{
    "word_family": [
        "fortunate",
        "unfortunate",
        "fortunately",
        "unfortunately",
        "misfortune"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "605589a0-479b-35fe-8107-f95e9866fe6c",
                    "sense_definition": "A very large amount of money.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That vintage car must be worth a <w>fortune</w> in today's market.",
                            "target_lang_translations": {
                                "ru": "Этот ретро-автомобиль, должно быть, стоит <w>целое состояние</w> на сегодняшнем рынке.",
                                "de": "Dieser Oldtimer muss auf dem heutigen Markt ein <w>Vermögen</w> wert sein."
                            }
                        },
                        {
                            "text": "He spent a small <w>fortune</w> on renovations for his new house.",
                            "target_lang_translations": {
                                "ru": "Он потратил небольшое <w>состояние</w> на ремонт своего нового дома.",
                                "de": "Er hat ein kleines <w>Vermögen</w> für die Renovierung seines neuen Hauses ausgegeben."
                            }
                        }
                    ],
                    "synonyms": [
                        "bundle",
                        "pile",
                        "wealth",
                        "a lot of money"
                    ],
                    "common_phrases": [
                        "cost a fortune",
                        "worth a fortune",
                        "spend a fortune",
                        "small fortune",
                        "make a fortune"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большая сумма денег.",
                        "de": "Eine sehr große Geldsumme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "значительное имущество или деньги"
                            },
                            {
                                "target_lang_word": "целое состояние",
                                "target_lang_sense_clarification": "огромная сумма (устойчивое выражение)"
                            },
                            {
                                "target_lang_word": "богатство",
                                "target_lang_sense_clarification": "большое количество денег"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Vermögen",
                                "target_lang_sense_clarification": "große Menge an Geld oder Werten"
                            },
                            {
                                "target_lang_word": "ein kleines Vermögen",
                                "target_lang_sense_clarification": "umgangssprachlich für eine beträchtliche Summe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ad3447-8605-352a-b44c-cd8fe84fa33f",
                    "sense_definition": "The total wealth or assets possessed by a person or family.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She inherited a vast <w>fortune</w> from her grandfather.",
                            "target_lang_translations": {
                                "ru": "Она унаследовала огромное <w>состояние</w> от своего дедушки.",
                                "de": "Sie hat ein riesiges <w>Vermögen</w> von ihrem Großvater geerbt."
                            }
                        },
                        {
                            "text": "The family <w>fortune</w> was built on the steel industry during the last century.",
                            "target_lang_translations": {
                                "ru": "Семейное <w>состояние</w> было нажито на сталелитейной промышленности в прошлом веке.",
                                "de": "Das Familien<w>vermögen</w> wurde im letzten Jahrhundert in der Stahlindustrie aufgebaut."
                            }
                        }
                    ],
                    "synonyms": [
                        "wealth",
                        "riches"
                    ],
                    "common_phrases": [
                        "family fortune",
                        "amass a fortune",
                        "inherit a fortune",
                        "seek one's fortune"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее богатство или активы, принадлежащие человеку или семье.",
                        "de": "Das gesamte Vermögen oder die Besitztümer einer Person oder Familie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "накопленные средства и активы"
                            },
                            {
                                "target_lang_word": "богатство",
                                "target_lang_sense_clarification": "изобилие ценностей"
                            },
                            {
                                "target_lang_word": "капитал",
                                "target_lang_sense_clarification": "финансовые активы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Vermögen",
                                "target_lang_sense_clarification": "Gesamtheit der finanziellen Mittel"
                            },
                            {
                                "target_lang_word": "Reichtum",
                                "target_lang_sense_clarification": "großer materieller Besitz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea5fb126-84ea-329b-ba36-e2df14c2cbf2",
                    "sense_definition": "Chance or luck, especially when it is favorable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was my good <w>fortune</w> to find a taxi just as it started to rain.",
                            "target_lang_translations": {
                                "ru": "К моему <w>счастью</w>, я нашел такси как раз тогда, когда начался дождь.",
                                "de": "Ich hatte das <w>Glück</w>, ein Taxi zu finden, gerade als es anfing zu regnen."
                            }
                        },
                        {
                            "text": "<w>Fortune</w> favors the brave, so do not be afraid to take risks.",
                            "target_lang_translations": {
                                "ru": "<w>Удача</w> любит смелых, так что не бойтесь рисковать.",
                                "de": "Das <w>Glück</w> ist mit den Mutigen, also hab keine Angst, Risiken einzugehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "luck",
                        "chance",
                        "serendipity",
                        "providence"
                    ],
                    "antonyms": [
                        "misfortune"
                    ],
                    "common_phrases": [
                        "good fortune",
                        "ill fortune",
                        "stroke of fortune",
                        "fortune smiles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай или удача, особенно благоприятные.",
                        "de": "Zufall oder Glück, besonders wenn es günstig ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удача",
                                "target_lang_sense_clarification": "благоприятный исход"
                            },
                            {
                                "target_lang_word": "везение",
                                "target_lang_sense_clarification": "счастливое стечение обстоятельств"
                            },
                            {
                                "target_lang_word": "счастье",
                                "target_lang_sense_clarification": "успех, удачный случай"
                            },
                            {
                                "target_lang_word": "фортуна",
                                "target_lang_sense_clarification": "судьба, удача (часто персонифицированная)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Glück",
                                "target_lang_sense_clarification": "positiv auswirkender Zufall"
                            },
                            {
                                "target_lang_word": "Fügung",
                                "target_lang_sense_clarification": "schicksalhaftes, glückliches Ereignis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "702ca5e7-41dc-3647-a540-a19e9e86c33d",
                    "sense_definition": "The events that are destined to happen to a person; one's destiny or fate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destiny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old woman offered to tell my <w>fortune</w> by reading the lines on my palm.",
                            "target_lang_translations": {
                                "ru": "Старуха предложила предсказать мою <w>судьбу</w> по линиям на ладони.",
                                "de": "Die alte Frau bot an, mir aus der Hand zu lesen, um mein <w>Schicksal</w> vorherzusagen."
                            }
                        },
                        {
                            "text": "He believed that his <w>fortune</w> was written in the stars long before he was born.",
                            "target_lang_translations": {
                                "ru": "Он верил, что его <w>судьба</w> была начертана на звездах задолго до его рождения.",
                                "de": "Er glaubte, dass sein <w>Schicksal</w> schon lange vor seiner Geburt in den Sternen geschrieben stand."
                            }
                        }
                    ],
                    "synonyms": [
                        "destiny",
                        "fate",
                        "doom",
                        "kismet",
                        "lot"
                    ],
                    "common_phrases": [
                        "tell someone's fortune",
                        "read someone's fortune",
                        "fortune teller"
                    ],
                    "target_lang_definitions": {
                        "ru": "События, которым суждено произойти с человеком; судьба или рок.",
                        "de": "Die Ereignisse, die für eine Person vorherbestimmt sind; Schicksal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судьба",
                                "target_lang_sense_clarification": "предопределенный ход жизни"
                            },
                            {
                                "target_lang_word": "будущее",
                                "target_lang_sense_clarification": "то, что предстоит (в контексте гадания)"
                            },
                            {
                                "target_lang_word": "участь",
                                "target_lang_sense_clarification": "доля, жребий"
                            },
                            {
                                "target_lang_word": "рок",
                                "target_lang_sense_clarification": "неизбежная, часто злая судьба"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schicksal",
                                "target_lang_sense_clarification": "vorherbestimmter Lebensweg"
                            },
                            {
                                "target_lang_word": "Zukunft",
                                "target_lang_sense_clarification": "das, was noch kommen wird (oft im Kontext von Vorhersagen)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7ce9873-aaac-37dc-8d28-1d05075ea2b0",
                    "sense_definition": "To happen or take place by chance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>fortuned</w> that the two travelers met at the crossroads just as the sun was setting.",
                            "target_lang_translations": {
                                "ru": "Так <w>случилось</w>, что два путника встретились на перекрестке как раз на закате.",
                                "de": "Es <w>fügte</w> sich, dass die beiden Reisenden sich an der Kreuzung trafen, gerade als die Sonne unterging."
                            }
                        },
                        {
                            "text": "As it <w>fortuned</w>, the king was passing through the village that very day.",
                            "target_lang_translations": {
                                "ru": "Как <w>случилось</w>, король проезжал через деревню в тот самый день.",
                                "de": "Wie es sich <w>fügte</w>, kam der König genau an diesem Tag durch das Dorf."
                            }
                        }
                    ],
                    "synonyms": [
                        "happen",
                        "occur",
                        "chance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случаться или происходить случайно.",
                        "de": "Durch Zufall geschehen oder stattfinden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "происходить"
                            },
                            {
                                "target_lang_word": "посчастливиться",
                                "target_lang_sense_clarification": "удаваться (о счастливом случае)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich fügen",
                                "target_lang_sense_clarification": "durch Zufall so geschehen"
                            },
                            {
                                "target_lang_word": "sich ereignen",
                                "target_lang_sense_clarification": "passieren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bb57d5b7-1e3f-3ef0-af34-bcb847707549",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Fortune</w> was known in the town for his generous charitable donations.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Форчун</w> был известен в городе своими щедрыми благотворительными пожертвованиями.",
                                "de": "Herr <w>Fortune</w> war in der Stadt für seine großzügigen Spenden bekannt."
                            }
                        },
                        {
                            "text": "We invited the <w>Fortune</w> family to the gathering next weekend.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Форчун</w> на встречу в следующие выходные.",
                                "de": "Wir haben die Familie <w>Fortune</w> zum Treffen am nächsten Wochenende eingeladen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Форчун",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Fortune",
                                "target_lang_sense_clarification": "Nachname"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88a305ce-d3f6-3241-8051-c24d97d05c9c",
                    "sense_definition": "A town in Newfoundland, Canada.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They took a ferry to visit the small town of <w>Fortune</w> on the coast.",
                            "target_lang_translations": {
                                "ru": "Они сели на паром, чтобы посетить маленький городок <w>Форчун</w> на побережье.",
                                "de": "Sie nahmen die Fähre, um die kleine Stadt <w>Fortune</w> an der Küste zu besuchen."
                            }
                        },
                        {
                            "text": "The fishing industry has always been vital to the economy of <w>Fortune</w>.",
                            "target_lang_translations": {
                                "ru": "Рыбная промышленность всегда была жизненно важна для экономики <w>Форчуна</w>.",
                                "de": "Die Fischereiindustrie war schon immer lebenswichtig für die Wirtschaft von <w>Fortune</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в Ньюфаундленде, Канада.",
                        "de": "Eine Stadt in Neufundland, Kanada."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Форчун",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Fortune",
                                "target_lang_sense_clarification": "Ortsname"
                            }
                        ]
                    }
                }
