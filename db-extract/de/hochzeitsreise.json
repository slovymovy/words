                        ],
                        "form": "die Hochzeitsreise"
                    },
                    {
                        "form_id": "e1b54f2e-b1d5-402e-a8c9-2a8c83476d56",
                        "entry_id": "6108a381-9939-30b6-9950-14bad0332dbf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hochzeitsreisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52e30686-48cf-3b2a-95b9-201ea46f0beb",
                        "entry_id": "6108a381-9939-30b6-9950-14bad0332dbf",
                        "glosses": [
                            "Reise, die ein Ehepaar nach der Hochzeit unternimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d34912-b3f6-423b-9608-38d8036ee0ed",
                                "sense_id": "52e30686-48cf-3b2a-95b9-201ea46f0beb",
                                "text": "Ihre Hochzeitsreise ging in die Karibik."
                            },
                            {
                                "example_id": "484941d8-fbb4-41f4-b249-74b038b98f1c",
                                "sense_id": "52e30686-48cf-3b2a-95b9-201ea46f0beb",
                                "text": "„Nein, die Hochzeitsreise sei ein ziemlicher Reinfall gewesen.“"
                            },
                            {
                                "example_id": "b89867ef-7227-49e0-9fef-2bd7f1608729",
                                "sense_id": "52e30686-48cf-3b2a-95b9-201ea46f0beb",
                                "text": "„Ich hörte soeben, daß ein auf der Hochzeitsreise befindliches Paar aus Saginaw in Michigan hier ist.“"
                            },
                            {
                                "example_id": "9a5dcbf8-aaa1-4216-9874-fad5b7a92195",
                                "sense_id": "52e30686-48cf-3b2a-95b9-201ea46f0beb",
                                "text": "„Sie nahmen Worte wie Hochzeitsreise und Flitterwochen in den Mund und wollten mich obszön nennen, diese Heuchler.“"
                            },
                            {
                                "example_id": "9c80e826-44cd-4bc1-b403-43ee098e724d",
                                "sense_id": "52e30686-48cf-3b2a-95b9-201ea46f0beb",
                                "text": "„Ein frisch gebackener Ehemann wird auf der Hochzeitsreise krank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42deebf7-e255-448d-b537-07b6ca989e89",
                        "source_entry_id": "6108a381-9939-30b6-9950-14bad0332dbf",
                        "source_sense_id": "52e30686-48cf-3b2a-95b9-201ea46f0beb",
                        "source_sense_description": "Reise, die ein Ehepaar nach der Hochzeit unternimmt",
                        "target_lang_word": "honeymoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honeymoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9245bd95-163d-3b4c-88ad-9a8c8861996b",
                                        "entry_id": "1ff02bda-270f-3804-a9e4-28c3ca4220dc",
                                        "glosses": [
                                            "The period of time immediately following a marriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b046010-eb72-491c-a708-ebcdb84ee891",
                                                "sense_id": "9245bd95-163d-3b4c-88ad-9a8c8861996b",
                                                "text": "The new minister and his wife were a young, pleasant-faced couple, still on their honeymoon, and full of all good and beautiful enthusiasms for their chosen lifework."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93474065-7dde-3e0c-912b-b2bdb98b84b8",
                                        "entry_id": "1ff02bda-270f-3804-a9e4-28c3ca4220dc",
                                        "glosses": [
                                            "A trip taken by a newly married couple during this period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec6ad6f-c6ae-472d-b45a-885fa5e2f64c",
                                                "sense_id": "93474065-7dde-3e0c-912b-b2bdb98b84b8",
                                                "text": "We went to Greece for our honeymoon."
                                            },
                                            {
                                                "example_id": "f2efa1b3-21f5-4016-aff1-2c90e5cd9602",
                                                "sense_id": "93474065-7dde-3e0c-912b-b2bdb98b84b8",
                                                "text": "I will say, 'Sir, I am going to marry your daughter. Be silent, sir! I have decided to do this and I will not be balked by a gouty old father-in-law. I want you to understand that from now on I am the master of this house. You may write out a check for ten thousand dollars for our honeymoon.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d50a58-d565-3be7-a263-3416f9f86138",
                                        "entry_id": "1ff02bda-270f-3804-a9e4-28c3ca4220dc",
                                        "glosses": [
                                            "A period of goodwill at the beginning of a new term or relationship (e.g. towards a newly elected politician or in respect of a new business arrangement)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8671fd2-29ef-4d1f-8902-0f07695d2111",
                                                "sense_id": "b0d50a58-d565-3be7-a263-3416f9f86138",
                                                "text": "Now that the honeymoon is over, it’s time for us to get down to the business at hand."
                                            },
                                            {
                                                "example_id": "a2de148d-6d24-4310-8a83-d07f1f117c66",
                                                "sense_id": "b0d50a58-d565-3be7-a263-3416f9f86138",
                                                "text": "The honeymoon period came to a swift end when the legislation was introduced."
                                            },
                                            {
                                                "example_id": "7b1ab55d-94cc-4d88-b8f6-bc0f221b3a0b",
                                                "sense_id": "b0d50a58-d565-3be7-a263-3416f9f86138",
                                                "text": "But the “honeymoon” was short. The propertied classes wanted merely a political revolution, which would take the power from the Tsar and give it to them. They wanted Russia to be a constitutional Republic, like France or the United States; or a constitutional Monarchy, like England. On the other hand, the masses of the people wanted real industrial and agrarian democracy."
                                            },
                                            {
                                                "example_id": "86acfb05-09cc-48c5-a4ab-d14c3f83bb54",
                                                "sense_id": "b0d50a58-d565-3be7-a263-3416f9f86138",
                                                "text": "It was here, surrounded by such friends, that the distinguished Chief Justice swore me in as Vice President on December 6, 1973. It was here I returned 8 months later as your President to ask not for a honeymoon, but for a good marriage."
                                            },
                                            {
                                                "example_id": "76a49e3a-6198-4270-b7be-c5d4b5ecf1c0",
                                                "sense_id": "b0d50a58-d565-3be7-a263-3416f9f86138",
                                                "text": "It suggests any honeymoon for the new government is over, with falls in approval ratings across the board for the senior figures in the cabinet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "honeymoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9abee125-2c01-3026-8fe4-2bbcea61942f",
                                        "entry_id": "e357ed53-a8f1-3cc8-978e-2c226e701ace",
                                        "glosses": [
                                            "To have a honeymoon (a trip taken by a couple after wedding)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c951531-f7f1-413a-b1eb-85a1df26f1eb",
                                                "sense_id": "9abee125-2c01-3026-8fe4-2bbcea61942f",
                                                "text": "My parents honeymooned at Niagara falls."
                                            },
                                            {
                                                "example_id": "95b31d3a-bb64-47d4-a7c3-780d7ac40ee2",
                                                "sense_id": "9abee125-2c01-3026-8fe4-2bbcea61942f",
                                                "text": "No sooner were they married than Dick fitted out his schooner, the All Away, and away the blessed pair of them went, honeymooning from Bordeaux to Hongkong."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
