                    "sense_definition": "En héraldique, se dit d'un astre, d'un charbon ou d'un feu représenté avec des étincelles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason familial portait une étoile <w>étincelante</w> d'or sur un fond bleu profond.",
                            "target_lang_translations": {
                                "en": "The family coat of arms bore a <w>sparkling</w> gold star on a deep blue field.",
                                "ru": "На семейном гербе была изображена <w>сверкающая</w> золотая звезда на глубоко синем поле.",
                                "de": "Das Familienwappen zeigte auf tiefblauem Grund einen <w>funkensprühenden</w> goldenen Stern.",
                                "es": "El escudo familiar lucía una estrella de oro <w>resplandeciente</w> sobre un campo azul intenso.",
                                "zh": "家族纹章的深蓝色底面上绘着一颗<w>带火花的</w>金色星星。"
                            }
                        },
                        {
                            "text": "L'écu était chargé d'un charbon <w>étincelant</w> posé au centre du champ.",
                            "target_lang_translations": {
                                "en": "The shield was charged with a <w>sparkling</w> coal placed at the centre of the field.",
                                "ru": "На щите был изображён <w>сверкающий</w> уголь в центре поля.",
                                "de": "Der Schild war in der Mitte des Feldes mit einer <w>funkensprühenden</w> Kohle belegt.",
                                "es": "El escudo estaba cargado con un carbón <w>resplandeciente</w> colocado en el centro del campo.",
                                "zh": "盾徽的正中央绘着一块<w>带火花的</w>炭块。"
                            }
                        }
                    ],
