                    }
                ],
                "translations": [
                    {
                        "translation_id": "34e98748-98ff-4874-a057-ae207fb41418",
                        "source_entry_id": "10d266b1-7ed7-3710-a451-232682f3a7f2",
                        "source_sense_id": "a1614e94-c7d1-32ef-b0fb-2a976c06de03",
                        "target_lang_word": "waiter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waiter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6568d8e8-c2ac-38d9-9a3c-ddb1833e48c9",
                                        "entry_id": "37b66816-466c-3911-85fa-54558f7e7641",
                                        "glosses": [
                                            "A male or female attendant who serves customers at their tables in a restaurant, café or similar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bb6c352-e50c-4f83-ad86-df78139ce80f",
                                                "sense_id": "6568d8e8-c2ac-38d9-9a3c-ddb1833e48c9",
                                                "text": "Waiter! There's a fly in my soup."
                                            },
                                            {
                                                "example_id": "b20c0a02-04e9-4dc2-bb6b-3ab2a36daeec",
                                                "sense_id": "6568d8e8-c2ac-38d9-9a3c-ddb1833e48c9",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace, […]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid,[…]—all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            },
                                            {
                                                "example_id": "defe847d-a68d-493c-aee7-6e688964a66f",
                                                "sense_id": "6568d8e8-c2ac-38d9-9a3c-ddb1833e48c9",
                                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed.\n ‘Civilized,’ he said to Mr. Campion. ‘Humanizing.’ […] ‘Cigars and summer days and women in big hats with swansdown face-powder, that's what it reminds me of.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63b0b90-fe35-3a3f-87b6-91ca5eee77ab",
                                        "entry_id": "37b66816-466c-3911-85fa-54558f7e7641",
                                        "glosses": [
                                            "Someone who waits for somebody or something; a person who is waiting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b447f184-10cc-4a95-b391-c710f0720d21",
                                                "sense_id": "e63b0b90-fe35-3a3f-87b6-91ca5eee77ab",
                                                "text": "However, the NTPF also contained implicit negative incentives for the public sector by offering alternative private sector treatment for the longest waiters at no extra cost to patients or no penalty to public providers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deeb0f3f-c8f5-3db6-bb6d-5219cee32e61",
                                        "entry_id": "37b66816-466c-3911-85fa-54558f7e7641",
                                        "glosses": [
                                            "A person working as an attendant at the London Stock Exchange."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "faa143a0-bc2c-39c4-a6f2-ea6f891d0098",
                                        "entry_id": "37b66816-466c-3911-85fa-54558f7e7641",
                                        "glosses": [
                                            "A vessel or tray on which something is carried, as dishes, etc.; a salver. (See etymology of dumbwaiter.)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9443a7e1-d545-49f0-9dd6-d4d48a9c798e",
                                                "sense_id": "faa143a0-bc2c-39c4-a6f2-ea6f891d0098",
                                                "text": "Cautioning her, in these terms, not to trip over a heterogeneous litter of pastry-cook’s trays, lamps, waiters full of glasses, and piles of rout seats which were strewn about the hall, plainly bespeaking a late party on the previous night, the man led the way to the second story […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756c069f-c1b1-395e-8cb6-64698d3dfd3b",
                                        "entry_id": "37b66816-466c-3911-85fa-54558f7e7641",
                                        "glosses": [
                                            "A custom house officer; a tide waiter."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d46b476b-7fcf-3168-b796-56cead3c051e",
                                        "entry_id": "37b66816-466c-3911-85fa-54558f7e7641",
                                        "glosses": [
                                            "A watchman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "waiter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63324d44-e5e5-3825-92a4-97593168690b",
                                        "entry_id": "9e52914a-4be6-3c85-9e13-1546bc9ac503",
                                        "glosses": [
                                            "To work as a waiter."
                                        ],
                                        "tags": [
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08aa37f8-7675-40ab-b523-197ddc102ebf",
                                                "sense_id": "63324d44-e5e5-3825-92a4-97593168690b",
                                                "text": "I had definitely had my fill of factory jobs, but had never worked in an office, nor bussed, nor waitered."
                                            },
                                            {
                                                "example_id": "86308ca3-ab00-40fc-86f2-9f5a17031a7b",
                                                "sense_id": "63324d44-e5e5-3825-92a4-97593168690b",
                                                "text": "He dropped out and waitered at the Spain but was fired for throwing water in a customer’s face."
                                            },
                                            {
                                                "example_id": "8f929237-56eb-41a1-b6d9-ccd42abe0456",
                                                "sense_id": "63324d44-e5e5-3825-92a4-97593168690b",
                                                "text": "John [Jasper] started out as a cart boy, helping the ox-cart driver manage the oxen; but he was so smart that he was soon transferred to the house, where he waitered and worked in the garden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
