                            {
                                "target_word": "belastet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                        "entry_id": "8b4a58c6-180b-3bc8-a73d-673019bf067d",
                                        "glosses": [
                                            "schädliche Stoffe aufweisend, verunreinigt (zum Beispiel mit Chemikalien, Pestiziden, Herbiziden, …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7831e4a7-ef37-40f9-9a91-fea03372c9e3",
                                                "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                                "text": "Die Eier sind unverkäuflich, da mit Dioxin belastet."
                                            },
                                            {
                                                "example_id": "a537a86d-009e-4892-b7be-3cd2443a3518",
                                                "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                                "text": "Mit Düngemittelrückständen belastete Futtermittel haben im ökologischen Landbau nichts zu suchen."
                                            },
                                            {
                                                "example_id": "a2140bd8-c9d8-45d4-bb5b-fceaffd73293",
                                                "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                                "text": "„In Japan ist radioaktiv belastete Nahrung aufgetaucht.“"
                                            },
                                            {
                                                "example_id": "2d29b0ad-fb52-43eb-93b8-d4fe6fb6c2a2",
                                                "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                                "text": "„Wer ein Jahr lang von der belasteten Milch trinken und den ebenfalls belasteten Spinat essen würde, nehme eine Strahlendosis von der Stärke einer Röntgenuntersuchung auf.“"
                                            },
                                            {
                                                "example_id": "6d9fb25f-3ce5-426e-b8fc-e84b0fc030cc",
                                                "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                                "text": "„Bei Sanierung und Rückbau von Gebäuden bereiten mit Giftstoffen belastete Bauteile besonders große Probleme.“"
                                            },
                                            {
                                                "example_id": "ecc80ca8-00a2-46ae-b3bc-ab31da7d02fc",
                                                "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                                "text": "„In Belarus erhielten 16 mit Blei belastete Arbeiterinnen 5 Spirulinatabletten pro Tag als Nahrungsergänzung.“"
                                            },
                                            {
                                                "example_id": "f1b11399-9429-4c2d-9505-65f358a13146",
                                                "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                                "text": "„Bodenkontaminationen können dann auftreten, wenn eine geeignete Bodenabdichtung fehlt und flüssige Schadstoffe oder mit Schadstoffen belastete Sickerwässer aus dem Abfallkörper austreten.“"
                                            },
                                            {
                                                "example_id": "861a02c1-af4b-41f5-b270-7b5a613b6dda",
                                                "sense_id": "bb644ed3-1d72-3559-9ef5-0858dac6e7c2",
                                                "text": "„Eine nicht mit anthropogenen Abgasen belastete Atmosphäre enthält etwa 60 Mio t dieses Gases [Kohlenmonoxid].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbebbc9c-18ba-30c2-87e2-5874b0e76364",
                                        "entry_id": "8b4a58c6-180b-3bc8-a73d-673019bf067d",
                                        "glosses": [
                                            "angespannt, in einer angespannten Situation seiend; erfüllt von unerfreulichem Druck; beladen mit einer Bürde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da8ef873-630b-46be-9678-9f96216372e5",
                                                "sense_id": "dbebbc9c-18ba-30c2-87e2-5874b0e76364",
                                                "text": "„Stark belastete Soldaten standen für die Untersuchung hingegen nicht zur Verfügung.“"
                                            },
                                            {
                                                "example_id": "476e6b4e-a13c-4335-a97d-e6f5a70c7f1b",
                                                "sense_id": "dbebbc9c-18ba-30c2-87e2-5874b0e76364",
                                                "text": "„Die letzten drei Kinder- und Jugendberichte der deutschen Bundesregierungen gehen davon aus, dass es tendenziell immer mehr psychisch belastete und/oder traumatisierte Kinder und Jugendliche geben wird.“"
                                            },
                                            {
                                                "example_id": "d088bc56-fd01-4ae4-a465-059fb1220e41",
                                                "sense_id": "dbebbc9c-18ba-30c2-87e2-5874b0e76364",
                                                "text": "„Sie geht vielmehr davon aus, dass seelisch gesunde oder zumindest gesündere Menschen besser in der Lage sind, sich vernunftbezogen und ethisch orientiert zu verhalten als seelisch belastete Menschen."
                                            },
                                            {
                                                "example_id": "bbb2668a-5e3b-4bf2-a497-3f14e30d8362",
                                                "sense_id": "dbebbc9c-18ba-30c2-87e2-5874b0e76364",
                                                "text": "„Solange die Klinik primär als Ort der Entspannung („Kur“), also möglichst weit weg vom Alltag, erlebt wird, werden sich beruflich belastete Menschen zwar wohl fühlen, aber kaum alltagstaugliche Strategien erarbeiten können.“"
                                            },
                                            {
                                                "example_id": "2b72f2a7-72c8-4781-b64a-dc6b1c25bb39",
                                                "sense_id": "dbebbc9c-18ba-30c2-87e2-5874b0e76364",
                                                "text": "„Hier brachte der technische Fortschritt wirklich etwas Gutes und Erfreuliches für die durch Arbeit belastete Hausfrau.“"
                                            },
                                            {
                                                "example_id": "9c331f5e-9fcf-426c-90e8-22bc0015c607",
                                                "sense_id": "dbebbc9c-18ba-30c2-87e2-5874b0e76364",
                                                "text": "übertragen: „Die Krise wurde aus den unsichtbaren Verästelungen übermäßig mit Terminen belasteter Tagesläufe herausgeschnitten. Das musste so sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ea040090-1ae3-3bd9-92a7-7f998afc9b92",
                                        "entry_id": "8b4a58c6-180b-3bc8-a73d-673019bf067d",
                                        "glosses": [
                                            "eine negative Vergangenheit habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ccc4f49-23e8-4f95-8c0c-12afa46fc6db",
                                                "sense_id": "ea040090-1ae3-3bd9-92a7-7f998afc9b92",
                                                "text": "„Noch 1957 sei etwa ein führender und erheblich belasteter Nazi mit einem Empfehlungsschreiben eines Exkameraden eingestellt worden, der in der Hitler-Zeit dessen Vorgesetzter war.“"
                                            },
                                            {
                                                "example_id": "8c4eb718-fa4e-49bb-9214-cb73d695493c",
                                                "sense_id": "ea040090-1ae3-3bd9-92a7-7f998afc9b92",
                                                "text": "„Mit Puvogel (CDU) in Niedersachsen und Filbinger (CDU) in Baden-Württemberg schieden noch 1978 zwei belastete Politiker unter dem Druck der öffentlichen Meinung aus dem Amt.“"
                                            },
                                            {
                                                "example_id": "1c5444cc-d2b5-428e-8360-1fcc688375fd",
                                                "sense_id": "ea040090-1ae3-3bd9-92a7-7f998afc9b92",
                                                "text": "„Umgerechnet auf die Bevölkerung ging der Osten wesentlich rigoroser gegen nachgewiesenermaßen belastete Nazis vor und verurteilte etwa achtmal mehr Täter als der Westen.“"
                                            },
                                            {
                                                "example_id": "f69b9026-9474-402b-bfc2-1946f4e3d04d",
                                                "sense_id": "ea040090-1ae3-3bd9-92a7-7f998afc9b92",
                                                "text": "„Der Gegensatz zwischen dem symbolischen Aufrufen eines im Gedankengut der Humanität stehenden Werkes und nationalsozialistisch belasteten Politikern könnte größer nicht sein.“"
                                            },
                                            {
                                                "example_id": "b9625f88-f880-4622-91f9-2a1b4d5051b1",
                                                "sense_id": "ea040090-1ae3-3bd9-92a7-7f998afc9b92",
                                                "text": "„Diese Zähigkeit durch alle Veränderungen macht die AN so zu einem Idealfall der Entwicklung einer geächteten extrem rechten und historisch belasteten Partei in Richtung der politischen Mitte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "belastet",
                                "target_lang_code": "de",
