                "senses": [
                    {
                        "sense_id": "bfcc2440-2e89-3368-84c1-a162a631b779",
                        "entry_id": "615a33ed-0136-3fa3-b44d-ef1971e059e2",
                        "glosses": [
                            "Buch, dessen Zielgruppe Jugendliche sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78759958-88fa-46c6-8b42-48ed79b5b85c",
                                "sense_id": "bfcc2440-2e89-3368-84c1-a162a631b779",
                                "text": "Sie kaufte ihrer Nichte ein Jugendbuch zum Geburtstag."
                            },
                            {
                                "example_id": "c464e6cd-4925-4e45-a694-1aa3eb8aeacc",
                                "sense_id": "bfcc2440-2e89-3368-84c1-a162a631b779",
                                "text": "„Die Berliner Schriftstellerin Christine Fehér (49) ist am Freitag mit dem ‚Buxtehuder Bullen‘ für das beste Jugendbuch des Jahres ausgezeichnet worden.“"
                            },
                            {
                                "example_id": "875f80c5-ee40-4b8b-a543-d00ece486f3b",
                                "sense_id": "bfcc2440-2e89-3368-84c1-a162a631b779",
                                "text": "„Martin Grzimek hat ein spannendes Jugendbuch geschrieben, er entkleidet die Geschichte der reflexiven Fallhöhe und der Konzentration auf ein entfesseltes Liebesverhältnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
