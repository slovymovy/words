    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a8581f68-487a-3124-8106-33b6f0f4f849",
                    "sense_definition": "At, near, or towards the front or the direction one is facing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction_phys",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please step <w>forward</w> when your name is called.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, сделайте шаг <w>вперёд</w>, когда назовут ваше имя.",
                                "pl": "Proszę wystąpić <w>do przodu</w>, gdy zostanie wywołane twoje nazwisko."
                            }
                        },
                        {
                            "text": "She leaned <w>forward</w> to hear him better.",
                            "target_lang_translations": {
                                "ru": "Она наклонилась <w>вперёд</w>, чтобы лучше его слышать.",
                                "pl": "Pochyliła się <w>do przodu</w>, aby lepiej go słyszeć."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahead",
                        "forwards"
                    ],
                    "antonyms": [
                        "back",
                        "backward",
                        "backwards",
                        "rearwards"
                    ],
                    "common_phrases": [
                        "move forward",
                        "step forward",
                        "lean forward",
                        "come forward"
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении передней стороны или по ходу движения.",
                        "pl": "W kierunku przodu lub w stronę, w którą ktoś jest zwrócony."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "направление движения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "do przodu",
                                "target_lang_sense_clarification": "kierunek ruchu"
                            },
                            {
                                "target_lang_word": "naprzód",
                                "target_lang_sense_clarification": "przed siebie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17c177fb-b8a3-365b-a338-263bee5936e0",
                    "sense_definition": "In a direction of progress, improvement, or development.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction_meta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to move this project <w>forward</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Нам нужно немедленно продвигать этот проект <w>вперёд</w>.",
                                "pl": "Musimy natychmiast ruszyć z tym projektem <w>do przodu</w>."
                            }
                        },
                        {
                            "text": "This agreement is a significant step <w>forward</w> for peace.",
                            "target_lang_translations": {
                                "ru": "Это соглашение — значительный шаг <w>вперёд</w> к миру.",
                                "pl": "To porozumienie to znaczący krok <w>naprzód</w> w stronę pokoju."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahead",
                        "on",
                        "onward",
                        "onwards"
                    ],
                    "antonyms": [
                        "backward",
                        "backwards"
                    ],
                    "common_phrases": [
                        "go forward",
                        "way forward",
                        "step forward"
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении развития, улучшения или прогресса.",
                        "pl": "W kierunku postępu, poprawy lub rozwoju."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "прогресс"
                            },
                            {
                                "target_lang_word": "дальше",
                                "target_lang_sense_clarification": "продолжение действия"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "naprzód",
                                "target_lang_sense_clarification": "rozwój"
                            },
                            {
                                "target_lang_word": "do przodu",
                                "target_lang_sense_clarification": "postęp"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b0c0544-b46d-3075-8f08-5c878b833c1c",
                    "sense_definition": "Into the future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From this day <w>forward</w>, we will work together.",
                            "target_lang_translations": {
                                "ru": "С этого дня и <w>впредь</w> мы будем работать вместе.",
                                "pl": "Od dzisiaj <w>w przyszłość</w> będziemy pracować razem."
                            }
                        },
                        {
                            "text": "We must look <w>forward</w> rather than dwelling on the past.",
                            "target_lang_translations": {
                                "ru": "Мы должны смотреть <w>вперёд</w>, а не зацикливаться на прошлом.",
                                "pl": "Musimy patrzeć <w>w przyszłość</w>, zamiast rozpamiętywać przeszłość."
                            }
                        }
                    ],
                    "synonyms": [
                        "forth",
                        "on",
                        "onward"
                    ],
                    "antonyms": [
                        "into the past"
                    ],
                    "common_phrases": [
                        "from now forward",
                        "look forward"
                    ],
                    "target_lang_definitions": {
                        "ru": "В будущем; начиная с этого момента.",
                        "pl": "W przyszłość; od teraz na przyszłość."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впредь",
                                "target_lang_sense_clarification": "с этого момента"
                            },
                            {
                                "target_lang_word": "в дальнейшем",
                                "target_lang_sense_clarification": "в будущем"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "w przyszłość",
                                "target_lang_sense_clarification": "kierunek czasowy"
                            },
                            {
                                "target_lang_word": "naprzód",
                                "target_lang_sense_clarification": "patrzenie w przyszłość"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8f2dbedc-7bba-3444-9c60-b905949ed9d1",
                    "sense_definition": "Situated toward or at the front of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction_phys",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The passengers in the <w>forward</w> cabin felt the turbulence less.",
                            "target_lang_translations": {
                                "ru": "Пассажиры в <w>передней</w> кабине меньше чувствовали турбулентность.",
                                "pl": "Pasażerowie w <w>przedniej</w> kabinie mniej odczuwali turbulencje."
                            }
                        },
                        {
                            "text": "The <w>forward</w> part of the ship was damaged in the storm.",
                            "target_lang_translations": {
                                "ru": "<w>Носовая</w> часть корабля была повреждена во время шторма.",
                                "pl": "<w>Dziobowa</w> część statku została uszkodzona podczas sztormu."
                            }
                        }
                    ],
                    "synonyms": [
                        "front",
                        "leading"
                    ],
                    "antonyms": [
                        "back",
                        "posterior",
                        "rear"
                    ],
                    "common_phrases": [
                        "forward position",
                        "forward movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный в передней части чего-либо.",
                        "pl": "Znajdujący się z przodu lub w przedniej części czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пере́дний",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "носовой",
                                "target_lang_sense_clarification": "о корабле или самолете"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przedni",
                                "target_lang_sense_clarification": "położenie"
                            },
                            {
                                "target_lang_word": "dziobowy",
                                "target_lang_sense_clarification": "o statku lub samolocie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c65d6858-a890-3ba4-b072-52d41290853b",
                    "sense_definition": "Relating to the future or directed towards the future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company needs more <w>forward</w> planning to succeed.",
                            "target_lang_translations": {
                                "ru": "Для успеха компании необходимо более тщательное <w>перспективное</w> планирование.",
                                "pl": "Firma potrzebuje więcej <w>perspektywicznego</w> planowania, aby odnieść sukces."
                            }
                        },
                        {
                            "text": "This is a <w>forward</w> estimate of our earnings.",
                            "target_lang_translations": {
                                "ru": "Это <w>прогнозная</w> оценка наших доходов.",
                                "pl": "To jest <w>przyszła</w> prognoza naszych zarobków."
                            }
                        }
                    ],
                    "synonyms": [
                        "forecast",
                        "predicted"
                    ],
                    "common_phrases": [
                        "forward planning",
                        "forward thinking",
                        "forward looking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к будущему или направленный на перспективу.",
                        "pl": "Dotyczący przyszłości lub skierowany ku przyszłości."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перспективный",
                                "target_lang_sense_clarification": "о планировании"
                            },
                            {
                                "target_lang_word": "будущий",
                                "target_lang_sense_clarification": "предстоящий"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przyszły",
                                "target_lang_sense_clarification": "nadchodzący"
                            },
                            {
                                "target_lang_word": "perspektywiczny",
                                "target_lang_sense_clarification": "o planowaniu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a64b8e5-5a58-3f26-9755-850c41decb79",
                    "sense_definition": "Lacking customary restraint or modesty; bold or presumptuous.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope you do not think me <w>forward</w> for asking your age.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, вы не сочтёте меня <w>развязным</w>, если я спрошу ваш возраст.",
                                "pl": "Mam nadzieję, że nie uznasz mnie za zbyt <w>bezpośredniego</w>, pytając o twój wiek."
                            }
                        },
                        {
                            "text": "She is a very <w>forward</w> young lady who speaks her mind.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>бойкая</w> девушка, которая говорит то, что думает.",
                                "pl": "To bardzo <w>pewna siebie</w> młoda dama, która mówi to, co myśli."
                            }
                        }
                    ],
                    "synonyms": [
                        "bold",
                        "brazen",
                        "fresh",
                        "impertinent"
                    ],
                    "antonyms": [
                        "restrained"
                    ],
                    "common_phrases": [
                        "too forward",
                        "forward behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый скромности; слишком смелый или фамильярный.",
                        "pl": "Zbyt pewny siebie, śmiały lub bezczelny; wykazujący brak skromności."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развязный",
                                "target_lang_sense_clarification": "бесцеремонный"
                            },
                            {
                                "target_lang_word": "наха́льный",
                                "target_lang_sense_clarification": "грубый"
                            },
                            {
                                "target_lang_word": "де́рзкий",
                                "target_lang_sense_clarification": "смелый, вызывающий"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pewny siebie",
                                "target_lang_sense_clarification": "śmiały"
                            },
                            {
                                "target_lang_word": "bezpośredni",
                                "target_lang_sense_clarification": "aż do przesady"
                            },
                            {
                                "target_lang_word": "bezelzelny",
                                "target_lang_sense_clarification": "zuchwały"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dba7509f-d9c3-30bc-b258-2b319b13cc22",
