                ],
                "senses": [
                    {
                        "sense_id": "d6bbeaa2-c3b7-3902-9f2e-79fd39468ea7",
                        "entry_id": "ff88d37f-2108-3700-97ac-85a6422651a7",
                        "glosses": [
                            "шахм., разг. уменьш.-ласк. к конь; шахматная фигура"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e30e4c-1281-4a0c-8b15-acfbb2a3d424",
                                "sense_id": "d6bbeaa2-c3b7-3902-9f2e-79fd39468ea7",
                                "text": "— А я коника съем и шахец объявлю, — это говорил низкорослый в форме, постарше."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdc447d5-c793-3702-ba68-e037c08d8b24",
                        "entry_id": "ff88d37f-2108-3700-97ac-85a6422651a7",
                        "glosses": [
                            "устар. лавка с ларём; ларь для спанья, с подъёмною крышкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9980568a-0d0a-4195-b741-db1c5b75f7d0",
                                "sense_id": "fdc447d5-c793-3702-ba68-e037c08d8b24",
                                "text": "— Сюда садись, ваше сиятельство, вот сюда на коник, — говорила она, вытирая коник занавеской."
                            }
                        ]
                    }
                ],
