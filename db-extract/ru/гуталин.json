                ],
                "senses": [
                    {
                        "sense_id": "9017d2ec-9550-38a8-b853-395be221da5d",
                        "entry_id": "2eafbc43-6032-315f-b214-d2319ba674db",
                        "glosses": [
                            "маслянистое вещество, используемое для натирания кожаной обуви с целью защиты от влаги и маскировки грязи, увеличения эластичности, а также придания блеска"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35a62f4-56da-4900-9c5a-d63f057e8d93",
                                "sense_id": "9017d2ec-9550-38a8-b853-395be221da5d",
                                "text": "Скоро имущества осталось немного: табурет сломанный, кровать старая, комод, портрет отца да начатая банка гуталину со щёткой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bcf65ee-a62f-4059-adc4-f4d41257c1bd",
                        "source_entry_id": "2eafbc43-6032-315f-b214-d2319ba674db",
                        "source_sense_id": "9017d2ec-9550-38a8-b853-395be221da5d",
                        "target_lang_word": "Schuhwichse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhwichse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc3bc38-a327-36ce-9642-b5cd2303632d",
                                        "entry_id": "ade15097-f42d-3e9d-9ca1-c96597c3dea2",
                                        "glosses": [
                                            "Creme zur Pflege des Oberleders von Schuhen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90ad9498-7b39-4180-b0d9-e3bd476632bc",
                                                "sense_id": "6dc3bc38-a327-36ce-9642-b5cd2303632d",
                                                "text": "„Das Haar der Schnösel sah aus, als wäre es mit schwarzer Schuhwichse angeklatscht.“"
                                            },
                                            {
                                                "example_id": "1cdcd7f6-a61c-4167-a847-77c9bca599c9",
                                                "sense_id": "6dc3bc38-a327-36ce-9642-b5cd2303632d",
                                                "text": "„Sein Haar war schwarz wie Schuhwichse, und er trug einen schmalen Oberlippenbart, vermutlich um sein weiches, fast noch jugendliches Gesicht älter wirken zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e255384-3d79-4b9b-9f33-725f42784e32",
                        "source_entry_id": "2eafbc43-6032-315f-b214-d2319ba674db",
                        "source_sense_id": "9017d2ec-9550-38a8-b853-395be221da5d",
                        "target_lang_word": "Schuhcreme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhcreme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c268c84a-d1e3-352d-bda1-d047d0f26c21",
                                        "entry_id": "d26c549c-aa1b-30a8-a2b5-a34a2a69c325",
                                        "glosses": [
                                            "Creme für die Pflege der Schuhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd639f77-9c0d-4b35-bca2-3643bbd4d8cc",
                                                "sense_id": "c268c84a-d1e3-352d-bda1-d047d0f26c21",
                                                "text": "„Insoweit sie noch Stiefel und Schuhe haben, sieht man ihnen immer an, daß sie versucht haben, sie zu polieren und zu bürsten, obwohl Schuhcreme nicht erhältlich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
