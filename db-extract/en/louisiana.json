                                    {
                                        "sense_id": "2d96ed44-f5af-374b-bd22-e0d9a22a4183",
                                        "entry_id": "0db42896-125d-39e4-af7d-175f685ec2c9",
                                        "glosses": [
                                            "een van de vijftig deelstaten van de Verenigde Staten van Amerika. Louisiana ligt aan de Golf van Mexico, en grenst aan de deelstaten Mississippi, Arkansas en Texas."
