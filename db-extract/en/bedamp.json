                        "sense_id": "151f3b5e-7b49-35cb-bde6-63478d9ac0cd",
                        "entry_id": "5a16fac4-9d59-35bb-bd79-2ce4984a6543",
                        "glosses": [
                            "To cover with dampness; make damp; dampen."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c57fcced-c44d-408e-b6ed-c7f8009253b9",
                                "sense_id": "151f3b5e-7b49-35cb-bde6-63478d9ac0cd",
                                "text": "Before I reached our lodgings, the dusk settled into streets, and a mist bedewed and bedamped me and I went astray, as is usual with me, and had to inquire my way; […]"
                            },
                            {
                                "example_id": "074d34b1-6312-440c-8cbb-05f2bfeba15a",
                                "sense_id": "151f3b5e-7b49-35cb-bde6-63478d9ac0cd",
                                "text": "Nor is it sense to prostitute the kirk\nWith pleas of faith in God for business weal,\nWhen lack of enterprise bedamps your zeal."
                            },
                            {
                                "example_id": "7e8f203b-c383-4f90-bc72-7f4e03ccc7db",
                                "sense_id": "151f3b5e-7b49-35cb-bde6-63478d9ac0cd",
                                "text": "“Hallowed is the gleet that bedamps the repentant's nerve - sacred is the golden channel spurting from the kindness of liberty's expiring worldbeater - […]”"
                            }
                        ]
                    }
