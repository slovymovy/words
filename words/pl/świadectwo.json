                {
                    "sense_id": "dbfaa1a1-bb46-371d-b866-6f1515ace62e",
                    "sense_definition": "Oficjalny dokument szkolny zawierający wykaz ocen uzyskanych przez ucznia w danym roku szkolnym.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dokumenty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na koniec roku szkolnego każdy uczeń otrzymuje <w>świadectwo</w>.",
                            "target_lang_translations": {
                                "ru": "В конце учебного года каждый ученик получает <w>табель</w> с оценками.",
                                "en": "At the end of the school year, every student receives a <w>report card</w>."
                            }
                        },
                        {
                            "text": "Marek był dumny, bo dostał <w>świadectwo</w> z czerwonym paskiem.",
                            "target_lang_translations": {
                                "ru": "Марек гордился, потому что получил <w>аттестат</w> с отличием.",
                                "en": "Marek was proud because he received a <w>school certificate</w> with honors."
                            }
                        }
                    ],
                    "synonyms": [
                        "cenzurka"
                    ],
                    "common_phrases": [
                        "świadectwo z paskiem",
                        "rozdanie świadectw",
                        "świadectwo ukończenia szkoły"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный школьный документ, содержащий перечень оценок, полученных учеником в данном учебном году.",
                        "en": "An official school document showing the marks or grades obtained by a student in a given school year."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аттестат",
                                "target_lang_sense_clarification": "об окончании школы"
                            },
                            {
                                "target_lang_word": "табель",
                                "target_lang_sense_clarification": "с оценками"
                            },
                            {
                                "target_lang_word": "свидетельство",
                                "target_lang_sense_clarification": "об образовании"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "school report",
                                "target_lang_sense_clarification": "UK; report card"
                            },
                            {
                                "target_lang_word": "report card",
                                "target_lang_sense_clarification": "US; document with school grades"
                            },
                            {
                                "target_lang_word": "certificate",
                                "target_lang_sense_clarification": "of school completion or graduation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fa213ea-77ea-37e2-af88-19cdecbc5b5d",
                    "sense_definition": "Dokument urzędowy potwierdzający określony stan faktyczny, posiadane kwalifikacje, uprawnienia lub zaistnienie zdarzenia.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dokumenty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pracodawca ma obowiązek wydać pracownikowi <w>świadectwo</w> pracy.",
                            "target_lang_translations": {
                                "ru": "Работодатель обязан выдать работнику <w>справку</w> с места работы.",
                                "en": "An employer is obliged to issue an employment <w>certificate</w> to an employee."
                            }
                        },
                        {
                            "text": "Po zdaniu matury każdy uczeń otrzymuje <w>świadectwo</w> dojrzałości.",
                            "target_lang_translations": {
                                "ru": "После сдачи выпускных экзаменов каждый ученик получает <w>аттестат</w> зрелости.",
                                "en": "After passing the secondary school exit exams, every student receives a maturity <w>certificate</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "certyfikat"
                    ],
                    "common_phrases": [
                        "świadectwo pracy",
                        "świadectwo urodzenia",
                        "świadectwo dojrzałości",
                        "świadectwo zdrowia",
                        "świadectwo ślubu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный документ, подтверждающий фактическое положение дел, квалификацию, права или событие.",
                        "en": "An official document confirming a specific factual situation, qualifications, entitlements, or the occurrence of an event."
