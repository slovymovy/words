                    "frequency": "High",
                    "semantic_group_id": "genuanceerd_oordeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De journalist gaf een <w>genuanceerd</w> beeld van de ingewikkelde politieke situatie.",
                            "target_lang_translations": {
