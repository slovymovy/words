                                                "example_id": "2705a6b4-2c07-4224-89d4-6c58300c642e",
                                                "sense_id": "a9fe0719-4227-3a35-aa72-1c3b3254a00d",
                                                "text": "Mary screened the beans to remove the clumps of gravel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27ebf185-0e2c-35ae-8560-7f925d2a716a",
                                        "entry_id": "112ff469-49f1-32c3-b814-7336af802226",
                                        "glosses": [
                                            "To shelter or conceal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8a1fb36-f76a-33b2-b7ea-37aa82d704fc",
                                        "entry_id": "112ff469-49f1-32c3-b814-7336af802226",
                                        "glosses": [
                                            "To remove information, or censor intellectual material from viewing. To hide the facts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d805b701-d525-4efb-aff7-743e4e11eaaa",
                                                "sense_id": "f8a1fb36-f76a-33b2-b7ea-37aa82d704fc",
                                                "text": "The news report was screened because it accused the politician of wrongdoing."
                                            },
                                            {
                                                "example_id": "c16afbf1-36c9-4553-9f01-5aa0e0f5f743",
                                                "sense_id": "f8a1fb36-f76a-33b2-b7ea-37aa82d704fc",
                                                "text": "\"It were dishonour in me to yield. I will not play the part of an impostor, whom my uncle must despise even while he screens. No; these estates are his right: let him take them; I will not buy them with his daughter's hand.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbeae6be-ac50-3b3c-a637-22bb211076ba",
                                        "entry_id": "112ff469-49f1-32c3-b814-7336af802226",
                                        "glosses": [
                                            "To present publicly (on the screen)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0967f21-c036-4e2a-b7be-9410cbe6cfc4",
                                                "sense_id": "dbeae6be-ac50-3b3c-a637-22bb211076ba",
                                                "text": "The news report will be screened at 11:00 tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833dd1df-0226-37f1-b619-60dfaa9fafc8",
                                        "entry_id": "112ff469-49f1-32c3-b814-7336af802226",
                                        "glosses": [
                                            "To fit with a screen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e242ea-15d2-4f25-9dc6-4af110e819ea",
                                                "sense_id": "833dd1df-0226-37f1-b619-60dfaa9fafc8",
                                                "text": "We need to screen this porch. These bugs are driving me crazy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0947ab4-d6c8-370e-9a19-cacdf91d2732",
                                        "entry_id": "112ff469-49f1-32c3-b814-7336af802226",
                                        "glosses": [
                                            "To examine patients or treat a sample in order to detect a chemical or a disease, or to assess susceptibility to a disease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a85a1f8a-eed0-3406-bc61-5f390692361c",
                                        "entry_id": "112ff469-49f1-32c3-b814-7336af802226",
                                        "glosses": [
                                            "To search chemical libraries by means of a computational technique in order to identify chemical compounds which would potentially bind to a given biological target such as a protein."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "219cb0ec-260e-3c72-a810-f42bb7d5f1e6",
                                        "entry_id": "112ff469-49f1-32c3-b814-7336af802226",
                                        "glosses": [
                                            "To stand so as to block a defender from reaching a teammate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5107cd0e-c58c-32ca-a195-b4dbd9beda2f",
                                        "entry_id": "112ff469-49f1-32c3-b814-7336af802226",
                                        "glosses": [
                                            "To determine the source or subject matter of a call before deciding whether to answer the phone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a995a5f-aaef-48cb-a736-595b0e4ae1c5",
                                                "sense_id": "5107cd0e-c58c-32ca-a195-b4dbd9beda2f",
                                                "text": "A Phone to Screen Calls"
                                            },
                                            {
                                                "example_id": "efa97c8d-8f88-4bb9-81ab-b5224199e761",
                                                "sense_id": "5107cd0e-c58c-32ca-a195-b4dbd9beda2f",
                                                "text": "If you screen your calls as a time management technique, try this message: I'm not near my phone right now, but I should be able to return calls after 3:30."
                                            },
                                            {
                                                "example_id": "1c337b9f-d197-4d59-90b0-2e58ee43a3c7",
                                                "sense_id": "5107cd0e-c58c-32ca-a195-b4dbd9beda2f",
                                                "text": "The new phones can take pictures, screen calls and even make calls on their own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
