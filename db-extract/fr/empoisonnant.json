                        "cross_references": [
                            {
                                "target_word": "venenoso",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4477abad-117e-3626-9b60-cb7b7d87ea9e",
                                        "entry_id": "323e2c0c-d3b8-3ac9-b49b-d419efe66602",
                                        "glosses": [
                                            "Que por contacto, ingesta o inoculación resulta dañino o letal para un organismo vivo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd0ee84-f31c-4702-9f40-d8933e26157d",
                                                "sense_id": "4477abad-117e-3626-9b60-cb7b7d87ea9e",
                                                "text": "Pensó en el formicario, allá arriba, y era una cosa muerta y rezumante, un horror de patas buscando salir, un aire viciado y venenoso."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "191e9ab1-2613-3c46-a8da-1259b501b467",
                                        "entry_id": "323e2c0c-d3b8-3ac9-b49b-d419efe66602",
                                        "glosses": [
                                            "Se dice del habla o discurso que ofende, daña la reputación, causa conflicto o contiene sátiras."
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da01876d-19b0-41f3-adbd-a7e81ce1d65f",
                                                "sense_id": "191e9ab1-2613-3c46-a8da-1259b501b467",
                                                "text": "conteniéndose de manera heroica para evitar insultos abiertos, intercambiaron frases venenosas disfrazadas de opiniones casi neutras."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "449aebce-64b0-3468-abe9-2b66a4d58120",
                                        "entry_id": "323e2c0c-d3b8-3ac9-b49b-d419efe66602",
                                        "glosses": [
                                            "Dicho de un animal, que es capaz de inocular veneno ya sea por mordedura o picadura con aguijón o espuela."
                                        ],
                                        "tags": [],
