                        "source_sense_description": "Geometrie: nicht geschlossene ebene Linie mit konstanter Krümmung",
                        "target_lang_word": "arc de cercle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arc de cercle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5986da6-f554-3e19-8159-8b7ada1d833e",
                                        "entry_id": "075c51b2-244a-32ed-81b1-261e16e3a7f3",
                                        "glosses": [
                                            "Portion de cercle limitée par deux points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93717ca9-884b-4337-a6e3-7de35fe168dd",
                                                "sense_id": "c5986da6-f554-3e19-8159-8b7ada1d833e",
                                                "text": "Si l'on suppose maintenant que la courbure de notre arc méridien aille toujours en diminuant, comme on le voit en abd, il est visible qu'alors cet arc sera inférieur à l'arc de cercle acd ayant son centre sur l'axe, que sa courbure commencera par être supérieure à celle de ce dernier pour lui devenir ensuite inférieure, et qu'au point d l'un des arcs viendra encore couper l'autre et non le toucher."
                                            },
                                            {
                                                "example_id": "4a39211e-92cc-40db-a182-99aac753b328",
                                                "sense_id": "c5986da6-f554-3e19-8159-8b7ada1d833e",
                                                "text": "Rue Valentin-Haüy, un vieux restaurant porte encore sur sa vitre l’inscription en arc de cercle : « Vins et liqueurs »."
                                            },
                                            {
                                                "example_id": "019508d3-6fc0-4393-99a8-d0658bc7fd23",
                                                "sense_id": "c5986da6-f554-3e19-8159-8b7ada1d833e",
                                                "text": "La plage microtidale d’Agay, située sur la commune de Saint-Raphaël (83), présente une forme en arc de cercle sur un kilomètre."
                                            },
                                            {
                                                "example_id": "8bc45734-a403-4d8c-a6f7-a8d7b4aac824",
                                                "sense_id": "c5986da6-f554-3e19-8159-8b7ada1d833e",
                                                "text": "sur l'arc de cercle d'un pont\ntu passes de l'autre\ncôté"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
