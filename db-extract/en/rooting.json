                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2c02ced6-5498-473a-a394-e6d8111ec559",
                                "sense_id": "7340c499-0b63-301b-953b-181bb9da8a48",
                                "text": "These rootings may be as deep as two and a half feet, depending on how large a pig has been working."
                            }
                        ]
                    },
