                "senses": [
                    {
                        "sense_id": "9f4a4d56-4b9e-31e7-83df-92779b60906b",
                        "entry_id": "f1d507c4-a509-3f1e-980c-d57ab4085ed5",
                        "glosses": [
                            "Woche im Winter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca9fd24c-d431-4453-bb17-ff0d27c0f4e5",
                                "sense_id": "9f4a4d56-4b9e-31e7-83df-92779b60906b",
                                "text": "„Sie gelten praktisch nur zwei schneereiche Winterwochen lang, vom 3. Januar bis zum 16. Februar 1922.“"
                            },
                            {
                                "example_id": "c2d106bf-5f60-4c69-8841-a30e82ef7bd8",
                                "sense_id": "9f4a4d56-4b9e-31e7-83df-92779b60906b",
                                "text": "„Er sieht seiner Frau nach, dieser Frau, die er in all den Jahren tagtäglich sah, außer in den Winterwochen in Arnarstapi.“"
                            },
                            {
                                "example_id": "77bb285e-1a14-4d30-a41e-5aa60cc1c16a",
                                "sense_id": "9f4a4d56-4b9e-31e7-83df-92779b60906b",
                                "text": "„Die erzwungene Ordnung, die verbissen zur Schau gestellte Routine der Machthaber, geriet in diesen Winterwochen in immer krasseren Gegensatz zur Wirklichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
