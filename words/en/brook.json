                            },
                            {
                                "target_lang_word": "речушка",
                                "target_lang_sense_clarification": "маленькая река"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "strumyk",
                                "target_lang_sense_clarification": "mały strumień"
                            },
                            {
                                "target_lang_word": "potok",
                                "target_lang_sense_clarification": "ciek wodny płynący wartkim nurtem"
                            },
                            {
                                "target_lang_word": "ruczaj",
                                "target_lang_sense_clarification": "poetycko o małym strumyku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca7c6953-e3bc-383c-86a7-2be43080915f",
                    "sense_definition": "To bear, endure, or tolerate something, typically dissent or opposition; usually used in negative sentences.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict teacher stated clearly that she would <w>brook</w> no talking during the exam.",
                            "target_lang_translations": {
                                "ru": "Строгая учительница ясно заявила, что не <w>потерпит</w> разговоров во время экзамена.",
                                "pl": "Surowa nauczycielka jasno oświadczyła, że nie <w>zniesie</w> żadnych rozmów podczas egzaminu."
                            }
                        },
                        {
                            "text": "He is a determined leader who will <w>brook</w> no interference with his plans.",
                            "target_lang_translations": {
                                "ru": "Он решительный лидер, который не <w>допустит</w> вмешательства в свои планы.",
                                "pl": "Jest zdeterminowanym liderem, który nie <w>toleruje</w> żadnej ingerencji w swoje plany."
                            }
                        }
                    ],
                    "synonyms": [
                        "tolerate",
                        "endure",
                        "stand",
                        "allow",
                        "bear",
                        "put up with"
                    ],
                    "common_phrases": [
                        "brook no argument",
                        "brook no delay",
                        "brook no dissent",
                        "brook no interference"
