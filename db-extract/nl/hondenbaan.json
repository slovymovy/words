                "senses": [
                    {
                        "sense_id": "15204dab-534c-3339-806f-9432f9b1d487",
                        "entry_id": "89de916e-22a7-3c3e-b7b7-7772e4ab6977",
                        "glosses": [
                            "heel vervelend, vermoeiend en ondankbaar werk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f71c917-b4f9-413e-b9f4-650b92e11b88",
                                "sense_id": "15204dab-534c-3339-806f-9432f9b1d487",
                                "text": "Gearmd met mevr. R. v. Driel en lachend ging ze weg, weer de woestijn in, 3 uur in een auto, weer lunchen, weer recepties, het is ook een hondenbaan."
                            },
                            {
                                "example_id": "685e905c-d9f8-421f-9253-59363bc07fd2",
                                "sense_id": "15204dab-534c-3339-806f-9432f9b1d487",
                                "text": "Het Kamerlidmaatschap is een 'mooie hondenbaan', schreef mijn partijgenoot Paul Rosenmüller, en vergt een krachtige innerlijke drive. Als ijdelheid je enige brandstof is kom je niet ver. Ik ben ervan overtuigd dat al onze politici echt oprecht een bijdrage willen leveren aan het verbeteren van deze wereld. Iedereen in de Tweede Kamer is, op zijn eigen manier, een idealist."
                            }
                        ]
                    }
