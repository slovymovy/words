                ],
                "senses": [
                    {
                        "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                        "entry_id": "48e00977-51a4-3783-a316-016106fa8c77",
                        "glosses": [
                            "Verzierung, Dekoration einer zubereiteten Speise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc865d81-d530-4b86-a380-fe4921cfe165",
                                "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                "text": "„Ich schiebe die Schale beiseite und sehe hinüber zum Tresen, wo Dylan einen extrem großen Eisbecher bestellt und so ziemlich jede Garnierung draufschüttet, die sie haben.“"
                            },
                            {
                                "example_id": "1875618f-cca8-4458-b228-ec312025f164",
                                "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                "text": "„Bereiten Sie zuerst die Garnierung vor: Geben Sie die gehackten Salatblätter und Dreiviertel der Butter in einen Topf mit schwerem Boden.“"
                            },
                            {
                                "example_id": "b3d7621f-f11c-4005-b098-6165f5abb645",
                                "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                "text": "„Es gibt Barkeeper, die aufgrund der raffinierten und ansprechenden Garnierung ihrer Cocktails Karriere gemacht haben.“"
                            },
                            {
                                "example_id": "787ddb5e-ee23-4283-b4f0-b07b7248d23a",
                                "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                "text": "„Wenden Sie die Pizza und streuen Sie dann Ihre Garnierungen über die gebratene Seite, die nun oben liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
