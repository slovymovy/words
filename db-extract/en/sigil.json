                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd6af41-3480-4306-b555-4b569562b0e6",
                                                "sense_id": "7ec2cfc6-de31-3190-a1a3-034d3845d226",
