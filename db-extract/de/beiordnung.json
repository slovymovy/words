                "senses": [
                    {
                        "sense_id": "d49047aa-9a00-305f-9f57-920faec81863",
                        "entry_id": "630438b3-a981-3004-b9b7-a500d46b160c",
                        "glosses": [
                            "deutscher Ausdruck für Koordination (gleichrangige Verbindung sprachlicher Einheiten im Satz)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ac01c0-d5d5-4881-bd44-ebaab34ef4d7",
                                "sense_id": "d49047aa-9a00-305f-9f57-920faec81863",
                                "text": "Als Beispiel für Beiordnung nennt Sütterlin den Satz: „Mein Bruder wohnt in der Stadt; ich lebe lieber auf dem Lande.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "451f4afe-c4b2-3b8b-9610-18100786f552",
                        "entry_id": "630438b3-a981-3004-b9b7-a500d46b160c",
                        "glosses": [
                            "Zuweisung eines Anwalts zu einer für bedürftig erachteten Prozesspartei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "622ed264-c328-4963-a30e-e08f52e11d9a",
                                "sense_id": "451f4afe-c4b2-3b8b-9610-18100786f552",
                                "text": "„Die Beiordnung eines Rechtsanwaltes erfolgt auf Antrag auch ohne Prüfung der hinreichenden Erfolgsaussicht, wenn die Gegenseite durch einen Rechtsanwalt vertreten wird, § 11 a Arbeitsgerichtsgesetz (ArbGG). Die Beiordnung unterbleibt jedoch, wenn die Klage mutwillig ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
