                                "target_senses": [
                                    {
                                        "sense_id": "1a5bf549-84a0-35e0-99c4-f1419fa39286",
                                        "entry_id": "2dd637f5-7793-3a84-a5df-d812f431f150",
                                        "glosses": [
                                            "Barschartiger, der im Ostatlantik und den nordeuropäischen Küsten lebt, wissenschaftlich Zoarces viviparus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bf5edf4-5d2e-42b5-8706-a45d7edbb99f",
                                                "sense_id": "1a5bf549-84a0-35e0-99c4-f1419fa39286",
                                                "text": "Die Aalmutter hat einen langgestreckten, hinten spitz zulaufenden Körper."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d379eeb-89e5-3b6b-b858-4677d57a044d",
                                        "entry_id": "2dd637f5-7793-3a84-a5df-d812f431f150",
                                        "glosses": [
                                            "eine Gattung der Barschartigen, wissenschaftlich Zoarces"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e1e0ef-c7b5-4d91-a5ac-331f565cb01d",
                                                "sense_id": "7d379eeb-89e5-3b6b-b858-4677d57a044d",
                                                "text": "Die Aalmutter (Zoacres viviparus) ist die namensgebende Art der Gattung und der Familie der Aalmuttern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fdaf1326-9526-32ef-90db-9bf333dacfc7",
                                        "entry_id": "2dd637f5-7793-3a84-a5df-d812f431f150",
                                        "glosses": [
                                            "eine Familie der Barschartigen, wissenschaftlich Zoarcidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1eb341a-42cf-4708-8294-ac719bec9d9f",
                                                "sense_id": "fdaf1326-9526-32ef-90db-9bf333dacfc7",
                                                "text": "„Der Name der Aalmuttern ergibt sich aus dem früheren Glauben, dass die Europäischen Aale von diesen geboren würden.“"
                                            },
                                            {
                                                "example_id": "94fcac27-d11e-4a96-b38f-c3a3887bb946",
                                                "sense_id": "fdaf1326-9526-32ef-90db-9bf333dacfc7",
                                                "text": "Im nördlichen Pazifik leben mehrere endemische Gattungen der Familie der Aalmuttern oder Zoarcidae."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
