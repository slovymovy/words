                    },
                    {
                        "translation_id": "5511fa6d-ff0c-4fee-a31d-544d00834bcf",
                        "source_entry_id": "6b4e947c-be3e-371b-928e-bb99f2c3dd5e",
                        "source_sense_id": "360c13ee-5218-37cc-9119-545f6c920b80",
                        "source_sense_description": "Aggression, die gegen die eigene Person gerichtet ist",
                        "target_lang_word": "automutilation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automutilation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6641b2-3467-32ab-8ec2-53dc27df6e85",
                                        "entry_id": "eca217fc-5fc6-3f97-8035-9c9afeec792e",
                                        "glosses": [
                                            "Mutilation de soi-même, fait de s'infliger des blessures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309e2348-9fa8-4b5b-b281-c83fc01e9194",
                                                "sense_id": "7d6641b2-3467-32ab-8ec2-53dc27df6e85",
                                                "text": "Ils considèrent que ce n’est pas dangereux, que ce n’est pas de l’automutilation, estime Clément Legrand."
                                            },
                                            {
                                                "example_id": "0a6bdfcb-47a9-4eb4-9a3c-07101202ebd6",
                                                "sense_id": "7d6641b2-3467-32ab-8ec2-53dc27df6e85",
                                                "text": "Ils apprirent aussi au Dalaï-lama que certains allaient jusqu'à se blesser volontairement, et que l'automutilation était pratiquée par 10 à 15 % des adolescents européens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87cf10d4-f56b-367d-8e96-a64a90b36dc6",
                                        "entry_id": "eca217fc-5fc6-3f97-8035-9c9afeec792e",
                                        "glosses": [
                                            "Action de se priver soi-même d'une partie de soi."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b0bc3d9-aa3d-4fa1-8805-fcc177a62a58",
                                                "sense_id": "87cf10d4-f56b-367d-8e96-a64a90b36dc6",
                                                "text": "Il y a une espèce de joie sauvage à voir cramer un manuscrit. Deux mois de travail, les pensées d’un instant, des choses qu’on ne retrouvera jamais plus… C’est une automutilation, une espèce de suicide…, ça aussi."
                                            },
                                            {
                                                "example_id": "ab94a426-5daa-4a50-8349-e0251e87ce03",
                                                "sense_id": "87cf10d4-f56b-367d-8e96-a64a90b36dc6",
                                                "text": "Le pullulement de raisons sociales et autres affichages en anglais ressemble à une forme d'automutilation."
                                            },
                                            {
                                                "example_id": "92361e5d-0c7e-4312-9a7b-e3aa3c73652b",
                                                "sense_id": "87cf10d4-f56b-367d-8e96-a64a90b36dc6",
                                                "text": "J’ai peur de la confrontation, alors je me tais. C’est de l’automutilation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6632180a-06b5-487d-b1e3-73ef94cad03e",
                        "source_entry_id": "6b4e947c-be3e-371b-928e-bb99f2c3dd5e",
                        "source_sense_id": "360c13ee-5218-37cc-9119-545f6c920b80",
                        "source_sense_description": "Aggression, die gegen die eigene Person gerichtet ist",
                        "target_lang_word": "auto-agression",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auto-agression",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dddd8c1c-9fb9-389d-9dd2-91ed84b44d56",
                                        "entry_id": "35b514cc-ab62-3499-85a9-7650d9981b51",
                                        "glosses": [
                                            "Agression envers soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af44055c-44a5-4a70-a2c1-4206ad624e0e",
                                                "sense_id": "dddd8c1c-9fb9-389d-9dd2-91ed84b44d56",
                                                "text": "48 auto-agressions sont nettement déclenchées par la jalousie à l’égard des autres enfants dont l’éducatrice s'occupe."
                                            },
                                            {
                                                "example_id": "6a3b2dd2-c241-4884-8921-baab6157c792",
                                                "sense_id": "dddd8c1c-9fb9-389d-9dd2-91ed84b44d56",
                                                "text": "L’auto-agression serait inversement proportionnelle à l’agression dirigée vers autrui et vice versa."
                                            },
                                            {
                                                "example_id": "e7d3cca4-fe87-4520-921a-5ff360542234",
                                                "sense_id": "dddd8c1c-9fb9-389d-9dd2-91ed84b44d56",
                                                "text": "De ce jour lointain, l’agression extérieure réprimée allait venir, de siècle en siècle, renforcer l’auto-agression acquise préhistoriquement sur le corps du père assassiné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
