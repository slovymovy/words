                "senses": [
                    {
                        "sense_id": "81a5e5b4-e56d-34b8-93ac-c4cf04bd2d27",
                        "entry_id": "7ddbc2d6-304a-3b4c-97f4-7c7737edb84c",
                        "glosses": [
                            "Süßware in Form eines Riegels, die aus Schokolade besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "490df62a-62f5-4666-ad49-46bbe7965792",
                                "sense_id": "81a5e5b4-e56d-34b8-93ac-c4cf04bd2d27",
                                "text": "„›Du siehst aus wie ein Schokoladenriegel‹, sagte sie schließlich.“"
                            },
                            {
                                "example_id": "58de9f2f-ee9f-4496-8760-3d6eac340114",
                                "sense_id": "81a5e5b4-e56d-34b8-93ac-c4cf04bd2d27",
                                "text": "„Einige Verkäufer boten warme, klebrige Cola an, Softeis, das ungefähr dreiundvierzig Sekunden später schon geschmolzen war und einem über die Hand lief, dicke Schokoladenriegel von Cadbury, die sich ebenso schnell verflüssigten und einem das Hemd verkleckerten, gesalzene Erdnüsse, die nur ein total Irrer bei diesem Wetter verzehrt hätte, die aber ständig verlangt wurden.“"
                            },
                            {
                                "example_id": "9062b878-3f14-4c16-98c0-fa28bd6035e6",
                                "sense_id": "81a5e5b4-e56d-34b8-93ac-c4cf04bd2d27",
                                "text": "„In einem der Seitenfächer liegen mehrere Schokoladenriegel.“"
                            },
                            {
                                "example_id": "f9ef068b-4b69-4bd5-bf2c-f051123c99a4",
                                "sense_id": "81a5e5b4-e56d-34b8-93ac-c4cf04bd2d27",
                                "text": "„Er zog einen Schokoladenriegel aus der Tasche und begann ihn zu essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
