                "senses": [
                    {
                        "sense_id": "3fd5c5e9-37f4-3d5a-94f9-453f6820e758",
                        "entry_id": "8fd77313-a9ca-38f8-a756-53164e6e782f",
                        "glosses": [
                            "Arbeitsgruppe, die Fernsehaufnahmen macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1baeec22-aab6-460c-86c0-2d7921f4bb81",
                                "sense_id": "3fd5c5e9-37f4-3d5a-94f9-453f6820e758",
                                "text": "„Als ein Fernsehteam der ARD über die Terrorakte berichten will, wird es vom wütenden Mob angegriffen.“"
                            },
                            {
                                "example_id": "6ac4dbda-fe84-44ea-9b3e-d258974b571e",
                                "sense_id": "3fd5c5e9-37f4-3d5a-94f9-453f6820e758",
                                "text": "„Sie wollten nur ihre Arbeit machen, und wurden plötzlich Opfer eines aufgebrachten Mobs — ein Fernsehteam des Südwestrundfunks (SWR) ist bei Dreharbeiten in Kairo von einer Gruppe Ägypter angegriffen worden.“"
                            },
                            {
                                "example_id": "d044d723-56a7-4824-8da7-27c95ae3c4f6",
                                "sense_id": "3fd5c5e9-37f4-3d5a-94f9-453f6820e758",
                                "text": "„Kurz darauf bekam ich die Gelegenheit, die glücklichen Brautleute zusammen mit einem Fernsehteam aus Katowice zu besuchen.“"
                            },
                            {
                                "example_id": "94ac0973-c46b-4adc-aed4-f2bb8d81efa7",
                                "sense_id": "3fd5c5e9-37f4-3d5a-94f9-453f6820e758",
                                "text": "„Etwas mehr als eine Stunde verging, als die ersten Reporter im Tower erschienen, gefolgt von einem Fernsehteam des spanischen Rundfunks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
