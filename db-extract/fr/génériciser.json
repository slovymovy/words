                "senses": [
                    {
                        "sense_id": "3a376bf9-2777-3d01-8dc0-659710435e9c",
                        "entry_id": "711a9cb2-1f07-38bf-8ef5-2966e6d239df",
                        "glosses": [
                            "Donner un caractère générique à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "40448b7e-dea7-40fa-b70a-4fbc08b4d36e",
                                "sense_id": "3a376bf9-2777-3d01-8dc0-659710435e9c",
                                "text": "L’argent en monnaie pose, pour l’objet de l’obligation, la question de ce qui est généricisé."
                            },
                            {
                                "example_id": "337731df-bc9a-460d-bc1f-588b90447718",
                                "sense_id": "3a376bf9-2777-3d01-8dc0-659710435e9c",
                                "text": "Il ne faut cependant pas s’y méprendre, si certains théoriciens tentent de « génériciser » le recueil, ils ne vont pas jusqu’à attribuer une telle unité à tous les recueils ;"
                            },
                            {
                                "example_id": "92f8db51-98cd-4623-85ee-dd9d934b95e9",
                                "sense_id": "3a376bf9-2777-3d01-8dc0-659710435e9c",
                                "text": "Génériciser ou nativiser les TextGrids d'une enquête."
                            }
                        ]
                    }
                ],
