                {
                    "sense_id": "2aa47595-a9b2-3db4-ab82-790eb70ddb7d",
                    "sense_definition": "To need to do something; must.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>got</w> to go study for the test now.",
                            "target_lang_translations": {
                                "ru": "Мне <w>нужно</w> идти готовиться к тесту сейчас.",
                                "fr": "Je <w>dois</w> aller étudier pour l'examen maintenant."
                            }
                        },
                        {
                            "text": "We <w>got</w> to leave early to catch the train.",
                            "target_lang_translations": {
                                "ru": "Нам <w>надо</w> уйти пораньше, чтобы успеть на поезд.",
                                "fr": "Nous <w>devons</w> partir tôt pour attraper le train."
                            }
                        }
