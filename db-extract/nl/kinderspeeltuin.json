                        "source_sense_id": "569df4ee-4f4f-3422-9203-a2b7089e674c",
                        "target_lang_word": "playground",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playground",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "A large open space for children to play in, usually having dedicated play equipment (such as swings and slides)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89c6887-7417-4180-b43b-1840ffb6711c",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "The kids have to go to the playground during recess, no matter the weather."
                                            },
                                            {
                                                "example_id": "81f8f73c-9c8b-458b-9b0a-c315e4067230",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "The local council have set up a new playground, equipped with slides, swings, and a climbing wall."
                                            },
                                            {
                                                "example_id": "9296211f-5b27-42b7-9f0a-0b28bf2f263d",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "Any physical or metaphysical space in which a person or organization has free rein to do as they please."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bf7cf8e-9a25-470f-9187-ac1beff6a217",
                                                "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                                "text": "The exclusive tropical island was a millionaire's playground."
                                            },
                                            {
                                                "example_id": "8271b7cf-89c4-4a19-9571-e910c334a078",
                                                "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                                "text": "Kjelsås (six miles) marks the end of the suburbs, and the line immediately plunges into Nordmarka. This vast untamed area of forest and mountain (much of it over 2,000 ft. above sea level), interspersed with innumerable lakes, large and small, is known as Oslo's playground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37c8473-d51b-3c12-aa38-3dc2ed5145b9",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "A sandbox for testing calls to an application programming interface."
                                        ],
