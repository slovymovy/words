                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strokes",
                                "target_lang_sense_clarification": "plural of a gentle touch"
                            },
                            {
                                "target_lang_word": "pets",
                                "target_lang_sense_clarification": "plural of an act of petting"
                            }
                        ]
                    }
                }
            ]
        }
    ]
