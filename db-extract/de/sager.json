                                "sense_id": "b0651b0e-38f7-310b-afcf-e73be97cc0aa",
                                "text": "Deutsche TV-Moderatorin nach Nazi-Sager entlassen (article headline)",
                                "translation": "German TV presenter fired after Nazi remark",
                                "english": "German TV presenter fired after Nazi remark"
                            }
                        ]
