            {
                "entry_id": "e4740442-b54e-385c-8727-9be4563e3f12",
                "word": "Jurassien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d181975f-955e-4c31-add2-b45c95f19fc1",
                        "entry_id": "e4740442-b54e-385c-8727-9be4563e3f12",
                        "tags": [
                            "plural"
                        ],
                        "form": "Jurassiens"
                    },
                    {
                        "form_id": "972fe39c-2b4b-424a-9527-ff9b276e7a20",
                        "entry_id": "e4740442-b54e-385c-8727-9be4563e3f12",
                        "tags": [
                            "feminine"
                        ],
                        "form": "Jurassienne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e2f9364-daad-3980-b777-2c86b7756cf6",
                        "entry_id": "e4740442-b54e-385c-8727-9be4563e3f12",
                        "glosses": [
                            "Personne habitant ou qui est originaire du département du Jura en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22601f9f-5f9b-44c7-ba19-2cce99abad74",
                                "sense_id": "6e2f9364-daad-3980-b777-2c86b7756cf6",
                                "text": "Il faut s’imposer ; Robic l’a bien prouvé pendant le Tour de France 1948. Un Jurassien n’en fait qu’à sa tête. On dira : le grand Jurassien Bernard Busard, Busard l’indomptable…"
                            },
                            {
                                "example_id": "0285111b-3876-431b-b5f1-318e5bf6f8c4",
                                "sense_id": "6e2f9364-daad-3980-b777-2c86b7756cf6",
                                "text": "Et quand un Jurassien imite l'accent normand, ça déclenche une poilade à laquelle se joint Ambroise afin d'ignorer la petite vacherie de Paroli."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d6344a0-e387-3a0f-a455-e2b09013f499",
                        "entry_id": "e4740442-b54e-385c-8727-9be4563e3f12",
                        "glosses": [
                            "Membre de l’Internationale qui faisait partie de la Fédération jurassienne."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "81171576-265f-4d36-84b8-5a9b8ef2c891",
                                "sense_id": "2d6344a0-e387-3a0f-a455-e2b09013f499",
                                "text": "Après que toutes les fédérations organisées aient répudié le Congrès de La Haye, les Jurassiens convoquèrent en 1873 un congrès général à Genève pour continuer l'Internationale sans le Conseil Général."
                            }
                        ]
                    }
                ],
