                "senses": [
                    {
                        "sense_id": "832b607d-92fb-3908-b9af-b3b597e76108",
                        "entry_id": "4c791988-179d-3278-8b18-95c6eec4081a",
                        "glosses": [
                            "Utiliser la géothermie pour le chauffage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "748af1de-3003-463c-a5bb-7ecee9353e0d",
                                "sense_id": "832b607d-92fb-3908-b9af-b3b597e76108",
                                "text": "Je vais de ce pas géothermiser mon énergie dans cette mission complètement folle !"
                            },
                            {
                                "example_id": "76793cf9-d5cb-4791-8331-690f3b753e06",
                                "sense_id": "832b607d-92fb-3908-b9af-b3b597e76108",
                                "text": "La géothermie de surface amélioré à un rapport d'une surface à « géothermiser » pour une surface à chauffer au lieu de quatre surfaces à « géothermiser » pour une surface à chauffer."
                            },
                            {
                                "example_id": "4f657562-2969-46b6-b15b-5ce656f6c153",
                                "sense_id": "832b607d-92fb-3908-b9af-b3b597e76108",
                                "text": "En tout cas, je connais des occupants d'un appartement de Chelles \"géothermisé\" qui payent aussi cher voire davantage qu'avec un chauffage classique, pour un service assez médiocre."
                            }
                        ]
                    }
