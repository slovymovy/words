                "senses": [
                    {
                        "sense_id": "75f937b6-88ca-38ce-b2f4-b5b53813ca6e",
                        "entry_id": "7d84c6b8-e0e1-3b40-a846-1acd0936104b",
                        "glosses": [
                            "iniquity, misdeed (evil, sinful, dishonorable deed)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "6c865fdf-cb2c-4270-8555-c8903053f146",
                                "sense_id": "75f937b6-88ca-38ce-b2f4-b5b53813ca6e",
                                "text": "Wegen dieser Missetat sollt ihr mit ewigem Fluch belegt sein!",
                                "translation": "For this iniquity an eternal curse shall be upon you!",
                                "english": "For this iniquity an eternal curse shall be upon you!"
                            },
                            {
                                "example_id": "4d2707ef-8cc7-4fe8-a563-f6b2ed5280d0",
                                "sense_id": "75f937b6-88ca-38ce-b2f4-b5b53813ca6e",
                                "text": "Die Liste seiner Missetaten war lang.",
                                "translation": "The list of his misdeeds was long.",
                                "english": "The list of his misdeeds was long."
                            }
                        ]
                    }
                ],
