                "senses": [
                    {
                        "sense_id": "3a43a52c-0a68-3221-837e-e649b227bab5",
                        "entry_id": "fb6b7a9d-ebc6-313f-8711-4ae5fc5fa69e",
                        "glosses": [
                            "назойливо пристающий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a617275-d96c-4e5b-88a2-7574e7feffdc",
                                "sense_id": "3a43a52c-0a68-3221-837e-e649b227bab5",
                                "text": "Объявляю вам, что я хочу быть откровенным, хотя и чувствую, что вы имеете полное право принять меня за довольно навязчивого человека."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e87e4fa-701f-435c-b632-a4441b485414",
                        "source_entry_id": "fb6b7a9d-ebc6-313f-8711-4ae5fc5fa69e",
                        "source_sense_id": "3a43a52c-0a68-3221-837e-e649b227bab5",
                        "target_lang_word": "obtrusive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obtrusive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97781dac-c14e-3a07-9ffc-728b71e4e248",
                                        "entry_id": "26c04290-c63c-3b62-b2c4-15a328e0d994",
                                        "glosses": [
                                            "Of a person: overly assertive, bold, or domineering; pushy; also, ostentatious."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7e7acdb-378c-4da8-ae29-c40cb4fa9f45",
                                                "sense_id": "97781dac-c14e-3a07-9ffc-728b71e4e248",
                                                "text": "The office manager is an unpleasantly obtrusive individual."
                                            },
                                            {
                                                "example_id": "4207e84f-e5a3-4b2a-8428-4e79857c8457",
                                                "sense_id": "97781dac-c14e-3a07-9ffc-728b71e4e248",
                                                "text": "Her vertue and the conſcience of her worth, / That would be woo'd, and not unfought be won, / Not obvious, not obtruſive, but retir'd, / The more deſirable, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23b9f692-bfb8-37cf-b5f3-4a6e0c84707c",
                                        "entry_id": "26c04290-c63c-3b62-b2c4-15a328e0d994",
                                        "glosses": [
                                            "Of a thing: noticeable or prominent, especially in a displeasing way."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9baa069-a661-4474-a406-8297a183802b",
                                                "sense_id": "23b9f692-bfb8-37cf-b5f3-4a6e0c84707c",
                                                "text": "He has an obtrusive forehead."
                                            },
                                            {
                                                "example_id": "4d0d5d56-230a-46e8-830c-d9b746d765b3",
                                                "sense_id": "23b9f692-bfb8-37cf-b5f3-4a6e0c84707c",
                                                "text": "Thus it was that, year by year, Boss McGinty's diamond pins became more obtrusive, his gold chains more weighty across a more gorgeous vest, and his saloon stretched farther and farther, until it threatened to absorb one whole side of the Market Square."
                                            },
                                            {
                                                "example_id": "2d056ef4-bffa-4d47-8209-d5515db1deea",
                                                "sense_id": "23b9f692-bfb8-37cf-b5f3-4a6e0c84707c",
                                                "text": "But there was a third principal in this primitive drama, the wife of Essenden, a woman of great energy, great possessiveness and obtrusive helpfulness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87ad565c-ea8d-3721-98ae-ceafceb530e3",
                                        "entry_id": "26c04290-c63c-3b62-b2c4-15a328e0d994",
                                        "glosses": [
                                            "Protruding or sticking out, especially in a way that obstructs."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb10b632-402c-444a-85fa-185ba26b7da8",
                                                "sense_id": "87ad565c-ea8d-3721-98ae-ceafceb530e3",
                                                "text": "The facade of the building was ornamented with obtrusive sculpted designs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5707e860-1033-4cc2-afcf-bd35561e6b86",
                        "source_entry_id": "fb6b7a9d-ebc6-313f-8711-4ae5fc5fa69e",
                        "source_sense_id": "3a43a52c-0a68-3221-837e-e649b227bab5",
                        "target_lang_word": "importunate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "importunate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b9dcd6a-9fe5-3017-afe3-54507f81c91e",
                                        "entry_id": "3a9a38ff-f3eb-370f-a8c0-929df95b957e",
                                        "glosses": [
                                            "Persistent or pressing, often annoyingly so."
                                        ],
                                        "tags": [
                                            "of a demand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5ec05c-1573-4fc3-8a86-61f837995f5b",
                                                "sense_id": "0b9dcd6a-9fe5-3017-afe3-54507f81c91e",
                                                "text": "Nick was on the point of declaring again that he was a humbug, so vivid was his inner sense of what he thought of his factitious public utterances, which had the cursed property of creating dreadful responsibilities and importunate credulities for him."
                                            },
                                            {
                                                "example_id": "72c5f2aa-ce51-4941-bc11-c50d7c05b4f6",
                                                "sense_id": "0b9dcd6a-9fe5-3017-afe3-54507f81c91e",
                                                "text": "Trembling in every limb I raise my loud im­portunate cry,\nAnd in a sacred terror wait the Delian god’s reply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ba1d892-2bf2-32db-882c-c1a3cd759413",
                                        "entry_id": "3a9a38ff-f3eb-370f-a8c0-929df95b957e",
                                        "glosses": [
                                            "Given to importunate demands, greedily or thoughtlessly demanding."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "importunate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d19d2ae1-a29f-36ad-b97a-ff41b1dfe66d",
                                        "entry_id": "74f54d12-a9a1-3b50-84e4-24ed4cc2a842",
                                        "glosses": [
                                            "An importuner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eceec7cc-eff7-409c-828a-1273d24520c5",
                                                "sense_id": "d19d2ae1-a29f-36ad-b97a-ff41b1dfe66d",
                                                "text": "This will put an Answer into the Kings mouth, against all importunates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "importunate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "380a514c-3ce4-3a6c-bcb2-0c27875f9b2e",
                                        "entry_id": "cefd7a7a-b5f0-3285-94ba-dc66107b4725",
                                        "glosses": [
                                            "To importune, or to obtain by importunity."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49dd3027-980f-4aae-9e00-d1afa22f723c",
                                                "sense_id": "380a514c-3ce4-3a6c-bcb2-0c27875f9b2e",
                                                "text": "All which notwithstanding, I obtained licence at length to make my supplication to the noble Parliament house; but I could find no messengers till Sir John Seton went, whom I importunated daily to obtain me favor for my return home again."
                                            },
                                            {
                                                "example_id": "baa346bf-bd1e-4256-b14d-2659650877d6",
                                                "sense_id": "380a514c-3ce4-3a6c-bcb2-0c27875f9b2e",
                                                "text": "Is my work ended? The fear of importunating my friends answers, “Yes.”"
                                            },
                                            {
                                                "example_id": "cd3ca0b0-8909-430f-b219-f0a6820aa601",
                                                "sense_id": "380a514c-3ce4-3a6c-bcb2-0c27875f9b2e",
                                                "text": "It is the concrete that impresses, that importunates until it influences—in writing as in everything else."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82334ca0-d3e0-458b-b889-77b2b4366f1c",
                        "source_entry_id": "fb6b7a9d-ebc6-313f-8711-4ae5fc5fa69e",
                        "source_sense_id": "3a43a52c-0a68-3221-837e-e649b227bab5",
                        "target_lang_word": "zudringlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zudringlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06f1038a-790d-3f04-8e6b-11912ac3bde3",
                                        "entry_id": "fae61dea-0855-374d-bb15-bebfee3a6484",
                                        "glosses": [
                                            "nicht die nötige oder erwartete Distanz wahrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc6d138-0da4-41e6-b284-7c09c3d6f33e",
                                                "sense_id": "06f1038a-790d-3f04-8e6b-11912ac3bde3",
                                                "text": "„Im Nachhinein habe die Antragsgegnerin von anderen Arbeitskolleginnen gehört, dass er relativ zudringlich gewesen sei.“"
                                            },
                                            {
                                                "example_id": "9e058b8c-46de-429c-b9f3-4015920c7859",
                                                "sense_id": "06f1038a-790d-3f04-8e6b-11912ac3bde3",
                                                "text": "„Dort wurde er von einer Meute zudringlicher Reporter empfangen, was ihn veranlaßte, zunächst nach London zu fliehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57ec2d44-83b8-4c09-a4c5-d0ab9b8b103c",
                        "source_entry_id": "fb6b7a9d-ebc6-313f-8711-4ae5fc5fa69e",
                        "source_sense_id": "3a43a52c-0a68-3221-837e-e649b227bab5",
                        "target_lang_word": "aufdringlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufdringlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf33208-bb72-3133-8cb7-f2266d89b548",
                                        "entry_id": "7fceb0c1-fce7-3605-9502-e1af34473ebe",
                                        "glosses": [
                                            "persönliche Grenzen ignorierend; durch invasives Verhalten störend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1b7a0b-c937-4ff9-8876-80b23a82e88e",
                                                "sense_id": "ddf33208-bb72-3133-8cb7-f2266d89b548",
                                                "text": "Ich vermeide Diskothekenbesuche wegen der aufdringlichen Macker."
                                            },
                                            {
                                                "example_id": "4cb4557a-d753-4528-ad61-95099c263bd0",
                                                "sense_id": "ddf33208-bb72-3133-8cb7-f2266d89b548",
                                                "text": "Die Farbe dieses Jogginganzuges ist ganz schön aufdringlich."
                                            }
                                        ],
