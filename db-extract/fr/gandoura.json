                    }
                ],
                "senses": [
                    {
                        "sense_id": "83a22150-8faf-373a-bda4-d1de3d41aebe",
                        "entry_id": "2ef8b59b-bf4f-3e34-b473-95cbb74bcdeb",
                        "glosses": [
                            "Tunique sans manche portée au Maghreb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12db93c6-ae4f-4bb1-8d7c-79a299b92e8a",
                                "sense_id": "83a22150-8faf-373a-bda4-d1de3d41aebe",
                                "text": "Sa blondeur s’accusait au contraste d’une gandoura pourpre et or, sous laquelle on devinait un simple linon sur la peau."
                            },
                            {
                                "example_id": "d4ca3dee-e33a-4397-a493-d92647e0bf3d",
                                "sense_id": "83a22150-8faf-373a-bda4-d1de3d41aebe",
                                "text": "Hama Srir, à demi couché près de moi, tira son matoui (petit sac en filali pour le kif) et sa petite pipe. Je portais, moi aussi, dans la poche de ma gandoura, ces insignes du véritable Soufi. Nous commençâmes à fumer."
                            },
                            {
                                "example_id": "3df59126-2802-425a-a72f-7f7b2588283d",
                                "sense_id": "83a22150-8faf-373a-bda4-d1de3d41aebe",
                                "text": "Après quoi le drapeau s'incline à quatre-vingt-quinze degrés et la fanfare attaque « Si tu n'en veux pas, je la remets dans ma gandoura »."
                            },
                            {
                                "example_id": "22a52e5f-fdcd-42e3-bb37-24d71beef610",
                                "sense_id": "83a22150-8faf-373a-bda4-d1de3d41aebe",
                                "text": "Ils portaient, en guise de gandouras, des sacs de jute grossièrement rafistolés et ils étaient pieds nus."
                            }
                        ]
                    }
                ],
