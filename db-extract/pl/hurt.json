                                        "entry_id": "c3f735bc-1c36-3ebd-97e6-4c11abb8dc51",
                                        "glosses": [
                                            "To sell at wholesale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f29c570-3846-4bd3-a371-ccd1cc9563a6",
