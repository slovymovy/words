                    {
                        "sense_id": "afd84bf3-a496-37ed-bc5a-7bd7a4a38bf1",
                        "entry_id": "3b2a3b68-d858-391a-a9b0-d4607af9c07f",
                        "glosses": [
                            "Pufferspeicher aus Kiesschichten, um Regenwasser aufzunehmen und versickern zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4849458e-a4b3-4e43-91ec-87673eb54cfb",
                                "sense_id": "afd84bf3-a496-37ed-bc5a-7bd7a4a38bf1",
                                "text": "Zur Zeit werden Rigolen am Lärmschutzwall der Bundesstraße 56 in Höhe des Baugebiets Am Mühlenbach eingebaut."
                            }
