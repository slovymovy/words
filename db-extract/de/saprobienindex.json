                "senses": [
                    {
                        "sense_id": "0d5bb1d6-0763-393e-8617-924769d3f50b",
                        "entry_id": "ee23bfd3-42a6-3379-be36-047aed85756b",
                        "glosses": [
                            "Maßstab für die Güteklasse eines Gewässers anhand darin lebender Organismen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea1d053d-f1f4-46d2-8f46-169cd99bacb9",
                                "sense_id": "0d5bb1d6-0763-393e-8617-924769d3f50b",
                                "text": "„Mithilfe des auf diese Weise ermittelten Saprobienindex kann das untersuchte Gewässer einer Gewässergüteklasse zugeordnet werden.“"
                            },
                            {
                                "example_id": "92578ebe-8a27-418d-8702-8e011ac5c21d",
                                "sense_id": "0d5bb1d6-0763-393e-8617-924769d3f50b",
                                "text": "„So haben Untersuchungen aus dem Jahr 2001 gezeigt, dass der Saprobienindex in der Wedeler Au im Oberlauf unmittelbar nach Starkregen und Überlaufereignissen schlechter wird.“"
                            },
                            {
                                "example_id": "ec26cbbc-1ee3-4ecf-86c2-16b100dfaa83",
                                "sense_id": "0d5bb1d6-0763-393e-8617-924769d3f50b",
                                "text": "„Für die Berechnung des Saprobienindex bekommt jede verwendete Art einen Saprobienwert entsprechend ihrer Indikatoreigenschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
