                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600d4dc1-3567-4255-a1d4-048624c4c7fb",
                                "sense_id": "b94b0854-d9fa-33ca-a6ab-a071aacff7cb",
                                "text": "„Sie hatte viel Gewicht verloren, der linke Lungenflügel war stark geschädigt.“"
                            },
                            {
                                "example_id": "89731bb4-6664-4b95-a8f1-6fdcf140ec2f",
                                "sense_id": "b94b0854-d9fa-33ca-a6ab-a071aacff7cb",
                                "text": "„Er war durch den rechten Lungenflügel geschossen worden.“"
                            },
                            {
                                "example_id": "40072479-431d-494a-9413-0faa1e7ba3a1",
                                "sense_id": "b94b0854-d9fa-33ca-a6ab-a071aacff7cb",
                                "text": "„Der Gedanke ließ mich nicht los: Ich muß die See sehen, die Weite des Himmels atmen, frische Luft in meine Lungenflügel pumpen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
