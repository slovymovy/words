                "forms": [],
                "senses": [
                    {
                        "sense_id": "b91eeedb-1f42-39eb-8ea6-6d82517321a6",
                        "entry_id": "ece5085a-65e9-39d9-b621-34b0ecfecc21",
                        "glosses": [
                            "Surnom de la marine militaire française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de77bd8f-b4a3-4be8-8af3-da7bfeb5089a",
                                "sense_id": "b91eeedb-1f42-39eb-8ea6-6d82517321a6",
                                "text": "S'engager dans la marine, dans la Royale, c'est d'abord et avant tout s'engager pour un certain mode de vie nomade fait essentiellement de navigation."
                            }
                        ]
                    }
                ],
                "translations": [],
