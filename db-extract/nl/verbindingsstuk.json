                        "sense_id": "ab7d8cd2-eefc-3652-82ba-760f5f5aeb38",
                        "entry_id": "7fa15625-dfb6-318b-a042-7891e11fda1d",
                        "glosses": [
                            "voorwerp dat twee zaken aan elkaar verbindt"
