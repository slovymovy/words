                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a56744-c3e3-4ec4-ae7b-69c704cb1f6f",
                                "sense_id": "e521e030-c8bc-3d04-9f36-aac8094d77db",
                                "text": "Un colorant de synthèse aura une nombreuse descendance : le bleu de méthylène, plus précisément un de ces dérivés appelé la phénothiazine."
                            },
                            {
                                "example_id": "c4117447-0d8f-48a8-a763-45b66238dd7d",
                                "sense_id": "e521e030-c8bc-3d04-9f36-aac8094d77db",
                                "text": "L’indication principale des phénothiazines neuroleptiques est le traitement des psychoses aiguës ou chroniques de l’adulte."
