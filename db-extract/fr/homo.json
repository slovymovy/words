                "senses": [
                    {
                        "sense_id": "5c4df6c7-b157-38aa-9ffa-a2fa9a6855bb",
                        "entry_id": "322d991e-7378-38ad-9315-69eeec4ee63f",
                        "glosses": [
                            "Homosexuel."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4d5a1ded-5bd6-4127-a92f-73fd40d14cca",
                                "sense_id": "5c4df6c7-b157-38aa-9ffa-a2fa9a6855bb",
                                "text": "C’était comme si trois heures passées dans une disco homo avaient complètement transformé sa personnalité."
                            },
                            {
                                "example_id": "8ce68be3-f66f-45b9-83ce-ace715a784a0",
                                "sense_id": "5c4df6c7-b157-38aa-9ffa-a2fa9a6855bb",
                                "text": "Les opposants au mariage homo à Paris pour une démonstration de force"
                            },
                            {
                                "example_id": "a605b479-62e7-460c-81ad-558560a38d3f",
                                "sense_id": "5c4df6c7-b157-38aa-9ffa-a2fa9a6855bb",
                                "text": "Il a déjà prévenu ses adjoints : si l’occasion se présentait, il ne procéderait pas au mariage d’un couple homo."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
