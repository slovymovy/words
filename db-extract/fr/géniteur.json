                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c50c2d89-146f-4ed5-b31a-fbb475419faf",
                        "entry_id": "6c23aba7-c3b6-389e-b558-a5a87708877c",
                        "tags": [
                            "plural"
                        ],
                        "form": "géniteurs"
                    },
                    {
                        "form_id": "2bbdaf93-7c77-4d81-9b78-ccaed7013712",
                        "entry_id": "6c23aba7-c3b6-389e-b558-a5a87708877c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "génitrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7ceeda6-df87-3898-a220-1919ffc40941",
                        "entry_id": "6c23aba7-c3b6-389e-b558-a5a87708877c",
                        "glosses": [
                            "Celui qui engendre ; père (du point de vue biologique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4acda117-58d8-438d-b036-d9a2c9de3118",
                                "sense_id": "d7ceeda6-df87-3898-a220-1919ffc40941",
                                "text": "j’aurais aimé tout garder\ntout, sauf leurs géniteurs\net ma peine"
                            },
                            {
                                "example_id": "18211944-c5bf-46f9-91bd-e33defd13c0d",
                                "sense_id": "d7ceeda6-df87-3898-a220-1919ffc40941",
                                "text": "Mais il existe des sociétés où le géniteur n’entretient aucune relation sociale, juridique ou affective avec ses enfants."
                            },
                            {
                                "example_id": "681b4a86-9877-43bb-ba41-8be25a9f65cf",
                                "sense_id": "d7ceeda6-df87-3898-a220-1919ffc40941",
                                "text": "Contrairement à ses frères, Joseph Antoine l’aîné, Vincent et Nicolas, les deux puînés, qui marchaient dans les pas de leur géniteur, Michele ne se voyait pas toute sa vie garder les chèvres et les mulets, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "14d6715b-32c9-3f04-aeed-833ed5693962",
                        "entry_id": "6c23aba7-c3b6-389e-b558-a5a87708877c",
                        "glosses": [
                            "Personne ayant joué un rôle équivalent a celui de père."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b6ed3911-82fe-494d-96ef-586e0851a462",
                                "sense_id": "14d6715b-32c9-3f04-aeed-833ed5693962",
                                "text": "Telle Cordélia, la fille insolente de Lear, Martine Vassal, candidate d’une certaine continuité, a pris une distance ostensible envers son géniteur politique. «Je ne suis pas son héritière», dit-elle, reniant en apparence une longue carrière dans les allées tortueuses du gaudinisme triomphant."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0ad75bd-1310-3b3f-80be-d7d470842d73",
                        "entry_id": "6c23aba7-c3b6-389e-b558-a5a87708877c",
                        "glosses": [
                            "Personne créant des choses assimilées à un être vivant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5a3e6e22-f497-4f38-b57d-7e4fa71938a8",
                                "sense_id": "b0ad75bd-1310-3b3f-80be-d7d470842d73",
                                "text": "… nous sommes tous par essence usagers et géniteurs de mots et, ce faisant, nous représentons un dictionnaire à nous seuls. À sans cesse enrichir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a51d831-4967-49b5-b308-d8afc0d939fc",
                        "source_entry_id": "6c23aba7-c3b6-389e-b558-a5a87708877c",
                        "source_sense_description": "celui qui engendre",
                        "target_lang_word": "Erzeuger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzeuger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14bb55a2-96d1-3b86-b9f6-d525ae097ed8",
                                        "entry_id": "81492d76-cdbd-3a7b-b96d-695a6885b697",
                                        "glosses": [
                                            "Hersteller eines Produktes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db15fca-8ea8-4eb1-8b41-aeef2efb5135",
                                                "sense_id": "14bb55a2-96d1-3b86-b9f6-d525ae097ed8",
                                                "text": "Die Erzeuger des Fahrzeuges wollen die Lampen verbessern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                        "entry_id": "81492d76-cdbd-3a7b-b96d-695a6885b697",
                                        "glosses": [
                                            "genetischer Vater eines Nachwuchses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdd01556-dbbc-4f4b-a36a-8e7b721ea474",
                                                "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                                "text": "Er mag zwar mein Erzeuger sein, aber du warst immer mein Vater für mich."
                                            },
                                            {
                                                "example_id": "14309c3f-d8e1-442c-b4fb-aeaf731c10f3",
                                                "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                                "text": "„Ich sah ihn als Erzeuger, nicht als Vater.“"
                                            },
                                            {
                                                "example_id": "ba88c0dd-dc33-4e5f-85a9-1b570ef5b4fe",
                                                "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                                "text": "„Ihnen verbot der Gouverneur kurzerhand das Recht, den Namen ihres deutschen Vaters zu führen, denn die Erzeuger sollten inkognito bleiben.“"
                                            },
                                            {
                                                "example_id": "56ad9013-ceae-4bf1-a3c8-3b8b3ae6052a",
                                                "sense_id": "cec82189-0ebd-3f40-b001-cfb331da70f4",
                                                "text": "„Nachdem sich mein Herr Erzeuger davongemacht hatte, zogen meine Mutter, meine Oma und ich nach Newcastle — das heißt, nach Newcastle-under-Lyme, nicht weit von Stoke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5dc5f3d-7eed-487e-9cde-1c5763f2d7da",
                        "source_entry_id": "6c23aba7-c3b6-389e-b558-a5a87708877c",
