                        "glosses": [
                            "A simple wooden harp or zither used in central and eastern Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a621b3b0-fa2f-40c8-825c-926aceaf1af8",
                                "sense_id": "8c4b446d-86ff-383d-94b6-39f0d66917a8",
                                "text": "The \"shoulder harp\" or \"nanga\" had a boat-shaped sound chest."
                            },
                            {
                                "example_id": "e2e0d6d8-d2c9-4f5c-a040-c7de52123f87",
                                "sense_id": "8c4b446d-86ff-383d-94b6-39f0d66917a8",
                                "text": "The nanga of Nubia is similar; here also, long wooden pegs prevent the strings from slipping."
                            },
                            {
                                "example_id": "b92962df-65dc-480d-8f1f-a0c7739c8a4a",
                                "sense_id": "8c4b446d-86ff-383d-94b6-39f0d66917a8",
                                "text": "The artist uses his voice, he sings his laws to the accompaniment of the nanga, the harp; he twists his body to the rhythm of the drums, to proclaim his rules."
                            }
                        ]
