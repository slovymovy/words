    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7525821c-1d56-38b4-af2b-ff0a0b21a0f1",
                    "sense_definition": "S'empêcher volontairement d'agir ou se priver de l'usage d'une chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renoncement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a vivement conseillé de s'<w>abstenir</w> d'alcool pendant tout son traitement."
                        },
                        {
                            "text": "Devant cette question embarrassante, le porte-parole a préféré s'<w>abstenir</w> de tout commentaire."
                        }
                    ],
                    "synonyms": [
                        "se priver",
                        "se retenir",
                        "renoncer"
                    ],
                    "antonyms": [
                        "s'adonner",
                        "consommer"
                    ],
                    "common_phrases": [
                        "s'abstenir de tout commentaire",
                        "s'abstenir de fumer"
                    ]
                },
                {
                    "sense_id": "02c7d2e4-88e8-3d31-aee0-cbca1f5d157f",
                    "sense_definition": "Ne pas exprimer de suffrage ou ne pas participer à un scrutin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une grande partie des jeunes citoyens ont choisi de s'<w>abstenir</w> lors des dernières élections."
                        },
                        {
                            "text": "Trois membres du conseil municipal ont décidé de s'<w>abstenir</w> lors du vote du budget."
                        }
                    ],
                    "antonyms": [
                        "voter"
                    ],
                    "common_phrases": [
                        "s'abstenir lors du vote"
                    ]
                },
                {
                    "sense_id": "4987bf18-29b3-3b71-919d-984c8d91edd4",
                    "sense_definition": "Renoncer à exercer un droit, une compétence légale ou une fonction officielle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison d'un conflit d'intérêts évident, le magistrat s'<w>abstient</w> de juger cette affaire."
                        },
                        {
                            "text": "L'un des héritiers désignés s'est formellement <w>abstenu</w> de réclamer sa part de succession."
                        }
                    ],
                    "synonyms": [
                        "se récuser"
                    ]
                },
                {
                    "sense_id": "98db06c8-094e-3678-85a7-ff3755d074b8",
                    "sense_definition": "Empêcher ou dissuader quelqu'un d'accomplir une action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "empechement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La violence de l'orage a soudainement <w>abstenu</w> les promeneurs d'entrer dans la forêt."
                        },
                        {
                            "text": "Ces menaces répétées ont fini par <w>abstenir</w> les témoins d'aller faire une déposition."
                        }
                    ],
                    "synonyms": [
                        "dissuader",
                        "empêcher"
                    ],
                    "antonyms": [
                        "inciter",
                        "encourager"
                    ],
                    "traits": [
