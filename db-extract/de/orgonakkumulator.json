                        "sense_id": "e2ed468d-8cd0-32ca-aed2-024d42f3ddcd",
                        "entry_id": "8bd2f3ba-56d6-39d9-bca4-68a2a6cea891",
                        "glosses": [
                            "Vorrichtung zum Sammeln der hypothetischen Orgonenergie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012f7450-ed84-4cde-8c13-d85b4f2d91b2",
                                "sense_id": "e2ed468d-8cd0-32ca-aed2-024d42f3ddcd",
                                "text": "„Nebenbei baute er einen sonderbaren Kasten: den Orgonakkumulator, der jene Lebensenergie sammeln und sie an den Klienten, der in ihm Platz nimmt, abgeben soll.“"
                            },
                            {
                                "example_id": "ada123c1-4259-4a2f-9406-1c1f8a308ff8",
                                "sense_id": "e2ed468d-8cd0-32ca-aed2-024d42f3ddcd",
                                "text": "„Reich verkaufte oder vermietete mehrere hundert Orgonakkumulatoren an Patienten mit einem Heilversprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
