                ],
                "senses": [
                    {
                        "sense_id": "2b1f504e-43e7-3f4d-a1a1-1fbdc512ebd3",
                        "entry_id": "a1eaf0b2-f4f8-3c97-88a4-316ea8ae0b31",
                        "glosses": [
                            "Anlage für den Umschlag von Containern zwischen den verschiedenen Verkehrsträgern"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "a0f9aba3-5136-4401-b382-47a4391cea53",
                                "sense_id": "2b1f504e-43e7-3f4d-a1a1-1fbdc512ebd3",
                                "text": "Für den Ausbau des Containerterminals musste ein Waldstück gerodet werden."
                            },
                            {
                                "example_id": "5a12e822-68ab-460b-b9b9-2c7b2cf4f55b",
                                "sense_id": "2b1f504e-43e7-3f4d-a1a1-1fbdc512ebd3",
                                "text": "„Acht bis neun Frachttage - so viel würden die Chinesen einsparen, wenn sie ihre Exportwaren nicht mehr über die Nordseehäfen, sondern über ihr Containerterminal in Piräus nach Zentraleuropa bringen könnten.“"
                            },
                            {
                                "example_id": "609d4aee-fab3-49df-b270-5be42301d532",
                                "sense_id": "2b1f504e-43e7-3f4d-a1a1-1fbdc512ebd3",
                                "text": "„Die Karawanenstraßen des 21. Jahrhunderts werden aus allen Richtungen Afrikas an den Containerterminal Bagamoyos führen, mit unvorhersehbaren Auswirkungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
