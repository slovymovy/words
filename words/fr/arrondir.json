                    "frequency": "High",
                    "semantic_group_id": "calcul",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour simplifier le calcul, nous allons <w>arrondir</w> la somme à l'entier le plus proche."
                        },
                        {
                            "text": "Le commerçant a accepté d'<w>arrondir</w> le prix total pour éviter de chercher la petite monnaie."
                        }
                    ],
                    "common_phrases": [
