                "senses": [
                    {
                        "sense_id": "76d2b69e-3ad7-310b-9203-0e51d9dec122",
                        "entry_id": "92bab1db-9e37-395a-a6cb-f1cbf53e2e30",
                        "glosses": [
                            "истор. житель или уроженец Леванта; представитель католического населения средневековых государств Ближнего Востока"
                        ],
                        "tags": [],
