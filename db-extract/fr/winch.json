                    },
                    {
                        "form_id": "d1ba16d3-8c53-4877-a1cf-56c536c6591b",
                        "entry_id": "62900e74-1091-331e-9399-ab96e59c1abf",
                        "tags": [
                            "plural"
                        ],
                        "form": "winches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34e1ceec-94ab-344d-b7bc-9737b10ac64c",
                        "entry_id": "62900e74-1091-331e-9399-ab96e59c1abf",
                        "glosses": [
                            "Équipement fixe placé sur le pont d’un voilier qui permet de démultiplier la traction exercée par l’équipage sur les cordages (écoute, drisse, bras de spinnaker) utilisés pour contrôler la voilure."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "422c7f8b-8e8a-49fe-8f41-4e1b22597001",
                                "sense_id": "34e1ceec-94ab-344d-b7bc-9737b10ac64c",
                                "text": "« Quand je te le dirai, tu tireras sur la corde pour monter la grande voile », ou encore « tu pourras resserrer le winch avec la manivelle »."
                            },
                            {
                                "example_id": "7fcdec69-3160-4e15-897d-631e0e3406a2",
                                "sense_id": "34e1ceec-94ab-344d-b7bc-9737b10ac64c",
                                "text": "Je préfère choquer et border. Je suis plus à l’aise avec les winchs."
                            }
                        ]
                    },
                    {
                        "sense_id": "04cdad12-cb09-30b1-b504-54bd7a1bca98",
                        "entry_id": "62900e74-1091-331e-9399-ab96e59c1abf",
                        "glosses": [
                            "Treuil."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "12268aef-4a00-4d0e-aabc-856af82ece30",
                                "sense_id": "04cdad12-cb09-30b1-b504-54bd7a1bca98",
                                "text": "J'ai un winch sur mon quatre roues au cas où je m'embourbe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6019c13-d4ef-4292-991e-6718be863612",
                        "source_entry_id": "62900e74-1091-331e-9399-ab96e59c1abf",
                        "target_lang_word": "winch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb663c8-abcf-31ae-b17b-4ec47ede811b",
                                        "entry_id": "3463781b-3db4-3d27-beb5-00e34f78ac82",
                                        "glosses": [
                                            "A machine consisting of a drum on an axle, a friction brake or ratchet and pawl, and a crank handle or prime mover (often an electric or hydraulic motor), with or without gearing, to give increased mechanical advantage when hoisting or hauling on a rope or cable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fe83a42-17f8-3288-8cf5-ccb037d4a6e1",
                                        "entry_id": "3463781b-3db4-3d27-beb5-00e34f78ac82",
                                        "glosses": [
                                            "A hoisting device used for loading or unloading cargo, or for pulling in lines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64135e00-7bce-4ca2-99fc-15fdd445e20b",
                                                "sense_id": "6fe83a42-17f8-3288-8cf5-ccb037d4a6e1",
                                                "text": "It runs on clattering steel tracks; the driver sits in a cab over the tracks, operating the controls that rotate the arm and turn the winch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "171868eb-f9c9-3ef9-80e7-e9845a252f1e",
                                        "entry_id": "3463781b-3db4-3d27-beb5-00e34f78ac82",
                                        "glosses": [
                                            "A wince (machine used in dyeing or steeping cloth)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32e96cd9-e393-3941-a135-2e0b2d8c37c8",
                                        "entry_id": "3463781b-3db4-3d27-beb5-00e34f78ac82",
                                        "glosses": [
                                            "A kick, as of an animal, from impatience or uneasiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "003585db-0acf-4740-8990-e1a18106bab3",
                                                "sense_id": "32e96cd9-e393-3941-a135-2e0b2d8c37c8",
                                                "text": "the mule[…]being likewise frighted by that terrible blow, ran away as fast as it could about the fields, and within two or three winches overthrew him to the ground"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7097ebe8-773d-3283-820a-4e1c71eb77a3",
                                        "entry_id": "3463781b-3db4-3d27-beb5-00e34f78ac82",
                                        "glosses": [
                                            "A witch."
                                        ],
                                        "tags": [
                                            "Nigeria",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "winch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7a9ed0c-be09-34bb-9bdb-bfac23396e73",
                                        "entry_id": "32a7815d-a373-352e-8b02-08aaaaf319fb",
                                        "glosses": [
                                            "To use a winch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2cba57-4adf-4611-b56f-7d5fb87f5d9b",
                                                "sense_id": "c7a9ed0c-be09-34bb-9bdb-bfac23396e73",
                                                "text": "Winch in those sails, lad!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "winch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "867b35df-0fa8-3050-9e87-89bbb69b929c",
                                        "entry_id": "eb27f10f-f8dd-31c4-a2e0-15fa4cb6fafb",
                                        "glosses": [
                                            "To wince; to shrink"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420cdefd-a3b5-426a-8a13-3746d87afe23",
                                                "sense_id": "867b35df-0fa8-3050-9e87-89bbb69b929c",
                                                "text": "It is not the first time a cat-o'-nine-tails has been across my back for other men's misdeeds. Promise me a good flask of brandy when I'm done with it, and I warrant ye I'll never winch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7c98a07-2385-3f58-a066-ec2d87fcf389",
                                        "entry_id": "eb27f10f-f8dd-31c4-a2e0-15fa4cb6fafb",
                                        "glosses": [
                                            "To kick with impatience or uneasiness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "winch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4761f6a8-6df1-3450-bbf4-dab54cbe5e8e",
                                        "entry_id": "e3d9dde4-5425-39db-aed3-a2620a5373f4",
                                        "glosses": [
                                            "to court"
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "ambitransitive",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d00dea-a440-4560-beb5-592c76b39c69",
                                                "sense_id": "4761f6a8-6df1-3450-bbf4-dab54cbe5e8e",
                                                "text": "They “clicked” each other, kidded each other, and by and by they would “winch” and marry each other."
                                            },
                                            {
                                                "example_id": "a68a4420-744c-4023-9a6b-8a5e6c671266",
                                                "sense_id": "4761f6a8-6df1-3450-bbf4-dab54cbe5e8e",
                                                "text": "It was common knowledge that he'd winched dozens of girls while she had been sharing a bedroom with her two brothers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbec94e9-a42c-389b-a24e-32a7389093b7",
                                        "entry_id": "e3d9dde4-5425-39db-aed3-a2620a5373f4",
                                        "glosses": [
                                            "to kiss, snog"
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "ambitransitive",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2647d798-99f5-444f-b08f-be1ba3dcc5c0",
                                                "sense_id": "fbec94e9-a42c-389b-a24e-32a7389093b7",
                                                "text": "She turned and looked at me, amused, gave a wee chuckle, kissed me on the mouth hard and quick, and again, and we were kissing for real, lingering, soft and moist and warm, me and Jeannie winching, and I wanted it not to stop."
                                            },
                                            {
                                                "example_id": "101a1de8-e173-4ce1-b005-9f71a9c52759",
                                                "sense_id": "fbec94e9-a42c-389b-a24e-32a7389093b7",
                                                "text": "Up at the cinema Campbell Cameron had been all slithering hands, like a dirty octopus. Even his tenderest winching had felt entitled and demanding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
