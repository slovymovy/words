                                "sense_id": "6310935e-c42f-3dfa-bbce-758ac62811fd",
                                "text": "Ohne das Plugin kann das Video nicht im Browser wiedergegeben werden."
                            },
                            {
                                "example_id": "a5d496e6-4d81-4c49-82c6-dcdb3b95e06e",
                                "sense_id": "6310935e-c42f-3dfa-bbce-758ac62811fd",
