                                        "sense_id": "dbcf46c4-d51d-3764-a6df-1b7d8d80e878",
                                        "entry_id": "29ce057c-feec-3ca3-8e3f-0ea8b3c9a7dd",
                                        "glosses": [
                                            "Rapid, confused speech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb0f6ef-4c3b-4e1a-8331-99360beaa3ba",
                                                "sense_id": "dbcf46c4-d51d-3764-a6df-1b7d8d80e878",
                                                "text": "the gabblings of a madman"
                                            },
                                            {
                                                "example_id": "4800d510-fc7e-4cba-ae29-788707431357",
                                                "sense_id": "dbcf46c4-d51d-3764-a6df-1b7d8d80e878",
                                                "text": "[…] I could hear nothing but a low gabbling; but at last the voices began to grow higher, and I could pick up a word or two […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6371890c-f51d-4da4-b34f-4407a1c61a58",
                        "source_entry_id": "8485f137-4b1f-3ab9-9b1a-35765efc797f",
                        "source_sense_id": "af6a7982-e1a4-30fb-88ab-6388ac587002",
