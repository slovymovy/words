                "senses": [
                    {
                        "sense_id": "8fe26dbd-bc97-3f17-97a5-5e3e8ee058c8",
                        "entry_id": "0a54752c-1b38-3a77-b89d-e0f2535f545e",
                        "glosses": [
                            "Dévider les écheveaux avec un trafusoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71e41299-fe93-42d0-ab6e-582eefb190dd",
                                "sense_id": "8fe26dbd-bc97-3f17-97a5-5e3e8ee058c8",
                                "text": "Le Trafusoir est placé devant le Rouet, au côté gauche de la Devideuse, de maniere que la grande cheville soit suivant la longueur du Rouet, pour que la Devideuse puisse trafuser en devidant."
                            },
                            {
                                "example_id": "667051d6-fe29-40e9-92e3-d5800bbd85c5",
                                "sense_id": "8fe26dbd-bc97-3f17-97a5-5e3e8ee058c8",
                                "text": "& comme la construction de ce Rouet permet à l’Ouvriere de trafuser, c’est-à-dire de débrouiller l’écheveau en méme tems qu’elle devide, il discute les différentes manieres de trafuser, et les avantages des différens Trafusoirs."
                            }
                        ]
                    }
