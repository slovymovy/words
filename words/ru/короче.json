        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0f5c735-32bd-3c4a-a08e-a6e64713e0ef",
                    "sense_definition": "Форма сравнительной степени прилагательного <w>короткий</w>; имеющий меньшую длину или длительность.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparative_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой дни становятся заметно <w>короче</w>, а ночи длиннее.",
                            "target_lang_translations": {
                                "en": "In winter, the days become noticeably <w>shorter</w>, and the nights longer.",
                                "es": "En invierno los días se vuelven notablemente <w>más cortos</w> y las noches más largas.",
                                "fr": "En hiver, les journées deviennent nettement <w>plus courtes</w> et les nuits plus longues."
                            }
                        },
                        {
                            "text": "Эта дорога <w>короче</w>, но она проходит через лес.",
                            "target_lang_translations": {
                                "en": "This road is <w>shorter</w>, but it goes through the forest.",
                                "es": "Este camino es <w>más corto</w>, pero pasa por el bosque.",
                                "fr": "Ce chemin est <w>plus court</w>, mais il passe par la forêt."
                            }
                        }
                    ],
                    "antonyms": [
                        "длиннее"
                    ],
                    "common_phrases": [
                        "стать короче",
                        "намного короче",
                        "еще короче"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative form of the adjective 'short'; having less length or duration.",
                        "es": "Forma comparativa del adjetivo 'corto'; que tiene menor longitud o duración.",
                        "fr": "Forme comparative de l'adjectif 'court' ; ayant une longueur ou une durée moindre."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shorter",
                                "target_lang_sense_clarification": "length or time"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "más corto",
                                "target_lang_sense_clarification": "longitud o tiempo"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plus court",
                                "target_lang_sense_clarification": "pour la longueur ou le temps"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66886a83-4abc-30c3-87f7-95a1f4f40d6e",
                    "sense_definition": "Находящийся в более близких, дружеских отношениях.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_closer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За время путешествия они сошлись <w>короче</w> и стали друзьями.",
                            "target_lang_translations": {
                                "en": "During the trip, they became <w>closer</w> and became friends.",
                                "es": "Durante el viaje se hicieron <w>más cercanos</w> y se volvieron amigos.",
                                "fr": "Pendant le voyage, ils sont devenus <w>plus proches</w> et sont devenus amis."
                            }
                        },
                        {
                            "text": "Я хотел бы узнать его <w>короче</w>, прежде чем доверять дела.",
                            "target_lang_translations": {
                                "en": "I would like to get to know him <w>better</w> before trusting him with business.",
                                "es": "Me gustaría conocerlo <w>mejor</w> antes de confiarle asuntos.",
                                "fr": "J'aimerais le connaître <w>mieux</w> avant de lui confier des affaires."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "meaning 'closer' in relationships"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Being in closer, more friendly relations.",
                        "es": "Estar en relaciones más cercanas y amistosas.",
                        "fr": "Être dans des relations plus proches et plus amicales."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "closer",
                                "target_lang_sense_clarification": "in relationships"
                            },
                            {
                                "target_lang_word": "better",
                                "target_lang_sense_clarification": "to know someone"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "más cercano",
                                "target_lang_sense_clarification": "en relaciones personales"
                            },
