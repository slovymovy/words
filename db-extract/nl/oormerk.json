                    },
                    {
                        "sense_id": "b311a3a9-4b8a-3ae1-9a32-58001b19de68",
                        "entry_id": "e8e0b16d-5df2-32dd-b06c-d94d3f92b024",
                        "glosses": [
                            "aim, goal"
                        ],
                        "tags": [
