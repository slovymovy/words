                                        "entry_id": "0f625fdb-0d55-3727-b07a-475c62505230",
                                        "glosses": [
                                            "A situation which offers no advantage to any particular person or side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c5ac2a2-dadb-484f-a862-2c2d43a186a1",
                                                "sense_id": "b2621a9a-cc62-350a-a551-6a5e99bb29cd",
                                                "text": "Although the political commitment to maintaining a level playing field is generally strong, government commercial activities may damage the competition landscape either due to deliberate or unintentional departures from neutral practices."
                                            },
                                            {
                                                "example_id": "8c6dc1ac-44a2-44f9-8bdd-9df1b93f7bbd",
                                                "sense_id": "b2621a9a-cc62-350a-a551-6a5e99bb29cd",
                                                "text": "Although the government has significantly reduced its UK growth targets to 75% by 2050 from the heady heights of trebling it in ten years at the beginning of privatisation, the rail freight industry is calling on all politicians to create a level playing field with road haulage."
                                            }
                                        ]
