                    {
                        "translation_id": "e710705a-6e49-49f7-bae4-fe113b111957",
                        "source_entry_id": "fc178395-4063-35fa-b6ba-4e1be7427636",
                        "source_sense_description": "capital and largest city of Lebanon",
                        "target_lang_word": "Beyrouth",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beyrouth",
