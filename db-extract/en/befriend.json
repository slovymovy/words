                    {
                        "sense_id": "1a090b53-ff37-3369-bc34-0d9395dc7282",
                        "entry_id": "a0609916-3eb5-37ba-b897-df53cec727eb",
                        "glosses": [
                            "Freundschaft mit jemandem schließen, sich anfreunden"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1c3ea011-2523-47b8-a1e6-ff9c935dd1f9",
                                "sense_id": "1a090b53-ff37-3369-bc34-0d9395dc7282",
                                "text": "“Over the past year, a man in his late 50s has befriended her.”",
                                "translation": "Im Lauf des vergangenen Jahres hat sich ein Mann Ende Fünfzig mit ihr angefreundet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a47a06e1-c62f-343d-a008-5300eb0a8914",
                        "entry_id": "a0609916-3eb5-37ba-b897-df53cec727eb",
                        "glosses": [
                            "sich freundschaftlich gegenüber einer anderen Person verhalten, jemandem behilflich sein"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ab6780f0-4bec-4185-a7ac-5f6f30a54160",
                                "sense_id": "a47a06e1-c62f-343d-a008-5300eb0a8914",
                                "text": "“I used to mend all the boys' kites and things, and show 'em where the good fishin' places was, and befriend 'em what I could, and now they've all forgot old Muff when he's in trouble ….”",
                                "translation": "Früher habe ich für all die Jungs die Drachen und so geflickt und ihnen gezeigt, wo die guten Fischfangplätze sind, und war ihnen behilflich, wo ich nur konnte, und jetzt ist er in Schwierigkeiten, da haben sie alle den alten Muff vergessen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
