                "translations": [
                    {
                        "translation_id": "9be2b6b1-e1a1-4c31-9319-2a18d184c360",
                        "source_entry_id": "7ea27892-d679-3299-8b91-9fa6086f9837",
                        "source_sense_id": "41b47469-c769-3c38-b268-9f9c0a8794c0",
                        "target_lang_word": "Fahrradsattel",
                        "target_lang_code": "de",
