                    "frequency": "High",
                    "semantic_group_id": "laid_desagreable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il porte un pull <w>affreux</w> qu'il a reçu pour Noël l'année dernière."
                        },
                        {
                            "text": "Le temps est <w>affreux</w> aujourd'hui avec cette pluie continue et ce vent glacial."
                        }
                    ],
                    "antonyms": [
