                                    {
                                        "sense_id": "c75b2165-eae2-3878-926b-0320852eccf7",
                                        "entry_id": "c07a116d-65bd-3469-829a-55f35389de9e",
                                        "glosses": [
                                            "Having complex cells in which the genetic material is organized into membrane-bound nuclei."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e922b11-708a-48b4-957d-9c199b4a01b6",
                                                "sense_id": "c75b2165-eae2-3878-926b-0320852eccf7",
                                                "text": "The close analogies between DNA-containing eukaryotic cell organelles and microbial symbionts require revision of classic cell theory, wrote Scwemmler and Schenk (1980) on introducing the field of endocytobiology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee57364-fb5d-3e2b-b95c-3dc9db304c5c",
                                        "entry_id": "c07a116d-65bd-3469-829a-55f35389de9e",
                                        "glosses": [
                                            "Of or pertaining to a eukaryote."
                                        ],
                                        "tags": [
