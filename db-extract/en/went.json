                        "examples": []
                    },
                    {
                        "sense_id": "dd02e31e-7807-3c92-af82-85d72c252d65",
                        "entry_id": "8c16e764-f909-39df-9248-e5f308bfe56a",
                        "glosses": [
                            "past participle of go"
                        ],
                        "tags": [
                            "form-of",
                            "nonstandard",
                            "participle",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "868a679c-97b8-4384-813c-a0e0ca628950",
                                "sense_id": "dd02e31e-7807-3c92-af82-85d72c252d65",
                                "text": "When they arrived whither they were bent, / He made as if he farther would have went. / But they conſtrain'd him, ſaying, Night is near; / Abide with us; and ſo he tarry'd there."
                            },
                            {
                                "example_id": "94187b10-211d-4df2-81e0-c9e0d6a75bef",
                                "sense_id": "dd02e31e-7807-3c92-af82-85d72c252d65",
                                "text": "I went from Filley's to Fitch's house, to talk of oxen; no one went with me; might have went to the mill; don,t remember whether I rode back to Laycock's or not to dinner."
                            },
                            {
                                "example_id": "6700dd28-11db-4626-99cc-3ce6e005989d",
                                "sense_id": "dd02e31e-7807-3c92-af82-85d72c252d65",
                                "text": "I just sat around and watched, then decided to go see Safid; we planned to study that day, but first we had a good ride around town. We must have went fifteen miles, and Safid was ready to sit and study; we went to a little park and started working."
                            }
                        ]
                    },
                    {
                        "sense_id": "49cbfeae-1d01-367e-ae23-57dacad791b8",
                        "entry_id": "8c16e764-f909-39df-9248-e5f308bfe56a",
                        "glosses": [
