                                "target_senses": [
                                    {
                                        "sense_id": "e04dc1fd-8f7e-3f34-bccf-b298ff232d2f",
                                        "entry_id": "20c6d34e-3af1-3bf0-8268-52cb3d293eac",
                                        "glosses": [
                                            "een tegen vijandelijk vuur gedekte en van schietgaten voorziene ruimte voor de opstelling van een vuurwapen, aanvankelijk deel uitmakend van een vesting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15f6914-38a6-4566-ae9c-1c3486386180",
                                                "sense_id": "e04dc1fd-8f7e-3f34-bccf-b298ff232d2f",
                                                "text": "Ik voel mij betrokken bij de dingen om me heen. In tijden dat de maatschappelijke deining hoog gaat, houd ik mijn ogen graag gericht op de kustlijn. Op de kade van Vlissingen bijvoorbeeld, met zijn vuurtoren, zijn kazematten en zijn Zeewezen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7546d76-95da-4f3e-994a-16c7123b2fa5",
                        "source_entry_id": "e9767142-90fa-3a26-b844-1beb67db776b",
                        "source_sense_description": "bombproof chamber as part of fortification",
                        "target_lang_word": "casemate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casemate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f24b85e-8e8d-3eae-916b-43dd74698a6f",
                                        "entry_id": "4c42b141-236b-3450-8745-a190ad20c088",
                                        "glosses": [
                                            "Réduit d'un fort, généralement souterrain, à l'épreuve des bombes et des obus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff77842-7606-4259-8d84-a327433047fd",
                                                "sense_id": "8f24b85e-8e8d-3eae-916b-43dd74698a6f",
                                                "text": "À l’intérieur de la citadelle, dans une de ces profondes casemates, impénétrables aux gros obus."
                                            },
                                            {
                                                "example_id": "e9c976c0-39e0-4646-bab3-a59f3834e62c",
                                                "sense_id": "8f24b85e-8e8d-3eae-916b-43dd74698a6f",
                                                "text": "Il est mort à la caserne, pendant une épidémie, quatre mois après son incorporation. Ces garnisons de l’Est sont dures pour les recrues, surtout les casemates."
                                            },
                                            {
                                                "example_id": "df978ff8-0755-4a06-ba41-e521090888de",
                                                "sense_id": "8f24b85e-8e8d-3eae-916b-43dd74698a6f",
                                                "text": "Flifla est mort, ainsi que jambon-beurre, leur Lebel au sol, mort propre, une seule balle chaque.\nJ'ai compris, y a un snipeur super-bien placé dans une casemate, en haut du sentier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9e5536c-e2f7-37f0-a313-80fcbe655ff7",
                                        "entry_id": "4c42b141-236b-3450-8745-a190ad20c088",
                                        "glosses": [
                                            "Redoute fortifiée, à l’épreuve du canon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f49431-eae4-4dca-b494-3508e3382282",
                                                "sense_id": "e9e5536c-e2f7-37f0-a313-80fcbe655ff7",
                                                "text": "Des torches s’allument dans les casemates, courent sur les bastions, illuminent les tours et les eaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e91ba503-303c-3a57-a8e0-ed815654f851",
                                        "entry_id": "4c42b141-236b-3450-8745-a190ad20c088",
                                        "glosses": [
                                            "Trou de renard ou de blaireau, dans lequel ils se défendent contre les chiens."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8107aff0-482e-377e-a504-12eccfe013cc",
                                        "entry_id": "4c42b141-236b-3450-8745-a190ad20c088",
                                        "glosses": [
                                            "Lieu d’aisance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
