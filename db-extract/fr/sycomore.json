                                        "sense_id": "56716a04-02f8-3bb4-a98e-d55d087c933c",
                                        "entry_id": "3913a0f5-3c32-3bb6-96af-8a61224a37ea",
                                        "glosses": [
                                            "Any of several North American plane trees, of the genus Platanus, especially Platanus occidentalis (American sycamore), distinguished by its mottled bark which flakes off in large irregular masses."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0074f3c1-2662-4155-9445-eac6852ecc2f",
                                                "sense_id": "56716a04-02f8-3bb4-a98e-d55d087c933c",
                                                "text": "Stars shining bright above you / Night breezes seem to whisper, I love you / Birds singin' in the sycamore trees"
                                            },
                                            {
                                                "example_id": "22a22449-d679-4f8c-bb3e-255bb9b54ed8",
                                                "sense_id": "56716a04-02f8-3bb4-a98e-d55d087c933c",
                                                "text": "On his dark face were white sycamore patches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8fc8ef4-3deb-3795-89ab-df120ae1eb01",
                                        "entry_id": "3913a0f5-3c32-3bb6-96af-8a61224a37ea",
                                        "glosses": [
                                            "A large British and European species of maple, Acer pseudoplatanus, known in North America as the sycamore maple."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0bfe5bd-63bd-4be3-bde6-b6da2a2770b3",
                                                "sense_id": "a8fc8ef4-3deb-3795-89ab-df120ae1eb01",
                                                "text": "The thronged boughs of the shadowy sycamore / Still bear young leaflets half the summer through"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e36d06-73cf-3512-94a7-de9494aef086",
                                        "entry_id": "3913a0f5-3c32-3bb6-96af-8a61224a37ea",
                                        "glosses": [
                                            "A large tree bearing edible fruit, Ficus sycomorus, allied to the common fig, found in Egypt and Syria."
                                        ],
