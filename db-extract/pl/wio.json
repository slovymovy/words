                                    {
                                        "sense_id": "4afa7f92-c0c0-3d50-a05d-6a47ccc90b90",
                                        "entry_id": "d52a0000-ef4f-3b17-bbaf-1af539d7d859",
                                        "glosses": [
                                            "move on!, go faster!"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90288f5-7fc7-4d1a-a7bc-80d3c16a44db",
                                                "sense_id": "4afa7f92-c0c0-3d50-a05d-6a47ccc90b90",
                                                "text": "There he sat and kicked away and cried: \" Gee up, gee up! \" to his nag."
                                            },
                                            {
                                                "example_id": "a48436d9-aef0-4cdc-9846-069ffeb7f605",
                                                "sense_id": "4afa7f92-c0c0-3d50-a05d-6a47ccc90b90",
                                                "text": "Gee up, Dobbin, Gee ho, Dobbin, Gee up, Dobbin, Gee up, and gee ho - o - o!"
                                            },
                                            {
                                                "example_id": "4c3e3fbb-0982-4f39-ad6e-786cb97447df",
                                                "sense_id": "4afa7f92-c0c0-3d50-a05d-6a47ccc90b90",
                                                "text": "\"Gee up!\" The horses roused themselves and pulled the light carriage along as though it were a feather"
                                            },
                                            {
                                                "example_id": "c8c497ed-5bce-42b1-9a7e-b95bb7f85e16",
                                                "sense_id": "4afa7f92-c0c0-3d50-a05d-6a47ccc90b90",
                                                "text": "He kept on cracking his whip, and calling out, \"Gee-up, my five horses!\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gee up",
                                "target_lang_code": "en",
                                "target_senses": [
