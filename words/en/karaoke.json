                        {
                            "text": "Include the <w>karaoke</w> drill in your routine to improve your lateral agility.",
                            "target_lang_translations": {
                                "ru": "Включите упражнение <w>караоке</w> в свою тренировку, чтобы улучшить боковую маневренность."
                            }
                        }
                    ],
                    "common_phrases": [
