                        "glosses": [
                            "plaats war politiek ongewenste personen gevangen gehouden worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5574e3-c4c2-42ce-9f80-fd555ba37ca7",
                                "sense_id": "2ab29fa0-412d-3396-a417-43179827ef9e",
                                "text": "Zangeres Frédérique Spigt trad op tijdens de herdenking van de bevrijding van Nederlands-Indië. Haar moeder zat gedurende de Tweede Wereldoorlog in een Japans interneringskamp. Spigt maakte daarover het lied Buigen voor de Keizer."
                            },
                            {
                                "example_id": "44f4e4da-9718-4722-b30f-e0860a952faa",
                                "sense_id": "2ab29fa0-412d-3396-a417-43179827ef9e",
                                "text": "Die laatste passage zou haar duur komen te staan. Hij werd opgenomen in de dagvaarding wegens landverraad. Ze werd veroordeeld tot 8,5 maand interneringskamp. Dat was geen lichte straf, integendeel, de geïnterneerden werden over het algemeen als beesten behandeld. En dan droeg zij ook nog de naam Mussert."
                            }
                        ]
                    }
