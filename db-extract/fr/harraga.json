                        "entry_id": "17901e1b-59d7-3026-8c04-96722f56c6a2",
                        "glosses": [
                            "Maghrebi clandestine emigrant trying to reach Europe, particularly through dangerous means."
                        ],
                        "tags": [
                            "Morocco",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "5ffeb189-017d-40fc-ad2e-1aba46b0df14",
                                "sense_id": "97c8b9f4-b65e-3bc0-81c5-e8b6031f535c",
                                "text": "Selon Madrid, près de dix mille Algériens sur un total de quatorze mille harragas sont entrés clandestinement sur le territoire espagnol en 2021, soit 20 % de plus qu’en 2020."
                            }
                        ]
                    }
