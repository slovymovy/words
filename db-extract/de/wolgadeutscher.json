                "senses": [
                    {
                        "sense_id": "18ee089c-3540-3a9c-8b25-5e366bddd651",
                        "entry_id": "87541e87-651e-3f7f-aa86-2144f1e71652",
                        "glosses": [
                            "deutschstämmige Person, die in den deutschen Siedlungsgebieten an der Wolga lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bccf53c-e421-4a08-9a7f-3da4d3a333d0",
                                "sense_id": "18ee089c-3540-3a9c-8b25-5e366bddd651",
                                "text": "„Auch die Wolgadeutschen hatten diesen Status, doch wie Sie wissen, hat man sie alle deportiert und ihre Republik aufgelöst.“"
                            },
                            {
                                "example_id": "0c03de8f-8e57-486b-8b3d-72318ee30a82",
                                "sense_id": "18ee089c-3540-3a9c-8b25-5e366bddd651",
                                "text": "„Im Rahmen einer - verglichen mit dem Zaristischen Reich - liberalen Nationalitätenpolitik wurde 1924 das deutschsprachige Siedlungsgebiet um Saratov zur Autonomen Sozialistischen Sowjetrepublik der Wolgadeutschen mit der Hauptstadt Engel's (bis 1931 Pokrovs) aufgewertet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
