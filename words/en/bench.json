{
    "word_family": [
        "workbench",
        "benchmark",
        "backbench"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14ddc83a-a0e3-33e1-87ff-a19b0c07db8d",
                    "sense_definition": "A long seat for two or more people, usually made of wood or metal and found in public places like parks or schools.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "seat_furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat on a park <w>bench</w> to eat our sandwiches.",
                            "target_lang_translations": {
                                "ru": "Мы сели на парковую <w>скамейку</w>, чтобы съесть наши бутерброды.",
                                "zh": "我们坐在公园的<w>长椅</w>上吃三明治。"
                            }
                        },
                        {
                            "text": "The old wooden <w>bench</w> outside the library is a nice place to read.",
                            "target_lang_translations": {
                                "ru": "Старая деревянная <w>скамейка</w> у библиотеки — хорошее место для чтения.",
                                "zh": "图书馆外那张旧木<w>长凳</w>是个读书的好地方。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "park bench",
                        "wooden bench",
                        "sit on a bench"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинное сиденье для двух или более человек, обычно сделанное из дерева или металла и расположенное в общественных местах, таких как парки или школы.",
                        "zh": "一种供两人或多人坐的长椅，通常由木头或金属制成，常见于公园或学校等公共场所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скамейка",
                                "target_lang_sense_clarification": "уличная мебель"
                            },
                            {
                                "target_lang_word": "скамья",
                                "target_lang_sense_clarification": "мебель"
                            },
                            {
                                "target_lang_word": "лавка",
                                "target_lang_sense_clarification": "простая скамья"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长椅",
                                "target_lang_sense_clarification": "公共场所的座椅"
                            },
                            {
                                "target_lang_word": "长凳",
                                "target_lang_sense_clarification": "木制或金属制长条坐具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee340a0b-e619-3709-bab2-6ec6459a6e9b",
                    "sense_definition": "The place where substitute players and coaches sit during a sports game when they are not playing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the first half of the match on the <w>bench</w> waiting for his turn.",
                            "target_lang_translations": {
                                "ru": "Он провёл первую половину матча на <w>скамейке запасных</w>, ожидая своей очереди.",
                                "zh": "他上半场一直坐在<w>替补席</w>上等待上场机会。"
                            }
                        },
                        {
                            "text": "The coach called the young player from the <w>bench</w> to join the game.",
                            "target_lang_translations": {
                                "ru": "Тренер вызвал молодого игрока со <w>скамейки запасных</w>, чтобы тот вступил в игру.",
                                "zh": "教练把那位年轻球员从<w>替补席</w>上叫起来参加比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the bench",
                        "off the bench"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где сидят запасные игроки и тренеры во время спортивной игры.",
                        "zh": "体育比赛中替补队员和教练坐的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скамейка запасных",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "скамейка",
                                "target_lang_sense_clarification": "разговорное, спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "替补席",
                                "target_lang_sense_clarification": "体育比赛中的座位区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82e17972-2091-3b58-aedb-09d00485ffca",
                    "sense_definition": "A strong table used for working with tools and materials, often called a workbench.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "work_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter placed his tools on the <w>bench</w> before starting work.",
                            "target_lang_translations": {
                                "ru": "Плотник положил свои инструменты на <w>верстак</w> перед началом работы.",
                                "zh": "木匠在开工前把工具放在了<w>工作台</w>上。"
                            }
                        },
                        {
                            "text": "She cleaned the laboratory <w>bench</w> after finishing the experiment.",
                            "target_lang_translations": {
                                "ru": "Она вытерла лабораторный <w>стол</w> после завершения эксперимента.",
                                "zh": "实验结束后，她清理了实验室的<w>工作台</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "work bench",
                        "lab bench"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочный стол, используемый для работы с инструментами и материалами; верстак.",
                        "zh": "用于放置工具和材料进行加工的坚固工作台。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верстак",
                                "target_lang_sense_clarification": "рабочий стол"
                            },
                            {
                                "target_lang_word": "рабочий стол",
                                "target_lang_sense_clarification": "мебель для работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工作台",
                                "target_lang_sense_clarification": "用于手工或实验的工作桌面"
                            },
                            {
                                "target_lang_word": "工作台",
                                "target_lang_sense_clarification": "木工或实验室用台"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f4adc6f-b52a-37f5-8724-7d81569f407a",
                    "sense_definition": "The judge or judges in a court of law, or the seat where they sit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer asked for permission to approach the <w>bench</w>.",
                            "target_lang_translations": {
                                "ru": "Адвокат попросил разрешения подойти к <w>судейскому столу</w>.",
                                "zh": "律师请求获准走到<w>法官席</w>前。"
                            }
                        },
                        {
                            "text": "The <w>bench</w> is expected to deliver a verdict by tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что <w>суд</w> вынесет вердикт к завтрашнему утру.",
                                "zh": "预计<w>法庭</w>将在明天上午做出判决。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "approach the bench",
                        "from the bench"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "law"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Судья или состав судей в суде, либо место, где они заседают.",
                        "zh": "法庭上的法官或法官席位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суд",
                                "target_lang_sense_clarification": "состав судей"
                            },
                            {
                                "target_lang_word": "судейский стол",
                                "target_lang_sense_clarification": "место судьи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "法官席",
                                "target_lang_sense_clarification": "法官所在的区域"
                            },
                            {
                                "target_lang_word": "法庭",
                                "target_lang_sense_clarification": "指代法官群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6893066-799c-3724-951c-56f80bc992bf",
                    "sense_definition": "A padded table or surface used for weightlifting exercises.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exercise_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lay on the <w>bench</w> to lift the heavy weights safely.",
                            "target_lang_translations": {
                                "ru": "Он лёг на <w>скамью</w>, чтобы безопасно поднять тяжёлый вес.",
                                "zh": "他躺在<w>卧推凳</w>上安全地举起重物。"
                            }
                        },
                        {
                            "text": "The gym has a new adjustable <w>bench</w> for different exercises.",
                            "target_lang_translations": {
                                "ru": "В спортзале есть новая регулируемая <w>скамья</w> для различных упражнений.",
                                "zh": "健身房有一张新的可调节<w>卧推凳</w>，适用于不同的练习。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "weight bench"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "fitness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая скамья или поверхность, используемая для упражнений с весами.",
                        "zh": "用于举重练习的软垫长凳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скамья для жима",
                                "target_lang_sense_clarification": "тренажёр"
                            },
                            {
                                "target_lang_word": "скамья",
                                "target_lang_sense_clarification": "спортивный инвентарь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卧推凳",
                                "target_lang_sense_clarification": "健身器材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "586c03f0-5611-3b2e-b2d7-6de66e4cbb32",
                    "sense_definition": "A long flat surface in a kitchen used for preparing food; a counter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "work_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wiped down the kitchen <w>bench</w> after making dinner.",
                            "target_lang_translations": {
                                "ru": "Она вытерла кухонную <w>столешницу</w> после приготовления ужина.",
                                "zh": "做完晚饭后，她擦拭了厨房的<w>操作台</w>。"
                            }
                        },
                        {
                            "text": "Please leave the groceries on the <w>bench</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставь продукты на <w>столешнице</w>.",
                                "zh": "请把杂货放在<w>操作台</w>上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kitchen bench"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная плоская поверхность на кухне, используемая для приготовления пищи; столешница.",
                        "zh": "厨房中用于准备食物的长条平面；操作台。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столешница",
                                "target_lang_sense_clarification": "кухонная поверхность"
                            },
                            {
                                "target_lang_word": "кухонный стол",
                                "target_lang_sense_clarification": "рабочая поверхность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "操作台",
                                "target_lang_sense_clarification": "厨房工作台面"
                            },
                            {
                                "target_lang_word": "台面",
                                "target_lang_sense_clarification": "厨房料理台"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c815bd0-b6da-3133-8b83-3dcf58e22c1a",
                    "sense_definition": "A seat for politicians in a parliament, often referring to their official position or group.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "political_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Members on the opposition <w>benches</w> argued against the new policy.",
                            "target_lang_translations": {
                                "ru": "Члены парламента на <w>скамьях</w> оппозиции выступили против новой политики.",
                                "zh": "反对派<w>议席</w>上的成员对新政策提出了异议。"
                            }
                        },
                        {
                            "text": "He hopes to return to the front <w>bench</w> after the next election.",
                            "target_lang_translations": {
                                "ru": "Он надеется вернуться на переднюю <w>скамью</w> после следующих выборов.",
                                "zh": "他希望在下次选举后能回到前排<w>议席</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "front bench",
                        "back bench"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "politics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Места для политиков в парламенте, часто обозначающие их официальную позицию или фракцию.",
                        "zh": "议会中政客的座位，通常指代其官方立场或党派。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скамья",
                                "target_lang_sense_clarification": "в парламенте"
                            },
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "в парламенте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "议席",
                                "target_lang_sense_clarification": "议会中的座位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b7f99ca-00af-3ce0-ab84-93428d590b9d",
                    "sense_definition": "To remove a player from a game or not allow them to play, often due to poor performance or injury.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach decided to <w>bench</w> the star player for being late to practice.",
                            "target_lang_translations": {
                                "ru": "Тренер решил <w>посадить на скамейку</w> звёздного игрока за опоздание на тренировку.",
                                "zh": "教练决定因为明星球员训练迟到而将其<w>冷藏</w>。"
                            }
                        },
                        {
                            "text": "He was <w>benched</w> for the rest of the season after his injury.",
                            "target_lang_translations": {
                                "ru": "Его <w>отправили в запас</w> до конца сезона после травмы.",
                                "zh": "受伤后，他本赛季余下的比赛都被<w>撤下</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sideline"
                    ],
                    "common_phrases": [
                        "get benched"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалить игрока из игры или не позволить ему играть, часто из-за плохой игры или травмы.",
                        "zh": "将球员从比赛中撤下或禁止其上场，通常是因为表现不佳或受伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посадить на скамейку",
                                "target_lang_sense_clarification": "отстранить от игры"
                            },
                            {
                                "target_lang_word": "отправить в запас",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷藏",
                                "target_lang_sense_clarification": "体育术语，指不让球员上场"
                            },
                            {
                                "target_lang_word": "撤下",
                                "target_lang_sense_clarification": "将球员换下场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db5a2a99-893e-3a17-96cb-671be9d19c53",
                    "sense_definition": "To lift weights by pushing them upwards while lying on a bench.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "exercise_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He can <w>bench</w> more than his own body weight.",
                            "target_lang_translations": {
                                "ru": "Он может <w>жать</w> больше собственного веса.",
                                "zh": "他能<w>卧推</w>超过自身体重的重量。"
                            }
                        },
                        {
                            "text": "I usually <w>bench</w> on Mondays as part of my chest workout.",
                            "target_lang_translations": {
                                "ru": "Я обычно <w>делаю жим лёжа</w> по понедельникам как часть тренировки груди.",
                                "zh": "我通常在周一进行<w>卧推</w>，作为胸部训练的一部分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bench press"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "fitness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать веса, толкая их вверх, лёжа на скамье.",
                        "zh": "躺在长凳上向上推举重物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жать",
                                "target_lang_sense_clarification": "упражнение"
                            },
                            {
                                "target_lang_word": "делать жим лёжа",
                                "target_lang_sense_clarification": "упражнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卧推",
                                "target_lang_sense_clarification": "健身动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
