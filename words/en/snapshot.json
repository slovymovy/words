{
    "word_family": [
        "snap",
        "shot",
        "snappy",
        "shooter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03abf282-e83c-3839-82bb-982d87e61b2a",
                    "sense_definition": "A photograph, especially one taken quickly or in a sudden moment of opportunity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carried a small <w>snapshot</w> of his daughter in his wallet.",
                            "target_lang_translations": {
                                "ru": "Он носил в кошельке маленький <w>снимок</w> своей дочери.",
                                "zh": "他在钱包里放了一张女儿的小<w>快照</w>。",
                                "es": "Llevaba una pequeña <w>instantánea</w> de su hija en la cartera."
                            }
                        },
                        {
                            "text": "I took a quick <w>snapshot</w> of the sunset before the light faded.",
                            "target_lang_translations": {
                                "ru": "Я быстро сделал <w>кадр</w> заката, пока свет не погас.",
                                "zh": "在光线消失前，我快速<w>抓拍</w>了一张日落的照片。",
                                "es": "Tomé una <w>instantánea</w> rápida del atardecer antes de que la luz se desvaneciera."
                            }
                        }
                    ],
                    "synonyms": [
                        "photo",
                        "photograph",
                        "picture",
                        "snap"
                    ],
                    "common_phrases": [
                        "quick snapshot",
                        "family snapshot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фотография, сделанная быстро или в момент удачной возможности.",
                        "zh": "指快速拍摄或在偶然机会下拍摄的照片。",
                        "es": "Una fotografía, especialmente una tomada rápidamente o en un momento de oportunidad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимок",
                                "target_lang_sense_clarification": "фотографическое изображение"
                            },
                            {
                                "target_lang_word": "кадр",
                                "target_lang_sense_clarification": "отдельный снимок"
                            },
                            {
                                "target_lang_word": "фото",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快照",
                                "target_lang_sense_clarification": "指快速拍摄的照片"
                            },
                            {
                                "target_lang_word": "照片",
                                "target_lang_sense_clarification": "通用的摄影图像"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "instantánea",
                                "target_lang_sense_clarification": "fotografía tomada rápidamente"
                            },
                            {
                                "target_lang_word": "foto",
                                "target_lang_sense_clarification": "término coloquial para fotografía"
                            },
                            {
                                "target_lang_word": "fotografía",
                                "target_lang_sense_clarification": "término general"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9ef134f-6210-3a32-a27c-0d31eec99b23",
                    "sense_definition": "A brief look or portrayal of a situation at a specific moment in time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overview",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article offered a <w>snapshot</w> of life in that remote region.",
                            "target_lang_translations": {
                                "ru": "Статья предложила краткий <w>обзор</w> жизни в том отдаленном регионе.",
                                "zh": "这篇文章提供了那个偏远地区生活的<w>概况</w>。",
                                "es": "El artículo ofrecía un <w>panorama</w> de la vida en esa región remota."
                            }
                        },
                        {
                            "text": "This report provides a <w>snapshot</w> of the current economic climate.",
                            "target_lang_translations": {
                                "ru": "Этот отчет дает <w>срез</w> текущего экономического климата.",
                                "zh": "这份报告提供了当前经济环境的<w>缩影</w>。",
                                "es": "Este informe proporciona una <w>radiografía</w> del clima económico actual."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimpse",
                        "overview",
                        "summary",
                        "profile"
                    ],
                    "common_phrases": [
                        "statistical snapshot",
                        "brief snapshot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткий обзор или описание ситуации в конкретный момент времени.",
                        "zh": "对特定时间点情况的简要概述或描绘。",
                        "es": "Una visión breve o representación de una situación en un momento específico."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обзор",
                                "target_lang_sense_clarification": "краткое описание ситуации"
                            },
                            {
                                "target_lang_word": "срез",
                                "target_lang_sense_clarification": "состояние на текущий момент"
                            },
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "общее представление о ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "概况",
                                "target_lang_sense_clarification": "对情况的简要描述"
                            },
                            {
                                "target_lang_word": "缩影",
                                "target_lang_sense_clarification": "反映整体情况的局部"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "panorama",
                                "target_lang_sense_clarification": "visión general de una situación"
                            },
                            {
                                "target_lang_word": "resumen",
                                "target_lang_sense_clarification": "descripción breve"
                            },
                            {
                                "target_lang_word": "radiografía",
                                "target_lang_sense_clarification": "análisis detallado de una situación en un momento dado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05796a47-9b6d-30a2-baae-9a28c3068a96",
                    "sense_definition": "A record of the state of a computer system or database at a particular point in time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system administrator took a <w>snapshot</w> of the server before the update.",
                            "target_lang_translations": {
                                "ru": "Системный администратор сделал <w>снапшот</w> сервера перед обновлением.",
                                "zh": "系统管理员在更新前为服务器创建了一个<w>快照</w>。",
                                "es": "El administrador del sistema tomó una <w>instantánea</w> del servidor antes de la actualización."
                            }
                        },
                        {
                            "text": "You can restore your files from a previous <w>snapshot</w> if the data is corrupted.",
                            "target_lang_translations": {
                                "ru": "Вы можете восстановить свои файлы из предыдущего <w>образа</w>, если данные повреждены.",
                                "zh": "如果数据损坏，你可以从之前的<w>快照</w>中恢复文件。",
                                "es": "Puedes restaurar tus archivos desde una <w>instantánea</w> anterior si los datos están dañados."
                            }
                        }
                    ],
                    "synonyms": [
                        "backup",
                        "image",
                        "capture"
                    ],
                    "common_phrases": [
                        "system snapshot",
                        "database snapshot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запись состояния компьютерной системы или базы данных в определенный момент времени.",
                        "zh": "记录计算机系统或数据库在特定时间点的状态。",
                        "es": "Un registro del estado de un sistema informático o base de datos en un punto particular en el tiempo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снапшот",
                                "target_lang_sense_clarification": "технический термин в ИТ"
                            },
                            {
                                "target_lang_word": "мгновенный снимок",
                                "target_lang_sense_clarification": "состояние системы или данных"
                            },
                            {
                                "target_lang_word": "образ",
                                "target_lang_sense_clarification": "копия состояния системы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快照",
                                "target_lang_sense_clarification": "计算机系统状态的备份"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "instantánea",
                                "target_lang_sense_clarification": "término técnico en informática"
                            },
                            {
                                "target_lang_word": "copia de seguridad",
                                "target_lang_sense_clarification": "respaldo del estado del sistema"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ec61de0-a66f-33a0-85d7-0182311576db",
                    "sense_definition": "A quick, unplanned shot in sports or hunting, made without taking careful aim.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shooting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker's <w>snapshot</w> from the edge of the box went just wide.",
                            "target_lang_translations": {
                                "ru": "Быстрый <w>удар</w> нападающего с края штрафной прошел чуть мимо ворот.",
                                "zh": "前锋在禁区边缘的<w>快速射门</w>稍稍偏出。",
                                "es": "El <w>disparo</w> rápido del delantero desde el borde del área salió desviado."
                            }
                        },
                        {
                            "text": "He missed the target with a hurried <w>snapshot</w> as the deer ran past.",
                            "target_lang_translations": {
                                "ru": "Он промахнулся, сделав поспешный <w>выстрел навскидку</w>, когда олень пробегал мимо.",
                                "zh": "当鹿跑过时，他匆忙<w>盲射</w>，结果没打中目标。",
                                "es": "Falló el blanco con un <w>disparo</w> apresurado mientras el ciervo pasaba corriendo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "point-blank snapshot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый, незапланированный выстрел в спорте или на охоте, сделанный без тщательного прицеливания.",
                        "zh": "在体育或狩猎中，不经仔细瞄准而进行的快速射击或击球。",
                        "es": "Un disparo rápido y no planificado en deportes o caza, realizado sin apuntar cuidadosamente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выстрел навскидку",
                                "target_lang_sense_clarification": "без долгого прицеливания"
                            },
                            {
                                "target_lang_word": "быстрый удар",
                                "target_lang_sense_clarification": "в спорте, например в хоккее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快速射门",
                                "target_lang_sense_clarification": "体育运动中不经瞄准的射门"
                            },
                            {
                                "target_lang_word": "盲射",
                                "target_lang_sense_clarification": "狩猎中不经瞄准的射击"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "disparo rápido",
                                "target_lang_sense_clarification": "disparo sin apuntar"
                            },
                            {
                                "target_lang_word": "tiro a puerta",
                                "target_lang_sense_clarification": "en deportes, un tiro repentino"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a85a3bf1-4e46-36a8-a46c-fe80ffbc7b9b",
                    "sense_definition": "To take a photograph of someone or something quickly.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>snapshotted</w> the deer before it disappeared into the woods.",
                            "target_lang_translations": {
                                "ru": "Я <w>сфотографировал</w> оленя до того, как он скрылся в лесу.",
                                "zh": "在鹿消失在树林里之前，我<w>抓拍</w>了它。",
                                "es": "Le <w>tomé una instantánea</w> al ciervo antes de que desapareciera en el bosque."
                            }
                        },
                        {
                            "text": "She was busy <w>snapshotting</w> the street performers during her vacation.",
                            "target_lang_translations": {
                                "ru": "Во время отпуска она была занята тем, что <w>щелкала</w> уличных артистов.",
                                "zh": "度假期间，她忙着<w>抓拍</w>街头艺人。",
                                "es": "Estaba ocupada <w>fotografiando</w> a los artistas callejeros durante sus vacaciones."
                            }
                        }
                    ],
                    "synonyms": [
                        "photograph",
                        "snap",
                        "capture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро сфотографировать кого-либо или что-либо.",
                        "zh": "快速地拍摄某人或某物。",
                        "es": "Tomar una fotografía de alguien o algo rápidamente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать снимок",
                                "target_lang_sense_clarification": "фотографировать"
                            },
                            {
                                "target_lang_word": "щелкнуть",
                                "target_lang_sense_clarification": "разговорное о фото"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓拍",
                                "target_lang_sense_clarification": "快速拍摄"
                            },
                            {
                                "target_lang_word": "拍照",
                                "target_lang_sense_clarification": "进行摄影动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tomar una instantánea",
                                "target_lang_sense_clarification": "fotografiar rápidamente"
                            },
                            {
                                "target_lang_word": "fotografiar",
                                "target_lang_sense_clarification": "acción de hacer fotos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d46eaefb-7bd3-31b7-88c1-c84c4215caa2",
                    "sense_definition": "To capture and save the current state of a computer system or data.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software is designed for <w>snapshotting</w> virtual machines automatically.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение предназначено для автоматического <w>создания снапшотов</w> виртуальных машин.",
                                "zh": "该软件旨在自动为虚拟机<w>创建快照</w>。",
                                "es": "El software está diseñado para <w>crear instantáneas</w> de máquinas virtuales automáticamente."
                            }
                        },
                        {
                            "text": "We <w>snapshotted</w> the database right before the migration started.",
                            "target_lang_translations": {
                                "ru": "Мы <w>зафиксировали состояние</w> базы данных прямо перед началом миграции.",
                                "zh": "我们在迁移开始前立即为数据库<w>创建快照</w>。",
                                "es": "Hicimos una <w>instantánea</w> de la base de datos justo antes de que comenzara la migración."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Захватить и сохранить текущее состояние компьютерной системы или данных.",
                        "zh": "捕获并保存计算机系统或数据的当前状态。",
                        "es": "Capturar y guardar el estado actual de un sistema informático o datos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать снапшот",
                                "target_lang_sense_clarification": "сохранять состояние системы"
                            },
                            {
                                "target_lang_word": "снимать образ",
                                "target_lang_sense_clarification": "фиксировать данные"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创建快照",
                                "target_lang_sense_clarification": "保存系统状态的动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "crear una instantánea",
                                "target_lang_sense_clarification": "término técnico para guardar el estado"
                            },
                            {
                                "target_lang_word": "hacer un backup",
                                "target_lang_sense_clarification": "guardar el estado de los datos"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}