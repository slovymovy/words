            "senses": [
                {
                    "sense_id": "373f9d59-c519-34f4-a8fa-7f39bb225eea",
                    "sense_definition": "Met een sombere, neerslachtige stemming; zonder hoop of moed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het horen van het slechte nieuws keek hij <w>mismoedig</w> voor zich uit.",
                            "target_lang_translations": {
                                "en": "After hearing the bad news, he stared ahead <w>despondently</w>."
                            }
                        },
                        {
                            "text": "De coach gaf na de zware nederlaag een <w>mismoedige</w> reactie aan de pers.",
                            "target_lang_translations": {
                                "en": "The coach gave a <w>dispirited</w> response to the press after the heavy defeat."
                            }
                        }
                    ],
                    "synonyms": [
