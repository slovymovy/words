                    },
                    {
                        "translation_id": "f20166e3-fd48-4171-8d73-48342e51314d",
                        "source_entry_id": "19f79347-efd9-3cde-bd08-3a7de421efdc",
                        "source_sense_id": "123ba2b9-b5c6-3ae1-b976-1113f1f8b43e",
                        "source_sense_description": "device used to gather water",
                        "target_lang_word": "Schwingbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwingbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e92dd93-a35f-3c79-84eb-6dee5ef65ec1",
                                        "entry_id": "fcc1746f-7c77-30b8-95a7-ccd59d203e96",
                                        "glosses": [
                                            "Schöpfwerk in Form eines Hebebaums, an dessen vorderem Ende ein Seil oder eine Stange angebracht ist, woran ein Eimer hängt, das dem Schöpfen von Wasser aus Brunnen (Schöpfbrunnen, Schwengelbrunnen, Ziehbrunnen) oder vom Ufer eines kleineren (fließenden oder stehenden) Gewässers aus dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016b7156-0c83-46e0-9c19-2d84747599d6",
                                                "sense_id": "8e92dd93-a35f-3c79-84eb-6dee5ef65ec1",
                                                "text": "„Diese Brunnen waren oft sehr einfach und befanden sich nicht selten in der Nähe von Misthaufen oder Stallungen. Das Wasser schöpfte man mit Eimern am Seil oder über einen Schwingbaum.“"
                                            },
                                            {
                                                "example_id": "788529bf-41b6-4f95-81f6-bd89a67625d4",
                                                "sense_id": "8e92dd93-a35f-3c79-84eb-6dee5ef65ec1",
                                                "text": "„Fast ein Jahr hat der Aufbau des Brunnens gedauert. Zum einen verzögerte der lange Winter die Bauarbeiten. Zum anderen musste lange gesucht werden, bis die passende Robinie für den Schwingbaum gefunden war.“"
                                            },
                                            {
                                                "example_id": "ee139f16-64ca-4f82-babb-c1433ff84502",
                                                "sense_id": "8e92dd93-a35f-3c79-84eb-6dee5ef65ec1",
                                                "text": "«Im alten Ägypten standen zu Bewässerungszwecken die im Niltal noch heute zu sehenden Schwingbäume und Schöpfräder im Gebrauch, in den letzten vorchristlichen Jahrhunderten wohl auch Wasserschnecken (‹Archimedische Schnecken›; […]) und vereinzelt Kolbenpumpen.»"
                                            },
                                            {
                                                "example_id": "3304a39f-7a04-49bc-8f7f-9cac9e7903b7",
                                                "sense_id": "8e92dd93-a35f-3c79-84eb-6dee5ef65ec1",
                                                "text": "„Bei einem Sturm im Frühjahr wurde der historische Ziehbrunnen in Laaske beschädigt. Der Schwingbaum, also die meterlange Stange, an der ansonsten ein Wassereimer hängt, ist abgebrochen.“"
                                            },
                                            {
                                                "example_id": "4a0ae097-4d27-42d7-a547-cc3c0dcbf917",
                                                "sense_id": "8e92dd93-a35f-3c79-84eb-6dee5ef65ec1",
                                                "text": "„Und wenn man kräftig genug am Schwingbaum zieht, dann spendet der neu aufgebaute alte Dorfbrunnen aus dem Jahr 1881 auch tatsächlich Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74ba31be-30a2-4658-8dde-11911afc742e",
