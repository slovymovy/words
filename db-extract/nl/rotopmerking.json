                        "examples": [
                            {
                                "example_id": "6f77c7e5-4b4a-4c71-9638-e00b4068c67f",
                                "sense_id": "36edd0cd-6836-30dd-aa02-3acaada32231",
                                "text": "Een ‘rotopmerking’ over een overleden Turkse medescholier leidde in december vorig jaar tot een heftige vechtpartij op de locatie Schuttersveld van het Stedelijk Lyceum. Na een pittig gesprek ziet justitie af van vervolging van de betrokken meiden."
                            },
                            {
                                "example_id": "d45c98a6-31a4-44b8-8951-0feee9f0f73b",
                                "sense_id": "36edd0cd-6836-30dd-aa02-3acaada32231",
                                "text": "Vicevoorzitter Simon Reed van de Politie Federatie noemde de suggestie dat de politie haar beleid had gewijzigd na ingrijpen van de regering 'een rotopmerking'. De voorman van de Politie Federatie in Manchester vindt het 'achterbaks van politici om te zeggen dat zij de problemen hebben opgelost'."
                            }
                        ]
                    }
