                        "examples": [
                            {
                                "example_id": "632f5612-868e-4146-9954-06cd93760e4c",
                                "sense_id": "70512562-326d-3b4f-9c6b-abe424c884e2",
                                "text": "„Fast alle Besucher prangerten die Doppelmoral der Amerikaner an, die stolz ihre Gleichheitsprinzipien präsentierten, deren Ökonomie in den Südstaaten aber zum größten Teil auf Sklavenarbeit basierte.“",
                                "translation": "„Alpenland, Union Alpine und Südstaat sind Begriffe aus verschiedenen, seit dem ausgehenden 18. Jahrhundert geführten Diskussionen über die territoriale Neuorganisation Südwestdeutschlands.“"
                            }
                        ],
