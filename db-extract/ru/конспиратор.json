                            }
                        ]
                    },
                    {
                        "translation_id": "8e853421-70a3-4d02-a9c1-1cf6e747d8aa",
                        "source_entry_id": "7e007346-b125-3920-b2b0-ab715fe23f9f",
                        "target_lang_word": "conspirator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspirator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc8007bf-bce5-3094-9f18-bdfd70a883b6",
                                        "entry_id": "cc762a07-ffae-328f-96a2-23661315d63f",
                                        "glosses": [
                                            "One of a group that acts in harmony to do something unlawful and unethical; a person who is part of a conspiracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1287b6-fb9a-45f9-a484-2135f1475c8d",
                                                "sense_id": "dc8007bf-bce5-3094-9f18-bdfd70a883b6",
                                                "text": "The conspirators were rounded up by the police and arrested."
                                            },
                                            {
                                                "example_id": "cc5524f4-d998-47f2-8a1e-65992728c80d",
                                                "sense_id": "dc8007bf-bce5-3094-9f18-bdfd70a883b6",
                                                "text": "All the Jacobite gentry of that part of the country were collected together; though, it must be confessed, their appearance and their usual after-dinner conversation were rather at variance. Now they looked calm and comfortable, with as little the appearance of conspirators as possible; then they were (by their own account) the most oppressed of individuals, and the most devoted of partisans, ready to die, so that their wrongs were redressed, and the rightful king restored."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
