    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "02586b4f-d2e9-3df0-a248-ebc622812435",
                "word": "adposition",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b513bcab-9dba-41bb-8288-0b589c5b1213",
                        "entry_id": "02586b4f-d2e9-3df0-a248-ebc622812435",
                        "tags": [
                            "plural"
                        ],
