                            "plural"
                        ],
                        "form": "traintrains"
                    },
                    {
                        "form_id": "74fdbdfa-9a91-4ae7-8f27-1d9591b66377",
                        "entry_id": "8df9657e-ae01-34d4-9514-226d756217de",
                        "tags": [],
                        "form": "train-train"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52ec5462-7592-3ae8-864c-06f15f5a92ed",
                        "entry_id": "8df9657e-ae01-34d4-9514-226d756217de",
                        "glosses": [
                            "Petite allure lente et routinière des choses dans une affaire, dans un ménage, dans une administration, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2fea857-d74f-4d43-b973-f73290f6b10f",
                                "sense_id": "52ec5462-7592-3ae8-864c-06f15f5a92ed",
                                "text": "En dehors d’événements très rares, comme cet accouchement, le traintrain de ma tante ne subissait jamais aucune variation."
                            },
                            {
                                "example_id": "31683ecd-c299-412a-8fe1-08597c819e86",
                                "sense_id": "52ec5462-7592-3ae8-864c-06f15f5a92ed",
                                "text": "Quoi de neuf ? - Le traintrain…"
                            },
                            {
                                "example_id": "76bb18e5-ced3-4a2e-8483-7c05a1eb28e2",
                                "sense_id": "52ec5462-7592-3ae8-864c-06f15f5a92ed",
                                "text": "Cette renonciation momentanée à ce qu’il aime le plus, les pays ensoleillés, veut dire aussi le renoncement au jeu, qui est pour cet homme un besoin comme pour d’autres la débauche, aux salons dorés de Monte-Carlo, au peu de romanesque mis dans le traintrain des jours par les passades avec des femmes séduisantes ou belles, dont on s’imagine qu’elles ne sont pas vénales, aux brèves pointes vers l’Italie, Gênes, Florence, ou Naples, n’importe, avec ici la visite d’une église et là d’une galerie naguère vues avec Fernande."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04654dba-48d5-4a81-8ba2-bb86cff394cd",
                        "source_entry_id": "8df9657e-ae01-34d4-9514-226d756217de",
                        "source_sense_id": "52ec5462-7592-3ae8-864c-06f15f5a92ed",
                        "target_lang_word": "humdrum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humdrum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f43ee9a-76dc-3264-9f13-cb2fdad17707",
                                        "entry_id": "8247dfe9-1c7d-31af-85cf-187677a74b08",
                                        "glosses": [
                                            "Lacking variety or excitement; dull; boring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70e08048-b8c1-46c7-b010-7296669c2225",
                                                "sense_id": "5f43ee9a-76dc-3264-9f13-cb2fdad17707",
                                                "text": "In the valley there would have been feasting and celebration, and then dancing at the wedding, and afterwards the turmoil of a brief romance turning to humdrum married life, the cares of her house, the cares of children, anxiety, fret, illness, trouble, the day-by-day routine of growing old."
                                            },
                                            {
                                                "example_id": "dc12df2b-8954-4605-82c7-595de2e3a1e2",
                                                "sense_id": "5f43ee9a-76dc-3264-9f13-cb2fdad17707",
                                                "text": "He suggested cusk, because he knew they would have it. She had never heard of cusk. “Doesn't it sound exotic!” she said. “Exotic indeed!” he laughed, and almost told her what a humdrum fish it really was, but stopped himself."
                                            },
                                            {
                                                "example_id": "66df280d-7541-47e4-b3dc-d09eb9d5ef8f",
                                                "sense_id": "5f43ee9a-76dc-3264-9f13-cb2fdad17707",
                                                "text": "With that kind of line-up it was probably inevitable that there would be a few spells when England looked what they were: a team that was trying to find some rhythm, unbeaten for eight years in humdrum qualifying groups but still not entirely sure about whether that makes them any good."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "humdrum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba05ecd9-14b3-3045-a176-e6c6a5be5f74",
                                        "entry_id": "843419d5-ece3-3318-915b-036000877a5f",
                                        "glosses": [
                                            "The quality of lacking variety or excitement."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b9ee6b4-1caf-4fdc-857a-dee480e6dc2c",
                                                "sense_id": "ba05ecd9-14b3-3045-a176-e6c6a5be5f74",
                                                "text": "I think it helped distract us from the dry, humdrum, and heat of the here and now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff4e1263-39b4-3d07-969f-6bf9017b0a92",
                                        "entry_id": "843419d5-ece3-3318-915b-036000877a5f",
                                        "glosses": [
                                            "A stupid fellow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ffb58b3-c396-40f6-87f3-131e44423b1e",
                                                "sense_id": "ff4e1263-39b4-3d07-969f-6bf9017b0a92",
                                                "text": "So, after settling it that Mr. and Mrs. Wilson were complete country humdrums, the daughters hoydens, the sons awkward half-dandies, and the company altogether any thing but agreeable, she came to a conclusion she had done fifty times before, that the country was not like London."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22a3beaf-6222-46d0-865b-4bbefe7fc129",
                        "source_entry_id": "8df9657e-ae01-34d4-9514-226d756217de",
                        "source_sense_id": "52ec5462-7592-3ae8-864c-06f15f5a92ed",
                        "target_lang_word": "daily grind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daily grind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f53d6041-7c8c-3326-b30b-d1bb1fad073b",
                                        "entry_id": "19d0fb32-0be0-3d50-b11c-7c44e4135447",
                                        "glosses": [
                                            "The difficult, routine, or monotonous tasks of daily work."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36d19862-a996-42c6-92ea-0aa72d6cf974",
                                                "sense_id": "f53d6041-7c8c-3326-b30b-d1bb1fad073b",
                                                "text": "As soon as he has the money to retire, he plans to leave the daily grind and travel more."
                                            },
                                            {
                                                "example_id": "a77f819d-ed03-46fe-a470-f262457a4bd8",
                                                "sense_id": "f53d6041-7c8c-3326-b30b-d1bb1fad073b",
                                                "text": "“Why bother with the daily grind when you can go to Mosul, get paid $400 a month, get a wife – and live an Islamic way,” went an exchange between two men overheard by a fellow passenger in a taxi. Rumour has it that a woman whose husband died fighting with Isis now receives a generous widow’s pension from jihadi coffers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
