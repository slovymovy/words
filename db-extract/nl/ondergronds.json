                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c1c156-019e-41c3-bc04-6d43526e08ce",
                                                "sense_id": "ea13fd73-508e-3e37-a529-fb164991e20b",
                                                "text": "the French underground during World War II"
                                            },
                                            {
                                                "example_id": "58406fdf-6160-409b-aa18-8872689d29fe",
                                                "sense_id": "ea13fd73-508e-3e37-a529-fb164991e20b",
