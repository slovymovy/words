                        "glosses": [
                            "Difficult, undesirable, or unpleasant; not to be envied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b329773c-d913-4d8e-bb48-ae37435dd7e6",
                                "sense_id": "ae119c92-607b-387b-8d5c-b809d6c342ac",
                                "text": "Valjean was in the unenviable position of either living with the knowledge an innocent would suffer for his crime or revealing his true identity and going back to prison."
                            },
                            {
                                "example_id": "47d4725e-b53b-4dad-b9f6-b199fc594ecd",
                                "sense_id": "ae119c92-607b-387b-8d5c-b809d6c342ac",
                                "text": "There might be a 'train captain' on board, as on the Docklands Light Railway, but this would be an unenviable role on our packed Tube: the train captain would be condemned to live in a permanent rush hour."
                            }
                        ]
                    }
