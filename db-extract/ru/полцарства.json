                "senses": [
                    {
                        "sense_id": "454a7f6c-61b8-3d6b-9143-1d5e5477ccb4",
                        "entry_id": "e7b64890-3f5c-3986-88cc-e54fa8fe1fc0",
                        "glosses": [
                            "half (of) a kingdom, half (of) the kingdom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d1a6504-8fef-4e87-824f-0b5db173d2cf",
                                "sense_id": "454a7f6c-61b8-3d6b-9143-1d5e5477ccb4",
                                "text": "Ко́ня! Ко́ня! Полца́рства за ко́ня!",
                                "translation": "A horse! A horse! My kingdom for a horse! (from 18th-century actor Yakov Bryansky's poetic translation of Shakespeare's Richard III)",
                                "english": "A horse! A horse! My kingdom for a horse! (from 18th-century actor Yakov Bryansky's poetic translation of Shakespeare's Richard III)"
                            },
                            {
                                "example_id": "90554159-5a8d-477f-8c3a-28cfbda9caef",
                                "sense_id": "454a7f6c-61b8-3d6b-9143-1d5e5477ccb4",
                                "text": "Я бы отда́л полца́рства, что́бы услы́шать э́тот смех.",
                                "translation": "I'd give anything to hear that laugh.",
                                "english": "I'd give anything to hear that laugh."
                            }
                        ]
                    }
