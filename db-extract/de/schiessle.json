                ],
                "senses": [
                    {
                        "sense_id": "0d3d7529-7ede-3bea-9a21-a2da6b27d3db",
                        "entry_id": "3fa3a033-82c7-3e97-9345-7279af097ae8",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "356b60e7-5cd4-4e27-ba68-879329eca389",
                                "sense_id": "0d3d7529-7ede-3bea-9a21-a2da6b27d3db",
                                "text": "Frau Schiessle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "16378d60-7795-48d5-be18-9a160e964ed2",
                                "sense_id": "0d3d7529-7ede-3bea-9a21-a2da6b27d3db",
                                "text": "Herr Schiessle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e81b3288-444b-4a47-9650-281629e04ffe",
                                "sense_id": "0d3d7529-7ede-3bea-9a21-a2da6b27d3db",
                                "text": "Die Schiessles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "620367e3-ca6d-4592-989b-50ac64b3fbc9",
                                "sense_id": "0d3d7529-7ede-3bea-9a21-a2da6b27d3db",
                                "text": "Der Schiessle trägt nie die Pullover, die die Schiessle ihm strickt."
                            },
                            {
                                "example_id": "a51d2eb1-7f91-4e59-b0f0-b80b4f4a32e7",
                                "sense_id": "0d3d7529-7ede-3bea-9a21-a2da6b27d3db",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schiessle kommt, geht der Herr Schiessle.“"
                            },
                            {
                                "example_id": "4c0713fa-ba58-4f6b-aeae-942492b50260",
                                "sense_id": "0d3d7529-7ede-3bea-9a21-a2da6b27d3db",
                                "text": "Schiessle kommt und geht."
                            },
                            {
                                "example_id": "20ce0abd-cc0e-46d7-a832-791883d26c30",
                                "sense_id": "0d3d7529-7ede-3bea-9a21-a2da6b27d3db",
                                "text": "Schiessles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
