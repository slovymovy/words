                                            {
                                                "example_id": "5a819506-48de-4276-aa69-490dafae9f7c",
                                                "sense_id": "95d97669-9621-324e-abd5-90dda74e2cb2",
                                                "text": "Le pipit des arbres (Anthus trivialis) est une des sept espèces de pipits que l’on peut observer en France."
                                            },
                                            {
                                                "example_id": "a1bc8abe-9ce0-4631-adef-e075d8e1d89f",
                                                "sense_id": "95d97669-9621-324e-abd5-90dda74e2cb2",
                                                "text": "Il existe plusieurs espèces de pipits en France et en Europe."
