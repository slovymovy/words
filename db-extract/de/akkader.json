                ],
                "senses": [
                    {
                        "sense_id": "607d696a-a037-3f17-9931-b75e3726727f",
                        "entry_id": "4675501e-3cf4-3284-86af-8e546ea8ac93",
                        "glosses": [
                            "akkadisch sprechender Mensch, (Plural:) akkadisch sprechende Menschengruppe"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c62ca663-d227-4f35-9dfc-6b5597f7030b",
                                "sense_id": "607d696a-a037-3f17-9931-b75e3726727f",
                                "text": "Der Personenname verrät, dass einer der Zeugen in der sumerischen Urkunde ein Akkader war."
                            },
                            {
                                "example_id": "8b931a9d-be2d-4394-9e7c-58ecbd403216",
                                "sense_id": "607d696a-a037-3f17-9931-b75e3726727f",
                                "text": "„Die Akkader waren ein semitisches Volk, dessen Nachkommen sich heute unter den Juden und Arabern finden.“"
                            },
                            {
                                "example_id": "569b50a0-7e84-4e58-b6c0-ee1651508d80",
                                "sense_id": "607d696a-a037-3f17-9931-b75e3726727f",
                                "text": "„Da sich das Sumerische im Lautbestand wie im Sprachbau […] vom Akkadischen grundlegend unterscheidet, standen die Akkader bei der Übernahme der sumerischen Schrift vor erheblichen Schwierigkeiten, […]“"
                            },
                            {
                                "example_id": "1322a1e9-793a-4a59-a6d9-9188e4eaaf7a",
                                "sense_id": "607d696a-a037-3f17-9931-b75e3726727f",
                                "text": "„Später, in der Zeit zwischen 2340 und 2200 v. Chr., unterwarfen die Akkader sogar ganz Mesopotamien und errichteten ein ausgedehntes Imperium, das früheste der Menschheitsgeschichte.“"
                            },
                            {
                                "example_id": "f22ede0f-8148-4892-bd6d-29608bacbb60",
                                "sense_id": "607d696a-a037-3f17-9931-b75e3726727f",
                                "text": "„Ab 2500 v. Chr. drangen vom Süden […] kriegerische semitische Erobererstämme […] nach Norden vor, die Akkader als sogenannte erste Welle, Stämme mit nordostsemitischer Sprache, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "925e22bb-b35c-31e3-8cca-8c722c7a0db0",
                        "entry_id": "4675501e-3cf4-3284-86af-8e546ea8ac93",
                        "glosses": [
                            "zum Reich von Akkad gehöriger Mensch, später: die sich überwiegend durch diese Sprache auszeichnenden Bewohner der Landschaft Akkad"
                        ],
                        "tags": [
                            "geography",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "ff52045f-986e-49d6-aa96-d5e4873a69ff",
                                "sense_id": "925e22bb-b35c-31e3-8cca-8c722c7a0db0",
                                "text": "„Da sich das Sumerische im Lautbestand wie im Sprachbau […] vom Akkadischen grundlegend unterscheidet, standen die Akkader bei der Übernahme der sumerischen Schrift vor erheblichen Schwierigkeiten, […]“"
                            },
                            {
                                "example_id": "815ea49c-0c74-4683-8325-90ab502651ed",
                                "sense_id": "925e22bb-b35c-31e3-8cca-8c722c7a0db0",
                                "text": "„Später, in der Zeit zwischen 2340 und 2200 v. Chr., unterwarfen die Akkader sogar ganz Mesopotamien und errichteten ein ausgedehntes Imperium, das früheste der Menschheitsgeschichte.“"
                            },
                            {
                                "example_id": "97fb7947-61aa-4712-b496-37ce73427fdb",
                                "sense_id": "925e22bb-b35c-31e3-8cca-8c722c7a0db0",
                                "text": "„Ab 2500 v. Chr. drangen vom Süden […] kriegerische semitische Erobererstämme […] nach Norden vor, die Akkader als sogenannte erste Welle, Stämme mit nordostsemitischer Sprache, […].“"
                            },
                            {
                                "example_id": "f2a31e70-6043-4a34-b17c-c5cf1188a161",
                                "sense_id": "925e22bb-b35c-31e3-8cca-8c722c7a0db0",
                                "text": "„Der Name der neuen Hauptstadt [Akkade] übertrug sich auf ganz Nord-Babylonien, dessen Bevölkerung, unabhängig von ihrer Herkunft oder Sprache, als ›Akkader‹ eine neue geschichtliche Identität gewann.“"
                            },
                            {
                                "example_id": "68e71b3f-7617-44a5-991a-65b16ce750d8",
                                "sense_id": "925e22bb-b35c-31e3-8cca-8c722c7a0db0",
                                "text": "„Vom Zentrum Akkad aus regierten die Akkader ein kulturell äußerst heterogenes Reich, […].“"
                            },
                            {
                                "example_id": "2ba48cb5-5997-4c77-bc7f-e394daa5cb8c",
                                "sense_id": "925e22bb-b35c-31e3-8cca-8c722c7a0db0",
                                "text": "„Niederlagen der Akkader gegen Bergstämme im Norden Elams ermöglichten es dann um 2200 dem elamischen König […], eine Reihe von Bergländern seiner Macht zu unterwerfen […].“"
                            },
                            {
                                "example_id": "7f9ac43b-e5ba-444d-8571-849a280a6bda",
                                "sense_id": "925e22bb-b35c-31e3-8cca-8c722c7a0db0",
                                "text": "„Das Sargoniden-Reich gerät unter Druck durch kriegerische Bergstämme aus dem iranischen […] Zagros-Gebirge […], die die Akkader angreifen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
