                    {
                        "translation_id": "f77d4f1b-3853-4625-bc58-c5eb5f657443",
                        "source_entry_id": "f17f3e68-a403-3978-bde0-b6beb48b6dae",
                        "source_sense_description": "capital of Colorado",
                        "target_lang_word": "Де́нвер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Де́нвер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4f64ff64-3fc5-3872-85e2-8fd1eff05c60",
                                        "entry_id": "1b1c00f8-c45f-30b5-a82a-e0f43ab6b590",
                                        "glosses": [
                                            "геогр. город в США, столица штата Колорадо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e605f779-1f1a-44d5-8f33-19d5efdf4954",
                                                "sense_id": "4f64ff64-3fc5-3872-85e2-8fd1eff05c60",
                                                "text": "Как вскоре узнал Юджин, Лайл успел поработать во всех концах Соединённых Штатов — в Денвере, Портленде, Сент-Поле, Сент-Луисе .."
                                            },
                                            {
                                                "example_id": "7f2a5a97-c6f8-42d6-8ded-13c56162c35f",
                                                "sense_id": "4f64ff64-3fc5-3872-85e2-8fd1eff05c60",
                                                "text": "― Я был в Чикаго, в Сент-Луисе, в Канзас-Сити, в Денвере, в Лос-Анджелесе, в Солт-Лейк-Сити. // Он тщательно перечислил все города. // ― Долго вы были в Америке? // ― Пятнадцать лет."
                                            },
                                            {
                                                "example_id": "2c97d141-cc0d-4942-9a5e-3d85f92fdb1d",
                                                "sense_id": "4f64ff64-3fc5-3872-85e2-8fd1eff05c60",
                                                "text": "Отец и мать Клайда всё время чувствовали, что из-за истории с Эстой им следует уехать из Канзас-Сити и поселиться в Денвере."
                                            },
                                            {
                                                "example_id": "35b1f504-a59d-4a23-bf8f-2c3c068ea503",
                                                "sense_id": "4f64ff64-3fc5-3872-85e2-8fd1eff05c60",
                                                "text": "Мы прилетели в г. Денвер — центр штата Колорадо."
                                            },
                                            {
                                                "example_id": "44aa1329-9c1b-400f-b84d-be907fda24a9",
                                                "sense_id": "4f64ff64-3fc5-3872-85e2-8fd1eff05c60",
                                                "text": "Мой хороший приятель, бывший второй пилот, уже третий год жил в Америке, в маленьком городке под Денвером (штат Колорадо) .."
                                            },
                                            {
                                                "example_id": "f08f356a-a7f3-450b-867f-f3c836c317ad",
                                                "sense_id": "4f64ff64-3fc5-3872-85e2-8fd1eff05c60",
                                                "text": "Сейчас Константин Григорьевич живёт в Денвере (США)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
