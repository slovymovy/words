                    {
                        "sense_id": "a7797188-f55f-326b-8074-24bcd82d3b25",
                        "entry_id": "e46aa0fa-18fc-3f26-a96e-ef0c7aa740e0",
                        "glosses": [
                            "Zustand, in dem kein Zuwachs, Wachstum, Anstieg (mehr) stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55af64c-0952-4f32-8397-12985577bbcb",
                                "sense_id": "a7797188-f55f-326b-8074-24bcd82d3b25",
                                "text": "Aufgrund der mangelnden Nachfrage kam es zu einer Stagnation der Absätze."
                            },
                            {
                                "example_id": "f7302fb4-1318-4b2d-9b71-5dd3b674e679",
                                "sense_id": "a7797188-f55f-326b-8074-24bcd82d3b25",
                                "text": "Der Diskussionsverlauf unterliegt aufgrund festgefahrender Meinungen einer zunehmenden Stagnation."
                            },
                            {
                                "example_id": "e0543ca7-b0ae-4a6e-ac0b-f099f6101b4c",
                                "sense_id": "a7797188-f55f-326b-8074-24bcd82d3b25",
                                "text": "„Von einem kurzen Nachkriegsboom abgesehen, erlebte Großbritannien in den 20er Jahren eine Stagnation der traditionellen Branchen der Textilindustrie, des Kohlenbergbaus oder des Schiffbaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
