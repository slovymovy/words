                    }
                ],
                "senses": [
                    {
                        "sense_id": "467ffd3c-dccf-36f2-8b5c-480af42aa5a1",
                        "entry_id": "b887d110-d2f0-35a5-a401-fe99300b153c",
                        "glosses": [
                            "The seepage or filtration of a liquid through a porous substance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "983fac62-d70d-476c-abd5-fc8baaaeebd1",
                                "sense_id": "467ffd3c-dccf-36f2-8b5c-480af42aa5a1",
                                "text": "With simultaneous measurement of channel conductivity and its slow time-dependent fluctuation (or noise) in ultra-thin WSe2 and MoS2 FETs on insulating SiO2 substrates, where noise arises from McWhorter-type carrier number fluctuations, we establish that the switching in conventional backgated TMDC FETs is a classical percolation transition in a medium of inhomogeneous carrier density distribution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcad7bce-9157-40f7-a6d1-ffc4fe0bcc6f",
                        "source_entry_id": "b887d110-d2f0-35a5-a401-fe99300b153c",
                        "source_sense_id": "467ffd3c-dccf-36f2-8b5c-480af42aa5a1",
                        "source_sense_description": "seepage or filtration of a liquid",
                        "target_lang_word": "doorsijpelen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doorsijpelen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "61f61d0d-c47a-3a10-806a-1c00def746b4",
                                        "entry_id": "a1b5f49c-8d71-39e4-87c5-3314130102ab",
                                        "glosses": [
                                            "druppelsgewijze ergens doorheen lekken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02bbd73-f942-4cd2-a718-3d8c4fa9b72c",
                                                "sense_id": "61f61d0d-c47a-3a10-806a-1c00def746b4",
                                                "text": "Aydemir is zelf kleinkind van Turkse migranten, en als journaliste in Berlijn kent ze het leven in de grootstad. Het zijn ervaringen die doorsijpelen in haar beenharde verhaal over een meisje dat ontspoort."
                                            },
                                            {
                                                "example_id": "2dce6d00-528f-4225-ba11-a6bc22b52498",
                                                "sense_id": "61f61d0d-c47a-3a10-806a-1c00def746b4",
                                                "text": "Kim Jong-un is een onvoorspelbare dictator die lijdt aan grootheidswaanzin. De verhalen die sporadisch doorsijpelen uit het gesloten land doen de haren ten berge rijzen. Tegelijk heeft hij ondanks zijn eindeloos gedreig andere landen (nog) niet aangevallen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29800691-4a8b-35a4-a410-d08babcb5510",
                                        "entry_id": "a1b5f49c-8d71-39e4-87c5-3314130102ab",
                                        "glosses": [
                                            "langzaam effect beginnen te hebben"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b64039e2-0be8-48ce-b2ed-73d07f9260a1",
                                                "sense_id": "29800691-4a8b-35a4-a410-d08babcb5510",
                                                "text": "De gevolgen van de economische opleving beginnen nu ook in de provincie door te sijpelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a73b2d37-6cb9-4b92-87fa-177bf4b76ec6",
                        "source_entry_id": "b887d110-d2f0-35a5-a401-fe99300b153c",
                        "source_sense_id": "467ffd3c-dccf-36f2-8b5c-480af42aa5a1",
                        "source_sense_description": "seepage or filtration of a liquid",
                        "target_lang_word": "percolation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "percolation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f604c2ee-3538-3b42-a100-95485b614e3c",
                                        "entry_id": "16ba2cda-b77f-326f-abcf-ad16f72c916e",
                                        "glosses": [
                                            "Action de percoler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3c59a5-2f17-494a-b12e-a038295aa75e",
                                                "sense_id": "f604c2ee-3538-3b42-a100-95485b614e3c",
                                                "text": "La percolation de l'eau n'est pas stoppée par la valeur élevée de la microporosité. Quand le déficit hydrique de cette microporosité est comblé, l'eau peut percoler et permettre la lixiviation des éléments dissous en surface."
                                            },
                                            {
                                                "example_id": "fb71ef00-ef6c-4669-97f9-a63acfa6cb16",
                                                "sense_id": "f604c2ee-3538-3b42-a100-95485b614e3c",
                                                "text": "La théorie mathématique de la percolation repose sur l'étude probabiliste d'apparition des amas en fonction des fractions de phases en présence."
                                            },
                                            {
                                                "example_id": "059bea0c-0d5e-476d-9668-a9ba2ff41743",
                                                "sense_id": "f604c2ee-3538-3b42-a100-95485b614e3c",
                                                "text": "Lorsqu’apparaît à quelques décimètres de profondeur une couche imperméable (argile compacte, limons tassés) qui est appelée plancher, cette dernière peut entraîner la formation d’une véritable nappe au-dessus, par défaut de percolation des eaux pluviales, notamment dans une couche limoneuse, voire sableuse, sus-jacente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd3c31f4-8738-4055-815d-cbcf6483b6ab",
                        "source_entry_id": "b887d110-d2f0-35a5-a401-fe99300b153c",
                        "source_sense_id": "467ffd3c-dccf-36f2-8b5c-480af42aa5a1",
                        "source_sense_description": "seepage or filtration of a liquid",
                        "target_lang_word": "Perkolation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perkolation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4597d5dc-c9af-3443-a84c-b9e742fe69f4",
                                        "entry_id": "77c914eb-d8f3-39f7-93b1-88923e1b9758",
                                        "glosses": [
                                            "Gewinnung eines Extrakts, eines Auszugs aus Gewächsen, indem gefiltert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbdfc223-074b-4708-abed-6b5bcdfdc16f",
                                                "sense_id": "4597d5dc-c9af-3443-a84c-b9e742fe69f4",
                                                "text": "„Legen wir eine kurze Pause ein, um uns klarzumachen, dass die Perkolation tatsächlich mehr Alkohol benötigt als die Mazeration.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b8fb2f2-9c28-3552-bcae-710132603ac7",
                                        "entry_id": "77c914eb-d8f3-39f7-93b1-88923e1b9758",
                                        "glosses": [
                                            "Versickern/Durchfließen von Wasser im Erdreich"
                                        ],
                                        "tags": [
                                            "Bodenkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9475020b-8322-44a3-b2db-216d6a47d3e3",
                                                "sense_id": "4b8fb2f2-9c28-3552-bcae-710132603ac7",
                                                "text": "Es lag eine sehr gute Perkolation im Oberboden vor, aber eine schwach gehemmte Versickerung im Unterboden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9f2c3b66-38b9-36b4-be2e-2110c542d6ca",
                                        "entry_id": "77c914eb-d8f3-39f7-93b1-88923e1b9758",
                                        "glosses": [
                                            "Phänomen, das die (ungleichmäßige, schlagartige) Ausbreitung von etwas (zum Beispiel die einer Epidemie oder eines Computervirus) erläutern hilft; Übergang von lokal betroffenen Inseln zu flächendeckender Durchdringung"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87b50c96-9baa-45ae-8461-23f7eae317d4",
                                                "sense_id": "9f2c3b66-38b9-36b4-be2e-2110c542d6ca",
                                                "text": "„Perkolation – ein Phänomen aus der Physik erklärt, wie Corona außer Kontrolle geraten könnte.“"
                                            },
                                            {
                                                "example_id": "2d825444-dde2-4795-89c0-a028a081332c",
                                                "sense_id": "9f2c3b66-38b9-36b4-be2e-2110c542d6ca",
                                                "text": "„Beispiele dafür sind die Perkolation in der Nähe der Perkolationsschwelle, Polymere im Grenzfall großer Zahl von Monomeren, Wiederkehr vermeidende Zufallsbewegung, Wachstumsvorgänge und getriebene dissipative Systeme im Grenzfall langsamer Wachstumsrate (selbstorganisierte Kritikalität).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
