                            }
                        },
                        {
                            "text": "Zij speelt prachtig op haar <w>instrument</w> tijdens het concert.",
                            "target_lang_translations": {
                                "en": "She plays her <w>instrument</w> beautifully during the concert.",
                                "ru": "Она прекрасно играет на своем <w>инструменте</w> во время концерта.",
                                "pl": "Ona pięknie gra na swoim <w>instrumencie</w> podczas koncertu.",
                                "de": "Sie spielt während des Konzerts wunderschön auf ihrem <w>Instrument</w>.",
                                "fr": "Elle joue magnifiquement de son <w>instrument</w> pendant le concert.",
                                "it": "Lei suona magnificamente il suo <w>strumento</w> durante il concerto.",
