                "senses": [
                    {
                        "sense_id": "14efa7bf-043b-376c-bcb0-bed8c0ee1ccf",
                        "entry_id": "2fc0ef46-6863-358e-90a7-2e99c5a23132",
                        "glosses": [
                            "Krieg zwischen den Angehörigen eines Volkes oder zweier nahestehender Völker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f9f36e-96b7-41e3-a0e8-af071b4ab687",
                                "sense_id": "14efa7bf-043b-376c-bcb0-bed8c0ee1ccf",
                                "text": "„Er fürchtete außerdem den Konflikt zwischen den auf britischer und auf türkischer Seite kämpfenden jüdischen Soldaten, die auf diese Weise in einen Bruderkrieg verwickelt würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41327832-7481-3804-8500-e87a91b46033",
                        "entry_id": "2fc0ef46-6863-358e-90a7-2e99c5a23132",
                        "glosses": [
                            "Krieg zwischen mindestens zwei Söhnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e79779c3-52ee-4a10-aabc-7ab5c1b82e18",
                                "sense_id": "41327832-7481-3804-8500-e87a91b46033",
                                "text": "„Der Vertrag von Verdun, ein fairer und nicht einmal ungeschickter Kompromiß, beendete den Bruderkrieg der Söhne Ludwigs.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
