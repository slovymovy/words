                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9850dee9-fdbb-413c-a432-7de03927478a",
                                "sense_id": "458dfcee-f460-3bcc-8caa-dc3c5773f8d9",
                                "text": "Do tatrzańskich endemitów zalicza się przymiotno węgierskie i ostróżkę tatrzańską."
                            }
