                "senses": [
                    {
                        "sense_id": "50de1be6-ebbe-3ff8-b870-038b54cdc8eb",
                        "entry_id": "d20e1943-7b34-3571-b47b-949c96b18bcf",
                        "glosses": [
                            "Rohr zur Wasser- oder Abwasserleitung unter hohem Druck eines Bodeneinschnitts, der meist von Baustellen, Bahnlinien oder einem Gewässer verursacht wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c8ff47-040a-4f3f-9737-5a2c1b89972c",
                                "sense_id": "50de1be6-ebbe-3ff8-b870-038b54cdc8eb",
                                "text": "Wegen des schweren Drucks, der vom See unter dem Boden erzeugt wurde, mussten die Männer einen Düker unter dem Gewässer erbauen, sodass die Leitung des Wassers der hohen Schwere standhalten konnte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e471b7-6496-4f0b-9505-9b6e8943d79b",
                        "source_entry_id": "d20e1943-7b34-3571-b47b-949c96b18bcf",
                        "source_sense_id": "50de1be6-ebbe-3ff8-b870-038b54cdc8eb",
                        "source_sense_description": "Rohr zur Wasser- oder Abwasserleitung unter hohem Druck eines Bodeneinschnitts",
                        "target_lang_word": "culvert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culvert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "463357a8-6ed9-3b5e-96b4-ca5fca2d91ea",
                                        "entry_id": "030485ad-9bee-3808-91bd-1b9a5040d4c9",
                                        "glosses": [
                                            "A channel crossing under a road or railway for the draining of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14c08b22-c70f-4ea0-99c7-764ebe0e0f48",
                                                "sense_id": "463357a8-6ed9-3b5e-96b4-ca5fca2d91ea",
                                                "text": "A raft of twigs stayed upon a stone, suddenly detached itself, and floated towards the culvert."
                                            },
                                            {
                                                "example_id": "73dba568-4945-4722-977e-37b0be59e223",
                                                "sense_id": "463357a8-6ed9-3b5e-96b4-ca5fca2d91ea",
                                                "text": "After she left, I ran away for a day, and hid myself, solitary, in a culvert under the railway lines."
                                            },
                                            {
                                                "example_id": "4e4d65e3-ce85-43ad-8ad4-88b971bc03f3",
                                                "sense_id": "463357a8-6ed9-3b5e-96b4-ca5fca2d91ea",
                                                "text": "It was on the leisurely upswing when, 16 years after we bought our house, a woman driving a fancy S.U.V. jumped the culvert, plowed through the hedge, jumped the culvert again and sped off."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "culvert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c7e2513-3b34-3def-84d0-d30d885a2033",
                                        "entry_id": "70642627-12f2-3747-8fee-922c3656f036",
                                        "glosses": [
                                            "To channel (a stream of water) through a culvert."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a83eab-06ad-47e9-8d99-90b6405a511e",
                                                "sense_id": "9c7e2513-3b34-3def-84d0-d30d885a2033",
                                                "text": "This led to a great deal of straightening and culverting, which in turn led to a massive loss of biodiversity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
