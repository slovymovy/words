                "senses": [
                    {
                        "sense_id": "4f30c46f-8a9d-3f9e-b230-e43267d2fc8b",
                        "entry_id": "a6d38dbf-1a72-3f85-b82c-389809966704",
                        "glosses": [
                            "Savourer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b839178-060b-4f5f-b962-e21740526de1",
                                "sense_id": "4f30c46f-8a9d-3f9e-b230-e43267d2fc8b",
                                "text": "Pour s'y résigner, il n'est que de revivre, resavourer les émotions que le « maître » a fait naître chez l'un de ses élèves !"
                            },
                            {
                                "example_id": "2b77f48e-0594-4beb-9569-c4b6e94845d4",
                                "sense_id": "4f30c46f-8a9d-3f9e-b230-e43267d2fc8b",
                                "text": "Si jamais je porte votre nom, je l'écrirai peut-être quarante fois le jour pour jouir de ma joie et la resavourer."
                            },
                            {
                                "example_id": "9a2914ea-9860-4529-bd89-51086f5a61bf",
                                "sense_id": "4f30c46f-8a9d-3f9e-b230-e43267d2fc8b",
                                "text": "J'irais resavourer l'affolante sensation de la culbute dans la mélasse."
                            }
                        ]
                    }
