                "senses": [
                    {
                        "sense_id": "3690c848-6df3-33da-a8d0-dd31ca8d4498",
                        "entry_id": "6efb5e0a-225b-3b66-a6ab-8eb5b3a06081",
                        "glosses": [
                            "großes Interesse und Begeisterung für das Basteln (kleine Handwerksarbeiten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7dc4d93-2f72-4c3b-9254-49378159d7f9",
                                "sense_id": "3690c848-6df3-33da-a8d0-dd31ca8d4498",
                                "text": "„Bei der Herstellung hatte ich oft Zuschauer, die mir über die Schulter schauten und sich von meiner Bastelleidenschaft anstecken ließen.“"
                            },
                            {
                                "example_id": "b775223a-e772-4ee1-bf4c-8e7540696670",
                                "sense_id": "3690c848-6df3-33da-a8d0-dd31ca8d4498",
                                "text": "„Diese Basteleien sind meiner Meinung nach, prädestiniert für Erwachsene mit Bastelleidenschaft.“"
                            },
                            {
                                "example_id": "39b89fc5-593b-47c1-9a02-d568dce2c784",
                                "sense_id": "3690c848-6df3-33da-a8d0-dd31ca8d4498",
                                "text": "„Einen Teil des ersparten Geldes verwendete ich für meine Bastelleidenschaft, um eine Eisenbahnanlage auf einem Brett mit Bahnhof und Häusern aufzubauen.“"
                            },
                            {
                                "example_id": "e71e6f0c-25d0-48d2-9a40-bb6e0747bcad",
                                "sense_id": "3690c848-6df3-33da-a8d0-dd31ca8d4498",
                                "text": "„Er kannte schließlich den Erfindungsreichtum und die Bastelleidenschaft seines Butlers.“"
                            },
                            {
                                "example_id": "e6b121a6-5b9a-44ae-8d7c-1e6f8a03d2f3",
                                "sense_id": "3690c848-6df3-33da-a8d0-dd31ca8d4498",
                                "text": "„Danach war er auf seinen Dachboden gestiegen und hatte im ersten Morgenlicht die Früchte seiner Bastelleidenschaft betrachtet.“"
                            },
                            {
                                "example_id": "e18f6df4-719c-4e73-805e-e4159931338c",
                                "sense_id": "3690c848-6df3-33da-a8d0-dd31ca8d4498",
                                "text": "„Die Mütter der Kindergartenkinder hatten ganz offensichtlich ihre Bastelleidenschaften während des Zubereitens von eigentlich einfachen Speisen ausgelebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
