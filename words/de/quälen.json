    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd3e52fe-2faf-3b68-9b1d-8287d1e333e4",
                    "sense_definition": "Jemandem oder einem Tier absichtlich körperliche Schmerzen oder großes Leid zufügen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "leid_zufuegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es ist verboten und grausam, wehrlose Tiere absichtlich zu <w>quälen</w>."
                        },
                        {
                            "text": "Der rücksichtslose Wächter <w>quälte</w> die hilflosen Gefangenen über viele Wochen hinweg."
                        }
                    ],
                    "synonyms": [
                        "foltern",
                        "misshandeln"
                    ],
                    "common_phrases": [
                        "ein Tier quälen"
                    ]
                },
                {
                    "sense_id": "ba3d930e-aebd-3881-b3a4-237395d56499",
                    "sense_definition": "Jemandem seelischen Schmerz bereiten oder starke Sorgen und Unruhe verursachen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leid_zufuegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seit dem schrecklichen Unfall <w>quälen</w> ihn ständige Selbstvorwürfe und schwere Schuldgefühle."
                        },
                        {
                            "text": "Die ständige Ungewissheit über ihre berufliche Zukunft <w>quälte</w> die junge Frau monatelang."
                        }
                    ],
                    "common_phrases": [
                        "von Schuldgefühlen gequält werden",
                        "von Zweifeln gequält werden"
                    ],
                    "synonyms": [
                        "plagen"
                    ]
                },
                {
                    "sense_id": "4bab2abf-1a29-37b9-9301-d12e28ebc52d",
                    "sense_definition": "Sich unter großer körperlicher oder geistiger Anstrengung nur mühsam vorwärtsbewegen oder abmühen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anstrengung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeden frühen Morgen muss er sich mühsam aus dem warmen Bett <w>quälen</w>."
                        },
                        {
                            "text": "Die müden Wanderer <w>quälten</w> sich die letzten Kilometer den steilen Berg hinauf."
                        }
                    ],
                    "common_phrases": [
                        "sich aus dem Bett quälen",
                        "sich durch den Berufsverkehr quälen"
                    ]
                },
                {
                    "sense_id": "b7edff64-3610-3e88-b069-eaf2b6692101",
                    "sense_definition": "Jemandem lästig fallen oder durch wiederholte Fragen oder Forderungen belästigen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "belaestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte <w>quäle</w> mich nach diesem anstrengenden Arbeitstag nicht mit weiteren schwierigen Fragen."
                        },
                        {
                            "text": "Die ungeduldigen Journalisten <w>quälten</w> den Politiker mit immer denselben bohrenden Fragen."
                        }
                    ],
                    "common_phrases": [
                        "mit neugierigen Fragen quälen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cab59c6-d43f-3a5c-8cb5-cd6882edb09b",
                    "sense_definition": "Das absichtliche Zufügen von körperlichen oder seelischen Schmerzen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "leid_zufuegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das grausame <w>Quälen</w> von Tieren wird vom Gesetzgeber streng bestraft."
                        },
                        {
                            "text": "Niemand im Dorf konnte das sinnlose <w>Quälen</w> der Gefangenen länger ertragen."
                        }
                    ],
                    "synonyms": [
                        "Quälerei"
                    ],
                    "common_phrases": [
                        "das Quälen von Tieren"
                    ]
                }
            ]
        }
    ]
