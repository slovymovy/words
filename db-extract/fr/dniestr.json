                    {
                        "sense_id": "fe791bef-0062-3dbf-a9fb-89365a679b67",
                        "entry_id": "dc97f6ad-89bd-3d68-8182-b0f63ba404c3",
                        "glosses": [
                            "Fleuve d’Europe de l’Est, long de 1 362 km, qui prend sa source dans les Beskides orientales en Galicie, pour se jeter dans la mer Noire près d’Odessa."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76459e4b-07f0-4150-8afe-652922a22fd0",
                        "source_entry_id": "dc97f6ad-89bd-3d68-8182-b0f63ba404c3",
                        "source_sense_id": "fe791bef-0062-3dbf-a9fb-89365a679b67",
                        "target_lang_word": "Dnister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dnister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68d4e6a7-a7d5-3c83-bc68-2b880c4d154d",
                                        "entry_id": "b92bcf0e-adad-34a5-bfa9-cac51c36ebaf",
                                        "glosses": [
                                            "ukrainisch-moldawischer Zufluss zum Schwarzen Meer"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475f4fa8-ec04-43dc-9658-458295509565",
                                                "sense_id": "68d4e6a7-a7d5-3c83-bc68-2b880c4d154d",
                                                "text": "„Der Dnister ist nicht einfach nur ein Fluss. Er ist die Landesgrenze eines Staates, den es eigentlich nicht gibt.“"
                                            },
                                            {
                                                "example_id": "f680932f-7230-4e2b-878d-527244c3da58",
                                                "sense_id": "68d4e6a7-a7d5-3c83-bc68-2b880c4d154d",
                                                "text": "„Westlich des Dnister ist Rumänisch die offizielle Amtssprache.“"
                                            },
                                            {
                                                "example_id": "483a9ee8-b276-4d07-8c66-1acf8c48c16c",
                                                "sense_id": "68d4e6a7-a7d5-3c83-bc68-2b880c4d154d",
                                                "text": "„Heute hat die Regierung in Chişinău die Kontrolle über das Territorium östlich des Dnister verloren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "681b658c-2753-4d19-b22d-e55e4fb7c5bd",
                        "source_entry_id": "dc97f6ad-89bd-3d68-8182-b0f63ba404c3",
