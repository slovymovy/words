                "senses": [
                    {
                        "sense_id": "325ceb12-0d81-333e-9abc-f3cb9174372e",
                        "entry_id": "8d5f5bae-f595-3af1-9a59-8fcb10a556fc",
                        "glosses": [
                            "Form der Komödie, bei der komische Effekte durch körperbezogene Aktionen hervorgerufen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a19133-8b4d-4f3a-94ff-002152c92695",
                                "sense_id": "325ceb12-0d81-333e-9abc-f3cb9174372e",
                                "text": "Charlie Chaplin war ein Meister des Slapsticks."
                            },
                            {
                                "example_id": "21e402a1-9a15-4e33-9e4f-7190a88e0ee8",
                                "sense_id": "325ceb12-0d81-333e-9abc-f3cb9174372e",
                                "text": "„Der Slapstick und die Slapstick-Komik garantierten den weichen Fall.“"
                            },
                            {
                                "example_id": "e27b530f-5f24-4686-9670-88d02841b8e0",
                                "sense_id": "325ceb12-0d81-333e-9abc-f3cb9174372e",
                                "text": "„Wieland führt uns wie in Zeitlupe vor, was am Ende wie ein Slapstick im Zeitraffer erscheint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ff57c50-503d-3a4d-8a07-653d9ecafee4",
                        "entry_id": "8d5f5bae-f595-3af1-9a59-8fcb10a556fc",
                        "glosses": [
                            "ein derb-komischer Gag, eine meist körperbezogene, lustige Szene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a9b734c-e717-4181-bdd3-1826b1da4062",
                                "sense_id": "5ff57c50-503d-3a4d-8a07-653d9ecafee4",
                                "text": "Ein klassischer Slapstick ist das Werfen einer Sahnetorte in das Gesicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
