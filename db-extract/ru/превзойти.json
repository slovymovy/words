                                        "entry_id": "084fb245-b0e9-3838-a5ce-0e32f41b2f6c",
                                        "glosses": [
                                            "Outrepasser, aller au-delà de certaines limites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c0af5e-a20b-406b-b53c-e217e07fc29b",
                                                "sense_id": "03b46003-695d-319f-b179-8812944c862b",
                                                "text": "Il a excédé son pouvoir, ses pouvoirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc7cfb25-93be-36f1-a840-f0f8d6ac6cd1",
                                        "entry_id": "084fb245-b0e9-3838-a5ce-0e32f41b2f6c",
                                        "glosses": [
                                            "Surpasser en valeur, en nombre, dépasser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5be6d06-50a4-4a17-834b-c29690e2cdab",
                                                "sense_id": "bc7cfb25-93be-36f1-a840-f0f8d6ac6cd1",
                                                "text": "La dépense a excédé la recette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                                        "entry_id": "084fb245-b0e9-3838-a5ce-0e32f41b2f6c",
                                        "glosses": [
                                            "Lasser, au sens physique et moral."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bbee63-b614-4fdd-a5f3-c7808d5ae4ae",
                                                "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                                                "text": "Cette course m’a excédé."
                                            },
                                            {
                                                "example_id": "db4e8576-db0b-4095-bf02-ea3bd0dccb4e",
                                                "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                                                "text": "Je suis excédé de fatigue."
                                            },
                                            {
                                                "example_id": "343cdb4c-a7df-4b4e-929a-7f065b548176",
                                                "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                                                "text": "Il excède tout le monde par son éternel bavardage."
                                            },
                                            {
                                                "example_id": "2080662d-c8c8-431c-802c-1cb0690cf27f",
                                                "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                                                "text": "Monsieur, vous m'excédez ! fit une voix qui le fit tressaillir. Vos hommages ressemblent à une insulte !"
                                            },
                                            {
                                                "example_id": "2ec43e7e-3d41-4e60-95f7-932f1c98acaf",
                                                "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                                                "text": "— N’excède pas ma patience !"
                                            },
                                            {
                                                "example_id": "b04b6d7b-1911-4440-a6fa-1712b69e13c3",
                                                "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                                                "text": "Ma mère, excédée de travail, m’habillait avec négligence ; mes robes informes accentuaient ma gaucherie."
                                            },
                                            {
                                                "example_id": "e48ede86-2ae8-4de7-9c3e-b700e7bd7213",
                                                "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                                                "text": "Excéder de flatteries, d’attentions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "435b1351-aa49-3edb-89f6-4d950f4150a1",
                                        "entry_id": "084fb245-b0e9-3838-a5ce-0e32f41b2f6c",
                                        "glosses": [
                                            "Se fatiguer à l’excès."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c52eba7-bd08-4087-b5f4-146e813b3fc9",
                                                "sense_id": "435b1351-aa49-3edb-89f6-4d950f4150a1",
                                                "text": "De son côté, Louise s’excédait, malade, faible, effarée par cette maladie sans remède qui la minait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
