    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3766d157-1025-33b7-9234-1d5cb31e79b3",
                    "sense_definition": "Couper ras l'herbe d'un jardin ou d'un pré à l'aide d'un appareil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "coupe_vegetale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque samedi matin, mon père <w>tond</w> la pelouse devant la maison."
                        },
                        {
                            "text": "Il fait beaucoup trop chaud cet après-midi pour <w>tondre</w> le gazon."
                        }
                    ],
                    "common_phrases": [
                        "tondre la pelouse",
                        "tondre le gazon"
                    ]
                },
                {
                    "sense_id": "c218c27e-6f1d-3f8e-b1ce-fa859e8d8975",
                    "sense_definition": "Couper à ras la laine ou les poils d'un animal, particulièrement d'un mouton.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "coupe_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au printemps, l'éleveur rassemble son troupeau pour <w>tondre</w> les moutons."
                        },
                        {
                            "text": "On <w>tond</w> les bêtes une fois par an afin de récolter leur laine."
                        }
                    ],
                    "common_phrases": [
                        "tondre les moutons",
                        "tondre les brebis"
                    ]
                },
                {
                    "sense_id": "6ea82051-e973-363f-a16e-dcb6ea8d60ed",
                    "sense_definition": "Couper les cheveux de très près, raser la tête.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "coupe_cheveux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir au service militaire, il a décidé de se faire <w>tondre</w>."
                        },
                        {
                            "text": "Le coiffeur lui a <w>tondu</w> la tête un peu trop court selon son goût."
                        }
                    ],
                    "common_phrases": [
                        "se faire tondre"
                    ]
                },
                {
                    "sense_id": "fef92b39-e1c5-3a05-864b-68f9ca3f1de4",
                    "sense_definition": "Dépouiller quelqu'un de son argent ou de ses biens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "argent_vol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce joueur imprudent s'est fait totalement <w>tondre</w> au casino hier soir."
                        },
                        {
                            "text": "Ces aigrefins l'ont complètement <w>tondu</w> lors de cette mauvaise affaire."
                        }
                    ],
                    "synonyms": [
                        "ratiboiser"
                    ],
                    "common_phrases": [
                        "se faire tondre"
                    ],
