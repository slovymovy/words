    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "720aae6e-fe3f-33db-82f0-84f06cb3dd9b",
                    "sense_definition": "To discontinue the sessions of a parliament or legislative assembly without dissolving it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "suspend_assembly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prime minister advised the monarch to <w>prorogue</w> parliament until the next month."
                        },
                        {
                            "text": "Opposition lawmakers argued that the government was trying to <w>prorogue</w> the assembly to avoid scrutiny."
                        }
                    ],
                    "common_phrases": [
                        "prorogue parliament"
                    ]
                },
                {
                    "sense_id": "5e6770cc-78a3-329c-988d-dbb9506631f0",
                    "sense_definition": "To delay or put off to a later time; to defer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "postpone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>prorogue</w> the hearing until more evidence could be gathered."
                        },
                        {
                            "text": "The committee chose to <w>prorogue</w> further debate on the matter until the following spring."
                        }
                    ],
                    "synonyms": [
                        "defer",
                        "postpone"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or archaic usage"
                        }
                    ]
                },
                {
                    "sense_id": "2914c596-f099-32b5-b771-cb443bf3ae45",
                    "sense_definition": "To prolong, extend, or lengthen in duration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient physicians claimed that a cheerful disposition could <w>prorogue</w> human life."
                        },
                        {
                            "text": "No medicine could <w>prorogue</w> his failing vitality as the winter wore on."
                        }
                    ],
                    "synonyms": [
                        "extend",
                        "prolong",
                        "protract"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or archaic usage"
                        }
                    ]
                }
            ]
        }
