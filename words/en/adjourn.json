{
    "word_family": [
        "adjournment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2627fdf2-64f6-3c8d-8149-d1e8136cbdf3",
                    "sense_definition": "To postpone a meeting or legal proceeding to a later time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postpone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>adjourn</w> the trial until next Monday."
                        },
                        {
                            "text": "The committee will <w>adjourn</w> the meeting until all members are present."
                        }
                    ],
                    "synonyms": [
                        "postpone",
                        "defer",
                        "suspend"
                    ],
                    "antonyms": [
                        "convene"
                    ],
                    "common_phrases": [
                        "adjourn the meeting",
                        "adjourn the trial"
                    ]
                },
                {
                    "sense_id": "765b8d45-0efd-386b-8c8d-a2f693b12680",
                    "sense_definition": "To end or suspend a meeting or event, typically for a break.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postpone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court will <w>adjourn</w> for lunch and resume at two o'clock."
                        },
                        {
                            "text": "The chairman announced that the session would <w>adjourn</w> for the day."
                        }
                    ],
                    "synonyms": [
                        "break",
                        "recess"
                    ],
                    "common_phrases": [
                        "adjourn for lunch",
                        "adjourn for the day"
                    ]
                },
                {
                    "sense_id": "1474497f-71df-3482-9fbb-a46fcda5163f",
                    "sense_definition": "To move as a group from one location to another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the formal dinner, the guests decided to <w>adjourn</w> to the garden."
                        },
                        {
                            "text": "Let us <w>adjourn</w> to the library to discuss the matter in private."
                        }
                    ],
                    "synonyms": [
                        "relocate",
                        "move"
                    ],
                    "common_phrases": [
                        "adjourn to the bar",
                        "adjourn to another room"
                    ]
                }
            ]
        }
    ]
