                "senses": [
                    {
                        "sense_id": "95e60d37-10f9-3ae0-8ff9-4a8876ca0d25",
                        "entry_id": "d05043a6-a68f-364b-8d11-10f479ed15c6",
                        "glosses": [
                            "großes rundes oder ovales, oben offenes Gefäß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef4f295-c1f3-4309-b001-538925c3c44d",
                                "sense_id": "95e60d37-10f9-3ae0-8ff9-4a8876ca0d25",
                                "text": "Wir wollen mal sehen, ob das auch alles in die Bütte passt."
                            },
                            {
                                "example_id": "9f37f62d-d1d6-4a20-8746-e25bde82ee1f",
                                "sense_id": "95e60d37-10f9-3ae0-8ff9-4a8876ca0d25",
                                "text": "„Sie keuchten, wenn sie die Schraube anzogen, schöpften den Zucker aus der Bütte, bobachteten die Spundlöcher und amüsierten sich köstlich.“"
                            }
                        ],
