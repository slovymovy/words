                ],
                "senses": [
                    {
                        "sense_id": "7d8b748b-fa49-392c-8585-265479bc86ef",
                        "entry_id": "cd777831-99b4-338f-aa08-844f4f9ef26a",
                        "glosses": [
                            "(männliche) Person, die ständig und überall in maßloser Weise ihr Handy benutzt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "230c8f12-05b9-4a90-a80c-21731a1c98dc",
                                "sense_id": "7d8b748b-fa49-392c-8585-265479bc86ef",
                                "text": "„Wenn man hinter Telefonierern - in extremen Fällen spricht man von Handyoten - nachfährt, weiß man gleich, was los ist.“"
                            },
                            {
                                "example_id": "fcea5aec-7f57-4795-99a1-f07374d3d41d",
                                "sense_id": "7d8b748b-fa49-392c-8585-265479bc86ef",
                                "text": "„Sie speichern stetig Wut, ihr Aggressionsspiegel steigt und der Tag scheint nicht mehr fern, da die Opfer zu Tätern werden und den Handyoten die Geräte quer durch die Gehörgänge schlagen.“"
                            },
                            {
                                "example_id": "02e78f34-c4ce-4a50-b661-e4967e51d724",
                                "sense_id": "7d8b748b-fa49-392c-8585-265479bc86ef",
                                "text": "„Denn was die IDIOT-Reisenden auf den Planeten vorfinden, sind treffende Exemplare aus den Subkulturen des 20. Jahrhunderts - schräge Vögel, wie die coolen Hip-Hopper oder die Hippies mit ihren Flower-power-Allüren, aber auch ‚Exoten‘ wie die Bajuwaren, jene Bier trinkenden Jungs, die sich auf die Schenkel klopfen, oder wie die Handyoten, die immer so beschäftigt aussehen.“"
                            },
                            {
                                "example_id": "9e225093-1a95-4a5b-9759-942069f187a2",
                                "sense_id": "7d8b748b-fa49-392c-8585-265479bc86ef",
                                "text": "„Wenn es, wie Nichtraucherflüge, auch handyfreie Flüge geben soll, sollten sich die ‚Handyoten‘ auf den anderen Flügen austoben.“"
                            },
                            {
                                "example_id": "4513a661-ab11-44f3-b516-97e543acbd9b",
                                "sense_id": "7d8b748b-fa49-392c-8585-265479bc86ef",
                                "text": "„Als Erwachsene treten die Schreihälse dann überall als Handyoten in Erscheinung, kümmern sich in keiner Weise um die Nacht- oder Mittagsruhe oder beglücken ihre Umgebung mit ‚Booster‘-Autoradio.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
