{
    "word_family": [
        "stutten",
        "stutbalk",
        "onderstutten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88558547-f8f0-3820-8ca5-75aaaac47815",
                    "sense_definition": "Een voorwerp, zoals een paal of balk, dat gebruikt wordt om iets te ondersteunen of omvallen te voorkomen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ondersteuning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die oude boom heeft een stevige <w>stut</w> nodig om niet om te vallen.",
                            "target_lang_translations": {
                                "en": "That old tree needs a sturdy <w>prop</w> so it doesn't fall over."
                            }
                        },
                        {
                            "text": "Tijdens de verbouwing plaatsten de bouwvakkers een houten <w>stut</w> onder het plafond.",
                            "target_lang_translations": {
                                "en": "During the renovation, the construction workers placed a wooden <w>prop</w> under the ceiling."
                            }
                        }
                    ],
                    "synonyms": [
                        "steunpilaar",
                        "steunbeer"
                    ],
                    "common_phrases": [
                        "stevige stut"
                    ],
                    "target_lang_definitions": {
                        "en": "An object, such as a pole or beam, used to support something or prevent it from falling over."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prop",
                                "target_lang_sense_clarification": "support beam or pole"
                            },
                            {
                                "target_lang_word": "brace",
                                "target_lang_sense_clarification": "structural reinforcement or support"
                            },
                            {
                                "target_lang_word": "stay",
                                "target_lang_sense_clarification": "support or prop"
                            },
                            {
                                "target_lang_word": "shore",
                                "target_lang_sense_clarification": "temporary post used for shoring up"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16b00a3c-e36f-396c-bde4-c15f88484f17",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>stutten</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>stut</w> de muur zorgvuldig voordat we verdergaan met de sloopwerkzaamheden.",
                            "target_lang_translations": {
                                "en": "I <w>prop up</w> the wall carefully before we proceed with the demolition work."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>stut</w> ik de wankele schutting met een extra balk.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>brace</w> the shaky fence with an extra beam."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'stutten' (to prop up, support)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prop up",
                                "target_lang_sense_clarification": "first-person singular form (I prop up)"
                            },
                            {
                                "target_lang_word": "brace",
                                "target_lang_sense_clarification": "first-person singular form (I brace)"
                            },
                            {
                                "target_lang_word": "shore up",
                                "target_lang_sense_clarification": "first-person singular form (I shore up)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e321d8c9-a646-341e-b049-79a021d328a1",
                    "sense_definition": "Gebiedende wijs van <w>stutten</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Stut</w> die zware balk snel voordat het hele dak instort!",
                            "target_lang_translations": {
                                "en": "<w>Prop up</w> that heavy beam quickly before the entire roof collapses!"
                            }
                        },
                        {
                            "text": "<w>Stut</w> de schutting goed vast tegen de harde wind.",
                            "target_lang_translations": {
                                "en": "<w>Shore up</w> the fence securely against the strong wind."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative of 'stutten' (prop up!, support!)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prop up",
                                "target_lang_sense_clarification": "imperative form"
                            },
                            {
                                "target_lang_word": "brace",
                                "target_lang_sense_clarification": "imperative form"
                            },
                            {
                                "target_lang_word": "shore up",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}