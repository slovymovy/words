                        "glosses": [
                            "het op een felle, strijdvaardige, fanatieke manier niet willen opgeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd89b14-6b93-4ede-a590-8f5f001b0ea9",
                                "sense_id": "2495e5e2-0def-30cc-8b8a-812b58d00023",
                                "text": "Niet omdat de bezoekers nou zoveel minder voetballen, met name na rust is PSV speltechnisch de betere, maar de thuisploeg wint de wedstrijd op hartstocht en verbetenheid."
                            },
                            {
                                "example_id": "119e9319-fb18-4e55-b4b4-253a660a8f7b",
                                "sense_id": "2495e5e2-0def-30cc-8b8a-812b58d00023",
                                "text": "Het verschil tussen PSV en Ajax, het was werkelijk in alles zichtbaar in de eenzijdige topper in het Philips Stadion. De verbetenheid in de duels. Het omgaan met kansen. Het spelen als team."
                            }
                        ]
                    }
