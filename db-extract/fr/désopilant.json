                "senses": [
                    {
                        "sense_id": "f2a2b432-a074-3228-97a4-834179be7b6a",
                        "entry_id": "15c6b11a-801f-3862-a66a-7f76b4e00e93",
                        "glosses": [
                            "Qui fait beaucoup rire."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "0933f148-f67a-45d7-bb64-b8539900b229",
                                "sense_id": "f2a2b432-a074-3228-97a4-834179be7b6a",
                                "text": "Voir juger Césarin était un spectacle des plus curieux, la plus désopilante comédie qu’on pût rêver."
                            },
                            {
                                "example_id": "7a046a30-56ea-4fe1-89f3-02e2f20813ed",
                                "sense_id": "f2a2b432-a074-3228-97a4-834179be7b6a",
                                "text": "Il y a sur lui des histoires fantastiques de quoi composer un recueil désopilant et que, seul, Hubert Rouger sait raconter."
                            },
                            {
                                "example_id": "d4cf747b-d1bc-45b5-90df-929dc56c35c1",
                                "sense_id": "f2a2b432-a074-3228-97a4-834179be7b6a",
                                "text": "C'était pour le faire valoir auprès de ses amis qu'elle avait amené sur le tapis les petites manies de sa tante... il peut être désopilant quand il est dans un bon jour…"
                            },
                            {
                                "example_id": "1690dec9-0987-49eb-a92f-a9d2144366c4",
                                "sense_id": "f2a2b432-a074-3228-97a4-834179be7b6a",
                                "text": "Vu une dizaine de fois et toujours aussi désopilant!! Un classique!"
                            }
                        ]
                    }
                ],
