    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14963f1e-acca-3c62-ab00-ca2fadfbc766",
                    "sense_definition": "Fibre textile d'origine animale ou étoffe douce et brillante tissée à partir des cocons du ver à soie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour son anniversaire, elle a reçu un magnifique foulard en <w>soie</w> bleu marine."
                        },
                        {
                            "text": "Cette chemise est fabriquée avec une <w>soie</w> très délicate qu'il faut laver à la main."
                        }
                    ],
                    "common_phrases": [
                        "foulard en soie",
                        "ver à soie",
                        "robe de soie"
                    ]
                },
                {
                    "sense_id": "eb355237-14d1-30d9-bdbc-a831c3c02927",
                    "sense_definition": "Substance filamenteuse, fine et résistante, sécrétée par certains arthropodes comme les araignées et les chenilles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'araignée utilise sa <w>soie</w> pour tisser une toile solide capable de capturer des proies."
                        },
                        {
                            "text": "La chenille s'enferme dans un cocon protecteur fait d'un long fil de <w>soie</w>."
                        }
                    ],
                    "common_phrases": [
                        "fil de soie",
                        "cocon de soie"
                    ]
                },
                {
                    "sense_id": "46ef11e6-4f7a-33e9-994e-14c72c2c5b8e",
                    "sense_definition": "Poil raide et épais de certains mammifères, particulièrement du porc ou du sanglier, utilisé en brosserie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "poil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre utilise un pinceau fabriqué avec des <w>soies</w> de porc pour étaler la peinture à l'huile."
                        },
                        {
                            "text": "Cette brosse à cheveux en <w>soies</w> naturelles permet de lisser les cheveux sans les abîmer."
                        }
                    ],
                    "common_phrases": [
                        "soie de porc",
                        "soie de sanglier",
                        "soies naturelles"
                    ]
                },
                {
                    "sense_id": "3599050f-757d-3d86-9019-1f403b313a5b",
                    "sense_definition": "Partie étroite et allongée d'une lame de couteau ou d'épée qui s'insère à l'intérieur de la poignée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan ajuste la <w>soie</w> de la lame dans le manche en bois avant de la fixer solidement."
                        },
                        {
                            "text": "La <w>soie</w> de cette vieille épée est entièrement dissimulée sous une poignée en cuir tressé."
                        }
                    ],
                    "common_phrases": [
                        "soie de la lame",
                        "soie d'une épée"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "terme technique de coutellerie"
                        }
                    ]
                },
                {
                    "sense_id": "d177499d-883a-3c10-bbac-f1a1bc74f424",
                    "sense_definition": "Ligne de pêche lourde et calibrée servant à propulser l'artifice lors de la pêche à la mouche.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "peche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pêcheur déroule soigneusement sa <w>soie</w> sur la rivière pour poser la mouche sans effrayer les truites."
                        },
                        {
                            "text": "Il nettoie et graisse régulièrement sa <w>soie</w> afin qu'elle flotte parfaitement à la surface de l'eau."
                        }
                    ],
                    "common_phrases": [
                        "soie flottante",
                        "soie plongeante"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "terme de pêche sportive"
                        }
                    ]
                },
                {
                    "sense_id": "e753be16-005f-3e62-964d-e9cd256512b0",
                    "sense_definition": "Fissure longitudinale se formant dans la muraille de la corne du sabot d'un cheval.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "veterinaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maréchal-ferrant a constaté une profonde <w>soie</w> sur la pince du sabot du cheval boiteux."
                        },
                        {
                            "text": "Pour soigner cette <w>soie</w>, il faut ferrer l'animal de manière à soulager la pression exercée."
                        }
                    ],
                    "synonyms": [
                        "seime"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "terme de maréchalerie et médecine vétérinaire"
                        }
                    ]
                }
            ]
        }
    ]
