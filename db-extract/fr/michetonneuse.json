                    },
                    {
                        "form_id": "5558c59c-e36c-485c-abb4-a8e8f63c4bfd",
                        "entry_id": "8d30b5f6-0ad1-3aa4-9cc6-7ae75dd3894f",
                        "tags": [
                            "masculine"
                        ],
                        "form": "michetonneur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c85bf242-05ef-3ab4-84fb-290aba7fe764",
                        "entry_id": "8d30b5f6-0ad1-3aa4-9cc6-7ae75dd3894f",
                        "glosses": [
                            "Prostituée occasionnelle."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "820f7589-49a2-4ae1-a0b7-987632047290",
                                "sense_id": "c85bf242-05ef-3ab4-84fb-290aba7fe764",
                                "text": "Vous devez aussi identifier une femme, probablement une michetonneuse, qui vient de temps en temps désengorger notre client. Tâchez d’obtenir un signalement précis."
                            },
                            {
                                "example_id": "447c43bd-c91d-4dbb-934f-f30bb94ff468",
                                "sense_id": "c85bf242-05ef-3ab4-84fb-290aba7fe764",
                                "text": "Une voyoute, une michetonneuse et une pute. Un trio aussi infernal que redoutable."
                            }
                        ]
                    },
                    {
                        "sense_id": "65ea66b7-0d9f-3597-9a54-f9fd981e52e9",
                        "entry_id": "8d30b5f6-0ad1-3aa4-9cc6-7ae75dd3894f",
                        "glosses": [
                            "Femme qui séduit un homme pour en tirer le meilleur parti financier, se faire donner de l’argent et recevoir des cadeaux."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "73815a60-d580-48a8-84cd-189600032ed2",
                                "sense_id": "65ea66b7-0d9f-3597-9a54-f9fd981e52e9",
                                "text": "Michetonneuse de tes propres parents. La voilà, ta vraie vocation ! Argent liquide, donations, maison avec piscine dans le Luberon, tu auras tout obtenu, excepté l’estime de toi-même."
                            },
                            {
                                "example_id": "2f1aad91-40a4-4b69-8be5-01a6739ff2c6",
                                "sense_id": "65ea66b7-0d9f-3597-9a54-f9fd981e52e9",
                                "text": "« Par exemple, se faire offrir un sac Vuitton, un voyage… Avec la crise, rares sont les filles qui refusent. Bon, une starfuckeuse peut être aussi une michetonneuse. Mais ça n'a rien à voir avec une prostituée. Rien. Une michetonneuse, ça a du tact ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "792aa92c-4e54-41d3-abfe-e2c283c132c3",
