                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6da0c845-e2e0-45e3-872b-6dadf1f7eed0",
                        "source_entry_id": "21382265-5675-3127-b0ae-f8baf3be8fad",
                        "source_sense_id": "3105a9a3-9f7e-3145-9a6f-79af4b58a4bd",
                        "source_sense_description": "Person, die nörgelt",
                        "target_lang_word": "râleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "râleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08499f15-670c-318f-a4cd-024de1f3cc29",
                                        "entry_id": "5b192def-bd50-3e93-b545-fef64d4c5955",
                                        "glosses": [
                                            "Qui est porté à protester de façon hargneuse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6e34dd-4a45-4dd0-ba4a-4110eb957417",
                                                "sense_id": "08499f15-670c-318f-a4cd-024de1f3cc29",
                                                "text": "Et on s’engueule dans le tramway déjà un bon coup pour se faire la bouche. Les femmes sont plus râleuses encore que les moutards."
                                            },
                                            {
                                                "example_id": "3627ece7-29e3-4d7e-a7c7-4a603b751f8d",
                                                "sense_id": "08499f15-670c-318f-a4cd-024de1f3cc29",
                                                "text": "On ne savait pas se parler entre nous autrement que d’une manière râleuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "râleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea8bc2be-ec74-3f3a-b429-7f9e171a4619",
                                        "entry_id": "72e535cd-8365-3f37-b539-6af8e09738de",
                                        "glosses": [
                                            "Personnage qui aime à protester de façon hargneuse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64539e8d-d658-403d-b920-1a669d3fc010",
                                                "sense_id": "ea8bc2be-ec74-3f3a-b429-7f9e171a4619",
                                                "text": "Bref, au bout de presque deux mois, sans doute en avait-il marre de voir ce râleur de français, l’artiste me remet une magnifique spatule triangulaire avec un manche courbé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dc53501-69c5-420c-bef8-6e68b7dae1ff",
                        "source_entry_id": "21382265-5675-3127-b0ae-f8baf3be8fad",
                        "source_sense_id": "3105a9a3-9f7e-3145-9a6f-79af4b58a4bd",
                        "source_sense_description": "Person, die nörgelt",
                        "target_lang_word": "geignard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geignard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9fa2f18-abe7-3614-bf4a-8377a96f8e79",
                                        "entry_id": "cf6f88ba-17b3-3c2b-a04a-52b2378190c2",
                                        "glosses": [
                                            "Qui se lamente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6233d5c6-ee1e-46c5-9080-ac8ab9d298ec",
                                                "sense_id": "c9fa2f18-abe7-3614-bf4a-8377a96f8e79",
                                                "text": "Rien ne calme, rien n’endort vraiment, si ce n’est pour l’éternité. Cet homme geignard, pourquoi donc avait-il si peur de ce qui sans retour l’apaiserait ?"
                                            },
                                            {
                                                "example_id": "32c28a4c-bba6-4132-88ca-a61844fb57e6",
                                                "sense_id": "c9fa2f18-abe7-3614-bf4a-8377a96f8e79",
                                                "text": "Elle s’entend dire sur un ton geignard : « J’ai été très malade. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "geignard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a39461-d439-3eae-b345-74ce16c25cf5",
                                        "entry_id": "3d46a04d-0954-3c81-a726-b98a5a7045f9",
                                        "glosses": [
                                            "Qui geint, gémit, se lamente ou se plaint volontiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "901eb6d8-6bbd-40e4-b1e4-9f659f16661c",
                                                "sense_id": "e0a39461-d439-3eae-b345-74ce16c25cf5",
                                                "text": "Le comble dans la veule, le geignard, la serpillère suicidaire."
                                            },
                                            {
                                                "example_id": "781e6c5c-d524-45e6-87a1-34c7f4006061",
                                                "sense_id": "e0a39461-d439-3eae-b345-74ce16c25cf5",
                                                "text": "Dean Singleton ne prend pas de gants devant ses pairs : « Il y a trop de geignards parmi les éditeurs, les journalistes et les syndicats qui persistent à aboyer dans la nuit, en pensant qu’ils la feront fuir. Ils chérissent avec nostalgie notre histoire, comme s’ils pouvaient la faire revivre, comme si nous pouvions embaucher à nouveau indéfiniment dans les rédactions. »"
                                            },
                                            {
                                                "example_id": "a8a184c6-5dbd-4a12-a592-91f856baf181",
                                                "sense_id": "e0a39461-d439-3eae-b345-74ce16c25cf5",
                                                "text": "J’ai tendance à croire, toutefois, que les tensions sociales seraient moins vives si on ne présentait pas ceux qui souffrent de libertés comme des geignards et des braillards, se plaignant le ventre plein, comme si, finalement, le confinement perpétuel ne représentait rien de grave."
                                            },
                                            {
                                                "example_id": "c38dc963-4ac4-45cb-8dbc-133f76be03ee",
                                                "sense_id": "e0a39461-d439-3eae-b345-74ce16c25cf5",
                                                "text": "C'est une geignarde, il faut toujours qu'elle se plaigne de quelque chose ou de quelqu'un !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b3b8527-cc14-4008-9fba-82c9c259f58d",
