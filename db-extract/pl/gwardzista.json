                                "sense_id": "712a687a-729d-3b4d-845b-1e8476c96e3f",
                                "text": "Poprzedniemu trenerowi gwardzistów również udostępniano pomieszczenie przy szatni."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
