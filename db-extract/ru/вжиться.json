                                        "sense_id": "b1e40d0f-acb2-3fd5-b222-bba44208d8bd",
                                        "entry_id": "318a17ba-438d-3e0e-9970-842e2ca3c36d",
                                        "glosses": [
                                            "To become accustomed to something; to acclimate; to adjust."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99598f0a-9477-4dfc-b4aa-de932a5183bc",
                                                "sense_id": "b1e40d0f-acb2-3fd5-b222-bba44208d8bd",
                                                "text": "I'm getting used to this climate."
                                            },
                                            {
                                                "example_id": "22495f79-3e94-4f38-a3cd-2a78a9be85f4",
                                                "sense_id": "b1e40d0f-acb2-3fd5-b222-bba44208d8bd",
                                                "text": "Over time, you will get used to being on the front line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e88980a0-8b76-36c1-9f4f-66bdcb404d86",
                                        "entry_id": "318a17ba-438d-3e0e-9970-842e2ca3c36d",
                                        "glosses": [
                                            "to make accustomed, to accustom, to habituate (someone to something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49addbd2-1a3f-440b-9c5f-0bbe1ff2d4a9",
                                                "sense_id": "e88980a0-8b76-36c1-9f4f-66bdcb404d86",
                                                "text": "I'm gradually getting them used to the idea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ccf4553-fb2c-37b6-8edf-ef3989982f8d",
                                        "entry_id": "318a17ba-438d-3e0e-9970-842e2ca3c36d",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see get, used."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71ea9404-8e8b-453e-be73-f9dbb1d926c4",
                                                "sense_id": "9ccf4553-fb2c-37b6-8edf-ef3989982f8d",
                                                "text": "This sponge gets used to clean cars."
                                            }
                                        ]
                                    }
