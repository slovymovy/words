                                    {
                                        "sense_id": "e31ecfae-aa75-3a02-99a1-11b9a681bca6",
                                        "entry_id": "79444c25-5f0c-35af-a7cd-eaedf034ef12",
                                        "glosses": [
                                            "Revêtir un objet d’une mince pellicule d’or."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826bbce6-c0e1-4d51-88cc-e6d438aa5e4d",
                                                "sense_id": "e31ecfae-aa75-3a02-99a1-11b9a681bca6",
                                                "text": "Précisément, mademoiselle, la grâce vient des proportions exactes entre les stylobates, les plinthes, les corniches et les ornements ; puis je n’ai rien doré, les couleurs sont sobres et n’offrent point de tons éclatants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfd72ac9-574f-3933-aa4b-bedfed74c0ce",
                                        "entry_id": "79444c25-5f0c-35af-a7cd-eaedf034ef12",
                                        "glosses": [
                                            "Jaunir, éclairer d'une lumière jaune."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef65b7fa-2fa2-49d3-a26d-eb927e630a7a",
                                                "sense_id": "cfd72ac9-574f-3933-aa4b-bedfed74c0ce",
                                                "text": "Le jour venait. […]. Les pailles, dont les couches épaisses recouvraient entièrement le sol de la cour, se doraient peu à peu d'un jaune pâle sous la lueur grandissante du crépuscule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f15e4f7-51c6-3441-a27c-ed02d39f3b5c",
                                        "entry_id": "79444c25-5f0c-35af-a7cd-eaedf034ef12",
                                        "glosses": [
                                            "Mûrir ou faire mûrir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dcdab8a-acf0-415e-a729-c9343ba57347",
                                                "sense_id": "8f15e4f7-51c6-3441-a27c-ed02d39f3b5c",
                                                "text": "Le soleil dore les moissons."
                                            },
                                            {
                                                "example_id": "0817fc96-3619-459a-a120-510d7d821b2b",
                                                "sense_id": "8f15e4f7-51c6-3441-a27c-ed02d39f3b5c",
                                                "text": "Les moissons commencent à se dorer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32156f0b-a371-30af-8555-0dd66c036721",
                                        "entry_id": "79444c25-5f0c-35af-a7cd-eaedf034ef12",
                                        "glosses": [
                                            "Étaler une couche de jaune d’œuf délavé sur un article à passer au four."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a2fe61-ab73-4731-a9ae-95db16d42b47",
                                                "sense_id": "32156f0b-a371-30af-8555-0dd66c036721",
                                                "text": "Dorer un pâté, un gâteau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
