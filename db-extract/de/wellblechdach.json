                "senses": [
                    {
                        "sense_id": "ef67572e-c553-38f3-b15c-8820f19956df",
                        "entry_id": "2404b937-a0d6-368f-9bb7-26af60333bad",
                        "glosses": [
                            "mit Wellblech gedecktes Dach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2350f1e9-607b-4806-bfc7-e70f4faeb674",
                                "sense_id": "ef67572e-c553-38f3-b15c-8820f19956df",
                                "text": "„Das kleine weiße Häuschen mit dem schrägen Wellblechdach liegt an der Hochstraße im Saarbrücker Stadtteil Burbach, gleich neben dem Bahnhof.“"
                            },
                            {
                                "example_id": "85a495fa-8e85-47f0-b971-7708a9b7e538",
                                "sense_id": "ef67572e-c553-38f3-b15c-8820f19956df",
                                "text": "„Ob man während des Monsunregens nicht Probleme mit Stromschlägen hat, wenn die frei hängenden elektrischen Leitungen samt Steckdosen nur durch ein rudimentäres Wellblechdach geschützt sind?“"
                            },
                            {
                                "example_id": "12c92de0-8b52-45a5-8efd-22fffae950ba",
                                "sense_id": "ef67572e-c553-38f3-b15c-8820f19956df",
                                "text": "„Dunkle Rauchwolken stiegen auf, und Betonboden wie Wellblechdach warfen den gräßlichen Lärm in jeden Winkel des Gebäudes, so daß Sprechen und Denken unerträglich und alle Sinne betäubt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
