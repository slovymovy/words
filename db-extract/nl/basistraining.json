                    {
                        "sense_id": "456d9e68-3941-3df5-8555-5f6f7c0fee78",
                        "entry_id": "9b6764ad-9d08-3c41-83b6-80bfd781fb02",
                        "glosses": [
                            "beginopleiding die voor iedere militair gelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e0eafab-489f-41de-9e72-4bd9c82230a6",
                                "sense_id": "456d9e68-3941-3df5-8555-5f6f7c0fee78",
                                "text": "Die bracht me veilig naar Lawton, Oklahoma en Fort Sill, waar ik de basistraining van acht weken doorliep en daarna de veldartillerieschool en op 26 november werd ik overgebracht naar San Francisco waar ik drie dagen voor mezelf had voordat ik met honderden anderen aan boord ging van het chartervliegtuig dat ons eerst naar Anchorage in Alaska zou brengen,"
                            },
                            {
                                "example_id": "16965be8-dfa5-470f-b6a9-43838db81a70",
                                "sense_id": "456d9e68-3941-3df5-8555-5f6f7c0fee78",
                                "text": "Hij meldde zich aan bij de luchtmacht, slaagde voor de medische test en volgde daarna een basistraining van twaalf weken."
                            }
                        ]
                    },
                    {
                        "sense_id": "5098c3f2-b54c-3124-b160-5ea2676bb190",
                        "entry_id": "9b6764ad-9d08-3c41-83b6-80bfd781fb02",
                        "glosses": [
                            "eenvoudige, algemene beginopleiding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b6a0e5-ce66-4c1d-907d-4e84e1d5623f",
                                "sense_id": "5098c3f2-b54c-3124-b160-5ea2676bb190",
                                "text": "De verklikkers zouden voor korte tijd in dienst worden genomen door de Griekse belastingdienst en een basistraining krijgen voordat ze op pad worden gestuurd met opnameapparatuur. Ze krijgen geen bevoegdheden, maar het verzamelde materiaal kan wel worden gebruikt tegen de belastingontduikers."
                            }
                        ]
                    }
