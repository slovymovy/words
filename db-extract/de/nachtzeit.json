                "senses": [
                    {
                        "sense_id": "7b261a48-a30a-3cc1-8dce-bd612c4ca7bf",
                        "entry_id": "1773631e-19ef-3cce-b505-bae469cb4caa",
                        "glosses": [
                            "Zeit in der Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec7a0f66-3947-4bdb-9bdd-ce928425e5b2",
                                "sense_id": "7b261a48-a30a-3cc1-8dce-bd612c4ca7bf",
                                "text": "Während der Nachtzeit werden E-Mails nicht an Mitarbeiter weitergeleitet."
                            },
                            {
                                "example_id": "c19cd09e-09c6-4d5e-b5ac-f22dfd9e6bfa",
                                "sense_id": "7b261a48-a30a-3cc1-8dce-bd612c4ca7bf",
                                "text": "Eine Hausdurchsuchung zur Nachtzeit darf nach der Strafprozessordnung nur unter bestimmten Voraussetzungen, wie Gefahr im Verzug, erfolgen."
                            },
                            {
                                "example_id": "5968280b-9995-4dd9-8c79-41ded99a56d4",
                                "sense_id": "7b261a48-a30a-3cc1-8dce-bd612c4ca7bf",
                                "text": "„Die Begräbnisanstalten waren während der Nachtzeit und den Tag hindurch mit unglaublicher Tätigkeit, aber ununterbrochenem Geheule und Jammer zustande gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
