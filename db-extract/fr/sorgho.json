                ],
                "senses": [
                    {
                        "sense_id": "d20d724c-d074-3008-986c-7248c9fa1494",
                        "entry_id": "2291f5f1-2c3f-36f0-bc40-c75902378280",
                        "glosses": [
                            "Sorghum bicolor, plante herbacée, annuelle, de grande taille, de la famille des Poacées, c’est une céréale originaire des régions chaudes d’Afrique et d’Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bd0f027-9a39-44e2-b8dc-42f5ea97cf5b",
                                "sense_id": "d20d724c-d074-3008-986c-7248c9fa1494",
                                "text": "SORGHO, (Mat. méd. & diet.) voyez Mil, gros, & l’article Farine & Farineux."
                            },
                            {
                                "example_id": "1714dea0-9c8c-461a-a42a-fbf7bdb6419b",
                                "sense_id": "d20d724c-d074-3008-986c-7248c9fa1494",
                                "text": "Le sorgho, planté en succession de la culture commerciale, est desséché sur pied 8 à 10 jours avant de semer le cotonnier […], afin d’obtenir une couverture morte dans laquelle est effectué le semis."
                            },
                            {
                                "example_id": "fbeb41a4-eddf-41f1-843d-d1489ae548cf",
                                "sense_id": "d20d724c-d074-3008-986c-7248c9fa1494",
                                "text": "Il arrive que des plants de sorgho contiennent du cyanure, surtout les jeunes pousses."
                            }
                        ]
                    },
                    {
                        "sense_id": "f667917c-0883-3ba3-b53e-5268408d072d",
                        "entry_id": "2291f5f1-2c3f-36f0-bc40-c75902378280",
                        "glosses": [
                            "Graminée du genre Sorghum."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "da0148fc-5430-459a-943d-6f27dc8c8e4c",
                                "sense_id": "f667917c-0883-3ba3-b53e-5268408d072d",
                                "text": "Les botanistes (HARLAN - STEMLER, 1972) situent plutôt les premiers sorghos domestiques (S. bicolor) plus au nord et à l’est, en territoire principalement nilo-saharien, entre Tchad et Éthiopie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17aeeed0-aa2d-4d95-8011-392d243ba1f8",
                        "source_entry_id": "2291f5f1-2c3f-36f0-bc40-c75902378280",
                        "source_sense_description": "Sorgho commun",
                        "target_lang_word": "Mohrenhirse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mohrenhirse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2924469-fc2e-3965-b9c7-28053680fc18",
                                        "entry_id": "8c23a03d-2516-37b8-a39a-0ebdec477f9c",
                                        "glosses": [
                                            "für die Welternährung wichtigste Art aus der Gattung Sorghum innerhalb der Familie der Süßgräser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc9c5f7-df52-4d23-a935-cd60cb2cb526",
                                                "sense_id": "e2924469-fc2e-3965-b9c7-28053680fc18",
                                                "text": "„Die spärlichen Ernten von Mohrenhirse und Mais reichen schon lange nicht mehr aus, um die Menschen zu ernähren.“"
                                            },
                                            {
                                                "example_id": "2651a6e0-8093-4cf2-abb1-69a413016f88",
                                                "sense_id": "e2924469-fc2e-3965-b9c7-28053680fc18",
                                                "text": "„Der Hauptgrund liegt in der zunehmenden Verstädterung: Reis zuzubereiten, erfordert nämlicher weniger Zeit, Arbeit und Brennstoff als die traditionell verzehrten Getreide wie Hirse und Sorghum (Mohrenhirse), als Yamswurzeln oder Maniok.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97eb7ca9-0e95-499b-af18-9f06187522a6",
                        "source_entry_id": "2291f5f1-2c3f-36f0-bc40-c75902378280",
