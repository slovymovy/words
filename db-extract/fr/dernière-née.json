                "senses": [
                    {
                        "sense_id": "ed6bb6cf-40a3-3d9b-a4ee-33deca78111a",
                        "entry_id": "dfb562b7-a147-3468-a5a1-2818e3e71302",
                        "glosses": [
                            "Dernière enfant en date à avoir vu le jour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b73927-539d-40b7-aa5e-1dba6a0d5d05",
                                "sense_id": "ed6bb6cf-40a3-3d9b-a4ee-33deca78111a",
                                "text": "En pensant à ses deux filles aînées toujours en fuite, Marianna sort de son berceau la dernière-née."
                            }
                        ]
                    },
                    {
                        "sense_id": "d15083a8-f67f-34db-ae6a-81265b8d0c89",
                        "entry_id": "dfb562b7-a147-3468-a5a1-2818e3e71302",
                        "glosses": [
                            "Plus récente chose à apparaitre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ed3c10a8-9870-4653-9122-0dac029b9857",
                                "sense_id": "d15083a8-f67f-34db-ae6a-81265b8d0c89",
                                "text": "Sans doute étonné par l'absence de nouvelles de Ned, George Brough, le constructeur de motocyclettes, lui a proposé, il y a quelques semaines, la dernière-née de ses ateliers : une nouvelle version du modèle Brough SS 100."
                            },
                            {
                                "example_id": "c5023900-999c-4cf2-bbdc-c0b67c70f99d",
                                "sense_id": "d15083a8-f67f-34db-ae6a-81265b8d0c89",
                                "text": "Dernière-née des routes cyclables normandes, la Véloroute du Lin propose une balade à travers les champs de lin."
                            }
                        ]
                    }
                ],
