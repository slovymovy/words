                    },
                    {
                        "form_id": "eac7cddb-6ab0-4229-a8cb-4ecc21709e26",
                        "entry_id": "e805210e-6088-3c14-a545-696a9ed76847",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "vêtues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6e8ab0a-f7b4-3556-8540-a9d916b31441",
                        "entry_id": "e805210e-6088-3c14-a545-696a9ed76847",
                        "glosses": [
                            "Enveloppé dans un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeb70167-83da-4d13-bce8-d4525586a5b0",
                                "sense_id": "a6e8ab0a-f7b4-3556-8540-a9d916b31441",
                                "text": "Vous voilà bien vêtu pour votre hiver."
                            },
                            {
                                "example_id": "4b165fe2-e3ba-42a8-b2eb-73e3899bf2ab",
                                "sense_id": "a6e8ab0a-f7b4-3556-8540-a9d916b31441",
                                "text": "Il est richement vêtu, vêtu chaudement."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5af3fe9-caad-37c1-afb1-d7952908c427",
                        "entry_id": "e805210e-6088-3c14-a545-696a9ed76847",
                        "glosses": [
                            "Il se dit particulièrement en parlant des habits de dignité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "133adc31-9a9e-4246-af3e-8d3fd747b208",
                                "sense_id": "f5af3fe9-caad-37c1-afb1-d7952908c427",
                                "text": "Le roi était vêtu de ses habits de cérémonie."
                            }
                        ]
                    },
                    {
                        "sense_id": "b46d3c7b-8f01-3da7-a4fe-2d298542885b",
                        "entry_id": "e805210e-6088-3c14-a545-696a9ed76847",
                        "glosses": [
                            "Être à l’intérieur d’une enveloppe protectrice."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "18561193-3966-4b19-86fc-63d77ed22cf5",
                                "sense_id": "b46d3c7b-8f01-3da7-a4fe-2d298542885b",
                                "text": "L’oignon est bien vêtu cette année — Ses enveloppes sont plus épaisses et plus nombreuses qu’à l’ordinaire."
                            },
                            {
                                "example_id": "4ae649f6-ea5f-452e-afb4-effd2fc04bb1",
                                "sense_id": "b46d3c7b-8f01-3da7-a4fe-2d298542885b",
                                "text": "[…] toute vêtue d'aluminium, elle avait davantage la forme d’une torpille que d’une auto."
                            },
                            {
                                "example_id": "3a4d61e2-b1f6-44f7-ac63-15fd5262151a",
                                "sense_id": "b46d3c7b-8f01-3da7-a4fe-2d298542885b",
                                "text": "Le grain des céréales est un caryopse nu ou vêtu de ses glumelles. Le blé, le maïs, le sorgho, le seigle et le triticale appartiennent au premier groupe; l’orge et l’avoine font partie du second."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7c72f7e-0067-3fc0-8ad2-a7602c5065f2",
                        "entry_id": "e805210e-6088-3c14-a545-696a9ed76847",
                        "glosses": [
                            "Se dit d’un être humain représenté avec un vêtement particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8cdf62-5c09-4fe1-8965-7be7d095a5c8",
                                "sense_id": "c7c72f7e-0067-3fc0-8ad2-a7602c5065f2",
                                "text": "D’azur à un Saint-Etienne de carnation, vêtu en diacre, l’aube d’argent et la dalmatique de gueules bordée d’or, tenant d’une main une palme aussi d’or et de l’autre trois cailloux d’argent ensanglantés aussi de gueules, qui est de Viols-le-Fort → voir illustration « Saint-Étienne vêtu en diacre »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
