                },
                {
                    "sense_id": "29ec0c53-7028-308a-9b11-458f31952ef0",
                    "sense_definition": "Een dienaar of helper, voornamelijk in een historische context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ridder werd geholpen door zijn trouwe <knaap> bij het aantrekken van het harnas.",
                            "target_lang_translations": {
                                "en": "The knight was helped by his faithful <w>squire</w> in putting on his armor.",
                                "ru": "Рыцарю помогал надевать доспехи его верный <w>оруженосец</w>.",
                                "fr": "Le chevalier était aidé par son fidèle <w>écuyer</w> pour enfiler son armure."
                            }
                        },
                        {
                            "text": "In de middeleeuwen moest een <knaap> hard werken voor zijn meester.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, a <w>servant</w> had to work hard for his master.",
                                "ru": "В Средние века <w>слуга</w> должен был усердно работать на своего господина.",
                                "fr": "Au Moyen Âge, un <w>valet</w> devait travailler dur pour son maître."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trouwe knaap"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A servant or helper, mainly in a historical context.",
                        "ru": "Слуга или помощник, преимущественно в историческом контексте.",
                        "fr": "Un serviteur ou un assistant, principalement dans un contexte historique."
                    },
