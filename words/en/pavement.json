{
    "word_family": [
        "pave",
        "paving",
        "paver"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88211c57-23ba-3ab4-9d83-9fd581153ba7",
                    "sense_definition": "A paved path for pedestrians at the side of a road.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pedestrian_infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please walk on the <w>pavement</w> to stay safe from the cars on the road.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, идите по <w>тротуару</w>, чтобы быть в безопасности от машин на дороге."
                            }
                        },
                        {
                            "text": "The narrow <w>pavement</w> was crowded with people rushing to the train station.",
                            "target_lang_translations": {
                                "ru": "Узкий <w>тротуар</w> был переполнен людьми, спешащими на вокзал."
                            }
                        }
                    ],
                    "synonyms": [
                        "sidewalk",
                        "footpath"
                    ],
                    "common_phrases": [
                        "narrow pavement",
                        "wet pavement"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пешеходная дорожка с твердым покрытием по бокам дороги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тротуар",
                                "target_lang_sense_clarification": "пешеходная дорожка"
                            },
                            {
                                "target_lang_word": "панель",
                                "target_lang_sense_clarification": "устаревшее название тротуара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14e6b692-b545-3eb7-a4cb-dbc2b795e7a9",
                    "sense_definition": "The hard surface of a road or thoroughfare used by vehicles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "road_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain made the <w>pavement</w> very slippery for the truck drivers.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь сделал <w>дорожное покрытие</w> очень скользким для водителей грузовиков."
                            }
                        },
                        {
                            "text": "Engineers are testing a new type of asphalt <w>pavement</w> that lasts longer.",
                            "target_lang_translations": {
                                "ru": "Инженеры тестируют новый тип асфальтового <w>покрытия</w>, которое служит дольше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "asphalt pavement",
                        "road pavement"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердое покрытие дороги или проезда, предназначенное для транспортных средств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мостовая",
                                "target_lang_sense_clarification": "проезжая часть улицы"
                            },
                            {
                                "target_lang_word": "асфальт",
                                "target_lang_sense_clarification": "дорожное покрытие"
                            },
                            {
                                "target_lang_word": "дорожное полотно",
                                "target_lang_sense_clarification": "поверхность дороги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "323bdf59-9ba5-37e2-a1e8-e438f7d7fa27",
                    "sense_definition": "Any paved surface or hard covering on the ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_surfaces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden features a beautiful stone <w>pavement</w> leading to the fountain.",
                            "target_lang_translations": {
                                "ru": "В саду проложена красивая каменная <w>дорожка</w>, ведущая к фонтану."
                            }
                        },
                        {
                            "text": "We sat on the edge of the <w>pavement</w> to watch the parade go by.",
                            "target_lang_translations": {
                                "ru": "Мы сели на край <w>тротуара</w>, чтобы посмотреть на проходящий парад."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stone pavement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая мощеная поверхность или твердое покрытие на земле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощение",
                                "target_lang_sense_clarification": "процесс или результат покрытия поверхности"
                            },
                            {
                                "target_lang_word": "покрытие",
                                "target_lang_sense_clarification": "твердый слой на земле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c8bbf3d-2b61-3ad8-acc5-0619f0f0ee64",
                    "sense_definition": "The paved part of an area like a plaza, schoolyard, or parking lot.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "general_surfaces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children were playing basketball on the school <w>pavement</w> during their lunch break.",
                            "target_lang_translations": {
                                "ru": "Дети играли в баскетбол на школьной <w>площадке</w> во время обеденного перерыва."
                            }
                        },
                        {
                            "text": "The historic plaza is covered in a traditional cobblestone <w>pavement</w>.",
                            "target_lang_translations": {
                                "ru": "Историческая площадь покрыта традиционной булыжной <w>мостовой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cobblestone pavement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощеная часть территории, такой как площадь, школьный двор или парковка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "площадка",
                                "target_lang_sense_clarification": "участок с твердым покрытием"
                            },
                            {
                                "target_lang_word": "мостовая",
                                "target_lang_sense_clarification": "вымощенная площадь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c867f53e-c57e-3410-ab0f-653a96e11f64",
                    "sense_definition": "Interior flooring made of stone or tile, especially in large or historic buildings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interior_flooring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral's marble <w>pavement</w> has been worn smooth by centuries of visitors.",
                            "target_lang_translations": {
                                "ru": "Мраморный <w>пол</w> собора был отполирован до гладкости веками посетителей."
                            }
                        },
                        {
                            "text": "They walked across the tiled stone <w>pavement</w> of the ancient castle hall.",
                            "target_lang_translations": {
                                "ru": "Они прошли по выложенному камнем <w>полу</w> зала древнего замка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "marble pavement",
                        "stone pavement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in architectural contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренний пол из камня или плитки, особенно в больших или исторических зданиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощёный пол",
                                "target_lang_sense_clarification": "пол из камня или плитки"
                            },
                            {
                                "target_lang_word": "плиточный пол",
                                "target_lang_sense_clarification": "пол, выложенный плиткой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3a286b4-afe4-31bf-8018-d3a050f2e2cf",
                    "sense_definition": "The interior flooring of a church sanctuary between the communion rail and the altar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interior_flooring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest knelt upon the sanctuary <w>pavement</w> during the silent prayer.",
                            "target_lang_translations": {
                                "ru": "Священник преклонил колени на <w>пол</w> святилища во время безмолвной молитвы."
                            }
                        },
                        {
                            "text": "Intricate mosaics decorated the <w>pavement</w> leading up to the high altar.",
                            "target_lang_translations": {
                                "ru": "Сложная мозаика украшала <w>покрытие</w>, ведущее к главному алтарю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sanctuary pavement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "ecclesiastical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутреннее покрытие пола в алтарной части церкви между балюстрадой и алтарем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пол солеи",
                                "target_lang_sense_clarification": "покрытие перед алтарем"
                            },
                            {
                                "target_lang_word": "мозаичный пол",
                                "target_lang_sense_clarification": "часто встречающееся в церквях покрытие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}