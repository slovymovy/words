        "de-extract.jsonl": [
            {
                "entry_id": "c4c31c75-fec2-3cf1-ba76-32b57bda11ed",
                "word": "Roubaiser",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "704c5950-fe03-4ad7-b96a-ca069f342f8a",
                        "entry_id": "c4c31c75-fec2-3cf1-ba76-32b57bda11ed",
                        "tags": [
                            "positive"
                        ],
                        "form": "Roubaiser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
                        "entry_id": "c4c31c75-fec2-3cf1-ba76-32b57bda11ed",
                        "glosses": [
                            "für Roubaix charakteristisch, aus Roubaix stammend, zu Roubaix gehörig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa72ac8-1797-4db6-a364-47073b2ad080",
                                "sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
                                "text": "Jean-Baptiste Lebas war jahrelang Roubaiser Bürgermeister."
                            },
                            {
                                "example_id": "c18ccf08-d448-4c46-a8b3-40f931780927",
                                "sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
                                "text": "Mehr Glück hatten die französischen Spieler bei einem Einzelturnier, das der Roubaiser Spitzenspieler Christian Martin gewinnen konnte."
                            },
                            {
                                "example_id": "d2794e74-d16c-4739-add9-af3bc00f4898",
                                "sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
                                "text": "Der Roubaiser Gemeinderath hat in einer seiner jüngsten Sitzungen beschlossen: 1. die Institution unentgeltlicher Rechtskonsultationen einzuführen; 2. eine Gemeinde-Apotheke zu errichten…"
                            },
                            {
                                "example_id": "4668ba1e-250e-44d3-a8a5-c64a8272ae11",
                                "sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
                                "text": "Ein Roubaiser Blatt bringt folgende Mittheilung eines Lesers: \"Kürzlich sah ich auf einem Viehmarkte, wie eine Heerde von 31 Pferden zu 4 bis 22,50 Frks. das Stück verkauft wurde…"
                            },
                            {
                                "example_id": "0525a51b-b6bd-4db0-9aa7-a5ed4eb96180",
                                "sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
                                "text": "Große Posten ächt französischer Roubaiser reinwollene Polonaiser und Winter-Costumestoffe, unverwüstlich und sein, anstatt 2 m 40 der ganze Meter nur 1 m 80."
                            },
                            {
                                "example_id": "086dab81-35a6-4f86-9715-ebbffd171a49",
                                "sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
                                "text": "Dann intrigierte Hyndman gegen Absendung von Delegierten zum Roubaixer Kongreß: Die Leute seien eine Minorität, und man dürfe sich nicht in französische innere Streitigkeiten mischen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0b5869f-487d-4c4a-b584-f7b5e5429515",
                        "source_entry_id": "c4c31c75-fec2-3cf1-ba76-32b57bda11ed",
                        "source_sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
                        "source_sense_description": "für Roubaix charakteristisch, aus Roubaix stammend, zu Roubaix gehörig",
                        "target_lang_word": "Roubaisian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roubaisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ccfe47-90d7-3e55-888a-cbea50b75280",
                                        "entry_id": "99d892d9-963a-372a-8800-5a7657b3ac37",
                                        "glosses": [
                                            "A person who was born in, or is a citizen or inhabitant of Roubaix, France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00bef4f9-775f-4edb-af7d-3aadfeff185c",
                                                "sense_id": "a5ccfe47-90d7-3e55-888a-cbea50b75280",
                                                "text": "Even very large immigrant communities managed to integrate into the ranks of the Roubaignos (native Roubaisians) through their membership in the working class."
                                            },
                                            {
                                                "example_id": "6d03ccbd-8fb0-4da6-aac5-09adec0e322b",
                                                "sense_id": "a5ccfe47-90d7-3e55-888a-cbea50b75280",
                                                "text": "Sure enough, she is indeed Canadian and not by chance but by necessity seeing that she was born that way and isn't married to a foreigner (she doesn't state that she is a virgin) and hasn't had herself naturalised Roubaisian or Zanzibian."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Roubaisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2015b18d-212f-384a-8dd1-c8d1c256c063",
                                        "entry_id": "55521655-e57d-3cf4-8f6c-b1f60eec69b3",
                                        "glosses": [
                                            "Of, relating, or pertaining to Roubaix, France"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8288f1c5-a1eb-48cd-9b57-5eb7ba1372fd",
                        "source_entry_id": "c4c31c75-fec2-3cf1-ba76-32b57bda11ed",
                        "source_sense_id": "b1a3f39c-d231-3a5c-951a-35ec2f13ed24",
