                {
                    "sense_id": "c7dba9af-6902-3329-a538-1150551661de",
                    "sense_definition": "Éclatant ou pompeux, qui promet de grandes choses mais peut être illusoire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme s'est laissé séduire par les promesses <w>magnifiques</w> du commerçant.",
                            "target_lang_translations": {
                                "en": "The young man let himself be seduced by the merchant's <w>glowing</w> promises.",
                                "ru": "Молодой человек поддался на <w>заманчивые</w> обещания торговца.",
                                "nl": "De jongeman liet zich verleiden door de <w>rooskleurige</w> beloften van de handelaar.",
                                "de": "Der junge Mann ließ sich von den <w>verlockenden</w> Versprechen des Händlers verführen.",
                                "pl": "Młody człowiek dał się uwieść <w>kuszącym</w> obietnicom kupca.",
                                "it": "Il giovane si è lasciato sedurre dalle <w>allettanti</w> promesse del commerciante.",
                                "cs": "Mladík se nechal ošálit <w>lákavými</w> sliby obchodníka.",
                                "tr": "Genç adam, tüccarın <w>parlak</w> vaatlerine kapılıp aldandı.",
                                "es": "El joven se dejó seducir por las <w>halagüeñas</w> promesas del comerciante.",
                                "zh": "这个年轻人轻信了商人许下的<w>诱人</w>承诺。"
                            }
                        },
                        {
                            "text": "Ce projet présentait des perspectives <w>magnifiques</w>, mais la réalité fut bien décevante.",
                            "target_lang_translations": {
                                "en": "This project offered <w>glowing</w> prospects, but reality proved very disappointing.",
                                "ru": "Этот проект сулил <w>блестящие</w> перспективы, но реальность оказалась весьма разочаровывающей.",
                                "nl": "Dit project bood <w>rooskleurige</w> vooruitzichten, maar de werkelijkheid viel erg tegen.",
                                "de": "Dieses Projekt bot <w>rosige</w> Aussichten, doch die Wirklichkeit war sehr enttäuschend.",
                                "pl": "Ten projekt zapowiadał <w>różowe</w> perspektywy, ale rzeczywistość okazała się bardzo rozczarowująca.",
                                "it": "Questo progetto prometteva prospettive <w>rosee</w>, ma la realtà si rivelò molto deludente.",
                                "cs": "Tento projekt sliboval <w>růžové</w> vyhlídky, ale skutečnost byla velmi zklamávající.",
                                "tr": "Bu proje <w>parlak</w> beklentiler sunuyordu, ama gerçeklik oldukça hayal kırıklığı yarattı.",
                                "es": "Este proyecto presentaba perspectivas <w>halagüeñas</w>, pero la realidad resultó bastante decepcionante.",
                                "zh": "这个项目的前景看上去十分<w>美好</w>，可现实却令人相当失望。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "promesses magnifiques"
                    ],
                    "target_lang_definitions": {
                        "en": "Showy and impressive-sounding, promising great things that may prove illusory.",
                        "ru": "Пышный и эффектный, обещающий многое, но часто нереальный.",
                        "nl": "Schitterend of pompeus, met grote beloften die misschien niet uitkomen.",
                        "de": "Glänzend oder bombastisch, verspricht viel, kann sich aber als trügerisch erweisen.",
                        "pl": "Efektowny i pociągający, obiecujący wielkie rzeczy, które mogą jednak okazać się złudne.",
                        "it": "Appariscente e pomposo, che promette grandi cose ma può rivelarsi illusorio.",
                        "cs": "Nápadný a efektní, slibující velké věci, které se mohou ukázat jako iluzorní.",
