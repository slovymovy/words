                        "entry_id": "637617f7-01b3-3f04-a71f-eb09e4ed77b8",
                        "glosses": [
                            "technisches Produkt, das in die Scheide eingeführt wird und zur Verhütung der Empfängnis dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f38a255-7902-4577-be01-d0ae8d3918bc",
                                "sense_id": "97e90e58-d866-3bc7-a7fb-fa458c36448b",
                                "text": "„Das erste war gekommen, nachdem sie sich vorher darüber unterhalten hatten und darin übereinstimmten, daß sie sich ein Baby wünschten; aber jetzt kann er sich kein zweites leisten und ist besorgt, ob ihr Pessar ordentlich sitzt.“"
                            },
                            {
                                "example_id": "db91cf08-e34c-436a-b067-a657e7fd988b",
                                "sense_id": "97e90e58-d866-3bc7-a7fb-fa458c36448b",
                                "text": "„Im Bad zog ich meine Pumps aus und setzte mein Pessar ein.“"
                            }
                        ],
