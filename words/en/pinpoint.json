            "senses": [
                {
                    "sense_id": "8810eb9f-df64-3fb0-abfb-d0b87ceb994d",
                    "sense_definition": "Extremely precise or specific, especially regarding location or accuracy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine assembles parts with <w>pinpoint</w> accuracy.",
                            "target_lang_translations": {
                                "pl": "Maszyna montuje części z <w>punktową</w> dokładnością."
                            }
                        },
                        {
                            "text": "The pilot made a <w>pinpoint</w> landing on the small runway.",
                            "target_lang_translations": {
                                "pl": "Pilot wykonał <w>precyzyjne</w> lądowanie na małym pasie startowym."
                            }
                        }
                    ],
                    "synonyms": [
                        "precise",
                        "exact",
                        "accurate"
                    ],
                    "antonyms": [
                        "vague",
                        "imprecise"
                    ],
                    "common_phrases": [
                        "pinpoint accuracy"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niezwykle precyzyjny lub dokładny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "precyzyjny",
                                "target_lang_sense_clarification": "o wysokim stopniu dokładności"
                            },
                            {
                                "target_lang_word": "punktowy",
                                "target_lang_sense_clarification": "odnoszący się do konkretnego punktu"
                            }
                        ]
                    }
                }
            ]
        },
        {
