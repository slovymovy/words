                        "zh": "浅的或平的（苏格兰方言）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелкий",
                                "target_lang_sense_clarification": "о воде"
                            },
                            {
                                "target_lang_word": "плоский",
                                "target_lang_sense_clarification": "о посуде или поверхности"
                            }
                        ],
                        "zh": [
                            {
