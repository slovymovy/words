            "pos": "verb",
            "senses": [
                {
                    "sense_id": "abd209d0-d612-3bb9-9bd7-58218c04d4cb",
                    "sense_definition": "To damage, break, or misconfigure something, especially a computer, system, or other complex device.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malfunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest software update might <w>bork</w> your operating system completely.",
                            "target_lang_translations": {
                                "ru": "Последнее обновление ПО может полностью <w>сломать</w> вашу операционную систему."
                            }
                        },
                        {
                            "text": "I tried to edit the code, but I managed to <w>bork</w> the whole website instead.",
                            "target_lang_translations": {
                                "ru": "Я попытался отредактировать код, но вместо этого умудрился <w>запороть</w> весь сайт."
                            }
                        }
                    ],
                    "synonyms": [
                        "break",
                        "ruin"
                    ],
                    "antonyms": [
                        "fix",
                        "repair"
                    ],
                    "common_phrases": [
                        "bork up"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "tech slang"
                        }
