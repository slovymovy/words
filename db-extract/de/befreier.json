                        "glosses": [
                            "Person, die jemanden oder etwas aus einer Zwangslage herausholt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb5432b8-6129-475c-b820-1e7a17b4ac2d",
                                "sense_id": "aaa69c71-66cf-3ee0-b51a-40adf671986c",
                                "text": "„Und es werden Befreier auf den Berg Zion hinaufziehen, um das Gebirge Esaus zu richten. Und die Königsherrschaft wird dem HERRN gehören!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
