{
    "word_family": [
        "thriver",
        "thriving",
        "thrift",
        "thrifty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e0d08be-ded8-351b-924e-efcaab53f320",
                    "sense_definition": "To increase in wealth or success; to prosper or be profitable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since expanding its operations in June, the small family business has really started to <w>thrive</w>.",
                            "target_lang_translations": {
                                "ru": "С момента расширения своей деятельности в июне этот небольшой семейный бизнес действительно начал <w>процветать</w>."
                            }
                        },
                        {
                            "text": "Many tech companies <w>thrive</w> on innovation and the ability to adapt quickly to market changes.",
                            "target_lang_translations": {
                                "ru": "Многие технологические компании <w>преуспевают</w> благодаря инновациям и способности быстро адаптироваться к рыночным изменениям."
                            }
                        }
                    ],
                    "synonyms": [
                        "prosper",
                        "flourish",
                        "succeed",
                        "boom"
                    ],
                    "antonyms": [
                        "fail",
                        "decline",
                        "languish"
                    ],
                    "common_phrases": [
                        "thrive on innovation",
                        "thrive in business",
                        "thrive under pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать богатство или успех; процветать или быть прибыльным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процветать",
                                "target_lang_sense_clarification": "успешно развиваться, находиться в состоянии подъема"
                            },
                            {
                                "target_lang_word": "преуспевать",
                                "target_lang_sense_clarification": "добиваться значительных успехов в делах"
                            },
                            {
                                "target_lang_word": "благоденствовать",
                                "target_lang_sense_clarification": "жить в достатке и благополучии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61002621-d253-3a5e-9935-e6c4cc5e187c",
                    "sense_definition": "To grow or develop vigorously; to flourish in a physical or biological sense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Not all wild animals <w>thrive</w> well in captivity because they need a natural environment.",
                            "target_lang_translations": {
                                "ru": "Не все дикие животные хорошо <w>развиваются</w> в неволе, потому что им нужна естественная среда обитания."
                            }
                        },
                        {
                            "text": "These tropical plants <w>thrive</w> in humid conditions and require very little direct sunlight.",
                            "target_lang_translations": {
                                "ru": "Эти тропические растения <w>пышно растут</w> во влажных условиях и требуют совсем немного прямого солнечного света."
                            }
                        }
                    ],
                    "synonyms": [
                        "flourish",
                        "bloom",
                        "burgeon"
                    ],
                    "antonyms": [
                        "wither",
                        "die",
                        "stagnate"
                    ],
                    "common_phrases": [
                        "thrive in conditions",
                        "thrive in the wild",
                        "thrive on neglect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергично расти или развиваться; процветать в физическом или биологическом смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрастаться",
                                "target_lang_sense_clarification": "увеличиваться в размере, становиться гуще (о растениях)"
                            },
                            {
                                "target_lang_word": "пышно расти",
                                "target_lang_sense_clarification": "интенсивно и здорово развиваться"
                            },
                            {
                                "target_lang_word": "цвести",
                                "target_lang_sense_clarification": "находиться в поре физического расцвета"
                            },
                            {
                                "target_lang_word": "буйно расти",
                                "target_lang_sense_clarification": "очень быстро и обильно развиваться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}