                        ]
                    },
                    {
                        "translation_id": "5481d5b3-a628-4f55-b480-9f18d98356b5",
                        "source_entry_id": "4982a61b-f3ed-3cad-9228-acc0af2ef9d2",
                        "source_sense_id": "1f448ae4-36f6-3697-bb90-67633cf8c525",
                        "source_sense_description": "a family of mammals related to pigs",
                        "target_lang_word": "pécari",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pécari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b12c760-ba66-3447-9c50-b7e67a32b615",
                                        "entry_id": "b2c00aaa-ae1c-31ea-a9dd-89f99127fc72",
                                        "glosses": [
                                            "Sorte de porc sauvage de la famille des Tayassuidae, les trois espèces actuelles sont essentiellement sud-américaines."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0152196-7f8d-43f7-bd03-38e9d7377a7d",
                                                "sense_id": "6b12c760-ba66-3447-9c50-b7e67a32b615",
                                                "text": "Glenarvan tua fort adroitement un pécari « tay-tetre, » pachyderme à poil fauve très bon à manger, qui valait son coup de fusil."
                                            },
                                            {
                                                "example_id": "f1a67fc0-76c4-4da4-bdc4-10d830bd92c2",
                                                "sense_id": "6b12c760-ba66-3447-9c50-b7e67a32b615",
                                                "text": "Le pécari à lèvres blanches, vivant en Amérique centrale et du Sud, a vu ses effectifs diminuer de 89 % au Costa Rica et de 84 % au Mexique et au Guatemala. Il figure maintenant sur la liste des espèces vulnérables. Parmi les causes de ce déclin : la chasse et la disparition de son habitat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffe1d870-6c9d-3d3b-97c3-a021fb113fd6",
                                        "entry_id": "b2c00aaa-ae1c-31ea-a9dd-89f99127fc72",
                                        "glosses": [
                                            "Cuir de cet animal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d69cded-84f7-4560-b127-6b2dcec32b94",
                                                "sense_id": "ffe1d870-6c9d-3d3b-97c3-a021fb113fd6",
                                                "text": "On trouve des chaussures ou des vestes en pécari, mais il est utilisé essentiellement pour la confection de gants haut de gamme."
                                            },
                                            {
                                                "example_id": "96c85a91-387c-429c-8103-38efd771b606",
                                                "sense_id": "ffe1d870-6c9d-3d3b-97c3-a021fb113fd6",
                                                "text": "Ils ne brasseront jamais que les millions des autres. On leur en laissera quelques miettes, pour le standing, pour les chemises de soie, pour les gants de pécari fumé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b8b6e7b-a696-4622-b37a-e40397e7e07c",
                        "source_entry_id": "4982a61b-f3ed-3cad-9228-acc0af2ef9d2",
                        "source_sense_id": "1f448ae4-36f6-3697-bb90-67633cf8c525",
                        "source_sense_description": "a family of mammals related to pigs",
                        "target_lang_word": "Nabelschwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nabelschwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53c9451e-862c-30e2-b3b2-abbbf06b52e2",
                                        "entry_id": "a1d1a40a-e801-3e43-a8dc-e4937c983b37",
                                        "glosses": [
                                            "auf dem amerikanischen Kontinent verbreitete Schweineart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f23ab9-5e15-43cc-b341-db26fdb48251",
                                                "sense_id": "53c9451e-862c-30e2-b3b2-abbbf06b52e2",
                                                "text": "„Kleine Waisenkinder, zornigen Zwergen gleich, waren unterwegs, Verrückte und Säufer wankten sabbernd und mit den Armen fuchtelnd durch die winzigen Marktbuden der Metropole; die Gefangenen zogen vorbei an den in Blut gebadeten Fleischständen, am Wachsgeruch, an Gedärmen, die schwarz vor Fliegen, an Gestellen baumelten, vorbei an großen roten Streifen von abgehäutetem Fleisch, das nun, zu vorgerückter Stunde, dunkler wurde, an den abgespeckten, nackten Schädeln von Kühen und Schafen mit stumpfblauen, stier blickenden Augen, an den steifen Leibern von Hirschen, Nabelschweinen, Enten, Wachteln und Papageien, alles einheimische Wild hing kopfunter am Haken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
