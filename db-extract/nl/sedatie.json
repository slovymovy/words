                    }
                ],
                "senses": [
                    {
                        "sense_id": "f634299a-ebe7-32be-9101-00d322d37988",
                        "entry_id": "a6e36517-0aaf-325a-a4e9-d5fcfc237493",
                        "glosses": [
                            "het verlagen van de staat van het bewustzijn van een patiënt met het doel een medische procedure of ingreep aangenamer te maken"
                        ],
                        "tags": [],
