        "nl-extract.jsonl": [
            {
                "entry_id": "15796db5-9d71-3e25-9f2f-50392c6afa00",
                "word": "overschreeuwen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e26e9829-1aad-3918-a7d6-4ab5899381eb",
                        "entry_id": "15796db5-9d71-3e25-9f2f-50392c6afa00",
                        "glosses": [
                            "harder schreeuwen dan iets of iemand (om er bovenuit te komen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ba8a94-fee9-43f9-8881-4cc3c4ae06cd",
                                "sense_id": "e26e9829-1aad-3918-a7d6-4ab5899381eb",
                                "text": "Volgens Spekman is het ophitsen steeds extremer geworden en gebeurde het al vanaf het moment dat de voordracht van de PvdA'er met Marokkaanse roots bekend was. Volgens hem begon Wilders met ophitsen op Twitter en ging Baudet daar overheen. \"Ze proberen elkaar te overschreeuwen\", aldus Spekman."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6554afc-f30d-3452-a7be-25208c17e02b",
                        "entry_id": "15796db5-9d71-3e25-9f2f-50392c6afa00",
                        "glosses": [
                            "zo hard schreeuwen dat je jezelf of de waarheid niet meer hoort"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a542f0dd-6e0c-4a16-9fab-1d120e0d34e6",
                                "sense_id": "e6554afc-f30d-3452-a7be-25208c17e02b",
                                "text": "‘Ik heb geleerd mijn verlegenheid te overschreeuwen. Maar in een gesprek face to face ben ik veeleer timide. Ik ben niet erg sociaal. Op dit moment ben ik trouwens héél verlegen. Ik kijk voortdurend naar mijn kopje omdat het me timide maakt wat ik vertel.’"
                            }
                        ]
                    }
                ],
