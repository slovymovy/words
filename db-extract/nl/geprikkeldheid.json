                                        "entry_id": "669a2183-eac2-3be2-a2c9-39a6fbde5e8c",
                                        "glosses": [
                                            "Synonym of pica (“a disorder characterized by appetite and craving for non-edible substances”)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "defc5ecb-e426-4a5f-acf7-3f4236cc30f7",
                                                "sense_id": "a32d8cf8-c58d-3550-8388-370b6d2287b0",
                                                "text": "The World is nat'rally averse / To all the truth it sees or hears, / But swallows Non-sense and a Lie / With greediness and gluttony; / And though it have the Pique, and long, / 'Tis still for something in the wrong: […]"
                                            }
