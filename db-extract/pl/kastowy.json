                "senses": [
                    {
                        "sense_id": "77c62038-4dc3-3ec9-a468-e66f46f053d4",
                        "entry_id": "4a013a81-5b3e-3d83-8e6b-e8132a53580a",
                        "glosses": [
                            "związany z kastą, dotyczący kast; podzielony na kasty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0cc6a4a-83f4-44a9-b65b-1a001a4aba5b",
                                "sense_id": "77c62038-4dc3-3ec9-a468-e66f46f053d4",
                                "text": "Otrzymawszy ogładę damy z towarzystwa, stała się jednocześnie ofiarą społeczeństwa kastowego. (…) Dla młodych mężczyzn ze środowiska, które opuściła, była zbyt uczona, dla epuzerów ze środowiska, o którym marzyła, pozostała zbyt wielką prostaczką"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b57ffb64-dcc8-4811-bbbd-8d47df2468ca",
                        "source_entry_id": "4a013a81-5b3e-3d83-8e6b-e8132a53580a",
                        "source_sense_id": "77c62038-4dc3-3ec9-a468-e66f46f053d4",
                        "target_lang_word": "кастовый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кастовый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6679963e-cad5-3e13-a941-78f38a625752",
                                        "entry_id": "6a835923-3fe4-360f-b980-f5e8597d8432",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным каста; основанный на делении общества на касты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2878152-0eac-4d1f-8c2c-d106bf228876",
                                                "sense_id": "6679963e-cad5-3e13-a941-78f38a625752",
                                                "text": "Я признаю личный этикет и отвергаю кастовый."
                                            },
                                            {
                                                "example_id": "5abe00cc-92f1-4b14-9fd5-80bb0d88352f",
                                                "sense_id": "6679963e-cad5-3e13-a941-78f38a625752",
                                                "text": "Кастовая система, изобретенная с целью, так сказать, выведения пород людей разного общественного назначения, уже тысячи лет назад не оправдала себя, а в отношении своей прямой цели ― улучшения людей полностью провалилась."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
