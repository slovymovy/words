                "senses": [
                    {
                        "sense_id": "fbbadd32-9244-32dc-b3ff-932bc5873e27",
                        "entry_id": "71f64c51-6063-3ccf-9e99-2c004f50194e",
                        "glosses": [
                            "(vollkommen) von Alkohol berauscht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d137be02-cf62-4e64-9fd4-aca303858542",
                                "sense_id": "fbbadd32-9244-32dc-b3ff-932bc5873e27",
                                "text": "„Die setzen sich babbelas in ihre Tjorrie und rasen los, komme was wolle.“"
                            },
                            {
                                "example_id": "3472178d-70a0-4bb4-9db3-355063d239ee",
                                "sense_id": "fbbadd32-9244-32dc-b3ff-932bc5873e27",
                                "text": "„Aber das is nich unbedingt die Lösung, denn wenn ein Oukie babbelas is, machen die anderen ihm 'ne lange Nase.“"
                            },
                            {
                                "example_id": "6be5bde9-2b13-43cf-8473-1853e23c470d",
                                "sense_id": "fbbadd32-9244-32dc-b3ff-932bc5873e27",
                                "text": "„Und auch das muss angezweifelt werden, weil die Oukies die Lampenpfähle und Ampeln wrachtach nich nach dem Biertrunk umfahren, sondern um Lampenmasten abzurasieren und schlimmere Karambolagen zu verursachen, wo mancher nich mehr lebend rauskommt, kommt harter geistiger Trunk ins Spiel, der richtig babbelas macht und deftigen Hängover nach sich zieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
