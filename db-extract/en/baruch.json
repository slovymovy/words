{
    "word": "baruch",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "21ef9b0b-e2c5-3966-96f2-c0c78787e9f6",
                "word": "Baruch",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9ebb1f51-8dee-39b8-88d8-97bbf6b6cf68",
                        "entry_id": "21ef9b0b-e2c5-3966-96f2-c0c78787e9f6",
                        "glosses": [
                            "Any of a number of Old Testament men, including the scribe and companion of Jeremiah."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a21cef-563c-4178-9e48-9c61ebab0fee",
                                "sense_id": "9ebb1f51-8dee-39b8-88d8-97bbf6b6cf68",
                                "text": "Then Jeremiah called Baruch the son of Neriah: and Baruch wrote from the mouth of Jeremiah all the words of the LORD, which he had spoken unto him, upon a roll of a book."
                            }
                        ]
                    },
                    {
                        "sense_id": "a48db5e9-f8f3-31fd-b10b-8647522f9de8",
                        "entry_id": "21ef9b0b-e2c5-3966-96f2-c0c78787e9f6",
                        "glosses": [
                            "A book of the Catholic and Eastern Orthodox canon of the Old Testament, considered apocryphal by Protestants."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c1e6302b-d66b-39d9-a37f-cbdf1d5a1889",
                        "entry_id": "21ef9b0b-e2c5-3966-96f2-c0c78787e9f6",
                        "glosses": [
                            "A male given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa65015f-d17d-40d4-badf-d7e6016bbb14",
                        "source_entry_id": "21ef9b0b-e2c5-3966-96f2-c0c78787e9f6",
                        "source_sense_description": "Biblical figure",
                        "target_lang_word": "Baruch",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baruch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71a8e398-9739-3bc3-a323-db4d7b115708",
                                        "entry_id": "77693ca8-88b5-381a-83f4-d787ae2d39f8",
                                        "glosses": [
                                            "Baruch ben Neria, secrétaire du prophète Jérémie."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c2b923-249f-4a03-93ee-06e3387a5673",
                                                "sense_id": "71a8e398-9739-3bc3-a323-db4d7b115708",
                                                "text": "Voici les paroles du livre qu’écrivit Baruch, fils de Néreïas ; fils de Maasias, fils de Sédécias, fils de Sédéï, fils de Helcias, à Babylone, la cinquième année, le premier jour du mois, au temps où les Chaldéens avaient pris Jérusalem et l’avaient brûlée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8486dcb8-1ad9-3924-879b-e6bb41324525",
                                        "entry_id": "77693ca8-88b5-381a-83f4-d787ae2d39f8",
                                        "glosses": [
                                            "Livre de l’Ancien Testament, attribué au secrétaire de Jérémie."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445d8806-11f4-4d5a-a2a2-c9fd5842c70f",
                                                "sense_id": "8486dcb8-1ad9-3924-879b-e6bb41324525",
                                                "text": "Le livre de Baruch est deutérocanonique, il n’est pas reconnu par les Protestants."
                                            },
                                            {
                                                "example_id": "7142d959-3f76-4601-b188-a1494ee42de7",
                                                "sense_id": "8486dcb8-1ad9-3924-879b-e6bb41324525",
                                                "text": "Celui qui nous était le plus familier était La Fontaine, […]. Sa biographie me révéla qu’une grande ferveur religieuse s’emparait parfois de lui. La lecture d’un livre de Baruch, disciple de Jérémie, avait tellement soulevé son enthousiasme qu’il arrêtait les passants et leur posait la question :\n« Avez-vous lu Baruch ? « Avez-vous lu Baruch ? »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Baruch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9266f25-d9d9-32e2-9f33-2f2a2c722c97",
                                        "entry_id": "22f90d7a-98c2-394a-ae6c-16ae4bafcbf1",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9b4bec-6199-4638-a55b-75b848ba5c60",
                                                "sense_id": "b9266f25-d9d9-32e2-9f33-2f2a2c722c97",
                                                "text": "Baruch Spinoza."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
