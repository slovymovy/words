                "senses": [
                    {
                        "sense_id": "dd223d54-3c2c-316f-a447-b6d30fcda959",
                        "entry_id": "4257d155-9d48-344f-9394-e9e596be6c2c",
                        "glosses": [
                            "Stilstufe von 1730 bis 1780, in der die Schwere des Barocks zunehmend in beschwingten Formen, zarten Farbtönen und hellen Räumen ins Spielerische zurückgenommen wird"
                        ],
                        "tags": [
                            "Kunstgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "13b4f631-1d53-4e8b-b164-33ae0dfe6dc2",
                                "sense_id": "dd223d54-3c2c-316f-a447-b6d30fcda959",
                                "text": "„Anders als in Frankreich spricht man auch im deutschen Kirchenbau von Rokoko mit dem Blick auf die Dekoration in den genialen spätbarocken Raumschöpfungen (Birnau, Vierzehnheiligen, Wieskirche, Zwiefalten und andere); […]“"
                            },
                            {
                                "example_id": "29b53c7b-4513-4210-97d7-6c271e8399f1",
                                "sense_id": "dd223d54-3c2c-316f-a447-b6d30fcda959",
                                "text": "„Den Rollentausch der Shakespearezeit, wo Männer Frauen spielten, können wir seit der Barockzeit und dem Rokoko bis heute in der Oper nachvollziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8cb56cf-fb47-49ad-bf54-b704ae0f3be1",
                        "source_entry_id": "4257d155-9d48-344f-9394-e9e596be6c2c",
                        "source_sense_id": "dd223d54-3c2c-316f-a447-b6d30fcda959",
                        "target_lang_word": "rococo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rococo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a599e1b-8967-3e05-9942-4f7dca5abf35",
                                        "entry_id": "5052f96b-45cc-316f-bd97-309fdd3d91f8",
                                        "glosses": [
                                            "A style of baroque architecture and decorative art, from 18th-century France, having elaborate ornamentation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90c863fd-90c5-4140-8fda-e5ed8eca1a4b",
                                                "sense_id": "5a599e1b-8967-3e05-9942-4f7dca5abf35",
                                                "text": "They built a rococo aedicule that stands around the Tomb today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d78ec105-15e2-36ab-a15f-012110db2207",
                                        "entry_id": "5052f96b-45cc-316f-bd97-309fdd3d91f8",
                                        "glosses": [
                                            "A piece of ornamentation in this style."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c53d41-6813-41e5-bb69-fa6af2e75385",
                                                "sense_id": "d78ec105-15e2-36ab-a15f-012110db2207",
                                                "text": "Above the two chief figures are rococos on either side of the clock face. These, like all the other work, are in bold relief and wrought with great delicacy and grace. On the top of the clock is a realistic scene from nature."
                                            },
                                            {
                                                "example_id": "2380c75d-4634-4f01-bff5-eb12946b1666",
                                                "sense_id": "d78ec105-15e2-36ab-a15f-012110db2207",
                                                "text": "The marzipan and that kind of malleable ceramic, the rococo decorations, the flowers made of hard sugar, the frosted blue surfaces, kind of gray, the pearls, the legal coloring... all of it supposedly suitable for human consumption."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rococo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc2d69d-2c5d-3274-b7e4-8754850af2b6",
                                        "entry_id": "e276156a-f07e-3004-8a8a-f9422bd2eaa4",
                                        "glosses": [
                                            "Of or relating to the rococo style."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e25df24f-d565-3c84-b339-cc8c87854590",
                                        "entry_id": "e276156a-f07e-3004-8a8a-f9422bd2eaa4",
                                        "glosses": [
                                            "Over-elaborate or complicated; opulent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1bd536d-a4d0-3b88-a8c9-1f9ce067f5ef",
                                        "entry_id": "e276156a-f07e-3004-8a8a-f9422bd2eaa4",
                                        "glosses": [
                                            "Old-fashioned."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba673a08-b074-4461-9f27-b54a9dde2263",
                        "source_entry_id": "4257d155-9d48-344f-9394-e9e596be6c2c",
                        "source_sense_id": "dd223d54-3c2c-316f-a447-b6d30fcda959",
                        "target_lang_word": "rococo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rococo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2250782-1023-3548-be63-3f5b05b13bd9",
                                        "entry_id": "c5720a86-56ea-3171-82fc-82b4090a86ae",
                                        "glosses": [
                                            "Se dit d'un style décoratif dérivant du baroque et de la rocaille qui fut en vogue dans la première moitié du dix-huitième siècle, particulièrement en Allemagne, en Autriche et en Italie."
                                        ],
                                        "tags": [
                                            "Arts décoratifs"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b891740a-391b-4f8c-8000-09b8455db5c7",
                                                "sense_id": "d2250782-1023-3548-be63-3f5b05b13bd9",
                                                "text": "Le style rococo est caractérisé par le foisonnement des couleurs et des formes, la profusion et l'exubérance d'ornements contournés."
                                            },
                                            {
                                                "example_id": "3ef81748-c27d-41b5-83a2-37f834d4c223",
                                                "sense_id": "d2250782-1023-3548-be63-3f5b05b13bd9",
                                                "text": "Vous ne trouverez pas une superficie d’un pouce carré qui ne soit guillochée, festonnée, dorée ou peinte ; tout ce que le genre désigné chez nous sous le nom de rococo a laissé de plus rocailleux et de plus désordonné, avec une épaisseur et un entassement de luxe que le bon goût français, même aux pires époques, a toujours su éviter. Ce pompadour-hollando-chinois amuse et surprend en Andalousie."
                                            },
                                            {
                                                "example_id": "7038068c-68a3-4839-9020-b4d4339700ef",
                                                "sense_id": "d2250782-1023-3548-be63-3f5b05b13bd9",
                                                "text": "On remue le prie-Dieu, les chaises, le confessionnal rococo, joli comme une pièce de nougat, on dérange la statue des saints, on met en lambeaux les toiles d’araignée."
                                            },
                                            {
                                                "example_id": "a90c9cfa-3aa0-4451-9127-a0a4931093a5",
                                                "sense_id": "d2250782-1023-3548-be63-3f5b05b13bd9",
                                                "text": "Cette fin de l’ère rococo dans les Pays-Bas autrichiens laisse le même arrière-goût pâteux que les natures mortes des petits-maîtres flamands de l’époque, avec leurs fruits, leur foie gras en croûte, et leurs cadavres de bêtes sur des plats de vermeil et des tapis turcs."
                                            },
                                            {
                                                "example_id": "9e609016-bc6f-419f-9266-c2282e7ccf4f",
                                                "sense_id": "d2250782-1023-3548-be63-3f5b05b13bd9",
                                                "text": "François Boucher est l’un des principaux « acteurs » du mouvement rococo. Il peint de nombreuses scènes pastorales ou mythologiques mais aussi des scènes d’amour et des scènes de plaisirs qui traduisent les mœurs relâchées de l’époque."
                                            },
                                            {
                                                "example_id": "85d4c72d-8282-452d-b2e5-47e0f85e9a42",
                                                "sense_id": "d2250782-1023-3548-be63-3f5b05b13bd9",
                                                "text": "Au milieu du XVIIIᵉ siècle, ceci a commencé à changer, car des cartes d’affaires ont commencé à être conçues comme des cartouches détaillés, avec les marchandises en vente présentées dans et autour d’encadrements rococo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85bec6ad-c007-3675-acf1-13546090672d",
                                        "entry_id": "c5720a86-56ea-3171-82fc-82b4090a86ae",
                                        "glosses": [
                                            "Surchargé de fioritures, recherché à l’excès."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d29da83-e02b-4a91-927f-9efd9cfe8b8d",
                                                "sense_id": "85bec6ad-c007-3675-acf1-13546090672d",
                                                "text": "Un chapeau rococo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f2a36f3-20d2-3b6a-b11c-afb2a630024e",
                                        "entry_id": "c5720a86-56ea-3171-82fc-82b4090a86ae",
                                        "glosses": [
                                            "Qui est suranné, passé de mode."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5230f294-5442-4ad4-974b-543c6f0aa448",
                                                "sense_id": "6f2a36f3-20d2-3b6a-b11c-afb2a630024e",
                                                "text": "Oh ! me dit le commissaire-priseur, tout cela était bien rococo. » Mot épouvantable qui flétrissait toutes les religions de mon enfance et me dépouillait de mes premières illusions, les plus chères de toutes."
                                            },
                                            {
                                                "example_id": "d3f2c7e6-9220-4a7f-ac57-2250264b4526",
                                                "sense_id": "6f2a36f3-20d2-3b6a-b11c-afb2a630024e",
                                                "text": "Gaussin, […], lui reproche la colère d'un père ridicule à être empaillé, tellement il est rococo et en dehors du mouvement bourgeois."
                                            },
                                            {
                                                "example_id": "851326cd-663f-4c1f-9e0f-2f981ae7fb19",
                                                "sense_id": "6f2a36f3-20d2-3b6a-b11c-afb2a630024e",
                                                "text": "Ahasvérus et Childe-Harold sont démodés, mon pauvre Plumkett, et votre petite histoire est d’un rococo complet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rococo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b2e8057-5425-30a7-b1bc-e6eba5f359ab",
                                        "entry_id": "9f14ce35-a159-3337-8ae9-62b4d9ddc371",
                                        "glosses": [
                                            "Le style, le genre rococo."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3d30b2-87a5-4745-912c-812cea50bf08",
                                                "sense_id": "2b2e8057-5425-30a7-b1bc-e6eba5f359ab",
                                                "text": "En effet, comme tous les termes que la littérature emprunte aux Beaux-arts, le rococo est marqué par la définition que donnent de lui la peinture et l’architecture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
