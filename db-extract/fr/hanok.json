                ],
                "senses": [
                    {
                        "sense_id": "c6ceb6ab-1aba-3800-a697-3205bcbe7afd",
                        "entry_id": "713e21ff-b58f-32cc-933a-0058f957275c",
                        "glosses": [
                            "Maison traditionnelle coréenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e53b8bd-5229-4b05-a1e0-c943a9a3f943",
                                "sense_id": "c6ceb6ab-1aba-3800-a697-3205bcbe7afd",
                                "text": "Objet de fierté nationale, l’hanok réhabilitée ne profite pas qu’à son propriétaire : elle bonifie aussi l’offre touristique séoulite, et deux fois plutôt qu’une."
                            },
                            {
                                "example_id": "23eb91c0-52a9-4dce-800c-41f35cc56cf2",
                                "sense_id": "c6ceb6ab-1aba-3800-a697-3205bcbe7afd",
                                "text": "Afin de construire une hanok, on érige d’abord les piliers et la structure en bois de la maison. On mure ensuite la structure avec des briques faites de terre et d’herbe."
                            },
                            {
                                "example_id": "ff0fcf36-7819-4941-b067-32145d063676",
                                "sense_id": "c6ceb6ab-1aba-3800-a697-3205bcbe7afd",
                                "text": "Réaménager l’intérieur d’un hanok, ajouter une cave ou un deuxième étage comme cela se fait parfois dans le quartier, cela le scandalise."
                            },
                            {
                                "example_id": "15f703db-3f5e-40a6-b6ae-42a6d7c327c8",
                                "sense_id": "c6ceb6ab-1aba-3800-a697-3205bcbe7afd",
                                "text": "Un « hanok » est une maison traditionnelle coréenne bâtie avec de la terre et du bois, puis couverte de tuiles appelées « kiwa »."
                            }
                        ]
                    }
                ],
