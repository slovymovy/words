            },
            {
                "entry_id": "66d19d55-8ab8-31a2-967a-09a72b2576db",
                "word": "ocelot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "06292bdb-a54c-4f42-8cbe-adbd96b019f5",
                        "entry_id": "66d19d55-8ab8-31a2-967a-09a72b2576db",
                        "tags": [
                            "plural"
                        ],
                        "form": "ocelots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4a47d0b-da66-355d-afe1-95fe238d660a",
                        "entry_id": "66d19d55-8ab8-31a2-967a-09a72b2576db",
                        "glosses": [
                            "Petit félin d’Amérique à pelage roux tacheté de brun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1352df-1671-4e37-8b0f-aa5871c0d43e",
                                "sense_id": "e4a47d0b-da66-355d-afe1-95fe238d660a",
                                "text": "Quelques animaux, entre autres l’ocelot, se tenaient tapis dans les fourrés."
                            },
                            {
                                "example_id": "dcbb4fba-ac5c-4c09-b366-7acbf4ebc694",
                                "sense_id": "e4a47d0b-da66-355d-afe1-95fe238d660a",
                                "text": "Pour garantir l’intégrité de son territoire, la communauté a décidé de préserver une zone de 10 000 ha, la Playa de Oro Reserva de Tigrillos, afin de protéger les félins de la jungle —jaguars, cougars, ocelots, margays, oncillas et jaguarundis."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d5aeb44-6ed0-357c-a965-1a9916b2ab5e",
                        "entry_id": "66d19d55-8ab8-31a2-967a-09a72b2576db",
                        "glosses": [
                            "Fourrure de cet animal."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "202791ed-edc1-4c1e-adee-5d1e62800fea",
                                "sense_id": "0d5aeb44-6ed0-357c-a965-1a9916b2ab5e",
                                "text": "Les dignitaires Maya portaient des manteaux en ocelot."
                            },
                            {
                                "example_id": "87c88631-5804-4f2d-b579-14f0a0949b8a",
                                "sense_id": "0d5aeb44-6ed0-357c-a965-1a9916b2ab5e",
                                "text": "Vous pourrez mettre ces charmants gilets d’ocelot ou d’agneau rasé qui se glisseront sous les jaquettes sans alourdir la silhouette."
                            },
                            {
                                "example_id": "24ad8c55-82f4-4786-b8ea-f78523ab5247",
                                "sense_id": "0d5aeb44-6ed0-357c-a965-1a9916b2ab5e",
                                "text": "Pierre coiffa sa femme d’un chapeau bordé de fourrure, l’enroula dans le manteau d’ocelot qu’il venait de lui acheter et qui lui donnait l’air d’une ménade (d’une ménade avec toute sa tête), et l’entraîna vivement dehors."
                            },
                            {
                                "example_id": "1e0d0a85-b85e-4052-a7c3-b33576ad81ef",
                                "sense_id": "0d5aeb44-6ed0-357c-a965-1a9916b2ab5e",
                                "text": "Adorable sous les plumes de son chapeau,\nElle frissonnait dans un manteau d’ocelot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95f00805-117e-4bfa-ba4e-c51eb001c652",
                        "source_entry_id": "66d19d55-8ab8-31a2-967a-09a72b2576db",
                        "source_sense_id": "e4a47d0b-da66-355d-afe1-95fe238d660a",
                        "source_sense_description": "Félin d’Amérique",
                        "target_lang_word": "Ozelot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ozelot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e30e5aaa-9d45-34a8-bc83-e9f98b3b2ebf",
                                        "entry_id": "d36e93cf-1d5d-3c95-9fcc-c4ef8ae07401",
                                        "glosses": [
                                            "in Süd- und Mittelamerika vorkommende Katzenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc0b0a2-3543-4789-9d94-4707917565fe",
                                                "sense_id": "e30e5aaa-9d45-34a8-bc83-e9f98b3b2ebf",
                                                "text": "„Das Fell der Ozelots ist mit schwarzen, ring- bis rosettenartigen Flecken bedeckt, die streifenförmig angeordnet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
