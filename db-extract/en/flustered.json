                "senses": [
                    {
                        "sense_id": "49165bc4-58e6-385d-ac85-47e1c9b25d21",
                        "entry_id": "e44684f8-f30c-3d91-8647-0e8287cd712d",
                        "glosses": [
                            "Confused, befuddled, in a state of panic by having become overwrought with confusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9086dbe8-83e0-4328-b15f-ec14ba8425b3",
                                "sense_id": "49165bc4-58e6-385d-ac85-47e1c9b25d21",
                                "text": "The speaker became quite flustered when she dropped all her notes."
                            },
                            {
                                "example_id": "bc8e03ec-342e-4ff7-94e2-8225c052a893",
                                "sense_id": "49165bc4-58e6-385d-ac85-47e1c9b25d21",
                                "text": "Behind the scenes, Truss's camp feel positive too—claiming that while she stayed calm Sunak was “flustered”."
                            },
                            {
                                "example_id": "fc9c6630-98bf-421a-a86a-1c3f46991ffb",
                                "sense_id": "49165bc4-58e6-385d-ac85-47e1c9b25d21",
                                "text": "I ring her bell and I’m buzzed in. My Spanish teacher, Miss P – Ali – is standing in the doorway, looking flustered."
                            }
                        ]
                    },
                    {
                        "sense_id": "b39c8a95-96f0-36b9-b88e-1a7e732e018d",
