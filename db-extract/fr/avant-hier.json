                                                "sense_id": "4bb33ba4-98a3-30cf-8ddf-10ec82496c61",
                                                "text": "Vandaag is het zaterdag, gisteren was het vrijdag, eergisteren was het donderdag, morgen is het zondag en overmorgen is het maandag."
                                            },
                                            {
                                                "example_id": "e1ad9f66-86cb-4e02-87ba-6f1d0ed40a3d",
                                                "sense_id": "4bb33ba4-98a3-30cf-8ddf-10ec82496c61",
                                                "text": "De grote Griek was de eerste die mij aan zijn tafeltje noodde, eergisteren, tijdens de merenda, die elke dag tussen vier en halfrijf wordt geserveerd in de Chinese kamer."
                                            }
                                        ]
                                    }
