                "senses": [
                    {
                        "sense_id": "9d73ab62-340b-3511-8242-7edee35c0805",
                        "entry_id": "1ecd1876-d54e-3215-b428-c15f5901bbaa",
                        "glosses": [
                            "изменяясь, становиться способным эффективно действовать в изменившихся условиях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963564a2-df48-4737-a951-fe934f12cda3",
                                "sense_id": "9d73ab62-340b-3511-8242-7edee35c0805",
                                "text": "Мы с тобой живём в жестоком мире, и хочешь ты того или нет, а к нему надо приспосабливаться."
                            },
                            {
                                "example_id": "42e9db91-d07e-4967-b26b-93a992d91551",
                                "sense_id": "9d73ab62-340b-3511-8242-7edee35c0805",
                                "text": "Нужно уметь быстро приспосабливаться к обстановке, а это непросто."
                            }
                        ]
                    }
                ],
