                                    {
                                        "sense_id": "0d29d4e4-72f1-3c6c-9307-f2f34df1f8f5",
                                        "entry_id": "14e59c0c-46c6-3afe-a578-a6b50c34f22d",
                                        "glosses": [
                                            "A designated player that attempts to prevent the opposing team from scoring by protecting a goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62549e8-796a-4bdd-87a4-8f2d345fba32",
                                                "sense_id": "0d29d4e4-72f1-3c6c-9307-f2f34df1f8f5",
                                                "text": "Krohn-Dehli took advantage of a lucky bounce of the ball after a battling run on the left flank by Simon Poulsen, dummied two defenders and shot low through goalkeeper Maarten Stekelenburg's legs after 24 minutes."
                                            },
                                            {
                                                "example_id": "ae494947-905c-4f0d-8844-9c6bfc8d77d3",
                                                "sense_id": "0d29d4e4-72f1-3c6c-9307-f2f34df1f8f5",
                                                "text": "Handball is a team sport in which two teams of seven players each (six outcourt players and a goalkeeper) pass a ball using their hands with the aim of throwing it into the goal of the other team."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c414b17e-e34e-45e5-9e96-a159f8842fd3",
                        "source_entry_id": "6dd65066-a8ae-3b89-82d5-4dd08ee0fd15",
                        "source_sense_id": "93abe13c-28d9-3e85-8e2a-2d97e4050fc4",
