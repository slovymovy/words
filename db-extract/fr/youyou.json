        "fr-extract.jsonl": [
            {
                "entry_id": "3b67deb1-caa3-3ba8-adcb-25231ecdc260",
                "word": "youyou",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ed437cc9-9a2c-42f9-86df-33853387108d",
                        "entry_id": "3b67deb1-caa3-3ba8-adcb-25231ecdc260",
                        "tags": [
                            "plural"
                        ],
                        "form": "youyous"
                    },
                    {
                        "form_id": "c6dd0270-2dba-4426-8a51-2da3894d295f",
                        "entry_id": "3b67deb1-caa3-3ba8-adcb-25231ecdc260",
                        "tags": [
                            "Moins courant"
                        ],
                        "form": "you-you"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a623cdc-0590-3f5a-bc7a-5193afe2c220",
                        "entry_id": "3b67deb1-caa3-3ba8-adcb-25231ecdc260",
                        "glosses": [
                            "Petit canot chinois utilisé en rivière ou dans des zones marines abritées et qui se manœuvre soit à l’aviron soit à la godille."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b32ec9cc-fbd5-36d1-998a-cca85d506d0b",
                        "entry_id": "3b67deb1-caa3-3ba8-adcb-25231ecdc260",
                        "glosses": [
                            "Petit canot court et large utilisé pour la navette entre les bateaux au mouillage et les quais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fbb46e-6c50-41da-b523-3dc6859e03ae",
                                "sense_id": "b32ec9cc-fbd5-36d1-998a-cca85d506d0b",
                                "text": "Maintenant, camarade… marchons vite jusqu’au port. Je ne serai tranquille que lorsque nous aurons le pied sur le youyou."
                            },
                            {
                                "example_id": "78f1c6bc-2003-4ecf-8e73-5cdc3555d174",
                                "sense_id": "b32ec9cc-fbd5-36d1-998a-cca85d506d0b",
                                "text": "Nous étions deux garçons, deux filles\nSur un petit youyou de bois\nIl s’appelait Nina gentille\nEt nous allions à Cuba."
                            },
                            {
                                "example_id": "09eb4f27-1f0d-4e45-b387-f4a55c9c724f",
                                "sense_id": "b32ec9cc-fbd5-36d1-998a-cca85d506d0b",
                                "text": "L’inquiétude les avait saisis dès le premier soir, quand Yelpy et Le Kerrec étaient revenus avec le youyou, après avoir sabordé la Jubilation."
                            }
                        ]
                    },
                    {
                        "sense_id": "17a2a4de-d26f-3f10-ab05-a788594fbf47",
                        "entry_id": "3b67deb1-caa3-3ba8-adcb-25231ecdc260",
                        "glosses": [
                            "Canot pneumatique, généralement utilisé pour le sauvetage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7ca6e34a-e0a1-3216-a2cc-59d627cc4a7d",
                        "entry_id": "3b67deb1-caa3-3ba8-adcb-25231ecdc260",
                        "glosses": [
                            "Cri de joie ou de tristesse aigu modulé de type ululement poussé en certaines occasions par les femmes d’Afrique du Nord et du Moyen-Orient."
                        ],
                        "tags": [
                            "Souvent au pluriel"
                        ],
                        "examples": [
                            {
                                "example_id": "d276b7d3-f32f-485f-83ef-38e3a41aaa03",
                                "sense_id": "7ca6e34a-e0a1-3216-a2cc-59d627cc4a7d",
                                "text": "Des youyous de joie."
                            },
                            {
                                "example_id": "4f822eab-b17b-49f1-9901-f690637609d5",
                                "sense_id": "7ca6e34a-e0a1-3216-a2cc-59d627cc4a7d",
                                "text": "Les Français, quand ils entendent nos mères avec leurs chœurs de youyous suraigus qui s’envolent, n’en perçoivent pas la joie, ça non!"
                            },
                            {
                                "example_id": "09fd111e-7a69-43f4-b52d-69edc43149da",
                                "sense_id": "7ca6e34a-e0a1-3216-a2cc-59d627cc4a7d",
                                "text": "Ils arrivent munis de leurs tambourins, entrent dans la maison où les femmes les reçoivent en poussant des youyou."
                            },
                            {
                                "example_id": "8280bfd4-03f1-45e2-9124-5acfcf735039",
                                "sense_id": "7ca6e34a-e0a1-3216-a2cc-59d627cc4a7d",
                                "text": "Les hommes chargèrent le quintal de blé. Le tambourinaire agitait sa baguette, les hommes faisaient parler la poudre, les femmes poussaient des youyous."
                            },
                            {
                                "example_id": "1d8fc379-bb49-4dd5-98bb-36c92e5b1292",
                                "sense_id": "7ca6e34a-e0a1-3216-a2cc-59d627cc4a7d",
                                "text": "Ce banquet sans alcool était un vrai festin, qui détonnait avec les youyous du malheur entendus dans la matinée."
                            },
                            {
                                "example_id": "9841ad44-79db-4b46-84a2-25c599612005",
                                "sense_id": "7ca6e34a-e0a1-3216-a2cc-59d627cc4a7d",
                                "text": "Les juges ont rendu leurs verdicts en l’absence des détenus et de leurs familles, qui ont décidé il y a quelques jours de « boycotter » le procès. Pleurs et youyous ont aussitôt résonné dans les couloirs du Tribunal dès le prononcement des verdicts."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe32f202-05f2-3332-a8f4-3d3d4bb96591",
                        "entry_id": "3b67deb1-caa3-3ba8-adcb-25231ecdc260",
                        "glosses": [
                            "Variante de yoyo, beignets tunisiens."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": []
                    },
