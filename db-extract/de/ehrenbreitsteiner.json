                        "examples": [
                            {
                                "example_id": "b6e47291-15af-4f5c-ad57-bd7f51f0eed1",
                                "sense_id": "7d84ec93-cb32-3607-8476-2ccd21ee0169",
                                "text": "„Unbedenklich schien ihm eine Vereinigung der Ehrenbreitsteiner Kammerbehörde mit dem Kammerkollegium in Weilburg zu sein.“"
                            },
                            {
                                "example_id": "9e765444-940b-4326-8d1f-dad1266ab251",
                                "sense_id": "7d84ec93-cb32-3607-8476-2ccd21ee0169",
                                "text": "„Das „Ehrenbreitsteiner Gesangbuch\" erschien 1818 zum ersten Mal und erlebte bis 1846 mindestens 18 weitere Auflagen; […]“"
                            },
                            {
                                "example_id": "91a48db6-f706-4b06-b570-ee4a07b3be29",
                                "sense_id": "7d84ec93-cb32-3607-8476-2ccd21ee0169",
                                "text": "„Der Frieden von Lunéville im Jahre 1801 machte den Rhein zur Grenze zwischen Frankreich und Deutschland. Er entschied auch das Schicksals des Ehrenbreitsteins. […] Die Festung Ehrenbreitstein wurde in die Luft gesprengt, […]. Doch gelang es den Ehrenbreitsteiner Bürgern, die Zerstörung der übrigen kurfürstlichen Gebäude zu verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
