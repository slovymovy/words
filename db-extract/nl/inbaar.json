                                    }
                                ]
                            },
                            {
                                "target_word": "collectable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0abc6927-9b5e-3c88-b182-36b434641c94",
                                        "entry_id": "069324c0-48e9-30c1-adc1-9ace0a2f4cb3",
                                        "glosses": [
                                            "Anything that someone might want to collect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3770e701-154a-4e03-8c2b-b9bcdaa859e4",
                                                "sense_id": "0abc6927-9b5e-3c88-b182-36b434641c94",
                                                "text": "If you invest in collectables overseas, you can make a profit or loss on currency exchange rates as well as a gain or loss on movements in intrinsic capital value."
                                            },
                                            {
                                                "example_id": "0302d022-e730-4cf7-b742-25f3dbe97532",
                                                "sense_id": "0abc6927-9b5e-3c88-b182-36b434641c94",
                                                "text": "The mindset of making collectables runs against that of making games—if you succeed in the collectable department then there is a tendency to keep new players out and to drive old ones away because of escalating prices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
