                    {
                        "sense_id": "979d7618-308c-3b06-be4b-0f5db8ef75d3",
                        "entry_id": "d98dd1be-80fc-35d0-a0c5-b8e315e6ca6f",
                        "glosses": [
                            "een boek bedoeld om er iets uit te leren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e89b0316-dc12-4ee2-8ffd-18856da4182a",
                                "sense_id": "979d7618-308c-3b06-be4b-0f5db8ef75d3",
                                "text": "Hij schreef een nieuw leerboek voor de eerstejaars in scheikunde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32a54390-3a2b-4e15-8782-ab7e44eba51f",
                        "source_entry_id": "d98dd1be-80fc-35d0-a0c5-b8e315e6ca6f",
                        "source_sense_id": "979d7618-308c-3b06-be4b-0f5db8ef75d3",
                        "source_sense_description": "een boek bedoeld om er iets uit te leren",
                        "target_lang_word": "Lehrbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehrbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc8bd3d3-5aa7-3e81-832a-1fb8085f587d",
                                        "entry_id": "916e831f-3b86-3bfe-a04f-5fe376393785",
                                        "glosses": [
                                            "Buch, das dazu dient, das Erlernen eines Faches zu ermöglichen, entweder im Selbststudium oder im Unterricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52fef541-2414-42c9-a0ff-6b8f3278a2dc",
                                                "sense_id": "bc8bd3d3-5aa7-3e81-832a-1fb8085f587d",
                                                "text": "Lehrbücher sind die Schulbücher und die Einführungen in Wissenschaften."
                                            },
                                            {
                                                "example_id": "7695b1f2-4b79-42d6-9f47-4b0458edab82",
                                                "sense_id": "bc8bd3d3-5aa7-3e81-832a-1fb8085f587d",
                                                "text": "Lehrbücher müssen nicht nur wie Fachbücher und Sachbücher inhaltlich richtig, sondern auch didaktisch durchdacht sein."
                                            },
                                            {
                                                "example_id": "60c7d163-15f9-427d-b7fe-9239e4324ce1",
                                                "sense_id": "bc8bd3d3-5aa7-3e81-832a-1fb8085f587d",
                                                "text": "„Die Poesie als Dienerin der Beredsamkeit: dies war auch der didaktische Grundsatz von Christian Weise, der als Rektor des Gymnasiums zu Zittau und als Verfasser von Schauspielen, Romanen und zahlreichen Lehrbüchern gleichzeitig mit Thomasius und vielleicht wirkungsvoller noch als dieser der deutschen Stilbildung im 18. Jahrhundert den Weg gewiesen hat.“"
                                            },
                                            {
                                                "example_id": "addb99ce-1b94-4130-a62f-0f2da6d5146a",
                                                "sense_id": "bc8bd3d3-5aa7-3e81-832a-1fb8085f587d",
                                                "text": "„Es gibt keine Lehrbücher über diese Situation – deshalb muss ich improvisieren.“"
                                            },
                                            {
                                                "example_id": "fd161075-725b-4201-87bc-6fd98ddab32b",
                                                "sense_id": "bc8bd3d3-5aa7-3e81-832a-1fb8085f587d",
                                                "text": "„Unsere Eltern belegten einen Sprachkurs nach dem anderen, sie lernten unaufhörlich Vokabeln, sie waren irritiert, wenn sie merkten, dass die deutschen Nachbarn Dativ statt Genitiv benutzten, und schauten daheim in ihren Lehrbüchern nach.“"
                                            },
                                            {
                                                "example_id": "7785fae0-dc3a-4b45-ba4c-360954199798",
                                                "sense_id": "bc8bd3d3-5aa7-3e81-832a-1fb8085f587d",
                                                "text": "„Viel später, ich hatte die Zeichnungen längst vergessen, habe ich ein gleiches, über fünfundachtzig Jahre altes Lehrbuch schmunzelnd auf eBay wiedergefunden und war gerührt.“"
                                            },
                                            {
                                                "example_id": "82bc04d4-c4d3-4d0c-8a6d-7127132bea2c",
                                                "sense_id": "bc8bd3d3-5aa7-3e81-832a-1fb8085f587d",
                                                "text": "„Alle unsere Lehrbücher waren von der gleichen Hand geschrieben, die Schuluniformen nach gleichem Muster gestrickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7ef986d-6f4b-4430-b703-aef2bbdb612c",
                        "source_entry_id": "d98dd1be-80fc-35d0-a0c5-b8e315e6ca6f",
                        "source_sense_id": "979d7618-308c-3b06-be4b-0f5db8ef75d3",
                        "source_sense_description": "een boek bedoeld om er iets uit te leren",
                        "target_lang_word": "textbook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "textbook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53c63f49-5a78-35ee-b088-913a98031a73",
                                        "entry_id": "c2229776-346b-35e3-a3c0-d999232afbfb",
                                        "glosses": [
                                            "A coursebook, a formal manual of instruction in a specific subject, especially one for use in schools or colleges."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "textbook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9336f6b9-e640-3cbd-b9d5-2499975b5376",
                                        "entry_id": "524faf0c-3d10-3c30-ba88-91faed5b1ae4",
                                        "glosses": [
                                            "Of or pertaining to textbooks or their style, especially in being dry and pedagogical; textbooky, textbooklike."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb149b14-48ae-4320-8f4b-37b37de6b111",
                                                "sense_id": "9336f6b9-e640-3cbd-b9d5-2499975b5376",
                                                "text": "These figures are just too textbook, or papyrus-like, as if this information came off of a shelf in the Library of Alexandria"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08c6e51f-c85a-3ae5-aa48-37fd895b405c",
                                        "entry_id": "524faf0c-3d10-3c30-ba88-91faed5b1ae4",
                                        "glosses": [
                                            "Having the typical characteristics of some class of phenomenon, so that it might be included as an example in a textbook."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c87b098-854f-4ed8-b3f2-bfd4cf99e6be",
                                                "sense_id": "08c6e51f-c85a-3ae5-aa48-37fd895b405c",
                                                "text": "Every night had been clear and star-studded, the progression of the moon through its phases absolutely textbook, its dance with the planets visible in the ecliptic..."
                                            },
                                            {
                                                "example_id": "1821c00a-34e1-4414-b7d1-b381565dabf8",
                                                "sense_id": "08c6e51f-c85a-3ae5-aa48-37fd895b405c",
                                                "text": "Involuntarily it is practiced all the time, for instance when Shylock at the beginning of the trial describes himself as a very textbook example of a very bad and very common illness."
                                            },
                                            {
                                                "example_id": "75d9689e-6d75-482b-a1d0-b39f3e08adc1",
                                                "sense_id": "08c6e51f-c85a-3ae5-aa48-37fd895b405c",
                                                "text": "It's absolutely textbook! / The amount of trust Mia had in her future self was infinitesimal. Thus, she couldn't help but feel like there was something off about this name. / It's too textbook!"
                                            },
                                            {
                                                "example_id": "fb6d31ab-9d0f-4ad1-b1de-33fc3a5e3d18",
                                                "sense_id": "08c6e51f-c85a-3ae5-aa48-37fd895b405c",
                                                "text": "It seemed too textbook, too talk-showish, but it was true."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db8f81b-7d00-38a5-ae63-0d3f77b77e13",
                                        "entry_id": "524faf0c-3d10-3c30-ba88-91faed5b1ae4",
                                        "glosses": [
                                            "Done exactly correctly, in an exemplary way that might be described in a textbook."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10726ff-0378-455a-bf47-a95445c8cf90",
                                                "sense_id": "6db8f81b-7d00-38a5-ae63-0d3f77b77e13",
                                                "text": "Well done everyone, the tree fell exactly where we planned. That was textbook."
                                            },
                                            {
                                                "example_id": "f91fa9fd-f076-4ca1-8480-0fc4de9de0d2",
                                                "sense_id": "6db8f81b-7d00-38a5-ae63-0d3f77b77e13",
                                                "text": "[…]Hilts and the commandant spar verbally in a very textbook shot/reverse shot scene, back and forth, “over the shoulder” of one interlocutor and then the other […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7495c22-99ba-38ff-8fb0-bbe27eb72bb6",
                                        "entry_id": "524faf0c-3d10-3c30-ba88-91faed5b1ae4",
                                        "glosses": [
                                            "Learned from, or as if learned from, a textbook, as opposed to personal discovery or experience."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2881a90-b1fc-44c3-bac2-9579279256a9",
                                                "sense_id": "a7495c22-99ba-38ff-8fb0-bbe27eb72bb6",
                                                "text": "He has a textbook understanding of company law but no practical experience of litigation."
                                            },
                                            {
                                                "example_id": "3ff150c9-b4bf-4f1f-93b3-21f59f4d9193",
                                                "sense_id": "a7495c22-99ba-38ff-8fb0-bbe27eb72bb6",
                                                "text": "So a lot of women will be very textbook if something meets the definition of sexual harassment, whereas a lot of men are more laissez-faire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44b3c62b-366f-4fb9-9b4e-fe913cab4a04",
                        "source_entry_id": "d98dd1be-80fc-35d0-a0c5-b8e315e6ca6f",
                        "source_sense_id": "979d7618-308c-3b06-be4b-0f5db8ef75d3",
                        "source_sense_description": "een boek bedoeld om er iets uit te leren",
                        "target_lang_word": "manuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01291c54-5d94-3a73-a1f8-a0212aa8ce46",
                                        "entry_id": "2ede80f3-6419-3411-8d94-e88197d424c7",
                                        "glosses": [
                                            "Qui concerne la main, qui est relatif à la main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c3ae7a4-6e77-4cd3-ba82-74ded5eb9693",
                                                "sense_id": "01291c54-5d94-3a73-a1f8-a0212aa8ce46",
                                                "text": "Une grande habileté manuelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "585de548-32df-300f-9f74-6a60f1ef8db1",
                                        "entry_id": "2ede80f3-6419-3411-8d94-e88197d424c7",
                                        "glosses": [
                                            "Qui se fait avec la main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4c35e1-46a5-49d8-849c-88836de708bf",
                                                "sense_id": "585de548-32df-300f-9f74-6a60f1ef8db1",
                                                "text": "La corporation étant un organisme chrétien, les juifs en étaient ipso facto écartés; l'exercice des professions étant interdit en dehors des corporations légalement reconnues, ils furent contraints, à leur corps défendant, de renoncer au travail manuel."
                                            },
                                            {
                                                "example_id": "dfba6dc0-3d18-4d38-a648-89e5433504c1",
                                                "sense_id": "585de548-32df-300f-9f74-6a60f1ef8db1",
                                                "text": "Le ramassage des pommes de terre est une opération agricole exécutée la plupart du temps d'une façon manuelle."
                                            },
                                            {
                                                "example_id": "11a9c701-1258-4ea5-87d3-276c1d0c3df1",
                                                "sense_id": "585de548-32df-300f-9f74-6a60f1ef8db1",
                                                "text": "Ce mode de sciage peut être manuel ou mécanique et se rencontre aussi sur des machines électroportatives (machines « scie sauteuse », « scie sabre ») ; dans ce cas, la lame n'est maintenue que par une seule extrémité."
                                            },
                                            {
                                                "example_id": "fa4c5e49-a9d9-4713-960a-0c599b40e6fa",
                                                "sense_id": "585de548-32df-300f-9f74-6a60f1ef8db1",
                                                "text": "Je n'ai jamais compris que l'on nommât manuels ces travaux [de forge ou de menuiserie] : rien n'est fait par la main de l'Homme, qui ne soit d'abord conçu par l'esprit et exécuté sous sa direction constante."
                                            },
                                            {
                                                "example_id": "5e5a577d-2b50-41a0-8a89-38daaeb4dfb2",
                                                "sense_id": "585de548-32df-300f-9f74-6a60f1ef8db1",
                                                "text": "Sur la maîtrise du mode manuel de la boîte, il précise « je ne pense pas qu’il connaissait, parce que ce sont des fonctionnalités que je n’utilise jamais. Je conduis toujours en tout automatique et je n’utilise jamais la conduite en mode manuel. Donc du coup je n’ai pas parlé de ces options de conduite au conducteur lors de sa formation ». Pendant sa formation, il confirme que le conducteur accidenté n’a pas eu à basculer la boîte automatique en mode manuel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "854b6e6c-4a8a-31f3-95eb-f69443942536",
                                        "entry_id": "239f1279-4ea3-3153-9e66-f225355668c3",
                                        "glosses": [
                                            "Livre de référence sur un thème donné."
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a003b36-8b75-4ac0-91fa-94ca662f2caf",
                                                "sense_id": "854b6e6c-4a8a-31f3-95eb-f69443942536",
                                                "text": "Différents cabinets de conseil proposent de tels services ou supports d'application tels que par exemple le manuel des achats durables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3e3cdfa-4033-3fba-aa2f-40454f92e5db",
                                        "entry_id": "239f1279-4ea3-3153-9e66-f225355668c3",
                                        "glosses": [
                                            "Livre de référence scientifique (sciences exactes ou humaines)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "397501e4-1385-4a12-a387-c5e85d7f2813",
                                                "sense_id": "b3e3cdfa-4033-3fba-aa2f-40454f92e5db",
                                                "text": "[…] ; je me souviens d'avoir lu autrefois, dans un manuel de Paul Bert, que le principe fondamental de la morale s’appuie sur les enseigne­ments de Zoroastre et sur la Constitution de l'an III ; […]."
                                            },
                                            {
                                                "example_id": "7e8354d3-c7d4-4845-b3a5-dfdeeef70e52",
                                                "sense_id": "b3e3cdfa-4033-3fba-aa2f-40454f92e5db",
                                                "text": "Les manuels de géographie nous disent que cette région est une gâtine – très précisément la gâtine de Loches et de Montrésor - terme qui signifiait « désert » en vieux français et « terre marécageuse, imperméable et stérile » dans les dictionnaires actuels."
                                            },
                                            {
                                                "example_id": "985c3531-bd53-414a-ada3-58265f9f7f35",
                                                "sense_id": "b3e3cdfa-4033-3fba-aa2f-40454f92e5db",
                                                "text": "Les historiens des sciences spécialistes de la régulation des substances toxiques ont, dans leurs manuels, de nombreuses situations montrant les dangers considérables d’une telle opacité. L’histoire fourmille d’exemples, l’actualité aussi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f333907-03c0-34dd-8821-0e1d031175c6",
                                        "entry_id": "239f1279-4ea3-3153-9e66-f225355668c3",
                                        "glosses": [
                                            "Livre destiné à l’apprentissage d’un métier ou de toute activité."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c8a21c4-909d-4c43-b19e-8f93e04ab37b",
                                                "sense_id": "8f333907-03c0-34dd-8821-0e1d031175c6",
                                                "text": "L'usage de la tétine, encore appelée sucette, a toujours été un objet de polémique. […]. Si la tétine est aujourd'hui très répandue, son utilisation n'a donné lieu qu'à très peu d'écrits dans les manuels de puériculture ou dans les ouvrages de psychologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c439f85-f586-3b8f-88e9-296652b62119",
                                        "entry_id": "239f1279-4ea3-3153-9e66-f225355668c3",
                                        "glosses": [
                                            "Livre destiné à l’apprentissage d’une matière scolaire : manuel scolaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3a86f9-43d8-475b-a08a-d591270b0b02",
                                                "sense_id": "6c439f85-f586-3b8f-88e9-296652b62119",
                                                "text": "Ici le but n'est pas forcément l’accumulation de connaissances, mais plutôt l’initiation à la résolution de problèmes et l’éveil de la curiosité de l’élève, celui-ci étant en général confronté à une situation concrète, en autonomie, à partir de supports variés (manuels, expériences menées en classe ou à la maison, documents audio-vidéo, logiciels, animations interactives, etc.)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd0e140-48d6-35a6-a5d7-7ba1c2b9d10f",
                                        "entry_id": "239f1279-4ea3-3153-9e66-f225355668c3",
                                        "glosses": [
                                            "Livre de référence pour un appareil, une machine, voire un logiciel : manuel d’utilisation, d’entretien ou de maintenance."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f296ba5-03be-465d-acd0-3d0b368900ee",
                                                "sense_id": "dcd0e140-48d6-35a6-a5d7-7ba1c2b9d10f",
                                                "text": "La signification de l’erreur liée à cette série de bips est précisée dans le manuel de la carte mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
