        "fr-extract.jsonl": [
            {
                "entry_id": "b59df493-39e9-31c3-b67b-7c00e6e8878b",
                "word": "débilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "abaf5319-f23c-43cb-9de5-a11295e0457c",
                        "entry_id": "b59df493-39e9-31c3-b67b-7c00e6e8878b",
                        "tags": [
                            "plural"
                        ],
                        "form": "débilités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fbeb2e0-7103-3adc-8356-caacf9a3767c",
                        "entry_id": "b59df493-39e9-31c3-b67b-7c00e6e8878b",
                        "glosses": [
                            "État de celui, de ce qui est débile, faible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83354e0c-28a3-4065-a020-972c0553ed1e",
                                "sense_id": "9fbeb2e0-7103-3adc-8356-caacf9a3767c",
                                "text": "Une grande débilité de nerfs, de jambes, d’estomac…"
                            },
                            {
                                "example_id": "cfc8d4fa-de5d-4a5f-bc38-1dbe73c8c71d",
                                "sense_id": "9fbeb2e0-7103-3adc-8356-caacf9a3767c",
                                "text": "Ce sont ces pauvres femmes que je plains, obligées, malgré la débilité de leur sexe, à supporter des fatigues et des privations comme routiers en campagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "313fc5fc-25ac-3934-890e-264c317b5bde",
                        "entry_id": "b59df493-39e9-31c3-b67b-7c00e6e8878b",
                        "glosses": [
                            "Misère physiologique qui se mesure par différents tests faisant appel aux différentes facultés intellectuelles dont le test du quotient intellectuel, le Q I."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4891298a-496c-4b6d-9443-84c41c42d8a8",
                                "sense_id": "313fc5fc-25ac-3934-890e-264c317b5bde",
                                "text": "Être atteint de débilité mentale."
                            },
                            {
                                "example_id": "c39c75d9-0e5c-4c6d-a7e4-be7d23275fed",
                                "sense_id": "313fc5fc-25ac-3934-890e-264c317b5bde",
                                "text": "On pourrait dire, par exemple,que ce sont là des cas de paranoïa aiguë à délire asystématique, en raison d’une débilité mentale native, profonde et, pour la même raison, aboutissant exceptionnellement à une démence rapide."
                            },
                            {
                                "example_id": "68f450da-f914-454e-9761-7cf395dc5006",
                                "sense_id": "313fc5fc-25ac-3934-890e-264c317b5bde",
                                "text": "Présenter une débilité congénitale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e00570f-bf3f-45eb-96a7-7c7a84e4ceba",
                        "source_entry_id": "b59df493-39e9-31c3-b67b-7c00e6e8878b",
                        "target_lang_word": "debility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a2ce44e-3009-388e-9ec8-ef2069bfc4d1",
                                        "entry_id": "97007f8e-0c2d-39f1-bbf5-3b819d34af29",
                                        "glosses": [
                                            "A state of physical or mental weakness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7679dae9-ced0-4fcd-8e0a-7b1dcc45fe7d",
                                                "sense_id": "1a2ce44e-3009-388e-9ec8-ef2069bfc4d1",
                                                "text": "As I was in a state of extreme debility, I resolved to sail directly towards the town, as a place where I could most easily procure nourishment.\n[…]\nI was ready to sink from fatigue and hunger, but being surrounded by a crowd, I thought it politic to rouse all my strength, that no physical debility might be construed into apprehension or conscious guilt."
                                            },
                                            {
                                                "example_id": "37f851db-8bd9-483d-897a-cc8d1abf04cd",
                                                "sense_id": "1a2ce44e-3009-388e-9ec8-ef2069bfc4d1",
                                                "text": "I was struck besides with the shocking expression of his face, with his remarkable combination of great muscular activity and great apparent debility of constitution"
                                            },
                                            {
                                                "example_id": "ba17387b-12e9-451a-96ee-b4361c92957d",
                                                "sense_id": "1a2ce44e-3009-388e-9ec8-ef2069bfc4d1",
                                                "text": "At the mention of money Mrs Dibble was overcome with great debility, and wheezed, \"I don't feel up to talking about money, matters just now, dearie. I think I better have a bit of a doze.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "046b23ad-c26f-41e7-8fbe-546701731ee7",
                        "source_entry_id": "b59df493-39e9-31c3-b67b-7c00e6e8878b",
