                "senses": [
                    {
                        "sense_id": "45caa5c3-f16e-3c58-a2d4-910f0b2486eb",
                        "entry_id": "d78ab86c-67ab-3eae-b32e-8f7196eacdb9",
                        "glosses": [
                            "уменьш.-ласк. к папа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f304379b-9de5-4ef6-be57-d3361785ea26",
                                "sense_id": "45caa5c3-f16e-3c58-a2d4-910f0b2486eb",
                                "text": "Ты мой лаковый, добрый и любимый папуля."
                            },
                            {
                                "example_id": "aad782b3-4314-4def-9226-6e9b27a1c47c",
                                "sense_id": "45caa5c3-f16e-3c58-a2d4-910f0b2486eb",
                                "text": "Папуля, купи мне эту игрушку?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13317410-2c46-44b8-974c-5371e288086f",
                        "source_entry_id": "d78ab86c-67ab-3eae-b32e-8f7196eacdb9",
                        "source_sense_id": "45caa5c3-f16e-3c58-a2d4-910f0b2486eb",
                        "target_lang_word": "Papi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "447a5a3a-afc4-37f6-8a71-963abf1bfa4d",
                                        "entry_id": "66706e2a-581a-36a9-a63c-fa58b940c6ba",
                                        "glosses": [
                                            "Koseform von Papa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "712b6de4-b100-41ce-8a92-05ee5f941ba1",
                                                "sense_id": "447a5a3a-afc4-37f6-8a71-963abf1bfa4d",
                                                "text": "Papi, kommst du bitte mal."
                                            },
                                            {
                                                "example_id": "862b0b7f-443e-4748-ac9e-11f9d1639abf",
                                                "sense_id": "447a5a3a-afc4-37f6-8a71-963abf1bfa4d",
                                                "text": "Mein Papi steht morgens ungern auf."
                                            },
                                            {
                                                "example_id": "b06c4afb-9885-44e1-9908-28b965eac121",
                                                "sense_id": "447a5a3a-afc4-37f6-8a71-963abf1bfa4d",
                                                "text": "Der Papi nannte sich bei Hans-Jürgen „Vati“."
                                            },
                                            {
                                                "example_id": "d78cc35b-398a-425e-b498-d0e25bcb4bba",
                                                "sense_id": "447a5a3a-afc4-37f6-8a71-963abf1bfa4d",
                                                "text": "„Ich bin der Hacker im System, ich schleich mich in die NATO ein, ich könnte auch ein Russe sein. Papi, schenk mir einen Computer! Hilfe für die ganze Familie! Liebling, nimm die Rüstungsspirale! Tanz den Gummitwist!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b16e8310-6322-454c-be0d-79edc5f87c8f",
                        "source_entry_id": "d78ab86c-67ab-3eae-b32e-8f7196eacdb9",
                        "source_sense_id": "45caa5c3-f16e-3c58-a2d4-910f0b2486eb",
                        "target_lang_word": "Vati",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vati",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60208b01-d477-3158-abf6-3a5bcc9965db",
                                        "entry_id": "9bd10de9-136e-3efc-b68d-a59f4ff6d905",
                                        "glosses": [
                                            "Koseform zu Vater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a2b48f1-9fce-47e4-82c7-a0e3147c038d",
                                                "sense_id": "60208b01-d477-3158-abf6-3a5bcc9965db",
                                                "text": "Ich liebe meinen Vati."
                                            },
                                            {
                                                "example_id": "522d0c2c-eb75-4697-971b-3efd50776a85",
                                                "sense_id": "60208b01-d477-3158-abf6-3a5bcc9965db",
                                                "text": "Aber Vati, man trinkt doch nicht so viel, hast du immer gesagt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4013f854-4f45-4eaa-be0a-916f04a66a93",
                        "source_entry_id": "d78ab86c-67ab-3eae-b32e-8f7196eacdb9",
                        "source_sense_id": "45caa5c3-f16e-3c58-a2d4-910f0b2486eb",
                        "target_lang_word": "papounet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papounet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eface698-d1ef-3be8-a67f-bcd38f407d05",
                                        "entry_id": "e54d068c-d0ed-39ca-9703-0258731a1b93",
                                        "glosses": [
                                            "Diminutif affectueux de papa."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e3b78c-a617-4c60-b8c8-1d4615509b29",
                                                "sense_id": "eface698-d1ef-3be8-a67f-bcd38f407d05",
                                                "text": "Mon papounet, c’est le plus gentil des papounets de la terre ! C’est mon papa."
                                            },
                                            {
                                                "example_id": "9647abbc-683c-4560-8f38-72e8fb586c68",
                                                "sense_id": "eface698-d1ef-3be8-a67f-bcd38f407d05",
                                                "text": "Bon, que fait-on à présent mon Papounet ? On vide l'eau du bénitier pour agacer la grenouille ? On attrape une à une les bestioles paniquées par le coup de pied dans leur fourmilière pour les faire parler ?"
                                            },
                                            {
                                                "example_id": "13e51c8d-f37e-43d0-b08f-f0070cc47900",
                                                "sense_id": "eface698-d1ef-3be8-a67f-bcd38f407d05",
                                                "text": "As-tu pris tes médicaments, mon papounet ? demanda-t-elle sévèrement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
