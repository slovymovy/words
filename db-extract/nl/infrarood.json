                "senses": [
                    {
                        "sense_id": "e54c711a-6889-3df4-84e2-e973fc4ce67d",
                        "entry_id": "492cc350-2584-3626-9f65-6f1fc1980402",
                        "glosses": [
                            "betrekking hebbend op het golflengtegebied tussen 780 nm en ca. 1 mm van het elektromagnetische spectrum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c72482-586c-4030-927f-f5024cf6c7e0",
                                "sense_id": "e54c711a-6889-3df4-84e2-e973fc4ce67d",
                                "text": "Infrarode straling wordt minder verstrooid door nevel dan straling in het zichtbare gebied."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "297aa3cc-c2ab-4f89-8a76-b14a567e0cd2",
                        "source_entry_id": "492cc350-2584-3626-9f65-6f1fc1980402",
                        "source_sense_id": "e54c711a-6889-3df4-84e2-e973fc4ce67d",
                        "target_lang_word": "infrarot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infrarot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "807f55a9-1fd8-3e45-ac4e-0adc6dd53620",
                                        "entry_id": "7a1c7bb1-e02e-360a-a53a-f70a3ee530d6",
                                        "glosses": [
                                            "zum Bereich des Infrarots gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b1f25b-e811-4c23-8808-9549e2a880f6",
                                                "sense_id": "807f55a9-1fd8-3e45-ac4e-0adc6dd53620",
                                                "text": "„Die infrarote Wärmestrahlung dringt nur wenige Millimeter tief ins Gewebe ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0201af7b-2e01-4bc5-af00-4ed4983979aa",
                        "source_entry_id": "492cc350-2584-3626-9f65-6f1fc1980402",
                        "source_sense_id": "e54c711a-6889-3df4-84e2-e973fc4ce67d",
                        "target_lang_word": "infrared",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infrared",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c622172-1779-31d3-a35b-42bac5ed3d13",
                                        "entry_id": "bfaf2395-0c28-3ef0-806a-6b3e44529e59",
                                        "glosses": [
                                            "The electromagnetic radiation of a wavelength longer than visible light, but shorter than microwave radiation, having a wavelength between 700 nm and 1 mm."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7255c23a-6287-4ae7-9a61-d7fa0cf5d794",
                                                "sense_id": "1c622172-1779-31d3-a35b-42bac5ed3d13",
                                                "text": "Collisions of these 'transparent' molecules with the molecules that do have absorption bands in the infrared can have a considerable influence on the intensities of the observed absorption bands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b86816b1-bd17-3eb6-8c07-4d9ed9ac16e7",
                                        "entry_id": "bfaf2395-0c28-3ef0-806a-6b3e44529e59",
                                        "glosses": [
                                            "A specific wavelength in this range."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad76d95a-bacb-4fa5-ac70-1bfe10cfc4f1",
                                                "sense_id": "b86816b1-bd17-3eb6-8c07-4d9ed9ac16e7",
                                                "text": "Sonne has shown that by means of the luminous rays the temperature in the tissue may be raised to a higher degree than by the use of the infrareds."
                                            },
                                            {
                                                "example_id": "d42f9796-4650-4173-8b31-f9e25b65029e",
                                                "sense_id": "b86816b1-bd17-3eb6-8c07-4d9ed9ac16e7",
                                                "text": "Exposure of spectral pieces at centimeters, millimeters, and infrareds, which provide a top steadiness of the dependence \"MCW radiation vs. parameter Δt\" and its interannual (seasonal) dynamics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0146ab6-7ca9-32ed-ba32-3fb6a1d13b24",
                                        "entry_id": "bfaf2395-0c28-3ef0-806a-6b3e44529e59",
                                        "glosses": [
                                            "A device that emits infrared radiation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d292b8bc-8ddb-40fc-ae9a-72c56954e302",
                                                "sense_id": "a0146ab6-7ca9-32ed-ba32-3fb6a1d13b24",
                                                "text": "In his room, he could install his infrareds without being discovered."
                                            },
                                            {
                                                "example_id": "a882cc43-2b97-4b97-a75c-731226dd7edc",
                                                "sense_id": "a0146ab6-7ca9-32ed-ba32-3fb6a1d13b24",
                                                "text": "Beams are the active counterparts of passive infrareds (PIRs). Since these are active infrareds, they require two parts: a transmitter and a receiver."
                                            },
                                            {
                                                "example_id": "73ac81c0-baa3-42db-891a-8e5a45ff66d7",
                                                "sense_id": "a0146ab6-7ca9-32ed-ba32-3fb6a1d13b24",
                                                "text": "Additionally, infrareds tend to cook food faster so there's less time to render said fat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "infrared",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67ac845d-d7b7-3617-a011-37cb319eef3d",
                                        "entry_id": "bca1f7c0-7516-3ffb-8928-7e5c20d00557",
                                        "glosses": [
                                            "Having a wavelength in the infrared spectrum."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "635bf8a6-aca3-3c44-9b2b-9a8a355bbc26",
                                        "entry_id": "bca1f7c0-7516-3ffb-8928-7e5c20d00557",
                                        "glosses": [
                                            "Relating to very low energies or very large distances or time spans."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f140eeba-2107-43bd-a75b-10c3e6e0407b",
                                                "sense_id": "635bf8a6-aca3-3c44-9b2b-9a8a355bbc26",
                                                "text": "Unless otherwise stated, we will be working in Euclidean space compactified to a sphere in order to avoid infrared problems."
                                            },
                                            {
                                                "example_id": "5acbb2ab-06f6-431c-a344-8563e6a78b00",
                                                "sense_id": "635bf8a6-aca3-3c44-9b2b-9a8a355bbc26",
                                                "text": "Secondly, as stated already by Osborne & Provenzale, pure k^(-α)-behaviour is impossible since there would have to be infinite power at zero frequency (this would correspond to an infrared catastrophe)."
                                            },
                                            {
                                                "example_id": "c682f2db-13b7-448b-b960-e248a19ba335",
                                                "sense_id": "635bf8a6-aca3-3c44-9b2b-9a8a355bbc26",
                                                "text": "Although infrared divergences are of long-distance nature, they often play an essential role in the verification of the validity of the perturbative treatment of short-distance phenomena."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d39c949-ce7a-4bcc-b010-b7faaa0de0db",
