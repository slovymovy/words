                ],
                "senses": [
                    {
                        "sense_id": "b61a5467-8b3e-3e27-b7ea-cc4cfc8af4dd",
                        "entry_id": "af4dab46-11ce-39ad-ae7f-7f3c4afffeaa",
                        "glosses": [
                            "Person, die sich wissenschaftlich mit Sprache/Sprachen befasst, die sich der Sprachforschung widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b9cb32-1c39-4a15-960a-c1e66d0ebf89",
                                "sense_id": "b61a5467-8b3e-3e27-b7ea-cc4cfc8af4dd",
                                "text": "„Die Deutsche Forschungsgemeinschaft (DFG) unterstützt eine Gruppe Mannheimer Sprachforscher mit mehr als zwei Millionen Mark.“"
                            },
                            {
                                "example_id": "c5a2aab5-aaa6-4520-b995-56a82c68f4c0",
                                "sense_id": "b61a5467-8b3e-3e27-b7ea-cc4cfc8af4dd",
                                "text": "„Die Vorstellungen über die Merkmale, die das Nationalwörterbuch haben sollte, gingen beim Verleger, der das große Publikum der wissenschaftlichen Laien im Auge hatte, und bei den Literatur- und Sprachforschern der historisch-etymologischen Richtung auseinander.“"
                            },
                            {
                                "example_id": "cf2d2a06-dfad-49b2-b5cb-2455181cccfd",
                                "sense_id": "b61a5467-8b3e-3e27-b7ea-cc4cfc8af4dd",
                                "text": "„Moderne Sprachforscher wie Peter von Polenz und Ulrich Schmitz sehen hingegen in den Medien »Antreiber für den Sprachwandel« und bewerten dies positiv.“"
                            },
                            {
                                "example_id": "75d6e018-3211-484e-939e-bf6d51ee70de",
                                "sense_id": "b61a5467-8b3e-3e27-b7ea-cc4cfc8af4dd",
                                "text": "„Wenn Sprachforscher das Gesagte in eine Schriftform bringen, müssen sie sich entscheiden, welches Wort wie klingt.“"
                            },
                            {
                                "example_id": "28f1f6b2-1c07-4051-9fcf-56b6dfbeb2cb",
                                "sense_id": "b61a5467-8b3e-3e27-b7ea-cc4cfc8af4dd",
                                "text": "„Und so lernte ich ohne Umschweife, bevor ich eigentlich aufwuchs und zur eigenen Vernunft kam, kommentarlos eine Menge von Reimen, die nicht einmal gelehrte Sprachforscher bis zum heutigen Tag zu ergründen vermögen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f14af4c7-2966-4ed8-af29-c33a3b89afed",
                        "source_entry_id": "af4dab46-11ce-39ad-ae7f-7f3c4afffeaa",
                        "source_sense_id": "b61a5467-8b3e-3e27-b7ea-cc4cfc8af4dd",
                        "source_sense_description": "Person, die sich wissenschaftlich mit Sprache/Sprachen befasst, die sich der Sprachforschung widmet",
                        "target_lang_word": "linguist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7e8b132-d66f-36c6-87b4-dd8791cb8abb",
                                        "entry_id": "d9fada07-48c0-32a8-af0c-fa98061672df",
                                        "glosses": [
                                            "One who studies linguistics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b62db118-d369-3d56-9a6a-d3a6ae5facea",
                                        "entry_id": "d9fada07-48c0-32a8-af0c-fa98061672df",
                                        "glosses": [
                                            "One who studies linguistics.",
                                            "One who studies modern-day linguistics, that is, linguistic science."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c88ea51d-17d7-41c5-a40e-a4fe1604e1db",
                                                "sense_id": "b62db118-d369-3d56-9a6a-d3a6ae5facea",
                                                "text": "President Donald Trump has \"turned words into weapons\" -- and journalists are providing additional ammunition.\nThat's according to Trump critic George Lakoff, a renowned linguist and professor emeritus at the University of California at Berkeley."
                                            },
                                            {
                                                "example_id": "be9080ce-95d0-45cf-847b-e06d3bbfcae4",
                                                "sense_id": "b62db118-d369-3d56-9a6a-d3a6ae5facea",
                                                "text": "The internet serves as an accelerant to fanilects. Because song lyrics are readily available online, they have a characteristic linguists call \"persistence,\" meaning anyone can refer to them and reuse them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e8590fd-b9ec-34b7-8937-b1ade7b33d99",
                                        "entry_id": "d9fada07-48c0-32a8-af0c-fa98061672df",
                                        "glosses": [
                                            "A person skilled in languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7e05f8-dbf6-4c98-919f-d2eec26c8432",
                                                "sense_id": "4e8590fd-b9ec-34b7-8937-b1ade7b33d99",
                                                "text": "The words of these songs were either without meaning, or derived from an idiom with which Watt, a very fair linguist, had no acquaintance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa8c2ce-fd61-387a-848e-db093c77f272",
                                        "entry_id": "d9fada07-48c0-32a8-af0c-fa98061672df",
                                        "glosses": [
                                            "A human translator; an interpreter, especially in the armed forces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
