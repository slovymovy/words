                            {
                                "example_id": "6aeba185-74c1-4ca6-bb21-98109965c35c",
                                "sense_id": "78b61b6d-8df4-3ea3-9c88-bb9f024c3d87",
                                "text": "Do Żanety zaczął dostawiać się jakiś businessman i Waldek mu lutnął."
