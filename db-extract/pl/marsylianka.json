                    },
                    {
                        "translation_id": "c0b5acc9-7a1f-4f62-afe2-16ea9ba4c771",
                        "source_entry_id": "1c782892-2056-3c9d-9233-47631ee4eb50",
                        "source_sense_id": "e83e8c2f-d6d6-3ab4-8ef0-9f0f7e1b8724",
                        "target_lang_word": "La Marseillaise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "La Marseillaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba1a22d6-02e0-3980-8f01-97dafca4b431",
                                        "entry_id": "4f37bf5a-bdb9-3781-a592-decf4874f113",
                                        "glosses": [
                                            "Chant révolutionnaire et patriotique devenu l’hymne national français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2150cc0c-5344-4d24-bbd6-c004f8516664",
                                                "sense_id": "ba1a22d6-02e0-3980-8f01-97dafca4b431",
                                                "text": "24 août 44 – On chante La Marseillaise dans la rue, on applaudit, c’est le délire. Joie, joie ! Pleurs de joie !"
                                            },
                                            {
                                                "example_id": "1e6614be-d219-41e5-86cc-4458e6f3f019",
                                                "sense_id": "ba1a22d6-02e0-3980-8f01-97dafca4b431",
                                                "text": "Un joueur de l’équipe de France ne desserre pas les dents quand ses camarades chantent La Marseillaise. Il s’explique : « C’est parce que chanter La Marseillaise, ça m’émeut et ensuite je joue moins bien. »"
                                            },
                                            {
                                                "example_id": "f6bc39c5-568f-40f8-bf5e-fc8564354d5e",
                                                "sense_id": "ba1a22d6-02e0-3980-8f01-97dafca4b431",
                                                "text": "À la Libération, il m'a appris à chanter La Marseillaise en ajoutant à la fin « tas de cochons » pour rimer avec « sillon »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
