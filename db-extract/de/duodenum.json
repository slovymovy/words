                                    {
                                        "sense_id": "49736007-8b17-31e9-905e-e8fb1eea9618",
                                        "entry_id": "5bb496f4-426c-39ba-a458-c1ea4fa1edf5",
                                        "glosses": [
                                            "segmento dell'intestino tenue, che misura circa 25 cm, posizionato nella parte superiore dell'addome che unisce lo stomaco al digiuno, che riceve la bile dal dotto coledoco e il succo pancreatico dal condotto del pancreas, per emulsionare i grassi e scomporre proteine e zuccheri nei loro monomeri"
                                        ],
