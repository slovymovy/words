{
    "word_family": [
        "sacrificateur",
        "sacrificatoire",
        "sacrificiel",
        "sacrifier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e58ed64-3151-35e1-8a43-f64d26775386",
                    "sense_definition": "Renoncement volontaire ou privation imposée pour autrui, un idéal ou une cause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abnegation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents font souvent d'immenses <w>sacrifices</w> pour assurer un bel avenir à leurs enfants."
                        },
                        {
                            "text": "Elle a accepté de grands <w>sacrifices</w> professionnels pour s'occuper de son père malade."
                        }
                    ],
                    "synonyms": [
                        "abnégation",
                        "privation",
                        "renoncement"
                    ],
                    "antonyms": [
                        "égoïsme"
                    ],
                    "common_phrases": [
                        "faire des sacrifices",
                        "esprit de sacrifice",
                        "au prix de sacrifices"
                    ]
                },
                {
                    "sense_id": "2f7a9315-e2e4-3e80-bf57-91d9c477707c",
                    "sense_definition": "Offrande rituelle d'une victime ou de biens à une divinité pour lui rendre hommage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les prêtres de l'Antiquité offraient un <w>sacrifice</w> aux dieux avant chaque grande bataille."
                        },
                        {
                            "text": "La tribu accomplissait un <w>sacrifice</w> annuel pour apaiser la colère des esprits de la forêt."
                        }
                    ],
                    "synonyms": [
                        "immolation"
                    ],
                    "common_phrases": [
                        "offrir un sacrifice",
                        "sacrifice humain",
                        "sacrifice rituel"
                    ]
                },
                {
                    "sense_id": "8d8da863-ed2e-3207-9852-a301315656fb",
                    "sense_definition": "Concession pénible consentie dans une négociation ou pour préserver une entente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abnegation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chacune des deux parties a dû faire un lourd <w>sacrifice</w> pour trouver un compromis équitable."
                        },
                        {
                            "text": "Renoncer à cette clause contractuelle était un <w>sacrifice</w> nécessaire pour conclure la vente."
                        }
                    ],
                    "synonyms": [
                        "concession"
                    ],
                    "antonyms": [
                        "intransigeance"
                    ],
                    "common_phrases": [
                        "consentir un sacrifice"
                    ]
                },
                {
                    "sense_id": "8bfa240e-5df3-393a-88d0-27de8d3d887c",
                    "sense_definition": "Célébration du mystère eucharistique au cours de la liturgie catholique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles se recueillaient en silence pendant la célébration du saint <w>sacrifice</w> de la messe."
                        },
                        {
                            "text": "Le prêtre présenta le pain et le vin au moment le plus solennel du divin <w>sacrifice</w>."
                        }
                    ],
                    "synonyms": [
                        "eucharistie",
                        "messe"
                    ],
                    "common_phrases": [
                        "saint sacrifice",
                        "saint sacrifice de la messe"
                    ]
                }
            ]
        }
    ]
}