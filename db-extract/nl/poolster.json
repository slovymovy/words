            {
                "entry_id": "fdf47a0a-7800-3358-89b4-5ced08de0cc7",
                "word": "poolster",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a81a79f9-0913-44c3-8e63-2746a4639ecc",
                        "entry_id": "fdf47a0a-7800-3358-89b4-5ced08de0cc7",
                        "tags": [
                            "plural"
                        ],
                        "form": "poolsterren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f60c1466-56a7-36c2-bf89-636ff34f003f",
                        "entry_id": "fdf47a0a-7800-3358-89b4-5ced08de0cc7",
                        "glosses": [
                            "enige ster die in de loop van de geschiedenis dicht bij een van beide hemelpolen komt te liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08c033f8-3b5d-4c1d-930b-65e354abab62",
                                "sense_id": "f60c1466-56a7-36c2-bf89-636ff34f003f",
                                "text": "Wega, Thuban en Kocab zijn in het verleden poolsterren geweest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8449fc3-fb09-4707-809e-be9896fb1672",
                        "source_entry_id": "fdf47a0a-7800-3358-89b4-5ced08de0cc7",
                        "source_sense_id": "f60c1466-56a7-36c2-bf89-636ff34f003f",
                        "target_lang_word": "pole star",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pole star",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "889bf4f6-e7ba-3077-8a02-382e0fd2d6e2",
                                        "entry_id": "660c52a2-cc34-3693-95bc-9c18895b1a70",
                                        "glosses": [
                                            "The star visible to the naked eye which was in the past, is now, or will be in the future nearest a celestial pole of a planet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8d5e12-c940-4d14-aaa3-5568a904e7b1",
                                                "sense_id": "889bf4f6-e7ba-3077-8a02-382e0fd2d6e2",
                                                "text": "Polaris is currently the pole star of planet Earth."
                                            },
                                            {
                                                "example_id": "7190569b-3f8d-435c-ae3e-49da61be92fb",
                                                "sense_id": "889bf4f6-e7ba-3077-8a02-382e0fd2d6e2",
                                                "text": "Who can doubt that poetry will revive and lead in a new age, as the star in the constellation Harp, which now flames in our zenith, astronomers announce, shall one day be the pole-star for a thousand years?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df6260f5-6a20-386f-b087-feaff7173aa4",
                                        "entry_id": "660c52a2-cc34-3693-95bc-9c18895b1a70",
                                        "glosses": [
                                            "A person, principle, or thing which acts as a guide; a guiding light; also, something which attracts much attention; a centre of attention."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d9c838e-66d8-44a2-a97d-bbbfdef01f33",
                                                "sense_id": "df6260f5-6a20-386f-b087-feaff7173aa4",
                                                "text": "But it [our hotel] has one great advantage for a stranger, by being in the market place, and the next neighbour of the huge church of St. Nicholas: […] A better pole-star could scarcely be desired."
                                            },
                                            {
                                                "example_id": "791e19e5-af35-4ed1-a432-7e68ca94d4c8",
                                                "sense_id": "df6260f5-6a20-386f-b087-feaff7173aa4",
                                                "text": "Love was her pole-star. What was Jason's? Only the blankness of despair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1f442ca-fed8-453c-a291-83a0672f0b63",
                        "source_entry_id": "fdf47a0a-7800-3358-89b4-5ced08de0cc7",
                        "source_sense_id": "f60c1466-56a7-36c2-bf89-636ff34f003f",
                        "target_lang_word": "étoile polaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étoile polaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38b6fc73-37cb-3d51-b540-e1a52a0fa4ca",
                                        "entry_id": "eaabb7e4-7345-3f88-b0a7-a1a902feadca",
                                        "glosses": [
                                            "Étoile assez visible la plus proche du pôle céleste, très souvent du pôle Nord céleste. Comme les pôles célestes varient sur une période d’environ 25 800 ans par la précession des équinoxes, l’étoile polaire est amenée à changer. L’étoile polaire nord actuelle est α Ursae Minoris, soit Polaris, de la constellation de la Petite Ourse, utilisée pour trouver le nord depuis environ 2000 ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f023552-53ee-405c-a124-641657ab1942",
                                                "sense_id": "38b6fc73-37cb-3d51-b540-e1a52a0fa4ca",
                                                "text": "J’avais, l’avant-veille, aperçu pour la dernière fois l’étoile polaire, et je disais adieu, peut-être pour des années, à l’hémisphère septentrional."
                                            },
                                            {
                                                "example_id": "2b922470-495c-458b-8493-91012e5cf38d",
                                                "sense_id": "38b6fc73-37cb-3d51-b540-e1a52a0fa4ca",
                                                "text": "Autrefois, dit Rosenthal, j’étais très fort sur la cosmographie. Mais maintenant le cou sous la guillotine, vous ne me feriez pas dire où est l’étoile polaire..."
                                            },
                                            {
                                                "example_id": "cb0ec957-0f87-40e3-ad7a-594c8bdc95c6",
                                                "sense_id": "38b6fc73-37cb-3d51-b540-e1a52a0fa4ca",
                                                "text": "Ou je cherche la Polaire. J’ai lu qu’il y a plusieurs étoiles polaires, mais je ne peux pas m’habituer à la chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc134449-9600-3e37-93a8-99fa48d15aac",
                                        "entry_id": "eaabb7e4-7345-3f88-b0a7-a1a902feadca",
                                        "glosses": [
                                            "Personne ou chose servant de références, de guide."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b983a92-7d07-40e9-a877-7102e9e1b537",
                                                "sense_id": "bc134449-9600-3e37-93a8-99fa48d15aac",
                                                "text": "Cependant, après avoir erré au hasard pendant deux ou trois heures, nous aperçûmes une lumière bien loin, qui scintillait sous les branches comme un ver luisant ; nous en fîmes tout de suite notre étoile polaire, et nous nous dirigeâmes vers elle le plus directement possible, au risque de verser à chaque pas."
                                            },
                                            {
                                                "example_id": "536384bf-c5c3-4893-a9cb-b33c94d270de",
                                                "sense_id": "bc134449-9600-3e37-93a8-99fa48d15aac",
                                                "text": "Egon désemparé a au moins sa musique pour étoile polaire ; […]"
                                            },
                                            {
                                                "example_id": "1f5c7508-7b32-410d-bf8e-009dcfe04153",
                                                "sense_id": "bc134449-9600-3e37-93a8-99fa48d15aac",
                                                "text": "Ses expériences se cristallisaient toujours pour former les étoiles polaires d’une nouvelle pensée."
                                            },
                                            {
                                                "example_id": "8b093294-2ee0-49d7-af3e-72272a046895",
                                                "sense_id": "bc134449-9600-3e37-93a8-99fa48d15aac",
                                                "text": "Kertész a désigné Camus comme « une de ses deux étoiles polaires » avec Thomas Mann."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
