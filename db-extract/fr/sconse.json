                "senses": [
                    {
                        "sense_id": "d4066934-a3ec-31e2-b217-c46a4f37fc58",
                        "entry_id": "73802a47-c6c0-37ba-982c-40f785cc3049",
                        "glosses": [
                            "Nom commercial de la fourrure de la mouffette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d6bb88-ab11-4132-a7c5-00457f22273d",
                                "sense_id": "d4066934-a3ec-31e2-b217-c46a4f37fc58",
                                "text": "Le paquet contenait un somptueux manteau d’une fourrure que Pastor fut incapable d’identifier.\n – Un sconse, mon petit pote."
                            },
                            {
                                "example_id": "48d43979-59a9-490b-8d71-4a87cbb03c5a",
                                "sense_id": "d4066934-a3ec-31e2-b217-c46a4f37fc58",
                                "text": "Mais attention, ne transformez pas les sconses en manteaux !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b2e65409-1a3b-3485-b6c4-aba4772050f4",
                        "entry_id": "73802a47-c6c0-37ba-982c-40f785cc3049",
                        "glosses": [
                            "Mouffette elle-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "352cd7c4-6f51-432b-8f22-c0a6c57f92e0",
                                "sense_id": "b2e65409-1a3b-3485-b6c4-aba4772050f4",
                                "text": "Sauf que ce type puait comme un sconse ; quand on se trouvait dans la baraque réservée à l’état civil en tête à tête avec lui, c’était intenable."
                            },
                            {
                                "example_id": "64ba5de3-9f68-4ee3-a1af-0fb1f6cffee7",
                                "sense_id": "b2e65409-1a3b-3485-b6c4-aba4772050f4",
                                "text": "Ils ont beau se savonner les arpions pendant des heures, rien n’y fait, au bout de quinze secondes dans une paire de chaussures, ils se mettent à sentir le sconse."
                            },
                            {
                                "example_id": "814d591b-89f4-4567-b9f0-6098ea58b639",
                                "sense_id": "b2e65409-1a3b-3485-b6c4-aba4772050f4",
                                "text": "– C’est mon coq, et il veut pas rester seul à la maison, répondit Peach. Je l’ai trouvé au magasin. Les sconses vont l’avoir si je fais pas gaffe."
                            }
                        ]
                    }
                ],
