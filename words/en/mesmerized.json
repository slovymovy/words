{
    "word_family": [
        "mesmerize",
        "mesmerism",
        "mesmerist",
        "mesmeric"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d9ca55cb-35ca-30e4-a34b-012b36889e2f",
                    "sense_definition": "Feeling completely fascinated or captivated by something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fascinated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience was <w>mesmerized</w> by the beautiful performance on stage.",
                            "target_lang_translations": {
                                "nl": "Het publiek was <w>betoverd</w> door het prachtige optreden op het podium."
                            }
                        },
                        {
                            "text": "She stood <w>mesmerized</w> while watching the colorful sunset over the ocean.",
                            "target_lang_translations": {
                                "nl": "Ze stond <w>gehypnotiseerd</w> te kijken naar de kleurrijke zonsondergang boven de oceaan."
                            }
                        }
                    ],
                    "synonyms": [
                        "enthralled",
                        "spellbound",
                        "captivated",
                        "fascinated"
                    ],
                    "common_phrases": [
                        "completely mesmerized",
                        "totally mesmerized"
                    ],
                    "target_lang_definitions": {
                        "nl": "Volledig gefascineerd of in de ban van iets zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "betoverd",
                                "target_lang_sense_clarification": "geeft aan dat iemand volledig in de ban is van iets moois of indrukwekkends"
                            },
                            {
                                "target_lang_word": "gehypnotiseerd",
                                "target_lang_sense_clarification": "figuurlijk gebruikt om aan te geven dat iemand zijn aandacht niet van iets kan afhouden"
                            },
                            {
                                "target_lang_word": "geboeid",
                                "target_lang_sense_clarification": "geeft aan dat iemands aandacht volledig wordt vastgehouden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae25bb3d-61e8-3f3f-9219-a01f97e63be9",
                    "sense_definition": "In a state of hypnosis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hypnosis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient appeared <w>mesmerized</w> during the deep relaxation session.",
                            "target_lang_translations": {
                                "nl": "De patiënt leek <w>gehypnotiseerd</w> tijdens de sessie voor diepe ontspanning."
                            }
                        },
                        {
                            "text": "He seemed <w>mesmerized</w> as if he were under a powerful hypnotic spell.",
                            "target_lang_translations": {
                                "nl": "Hij leek <w>gehypnotiseerd</w> alsof hij onder een krachtige hypnotische spreuk stond."
                            }
                        }
                    ],
                    "synonyms": [
                        "hypnotized"
                    ],
                    "target_lang_definitions": {
                        "nl": "In een staat van hypnose verkerend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gehypnotiseerd",
                                "target_lang_sense_clarification": "letterlijke staat van hypnose"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ee7c585-7f7d-36ac-a404-c1308c04118b",
                    "sense_definition": "Simple past and past participle of <w>mesmerize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fascinated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician <w>mesmerized</w> the crowd with his incredible card tricks.",
                            "target_lang_translations": {
                                "nl": "De goochelaar <w>betoverde</w> het publiek met zijn ongelooflijke kaarttrucs."
                            }
                        },
                        {
                            "text": "The bright lights have <w>mesmerized</w> the children since they arrived.",
                            "target_lang_translations": {
                                "nl": "De felle lichten hebben de kinderen <w>gehypnotiseerd</w> sinds ze aankwamen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb mesmerize."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'betoveren' of 'hypnotiseren'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "betoverde",
                                "target_lang_sense_clarification": "verleden tijd van betoveren"
                            },
                            {
                                "target_lang_word": "gehypnotiseerd",
                                "target_lang_sense_clarification": "voltooid deelwoord van hypnotiseren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}