                                "example_id": "a294ebae-72d6-4aab-97ce-68c655dcf4f7",
                                "sense_id": "3c552478-25d5-3d8b-a089-48fa640d586c",
                                "text": "Il se trouve que les six dernières fois où on s’est parlé, la conversation s’est achevée par un silence interminable auquel j’ai mis un terme en disant quelque chose, avant d’ajouter autre chose, histoire de corriger ce qui précédait, puis je me suis excusée, puis désexcusée."
                            },
                            {
                                "example_id": "2364f0c9-6f6f-4852-8a75-2d73d13c26fc",
                                "sense_id": "3c552478-25d5-3d8b-a089-48fa640d586c",
                                "text": "Et moi, je me permets de nous désexcuser."
                            },
                            {
                                "example_id": "ca7f5dc8-498e-4806-ae84-7b8b9e466014",
                                "sense_id": "3c552478-25d5-3d8b-a089-48fa640d586c",
                                "text": "Parce que je me \"désexcuse\"."
                            },
                            {
                                "example_id": "252d77f6-238e-40be-87fa-d094d3693470",
                                "sense_id": "3c552478-25d5-3d8b-a089-48fa640d586c",
                                "text": "Je te trouve une excuse, ne te désexcuse pas !"
                            }
                        ]
                    }
