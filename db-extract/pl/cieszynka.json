    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e7b37639-b305-3698-877a-d8f77c5487a3",
                "word": "cieszynka",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7907d77e-0306-38a9-b61b-fdcedaca81e9",
                        "entry_id": "e7b37639-b305-3698-877a-d8f77c5487a3",
                        "glosses": [
                            "goal celebration"
                        ],
                        "tags": [
                            "colloquial",
                            "especially",
                            "feminine",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "f25c62e0-9ea0-49cd-9d73-68d8f42aa832",
                                "sense_id": "7907d77e-0306-38a9-b61b-fdcedaca81e9",
                                "text": "Jędza wykonał chyba najzabawniejszą „cieszynkę” w dziejach polskiej piłki – po tym, jak trafił do siatki, wskoczył na trybuny, usiadł między kibicami, a ci serdecznie go wyściskali.",
                                "translation": "Jędza displayed the most fun goal celebration in the history of Polish soccer - after he scored a goal, he jumped up onto the stands, sat down between the fans, and they excitedly hugged him.",
                                "english": "Jędza displayed the most fun goal celebration in the history of Polish soccer - after he scored a goal, he jumped up onto the stands, sat down between the fans, and they excitedly hugged him."
                            },
                            {
                                "example_id": "eb38ade7-a67e-48f9-847f-48700c67f7de",
                                "sense_id": "7907d77e-0306-38a9-b61b-fdcedaca81e9",
                                "text": "Przed którymś z meczów usłyszałem od nich: jeśli strzelisz, w ramach cieszynki będziesz symulował pływanie na plecach.",
                                "translation": "A game came round, and with it a dare from the lads: if you score, you've got to do a backstroke swimming celebration.",
                                "english": "A game came round, and with it a dare from the lads: if you score, you've got to do a backstroke swimming celebration."
                            },
                            {
                                "example_id": "9611acd9-541a-475b-9a5e-e17fee59dacc",
                                "sense_id": "7907d77e-0306-38a9-b61b-fdcedaca81e9",
                                "text": "Dziś niemal każdy czołowy napastnik świata ma opracowaną autorską cieszynkę.",
                                "translation": "Nowadays every head striker in the world has their own developed, authorial goal celebration.",
                                "english": "Nowadays every head striker in the world has their own developed, authorial goal celebration."
                            },
                            {
                                "example_id": "7e8552ef-4b14-4220-94f8-d5015bccf315",
                                "sense_id": "7907d77e-0306-38a9-b61b-fdcedaca81e9",
                                "text": "Wciąż się śmieję, gdy przypominam sobie tych policjantów naśladujących moją cieszynkę – wspomina rozbawiony Krzysztof Piątek.",
                                "translation": "\"I still laugh when I remember when those police officers imitated my goal celebration\" Krzysztof Piątek mentions delighted.",
                                "english": "\"I still laugh when I remember when those police officers imitated my goal celebration\" Krzysztof Piątek mentions delighted."
                            },
                            {
                                "example_id": "0660739d-a185-41dc-9cd1-11ed7fb8c009",
                                "sense_id": "7907d77e-0306-38a9-b61b-fdcedaca81e9",
                                "text": "By wykonać tę cieszynkę, wciśnij przycisk modyfikacji strzału finezyjnego i klawisz odpowiedzialny za podanie prostopadłe/szarżę bramkarza jednocześnie.",
                                "translation": "In order to perform this goal celebration, press the finesse shot modification button and the appropriate button for a perpendiciation/charge of the goalie at the same time.",
                                "english": "In order to perform this goal celebration, press the finesse shot modification button and the appropriate button for a perpendiciation/charge of the goalie at the same time."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
