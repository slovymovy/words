                "senses": [
                    {
                        "sense_id": "5f7831c1-6a6b-30db-bcab-27f25168d896",
                        "entry_id": "39223a1f-5472-3ac9-8456-bd351926015e",
                        "glosses": [
                            "brother’s"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a8799b6-75bf-46e2-aac0-7cb7265f1346",
                                "sense_id": "5f7831c1-6a6b-30db-bcab-27f25168d896",
                                "text": "Прие́хав в обе́д в дере́вню и оста́вив ло́шадь у прия́теля-старика́, му́жа бра́тниной корми́лицы, Лёвин вошёл к старику́ на пче́льник, жела́я узна́ть от него́ подро́бности об убо́рке поко́са.",
                                "translation": "Arriving for dinner at the village, and leaving his horse at the cottage of an old friend of his, the husband of his brother's wet-nurse, Levin went to see the old man in his bee-house, wanting to find out from him the truth about the hay.",
                                "english": "Arriving for dinner at the village, and leaving his horse at the cottage of an old friend of his, the husband of his brother's wet-nurse, Levin went to see the old man in his bee-house, wanting to find out from him the truth about the hay."
                            }
                        ]
                    }
                ],
