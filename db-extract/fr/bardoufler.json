                "senses": [
                    {
                        "sense_id": "4e89621a-f47e-301e-ab07-f079e6325ac0",
                        "entry_id": "296defa2-95ac-3aac-8bb7-a4350216d9d0",
                        "glosses": [
                            "Salir, barbouiller."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "9ea8731c-5b56-41c8-ae0c-262e27a8af63",
                                "sense_id": "4e89621a-f47e-301e-ab07-f079e6325ac0",
                                "text": "Curieux comme on classe les gens en fonction des délires spontanés de notre imagination : on les bardoufle de nos couleurs intérieures, de nos odeurs fantasmées."
                            },
                            {
                                "example_id": "a73ca0b1-2150-44ba-9c28-871f03dea5fe",
                                "sense_id": "4e89621a-f47e-301e-ab07-f079e6325ac0",
                                "text": "Avant de descendre dans son caveau, le financier-marquis a légué à la municipalité de Gênes un palais, le palais Brignolesale, dit il palazzo rosso, à cause de la couleur rouge-brique, assez laide, dont on l’a bardouflé du sol au faite, plus quinze millions pour agrandir le port."
                            }
                        ]
                    }
