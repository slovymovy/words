                    {
                        "sense_id": "2a1ec851-48bd-3d18-bdc8-fa823d009ee6",
                        "entry_id": "975aef14-f204-3d44-a237-0ab69b3727f7",
                        "glosses": [
                            "weibliche Person, die den Dienstgrad eines Majors innehat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ff8fdfd0-d00b-4291-84e0-ee7548fc1438",
                                "sense_id": "2a1ec851-48bd-3d18-bdc8-fa823d009ee6",
                                "text": "Die Majorin erhielt für Ihre Dienste eine Medaille."
                            },
                            {
                                "example_id": "da0c8e36-f36a-4137-86bc-b18371015dda",
                                "sense_id": "2a1ec851-48bd-3d18-bdc8-fa823d009ee6",
                                "text": "Von der Majorin wurde eine Truppenverlegung angeordnet."
                            },
                            {
                                "example_id": "fddcadda-357a-42c3-a4d9-909e87454737",
                                "sense_id": "2a1ec851-48bd-3d18-bdc8-fa823d009ee6",
                                "text": "Der General hat eine neue Majorin ernannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef0a7d0d-caea-3464-bf8e-19522ddb3ddd",
                        "entry_id": "975aef14-f204-3d44-a237-0ab69b3727f7",
                        "glosses": [
                            "weibliche Person, die in der Heilsarmee den Rang eines Majors innehat"
