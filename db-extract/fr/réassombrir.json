                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5e78f6-3651-4776-8ec7-19674f4ac024",
                                "sense_id": "451fec4b-7cac-3ed3-a3a2-0a6d8f7d44b1",
                                "text": "Lord Ewald, après un moment, regarda sa montre : son front s'était réassombri."
                            },
                            {
                                "example_id": "519f713c-bf76-453c-a155-acaabfea97df",
                                "sense_id": "451fec4b-7cac-3ed3-a3a2-0a6d8f7d44b1",
                                "text": "décomposant la lumière extérieure, ces verrières créaient, à l'intérieur, une ambiance tout à fait étrange et magique : quitte à réassombrir quelque peu les vastes vaisseaux que l'agrandissement des baies aurait permis d'éclairer davantage."
                            }
                        ]
                    }
