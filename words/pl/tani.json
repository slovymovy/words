                },
                {
                    "sense_id": "4edeaee5-e3f6-3413-81bd-3a61ab425e3e",
                    "sense_definition": "Taki, który spuścił z tonu, wycofał się lub stał się potulny.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy zobaczył dowody, szybko stał się <w>tani</w> i przestał krzyczeć.",
                            "target_lang_translations": {
                                "ru": "Увидев улики, он быстро <w>притих</w> и перестал кричать.",
                                "en": "When he saw the evidence, he quickly became <w>subdued</w> and stopped shouting.",
                                "de": "Als er die Beweise sah, wurde er schnell <w>kleinlaut</w> und hörte auf zu schreien."
                            }
                        },
                        {
                            "text": "Po tej reprymendzie od szefa wrócił do biurka zupełnie <w>tani</w>.",
                            "target_lang_translations": {
                                "ru": "После этого выговора от начальника он вернулся к столу совершенно <w>шёлковым</w>.",
                                "en": "After that reprimand from the boss, he returned to his desk completely <w>meek</w>.",
                                "de": "Nach dem Tadel vom Chef kehrte er ganz <w>zahm</w> an seinen Schreibtisch zurück."
                            }
                        }
                    ],
                    "traits": [
