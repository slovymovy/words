                "senses": [
                    {
                        "sense_id": "0fa5f1c1-f9fc-3900-870f-c6f1877fd166",
                        "entry_id": "92c95293-c58d-3e76-a578-2fc6c3000151",
                        "glosses": [
                            "„Vorgesetzter, der in Unternehmen oder der öffentlichen Verwaltung die Dienstaufsicht über Mitarbeiter, Beamte und Dienstkräfte oder bei der Bundeswehr die Disziplinarbefugnis über Soldaten ausübt“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c8291ea-e87a-4b4a-8edf-72bb2e5a1dad",
                                "sense_id": "0fa5f1c1-f9fc-3900-870f-c6f1877fd166",
                                "text": "„Zur Einhaltung von Sicherheitsbestimmungen und bei bestimmten Diensten - zum Beispiel Gefechtsausbildung und Teilnahme an Einsätzen - kann der Disziplinarvorgesetzte bei langen Haaren das Tragen eines Haarnetzes befehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
