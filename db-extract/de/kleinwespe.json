                ],
                "senses": [
                    {
                        "sense_id": "e3560a82-a32b-3a4d-9a01-64a260bb6b04",
                        "entry_id": "296696bd-d5fb-313c-827c-ec52904fbab3",
                        "glosses": [
                            "umgangssprachliche, zusammenfassende Bezeichnung von kleineren Formen wespenartig aussehender Vertreter verschiedener Familien der Hautflügler"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f18b2a39-aa31-461e-b800-af0aa2e27cbd",
                                "sense_id": "e3560a82-a32b-3a4d-9a01-64a260bb6b04",
                                "text": "„Nach der Austrocknung sind die Kleinwespen für Jahrzehnte haltbar, […]“"
                            },
                            {
                                "example_id": "c00b322a-d2de-4535-8ce6-ca106a9091bf",
                                "sense_id": "e3560a82-a32b-3a4d-9a01-64a260bb6b04",
                                "text": "„Mit Insektiziden ist er äußerst schwer zu bekämpfen. In letzter Zeit legt man verstärktes Augenmerk in die Anwendung von natürlichen Feinden, wie einer Kleinwespe (Apantele flavipes; Hymenoptera: Braconidae) und Fliegen (Metagonistylum minense und Paratheresia claripalpis); […]“"
                            },
                            {
                                "example_id": "d5d2383d-d77e-4662-b3ef-e2c7344d2e6c",
                                "sense_id": "e3560a82-a32b-3a4d-9a01-64a260bb6b04",
                                "text": "„Der Wirt der in Spanien beschriebenen Kleinwespe (Meboet, 1921) war bisher nicht bekannt.“"
                            },
                            {
                                "example_id": "1d8c6cb7-2587-4374-8048-c5c24e4576cd",
                                "sense_id": "e3560a82-a32b-3a4d-9a01-64a260bb6b04",
                                "text": "„Die vollentwickelten Kleinwespen schlüpfen aus den Puparien der Wirtstiere.“"
                            },
                            {
                                "example_id": "3e92786a-071a-46da-8188-c6ce69a1439d",
                                "sense_id": "e3560a82-a32b-3a4d-9a01-64a260bb6b04",
                                "text": "„Nun gereicht aber der Honigtau auch vielen andern Insekten, darunter vorzüglich Nützlingen, wie schmarotzenden Kleinwespen, ganz besonders aber der Honigbiene und damit auch dem Imker, zu großem Nutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
