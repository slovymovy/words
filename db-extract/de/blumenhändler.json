                                    {
                                        "sense_id": "c24b98cc-aeb4-3f7f-a828-52720bc7be22",
                                        "entry_id": "d621fbdf-3d7a-300d-8019-51f8b04bfa00",
                                        "glosses": [
                                            "A florist's shop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f52bd0b-1f02-4301-8f24-b8e8781d9d27",
                                                "sense_id": "c24b98cc-aeb4-3f7f-a828-52720bc7be22",
                                                "text": "“After the gown, we can go to the florist, then stop by the lingerie store.”"
                                            }
                                        ]
                                    }
                                ]
