                "translations": [
                    {
                        "translation_id": "b33c77b5-5e07-466c-8132-0c09f7f37f9f",
                        "source_entry_id": "086ed03a-0a93-35dd-929a-8445cb68d292",
                        "source_sense_id": "090dc2eb-0739-341d-8717-90619ee8c904",
                        "source_sense_description": "Medizin: Geschlechtskrankheit",
                        "target_lang_word": "Geschlechtskrankheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschlechtskrankheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6d3c268-e03d-347d-b718-a1329f6643f5",
                                        "entry_id": "bad86403-f371-336c-bac3-6677a5c62524",
                                        "glosses": [
                                            "sexuell übertragbare Infektionskrankheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9e14ec-0aa6-41b3-bfd3-fa890db88c0f",
                                                "sense_id": "e6d3c268-e03d-347d-b718-a1329f6643f5",
                                                "text": "„Ein Venerologe ist ein Facharzt für Behandlung von Geschlechtskrankheiten.“"
                                            },
                                            {
                                                "example_id": "9e96943d-5711-4204-b366-6df206344417",
                                                "sense_id": "e6d3c268-e03d-347d-b718-a1329f6643f5",
                                                "text": "„Bei einem Viertel der festgenommenen Geheimprostituierten in Wien haben die Gesundheitsbehörden im Jahre 2002 Mehrfachinfektionen durch Geschlechtskrankheiten festgestellt.“"
                                            },
                                            {
                                                "example_id": "2f43c6aa-0d20-4f34-a1a2-60fa3e2039c1",
                                                "sense_id": "e6d3c268-e03d-347d-b718-a1329f6643f5",
                                                "text": "„Gewöhnlich gipfelte die Auseinandersetzung darin, daß Alf die Mutter seiner Frau der Hurerei in jungen Jahren bezichtigte, indes Recha ihm triumphierend die Geschlechtskrankheit seiner Eltern an den Kopf warf.“"
                                            },
                                            {
                                                "example_id": "9313a62b-40a4-4784-aa7c-b83d31a457eb",
                                                "sense_id": "e6d3c268-e03d-347d-b718-a1329f6643f5",
                                                "text": "„Als hätte man mir eine Eisenkugel vom Bein genommen, stürzte ich mich deshalb nach der Heilung von meinem Liebesleid und der Heilung von meiner kleinen, gemeinen Geschlechtskrankheit in die Recherche.“"
                                            },
                                            {
                                                "example_id": "41d6ebae-9921-4886-8780-33c823d939ce",
                                                "sense_id": "e6d3c268-e03d-347d-b718-a1329f6643f5",
                                                "text": "„Ich fand ihn im Elend, an allen Gliedern durch eine Geschlechtskrankheit gelähmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
