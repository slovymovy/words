                        "entry_id": "0b602a21-affc-31ae-ab46-a4e1d3827e34",
                        "glosses": [
                            "An annual festival of light, observed during several days in October and November."
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": [
                            {
                                "example_id": "a1c04b07-6569-4a2d-a64a-bb82f1185f47",
                                "sense_id": "694b240a-3ebd-3e3f-880d-f4d41faf1ff3",
                                "text": "Around one billion people worldwide and across the U.S. will celebrate Diwali this week."
                            },
                            {
                                "example_id": "ca6e2a35-b5d3-49e8-86c9-c19e45ee5099",
                                "sense_id": "694b240a-3ebd-3e3f-880d-f4d41faf1ff3",
                                "text": "While Diwali is a major religious festival for Hindus, it is also observed by Sikhs, Jains and Buddhists."
                            }
                        ]
                    }
