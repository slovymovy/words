                                "sense_id": "dca48a49-fafd-321b-a0fe-d3415f5d466d",
                                "text": "„Der Luzerner Kunsthistoriker Josef Helfenstein übernimmt ab September 2016 die Leitung des Kunstmuseums Basel.“"
                            },
                            {
                                "example_id": "b07fced2-f4ed-4b04-837f-2d903662ca49",
                                "sense_id": "dca48a49-fafd-321b-a0fe-d3415f5d466d",
                                "text": "„Der Kunsthistoriker und Kunsthändler Hildebrand Gurlitt hatte nach dem Krieg in Düsseldorf eine Galerie und war dort 1948 Leiter des Kunstvereins für die Rheinlande und Westfalen geworden.“"
                            }
                        ],
