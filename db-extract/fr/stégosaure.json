                    },
                    {
                        "translation_id": "90a1dabd-4bb1-44bc-ad45-47ba75891d5f",
                        "source_entry_id": "754e00d6-ca3b-31da-b7eb-33a4a7147ee1",
                        "source_sense_id": "8b34d7e8-f6a4-3193-9d64-7f9388b5af00",
                        "target_lang_word": "stegosaurus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stegosaurus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f521ba4-fae1-373a-b7d9-74995ddbff4c",
                                        "entry_id": "0a410944-c6db-3e90-aa72-6b1f96e6dd76",
                                        "glosses": [
                                            "Stegosaurus dinosaurus met grote rugplaten"
                                        ],
                                        "tags": [
                                            "reptielen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cd4c7f5-eac2-4413-955b-520991d97091",
                                                "sense_id": "8f521ba4-fae1-373a-b7d9-74995ddbff4c",
                                                "text": "„Wist je dat de stegosaurus, een beest zo groot als een flinke olifant, hersens had ter grootte van een walnoot?”"
                                            },
                                            {
                                                "example_id": "06695356-6060-4cda-a265-b4effa3c14fd",
                                                "sense_id": "8f521ba4-fae1-373a-b7d9-74995ddbff4c",
                                                "text": "Van die giga-vissersbroeken die over je schoenen tot op de grond reiken waardoor je voetloos door het leven lijkt te gaan; ruches zo groot als de rugplaten van een stegosaurus – of hoe heet dat – en mouwen formaatje luchtballon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90b6e70d-1d36-4a6b-bf72-56a029f4272e",
                        "source_entry_id": "754e00d6-ca3b-31da-b7eb-33a4a7147ee1",
                        "source_sense_id": "8b34d7e8-f6a4-3193-9d64-7f9388b5af00",
