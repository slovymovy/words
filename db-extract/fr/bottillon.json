                    }
                ],
                "senses": [
                    {
                        "sense_id": "1998dd22-40c6-3b24-841a-4ce62344e6d4",
                        "entry_id": "0bd5b9d9-6af3-300b-94b9-e84fec327a67",
                        "glosses": [
                            "Bottine pour homme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc66e652-61fd-4f18-b8e5-cab1f6307e3d",
                                "sense_id": "1998dd22-40c6-3b24-841a-4ce62344e6d4",
                                "text": "En fait de belles choses, Nicolas admirait surtout les bottillons de cuir noir qu’il s’était offerts avec ses bénéfices de décembre et de janvier. Il allongea la jambe, tourna le pied à droite, à gauche, et la lumière de l’ampoule électrique joua sur la boucle de métal qui fermait la chaussure à hauteur de cheville. Tout le chic de l’Angleterre s’était réfugié au niveau de ses extrémités."
                            },
                            {
                                "example_id": "ee6558ae-9077-4bdc-a78b-d6cfc0f3da44",
                                "sense_id": "1998dd22-40c6-3b24-841a-4ce62344e6d4",
                                "text": "Sa quête ne souffrait plus d’accalmie et Louise allait maintenant d’un trottoir à l’autre, sans souci des dangers de la chaussée, attirée par la fatigue ou l’éclat d’un chevreau, ballerine ou richelieu, bottillon ou petit soulier, séminariste ou semi-poulaine, boucle, élastiques ou boutons."
                            },
                            {
                                "example_id": "aa5c7c3b-4678-427f-a75d-6288770762f2",
                                "sense_id": "1998dd22-40c6-3b24-841a-4ce62344e6d4",
                                "text": "L’inélégance extrême du bottillon est devenue manifeste lorsqu’on s’est mis à porter la culotte courte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fe5fdad-1c15-4566-aa2b-f2e2fc9e54f0",
                        "source_entry_id": "0bd5b9d9-6af3-300b-94b9-e84fec327a67",
                        "source_sense_id": "1998dd22-40c6-3b24-841a-4ce62344e6d4",
                        "target_lang_word": "bootee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bootee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "A soft, woolen shoe, usually knitted, for a baby or small pet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4702c0-cf3d-4a6d-8d6d-840bdaff92a2",
                                                "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                                "text": "Take off the baby's bootees before you put her in the crib."
                                            },
                                            {
                                                "example_id": "96aab636-639c-4ac6-8922-826f9ba5b0ba",
                                                "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                                "text": "‘No,’ said Luke, grinning at her. ‘You're not dull enough! […] What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything? A bootee or a bit of embroidery or anything at all?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e6b775-45c4-3fc8-b9b1-f426a7e34115",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "A thick sock worn under a wetsuit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "An overshoe or sock worn to cover dirty shoes or feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd434756-f757-4e98-b3fb-f682f09d36ce",
                                                "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                                "text": "Surgeons often slip on bootees before entering the operating room."
                                            },
                                            {
                                                "example_id": "0740b9b5-0b9b-4ab9-a66b-c7b6cabc8a7b",
                                                "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                                "text": "Just above the Sunset Strip, construction workers in white bootees were putting the final touches on another home — a 14,000-square-foot house that Mr. Niami is building for himself."
                                            }
                                        ]
                                    }
                                ]
                            }
