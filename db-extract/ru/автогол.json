                                        "entry_id": "e0254609-0af8-3ee8-8c7d-aa8f7acd7191",
                                        "glosses": [
                                            "punto segnato da un giocatore nella propria porta a favore degli avversari"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
