                "senses": [
                    {
                        "sense_id": "16821bc0-26c9-306b-8cdc-78313fd7c7c1",
                        "entry_id": "73c8ad1d-b439-3c86-a1eb-98ef88eed5a8",
                        "glosses": [
                            "Sonderform der Geomorphodynamik im Flussbett, wobei Hohlformen entstehen. Evorsion beschreibt die Strudelwirkung des Wassers unter Mitwirkung von Mahlsteinen unterschiedlicher Größe. Es entstehen Kolke (Hohlformen kleineren Ausmaßes)."
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "ef77ca8c-6b70-4b6e-a6ff-b7c844b0b40b",
                                "sense_id": "16821bc0-26c9-306b-8cdc-78313fd7c7c1",
                                "text": "„Die ausstrudelnde Tätigkeit des fließenden Wassers, die Evorsion, ist besonders schön in Flußengen, am Fuß von Wasserfällen oder in Klammen zu beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
