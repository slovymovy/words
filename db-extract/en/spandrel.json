    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                "word": "spandrel",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ce668584-4b29-40a3-a16e-dd6f31dd7893",
                        "entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "tags": [
                            "plural"
                        ],
                        "form": "spandrels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8ce734d-b6d5-3ff1-b3fc-6897a90ad807",
                        "entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "glosses": [
                            "The space (often more or less triangular) between the outer curve of an arch (the extrados) and a straight-sided figure that bounds it; the space between two contiguous arches and a straight feature above them."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd595fb-31de-41cd-a0e2-48e832f257b5",
                                "sense_id": "d8ce734d-b6d5-3ff1-b3fc-6897a90ad807",
                                "text": "Usual practice then builds a wall above each curved end of the arch, known as a spandrel, which directly joins the bridge's sidewalls. […] With sidewalls and spandrels in place, you can fill the space between them with material up to the height of the bridge deck, and then place the road or railway on top."
                            }
                        ]
                    },
                    {
                        "sense_id": "705147ae-3932-3dab-9b5f-82356f68d9d9",
                        "entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "glosses": [
                            "Horizontal member between the windows of successive storeys of a tall building."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24c81498-b4e0-4faf-bee7-fd2ad245fff1",
                                "sense_id": "705147ae-3932-3dab-9b5f-82356f68d9d9",
                                "text": "2002, Kerstin Lang, Seismic Vulnerability of Existing Buildings, vdf Hochschulverlag AG, page 25,\nDue to the fact that the walls are joined by floors and spandrels, a coupling effect is produced. Depending on the extent of the spandrels, this coupling effect will be bigger or smaller."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfb4ddf1-d390-36b8-8005-68f6c2cb5cbf",
                        "entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "glosses": [
                            "The triangular space under a stair; the material that fills the space."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "96364894-2c37-3ea9-bce3-d9fb1f85e982",
                        "entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "glosses": [
                            "An oriental rug having a pattern of arches; the design in the corners of such a rug, especially in a prayer rug."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "94220c7c-4717-3b9c-8a4f-4a6b36212618",
                        "entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "glosses": [
                            "A phenotypic characteristic that evolved as a side effect of an adaptation in response to evolutionary pressure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6be37251-6a03-427e-8446-74607657cfe7",
                                "sense_id": "94220c7c-4717-3b9c-8a4f-4a6b36212618",
                                "text": "Another type of theory emphasises the sometimes accidental nature of evolution. A spandrel is a structure arising as a by-product of some other architectural configuration. In evolutionary terms, a spandrel is some trait of an organism which emerges not through direct adaptionist or exaptationist means, but rather as a side effect of some other evolutionary development."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2304a6d-81d2-3a5e-88a0-618c31ea2dfd",
                        "entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "glosses": [
                            "soffit (usually used to describe metal or corrugated plastic types of roof soffit)"
                        ],
                        "tags": [
                            "Philippines"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30806267-63f5-4268-8ca8-b4dd4330049f",
                        "source_entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "source_sense_description": "space between an arch and another object",
                        "target_lang_word": "zwik",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "61e6292b-a200-3190-ac87-26bb3ec8b643",
                                        "entry_id": "81385c47-b51f-3156-9270-50a50423efb6",
                                        "glosses": [
                                            "een houten pin waarmee een zwikgat afgedicht kan worden"
                                        ],
                                        "tags": [
                                            "kuiperij"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "949890c2-4fc4-3d7e-a7d4-fb514a99e718",
                                        "entry_id": "81385c47-b51f-3156-9270-50a50423efb6",
                                        "glosses": [
                                            "een houten pin waarmee een zwikgat afgedicht kan worden",
                                            "~ zwak: Proost!"
                                        ],
                                        "tags": [
                                            "kuiperij",
                                            "pregnant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "087e710a-2ccd-401e-abf1-91e0d63df57f",
                                                "sense_id": "949890c2-4fc4-3d7e-a7d4-fb514a99e718",
                                                "text": "- ‘Dat is niet kwaad gedacht,’ zeide ik, hopende op deze wijze de zaak best te sussen: ‘geef dan een glaasje brandewijn, vrijster! en laat er niet meer over de questie gesproken worden. Zwik!’ zeide ik, mijn mond aan het zoopje zettende, dat Mientje mij bracht en het daarna aan Andries toestekende.\n- ‘Zwak!’ zeide deze, het glas ledigende: ‘en ik wensch je toe dat je nooit meer in mijn vaarwater komen meugt.’"
                                            },
                                            {
                                                "example_id": "952866a6-80cd-4c5f-bc36-52e9cce920eb",
                                                "sense_id": "949890c2-4fc4-3d7e-a7d4-fb514a99e718",
                                                "text": "Nou goelicke Giertje, ick selt so louter as een held // klaren. Swick.\nGiertje: Swack, een half bier in iou sack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "161f97ed-9b7a-39d9-b35f-e9e0ab33b576",
                                        "entry_id": "81385c47-b51f-3156-9270-50a50423efb6",
                                        "glosses": [
                                            "hoekstuk tussen een cirkel en de rechthoekige omlijsting hiervan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce7e8646-43e0-4056-948a-fdbffe6cb4d5",
                                                "sense_id": "161f97ed-9b7a-39d9-b35f-e9e0ab33b576",
                                                "text": "Sporen van pinakels op de aanzetten. Van de transeptgevels bevat de zuidelijke een versierde poort (midden-XV) met korfboog, waarboven een geprofileerde spitsboog; het boogveld is in drie vakken verdeeld, waarin traceeringen en lijst met bladornament. In de zwikken is een boogfries en op den spitsboog zijn hogels. Het geheel is besloten tusschen twee stijlen, elk met twee beeldnissen met draagsteen en baldakijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a44b1d1-fb59-301a-8182-573bb645c567",
                                        "entry_id": "81385c47-b51f-3156-9270-50a50423efb6",
                                        "glosses": [
                                            "penis"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75036766-f449-4985-9851-69434bda97f9",
                                                "sense_id": "5a44b1d1-fb59-301a-8182-573bb645c567",
                                                "text": "Tis noch niet langh e leen dat Dirredomdeyne van een leelicke Vryer een moye Keurs kreegh, Om dat sy heur oxhooft tot sijn swickje wat e lient hadt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c9ff8a4-65e4-3af6-a665-a30327145872",
                                        "entry_id": "81385c47-b51f-3156-9270-50a50423efb6",
                                        "glosses": [
                                            "het zwikken (van een lichaamsdeel), verstuiking"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43a463a5-9154-305b-905e-4ab16c20e7dc",
                                        "entry_id": "81385c47-b51f-3156-9270-50a50423efb6",
                                        "glosses": [
                                            "winnende slag van drie gelijke kaarten (bijv. drie boeren of drie azen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d35dc662-8ec8-424b-af4f-361a34a4f0e4",
                                                "sense_id": "43a463a5-9154-305b-905e-4ab16c20e7dc",
                                                "text": "Men is ten onzent graag bereid een puik harmonie-orkest of zelfs een zwik buitenlandse blazers te engageren, maar de hoge kosten daarvoor worden deels gedekt door de drankopbrengst."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2601534-9660-3ea1-8792-2a146cd1ba45",
                                        "entry_id": "81385c47-b51f-3156-9270-50a50423efb6",
                                        "glosses": [
                                            "aanzienlijke hoeveelheid, een groot aantal (van bij elkaar horen voorwerpen, artikelen, mensen e.d.)"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ec832a0-5a82-4430-b0bd-8616e294cc8e",
                                                "sense_id": "d2601534-9660-3ea1-8792-2a146cd1ba45",
                                                "text": "een zwik artikelen"
                                            },
                                            {
                                                "example_id": "48e15b89-c442-4bf8-bb4e-7c358752060d",
                                                "sense_id": "d2601534-9660-3ea1-8792-2a146cd1ba45",
                                                "text": "Men is ten onzent graag bereid een puik harmonie-orkest of zelfs een zwik buitenlandse blazers te engageren, maar de hoge kosten daarvoor worden deels gedekt door de drankopbrengst."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc35e0f8-9a5b-3187-a9ef-b6ff0da7b650",
                                        "entry_id": "81385c47-b51f-3156-9270-50a50423efb6",
                                        "glosses": [
                                            "vnl. verkleinwoord spullen, mikmak, zooitje"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c32eddf-c352-4d80-ab42-7dc829265ec1",
                                                "sense_id": "fc35e0f8-9a5b-3187-a9ef-b6ff0da7b650",
                                                "text": "Neem dat hele zwikje maar weer mee."
                                            },
                                            {
                                                "example_id": "d126b31d-9c2d-4c9f-8c1e-be960c185d30",
                                                "sense_id": "fc35e0f8-9a5b-3187-a9ef-b6ff0da7b650",
                                                "text": "- Wat een bènde, zei ze.\n- Ja, - zei de vrouw. - Dat is zo usance, bij een verhuizing.\nHet kind trok misprijzend de smalle neus op.\n- En moet dat allemaal mee? informeerde ze.\n- Natuurlijk! zei de vrouw. - Ik laat al een nele zwik achter!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zwik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ec7a8d87-64eb-3087-b74a-8582a242a445",
                                        "entry_id": "e972ef0c-2da1-3c13-b787-b07022dfaf2b",
                                        "glosses": [
                                            "wankel (allitererend met zwak)"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a16fe58-7bc2-445d-8681-943986a154fb",
                                                "sense_id": "ec7a8d87-64eb-3087-b74a-8582a242a445",
                                                "text": "Wat vogels zingen daar alle engelse koralen\nmet hunne kelen na! Hoe welig hangt dit ooft!\nHoe zwik deez' muskadel! D' oranjeboom belooft\nden mond verkwikkend sap, men ziet het vee gedijen\nbij keur van geurig kruid en duizend lekkernijen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zwik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "80bead96-18aa-359c-b9af-e2aae4cf5b45",
                                        "entry_id": "315ace6f-49c4-32ed-8218-40ed7c204776",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van zwikken"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58470ae6-a01d-4a82-916b-9b3f0b9a09b4",
                                                "sense_id": "80bead96-18aa-359c-b9af-e2aae4cf5b45",
                                                "text": "Ik zwik."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d92975-c7e2-3478-abd4-7ad9c1655c61",
                                        "entry_id": "315ace6f-49c4-32ed-8218-40ed7c204776",
                                        "glosses": [
                                            "gebiedende wijs van zwikken"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7043a078-ffe1-4a34-ac4d-7a1d18ec8834",
                                                "sense_id": "93d92975-c7e2-3478-abd4-7ad9c1655c61",
                                                "text": "Zwik!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7652ec52-4164-3155-9bee-54b1b74f1462",
                                        "entry_id": "315ace6f-49c4-32ed-8218-40ed7c204776",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van zwikken"
                                        ],
                                        "tags": [
