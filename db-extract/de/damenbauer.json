                    {
                        "sense_id": "6a4d0107-0392-3c84-b80d-f3918e700df9",
                        "entry_id": "b9bffe20-12c3-38af-9323-5c2340efa47b",
                        "glosses": [
                            "Bauer, der in der Grundstellung vor der Dame beziehungsweise im späteren Spielverlauf auf der d-Linie steht"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "60e020fb-f5ec-43c8-b3df-ec7c46442cd1",
                                "sense_id": "6a4d0107-0392-3c84-b80d-f3918e700df9",
                                "text": "In der Ausgangsstellung des Schachspiels steht der weiße Damenbauer auf dem Feld d2, der schwarze Damenbauer auf dem Feld d7."
                            },
                            {
                                "example_id": "4eace58e-a633-4891-bdb1-5d900b91af66",
                                "sense_id": "6a4d0107-0392-3c84-b80d-f3918e700df9",
                                "text": "„Es war allmählich an der Zeit, den Damenbauern zu ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
