                                "example_id": "de2a2b1b-c3e8-4f89-8aef-8ac00bdccb54",
                                "sense_id": "ecdcfb30-0cf1-369a-89c9-0cd1e0b3cb44",
                                "text": "Het Nederlands wordt beschouwd als de standaardtaal in Nederland en Vlaanderen.",
                                "translation": "Dutch is considered the standard language in the Netherlands and Flanders.",
                                "english": "Dutch is considered the standard language in the Netherlands and Flanders."
                            },
                            {
                                "example_id": "2d82f387-2d20-427c-a3a4-82903d8feae4",
                                "sense_id": "ecdcfb30-0cf1-369a-89c9-0cd1e0b3cb44",
                                "text": "De standaardtaal wordt meestal gebruikt in formele communicatie en officiële documenten.",
                                "translation": "The standard language is commonly used in formal communication and official documents.",
                                "english": "The standard language is commonly used in formal communication and official documents."
                            },
                            {
                                "example_id": "8df7de86-b609-4991-b7d9-863c3a295880",
                                "sense_id": "ecdcfb30-0cf1-369a-89c9-0cd1e0b3cb44",
                                "text": "In sommige regio's wordt een dialect gesproken, naast de standaardtaal van het land.",
                                "translation": "In some regions, a dialect is spoken alongside the standard language of the country.",
                                "english": "In some regions, a dialect is spoken alongside the standard language of the country."
                            }
