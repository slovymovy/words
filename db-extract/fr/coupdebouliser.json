                        "examples": [
                            {
                                "example_id": "eb9b8f52-6dbd-4959-9fce-bdae73819fce",
                                "sense_id": "11a7206a-9ff7-36dd-b485-b05c78259581",
                                "text": "Blague à part, il s’est trouvé un juge pour mettre cet enseignant en garde à vue. L’enseignant a giflé le gosse mal élevé. A-t-il coupdeboulisé le gendarme, le juge et le procureur ?"
                            },
                            {
                                "example_id": "84d8c3bc-fa6c-4c6f-9fa5-b5019b9245ee",
                                "sense_id": "11a7206a-9ff7-36dd-b485-b05c78259581",
                                "text": "L’avantage d’une grosse tête c’est que je pourrais vous coupdebouliser tous d’une ^([sic : un]) coup bande de moules frites…"
                            },
                            {
                                "example_id": "f775ad97-25b3-4082-9462-3c8cdd6ed755",
                                "sense_id": "11a7206a-9ff7-36dd-b485-b05c78259581",
                                "text": "Qui va se faire coupdebouliser ?"
                            }
                        ]
                    }
