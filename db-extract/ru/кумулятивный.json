                ],
                "senses": [
                    {
                        "sense_id": "61f7eadd-0fd2-3b72-96a9-8b697a453397",
                        "entry_id": "63cca2aa-5ede-3f27-abc0-490a5905cc40",
                        "glosses": [
                            "спец. постепенно накапливаемый или накапливающийся, суммирующийся со временем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4229ef5e-71a9-472c-95f1-411bda61af3f",
                                "sense_id": "61f7eadd-0fd2-3b72-96a9-8b697a453397",
                                "text": "Неприятно для организма и то, что доза суммарного облучения обладает кумулятивным эффектом."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbf7f972-878b-3bfb-8e0e-f78acf839e92",
                        "entry_id": "63cca2aa-5ede-3f27-abc0-490a5905cc40",
                        "glosses": [
                            "воен. основанный на использовании эффекта усиления действия взрыва путем его концентрации в заданном направлении (о боеприпасах и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e34d5c24-47d7-47ae-a913-2d4bbe809126",
                                "sense_id": "fbf7f972-878b-3bfb-8e0e-f78acf839e92",
                                "text": "Ночью с помощью ракет засылались на огромную высоту армейские гранаты с кумулятивным зарядом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f275e4d-bffd-4463-89a8-28ec3ca215d8",
                        "source_entry_id": "63cca2aa-5ede-3f27-abc0-490a5905cc40",
                        "target_lang_word": "cumulative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cumulative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7960ce13-66e0-3923-ac1a-0bc03a04ea5f",
                                        "entry_id": "2a4d8f22-90dc-3d0c-a555-178eaddfa161",
                                        "glosses": [
                                            "Incorporating all current and previous data up to the present or at the time of measuring or collating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7b6cc5c-2875-3cec-a1e1-6642780755c6",
                                        "entry_id": "2a4d8f22-90dc-3d0c-a555-178eaddfa161",
                                        "glosses": [
                                            "That is formed by an accumulation of successive additions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea7d4b81-de6d-483f-9ed8-23fc05e35b5a",
                                                "sense_id": "e7b6cc5c-2875-3cec-a1e1-6642780755c6",
                                                "text": "As for knowledge which man receiveth by teaching, it is cumulative, not original."
                                            },
                                            {
                                                "example_id": "ab1f883b-7417-42fe-83bc-d0d6f4684cd0",
                                                "sense_id": "e7b6cc5c-2875-3cec-a1e1-6642780755c6",
                                                "text": "The argument […] is in very truth not logical and single, but moral and cumulative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ba48de-009d-3244-bbdb-e126dcc06f9f",
                                        "entry_id": "2a4d8f22-90dc-3d0c-a555-178eaddfa161",
                                        "glosses": [
                                            "That is formed by an accumulation of successive additions.",
                                            "Adding one statement to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2bd395-c378-48f4-bddc-1b2e446d5928",
                                                "sense_id": "59ba48de-009d-3244-bbdb-e126dcc06f9f",
                                                "text": "cumulative conjunctions like and, both…and and as well as"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ef5f8d1-a033-3139-9047-60ee6f23eb65",
                                        "entry_id": "2a4d8f22-90dc-3d0c-a555-178eaddfa161",
                                        "glosses": [
                                            "That tends to accumulate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19e5da1c-153e-3ec1-9486-120e6c7ec84f",
                                        "entry_id": "2a4d8f22-90dc-3d0c-a555-178eaddfa161",
                                        "glosses": [
                                            "Having priority rights to receive a dividend that accrue until paid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91e74029-9177-3ebc-9a19-167edee77742",
                                        "entry_id": "2a4d8f22-90dc-3d0c-a555-178eaddfa161",
                                        "glosses": [
                                            "(of evidence, witnesses, etc.) Intended to illustrate an argument that has already been demonstrated excessively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3310b26d-5e6c-499b-9471-7efe80da0eb4",
                                                "sense_id": "91e74029-9177-3ebc-9a19-167edee77742",
                                                "text": "The state wants to bring in ten blood-spatter experts to testify. Your Honor, that is cumulative testimony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86262578-e141-462e-a01d-6d52bcf3fd2a",
