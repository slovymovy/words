                "senses": [
                    {
                        "sense_id": "76fe88c6-ab2b-3b9c-996f-ac7146de91ee",
                        "entry_id": "0be42409-c338-33c1-ae23-51b134bd3286",
                        "glosses": [
                            "Variante orthographique de trait d’union."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "bdcff33f-1a97-4087-9047-6c84d5a68aca",
                                "sense_id": "76fe88c6-ab2b-3b9c-996f-ac7146de91ee",
                                "text": "Le massif du Chasseral est un trait-d’union entre le Jura et le Plateau suisse."
                            },
                            {
                                "example_id": "2845a31b-e722-4ae6-9f49-5223815f99e7",
                                "sense_id": "76fe88c6-ab2b-3b9c-996f-ac7146de91ee",
                                "text": "L’adverbe « très » et le mot qu’il modifie son sauf quelques exceptions, liés par un trait-d’union dans l’original."
                            },
                            {
                                "example_id": "02065359-310c-4642-9a75-15e91c36f98a",
                                "sense_id": "76fe88c6-ab2b-3b9c-996f-ac7146de91ee",
                                "text": "Au début des années trente, il conçoit six projets successifs pour le Cercle international qui doit, au centre de la cité, représenter le trait-d’union entre les multiples pavillons étrangers et français."
                            },
                            {
                                "example_id": "3389319d-0603-4012-b3c1-8f97f9ff34cc",
                                "sense_id": "76fe88c6-ab2b-3b9c-996f-ac7146de91ee",
                                "text": "Nous ne pouvions, d’ailleurs, passer sous silence une œuvre qui, chronologiquement, sert de trait-d’union entre Eustache Deschamps et Jehan Molinet, distants de près d’un siècle."
                            },
                            {
                                "example_id": "8ffe64d4-7c63-40d8-b050-d33fc0e3b0ef",
                                "sense_id": "76fe88c6-ab2b-3b9c-996f-ac7146de91ee",
                                "text": "Quand les mots ne peuvent vraisemblablement se fondre ensemble, on emploierait le trait-d’union, mais toujours en considérant le composé comme un seul mot : des pince-sans-rires, des va-et-vients, etc."
                            },
                            {
                                "example_id": "fad12c3b-d8ed-4204-a28d-b0e767da2b89",
                                "sense_id": "76fe88c6-ab2b-3b9c-996f-ac7146de91ee",
                                "text": "On emploie le trait-d’union pour joindre deux mots ensemble, pour les prononcer comme s’ils n’en formaient qu’un, ou du moins pour les fixer d’une manière inséparable (peut-être, chefs-d’œuvre, etc.)."
                            }
                        ]
                    }
