                        "glosses": [
                            "organisatie die toezicht houdt op de naleving van veiligheidswetgeving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf6aa6e-44a7-4476-be5e-51435ddf5246",
                                "sense_id": "48250fed-12bd-32aa-ae2b-69e62e78934e",
                                "text": "De tien bestaande overheidsinspecties moeten opgaan in een Nationale Veiligheidsinspectie. Die moet onafhankelijk, op afstand van de ministeries, inspecteren of de veiligheidsregels in allerlei sectoren worden nageleefd."
                            }
                        ]
                    },
                    {
                        "sense_id": "ada837e6-0184-3e52-b379-9348558ac53a",
                        "entry_id": "f7647e35-264c-347d-ad8f-1b8477b3357f",
                        "glosses": [
                            "onderzoek of iets veilig kan functioneren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b652a8-7015-439e-a944-701796bcecc0",
                                "sense_id": "ada837e6-0184-3e52-b379-9348558ac53a",
                                "text": "Ik zat in de gammele achtbaan en luisterde bij elke bocht bezorgd naar de klagende bouten, ervan overtuigd dat de hele handel zich aan elke vorm van veiligheidsinspectie en degelijk onderhoud had onttrokken sinds zijn hoogtijdagen in de jaren vijftig."
                            },
                            {
                                "example_id": "bead0d80-e890-4cd5-9ed5-90a124174b69",
                                "sense_id": "ada837e6-0184-3e52-b379-9348558ac53a",
                                "text": "Aan de gate moest de Airbus daarom van staart tot neuswiel worden schoongemaakt. Ook kreeg het toestel een uitgebreide veiligheidsinspectie."
                            }
                        ]
                    }
