                "senses": [
                    {
                        "sense_id": "cea47c58-f47e-336e-a60b-3b60145b2008",
                        "entry_id": "61116696-c99c-351f-b8ba-fdc520c6294e",
                        "glosses": [
                            "Donner un caractère de prosopopée à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2f92b40-ff75-4e43-8a63-3fed49231b20",
                                "sense_id": "cea47c58-f47e-336e-a60b-3b60145b2008",
                                "text": "Comment envisager (prosopopéiser) le rapport de la promesse à la terre."
                            },
                            {
                                "example_id": "6dae1192-b7b6-4224-ad46-7bcd63ec7e98",
                                "sense_id": "cea47c58-f47e-336e-a60b-3b60145b2008",
                                "text": "L’émotion prosopopéise l’objet émouvant, le fait parler."
                            },
                            {
                                "example_id": "15c40936-441f-4c1f-ba37-5d67760281f7",
                                "sense_id": "cea47c58-f47e-336e-a60b-3b60145b2008",
                                "text": "C'est ainsi qu'il prosopopise (?), qu'il prosopope (?), qu'il prosopopéise (?), qu'il prosopopope (?), qu'il fait jacter la pierre, Pierre Seghers, dans Les Pierres (1958) : \"La bouche de la pluie m'embrasse\""
                            },
                            {
                                "example_id": "660a93bd-56cd-41a9-8c24-cbbc4c59123d",
                                "sense_id": "cea47c58-f47e-336e-a60b-3b60145b2008",
                                "text": "effet, le monde se prosopopéise, prend visage : il parle en disant ce que l'homme souhaite y voir, ce qu'il souhaite y toucher et y sentir, disant comment il est, donnant le visage à ce qu'il est, montrant son reflet, sa semblance."
                            }
                        ]
                    }
