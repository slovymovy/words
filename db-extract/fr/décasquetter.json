                "senses": [
                    {
                        "sense_id": "e57e9fae-ddae-3a79-8174-cfff79a8d8fc",
                        "entry_id": "60be3aaf-42ac-34a6-8227-19e087044abc",
                        "glosses": [
                            "Enlever la casquette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e59ecf8-0f53-4ddc-95a5-235c1f17e090",
                                "sense_id": "e57e9fae-ddae-3a79-8174-cfff79a8d8fc",
                                "text": "Et quant au directeur de la sécurité, il aurait été malvenu de décasquetter le préfet sans déképiser le directeur."
                            },
                            {
                                "example_id": "0b4f03ae-f600-4aea-a4fe-a06b473271a4",
                                "sense_id": "e57e9fae-ddae-3a79-8174-cfff79a8d8fc",
                                "text": "Un vent à décasquetter les coureurs."
                            },
                            {
                                "example_id": "c03a2c3a-eeda-47f3-ab52-938b863c20ec",
                                "sense_id": "e57e9fae-ddae-3a79-8174-cfff79a8d8fc",
                                "text": "A cela s’ajoute le matraquage et la bêtise de la presse locale régionale, véritable instrument de de lobotomisation des peuplades repliées sur leurs hameaux, traditions, superstitions et craintes, au poinr de se décasquetter et s’incliner passage du maire, du curé et de son préfet, de mes fesses."
                            }
                        ]
                    }
