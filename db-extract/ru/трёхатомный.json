                                        "glosses": [
                                            "Consisting of three atoms."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a8279e2-b86d-4ac0-bd10-51286d1daecf",
                                                "sense_id": "dd7eaa07-1b6e-39dc-8cf5-9768b792b80f",
                                                "text": "Ozone is a triatomic form of oxygen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
