        "fr-extract.jsonl": [
            {
                "entry_id": "76e88fb5-6c98-3c09-817f-7b6b9a30be84",
                "word": "krypton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bfb8ea51-994e-31ae-aa20-b400eea324d7",
                        "entry_id": "76e88fb5-6c98-3c09-817f-7b6b9a30be84",
                        "glosses": [
                            "Élément chimique de numéro atomique 36 et de symbole Kr qui fait partie de la série des gaz nobles."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "788d90e4-2adc-4ecb-a60d-bb434315832c",
                                "sense_id": "bfb8ea51-994e-31ae-aa20-b400eea324d7",
                                "text": "Ces résultats suggèrent aux deux géochimistes qu’avec la cristallisation de la pérovskite à partir de l’océan de magma en fusion, dans les tout premiers stades de l’histoire de la Terre, de l’argon et du krypton, mais très peu de xénon, ont été piégés dans le manteau inférieur."
                            },
                            {
                                "example_id": "e8c3abe2-c05a-427f-a81c-640f03c7e412",
                                "sense_id": "bfb8ea51-994e-31ae-aa20-b400eea324d7",
                                "text": "Cela permettrait d’expliquer pourquoi le xénon est 20 fois moins abondant dans l’atmosphère que le néon, le krypton ou l’argon."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd590683-09ab-3294-a529-c2d953257c9d",
                        "entry_id": "76e88fb5-6c98-3c09-817f-7b6b9a30be84",
                        "glosses": [
                            "Gaz monoatomique de cet élément (Kr) incolore, inodore et chimiquement inerte."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b26d35fa-0d12-4397-a623-bd189659a0be",
                                "sense_id": "dd590683-09ab-3294-a529-c2d953257c9d",
                                "text": "La combinaison sèche ne convient plus parce que le gaz injecté à partir de la bouteille, de l’hélium dans ce cas-là, se comprime fortement et devient plus conducteur alors même qu’il n’a pas le pouvoir isolant de l’air. Il faut donc une bouteille auxiliaire contenant un gaz plus lourd, tel le krypton."
                            },
                            {
                                "example_id": "aa155822-4db1-42de-8fae-f4694cae0cda",
                                "sense_id": "dd590683-09ab-3294-a529-c2d953257c9d",
                                "text": "Ils ont étudié la solubilité de l’argon, du krypton et du xénon dans la pérovskite MgSiO₃ qui compose cette partie du globe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9242f185-7a43-4df0-b75a-fa0707b0d7c8",
                        "source_entry_id": "76e88fb5-6c98-3c09-817f-7b6b9a30be84",
                        "target_lang_word": "Krypton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krypton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6747dffc-603a-3480-a76c-39bd2e1c1d96",
                                        "entry_id": "ead1d114-0e5d-3a4a-a019-6625f2cc6bab",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 36, das zur Gruppe der Edelgase gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e841fc30-5cd0-402e-97b6-d07d11e6c820",
                                                "sense_id": "6747dffc-603a-3480-a76c-39bd2e1c1d96",
                                                "text": "„Der größte Teil des Kryptons wird als Füllgas für Glühlampen verwendet.“"
                                            },
                                            {
                                                "example_id": "69396ed8-43d3-45d0-84a4-ee55b6586a3e",
                                                "sense_id": "6747dffc-603a-3480-a76c-39bd2e1c1d96",
                                                "text": "Krypton ist im gasförmigen und flüssigen Zustand farblos."
                                            },
                                            {
                                                "example_id": "90dda83f-1d52-4397-b676-fa078a9cdd02",
                                                "sense_id": "6747dffc-603a-3480-a76c-39bd2e1c1d96",
                                                "text": "Bei Kernexplosionen von Uran und Plutonium oder bei der Wiederaufarbeitung von Brennelementen entsteht ⁸⁵Kr, ein radioaktives Isotop des Kryptons, das in der Atmosphäre nachgewiesen werden kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
