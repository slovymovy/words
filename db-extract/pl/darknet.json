                "senses": [
                    {
                        "sense_id": "02a6d4bc-1a28-3e6f-a882-5a163dd46f64",
                        "entry_id": "ce3485a4-04f7-3497-9eea-0662abc7872d",
                        "glosses": [
                            "sieć komputerowa, z którą można połączyć się wyłącznie za pomocą specjalnego oprogramowania, zwykle oferująca anonimizację danych przesyłanych przez użytkowników"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c210c23d-2112-4098-8629-35c06fb098d6",
                                "sense_id": "02a6d4bc-1a28-3e6f-a882-5a163dd46f64",
                                "text": "Z reguły darknety to sieci małe i zarezerwowane dla ściśle określonej grupy osób (np. hackerów wymieniających się informacjami o lukach w oprogramowaniu)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aab54ad4-811e-494b-a2ca-b7ee18811f8e",
                        "source_entry_id": "ce3485a4-04f7-3497-9eea-0662abc7872d",
                        "source_sense_id": "02a6d4bc-1a28-3e6f-a882-5a163dd46f64",
                        "target_lang_word": "darknet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "darknet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0e642c4-0ae4-3e59-a402-bbe5aa5fa456",
                                        "entry_id": "b8da4f7a-0c21-32dd-8476-e857af4a79e6",
                                        "glosses": [
                                            "A network of computers that can only be accessed using special software, configuration, or authorization, usually characterized by the anonymization of users, participating hosts, or both."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef67b85-f840-493c-bf02-e959885dbf96",
                                                "sense_id": "c0e642c4-0ae4-3e59-a402-bbe5aa5fa456",
                                                "text": "Despite all the openness of the Internet, there are still places you cannot saunter into on the Web. You must be invited. These are “darknets”: exclusive peer-to-peer networks in which membership is based on circles of trust, whose activities are veiled from the general public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b263cb3d-854b-4bf6-87bf-59674b2d9f94",
