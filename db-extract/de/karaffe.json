                                                "sense_id": "536ec163-e475-3884-ae9d-c0cc2cf6332f",
                                                "text": "Amongst the scattered letters and papers, there stood a claret jug, a large carafe of water, and an empty glass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937e0305-677b-3eba-89d1-351e2169502f",
