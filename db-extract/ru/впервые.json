                                "target_senses": [
                                    {
                                        "sense_id": "32b8358d-dad1-3fab-8220-f08de35589ef",
                                        "entry_id": "376e0750-6d3a-3085-9cca-892c86f353ee",
                                        "glosses": [
                                            "nicht vorher gewesen; niemals vorher stattgefunden habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd32aba-6fef-4620-9a11-e9dd4ade71ea",
                                                "sense_id": "32b8358d-dad1-3fab-8220-f08de35589ef",
                                                "text": "„An deren vorläufigen Höhepunkt steht nun die erstmalige WM-Teilnahme.“"
                                            },
                                            {
                                                "example_id": "d4ab538a-b585-4d6d-bb9e-cf496e1fe52e",
                                                "sense_id": "32b8358d-dad1-3fab-8220-f08de35589ef",
                                                "text": "„Der Begriff Krisenmanagement entstand im politischen Bereich, wobei dessen erstmalige Verwendung dort umstritten ist, mehrheitlich aber J.F. Kennedy im Zusammenhang mit der Kuba-Krise 1962 zugeschrieben wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "741095b6-0c67-34d8-8fb0-734836d248f1",
                                        "entry_id": "376e0750-6d3a-3085-9cca-892c86f353ee",
                                        "glosses": [
                                            "zum ersten Mal"
                                        ],
                                        "tags": [
                                            "adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55c2e82d-1734-4fd2-ab57-7711e2918a2f",
                                                "sense_id": "741095b6-0c67-34d8-8fb0-734836d248f1",
                                                "text": "„Erstmalig haben Mediziner einen Patienten mithilfe des sogenannten Gene Editing direkt im Körper behandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "956789a5-4911-49ba-94ea-f32b152d3b0a",
                        "source_entry_id": "e36338bc-5bdc-3cc1-867b-78f698da44d6",
                        "source_sense_id": "a0b5dd33-6ff2-32a0-92b6-c5dd5690f0b4",
