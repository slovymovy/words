                            {
                                "target_lang_word": "走",
                                "target_lang_sense_clarification": "离开（非标准过去分词）"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49cbfeae-1d01-367e-ae23-57dacad791b8",
                    "sense_definition": "The simple past and past participle of <w>wend</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>went</w> his way through the dark and quiet forest.",
                            "target_lang_translations": {
                                "ru": "Он <w>держал</w> свой путь через темный и тихий лес.",
                                "zh": "他穿过幽暗寂静的森林，继续<w>行进</w>。"
                            }
                        },
                        {
                            "text": "The travelers <w>went</w> towards the setting sun.",
                            "target_lang_translations": {
                                "ru": "Путешественники <w>направлялись</w> к заходящему солнцу.",
                                "zh": "旅行者们朝着落日方向<w>走</w>去。"
                            }
