                                        "sense_id": "32f9e1b4-6c33-3aba-99ed-5038fc5d1cd4",
                                        "entry_id": "630f2b03-c82d-351f-9d6f-43bfae5a802a",
                                        "glosses": [
                                            "Pflanzengattung aus der Familie der Araliengewächse (Araliaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359074e9-573b-4c9a-9a33-9292eb4c4598",
                                                "sense_id": "32f9e1b4-6c33-3aba-99ed-5038fc5d1cd4",
                                                "text": "Efeu gehört zu den Araliengewächsen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "621de622-5c95-3e0d-ba62-4a932d6fe0ac",
                                        "entry_id": "630f2b03-c82d-351f-9d6f-43bfae5a802a",
                                        "glosses": [
                                            "immergrüne Kletterpflanze aus der Gattung Efeu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "752a76fb-3a3d-4ad4-b7da-b4b1afec58a6",
                                                "sense_id": "621de622-5c95-3e0d-ba62-4a932d6fe0ac",
                                                "text": "Efeu findet man oft auf Friedhöfen und an alten Hausmauern."
                                            },
                                            {
                                                "example_id": "d23cbd53-2f7b-40c1-80ca-5a4dd7815922",
                                                "sense_id": "621de622-5c95-3e0d-ba62-4a932d6fe0ac",
                                                "text": "„Um sicher zu sein, dass der Efeu sich nicht erholen würde, kappt er die abgelösten Ranken dicht über dem Erdboden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
