                        {
                            "text": "The engineer adjusted the length of the tuning <w>stub</w> to minimize signal reflection.",
                            "target_lang_translations": {
                                "ru": "Инженер отрегулировал длину настроечного <w>шлейфа</w>, чтобы минимизировать отражение сигнала.",
                                "zh": "工程师调整了调谐<w>短截线</w>的长度，以最大限度地减少信号反射。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tuning stub",
                        "matching stub"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical jargon in electrical engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрезок линии передачи или волновода, подключенный только с одного конца.",
                        "zh": "仅一端连接的传输线或波导段。"
                    },
                    "translations": {
