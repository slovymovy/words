                },
                {
                    "sense_id": "52388ed9-ea72-30c4-b3fe-5fba63c15b5b",
                    "sense_definition": "Harsh, cruel, or refusing to give up a strict or severe attitude.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator was <w>relentless</w> in his treatment of those who opposed his rule.",
                            "target_lang_translations": {
                                "ru": "Диктатор был <w>неумолим</w> в своем отношении к тем, кто выступал против его правления.",
                                "tr": "Diktatör, yönetimine karşı çıkanlara yönelik muamelesinde <w>acımasızdı</w>.",
                                "de": "Der Diktator war <w>unerbittlich</w> im Umgang mit denjenigen, die sich seiner Herrschaft widersetzten.",
                                "fr": "Le dictateur était <w>impitoyable</w> dans sa manière de traiter ceux qui s'opposaient à son règne.",
                                "cs": "Diktátor byl <w>neúprosný</w> v zacházení s těmi, kteří se stavěli proti jeho vládě."
                            }
                        },
                        {
                            "text": "She fixed her son with a <w>relentless</w> eye until he finally told the truth.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на сына <w>непреклонным</w> взглядом, пока он наконец не сказал правду.",
                                "tr": "Oğlu sonunda gerçeği söyleyene kadar ona <w>tavizsiz</w> bakışlarını dikti.",
                                "de": "Sie fixierte ihren Sohn mit einem <w>unnachgiebigen</w> Blick, bis er endlich die Wahrheit sagte.",
                                "fr": "Elle a fixé son fils d'un regard <w>implacable</w> jusqu'à ce qu'il dise enfin la vérité.",
                                "cs": "Upřeně a <w>neústupně</w> se synovi dívala do očí, dokud konečně neřekl pravdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "grim",
                        "inexorable",
                        "unyielding",
                        "unrelenting"
