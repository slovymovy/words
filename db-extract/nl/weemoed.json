                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a28c156-3f11-3b52-85c4-b9b14a156aa6",
                        "entry_id": "574331c8-05a5-308e-9e54-86c75d68c1f3",
                        "glosses": [
                            "gevoel van treurnis, verdriet, nostalgie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b69e8ba-a5d6-43bb-b24a-aa5651b6e463",
                                "sense_id": "4a28c156-3f11-3b52-85c4-b9b14a156aa6",
                                "text": "Hij dacht met weemoed aan de goede tijden van weleer."
                            },
                            {
                                "example_id": "426a92f6-e0e0-486f-b092-a4d75d7a58c4",
                                "sense_id": "4a28c156-3f11-3b52-85c4-b9b14a156aa6",
                                "text": "Fawaz denkt met weemoed terug aan de zender. \"Vroeger zat ik hele dagen voor de tv naar TMF te kijken om dezelfde clip nog een keer te zien. Maar het principe dat er bij een liedje een clip hoort, dat blijft.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a1f753b-feb1-4ecd-a1b5-04a38cf02d40",
                        "source_entry_id": "574331c8-05a5-308e-9e54-86c75d68c1f3",
                        "source_sense_id": "4a28c156-3f11-3b52-85c4-b9b14a156aa6",
                        "source_sense_description": "gevoel van treurnis, verdriet, nostalgie",
                        "target_lang_word": "Wehmut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wehmut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e52314cb-b9ab-3597-8850-35246825754c",
                                        "entry_id": "ea00d04f-9777-3840-bc41-6ca746b7f25b",
                                        "glosses": [
                                            "eine nach innen gekehrte, traurige Grundstimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58452b98-d4fd-4cfd-9f02-6fa110d1c84e",
                                                "sense_id": "e52314cb-b9ab-3597-8850-35246825754c",
                                                "text": "»Nein, in der Tat nicht«, entgegnete Mrs. Sparsit mit einem Anstrich von Wehmut."
                                            },
                                            {
                                                "example_id": "d4e99503-0f5f-44fb-9347-66887fe5eba4",
                                                "sense_id": "e52314cb-b9ab-3597-8850-35246825754c",
                                                "text": "Da ich aber vor Wehmut selbsten nit beten kunnte, ließ ich Paasch sein klein Mägdlein das Gratias beten, in währender Zeit meine Maria das Brot zerschnitt und einem jeglichen sein Teil reichete."
                                            },
                                            {
                                                "example_id": "d274929c-3cb1-42cf-94ed-1e5b1467a451",
                                                "sense_id": "e52314cb-b9ab-3597-8850-35246825754c",
                                                "text": "Wehmut, Trauer, Angst, Verachtung, das waren keine Gefühle mehr für sie, dazu war ihr Blut zu sehr gejagt; …"
                                            },
                                            {
                                                "example_id": "b94aa6d9-c434-4378-9cd5-966f5edb65f3",
                                                "sense_id": "e52314cb-b9ab-3597-8850-35246825754c",
                                                "text": "Er erklärte sich hierüber mit einiger Wehmut; denn er konnte nach der Lage der Sache wohl einsehen, daß sein Aufenthalt in so vollkommener Gesellschaft nicht immer dauern könne, ja vielleicht bald abgebrochen werden müsse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "faa676d8-f14b-3861-b6fc-f14eaf8690bf",
                                        "entry_id": "ea00d04f-9777-3840-bc41-6ca746b7f25b",
                                        "glosses": [
                                            "der bedauernde Wunsch, die Sehnsucht nach einer schöneren Vergangenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f079454-eeb2-4ee3-bc56-4ebe4d7d14c5",
                                                "sense_id": "faa676d8-f14b-3861-b6fc-f14eaf8690bf",
                                                "text": "Verlässt er Berlin mit Wehmut? Wehmut, sagt er, kenn' ich nicht."
                                            },
                                            {
                                                "example_id": "e31a7644-aca8-44e8-bf10-afa95472a93e",
                                                "sense_id": "faa676d8-f14b-3861-b6fc-f14eaf8690bf",
                                                "text": "Wenn eine traditionsreiche Herberge schließen muss, macht sich in fühlenden Herzen Wehmut breit."
                                            },
                                            {
                                                "example_id": "5666ae67-ec1e-427c-9631-18d03683cf6f",
                                                "sense_id": "faa676d8-f14b-3861-b6fc-f14eaf8690bf",
                                                "text": "Nur dem Charmeur Jacques Chirac mag bei seinem letzten Gipfel als französischer Staatschef ein wenig Wehmut befallen haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2184b21a-7570-407b-bb39-818523db17c9",
                        "source_entry_id": "574331c8-05a5-308e-9e54-86c75d68c1f3",
                        "source_sense_id": "4a28c156-3f11-3b52-85c4-b9b14a156aa6",
                        "source_sense_description": "gevoel van treurnis, verdriet, nostalgie",
                        "target_lang_word": "melancholy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melancholy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8cdfa2-3578-3200-be35-23b7fcba2341",
                                        "entry_id": "bff5e659-0944-3a3a-96af-88c5df07f6d8",
                                        "glosses": [
                                            "Black bile, formerly thought to be one of the four \\\"cardinal humours\\\" of animal bodies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22c425b3-26d4-4a76-b5ed-d6bfbfa2f18d",
                                                "sense_id": "1f8cdfa2-3578-3200-be35-23b7fcba2341",
                                                "text": "Melancholy, cold and dry, thick, black, and sour, […] is a bridle to the other two hot humours, blood and choler, preserving them in the blood, and nourishing the bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                        "entry_id": "bff5e659-0944-3a3a-96af-88c5df07f6d8",
                                        "glosses": [
                                            "Great sadness or depression, especially of a thoughtful or introspective nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0307c175-9790-4017-abd3-f5675a01ff4d",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "My mind was troubled with deep melancholy."
                                            },
                                            {
                                                "example_id": "93c233e1-b1a2-4891-9422-369335f87292",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "I have neither the scholar’s melancholy, which is emulation; nor the musician’s, which is fantastical; nor the courtier’s, which is proud; nor the soldier’s, which is ambitious; nor the lawyer’s, which is politic; nor the lady’s, which is nice; nor the lover’s, which is all these; but it is a melancholy of mine own, compounded of many simples, extracted from many objects, and, indeed, the sundry contemplation of my travels; in which my often rumination wraps me in a most humorous sadness."
                                            },
                                            {
                                                "example_id": "ceda47bf-1209-4f90-8612-fd4d136999b5",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "\"The ancients referred melancholy to the mind, the moderns make it matter of digestion—to either case my plan applies,\" said Lady Mandeville."
                                            },
                                            {
                                                "example_id": "8b1514c4-373a-43a6-8c0f-2ad9bb567f0c",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "As to Ernest... He is quite as nervously broken down as I am but it manifests itself in different ways. His inclination is towards megalomania and mine towards melancholy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "melancholy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                        "entry_id": "62d7b7ad-cfc0-3539-978f-64a64043c1d0",
                                        "glosses": [
                                            "Affected with great sadness or depression."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9d3648-3a09-463a-a7dc-1f1e82fa1506",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "Melancholy people don't talk much."
                                            },
                                            {
                                                "example_id": "3265362c-9be8-4312-a0af-b62feb6c647b",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "[…] he is melancholy without cause, and merry against the hair: […]"
                                            },
                                            {
                                                "example_id": "dccecd0a-19b5-45e0-8b80-aa6f78492945",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. […] And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            },
                                            {
                                                "example_id": "1c37b54e-6b07-4f1f-8006-00dddf8ccca1",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "It was the same old song / With a melancholy sound"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
