                    },
                    {
                        "translation_id": "88ab9de9-88ab-4651-9a1c-94844fddf4a7",
                        "source_entry_id": "67272f4a-f0ad-3ef5-b840-a19b9837ddf6",
                        "source_sense_id": "0bc1c639-7be7-3a2a-ada0-4a92929a05a6",
                        "target_lang_word": "Matilda",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "beff3dcd-6b69-4819-bb1a-689821dd845e",
                        "source_entry_id": "67272f4a-f0ad-3ef5-b840-a19b9837ddf6",
                        "source_sense_id": "0bc1c639-7be7-3a2a-ada0-4a92929a05a6",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Matilda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Matilda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fe446f5-b913-3cd4-8ab9-010cc4e54d43",
                                        "entry_id": "81b67b90-8b3c-3c3b-8176-51c731e827fc",
                                        "glosses": [
                                            "A female given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d5d89f-48bd-4537-bc56-c79d44bf631d",
                                                "sense_id": "3fe446f5-b913-3cd4-8ab9-010cc4e54d43",
                                                "text": "But wondrously begotten, and begonne / By false illusion of a guilefull Spright, / On a faire Ladie Nonne, that whilome hight / Matilda, daughter to Pubidius, […]"
                                            },
                                            {
                                                "example_id": "d0591e92-90a2-40c7-acca-092cd6d75240",
                                                "sense_id": "3fe446f5-b913-3cd4-8ab9-010cc4e54d43",
                                                "text": "Countess of Laussitz - Matilda, too, by the mark! A good name, a marvellous good name, is not, Algernon? Musical, pretty, soft, smoothing, loveable. - - - many a fair prospect is spoiled by the mistake in the name. Call Matilda Joan, or Louisa Deborah, and you are ruined forever!"
                                            },
                                            {
                                                "example_id": "072c8d04-0202-4197-996c-5d539941e71f",
                                                "sense_id": "3fe446f5-b913-3cd4-8ab9-010cc4e54d43",
                                                "text": "At one time Joan invented other names for her. 'Matilda' brought to mind dingy curtains, gray tent flaps, a slack-skinned old woman. How about Sharon? Lilliane? Elizabeth? Then, Joan didn't know how, the name Matilda became transformed. It started shining like silver. The \"il\" in it was silver. But not metallic. In Joan's mind the name gleamed now like a fold of satin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Matilda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1dab8d9-6091-3453-b749-7a1a0973f7dd",
                                        "entry_id": "b72ee86d-fa48-3ee3-951d-063e80ad43d4",
                                        "glosses": [
                                            "Either of two British infantry tanks in use during World War II, the Infantry Tank Mark I or Infantry Tank Mark II."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3348079-4c83-3801-acc4-360c3880aa92",
                                        "entry_id": "b72ee86d-fa48-3ee3-951d-063e80ad43d4",
                                        "glosses": [
                                            "A swag or bluey carried by a swagman or swagwoman."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e25c14a-c672-43be-8fd0-9732d722f27e",
                                                "sense_id": "d3348079-4c83-3801-acc4-360c3880aa92",
                                                "text": "Oh there once was a swagman camped in the billabong,\n Under the shade of a coolibah tree,\nAnd he sang as he looked at the old billy boiling,\n 'Who'll come a'waltzing Matilda, with me.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
