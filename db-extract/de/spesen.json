                        "source_sense_id": "f8b37e1d-d0ce-3742-a2d4-8fe77beadf8f",
                        "source_sense_description": "Kosten, die in Ausübung einer beruflichen oder geschäftlichen Tätigkeit entstanden sind",
                        "target_lang_word": "expense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expense",
