                        "glosses": [
                            "уменьш. к топор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf6d586-9f96-45c6-a891-7bc68b2f2d16",
                                "sense_id": "f17e295d-d211-30e6-bead-fb088d9c2963",
                                "text": "Было сыро и сумрачно, тропку иногда преграждали нависающие ветви кустов, но проводник, шедший впереди с топориком в руке, одним небрежным взмахом отсекал их"
                            }
                        ]
