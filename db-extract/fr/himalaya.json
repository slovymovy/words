        "fr-extract.jsonl": [
            {
                "entry_id": "0e0ab5e3-0a6e-3797-8334-1b93433dab1f",
                "word": "Himalaya",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc41a164-a7bf-3a63-b0c6-193390349b2a",
                        "entry_id": "0e0ab5e3-0a6e-3797-8334-1b93433dab1f",
                        "glosses": [
                            "Chaîne de montagnes s’étendant sur les territoires de l’Afghanistan, du Pakistan, de l’Inde, de la Chine, du Bhoutan, du Népal et de la Birmanie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "31b072d0-26f1-3ef5-aa68-d1449a74e9b2",
                        "entry_id": "0e0ab5e3-0a6e-3797-8334-1b93433dab1f",
                        "glosses": [
                            "Personne qui en impose par sa stature intellectuelle."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bb5d3acc-6e58-4bbc-810b-ad2a2d91b55e",
                                "sense_id": "31b072d0-26f1-3ef5-aa68-d1449a74e9b2",
                                "text": "[…] J'ai connu une fondatrice de monastère […] qui parlait comme un livre des douze degrés d'humilité et qui avait réuni un immense monastère dont elle était la législation vivante, et qu'elle édifiait par sa grandeur, son intelligence et ses conseils empruntés aux Pères grecs et latins qu'elle lisait à vue, et elle donnait l'impression vraiment d'être un Himalaya de la vie spirituelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8565bbd-a709-3f78-a1ea-61b9160eed5a",
                        "entry_id": "0e0ab5e3-0a6e-3797-8334-1b93433dab1f",
                        "glosses": [
                            "Ce qui est difficile à surmonter."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4bef9b7a-7655-42e6-8b66-17ffe1b8667f",
                                "sense_id": "a8565bbd-a709-3f78-a1ea-61b9160eed5a",
                                "text": "Une nénette enceinte, c'est pas l’Himalaya, et un contrôle fiscal, c'est pas un mardi noir à Wall Street. D'abord tu largues la nénette, je te file l'oseille en liquide pour les formalités. Ensuite, tu disparais du bureau, […]."
                            },
                            {
                                "example_id": "568b8b0c-7b62-4d13-bb42-40dab3d1ea6e",
                                "sense_id": "a8565bbd-a709-3f78-a1ea-61b9160eed5a",
                                "text": "10 octobre 1941 – Elles vivent pour un an ou deux sur des rites mystérieux et incommunicables, des complicités idiotes, retranchées dans un univers de broutilles dont elles font leurs Himalayas."
                            }
                        ]
                    },
                    {
                        "sense_id": "e705998d-a3e2-3bbe-bb52-24c4f959e39c",
                        "entry_id": "0e0ab5e3-0a6e-3797-8334-1b93433dab1f",
                        "glosses": [
                            "Endroit difficile à atteindre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "24fbffb8-7223-4d9a-97d9-8ca89487f4eb",
                                "sense_id": "e705998d-a3e2-3bbe-bb52-24c4f959e39c",
                                "text": "La rumeur villageoise parle avec une respectueuse considération du « fils Le Lannou », entré à une École normale dont on dit qu’elle est « supérieure » à celle d’où mes parents sont sortis : première évocation de la rue d’Ulm dans ma vie, comme un himalaya de la réussite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad1324af-f2f6-4116-9792-72be5280980b",
                        "source_entry_id": "0e0ab5e3-0a6e-3797-8334-1b93433dab1f",
                        "target_lang_word": "Himalaja",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Himalaja",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe829ea7-2019-3dae-b201-3157b463cff5",
                                        "entry_id": "ddc4abea-efb4-3f64-82b6-4a09f2bc5bc9",
                                        "glosses": [
                                            "Hochgebirge in Asien, das sich zwischen dem Indischen Subkontinent und dem Tibetischen Hochland erstreckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b1b110b-7ab2-4595-ae6c-62751f72f51b",
                                                "sense_id": "fe829ea7-2019-3dae-b201-3157b463cff5",
                                                "text": "„Ins Basislager am Fuß des Bergs begleiteten ihn sein Bruder Vincent und sein Vater Alfred, der als junger Mann Touren im Himalaja unternommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3702b724-ff6c-4d75-b5c3-a9a7a7283c60",
                        "source_entry_id": "0e0ab5e3-0a6e-3797-8334-1b93433dab1f",
                        "target_lang_word": "Himalaya",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Himalaya",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9303ebcf-9096-3d22-a5cb-14faef8def3e",
                                        "entry_id": "3b4589db-f510-3199-81ba-76a7f2bcd75b",
                                        "glosses": [
                                            "Hochgebirge in Asien, das sich zwischen dem indischen Subkontinent und dem tibetischen Hochland erstreckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c893590-1f98-4e17-9a19-65da2d6c4cdc",
                                                "sense_id": "9303ebcf-9096-3d22-a5cb-14faef8def3e",
                                                "text": "„Der Mount Everest ist, wie der gesamte Himalaya, während der alpidischen Gebirgsbildung entstanden.“"
                                            },
                                            {
                                                "example_id": "3f6eb66f-099a-4f01-971c-022c8af16fa1",
                                                "sense_id": "9303ebcf-9096-3d22-a5cb-14faef8def3e",
                                                "text": "„Da hilft kein Risikosport und kein Erlebnistourismus im Himalaya mehr.“"
                                            },
                                            {
                                                "example_id": "2c668604-608e-469f-97c5-c51496c8b9a1",
                                                "sense_id": "9303ebcf-9096-3d22-a5cb-14faef8def3e",
                                                "text": "„Der junge Forscher identifizierte sie im einzelnen als Deodars, Bäume mit erlesenem Duft, die vor allem im Himalaya vorkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "434431f6-d57e-4ff8-990a-aa24d361ec01",
                        "source_entry_id": "0e0ab5e3-0a6e-3797-8334-1b93433dab1f",
