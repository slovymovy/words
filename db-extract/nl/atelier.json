                        "form": "ateliertjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9962061-8a5f-3a55-9860-1fefa093ea28",
                        "entry_id": "a959f00e-b351-3d38-906f-cb5a1ceec552",
                        "glosses": [
                            "de werkruimte van een kunstenaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8868d4-c3f5-42b3-a51c-a8273474027a",
                                "sense_id": "e9962061-8a5f-3a55-9860-1fefa093ea28",
                                "text": "Het atelier was volgepakt met schilderijen."
                            },
                            {
                                "example_id": "173ecd6e-f1e2-4be6-8ee0-17794a2461fe",
                                "sense_id": "e9962061-8a5f-3a55-9860-1fefa093ea28",
                                "text": "Toen ik het boek uit had, begon ik te vermoeden dat achter de zwart-witfoto die al twee decennia in mijn atelier hangt misschien wel een politiek statement schuilging."
                            },
                            {
                                "example_id": "aa81610f-7fff-4fde-8552-f48173428dba",
                                "sense_id": "e9962061-8a5f-3a55-9860-1fefa093ea28",
                                "text": "Hierbij is een foto van het atelier geplaatst: Salomé Abergel, in een wijd, vuil overhemd, poseert naast een onvoltooid doek, haar zwartgeverfde haren een aureool van onheil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10d1f0a4-7312-41c0-b983-6d458288bab0",
                        "source_entry_id": "a959f00e-b351-3d38-906f-cb5a1ceec552",
                        "source_sense_id": "e9962061-8a5f-3a55-9860-1fefa093ea28",
                        "source_sense_description": "de werkruimte van een kunstenaar",
                        "target_lang_word": "Atelier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atelier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                        "entry_id": "9762b74d-86a1-35a3-8c83-31d72968270e",
                                        "glosses": [
                                            "die Werkstatt eines Künstlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f28a89be-b384-4ab7-ac5a-6b53777ccdb4",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "Er ist gerade in seinem Atelier und zeichnet."
                                            },
                                            {
                                                "example_id": "2f9e693a-5e1a-406a-b569-ed9d7c50fafb",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "„Das Halbrund der Morgensonne zeigte sich über den Dächern und füllte sein kleines Atelier mit diesem besonderen Licht, das nur in der ersten Stunde eines wolkenlosen Tages zu sehen war.“"
                                            },
                                            {
                                                "example_id": "7732106b-b282-4805-8b96-3bd7c50dca28",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "„Die weißen Vorhänge des Ateliers waren zugezogen, und man sah darauf Schatten, die sich bewegten.“"
                                            },
                                            {
                                                "example_id": "bf77ac73-074b-460d-8671-c8b2d56300b2",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "„Aus dem Stockwerk unter dem Atelier kamen plötzlich zwei Männer herauf, weitere zwei Männer kamen vom Dachboden herab.“"
                                            },
                                            {
                                                "example_id": "d78674cf-c1c2-43a8-a87e-e8a99d81d39e",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "„Später bekam ich die Einladung, im Winter jederzeit nach fünf ins Atelier zu kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0986882f-45a3-41d0-a389-810d3704bfe1",
                        "source_entry_id": "a959f00e-b351-3d38-906f-cb5a1ceec552",
                        "source_sense_id": "e9962061-8a5f-3a55-9860-1fefa093ea28",
                        "source_sense_description": "de werkruimte van een kunstenaar",
                        "target_lang_word": "atelier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atelier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                        "entry_id": "36d7d1b3-69a0-3698-a1ca-1868975c0598",
                                        "glosses": [
                                            "A studio or workshop, especially for an artist, designer, or fashion house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37c5e54-b7e3-4f54-9481-91d4deabeb56",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "The Dukes de Claulne, father and ſon, had laboratories for clock and vvatch making as vvell as for machinery. Theſe ateliers, as the French name them, vvere as fine and complete for the choice of tools as it vvas poſſible to find in Europe; […]"
                                            },
                                            {
                                                "example_id": "69b4abd0-356c-4a3d-b1e5-4af46d9988c6",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "I paid a visit to the celebrated [Antonio] Canova in his vast and interesting atelier. He had been at Naples a short time before to form his own judgment of the situation intended for the equestrian statue of Napoleon, which we saw already almost finished in his atelier."
                                            },
                                            {
                                                "example_id": "7b2e9602-6dc0-40e1-91fa-a6f17538bfe3",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "The life of a young artist here is the easiest, merriest, dirtiest existence possible. […] [H]e arrives at his atelier at a tolerably early hour, and labours among a score of companions as merry and poor as himself."
                                            },
                                            {
                                                "example_id": "483e7c15-8e5c-4817-9a1e-1aaf7a75cb25",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "At the meeting of the Society, February 6, it was stated that red glass was preferable to yellow for the windows of photographic ateliers."
                                            },
                                            {
                                                "example_id": "816aed24-76f7-46a1-b919-69373e9e764b",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "[Albert de] Lautreppe is awfully nice—a quiet, gentlemanly fellow, gonflé de rêves, as he describes himself—once a sculptor in the atelier of Henry Crosse, he knows something of art, and is really a resource to me."
                                            },
                                            {
                                                "example_id": "9e178dde-e520-4b49-9e02-189efe661659",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "Hats with transparent tulle and crêpe brims and hemp or leghorn crowns are succeeding the small martial styles of which this atelier made quite a feature earlier in the season."
                                            },
                                            {
                                                "example_id": "2225eed4-eada-4e2c-a37c-470850530188",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "Education opportunities improved with the advent of the Second Empire in 1850 and more ateliers began to take women students. But the atelier system, in which master painters trained a number of students in their studio, was a male-dominated world to which women's access was still restricted, even though the number of ateliers taking women increased – not just because not all artists would teach women, but because the atelier was itself a gendered social space that was not suitable for women."
                                            },
                                            {
                                                "example_id": "8a769893-441d-40b4-bef9-eec872fa60f2",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "The first thing Diane did when she arrived home was to hurry into the atelier. She removed the half-finished portrait on the easel and replaced it with a blank canvas. She began to sketch the face of the man who had tried to kill her, but her hands were trembling so hard that she had to stop."
                                            },
                                            {
                                                "example_id": "0f6f9338-d80f-4fc2-b496-6ee5cc31163f",
                                                "sense_id": "31e6ec47-6b9c-3ce2-bc64-08596e20fa44",
                                                "text": "During the time Theyskens was presenting his precollection, a rumor began circulating in Paris: Procter & Gamble, the American conglomerate that owns Rochas, had decided to close the fashion branch of the company. Soon enough, the story was confirmed. The beautiful gowns would never be shown or produced; the atelier would be shuttered. […] [\"T]he French world of fashion is being destroyed little by little. The French factories and ateliers were once dedicated to the little nuances. That luxurious approach and that refinement disappeared in the 80's and 90's, and I fear it may be disappearing again.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1664395-2f96-4f43-a893-cbd550fa54d5",
                        "source_entry_id": "a959f00e-b351-3d38-906f-cb5a1ceec552",
                        "source_sense_id": "e9962061-8a5f-3a55-9860-1fefa093ea28",
                        "source_sense_description": "de werkruimte van een kunstenaar",
                        "target_lang_word": "atelier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03794128-760c-37ac-81af-f01c929e2f12",
                                        "entry_id": "b33d5ef0-38cc-3027-b729-3bc7f4cc7b2b",
                                        "glosses": [
                                            "Lieu où se fait un travail manuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a61a30-ad5f-488b-a802-b73a66bc5def",
                                                "sense_id": "03794128-760c-37ac-81af-f01c929e2f12",
                                                "text": "Il fut reconnu, plus tard, que les tabacs de Morlaix étaient mal travaillés et qu'aux ateliers royaux de cette ville, la mouillade des feuilles était faite avec de l'eau de mer très sale, puisée dans le port vaseux."
                                            },
                                            {
                                                "example_id": "5d18d0f7-09f5-4ded-b63b-f27a769229dd",
                                                "sense_id": "03794128-760c-37ac-81af-f01c929e2f12",
                                                "text": "En passant, écoutez les chants qui montent quelquefois des ateliers où les sardinières s'appliquent à la tâche. De vieux cantiques alternent avec les grivoiseries de café-concert."
                                            },
                                            {
                                                "example_id": "f70f4fc4-a24a-4711-9206-01a35fb95331",
                                                "sense_id": "03794128-760c-37ac-81af-f01c929e2f12",
                                                "text": "Mélie pareil : quatre ou cinq ans pour offrir à son Alphonse, qui est mécanicien de son métier et maquereautin d'occasion, les moyens d'ouvrir un atelier de vélocipèdes ou de bicyclettes."
                                            },
                                            {
                                                "example_id": "c1e2afa1-064a-4269-9523-3dc55268801d",
                                                "sense_id": "03794128-760c-37ac-81af-f01c929e2f12",
                                                "text": "Sans doute étonné par l'absence de nouvelles de Ned, George Brough, le constructeur de motocyclettes, lui a proposé, il y a quelques semaines, la dernière-née de ses ateliers : une nouvelle version du modèle Brough SS 100."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfdfd7fe-c146-3788-b5c4-748f52dc6f35",
                                        "entry_id": "b33d5ef0-38cc-3027-b729-3bc7f4cc7b2b",
                                        "glosses": [
                                            "Lieu de travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d95ddf3-07ed-497a-b3b1-1a3d6d8911c3",
                                                "sense_id": "cfdfd7fe-c146-3788-b5c4-748f52dc6f35",
                                                "text": "Atelier de charité, ouvroir, lieu où l’on fait travailler des pauvres qui manquent d’ouvrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b251fb61-0dd6-3000-82fd-07e79b54e711",
                                        "entry_id": "b33d5ef0-38cc-3027-b729-3bc7f4cc7b2b",
                                        "glosses": [
                                            "Lieu de travail.",
                                            "Espace, dans une usine, consacré à la production."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4031811d-3016-4a9f-bbbe-511f3cb9baa2",
                                                "sense_id": "b251fb61-0dd6-3000-82fd-07e79b54e711",
                                                "text": "La marbrerie de Givet, fondée en 1852, a maintenant une notable importance ; elle occupe 70 ouvriers tant aux ateliers qu'aux carrières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7475386-27eb-34f4-869b-1fc03fca28e5",
                                        "entry_id": "b33d5ef0-38cc-3027-b729-3bc7f4cc7b2b",
                                        "glosses": [
                                            "Lieu de travail.",
                                            "Lieu où travaille un artiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ec1a6c7-92cb-4ebc-a6a5-6abbc3ba20f3",
                                                "sense_id": "d7475386-27eb-34f4-869b-1fc03fca28e5",
                                                "text": "Dans le centre-ville, elle est heureuse comme un poisson dans l'eau. Elle a son petit atelier, un beau salon, une chambre et une minuscule cuisine qui lui suffit pour elle toute seule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3afbd449-865d-3185-a3bd-cb713a7a56b2",
                                        "entry_id": "b33d5ef0-38cc-3027-b729-3bc7f4cc7b2b",
                                        "glosses": [
                                            "Ensemble des travailleurs qui travaillent dans un atelier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f87770-780a-4d05-a743-9531260d308f",
                                                "sense_id": "3afbd449-865d-3185-a3bd-cb713a7a56b2",
                                                "text": "Atelier nombreux. — Chef d’atelier. — Tout l’atelier regrette son départ."
                                            },
                                            {
                                                "example_id": "3fb4fb8f-2f1f-42eb-966a-728a87629a59",
                                                "sense_id": "3afbd449-865d-3185-a3bd-cb713a7a56b2",
                                                "text": "C’est un homme qui fait bien aller un atelier, qui conduit bien un atelier."
                                            },
                                            {
                                                "example_id": "70ce9286-0e78-4c23-9ad3-d74ff185e563",
                                                "sense_id": "3afbd449-865d-3185-a3bd-cb713a7a56b2",
                                                "text": "Pour les travaux agricoles, les esclaves sont répartis en ateliers. Le grand atelier regroupe les esclaves voués aux travaux les plus durs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c3131d-3c8d-3dd7-902b-b2a38489e47b",
                                        "entry_id": "b33d5ef0-38cc-3027-b729-3bc7f4cc7b2b",
                                        "glosses": [
                                            "Ensemble des travailleurs qui travaillent dans un atelier.",
                                            "Réunion d’élèves travaillant sous un même maître, dans un atelier de peinture ou de sculpture."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e83e9964-8c0e-47f0-9030-467f544855aa",
                                                "sense_id": "e9c3131d-3c8d-3dd7-902b-b2a38489e47b",
                                                "text": "L’atelier de tel maître est le plus nombreux, le plus réputé."
                                            },
                                            {
                                                "example_id": "cf9d30e3-fc1c-4a12-a003-e021b201467d",
                                                "sense_id": "e9c3131d-3c8d-3dd7-902b-b2a38489e47b",
                                                "text": "La rivalité d’atelier produit l’émulation."
                                            },
                                            {
                                                "example_id": "80b098a3-4f27-4589-ae0a-4d1025457f8b",
                                                "sense_id": "e9c3131d-3c8d-3dd7-902b-b2a38489e47b",
                                                "text": "C’est un propos d’atelier, une farce d’atelier."
                                            },
                                            {
                                                "example_id": "4367a64e-9bad-47ea-9a31-ff735b0d48e4",
                                                "sense_id": "e9c3131d-3c8d-3dd7-902b-b2a38489e47b",
                                                "text": "Un travail d’atelier est un travail exécuté soit par des apprentis ou des élèves sous la direction d’un maître, ou d’après ses dessins."
                                            },
                                            {
                                                "example_id": "18424ba9-9e4c-4cb6-8c43-1469108cd820",
                                                "sense_id": "e9c3131d-3c8d-3dd7-902b-b2a38489e47b",
                                                "text": "Une œuvre anonyme est dite de l’atelier de tel maître lorsqu'elle a été faite par l’entourage immédiat ou sous la surveillance de ce maître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6eeb4a1-dfb8-3b1f-ad91-e3b16802c408",
                                        "entry_id": "b33d5ef0-38cc-3027-b729-3bc7f4cc7b2b",
                                        "glosses": [
                                            "Groupe de personnes réunies pour une période déterminée afin de mener une réflexion sur un sujet donné ou réaliser un projet commun."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa9eb3a-4696-4ef2-9d53-6a8d93a010ae",
                                                "sense_id": "a6eeb4a1-dfb8-3b1f-ad91-e3b16802c408",
                                                "text": "Un atelier de ressourcement personnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8bda2c3-4046-3800-b12b-76ce2b6d8171",
                                        "entry_id": "b33d5ef0-38cc-3027-b729-3bc7f4cc7b2b",
                                        "glosses": [
                                            "Loge."
                                        ],
                                        "tags": [
                                            "Franc-maçonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69423456-882a-45bd-8ebc-67158c3f6b1d",
                                                "sense_id": "a8bda2c3-4046-3800-b12b-76ce2b6d8171",
                                                "text": "Je déclare ouvert ce respectable atelier."
                                            }
