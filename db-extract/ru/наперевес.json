                                "example_id": "6b2a5f0d-366e-4ef4-b644-778bd2041609",
                                "sense_id": "8c5ab875-c72e-347b-afcc-e1c5e3e5f51a",
                                "text": "Они́ бы́стро напра́вились за мной, держа́ свои́ ру́жья напереве́с.",
                                "translation": "They quickly traveled behind me with their shotguns at the ready.",
                                "english": "They quickly traveled behind me with their shotguns at the ready."
                            },
                            {
                                "example_id": "1b8300e3-f79d-4b0d-be78-618ce38480da",
                                "sense_id": "8c5ab875-c72e-347b-afcc-e1c5e3e5f51a",
                                "text": "Так чу́вствуют себя́ лю́ди, кото́рые под огнём проти́вника — штыки́ напереве́с и́ли ша́шки на́голо — иду́т в ата́ку.",
                                "translation": "People under enemy fire feel this way — bayonets are pointed at you; sabres are unsheathed — and go to war.",
                                "english": "People under enemy fire feel this way — bayonets are pointed at you; sabres are unsheathed — and go to war."
                            }
                        ]
                    }
