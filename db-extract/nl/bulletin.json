                                "sense_id": "31b5a0de-618c-3693-a757-f8390adb7d60",
                                "text": "Ik luister voor ik ga fietsen altijd eerst naar het weersbulletin."
                            }
                        ]
                    },
                    {
                        "sense_id": "78ffeafe-3df3-3d59-ab8b-63baa60860b8",
                        "entry_id": "fc9797b3-91f6-3524-b3af-324c4780d79b",
