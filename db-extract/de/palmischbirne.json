                "senses": [
                    {
                        "sense_id": "7e363b58-3cb6-3967-b921-f50224d58313",
                        "entry_id": "eebcdbf8-3445-3336-a9de-a54845abd43b",
                        "glosses": [
                            "eine sehr alte Birnensorte der Kulturbirne, die meist als Baum auf Streuobstwiesen gepflegt wird. Palmischbirnen werden vor allen Dingen in Schwaben kultiviert."
                        ],
                        "tags": [
                            "Obstbau"
                        ],
                        "examples": [
                            {
                                "example_id": "9087cc72-ef7a-421d-90cf-d05c6961592c",
                                "sense_id": "7e363b58-3cb6-3967-b921-f50224d58313",
                                "text": "Aus Palmischbirnen kann man einen hervorragenden Birnenbrand herstellen."
                            },
                            {
                                "example_id": "572829b1-f3cd-49cc-b547-75d7a1781bcf",
                                "sense_id": "7e363b58-3cb6-3967-b921-f50224d58313",
                                "text": "Die Palmischbirne wurde 2005 zum Streuobst des Jahres in Baden-Württemberg gewählt."
                            },
                            {
                                "example_id": "94d5ec83-d953-4638-9b31-41adbe11b2ad",
                                "sense_id": "7e363b58-3cb6-3967-b921-f50224d58313",
                                "text": "\"Die Palmischbirne wird als typischer Streuobstwiesenbaum gepflegt und gilt unter Kennern als hervorragende Most- und Brennbirne.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
