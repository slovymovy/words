                ],
                "senses": [
                    {
                        "sense_id": "b944e43a-6c7e-3a69-9bed-c738d9ffbb95",
                        "entry_id": "b500ff34-b3b4-3309-a612-b7c3fae0fceb",
                        "glosses": [
                            "Faire un brushing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d2aad1-c371-4cf3-b21b-5481aa28cf42",
                                "sense_id": "b944e43a-6c7e-3a69-9bed-c738d9ffbb95",
                                "text": "Je n'ai malheureusement pas le temps de me brushinguer, surtout que ça aussi, ça accroit mon volume."
                            },
                            {
                                "example_id": "29eae624-781a-4ceb-9df1-9a6589c6d779",
                                "sense_id": "b944e43a-6c7e-3a69-9bed-c738d9ffbb95",
                                "text": "J'ai envie de brushinguer mes cheveux."
                            },
                            {
                                "example_id": "95af270e-ce22-4f7f-acc2-79cdaecacae2",
                                "sense_id": "b944e43a-6c7e-3a69-9bed-c738d9ffbb95",
                                "text": "Pour se préparer, tout le monde a été chez le coiffeur pour se babylisser les cheveux (ça veut dire les faire boucler comme les tifs des poupées), les brushinguer (indispensable si, comme moi, on a les cheveux qui, au naturel, ressemblent à de la laine de fer), ou simplement les coiffer."
                            }
                        ]
                    }
