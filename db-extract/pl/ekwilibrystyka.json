                                    },
                                    {
                                        "sense_id": "d8d0974b-0f5c-3297-a3b5-174ccbcc3866",
                                        "entry_id": "d5e8a5ba-80d6-35ba-b3c1-70d48ac2d9d8",
                                        "glosses": [
                                            "A spectacular display of agility."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cca7e26-037c-44dc-adb3-53733b865fd0",
                                                "sense_id": "d8d0974b-0f5c-3297-a3b5-174ccbcc3866",
                                                "text": "[…] he performs linguistic acrobatics, bringing a new sense of language into the theatre, combining lexiconic esoterica with street speech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e2f6648-1831-4d05-a4df-47c10cbf39ca",
                        "source_entry_id": "58ca1578-b8e5-33bc-bc5a-5dc45eeeabee",
                        "source_sense_id": "2abfd55b-1088-3f83-a516-621c97ebb52a",
                        "target_lang_word": "Äquilibristik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "801ff6f1-c645-4756-9c6e-d043cc1658f8",
                        "source_entry_id": "58ca1578-b8e5-33bc-bc5a-5dc45eeeabee",
                        "source_sense_id": "2abfd55b-1088-3f83-a516-621c97ebb52a",
                        "target_lang_word": "эквилибристика",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эквилибристика",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca1b25e-ba7c-33ef-86ac-a115eb4b2eb0",
                                        "entry_id": "be04e6c9-2ad4-3af0-93ec-66049f20c8c7",
                                        "glosses": [
                                            "цирковой жанр, искусство делать сложные акробатические упражнения, не теряя равновесия при неустойчивом положении тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "260cbc3a-076d-4afa-a178-52a7c454fe3b",
                                                "sense_id": "1ca1b25e-ba7c-33ef-86ac-a115eb4b2eb0",
                                                "text": "Не стоит описывать все чудеса эквилибристики, показанные акробатами и гимнастами труппы. Упражнения .. были исполнены с удивительной точностью."
                                            },
                                            {
                                                "example_id": "23e8d847-25f7-48c6-823d-86452a4c52fa",
                                                "sense_id": "1ca1b25e-ba7c-33ef-86ac-a115eb4b2eb0",
                                                "text": "В китайском цирке не выступают ни дрессированные животные, ни клоуны, но зато циркачи из Поднебесной — признанные кудесники в том, что касается акробатики, жонглирования и эквилибристики."
                                            },
                                            {
                                                "example_id": "f9521b3b-7789-4087-bd4a-a762366562dd",
                                                "sense_id": "1ca1b25e-ba7c-33ef-86ac-a115eb4b2eb0",
                                                "text": "Его выступлениям было свойственно смешение жанров: эквилибристика, клоунада, акробатика, жонглирование, буффонада — всё это включалось в номера Олега Константиновича [Попова]."
                                            },
                                            {
                                                "example_id": "a5f9b85a-38a1-4f4c-8d47-bc838d9cd683",
                                                "sense_id": "1ca1b25e-ba7c-33ef-86ac-a115eb4b2eb0",
                                                "text": "Впрочем, в цирке можно выступать в самых разнообразных жанрах: на выбор — акробатика, атлетика, гимнастика, дрессировка, клоунада, эквилибристика, жонглирование и др."
                                            },
                                            {
                                                "example_id": "d1c7f256-8715-40da-8836-833033ab0b15",
                                                "sense_id": "1ca1b25e-ba7c-33ef-86ac-a115eb4b2eb0",
                                                "text": "Другими постоянными жанрами того или иного представления в отечественном цирке являются акробатика (в том числе и воздушная), эквилибристика, музыкальная эксцентрика, дрессура и иллюзионизм."
                                            },
                                            {
                                                "example_id": "8fa7edc2-ce9a-4262-bba3-ccc3c075ef03",
                                                "sense_id": "1ca1b25e-ba7c-33ef-86ac-a115eb4b2eb0",
                                                "text": "Цирковыми артистами были его родители. Отец занимался эквилибристикой .."
                                            },
                                            {
                                                "example_id": "2df0c08f-6bce-4f08-bbd7-3743b180534e",
                                                "sense_id": "1ca1b25e-ba7c-33ef-86ac-a115eb4b2eb0",
                                                "text": "Традиции эквилибристики заложили сёстры Марта, Зоя и Клара Кох — первые артистки советского цирка, получившие звание заслуженных."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "282ea25b-4c3e-34a9-a484-260a0d62da99",
                                        "entry_id": "be04e6c9-2ad4-3af0-93ec-66049f20c8c7",
                                        "glosses": [
                                            "перен. поведение, характеризующееся необычайной изворотливостью в поведении, в спорах и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018c6ae7-6be8-4a4a-839b-ec0d027cf783",
                                                "sense_id": "282ea25b-4c3e-34a9-a484-260a0d62da99",
                                                "text": "— \"А эквилибристика, говорит, вот какая наука, чтоб перед начальником всегда в струне ходить, чтобы ноги у тебя были не усталые, чтоб когда начальство тебе говорит: «Кривляйся, Сашка!» — ну, и кривляйся! а «сиди, Сашка, смирно» — ну, смирно и сиди, ни единым суставом не шевели, а то неравно у начальства головка заболит."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
