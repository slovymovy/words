                "senses": [
                    {
                        "sense_id": "97a8c492-0557-339e-950c-15951140e22c",
                        "entry_id": "635a3476-b1fb-3e1a-a0f2-5c825d5aa750",
                        "glosses": [
                            "Doper à la caféine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d5d4763-4fd0-457f-adfe-ffb9394baf99",
                                "sense_id": "97a8c492-0557-339e-950c-15951140e22c",
                                "text": "Si tout le monde pouvait baptiser « coca-cola » les boissons qu'il fabrique, quelle catastrophe cela serait pour la grande multinationale qui caféinise et aspartamise des millions de gens dans le monde entier !"
                            },
                            {
                                "example_id": "a60aff22-f6ed-4dd5-a5bb-ddf4283a9de2",
                                "sense_id": "97a8c492-0557-339e-950c-15951140e22c",
                                "text": "Fini, le seul, le grand Nespresso et toutes ses clowneries (quelque 16 «grands crus») qui nous caféinise le palais depuis 1991."
                            },
                            {
                                "example_id": "d4ad964e-c479-4346-a3f5-afec0f92ee6d",
                                "sense_id": "97a8c492-0557-339e-950c-15951140e22c",
                                "text": "Belle journée encore, cette fois je file me caféiniser."
                            }
                        ]
                    }
