                {
                    "sense_id": "e6f1e8b6-4fb3-3467-b360-0c10583478e1",
                    "sense_definition": "A large cooking stove with multiple burners and ovens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She baked bread in the old iron <w>range</w>.",
                            "target_lang_translations": {
                                "ru": "Она испекла хлеб в старой чугунной <w>плите</w>.",
                                "tr": "Eski döküm <w>kuzinede</w> ekmek pişirdi.",
                                "zh": "她在旧铁制<w>炉灶</w>里烤了面包。"
                            }
                        },
                        {
                            "text": "The kitchen features a professional gas <w>range</w>.",
                            "target_lang_translations": {
                                "ru": "На кухне установлена профессиональная газовая <w>плита</w>.",
                                "tr": "Mutfakta profesyonel bir gazlı <w>ocak</w> bulunmaktadır.",
                                "zh": "厨房里配有一台专业的燃气<w>炉灶</w>。"
                            }
