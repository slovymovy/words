                "senses": [
                    {
                        "sense_id": "7cf6d601-d918-3c4d-8f40-3d1ad9f3eea6",
                        "entry_id": "2cc39b87-ff4b-30bf-87a7-421672f24b77",
                        "glosses": [
                            "Rendre (un médicament, un programme informatique) générique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1131a0d9-3a98-4738-b0f7-1cc8df59010e",
                                "sense_id": "7cf6d601-d918-3c4d-8f40-3d1ad9f3eea6",
                                "text": "Tout à fait, c’est un vieux médicament, génériqué, et en fait on se trouve à utiliser — voilà — une propriété qui était peu… qui avait peu été utilisée de ce médicament-là."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b27c981-5d04-3ab9-870f-f4af34849b1e",
                        "entry_id": "2cc39b87-ff4b-30bf-87a7-421672f24b77",
                        "glosses": [
                            "Remplacer (un médicament prescrit par le médecin) par un médicament générique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d27c975a-da8e-46e7-b8ec-d0ebce6fe178",
                                "sense_id": "9b27c981-5d04-3ab9-870f-f4af34849b1e",
                                "text": "C’est ce à quoi on est justement en train de travailler avec les médecins. Il faut que chacun contribue à faire des économies. Eux en prescrivant davantage de médicaments susceptibles d’être génériqués."
                            }
                        ]
                    }
