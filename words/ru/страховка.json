    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d54bae30-8bf8-321a-96c5-f6a194d6964a",
                    "sense_definition": "Разговорное название договора страхования (полиса) или самого процесса защиты имущества, здоровья и жизни.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "insurance_doc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для получения визы мне нужна медицинская <страховка>.",
                            "target_lang_translations": {
                                "en": "I need medical <insurance> to get a visa.",
                                "es": "Para obtener el visado necesito un <seguro> médico.",
                                "fr": "J'ai besoin d'une <assurance> médicale pour obtenir un visa."
                            }
                        },
                        {
                            "text": "Водитель обязан всегда иметь при себе права и <страховку> на машину.",
                            "target_lang_translations": {
                                "en": "A driver is required to always carry their license and car <insurance>.",
                                "es": "El conductor está obligado a llevar siempre consigo el carné de conducir y el <seguro> del coche.",
                                "fr": "Le conducteur doit toujours avoir sur lui son permis et l'<assurance> automobile."
                            }
                        }
                    ],
                    "synonyms": [
                        "страхование"
                    ],
                    "common_phrases": [
                        "медицинская страховка",
                        "оформить страховку",
                        "страховка на машину",
                        "без страховки"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Colloquial term for an insurance policy or the insurance process itself.",
                        "es": "Término coloquial para un contrato de seguro (póliza) o el proceso de protección de bienes, salud y vida.",
                        "fr": "Terme familier pour désigner un contrat d'assurance (police) ou le processus de protection des biens, de la santé et de la vie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insurance",
                                "target_lang_sense_clarification": "general concept or the policy"
                            },
                            {
                                "target_lang_word": "insurance policy",
                                "target_lang_sense_clarification": "specific document"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "seguro",
                                "target_lang_sense_clarification": "concepto general o contrato"
                            },
                            {
                                "target_lang_word": "póliza de seguro",
                                "target_lang_sense_clarification": "documento específico"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "assurance",
                                "target_lang_sense_clarification": "concept général ou contrat d'assurance"
                            },
                            {
                                "target_lang_word": "police d'assurance",
                                "target_lang_sense_clarification": "document officiel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce99feb9-d88c-3a3b-b512-3ed7ee70d654",
                    "sense_definition": "Денежная сумма, выплачиваемая страховой компанией при наступлении страхового случая.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insurance_money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После пожара семья получила крупную <страховку> и смогла восстановить дом.",
                            "target_lang_translations": {
                                "en": "After the fire, the family received a large <insurance payout> and was able to restore the house.",
                                "es": "Después del incendio, la familia recibió una gran <indemnización> del seguro y pudo reconstruir la casa.",
                                "fr": "Après l'incendie, la famille a reçu une importante <indemnité d'assurance> et a pu reconstruire la maison."
                            }
                        },
                        {
                            "text": "Он надеялся получить <страховку>, но компания отказала в выплате.",
                            "target_lang_translations": {
                                "en": "He hoped to receive the <insurance money>, but the company refused to pay.",
                                "es": "Él esperaba cobrar el <dinero del seguro>, pero la compañía se negó a pagar.",
                                "fr": "Il espérait toucher l'<argent de l'assurance>, mais la compagnie a refusé de payer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "получить страховку",
                        "выплата страховки"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A sum of money paid by an insurance company when an insured event occurs.",
                        "es": "Suma de dinero pagada por una compañía de seguros al ocurrir un siniestro.",
                        "fr": "Somme d'argent versée par une compagnie d'assurance lors de la survenance d'un sinistre."
                    },
                    "translations": {
