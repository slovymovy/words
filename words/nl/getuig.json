    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34a70bb4-5b57-3833-b6dc-482552cd440e",
                    "sense_definition": "Toebehoren om een last- of rijdier op te tuigen, klaar te maken om een kar te trekken, of om bereden te worden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer legde het zware <w>getuig</w> op de rug van het paard.",
                            "target_lang_translations": {
                                "en": "The farmer placed the heavy <w>harness</w> on the horse's back."
                            }
                        },
                        {
                            "text": "Zonder het juiste <w>getuig</w> kan de ezel de kar niet trekken.",
                            "target_lang_translations": {
                                "en": "Without the proper <w>tack</w>, the donkey cannot pull the cart."
                            }
                        }
                    ],
                    "synonyms": [
                        "harnas",
                        "tuig"
                    ],
                    "common_phrases": [
                        "het getuig van het paard"
                    ],
                    "target_lang_definitions": {
                        "en": "Accessories used to harness a draft or riding animal, preparing it to pull a cart or to be ridden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "harness",
                                "target_lang_sense_clarification": "for draft or riding animals"
                            },
                            {
                                "target_lang_word": "tack",
                                "target_lang_sense_clarification": "riding equipment"
                            },
                            {
                                "target_lang_word": "gear",
                                "target_lang_sense_clarification": "general equipment for animals"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42b80ea6-951f-39b5-872f-3906632f618d",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>getuigen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>getuig</w> vandaag in de rechtbank over het ongeluk dat ik zag.",
                            "target_lang_translations": {
                                "en": "Today, I <w>testify</w> in court about the accident I saw."
                            }
                        },
                        {
                            "text": "Als burger <w>getuig</w> ik altijd naar waarheid.",
                            "target_lang_translations": {
                                "en": "As a citizen, I always <w>bear witness</w> truthfully."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'getuigen' (to testify, bear witness)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "testify",
                                "target_lang_sense_clarification": "first-person singular present"
                            },
                            {
                                "target_lang_word": "bear witness",
                                "target_lang_sense_clarification": "first-person singular present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7402ce79-180d-390d-8023-77e7e4953ce5",
                    "sense_definition": "Gebiedende wijs van <w>getuigen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Getuig</w> nu voor de rechter en vertel de hele waarheid!",
                            "target_lang_translations": {
                                "en": "<w>Testify</w> before the judge now and tell the whole truth!"
                            }
                        },
                        {
                            "text": "Wees niet bang en <w>getuig</w> van wat je die avond hebt gehoord.",
                            "target_lang_translations": {
                                "en": "Do not be afraid and <w>bear witness</w> to what you heard that night."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'getuigen' (to testify, bear witness)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "testify",
                                "target_lang_sense_clarification": "imperative command"
                            },
                            {
                                "target_lang_word": "bear witness",
                                "target_lang_sense_clarification": "imperative command"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95d50a51-3393-320e-8a5f-0404e6108c7b",
                    "sense_definition": "Inversievorm of tweede persoon enkelvoud tegenwoordige tijd van <w>getuigen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>getuig</w> je niet gewoon over wat er echt is gebeurd?",
                            "target_lang_translations": {
                                "en": "Why don't you just <w>testify</w> about what really happened?"
                            }
                        },
                        {
                            "text": "Als je de waarheid kent, <w>getuig</w> je hopelijk snel.",
                            "target_lang_translations": {
                                "en": "If you know the truth, hopefully you will <w>testify</w> soon."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tweede persoon enkelvoud tegenwoordige tijd bij inversie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inversion form or second-person singular present tense of 'getuigen' (to testify, bear witness)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "testify",
                                "target_lang_sense_clarification": "second-person singular present"
                            },
                            {
                                "target_lang_word": "bear witness",
                                "target_lang_sense_clarification": "second-person singular present"
                            }
                        ]
                    }
                }
            ]
        }
    ]
