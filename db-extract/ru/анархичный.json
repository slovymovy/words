                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68b43748-a933-43ed-a146-816432337888",
                        "source_entry_id": "e8cfb036-03a8-335b-a435-2e134662f13d",
                        "source_sense_description": "связанный с идеологией",
                        "target_lang_word": "anarchiczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anarchiczny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d591a5ad-f00f-30d3-8f9a-3168cc5cba6a",
                                        "entry_id": "9238426c-650b-3278-bf25-a7bd706d3ca6",
                                        "glosses": [
                                            "związany z anarchią"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02298034-10fd-4a82-a538-7d113a86b723",
                                                "sense_id": "d591a5ad-f00f-30d3-8f9a-3168cc5cba6a",
                                                "text": "Gorący i żywy temperament włoski, podniecony teoryą anarchiczną, rwał się do czynów, a że stosunki rolnicze w niektórych częściach Włoch są okropne, wybuchły więc tu i ówdzie poruszenia agrarne, a nawet większe ruchy powstańcze, z których najważniejsze były: w r. 1874 w Bolonii i w 1876 w Benevencie. Gorączka ta jednak anarchiczna zaczęła rychło przechodzić"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f7f4ccc-f097-4ecc-b4af-db84f1994269",
                        "source_entry_id": "e8cfb036-03a8-335b-a435-2e134662f13d",
                        "source_sense_description": "связанный с идеологией",
                        "target_lang_word": "anarchique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anarchique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf55f9c9-1da2-3218-91ab-37ba369a1c7a",
                                        "entry_id": "a8d23532-a922-32c9-9c53-7dde80a9e75c",
                                        "glosses": [
                                            "Qui tient de l’anarchie."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e95e917e-facf-440d-a13f-0ea59420f0b8",
                                                "sense_id": "cf55f9c9-1da2-3218-91ab-37ba369a1c7a",
                                                "text": "Le rêve anarchique est sûrement le plus haut, le plus fier, et quelle douceur de s’abandonner à l’espoir de cette harmonie de la vie qui, d’elle-même, livrée à ses forces naturelles, créerait le bonheur !"
                                            },
                                            {
                                                "example_id": "59d1b2d0-025f-4dc4-8ff3-731d982fa0f0",
                                                "sense_id": "cf55f9c9-1da2-3218-91ab-37ba369a1c7a",
                                                "text": "Cette gravité de l’œuvre poursuivie par le prolétariat ne saurait convenir à la clientèle jouisseuse de nos politiciens ; ceux-ci veulent rassurer la bourgeoisie et lui promettent de ne pas laisser le peuple s’abandonner à ses instincts anarchiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e24cdf4-2344-3c4b-907e-e4b359e52e8d",
                                        "entry_id": "a8d23532-a922-32c9-9c53-7dde80a9e75c",
                                        "glosses": [
                                            "Qui est dans un grand désordre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ae35cb-744a-4f5c-acb8-1e60448dda59",
                                                "sense_id": "3e24cdf4-2344-3c4b-907e-e4b359e52e8d",
                                                "text": "Ce pays est dans un état anarchique."
                                            },
                                            {
                                                "example_id": "20ba8166-76a9-481c-b0f2-e0e2ffc0b433",
                                                "sense_id": "3e24cdf4-2344-3c4b-907e-e4b359e52e8d",
                                                "text": "Athènes eut trop souvent un gouvernement anarchique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "d880f3ec-59d6-4443-9e5c-f1fa7051bfc9",
