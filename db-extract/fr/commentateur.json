                        "target_lang_word": "pundit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pundit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e266676-aaf4-31ad-b6bc-adc351677c9a",
                                        "entry_id": "c47fc665-5d2d-3d5f-8902-e013803d11f7",
                                        "glosses": [
                                            "An expert in a particular field, especially as called upon to provide comment or opinion in the media; a commentator, a critic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f631642f-0ed3-4d46-930a-f9fdb2abb50c",
                                                "sense_id": "5e266676-aaf4-31ad-b6bc-adc351677c9a",
                                                "text": "This week we introduce Jenny Walker, who will be The Observer's expert pundit for the duration of the World Cup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "892f7c6d-b616-3921-a01f-9f6ec0c790e4",
                                        "entry_id": "c47fc665-5d2d-3d5f-8902-e013803d11f7",
                                        "glosses": [
                                            "A learned person in India; someone with knowledge of Sanskrit, philosophy, religion and law; a Hindu scholar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afcf60e5-f55c-4ddb-ac2d-404a120a121a",
                                                "sense_id": "892f7c6d-b616-3921-a01f-9f6ec0c790e4",
                                                "text": "Pundits in black gowns, with spectacles on their noses and undigested wisdom in their insides; bearded headmen of the wards; [...] all these people and more also you might find in the white room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f842758-7af3-374f-9571-4964c94264bd",
                                        "entry_id": "c47fc665-5d2d-3d5f-8902-e013803d11f7",
                                        "glosses": [
                                            "A native surveyor in British India, trained to carry out clandestine surveillance beyond British borders."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95ae25ef-c1a6-4cb7-b7ba-72fd98ee9f82",
                                                "sense_id": "8f842758-7af3-374f-9571-4964c94264bd",
                                                "text": "At every hundredth pace the Pundit would automatically slip one bead. Each complete circuit of the rosary thus represented ten thousand paces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
