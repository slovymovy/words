                                "target_senses": [
                                    {
                                        "sense_id": "3df57675-0302-3eaf-8cf8-ff710a54164f",
                                        "entry_id": "eab814a8-9852-3915-88ae-55967115a1d7",
                                        "glosses": [
                                            "πόλη ή κράτος ή περιοχή που ιδρύεται από άλλη πόλη ή κράτος σε μακρινό τόπο"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0189f07d-532b-408e-b043-e7c33ca83a50",
                                                "sense_id": "3df57675-0302-3eaf-8cf8-ff710a54164f",
                                                "text": "※ 2002 Ρούσσος Βρανάς, Η άχρονη χώρα, εκδ. Ποταμός, 2002, σελ. 22",
                                                "translation": "Η εμμονή εκείνων των συγγραφέων στην πυραυλική τεχνολογία και τα διαστημικά ταξίδια αποδείχθηκε άστοχη. Η προσσελήνωση δεν οδήγησε πουθενά. Δεν υπάρχουν γήινες αποικίες ούτε στη Σελήνη ούτε στον Άρη. Ύστερα από μισόν αιώνα ραγδαίας τεχνολογικής προόδου, ο «homo sapiens» παραμένει καθηλωμένος στη Γη."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cab94aae-53d3-3190-ba37-b29cc2f0f058",
                                        "entry_id": "eab814a8-9852-3915-88ae-55967115a1d7",
                                        "glosses": [
                                            "νέα πόλη που ιδρύεται σε ξένη γη από κατοίκους μιας άλλης πόλης (της μητρόπολης) που μετακινούνται οργανωμένα για τον σκοπό αυτό· η νέα πόλη ήταν ανεξάρτητο κράτος, που διατηρούσε όμως θρησκευτικούς και συναισθηματικούς δεσμούς με την μητρόπολή της"
                                        ],
                                        "tags": [
                                            "ιστορία",
                                            "στην αρχαία ιστορία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8765c110-ef48-450a-ae44-1c1095f2e113",
                                                "sense_id": "cab94aae-53d3-3190-ba37-b29cc2f0f058",
                                                "text": "Οι Συρακούσες της Σικελίας ήταν αποικία των Κορινθίων."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd9ac29-791d-3da4-9e8d-88d5ad15b67f",
                                        "entry_id": "eab814a8-9852-3915-88ae-55967115a1d7",
                                        "glosses": [
                                            "χώρα εκτός Ευρώπης που κατακτήθηκε από ευρωπαϊκό κράτος και εγκαταστάθηκαν σ' αυτήν Ευρωπαίοι κάτοικοι, οι οποίοι είτε βαθμιαία έγιναν η πλειοψηφία του πληθυσμού είτε παρέμειναν μειοψηφία κρατώντας όμως στα χέρια τους την διοίκηση και τις πλουτοπαραγωγικές πηγές ως εκπρόσωποι της χώρας καταγωγής τους"
                                        ],
                                        "tags": [
                                            "ιστορία",
                                            "στην νεότερη ιστορία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd8f6752-670a-4d48-bdc1-f9afd5cade21",
                                                "sense_id": "6cd9ac29-791d-3da4-9e8d-88d5ad15b67f",
                                                "text": "Η Μοζαμβίκη ήταν αποικία της Πορτογαλίας μέχρι το 1975."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a2f444-5836-3928-b778-98c558f7ef15",
                                        "entry_id": "eab814a8-9852-3915-88ae-55967115a1d7",
                                        "glosses": [
                                            "πολυκυτταρικός οργανισμός χωρίς δομή, ή με πολύ απλοϊκή δομή"
                                        ],
                                        "tags": [
                                            "βιολογία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c064f7b-72a8-4aec-a12c-083c043fe763",
                                                "sense_id": "91a2f444-5836-3928-b778-98c558f7ef15",
                                                "text": "Θεωρητικά μια αποικία κυττάρων δεν αποτελείται από επιμέρους οργανίδια, όμως εκτενέστερες μελέτες απέδειξαν ότι το όριο μεταξύ αποικιών και σύνθετων οργανισμών δεν είναι σαφώς διακριτό."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
