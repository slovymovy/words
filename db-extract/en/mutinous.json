                                    {
                                        "sense_id": "704dbb0d-4968-3098-b656-343876a7f657",
                                        "entry_id": "9a6d74a9-5f74-3d9d-8960-273dc3df0c9b",
                                        "glosses": [
                                            "Espiègle, badin, moqueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7cfdd4-c487-4bd5-984f-79827ace5775",
                                                "sense_id": "704dbb0d-4968-3098-b656-343876a7f657",
                                                "text": "La vie et la jeunesse étalaient leurs trésors sur ce visage mutin."
                                            },
                                            {
                                                "example_id": "3deec970-5b29-49f1-8010-6cf94cbf5b51",
                                                "sense_id": "704dbb0d-4968-3098-b656-343876a7f657",
                                                "text": "La seconde personne était une jeune fille ou plutôt une enfant de quinze ans, à la mine mutine et éveillée, au nez retroussé et au regard hardi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00e16b9b-025a-333f-83a9-b46fbcdcf663",
                                        "entry_id": "9a6d74a9-5f74-3d9d-8960-273dc3df0c9b",
                                        "glosses": [
                                            "Qui est séditieux, révolté, qui participe à une mutinerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "badfffc5-483d-47a8-9440-cb02d7157400",
                                                "sense_id": "00e16b9b-025a-333f-83a9-b46fbcdcf663",
                                                "text": "Arrivé rue des Cuirassiers les soldats firent entendre raison aux mutins […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mutin",
