                {
                    "sense_id": "b5dd1483-3050-3f99-b0ed-7302181428bb",
                    "sense_definition": "Abattre ou capturer un animal sauvage dans le cadre de la chasse ou de la régulation des espèces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les gardes forestiers peuvent <w>prélever</w> du gibier pour réguler la population locale.",
                            "target_lang_translations": {
                                "en": "Forest wardens may <w>cull</w> game to regulate the local population.",
                                "ru": "Лесники могут <w>отстреливать</w> дичь, чтобы регулировать численность местной популяции.",
                                "de": "Die Wildhüter können Wild <w>abschießen</w>, um den örtlichen Bestand zu regulieren.",
                                "es": "Los guardabosques pueden <w>abatir</w> piezas de caza para regular la población local.",
                                "zh": "护林员可以<w>捕杀</w>部分野生动物，以调节当地的种群数量。"
                            }
                        },
                        {
                            "text": "Durant la dernière saison, les chasseurs ont <w>prélevé</w> plusieurs cerfs dans cette forêt.",
                            "target_lang_translations": {
                                "en": "During the last season, hunters <w>shot</w> several deer in this forest.",
                                "ru": "В прошлом сезоне охотники <w>добыли</w> несколько оленей в этом лесу.",
                                "de": "In der letzten Jagdsaison haben die Jäger in diesem Wald mehrere Hirsche <w>erlegt</w>.",
                                "es": "Durante la última temporada, los cazadores <w>abatieron</w> varios ciervos en este bosque.",
                                "zh": "上个狩猎季，猎人在这片森林里<w>猎杀</w>了好几头鹿。"
                            }
                        }
