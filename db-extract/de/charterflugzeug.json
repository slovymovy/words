                            {
                                "example_id": "d417720f-727b-4bcc-ac68-92ae849589bc",
                                "sense_id": "229dda83-0353-36e1-91b2-79abfba5f49a",
                                "text": "Wir haben einenCharterflugzeug von Berlin nach Paris.",
                                "translation": "Nous avons un avion charter de Berlin à Paris."
                            },
                            {
                                "example_id": "06f24197-5ad9-4e5a-81ce-409918b4b974",
                                "sense_id": "229dda83-0353-36e1-91b2-79abfba5f49a",
                                "text": "Ein Charterflugzeug mit mehr als 140 Südkoreanern und chinesischen Familienangehörigen aus Wuhan an Bord traf am Mittwochmorgen (Ortszeit) in Seoul ein, wie südkoreanische TV-Sender berichteten."
                            }
                        ]
                    }
