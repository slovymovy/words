                        "entry_id": "20adc629-08de-35bb-9a09-0d09bd25c141",
                        "glosses": [
                            "A televised debate or discussion with the leaders of the major political parties."
                        ],
                        "tags": [
                            "feminine",
                            "informal"
                        ],
                        "examples": [
