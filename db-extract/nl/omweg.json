                "senses": [
                    {
                        "sense_id": "7aa17676-cd5d-37a9-a90f-872a1e611f6d",
                        "entry_id": "6e8e7227-9f25-3064-81d7-3d94b6a88973",
                        "glosses": [
                            "de weg die langer is dan de gewone of kortste verbinding tussen twee plaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43679322-10f8-4fbb-bd9d-196066bdb67e",
                                "sense_id": "7aa17676-cd5d-37a9-a90f-872a1e611f6d",
                                "text": "Omdat de weg ten gevolge van een ongeluk was afgesloten, moest men een omweg maken om op de plaats van bestemming te komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f85f87b9-ac03-3968-be38-d6bdecf68395",
                        "entry_id": "6e8e7227-9f25-3064-81d7-3d94b6a88973",
                        "glosses": [
                            "een weg die om een obstakel heen gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c04692a-cad6-4b64-af66-53779ba942c2",
                                "sense_id": "f85f87b9-ac03-3968-be38-d6bdecf68395",
                                "text": "Ik laat het meestal helemaal aan hen over, soms springen ze over de gevallen bomen, soms moeten we helemaal terug om een omweg te vinden.’ Hij stak weer een peuk op en het bleef opeens stil."
                            }
                        ]
                    },
                    {
                        "sense_id": "94d68bbc-97a4-3933-a7c7-db1f5e713875",
                        "entry_id": "6e8e7227-9f25-3064-81d7-3d94b6a88973",
                        "glosses": [
                            "nodeloze omhaal van woorden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aec00988-ab42-43a3-bdd5-4c18829a217a",
                                "sense_id": "94d68bbc-97a4-3933-a7c7-db1f5e713875",
                                "text": "Met veel omwegen trachtte de man zijn plannen duidelijk te maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "252c2861-d51c-4866-911f-f8e4975b1471",
                        "source_entry_id": "6e8e7227-9f25-3064-81d7-3d94b6a88973",
                        "source_sense_id": "7aa17676-cd5d-37a9-a90f-872a1e611f6d",
                        "source_sense_description": "de weg die langer is dan de gewone of kortste verbinding tussen twee plaatsen",
                        "target_lang_word": "Umweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77384df6-ecdd-3c55-94aa-21fb9bc2d67d",
                                        "entry_id": "f7622b0f-7113-3ebc-a6b4-10c310098d67",
                                        "glosses": [
                                            "Weg, der nicht direkt, sondern um etwas herum zum Ziel führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103fd96e-e3c0-443a-9e63-d86dc9b71dc3",
                                                "sense_id": "77384df6-ecdd-3c55-94aa-21fb9bc2d67d",
                                                "text": "»Aber auf dem seltsamsten Umwege kam ein deutscher Handwerksbursche in Amsterdam durch den Irrtum zur Wahrheit und zu ihrer Erkenntnis«."
                                            },
                                            {
                                                "example_id": "e13e4f55-efaa-442e-b23c-59c61f771a56",
                                                "sense_id": "77384df6-ecdd-3c55-94aa-21fb9bc2d67d",
                                                "text": "„Nur auf Umwegen lässt sich mitunter eine Lineatur des Sinns nacherzählen, bis an unverhoffter Stelle das Blau aufblitzt und erst im Zusammenhang seine Bedeutsamkeit preisgibt.“"
                                            },
                                            {
                                                "example_id": "964f313a-cc2d-4142-bc51-5689e948a057",
                                                "sense_id": "77384df6-ecdd-3c55-94aa-21fb9bc2d67d",
                                                "text": "„Wir verließen die Stadt auf Umwegen.“"
                                            },
                                            {
                                                "example_id": "79e0a888-16bd-4612-8e11-e8efae52454b",
                                                "sense_id": "77384df6-ecdd-3c55-94aa-21fb9bc2d67d",
                                                "text": "„Nach einigen Umwegen kamen wir in eine ziemlich lange laubüberdachte Allee, an die sich auf halbem Weg eine Art Kammer mit Rasensitzen in den verschiedensten Formen anschloß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62a10ced-ed3c-4c9c-9d8e-a92c6dea7192",
                        "source_entry_id": "6e8e7227-9f25-3064-81d7-3d94b6a88973",
