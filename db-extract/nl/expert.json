                "senses": [
                    {
                        "sense_id": "1cff4602-77dc-3400-999e-3c766c82c83b",
                        "entry_id": "88521b16-102e-3ce9-a943-278c0f789086",
                        "glosses": [
                            "iemand die bijzonder goed bekend is met een bepaald onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba9ecc6-7deb-4004-ba7f-19620ebe77f6",
                                "sense_id": "1cff4602-77dc-3400-999e-3c766c82c83b",
                                "text": "Hij is een echte expert op dit gebied."
                            },
                            {
                                "example_id": "722a21d3-a8e6-4c56-8446-bd548f8a7adf",
                                "sense_id": "1cff4602-77dc-3400-999e-3c766c82c83b",
                                "text": "Dus waarom niet leren blowen tussen experts? Ik nam een paar trekken van de splif na mijn bistromaaltijd, maar er gebeurde niets. Waarschijnlijk verwachtte ik er te veel van."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed0bb41e-e76a-469e-a0cc-085205b02aeb",
                        "source_entry_id": "88521b16-102e-3ce9-a943-278c0f789086",
                        "source_sense_id": "1cff4602-77dc-3400-999e-3c766c82c83b",
                        "source_sense_description": "iemand die bijzonder goed bekend is met een bepaald onderwerp",
                        "target_lang_word": "Experte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Experte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                        "entry_id": "fb3abdc5-7830-3191-8c3d-0441b89adb7f",
                                        "glosses": [
                                            "Person, die in einem bestimmten Gebiet beziehungsweise in einem Fach sehr bewandert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "470f727a-b3b8-4870-8479-c94f7b560129",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "Er weiß einfach alles über Musik. Er ist ein absoluter Experte in dem Fach."
                                            },
                                            {
                                                "example_id": "60cc6e98-460b-4b19-858d-52da6dc5dc61",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "Er ist ein Experte in Rotordynamik."
                                            },
                                            {
                                                "example_id": "a0cd7b70-efd1-4df8-93ab-c2576c946b58",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "„Georg Ried ist seit vielen Jahren ein gefragter Experte in Sachen Blasmusik.“"
                                            },
                                            {
                                                "example_id": "26ea39ff-5f08-495c-81da-0945fda3e9e0",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "„Deswegen leisten sich viele Unternehmen, die im Netz noch bessere Geschäfte machen wollen, Experten für die Suchmaschinenoptimierung (SEO).“"
                                            },
                                            {
                                                "example_id": "d06abcc6-cb1f-4479-b913-a2a806508a04",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "„Zahlreiche Experten aus den verschiedensten Fachbereichen formulierten Gründe für die Ursachen.“"
                                            },
                                            {
                                                "example_id": "e9b0cec3-335d-4e23-8b90-13b019d82d18",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "„Und Leipzig begann erst nach der Verpflichtung des Krisenmanagers Peter Zühlsdorff, die wenigen deutschen Experten mit einzubeziehen.“"
                                            },
                                            {
                                                "example_id": "1b520a22-11b9-4ed5-81bf-14fc658cb3de",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "„Ende September trafen sich Experten für freie Software aus ganz Europa in Brüssel.“"
                                            },
                                            {
                                                "example_id": "8a07ecdb-24f3-4f8b-8798-0394cfa579cf",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "„Einige Experten sprechen dem Protokoll die zugesicherten Merkmale jedoch teils ab.“"
                                            },
                                            {
                                                "example_id": "f4686752-eab7-477b-9aa9-b4ee6c5f3738",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "„[…] während der gesamten Veranstaltung [besteht] die Möglichkeit, an Infoständen direkt Kontakt zu Experten aufzunehmen.“"
                                            },
                                            {
                                                "example_id": "98246b5b-6dc8-48b2-91bf-60796c10ae8f",
                                                "sense_id": "c38dcb24-a733-3f65-95c2-026e6e1726e3",
                                                "text": "„Sie reinigen Wasser: Schwermetalle, Öle, Fette - Verschmutzungen, bei denen andere kapitulieren, kriegen die Experten der Firma H2O wieder weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9870afc-b236-4aca-9d04-abab1d48fd9f",
                        "source_entry_id": "88521b16-102e-3ce9-a943-278c0f789086",
