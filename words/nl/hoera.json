                    "sense_id": "0b554eb5-b7a3-3874-bb6c-a77651ef09b8",
                    "sense_definition": "Een uitroep van vreugde om iets te vieren, bijvoorbeeld een verjaardag of overwinning.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hoera</w>! Ik ben vandaag eindelijk jarig.",
                            "target_lang_translations": {
                                "en": "<w>Hooray</w>! It's finally my birthday today.",
                                "ru": "<w>Ура</w>! У меня сегодня наконец-то день рождения.",
                                "pl": "<w>Hura</w>! W końcu mam dzisiaj urodziny.",
                                "de": "<w>Hurra</w>! Ich habe heute endlich Geburtstag.",
                                "fr": "<w>Houra</w> ! C'est enfin mon anniversaire aujourd'hui.",
                                "it": "<w>Evviva</w>! Oggi è finalmente il mio compleanno.",
                                "cs": "<w>Hurá</w>! Dnes mám konečně narozeniny.",
                                "tr": "<w>Yaşasın</w>! Bugün nihayet doğum günüm.",
                                "es": "<w>¡Hurra</w>! Por fin es mi cumpleaños hoy.",
                                "zh": "<w>万岁</w>！我今天终于过生日了。"
                            }
                        },
                        {
                            "text": "We hebben de wedstrijd gewonnen, <w>hoera</w>!",
                            "target_lang_translations": {
                                "en": "We won the match, <w>hooray</w>!",
                                "ru": "Мы выиграли матч, <w>ура</w>!",
                                "pl": "Wygraliśmy mecz, <w>hura</w>!",
                                "de": "Wir haben das Spiel gewonnen, <w>hurra</w>!",
                                "fr": "Nous avons gagné le match, <w>houra</w> !",
                                "it": "Abbiamo vinto la partita, <w>evviva</w>!",
                                "cs": "Vyhráli jsme zápas, <w>hurá</w>!",
                                "tr": "Maçı kazandık, <w>yaşasın</w>!",
                                "es": "Hemos ganado el partido, <w>¡hurra</w>!",
                                "zh": "我们赢了比赛，<w>万岁</w>！"
                            }
                        }
                    ],
                    "synonyms": [
                        "hoeree",
                        "joepie"
