            {
                "entry_id": "0cde378c-5f3b-36f4-972b-ad528124dccd",
                "word": "Dada",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "63302d01-90c7-3ae4-9c70-5eca7f8415f8",
                        "entry_id": "0cde378c-5f3b-36f4-972b-ad528124dccd",
                        "glosses": [
                            "A cultural movement that began in Zürich, Switzerland during and as a reaction to World War I and peaked from 1916 to 1920, which primarily involved visual arts, literature (mainly poetry), theatre, and graphic design, and was characterized by deliberate irrationality, disillusionment, cynicism, nihilism, randomness, and rejection of the prevailing standards in art."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f719e833-f89b-41f6-a5ea-5d44d804ff54",
                                "sense_id": "63302d01-90c7-3ae4-9c70-5eca7f8415f8",
                                "text": "Ironically enough, it was the anti-war stirrings of Dada that bore out its most immediate influence, first in Switzerland and then post-war Berlin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfe14075-6118-448d-888d-43db0c1a49d7",
                        "source_entry_id": "0cde378c-5f3b-36f4-972b-ad528124dccd",
                        "source_sense_id": "63302d01-90c7-3ae4-9c70-5eca7f8415f8",
                        "source_sense_description": "cultural movement — see also dadaism",
                        "target_lang_word": "dadaismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "eefc0977-8f83-47fa-b6c9-cff5bc85f052",
                        "source_entry_id": "0cde378c-5f3b-36f4-972b-ad528124dccd",
                        "source_sense_id": "63302d01-90c7-3ae4-9c70-5eca7f8415f8",
                        "source_sense_description": "cultural movement — see also dadaism",
                        "target_lang_word": "dadaïsme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dadaïsme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4596bc-285e-3311-bc10-4076f2a76747",
                                        "entry_id": "99c93a1a-bd78-3faa-85e6-8b58c693ca6c",
                                        "glosses": [
                                            "kunststroming ontstaan in 1916, die alle betrekking tussen de gedachte en de uitdrukking ervan wilde opheffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59efb35a-250d-4e6c-921b-7de5357fcc67",
                                                "sense_id": "8f4596bc-285e-3311-bc10-4076f2a76747",
                                                "text": "In de omringende landen was er al sinds de jaren twintig van de vorige eeuw een opleving gaande: er waren daar stromingen zoals het dadaïsme, dat in Nederland nog niet echt was 'aangeslagen'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
