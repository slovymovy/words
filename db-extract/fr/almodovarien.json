                        "glosses": [
                            "Relatif à Pedro Almodóvar, à son cinéma."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15426db1-2e38-486d-91c8-4f6e2310ab01",
                                "sense_id": "4c27f8a8-bd0b-3d05-b597-9179aaa9e6eb",
                                "text": "Usant du flash-back, jouant du gros plan, cassant les règles, manifestant un sens du cadrage impressionnant et un rythme d’enfer, fer de lance d’une bonne comédie, usant de couleurs almodovariennes."
                            }
                        ]
                    }
