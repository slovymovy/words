                        "target_lang_word": "reine mère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reine mère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7aeeb7-2175-3e2d-b355-1b86cf00d4cf",
                                        "entry_id": "a9b6b3de-7759-3bb9-89c2-d3a67ad2771f",
                                        "glosses": [
                                            "Titre donné à la veuve d’un roi, lorsque l’un de leurs enfants communs est le monarque régnant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caced283-586b-4351-958e-e7e8b375e262",
                                                "sense_id": "ea7aeeb7-2175-3e2d-b355-1b86cf00d4cf",
                                                "text": "Catherine de Médicis était seule, assise près d’une table, le coude appuyé sur un livre d’heures entr’ouvert, et la tête posée sur sa main encore remarquablement belle, grâce au cosmétique que lui fournissait le Florentin René, qui réunissait la double charge de parfumeur et d’empoisonneur de la reine mère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f08e592-6895-3603-ad6a-64beefa89b14",
                                        "entry_id": "a9b6b3de-7759-3bb9-89c2-d3a67ad2771f",
                                        "glosses": [
                                            "Femme à laquelle l'âge et l'apparence confèrent une certaine prestance et une apparente autorité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "847e27d2-a37f-4000-8d2f-822f18fd858f",
                                                "sense_id": "9f08e592-6895-3603-ad6a-64beefa89b14",
                                                "text": "Et les joues avaient simplement séché, coupées de profondes rides symétriques, qui donnaient à la physionomie une grande noblesse, cet air souverain de reine mère, qu’elle conservait en se livrant aux plus humbles occupations, mince et haute, dans son éternelle robe de laine noire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
