                ],
                "senses": [
                    {
                        "sense_id": "8c8ba303-0367-3638-9096-6eb0b577bd72",
                        "entry_id": "c2b4df28-948a-35a7-a02d-ffbddab8183b",
                        "glosses": [
                            "Qui est administré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df2517b7-b54f-4dc6-8f70-2fd02c7cc855",
                                "sense_id": "8c8ba303-0367-3638-9096-6eb0b577bd72",
                                "text": "Un régime administré"
                            },
                            {
                                "example_id": "bd3fb4cf-1145-4d5f-8340-2bc8f1747537",
                                "sense_id": "8c8ba303-0367-3638-9096-6eb0b577bd72",
                                "text": "Devant les tribunaux, justement, l’Ordre et le CNB ont chaque fois été déboutés. Il y a quelques jours, ils ont pris une petite baffe de plus, administrée par la Cour de cassation."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fe60581-83f7-3bae-9e5e-6d4835738479",
                        "entry_id": "c2b4df28-948a-35a7-a02d-ffbddab8183b",
                        "glosses": [
                            "Qui a reçu le viatique et l’extrême-onction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "913759c7-07f6-41ca-acff-7c3d121a0d11",
                                "sense_id": "4fe60581-83f7-3bae-9e5e-6d4835738479",
                                "text": "Trois jours après, la baronne, administrée la veille, était à l’agonie et se voyait entourée de sa famille en larmes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
