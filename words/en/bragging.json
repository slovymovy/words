{
    "word_family": [
        "brag",
        "braggart",
        "braggadocio"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "482245a4-84e7-3aac-93e6-3fc1a9beaf6b",
                    "sense_definition": "The act of talking with excessive pride about one's own achievements or possessions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "boasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete grew tired of the constant <w>bragging</w> from his rival before the big game.",
                            "target_lang_translations": {
                                "cs": "Sportovec byl před velkým zápasem unavený z neustálého <w>vychloubání</w> svého soupeře.",
                                "es": "El atleta se cansó de los constantes <w>alardes</w> de su rival antes del gran partido."
                            }
                        },
                        {
                            "text": "Nobody enjoyed listening to his endless <w>bragging</w> about his expensive new car.",
                            "target_lang_translations": {
                                "cs": "Nikdo neposlouchal rád jeho nekonečné <w>vychloubání</w> se drahým novým autem.",
                                "es": "A nadie le gustaba escuchar su interminable <w>jactancia</w> sobre su coche nuevo y caro."
                            }
                        }
                    ],
                    "synonyms": [
                        "boasting",
                        "vaunting",
                        "braggadocio"
                    ],
                    "antonyms": [
                        "humility",
                        "modesty"
                    ],
                    "common_phrases": [
                        "constant bragging",
                        "endless bragging"
                    ],
                    "target_lang_definitions": {
                        "cs": "Projev nadměrné pýchy nebo vychloubání se vlastními úspěchy či majetkem.",
                        "es": "El acto de hablar con orgullo excesivo sobre los propios logros o posesiones."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vychloubání",
                                "target_lang_sense_clarification": "obecné označení pro akt chlubení se"
                            },
                            {
                                "target_lang_word": "vytahování",
                                "target_lang_sense_clarification": "hovorový výraz pro předvádění se"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "alardes",
                                "target_lang_sense_clarification": "manifestaciones de ostentación o presunción"
                            },
                            {
                                "target_lang_word": "jactancia",
                                "target_lang_sense_clarification": "actitud o hábito de alabarse a uno mismo excesivamente"
                            },
                            {
                                "target_lang_word": "fanfarronería",
                                "target_lang_sense_clarification": "arrogancia o vanagloria al hablar de lo propio"
                            },
                            {
                                "target_lang_word": "presunción",
                                "target_lang_sense_clarification": "acto de presumir o vanagloriarse"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe1c5c0e-9754-3de4-9f44-0dca45acf26a",
                    "sense_definition": "The present participle and gerund of <w>brag</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is always <w>bragging</w> about how much money he makes at his new job.",
                            "target_lang_translations": {
                                "cs": "Neustále se <w>vychloubá</w> tím, kolik peněz vydělává v nové práci.",
                                "es": "Él siempre está <w>presumiendo</w> de cuánto dinero gana en su nuevo trabajo."
                            }
                        },
                        {
                            "text": "Stop <w>bragging</w> about your test scores and be more considerate of your classmates.",
                            "target_lang_translations": {
                                "cs": "Přestaň se <w>vychloubat</w> svými výsledky z testů a buď ohleduplnější ke svým spolužákům.",
                                "es": "Deja de <w>alardear</w> de las notas de tus exámenes y sé más considerado con tus compañeros de clase."
                            }
                        }
                    ],
                    "synonyms": [
                        "boasting",
                        "showing off"
                    ],
                    "common_phrases": [
                        "keep bragging",
                        "stop bragging"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa chlubit se.",
                        "es": "Participio presente y gerundio del verbo 'brag' (presumir o jactarse)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chlubící se",
                                "target_lang_sense_clarification": "příčestí vyjadřující probíhající činnost"
                            },
                            {
                                "target_lang_word": "vychloubání se",
                                "target_lang_sense_clarification": "gerundium vyjadřující činnost jako takovou"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "presumiendo",
                                "target_lang_sense_clarification": "gerundio del verbo presumir"
                            },
                            {
                                "target_lang_word": "jactándose",
                                "target_lang_sense_clarification": "gerundio del verbo jactarse"
                            },
                            {
                                "target_lang_word": "alardeando",
                                "target_lang_sense_clarification": "gerundio del verbo alardear"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}