                        "entry_id": "fbe4e45b-a18e-3c55-be6d-5b9012e24409",
                        "glosses": [
                            "Rivière de l’État du New York, confluent du fleuve Hudson au nord d’Albany."
                        ],
                        "tags": [
                            "États-Unis"
                        ],
                        "examples": [
                            {
                                "example_id": "3a8eb005-b178-4e21-81e8-bbfaddc49153",
                                "sense_id": "bafaaa09-9a37-3056-8df0-f8c18901a826",
                                "text": "Il convient de rappeler ici que les soldats du régiment de Carignan-Salières arrivés en Nouvelle-France en 1665 avaient eux-mêmes attaqué et détruit de nombreux villages des Agniers de la rivière Mohawk."
                            }
                        ]
                    },
