            "senses": [
                {
                    "sense_id": "3e0f6c46-5ce7-324d-945d-3e0d5e2d5dbb",
                    "sense_definition": "wydaliny z przewodu pokarmowego, zwłaszcza ludzkie lub zwierzęce",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wydaliny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę wyjść z psem na spacer, bo bardzo chce mu się zrobić <w>kupę</w>.",
                            "target_lang_translations": {
                                "en": "I need to take the dog out for a walk because he really needs to take a <w>poop</w>."
                            }
                        },
                        {
                            "text": "Uważaj pod nogi, bo na chodniku leży psia <w>kupa</w>.",
                            "target_lang_translations": {
                                "en": "Watch your step because there is dog <w>poop</w> on the sidewalk."
                            }
                        }
