                    {
                        "translation_id": "d34b846b-8188-4412-a71c-0ab4cb4f0871",
                        "source_entry_id": "597b34f1-4306-3f28-af2b-b4ac1426ddec",
                        "source_sense_id": "ecd1c562-49cd-3554-9068-a894b740e302",
