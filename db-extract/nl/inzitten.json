        "nl-extract.jsonl": [
            {
                "entry_id": "a29f74ca-7ac6-3ce5-ac9b-7f1b74b63f17",
                "word": "inzitten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0bfe942-7849-3fdb-92e7-80550b66a4dd",
                        "entry_id": "a29f74ca-7ac6-3ce5-ac9b-7f1b74b63f17",
                        "glosses": [
                            "ergens in aanwezig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e94f29e1-7b79-45a6-adf8-d38ae09fdab8",
                                "sense_id": "b0bfe942-7849-3fdb-92e7-80550b66a4dd",
                                "text": "Grote sterrenstelsels staan niet willekeurig aan het firmament, maar vaak dezelfde kant op als het hele cluster van sterrenstelsels waar ze inzitten."
                            },
                            {
                                "example_id": "f48adbcd-623f-419b-982f-70774aaa5ca5",
                                "sense_id": "b0bfe942-7849-3fdb-92e7-80550b66a4dd",
                                "text": "Daarom hebben wij onze excuses aangeboden. Het is echter niet vreemd dat in een strip met heel uitgesproken karakters wordt gewerkt. Lambik is ook niet degene die wij vooropstellen als het prototype Vlaamse man. Het gaat om één plaatje uit een stripalbum waar veel diverse personages inzitten, waaronder ook een Afrikaanse agent die op een hele andere manier is getekend.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "5555c994-3d93-3da7-8e8d-b5317503eb4f",
                        "entry_id": "a29f74ca-7ac6-3ce5-ac9b-7f1b74b63f17",
                        "glosses": [
                            "van personen: in een bepaald vervoermiddel als passagier aanwezig zijn"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
