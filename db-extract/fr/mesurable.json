                "forms": [
                    {
                        "form_id": "4e651261-33a4-4ab0-8918-f11b25a9b548",
                        "entry_id": "5a696aed-bf45-3884-b831-fe17e22c9cd7",
                        "tags": [
                            "plural",
                            "masculine",
