                                    {
                                        "sense_id": "fbada607-bef3-39f3-909b-06894dd7a51f",
                                        "entry_id": "6a0b0dc3-3a69-356b-bfd3-7961c38e7f33",
                                        "glosses": [
                                            "Flasche, für die beim Kauf ein Pfandbetrag erhoben und bei ihrer Rückgabe zurückgezahlt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f9f79d9-99a7-47e6-be9d-d37c02c5cc27",
                                                "sense_id": "fbada607-bef3-39f3-909b-06894dd7a51f",
                                                "text": "Nicht wegwerfen! Das ist eine Pfandflasche."
                                            },
                                            {
                                                "example_id": "2feb1540-7a91-4f29-a412-d36251b977c3",
                                                "sense_id": "fbada607-bef3-39f3-909b-06894dd7a51f",
                                                "text": "„Das Einwegpfand hat nichts gebracht - der Anteil klassischer Pfandflaschen geht immer mehr zurück.“"
                                            },
                                            {
                                                "example_id": "7e228bf5-d6cf-432f-9dc6-db823e5412e7",
                                                "sense_id": "fbada607-bef3-39f3-909b-06894dd7a51f",
                                                "text": "„Mây lachte, während sie den Kopf schüttelte, bis sie eines Tages schließlich nickte und Etsuko die alte Registrierkasse erklärte, ihr zeigte, wo die Tüten hingen, wie man die Pfandflaschen entgegennahm und abrechnete.“"
                                            },
                                            {
                                                "example_id": "7c255148-a92b-4e2a-8f8b-af31c394c1c8",
                                                "sense_id": "fbada607-bef3-39f3-909b-06894dd7a51f",
                                                "text": "„Es gab auch keine leeren Pfandflaschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
