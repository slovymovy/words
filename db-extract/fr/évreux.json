                    {
                        "sense_id": "99fa40cd-5438-30de-8bcb-e16defe00e2f",
                        "entry_id": "976ce4c0-022b-31a0-b02c-f28aaaaf4785",
                        "glosses": [
                            "Commune et chef-lieu de département française, située dans le département de l’Eure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adbdf8a1-7d0a-4452-bf03-87ef4e08c2e9",
                                "sense_id": "99fa40cd-5438-30de-8bcb-e16defe00e2f",
                                "text": "Autre curiosité : son interview tire-larmes dans le « JDD » sur son enfance à Évreux dans 15 m² (« La fenêtre donnait sur la maison d’arrêt, on s’habillait au Secours populaire… ») a été amplement relayée par la presse pipole, notamment « Closer »."
                            },
                            {
                                "example_id": "8f4e3559-7e61-44ad-8039-56a3b67e6fa9",
                                "sense_id": "99fa40cd-5438-30de-8bcb-e16defe00e2f",
                                "text": "Après le bombardement d’Évreux, le dimanche 9 Juin, les Bernayens s’affolèrent."
                            },
                            {
                                "example_id": "fe13e054-2555-40d7-b5f5-387e0c29185e",
                                "sense_id": "99fa40cd-5438-30de-8bcb-e16defe00e2f",
                                "text": "Jacques et Noémie se réveillent en prison comme des criminels. Ils ont été incarcérés à Évreux la veille au soir, à 23 h 20 selon le livre d’écrou. Motif d’incarcération : Juifs."
                            }
                        ]
                    }
