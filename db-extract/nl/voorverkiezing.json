                                        "entry_id": "fee823dc-24d2-31ca-86c6-9c540dba1c84",
                                        "glosses": [
                                            "The primary site of a disease; the original location or source of the disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba809e9-80fd-4ad9-94f1-beb4039f7d9a",
