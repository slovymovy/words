                                        "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                        "entry_id": "a40ef367-75e8-3a8a-8444-37f1ac8d332a",
                                        "glosses": [
                                            "Staat in Zentralasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085abd68-20d0-4e2a-9143-97c0ddb23b15",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "Morgen fahren wir nach Usbekistan."
                                            },
                                            {
                                                "example_id": "6f767891-3caa-4d1f-b8e3-df42db30e0b4",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "In seinen Schilderungen findet man das Usbekistan der 90er Jahre wieder."
                                            },
                                            {
                                                "example_id": "a87efd0a-4474-4798-829f-e7d33b5f86db",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "Taschkent ist die Hauptstadt von Usbekistan."
                                            },
                                            {
                                                "example_id": "925e12e2-6852-4511-bc1d-70a41efb9c80",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "„Durch Usbekistan fließen die zwei wichtigsten Zuflüsse des Aralsees und größten Ströme Zentralasiens, der Amudarja (usbek. Amudaryo) mit 2.539 km Länge und der Syrdarja (usbek. Sirdaryo) mit 2.212 km Länge.“"
                                            },
                                            {
                                                "example_id": "79c19714-941f-4c53-b49b-5feb7f5cc00c",
                                                "sense_id": "7c9214bd-959c-343d-875c-547e0e52e5ff",
                                                "text": "„Usbekistan gliedert sich in elf Gebiete und die Karakalpakische Autonome Republik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
