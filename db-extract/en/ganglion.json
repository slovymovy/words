                    {
                        "translation_id": "8357b7dd-7b56-4e97-a8a0-786940824af3",
                        "source_entry_id": "43676086-461b-36d8-aeab-0a0973caee95",
                        "source_sense_description": "centre of power or authority",
                        "target_lang_word": "Kopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "oberster beziehungsweise vorderster Körperteil eines Menschen oder Tieres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863ac925-18f7-4acd-9376-2eacba218b5f",
                                                "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                                "text": "„Während man jedoch beim Segelfliegen in einem kleinen Cockpit hockt, beim Gleitschirmfliegen in einem Sitz schaukelt, hängt der Drachenflieger unter der Tragfläche, Kopf voraus.“"
                                            },
                                            {
                                                "example_id": "8ea1530d-929e-409a-ac07-616d6903e45d",
                                                "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                                "text": "Der Hut ist zu groß für deinen Kopf."
                                            },
                                            {
                                                "example_id": "7ef6e99b-a9d5-47c0-809f-5705609b75dc",
                                                "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                                "text": "„Mein Kopf fühlte sich fast völlig leer an, und das war sicher das Beste.“"
                                            },
                                            {
                                                "example_id": "9770ff6b-cf7e-4e53-9135-3e8dae633936",
                                                "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                                "text": "„Sie hob den Kopf, sie hörte jetzt selbst seine Stimme, das Gepolter auf der Treppe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b03ed9c-ba8a-3f7a-af3f-d62ed4d552c6",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "das oberste Mitglied einer Organisation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c43aa3d-42f8-4788-b46c-f61772abb9eb",
                                                "sense_id": "1b03ed9c-ba8a-3f7a-af3f-d62ed4d552c6",
                                                "text": "Das ist der Kopf der Verbrecherbande."
                                            },
                                            {
                                                "example_id": "cee1056d-8a86-4aa3-a537-0432a1154c09",
                                                "sense_id": "1b03ed9c-ba8a-3f7a-af3f-d62ed4d552c6",
                                                "text": "„Ihr Kopf sitzt in Monrovia im benachbarten Liberia und heißt Charles Taylor, von Beruf Präsident und Kriegsverbrecher.“"
                                            },
                                            {
                                                "example_id": "d15a8bed-bf64-4e09-8945-b899fbcda0ad",
                                                "sense_id": "1b03ed9c-ba8a-3f7a-af3f-d62ed4d552c6",
                                                "text": "„Wichtige Köpfe dieser Bewegung waren Maqbool Butt (1984 in Delhi hingerichtet) sowie Amanullah Khan und Yasin Malik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
