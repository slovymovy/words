                                        "glosses": [
                                            "dokument potwierdzający umiejętności jego posiadacza do prowadzenia pojazdów mechanicznych, wydawany przez odpowiednie organy państwowe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d073a488-747e-411e-ba35-3d5874794c39",
                                                "sense_id": "816f66f8-dadd-3e2e-932e-1b3eae86d064",
                                                "text": "Nie mogę prowadzić, bo zapomniałem prawa jazdy."
