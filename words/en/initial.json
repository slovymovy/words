                    "target_lang_definitions": {
                        "ru": "Первая буква имени, часто используется во множественном числе для обозначения полного имени.",
                        "zh": "姓名的首字母，常以复数形式代表全名。"
                    },
                    "translations": {
                        "ru": [
                            {
