                "senses": [
                    {
                        "sense_id": "51fdc5c4-768b-3a26-beae-b03e9ae5f8fc",
                        "entry_id": "a4e2084c-8c54-31f2-ae2b-2178111b773c",
                        "glosses": [
                            "Sorte de cisaille utilisée par les criniers et destinée à couper les crins de la queue des chevaux, des bœufs ou autres animaux.. On dit aussi coupe-queue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b6fd63e-5312-416f-9709-b92380af4a46",
                                "sense_id": "51fdc5c4-768b-3a26-beae-b03e9ae5f8fc",
                                "text": "ROGNE-QUEUE : Instrument du crinier (apprêteur de crin qui en faisait commerce) ... C'est une Cisaille à couper le crin des bêtes."
                            },
                            {
                                "example_id": "b9d1fba4-cfcb-4d3b-ac50-6f01a2b764cb",
                                "sense_id": "51fdc5c4-768b-3a26-beae-b03e9ae5f8fc",
                                "text": "On commence par préparer l'appendice en peignant les crins avec soin ; puis, après avoir fixé le point précis de la queue … l'opérateur, placé à gauche et armé du coupe-queue ou rogne-queue — que l'on trouve dans le commerce — passe la queue …. — (Journal d'agriculture pratique, volume 66, numéro 1, 1902)"
                            }
                        ]
                    },
                    {
                        "sense_id": "452ecdb1-837c-3073-8b16-f8daaf8ccc40",
                        "entry_id": "a4e2084c-8c54-31f2-ae2b-2178111b773c",
                        "glosses": [
                            "Instrument utilisé par les fabricants de queue de billard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f883d5-d4d2-4d30-b730-1b631ef71795",
                                "sense_id": "452ecdb1-837c-3073-8b16-f8daaf8ccc40",
                                "text": "Le rogne-queue se fait ordinairement sur le tour, mais rien ne s'oppose à ce que le menuisier le fasse lui-même."
                            }
                        ]
                    },
                    {
                        "sense_id": "77a21868-8720-3214-86a5-f29854209488",
                        "entry_id": "a4e2084c-8c54-31f2-ae2b-2178111b773c",
                        "glosses": [
                            "Ancien outil destiné à rogner les traces de moulage sur les projectiles en plomb destiné aux armes à feu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc734038-d5b0-494d-9509-63b267b6a1ac",
                                "sense_id": "77a21868-8720-3214-86a5-f29854209488",
                                "text": "M. le colonel Parisot a, nous assure-t-on, inventé une cisaille ou rogne-queue qui coupe les jets en arrondissant, et épargne des peines et des frais, en faisant mieux, et en dispensant d'opérations ultérieures, telle que celle de tourner les balles dans un baril pour les arondir, …. — (A. O. Paulin Desormeaux, Manuel de l'armurier, du fourbisseur et de l'arquebusier, Éd. Roret, 1832)"
                            }
                        ]
                    }
