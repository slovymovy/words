                                        "glosses": [
                                            "Radiosource ponctuelle dont le rayonnement, très intense, peut varier en quelques jours d’un facteur allant jusqu’à 100."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5d33d6-b929-4409-b518-a653f738ef1c",
                                                "sense_id": "398353b8-a72e-3f5d-b2e3-85cb079e4a1c",
                                                "text": "Naines blanches, étoiles à neutrons, supernovae, trous noirs, quasars, blazars."
                                            },
                                            {
                                                "example_id": "af44344f-7471-4b49-a6b7-15e03a16a299",
                                                "sense_id": "398353b8-a72e-3f5d-b2e3-85cb079e4a1c",
                                                "text": "Contraction de « blazing quasar » (« quasar flamboyant » en français), un blazar désigne une galaxie dont le cœur est occupé par un trou noir gargantuesque."
                                            }
                                        ]
