                "senses": [
                    {
                        "sense_id": "ef13febd-2107-32f9-94ba-0cec9f6567c8",
                        "entry_id": "e422dd6e-c48b-39a7-b217-232d580869eb",
                        "glosses": [
                            "zwolennik karlizmu, tradycjonalistycznego i prokatolickiego ruchu politycznego w Hiszpanii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be830d6-a602-408f-a6d4-fcf3e0a27b7d",
                                "sense_id": "ef13febd-2107-32f9-94ba-0cec9f6567c8",
                                "text": "W Hiszpanii konflikt między zachowawcami a liberałami nakładał się na konflikt dynastyczny między starzejącym się Ferdynandem VII a jego bratem, ambitnym don Carlosem i jego zwolennikami, karlistami, którzy jednak przegrali w 1839 r."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
