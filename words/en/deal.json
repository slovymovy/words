                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная ситуация, событие или стечение обстоятельств.",
                        "pl": "Konkretna sytuacja, wydarzenie lub zestaw okoliczności."
                    },
                    "translations": {
