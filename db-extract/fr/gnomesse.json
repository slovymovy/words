        "fr-extract.jsonl": [
            {
                "entry_id": "e51045ff-0c46-3cb9-b47f-b5407a5cc9a6",
                "word": "gnomesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b6863c0-e9de-4782-90ee-99e3a0947aa6",
                        "entry_id": "e51045ff-0c46-3cb9-b47f-b5407a5cc9a6",
                        "tags": [
                            "plural"
                        ],
                        "form": "gnomesses"
                    },
                    {
                        "form_id": "fbc1fc9e-ef7d-48d3-9f48-ab8ad0595d19",
                        "entry_id": "e51045ff-0c46-3cb9-b47f-b5407a5cc9a6",
                        "tags": [
                            "masculine"
                        ],
                        "form": "gnome"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8160567f-c56a-365b-966a-b6d53a9cf256",
                        "entry_id": "e51045ff-0c46-3cb9-b47f-b5407a5cc9a6",
                        "glosses": [
                            "Variante de gnomide."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "24a333a3-055d-4e74-9347-d02c60e88c8c",
                                "sense_id": "8160567f-c56a-365b-966a-b6d53a9cf256",
                                "text": "Il y avait là à profusion du vin, de la bière et les mets les plus riches, ainsi que toutes les putains du monde, pourvu qu’on en paie le prix : de longues elfes des Havres qui nouaient leurs jambes nues au cou de leurs amants, de lascives filles du Sud aux cheveux noirs, des blondes à la peau diaphane et aux hanches larges, des naines aux seins durs comme du bois, des gnomesses peinturlurées et ridicules…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16ed92f8-bfc1-4128-947a-e538218500fa",
                        "source_entry_id": "e51045ff-0c46-3cb9-b47f-b5407a5cc9a6",
                        "source_sense_id": "8160567f-c56a-365b-966a-b6d53a9cf256",
                        "target_lang_word": "gnome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed10975f-70e9-31b1-9313-060ede0d61b2",
                                        "entry_id": "63d6274e-64fa-386e-992f-58084db254a9",
                                        "glosses": [
                                            "An elemental (spirit or corporeal creature associated with a classical element) associated with earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e33805c-b2a5-47aa-a35b-3cb0d5070a34",
                                                "sense_id": "ed10975f-70e9-31b1-9313-060ede0d61b2",
                                                "text": "He adopts the Rosycrusian fancy of Gnomes, spirits which inhabit the earth, and who by their power form the ores of metals, and all the wonders met with in the inmost recesses of the globe."
                                            },
                                            {
                                                "example_id": "b1ae09c5-e9d8-4729-bd36-c3eecdcdda2d",
                                                "sense_id": "ed10975f-70e9-31b1-9313-060ede0d61b2",
                                                "text": "Day belongs to the earthlier deities—the stern, the harsh, and the cold. Gnomes are the spirits of daily hours. Toil, thought, and strife, beset us: we have to work, to quarrel, and to struggle: we have to take our neighbours in; or, at least, to avoid their doing so by us."
                                            },
                                            {
                                                "example_id": "4fe4f2dd-1da1-49e3-b207-c50ef8798734",
                                                "sense_id": "ed10975f-70e9-31b1-9313-060ede0d61b2",
                                                "text": "Gnomes are perhaps the most useful of the elementals.\nA gnome can carry a person with it as it swims through the soil, provided it is strong enough to lift the person. The gnome cannot, however, provide air for that person[…]."
                                            },
                                            {
                                                "example_id": "89762313-9c6d-4dc6-99bc-35b4c0f8250a",
                                                "sense_id": "ed10975f-70e9-31b1-9313-060ede0d61b2",
                                                "text": "Elementals are the consciousness guiding the four classical elements of earth, fire, air, and water. These elementals are depicted as gnomes, salamanders, diminutive faeries known as sylphs, and merfolk, known as undines, respectively."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "952fc3aa-a13a-3b9f-bd20-0eb325a5f837",
                                        "entry_id": "63d6274e-64fa-386e-992f-58084db254a9",
                                        "glosses": [
                                            "One of a race of imaginary human-like beings, usually depicted as short and typically bearded males, who inhabit the inner parts of the earth and act as guardians of mines, mineral treasure, etc.; in modern fantasy literature and games, when distinguished from dwarves, gnomes are usually smaller than dwarves and more focused on engineering than mining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6c93d3-e897-4577-b7ea-abc93ddab95a",
                                                "sense_id": "952fc3aa-a13a-3b9f-bd20-0eb325a5f837",
                                                "text": "When the trees were disposed of, the gnomes vanished again."
                                            },
                                            {
                                                "example_id": "bed7f739-d1dd-4fdc-8aca-15a9db1696a0",
                                                "sense_id": "952fc3aa-a13a-3b9f-bd20-0eb325a5f837",
                                                "text": "There were not one but four gnomes standing at his feet. “I nearly trod on you,” Daniel said. “What are you doing here?”\nThe gnomes just stood, looking up at him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "328b8d2c-670b-309e-8da0-fae86b9afe46",
                                        "entry_id": "63d6274e-64fa-386e-992f-58084db254a9",
                                        "glosses": [
                                            "A person of a small stature or misshapen features, or of a strange appearance."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc55b136-d423-3bd6-a377-4791fecb15e2",
                                        "entry_id": "63d6274e-64fa-386e-992f-58084db254a9",
                                        "glosses": [
                                            "The mountain pygmy owl, Glaucidium gnoma, a small owl of the western United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05756a59-fee2-32de-8857-6b2e06c4c4cc",
                                        "entry_id": "63d6274e-64fa-386e-992f-58084db254a9",
                                        "glosses": [
                                            "A small statue of a dwarf-like character, often bearded, placed in a garden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6d33678-be34-45b8-a376-43eabac6a103",
                                                "sense_id": "05756a59-fee2-32de-8857-6b2e06c4c4cc",
                                                "text": "There were ornamental ponds and shrubs clipped into animal shapes, painted concrete gnomes sitting on mushrooms, pink flamingos standing on one leg[.]"
                                            },
                                            {
                                                "example_id": "84a0d5e7-932c-474d-92e3-3b3a0f8838b4",
                                                "sense_id": "05756a59-fee2-32de-8857-6b2e06c4c4cc",
                                                "text": "Gnomes, more than any other garden feature, divide the gardening world. Once welcomed in the hallowed halls of the International Horticultural Exhibition at Chelsea, this year a lonesome gnome had the ignominity to be ejected from those same grounds, victim of a ban on all things mythical and unduly colourful."
                                            },
                                            {
                                                "example_id": "29064408-3ffb-41ed-a9a0-be67625b68ef",
                                                "sense_id": "05756a59-fee2-32de-8857-6b2e06c4c4cc",
                                                "text": "My mother-in-law, who swears she is a good Lutheran but is also the most powerful Witch I have ever met, also has at least a dozen small lawn gnomes peeking out from beside her shrubs, next to the lilac bushes, and hanging out with the roses. My husband has already started our collection; as of this writing, four gnomes and one moss-covered rabbit hang out in the shrubbery by the front door, two gnomes live in the dining room, and one guards the perpetual pile of to-do paperwork that lives next to the computer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e9babd2-5776-30b3-8a38-450e9e153b45",
                                        "entry_id": "63d6274e-64fa-386e-992f-58084db254a9",
                                        "glosses": [
                                            "An upper atmospheric optical phenomenon associated with thunderstorms, a compact blue starter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdd5ceae-fb65-349b-8a0b-f5a2e84e9505",
                                        "entry_id": "63d6274e-64fa-386e-992f-58084db254a9",
                                        "glosses": [
                                            "A banker, especially a secretive international one."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61d6090b-e875-4533-927c-75afb3dd7dc2",
                                                "sense_id": "bdd5ceae-fb65-349b-8a0b-f5a2e84e9505",
                                                "text": "the gnomes of Zurich"
                                            },
                                            {
                                                "example_id": "3db02c2d-2e96-4a94-9feb-0f5f455227a0",
                                                "sense_id": "bdd5ceae-fb65-349b-8a0b-f5a2e84e9505",
                                                "text": "So far the major beneficiaries of the boom in gold have been deposed South American dictators, Middle Eastern potentates, and the gnomes of Zurich."
                                            },
                                            {
                                                "example_id": "b94337ee-0e2d-4a16-bbce-08480d05908a",
                                                "sense_id": "bdd5ceae-fb65-349b-8a0b-f5a2e84e9505",
                                                "text": "1985, Fodor's, Fodor's ... London, Fodor's\nFor this is a creation of the City, of the country's financial heart, and of the gnomes of London who have financed it and supported it entirely on their own."
                                            },
                                            {
                                                "example_id": "6e5830df-f7c2-4a38-bed9-96c198ae9869",
                                                "sense_id": "bdd5ceae-fb65-349b-8a0b-f5a2e84e9505",
                                                "text": "The gnomes of Wall Street can trade on rumors, but Warren will only invest after the sale or merger has been announced."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gnome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae3db22a-ab00-3573-b7ae-ccd8945ebf17",
                                        "entry_id": "f467b551-0103-3b0f-86da-ce2672d641b1",
                                        "glosses": [
                                            "A brief reflection or maxim; a pithy saying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898ab938-9a1f-47bf-9c0a-b1e7b1d9960a",
                                                "sense_id": "ae3db22a-ab00-3573-b7ae-ccd8945ebf17",
                                                "text": "1996, Giambattista Vico, Giorgio A. Pinton, Arthur W. Shippee (translators), The Art of Rhetoric, [1711-1741, Giambattista Vico, Institutiones Oratoriae], page 125,\nThe Greeks in their tongue call this second type of maxim noema. The gnome is more appropriate to the philosophers, and the noema to the orators, to the poets, and to the historians. To speak by gnomes alone was referred to by the Greeks as \"philosophizing\" which we Italians would render as \"to mouth maxims\" (sputar sentenze)."
                                            },
                                            {
                                                "example_id": "333e09e6-2adc-47a2-8922-8f2f687c1d38",
                                                "sense_id": "ae3db22a-ab00-3573-b7ae-ccd8945ebf17",
                                                "text": "Thus, the gnome concerning the precarious nature of, and the potential suffering in, human life sent by the gods uttered by Electra is deconstructed by her choice of paradigm. By using Tantalos as an illustration, the play overturns the apparent meaning of the gnome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d016bcb-3cc7-44bf-b331-cebf92527bec",
                        "source_entry_id": "e51045ff-0c46-3cb9-b47f-b5407a5cc9a6",
                        "source_sense_id": "8160567f-c56a-365b-966a-b6d53a9cf256",
                        "target_lang_word": "gnomess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnomess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "950e6081-2cbe-3c94-9072-acc71fc2f233",
                                        "entry_id": "c057aba3-cac5-38e7-971b-dbc43906de4d",
                                        "glosses": [
                                            "A female gnome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af27ce72-dbc4-43db-8d92-6fc7b74b6b5f",
                                                "sense_id": "950e6081-2cbe-3c94-9072-acc71fc2f233",
                                                "text": "Surviving was too harsh, to worry about the life of another Gnome. Females, properly Gnomesses, were another reason that Gnomes often fought."
                                            },
                                            {
                                                "example_id": "b826a5e6-d2e4-4ded-a00b-4a99e5b56f7d",
                                                "sense_id": "950e6081-2cbe-3c94-9072-acc71fc2f233",
                                                "text": "The Gnomess turned and looked (longingly?) at the now closed shoppe Door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c19cd2a9-f182-43ac-9f05-13c19372a8fd",
                        "source_entry_id": "e51045ff-0c46-3cb9-b47f-b5407a5cc9a6",
