                        ],
                        "form": "die Ausgangsstoffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                        "entry_id": "ab4e671e-0afd-3d51-8baa-26e53e642c54",
                        "glosses": [
                            "Material, aus dem ein anderes Produkt hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eafb332-2e56-47e6-9745-8723675b750b",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Rohopium ist der Ausgangsstoff, um Heroin herzustellen.“"
                            },
                            {
                                "example_id": "e8aa36b6-c387-4624-b3ee-d935fec71c42",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "Bauxit ist der Ausgangsstoff für Aluminium."
                            },
                            {
                                "example_id": "162de50d-5bae-4ce5-babf-06edc8fac467",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "Rohöl ist der Ausgangsstoff für eine Reihe von Produktgruppen wie Kraftstoffen, Schmiermitteln, Paraffinen und Kunststoffen."
                            },
                            {
                                "example_id": "cbcac7ae-3dcc-4fc0-a478-0fa47adea1bf",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "[Acrylsäure ist ein] „Ausgangsstoff für Kunstharze und synthetische Fasern.“"
                            },
                            {
                                "example_id": "df0c6fd5-c331-4230-9599-33ad0d4eb78c",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Fensterrahmen und Fußbodenbeläge werden aus dem Kunststoff Polyvinylchlorid (PVC) hergestellt. Ausgangsstoff ist Chlorethen.“"
                            },
                            {
                                "example_id": "805e26dd-d03b-4fa8-be59-d8041b81cf18",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "[Benzol ist ein] „Ausgangsstoff für die Herstellung von Textilfasern, Kunststoffen, Farbstoffen, Arzneimitteln, Aromastoffen, Pflanzenschutzmitteln und Sprengstoffen.“"
                            },
                            {
                                "example_id": "31e3722f-fc19-4951-9f15-73ac9bc3c7b7",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Bei der chemischen Reaktion von Kupfer mit Schwefel hat eine Stoffumwandlung stattgefunden: Aus den Ausgangsstoffen Kupfer und Schwefel wurde ein neuer Stoff gebildet, das Reaktionsprodukt Kupfersulfid.“"
                            },
                            {
                                "example_id": "786f391a-3a7a-46bd-a0cf-50b1e9c1c5f5",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Wodka kann aus unterschiedlichen, kohlenhydrathaltigen Ausgangsstoffen hergestellt werden. Meist wird Getreide verwendet, aber auch Kartoffeln und Melasse sind üblich.“"
                            },
                            {
                                "example_id": "738ee3ef-cb00-41a0-be50-3f503a4e0fa3",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Cholesterin dient zudem als Ausgangsstoff für die Produktion von Gallensäuren zur Fettverdauung, für die Bildung von Vitamin D und von Hormonen wie Östrogen, Testosteron und Kortisol.“"
                            },
                            {
                                "example_id": "f6672415-c3dc-4d67-89aa-fd4592a69188",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Tatsächlich dient Methanol nicht nur als Ausgangsstoff in der Chemie, sondern man kann es direkt als Kraftstoff nutzen.“"
                            },
                            {
                                "example_id": "efde3129-ec69-4de5-8add-898d10b13c3a",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Aceton“ […] „findet Verwendung als“ […] „Ausgangsstoff für viele Synthesen der organischen Chemie.“"
                            },
                            {
                                "example_id": "722055d4-47cf-40e9-a5c2-66999e331623",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Die zulässigen Ausgangsstoffe für alle Grappas sind identisch.“"
                            },
                            {
                                "example_id": "7670ce3f-ed2b-44af-a031-7d1b920bff4e",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Natürliche Aromen müssen lediglich aus einem natürlichen Ausgangsstoff stammen, nicht aber zwingend aus dem Lebensmittel, nach dem sie schmecken.“"
                            },
                            {
                                "example_id": "f85af5ae-9419-42ef-a970-d9bac57efd48",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "[Biokohle:] „Dabei werden pflanzliche Ausgangsstoffe oder organische Abfälle unter Ausschluss von Luft im Prozess der Pyrolyse verkohlt.“"
                            },
                            {
                                "example_id": "3da70429-bd92-4487-a080-f1410c138365",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "„Um reinen Wasserstoff zu erhalten, muss er daher aus einem wasserstoffreichen Ausgangsstoff abgespaltet werden. Dies ist zeitraubend, energieintensiv und kostspielig.“"
                            },
                            {
                                "example_id": "d79f7558-e936-4757-8fdd-2f45b77e7b96",
                                "sense_id": "716b35dd-d4a8-3ac9-ac9b-133592c278f8",
                                "text": "[Instantkaffee:] „Also die Ausgangsstoffe weichen durchaus voneinander ab, aber die Packungen haben eines gemeinsam: Es ist nur Kaffee drin und zwar ausschließlich Kaffee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
