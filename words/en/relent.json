{
    "word_family": [
        "relentless",
        "relentlessly",
        "relentlessness",
        "unrelenting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d1365e7-b799-33cc-9f31-4553224598f9",
                    "sense_definition": "To abandon or mitigate a harsh intention or cruel treatment; to become more mild or compassionate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soften attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had planned to ground his son for a month, but <w>relented</w> and decided to give him a stern lecture instead.",
                            "target_lang_translations": {
                                "ru": "Он планировал оставить сына под домашним арестом на месяц, но <w>смягчился</w> и решил вместо этого прочитать ему строгую нотацию."
                            }
                        },
                        {
                            "text": "After seeing her tears, the judge began to <w>relent</w> and offered a lighter sentence.",
                            "target_lang_translations": {
                                "ru": "Увидев её слёзы, судья начал <w>смягчаться</w> и предложил более мягкий приговор."
                            }
                        }
                    ],
                    "synonyms": [
                        "yield",
                        "soften",
                        "capitulate",
                        "give in"
                    ],
                    "antonyms": [
                        "persist"
                    ],
                    "common_phrases": [
                        "finally relent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказаться от сурового намерения или жестокого обращения; стать более мягким или сострадательным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смягчиться",
                                "target_lang_sense_clarification": "стать более снисходительным"
                            },
                            {
                                "target_lang_word": "сжалиться",
                                "target_lang_sense_clarification": "проявить сострадание"
                            },
                            {
                                "target_lang_word": "уступить",
                                "target_lang_sense_clarification": "перестать настаивать на своем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4599c998-56a9-3030-bd38-46fe73ba4d0f",
                    "sense_definition": "To become less severe, intense, or strong; to slacken or abate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We waited for the storm to <w>relent</w> before we ventured outside.",
                            "target_lang_translations": {
                                "ru": "Мы ждали, пока шторм <w>утихнет</w>, прежде чем рискнули выйти на улицу."
                            }
                        },
                        {
                            "text": "The heat showed no sign it would <w>relent</w> during the long afternoon.",
                            "target_lang_translations": {
                                "ru": "Жара не подавала признаков того, что она <w>ослабнет</w> в течение этого долгого дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "abate",
                        "slacken",
                        "subside",
                        "ease"
                    ],
                    "antonyms": [
                        "intensify"
                    ],
                    "common_phrases": [
                        "refuse to relent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать менее суровым, интенсивным или сильным; ослабнуть или утихнуть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утихать",
                                "target_lang_sense_clarification": "о буре или ветре"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "о жаре или интенсивности"
                            },
                            {
                                "target_lang_word": "смягчаться",
                                "target_lang_sense_clarification": "о погоде или условиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "722c2f11-4b32-3be3-8eb9-5f692ce82dd5",
                    "sense_definition": "To become less rigid or hard; to soften or melt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical softening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frozen ground began to <w>relent</w> as the spring sun warmed the valley.",
                            "target_lang_translations": {
                                "ru": "Мерзлая земля начала <w>оттаивать</w>, когда весеннее солнце согрело долину."
                            }
                        },
                        {
                            "text": "Certain salts will <w>relent</w> and turn to liquid when kept in a damp cellar.",
                            "target_lang_translations": {
                                "ru": "Некоторые соли <w>размягчаются</w> и превращаются в жидкость при хранении в сыром подвале."
                            }
                        }
                    ],
                    "synonyms": [
                        "soften",
                        "thaw",
                        "dissolve"
                    ],
                    "antonyms": [
                        "harden",
                        "freeze"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in a physical sense of softening or melting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать менее жестким или твердым; размягчиться или растаять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттаивать",
                                "target_lang_sense_clarification": "о замерзшей почве"
                            },
                            {
                                "target_lang_word": "размягчаться",
                                "target_lang_sense_clarification": "становиться менее твердым"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91511dfd-c7fb-3f2a-8afe-0229d258f1db",
                    "sense_definition": "A stay, stop, or delay in progress or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pistons of this engine moved without <w>relent</w> throughout the entire journey.",
                            "target_lang_translations": {
                                "ru": "Поршни этого двигателя двигались без <w>остановки</w> на протяжении всего пути."
                            }
                        },
                        {
                            "text": "She continued her journey and did not rest until she arrived without <w>relent</w> at the border.",
                            "target_lang_translations": {
                                "ru": "Она продолжала свой путь и не отдыхала, пока не прибыла без <w>передышки</w> к границе."
