                                    },
                                    {
                                        "sense_id": "87bd001f-d066-3941-896d-78743816ff86",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "The interval between any two quantities having a ratio of 10 to 1."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df8f6f1-8cc8-478c-ae17-8b0623822b26",
                                                "sense_id": "87bd001f-d066-3941-896d-78743816ff86",
