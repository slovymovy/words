                "senses": [
                    {
                        "sense_id": "4769682f-6f0f-3e94-9c82-e5c31e1f02bb",
                        "entry_id": "8b2df7f4-69cb-3c13-a63f-f8d1d8cad1ee",
                        "glosses": [
                            "Administrer de la morphine à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77e5d16c-d427-49b6-812c-ace1ae4e6a3f",
                                "sense_id": "4769682f-6f0f-3e94-9c82-e5c31e1f02bb",
                                "text": "M. Pichon cite une malade, bien connue, dit-il, de tous les spécialistes, qui faisait un véritable apostulat de la propagande morphinique, et qui, non contente d’avoir gagné à sa cause sa servante, avait été jusqu’à morphiniser son chien."
                            },
                            {
                                "example_id": "124629ac-1116-4fd6-8b29-ee3f26ad78fa",
                                "sense_id": "4769682f-6f0f-3e94-9c82-e5c31e1f02bb",
                                "text": "Les morphinomanes du grand monde se réunissent volontiers aussi en petits comités. Les femmes surtout affectionnent cette manière de se morphiniser de compagnie."
                            }
                        ]
                    }
                ],
