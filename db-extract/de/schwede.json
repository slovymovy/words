                                            "człowiek narodowości szwedzkiej, obywatel Szwecji, mieszkaniec Szwecji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "839ad68c-7b3d-4156-bee3-689a6613d75c",
                                                "sense_id": "da122452-5fcc-3564-8f28-a7b407576aa3",
                                                "text": "Moja siostra wyszła za mąż za Szweda i przeprowadziła się do Sztokholmu."
                                            },
                                            {
                                                "example_id": "46e1b57e-2749-402a-a016-5c83623f7733",
                                                "sense_id": "da122452-5fcc-3564-8f28-a7b407576aa3",
                                                "text": "Jako człek rycerski, który się niegdyś żołnierskiem rzemiosłem parał, wiem, że Szwedzi w obliczu nieprzyjaciela musieli gęste ponad Wisłą popostawiać straże."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
