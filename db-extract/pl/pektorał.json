                    {
                        "sense_id": "a3e370ee-f31a-3221-8746-f9e2e2cc739c",
                        "entry_id": "c935117d-9f53-30cd-8ede-f1a3b1425802",
                        "glosses": [
                            "krzyż z relikwią noszony przez katolickich duchownych na piersi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca4cd98-0d0e-46b6-8a74-7ac9fd25ae37",
                                "sense_id": "a3e370ee-f31a-3221-8746-f9e2e2cc739c",
                                "text": "Papież otrzymał srebrny pektorał z okazji rocznicy święceń."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ba6b5011-4292-39e4-bfb4-5f04bbf2b1e8",
                        "entry_id": "c935117d-9f53-30cd-8ede-f1a3b1425802",
                        "glosses": [
                            "napierśnik noszony w starożytności jako oznaka władzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cadb74ad-ee6a-4acb-9fcb-3d379e84f917",
                                "sense_id": "ba6b5011-4292-39e4-bfb4-5f04bbf2b1e8",
                                "text": "W starożytnym Izraelu pektorały nosili królowie i arcykapłani."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "dcde6379-db5d-3639-a03b-8c0eea80f0f5",
