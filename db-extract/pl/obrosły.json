                "senses": [
                    {
                        "sense_id": "d5a55ef0-c8cc-370f-852a-cfc7736f1313",
                        "entry_id": "e3bd185c-0033-385b-85b9-811f3e9b8b36",
                        "glosses": [
                            "taki, który został pokryty czymś rosnącym lub nawarstwiającym się"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb1ec4e8-2cbb-4c1b-afe5-1d4d0efa141e",
                                "sense_id": "d5a55ef0-c8cc-370f-852a-cfc7736f1313",
                                "text": "Na razie siedziałam na drewnianych, rozchwierutanych schodach ogromnej, przeszklonej werandy z częściowo powybijanymi szybami, obrosłej pajęczyną i zagraconej, jak i całe wnętrze domostwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "61e2c8b7-8661-3bb6-8f82-9289a00725dc",
                        "entry_id": "e3bd185c-0033-385b-85b9-811f3e9b8b36",
                        "glosses": [
                            "taki, z którym coś połączyło się nierozłącznie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f25d3ae2-9633-42c7-9081-9b04a9a4fa55",
                                "sense_id": "61e2c8b7-8661-3bb6-8f82-9289a00725dc",
                                "text": "Zgromadzeni na terenie dawnej Stoczni Gdańskiej widzowie odbędą wraz z tytułowym bohaterem symboliczną podróż do miejsca niegdyś znanego i bliskiego, obrosłego w historyczne skojarzenia i stereotypy, dziś opuszczonego i wymagającego świeżego spojrzenia."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
