                "senses": [
                    {
                        "sense_id": "3e84ecb5-ee80-3ab9-925a-f210e9115cdc",
                        "entry_id": "71234016-49a3-392e-acfb-db817051139d",
                        "glosses": [
                            "Affecter de mildiou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46cbff77-c23d-4b54-b1da-f3d7ffb136e5",
                                "sense_id": "3e84ecb5-ee80-3ab9-925a-f210e9115cdc",
                                "text": "moi aussi je vais complètement abandonner la culture des tomates en plein air...ras le bol de me faire mildiouser..."
                            },
                            {
                                "example_id": "7875cb27-4a7c-4d29-a68d-d06db5847673",
                                "sense_id": "3e84ecb5-ee80-3ab9-925a-f210e9115cdc",
                                "text": "J'ai déjà fait de la récup quand j'ai fait mes coulis avec celles qui avaient été goûtées par les bestioles, les \"cerises\" un peu éclatées et celles qui étaient rouges mais dont j'ai enlevé les petites paries qui commençaient à mildiouser."
                            },
                            {
                                "example_id": "9147110d-7e31-4aa0-995b-4154f310b60f",
                                "sense_id": "3e84ecb5-ee80-3ab9-925a-f210e9115cdc",
                                "text": "tu devrais prévoir au moins une bâche enroulable sur un piquet par exemple pour fermer le côté d'où vient la pluie, parce que si tu laisses ouvert tu vas te faire mildiouser."
                            }
                        ]
                    }
