                "senses": [
                    {
                        "sense_id": "c9ec157b-56d8-3467-8a56-dbf7eeb78039",
                        "entry_id": "e018e2ee-c585-36e0-bc5d-52f82b194d71",
                        "glosses": [
                            "Linguistik, speziell Versuch der Einteilung der Sprechakte in wenige Klassen, Typen"
                        ],
                        "tags": [
                            "Sprechakttheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "664fc456-2951-492d-bfc1-64a0ee295fe8",
                                "sense_id": "c9ec157b-56d8-3467-8a56-dbf7eeb78039",
                                "text": "„Als Folge ist die Behauptung, daß die lexikalische Analyse zugleich eine Sprechaktklassifikation sei, nicht prüfbar.“"
                            },
                            {
                                "example_id": "9b8f2cd6-d1de-4127-9ad1-4221bab4c87e",
                                "sense_id": "c9ec157b-56d8-3467-8a56-dbf7eeb78039",
                                "text": "Die Sprechaktklassifikation von J.R. Searle sieht 5 Klassen von Sprechakten (Sprechakttypen) vor: repräsentativer Akt, direktiver Akt, kommissiver Akt, expressiver Akt, deklarativer Akt"
                            },
                            {
                                "example_id": "da1aec21-2824-4ab2-94a4-a7a93482212e",
                                "sense_id": "c9ec157b-56d8-3467-8a56-dbf7eeb78039",
                                "text": "„Als Grundschema kann die Sprechaktklassifikation von Searle (1967) gegeben werden, die den Ausgangspunkt für weiterführende Diskussionen gebildet hat und bildet…“"
                            }
                        ],
