                                                "sense_id": "ee13aa54-11d1-3caa-a0fe-da1419e40f4a",
                                                "text": "We got a news brief."
                                            },
                                            {
                                                "example_id": "5fbc10ea-321c-4d4e-a15f-515efda93b7e",
                                                "sense_id": "ee13aa54-11d1-3caa-a0fe-da1419e40f4a",
                                                "text": "Hie good ſir Mighell, beare this ſealed briefe / With winged haſte to the Lord Marſhall / This to my cooſen Scroope, and all the reſt / To whom they are directed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8e4aefe-920d-359a-bbe4-5b5bc43e7e90",
                                        "entry_id": "09986738-932a-3abb-81ad-491cf30c1b53",
                                        "glosses": [
                                            "Underwear briefs."
                                        ],
