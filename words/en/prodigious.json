                },
                {
                    "sense_id": "f66a8b4b-0eb9-3c18-a214-9e184249d370",
                    "sense_definition": "Acting as an omen or sign of future events, often negative.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "omen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden eclipse was seen as a <w>prodigious</w> event by the ancient people.",
                            "target_lang_translations": {
                                "nl": "De plotselinge zonsverduistering werd door de oude volkeren als een <w>onheilspellende</w> gebeurtenis gezien."
                            }
                        },
                        {
                            "text": "He interpreted the strange weather patterns as a <w>prodigious</w> warning.",
                            "target_lang_translations": {
                                "nl": "Hij interpreteerde de vreemde weerpatronen als een <w>onheilspellende</w> waarschuwing."
                            }
                        }
                    ],
                    "synonyms": [
                        "ominous",
                        "portentous",
                        "foreboding"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or historical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Dienend als een voorteken of teken van toekomstige gebeurtenissen, vaak negatief."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onheilspellend",
                                "target_lang_sense_clarification": "Een slecht voorteken gevend."
                            },
                            {
                                "target_lang_word": "voortekenachtig",
                                "target_lang_sense_clarification": "Betrekking hebbend op een teken van de toekomst."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "900b30b4-c7a5-31d2-bdc7-4fcaa545a7fd",
                    "sense_definition": "In a very large or extreme manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was <w>prodigious</w> difficult to complete on such a short deadline.",
                            "target_lang_translations": {
                                "nl": "Het project was <w>buitengewoon</w> moeilijk te voltooien met zo'n korte deadline."
                            }
                        },
                        {
                            "text": "He was <w>prodigious</w> busy preparing for the upcoming international conference.",
                            "target_lang_translations": {
                                "nl": "Hij was <w>enorm</w> druk met de voorbereidingen voor de komende internationale conferentie."
                            }
                        }
                    ],
                    "synonyms": [
                        "prodigiously"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally as an intensifier."
                        }
