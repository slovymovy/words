                ],
                "senses": [
                    {
                        "sense_id": "66324e53-ea67-30c9-8c78-89f1d2007815",
                        "entry_id": "363e63a4-7848-3bfd-b858-b3c9fed4b6bb",
                        "glosses": [
                            "Benennung eines Produkts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a912c5-9150-4232-9024-50d2347a4f84",
                                "sense_id": "66324e53-ea67-30c9-8c78-89f1d2007815",
                                "text": "„Wörterbuch und Enzyklopädie sind nicht nur im deutschsprachigen Raum an bestimmte Produktnamen geknüpft, die dazu tendieren, Gattungsnamen zu sein: Duden und Brockhaus stehen nicht selten für ganze Klassen ähnlicher Werke, gleich aus welchem Verlag…“"
                            },
                            {
                                "example_id": "560f6f35-6827-48a2-bc84-deace6be2d8f",
                                "sense_id": "66324e53-ea67-30c9-8c78-89f1d2007815",
                                "text": "„Rund um den Globus sind über 10 Millionen Warenzeichen registriert; der moderne homo oeconomicus kommt neueren Erkenntnissen zufolge täglich mit rund 300 Produktnamen in Berührung.“"
                            },
                            {
                                "example_id": "4e4fe677-1118-4b89-82d3-a049f03714a2",
                                "sense_id": "66324e53-ea67-30c9-8c78-89f1d2007815",
                                "text": "„Wieder andere Werber knüpfen bestimmte Bild- und Textvorstellungen an die Ambivalenz des Produktnamens (zum Beispiel Wilkinson-Rasierklingen: Schwertklingen: Ritterleben).“"
                            },
                            {
                                "example_id": "d2e5b358-ea96-4831-a700-4f64567d3f47",
                                "sense_id": "66324e53-ea67-30c9-8c78-89f1d2007815",
                                "text": "„Weit jenseits ihrer alten Bezüge und Wurzeln in den deutschen Sondersprachen sind Hebraismen auch in Produktnamen eingegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
