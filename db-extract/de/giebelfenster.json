                "senses": [
                    {
                        "sense_id": "b167c937-dc7e-35bf-9ba7-3c5518bb65f8",
                        "entry_id": "2b9118df-551c-3b02-8758-fce991d1b71b",
                        "glosses": [
                            "Fenster im Giebel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f5a950-1789-4b4c-9463-969cb8f2d41c",
                                "sense_id": "b167c937-dc7e-35bf-9ba7-3c5518bb65f8",
                                "text": "„Er residiere auf dem Vorgebirge, in dem fernen Gebäude, dessen Giebelfenster man zuweilen im Spiel des Lichts aufblitzen sehe.“"
                            },
                            {
                                "example_id": "6c7b7a54-f53c-45cf-9b89-7afddaaf8af4",
                                "sense_id": "b167c937-dc7e-35bf-9ba7-3c5518bb65f8",
                                "text": "„Als ich wieder auf den Beinen war, hatten sie den Altar unter dem unchristlichen Giebelfenster in der Kirche angebracht und ihn rot gemalt, so daß man keine Spur von Heiligen und Latein mehr entdecken konnte.“"
                            },
                            {
                                "example_id": "a623f30a-d57a-465b-91b8-93dcf8c045f3",
                                "sense_id": "b167c937-dc7e-35bf-9ba7-3c5518bb65f8",
                                "text": "„Es ist so schwer, sagt er schließlich und schaut aus dem Giebelfenster, das einen Rahmen um den Fjord bildet, wo er sich öffnet und in den weiten Golf ausblutet, das Fenster scheint größer zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
