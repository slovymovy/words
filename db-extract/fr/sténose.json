                                "target_senses": [
                                    {
                                        "sense_id": "787a3831-d46e-3742-89ae-9bcfc62fe340",
                                        "entry_id": "116d97ca-46ab-39f5-bc55-87a7fc573a97",
                                        "glosses": [
                                            "Verengung eines Blutgefäßes oder Hohlorgans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a9fc1ed-49e5-40bc-a68b-417351ff6818",
                                                "sense_id": "787a3831-d46e-3742-89ae-9bcfc62fe340",
                                                "text": "Manchmal (z.B. wenn der Bandscheibenvorfall mit Stenose verbunden ist) ist es für den Chirurgen nicht möglich, die Operation mittels eines Endoskopes durchzuführen."
                                            }
