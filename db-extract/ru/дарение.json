                                "target_senses": [
                                    {
                                        "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                        "entry_id": "5c832cfb-a6dd-30c0-9003-2fc09ad5cfec",
                                        "glosses": [
                                            "Don qui se fait par acte public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48447ca2-b75d-4d35-90e5-70bc21c7c298",
                                                "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                                "text": "Nous parlions de drame, ah ! je vous assure que si nous pouvions dire le secret de certaines donations, nos auteurs pourraient en faire de terribles tragédies bourgeoises."
                                            },
                                            {
                                                "example_id": "da998cac-a405-4a08-995c-d6b394eb101c",
                                                "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                                "text": "[…], par conséquent, il y a eu concours des volontés et réalisation de la donation le jour où la chose, offerte par le donateur (en la personne de son mandataire), a été acceptée par le donataire en personne."
                                            },
                                            {
                                                "example_id": "f3d95a30-4c30-4937-af2e-668e3d5c5993",
                                                "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                                "text": "Le 14 mars 1775, Louis-Alexandre d'Auger, par donation entre vifs et en avancement d’hoirie, laissait les 7/8 de Belestre à son fils Pierre-Alexandre, et celui-ci en faisait foi et hommage le 31 mai 1775."
                                            },
                                            {
                                                "example_id": "886cf2ac-5b3e-49dc-a737-65ea843aa5f4",
                                                "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                                "text": "III. Pour l'application du présent article, les donations entre vifs ne sont pas opposables à l'administration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf795ba-f0ef-394c-825d-45ff4c6e8e00",
                                        "entry_id": "5c832cfb-a6dd-30c0-9003-2fc09ad5cfec",
                                        "glosses": [
                                            "L’acte par lequel on fait une donation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
