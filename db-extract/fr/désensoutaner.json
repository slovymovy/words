                "senses": [
                    {
                        "sense_id": "cd99c30c-2030-38bc-8194-9ec60cb47cf5",
                        "entry_id": "0cb8f13b-6503-3122-93c6-b64ab536ba4f",
                        "glosses": [
                            "Faire en sorte que quelqu'un ne soit plus influencé par les prêtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4746ce0-23ff-4e84-989e-78bac779561b",
                                "sense_id": "cd99c30c-2030-38bc-8194-9ec60cb47cf5",
                                "text": "Je serai là, sois tranquille ; avec ta permission, je lui ferai même un doigt de cour, à cette ingrate. Il faut la désensoutaner, la remettre dans le train."
                            },
                            {
                                "example_id": "77d3e32e-e998-46c2-905e-bd17760587a4",
                                "sense_id": "cd99c30c-2030-38bc-8194-9ec60cb47cf5",
                                "text": "La Maçonnerie veut bien m’aider dans la tâche si ingrate de démocratiser et de désensoutaner (ouf ! !) nos officiers si hostiles et si inféodés à Sarto !"
                            }
                        ]
                    }
