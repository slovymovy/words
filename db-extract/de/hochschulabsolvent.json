                    {
                        "sense_id": "5e27c647-49f1-3d21-8282-e19232a701f8",
                        "entry_id": "62a8e04e-b395-3b5d-b094-32ce482c1f3c",
                        "glosses": [
                            "Person, die eine Hochschulausbildung abgeschlossen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9359a692-54d2-4077-8599-8e586695313b",
                                "sense_id": "5e27c647-49f1-3d21-8282-e19232a701f8",
                                "text": "„Die Einkommen von Hochschulabsolventen liegen in Österreich um rund 80 Prozent (Männer) bzw. 70 Prozent (Frauen) über jenen von Absolventen des Sekundarbereichs II (Matura, Lehre).“"
                            },
                            {
                                "example_id": "a9238264-511a-41a5-97e0-301204a492f2",
                                "sense_id": "5e27c647-49f1-3d21-8282-e19232a701f8",
                                "text": "„Angesichts von Hunderten unterschiedlicher Krawatten sei er immer besonders ratlos, sagt der Hochschulabsolvent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
