                ],
                "senses": [
                    {
                        "sense_id": "3feff199-ce9b-37ac-a026-823f4a79c9e0",
                        "entry_id": "e7f48436-a1be-35be-a093-a5e2ac5976fa",
                        "glosses": [
                            "Angebot von kulturellen Einrichtungen und Veranstaltungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8fa9af-9ff8-4694-9240-58ff6cabfbf9",
                                "sense_id": "3feff199-ce9b-37ac-a026-823f4a79c9e0",
                                "text": "„Sie sind einfacher vom Tourismusmarketing zu erreichen, für ein anspruchsvolleres Kulturangebot jedoch schwieriger zu motivieren.“"
                            },
                            {
                                "example_id": "1836e6e6-e4d4-40e7-997e-b7f40daa107d",
                                "sense_id": "3feff199-ce9b-37ac-a026-823f4a79c9e0",
                                "text": "„Bei der Art des Verhältnisses von Kulturangebot und Rezeptionsweisen handelt es sich stets um ein vermitteltes Verhältnis.“"
                            },
                            {
                                "example_id": "3efacd4b-4601-4559-a39d-c861f2e2d32b",
                                "sense_id": "3feff199-ce9b-37ac-a026-823f4a79c9e0",
                                "text": "„Mit speziellen Kulturangeboten erhofften sich die Schweden, die Gesundheit des Volkes verbessern zu können.“"
                            },
                            {
                                "example_id": "39f3d94a-266f-4e4a-b4c9-875b63a8da0f",
                                "sense_id": "3feff199-ce9b-37ac-a026-823f4a79c9e0",
                                "text": "„Dennoch trägt das Kulturangebot für die Unternehmen und die Angestellten zum Wohlbefinden am Ort bei, selbst wenn das Angebot nur begrenzt genutzt wird.“"
                            },
                            {
                                "example_id": "aa68b9ba-c5a8-4031-8873-b684a4fa7fff",
                                "sense_id": "3feff199-ce9b-37ac-a026-823f4a79c9e0",
                                "text": "„Außerdem wirkt sich das Kulturangebot auf die Attraktivität der Stadt und die Lebensqualität aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
