            "senses": [
                {
                    "sense_id": "8900a47c-e6e1-37c2-b52f-ffe0d817673f",
                    "sense_definition": "Filled with or expressing a feeling of great respect, wonder, or fear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists stood in <w>awed</w> silence as they gazed at the ancient cathedral.",
                            "target_lang_translations": {
                                "de": "Die Touristen verharrten in <w>ehrfürchtigem</w> Schweigen, als sie die alte Kathedrale betrachteten."
                            }
                        },
                        {
                            "text": "The children listened to the astronaut's incredible stories with <w>awed</w> faces.",
                            "target_lang_translations": {
                                "de": "Die Kinder lauschten den unglaublichen Geschichten des Astronauten mit <w>staunenden</w> Gesichtern."
                            }
                        }
                    ],
                    "synonyms": [
                        "awestruck",
                        "awestricken",
                        "thunderstruck"
                    ],
                    "common_phrases": [
                        "awed silence",
                        "awed whisper"
                    ],
                    "target_lang_definitions": {
