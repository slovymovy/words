{
    "word_family": [
        "quarterly",
        "headquarters",
        "quartermaster",
        "quarterback",
        "quarterdeck",
        "quarterstaff"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "902a364a-0cba-375f-95da-45826c44b1dd",
                    "sense_definition": "A period of fifteen minutes, especially with reference to the time before or after the hour.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>quarter</w> past five, so we should leave soon.",
                            "target_lang_translations": {
                                "ru": "Сейчас <w>четверть</w> шестого, так что нам пора выходить.",
                                "zh": "现在是五点一<w>刻</w>，我们该走了。"
                            }
                        },
                        {
                            "text": "The bus arrives at a <w>quarter</w> to eight every morning.",
                            "target_lang_translations": {
                                "ru": "Автобус приезжает без <w>четверти</w> восемь каждое утро.",
                                "zh": "每天早上七点三<w>刻</w>公交车会到。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "quarter past",
                        "quarter to",
                        "quarter of an hour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период в пятнадцать минут, особенно по отношению к времени до или после часа.",
                        "zh": "指十五分钟的时间段，常用于表示整点前后的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "че́тверть",
                                "target_lang_sense_clarification": "времени (15 минут)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刻",
                                "target_lang_sense_clarification": "指十五分钟"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88638b63-ed55-35a2-acc9-045d4d7cf95b",
                    "sense_definition": "One of four equal parts into which something can be divided; a fourth part (25%).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I only ate a <w>quarter</w> of the pizza because I was not very hungry.",
                            "target_lang_translations": {
                                "ru": "Я съел только <w>четверть</w> пиццы, потому что был не очень голоден.",
                                "zh": "我不太饿，所以只吃了<w>四分之一</w>的披萨。"
                            }
                        },
                        {
                            "text": "About a <w>quarter</w> of the students in the class speak Spanish.",
                            "target_lang_translations": {
                                "ru": "Около <w>четверти</w> студентов в классе говорят по-испански.",
                                "zh": "班里大约有<w>四分之一</w>的学生会说西班牙语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fourth",
                        "one-fourth",
                        "one-quarter",
                        "¼",
                        "fourth part"
                    ],
                    "common_phrases": [
                        "a quarter of",
                        "three quarters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из четырех равных частей, на которые можно разделить что-либо; четвертая часть (25%).",
                        "zh": "四等分中的一份；四分之一（25%）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "че́тверть",
                                "target_lang_sense_clarification": "доля"
                            },
                            {
                                "target_lang_word": "четвёртая часть",
                                "target_lang_sense_clarification": "доля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "四分之一",
                                "target_lang_sense_clarification": "分数或比例"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8fd0ff6-9e0a-3dad-8cd1-ed0a97e1cd5d",
                    "sense_definition": "A coin worth 25 cents in the United States or Canada.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a <w>quarter</w> to put in the parking meter.",
                            "target_lang_translations": {
                                "ru": "Мне нужна <w>монета в 25 центов</w>, чтобы заплатить за парковку.",
                                "zh": "我需要一枚<w>25美分硬币</w>来投进停车计时器。"
                            }
                        },
                        {
                            "text": "He found a shiny <w>quarter</w> on the sidewalk near the store.",
                            "target_lang_translations": {
                                "ru": "Он нашел блестящий <w>четвертак</w> на тротуаре возле магазина.",
                                "zh": "他在商店附近的人行道上发现了一枚闪亮的<w>25美分硬币</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US, Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Монета достоинством 25 центов в США или Канаде.",
                        "zh": "美国或加拿大面值为25美分的硬币。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "два́дцать пять це́нтов",
                                "target_lang_sense_clarification": "монета"
                            },
                            {
                                "target_lang_word": "четверта́к",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "25美分硬币",
                                "target_lang_sense_clarification": "货币单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b5c2769-4fbf-3e94-aeef-579a7e3a881c",
                    "sense_definition": "A period of three months; one of the four periods into which a year is divided for financial or business purposes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported higher profits in the first <w>quarter</w> of the year.",
                            "target_lang_translations": {
                                "ru": "Компания отчиталась о более высокой прибыли в первом <w>квартале</w> года.",
                                "zh": "公司报告称今年第一<w>季度</w>利润有所增长。"
                            }
                        },
                        {
                            "text": "We have a sales meeting scheduled for the end of this <w>quarter</w>.",
                            "target_lang_translations": {
                                "ru": "У нас запланировано собрание по продажам на конец этого <w>квартала</w>.",
                                "zh": "我们计划在本<w>季度</w>末召开销售会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "three-month period"
                    ],
                    "common_phrases": [
                        "first quarter",
                        "fiscal quarter",
                        "fourth quarter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период в три месяца; один из четырех периодов, на которые делится год для финансовых или деловых целей.",
                        "zh": "三个月的时间段；为财务或商业目的将一年划分成的四个时期之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кварта́л",
                                "target_lang_sense_clarification": "года (3 месяца)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "季度",
                                "target_lang_sense_clarification": "三个月的时间段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e17c8c50-e953-3273-b24f-fda9ab2a3336",
                    "sense_definition": "A specific district or section of a town or city, often associated with a particular group or activity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in the historic <w>quarter</w> of the city, which is full of old buildings.",
                            "target_lang_translations": {
                                "ru": "Они живут в историческом <w>квартале</w> города, полном старинных зданий.",
                                "zh": "他们住在城里的历史<w>街区</w>，那里到处都是古老的建筑。"
                            }
                        },
                        {
                            "text": "We visited the artist's <w>quarter</w> to look at the local galleries.",
                            "target_lang_translations": {
                                "ru": "Мы посетили <w>квартал</w> художников, чтобы посмотреть местные галереи.",
                                "zh": "我们参观了艺术家<w>区</w>，去看了当地的画廊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "district",
                        "neighborhood",
                        "ward",
                        "borough",
                        "area",
                        "section"
                    ],
                    "common_phrases": [
                        "Latin Quarter",
                        "French Quarter",
                        "residential quarter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный район или часть города, часто связанная с определенной группой или деятельностью.",
                        "zh": "城镇或城市中的特定区域，通常与特定的群体或活动相关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кварта́л",
                                "target_lang_sense_clarification": "часть города"
                            },
                            {
                                "target_lang_word": "райо́н",
                                "target_lang_sense_clarification": "часть города"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区",
                                "target_lang_sense_clarification": "城市区域"
                            },
                            {
                                "target_lang_word": "街区",
                                "target_lang_sense_clarification": "城市区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16236d83-7d3d-3820-9d6e-2ccda681b811",
                    "sense_definition": "One of four equal periods into which a game (such as American football or basketball) is divided.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team scored two goals in the final <w>quarter</w> to win the match.",
                            "target_lang_translations": {
                                "ru": "Команда забила два гола в последней <w>четверти</w>, чтобы выиграть матч.",
                                "zh": "球队在最后一<w>节</w>打进两球，赢得了比赛。"
                            }
                        },
                        {
                            "text": "By the end of the third <w>quarter</w>, the players were visibly tired.",
                            "target_lang_translations": {
                                "ru": "К концу третьей <w>четверти</w> игроки заметно устали.",
                                "zh": "到第三<w>节</w>结束时，球员们明显感到疲惫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fourth quarter",
                        "first quarter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из четырех равных периодов, на которые делится игра (например, американский футбол или баскетбол).",
                        "zh": "体育比赛（如美式足球或篮球）中四个相等比赛时段之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "че́тверть",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "пери́од",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节",
                                "target_lang_sense_clarification": "体育比赛时段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6027e07e-e361-3666-9b19-1da83116360b",
                    "sense_definition": "Living accommodations or lodgings, especially for military personnel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers returned to their <w>quarters</w> after a long day of training.",
                            "target_lang_translations": {
                                "ru": "Солдаты вернулись в свои <w>казармы</w> после долгого дня тренировок.",
                                "zh": "经过一整天的训练，士兵们回到了他们的<w>营房</w>。"
                            }
                        },
                        {
                            "text": "Our living <w>quarters</w> on the ship were small but comfortable enough.",
                            "target_lang_translations": {
                                "ru": "Наши жилые <w>помещения</w> на корабле были маленькими, но довольно удобными.",
                                "zh": "我们在船上的<w>住所</w>虽然小，但还算舒适。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "living quarters",
                        "close quarters",
                        "headquarters"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жилые помещения или жилье, особенно для военнослужащих.",
                        "zh": "居住场所或住所，尤指军人的驻地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилы́е помеще́ния",
                                "target_lang_sense_clarification": "жильё"
                            },
                            {
                                "target_lang_word": "каза́рма",
                                "target_lang_sense_clarification": "для военных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "住所",
                                "target_lang_sense_clarification": "居住地"
                            },
                            {
                                "target_lang_word": "营房",
                                "target_lang_sense_clarification": "军人住所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7921d27-7a87-3110-b255-252dd44aa339",
                    "sense_definition": "A specific person, group, or area from which something originates or comes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Support for the new policy came from an unexpected <w>quarter</w>.",
                            "target_lang_translations": {
                                "ru": "Поддержка новой политики пришла с неожиданной <w>стороны</w>.",
                                "zh": "对这项新政策的支持来自一个意想不到的<w>方面</w>。"
                            }
                        },
                        {
                            "text": "The government faced criticism from all <w>quarters</w> regarding the tax increase.",
                            "target_lang_translations": {
                                "ru": "Правительство столкнулось с критикой со всех <w>сторон</w> по поводу повышения налогов.",
                                "zh": "政府因增税而面临来自各<w>方面</w>的批评。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "from all quarters",
                        "unexpected quarter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный человек, группа или область, от которой что-то исходит.",
                        "zh": "指某事物的来源或出处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторона́",
                                "target_lang_sense_clarification": "направление, источник"
                            },
                            {
                                "target_lang_word": "исто́чник",
                                "target_lang_sense_clarification": "происхождение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方面",
                                "target_lang_sense_clarification": "来源或方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dd2c740-89e4-35d1-84f5-c791bebdabb3",
                    "sense_definition": "Exemption from being killed granted to a defeated enemy; mercy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mercy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ruthless pirates gave no <w>quarter</w> to the crew of the captured ship.",
                            "target_lang_translations": {
                                "ru": "Безжалостные пираты не давали <w>пощады</w> команде захваченного корабля.",
                                "zh": "残忍的海盗没有给被俘船只的船员任何<w>宽恕</w>。"
                            }
                        },
                        {
                            "text": "He fought bravely until the end and asked for no <w>quarter</w> from his opponent.",
                            "target_lang_translations": {
                                "ru": "Он храбро сражался до конца и не просил <w>пощады</w> у своего противника.",
                                "zh": "他战斗到最后一刻，没有向对手乞求<w>宽恕</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give no quarter",
                        "ask for quarter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освобождение от убийства, дарованное побежденному врагу; милосердие.",
                        "zh": "给予战败敌人的宽恕或怜悯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поща́да",
                                "target_lang_sense_clarification": "милосердие к врагу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宽恕",
                                "target_lang_sense_clarification": "对敌人的怜悯"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3605dc43-f9d4-3f62-bed4-7a4d3851ef22",
                    "sense_definition": "To divide something into four equal or roughly equal parts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>quartered</w> the apple to share it with her three friends.",
                            "target_lang_translations": {
                                "ru": "Она <w>разрезала на четвертинки</w> яблоко, чтобы поделиться с тремя друзьями.",
                                "zh": "她把苹果<w>四等分</w>，好和三个朋友分享。"
                            }
                        },
                        {
                            "text": "The chef peeled and <w>quartered</w> the potatoes before boiling them.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар почистил и <w>разрезал на четыре части</w> картофель перед варкой.",
                                "zh": "厨师在煮土豆前先削皮并将其<w>四等分</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делить что-либо на четыре равные или примерно равные части.",
                        "zh": "将某物分成四等份。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дели́ть на че́тыре ча́сти",
                                "target_lang_sense_clarification": "разделять"
                            },
                            {
                                "target_lang_word": "разреза́ть на четверти́нки",
                                "target_lang_sense_clarification": "кулинария"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "四等分",
                                "target_lang_sense_clarification": "动词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0c2524f-29a8-384b-9b62-51e7d93418f4",
                    "sense_definition": "To provide with lodging or shelter, especially for military troops.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The troops were <w>quartered</w> in the village during the winter months.",
                            "target_lang_translations": {
                                "ru": "Войска были <w>расквартированы</w> в деревне в зимние месяцы.",
                                "zh": "冬季期间，部队被<w>安置</w>在村子里。"
                            }
                        },
                        {
                            "text": "The government was obliged to <w>quarter</w> the refugees in temporary camps.",
                            "target_lang_translations": {
                                "ru": "Правительство было обязано <w>разместить</w> беженцев во временных лагерях.",
                                "zh": "政府被迫将难民<w>安置</w>在临时营地中。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять жилье или укрытие, особенно для военных отрядов.",
                        "zh": "提供住宿或住所，尤指为军队提供驻地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расквартиро́вывать",
                                "target_lang_sense_clarification": "размещать войска"
                            },
                            {
                                "target_lang_word": "размеща́ть",
                                "target_lang_sense_clarification": "предоставлять жилье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安置",
                                "target_lang_sense_clarification": "提供住所"
                            },
                            {
                                "target_lang_word": "驻扎",
                                "target_lang_sense_clarification": "军队驻地"
