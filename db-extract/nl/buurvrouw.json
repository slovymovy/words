                                                "sense_id": "024b2372-ee07-3583-9459-a2f4726b4794",
                                                "text": "That sort of talk is neighbouring on treason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f54418cd-08e3-30b5-8033-fe90dc977fa7",
                                        "entry_id": "ee72ef48-2aa7-3ced-9527-640b0d2a6e09",
                                        "glosses": [
                                            "To associate intimately with; to be close to."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4669ea66-cc6b-46cc-b09d-ea9e870eb3ec",
                                                "sense_id": "f54418cd-08e3-30b5-8033-fe90dc977fa7",
                                                "text": "[…] the barbarous Scythyan, […] / Shall bee as well neighbour’d, pittyed and relieued / As thou my ſometime daughter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
