                "senses": [
                    {
                        "sense_id": "912cc801-d92a-3bf8-a48a-6777cb5f79af",
                        "entry_id": "d26e8f8f-c7de-3de1-be20-bc4062d3e132",
                        "glosses": [
                            "Qui se fait pendant la saison d’été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff75c3e-decd-4f65-86e7-89c4d5645562",
                                "sense_id": "912cc801-d92a-3bf8-a48a-6777cb5f79af",
                                "text": "Tout l’été, le Petit Bleu part à la rencontre de saisonniers, étudiants ou employés à l’année, pour qui les mois d’août et de juillet riment avec travail estivalier."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e078215-e522-3093-a04f-379d5feab5e3",
                        "entry_id": "d26e8f8f-c7de-3de1-be20-bc4062d3e132",
                        "glosses": [
                            "Qui appartient au tourisme d’été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed3e2143-8182-4053-8540-f7adef1aa65e",
                                "sense_id": "6e078215-e522-3093-a04f-379d5feab5e3",
                                "text": "\"C’est vrai que mon fils Max est célèbre à Paris ?\" demandait Madame Jacob à tout le gratin estivalier qui défilait chez elle."
                            },
                            {
                                "example_id": "686496ab-1bc2-48ee-8c72-5353db387d95",
                                "sense_id": "6e078215-e522-3093-a04f-379d5feab5e3",
                                "text": "Unique dans son genre, l’exposition, qui a fermé ses portes dimanche, a séduit un large public local et estivalier, curieux de découvrir ces acteurs qui font, ou ont fait, vibrer les arènes."
                            },
                            {
                                "example_id": "50c17641-f70a-4a76-bc39-97788e86a777",
                                "sense_id": "6e078215-e522-3093-a04f-379d5feab5e3",
                                "text": "Le FIFAK réunit au cours de chaque édition,outre le public estivalier, plus de 1200 participants issus de la fédération tunisienne des cinéastes amateurs, des différentes associations cinématographiques tunisiennes, des étudiants d’écoles de cinéma ainsi que des professionnels et des invités du secteur de l’audiovisuel."
                            }
                        ]
                    }
                ],
