                        "examples": [
                            {
                                "example_id": "3918aa2e-c620-4cba-8b54-c46358cde97a",
                                "sense_id": "2176ed77-e4ce-3ed9-97ed-ac94611151c0",
                                "text": "Van de sublieme Ronnie O’Sullivan, die Marco Fu met 6-0 versloeg in de Snooker Masters 2018, was in zijn tweede partij tegen Mark Allen helemaal niets meer over. Als een beginneling stond The Rocket in het Londense Ally Pally aan de snookertafel en werd met maar liefst 6-1 afgedroogd."
                            },
                            {
                                "example_id": "b8f1eb8f-15dc-4618-8810-23d37f7e8cc6",
                                "sense_id": "2176ed77-e4ce-3ed9-97ed-ac94611151c0",
                                "text": "O’Sullivan probeerde in de derde sessie van de match, bij de stand 10-6 voor de Chinees, het tij nog te keren in een poging om zijn zesde wereldtitel te pakken. Maar Junhui bleef als ijskonijn aan de snookertafel en wist de controle over de partij te houden."
                            }
                        ]
                    }
