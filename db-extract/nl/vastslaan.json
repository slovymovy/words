                                                "example_id": "58021a35-8e47-4811-8711-cd793781f213",
                                                "sense_id": "4302c2d1-8ef4-34af-ada3-37169b84369f",
                                                "text": "They haven't nailed down their vacation plans yet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2b8af1a-d174-4d93-94cb-e49ba40aa74d",
