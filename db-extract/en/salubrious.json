                                    {
                                        "sense_id": "74af68ed-d76c-304b-ad0b-2aa849b5179d",
                                        "entry_id": "13031dce-de55-3b0d-860c-cbe6829bd52b",
                                        "glosses": [
                                            "jemanden dazu bewegend, umzudenken / sich zu bessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00a27038-89d6-42c7-b842-877bffd14841",
                                                "sense_id": "74af68ed-d76c-304b-ad0b-2aa849b5179d",
                                                "text": "Ein neuer Ölpreisschock wäre heilsam, weil wir dann endlich ernsthaft CO₂ einsparen würden."
                                            },
                                            {
                                                "example_id": "49102174-b915-45d3-bd8b-32f4dfea2e3e",
                                                "sense_id": "74af68ed-d76c-304b-ad0b-2aa849b5179d",
                                                "text": "Druck ist mitunter heilsam: Käme bis zum Wochenende keine Regierung in Spanien zustande, müsste es Neuwahlen geben. Doch die fürchten die Sozialisten."
                                            },
                                            {
                                                "example_id": "9836745a-ab76-44fb-920a-a70ff3ec4810",
                                                "sense_id": "74af68ed-d76c-304b-ad0b-2aa849b5179d",
                                                "text": "Ohne eine wettbewerbsfähige Position im Supercomputing kann eine moderne Volkswirtschaft nicht bestehen. Darüber soll man im Berliner Forschungsministerium erschrocken sein – ebenso wie im Wirtschaftsministerium. Aber dieser Schreck könnte heilsam sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0ec0d7e-159c-30a6-9440-9c7d590db134",
                                        "entry_id": "13031dce-de55-3b0d-860c-cbe6829bd52b",
                                        "glosses": [
                                            "heilend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb3b187-f0f6-46e7-b7a8-94b450b8b75d",
                                                "sense_id": "f0ec0d7e-159c-30a6-9440-9c7d590db134",
                                                "text": "[…] tief einatmen, still sein, ausatmen. Klingt banal, braucht aber Anleitung. Solche Übungen sollen heilsam auf Leib, Geist und Seele wirken."
                                            },
                                            {
                                                "example_id": "ebd24324-f253-4049-855b-68a3ffc352b5",
                                                "sense_id": "f0ec0d7e-159c-30a6-9440-9c7d590db134",
                                                "text": "[…] Schon griechische Ärzte der Antike, Hildegard von Bingen und die traditionelle asiatische Medizin wussten von der heilsamen Wirkung [des Ingwers]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
