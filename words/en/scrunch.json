{
    "word_family": [
        "scrunched",
        "scrunchy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe8b97ab-70af-3397-b7ce-fd01b5fb6708",
                    "sense_definition": "To crumple and squeeze something to make it more compact.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "squeeze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>scrunched</w> the paper into a small ball and threw it away.",
                            "target_lang_translations": {
                                "cs": "Papír <w>zmačkal</w> do malé kuličky a vyhodil ho."
                            }
                        },
                        {
                            "text": "She <w>scrunched</w> up the letter before tossing it into the bin.",
                            "target_lang_translations": {
                                "cs": "Dopis <w>zmuchlala</w>, než ho hodila do koše."
                            }
                        }
                    ],
                    "synonyms": [
                        "crush",
                        "crumple",
                        "squeeze"
                    ],
                    "common_phrases": [
                        "scrunch up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zmačkat nebo stlačit něco do menšího tvaru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zmačkat",
                                "target_lang_sense_clarification": "používá se pro papír nebo látku"
                            },
                            {
                                "target_lang_word": "zmuchlat",
                                "target_lang_sense_clarification": "neformální výraz pro zmačkání do koule"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b75c5813-cc22-3168-a946-2b2cc9698ee9",
                    "sense_definition": "To contract facial muscles to draw features together, often due to pain or discomfort.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "squeeze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>scrunched</w> his eyebrows in confused frustration.",
                            "target_lang_translations": {
                                "cs": "Zmateně a frustrovaně <w>svraštil</w> obočí."
                            }
                        },
                        {
                            "text": "She <w>scrunched</w> up her face when she tasted the sour lemon.",
                            "target_lang_translations": {
                                "cs": "Když ochutnala kyselý citron, <w>zkřivila</w> obličej."
                            }
                        }
                    ],
                    "synonyms": [
                        "grimace",
                        "frown"
                    ],
                    "common_phrases": [
                        "scrunch up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stáhnout obličejové svaly k sobě, často kvůli bolesti nebo nepohodlí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zkřivit",
                                "target_lang_sense_clarification": "zkřivit obličej v reakci na něco"
                            },
                            {
                                "target_lang_word": "svraštit",
                                "target_lang_sense_clarification": "stáhnout obočí nebo kůži na obličeji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72172a1c-10ae-3e9a-8d92-05433436d7ef",
                    "sense_definition": "A crunching noise.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scrunch</w> of dry leaves under our boots was the only sound.",
                            "target_lang_translations": {
                                "cs": "Jediným zvukem bylo <w>křupání</w> suchého listí pod našimi botami."
                            }
                        },
                        {
                            "text": "We heard the loud <w>scrunch</w> of gravel as the car pulled into the driveway.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme hlasité <w>křupnutí</w> štěrku, když auto vjíždělo na příjezdovou cestu."
                            }
                        }
                    ],
                    "synonyms": [
                        "crunch"
                    ],
                    "target_lang_definitions": {
                        "cs": "Křupavý nebo drtivý zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "křupání",
                                "target_lang_sense_clarification": "zvuk při šlapání na suché věci"
                            },
                            {
                                "target_lang_word": "křupnutí",
                                "target_lang_sense_clarification": "jednorázový zvuk drcení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}