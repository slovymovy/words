                        "glosses": [
                            "Variante orthographique de cannisse."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f57e8f8a-1318-4107-8ddc-485fd278a82b",
                                "sense_id": "26d0b7ba-8a6a-3d05-801c-3da238a83c67",
                                "text": "On emploie pour l’emmagasinement des cocons, des tiroirs dont le fond est constitué par un grillage métallique, désignés sous le nom de canisses ou claies."
                            },
                            {
                                "example_id": "6b93ca05-87ca-4cc6-acc4-f1ea9f9c164b",
                                "sense_id": "26d0b7ba-8a6a-3d05-801c-3da238a83c67",
                                "text": "Ensuite, nous fabriquâmes des canisses, qui sont des claies de roseaux sur lesquelles on fait sécher les figues."
                            },
                            {
                                "example_id": "f1308c48-92c8-4281-b154-a51eee576ba8",
                                "sense_id": "26d0b7ba-8a6a-3d05-801c-3da238a83c67",
                                "text": "Pour les préserver du vent et de l'érosion, les parcelles sont protégées par des canisses, et font au maximum quatre mètres de large."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
