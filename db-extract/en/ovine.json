                                            {
                                                "example_id": "1921bf6a-bd08-4331-9333-4277db6966d7",
                                                "sense_id": "c28e8ce7-50f0-33cf-8f64-f4856da62bec",
                                                "text": "Pergamen (bělpuch) jest suchá, nevydělaná kůže oslí, telecí, ovčí, kozí nebo jehněcí."
                                            }
                                        ]
                                    }
                                ]
                            }
