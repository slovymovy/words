                {
                    "sense_id": "2db76e7f-724c-35aa-a3d9-2891413442a7",
                    "sense_definition": "De manière peu perceptible pour les sens, notamment la vue ou l'ouïe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une bougie allumée dans le coin de la pièce éclairait <w>faiblement</w> le couloir obscur.",
                            "target_lang_translations": {
                                "en": "A candle burning in the corner of the room <w>dimly</w> lit the dark corridor.",
                                "ru": "Свеча, горевшая в углу комнаты, <w>тускло</w> освещала тёмный коридор.",
                                "de": "Eine Kerze, die in der Ecke des Zimmers brannte, beleuchtete den dunklen Flur <w>trüb</w>.",
                                "es": "Una vela encendida en un rincón de la habitación iluminaba <w>tenuemente</w> el oscuro pasillo.",
                                "zh": "房间角落里点着的一支蜡烛，<w>微弱地</w>照亮了昏暗的走廊。"
                            }
                        },
                        {
                            "text": "Dans le silence de la nuit, une cloche lointaine résonnait encore <w>faiblement</w>.",
                            "target_lang_translations": {
                                "en": "In the silence of the night, a distant bell was still ringing <w>faintly</w>.",
                                "ru": "В ночной тишине далёкий колокол ещё <w>слабо</w> звенел.",
                                "de": "In der Stille der Nacht war eine ferne Glocke noch <w>schwach</w> zu hören.",
                                "es": "En el silencio de la noche, una campana lejana aún resonaba <w>débilmente</w>.",
                                "zh": "夜深人静，远处的钟声仍<w>隐约地</w>回响着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indistinctement"
                    ],
                    "common_phrases": [
                        "briller faiblement",
                        "éclairer faiblement"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way barely perceptible to the senses, especially sight or hearing.",
                        "ru": "Так, что почти не воспринимается органами чувств, особенно зрением или слухом.",
                        "de": "So, dass es kaum wahrnehmbar ist, besonders für Sehen oder Hören.",
                        "es": "De manera apenas perceptible para los sentidos, sobre todo la vista o el oído.",
                        "zh": "以感官难以察觉的方式，尤指视觉或听觉上不明显。"
                    },
