                ],
                "senses": [
                    {
                        "sense_id": "845c15e8-70f8-37e1-8cb3-97ca5f6c9e23",
                        "entry_id": "3b5cc911-fcd2-35f4-8d6b-b689abce7eab",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4ef285-ec0b-4055-bd83-15d7a4b3ad92",
                                "sense_id": "845c15e8-70f8-37e1-8cb3-97ca5f6c9e23",
                                "text": "Frau Künzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "136ade67-6851-4692-b10c-c5234fce03bd",
                                "sense_id": "845c15e8-70f8-37e1-8cb3-97ca5f6c9e23",
                                "text": "Herr Künzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5eb50a19-9d38-45f2-a4a1-214f6768be3a",
                                "sense_id": "845c15e8-70f8-37e1-8cb3-97ca5f6c9e23",
                                "text": "Die Künzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fc448b20-cf10-4665-a8cb-092093a37cb7",
                                "sense_id": "845c15e8-70f8-37e1-8cb3-97ca5f6c9e23",
                                "text": "Der Künzle trägt nie die Schals, die die Künzle ihm strickt."
                            },
                            {
                                "example_id": "59561103-0a4d-4e48-b468-73ce3e1f9529",
                                "sense_id": "845c15e8-70f8-37e1-8cb3-97ca5f6c9e23",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Künzle kommt, geht der Herr Künzle.“"
                            },
                            {
                                "example_id": "d2bab415-53ed-4f7a-ac0d-844266423aa1",
                                "sense_id": "845c15e8-70f8-37e1-8cb3-97ca5f6c9e23",
                                "text": "Künzle kommt und geht."
                            },
                            {
                                "example_id": "d962bdd1-49cb-4c9b-8512-066c3b9d4370",
                                "sense_id": "845c15e8-70f8-37e1-8cb3-97ca5f6c9e23",
                                "text": "Künzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
