                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25cab0d2-3984-4d6c-831d-ece9a4b8b417",
                                                "sense_id": "b2b94792-8762-3f82-8138-56ea05872dc4",
                                                "text": "Die Straße führt zum Rathaus der Stadt."
                                            },
                                            {
                                                "example_id": "1459947f-03de-4d5a-8af7-0cf9d671ef7e",
                                                "sense_id": "b2b94792-8762-3f82-8138-56ea05872dc4",
                                                "text": "Ich brauche die Brille zum Lesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a364b94-a3d9-3188-bef8-894b058e29e5",
                                        "entry_id": "d59aead0-04f0-3478-91bf-3586e77ceec4",
                                        "glosses": [
                                            "Kurzform von „zu einem“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aeddedb-a671-43e1-9840-a7df398f5e7c",
                                                "sense_id": "3a364b94-a3d9-3188-bef8-894b058e29e5",
                                                "text": "Newton wurde zum Ritter geschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23b3b5cd-75af-44ab-a9d2-bd1554078f12",
                        "source_entry_id": "0ee1316e-9548-3e43-ab59-edbf850b3843",
                        "source_sense_id": "5698895c-0790-34d0-bbb8-169b01181ae7",
                        "target_lang_word": "Abendessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abendessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                        "entry_id": "848de6f5-7ded-373e-b095-26226c7e9f9b",
                                        "glosses": [
                                            "Mahlzeit, die zu Tagesende verzehrt wird"
                                        ],
                                        "tags": [
                                            "in Teilen Nord- und Ostdeutschlands sowie in der Schweiz warme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ac30fb-3c1e-4e7b-b4ed-0af1bbdb4e35",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "Zum Abendessen gibt es heute einen besonders guten Wein."
                                            },
                                            {
                                                "example_id": "2db83211-22c1-4175-afe4-09cb42f71a67",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "Während des Abendessens möchten wir nicht gestört werden."
                                            },
                                            {
                                                "example_id": "7adc6140-e4d8-4941-908f-1bca1e8be959",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "Die Abendessen fallen bei uns nicht so reichhaltig aus wie die anderen Mahlzeiten."
                                            },
                                            {
                                                "example_id": "b0b113e6-13ff-49ab-928d-d13f4b515551",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Die abendlichen Wanderungen hatten mir einen ordentlichen Muskelkater beschert, und so war ich heilfroh, dass ich zu meinem Abendessen mit Ton nicht auch noch radeln musste.“"
                                            },
                                            {
                                                "example_id": "307b0f6a-c4a4-44a0-8080-08e8bbf48dc1",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Es macht ihm anscheinend nichts aus, daß er zum Frühstück Kaffee-Ersatz trinken und sich beim Abendessen mit Schwarzbrot in Wasser begnügen muß.“"
                                            },
                                            {
                                                "example_id": "e785b458-0c02-4661-927d-25981d89eb98",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Das Abendessen war kurz und lief ab wie gewohnt.“"
                                            },
                                            {
                                                "example_id": "48cfa21b-9906-46e0-9d22-36459cea486a",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Bevor er zum Abendessen ging, blätterte er gedankenverloren in Ruges Text.“"
                                            },
                                            {
                                                "example_id": "495632f8-4b98-4924-9e03-e1629f5fc368",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Ein Abendessen mit einem befreundeten Verlagsvertreter veränderte alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
