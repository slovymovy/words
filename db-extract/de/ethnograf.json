                ],
                "senses": [
                    {
                        "sense_id": "2fefb414-c260-3bc6-90f9-4bf0b471a0c1",
                        "entry_id": "61441ad7-12a7-33fb-b867-467186a6ce01",
                        "glosses": [
                            "jemand, der die Kultur eines (ihm fremden) Volkes durch direkten Kontakt mit demselben systematisch zu erfassen und beschreiben versucht; Wissenschaftler auf dem Gebiet der Ethnografie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f65e4b4-37f4-4d64-9c15-01ca9c0de990",
                                "sense_id": "2fefb414-c260-3bc6-90f9-4bf0b471a0c1",
                                "text": "„Dem norwegischen Ethnografen Carl Sofus Lumholtz zufolge benutzten die Ureinwohner Nordamerikas Peyote, um körperliche Leiden wie Schlangenbisse, Skorpionstiche, Zahnschmerzen, Verbrennungen, Pfeilwunden oder Rheuma zu lindern.“"
                            },
                            {
                                "example_id": "e331d19e-d971-431f-ab02-d71ef2357c95",
                                "sense_id": "2fefb414-c260-3bc6-90f9-4bf0b471a0c1",
                                "text": "„Erst Anfang des 20. Jahrhunderts versuchten Ethnografen, die präkolumbianische Bevölkerung abzuschätzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3a94ea5-a39b-44a8-b4eb-faf5832995d0",
                        "source_entry_id": "61441ad7-12a7-33fb-b867-467186a6ce01",
                        "source_sense_id": "2fefb414-c260-3bc6-90f9-4bf0b471a0c1",
                        "target_lang_word": "ethnographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnographer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa84cb11-11fd-3061-bfbd-83ea60a3cb58",
                                        "entry_id": "35909a7c-d3db-3d95-9a81-b2fa6c2894d4",
                                        "glosses": [
                                            "One who practices ethnography."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea5f67b-c430-4561-b164-469956f9db7c",
                                                "sense_id": "aa84cb11-11fd-3061-bfbd-83ea60a3cb58",
                                                "text": "First, some ethnographers would argue that reconceptualizing groupness is necessary to better understand sharedness as a quality of group communication."
                                            },
                                            {
                                                "example_id": "22013707-e8bf-4872-b1e5-79c4451f50f1",
                                                "sense_id": "aa84cb11-11fd-3061-bfbd-83ea60a3cb58",
                                                "text": "The second stage in the process by which African cultural realities are often mistransformed through mistranslation by ethnographers is associated with the urgent demand for 'theories' to assist the ethnographer in organising his field data and in presenting the conclusions derived from the data."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "198c6364-2fec-4254-a440-885d0039258e",
                        "source_entry_id": "61441ad7-12a7-33fb-b867-467186a6ce01",
                        "source_sense_id": "2fefb414-c260-3bc6-90f9-4bf0b471a0c1",
                        "target_lang_word": "ethnographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87acbe37-61d3-3c46-b1a3-3e4901fce1ae",
                                        "entry_id": "41b0fbbb-fcc6-3c87-b413-60445c120282",
                                        "glosses": [
                                            "Celui, celle qui s’occupe d’ethnographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe329c0-8060-4b4c-8e99-b30f21775a62",
                                                "sense_id": "87acbe37-61d3-3c46-b1a3-3e4901fce1ae",
                                                "text": "Or, en dépit de sa perspicacité sur le plan descriptif, l’ethnographe ne tire pas de conclusion au sujet de la nature de l’écriture et de la mémoire amérindiennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
