                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола strut; хождение с важным, напыщенным или самодовольным видом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расхаживать с важным видом",
                                "target_lang_sense_clarification": "идти горделиво, напыщенно"
                            },
                            {
                                "target_lang_word": "шествовать",
                                "target_lang_sense_clarification": "важно или чинно двигаться"
                            },
                            {
                                "target_lang_word": "форсить",
                                "target_lang_sense_clarification": "рисоваться, выставлять напоказ"
                            }
                        ]
                    }
