                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "22c05ce3-14e4-33d4-ad3d-69ccfacc7b7e",
                        "entry_id": "89d7b729-24c4-3303-827c-693b02f4aa1a",
                        "glosses": [
                            "Abbreviation of overemployed."
                        ],
                        "tags": [
                            "Internet",
                            "abbreviation",
                            "alt-of",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dadd11f2-0163-4907-aff5-4179c9ce6365",
                                "sense_id": "22c05ce3-14e4-33d4-ad3d-69ccfacc7b7e",
                                "text": "Isaac has two full-time programming positions at tech companies, a contract job, and he also runs Overemployed, which he likens to an online \"campfire\" where fellow \"OE\" workers swap advice on how best to balance multiple jobs and not get caught."
                            },
                            {
                                "example_id": "fe8ec364-bee4-4e79-93d7-4370babc8bd1",
                                "sense_id": "22c05ce3-14e4-33d4-ad3d-69ccfacc7b7e",
                                "text": "Rallying on reddit, Minute-Lock6073 says, \"I started telling recruiters about my interest in a second job,\" the cloud computing specialist explains. \"Both of my managers know that I am 'OE'\"."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
