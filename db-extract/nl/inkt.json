                ],
                "senses": [
                    {
                        "sense_id": "eeafb20f-0a43-3768-966f-92b653c93da5",
                        "entry_id": "14b6dc73-7d4d-30ab-aad5-2b89c6781447",
                        "glosses": [
                            "een gekleurde vloeistof waarmee men kan schrijven en tekenen"
                        ],
                        "tags": [
                            "teken- en schrijfmateriaal"
                        ],
                        "examples": [
                            {
                                "example_id": "008768ca-828e-4d86-ab77-f6fa8e158346",
                                "sense_id": "eeafb20f-0a43-3768-966f-92b653c93da5",
                                "text": "Het tekenen met penseel en inkt geeft een prachtige lijn maar fouten zijn nauwelijks te corrigeren."
                            },
                            {
                                "example_id": "110ce0e7-520d-42f6-a13a-2d43ed89ab93",
                                "sense_id": "eeafb20f-0a43-3768-966f-92b653c93da5",
                                "text": "Het potje met mijn favoriete zwarte inkt plaatste ik binnen handbereik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "941d63da-03b1-4584-9d45-e12a3520dec4",
                        "source_entry_id": "14b6dc73-7d4d-30ab-aad5-2b89c6781447",
                        "source_sense_id": "eeafb20f-0a43-3768-966f-92b653c93da5",
                        "source_sense_description": "een gekleurde vloeistof waarmee geschreven wordt",
                        "target_lang_word": "Tinte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tinte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "199b9a26-9e21-3311-9990-2f191da4c090",
                                        "entry_id": "cefd537a-2365-355f-a104-62e51284fa83",
                                        "glosses": [
                                            "eine Flüssigkeit zum Schreiben, Zeichnen, Malen und Kalligraphieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "839918b5-f3db-450d-8414-dafbfffce830",
                                                "sense_id": "199b9a26-9e21-3311-9990-2f191da4c090",
                                                "text": "Sie füllt Tinte nach."
                                            },
                                            {
                                                "example_id": "2cb01c00-8f82-41ed-8bd6-b1c70e871ae0",
                                                "sense_id": "199b9a26-9e21-3311-9990-2f191da4c090",
                                                "text": "„Eugen Seebauer pustete über das Papier, um die Tinte trocknen zu lassen, und las den Brief.“"
                                            },
                                            {
                                                "example_id": "0220a811-6564-41ea-a198-54da95f9518f",
                                                "sense_id": "199b9a26-9e21-3311-9990-2f191da4c090",
                                                "text": "„Die Palette dient als Unterlage; der Schreiber taucht einen kleinen Pinsel in den Becher mit Wasser und rührt damit die Tintenpaste an; dann taucht er ein Schreibrohr in die flüssige Tinte und schreibt.“"
                                            },
                                            {
                                                "example_id": "51712452-2859-4dc2-bef1-7e0d45e6018d",
                                                "sense_id": "199b9a26-9e21-3311-9990-2f191da4c090",
                                                "text": "„Da zog der Bürger aus seiner Tasche ein beschriebenes Papier, legte es vor den Bauer hin und sagte, er solle ein Kreuz darunter setzen, und der Wirt war schon mit Tinte und einem neuen Gänsekiel gekommen.“"
                                            },
                                            {
                                                "example_id": "efa5e3d3-2360-49ea-bfc1-cf97d5840a28",
                                                "sense_id": "199b9a26-9e21-3311-9990-2f191da4c090",
                                                "text": "„Es ist viel Tinte darüber vergossen worden, ob Shakespeare am Druck seiner Werke beteiligt war und, falls ja, in welchem Ausmaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3e710f6-b237-4b46-a968-14dd17d8f55c",
                        "source_entry_id": "14b6dc73-7d4d-30ab-aad5-2b89c6781447",
                        "source_sense_id": "eeafb20f-0a43-3768-966f-92b653c93da5",
                        "source_sense_description": "een gekleurde vloeistof waarmee geschreven wordt",
                        "target_lang_word": "ink",
