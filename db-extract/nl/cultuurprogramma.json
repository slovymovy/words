                        "examples": [
                            {
                                "example_id": "f45b68e8-233a-46b6-a5ee-b2e701255316",
                                "sense_id": "c0324dd0-0d19-3f22-abb4-68b2e69f6d82",
                                "text": "\"Wij zijn ervan overtuigd dat Maurits samen met de andere directieleden daarnaast een wezenlijke bijdrage gaat leveren aan het cultuurprogramma voor een veilig werk- en sportklimaat binnen de hele club.\""
                            },
                            {
                                "example_id": "7f895899-4fed-4c5d-8e4d-791c62dee02e",
                                "sense_id": "c0324dd0-0d19-3f22-abb4-68b2e69f6d82",
                                "text": "In de jury van de Nipkowschijf zitten recensenten van alle grote dagbladen. Zij reiken ook de Zilveren Reissmicrofoon uit, de prijs voor het beste radioprogramma. De genomineerden daarvoor zijn de hoorspelserie De Oorlogskoningin, het gespreksprogramma Twee dingen en het cultuurprogramma Nooit meer slapen."
                            },
                            {
                                "example_id": "5b2d13f1-855c-4cdb-b645-9c65da38e1e5",
                                "sense_id": "c0324dd0-0d19-3f22-abb4-68b2e69f6d82",
                                "text": "Verder zullen vijftig nieuwe programma's op de buis te zien zijn. Het gaat bijvoorbeeld om dramaseries Hoogvliegers, Keizersvrouwen en Stanley H. en een cultuurprogramma van Nadia Moussaid. Voor kinderen gaat de NPO onder meer het van origine Belgische Tik Tak uitzenden."
                            }
                        ]
                    }
