                "senses": [
                    {
                        "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                        "entry_id": "78e835ac-bc8f-3a89-9790-b50c074bf881",
                        "glosses": [
                            "elegantes Kleid, dessen Länge von kurz über dem Knie bis kurz unter das Knie reicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd0269a9-8b1d-4a18-926e-37d26a129ae0",
                                "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                                "text": "Das ist aber ein chices Cocktailkleid. Und du siehst darin besonders toll aus!"
                            },
                            {
                                "example_id": "9002e14c-eb46-4cf8-ab3d-8e03ec764d1c",
                                "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                                "text": "Was nützt mir das schönste Cocktailkleid im Kleiderschrank, wenn ich nicht mehr reinpasse."
                            },
                            {
                                "example_id": "0dfc8666-70ad-4e4d-99a3-6e2037defec7",
                                "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                                "text": "„In der \"La Jarana\" […] tragen alle Frauen Cocktailkleider.“"
                            },
                            {
                                "example_id": "f8d98b38-e4b3-454d-b77d-398841c33f90",
                                "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                                "text": "„Die Dame wählt ein langes Kleid oder ein besonders elegantes kurzes Kleid aus, das gemeinhin als \"Cocktailkleid\" bekannt ist.“"
                            },
                            {
                                "example_id": "12bbfbe6-c488-4cd8-866e-6b56e2faf43f",
                                "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                                "text": "[Die Pailette:] „[…] besonders an den Feiertagen bringt sie Glamour auf die Cocktailkleider.“"
                            },
                            {
                                "example_id": "6d73f708-35c9-407b-a55b-0dd28df20673",
                                "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                                "text": "„Die Gäste haben sich schick gemacht. Die Frauen in kurzen Cocktailkleidern, geschminkt, mit hochgesteckten Haaren, in Blusen und Jeans oder in glänzenden kurdischen Trachten. Die Männer tragen Anzug.“"
                            },
                            {
                                "example_id": "0a5a85b0-48e5-4b6f-a5ca-2920da482090",
                                "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                                "text": "„In einer Online-Auktion beim Auktionshaus Christie's, die noch bis 4. Oktober läuft, können Fans ein Cocktailkleid aus Satin von [Anmerkung: Audrey] Hepburns bevorzugtem Modeschöpfer Hubert de Givenchy erstehen.“"
                            },
                            {
                                "example_id": "ec7faae6-b27a-4ddd-90de-f1fd2693da31",
                                "sense_id": "d32d1e76-e384-3cef-8e8e-a4c69e66324a",
                                "text": "„Modebloggerinnen und Youtuberinnen machen vor, wie ein elegantes schwarzes Cocktailkleid mit einer Lederjacke und Schnürstiefeln zum \"Grunge-Look\" wird oder wie man es bürofähig machen kann, wenn man einen schlichten Blazer in einer anderen Farbe dazu trägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
