                "senses": [
                    {
                        "sense_id": "05b2601f-2a78-37ad-bc3f-44a817439772",
                        "entry_id": "491ffcfa-305d-35f2-93ae-1a0ade20f61d",
                        "glosses": [
                            "Forschungsrichtungen, die sich mit Prozessen oder Strukturen von Lebewesen beschäftigen oder an denen Lebewesen beteiligt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534049d6-6761-4030-9135-f8c1bf29d571",
                                "sense_id": "05b2601f-2a78-37ad-bc3f-44a817439772",
                                "text": "„In zahlreichen aktuellen Themen wie Energieforschung, Lebenswissenschaften oder Umweltforschung wird seit Jahren erfolgreich zusammengearbeitet.“"
                            },
                            {
                                "example_id": "79f69cd0-5e77-4f70-b55c-df1d084d38ed",
                                "sense_id": "05b2601f-2a78-37ad-bc3f-44a817439772",
                                "text": "„Dieses Jahr waren erstmals auch interdisziplinäre Fragestellungen zugelassen, um Life Science im Sinne einer ‚Lebenswissenschaft‘ aus den Bereichen Naturwissenschaft und Medizin hervorzuholen und auf relevante Aspekte aus anderen Disziplinen auszuweiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
