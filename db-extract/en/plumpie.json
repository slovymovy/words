                        "examples": [
                            {
                                "example_id": "3fb0694e-6625-4b11-b8eb-f590077bab09",
                                "sense_id": "4b97ece1-47ae-3314-93c3-d613b63d9de9",
                                "text": "The boys liked to watch each other get dressed, and oh those pink fleshy plumpies with sturdy little legs! She should find some daffodils somewhere and take their picture."
                            },
                            {
                                "example_id": "de2304e7-308f-412a-b02c-92a3eca36aaa",
                                "sense_id": "4b97ece1-47ae-3314-93c3-d613b63d9de9",
                                "text": "The overwhelming popularity of the Food Channel has made superstars out of plumpies like Mario Batali, Paula Deen, Ina Garten, a.k.a. The Barefoot Contessa, and those Two Fat Ladies, one of whom may she rest in peace."
                            },
                            {
                                "example_id": "147e27cd-ff06-4068-9048-fa48af68ca29",
                                "sense_id": "4b97ece1-47ae-3314-93c3-d613b63d9de9",
                                "text": "I'm referring to the fictional depictions, those dimple bottomed winged plumpies flying around with harps or bows and arrows."
                            }
                        ]
