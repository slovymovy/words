                                        "entry_id": "4ab224dd-bb99-3721-b48a-734a06e1aa23",
                                        "glosses": [
                                            "Indifference to a person's skin color or race."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0194c5b-52ab-49a0-903c-9aa6d4798121",
                                                "sense_id": "2dea5ac9-fb54-3b45-af8c-0bf2dcf59a9c",
                                                "text": "Despite the fact that race is embedded in American social life, \"color blindness\" has recently emerged as the dominant ideology of race."
