                                    {
                                        "sense_id": "0112371d-afca-34ec-9ddb-a943ceb25ee0",
                                        "entry_id": "011f76e7-fd45-328b-a51e-94b80cbcdccb",
                                        "glosses": [
                                            "Connects at least two alternative words, phrases, clauses, sentences, etc., each of which could make a passage true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7740c8a-a9c8-4c15-922c-2e9f63652467",
                                                "sense_id": "0112371d-afca-34ec-9ddb-a943ceb25ee0",
                                                "text": "You may either stay or come."
                                            },
                                            {
                                                "example_id": "dcfbd141-a129-47e4-a0b0-8b9feb874cec",
                                                "sense_id": "0112371d-afca-34ec-9ddb-a943ceb25ee0",
                                                "text": "He might get cancer, or be hit by a bus, or God knows what."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b714433c-7837-323f-aa08-173e3cb59254",
                                        "entry_id": "011f76e7-fd45-328b-a51e-94b80cbcdccb",
                                        "glosses": [
                                            "An operator denoting the disjunction of two propositions or truth values. There are two forms, the inclusive or and the exclusive or."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5187effc-a837-3def-b500-4f4168835061",
                                        "entry_id": "011f76e7-fd45-328b-a51e-94b80cbcdccb",
                                        "glosses": [
                                            "Counts the elements before and after as two possibilities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e530d49-99f6-3f4a-b975-d23a8e5f5d02",
                                        "entry_id": "011f76e7-fd45-328b-a51e-94b80cbcdccb",
                                        "glosses": [
                                            "Otherwise (a consequence of the condition that the previous is false)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc71dd7-3e82-458c-8efa-c05a192d3e85",
                                                "sense_id": "8e530d49-99f6-3f4a-b975-d23a8e5f5d02",
                                                "text": "It's raining! Come inside or you'll catch a cold!"
                                            },
                                            {
                                                "example_id": "319da733-9437-42d9-893c-8e824941a8fc",
                                                "sense_id": "8e530d49-99f6-3f4a-b975-d23a8e5f5d02",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51540ae2-9ab1-31fd-8861-a6b45e9ae821",
                                        "entry_id": "011f76e7-fd45-328b-a51e-94b80cbcdccb",
                                        "glosses": [
                                            "Connects two equivalent names."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf33dbb6-3893-436c-b160-4d6bd5c5dac8",
                                                "sense_id": "51540ae2-9ab1-31fd-8861-a6b45e9ae821",
                                                "text": "The country Myanmar, or Burma"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
