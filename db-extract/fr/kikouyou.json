                        "glosses": [
                            "Nom vernaculaire de Cenchrus clandestinus plante herbacée de la famille des Poacées (Poaceae) originaire des régions centrales de l’Afrique, utilisée en tant que gazon dans les régions du monde sans forte gelée et en tant que pâturage en Afrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bde8cac-82d4-4c94-9911-2715c0283b69",
                                "sense_id": "f586d222-c653-3498-b460-61b0bfd30d40",
                                "text": "Le Kikouyou (Pennisetum clandestinum), le Rhodes Grass (Chloris gayana), le Napier (Pennisetum purpureum) sont des graminées fourragères vivaces à grands rendements."
                            }
                        ]
                    }
