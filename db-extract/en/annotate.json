                                        "examples": [
                                            {
                                                "example_id": "e2d12332-0f59-4b90-a1b9-1c0df14c46d7",
                                                "sense_id": "9d7613f7-06c3-37ae-a4df-bb59c5d317ab",
                                                "text": "Il a annoté les ouvrages de Pline, de Tacite."
                                            },
                                            {
                                                "example_id": "e21d6bcb-c357-4aec-8438-3a193e3fdf75",
                                                "sense_id": "9d7613f7-06c3-37ae-a4df-bb59c5d317ab",
                                                "text": "Un Virgile annoté."
