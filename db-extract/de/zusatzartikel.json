                                "target_senses": [
                                    {
                                        "sense_id": "03b109ea-88c6-34b2-98bd-0b2658ba69eb",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "An alteration or change for the better; correction of a fault or of faults; reformation of life by quitting vices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b81464c-1e83-398a-aa3f-ab1a5200cccd",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "In public bodies, any alteration made or proposed to be made in a bill or motion that adds, changes, substitutes, or omits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e6202b-8361-496b-9437-e548965c9075",
                                                "sense_id": "2b81464c-1e83-398a-aa3f-ab1a5200cccd",
                                                "text": "Arrests and prosecutions intensified after Isis captured Mosul in June, but the groundwork had been laid by an earlier amendment to Jordan’s anti-terrorism law."
                                            },
                                            {
                                                "example_id": "369a6ed8-ff88-4b4f-b238-eb50866836fd",
                                                "sense_id": "2b81464c-1e83-398a-aa3f-ab1a5200cccd",
                                                "text": "Almost half of MEPs wanted to remove the new provisions to expand the use of megatrucks but an amendment to do that failed to pass by just six votes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa95918-8342-3813-aed2-415352b830ed",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "Correction of an error in a writ or process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cb55495-e05d-320a-a409-40c5862f3f5d",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "An addition to and/or alteration to the Constitution."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "398ad999-c960-4e7d-b872-eb4413595b3b",
                                                "sense_id": "0cb55495-e05d-320a-a409-40c5862f3f5d",
                                                "text": "The First Amendment guarantees freedom of religion, speech, press, assembly, and petition."
                                            },
                                            {
                                                "example_id": "c93b0263-ca77-4d39-9f79-282412974450",
                                                "sense_id": "0cb55495-e05d-320a-a409-40c5862f3f5d",
                                                "text": "The Thirteenth Amendment to the United States Constitution abolished slavery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c9e827-fc1d-3680-b1d5-cd16b8169936",
                                        "entry_id": "79ad40fa-b891-3e7a-912d-ede27d0d8010",
                                        "glosses": [
                                            "That which is added; that which is used to increase or supplement something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f753a5-b1ce-4f02-9738-75f40c390e3f",
                                                "sense_id": "61c9e827-fc1d-3680-b1d5-cd16b8169936",
                                                "text": "a soil amendment"
                                            }
                                        ]
                                    }
                                ]
