                    },
                    {
                        "translation_id": "a69798fc-760b-4c0a-8489-9dc0cae067d5",
                        "source_entry_id": "3279d14e-82df-3ad1-889a-97954115e47d",
                        "source_sense_id": "6f56a923-5960-3bbf-b013-1c98dad82e18",
                        "source_sense_description": "private Angelegenheit",
                        "target_lang_word": "privéaangelegenheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privéaangelegenheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae3fae9-45ae-30a5-b4e2-d4580b799bd8",
                                        "entry_id": "edc7bf3f-da94-3c56-981d-3bce2132336a",
                                        "glosses": [
                                            "iets dat helemaal valt in de persoonlijke levenssfeer en waar de buitenwereld niets mee te maken heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d314542-05ac-43f5-908d-7ea03a2909e4",
                                                "sense_id": "2ae3fae9-45ae-30a5-b4e2-d4580b799bd8",
                                                "text": "Privéaangelegenheid 'Mevrouw Holl,' zegt Sophie terwijl ze met de rug van haar hand in haar ogen wrijft, 'ik moet u verzoeken me uit te leggen wat u bedoelt met privéaangelegenheid."
                                            },
                                            {
                                                "example_id": "754806d5-e9f9-41ff-9a02-78a849ee7920",
                                                "sense_id": "2ae3fae9-45ae-30a5-b4e2-d4580b799bd8",
                                                "text": "François De Smet, de nationale voorzitter van Défi, hield het bij een korte reactie. ,,De betrokkene zal gehoord worden over de feiten waarvan ze beschuldigd wordt”, legt hij uit. ,,In de tussentijd geven we geen commentaar.” De burgemeester van Ans kon haar ondertussen wel spreken. ,,Ik heb haar gisteren aan de telefoon gehad en ze ontkent de beschuldigingen”, aldus de burgemeester, die benadrukt dat het om een privéaangelegenheid gaat ‘die niet thuishoort in de politiek’."
                                            },
                                            {
                                                "example_id": "e84da63b-e809-4ee9-839c-b3fc47f4b945",
                                                "sense_id": "2ae3fae9-45ae-30a5-b4e2-d4580b799bd8",
                                                "text": "Maar enkele dagen later blijkt er toch meer aan de hand. Bruna Biancardi, de partner van Neymar, postte zélf een story op Instagram. Daarin bevestigde ze de relatiebreuk. ‘Dit is een privéaangelegenheid, maar aangezien ik dagelijks word blootgesteld aan nieuws, geruchten en grappen, laat ik u weten dat ik geen relatie heb. Wij zijn de ouders van Mavie, dat is de reden van onze band.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
