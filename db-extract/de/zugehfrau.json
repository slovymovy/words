                ],
                "translations": [
                    {
                        "translation_id": "74659616-bd4e-4d67-87dc-1f122ca017ae",
                        "source_entry_id": "f3af3325-cd1a-3ac0-aa67-7210a549660c",
                        "source_sense_id": "1d26455a-5170-3698-9ddd-039c0348aeee",
                        "source_sense_description": "eine Frau, die zum Putzen in ein Haus kommt",
                        "target_lang_word": "char",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "char",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e7f499-d26f-37ef-ba1a-fb964159953b",
                                        "entry_id": "38e887e8-8c3d-3e3f-b55c-2beab8587351",
                                        "glosses": [
                                            "Alternative form of cha (“tea”)."
                                        ],
