                        "examples": [
                            {
                                "example_id": "40a20273-0e20-44cd-9cd0-802a6dd30119",
                                "sense_id": "6469ae12-4417-3f92-a8a8-7f6d0cf0cf52",
                                "text": "PERMIE, province de, (Géog. mod.) province du royaume de Casan, appartenant à la Russie, & dont la capitale se nomme Perruski, ou Permekki."
                            },
                            {
                                "example_id": "0fecac51-6047-4e46-aca1-aaabe0f7f903",
                                "sense_id": "6469ae12-4417-3f92-a8a8-7f6d0cf0cf52",
                                "text": "Cette province de Permekki ou Permie, autrefois nommée le Solikan, était l’entrepôt des marchandises de la Perse, & des fourrures de Tartarie. On a trouvé dans cette Permie une grande quantité de monnaie au coin des premiers kalifes, & quelques idoles d’or des Tartares ; mais ces monumens d’anciennes richesses ont été trouvés au milieu de la pauvreté & dans les déserts ; il n’y avait plus aucune trace de commerce."
                            }
                        ]
                    }
