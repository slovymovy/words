                        "glosses": [
                            "Ejectable, separable from the aircraft."
                        ],
                        "tags": [
                            "of an aircraft flight recorder"
                        ],
                        "examples": [
                            {
                                "example_id": "e85621a6-be68-44ac-8b32-0b2846da6a6f",
                                "sense_id": "b58fab8b-cec0-30c0-bd03-1c6c1b47d231",
                                "text": "For example, helicopters that ditch at sea are often unrecoverable and consequently, despite the systems' higher cost and increased complexity, the Navy needed deployable recorder systems for its helicopters."
                            },
                            {
                                "example_id": "cb96d825-4c6c-4e47-91d0-75097b744b7e",
                                "sense_id": "b58fab8b-cec0-30c0-bd03-1c6c1b47d231",
                                "text": "It played a significant role in the evolution of the deployable recorder, and offers an attractive alternative to \"fixed recorders\" in a \"dual redundancy\" installation (discussed later)"
                            }
                        ]
                    }
