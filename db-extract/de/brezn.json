                ],
                "senses": [
                    {
                        "sense_id": "b3e699bc-6561-3e64-8475-a4f2018e07e0",
                        "entry_id": "652c83d5-2a3a-34e7-857f-941655bcf6ea",
                        "glosses": [
                            "größeres mit grobem Salz (oder Zucker) bestreutes Gebäck, dessen Form dem Buchstaben B ähnelt"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "4f13db5c-9468-4b2e-8499-c9aefea518de",
                                "sense_id": "b3e699bc-6561-3e64-8475-a4f2018e07e0",
                                "text": "„Seehofer überreichte Franziskus einen großen Präsentkorb mit bayerischen Spezialitäten, darunter Bier, Brezn, Griebenschmalz, Würzburger Silvaner, Senf und Obstler.“"
                            },
                            {
                                "example_id": "97111694-c4b6-4a57-8de7-6a9407d70e8e",
                                "sense_id": "b3e699bc-6561-3e64-8475-a4f2018e07e0",
                                "text": "„Dass sich das Bundesjustizministerium darum mühte, nicht nur Brezn und Brezen zu schützen, sondern auch die Brez’n, hat einen markenrechtlichen Hintergrund.“"
                            },
                            {
                                "example_id": "b38eea3d-8cf8-43a3-9c1f-6f92193a4c54",
                                "sense_id": "b3e699bc-6561-3e64-8475-a4f2018e07e0",
                                "text": "„Wenn es beispielsweise hauptsächlich um den Hunger geht, dann kann man sich beim Ottakringer Bier Stand einen Brezn kaufen – von diesem wird man mehr als satt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
