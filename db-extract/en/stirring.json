                ],
                "senses": [
                    {
                        "sense_id": "d89af451-c858-338d-a51f-09a9b136b713",
                        "entry_id": "16bd3d85-d027-3ad6-9c63-9a6f9b4ceb94",
                        "glosses": [
                            "invigorating or inspiring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143899ba-31bc-49f2-a1d9-62f949a2aeae",
                                "sense_id": "d89af451-c858-338d-a51f-09a9b136b713",
                                "text": "As he had said, his voice was hoarse, but he sang well enough, and it was a stirring tune, something between 'Clementine' and 'La Cucaracha'."
                            },
                            {
                                "example_id": "0706a5f0-7ccc-42bd-bde6-a711926f4d70",
                                "sense_id": "d89af451-c858-338d-a51f-09a9b136b713",
                                "text": "But Chelsea, who left Didier Drogba on the bench as coach Carlo Ancelotti favoured Fernando Torres, staged a stirring fightback to move up to fourth and keep United in their sights on a night when nothing other than victory would have kept the Blues in contention."
                            },
                            {
                                "example_id": "1e95a64f-9df3-474a-a458-c84e18fc31a0",
                                "sense_id": "d89af451-c858-338d-a51f-09a9b136b713",
                                "text": "22 March 2012, Scott Tobias, AV Club The Hunger Gameshttp://www.avclub.com/articles/the-hunger-games,71293/\nThe opening crawl (and a stirring propaganda movie) informs us that “The Hunger Games” are an annual event in Panem, a North American nation divided into 12 different districts, each in service to the Capitol, a wealthy metropolis that owes its creature comforts to an oppressive dictatorship."
                            },
                            {
                                "example_id": "6937d437-07b9-438d-bf60-0e7d87232978",
                                "sense_id": "d89af451-c858-338d-a51f-09a9b136b713",
                                "text": "On Friday night Dion delivered a stirring rendition of the 1950 song accompanied by a pianist, with the Olympics rings above her."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "367d274f-36f2-4107-9146-ce527c961f4f",
                        "source_entry_id": "16bd3d85-d027-3ad6-9c63-9a6f9b4ceb94",
                        "source_sense_id": "d89af451-c858-338d-a51f-09a9b136b713",
                        "source_sense_description": "invigorating, inspiring",
                        "target_lang_word": "passionnant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passionnant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                        "entry_id": "fdb56cc1-716b-3b02-8c51-399922d0fb45",
                                        "glosses": [
                                            "Qui passionne, qui est propre à passionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f515f21b-224d-4084-a1aa-3f3b688c05fc",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "La Canasta peut réunir de deux à six joueurs ; mais elle est surtout passionnante quand elle peut être pratiquée par deux équipes de deux joueurs."
                                            },
                                            {
                                                "example_id": "a3b1894f-e727-4354-b25c-26fe27d39b98",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "Fort heureusement pour moi, il n’eut pas le temps de m'expliquer plus avant tout l'intérêt qu’offrait la manière dont il eût souhaité que je conjuguasse mes verbes. Quelqu'un, en effet, venait d'arriver, interrompant dans l’œuf un développement qui risquait d'être plus passionné que passionnant."
                                            },
                                            {
                                                "example_id": "414f8e9a-7555-4c7b-9ff9-ebe93a563403",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "Parce que Charlie Roquin a le talent de nous émerveiller dans ces joutes oratoires wagnériennes, passionnantes, tout en maintenant une pression sur le lecteur quant à l’issue de cette confrontation."
                                            }
                                        ]
                                    }
                                ]
                            },
