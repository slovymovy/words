                    {
                        "translation_id": "101de050-a7f0-4311-bc54-00daea20db69",
                        "source_entry_id": "56f74835-3bac-329c-a6f5-3f281663680a",
                        "source_sense_id": "b3755927-6046-33f0-82f3-bf8adcb2ed5e",
                        "source_sense_description": "een boek waarin dagelijks de gebeurtenissen worden bijgehouden",
                        "target_lang_word": "Chronik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chronik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4507cf8d-e4f5-3d09-9456-2d44689607d0",
                                        "entry_id": "617304c3-ed7e-33b6-8e07-31c983290aec",
                                        "glosses": [
                                            "geschichtliche, historische Darstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814a0dee-f859-4b72-bbf6-80060cb200e4",
                                                "sense_id": "4507cf8d-e4f5-3d09-9456-2d44689607d0",
                                                "text": "In der Chronik werden Ereignisse der Geschichte erzählt."
                                            },
                                            {
                                                "example_id": "5e2dded4-54ad-4560-938f-9c82ff89848a",
                                                "sense_id": "4507cf8d-e4f5-3d09-9456-2d44689607d0",
                                                "text": "„Eine mittelalterliche Chronik berichtet, wie der Fürst in den Städten seines Reiches Gotteshäuser errichten und Gemeinden gründen lässt.“"
                                            },
                                            {
                                                "example_id": "bd720562-7442-41a4-b3f4-d4332508e845",
                                                "sense_id": "4507cf8d-e4f5-3d09-9456-2d44689607d0",
                                                "text": "„Er wehrte zunächst ab, als ihm der Wirt die Chronik brachte; doch dann nahm er sie doch und schlug den Sommer nach, in dem er auf seine erste Professur berufen worden war.“"
                                            },
                                            {
                                                "example_id": "8235f766-4e2b-4167-adf4-c56a89047982",
                                                "sense_id": "4507cf8d-e4f5-3d09-9456-2d44689607d0",
                                                "text": "„Es wurden nicht einmal Annalen und Chroniken festgehalten.“"
                                            },
                                            {
                                                "example_id": "8514245f-2c8d-4dd0-bb90-9c46e8bdc1dd",
                                                "sense_id": "4507cf8d-e4f5-3d09-9456-2d44689607d0",
                                                "text": "„Die Chroniken sind erfindungsreich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1528edc7-9000-4a1d-a190-efb081b8f1e6",
                        "source_entry_id": "56f74835-3bac-329c-a6f5-3f281663680a",
                        "source_sense_id": "b3755927-6046-33f0-82f3-bf8adcb2ed5e",
                        "source_sense_description": "een boek waarin dagelijks de gebeurtenissen worden bijgehouden",
                        "target_lang_word": "diary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                        "entry_id": "21338898-4887-3bf7-a01d-5c8b8ba8532e",
                                        "glosses": [
                                            "A daily log of experiences, especially those of the writer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdafcd69-c59b-4ce2-b509-12f68e141ccf",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "They kept separate diaries. His was on paper and her diary was on her computer's hard drive."
                                            },
                                            {
                                                "example_id": "78d721b7-3796-4a92-babd-b92c0b0b2cc8",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "No, I’m just going over the stuff Tara wrote in my diary.\nShe’s writing your diary? Could you be any lazier?"
                                            },
                                            {
                                                "example_id": "c8ca5c6f-3cdc-44e4-b934-df73ad1829b7",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "Both halves feature lyrics that are so teen-girly they sound like they were written in pink ink in a padlocked diary with hearts and frowny faces for punctuation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b7fae01-51af-3be7-bf84-5b6f51e08c4a",
                                        "entry_id": "21338898-4887-3bf7-a01d-5c8b8ba8532e",
                                        "glosses": [
                                            "A personal organizer or appointment diary."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9de45354-527f-4e2b-aa84-3015fc48890f",
                                                "sense_id": "8b7fae01-51af-3be7-bf84-5b6f51e08c4a",
                                                "text": "It is recommended that teachers and pupils are issued with homework diaries to help implement and monitor the homework timetable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cad41b2-0a3a-39da-a4cb-955b60642dcf",
                                        "entry_id": "49caeb2e-8210-3729-b325-596fb918466f",
                                        "glosses": [
                                            "To keep a diary or journal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca82135-ff7c-4342-8407-82e1cc922966",
                                                "sense_id": "6cad41b2-0a3a-39da-a4cb-955b60642dcf",
                                                "text": "As part of her mindful movement practise, diarying is important to Sarah. \"It gives me a chance to see what is going on, to reflect on my experience.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
