                "senses": [
                    {
                        "sense_id": "469cd448-a60d-315d-a4f6-9f97fe430a2f",
                        "entry_id": "f5c6c441-c647-32c2-80d9-1e5ce6690b97",
                        "glosses": [
                            "рег. тростниковая, ивовая или из другого дерева дудка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ff2aa5-5cc4-4e68-9d4e-c646253c6a4a",
                                "sense_id": "469cd448-a60d-315d-a4f6-9f97fe430a2f",
                                "text": "Весь хор у простаков составляет чебысга или дудочка, которая в верховых городах сиповкою прозывается, и делается или из камыша, или из дягильных стеблей, или из таловых прутьев."
                            }
                        ]
                    }
                ],
