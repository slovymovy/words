                                        "sense_id": "10a79df2-9bb4-37e5-b152-4b8790b4d693",
                                        "entry_id": "c590c4f6-9a67-335e-8ba5-f2931ee079d9",
                                        "glosses": [
                                            "Spielzug, bei dem ein Spieler den Football in die gegnerische Endzone trägt, ihn dort nach einem Pass fängt oder ihn dort sichert"
                                        ],
                                        "tags": [
                                            "American Football"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6920ce24-2890-472b-9876-5379c1bc0129",
                                                "sense_id": "10a79df2-9bb4-37e5-b152-4b8790b4d693",
                                                "text": "In der letzten Spielminute konnte die Auswärtsmannschaft noch einen Touchdown erzielen."
                                            },
                                            {
                                                "example_id": "644cd4b3-66c1-405c-b3b3-7b782300ff93",
                                                "sense_id": "10a79df2-9bb4-37e5-b152-4b8790b4d693",
                                                "text": "„Zwischen 1923 und 1925 agierte Grange als Ballträger, Passgeber, Punter und Returner und erzielte die für damalige Verhältnisse astronomische Anzahl von 31 Touchdowns selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41c461dd-349f-31a7-9ccd-b7ab6ab6680d",
                                        "entry_id": "c590c4f6-9a67-335e-8ba5-f2931ee079d9",
                                        "glosses": [
                                            "Ablegen des Rugbyballes im eigenen Malfeld"
                                        ],
                                        "tags": [
                                            "Rugby"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f88b0047-991a-4fab-a6a5-4b56c4221a80",
                                                "sense_id": "41c461dd-349f-31a7-9ccd-b7ab6ab6680d",
                                                "text": "Der letzten Angriff des Spiels konnte mit einem Touchdown abgewehrt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
