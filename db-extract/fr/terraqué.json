                        ],
                        "form": "terraqués"
                    },
                    {
                        "form_id": "a4a6cd96-61b8-4d17-8244-39a171f8fc24",
                        "entry_id": "b143a856-75f6-3df0-91ad-668ba8389f53",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "terraquée"
                    },
                    {
                        "form_id": "6dfbd11b-fed0-4f19-809a-15500a4d8ce1",
                        "entry_id": "b143a856-75f6-3df0-91ad-668ba8389f53",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "terraquées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1baa6b62-e975-34bd-a014-17bd84b73b03",
                        "entry_id": "b143a856-75f6-3df0-91ad-668ba8389f53",
                        "glosses": [
                            "Qui est composé de terre et d’eau."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "3ef3dc84-fbba-4af9-95c8-851a39d8f491",
                                "sense_id": "1baa6b62-e975-34bd-a014-17bd84b73b03",
                                "text": "Le globe terraqué : Le globe que nous habitons."
                            },
                            {
                                "example_id": "46231f2d-0d34-4a92-b1f4-1fa1d02082a2",
                                "sense_id": "1baa6b62-e975-34bd-a014-17bd84b73b03",
                                "text": "C’est évidemment la fin de ce misérable globe terraqué."
                            },
                            {
                                "example_id": "c79ef622-10ee-458e-bbb8-08d02f703313",
                                "sense_id": "1baa6b62-e975-34bd-a014-17bd84b73b03",
                                "text": "— Je n’ai pas envie de rire, répondit M. Bergeret. Il en est peu de sujets pour moi dans ce monde sublunaire, sur ce globe terraqué dont les habitants sont presque tous odieux ou ridicules."
                            },
                            {
                                "example_id": "17da973b-4911-48d3-9324-83e2d496b723",
                                "sense_id": "1baa6b62-e975-34bd-a014-17bd84b73b03",
                                "text": "Le globe terraqué, roulant parmi les étoiles, souffrait d’un mal intérieur qui éclatait ici ou là."
                            },
                            {
                                "example_id": "76af7b0e-7611-4f45-876c-6e77041089e4",
                                "sense_id": "1baa6b62-e975-34bd-a014-17bd84b73b03",
                                "text": "Tout à coup y apparut, le suivant à pas rapides, la jeune cycliste de la petite bande avec, sur ses cheveux noirs, son polo abaissé vers ses grosses joues, ses yeux gais et un peu insistants ; et dans ce sentier fortuné miraculeusement rempli de douces promesses, je la vis sous les arbres adresser à Elstir un salut souriant d'amie, arc-en-ciel qui unit pour moi notre monde terraqué à des régions que j'avais jugé jusque-là inaccessibles."
                            },
                            {
                                "example_id": "7e37dfdb-c647-48d9-83b2-f519c100b0ad",
                                "sense_id": "1baa6b62-e975-34bd-a014-17bd84b73b03",
                                "text": "Comment prendre pour \"réaliste\" un projet de modernisation qui aurait \"oublié\" depuis deux siècles de prévoir les réactions du globe terraqué aux actions humaines ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e27aa38c-dabb-4976-bfdf-b02bd6da7365",
                        "source_entry_id": "b143a856-75f6-3df0-91ad-668ba8389f53",
                        "source_sense_id": "1baa6b62-e975-34bd-a014-17bd84b73b03",
                        "target_lang_word": "terraqueous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terraqueous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9350e6-3971-312a-b763-11e428717f37",
                                        "entry_id": "ba138a14-137c-3a7e-a3ff-92ac48cf83e2",
                                        "glosses": [
                                            "Chiefly in terraqueous globe (that is, the Earth): consisting of both land and water."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d5fbe72-b631-4a68-b11f-fc1d57d11156",
                                                "sense_id": "4f9350e6-3971-312a-b763-11e428717f37",
                                                "text": "The Terraqueous Globe comprehending Sea and Land, Rivers and Lakes, ſtands divided by modern Geographers into tvvo Semi-Orbs, viz. the Old, and Nevv VVorld."
                                            },
                                            {
                                                "example_id": "0f5eb83c-2f0d-4820-81d2-35d9c40df322",
                                                "sense_id": "4f9350e6-3971-312a-b763-11e428717f37",
                                                "text": "[T]here may poſſibly be One Plastick Inconſcious Nature, in the vvhole Terraqueous Globe, by vvhich Vegetables may be ſeverally organized and framed, and all things performed vvhich tranſcend the Povver of Fortuitous Mechaniſm."
                                            },
                                            {
                                                "example_id": "c4a9b64c-4e0e-47e3-81e4-e1521e215cbc",
                                                "sense_id": "4f9350e6-3971-312a-b763-11e428717f37",
                                                "text": "A Part hovv ſmall of the terraqueous Globe / Is tenanted by man? the reſt a VVaſte, / Rocks, Deſerts, frozen Seas, and burning Sands; / VVild haunts of Monſters, Poiſons, Stings, and Death: / Such is Earth's melancholy Map!"
                                            },
                                            {
                                                "example_id": "e8f24744-78b3-48d5-b7e6-809c1be78b68",
                                                "sense_id": "4f9350e6-3971-312a-b763-11e428717f37",
                                                "text": "[…] Providence enjoins to ev'ry ſoul / An union vvith the vaſt terraqueous vvhole."
                                            },
                                            {
                                                "example_id": "2d1bff88-f45a-4a05-b45d-179f6c6ea784",
                                                "sense_id": "4f9350e6-3971-312a-b763-11e428717f37",
                                                "text": "'And when we come to that lane^([sic – meaning line]) your worship speaks of,' said Sancho [Panza], 'how far shall we have gone?' / 'Very far,' said Don Quixote, 'for of the three hundred and sixty degrees that this terraqueous globe contains, as computed by Ptolemy, the greatest cosmographer known, we shall have travelled one-half when we come to the line I spoke of.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3f61418-6014-319d-ab99-2afc6e0697e1",
                                        "entry_id": "ba138a14-137c-3a7e-a3ff-92ac48cf83e2",
                                        "glosses": [
                                            "Relating to, or taking place on, both land and water."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f1f7138-35cc-4863-a014-1ccd108e265c",
                                                "sense_id": "d3f61418-6014-319d-ab99-2afc6e0697e1",
                                                "text": "Thus the vicissitudes of the land and ocean, portrayed in the tertiary formations, harmonise perfectly with other terraqueous phenomena of the same geological period."
                                            },
                                            {
                                                "example_id": "73fab206-5775-4ef9-98a4-ab1eaa2924d0",
                                                "sense_id": "d3f61418-6014-319d-ab99-2afc6e0697e1",
                                                "text": "Spirit of light and darkness! I no less / Twy-natured, but of more terraqueous mould, / In whom conflicting powers proportion hold / With poise exact, before thy proud excess / Of beauty perfect and pure lawlessness / Quail self-confounded; neither nobly bold / To dare for thee damnation, nor so cold / As to endure unscathed thy fiery stress."
                                            },
                                            {
                                                "example_id": "ce221074-4deb-4bdd-b0ff-aaf88ee8aa47",
                                                "sense_id": "d3f61418-6014-319d-ab99-2afc6e0697e1",
                                                "text": "After this season of congealed dampness came a spell of dry frost, when strange birds from behind the North Pole began to arrive silently on the upland of Flintcomb-Ash; gaunt spectral creatures with tragical eyes—eyes which had […] been half blinded by the whirl of colossal storms and terraqueous distortions; and retained the expression of feature that such scenes had engendered."
                                            },
                                            {
                                                "example_id": "773dcf4a-7541-4647-b861-93ed58374ab3",
                                                "sense_id": "d3f61418-6014-319d-ab99-2afc6e0697e1",
                                                "text": "So, despite the obvious difficulties of crossing the intervening Sidlaws, correspondents to the Dundee newspapers in 1817 were advocating a \"terraqueous undertaking\" in the form of a canal from the town into Strathmore."
                                            },
                                            {
                                                "example_id": "86f26aa6-d026-4983-bc36-0bc8dbbdb4d6",
                                                "sense_id": "d3f61418-6014-319d-ab99-2afc6e0697e1",
                                                "text": "When the projectile fell in the mortar with the end of the fuse left outside like a rat's tail, others, more experienced, put the brand to it and … boom … boom … boom … violent terraqueous explosions, followed by booming detonations high up in a vast sky now full of stars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06dbbee2-2f25-34be-99aa-2a2c570d44df",
                                        "entry_id": "ba138a14-137c-3a7e-a3ff-92ac48cf83e2",
                                        "glosses": [
                                            "Of a plant: living in both land and water; amphibious."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bf073cc-5f95-4e80-9d21-7d9dd08968d4",
                                                "sense_id": "06dbbee2-2f25-34be-99aa-2a2c570d44df",
                                                "text": "Among a large number of terraqueous plants, cellulose and lignin are dominant in nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
