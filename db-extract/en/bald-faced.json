                        ],
                        "examples": [
                            {
                                "example_id": "4c9486ac-94ce-4a64-b104-d680243a5683",
                                "sense_id": "e45eab6e-ecb8-3460-b1cb-7be0c07f00f4",
                                "text": "a bald-faced lie"
                            },
                            {
                                "example_id": "5d4d1016-2df9-4423-a3c9-2fafc1d52d20",
                                "sense_id": "e45eab6e-ecb8-3460-b1cb-7be0c07f00f4",
                                "text": "What kind of deformed party will such a dynamic produce? A party so willing to be marinated in such a baldfaced lie will lie about anything, including who wins the next election and every one after that."
                            }
                        ]
                    }
                ],
                "translations": [
