                        "glosses": [
                            "longontsteking veroorzaakt door de Legionella pneumophila die zich vooral in warm (maar niet te warm) water kan vermenigvuldigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3385b763-764d-4c3f-a23b-9199f136885d",
                                "sense_id": "322c622f-672f-3f26-b307-f69799580f4e",
                                "text": "Zondag stief een 65-jarige man van wie wordt aangenomen dat hij de ziekte had. De autoriteiten wilden echter niet bevestigen dat hij is gestorven aan legionairsziekte."
                            },
                            {
                                "example_id": "167f0bc2-3308-4ddc-accc-64fa1d5164b5",
                                "sense_id": "322c622f-672f-3f26-b307-f69799580f4e",
                                "text": "Legionella is een zuurstofminnende, staafvormige kiem die in zoet water leeft en courant wordt aangetroffen. Onder ideale omstandigheden kan de bacterie zich vermenigvuldigen en de legionairsziekte of veteranenziekte veroorzaken."
                            }
                        ]
