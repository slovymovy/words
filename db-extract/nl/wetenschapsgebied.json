                "translations": [
                    {
                        "translation_id": "722dab45-a8c1-46f6-84f3-d0ff28311816",
                        "source_entry_id": "19b21095-ef46-301e-8c75-8e3e1a1c8413",
                        "source_sense_id": "142ea393-acd4-34d4-990e-9596b73f7e73",
                        "source_sense_description": "een specifiek domein binnen de wetenschap",
                        "target_lang_word": "Wissenschaftsgebiet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wissenschaftsgebiet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff0d8fd9-21a3-3f70-b350-a1dcec3103b7",
                                        "entry_id": "78fc5cad-cded-3228-ae0e-50657481df99",
                                        "glosses": [
                                            "wissenschaftliches Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62614210-5b11-44c1-bef5-77b051a1d735",
                                                "sense_id": "ff0d8fd9-21a3-3f70-b350-a1dcec3103b7",
                                                "text": "„Hirnforschung ist ein Wissenschaftsgebiet mit großer populärer Ausstrahlung.“"
                                            },
                                            {
                                                "example_id": "d69ad72c-a793-4654-89d0-3261b08a80f0",
                                                "sense_id": "ff0d8fd9-21a3-3f70-b350-a1dcec3103b7",
                                                "text": "„Ein ‚derartig im Fluß befindendes Wissenschaftsgebiet wie die Evolutorische Ökonomik‘ stelle die akademische Lehre vor ernste Schwierigkeiten, gestehen die Herausgeber zu.“"
                                            },
                                            {
                                                "example_id": "30e2f2e9-bd25-4e53-8664-49cfe1d3c8a9",
                                                "sense_id": "ff0d8fd9-21a3-3f70-b350-a1dcec3103b7",
                                                "text": "„Poensgen nannte beispielhafte Fragestellungen des jungen, interdisziplinären Wissenschaftsgebiets: «Warum in der Medizin ein Herzinfarkt bei Frauen später diagnostiziert wird als bei Männern oder warum im Marketing mit Geschlechterbildern so viel Geld verdient wird, warum die Musikwissenschaft nach wie vor so wenige Komponistinnen kennt oder auch warum Intersexualität erst jetzt Thema in der Gesundheitsversorgung wird.“"
                                            },
                                            {
                                                "example_id": "83819a1b-43d4-4823-8a81-827a5d4bddfc",
                                                "sense_id": "ff0d8fd9-21a3-3f70-b350-a1dcec3103b7",
                                                "text": "„Sein einzigartiges Genom könnte den Wasserfloh nach Ansicht der Forscher in Zukunft zu einem Modellorganismus eines völlig neuen Wissenschaftsgebiets avancieren lassen: Es gehe darum, das Zusammenspiel von Umwelt und Genen besser zu verstehen.“"
                                            },
                                            {
                                                "example_id": "62dff1d5-1e65-4ca6-948e-476385a98f19",
                                                "sense_id": "ff0d8fd9-21a3-3f70-b350-a1dcec3103b7",
                                                "text": "„Siegel wurde in Österreich der Führer im Wissenschaftsgebiete des deutschen Rechtes, welches er mit dem österreichischen Rechte in Zusammenhang zu bringen meisterhaft verstanden hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
