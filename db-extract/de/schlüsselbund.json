                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schlüsselbunde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                        "entry_id": "000244f2-8f24-3782-b35e-17f97fc1a7d8",
                        "glosses": [
                            "mehrere Schlüssel zum Öffnen von Schlössern, die gemeinsam an einem Ring oder etwas Ähnlichem befestigt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900510d6-d3e5-42b6-94dc-038abf87158f",
                                "sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                                "text": "Der Hausmeister zog seinen Schlüsselbund aus der Tasche und öffnete alle Türen für die Inspektoren."
                            },
                            {
                                "example_id": "7cb6803f-c91d-4c5d-b5f2-fe99734c58c1",
                                "sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                                "text": "Am Sonntagnachmittag ist in der Polizeiwache an der Bielefelder Straße ein Schlüsselbund abgegeben worden, das nun seinen Besitzer sucht."
                            },
                            {
                                "example_id": "b5c8aa47-d9ce-4ef1-93b5-52f291378c4f",
                                "sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                                "text": "Ob das Schlüsselbund aus einer Straftat stammt oder verloren wurde, kann nicht gesagt werden."
                            },
                            {
                                "example_id": "fa78007c-3af6-45ec-9231-c4f9bc1ada66",
                                "sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                                "text": "„Die Hausherrin des achtzehnten Jahrhunderts trug ständig einen riesigen Schlüsselbund um die Taille, die mehr dem Schutz vor Langfingern im eigenen Haus als dem vor Einbrechern diente.“"
                            },
                            {
                                "example_id": "06cdfb45-61e0-443b-907f-f20cff48bf47",
                                "sense_id": "0895e417-f59b-3178-84b1-e271a5f35f66",
                                "text": "„Unter einer Bank fanden wir ein Schlüsselbund mit Etui.“"
                            }
                        ],
