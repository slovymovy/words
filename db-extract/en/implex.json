                        "examples": [
                            {
                                "example_id": "2af44353-a122-48bd-899b-263d3da9dd03",
                                "sense_id": "55853d9e-32e1-35de-9d1a-7780fd9d11c4",
                                "text": "The fable of every poem is, according to Aristotle’s division, either simple or implex. It is called simple when there is no change of fortune in it; implex, when the fortune of the chief actor changes from bad to good, or from good to bad. The implex fable is thought most perfect: I suppose, because it is more proper to stir up the passion of the reader, and to surprise him with a greater variety of accidents."
                            }
                        ]
                    }
