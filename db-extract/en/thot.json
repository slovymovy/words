                "word": "thot",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d737e316-e730-459c-9512-649a0cebb9fc",
                        "entry_id": "0d8a3b2c-a8c7-3a7f-98d6-6bc75ca00ecc",
