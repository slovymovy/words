                    {
                        "sense_id": "4c9d1425-8cb5-3080-8c78-c44d6247393e",
                        "entry_id": "ba583d2e-59d0-3b1f-a8e3-7fa37594e608",
                        "glosses": [
                            "Qui acquiert une connaissance ou un savoir-faire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f715db85-7b7b-45c1-8157-9152c2d5adac",
                                "sense_id": "4c9d1425-8cb5-3080-8c78-c44d6247393e",
                                "text": "Un red herring, littéralement hareng rouge, est un leurre ou une fausse piste, c'est-à-dire quelque chose qui induit en erreur ou détourne l'attention de l'attention de l'agent apprenant pour l'amener à apprendre quelque chose d'incorrect et/ou d'involontaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "edf6edc0-e0fb-30a0-9fef-c0f1ed48e782",
                        "entry_id": "ba583d2e-59d0-3b1f-a8e3-7fa37594e608",
                        "glosses": [
                            "Qui permet d’apprendre."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "d35a056b-82cc-47a3-aee2-ba598a699b06",
                                "sense_id": "edf6edc0-e0fb-30a0-9fef-c0f1ed48e782",
                                "text": "L’opération vacances apprenantes repose sur plusieurs dispositifs allant de l’école ouverte à des séjours en colonies de vacances, dans le respect des consignes sanitaires."
                            }
                        ]
                    }
                ],
