                    {
                        "sense_id": "40370535-4f7c-31f9-a89c-318c9fbc7cb5",
                        "entry_id": "20a6f5a9-f496-3fb2-9621-0ab03da25426",
                        "glosses": [
                            "Arbeitsmaschine, die mittels Zahnrädern ein Fluid verdichtet oder nur den Druck erhöht, pumpt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e8b08e-71ba-4e8f-93dc-614fb1b5cc9a",
                                "sense_id": "40370535-4f7c-31f9-a89c-318c9fbc7cb5",
                                "text": "„Er heiratete erneut und schuf hier unter anderem eine Schrift über die Funktionsweise des Auges, vollendete die Rudolfinischen Tafeln, entwickelte eine ventillose Zahnradpumpe und formulierte das dritte Kepler'sche Gesetz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d2edd2e-9450-41bb-bef2-d9a902fe0398",
                        "source_entry_id": "20a6f5a9-f496-3fb2-9621-0ab03da25426",
                        "source_sense_id": "40370535-4f7c-31f9-a89c-318c9fbc7cb5",
                        "source_sense_description": "Arbeitsmaschine, die mittels Zahnrädern ein Fluid verdichtet oder nur den Druck erhöht, pumpt",
                        "target_lang_word": "pompe à engrenages",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompe à engrenages",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b51e8f03-b069-3989-aff0-6e1afa8a0059",
                                        "entry_id": "06f10376-63b3-3124-ba86-a86d6be0f49b",
                                        "glosses": [
                                            "Pompe volumétrique rotative utilisant le profil combiné de deux roues dentées pour mettre en mouvement un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a4cdb51-1695-411a-9b35-d705e4fca3fe",
                                                "sense_id": "b51e8f03-b069-3989-aff0-6e1afa8a0059",
                                                "text": "Le principe de la pompe à engrenages se prête aux combinaisons les plus variées et a engendré toute une série de types."
                                            },
                                            {
                                                "example_id": "42465946-53a9-4f14-8676-2becf8af8346",
                                                "sense_id": "b51e8f03-b069-3989-aff0-6e1afa8a0059",
                                                "text": "Il a constaté que la pompe à engrenages était nettement moins sensible à la cavitation que la pompe à palettes : la dépression critique moyenne à l’aspiration, à 50° C, étant 2,5 fois plus élevée pour la pompe à engrenages que pour la pompe à palettes."
                                            },
                                            {
                                                "example_id": "44b20a00-dcec-4f16-8050-85215a1982cf",
                                                "sense_id": "b51e8f03-b069-3989-aff0-6e1afa8a0059",
                                                "text": "La pompe à engrenages est dédiée au transfert de fluides lubrifiants exempts de particules ou de corps étrangers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
