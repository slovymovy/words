                                        "entry_id": "499f6871-7cd9-3d6c-a6ee-bcc0800ec3f9",
                                        "glosses": [
                                            "Of or in the language of Luxembourg (derived from the Moselle Franconian group of High German dialects)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Luxembourgish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fae54019-86fa-3e6c-b3c4-32f92a9501a1",
                                        "entry_id": "3514bd85-1f59-3ca4-bc14-ab3b28a66187",
                                        "glosses": [
                                            "A Germanic language spoken in Luxembourg and, traditionally, around the city of Arlon (Belgium); originally included in the Moselle Franconian group of High German dialects, but now usually regarded as a separate language due to its standardisation and official use in the state of Luxembourg."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78422223-8884-422e-a0a5-95c9b45f8a6a",
                        "source_entry_id": "99ad453a-9d1a-3901-84f9-e031a4c538c8",
                        "source_sense_id": "6ef17e8f-eb46-31bc-b13f-97c51cd379f1",
                        "target_lang_word": "luxembourgeois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luxembourgeois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7bf6aee-4f7d-38e2-b126-34d2caf2ecd0",
                                        "entry_id": "69bcd31f-96e3-333a-9680-b8c5d753c5e0",
                                        "glosses": [
                                            "Langue germanique parlée au Luxembourg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ae6473-ac4e-475a-b717-8a7e14356c25",
                                                "sense_id": "d7bf6aee-4f7d-38e2-b126-34d2caf2ecd0",
                                                "text": "Le luxembourgeois a emprunté beaucoup de mots au français et à l’allemand."
                                            },
                                            {
                                                "example_id": "42427926-8cce-43ad-8bef-5c6743999dac",
                                                "sense_id": "d7bf6aee-4f7d-38e2-b126-34d2caf2ecd0",
                                                "text": "C’est même la grand-messe du dimanche à l'église Saint-Donat, désormais dite en portugais par le padre Renato, alors que la messe en luxembourgeois se tient le samedi."
                                            },
                                            {
                                                "example_id": "c4121948-2a88-4f25-b3a4-6d32dd72f45d",
                                                "sense_id": "d7bf6aee-4f7d-38e2-b126-34d2caf2ecd0",
                                                "text": "Le statut du luxembourgeois, historiquement un dialecte du francique mosellan occidental est, depuis 1984, celui de langue nationale, c’est-à-dire de langue parlée dans des situations officielles comme les débats de la Chambre des Députés, et la troisième langue officielle du Luxembourg (environ 600 000 habitants), après le français et l’allemand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "luxembourgeois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae7f7e3-627d-3868-b051-6393326f55b3",
                                        "entry_id": "5fae6240-6de2-32d4-b2eb-e505794d50c8",
                                        "glosses": [
                                            "Relatif à la langue luxembourgeoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041f3d45-fee9-4dba-a816-737db9feb1f1",
                                                "sense_id": "0ae7f7e3-627d-3868-b051-6393326f55b3",
                                                "text": "Il possède un livre de grammaire luxembourgeoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51c688dd-e6d5-3c92-bc10-4f16fc849f10",
                                        "entry_id": "5fae6240-6de2-32d4-b2eb-e505794d50c8",
                                        "glosses": [
                                            "Relatif au Luxembourg, à ses habitants ou à sa culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5abb1cc1-d739-4be1-a4d0-ab7023b2521e",
                                                "sense_id": "51c688dd-e6d5-3c92-bc10-4f16fc849f10",
                                                "text": "Il habite un village luxembourgeois."
                                            },
                                            {
                                                "example_id": "04a682c2-cf50-46c9-82e5-32cbe3b0ad12",
                                                "sense_id": "51c688dd-e6d5-3c92-bc10-4f16fc849f10",
                                                "text": "Au vingtième verre, il se prend pour la Banque de France. Au trentième, il raconte partout qu’il est suisse. Au quarantième, il parle avec l’accent luxembourgeois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d3cd7c-2752-3533-8bb8-2d11bb67a023",
                                        "entry_id": "5fae6240-6de2-32d4-b2eb-e505794d50c8",
                                        "glosses": [
                                            "Relatif à la ville de Luxembourg ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7efe1a14-ed39-3fca-b14f-f7c21b1e6f13",
                                        "entry_id": "5fae6240-6de2-32d4-b2eb-e505794d50c8",
                                        "glosses": [
                                            "Relatif à la province belge de Luxembourg et à ses habitants (emploi très rare pour éviter les risques de confusion avec les sens relatifs au pays ou à la ville)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0375aa8b-2273-3b40-ad37-5800aacddc98",
                                        "entry_id": "5fae6240-6de2-32d4-b2eb-e505794d50c8",
                                        "glosses": [
                                            "Relatif à la justice européenne (car la Cour de justice de l’Union européenne se trouve à Luxembourg)."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5da5f84c-ace8-4afd-b07a-413549bcdbb5",
                                                "sense_id": "0375aa8b-2273-3b40-ad37-5800aacddc98",
                                                "text": "Sans surprise, un contentieux éclate entre les protagonistes. Et le Conseil d’État de Belgique finit par faire un recours préjudiciel auprès de la juridiction luxembourgeoise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
