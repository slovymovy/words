                ],
                "senses": [
                    {
                        "sense_id": "b9d827e0-2bed-3024-875f-a0e25969edb0",
                        "entry_id": "f0d9b5ea-4835-37e2-8fee-66335dfdffba",
                        "glosses": [
                            "Zeitpunkt, zu dem man glücklich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb4ea641-0672-4ce6-a476-3d5f885ecb80",
                                "sense_id": "b9d827e0-2bed-3024-875f-a0e25969edb0",
                                "text": "„Man gibt alles, aber die Glücksmomente sind rar gesät.“"
                            },
                            {
                                "example_id": "d257f65e-5981-4dae-be68-da49974220e1",
                                "sense_id": "b9d827e0-2bed-3024-875f-a0e25969edb0",
                                "text": "„Jedes Mal, wenn ein Osterei gefunden wird, löst das einen Glücksmoment aus.“"
                            },
                            {
                                "example_id": "a092b668-f4d8-4bc6-9d45-a585242d23a3",
                                "sense_id": "b9d827e0-2bed-3024-875f-a0e25969edb0",
                                "text": "„Kleine Glücksmomente ziehen oft vorbei und wir bemerken sie gar nicht in der Eile des Alltags.“"
                            },
                            {
                                "example_id": "94c8b849-b10d-4064-b4ae-0801d0a1c82c",
                                "sense_id": "b9d827e0-2bed-3024-875f-a0e25969edb0",
                                "text": "„Das Einzige, was diese Glücksmomente überschattete, war, dass Halldór in seinem Innersten, da, wo das Magma steckt, fühlte: Sobald es zu Ende war, der Zauber gebrochen, und sie die Gitarren weggelegt hatten, würde der Alltag zurückkehren, und die Distanz zwischen ihnen würde wieder wachsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
