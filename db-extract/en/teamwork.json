                "senses": [
                    {
                        "sense_id": "586e881f-2da4-361a-8ad3-d5a0e2c68383",
                        "entry_id": "417ff3a9-9b52-376a-ad8c-027c8bd512cd",
                        "glosses": [
                            "The cooperative effort of a team of people to achieve a common goal."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "57b76f09-694a-47e1-8064-56a9ac39de62",
                                "sense_id": "586e881f-2da4-361a-8ad3-d5a0e2c68383",
                                "text": "Sonic: OK then, let’s get ready to do this. We’ll show that creep the REAL SUPER POWER of TEAM WORK!"
                            },
                            {
                                "example_id": "2e2e2543-585b-40e2-b534-d85596d7ba82",
                                "sense_id": "586e881f-2da4-361a-8ad3-d5a0e2c68383",
                                "text": "Having put partisan interests to one side, Greenwood set about making teamwork a watchword for her chairmanship, while seeking the broadest possible participation in subsequent inquiries."
                            }
                        ]
                    }
                ],
                "translations": [
