                        "glosses": [
                            "Beweis, dass eine Behauptung falsch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f97e741-43d9-4136-9a00-62d3f0ea8992",
                                "sense_id": "14f9c799-7f2b-3582-bf8d-4b0053c5db84",
                                "text": "An der Widerlegung der These haben wir sehr lange gearbeitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d076c9c-ea9b-4ae6-831e-333dcf381b02",
                        "source_entry_id": "04a93b3b-5600-35b5-ad09-caca492f5b5c",
                        "source_sense_id": "14f9c799-7f2b-3582-bf8d-4b0053c5db84",
                        "source_sense_description": "Beweis, dass eine Behauptung falsch ist",
                        "target_lang_word": "refutation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refutation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7078bf-c158-3ba7-8551-a3371e020ef8",
                                        "entry_id": "81c96b2e-2b01-354b-9160-d2374fef2406",
                                        "glosses": [
                                            "An act of refuting or disproving; the disproving of an argument, opinion, testimony, doctrine or theory by argument or countervailing proof; evidence of falseness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeee3e67-4d53-49ba-be24-a4945d863fcf",
                                                "sense_id": "4c7078bf-c158-3ba7-8551-a3371e020ef8",
                                                "text": "Near-synonym: rebuttal (see note)"
                                            },
                                            {
                                                "example_id": "e1845842-8d75-4a3e-9342-fa5f44c108e1",
                                                "sense_id": "4c7078bf-c158-3ba7-8551-a3371e020ef8",
                                                "text": "Apply these tests to his arguments and you will render your task of refutation easier. But in your refutation, be sure you refute. Don’t think for a minute that either heat or violence or sarcasm is a good answer."
                                            },
                                            {
                                                "example_id": "16cb5d01-7ebc-4394-9532-cc667da345d5",
                                                "sense_id": "4c7078bf-c158-3ba7-8551-a3371e020ef8",
                                                "text": "The conclusion to which we shall be led by a full consideration of these facts will be that the effective refutation of such errors will frequently require further intellectual advance, and often advance on points which are very abstract and may seem very remote from the practical issues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9dcf448-be6f-31e8-a390-295189dc7397",
                                        "entry_id": "81c96b2e-2b01-354b-9160-d2374fef2406",
                                        "glosses": [
                                            "A vocal answer to an attack on one's assertions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3021f52a-3187-4139-a340-35c4b260a28f",
                        "source_entry_id": "04a93b3b-5600-35b5-ad09-caca492f5b5c",
                        "source_sense_id": "14f9c799-7f2b-3582-bf8d-4b0053c5db84",
                        "source_sense_description": "Beweis, dass eine Behauptung falsch ist",
                        "target_lang_word": "réfutation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réfutation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f11a9229-3580-362d-af08-4936f39b1b9f",
                                        "entry_id": "98320e5b-55ba-3145-9a8f-d4ad4e9bddae",
                                        "glosses": [
                                            "Discours ou écrit par lequel on réfute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c21817c8-3b0a-4cf2-a515-7591c19e5831",
                                                "sense_id": "f11a9229-3580-362d-af08-4936f39b1b9f",
                                                "text": "On ne doit donc tenir aucun compte des évaluation de ces derniers auteurs; elles ne méritent pas même l’honneur d’une réfutation."
                                            },
                                            {
                                                "example_id": "88530822-6166-4a96-b69d-2b95d96fbe37",
                                                "sense_id": "f11a9229-3580-362d-af08-4936f39b1b9f",
                                                "text": "Je vois plusieurs libraires ; l’un très bien fourni, avec les livres nouveaux et les réfutations de Renan, même les réfutations des réfutations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a1e48c-4e97-31fa-b1d1-de21bc750c71",
                                        "entry_id": "98320e5b-55ba-3145-9a8f-d4ad4e9bddae",
                                        "glosses": [
                                            "Démonstration de la fausseté d'un argument."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b29fac7f-f613-45ba-99ef-c4be43869047",
                                                "sense_id": "11a1e48c-4e97-31fa-b1d1-de21bc750c71",
                                                "text": "D’après la liste précédente, les arguments évoqués par les conspirationnistes demeurent circonstanciels et indirects. Ils ont d’ailleurs tous fait l’objet de réfutations détaillées […]"
                                            },
                                            {
                                                "example_id": "17633079-32dd-482c-9a03-f84dfc2a6f91",
                                                "sense_id": "11a1e48c-4e97-31fa-b1d1-de21bc750c71",
                                                "text": "Un scientifique digne de ce nom commence par émettre des hypothèses …, puis soumet ses hypothèses à des tests expérimentaux rigoureux susceptibles de les confirmer ou de les infirmer. … Le critère de réfutation permet donc de distinguer la démarche scientifique de la pseudoscience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684f4c2d-cb14-3901-b581-be82b04a826d",
                                        "entry_id": "98320e5b-55ba-3145-9a8f-d4ad4e9bddae",
                                        "glosses": [
                                            "Partie du discours par laquelle on répond aux objections."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7645fd2-08c5-4ac0-ac21-ed64edc1fe5e",
                                                "sense_id": "684f4c2d-cb14-3901-b581-be82b04a826d",
                                                "text": "La confirmation précède la réfutation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
