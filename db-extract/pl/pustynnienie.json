                    {
                        "translation_id": "b008f8a5-4220-48dc-9947-913116828435",
                        "source_entry_id": "05391f1f-bd67-3a3d-bbe6-a28db2e38670",
                        "source_sense_id": "f5490390-65bc-31c1-b37c-3cc169829427",
                        "target_lang_word": "verwoestijning",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwoestijning",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "01afcf19-cc87-3d5c-b28b-d3a23b7e0108",
                                        "entry_id": "48952491-7976-3ec9-8f23-8a08238ce11b",
                                        "glosses": [
                                            "is een term die gebruikt wordt voor zowel het oprukken of zich uitbreiden van een woestijn, als het ontstaan van nieuwe woestijngebieden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fff3c6d-83c4-4d75-ba56-a0023879d745",
                                                "sense_id": "01afcf19-cc87-3d5c-b28b-d3a23b7e0108",
                                                "text": "In Tsjaad is verwoestijning een groter gevaar dan in de Noordoostpolder."
                                            },
                                            {
                                                "example_id": "27fbb22a-efca-44c0-b398-5b62fc3fec06",
                                                "sense_id": "01afcf19-cc87-3d5c-b28b-d3a23b7e0108",
                                                "text": "Het weer wordt extremer. Veel meer neerslag, meer verdroging, verwoestijning, meer stormen, de zeespiegel stijgt. Dat is echt een kantelpunt. Er kan een moment komen dat de zeespiegel zo stijgt dat er niks meer aan te doen is. Wat je ook doet, je krijgt het niet meer hersteld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d9e1200-7656-48ce-88f6-5fd391adf6c9",
                        "source_entry_id": "05391f1f-bd67-3a3d-bbe6-a28db2e38670",
                        "source_sense_id": "f5490390-65bc-31c1-b37c-3cc169829427",
                        "target_lang_word": "Desertifikation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Desertifikation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30e87bac-1342-355f-9fb4-301714eb475a",
                                        "entry_id": "b10ff6d9-4cca-3b86-b45e-df24c1e017e5",
                                        "glosses": [
                                            "schleichende Ausdehnung der Wüste in semiariden Gebieten infolge intensiver Nutzung durch den Menschen und anderen klimatischen Einflüssen"
                                        ],
                                        "tags": [
                                            "Biogeographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2ac9f4-f611-489e-9ad8-5d01d74fe4ad",
                                                "sense_id": "30e87bac-1342-355f-9fb4-301714eb475a",
                                                "text": "„Als Maßnahme vor Ort gegen die Desertifikation werden oft Stein- oder Lehmwälle errichtet, um das geringe Aufkommen an Niederschlägen aufzustauen.“"
                                            },
                                            {
                                                "example_id": "59a5cb47-fcb3-4726-9276-3902c3631e2c",
                                                "sense_id": "30e87bac-1342-355f-9fb4-301714eb475a",
                                                "text": "Der WWF ruft die Staaten der Europäischen Union zu stärkeren Anstrengungen im Kampf gegen Desertifikation auf."
                                            },
                                            {
                                                "example_id": "67c18f7a-73ed-4862-84f3-122d5e3904d2",
                                                "sense_id": "30e87bac-1342-355f-9fb4-301714eb475a",
                                                "text": "Für ihn ist die Ursache der Migration eindeutig: \"Der Klimawandel beschleunigt die Desertifikation und raubt den Menschen die Lebensgrundlagen.\""
                                            },
                                            {
                                                "example_id": "72c4e7a1-01d7-48cc-93af-7a173b91e354",
                                                "sense_id": "30e87bac-1342-355f-9fb4-301714eb475a",
                                                "text": "Die Trockengebiete der Erde bleiben ein Randthema der internationalen Umwelt- und Entwicklungspolitik. Daran wird leider auch der UN-Welttag zur Bekämpfung der Desertifikation am 17. Juni wenig ändern."
                                            },
                                            {
                                                "example_id": "2e3c38c4-12d9-4424-9d9c-ee14f01ff499",
                                                "sense_id": "30e87bac-1342-355f-9fb4-301714eb475a",
                                                "text": "Neben dem hoch industrialisierten Gemüseanbau ist die Entwaldung einer der wesentlichen Gründe für die zunehmende Desertifikation in Spanien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fa498bf-833c-45f3-a3c1-df1f0cce8487",
                        "source_entry_id": "05391f1f-bd67-3a3d-bbe6-a28db2e38670",
                        "source_sense_id": "f5490390-65bc-31c1-b37c-3cc169829427",
                        "target_lang_word": "Verwüstung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwüstung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                        "entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                                        "glosses": [
                                            "Zustand vollkommener Zerstörung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaacf8cf-9082-47f2-8536-11bb5e9ed009",
                                                "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                                "text": "„Die sichtbare Verwüstung schließe die Opfer der radioaktiven Verstrahlung nicht ein.“"
                                            },
                                            {
                                                "example_id": "27afe531-63a8-44d0-b6b9-80c784e1f86e",
                                                "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                                "text": "„Bei den Verwüstungen wurde unter anderem auch die Kastorkirche fast ganz zerstört und erst in den Jahren danach in der heutigen Form wiederaufgebaut.“"
                                            },
                                            {
                                                "example_id": "6b70c514-9870-4bc6-866f-1fc29053dc14",
                                                "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                                "text": "„Die Verwüstungen, nach denen Robert Franke im September 1914 noch meist vergeblich gesucht hatte, waren nun im ganzen östlichen Ostpreußen unübersehbar.“"
                                            },
                                            {
                                                "example_id": "3389c7e9-6c55-480f-b321-04a476ad920b",
                                                "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                                "text": "„Das Erdreich rings um die Bäume, deren kahle, im blassen Mondlichte zum Himmel emporstrebende Äste die Verwüstung anzuklagen schienen, war durch den Pflug aufgerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6256285-1a6c-3542-8929-3656200d25cd",
                                        "entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                                        "glosses": [
                                            "natürliche oder menschengemachte Austrocknung und somit Verschlechterung des Bodens in relativ trockenen Gebieten"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338fb4f8-bc27-4272-86f0-df56d99c5834",
                                                "sense_id": "a6256285-1a6c-3542-8929-3656200d25cd",
                                                "text": "Die Verwüstung ist ein globales Problem."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d219218-5f70-311a-a977-af6d79f3f6a4",
                                        "entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
