                                        "glosses": [
                                            "mededeling die niet waar is, met de bedoeling om anderen te misleiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6859a12b-119e-40f5-8a08-83a2e221f4f8",
                                                "sense_id": "0c885d6f-cae1-3906-a80d-4352fbde084f",
                                                "text": "De jongen verzon snel een leugen om onder straf uit te komen."
                                            },
                                            {
                                                "example_id": "537e7f75-2b72-497c-b70d-1c1836d40643",
                                                "sense_id": "0c885d6f-cae1-3906-a80d-4352fbde084f",
                                                "text": "Op maandag ging Trump nog een stapje verder. In zijn Air Force One noemde hij de Russische aanval ‘een vergissing’ en herhaalde hij nog maar eens de leugen dat de oorlog de schuld is van Joe Biden en Zelensky."
                                            },
                                            {
                                                "example_id": "3ce2c01c-18d2-4b8d-bbfb-9d41996628fe",
                                                "sense_id": "0c885d6f-cae1-3906-a80d-4352fbde084f",
                                                "text": "Trump verspreidde in het laatste jaar van zijn vorige presidentschap volgens Washington Post gemiddeld 39 leugens per dag en dat is bepaald niet minder geworden."
                                            },
                                            {
                                                "example_id": "1ec94b5d-8e0c-451f-b65e-5ff6facbc5c2",
                                                "sense_id": "0c885d6f-cae1-3906-a80d-4352fbde084f",
                                                "text": "In de tussentijd schreef ik wraakgedichten over het Engelse weer en diste ik tegen mijn moeder de leugen op dat Londen het einde was."
                                            }
                                        ]
