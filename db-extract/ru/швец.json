                "senses": [
                    {
                        "sense_id": "fd49aca9-f774-3e5e-aece-94920cb7e894",
                        "entry_id": "05e94c35-4512-33c5-9745-6cc11eceb300",
                        "glosses": [
                            "tailor"
                        ],
                        "tags": [
                            "animate",
