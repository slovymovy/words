                                                "sense_id": "41ff17c3-a5be-310c-b487-89f2632c3491",
                                                "text": "The climber found himself in a pickle when one of the rocks broke off."
                                            },
                                            {
                                                "example_id": "cd224037-59e8-4e74-8e68-cb41c9fd51d5",
                                                "sense_id": "41ff17c3-a5be-310c-b487-89f2632c3491",
                                                "text": "I beg you, Miss Jones, to realize the pickle you're in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d981f985-0683-3ccc-a17a-af38b50a3ca2",
                                        "entry_id": "0a0af91f-c866-3fb3-9997-aab3c1ec8b86",
                                        "glosses": [
                                            "A mildly mischievous loved one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "endearing",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1dd57d-6408-4306-baed-dcdbd2e534d1",
                                                "sense_id": "d981f985-0683-3ccc-a17a-af38b50a3ca2",
                                                "text": "by degrees my little pickle (who, as I told you at the beginning of the story, was the most troublesome child I ever came across) turned into a very well-behaved young gentleman."
                                            },
                                            {
                                                "example_id": "2fe26295-fa9e-44a8-9fef-4aa873a97a84",
                                                "sense_id": "d981f985-0683-3ccc-a17a-af38b50a3ca2",
                                                "text": "... If you could get my little pickle to learn his multiplication table before you leave us, you shall have that musical box to take home with you."
                                            },
                                            {
                                                "example_id": "9b303b61-e407-4833-a6d7-f973b4e78e97",
                                                "sense_id": "d981f985-0683-3ccc-a17a-af38b50a3ca2",
                                                "text": "'And now,' she said, 'what about that kiss my little pickle was going to give his old Auntie?'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e43043-0346-339c-a04e-8eaf98c942bc",
                                        "entry_id": "0a0af91f-c866-3fb3-9997-aab3c1ec8b86",
