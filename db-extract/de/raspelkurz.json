                "senses": [
                    {
                        "sense_id": "ef15d641-9199-3dd5-8b27-d848bdb59d9d",
                        "entry_id": "ced8c59e-f177-3baa-ae08-43b371a9cea1",
                        "glosses": [
                            "sehr kurz, eine äußerst geringe Länge aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea2d999a-9bd4-4e36-9175-a6101a4219f5",
                                "sense_id": "ef15d641-9199-3dd5-8b27-d848bdb59d9d",
                                "text": "„Die Frau mit dem raspelkurzen blonden Haarschnitt ist gleichzeitig bürgerliche Intellektuelle und radikale Linke, eloquent, umtriebig, selbstbewusst und mit kaum zu bremsendem Tatendrang.“"
                            },
                            {
                                "example_id": "c37e99c2-d6b0-436a-ba5e-a40e0738f856",
                                "sense_id": "ef15d641-9199-3dd5-8b27-d848bdb59d9d",
                                "text": "„Obwohl er bestimmt schon Anfang fünfzig war, trug er das Haar so raspelkurz wie ein Rekrut bei den Marines.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
