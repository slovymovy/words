                        ],
                        "examples": [
                            {
                                "example_id": "6833c3d7-55bc-44cd-b85a-30765c7f03a4",
                                "sense_id": "fd22e609-71e1-35ef-aa18-e3d5e5f3bae2",
                                "text": "W Chinach nie ustają prześladowania tak zwanego „Kościoła katakumbowego”."
                            },
                            {
                                "example_id": "13acf444-dcad-4bfd-af9f-39f9c880c52f",
                                "sense_id": "fd22e609-71e1-35ef-aa18-e3d5e5f3bae2",
                                "text": "Wydarzenie to kończy też „katakumbowy” okres polskiego jazzu."
                            }
                        ],
