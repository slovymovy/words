                "senses": [
                    {
                        "sense_id": "9f8b58e9-c090-3976-b1c7-fda87fce8609",
                        "entry_id": "d20728f0-9b57-3f5e-b74a-7542914f5958",
                        "glosses": [
                            "To divest of a frock."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c08f72e0-c680-3941-87a2-7861258d834c",
                        "entry_id": "d20728f0-9b57-3f5e-b74a-7542914f5958",
                        "glosses": [
                            "To formally remove the rights and authority of a member of the clergy."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "de9c7e6e-2c1c-4cd8-8524-c6afa03d9833",
                                "sense_id": "c08f72e0-c680-3941-87a2-7861258d834c",
                                "text": "The defrocked priest may no longer perform rites."
                            },
                            {
                                "example_id": "3b35b690-d16a-4418-8510-3c266e75fffe",
                                "sense_id": "c08f72e0-c680-3941-87a2-7861258d834c",
                                "text": "The Vatican has defrocked the anti-abortion US priest Frank Pavone for what it said were “blasphemous communications on social media” as well as “persistent disobedience” of his bishop."
                            }
                        ]
                    },
                    {
                        "sense_id": "751e2568-a8b1-37a8-9a85-585fdf3dc64a",
                        "entry_id": "d20728f0-9b57-3f5e-b74a-7542914f5958",
                        "glosses": [
                            "To formally remove the rights and authority of someone, e.g. a government official or a medical practitioner."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a4ceb50f-cec6-4d3a-8438-2f9d0cde3266",
                                "sense_id": "751e2568-a8b1-37a8-9a85-585fdf3dc64a",
                                "text": "There are refugees and black marketers, defrocked bankers and resistance fighters, gamblers, floozies, French colonial policemen, American and Spanish entertainers, and, eventually, Nazi officers (who in reality never set foot in Casablanca)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71863a46-01e0-467b-995c-f203cb770609",
                        "source_entry_id": "d20728f0-9b57-3f5e-b74a-7542914f5958",
                        "source_sense_description": "remove the rights of a member of clergy",
                        "target_lang_word": "défroquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défroquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd40f8b-d7d5-36c9-9ff4-544b28b50803",
                                        "entry_id": "bf679168-cade-348f-bf94-c8d84c6b53e0",
                                        "glosses": [
                                            "Quitter ou faire quitter l’état monastique ou l’état ecclésiastique, en parlant d’un religieux ou un ecclésiastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b11d8b42-aa46-4dcf-bc8f-752706c066c9",
                                                "sense_id": "fdd40f8b-d7d5-36c9-9ff4-544b28b50803",
                                                "text": "Cependant, mon excellent frère, je crois que pour ton bien et celui de l’Église, je devrais te défroquer, en te donnant une place dans notre garde […]."
                                            },
                                            {
                                                "example_id": "5606c754-18c7-4063-9693-810051a68713",
                                                "sense_id": "fdd40f8b-d7d5-36c9-9ff4-544b28b50803",
                                                "text": "Défroquer un prélat est considéré comme le châtiment le plus grave pour un ecclésiastique, déchu de tous ses droits et prérogatives de prêtre, comme celui de dire la messe, y compris en privé."
                                            },
                                            {
                                                "example_id": "a36da07b-cf96-43c2-9500-44a052dbd130",
                                                "sense_id": "fdd40f8b-d7d5-36c9-9ff4-544b28b50803",
                                                "text": "Ce prêtre a défroqué."
                                            },
                                            {
                                                "example_id": "118ccaf5-e83a-4021-b717-c64f8cc4092c",
                                                "sense_id": "fdd40f8b-d7d5-36c9-9ff4-544b28b50803",
                                                "text": "— Ce prêtre s’est défroqué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db690bf8-a682-34af-a8f2-1ef9eaafd84c",
                                        "entry_id": "bf679168-cade-348f-bf94-c8d84c6b53e0",
                                        "glosses": [
                                            "Abandonner ses convictions, son engagement."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c494bb54-a93c-49d3-b953-8bebbabc64ae",
                                                "sense_id": "db690bf8-a682-34af-a8f2-1ef9eaafd84c",
                                                "text": "Il n’avait jamais pu se défroquer et rejeter son habit poussiéreux d’honnête homme vermoulu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1780c149-42fe-3b1d-9d88-309a9bb6c250",
                                        "entry_id": "bf679168-cade-348f-bf94-c8d84c6b53e0",
                                        "glosses": [
                                            "Dépouiller quelqu’un de son argent, de ses biens."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9d5e7ee-21dd-39af-a3d1-40be2da3a6f9",
                                        "entry_id": "bf679168-cade-348f-bf94-c8d84c6b53e0",
                                        "glosses": [
                                            "Ôter sa culotte ou son pantalon."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pronominal"
                                        ],
                                        "examples": []
                                    },
