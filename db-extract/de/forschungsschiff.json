                "senses": [
                    {
                        "sense_id": "17ea1778-e8ed-3ad2-a46b-8b04b5dba7cb",
                        "entry_id": "82e492d7-0d75-32f2-983d-5f547cd3b85e",
                        "glosses": [
                            "Schiff, das für Forschungszwecke eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e4024a5-56f9-427e-8e69-02f914d5aff0",
                                "sense_id": "17ea1778-e8ed-3ad2-a46b-8b04b5dba7cb",
                                "text": "Forschungsschiffe werden unter anderem für Meeres- und Klimaforschung eingesetzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26ea5463-0ddb-45ec-8c33-2139ab0cfbaf",
                        "source_entry_id": "82e492d7-0d75-32f2-983d-5f547cd3b85e",
                        "source_sense_id": "17ea1778-e8ed-3ad2-a46b-8b04b5dba7cb",
                        "source_sense_description": "Schiff, das für Forschungszwecke eingesetzt wird",
                        "target_lang_word": "research ship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "research ship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efc4a62f-0243-389f-9f42-db5aefd8dbb9",
                                        "entry_id": "e1db5ae6-4f99-3096-8e2f-88ef9ef8564e",
                                        "glosses": [
                                            "A ship that is designed and used for research."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f545f17e-10c8-4a16-a69a-dd59711251b2",
                                                "sense_id": "efc4a62f-0243-389f-9f42-db5aefd8dbb9",
                                                "text": "Eight stations were occupied by the researchship Ryofu-Maru along the 30° N-line which crossed the Japan Trench at the vicinity of Ramapo Deep, during the period from May 12 to June 20."
                                            },
                                            {
                                                "example_id": "cf9636c3-1acb-46b5-9ed0-2e54afe2bf40",
                                                "sense_id": "efc4a62f-0243-389f-9f42-db5aefd8dbb9",
                                                "text": "Experience also shows that a research ship spends from one quarter to one half of her sea time on scientific station when the sustained speed seldom exceeds 3.5 knots."
                                            },
                                            {
                                                "example_id": "30bcf128-c261-4819-8164-09fbde9b4e2a",
                                                "sense_id": "efc4a62f-0243-389f-9f42-db5aefd8dbb9",
                                                "text": "On the new scientific researchship everything is aimed at subjecting the sea to the will of man and making ships even more reliable and comfortable, and more inhabitable, as the specialists say."
                                            },
                                            {
                                                "example_id": "5a80724c-0451-4fee-90a4-192282b43f4b",
                                                "sense_id": "efc4a62f-0243-389f-9f42-db5aefd8dbb9",
                                                "text": "The US research ship Glomar Challenge has conducted successful drilling experiments at a depth of 5,000 metres."
                                            },
                                            {
                                                "example_id": "139ccfc7-1e66-446c-816e-3dfeca87b877",
                                                "sense_id": "efc4a62f-0243-389f-9f42-db5aefd8dbb9",
                                                "text": "This brings to my mind the important statement which Henry [Bryant] Bigelow made when he was asked by Rockefeller foundation authorities, \"What would you like to have first, a building or a researchship\", and his prompt answer was \"a ship\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
