                "senses": [
                    {
                        "sense_id": "c0c43f8d-6fe7-3c06-9ba5-d0cbc1debd02",
                        "entry_id": "01c8df44-2bc4-3850-96d2-cb6644b48628",
                        "glosses": [
                            "относящийся к санитарии, связанный с её применением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "156303d4-0142-48a8-8c7c-dec84c93ca0d",
                                "sense_id": "c0c43f8d-6fe7-3c06-9ba5-d0cbc1debd02",
                                "text": "Усилился санитарный контроль за состоянием мест общего пользования, особенно за кухнями и источниками воды."
                            }
                        ]
                    },
                    {
                        "sense_id": "83da1227-0535-3ec5-a8e0-ce87d2d23a47",
                        "entry_id": "01c8df44-2bc4-3850-96d2-cb6644b48628",
                        "glosses": [
                            "удовлетворяющий требованиям санитарии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff4dee3-a1a4-43fc-8091-4ab6690a9aee",
                                "sense_id": "83da1227-0535-3ec5-a8e0-ce87d2d23a47",
                                "text": "Чем хуже санитарное состояние города или поселка, тем больше в нем москитов."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f372594-b842-300c-b75c-a090cdb1a537",
                        "entry_id": "01c8df44-2bc4-3850-96d2-cb6644b48628",
                        "glosses": [
                            "относящийся к медицинской службе, как правило в армии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaad3182-4337-4edd-9722-cd0cb3614074",
                                "sense_id": "9f372594-b842-300c-b75c-a090cdb1a537",
                                "text": "Но все было чисто, и меня отправили к санитарному поезду."
                            }
                        ]
                    }
