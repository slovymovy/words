                "senses": [
                    {
                        "sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
                        "entry_id": "b289de50-09b6-3f5e-83da-ea01cece04b3",
                        "glosses": [
                            "Messgerät, das den Druck in Flüssigkeiten oder Gasen misst"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "69bd4123-efcb-4b93-816f-5fb0a70de5d4",
                                "sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
                                "text": "Das Manometer wird über dem Quecksilberspiegel in das Membrangefäß gehängt und dieses dann oben mit einem Deckel fest verschlossen."
                            },
                            {
                                "example_id": "dcce6b70-6a2f-4218-959b-cd61b27ab92f",
                                "sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
                                "text": "„Die Tauchtiefe sollte über ein Manometer angezeigt werden.“"
                            },
                            {
                                "example_id": "11bf0dcd-7132-48a9-88ed-c84400399744",
                                "sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
                                "text": "„Der Zeiger auf dem Manometer ist der größte Feind des Heizers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ebd8a15-af62-40a9-aaa9-4850bb442881",
                        "source_entry_id": "b289de50-09b6-3f5e-83da-ea01cece04b3",
                        "source_sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
