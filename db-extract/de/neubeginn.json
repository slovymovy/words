                        "source_sense_id": "7f0c1493-9a6a-3af5-a5c6-0c3182ab79c4",
                        "source_sense_description": "erneuter Beginn einer Sache, die beendet oder unterbrochen wurde",
                        "target_lang_word": "fresh start",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fresh start",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dae6a64-41ba-30c5-9053-94bf3c71a760",
                                        "entry_id": "a03f94e0-fd11-352d-b1b2-92e74e83c8a7",
                                        "glosses": [
                                            "A new beginning, without prejudices."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e240f70-4247-4ef7-8d4f-c9fd64d175c4",
                                                "sense_id": "0dae6a64-41ba-30c5-9053-94bf3c71a760",
                                                "text": "After the past disputes between the two countries, both sides decided to make a fresh start by agreeing to trade with each other again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cefc3f17-817e-495b-98a7-aaed07388f78",
                        "source_entry_id": "50bfb121-95a4-3d45-a3a1-bcb1c34fa475",
                        "source_sense_id": "7f0c1493-9a6a-3af5-a5c6-0c3182ab79c4",
