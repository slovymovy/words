{
    "word_family": [
        "kruis",
        "kruisen",
        "doorkruising"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c79a5783-54af-36be-9142-68c9a4875efa",
                    "sense_definition": "Een streep of kruis zetten door een tekst of vakje om het te schrappen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schrappen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je een fout maakt, moet je het foute antwoord <w>doorkruisen</w>.",
                            "target_lang_translations": {
                                "fr": "Si vous faites une erreur, vous devez <w>biffer</w> la mauvaise réponse."
                            }
                        },
                        {
                            "text": "Hij <w>kruiste</w> de verkeerde naam op de lijst <w>door</w>.",
                            "target_lang_translations": {
                                "fr": "Il a <w>rayé</w> le mauvais nom sur la liste."
                            }
                        }
                    ],
                    "synonyms": [
                        "schrappen",
                        "doorhalen"
                    ],
                    "common_phrases": [
                        "een vakje doorkruisen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Tracer une ligne ou une croix sur un texte ou une case pour l'effacer ou l'annuler."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "biffer",
                                "target_lang_sense_clarification": "d'un texte ou d'un mot"
                            },
                            {
                                "target_lang_word": "rayer",
                                "target_lang_sense_clarification": "d'un mot ou d'une liste"
                            },
                            {
                                "target_lang_word": "cocher d'une croix",
                                "target_lang_sense_clarification": "pour annuler ou sélectionner"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65bda347-e9ce-344b-a85d-1313ccf26591",
                    "sense_definition": "Reizen door een heel gebied of er dwars doorheen gaan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reizen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>doorkruisten</w> het hele land op hun fietsen.",
                            "target_lang_translations": {
                                "fr": "Ils ont <w>sillonné</w> tout le pays sur leurs vélos."
                            }
                        },
                        {
                            "text": "We willen tijdens onze vakantie het woestijngebied <w>doorkruisen</w>.",
                            "target_lang_translations": {
                                "fr": "Nous voulons <w>traverser</w> la zone désertique pendant nos vacances."
                            }
                        }
                    ],
                    "synonyms": [
                        "bereizen",
                        "doorkruisen"
                    ],
                    "common_phrases": [
                        "het land doorkruisen",
                        "een gebied doorkruisen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Voyager à travers toute une région ou la traverser de part en part."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sillonner",
                                "target_lang_sense_clarification": "un pays, une région"
                            },
                            {
                                "target_lang_word": "traverser",
                                "target_lang_sense_clarification": "un territoire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db7fdbfe-1e21-38ca-909a-3e7a307ad194",
                    "sense_definition": "Plannen of verwachtingen van iemand anders verstoren of tegenwerken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verstoren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het slechte weer <w>doorkruiste</w> al onze vakantieplannen.",
                            "target_lang_translations": {
                                "fr": "Le mauvais temps a <w>contrarié</w> tous nos projets de vacances."
                            }
                        },
                        {
                            "text": "Deze onverwachte beslissing kan de plannen van de organisatie <w>doorkruisen</w>.",
                            "target_lang_translations": {
                                "fr": "Cette décision inattendue peut <w>faire échouer</w> les plans de l'organisation."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwarsbomen",
                        "verhinderen",
                        "verstoren"
                    ],
                    "antonyms": [
                        "ondersteunen",
                        "bevorderen"
                    ],
                    "common_phrases": [
                        "plannen doorkruisen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Perturber ou contrecarrer les plans ou les attentes de quelqu'un d'autre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "contrarier",
                                "target_lang_sense_clarification": "des plans ou des projets"
                            },
                            {
                                "target_lang_word": "traverser",
                                "target_lang_sense_clarification": "contrecarrer des intentions"
                            },
                            {
                                "target_lang_word": "faire échouer",
                                "target_lang_sense_clarification": "des plans"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}