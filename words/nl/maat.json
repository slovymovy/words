                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit bedrijf levert meubels die volledig op <w>maat</w> zijn gemaakt.",
                            "target_lang_translations": {
                                "en": "This company supplies furniture that is made entirely to <w>measure</w>.",
