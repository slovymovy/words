                                "example_id": "4d9a5277-b993-471f-92e0-0feb20c37ff3",
                                "sense_id": "e533e770-eb88-357c-a1b9-f04acb448357",
                                "text": "Your brights are on."
                            },
                            {
                                "example_id": "86731a08-3b25-4f74-8277-9f9fa44e813f",
                                "sense_id": "e533e770-eb88-357c-a1b9-f04acb448357",
                                "text": "Drop your brights as soon as approaching lights appear."
                            },
                            {
                                "example_id": "48940c1d-2a4e-4a3a-b3ec-3e68fbc8119c",
                                "sense_id": "e533e770-eb88-357c-a1b9-f04acb448357",
                                "text": "You can turn your brights on and that helps quite a bit, but you can not leave them on. So you end up driving beyond your headlights more than half the time."
                            },
                            {
                                "example_id": "bd7f9728-2017-4917-a841-7da9374ef917",
                                "sense_id": "e533e770-eb88-357c-a1b9-f04acb448357",
                                "text": "The moment I flashed my brights this animal started to run across the road."
                            }
                        ]
