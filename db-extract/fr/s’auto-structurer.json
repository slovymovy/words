                        "glosses": [
                            "Se structurer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac36080-08fd-4703-89ac-4f627cbd493c",
                                "sense_id": "2bdd11c1-1bb7-3fb4-b157-e60b36e2dfe8",
                                "text": "Rappelons que le vivant a pour exigence de se relier, de s'auto-organiser et de s'auto-structurer."
                            },
                            {
                                "example_id": "ae41deef-ccb9-4e0d-bb28-7033a9fdf683",
                                "sense_id": "2bdd11c1-1bb7-3fb4-b157-e60b36e2dfe8",
                                "text": "Apte à s'auto-structurer que ce soit sur l'aspect gestion du temps (agenda, perspective des priorités, temps personnel, etc.), gestion de l'aire de travail..."
                            },
                            {
                                "example_id": "c5f3d9ef-5b44-4e74-bc9c-c5087465f0b4",
                                "sense_id": "2bdd11c1-1bb7-3fb4-b157-e60b36e2dfe8",
                                "text": "Les foldamères sont considérés comme étant des oligomères capables de s'auto-structurer en solution par le biais de liaisons non covalentes."
