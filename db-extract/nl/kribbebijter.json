                    {
                        "translation_id": "9a2f25e9-8c72-4595-b06a-4a4a8d835457",
                        "source_entry_id": "873351c4-bd4f-399f-8821-8375f39b1c0f",
                        "source_sense_id": "527d14d5-22e8-33c8-ba2f-e74dae3abaa1",
                        "source_sense_description": "chagrijnig met iedereen overhoop liggend persoon",
                        "target_lang_word": "grumbler",
