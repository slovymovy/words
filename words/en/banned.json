                        "prohibited",
                        "illegal",
                        "outlawed",
                        "barred",
                        "restricted"
                    ],
                    "antonyms": [
                        "allowed",
                        "permitted",
                        "legal"
                    ],
                    "common_phrases": [
                        "banned substance",
                        "banned book",
                        "banned list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запрещённый; не разрешённый законом или правилами.",
                        "zh": "被禁止的；不被允许的。"
                    },
                    "translations": {
                        "ru": [
                            {
