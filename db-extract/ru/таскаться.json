                ],
                "senses": [
                    {
                        "sense_id": "a3497258-6ce3-3af2-ad8c-7ce682e9e973",
                        "entry_id": "a2473640-ef0f-32a3-b0ac-8feb88b2ef60",
                        "glosses": [
                            "to drag oneself (to a place)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "20579fec-4525-4fca-9693-b051b8416f5f",
                                "sense_id": "a3497258-6ce3-3af2-ad8c-7ce682e9e973",
                                "text": "не хо́чется таска́ться так далеко́",
                                "translation": "I don't feel like making such long trips",
                                "english": "I don't feel like making such long trips"
                            },
                            {
                                "example_id": "a7ebb5f4-b188-49ee-bb7b-86d3bbe1c2e1",
                                "sense_id": "a3497258-6ce3-3af2-ad8c-7ce682e9e973",
                                "text": "ей прихо́дится таска́ться на рабо́ту в перепо́лненной электри́чке",
                                "translation": "she has to take a tough ride in a packed commuter train to get to her office [place of work]",
                                "english": "she has to take a tough ride in a packed commuter train to get to her office [place of work]"
                            },
                            {
                                "example_id": "46b4ce86-57e6-49b5-8acb-1dd599382d6a",
                                "sense_id": "a3497258-6ce3-3af2-ad8c-7ce682e9e973",
                                "text": "и заче́м ты туда́ таска́ешься так ча́сто?",
                                "translation": "what's the big need for you to go there so often?",
                                "english": "what's the big need for you to go there so often?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e6e53a57-a9d8-333c-a34d-dab5d507dc68",
                        "entry_id": "a2473640-ef0f-32a3-b0ac-8feb88b2ef60",
                        "glosses": [
                            "to carry about, to carry along"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d405af88-d426-4323-b774-9dbd24072930",
                                "sense_id": "e6e53a57-a9d8-333c-a34d-dab5d507dc68",
                                "text": "он всегда́ таска́ется с э́той су́мкой",
                                "translation": "he always carries this bag along; he never goes out without this bag",
                                "english": "he always carries this bag along; he never goes out without this bag"
                            }
                        ]
                    },
                    {
                        "sense_id": "1183b06e-2a79-3226-be83-19ce5dc7b891",
                        "entry_id": "a2473640-ef0f-32a3-b0ac-8feb88b2ef60",
                        "glosses": [
                            "to gad about, to hang about"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4b7cd368-8bc9-4de9-b853-ab873279fdec",
                                "sense_id": "1183b06e-2a79-3226-be83-19ce5dc7b891",
                                "text": "таска́ться по ба́рам",
                                "translation": "gad about bars; barhop",
                                "english": "gad about bars; barhop"
                            }
                        ]
                    },
                    {
                        "sense_id": "1f132812-1b1d-3fe6-a3e2-97753e355484",
                        "entry_id": "a2473640-ef0f-32a3-b0ac-8feb88b2ef60",
                        "glosses": [
                            "to follow, to trail along"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7143c139-0a42-4a2c-b33b-58cfb896dcee",
                                "sense_id": "1f132812-1b1d-3fe6-a3e2-97753e355484",
                                "text": "он всё вре́мя таска́ется за ма́терью",
                                "translation": "he always follows [trails along behind] his mother",
                                "english": "he always follows [trails along behind] his mother"
                            }
                        ]
                    },
