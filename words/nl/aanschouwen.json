    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91ed1e28-fe24-3140-b168-276e3420c67b",
                    "sense_definition": "iets of iemand met aandacht bekijken of waarnemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waarnemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>aanschouwde</w> zichzelf en zijn vrouw in de grote spiegel.",
                            "target_lang_translations": {
                                "en": "He <w>beheld</w> himself and his wife in the large mirror."
                            }
                        },
                        {
                            "text": "Hij had in de loop der jaren honderden van dit soort kinderachtige spelletjes moeten <w>aanschouwen</w>.",
                            "target_lang_translations": {
                                "en": "Over the years, he had had to <w>witness</w> hundreds of these kinds of childish games."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanzien",
                        "bekijken",
                        "in ogenschouw nemen"
                    ],
                    "common_phrases": [
                        "met eigen ogen aanschouwen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal tone"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To look at or observe something or someone with attention, often in a formal or literary context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "behold",
                                "target_lang_sense_clarification": "to look at or observe something impressive or significant"
                            },
                            {
                                "target_lang_word": "witness",
                                "target_lang_sense_clarification": "to see an event or situation happen"
                            },
                            {
                                "target_lang_word": "gaze upon",
                                "target_lang_sense_clarification": "to look steadily and intently at something"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "to look at or inspect something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4abfe06-2644-3956-a91d-fcc3e7bca39a",
                    "sense_definition": "gebruikt in de vaste verbinding ten <w>aanschouwen</w> van om aan te geven dat iets gebeurt in de aanwezigheid of het zicht van anderen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aanwezigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ceremonie vond plaats ten <w>aanschouwen</w> van de verzamelde menigte.",
                            "target_lang_translations": {
                                "en": "The ceremony took place <w>in the sight of</w> the gathered crowd."
                            }
                        },
                        {
                            "text": "Hij werd ten <w>aanschouwen</w> van al zijn collega's geprezen voor zijn inzet.",
                            "target_lang_translations": {
                                "en": "He was praised for his efforts <w>before the eyes of</w> all his colleagues."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ten aanschouwen van"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal and fixed expression"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used in the fixed expression 'ten aanschouwen van' to indicate that something happens in the presence or sight of others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in the sight of",
                                "target_lang_sense_clarification": "happening where others can see"
                            },
                            {
                                "target_lang_word": "before the eyes of",
                                "target_lang_sense_clarification": "happening directly in front of people"
                            },
                            {
                                "target_lang_word": "in the presence of",
                                "target_lang_sense_clarification": "happening while others are there"
                            }
                        ]
                    }
                }
            ]
        }
    ]
