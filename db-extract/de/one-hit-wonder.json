                        "glosses": [
                            "etwas oder jemand, das/der nur einmal Erfolg hatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743e1081-38b9-406e-8ca2-ad4d19d161f1",
                                "sense_id": "79160105-5843-30f9-9f8e-95598c642b7e",
                                "text": "„Vor Abba war es landesfremden Musikern noch nie gelungen, sich in den USA und Großbritannien dauerhaft in den Charts zu behaupten, also über den Status der belächelten One-Hit-Wonder hinaus zu kommen.“"
                            }
                        ],
