                    },
                    {
                        "sense_id": "b1b2227a-c9db-37b3-88d7-d7dcdf67088f",
                        "entry_id": "1e36b664-3db3-3db3-aea5-a04c07fc333a",
                        "glosses": [
                            "Having lost property revenue due to Federal presence, such that it may receive impact aid."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "e9aa5074-986c-4bee-a630-8319c7437b6a",
                                "sense_id": "b1b2227a-c9db-37b3-88d7-d7dcdf67088f",
                                "text": "Table A3-1 compares the capabilities of (1) impacted communities and school districts to finance capital improvements from their own resources […]"
                            },
                            {
                                "example_id": "2baafde1-89f6-4b04-a16a-934b65e1a890",
                                "sense_id": "b1b2227a-c9db-37b3-88d7-d7dcdf67088f",
                                "text": "Like many of my colleagues, I represent one of the most highly impacted schools in the Nation. This school relies on the impact aid program."
                            }
                        ]
                    }
