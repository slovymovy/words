                    "frequency": "High",
                    "semantic_group_id": "sachverhalt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unter diesen <w>Umständen</w> können wir den ursprünglichen Zeitplan leider nicht einhalten."
                        },
                        {
                            "text": "Der <w>Umstand</w>, dass niemand zu Hause war, verhinderte Schlimmeres."
                        }
                    ],
                    "synonyms": [
                        "Situation",
                        "Sachverhalt",
                        "Tatsache",
                        "Bedingung"
                    ],
                    "common_phrases": [
