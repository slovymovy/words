                                        "glosses": [
                                            "To perform the role of a host."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b7d70b-67a8-46c6-aa77-9769c8b96371",
                                                "sense_id": "e0181291-33fa-3ac9-a632-e5775a7c29ec",
                                                "text": "Our company will host the annual conference this year."
                                            },
                                            {
                                                "example_id": "5b3ce53c-6305-4b3c-9790-4a9e67b6a97d",
                                                "sense_id": "e0181291-33fa-3ac9-a632-e5775a7c29ec",
                                                "text": "I was terrible at hosting that show."
                                            },
                                            {
                                                "example_id": "50766457-9768-4f33-9483-90ff1860b087",
                                                "sense_id": "e0181291-33fa-3ac9-a632-e5775a7c29ec",
                                                "text": "I’ll be hosting tonight. I hope I’m not terrible."
                                            },
                                            {
                                                "example_id": "64505183-c1e9-4da4-b21f-d1f3f1c76588",
                                                "sense_id": "e0181291-33fa-3ac9-a632-e5775a7c29ec",
                                                "text": "I am quite impressed with the December 10th issue in which it hosted the article by Nancy Langer, \"Different Abilities, the Same Queer Pleasures.\""
                                            },
                                            {
                                                "example_id": "55322f3e-d093-4276-9bc8-d5378c0cc699",
                                                "sense_id": "e0181291-33fa-3ac9-a632-e5775a7c29ec",
                                                "text": "Bats host many high-profile viruses that can infect humans, including severe acute respiratory syndrome and Ebola."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4996782b-381d-32e2-a758-ac2b08ddd73c",
                                        "entry_id": "80a6571a-a9e7-3374-91ee-c5574bbfc521",
                                        "glosses": [
                                            "To lodge at an inn."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc7b329-0c16-4ee0-ad7f-74d974be33fc",
                                                "sense_id": "4996782b-381d-32e2-a758-ac2b08ddd73c",
                                                "text": "Where you shall host."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01dd30e3-72cd-32df-ae46-818ff2b66bf1",
                                        "entry_id": "80a6571a-a9e7-3374-91ee-c5574bbfc521",
                                        "glosses": [
                                            "To run software made available to a remote user or process."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9fee7c3-2374-4fe9-99e0-daca947951e3",
                                                "sense_id": "01dd30e3-72cd-32df-ae46-818ff2b66bf1",
                                                "text": "Kremvax hosts a variety of services."
                                            },
                                            {
                                                "example_id": "3f5d10b8-970f-41a3-a90e-df70761443cb",
                                                "sense_id": "01dd30e3-72cd-32df-ae46-818ff2b66bf1",
                                                "text": "CMU/TEK TCP/IP software uses an excessive amount of cpu resources for terminal support both outbound, when accessing another system, and inbound, when the local system is hosting a session."
                                            }
                                        ]
                                    }
                                ]
                            },
