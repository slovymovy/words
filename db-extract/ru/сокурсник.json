                ],
                "translations": [
                    {
                        "translation_id": "e97fe166-a2de-4dd8-b0cc-c11fcce7dadf",
                        "source_entry_id": "3e8fa0e8-2616-3937-8e5b-dace8287a383",
                        "source_sense_id": "63b1f251-f995-32b0-b289-5b388397ebf2",
                        "target_lang_word": "classmate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "classmate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                        "entry_id": "94684286-9992-3ccd-b86c-4a7e28c8133d",
                                        "glosses": [
                                            "A student who is in the same class at school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50df9526-b9ac-4dfd-9bea-b905bcc02d9d",
                                                "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                                "text": "She was your classmate at the village school from first grade."
                                            },
                                            {
                                                "example_id": "31e0c9a0-b5c7-4f1a-812c-5109b100b6f6",
                                                "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                                "text": "Danny and I have been classmates for five years, but I've never spoken to him outside of lessons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9025b2-4186-35ba-abd4-45e2750b5893",
                                        "entry_id": "94684286-9992-3ccd-b86c-4a7e28c8133d",
                                        "glosses": [
                                            "A member of a different sort of class, such as locomotives etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87374be0-ccde-42a0-90b1-e8ea3b317ca5",
                                                "sense_id": "fa9025b2-4186-35ba-abd4-45e2750b5893",
                                                "text": "The Class 87 is the only main line-certified member of the fleet left in the UK, although there are 21 classmates in use overseas [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49056d52-6c0c-4fe5-b226-b990906b6434",
                        "source_entry_id": "3e8fa0e8-2616-3937-8e5b-dace8287a383",
                        "source_sense_id": "63b1f251-f995-32b0-b289-5b388397ebf2",
                        "target_lang_word": "compañero de curso",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6ea80369-e383-4ded-906e-62792de97ab5",
                        "source_entry_id": "3e8fa0e8-2616-3937-8e5b-dace8287a383",
                        "source_sense_id": "63b1f251-f995-32b0-b289-5b388397ebf2",
                        "target_lang_word": "estudiante del mismo año",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b2579da5-fd22-46fb-a61b-40595e0e66cf",
                        "source_entry_id": "3e8fa0e8-2616-3937-8e5b-dace8287a383",
                        "source_sense_id": "63b1f251-f995-32b0-b289-5b388397ebf2",
                        "target_lang_word": "Kommilitone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommilitone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                        "entry_id": "872d0fa3-f9fc-3571-aa99-8e0fa62ea0f2",
                                        "glosses": [
                                            "Person, mit der man gemeinsam an einer Hochschule studiert (hat)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf2de264-5f70-433b-8c39-d6d32bf4c665",
                                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                                "text": "„Es war normal, dass ich mich ihnen anschloss, da wir keinen Zugang zu den reichen Studenten hatten, der Mehrzahl unserer Kommilitonen.“"
                                            },
                                            {
                                                "example_id": "010dab62-ddd3-4215-a1eb-21817095890e",
                                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                                "text": "„All dies, erklärte mir der Kommilitone geduldig, sei en detail im Mietvertrag festgelegt, sogar der Wochentag der Ausführung: und zwar der Samstag.“"
                                            },
                                            {
                                                "example_id": "4aaede38-e7b3-41dd-911c-d275b3715c5c",
                                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                                "text": "„Nur Csoma hielt das Versprechen - er war schließlich zwanzig Jahre älter als die beiden Kommilitonen, mit denen er es abgelegt hatte.“"
                                            },
                                            {
                                                "example_id": "5f088cdc-77e1-4010-b38a-da56724a91c5",
                                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                                "text": "„Sein Mobiltelefon klingelte, und ein Kommilitone, mit dem Tom gemeinsam promoviert hatte, war am anderen Ende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
