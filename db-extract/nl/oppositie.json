                                        "sense_id": "4053aaf0-e827-35b7-9cbc-dea1740ef346",
                                        "entry_id": "aac7cd82-09fe-3f77-a108-fe26042d575c",
                                        "glosses": [
                                            "Configuración de dos astros que se encuentran, en relación con la Tierra, en dos puntos del cielo diametralmente opuestos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be95cd7-bc55-4239-96e6-864065bbc5b2",
                                                "sense_id": "4053aaf0-e827-35b7-9cbc-dea1740ef346",
                                                "text": "El sol, la tierra y la luna están en oposición."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cae5c5ce-d170-3c4d-921a-6122155feca1",
                                        "entry_id": "aac7cd82-09fe-3f77-a108-fe26042d575c",
                                        "glosses": [
                                            "Partido político o coalición que no tiene el control del poder (y por lo tanto está enfrentada al partido que sí lo tiene) ya sea porque no está en el poder ejecutivo o porque no tiene la mayoría en el poder legislativo."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "494df6ea-926f-4e86-8341-0195c3989370",
                                                "sense_id": "cae5c5ce-d170-3c4d-921a-6122155feca1",
                                                "text": "La oposición volvió a acusar al gobierno de corrupción."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5b89b305-76b4-3560-ab1c-cc65c7906879",
                                        "entry_id": "aac7cd82-09fe-3f77-a108-fe26042d575c",
                                        "glosses": [
                                            "Antagonismo entre dos sectores de la sociedad."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "6669e7c2-c8b7-3874-aac9-5b9a33d09ee3",
                                        "entry_id": "aac7cd82-09fe-3f77-a108-fe26042d575c",
                                        "glosses": [
                                            "Situación que ocurre cuando los reyes están enfrentados y en casillas del mismo color, con una casilla de separación, en donde el jugador que tiene el turno debe ceder el paso al rey del rival."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "487a44b7-796e-3c6c-8701-9ca72a20646a",
                                        "entry_id": "aac7cd82-09fe-3f77-a108-fe26042d575c",
                                        "glosses": [
                                            "Procedimiento de selección de personal, habitual en las instituciones docentes y la administración, que consiste en el enfrentamiento público de dos o más candidatos ante un tribunal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff56ac02-efd9-42d2-b86f-90cd88f97cae",
                                                "sense_id": "487a44b7-796e-3c6c-8701-9ca72a20646a",
                                                "text": "ganó tres años después una beca por oposición en el Colegio Trilingüe."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
