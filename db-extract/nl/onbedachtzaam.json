                "senses": [
                    {
                        "sense_id": "bac8c259-418d-378e-b3bc-2002bc57800f",
                        "entry_id": "cb4f8fd3-9e89-314b-8c55-027cb6db1519",
                        "glosses": [
                            "van een persoon dat deze niet goed nadenkt voordat hij wat doet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c97a2aa-64c4-42cb-bb0a-1c2a3b350bcd",
                                "sense_id": "bac8c259-418d-378e-b3bc-2002bc57800f",
                                "text": "Zijn leven had ook veel nieuwe woorden opgeleverd die ik ruim voor mijn achttiende al geïnternaliseerd had: recalcitrant, onbedachtzaam, onuitstaanbaar."
                            },
                            {
                                "example_id": "96ed4ca3-b051-4f84-8729-e82f2f7c0d15",
                                "sense_id": "bac8c259-418d-378e-b3bc-2002bc57800f",
                                "text": "De vier zouden twee jaar geleden op een huisfeest voor tienduizenden euro's aan waardevolle spullen hebben meegenomen. Ook is de dochter van de eigenaar van het huis gefilmd terwijl ze seks had met Dave Roelvink, de zoon van zanger Dries Roelvink. Volgens het OM hebben de verdachten het vertrouwen van een \"verliefd en onbedachtzaam\" meisje ernstig geschonden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e738cca-9d8c-4465-bbe5-512d19a7a99e",
                        "source_entry_id": "cb4f8fd3-9e89-314b-8c55-027cb6db1519",
                        "source_sense_id": "bac8c259-418d-378e-b3bc-2002bc57800f",
                        "target_lang_word": "without thinking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2c8f8c8c-3e37-4222-b2cd-8cbc637a4f7d",
                        "source_entry_id": "cb4f8fd3-9e89-314b-8c55-027cb6db1519",
                        "source_sense_id": "bac8c259-418d-378e-b3bc-2002bc57800f",
                        "target_lang_word": "inconsiderate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsiderate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "212394d6-e2db-304a-9092-7152aff2ce12",
                                        "entry_id": "438b829f-9b83-3640-ab44-27401726dc71",
                                        "glosses": [
                                            "Not considerate of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b92e5a8b-b5c3-418f-8c3e-0edeadd36860",
                                                "sense_id": "212394d6-e2db-304a-9092-7152aff2ce12",
                                                "text": "Not replacing the roll after using the last of the toilet paper is very inconsiderate."
                                            },
                                            {
                                                "example_id": "a66e34e4-7ddf-47ce-bde7-31b32a4498ff",
                                                "sense_id": "212394d6-e2db-304a-9092-7152aff2ce12",
                                                "text": "“It’s very inconsiderate of you, St. Clare,” said the lady, “to insist on my talking and looking at things. You know I’ve been lying all day with the sick-headache; and there’s been such a tumult made ever since you came, I’m half dead.”"
                                            },
                                            {
                                                "example_id": "f5529882-8849-4529-9362-33589205668b",
                                                "sense_id": "212394d6-e2db-304a-9092-7152aff2ce12",
                                                "text": "Bayliss and his father were talking together before dinner when Claude came in and was so inconsiderate as to put up a window, though he knew his brother hated a draft."
                                            },
                                            {
                                                "example_id": "bae6fc7c-de21-4483-92f3-2bee4dcfe58b",
                                                "sense_id": "212394d6-e2db-304a-9092-7152aff2ce12",
                                                "text": "“Ann Landers claims drop-in visits are inconsiderate,” he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a87134f-7564-3b69-9d89-3365397dd856",
                                        "entry_id": "438b829f-9b83-3640-ab44-27401726dc71",
                                        "glosses": [
                                            "Not giving enough consideration to one's actions, conclusions, etc.; acting too quickly without considering the risks and consequences."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3121071c-d056-4876-a6fb-5fa14f8fe1cd",
                                                "sense_id": "7a87134f-7564-3b69-9d89-3365397dd856",
                                                "text": "And all the unsettled humours of the land,\nRash, inconsiderate, fiery voluntaries, […]\nHave sold their fortunes at their native homes,\nBearing their birthrights proudly on their backs,\nTo make hazard of new fortunes here:"
                                            },
                                            {
                                                "example_id": "41543d9c-3199-4895-930e-042c7d3cb252",
                                                "sense_id": "7a87134f-7564-3b69-9d89-3365397dd856",
                                                "text": "[…] the wise and considerate Men of the World, by a right and careful employment of their Thoughts, and Reason, attained true Notions in this, as well as other things; whilst the lazy and inconsiderate part of Men, making the far greater number, took up their Notions, by chance, from common Tradition, and vulgar Conceptions, without much beating their heads about them."
                                            },
                                            {
                                                "example_id": "21baf896-f11e-4b80-ac5c-c0797b38c2e8",
                                                "sense_id": "7a87134f-7564-3b69-9d89-3365397dd856",
                                                "text": "They Pray with Fervour and a fix’d, Attention, never turning like too many Inconsiderate Christians in our Noisy Churches, to behold what People pass behind them;"
                                            },
                                            {
                                                "example_id": "0743ba0d-145e-4280-95e6-05a65e4b6184",
                                                "sense_id": "7a87134f-7564-3b69-9d89-3365397dd856",
                                                "text": "[…] the most danger is from those inconsiderate and unexperienced pilots, who think a ship may be managed and conducted with equal ease and safety among shoals, as their own small vessels to which they have been accustomed,"
                                            },
                                            {
                                                "example_id": "66b64bd4-0066-4ca3-9e24-c08bdebf59cd",
                                                "sense_id": "7a87134f-7564-3b69-9d89-3365397dd856",
                                                "text": "[…] Mr. Elton might not be of an imprudent, inconsiderate disposition as to money-matters; he might naturally be rather attentive than otherwise to them;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128e4474-c310-3080-a863-f6b12c7f9e28",
                                        "entry_id": "438b829f-9b83-3640-ab44-27401726dc71",
                                        "glosses": [
                                            "Resulting from insufficient consideration."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a3f7055-b474-4b80-b548-783c9c14cc1e",
                                                "sense_id": "128e4474-c310-3080-a863-f6b12c7f9e28",
                                                "text": "I am ouer-ready to pardon young ouersights, and forgiue inconsiderate offences:"
                                            },
                                            {
                                                "example_id": "76785996-515f-4564-a3fe-f5631e18e0b4",
                                                "sense_id": "128e4474-c310-3080-a863-f6b12c7f9e28",
                                                "text": "And having given us this inconsiderate Description of Cold, they [the Classick Authors] commonly take leave of the subject, as if it deserved no further handling, then could be afforded it in a few Lines,"
                                            },
                                            {
                                                "example_id": "9be701f5-ed8e-46b4-9d0f-ad733545e5e9",
                                                "sense_id": "128e4474-c310-3080-a863-f6b12c7f9e28",
                                                "text": "[…] to such a choice are many worthy women betrayed, by that false and inconsiderate notion, raised and propagated, no doubt, by the author of all delusion, That a reformed Rake makes the best husband."
                                            },
                                            {
                                                "example_id": "f729703d-3f98-4e4d-8aa3-255ccb21b2a2",
                                                "sense_id": "128e4474-c310-3080-a863-f6b12c7f9e28",
                                                "text": "Do me not the injustice to imagine I now require any particulars to convince me of your innocence, and of my own inconsiderate conclusions."
                                            },
                                            {
                                                "example_id": "a9eff513-62a2-48fd-b71b-f4d1f6b022d1",
                                                "sense_id": "128e4474-c310-3080-a863-f6b12c7f9e28",
                                                "text": "Charlotte Stanhope did not in the least conceive that her new friend was a woman whom nothing could entrap into an inconsiderate marriage […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5d64942-41e5-3ed4-b175-299714ab78a9",
                                        "entry_id": "438b829f-9b83-3640-ab44-27401726dc71",
                                        "glosses": [
                                            "Of too little value to be considered."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f6328cb-4abd-4d0a-8c52-30044bb5c910",
                                                "sense_id": "a5d64942-41e5-3ed4-b175-299714ab78a9",
                                                "text": "[…] when they had sold any one of their bullooks to us, for a little inconsiderate peece of brasse, if we did not presently knock him down, they would by the same call, make the poor creature break from us and run unto them again, and then there was no getting them out of their hands, but by giving them more brasse,"
                                            },
                                            {
                                                "example_id": "6316166a-3533-400b-80f6-23a263116c62",
                                                "sense_id": "a5d64942-41e5-3ed4-b175-299714ab78a9",
                                                "text": "[…] to wrest the Law to our convenience\nIs no small, inconsiderate Work?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eae7066-91db-4149-b9db-724c96920735",
                        "source_entry_id": "cb4f8fd3-9e89-314b-8c55-027cb6db1519",
                        "source_sense_id": "bac8c259-418d-378e-b3bc-2002bc57800f",
                        "target_lang_word": "imprudent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprudent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9f0fb56-e19f-33bc-b7a9-9c5baf7c95ac",
                                        "entry_id": "b26b9a58-2551-3310-8cab-62c1cf2a6f2b",
                                        "glosses": [
                                            "Not prudent; lacking prudence or discretion; indiscreet; injudicious; not paying attention to the consequences of one's actions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25cfcfe-67fe-4412-8371-b54b708114d8",
                                                "sense_id": "a9f0fb56-e19f-33bc-b7a9-9c5baf7c95ac",
                                                "text": "Here Her Majesty took a great dislike at the imprudent behavior of many of the Ministers and Readers."
                                            },
                                            {
                                                "example_id": "1f2c783a-ddb2-42ea-8828-1cee36574124",
                                                "sense_id": "a9f0fb56-e19f-33bc-b7a9-9c5baf7c95ac",
                                                "text": "‘It was a most 'imprudent thing to go up Helvellyn in such weather,’ said Fräulein Müller, shaking her head gloomily as she ate her fish."
                                            },
                                            {
                                                "example_id": "9ad391c7-a75e-4d2e-bf11-f80a35fa1676",
                                                "sense_id": "a9f0fb56-e19f-33bc-b7a9-9c5baf7c95ac",
                                                "text": "My uncle, falling back into his absorbing contemplations, had already forgotten my imprudent words. I merely say imprudent, for the great mind of so learned a man of course had no place for love affairs, and happily the grand business of the document gained me the victory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cf13734-d3d4-4822-91a3-72daa116a969",
                        "source_entry_id": "cb4f8fd3-9e89-314b-8c55-027cb6db1519",
                        "source_sense_id": "bac8c259-418d-378e-b3bc-2002bc57800f",
                        "target_lang_word": "careless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "careless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c64680f-c854-3035-9a7a-30195d187813",
                                        "entry_id": "c68a0d26-fe4b-36a4-bc71-584830ca406e",
                                        "glosses": [
                                            "Not concerned or worried (about)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5adb710d-4112-43f4-9040-c7515f26523b",
                                                "sense_id": "3c64680f-c854-3035-9a7a-30195d187813",
                                                "text": "\"He was here,\" observed Drina composedly, \"and father was angry with him.\"\n\"What?\" exclaimed Eileen. \"When?\"\n\"This morning, before father went downtown.\"\nBoth Selwyn and Lansing cut in coolly, dismissing the matter with a careless word or two; and coffee was served—cambric tea in Drina's case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                                        "entry_id": "c68a0d26-fe4b-36a4-bc71-584830ca406e",
                                        "glosses": [
                                            "Not giving sufficient attention or thought, especially concerning the avoidance of harm or mistakes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359d619f-3f7a-439b-9f2e-9e6595862b94",
                                                "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                                                "text": "Jessica was so careless that she put her shorts on backwards."
                                            },
                                            {
                                                "example_id": "a9ac66ce-7af3-484d-98f5-a2da7f9a9bbe",
                                                "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                                                "text": "These ballads, none of which are later than the fifteenth century, are written in a strain of the most artless simplicity, not the slightest attempt at ornament is to be discerned in them; the same ideas and expressions continually recur, and the rimes are the most careless imaginable, often a mere assonnance in vowels or consonants, sometimes not possessing even that slight similarity of sound."
                                            },
                                            {
                                                "example_id": "680f3f13-d867-4a71-b4c3-d0b75c4c1279",
                                                "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                                                "text": "I don't find the pose of careless youth charming and engaging any more than you find the pose of careworn age fascinating and eccentric, I should imagine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978b55f6-7088-3da1-97f9-01e5ff793963",
                                        "entry_id": "c68a0d26-fe4b-36a4-bc71-584830ca406e",
                                        "glosses": [
                                            "Free from care; unworried, without anxiety."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be4aeb97-e952-4bc4-bb36-e8d7aecd824c",
                                                "sense_id": "978b55f6-7088-3da1-97f9-01e5ff793963",
                                                "text": "Jessica was careless about putting her shorts on properly."
                                            },
                                            {
                                                "example_id": "a6ec422a-e374-4381-8a50-c85bafb4cd95",
                                                "sense_id": "978b55f6-7088-3da1-97f9-01e5ff793963",
                                                "text": "Good-humored, easy, and careless, he presided over his whale-boat as if the most deadly encounter were but a dinner, and his crew all invited guests."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26794730-4ae6-41b9-84de-e18a202eefe5",
                        "source_entry_id": "cb4f8fd3-9e89-314b-8c55-027cb6db1519",
