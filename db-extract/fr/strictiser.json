                "senses": [
                    {
                        "sense_id": "401975f5-9ad8-31d1-92f1-b1897ee71b4c",
                        "entry_id": "08c5a680-6b17-3b83-bc8b-771cbbae5e30",
                        "glosses": [
                            "Donner un caractère strict à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fef5d74-11b6-4ec3-84ec-83e983f29ca8",
                                "sense_id": "401975f5-9ad8-31d1-92f1-b1897ee71b4c",
                                "text": "Si toutefois on souhaite des retrouvailles en douceur et pas direct la grande tape dans le dos, on couvre le tout d’un petit débardeur, on couvre le tout d'un petit débardeur, qui associé au pantalon droit donne un air un peu masculin et strictise ainsi le côté baba cool seventies du tissu."
                            },
                            {
                                "example_id": "dcfe8161-8735-4512-8f4e-89379898e146",
                                "sense_id": "401975f5-9ad8-31d1-92f1-b1897ee71b4c",
                                "text": "Mais il y eut tellement de déviances que ce créneau a été supprimé, et que la réglementation s'est \"strictisée\" au point que le maillot est obligatoire partout, même dans le sauna, et même sous la douche!"
                            },
                            {
                                "example_id": "ab354750-d7b8-429b-84e5-a382ac807196",
                                "sense_id": "401975f5-9ad8-31d1-92f1-b1897ee71b4c",
                                "text": "J'ai continué à strictiser toute la baraque, Devon a fait sa chambre (ça lui a demandé beaucoup d'effort psychologique de s'atteler à cette tache)."
                            }
                        ]
                    }
