                "entry_id": "2af19e36-f2e2-32c4-96ca-4727257c7d3c",
                "word": "embûche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2d9b5c1d-b8b5-4726-905d-19f82de6982f",
                        "entry_id": "2af19e36-f2e2-32c4-96ca-4727257c7d3c",
                        "tags": [
                            "plural"
                        ],
                        "form": "embûches"
                    },
                    {
                        "form_id": "83f5d509-670b-463e-abd2-82a182a7f67d",
                        "entry_id": "2af19e36-f2e2-32c4-96ca-4727257c7d3c",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "embuche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a8b6490-4c99-3d5b-a625-1934fe7e9987",
                        "entry_id": "2af19e36-f2e2-32c4-96ca-4727257c7d3c",
                        "glosses": [
                            "Entreprise secrète pour surprendre quelqu’un, pour lui nuire."
                        ],
                        "tags": [
                            "Plus usité au pluriel qu’au singulier"
                        ],
                        "examples": [
                            {
                                "example_id": "cac63823-31e9-4944-9c26-001da6e187f6",
                                "sense_id": "6a8b6490-4c99-3d5b-a625-1934fe7e9987",
                                "text": "Mon Dieu, en quel martyre vous m’avez condamnée à vivre, enveloppée de duplicités, environnée d’embûches, cernée de chausses-trapes."
                            },
                            {
                                "example_id": "cb4d064f-7342-4ec5-932d-cd383cd12b97",
                                "sense_id": "6a8b6490-4c99-3d5b-a625-1934fe7e9987",
                                "text": "…il se demandait s’il avait bien réellement le droit d’associer à cette vie de périls et d’embûches continuelles une jeune fille de l’âge de sa nièce, […] qui probablement ne pourrait pas s’accoutumer à ces dangers incessants et à ces agitations."
                            },
                            {
                                "example_id": "86ac7db6-9996-466e-b8dd-8bac87a5bc7e",
                                "sense_id": "6a8b6490-4c99-3d5b-a625-1934fe7e9987",
                                "text": "À quoi bon ces vaines enquêtes où il était sûr, si tant est qu’il évitât les embûches multipliées sous ses pas, de parvenir, en fin de compte, au plus pitoyable des résultats ?"
                            },
                            {
                                "example_id": "0a27ca74-fd51-49d7-86a1-5fdbf70459bc",
                                "sense_id": "6a8b6490-4c99-3d5b-a625-1934fe7e9987",
                                "text": "Comme une bête traquée, elle flairait l’embûche et fouillait les ténèbres de son regard."
                            },
                            {
                                "example_id": "66f8a78f-4a37-4e29-8670-59c0d0fc917a",
                                "sense_id": "6a8b6490-4c99-3d5b-a625-1934fe7e9987",
                                "text": "Pour avoir raison d’une embûche parlementaire, on est souvent contraint de biaiser, de ne pas heurter de front, de faire mine au contraire d’appuyer tel projet auquel les mots magiques qui le dénomment valent une faveur particulière sur les bancs d’une assemblée."
                            }
                        ]
                    },
                    {
                        "sense_id": "5762f4b8-bb9d-310c-b386-439adb229c94",
                        "entry_id": "2af19e36-f2e2-32c4-96ca-4727257c7d3c",
                        "glosses": [
                            "Piège, difficulté."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7a68faef-a6aa-4dea-bef3-7919acc93763",
                                "sense_id": "5762f4b8-bb9d-310c-b386-439adb229c94",
                                "text": "Quelle est la cruauté de l'homme le meilleur s'il ne veille à la démarche de son discours, s'il ne se garde des embûches des mots !"
                            },
                            {
                                "example_id": "5a027f3c-96cc-4404-930b-3ae599d1a147",
                                "sense_id": "5762f4b8-bb9d-310c-b386-439adb229c94",
                                "text": "Mercredi 27 novembre, l’ex-ministre allemande de la défense a franchi la dernière étape d’un parcours semé d’embûches : le Parlement de Strasbourg a donné son aval à son collège, avec une large majorité – 461 voix pour, 157 contre et 89 abstentions."
                            },
                            {
                                "example_id": "62144c5e-baef-4c1f-97f7-656aeabca33c",
                                "sense_id": "5762f4b8-bb9d-310c-b386-439adb229c94",
                                "text": "Le combat contre cette plante envahissante aquatique est toutefois semé d’embûches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dcfaaeb-e7f9-4878-b0cb-ab0ae64c5455",
                        "source_entry_id": "2af19e36-f2e2-32c4-96ca-4727257c7d3c",
                        "target_lang_word": "Fallstrick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fallstrick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                        "entry_id": "f300070b-af81-35d4-a1c4-eb747cfb0257",
                                        "glosses": [
                                            "Mittel, um jemanden zu Fall zu bringen oder zu schaden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c361a54-b213-424a-a465-d11a12170ffd",
                                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                                "text": "„So gilt Brigitte Ederer etwa als eine sehr erfahrene Personalerin, die lange auf ihrem Posten war und wohl eher über politische Fallstricke gestolpert ist als über eigenes Versagen.“"
                                            },
                                            {
                                                "example_id": "33e6be87-81a2-427e-a11b-e6fcf59d4b28",
                                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                                "text": "„Aber sein Weg war voller Fallstricke.“"
                                            },
                                            {
                                                "example_id": "30200dd1-c849-447f-86a1-36cafcc19b4e",
                                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                                "text": "„Ich glaubte im Gegenteil, gerade weil ich C. C. liebte, müsse ich hingehen, um sie vor anderen Fallstricken zu bewahren.“"
                                            },
                                            {
                                                "example_id": "6ad1597d-145e-4e12-a883-cac7fa0962a9",
                                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                                "text": "„Wenn man mit 280 Zeichen langen Tweets Wahlen beeinflussen, Pandemien kartieren und Märkte erschüttern kann, kommt es darauf an, die Verheißungen und Fallstricke von Buchstaben, Schriftarten, Emojis und Satzzeichen, vor allem aber der paradoxen !!! zu verstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ef13b05-bda7-4fa1-a3e1-4557ca34121a",
                        "source_entry_id": "2af19e36-f2e2-32c4-96ca-4727257c7d3c",
                        "target_lang_word": "Hindernis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hindernis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "Gegenstand, der das Weiterkommen verhindert oder behindert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43cde951-f903-48d9-89a6-c2c012b35f94",
                                                "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                                "text": "„Karl Joswig konnte und wollte er nicht als Hindernis ansehen, da Eddi Sillus es allein übernommen hatte, mit unserem Lieblingswärter fertig zu werden - Eddi, der schon früh den Meistergürtel der nordwestdeutschen Judokas erworben hatte.“"
                                            },
                                            {
                                                "example_id": "2f5a8e41-7239-4f79-b995-ca31e7d1fbbd",
                                                "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                                "text": "„Es gab noch ein anderes Hindernis auf meinem Schulweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "eine Tatsache, die eine Entwicklung verhindert oder behindert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6fbe64-f65e-4329-bd57-9f86cd0ad08e",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "„Erotik ist Überwindung von Hindernissen. Das verlockendste und populärste Hindernis ist die Moral.“"
                                            },
                                            {
                                                "example_id": "deed5b89-a19a-4b39-90be-f31fe7c9f3f5",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "Ich sehe keine Hindernisse, die einem Vertragsabschluss im Wege stehen könnten."
                                            },
                                            {
                                                "example_id": "5dad2b78-4deb-412e-935f-5238812a4417",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "„So sollte sich meiner Wahl immer ein Hindernis entgegensetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3d8e394e-b530-379b-9028-9316e271b722",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "durch Springen zu überwindende Konstruktion, zum Beispiel beim Hindernislauf oder beim Spring- oder Vielseitigkeitsreiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9184b899-89ee-4feb-b29d-48a4bf143c27",
                                                "sense_id": "3d8e394e-b530-379b-9028-9316e271b722",
                                                "text": "Das nächste Hindernis ist die Mauer, vor der die Stute das letzte Mal scheute."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "68fbc43e-5ef2-3aa3-8bb8-92b33c842d34",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "regelkonform zu durchfahrendes Kegelpaar auf einem Parcours"
                                        ],
                                        "tags": [
                                            "Fahrsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe397161-ac40-4d79-9cdb-ec8ab17104f5",
                                                "sense_id": "68fbc43e-5ef2-3aa3-8bb8-92b33c842d34",
                                                "text": "Wer stellt heute die Hindernisse auf?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
