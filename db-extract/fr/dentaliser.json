                "senses": [
                    {
                        "sense_id": "fca3d5f7-16b6-3888-b1ad-b34a562b9cc8",
                        "entry_id": "7029468d-8b0e-3e63-8229-6156eaa0fc8a",
                        "glosses": [
                            "Transformer en dentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1a2e9a-c694-496f-bc86-bd8fa0a6d1e4",
                                "sense_id": "fca3d5f7-16b6-3888-b1ad-b34a562b9cc8",
                                "text": "Le correcteur entérine aussi, voire accentue, la tendance à dentaliser les m en position implosive."
                            },
                            {
                                "example_id": "273b6718-6042-4704-9620-33c71d7bc993",
                                "sense_id": "fca3d5f7-16b6-3888-b1ad-b34a562b9cc8",
                                "text": "Ajoutons qu’à côté de schrunde, l'allemand possède le doublet schlund qui signifie à la fois gouffre et gosier (celui-ci considéré comme la chose béante et, par extension, dévorante), et schlucht (dont la finale radicale est restée gutturale, au lieu de se dentaliser, comme dans schrunde et schlund) « fondrière, » cf. schluck gorgée."
                            }
                        ]
                    }
