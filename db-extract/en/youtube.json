                                                "sense_id": "88b9b62e-7459-3b3b-89f4-672341da65f0",
                                                "text": "Het zijn voornamelijk videoclips van beroemde artiesten die populair zijn op YouTube."
                                            },
                                            {
                                                "example_id": "14831f3f-26c6-4266-afa6-dd68b16180a1",
                                                "sense_id": "88b9b62e-7459-3b3b-89f4-672341da65f0",
                                                "text": "YouTube had in 2011 3 miljard kijkers per dag."
                                            },
                                            {
                                                "example_id": "bc668ddb-754b-42e6-a061-0ff9cfe4aac7",
                                                "sense_id": "88b9b62e-7459-3b3b-89f4-672341da65f0",
                                                "text": "Maurits dacht waarschijnlijk dat ik dat wel op YouTube kon leren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa100782-5a9e-414c-924a-c7dcddfcc8e3",
