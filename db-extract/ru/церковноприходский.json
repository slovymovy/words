                "senses": [
                    {
                        "sense_id": "68921b05-1187-30c1-9b65-76c0d76d2604",
                        "entry_id": "113fd7b6-9245-3f51-a1b9-8c232d9b52be",
                        "glosses": [
                            "находящийся в ведении церкви и приходского духовенства (в Российском государстве до 1917 г.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98071aff-799f-467d-9440-be6500f2de26",
                                "sense_id": "68921b05-1187-30c1-9b65-76c0d76d2604",
                                "text": "Научились изготавливать для советских церковноприходские свидетельства, фабриковали удостоверения остарбайтеров."
                            },
                            {
                                "example_id": "534adb6c-74c5-4d29-8113-112827b5146f",
                                "sense_id": "68921b05-1187-30c1-9b65-76c0d76d2604",
                                "text": "Для образования низших слоев населения в духе православной веры и русской народности стали размножаться так называемые церковноприходские школы усердием Священного синода и его обер-прокурора К.П. Победоносцева."
                            }
                        ]
                    }
