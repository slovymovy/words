{
    "word_family": [
        "counterfeiter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f72ae19-9750-38b7-8e56-7e2218f02cc5",
                    "sense_definition": "Made in imitation of something genuine with the intent to deceive or defraud.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_fake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shopkeeper refused to accept the cash because it was a <w>counterfeit</w> bill.",
                            "target_lang_translations": {
                                "ru": "Продавец отказался принять наличные, так как банкнота была <w>фальшивой</w>.",
                                "nl": "De winkelier weigerde het contante geld te accepteren omdat het een <w>vals</w> biljet was."
                            }
                        },
                        {
                            "text": "Authorities confiscated thousands of <w>counterfeit</w> watches at the airport.",
                            "target_lang_translations": {
                                "ru": "Власти конфисковали в аэропорту тысячи <w>поддельных</w> часов.",
                                "nl": "De autoriteiten namen op de luchthaven duizenden <w>namaak</w>horloges in beslag."
                            }
                        }
                    ],
                    "synonyms": [
                        "fake",
                        "forged",
                        "fraudulent",
                        "spurious"
                    ],
                    "antonyms": [
                        "authentic",
                        "genuine",
                        "real"
                    ],
                    "common_phrases": [
                        "counterfeit money",
                        "counterfeit goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный в качестве имитации подлинного с целью обмана или мошенничества.",
                        "nl": "Nagemaakt met de bedoeling om te misleiden of te bedriegen; niet echt."
