                "senses": [
                    {
                        "sense_id": "2c05fb77-b68c-34e6-9a87-d3df4292dfe7",
                        "entry_id": "fa7a8060-d61b-3757-8c62-4cd8ad1779a7",
                        "glosses": [
                            "разг. короткий забавный рассказ анекдотического или поучительного характера"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f412837a-a94a-4bc5-b740-a50524c332a7",
                                "sense_id": "2c05fb77-b68c-34e6-9a87-d3df4292dfe7",
                                "text": "Запомнилась побасёнка Зорина: В Париже начала века к знаменитому скрипачу и композитору Энеску пришел начинающий проныра и просил… аккомпанировать ему на рояле, помочь ему выдвинуться. Энеску согласился, а придя на концерт, увидел в зале знаменитого пианиста (Кокто?) и попросил его сесть рядом, переворачивать ноты."
                            },
                            {
                                "example_id": "1cb93fa1-c134-43be-97dd-b49db93fb64c",
                                "sense_id": "2c05fb77-b68c-34e6-9a87-d3df4292dfe7",
                                "text": "Я же из них, из тех, где побасёнка на побасёнке сидит и побасёнкой погоняет."
                            }
                        ]
                    }
