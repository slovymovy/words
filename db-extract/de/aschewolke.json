                "senses": [
                    {
                        "sense_id": "55200d53-9566-3990-a2bb-e5b79c34ceb0",
                        "entry_id": "6f7399c1-c793-3988-b94e-a7a3a386466c",
                        "glosses": [
                            "Wolke, die aus Vulkanasche besteht und sich nach einem Vulkanausbruch am Himmel bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef8e40c-6337-4139-804c-c4b95b2d1dd7",
                                "sense_id": "55200d53-9566-3990-a2bb-e5b79c34ceb0",
                                "text": "„Wissenschaftler des Deutschen Zentrums für Luft- und Raumfahrt haben einen Messflug zur Aschewolke des Vulkans Eyjafjallajökull gewagt.“"
                            },
                            {
                                "example_id": "7bf38d78-9421-401a-a902-eab9a51e6ffe",
                                "sense_id": "55200d53-9566-3990-a2bb-e5b79c34ceb0",
                                "text": "„Der Schädelknochen und die Wirbelsäule dienten dabei wahrscheinlich als eine Art Schutzschild, der den direkten Kontakt des empfindlichen Gewebes mit der heißen Aschewolke verhinderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
