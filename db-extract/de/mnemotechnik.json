                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "037046e8-58ca-3d89-893f-528c0bcab269",
                                        "entry_id": "71c4a2cd-ab2a-3526-9214-ae855a27a938",
                                        "glosses": [
                                            "Something (especially a series of ideas, letters, words, etc.) used to help in remembering a thing; a memory aid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99408be8-5226-437a-8685-fe153d015cf9",
                                                "sense_id": "037046e8-58ca-3d89-893f-528c0bcab269",
                                                "text": "Mr Avery was a great believer in mnemonics; he had one for every possible aspect of flying – which was as good a way as any for student pilots to familiarise themselves with their new environment, but unless used on a daily basis could also be dangerous, for there were so many of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9798506-5838-39b4-9326-de74577c0639",
                                        "entry_id": "71c4a2cd-ab2a-3526-9214-ae855a27a938",
                                        "glosses": [
                                            "The human-readable, textual form of an assembly language instruction, not including operands."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e51a48c7-d9a9-3174-8b63-9c6b6ed92e8e",
                                        "entry_id": "71c4a2cd-ab2a-3526-9214-ae855a27a938",
                                        "glosses": [
                                            "Synonym of mnemonics (“the study of techniques for remembering anything more easily”)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
