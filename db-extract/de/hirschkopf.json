                        "form": "die Hirschköpfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1873569a-7b92-38cb-b472-11c139bf4921",
                        "entry_id": "aebb16cd-da82-33ef-94d6-492e47a0d42e",
                        "glosses": [
                            "Kopf eines Hirschs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a52810f6-b168-4c4b-a2e4-2ac1b399a738",
                                "sense_id": "1873569a-7b92-38cb-b472-11c139bf4921",
                                "text": "„Auf keinen Fall konnte ich jetzt Urlaub nehmen. Den würde ich brauchen, nachdem ich ihr die letzte Beichte abgenommen hätte und sie so tot wäre wie der ausgestopfte Hirschkopf, der im Keller meiner Mutter an der Wand hängt.“"
                            },
                            {
                                "example_id": "f9688592-aee0-47f8-bdbb-b4400b5a8b12",
                                "sense_id": "1873569a-7b92-38cb-b472-11c139bf4921",
                                "text": "„In einer Kleinstadt standen sie in einem Lebensmittelladen, in dem ein ausgestopfter Hirschkopf an der Wand hing.“"
                            },
                            {
                                "example_id": "8b30e57d-4d37-417e-91dd-8d787012c8a2",
                                "sense_id": "1873569a-7b92-38cb-b472-11c139bf4921",
                                "text": "„All diese Kissen mit vergilbtem Spitzenbezug. Bestickte Geschirrtücher. Topflappen mit Kreuzstichmustern. Versilberte, dunkelbraun angelaufene Haarbürsten. Präparierte Hirschköpfe mit ausladenden Geweihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
