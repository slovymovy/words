                        "vacarme infernal"
                    ]
                },
                {
                    "sense_id": "2cbefe10-042a-3bf0-8fd6-c1267b82b8d1",
                    "sense_definition": "Très agité, indiscipliné et difficile à supporter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce garçon est vraiment un enfant <w>infernal</w> qui refuse d'écouter ses parents."
                        },
                        {
                            "text": "Les élèves étaient particulièrement <w>infernaux</w> cet après-midi en classe."
                        }
                    ],
                    "synonyms": [
