{
    "word_family": [
        "wieszak",
        "zawieszenie",
        "zawieszka",
        "wieszanie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "463e72bf-7ba8-3b84-9e84-000a967be1be",
                    "sense_definition": "umieścić przedmiot na czymś, aby zwisał",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zawieszanie przedmiotów",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawsze <w>zawieszam</w> kurtkę na wieszaku w przedpokoju.",
                            "target_lang_translations": {
                                "en": "I always <w>hang</w> my jacket on the hook in the hall."
                            }
                        },
                        {
                            "text": "Mama <w>zawiesza</w> nowe zasłony w salonie.",
                            "target_lang_translations": {
                                "en": "Mum is <w>hanging</w> new curtains in the living room."
                            }
                        }
                    ],
                    "synonyms": [
                        "wieszać"
                    ],
                    "common_phrases": [
                        "zawieszać obraz",
                        "zawieszać kurtkę"
                    ],
                    "target_lang_definitions": {
                        "en": "To place an object on something so that it is supported from above."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "To attach something to a hook, hanger, or similar support."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bf612ec-1cf9-3525-88c0-0f7955d843b8",
                    "sense_definition": "wstrzymać lub przerwać działanie na pewien czas",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wstrzymywanie działań",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z powodu złej pogody linie lotnicze coraz częściej <w>zawieszają</w> poranne loty.",
                            "target_lang_translations": {
                                "en": "Because of bad weather, airlines are increasingly <w>suspending</w> morning flights."
                            }
                        },
                        {
                            "text": "Sąd <w>zawiesza</w> postępowanie, jeśli jedna ze stron poważnie zachoruje.",
                            "target_lang_translations": {
                                "en": "The court <w>suspends</w> the proceedings if one of the parties becomes seriously ill."
                            }
                        }
                    ],
                    "synonyms": [
                        "przerywać"
                    ],
                    "common_phrases": [
                        "zawieszać działalność",
                        "zawieszać rozprawę"
                    ],
                    "target_lang_definitions": {
                        "en": "To temporarily stop or pause an activity or operation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suspend",
                                "target_lang_sense_clarification": "To halt an activity or service for a period of time."
                            },
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "To interrupt an action or process temporarily."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61047d28-f8bd-3b37-bd17-ae4d2c069b76",
                    "sense_definition": "przestać reagować na polecenia użytkownika (o urządzeniu lub programie)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wstrzymywanie działań",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój komputer często <w>zawiesza</w> się podczas pracy z grafiką.",
                            "target_lang_translations": {
                                "en": "My computer often <w>freezes</w> while I am working with graphics."
                            }
                        },
                        {
                            "text": "Telefon <w>zawiesza</w> się za każdym razem, gdy otwieram aparat.",
                            "target_lang_translations": {
                                "en": "My phone <w>freezes</w> every time I open the camera."
                            }
                        }
                    ],
                    "common_phrases": [
                        "komputer zawiesza się",
                        "program zawiesza się"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w kontekście technicznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To stop responding to user input (referring to a device or program)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "When a computer program or system stops responding to commands."
                            },
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "Technical term for a system or program becoming unresponsive."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}