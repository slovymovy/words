{
    "word_family": [
        "slam",
        "slammer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd986bcb-bf3b-3362-823c-82e3d91e9eb4",
                    "sense_definition": "present participle and gerund of <w>slam</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "slam_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left the room in anger, <w>slamming</w> the heavy door behind him.",
                            "target_lang_translations": {
                                "ru": "Он в гневе вышел из комнаты, <w>хлопнув</w> за собой тяжелой дверью."
                            }
                        },
                        {
                            "text": "The wind was <w>slamming</w> the loose shutters against the side of the house.",
                            "target_lang_translations": {
                                "ru": "Ветер с силой <w>ударял</w> незакрепленными ставнями о стену дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slamming the door",
                        "slamming on the brakes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий глагола slam (хлопать, захлопывать с силой)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопающий",
                                "target_lang_sense_clarification": "причастие, о дверях, ставнях"
                            },
                            {
                                "target_lang_word": "хлопая",
                                "target_lang_sense_clarification": "деепричастие, с силой закрывая"
                            },
                            {
                                "target_lang_word": "захлопывание",
                                "target_lang_sense_clarification": "действие по значению глагола"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52a3f2d0-bed4-3de7-b6ff-671a7b702631",
                    "sense_definition": "The act or sound of something shutting or hitting with great force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slam_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>slamming</w> of a car door startled the sleeping dog.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>хлопанье</w> автомобильной двери напугало спящую собаку."
                            }
                        },
                        {
                            "text": "The constant <w>slamming</w> broke the delicate lock on the gate.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>хлопанье</w> сломало хрупкий замок на калитке."
                            }
                        }
                    ],
                    "synonyms": [
                        "banging"
                    ],
                    "common_phrases": [
                        "slamming of doors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий хлопок или звук удара от закрытия с большой силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопанье",
                                "target_lang_sense_clarification": "громкий звук или процесс захлопывания"
                            },
                            {
                                "target_lang_word": "хлопок",
                                "target_lang_sense_clarification": "одиночный звук удара или захлопывания"
                            },
                            {
                                "target_lang_word": "стук",
                                "target_lang_sense_clarification": "резкий громкий звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0751d62-e485-349c-8aeb-e191adef415b",
                    "sense_definition": "An illegal practice in which a customer's service provider is switched without their permission.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fraud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced heavy fines after being accused of telephone <w>slamming</w>.",
                            "target_lang_translations": {
                                "ru": "Компании грозили огромные штрафы после того, как ее обвинили в телефонном <w>слэминге</w>."
                            }
                        },
                        {
                            "text": "Many elderly consumers fell victim to <w>slamming</w> on their monthly bills.",
                            "target_lang_translations": {
                                "ru": "Многие пожилые потребители стали жертвами <w>несанкционированного переключения провайдера</w>, заметив изменения в ежемесячных счетах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконный перевод клиента на обслуживание к другому поставщику услуг без его согласия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слэминг",
                                "target_lang_sense_clarification": "несанкционированная смена провайдера услуг"
                            },
                            {
                                "target_lang_word": "несанкционированное переключение",
                                "target_lang_sense_clarification": "смена поставщика услуг без согласия абонента"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4eb64d6b-b9c8-30eb-a394-05ddc8b9235a",
                    "sense_definition": "Exceptionally good, attractive, or exciting; awesome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "positive_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ played a <w>slamming</w> set that kept everyone dancing until sunrise.",
                            "target_lang_translations": {
                                "ru": "Диджей отыграл <w>бомбический</w> сет, под который все танцевали до самого рассвета."
                            }
                        },
                        {
                            "text": "She showed up to the party wearing a totally <w>slamming</w> new outfit.",
                            "target_lang_translations": {
                                "ru": "Она появилась на вечеринке в совершенно <w>отпадном</w> новом наряде."
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome",
                        "fantastic",
                        "great"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal praise"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно хороший, потрясающий, классный или привлекательный (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпадный",
                                "target_lang_sense_clarification": "сленг: потрясающий, великолепный"
                            },
                            {
                                "target_lang_word": "улётный",
                                "target_lang_sense_clarification": "сленг: очень захватывающий"
                            },
                            {
                                "target_lang_word": "бомбический",
                                "target_lang_sense_clarification": "сленг: производящий сильное впечатление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}