                                    {
                                        "sense_id": "204cf339-7258-3533-8c11-155b6d027d51",
                                        "entry_id": "231114f0-7ff7-3d45-91dd-a955aac654d2",
                                        "glosses": [
                                            "past participle of rive"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "obsolete",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cba54a3-a1fc-46bf-8761-482b9ef1b96f",
                                                "sense_id": "204cf339-7258-3533-8c11-155b6d027d51",
                                                "text": "The mightie trunck halfe rent, with ragged rift\nDoth roll adowne the rocks, and fall with fearefull drift."
                                            },
                                            {
                                                "example_id": "1c753ecb-94cb-45ac-b27e-bea92da8d1bc",
                                                "sense_id": "204cf339-7258-3533-8c11-155b6d027d51",
                                                "text": "Whether these men are alive or not, the fragile meeting ground I shared with them has been rift apart by a microscopic menace they didn't tell us about in high school biology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e95072bb-684f-46cb-ab33-682cac391a5f",
