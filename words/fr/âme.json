        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45c125b8-c8f1-35f7-931d-037145af37e6",
                    "sense_definition": "Partie immatérielle de l'être humain, souvent opposée au corps, considérée comme le principe de la vie spirituelle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "principe spirituel de l'être humain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup de religions croient que l'<w>âme</w> survit à la mort du corps."
                        },
                        {
                            "text": "Il pense que le corps meurt, mais que son <w>âme</w> reste vivante."
                        },
                        {
                            "text": "Les croyants prient pour le repos de l'<w>âme</w> des défunts."
                        }
                    ],
                    "synonyms": [
                        "esprit"
                    ],
                    "antonyms": [
                        "corps"
                    ],
                    "common_phrases": [
                        "âme immortelle",
                        "âme et corps"
                    ]
                },
                {
                    "sense_id": "4b6b40a4-fab6-36e9-a311-f26c3ed55b69",
                    "sense_definition": "Ensemble des sentiments, de la pensée et du caractère moral d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "principe spirituel de l'être humain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a une <w>âme</w> généreuse et pense toujours aux autres."
                        },
                        {
                            "text": "Ce poète a une <w>âme</w> sensible à la beauté du monde."
                        },
                        {
                            "text": "Il est entré dans la pièce, l'<w>âme</w> troublée par cette mauvaise nouvelle."
                        }
                    ],
                    "synonyms": [
                        "esprit"
                    ],
                    "common_phrases": [
                        "âme sensible",
                        "grande âme",
                        "âme généreuse"
                    ]
                },
                {
                    "sense_id": "dac547c3-0674-3507-b036-6f328ef631da",
                    "sense_definition": "Personne, être humain (surtout dans des expressions).",
