                ],
                "senses": [
                    {
                        "sense_id": "63c3151c-b889-381f-83ac-a1af278d81b8",
                        "entry_id": "56ce8d5e-8edc-3f3b-8b68-f570dc978a18",
                        "glosses": [
                            "biały z szarym odcieniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5abba524-0c28-47ad-bc42-a987a4fa0f0e",
                                "sense_id": "63c3151c-b889-381f-83ac-a1af278d81b8",
                                "text": "Karolina pojawiła się w szarobiałej bluzie i czarnych dżinsach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6359e09f-5300-4cac-94d1-23837835635f",
                        "source_entry_id": "56ce8d5e-8edc-3f3b-8b68-f570dc978a18",
                        "source_sense_id": "63c3151c-b889-381f-83ac-a1af278d81b8",
                        "target_lang_word": "grauweiß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grauweiß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e47e9e0e-e683-3ea8-a4bf-d98df6a1e33b",
                                        "entry_id": "5115ce44-fe68-38a4-ad58-350467c80b68",
                                        "glosses": [
                                            "in einem grau durchsetzten Weiß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "474e5782-06a0-471c-ab35-97044bceb9d5",
                                                "sense_id": "e47e9e0e-e683-3ea8-a4bf-d98df6a1e33b",
                                                "text": "„Diese glitschigen, grauweißen Blasphemien verehrten sie von nun an als Gottheiten und sie klagten nicht, wenn Dutzende ihrer besten und fettesten Männer auf den schwarzen Galeeren fortgebracht wurden.“"
                                            },
                                            {
                                                "example_id": "6156b8b8-eb43-4434-a65a-7a9a2e5e661c",
                                                "sense_id": "e47e9e0e-e683-3ea8-a4bf-d98df6a1e33b",
                                                "text": "„Die Decke ist mit grauweißer Asche bedeckt, ein Hinweis darauf, dass es kein offenes Feuer gab oder jedenfalls kein so großes, dass sich das Zimmer mit mehr und schwärzerem Rauch gefüllt hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
