            "senses": [
                {
                    "sense_id": "05716f53-267c-3b55-b9f8-ac6777fcb3b9",
                    "sense_definition": "Éclairer quelque chose d'une vive lumière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un magnifique feu d'artifice vient d'<w>illuminer</w> le ciel au-dessus du château."
                        },
                        {
                            "text": "Les premiers rayons du soleil levant commencent à <w>illuminer</w> toute la vallée."
                        }
                    ],
                    "synonyms": [
                        "éclairer"
                    ],
                    "antonyms": [
                        "obscurcir",
                        "assombrir"
                    ],
                    "common_phrases": [
                        "illuminer le ciel",
                        "illuminer la pièce"
                    ]
                },
                {
                    "sense_id": "8ace7437-6ef1-30de-9851-3267d2bf3d37",
                    "sense_definition": "Décorer un lieu avec des lumières ou des guirlandes pour une fête.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a décidé d'<w>illuminer</w> la ville pour les fêtes de fin d'année."
                        },
                        {
                            "text": "Chaque hiver, les habitants installent des guirlandes lumineuses pour <w>illuminer</w> leurs maisons."
                        }
                    ],
                    "common_phrases": [
                        "illuminer la ville",
                        "illuminer les rues"
                    ]
                },
                {
                    "sense_id": "16311435-4f5f-30c7-9be4-b757ca389b80",
                    "sense_definition": "Éclairer l'esprit de quelqu'un ou rendre intelligible une notion complexe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lumiere_figuree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette explication limpide a suffi pour <w>illuminer</w> l'esprit de tous les élèves perplexes."
                        },
                        {
                            "text": "Une idée brillante vint soudainement <w>illuminer</w> sa réflexion après de longues heures de doute."
                        }
                    ],
                    "synonyms": [
                        "éclairer"
                    ],
                    "antonyms": [
                        "embrouiller"
                    ],
                    "common_phrases": [
