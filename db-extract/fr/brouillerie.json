                ],
                "senses": [
                    {
                        "sense_id": "be3df935-6027-3e16-aa58-18ab9a1607e2",
                        "entry_id": "c7904472-9c88-3224-8ae8-0d0a76faaa94",
                        "glosses": [
                            "Désunion, mésintelligence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce7c4774-a735-49c1-8c0f-83f75e72eb85",
                                "sense_id": "be3df935-6027-3e16-aa58-18ab9a1607e2",
                                "text": "Il se brouille de temps en temps, et il écrit sept ou huit lettres pour la brouillerie."
                            },
                            {
                                "example_id": "16c4bd93-91f8-4970-9c6b-6ff643cf41c9",
                                "sense_id": "be3df935-6027-3e16-aa58-18ab9a1607e2",
                                "text": "Je trouve cette espèce de brouillerie d’une absurdité quasi révoltante entre deux vieux amis."
                            },
                            {
                                "example_id": "71b8e94e-8085-4eb2-9c9c-bc3c366b5ddc",
                                "sense_id": "be3df935-6027-3e16-aa58-18ab9a1607e2",
                                "text": "Je Vous en écris tout simplement, cher et excellent frère, afin que Vous sachiez qu’il existe des brouilleries au quartier du Comte Tolstoy entre les hauts personnages et qui peuvent influencer pour les suites par des non-ententes vraies ou fausses sur les opérations, où un commun accord est plus nécessaire que jamais."
                            }
                        ]
                    }
                ],
