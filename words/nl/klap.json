    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8eb648c0-4005-3a35-8dea-66f55cf848e6",
                    "sense_definition": "een plotseling, luidruchtig geluid veroorzaakt door een slag of val",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude vaas viel met een luide <w>klap</w> in duizend stukken op de vloer.",
                            "target_lang_translations": {
                                "en": "The old vase fell onto the floor into a thousand pieces with a loud <w>bang</w>."
                            }
                        },
                        {
                            "text": "Hij hoorde een harde <w>klap</w> toen de deur achter hem dichtsloeg.",
                            "target_lang_translations": {
                                "en": "He heard a loud <w>bang</w> when the door slammed shut behind him."
                            }
                        }
                    ],
                    "common_phrases": [
                        "harde klap",
                        "luide klap"
                    ],
                    "target_lang_definitions": {
                        "en": "a sudden, loud noise caused by a blow or fall"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bang",
                                "target_lang_sense_clarification": "a sudden percussive noise"
                            },
                            {
                                "target_lang_word": "crash",
                                "target_lang_sense_clarification": "a loud noise of something breaking or falling"
                            },
                            {
                                "target_lang_word": "thud",
                                "target_lang_sense_clarification": "a dull sound from a heavy fall"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df4b0646-9a43-36bc-916b-3dc7bfbb85b1",
                    "sense_definition": "een fysieke slag of stoot die aan iemand wordt uitgedeeld",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysiek contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bokser kreeg een flinke <w>klap</w> tegen zijn kin tijdens de wedstrijd.",
                            "target_lang_translations": {
                                "en": "The boxer took a heavy <w>blow</w> to his chin during the match."
                            }
                        },
                        {
                            "text": "Hij heeft vroeger veel <w>klappen</w> gehad op het schoolplein.",
                            "target_lang_translations": {
                                "en": "He used to get a lot of <w>slaps</w> on the school playground."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreun",
                        "mep",
                        "opdoffer",
                        "pets"
                    ],
                    "common_phrases": [
                        "klappen krijgen",
                        "flinke klap"
                    ],
                    "target_lang_definitions": {
                        "en": "a physical blow or strike dealt to someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "a hard hit with a hand or weapon"
                            },
                            {
                                "target_lang_word": "slap",
                                "target_lang_sense_clarification": "a blow with an open hand"
                            },
                            {
                                "target_lang_word": "smack",
                                "target_lang_sense_clarification": "a sharp, loud blow"
                            },
                            {
                                "target_lang_word": "punch",
                                "target_lang_sense_clarification": "a blow with a fist"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d68efd73-a9d9-363e-8af8-5ccffe472624",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>klappen</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>klap</w> in mijn handen omdat ik het liedje erg leuk vind.",
                            "target_lang_translations": {
                                "en": "I <w>clap</w> my hands because I really like the song."
                            }
                        },
                        {
                            "text": "Elke keer als de artiest buigt, <w>klap</w> ik enthousiast mee.",
                            "target_lang_translations": {
                                "en": "Every time the artist bows, I <w>clap</w> along enthusiastically."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ik klap"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'to clap'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clap",
                                "target_lang_sense_clarification": "to strike hands together"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fb129f1-47c8-3b37-8762-11ba0cf05659",
                    "sense_definition": "de gebiedende wijs van <w>klappen</w>",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Klap</w> nu allemaal tegelijk in jullie handen voor de jarige!",
                            "target_lang_translations": {
                                "en": "Now everyone <w>clap</w> your hands at the same time for the birthday boy!"
                            }
                        },
                        {
                            "text": "Als je blij bent, <w>klap</w> dan mee met de muziek.",
                            "target_lang_translations": {
                                "en": "If you are happy, then <w>clap</w> along with the music."
                            }
                        }
                    ],
                    "common_phrases": [
                        "klap in je handen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative form of 'to clap'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clap",
                                "target_lang_sense_clarification": "command to strike hands together"
