                "senses": [
                    {
                        "sense_id": "7e697237-7315-3245-b98f-0705a15c4f48",
                        "entry_id": "9d3e8967-dc83-366d-a6fa-12c4edd8b2e2",
                        "glosses": [
                            "Streitkraft aus Bürgern eines Ortes, die erst im Bedarfsfall aufgestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38684027-1fa0-454d-81b4-2632163c7a9d",
                                "sense_id": "7e697237-7315-3245-b98f-0705a15c4f48",
                                "text": "„Das Heer der römischen Kaiserzeit ging aus der Armee der Republik hervor, die zunächst eine reine Milizarmee war, in der die wehrpflichtigen römischen Bürger ihre Waffen und Ausrüstung selber zu stellen hatten.“"
                            },
                            {
                                "example_id": "dffbd798-0a64-459f-ad57-94eabbc83546",
                                "sense_id": "7e697237-7315-3245-b98f-0705a15c4f48",
                                "text": "„Es ist also möglich, mit unserer Milizarmee in Friedenszeiten Geheimaktionen durchzuführen, sei es, weil kein Soldat davon erzählt, sei es, weil die Öffentlichkeit diese Maßnahmen voll und ganz akzeptiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
