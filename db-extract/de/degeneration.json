                "senses": [
                    {
                        "sense_id": "e370b04c-43aa-3aad-9cdd-21ea79a2b295",
                        "entry_id": "1509f0ba-e02a-3c37-bbfe-dc9e5f650097",
                        "glosses": [
                            "Rückbildung, Entartung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d5c375-bee9-4c3a-bb55-5be0d8a218c1",
                                "sense_id": "e370b04c-43aa-3aad-9cdd-21ea79a2b295",
                                "text": "Im Alter leiden viele Menschen an einer Degeneration der Knochensubstanz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93247a20-cf05-445e-9877-207e10c9e8d8",
                        "source_entry_id": "1509f0ba-e02a-3c37-bbfe-dc9e5f650097",
                        "source_sense_id": "e370b04c-43aa-3aad-9cdd-21ea79a2b295",
                        "source_sense_description": "Rückbildung, Entartung",
                        "target_lang_word": "degeneration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "degeneration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4afdbce5-5a4b-34f0-9a3b-8c105ca7a0e3",
                                        "entry_id": "7ea9ab9f-1e30-38a1-b867-90ff04ff63b5",
                                        "glosses": [
                                            "The process or state of growing worse, or the state of having become worse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a3af38a-33f7-4c26-8a45-c710ddbcd67f",
                                                "sense_id": "4afdbce5-5a4b-34f0-9a3b-8c105ca7a0e3",
                                                "text": "The modern cry of \"more liberty and less creed\" is a degeneration from a vertebrate to a jellyfish."
                                            },
                                            {
                                                "example_id": "f2cabd92-d7b2-4c38-81d8-ea2a6d17dcba",
                                                "sense_id": "4afdbce5-5a4b-34f0-9a3b-8c105ca7a0e3",
                                                "text": "Hence, regional soil degenerations and podsolization was probably an important factor contributing to the retrogressive change in the forest composition at the end of the mesocratic phase.."
                                            },
                                            {
                                                "example_id": "c65364fb-d173-4b3a-9108-4368999ecae0",
                                                "sense_id": "4afdbce5-5a4b-34f0-9a3b-8c105ca7a0e3",
                                                "text": "Emmanuel Macron sounded like a man in grief. Not angry, not defiant, just a little triste. Europe, he lamented, was suffering a “degeneration of democracy”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f61de34b-a49d-3aad-b9f5-99c2bf9a49b4",
                                        "entry_id": "7ea9ab9f-1e30-38a1-b867-90ff04ff63b5",
                                        "glosses": [
                                            "That condition of a tissue or an organ in which its vitality has become either diminished or perverted; a substitution of a lower for a higher form of structure."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e8b33d1-bb0c-46de-b03e-7b91f3856408",
                                                "sense_id": "f61de34b-a49d-3aad-b9f5-99c2bf9a49b4",
                                                "text": "fatty degeneration of the liver"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d1f5f4-f52f-31c9-9e1c-068f43593dc5",
                                        "entry_id": "7ea9ab9f-1e30-38a1-b867-90ff04ff63b5",
                                        "glosses": [
                                            "Gradual deterioration, from natural causes, of any class of animals or plants or any particular organ or organs; hereditary degradation of type."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c63b31a-6733-30de-a4ee-06ac9cf0e61d",
                                        "entry_id": "7ea9ab9f-1e30-38a1-b867-90ff04ff63b5",
                                        "glosses": [
                                            "A thing that has degenerated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4da275f-1e0d-4a4a-a59c-3c8b5b647b7d",
                                                "sense_id": "5c63b31a-6733-30de-a4ee-06ac9cf0e61d",
                                                "text": "cockle, aracus, […] and other degenerations"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a70990db-2671-4c29-bae4-b6ccaa34117c",
                        "source_entry_id": "1509f0ba-e02a-3c37-bbfe-dc9e5f650097",
                        "source_sense_id": "e370b04c-43aa-3aad-9cdd-21ea79a2b295",
                        "source_sense_description": "Rückbildung, Entartung",
                        "target_lang_word": "dégénérescence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégénérescence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed77108c-9197-3ded-92fd-37ddfd6e26b4",
                                        "entry_id": "0b2e7d39-570f-3563-8634-10fa6c15e31f",
                                        "glosses": [
                                            "Action de dégénérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0f76685-296b-4e7a-a612-2d9c5cf6da3d",
                                                "sense_id": "ed77108c-9197-3ded-92fd-37ddfd6e26b4",
                                                "text": "L’heureuse paix du Paradou, dormant au grand soleil, empêchait la dégénérescence des espèces."
                                            },
                                            {
                                                "example_id": "ec9db188-a1a8-44ef-aa85-56db15d9b222",
                                                "sense_id": "ed77108c-9197-3ded-92fd-37ddfd6e26b4",
                                                "text": "Le cabo­tinage était poussé par Murat jusqu’au grotesque, et les historiens n’ont pas assez remarqué quelle responsabilité incombe à Napoléon dans cette dégénérescence du véritable esprit guerrier."
                                            },
                                            {
                                                "example_id": "521fe2a2-b6b5-4c77-bd48-90e70372a76e",
                                                "sense_id": "ed77108c-9197-3ded-92fd-37ddfd6e26b4",
                                                "text": "Si la dégénérescence de la race n’est encore que rarement évoquée, le risque de dépopulation par la maladie vénérienne est, en 1885, dénoncé en des termes angoissés par le professeur A. Fournier, devant ses collègues de l’Académie de Médecine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc616d7-facc-3626-992f-f26332ba810f",
                                        "entry_id": "0b2e7d39-570f-3563-8634-10fa6c15e31f",
                                        "glosses": [
                                            "Action de dégénérer, en parlant d’un tissu ou d’un organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef44682-cee9-4a51-8aa1-3fef517d7cf3",
                                                "sense_id": "3dc616d7-facc-3626-992f-f26332ba810f",
                                                "text": "Les facteurs génétiques sont impliqués dans la prédisposition à la dégénérescence du disque intravertébral chez certaines personnes."
                                            },
                                            {
                                                "example_id": "73581489-f517-4bb1-83cc-d34f41881949",
                                                "sense_id": "3dc616d7-facc-3626-992f-f26332ba810f",
                                                "text": "Feinsold et al. ont démontré, pour la première fois en 1975, qu'au cours de la SEP il était possible de détecter en lumière anérythre une dégénérescence axonale de la couche des fibres nerveuses rétiniennes chez des patients."
                                            },
                                            {
                                                "example_id": "395e2f6a-b8db-41c1-96d4-2fd99d7dabd9",
                                                "sense_id": "3dc616d7-facc-3626-992f-f26332ba810f",
                                                "text": "Né avec une amyotrophie spinale, maladie génétique neuromusculaire qui entraîne la dégénérescence des neurones moteurs, Matthieu vit avec un handicap lourd caractérisé par une faiblesse et une atrophie des muscles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
