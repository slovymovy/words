                        "sense_id": "cef439b5-3270-32fa-8fee-5a1ae8005ce5",
                        "entry_id": "85d546ae-4d89-36ea-80b4-453a3c2e34c8",
                        "glosses": [
                            "Mineral-Aggregate, die vorwiegend aus Verbindungen von Mangan und Eisen bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04217e4-45de-45cd-99db-eff23d26220e",
                                "sense_id": "cef439b5-3270-32fa-8fee-5a1ae8005ce5",
                                "text": "„Manganknollen stellen am Grund unserer Ozeane einen undenkbar wertvollen Schatz dar.“"
                            },
                            {
                                "example_id": "153681b2-813f-4a3f-87f2-9018366a8c40",
                                "sense_id": "cef439b5-3270-32fa-8fee-5a1ae8005ce5",
                                "text": "„Die heutigen Schätze der Tiefsee sind kartoffel- bis salatkopfgroße, schwarze Knollen – Manganknollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
