                    {
                        "sense_id": "1a1d8d96-5313-3bb5-9ba9-25e8d5a7c8c5",
                        "entry_id": "d482a42b-d250-322f-b2e2-23015b64dc50",
                        "glosses": [
                            "uitgebreide, brede kennis"
