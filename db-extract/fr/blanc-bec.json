                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b2013622-be18-43c5-b116-90fb1d9233bf",
                        "entry_id": "d38f251a-56b8-3629-a311-c6afb968054b",
                        "tags": [
                            "plural"
                        ],
                        "form": "blancs-becs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25ae0c20-c248-340b-bf06-b6fbc08b71bd",
                        "entry_id": "d38f251a-56b8-3629-a311-c6afb968054b",
                        "glosses": [
                            "Jeune homme qui n’a pas encore de barbe."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                        "entry_id": "d38f251a-56b8-3629-a311-c6afb968054b",
                        "glosses": [
                            "Jeune homme sans expérience et trop sûr de lui."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6413c4ad-6f00-484e-9d48-08bad6382da2",
                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                "text": "Il trouvait que ce muscadin avait du bon et se mit à lui expliquer la façon de se comporter au régiment, pour ne pas avoir l’air d’un blanc-bec."
                            },
                            {
                                "example_id": "446d8688-32e4-47e7-8d68-c6fda55c937f",
                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                "text": "— Tu ne sais donc pas ce que disait ma mère, blanc-bec ? reprenait gravement le plus vieux en baissant les yeux d’un air farouche et solennel pour se faire écouter."
                            },
                            {
                                "example_id": "5decb270-aa7a-4471-baa7-77112ef66977",
                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                "text": "Un blanc-bec tel que vous provoquer en duel un personnage comme le baron !"
                            },
                            {
                                "example_id": "56fcbc31-0801-43c9-8ace-1f8c106537e4",
                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                "text": "L’autre, en rajustant son habit, prenait cet air las et dégoûté des jeunes blancs-becs qui s’en viennent de livrer un galant assaut."
                            },
                            {
                                "example_id": "c12033b4-09e1-4655-9bde-e17c385a61ce",
                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                "text": "— Sacrés jean-foutres de blancs-becs ! grogne le facteur en promenant autour de lui un œil courroucé. Le lait leur coule encore des narines, et ça voudrait chambarder tout !"
                            },
                            {
                                "example_id": "01fef8bc-f0e9-4703-8348-84a70ce68470",
                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                "text": "Alors blanc bec t’aimes le basket\nBen on va ouèj à ma façon ;\nJ’vais juste un peu changer les règles :\nOn est les joueurs, toi t’es l’ballon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0bfe615-a634-40ac-be43-5723f4d26d4e",
                        "source_entry_id": "d38f251a-56b8-3629-a311-c6afb968054b",
                        "source_sense_description": "Jeune homme sans expérience et trop sûr de lui",
                        "target_lang_word": "Grünschnabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grünschnabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb17359b-d6a3-3e78-924c-25ce2ef75113",
                                        "entry_id": "97624af8-38a6-3b1e-91c8-0d4401a71a69",
                                        "glosses": [
                                            "eine auf einem Gebiet noch unerfahrene Person (siehe auch Bedeutung [4] zu „grün“)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60654ca3-ebe8-4c81-8cb8-acb57e5d741d",
                                                "sense_id": "cb17359b-d6a3-3e78-924c-25ce2ef75113",
                                                "text": "An dem wichtigen Auftrag will der Chef nicht den Grünschnabel arbeiten lassen."
                                            },
                                            {
                                                "example_id": "24aec4a6-8940-4c31-9531-ffb9db5b241b",
                                                "sense_id": "cb17359b-d6a3-3e78-924c-25ce2ef75113",
                                                "text": "„Pröhl […] knöpfte sich den Grünschnabel vor und gab ihm deutlich zu verstehen, dass er etwas diskreter vorgehen solle.“"
                                            },
                                            {
                                                "example_id": "0448f27b-65f2-4705-b26c-2d518da45b6c",
                                                "sense_id": "cb17359b-d6a3-3e78-924c-25ce2ef75113",
                                                "text": "„[…] Als im März 2010 zum ersten Mal der Song \"Zu jung\" bei on3-radio lief, waren Kraftklub noch fünf Grünschnäbel aus Chemnitz ohne Management oder Bookingagentur, die gerade ein paar Songs ins Netz gestellt hatten.“"
                                            },
                                            {
                                                "example_id": "ab3b31f4-2f70-4123-92ef-e03c28f90319",
                                                "sense_id": "cb17359b-d6a3-3e78-924c-25ce2ef75113",
                                                "text": "„Zum 20-jährigen Jubiläum des Fernsehsenders «Tele M1» erinnert sich Tanja Gutmann zurück: Als Moderations-Grünschnabel trug sie lange schwarze Haare und wurde von einem Vogel attackiert.“"
                                            },
                                            {
                                                "example_id": "420a1f99-6ba2-4f63-bba8-c79f4276ecd0",
                                                "sense_id": "cb17359b-d6a3-3e78-924c-25ce2ef75113",
                                                "text": "„Ob ein politischer Grünschnabel aus dem Schwarzbubenland wirklich zum neuen SVP-Kantonalpräsidenten gewählt würde, bleibt fraglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d30502b9-b509-4c0d-91f8-515e8e709e01",
