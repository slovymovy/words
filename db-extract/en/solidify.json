                        "examples": [
                            {
                                "example_id": "327fe30f-bc33-4799-9621-9ef0244680f8",
                                "sense_id": "dd6c8be4-2834-3132-b8d1-5381ac5af188",
                                "text": "Emerging from Kennaway Tunnel, the train sweeps to the right, affording views of the recent work to solidify the railway here."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e842850-c726-30d8-9a15-644df16ed59c",
                        "entry_id": "b8236c50-5657-3d7e-a975-26e675d27e86",
                        "glosses": [
                            "To become solid; to freeze, set."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5647eeb9-a4d3-36d1-8217-f37796a6ab29",
                        "entry_id": "b8236c50-5657-3d7e-a975-26e675d27e86",
