                                        "sense_id": "73c7e855-0830-3c73-a587-e19b314186dd",
                                        "entry_id": "04b11983-ee42-33f2-aeb3-a2fddaa47291",
                                        "glosses": [
                                            "kurzes rohrförmiges Verbindungsstück zum Verbinden von Rohren, Kanälen oder elektrischen Leitungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6292418d-d8b4-4eb2-9fb7-298e8b4136e6",
                                                "sense_id": "73c7e855-0830-3c73-a587-e19b314186dd",
                                                "text": "Der Klempner verband die beiden Rohre mit einer Muffe."
                                            },
                                            {
                                                "example_id": "2801ccd5-9ee1-49ab-a8e8-106a5b9a141b",
                                                "sense_id": "73c7e855-0830-3c73-a587-e19b314186dd",
                                                "text": "Bei einer Muffenverbindung werden die beiden Nippel (mit dem kleineren Nippelmaß) in die Muffe (mit dem größeren Muffenmaß) eingesteckt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78b3fb7e-d0c0-3eea-8f52-db141c0cddb7",
                                        "entry_id": "04b11983-ee42-33f2-aeb3-a2fddaa47291",
                                        "glosses": [
                                            "Angst"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e52b0c17-433c-48c0-bf33-87f00be08794",
                                                "sense_id": "78b3fb7e-d0c0-3eea-8f52-db141c0cddb7",
                                                "text": "Ich spring da nicht rein, da habe ich zu viel Muffe."
                                            },
                                            {
                                                "example_id": "81b7b1f3-ef76-4d1a-9d1f-6d2da8eb5572",
                                                "sense_id": "78b3fb7e-d0c0-3eea-8f52-db141c0cddb7",
                                                "text": "So wie Du mir drohst, da geht mir aber die Muffe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
