                ],
                "senses": [
                    {
                        "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                        "entry_id": "38da867a-d847-3764-bcbb-fa1574a9585c",
                        "glosses": [
                            "Bauwerk/Mast, dessen tragende Teile ein Gitter (meist aus Stahl) bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34f0f90-56b5-4231-af79-36dbed52df40",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "Eine Gitterkonstruktion hat den Vorteil, bei gleicher Stabilität weniger Material zu benötigen als ein massiver Mast."
                            },
                            {
                                "example_id": "5d16d488-1cfe-4b83-89b7-da7d151684d5",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„Die Gitterkonstruktion ist außen achtkantig verschalt und hell angemalt […].“"
                            },
                            {
                                "example_id": "7d460091-4d36-4d18-a743-4d0a4e0aa316",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„250 Güterzüge, die jahrelang Tag für Tag über diese Brücke fuhren, haben ihre Spuren hinterlassen: Haarrisse in der Gitterkonstruktion, Schäden an den Pfeilern und Lagern.“"
                            },
                            {
                                "example_id": "6d3413c5-d4da-4fa2-b247-f4637b192b67",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„Für die Türme, auf denen sich die Rotoren drehen, gibt es verschiedene Konstruktionsprinzipien: Sie können als sich nach oben verjüngende Stahlrohrtürme, als Betonpfeiler oder als kostengünstige Gitterkonstruktionen erbaut werden.“"
                            },
                            {
                                "example_id": "6c18b18a-a552-465e-aa1d-b0b1ed319528",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„[Ständerbauweise:] Senkrechte Stützen, die in breitem Abstand voneinander stehen und sich auch über mehrere Geschosse erstrecken können, ergeben zusammen mit den waagerechten Trägern eine großflächige Gitterkonstruktion, ein Gerüst, das sämtliche Lasten trägt.“"
                            },
                            {
                                "example_id": "c69ce26b-2d5a-404d-9ea0-7f30d4ecf27d",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„Zur Stabilisation und zum Schutz der Fassade umgab er das Haus mit einer Gitterkonstruktion, die er auch nach Abschluss beibehielt, was ihm erlaubte, die originale Fassade zu zeigen.“"
                            },
                            {
                                "example_id": "a2dea571-560d-4c4c-9397-d8483dcc6391",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„Bei Familie Lindermeir hängen Rucksäcke, Bobby-Cars und Kinderspielzeug von oben im Flur herab wie eine Kunstinstallation, befestigt an einer Gitterkonstruktion unter der hohen Decke.“"
                            },
                            {
                                "example_id": "b2bf1a39-46bb-40fa-b757-8bcc20c0012f",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„Nur eine Gitterkonstruktion aus Metall ragt über dem leeren Becken in den Himmel - kein Zweifel, hier wird so schnell kein Badegast mehr schwimmen gehen.“"
                            },
                            {
                                "example_id": "182dca7e-495a-4258-9bdd-d6daf0070176",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„»Wenn wir das World Trade Center in der Form eines Skelettes bauen, werden die Terroristen gewinnen«, sagte Trump in Anspielung auf Libeskinds Entwurf, der an der Spitze des geplanten Turmes eine Gitterkonstruktion vorsieht.“"
                            },
                            {
                                "example_id": "c29ba77d-65f3-48f2-9099-507ba4376bae",
                                "sense_id": "c098ed4d-7c36-3826-90f6-3133e68485b5",
                                "text": "„Im Krankenhaus liegen sie dann unter Moskito-Netzen, die über eine Gitterkonstruktion gespannt sind, damit der Stoff nicht an den nässenden Brandwunden klebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
