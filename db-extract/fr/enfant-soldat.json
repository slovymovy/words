                    {
                        "sense_id": "695cfb21-555a-301c-a5f9-807712f1bfd6",
                        "entry_id": "e2566272-dc86-31a4-b00d-b080f6f30ddf",
                        "glosses": [
                            "Variante orthographique de enfant soldat."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "5a55c9e3-8dc6-4fb1-97e7-f2eaa3db2b73",
                                "sense_id": "695cfb21-555a-301c-a5f9-807712f1bfd6",
                                "text": "Qui sont les kadogos ? demanda Adèle. — Des enfants-soldats démobilisés qui, jusqu’à présent, survivaient grâce au pillage et au braconnage, mais maintenant c’est terminé."
                            },
                            {
                                "example_id": "fac54c7c-16bf-41aa-9a30-294c5d3082a3",
                                "sense_id": "695cfb21-555a-301c-a5f9-807712f1bfd6",
                                "text": "Enrôlement d’enfants-soldats, découverte de charniers, exécutions extrajudiciaires, viols, tortures, le rapport de l’ONU cite de multiples exemples, avant de constater, en termes forts modérés, que « la situation des droits de l’homme au Mali est demeurée très préoccupante »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "975e63fc-902f-40c9-a1c9-08386102866e",
                        "source_entry_id": "e2566272-dc86-31a4-b00d-b080f6f30ddf",
                        "source_sense_id": "695cfb21-555a-301c-a5f9-807712f1bfd6",
                        "target_lang_word": "Kindersoldat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindersoldat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10544f45-2c2c-304b-b3a5-83f0b8bfb19c",
                                        "entry_id": "3651c49d-05d5-3f63-a76c-90ff83822094",
                                        "glosses": [
                                            "minderjährige Person, die als Soldat eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2954b2a4-38d0-48fd-8635-6baf3be00f86",
                                                "sense_id": "10544f45-2c2c-304b-b3a5-83f0b8bfb19c",
                                                "text": "„Weil Kindersoldaten im Krieg gelernt haben, sich mit Gewalt zu nehmen, was sie wollen, rutschen sie, wenn sie sich wieder in die Zivilgesellschaft eingliedern sollen, besonders oft in die Kriminalität ab.“"
                                            },
                                            {
                                                "example_id": "59dff8bd-0c32-4dcf-818d-2a64adc80d99",
                                                "sense_id": "10544f45-2c2c-304b-b3a5-83f0b8bfb19c",
                                                "text": "„Man nimmt an, dass sich die Zahl von Kindersoldaten weltweit auf etwa 250000 beläuft und dass es Kindersoldaten in rund 86 Staaten und Regionen der Welt gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
