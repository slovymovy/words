                                "target_senses": [
                                    {
                                        "sense_id": "7667892d-a8c2-317a-97d0-496f6b9d8ee2",
                                        "entry_id": "607a9323-51e9-3a83-91a8-88ed0c1632c3",
                                        "glosses": [
                                            "de schil van een banaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3347eb6-73e9-4e12-aa97-2949ef7845bc",
                                                "sense_id": "7667892d-a8c2-317a-97d0-496f6b9d8ee2",
                                                "text": "Ik heb ook een collega die heel eng gaat doen als hij in een straal van 200 meter van zijn bureaustoel een bananenschil ziet of ruikt - respect - en er is er één die allergisch is voor komkommer en dan moeten we na de lunch altijd even om de beurt met hem gaan zitten om hem weer rustig te krijgen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a507ec3-ac82-34a5-9237-006ca53d76b0",
                                        "entry_id": "607a9323-51e9-3a83-91a8-88ed0c1632c3",
                                        "glosses": [
                                            "een hindernis of obstakel waarover je een uitglijder kunt maken"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fdb00c9-b1cd-42bd-be0c-817cf7b1ebfe",
                                                "sense_id": "2a507ec3-ac82-34a5-9237-006ca53d76b0",
                                                "text": "Blok had dat memo, naar eigen zeggen, dertig seconden ingezien en nauwelijks iets van de inhoud begrepen, zo verklaarde hij tegenover de commissie-Oosting. En hij veronderstelde dat Oosting dat memo via de ambtelijke top van Justitie zou krijgen. Op het ministerie van Veiligheid en Justitie ligt altijd wel ergens een bananenschil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
