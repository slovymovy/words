                "senses": [
                    {
                        "sense_id": "cbb19e04-845a-3d98-9e0d-a8fa0c2b574b",
                        "entry_id": "3959253b-391a-3226-af33-6ec3d9a01fcb",
                        "glosses": [
                            "Anführer einer Räuberbande"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2f2900e-f3b6-45a4-a23f-5f729fc838a8",
                                "sense_id": "cbb19e04-845a-3d98-9e0d-a8fa0c2b574b",
                                "text": "Der Räuberhauptmann gab jedem seiner Räuber zwei Silberlinge."
                            },
                            {
                                "example_id": "a0950096-c23e-41fc-850a-7dd79db46724",
                                "sense_id": "cbb19e04-845a-3d98-9e0d-a8fa0c2b574b",
                                "text": "„Ohne Zweifel besaß er selbst etwas von dem Zeug, das damals zu einem tüchtigen Räuberhauptmann nötig war.“"
                            },
                            {
                                "example_id": "b49fe366-7c63-401a-a4de-a51ac34ecbf6",
                                "sense_id": "cbb19e04-845a-3d98-9e0d-a8fa0c2b574b",
                                "text": "„Der Karl ist so enttäuscht von seinem Vater, dass er sich von einer Bande zum Räuberhauptmann wählen lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a91fc1c2-2a1d-3590-964e-7dabad24e0a6",
                        "entry_id": "3959253b-391a-3226-af33-6ec3d9a01fcb",
                        "glosses": [
                            "ein Suchspiel für Kinder auf offenem Gelände"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "66a11de4-75d4-46c1-9467-6c5cbfe9fa5d",
                                "sense_id": "a91fc1c2-2a1d-3590-964e-7dabad24e0a6",
                                "text": "Die Kinder des Dorfes spielten beinahe täglich Räuberhauptmann."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
