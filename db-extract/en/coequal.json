                    {
                        "sense_id": "ab3b3097-31e3-3ff9-8c0c-12361bd86067",
                        "entry_id": "49738c16-f751-31f6-86fa-3ad21282612a",
                        "glosses": [
                            "Equal to each other in size, rank or position."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2766ae4-b89f-4f6e-8674-9a921c9b375f",
                                "sense_id": "ab3b3097-31e3-3ff9-8c0c-12361bd86067",
                                "text": "ſince they meaſure our deſerts so meane,\nThat in conceit beare Empires on our ſpeares,\nAffecting thoughts coequall with the cloudes,\nThey ſhalbe kept our forced followers,\nTil with their eies they view vs Emperours."
                            },
                            {
                                "example_id": "0ba59995-93ad-4210-957b-cb0974ec4b6b",
                                "sense_id": "ab3b3097-31e3-3ff9-8c0c-12361bd86067",
                                "text": "Mr. Blinken stressed that point on Monday. “The speaker will make her own decisions about whether or not to visit Taiwan,” he said. “Congress is an independent, coequal branch of government. The decision is entirely the speaker’s."
                            }
                        ]
                    }
