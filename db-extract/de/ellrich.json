                ],
                "senses": [
                    {
                        "sense_id": "b77baeaa-0101-3ea9-9e50-150002218f8d",
                        "entry_id": "3ab8a502-85ba-3129-bf02-176bd3ff00e4",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02387375-656a-4ec4-93c9-fd5b6818d986",
                                "sense_id": "b77baeaa-0101-3ea9-9e50-150002218f8d",
                                "text": "Frau Ellrich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e1db8a20-0c69-4957-ae87-af3400a24e03",
                                "sense_id": "b77baeaa-0101-3ea9-9e50-150002218f8d",
                                "text": "Herr Ellrich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "386e8923-3c46-4ba3-83fe-284e3e674907",
                                "sense_id": "b77baeaa-0101-3ea9-9e50-150002218f8d",
                                "text": "Die Ellrichs fliegen heute nach Bali."
                            },
                            {
                                "example_id": "88158216-3476-471b-b0f5-fd06a96fd09c",
                                "sense_id": "b77baeaa-0101-3ea9-9e50-150002218f8d",
                                "text": "Der Ellrich trägt nie die Pullover, die die Ellrich ihm strickt."
                            },
                            {
                                "example_id": "8ab167e0-3b73-47ef-9f44-c151b7d04432",
                                "sense_id": "b77baeaa-0101-3ea9-9e50-150002218f8d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ellrich kommt, geht der Herr Ellrich.“"
                            },
                            {
                                "example_id": "1162890b-599b-4ccb-bb44-9611215aa969",
                                "sense_id": "b77baeaa-0101-3ea9-9e50-150002218f8d",
                                "text": "Ellrich kommt und geht."
                            },
                            {
                                "example_id": "d7de7e2a-2791-465a-82fc-ecfac0e9b00e",
                                "sense_id": "b77baeaa-0101-3ea9-9e50-150002218f8d",
                                "text": "Ellrichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
