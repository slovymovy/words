                "senses": [
                    {
                        "sense_id": "2bd022ed-0aae-3c94-a585-13bf84b26330",
                        "entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                        "glosses": [
                            "Rainfall."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "52fda84d-264b-4577-9427-efd276951cbd",
                                "sense_id": "2bd022ed-0aae-3c94-a585-13bf84b26330",
                                "text": "In early December, as rainwaters had started the monthlong process of flooding mines and washing out rail lines, workers lined up before 1 p.m. at an easy-to-miss storefront depot in Mackay."
                            }
                        ]
                    },
                    {
                        "sense_id": "b85ff13d-8031-32e9-98a9-dd04ab4bb80e",
                        "entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                        "glosses": [
                            "Water (for a house, etc.) sourced from rain which has not joined a spring, stream or river, pond, lake or sea."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5d8d3cde-59b6-4024-8470-b2dea0acac04",
                                "sense_id": "b85ff13d-8031-32e9-98a9-dd04ab4bb80e",
                                "text": "Constructed of hard flint stone, which came as ballast from England and is now painted coral white, the house has a fishpond, or catchment, roof, dating from 1788, to collect rainwater."
                            }
                        ]
                    }
                ],
