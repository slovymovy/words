                                        "glosses": [
                                            "A storm consisting of thunder and lightning produced by a cumulonimbus, usually accompanied with heavy rain, wind, and sometimes hail; and in rarer cases sleet, freezing rain, or snow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd850ac-6abe-4c33-bad7-8c18e3776c1f",
                                                "sense_id": "a69824a5-331d-314c-a4c5-af37374f3d42",
                                                "text": "I have never believed, as some people do, in omens and forewarnings, for the dramatic things in my life have generally come upon me as suddenly as a tropical thunder-storm."
                                            }
