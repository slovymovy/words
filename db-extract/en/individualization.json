                        "entry_id": "ab3ae1d5-30c5-3c29-8066-8418fbd5f258",
                        "glosses": [
                            "The act of individualizing; the state of being individualized."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1b278506-8f5b-4782-b198-73f361752e9c",
                                "sense_id": "ee04ef79-0d7b-3964-a532-44b94175fcc8",
                                "text": "“The individualization of systemic problems under late-stage capitalism is crazy,” Diacono later said."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "332d915d-a999-4da9-bcab-8105b76cbad3",
                        "source_entry_id": "ab3ae1d5-30c5-3c29-8066-8418fbd5f258",
