                                                "example_id": "a69b7f1f-e0e5-489d-bd7e-ea29c5f77a23",
                                                "sense_id": "0552df03-f410-3329-a364-b8e3b0ba89e6",
                                                "text": "Narzecze sztokawskie jest dialektem południowosłowiańskim."
