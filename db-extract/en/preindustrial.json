                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7376588c-8e86-308c-bf86-5f7341dfd75d",
                        "entry_id": "35e574a8-ca19-3f06-88d0-01b2fb6f4703",
                        "glosses": [
                            "Of or relating to the period before the Industrial Revolution and the global industrialisation that followed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5575682b-19eb-4ddc-be36-012f54d35f7c",
                                "sense_id": "7376588c-8e86-308c-bf86-5f7341dfd75d",
                                "text": "Civilization has already exceeded a global warming of ~1.0◦C above pre-industrial conditions[.]"
                            },
                            {
                                "example_id": "a7439d25-715f-4887-84f0-22dddd516fc4",
                                "sense_id": "7376588c-8e86-308c-bf86-5f7341dfd75d",
                                "text": "At last year’s summit in Glasgow, countries agreed to focus on limiting global temperature rises to 1.5C above pre-industrial levels, but recent UN reports have shown that current policies would raise temperatures by about 2.5C."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cd46d3f-406a-34b0-a12c-efc2a9c4b8a7",
                        "entry_id": "35e574a8-ca19-3f06-88d0-01b2fb6f4703",
                        "glosses": [
                            "Not yet industrialized."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "202b4e94-910e-4c20-8afe-0958be2ae6bb",
                                "sense_id": "8cd46d3f-406a-34b0-a12c-efc2a9c4b8a7",
                                "text": "a preindustrial nation"
                            }
                        ]
                    }
