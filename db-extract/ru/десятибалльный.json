                        "sense_id": "adcf0dbe-1d6d-3a16-921d-455d993fe4aa",
                        "entry_id": "bcb6a9de-a1c5-3fd6-bf64-b324581786c7",
                        "glosses": [
                            "оцениваемый по шкале в десять баллов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2be380-9767-4c0b-8270-ba2887e27ba0",
                                "sense_id": "adcf0dbe-1d6d-3a16-921d-455d993fe4aa",
                                "text": "Оценка выставляется по десятибалльной системе и выносится в аттестат зрелости."
                            }
                        ]
                    },
                    {
                        "sense_id": "d30a5566-ae9e-36f1-b2d9-c866f833ceb7",
                        "entry_id": "bcb6a9de-a1c5-3fd6-bf64-b324581786c7",
                        "glosses": [
                            "имеющий силу, магнитуду, мощность и т. п. в десять баллов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19deeb9-9459-45b6-935d-aa221bcbb551",
                                "sense_id": "d30a5566-ae9e-36f1-b2d9-c866f833ceb7",
                                "text": "Над Чёрным морем бушевал десятибалльный шторм, потом пронеслась снежная буря."
                            }
                        ]
                    }
