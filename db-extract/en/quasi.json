                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "Ich bin quasi schon fertig."
                                            },
                                            {
                                                "example_id": "021e724c-5c21-4e92-a05d-3a8582ee86f9",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "Ich bin quasi der Kaiser vom Schrottplatz."
                                            },
                                            {
                                                "example_id": "6dd5fb1d-b5c0-4b88-a6e0-3a297519e114",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "Sie hatten den Urlaub quasi schon angetreten, als der Anruf kam."
                                            },
                                            {
                                                "example_id": "28263e76-62fe-4608-9c89-0fda81e7aed2",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "Das ist doch quasi das gleiche."
                                            },
                                            {
                                                "example_id": "02abdc65-21fc-4879-906d-57d6822e1df8",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "„Die Untersuchung eignet sich gut, um das Herz quasi von hinten durch die Speiseröhre hindurch zubetrachten.“"
                                            },
                                            {
                                                "example_id": "74eb7a37-4ba0-45c8-88c5-55652bbf80e9",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "„Es handelt sich um Kandidaten aus dem Spektrum der Alltagsgespräche, die quasi zufällig im Rahmen des täglichen Auslaufs mit dem Hund entstehen.“"
                                            }
                                        ],
