                ],
                "senses": [
                    {
                        "sense_id": "6d8ef790-fd6e-32cc-b738-0a9172c0f701",
                        "entry_id": "03db88a5-36b3-3a83-905f-70424ecdb75f",
                        "glosses": [
                            "Kunst der kreativen oder traditionellen Zubereitung von Lebensmitteln, um sie attraktiver, bekömmlicher, nahrhafter, geschmackvoller und sicherer zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf71d4c1-9fe3-4d0e-92ad-3fc426d4c4b1",
                                "sense_id": "6d8ef790-fd6e-32cc-b738-0a9172c0f701",
                                "text": "Wer die Chancen attraktiver Kulinarik im touristischen Umfeld nutzen will, braucht dazu ein umfassendes, vielseitiges und praxisorientiertes Wissen rund um die Themen Genuss, kulinarische Geschichte, Produktentwicklung/-vermarktung, Nachhaltigkeit und natürlich auch um die Besonderheiten spezifischer oder regionaler Küchen – aus praktischer, kultureller, ästhetischer und ökonomischer Perspektive."
                            },
                            {
                                "example_id": "5f5aadff-cf33-4361-9cbd-f89d45c26cc8",
                                "sense_id": "6d8ef790-fd6e-32cc-b738-0a9172c0f701",
                                "text": "Der Begriff „nordische Küche“ umfasst die Kulinarik Schwedens, Norwegens, Dänemarks und Finnlands."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a13c96d8-fd14-4e6e-928f-5d78d80ce14b",
                        "source_entry_id": "03db88a5-36b3-3a83-905f-70424ecdb75f",
                        "source_sense_id": "6d8ef790-fd6e-32cc-b738-0a9172c0f701",
                        "source_sense_description": "Kunst der kreativen oder traditionellen Zubereitung von Lebensmitteln",
                        "target_lang_word": "cuisine",
