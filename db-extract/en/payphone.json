{
    "word": "payphone",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2122737d-a6c4-31f4-9a63-c2c0721adec0",
                "word": "payphone",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "90bb50b5-9051-43f7-b7c8-464f36da582b",
                        "entry_id": "2122737d-a6c4-31f4-9a63-c2c0721adec0",
                        "tags": [
                            "plural"
                        ],
                        "form": "payphones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb011784-f440-36ae-a4d1-e3993750a077",
                        "entry_id": "2122737d-a6c4-31f4-9a63-c2c0721adec0",
                        "glosses": [
                            "A public telephone that requires prepayment to operate, generally via the insertion of coins or a credit card."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fad9a580-ab43-40c8-b78b-14e543e3b655",
                                "sense_id": "eb011784-f440-36ae-a4d1-e3993750a077",
                                "text": "I only had ten cents in my pocket, so I couldn't use the payphone to call a cab."
                            },
                            {
                                "example_id": "5954bf04-671b-48c0-bc2a-9fca9e69dea9",
                                "sense_id": "eb011784-f440-36ae-a4d1-e3993750a077",
                                "text": "You called me from a payphone / They still got payphones / It costs a dollar a minute / To tell me you're getting sober"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c549c19-775e-427c-9121-223f5fef6296",
                        "source_entry_id": "2122737d-a6c4-31f4-9a63-c2c0721adec0",
                        "source_sense_id": "eb011784-f440-36ae-a4d1-e3993750a077",
                        "source_sense_description": "a public telephone",
                        "target_lang_word": "Münztelefon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Münztelefon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                        "entry_id": "403b01e4-4301-3869-8f47-8e7f3b059777",
                                        "glosses": [
                                            "öffentliches Gerät zur Übermittlung von akustischen Signalen, welches nach Bezahlung benutzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61dbd7f1-17dc-44b6-9152-dc332e4d4717",
                                                "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                                "text": "Ich habe früher oft das Münztelefon verwendet."
                                            },
                                            {
                                                "example_id": "c3d9524f-afc5-4427-bad7-c2dbe8831877",
                                                "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                                "text": "„Vier Münztelefone und vier vergeudete 50 Cent-Stücke später die Einsicht, es mit einer Wertkarte zu versuchen.“"
                                            },
                                            {
                                                "example_id": "47418866-db37-4940-b194-c097d6346f25",
                                                "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                                "text": "„Die Kassiererin legt ihren Hörer auf den Apparat zurück, während Anrath den seinen noch lange nicht in die Gabel an der Seite des Münztelefons hängt.“"
                                            },
                                            {
                                                "example_id": "6df86409-f792-45e3-a184-d4390e1c18a1",
                                                "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                                "text": "„Ich kann dich nur von einem Münztelefon aus anrufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3376c5b7-e3cc-48a3-8b54-0c5c2255a7bd",
                        "source_entry_id": "2122737d-a6c4-31f4-9a63-c2c0721adec0",
                        "source_sense_id": "eb011784-f440-36ae-a4d1-e3993750a077",
