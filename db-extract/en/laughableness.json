                        "examples": [
                            {
                                "example_id": "64057142-44b3-4c1f-8869-e28a8c6a6d41",
                                "sense_id": "59a88250-7456-33c0-8981-a414e3b86b4c",
                                "text": "We obtain a true perception of the laughableness of this sort of buffoonery."
                            },
                            {
                                "example_id": "4b7478e0-0939-4d35-80a9-60464eae95f3",
                                "sense_id": "59a88250-7456-33c0-8981-a414e3b86b4c",
                                "text": "They encounter Empousa, the comic monster, who reminds us in spite of her laughableness of the dangerousness of the other."
                            },
                            {
                                "example_id": "4c2d995b-fd1b-408a-bf2d-e7e5c9c92cad",
                                "sense_id": "59a88250-7456-33c0-8981-a414e3b86b4c",
                                "text": "Two sayings from Seneca speak of the laughableness of man's ambitions on an earth scarred by the wars of so many nations."
                            }
                        ]
