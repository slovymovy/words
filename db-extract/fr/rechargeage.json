                        "glosses": [
                            "Action de recharger."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d9b9c326-1f0e-44cb-8fd9-e4bd5b55e9ae",
                                "sense_id": "058aa3db-fc3d-3453-a09e-d0a8d7260cdc",
                                "text": "L'acheteur doit les droits de mesurage et de rechargeage s'il en use."
                            }
                        ]
                    },
                    {
                        "sense_id": "876e32bd-05d6-3728-8ea8-c80eca7b60d5",
                        "entry_id": "1bf952cf-67fb-3970-a43f-0d5de7a0b1c4",
                        "glosses": [
                            "Rechargement superficiel de métaux par soudure au chalumeau."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "83144016-8382-4c1c-99e1-afe94baa5ff8",
                                "sense_id": "876e32bd-05d6-3728-8ea8-c80eca7b60d5",
                                "text": "Une application que l'ouvrier noyauteur devra toujours bien observer dans cette fabrication, est celle qui se présente lors du rechargeage d'un noyau de trop faible dimension ou non conforme au moule."
                            }
                        ]
                    },
                    {
                        "sense_id": "f98a0879-52f5-343d-bb3c-ad62120c0741",
                        "entry_id": "1bf952cf-67fb-3970-a43f-0d5de7a0b1c4",
                        "glosses": [
                            "Apport de terre, de terreau ou de sable au pied des plantes durant leur culture."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "698ec92b-1608-4c57-9bb8-1892aa85fc2b",
                                "sense_id": "f98a0879-52f5-343d-bb3c-ad62120c0741",
                                "text": "Peu de temps après la levée on donne un sarclage rigoureux, suivi d’un rechargeage très léger, destiné à raffermir les plants qui auraient pu être soulevés ou ébranlés; […]."
                            }
                        ]
                    }
