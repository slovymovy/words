                "translations": [
                    {
                        "translation_id": "3048cdb8-1f4f-410e-95af-16d1b2e633db",
                        "source_entry_id": "11d47330-cc1a-3d25-917c-0d0856c6a7e9",
                        "source_sense_id": "ca74c92f-d2e6-3cb1-8554-e2004a7e29a6",
                        "source_sense_description": "een tractor",
                        "target_lang_word": "Schlepper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlepper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "884b0bda-081e-3a83-bd8f-147f65f6cd14",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "kleines Schiff zur Unterstützung größerer Schiffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5aa5e1f-a692-42c6-a69f-65b8324dbf38",
                                                "sense_id": "884b0bda-081e-3a83-bd8f-147f65f6cd14",
                                                "text": "Schuten werden von Schleppern gezogen."
                                            },
                                            {
                                                "example_id": "21dfd494-7a56-4378-adc0-6bca80aa3fbc",
                                                "sense_id": "884b0bda-081e-3a83-bd8f-147f65f6cd14",
                                                "text": "„Mehrere Schlepper, ein finnischer, ein schwedischer Dampfer sanken nach Volltreffern.“"
                                            },
                                            {
                                                "example_id": "3fca7495-4e8a-4031-88f9-78fea10a3c03",
                                                "sense_id": "884b0bda-081e-3a83-bd8f-147f65f6cd14",
                                                "text": "„Ein Schlepper tutete vom Fluss her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26947617-1a9e-3e86-9413-415bedd45adb",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "Kraftfahrzeug zum Ziehen von angehängten Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d51d6bf-11b0-449e-aef7-ed09840c7c50",
                                                "sense_id": "26947617-1a9e-3e86-9413-415bedd45adb",
                                                "text": "Er sitzt von früh bis spät auf seinem Schlepper und beackert die Felder."
                                            },
                                            {
                                                "example_id": "be560f5c-408a-496d-af74-f99d3947a5e3",
                                                "sense_id": "26947617-1a9e-3e86-9413-415bedd45adb",
                                                "text": "„Darum sind wir jetzt ärmer, und es ist niemand mehr da, der unsere kaputten Schlepper repariert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "729c3d1f-df3b-30e7-9eaf-79e238935692",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "für den Transport im Berg zuständiger Arbeiter"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60e29f70-86de-4fc6-8ed5-0c5396a72d9a",
                                                "sense_id": "729c3d1f-df3b-30e7-9eaf-79e238935692",
                                                "text": "Der Schlepper musste meist gebückt gehen, weil die Gänge so niedrig waren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "jemand, der anderen Personen hilft, auf illegale Weise gegen Bezahlung in ein Land zu kommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585d26ef-0eb2-4494-86c6-eefda584d431",
                                                "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                                "text": "Die Schlepper nehmen Gesundheitsrisiken und Lebensgefahr der geschmuggelten Personen für ihre geschäftsmäßig betriebene Hilfe in Kauf; gleichzeitig verlangen sie oft hohe Provisionen für den illegalen Grenzübertritt."
                                            },
                                            {
                                                "example_id": "2701f14d-3ee1-4403-8cb7-868025263a10",
                                                "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                                "text": "„Denn diese Schlepper haben die Hauptarbeit zu verrichten und bekommen auch den Löwenanteil am Ergebnis dieser riesigen Wurzerei.“"
                                            },
                                            {
                                                "example_id": "2b83f154-a4d7-42fa-ac30-0470039570de",
                                                "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                                "text": "„Und die Schlepper dort verlangen 7000 Dollar für den Trip.“"
                                            },
                                            {
                                                "example_id": "c2791b7e-0fc3-474d-a34c-32866ccab3c1",
                                                "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                                "text": "„So sind sie auf Schlepper und Schleuser angewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5ddb4536-3705-3543-a251-48ecbf70682d",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "jemand, der andere Personen auf fragwürdige Weise Betrieben (zum Beispiel Nachtlokalen) zuführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "283bf757-e5a3-4b15-9666-2eae98241f68",
                                                "sense_id": "5ddb4536-3705-3543-a251-48ecbf70682d",
                                                "text": "Der Schlepper stand auf St.Pauli vor der Bar und zog den Mann am Oberarm, obwohl dies den Angestellten verboten ist."
                                            },
                                            {
                                                "example_id": "8c9ae8d1-3bfb-4a7c-bfe9-8a8c2e4b1a9d",
                                                "sense_id": "5ddb4536-3705-3543-a251-48ecbf70682d",
                                                "text": "„Von jetzt an war Stavroula zwar vor Neppern, Schleppern und Bauernfängern sicher, konnte allerdings auch nicht mehr mit meiner Mutter in Deutschland telefonieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "81980cd1-520a-3b1e-a1d0-130e3c140924",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "Skilift, Aufstiegshilfe, mit der Personen hinaufgezogen werden"
                                        ],
                                        "tags": [
                                            "Skisport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7731fea-3632-437f-9bce-e6e89eca463f",
                                                "sense_id": "81980cd1-520a-3b1e-a1d0-130e3c140924",
                                                "text": "„Auf der Bruncu Spina begegnen wir einer Kuriosität, einem Skilift. Dieser einsame, doch recht steile Schlepper zieht sich vom Rifugio Baita Bruncu Spina (1570 m) herauf, von wo aus wir die Tour ebenfalls starten könnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2abbd86b-0ddc-4996-85c1-24efa15c6549",
                        "source_entry_id": "11d47330-cc1a-3d25-917c-0d0856c6a7e9",
                        "source_sense_id": "ca74c92f-d2e6-3cb1-8554-e2004a7e29a6",
                        "source_sense_description": "een tractor",
                        "target_lang_word": "Traktor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Traktor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                        "entry_id": "eab642b0-9d20-3e9b-aec3-265281ba012c",
                                        "glosses": [
                                            "(vor allem in der Landwirtschaft eingesetztes) Kraftfahrzeug zum Ziehen von Maschinen, Geräten oder sonstigen angehängten Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee44ead0-a62a-4fa0-9507-6b42553d00fb",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "Der Bauer ist mit dem Traktor unterwegs."
                                            },
                                            {
                                                "example_id": "148aebdf-52f1-49a8-ba54-f5027f71386a",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Lokale Parteiführer werden dadurch in Angelegenheiten verwickelt wie etwa, wo man den Brennstoff für Traktoren herbekommt, was für Ferien den Bürokraten zugestanden werden sollen, wie der Wohnungsbau zu beschleunigen ist usw.“"
                                            },
                                            {
                                                "example_id": "5e872514-3986-42da-95c3-5a687c6e2d88",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Über die Äcker knattern die Traktoren.“"
                                            },
                                            {
                                                "example_id": "6909e83d-4e43-4a1d-a18b-e8f932b5474e",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Seithinter den vierteiligen Pflügen schleppen die Traktoren die Eggen.“"
                                            },
                                            {
                                                "example_id": "225584cc-ebb3-4a9d-9fe7-a6ee835f54f5",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Stille war, und nur der Traktor auf dem Acker nebenan bockte hustend.“"
                                            },
                                            {
                                                "example_id": "cd45afba-b521-4f71-954b-d42a32448f07",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Nimm also wieder deinen Filter gegen Dieselqualm; es ist März, Kollege Riecheur, und im Märzen der Bauer die Rößlein einspannt, aber die Rößlein werden hier in der Gegend immer seltener und der Bauer wird langsam ein anderer als jener, der auf den schönen alten Bildern zu sehen ist, wo er noch der Sämann ist und ein erbaulicher Anblick; jetzt steigt der eine Bauer im Märzen auf die Drillmaschine und der andere Bauer auf den Traktor davor, und beide sind in einer LPG, und die hat nicht nur den einen Traktor, und rings um den Platz der Befreiung gibt es mehr als eine LPG, und darum ist heute auch die Landluft über dem Platz nicht so, daß du sie ungefiltert verwenden könntest.“"
                                            },
                                            {
                                                "example_id": "8d5c79a9-807c-4685-8fdb-94fbe751c589",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Wenn die Fahrzeuge und Traktoren der Kolonne nicht an der Front gebraucht wurden, stellte er sie zur Gewinnung von Neuland zur Verfügung.“"
                                            },
                                            {
                                                "example_id": "fe71404d-06be-48b1-9c87-950abd52e5ed",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Ellen sah Jenny losrennen, über die Straße weg, wo jenseits weit entfernt auf dem riesigen Stoppelfeld zwei Traktoren in einer Staubwolke beim Pflügen waren. Ellen stürzte ans Telefon, hämmerte auf die Gabel: tot. Wie immer um diese Zeit, wenn die Traktoren die Erdleitungen zerrissen.“"
                                            },
                                            {
                                                "example_id": "fcdc8bc9-4225-4b72-899d-7da9c943ef73",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Die Insekten verstummten, die Vögel schwiegen; es wurde zunehmend dunkler, und das Brummen des Traktors hallte eintönig durch die Stille.“"
                                            },
                                            {
                                                "example_id": "638973b4-3d5e-4a6d-98d7-390d5a03b624",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Und die LPG-Bauern wollten nicht mehr mit meiner Mutter auf dem Traktor oder Pferdewagen fahren, straften sie in den endlosen Maisfeldern, ließen sie allein, weil sie diese verruchte Tochter hatte.“"
                                            },
                                            {
                                                "example_id": "ae636b14-c2b0-45d3-bf65-7f18f99f5924",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Kaum Verkehr, hie und da überholte ich einen Traktor oder ein paar Radfahrer.“"
                                            },
                                            {
                                                "example_id": "2f3f1b8e-9bb1-4d05-8205-3a68f0c08eab",
                                                "sense_id": "413672c0-aaad-369a-9179-4ddffa19b8d9",
                                                "text": "„Vom Erlös ihrer Produktion wollen sie moderne Traktoren und Mähdrescher anschaffen und in einigen Jahren tausend Hektar ihr Eigen nennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5ae5386-a882-3b56-b247-5af644b598c7",
                                        "entry_id": "eab642b0-9d20-3e9b-aec3-265281ba012c",
                                        "glosses": [
                                            "Vorrichtung eines Druckers, die dazu dient, das Endlospapier zu bewegen beziehungsweise zu positionieren"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba49494-603e-4e86-8ccb-5a6ee9e4b6d9",
                                                "sense_id": "f5ae5386-a882-3b56-b247-5af644b598c7",
                                                "text": "„Drucker für Massenausgaben verwenden Endlosformulare, die über Stachelwalzen oder Traktoren geführt werden.“"
                                            },
                                            {
                                                "example_id": "0c045e9d-6f49-4909-8c64-14eba95bfc3e",
                                                "sense_id": "f5ae5386-a882-3b56-b247-5af644b598c7",
                                                "text": "„Sie besitzen fast als einzige Drucker einen Traktor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab7ce1e1-8465-44f6-8cac-fe41b0ab0961",
                        "source_entry_id": "11d47330-cc1a-3d25-917c-0d0856c6a7e9",
                        "source_sense_id": "ca74c92f-d2e6-3cb1-8554-e2004a7e29a6",
                        "source_sense_description": "een tractor",
                        "target_lang_word": "Trecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a6fd5f-b885-3a5c-a51a-c111b81ab3a0",
                                        "entry_id": "7621c69c-912d-3340-8c82-fae9f50434b7",
                                        "glosses": [
                                            "(vor allem in der Landwirtschaft eingesetztes) Kraftfahrzeug zum Ziehen von Maschinen, Geräten oder sonstigen angehängten Lasten"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e94edd1-2cb5-4cc9-9519-c81505810803",
                                                "sense_id": "a6a6fd5f-b885-3a5c-a51a-c111b81ab3a0",
                                                "text": "Dein Vater ist mit dem Trecker auf dem Feld."
                                            },
                                            {
                                                "example_id": "07250be5-99c8-4f7f-a646-4779d51d91cc",
                                                "sense_id": "a6a6fd5f-b885-3a5c-a51a-c111b81ab3a0",
                                                "text": "„Aber auch die Träume von der Motorenschlosserei sind aufgeschoben, vorläufig genügt es dem Jungen, den Trecker im Dorf bei der Pflügerei trotz seiner Jugend führen zu dürfen.“"
                                            },
                                            {
                                                "example_id": "1cbc8e5b-4bbc-4039-be12-8b9dc275100b",
                                                "sense_id": "a6a6fd5f-b885-3a5c-a51a-c111b81ab3a0",
                                                "text": "„Die Bäuerin tat keinen Handschlag, sie plauderte mit dem Fahrer, der kurz vor der Mittagspause mit seinem Trecker gekommen war und einen Kübel Tee mitgebracht hatte.“"
                                            },
                                            {
                                                "example_id": "58e87a9d-076b-4fc9-aaf6-3da146f7d632",
                                                "sense_id": "a6a6fd5f-b885-3a5c-a51a-c111b81ab3a0",
                                                "text": "„Man hörte ein Pferd wiehern, einen tuckernden Trecker, und dann bellte einer der Hofhunde am Stall bei den Kühen, von denen zwei, die gerade gekalbt hatten, nicht auf die Weide getrieben worden waren und nun ebenfalls unruhig wurden und brüllten.“"
                                            },
                                            {
                                                "example_id": "3412429c-f252-427f-b2b2-fbe4903a12bd",
                                                "sense_id": "a6a6fd5f-b885-3a5c-a51a-c111b81ab3a0",
                                                "text": "„In Potsdam über der Langen Brücke gerate ich in eine fürchterliche Verkehrsstauung, man fährt Schritt, ich bin zwischen Motorradfahrer, Trecker und Militärfahrzeuge eingekeilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
