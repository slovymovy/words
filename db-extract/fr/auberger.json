                        ],
                        "examples": [
                            {
                                "example_id": "9dd1746f-1666-46ba-93f5-233deb9fdb2d",
                                "sense_id": "37477b81-3f07-34a8-bedb-3b48f5dca0ed",
                                "text": "Ils aubergent indifféremment tous les Etrangers, & leur font le meilleur accueil qu’il leur est possible."
                            },
                            {
                                "example_id": "92d2bfa1-279b-4c2a-af51-156aaa4fa1b5",
                                "sense_id": "37477b81-3f07-34a8-bedb-3b48f5dca0ed",
                                "text": "Eh ! bien, reprit Tirechair, les deux étrangers que nous aubergeons sentent le roussi."
                            }
                        ]
                    }
