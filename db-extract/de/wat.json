                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d6f16ba-2c73-4447-99d6-d4390d19e411",
                        "source_entry_id": "6cfae77f-3fd4-3609-aebe-ad7137915816",
                        "source_sense_id": "b20b6c2a-57ab-3506-b280-1612eb4c6678",
                        "source_sense_description": "buddhistische Tempelanlage in Südostasien",
                        "target_lang_word": "wat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8049924-0cb4-3735-bbad-9b750453a6bb",
                                        "entry_id": "272ca6aa-f96a-3bb3-9fe5-b393d35a2e5b",
                                        "glosses": [
                                            "A Buddhist temple in Southeast Asia, especially those in Thailand, Laos and Cambodia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "006864b7-ae6b-4a93-b724-0c654440b2c4",
                                                "sense_id": "c8049924-0cb4-3735-bbad-9b750453a6bb",
                                                "text": "There are two wats near this village."
                                            },
                                            {
                                                "example_id": "b40a1c1a-9db4-4b76-9fe1-cb9161efa3ca",
                                                "sense_id": "c8049924-0cb4-3735-bbad-9b750453a6bb",
                                                "text": "Angkor Wat"
                                            },
                                            {
                                                "example_id": "96aa8a16-a900-4410-ad09-f01b3a188253",
                                                "sense_id": "c8049924-0cb4-3735-bbad-9b750453a6bb",
                                                "text": "Having at last got past the crowd of boats, we advanced rapidly for two hours more, when we stopped at a wat, in order to give the men a rest."
                                            },
                                            {
                                                "example_id": "d3f46ae9-b5a5-4505-8e94-79f46a7a444d",
                                                "sense_id": "c8049924-0cb4-3735-bbad-9b750453a6bb",
                                                "text": "Aside from its religious function in the community, the wat also performs a large variety of social functions."
                                            },
                                            {
                                                "example_id": "0cd3adcd-db6c-4149-bd84-bfe6e93c28a4",
                                                "sense_id": "c8049924-0cb4-3735-bbad-9b750453a6bb",
                                                "text": "It would be a mistake, however, to emphasize the Hindu element in Cambodian Buddhism and Cambodian temples. At its greatest it is always a subordinate element and in most of the wats or temples it hardly appears at all, […]"
                                            },
                                            {
                                                "example_id": "5e0f1ee0-3788-4c18-aacb-18f83f3dd982",
                                                "sense_id": "c8049924-0cb4-3735-bbad-9b750453a6bb",
                                                "text": "It is often possible to discern the motivation or importance of a wat by examining its name"
                                            },
                                            {
                                                "example_id": "a49a96ae-bfb3-448e-84dd-55dbc8c405db",
                                                "sense_id": "c8049924-0cb4-3735-bbad-9b750453a6bb",
                                                "text": "The ubosoth is in a small enclosure just before the main entrance to the wat, on the right, which has fine gilded doors. The wat has a small museum."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b642f3-1293-397a-9c47-21f45cd6c577",
                                        "entry_id": "6e07a1f9-6ca2-3cb5-859c-5ec9176c62e2",
                                        "glosses": [
                                            "A kind of stew or curry eaten in Ethiopia and Eritrea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
