                        "examples": [
                            {
                                "example_id": "099803a0-bba3-4c4b-a009-48460e9ca303",
                                "sense_id": "da7c2b46-9d39-38d5-b180-67c8a34dc520",
                                "text": "наде́лать кому́-либо хлопо́т",
                                "translation": "to give someone (a lot of) trouble",
                                "english": "to give someone (a lot of) trouble"
                            },
                            {
                                "example_id": "e1e50fad-ad29-4869-9609-e95c582cbab2",
