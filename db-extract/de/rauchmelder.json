                "senses": [
                    {
                        "sense_id": "fa10c701-5cc5-3721-8a56-eceb51adfff1",
                        "entry_id": "17f4a08a-5d18-3c50-92f2-6f214a84adf2",
                        "glosses": [
                            "Gerät, das Alarm schlägt, wenn es zu Rauchentwicklung kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c20a07c8-5f0e-4de5-931f-41fc4dbb689b",
                                "sense_id": "fa10c701-5cc5-3721-8a56-eceb51adfff1",
                                "text": "„Viele Landesbauordnungen fordern Rauchmelder – im offiziellen Sprachgebrauch Rauchwarnmelder – in Wohnungen – in der Regel in Schlaf- und Kinderzimmern sowie in Fluren, die als Fluchtweg dienen: Vorreiter sind Saarland, Rheinland-Pfalz, Hessen, Hamburg, Bremen, Schleswig-Holstein, Mecklenburg-Vorpommern, Niedersachsen, Sachsen-Anhalt und Thüringen. Neu ist die Pflicht in Bayern.“"
                            },
                            {
                                "example_id": "f71cc67d-0a0f-43f4-8b61-cb110a73b7ac",
                                "sense_id": "fa10c701-5cc5-3721-8a56-eceb51adfff1",
                                "text": "„Den Rauchmelder in seinem Büro hatte er eigenhändig mit Isolierband abgedichtet.“"
                            },
                            {
                                "example_id": "62ec8fc6-c9fc-4d70-9e60-ff86fcd2b4e6",
                                "sense_id": "fa10c701-5cc5-3721-8a56-eceb51adfff1",
                                "text": "„In der Flugzeugtoilette scheint ein Passagier zu rauchen, jedenfalls schlägt der Rauchmelder an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
