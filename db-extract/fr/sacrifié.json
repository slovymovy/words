                ],
                "senses": [
                    {
                        "sense_id": "4fdd4c3e-e59f-39fc-879a-ed22c7a131e9",
                        "entry_id": "ea0f50e4-c0c2-3e07-8500-b6601f6e7409",
                        "glosses": [
                            "Personne qui est offerte comme victime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494e20a1-f819-48b3-90e0-5073b8a53b3e",
                                "sense_id": "4fdd4c3e-e59f-39fc-879a-ed22c7a131e9",
                                "text": "Tout sacrifice suppose une translation, celle qui fait passer le sacrifié des mains du sacrifiant vers le destinataire du sacrifice."
                            },
                            {
                                "example_id": "2042abcd-11f6-49ea-9664-4fa2fd8bf5f1",
                                "sense_id": "4fdd4c3e-e59f-39fc-879a-ed22c7a131e9",
                                "text": "C'est à Craonne sur le plateau\nQu'on doit laisser sa peau\nCar nous sommes tous condamnés\nNous sommes les sacrifiés."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "63cb40ad-6ae6-3098-8b31-e62d77c93a05",
                "word": "sacrifié",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "871174b3-46ed-39ff-b210-ee49d91f52bc",
                        "entry_id": "63cb40ad-6ae6-3098-8b31-e62d77c93a05",
                        "glosses": [
                            "Participe passé masculin singulier de sacrifier."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1d91c0bc-2c5b-45fb-b951-d829015b7ce1",
                                "sense_id": "871174b3-46ed-39ff-b210-ee49d91f52bc",
                                "text": "Rose-Marie-Victoire craignait tant, en déplaisant à son époux, en le heurtant, de le désaffectionner, d’être privée de sa compagnie, qu’elle lui aurait sacrifié tout, même son oncle."
                            },
                            {
                                "example_id": "16664cb9-dfb0-4e98-919a-c9dabbf70239",
                                "sense_id": "871174b3-46ed-39ff-b210-ee49d91f52bc",
                                "text": "Quoiqu’il en soit, nous ne saurions trop approuver toutes les augmentations de salaires, seul moyen de revigorifier la production industrielle, mais le producteur agricole ne devrait pas être le seul sacrifié."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
