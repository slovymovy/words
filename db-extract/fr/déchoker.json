                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e85494-d754-4d3f-8eec-3c52c0b5e48a",
                                "sense_id": "f420b333-bd65-3b53-a663-9aa0401d1d5b",
                                "text": "Mon armurier m'a dit qu'on ne pouvait pas le déchoker."
                            },
                            {
                                "example_id": "6d8aed3f-cf30-45d2-8a2c-e3c313edde47",
                                "sense_id": "f420b333-bd65-3b53-a663-9aa0401d1d5b",
                                "text": "Ensuite, oui tu peux faire déchoker au dixième de millimètre près. J'ai fait déchoker un Merkel 117 calibre 16 dont le 3/4 - full ne me convenait pas du tout."
                            },
                            {
                                "example_id": "b2661748-be6a-4c7b-87e3-8817ca22dae9",
                                "sense_id": "f420b333-bd65-3b53-a663-9aa0401d1d5b",
                                "text": "Déchoker un B25 ou installer des chokes."
                            }
                        ]
