                        "glosses": [
                            "wetenschappelijke methode om een ziekte vast te stellen door afweging van verschijnselen die op zichzelf op meerdere ziekten kunnen duiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4fbbf95-a9ad-4442-bb60-875dbce20835",
                                "sense_id": "8d31f1ae-f40f-35e6-b4ae-ee430e85a9aa",
                                "text": "De afleveringen beginnen met een anamnese, een verslag van de symptomen van een patiënt, gevolgd door een differentiaaldiagnose, een lijst aandoeningen waaraan de patiënt zou kunnen lijden. Door de aflevering heen wordt aan de hand van onderzoek en ontwikkeling van het ziektebeeld de lijst steeds aangepast."
                            }
                        ]
                    }
