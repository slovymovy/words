    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6a6a68d5-11f6-3052-93d9-1aebc79c97be",
                "word": "suet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "db850227-3f84-4147-b931-1cbfd3db7d9b",
                        "entry_id": "6a6a68d5-11f6-3052-93d9-1aebc79c97be",
                        "tags": [
                            "plural"
                        ],
                        "form": "suets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2527970-333a-3271-aa39-f8c426077913",
                        "entry_id": "6a6a68d5-11f6-3052-93d9-1aebc79c97be",
                        "glosses": [
                            "The fatty tissue that surrounds and protects the kidneys; that of sheep and cattle is used in cooking and in making tallow."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a4789c03-85e5-42dd-a3f7-3f65e3d98838",
                                "sense_id": "e2527970-333a-3271-aa39-f8c426077913",
                                "text": "[T]he ſevvet of oxen […] is alſo good againſt the inflammation of the eares, the ſtupidity and dulneſſe of the teeth, the running of the eyes, the vlcers and rimes of the mouth, and ſtiffneſſe of the neck."
                            },
                            {
                                "example_id": "63b012c9-2abe-4efb-b98a-bbc7bc4559cc",
                                "sense_id": "e2527970-333a-3271-aa39-f8c426077913",
                                "text": "Many seed-eating birds also need animal fat and protein which they obtain from insects, animal carcasses, and suet."
                            },
                            {
                                "example_id": "a205b52f-6268-4c61-aae6-9273b05c3b90",
                                "sense_id": "e2527970-333a-3271-aa39-f8c426077913",
                                "text": "Some jays, chickadees, nuthatches, and titmice regularly feed at suet; others seem never to indulge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "258a3712-0ef0-4487-a52d-5045fbff8f60",
                        "source_entry_id": "6a6a68d5-11f6-3052-93d9-1aebc79c97be",
                        "source_sense_id": "e2527970-333a-3271-aa39-f8c426077913",
                        "source_sense_description": "fat",
                        "target_lang_word": "lůj",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lůj",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d01d62d7-d308-3118-adc5-8817c2e3916f",
                                        "entry_id": "a5315261-ba34-3df2-aca5-5f4058293fbd",
                                        "glosses": [
                                            "živočišný tuk bohatý na nasycené mastné kyseliny, při pokojové teplotě tuhý, nejčastěji získávaný z přežvýkavců"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a772d7e-e8a4-447e-9925-ac5edc14ce16",
                                                "sense_id": "d01d62d7-d308-3118-adc5-8817c2e3916f",
                                                "text": "Mločí syndikát nebude dodávat jenom mloky, ale také veškeré nářadí a krmivo pro mloky, to jest kukuřici, škroboviny, hovězí lůj a cukr pro miliardy přikrmovaných zvířat; dále dopravu, asekuraci, veterinární dohled a tak dále vesměs za nejnižší sazby, které nám zaručí ne-li monopol, tedy aspoň naprostou převahu nad každou budoucí konkurencí, která by chtěla mloky prodávat."
                                            },
                                            {
                                                "example_id": "e182992d-6af2-44c8-970b-df0bf5baa060",
                                                "sense_id": "d01d62d7-d308-3118-adc5-8817c2e3916f",
                                                "text": "Také jsme šli přes náměstí, na nichž samo rozličné ovoce v hojnosti prodávali; item saláty a čerstvé byliny, netoliko v Egyptě rostlé, ale také z Syrie, z Cypru a od jinud po vodě přivezené, bez nedostatku; potom kde samé oleje, loje a jiné tučné věci prodávají; jinde kde mouku, chléb a koláče."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f26422f-ea3a-41d6-9a06-e268de1b8a9b",
                        "source_entry_id": "6a6a68d5-11f6-3052-93d9-1aebc79c97be",
                        "source_sense_id": "e2527970-333a-3271-aa39-f8c426077913",
                        "source_sense_description": "fat",
                        "target_lang_word": "niervet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niervet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "94cd6dc3-35a2-3570-95d3-b5cf6e383311",
                                        "entry_id": "22eeb577-ec9d-3fff-888d-c2d28152c052",
                                        "glosses": [
                                            "glibberige stof, gewonnen uit het weefsel rond de beide organen die bij zoogdieren het bloed zuiveren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fe9ba60-f730-411d-a0a7-00e6da2a1cbe",
                                                "sense_id": "94cd6dc3-35a2-3570-95d3-b5cf6e383311",
                                                "text": "Afgelopen winter was ik in Zuid-Afrika, waar ze ‘braaien’ hebben verheven tot culinaire sport en kunstvorm (er is een Nationale Braaidag, met aartsbisschop Desmond Tutu als beschermheer). Ik at er skilpadjies, oftewel lamslever in niervet, en zogenaamde braaibroodjies en nu moet ik bekennen dat die iets met me deden. Inmiddels maak ik mijn eigen braaibroodjies, een gerecht waaraan ik al redelijk verslaafd ben. Sterker, ik denk erover om een braaibroodjie op mijn arm te laten tatoeëren."
                                            },
                                            {
                                                "example_id": "66e6e4fb-7610-4e24-a499-4f772737083b",
                                                "sense_id": "94cd6dc3-35a2-3570-95d3-b5cf6e383311",
                                                "text": "Al in 1763 staat in The Art of Cookery van Hannah Glasse een recept voor ‘Hamburgh sausages', van rundergehakt met niervet, peper, kruidnagel, nootmuskaat, knoflook, zout, wijn en rum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c21bea15-889c-4f36-8989-53ba7915d3d1",
                        "source_entry_id": "6a6a68d5-11f6-3052-93d9-1aebc79c97be",
                        "source_sense_id": "e2527970-333a-3271-aa39-f8c426077913",
                        "source_sense_description": "fat",
                        "target_lang_word": "suif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc8e3e9-5a82-3ab9-961a-327db4ddefa4",
                                        "entry_id": "136fbf30-4fde-3bc9-9a8f-d78bca3f07ea",
                                        "glosses": [
                                            "Graisse de certains animaux, dont on se sert principalement pour faire des chandelles et des bougies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69181afe-46fa-4814-a485-aa17ed927ff4",
                                                "sense_id": "2bc8e3e9-5a82-3ab9-961a-327db4ddefa4",
                                                "text": "Le suif de mouton mêlé à celui du bœuf, sert à faire des chandelles : on s'en sert pour les pommades & pour les onguents."
                                            },
                                            {
                                                "example_id": "524af2cb-c2b4-43e1-b968-4aa19fc9780d",
                                                "sense_id": "2bc8e3e9-5a82-3ab9-961a-327db4ddefa4",
                                                "text": "Le battant s’ouvrit, et une vieille, protégeant d’une main sèche qui semblait prendre feu la flamme vacillante d’un suif, apparut dans toute l’horreur d’un négligé peu galant."
                                            },
                                            {
                                                "example_id": "a8420cc1-5dd6-471e-bbb6-e3e91257a609",
                                                "sense_id": "2bc8e3e9-5a82-3ab9-961a-327db4ddefa4",
                                                "text": "A travers les plantes et la fournaise des bougies, elle verra parfaitement le défilé. Mais, en attendant, toutes ces flammes répandent une odeur désagréable de suif et de fumée."
                                            },
                                            {
                                                "example_id": "f191f982-4930-41b2-b13f-db80d5261e74",
                                                "sense_id": "2bc8e3e9-5a82-3ab9-961a-327db4ddefa4",
                                                "text": "Ils frappèrent à la porte du 7. Le garçon restait tapi au fond du couloir, et la bougie tremblait si fort dans sa main qu’elle aspergeait le plancher de gouttes de suif."
                                            },
                                            {
                                                "example_id": "ab676d72-0acd-402c-b915-d2535fe81dd0",
                                                "sense_id": "2bc8e3e9-5a82-3ab9-961a-327db4ddefa4",
                                                "text": "Donner du suif à un bâtiment. Enduire sa carène d’un mélange de suif, de brai et de soufre fondus ensemble."
                                            },
                                            {
                                                "example_id": "e6dcbb62-6b35-4a63-af3d-f09322047753",
                                                "sense_id": "2bc8e3e9-5a82-3ab9-961a-327db4ddefa4",
                                                "text": "Arbre à suif, Arbre de Chine dont les graines sont recouvertes d’une huile qui sert à faire des chandelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "022e1126-b566-321e-92be-8dcd55ba6b99",
                                        "entry_id": "136fbf30-4fde-3bc9-9a8f-d78bca3f07ea",
                                        "glosses": [
                                            "Argent."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcb8621d-12ad-3f4c-aa9a-6224fb6f8c14",
                                        "entry_id": "136fbf30-4fde-3bc9-9a8f-d78bca3f07ea",
                                        "glosses": [
                                            "Grabuge."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2696e46-411c-452c-bfa7-422232d6e21d",
                                                "sense_id": "fcb8621d-12ad-3f4c-aa9a-6224fb6f8c14",
                                                "text": "« Monsieur, c’était quinze jours, un mois après le suif à Ferdinand.\n– Ah ! oui, la perte du liquide pleurétique… sacré diable d’animal ! »"
                                            },
                                            {
                                                "example_id": "a814397e-c00a-4357-ae5e-ba309fa34066",
                                                "sense_id": "fcb8621d-12ad-3f4c-aa9a-6224fb6f8c14",
                                                "text": "En cas de suif imprévu, Tony et Dick pouvaient se permettre, avant que le pet soit donné, une prise de champ d’au moins vingt bornes…"
                                            },
                                            {
                                                "example_id": "a741142d-280f-4620-8dd2-9cc8de8eb9e9",
                                                "sense_id": "fcb8621d-12ad-3f4c-aa9a-6224fb6f8c14",
                                                "text": "Alors, qui nous contraint à ce carême forcé ? Qui est responsable de tout ce suif ? Bref, qui escamote le beurre ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
