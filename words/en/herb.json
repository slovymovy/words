    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4898df84-a22d-3180-ac23-09fde0bd656a",
                    "sense_definition": "A green, leafy plant used to add flavor or seasoning to food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plants_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I grow fresh <w>herbs</w> like basil and mint in my kitchen garden.",
                            "target_lang_translations": {
                                "ru": "Я выращиваю на огороде свежую <w>зелень</w>, такую как базилик и мята.",
                                "pl": "W moim przydomowym ogródku hoduję świeże <w>zioła</w>, takie jak bazylia i mięta."
                            }
                        },
                        {
                            "text": "You should add the dried <w>herbs</w> to the sauce early so the flavors can blend.",
                            "target_lang_translations": {
                                "ru": "Сушеные <w>травы</w> следует добавлять в соус пораньше, чтобы ароматы смешались.",
                                "pl": "Powinieneś dodać suszone <w>zioła</w> do sosu wcześniej, aby smaki się połączyły."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fresh herbs",
                        "dried herbs",
                        "herb garden",
                        "mixed herbs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зеленое лиственное растение, используемое для придания вкуса или аромата пище.",
                        "pl": "Zielona, liściasta roślina używana do nadawania smaku lub przyprawiania potraw."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пряная трава",
                                "target_lang_sense_clarification": "растение для приправы"
                            },
                            {
                                "target_lang_word": "зелень",
                                "target_lang_sense_clarification": "свежие листья растений в кулинарии"
                            },
                            {
                                "target_lang_word": "трава",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zioło",
                                "target_lang_sense_clarification": "roślina przyprawowa"
                            },
                            {
                                "target_lang_word": "zioła",
                                "target_lang_sense_clarification": "przyprawa w kuchni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "828b9b67-f37f-3c4d-80d3-8ad32589cd4b",
                    "sense_definition": "A plant used for making medicine or natural remedies.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plants_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many modern medicines were originally derived from natural <w>herbs</w> found in the forest.",
                            "target_lang_translations": {
                                "ru": "Многие современные лекарства были изначально получены из натуральных <w>трав</w>, найденных в лесу.",
                                "pl": "Wiele współczesnych leków pochodzi pierwotnie z naturalnych <w>ziół</w> rosnących w lasach."
                            }
                        },
                        {
                            "text": "She prefers to treat her cold with a tea made from medicinal <w>herbs</w>.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает лечить простуду чаем из лекарственных <w>трав</w>.",
                                "pl": "Ona woli leczyć przeziębienie herbatą zrobioną z <w>ziół leczniczych</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "medicinal plant"
                    ],
                    "common_phrases": [
                        "medicinal herbs",
                        "healing herbs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, используемое для изготовления лекарств или природных лечебных средств.",
                        "pl": "Roślina używana do produkcji leków lub naturalnych środków leczniczych."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лекарственная трава",
                                "target_lang_sense_clarification": "растение с лечебными свойствами"
                            },
                            {
                                "target_lang_word": "целебная трава",
                                "target_lang_sense_clarification": "растение, используемое для лечения"
                            },
                            {
                                "target_lang_word": "трава",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zioło lecznicze",
                                "target_lang_sense_clarification": "roślina o właściwościach leczniczych"
                            },
                            {
                                "target_lang_word": "zioło",
                                "target_lang_sense_clarification": "roślina medyczna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fa2df3c-e46e-3452-8714-ea2185b7a74c",
                    "sense_definition": "A slang term for cannabis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air at the concert was thick with the smell of <w>herb</w>.",
                            "target_lang_translations": {
                                "ru": "Воздух на концерте был пропитан запахом <w>травки</w>.",
                                "pl": "Powietrze na koncercie było gęste od zapachu <w>zioła</w>."
                            }
                        },
                        {
                            "text": "He got in trouble for smoking <w>herb</w> behind the building.",
                            "target_lang_translations": {
                                "ru": "У него были неприятности из-за курения <w>травки</w> за зданием.",
                                "pl": "Wpadł w kłopoty za palenie <w>zioła</w> za budynkiem."
                            }
                        }
                    ],
                    "synonyms": [
                        "cannabis",
                        "marijuana",
                        "weed",
                        "pot",
                        "grass"
                    ],
                    "common_phrases": [
                        "smoke herb"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название марихуаны.",
                        "pl": "Slangowe określenie marihuany."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травка",
                                "target_lang_sense_clarification": "разговорное, уменьшительное"
                            },
                            {
                                "target_lang_word": "трава",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
