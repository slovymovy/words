                        "entry_id": "14ec43cf-e8e1-3530-b881-6cedf33827be",
                        "glosses": [
                            "A player who stands behind the batsman’s wicket ready to catch the ball, or to stump the batsman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a40f0a1-242c-4b83-a090-85ee18110b7f",
                                "sense_id": "83d68883-11e0-3f81-ac4a-b59e74c9f5e8",
                                "text": "England's wicket-keeper in the 50s, he was fearless about standing on the stumps to fastish bowlers[.]"
                            },
                            {
                                "example_id": "453928ac-5058-4c25-931f-14c9867a15f0",
                                "sense_id": "83d68883-11e0-3f81-ac4a-b59e74c9f5e8",
                                "text": "The fielder clad in armour who squats behind the batsman should be respected as a specialist and not treated as a dabbler. The wicketkeeper controls the mood around the pitch. His gloves hold most of the catches, his voice accompanies every appeal. He is the factory foreman, responsible for every ball."
                            }
                        ]
                    }
