                ],
                "senses": [
                    {
                        "sense_id": "ff4ee462-fe96-3ed0-bbe4-faf86084b41e",
                        "entry_id": "60b7e8d8-e9be-3301-a45b-5d7e98ea50ea",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1019b9-ac76-498c-817f-7a862b8678f2",
                                "sense_id": "ff4ee462-fe96-3ed0-bbe4-faf86084b41e",
                                "text": "Frau Paule ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "52c93b67-45b2-45c0-ade6-651e9c08f874",
                                "sense_id": "ff4ee462-fe96-3ed0-bbe4-faf86084b41e",
                                "text": "Herr Paule wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e6a1bfde-e3f1-40b8-b5a3-56554fc26cdb",
                                "sense_id": "ff4ee462-fe96-3ed0-bbe4-faf86084b41e",
                                "text": "Die Paules fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "972a3933-5f05-4bce-93a6-db930f573b7b",
                                "sense_id": "ff4ee462-fe96-3ed0-bbe4-faf86084b41e",
                                "text": "Der Paule trägt nie die Schals, die die Paule ihm strickt."
                            },
                            {
                                "example_id": "7cd97d83-ba54-437a-9a0b-7ec6268a7566",
                                "sense_id": "ff4ee462-fe96-3ed0-bbe4-faf86084b41e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Paule kommt, geht der Herr Paule.“"
                            },
                            {
                                "example_id": "8d9e10bd-cac6-4bab-89be-adfe36e33c52",
                                "sense_id": "ff4ee462-fe96-3ed0-bbe4-faf86084b41e",
                                "text": "Paule kommt und geht."
                            },
                            {
                                "example_id": "545c2337-bb2b-489b-b7e5-f9984dcff4ec",
                                "sense_id": "ff4ee462-fe96-3ed0-bbe4-faf86084b41e",
                                "text": "Paules kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
