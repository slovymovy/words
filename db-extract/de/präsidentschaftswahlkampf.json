                ],
                "senses": [
                    {
                        "sense_id": "7d85748c-932a-3134-83eb-d4dbd24464af",
                        "entry_id": "fbb87fb5-b2c5-3268-bae2-8c27b1853a09",
                        "glosses": [
                            "das Werben von Kandidaten um Wählerstimmen anlässlich einer Präsidentenwahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd1b9d5-f92b-474d-af18-ecfcfbbc6152",
                                "sense_id": "7d85748c-932a-3134-83eb-d4dbd24464af",
                                "text": "„Die Reporter Manhattans halten Bloomberg vor, nach einer glänzenden ersten Amtszeit, den Jahren bürokratiefreien Handelns, di cde zweite Amtszeit verschwendet zu haben für seine Ambitionen, in den Präsidentschaftswahlkampf einzusteigen.“"
                            },
                            {
                                "example_id": "79094ef7-af83-440a-b0f3-cd37802af79d",
                                "sense_id": "7d85748c-932a-3134-83eb-d4dbd24464af",
                                "text": "„Schon im Präsidentschaftswahlkampf beklagte der Politiker, dass er und seine Familie ausspioniert worden seien.“"
                            },
                            {
                                "example_id": "e9bfe30b-2fd1-4468-8a74-bc4076c96452",
                                "sense_id": "7d85748c-932a-3134-83eb-d4dbd24464af",
                                "text": "„Den Präsidentschaftswahlkampf, aus dem Franklin D. Rooseveld erneut als Sieger hervorgehen wird, begleitet er mit Pessimismus.“"
                            },
                            {
                                "example_id": "26f05c3a-cc27-47a4-b8b7-52804d0f52c9",
                                "sense_id": "7d85748c-932a-3134-83eb-d4dbd24464af",
                                "text": "„Es war ein beispielloser Vorgang, als der damalige Armeechef General Zvinavashe gemeinsam mit anderen hohen Offizieren im Präsidentschaftswahlkampf 2002 vor die Fernsehkameras trat und bekannt gab, dass die Armee nur einen Präsidenten akzeptieren würde, der im Unabhängigkeitskrieg aktiv gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
