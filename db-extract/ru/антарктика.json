                ],
                "senses": [
                    {
                        "sense_id": "34e4267e-b720-38cc-96ee-5680b87e296c",
                        "entry_id": "8387eede-0470-3167-8223-4a12968496da",
                        "glosses": [
                            "геогр. южная полярная область Земли, включающая Антарктиду и прилегающие к ней участки Атлантического, Индийского и Тихого океанов (иногда эти части океанов выделяют в отдельный Южный океан)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed284f7-edaa-4082-be43-c6b3ad25936e",
                                "sense_id": "34e4267e-b720-38cc-96ee-5680b87e296c",
                                "text": "По названию этого материка ледяная зона стала именоваться Антарктикой. В нее входит Антарктида и широкая полоса окружающего ее Южного океана с находящимися там островами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eacd6af-ea5e-437d-b975-027a4c0bc2be",
                        "source_entry_id": "8387eede-0470-3167-8223-4a12968496da",
                        "source_sense_id": "34e4267e-b720-38cc-96ee-5680b87e296c",
                        "target_lang_word": "Antarctic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antarctic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b7b1d0b-6fd3-3d5b-8cef-1e8ac10f5adc",
                                        "entry_id": "3b7e3595-bde0-3582-a497-8aaf42400a33",
                                        "glosses": [
                                            "Of, from, or pertaining to Antarctica and the south polar regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc429400-311a-48f7-8084-01b3b7e6a7e1",
                                                "sense_id": "6b7b1d0b-6fd3-3d5b-8cef-1e8ac10f5adc",
                                                "text": "We are likely to consider Antarctic English as an occupational variety of general English rather than a new regional variety, mainly because men go to work in the Antarctic for a period, intending to return. They are not settlers."
                                            },
                                            {
                                                "example_id": "56319c27-826b-4c5b-897e-72cd9d3e9de1",
                                                "sense_id": "6b7b1d0b-6fd3-3d5b-8cef-1e8ac10f5adc",
                                                "text": "Scientists have known for years that the Thwaites glacier is the soft underbelly of the Antarctic ice sheet, and first found that it was unstable decades ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "616c3ffa-f385-30f5-8a84-d42e86800d6e",
                                        "entry_id": "3b7e3595-bde0-3582-a497-8aaf42400a33",
                                        "glosses": [
                                            "Opposite, contradictory."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72790ba4-e3bd-38a4-822d-6f5c72597b03",
                                        "entry_id": "3b7e3595-bde0-3582-a497-8aaf42400a33",
                                        "glosses": [
                                            "Southern."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Antarctic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79e39b4e-18b1-309c-beda-2199802419eb",
                                        "entry_id": "e45d3f19-f4cb-3ccc-b3ed-aefe07c0b3ea",
                                        "glosses": [
                                            "A continental region, one of the major ecozones of the world, covering the south polar regions, especially those south of the Antarctic Convergence; or, in accordance with the Antarctic Treaty System, the 60th parallel south."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f696dd6-20c8-4bae-a199-60c70789169a",
                        "source_entry_id": "8387eede-0470-3167-8223-4a12968496da",
                        "source_sense_id": "34e4267e-b720-38cc-96ee-5680b87e296c",
                        "target_lang_word": "Antarktis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antarktis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f81f8b1-4dcb-335e-8001-0f41a7c1540b",
                                        "entry_id": "fbb87cae-f734-3880-8b3a-632dca6bb1c3",
                                        "glosses": [
                                            "Kontinent der Erde, Gebiet um den Südpol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "721ed93c-ae95-4fb8-b03b-ba57cc74aa2e",
                                                "sense_id": "7f81f8b1-4dcb-335e-8001-0f41a7c1540b",
                                                "text": "In der Antarktis werden regelmäßig Wetter- und Klimadaten erhoben."
                                            },
                                            {
                                                "example_id": "a9104c3b-7ac9-4ac0-8e93-18785306c5f7",
                                                "sense_id": "7f81f8b1-4dcb-335e-8001-0f41a7c1540b",
                                                "text": "Die Eisdecke der Antarktis ist in Polnähe bis zu 4000 m dick."
                                            },
                                            {
                                                "example_id": "d7adaef0-a39a-4b05-b90b-232ee93e4f94",
                                                "sense_id": "7f81f8b1-4dcb-335e-8001-0f41a7c1540b",
                                                "text": "„Das Katzenkrokodil (Pakasuchus kapilimai) ernährte sich von kleinen Tieren und lebte auf dem ehemaligen Südkontinent Gondwana, der sich später in Afrika; Arabien; Südamerika, die Antarktis, Indien und Australien teilte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c4a10e2-f86f-462f-9c7b-e172f6b7c490",
                        "source_entry_id": "8387eede-0470-3167-8223-4a12968496da",
                        "source_sense_id": "34e4267e-b720-38cc-96ee-5680b87e296c",
                        "target_lang_word": "Antarktyka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antarktyka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "440ef15b-4089-38a2-913c-af66602740f4",
                                        "entry_id": "e5ff404a-b856-334a-a207-d1d49f1f33ed",
                                        "glosses": [
                                            "rejon globu ziemskiego od bieguna południowego do 60° szerokości geograficznej południowej, obejmujący Antarktydę, jej lądolód oraz otaczające je wody"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c68e87-600c-4c19-9ecc-1c8c5562c63f",
                                                "sense_id": "440ef15b-4089-38a2-913c-af66602740f4",
                                                "text": "Sowy spotyka się na całym świecie z wyjątkiem Antarktyki, większej części Grenlandii i innych odległych wysp"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
