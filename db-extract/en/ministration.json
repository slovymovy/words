                                                "example_id": "fe9639f1-d5e6-4758-b727-2945096d5e97",
                                                "sense_id": "1f47a0cd-d020-3a62-a669-30179dc52d2e",
                                                "text": "Ücret hizmet mukabilidir."
                                            }
                                        ]
