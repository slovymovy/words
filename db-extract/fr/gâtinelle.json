                        "glosses": [
                            "Sorte d'ancienne coiffe féminine des paysannes de la Gâtine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c0f181-92e0-4af3-9460-25b7e7cc0278",
                                "sense_id": "712a6f42-f4bd-3ae1-8240-426a36a079ad",
                                "text": "L'autre grande place de Parthenay, […], comme tous les mercredis grouillait de paysans en blouses bleues toutes neuves rêches comme des chasubles, de paysannes arborant sur leurs têtes leurs gâtinelles aux longs rubans de moire blanche, de maquignons, leurs fouets autour du cou, des bouviers, l'aiguillon à la main comme une lance, […]."
                            },
                            {
                                "example_id": "8a4d75e6-20e1-4b5a-89ff-61af113b8e0d",
                                "sense_id": "712a6f42-f4bd-3ae1-8240-426a36a079ad",
                                "text": "A part une gâtinelle, hors série, la septième vitrine est consacrée aux coiffes de Pornic et de l'île de Ré."
                            }
                        ]
                    }
