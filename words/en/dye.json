{
    "word_family": [
        "dyer",
        "dyestuff",
        "dyeing",
        "tie-dye",
        "redye"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "034e3b6f-c8ba-3555-9454-cb0ea23891df",
                    "sense_definition": "To change the colour of something, especially hair or cloth, using a special liquid or substance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You look different. Have you had your hair <w>dyed</w>?",
                            "target_lang_translations": {
                                "ru": "Ты выглядишь иначе. Ты <w>покрасила</w> волосы?",
                                "zh": "你看起来不一样了，你<w>染</w>头发了吗？"
                            }
                        },
                        {
                            "text": "She decided to <w>dye</w> her white dress a deep blue for the wedding.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>покрасить</w> своё белое платье в тёмно-синий цвет к свадьбе.",
                                "zh": "她决定为婚礼把白裙子<w>染</w>成深蓝色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tint",
                        "stain",
                        "color"
                    ],
                    "common_phrases": [
                        "dye hair",
                        "dye fabric",
                        "dye clothes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять цвет чего-либо, особенно волос или ткани, с помощью специальной жидкости или вещества.",
                        "zh": "改变某物的颜色，特别是头发或布料，使用特殊的液体或物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красить",
                                "target_lang_sense_clarification": "изменять цвет"
                            },
                            {
                                "target_lang_word": "окрашивать",
                                "target_lang_sense_clarification": "придавать цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "染",
                                "target_lang_sense_clarification": "改变颜色"
                            },
                            {
                                "target_lang_word": "染色",
                                "target_lang_sense_clarification": "使着色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f03d96b-c86b-3a18-ba5c-cc6da78f926b",
                    "sense_definition": "A substance used to change the colour of something, such as hair, textile fibers, or food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a box of permanent hair <w>dye</w> at the pharmacy.",
                            "target_lang_translations": {
                                "ru": "Она купила коробку стойкой <w>краски</w> для волос в аптеке.",
                                "zh": "她在药店买了一盒永久性<w>染发剂</w>。"
                            }
                        },
                        {
                            "text": "The factory uses a natural vegetable <w>dye</w> to color the cotton shirts.",
                            "target_lang_translations": {
                                "ru": "Фабрика использует натуральный растительный <w>краситель</w> для окрашивания хлопковых рубашек.",
                                "zh": "工厂使用天然植物<w>染料</w>来给棉衬衫上色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "colourant",
                        "stain",
                        "pigment",
                        "tint"
                    ],
                    "common_phrases": [
                        "hair dye",
                        "natural dye",
                        "vegetable dye",
                        "red dye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, используемое для изменения цвета чего-либо, например волос, текстильных волокон или еды.",
                        "zh": "用于改变某物颜色的物质，如头发、纺织纤维或食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краска",
                                "target_lang_sense_clarification": "вещество для окрашивания"
                            },
                            {
                                "target_lang_word": "краситель",
                                "target_lang_sense_clarification": "химическое вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "染料",
                                "target_lang_sense_clarification": "用于染色的物质"
                            },
                            {
                                "target_lang_word": "染发剂",
                                "target_lang_sense_clarification": "专门用于头发的染料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "625ba081-a8cf-398c-9dd0-a24e496b9066",
                    "sense_definition": "Any hue or color produced by or resembling a colouring substance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunset cast a brilliant crimson <w>dye</w> across the western sky.",
                            "target_lang_translations": {
                                "ru": "Закат окрасил западную часть неба в ярко-малиновый <w>цвет</w>.",
                                "zh": "夕阳在西边的天空中投下了一抹绚丽的深红<w>色彩</w>。"
                            }
                        },
                        {
                            "text": "The autumn leaves took on a golden <w>dye</w> before falling.",
                            "target_lang_translations": {
                                "ru": "Осенние листья приобрели золотистый <w>оттенок</w> перед тем, как опасть.",
                                "zh": "秋叶在落下前呈现出一种金黄的<w>色调</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tint",
                        "shade"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой оттенок или цвет, создаваемый красящим веществом или напоминающий его.",
                        "zh": "由染色物质产生或类似染色物质的任何色调或颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "цветовой тон"
                            },
                            {
                                "target_lang_word": "краска",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "色调",
                                "target_lang_sense_clarification": "色彩的倾向"
                            },
                            {
                                "target_lang_word": "色彩",
                                "target_lang_sense_clarification": "颜色表现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4397266-02a1-3071-b3a3-4706eaf5acd9",
                    "sense_definition": "Archaic spelling of <w>die</w> (a small cube marked with spots used in games of chance).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gambler cast the <w>dye</w> onto the table and waited for his luck to turn.",
                            "target_lang_translations": {
                                "ru": "Игрок бросил <w>кость</w> на стол и стал ждать, когда ему улыбнётся удача.",
                                "zh": "赌徒把<w>骰子</w>掷在桌上，等待着转运。"
                            }
                        },
                        {
                            "text": "In the old manuscript, the game piece was referred to as a <w>dye</w>.",
                            "target_lang_translations": {
                                "ru": "В старой рукописи эта игровая фигура называлась <w>костью</w>.",
                                "zh": "在旧手稿中，这个游戏棋子被称为<w>骰子</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "spelling"
                        },
                        {
                            "trait_type": "form",
                            "comment": "variant spelling of die"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова die (игральная кость).",
                        "zh": "die 的古拼写（一种用于博弈的小立方体）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игральная кость",
                                "target_lang_sense_clarification": "предмет для игры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骰子",
                                "target_lang_sense_clarification": "博弈用具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0a7600fc-f76f-308a-ba62-d098669c3e29",
