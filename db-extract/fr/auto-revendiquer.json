                        "sense_id": "4886aed0-0b8d-33bc-97b0-6256b589c126",
                        "entry_id": "34f81638-6e68-3e0b-8498-7adbb79af8d2",
                        "glosses": [
                            "Se revendiquer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6693ee-8b2b-4ae0-8e91-995c01a2f312",
                                "sense_id": "4886aed0-0b8d-33bc-97b0-6256b589c126",
                                "text": "Il s’auto-revendique d’un mouvement « noise / bat les couilles » pas très défini."
                            },
                            {
                                "example_id": "bd6df081-29bb-4c58-8af1-bf847cc40d44",
                                "sense_id": "4886aed0-0b8d-33bc-97b0-6256b589c126",
                                "text": "En France, de manière quasi-simultanée avec ce qui se produit en Angleterre ou aux États-Unis, les années 1976-1978 voient émerger une multitude de formations musicales qui s'auto-revendiquent et / ou sont désignées comme « punk » et se caractérisent par leur position revendiquée de rupture violente anti-establishment et anti-hippies, le dynamitage des codes musicaux ainsi que l'adoption, pour une bonne partie, de la langue française comme expression de leur contestation."
                            },
                            {
                                "example_id": "56588204-0368-4aab-a647-85065d764ca9",
                                "sense_id": "4886aed0-0b8d-33bc-97b0-6256b589c126",
                                "text": "Je m'auto-revendique, vis-à-vis de moi-même, comme étant plus arabo-musulman qu'occidental, que je ne suis pas."
                            }
                        ]
                    }
