{
    "word_family": [
        "prevent",
        "preventable",
        "preventative",
        "preventer",
        "preventive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "337f8248-467e-3cb4-a7fb-fd1613511a27",
                    "sense_definition": "The act of stopping something from happening or of hindering an action or access.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prevention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local government launched a new fire <w>prevention</w> campaign to educate citizens about safety.",
                            "target_lang_translations": {
                                "ru": "Местные власти запустили новую кампанию по <w>предотвращению</w> пожаров, чтобы обучить граждан правилам безопасности.",
                                "zh": "当地政府发起了一项新的消防<w>预防</w>运动，以向市民普及安全知识。"
                            }
                        },
                        {
                            "text": "Effective crime <w>prevention</w> requires cooperation between the police and the local community.",
                            "target_lang_translations": {
                                "ru": "Эффективное <w>предупреждение</w> преступности требует сотрудничества между полицией и местным сообществом.",
                                "zh": "有效的犯罪<w>预防</w>需要警方与当地社区之间的合作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obstruction",
                        "thwarting",
                        "hindrance",
                        "stoppage"
                    ],
                    "antonyms": [
                        "assistance",
                        "promotion",
                        "facilitation"
                    ],
                    "common_phrases": [
                        "crime prevention",
                        "fire prevention",
                        "prevention of cruelty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по остановке чего-либо или препятствование действию или доступу.",
                        "zh": "阻止某事发生或阻碍某项行动或进入的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предотвращение",
                                "target_lang_sense_clarification": "недопущение события"
                            },
                            {
                                "target_lang_word": "предупреждение",
                                "target_lang_sense_clarification": "заблаговременное пресечение"
                            },
                            {
                                "target_lang_word": "пресечение",
                                "target_lang_sense_clarification": "остановка начавшегося действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预防",
                                "target_lang_sense_clarification": "事先采取措施防止发生"
                            },
                            {
                                "target_lang_word": "防止",
                                "target_lang_sense_clarification": "采取行动阻止某事发生"
                            },
                            {
                                "target_lang_word": "阻止",
                                "target_lang_sense_clarification": "阻碍某事进行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d44535e8-44be-3e04-9b6b-19081d7b7a06",
                    "sense_definition": "Measures taken to reduce health risks, such as vaccinations, screenings, or educational programs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "prevention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern medicine focuses heavily on disease <w>prevention</w> rather than just treating symptoms.",
                            "target_lang_translations": {
                                "ru": "Современная медицина в значительной степени ориентирована на <w>профилактику</w> заболеваний, а не только на лечение симптомов.",
                                "zh": "现代医学非常注重疾病的<w>预防</w>，而不仅仅是治疗症状。"
                            }
                        },
                        {
                            "text": "The clinic provides resources for the <w>prevention</w> of drug abuse among teenagers.",
                            "target_lang_translations": {
                                "ru": "Клиника предоставляет ресурсы для <w>профилактики</w> наркомании среди подростков.",
                                "zh": "该诊所提供有关青少年药物滥用<w>预防</w>的资源。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prophylaxis"
                    ],
                    "common_phrases": [
                        "disease prevention",
                        "drug abuse prevention",
                        "relapse prevention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Меры, принимаемые для снижения рисков для здоровья, такие как вакцинация, обследования или образовательные программы.",
                        "zh": "为降低健康风险而采取的措施，如疫苗接种、筛查或教育项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "профилактика",
                                "target_lang_sense_clarification": "медицинские или социальные меры"
                            },
                            {
                                "target_lang_word": "предупреждение",
                                "target_lang_sense_clarification": "недопущение болезни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预防",
                                "target_lang_sense_clarification": "针对疾病或问题的防范措施"
                            },
                            {
                                "target_lang_word": "防范",
                                "target_lang_sense_clarification": "针对风险的防备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "831b62d4-b018-319b-b39d-2dd14620baa8",
                    "sense_definition": "The act of taking precautions or using forethought to avoid potential problems.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prevention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By way of <w>prevention</w>, he checked the weather forecast before planning the outdoor event.",
                            "target_lang_translations": {
                                "ru": "В качестве <w>предосторожности</w> он проверил прогноз погоды перед планированием мероприятия на открытом воздухе.",
                                "zh": "作为一种<w>预防措施</w>，他在计划户外活动前查看了天气预报。"
                            }
                        },
                        {
                            "text": "Taking a few minutes for <w>prevention</w> now can save hours of repair work later.",
                            "target_lang_translations": {
                                "ru": "Уделив несколько минут <w>предупреждению</w> проблем сейчас, можно сэкономить часы ремонтных работ позже.",
                                "zh": "现在花几分钟时间进行<w>预防</w>，以后可以节省数小时的维修工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "precaution",
                        "forethought",
                        "anticipation"
                    ],
                    "antonyms": [
                        "negligence",
                        "improvisation"
                    ],
                    "common_phrases": [
                        "way of prevention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принятие мер предосторожности или использование предусмотрительности во избежание потенциальных проблем.",
                        "zh": "为避免潜在问题而采取预防措施或预先考虑的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предосторожность",
                                "target_lang_sense_clarification": "заблаговременные меры"
                            },
                            {
                                "target_lang_word": "предупреждение",
                                "target_lang_sense_clarification": "избежание проблем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预防措施",
                                "target_lang_sense_clarification": "为避免问题而采取的行动"
                            },
                            {
                                "target_lang_word": "防备",
                                "target_lang_sense_clarification": "预先做好准备以应对可能的问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30b43f3d-1773-39a5-8a5f-4740c0031c91",
                    "sense_definition": "The state of preceding or going before something else in time or sequence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "precedence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the case of thunder and lightning, the <w>prevention</w> of the flash before the sound is easily observed.",
                            "target_lang_translations": {
                                "ru": "В случае грома и молнии легко наблюдается <w>предшествование</w> вспышки звуку.",
                                "zh": "在雷电天气中，闪电<w>先于</w>雷声发生这一现象很容易观察到。"
                            }
                        },
                        {
                            "text": "The historical <w>prevention</w> of one event over another helped establish the timeline.",
                            "target_lang_translations": {
                                "ru": "Историческое <w>предшествование</w> одного события другому помогло составить хронологию.",
                                "zh": "一个事件在历史上<w>先于</w>另一个事件发生，这有助于确定时间线。"
                            }
                        }
                    ],
                    "synonyms": [
                        "precedence",
                        "priority"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean precedence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние предшествования чему-либо во времени или последовательности.",
                        "zh": "在时间或顺序上先于某事发生的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предшествование",
                                "target_lang_sense_clarification": "первенство во времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先行",
                                "target_lang_sense_clarification": "在时间上先于其他事物"
                            },
                            {
                                "target_lang_word": "先于",
                                "target_lang_sense_clarification": "在顺序上排在前面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}