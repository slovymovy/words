                                "target_senses": [
                                    {
                                        "sense_id": "79e604ac-cdf4-3ed9-9932-9a1021209f1a",
                                        "entry_id": "9f273146-534b-3e4e-b184-2211b5c579ca",
                                        "glosses": [
                                            "weefsel van worteldraadjes waarmee een zwam voedsel uit zijn omgeving haalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6d8519-2aa9-475e-83e1-2bb27338b4ae",
                                                "sense_id": "79e604ac-cdf4-3ed9-9932-9a1021209f1a",
                                                "text": "Als je geluk hebt, vind je geprepareerde blokken stro of houtvezels in de winkel, dooraderd met een netwerk van witte draden: het mycelium ofwel de schimmel in een eindstadium. Thuis komen er als een wonder zwammen uit groeien."
                                            }
                                        ]
                                    }
