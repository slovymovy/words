                    {
                        "translation_id": "688c27c5-6a34-46b3-b27e-d88d267c1e13",
                        "source_entry_id": "a6ef91e2-1103-33e5-ad04-2e57e1f7a939",
                        "source_sense_id": "9d6c2879-8c98-398e-a7ae-e687a69ad13c",
                        "source_sense_description": "a technique for recording, and then reconstructing, the amplitude and phase distributions of a coherent wave disturbance",
                        "target_lang_word": "Holografie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holografie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d256281e-80c2-3854-9d32-b2a8834d3fed",
                                        "entry_id": "db6234f0-34de-3f20-8674-c67e27122c4b",
                                        "glosses": [
                                            "technische Methode, mit der dreidimensionale Bilder hergestellt, gespeichert und wiedergegeben werden können"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb60440-6295-468c-b6fd-7e6ead7d658d",
                                                "sense_id": "d256281e-80c2-3854-9d32-b2a8834d3fed",
                                                "text": "„Die Holografie ist demnach ein zweistufiges Verfahren zur Aufzeichnung und räumlichen Wiedergabe von Bildern beliebiger Gegenstände, das im Prinzip keine Linsen erfordert.“"
                                            },
                                            {
                                                "example_id": "96668c56-b005-4bb7-b838-229ed0ecd20d",
                                                "sense_id": "d256281e-80c2-3854-9d32-b2a8834d3fed",
                                                "text": "„Erfunden wurde die Methode der Holografie im Jahre 1948 durch den ungarischen Physiker Dennis Gabor in London.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fbd0e571-5c86-3bb4-bd7d-19f68b8d7a11",
                                        "entry_id": "db6234f0-34de-3f20-8674-c67e27122c4b",
                                        "glosses": [
                                            "durch [1] erzeugtes dreidimensionales Bild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d084d561-7df3-45c9-ac6c-cc5f97ae7461",
                                                "sense_id": "fbd0e571-5c86-3bb4-bd7d-19f68b8d7a11",
                                                "text": "„In vier Minuten schildert Hans Rosling anhand einer Art Holografie, wie sich in den letzten 200 Jahren Lebenserwartung und Wohlstand der Weltbevölkerung verändert haben.“"
                                            },
                                            {
                                                "example_id": "ca71b1d6-3c12-4553-a566-95bb9b4b5236",
                                                "sense_id": "fbd0e571-5c86-3bb4-bd7d-19f68b8d7a11",
                                                "text": "„Um den Körper des gealterten Moraners strahlten die Holografien Tausender Sterne, großer Planeten.“"
                                            },
                                            {
                                                "example_id": "47a315dd-e784-411e-b05e-3c0d001b6c62",
                                                "sense_id": "fbd0e571-5c86-3bb4-bd7d-19f68b8d7a11",
                                                "text": "„Im Inneren des Fahrzeugs gab es auch eine Möglichkeit, Holografien in erstklassiger Qualität darzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16d6174d-97eb-4b32-8881-3e13bee4a819",
                        "source_entry_id": "a6ef91e2-1103-33e5-ad04-2e57e1f7a939",
                        "source_sense_id": "9d6c2879-8c98-398e-a7ae-e687a69ad13c",
                        "source_sense_description": "a technique for recording, and then reconstructing, the amplitude and phase distributions of a coherent wave disturbance",
                        "target_lang_word": "Holographie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holographie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79c6ff52-b841-3342-8541-d46b83196424",
                                        "entry_id": "69513ca3-64db-3688-ba88-d126fc058c5b",
                                        "glosses": [
                                            "technische Methode, mit der dreidimensionale Bilder hergestellt, gespeichert und wiedergegeben werden können"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6631d5ed-a0f9-45c7-9ac5-00b0eed81284",
                                                "sense_id": "79c6ff52-b841-3342-8541-d46b83196424",
                                                "text": "„Der Vorteil der traditionellen Holographie liegt darin, dass die 3D-Bilder von hoher Qualität sind und ohne optische Systeme betrachtet werden können.“"
                                            },
                                            {
                                                "example_id": "47f78366-3eea-4b39-8854-fa44870eba73",
                                                "sense_id": "79c6ff52-b841-3342-8541-d46b83196424",
                                                "text": "„Seit der Erfindung der Holographie 1958 durch den Ungarisch-Britischen Physiker Denis Gabor hat die Technik eine enorme Evolution durchlaufen und es gibt heute eine Vielzahl holografischer Techniken.“"
                                            },
                                            {
                                                "example_id": "33388ec1-5f06-4c62-97dd-348d0940bb8c",
                                                "sense_id": "79c6ff52-b841-3342-8541-d46b83196424",
                                                "text": "„Möglich wird die Holographie dadurch, daß nach dem Huyghensschen Prinzip aus der gegebenen Verteilung der Feldstärke eines Wellenfeldes in einer Ebene das Lichtwellenfeld im ganzen Raum bestimmt werden kann.“"
                                            },
                                            {
                                                "example_id": "5930dd22-6035-4f01-bff2-f6537471c089",
                                                "sense_id": "79c6ff52-b841-3342-8541-d46b83196424",
                                                "text": "„Ziel der Holographie ist es, in einem zweidimensionalen Bildspeicher die vollständige optische Information über ein dreidimensionales Objekt zu speichern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "029840e7-26c3-3eea-8ca2-28f8ed903fd3",
                                        "entry_id": "69513ca3-64db-3688-ba88-d126fc058c5b",
                                        "glosses": [
                                            "durch [1] erzeugtes dreidimensionales Bild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3be7bb1-0235-4475-8c4d-20056a63e6ea",
                                                "sense_id": "029840e7-26c3-3eea-8ca2-28f8ed903fd3",
                                                "text": "„Der Computer benutzte Grüntöne, um mit Holographien innerhalb der Cockpitkuppel die Geländeverhältnisse draußen wiederzugeben.“"
                                            },
                                            {
                                                "example_id": "92ccedeb-6298-4d5d-8814-b86048af3820",
                                                "sense_id": "029840e7-26c3-3eea-8ca2-28f8ed903fd3",
                                                "text": "„Bei der Holographie hingegen, bekannt durch die Holographien auf den Geldscheinen, wird der Gegenstand aus mehreren Winkeln zu unterschiedlichen Zeiten aufgenommen.“"
                                            },
                                            {
                                                "example_id": "06c58ddf-a440-442d-a5c0-142ef8ee0536",
                                                "sense_id": "029840e7-26c3-3eea-8ca2-28f8ed903fd3",
                                                "text": "„Sie plädieren für den Einsatz von Projektoren, mit denen sich riesige farbige Holographien in die Wolken malen ließen, um den Gegner zu verwirren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
