                        "glosses": [
                            "Personne sans emploi ne poursuivant pas d'études et ne suivant pas de formation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9fb9c1-7ea0-4219-b055-5e2fb3e73088",
                                "sense_id": "3aa4fb55-e202-353f-9d7c-d021f704f2bf",
                                "text": "La catégorie des NEETs englobe diverses situations, certaines temporaires, notamment les chômeurs, les jeunes diplômés à la recherche d’un emploi, ceux en transition, les personnes malades, handicapées ou ayant des responsabilités familiales, ainsi que les jeunes marginalisés."
                            }
                        ]
