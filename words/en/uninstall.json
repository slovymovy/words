{
    "word_family": [
        "installation",
        "installer",
        "install"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f00d2674-4dc3-3790-b79c-1aca7de2ce51",
                    "sense_definition": "To completely remove software or hardware from a computer system.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "software_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>uninstall</w> any programs that you no longer use to free up space.",
                            "target_lang_translations": {
                                "zh": "你应该<w>卸载</w>掉不再使用的程序以腾出空间。"
                            }
                        },
                        {
                            "text": "It is often necessary to <w>uninstall</w> the old version before installing the new update.",
                            "target_lang_translations": {
                                "zh": "在安装新更新之前，通常需要先<w>卸载</w>旧版本。"
                            }
                        }
                    ],
                    "synonyms": [
                        "remove",
                        "delete"
                    ],
                    "antonyms": [
                        "install"
                    ],
                    "common_phrases": [
                        "uninstall software",
                        "uninstall program"
                    ],
                    "target_lang_definitions": {
                        "zh": "从计算机系统中彻底删除软件或硬件。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卸载",
                                "target_lang_sense_clarification": "指从计算机中移除已安装的软件程序。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83100e91-beda-3e86-afaf-27e96947be29",
                    "sense_definition": "The process of removing software or hardware from a computer system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "software_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>uninstall</w> process took much longer than I expected.",
                            "target_lang_translations": {
                                "zh": "<w>卸载</w>过程花费的时间比我预期的要长得多。"
                            }
                        },
                        {
                            "text": "If the automatic <w>uninstall</w> fails, you may need to remove the files manually.",
                            "target_lang_translations": {
                                "zh": "如果自动<w>卸载</w>失败，你可能需要手动删除这些文件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "removal",
                        "uninstallation"
                    ],
                    "antonyms": [
                        "installation"
                    ],
                    "common_phrases": [
                        "complete uninstall",
                        "manual uninstall"
                    ],
                    "target_lang_definitions": {
                        "zh": "从计算机系统中移除软件或硬件的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卸载",
                                "target_lang_sense_clarification": "指执行移除软件这一操作的过程。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}