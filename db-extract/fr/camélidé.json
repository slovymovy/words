                        "entry_id": "72a2d82a-ddb7-33e8-92ff-72a69631f0c0",
                        "glosses": [
                            "Tout animal de la famille des Camelidae, ruminants des régions arides, tels que le chameau ou le lama."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76058407-e6af-4ea0-bc44-8372c6448613",
                                "sense_id": "b3d9a029-caf9-3573-91b7-18cd4896ab2e",
                                "text": "Les camélidés appartiennent au sous-ordre des ruminants et à la sous-classe des mammifères vertébrés placentaires."
                            },
                            {
                                "example_id": "4a2e714e-4ea5-4be9-8fb8-9519bff7b7fb",
                                "sense_id": "b3d9a029-caf9-3573-91b7-18cd4896ab2e",
                                "text": "L'été de ses seize ans il avait parcouru toutes les plages de la Côte d'Azur à dos de chameau, vantant le pastis Ricard dont la publicité s'affichait sur un tissu accroché aux flancs du camélidé."
                            }
                        ]
                    }
