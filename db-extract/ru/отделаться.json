                        "entry_id": "2f108b5c-698f-3db4-a9a1-ab63691f07f8",
                        "glosses": [
                            "to get rid (of), to get away (from), to throw off, to shake off, to be through (with), to finish (with)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e108bf2e-1660-4d8a-af7a-1cf5a47c2c9f",
                                "sense_id": "181b545f-147f-3ad5-8a3e-571e8c75ccb3",
                                "text": "не могу́ отде́латься от впечатле́ния",
                                "translation": "I can't shake off [get away from] the impression",
                                "english": "I can't shake off [get away from] the impression"
                            }
                        ]
                    },
                    {
                        "sense_id": "f1afaed4-fac2-3c5a-aac8-7270aa716020",
                        "entry_id": "2f108b5c-698f-3db4-a9a1-ab63691f07f8",
