                ],
                "senses": [
                    {
                        "sense_id": "e463bdc8-132d-3d19-933b-5e298aba1eec",
                        "entry_id": "3e60e47e-5c4a-3977-80f1-172fe329f9f5",
                        "glosses": [
                            "ein Trillionstel der Maßeinheit Meter (= 0,000 000 000 000 000 001 Meter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58357cf4-af13-4bb0-b151-ebfbb050f8cd",
                                "sense_id": "e463bdc8-132d-3d19-933b-5e298aba1eec",
                                "text": "Ein Proton oder Neutron hat eine gemessene Länge von 1100 Attometer."
                            },
                            {
                                "example_id": "e0328484-df19-41ac-b5f5-3f70b7d2ff4b",
                                "sense_id": "e463bdc8-132d-3d19-933b-5e298aba1eec",
                                "text": "Mit der Heisenbergschen Unschärfebeziehung lässt sich ausrechnen, dass die Reichweite der schwachen Kraft nur zwei Attometer beträgt."
                            },
                            {
                                "example_id": "a9feb29f-466a-4709-a0bc-be3cac22c437",
                                "sense_id": "e463bdc8-132d-3d19-933b-5e298aba1eec",
                                "text": "Aufgrund seiner großen Masse ist das Top-Quark ein hervorragender Sensor für die Stärke und Struktur der fundamentalen Wechselwirkungen im Attometer-Bereich."
                            },
                            {
                                "example_id": "3f4bdb13-7575-4a13-8faf-1ba4e60bea49",
                                "sense_id": "e463bdc8-132d-3d19-933b-5e298aba1eec",
                                "text": "Die Gitterkonstante des Si-Einheitskristalls wird mit einem kombinierten Röntgen- und optischen Interferometer bestimmt, die derzeit erreichte relative Unsicherheit liegt dabei bei wenigen 10⁻⁹ entsprechend etwas unter einem Attometer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
