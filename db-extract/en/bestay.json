                        "glosses": [
                            "To secure or steady; cause to come to a fixed position or state; bring to a halt or stop."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e0f3a6da-42a3-4a7a-81c1-f343d44d7d42",
                                "sense_id": "b4d4add7-654a-3409-beba-16852f9cc33c",
                                "text": "Mid the half-furrowed field bestay the plough, Bid the twin toilers of the yoke go free, And aught that doth thee patient servitude, From closing sabbath to its blest return, [...]"
                            },
                            {
                                "example_id": "151c159d-b082-4790-ad65-44f509b77ef7",
                                "sense_id": "b4d4add7-654a-3409-beba-16852f9cc33c",
                                "text": "Hereupon the magistrates of the town cried \"Hola, hola, bestay the matter.\""
                            },
                            {
                                "example_id": "4f1256d0-7818-4c9c-84c9-adc79a693bf9",
                                "sense_id": "b4d4add7-654a-3409-beba-16852f9cc33c",
                                "text": "Bestay thee, bestay thee in fighting!"
                            }
                        ]
                    }
