                        "entry_id": "d334c418-24b6-3af0-89ff-5970046abce7",
                        "glosses": [
                            "Toutes sortes de caches destinés à obscurcir, à masquer, tout ou partiellement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "59c3bac8-3e57-4996-abf0-228f2add79e5",
                                "sense_id": "78d09e65-c164-3df3-83f5-8942cb27da69",
                                "text": "Pendant la dernière guerre mondiale, les phares des voitures étaient munis d'obscurateur pour ne pas être vus de trop loin, seul un fin faisceau de lumière pouvait passer"
                            }
                        ]
                    },
