                ],
                "senses": [
                    {
                        "sense_id": "2a494e9a-8631-35ee-a386-d7c84ce3c4a8",
                        "entry_id": "070dfa0e-8cbf-3131-9470-96c4eb4ba3ad",
                        "glosses": [
                            "Diener, der bei einer wohlhabenden Familie (insbesondere in Großbritannien) arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2f2ff2b-b9f1-48e6-bc83-eef80fa2dc07",
                                "sense_id": "2a494e9a-8631-35ee-a386-d7c84ce3c4a8",
                                "text": "Stellen Sie sich vor, meine Liebe, als unser Butler letzte Woche krank war, musste ich selbst ans Telefon gehen, wenn jemand anrief!"
                            },
                            {
                                "example_id": "69d79f8b-195f-48de-a6c8-8f417f46f6f0",
                                "sense_id": "2a494e9a-8631-35ee-a386-d7c84ce3c4a8",
                                "text": "„Natürlich hatte die Gräfin außer dem Butler noch anderes Personal: Zimmermädchen, Koch, Köchin, Gärtner, Zofe, Chauffeur.“"
                            },
                            {
                                "example_id": "3302ed0a-9f87-4fdb-8a9c-94fe67fc78d5",
                                "sense_id": "2a494e9a-8631-35ee-a386-d7c84ce3c4a8",
                                "text": "„Der farbige Butler verbeugte sich stumm und ging.“"
                            },
                            {
                                "example_id": "da98f5ac-cec9-4df7-a354-73b60c062e6b",
                                "sense_id": "2a494e9a-8631-35ee-a386-d7c84ce3c4a8",
                                "text": "„Aber es war ein Diener mit einer Laterne aus dem 18. Jahrhundert da, der mich eine Treppe hinunter (die Stufen waren mit hübschen Teppichen belegt) in eine Kellerwohnung führte, wo ich von einem richtigen Butler im Frack und mit weißen Handschuhen empfangen wurde, der mir den Mantel abnahm und der Gesellschaft meinen Namen verkündete.“"
                            },
                            {
                                "example_id": "3d8159ed-1439-4453-af65-71b4650db532",
                                "sense_id": "2a494e9a-8631-35ee-a386-d7c84ce3c4a8",
                                "text": "„Ein Butler in gestreifter Hose und grüner Samtweste hielt die schwere schmiedeeiserne Tür auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
