    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b40bb6eb-a56f-398b-bd3e-1e2f66b0d947",
                    "sense_definition": "То, что соответствует действительности; истина.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "truth_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу услышать от тебя только <w>правду</w>.",
                            "target_lang_translations": {
                                "en": "I want to hear only the <w>truth</w> from you.",
                                "zh": "我只想听你跟我说<w>真话</w>。"
                            }
                        },
                        {
                            "text": "Горькая <w>правда</w> лучше, чем сладкая ложь.",
                            "target_lang_translations": {
                                "en": "The bitter <w>truth</w> is better than a sweet lie.",
                                "zh": "苦涩的<w>真相</w>总比甜蜜的谎言好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "и́стина"
                    ],
                    "antonyms": [
                        "ложь",
                        "непра́вда",
                        "враньё",
                        "кри́вда"
                    ],
                    "common_phrases": [
                        "говорить правду",
                        "горькая правда",
                        "смотреть правде в глаза"
                    ],
                    "target_lang_definitions": {
                        "en": "That which corresponds to reality; truth.",
                        "zh": "与现实情况相符合的东西；真实情况；不是谎言。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "truth",
                                "target_lang_sense_clarification": "conformity to fact or reality"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真相",
                                "target_lang_sense_clarification": "与事实相符的内容；真相"
                            },
                            {
                                "target_lang_word": "真话",
                                "target_lang_sense_clarification": "真实的话，不是谎言"
                            },
                            {
                                "target_lang_word": "真理",
                                "target_lang_sense_clarification": "哲学或较正式语境中的“真理”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6448ecb1-924c-3401-90cd-2176c89ec0d8",
                    "sense_definition": "Справедливость, порядок, основанный на законе и честности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "justice_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы будем бороться за <w>правду</w> до самого конца.",
                            "target_lang_translations": {
                                "en": "We will fight for <w>justice</w> until the very end.",
                                "zh": "我们会为<w>正义</w>斗争到底。"
                            }
                        },
                        {
                            "text": "В этом споре твоя <w>правда</w>.",
                            "target_lang_translations": {
                                "en": "In this dispute, you are <w>right</w>.",
                                "zh": "在这场争论中，你有<w>道理</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "справедли́вость"
                    ],
                    "antonyms": [
                        "непра́вда",
                        "кри́вда"
                    ],
                    "common_phrases": [
                        "искать правду",
                        "твоя правда"
                    ],
                    "target_lang_definitions": {
                        "en": "Justice, fairness, or order based on law and honesty.",
                        "zh": "基于法律、诚实和公平的正当性；也可指谁有理。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "justice",
                                "target_lang_sense_clarification": "fairness or righteousness"
                            },
                            {
                                "target_lang_word": "truth",
                                "target_lang_sense_clarification": "in the sense of being right or just"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正义",
                                "target_lang_sense_clarification": "公平正当; 值得维护的正义"
                            },
                            {
                                "target_lang_word": "公道",
                                "target_lang_sense_clarification": "公平特别是民间说法中的“讨个公道”"
                            },
                            {
                                "target_lang_word": "道理",
                                "target_lang_sense_clarification": "指在争论中有理、说得对"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c6c8e7a-afd5-3da7-83af-a7e8d4b5f4c3",
                    "sense_definition": "Свод законов и правовых норм в средневековой Руси.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historical_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Русская <w>Правда</w> является важнейшим памятником древнерусского права.",
                            "target_lang_translations": {
                                "en": "Russkaya <w>Pravda</w> is the most important monument of old Russian law.",
                                "zh": "<w>《罗斯法典》</w>是古罗斯法律最重要的文献。"
                            }
                        },
                        {
                            "text": "Студенты изучали статьи из Салической <w>правды</w>.",
                            "target_lang_translations": {
                                "en": "Students studied articles from the Salic <w>Law</w>.",
                                "zh": "学生们学习了《萨利克<w>法典</w>》中的条文。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Русская Правда"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A code of laws and legal norms in medieval Russia.",
                        "zh": "中世纪罗斯的法律汇编或法典名称。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Pravda",
                                "target_lang_sense_clarification": "historical legal code name"
                            },
                            {
                                "target_lang_word": "law code",
                                "target_lang_sense_clarification": "historical context"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "《罗斯法典》",
                                "target_lang_sense_clarification": "《Русская Правда》这一历史法典名称"
                            },
                            {
                                "target_lang_word": "法典",
                                "target_lang_sense_clarification": "泛指中世纪的法律汇编"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "6127573b-0d11-3d75-ba58-04254707170a",
                    "sense_definition": "Действительно, на самом деле (используется для подтверждения истинности).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он и <w>правда</w> очень хороший специалист.",
                            "target_lang_translations": {
                                "en": "He <w>really</w> is a very good specialist.",
                                "zh": "他<w>确实</w>是一位非常优秀的专家。"
                            }
                        },
                        {
                            "text": "На улице <w>правда</w> идёт сильный дождь?",
                            "target_lang_translations": {
                                "en": "Is it <w>really</w> raining hard outside?",
                                "zh": "外面<w>真的</w>下着大雨吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "действи́тельно",
                        "в самом де́ле"
                    ],
                    "target_lang_definitions": {
                        "en": "Indeed, actually (used to confirm the truth of something).",
                        "zh": "确实，实际上；用来确认某事是真的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "emphasizing fact"
                            },
                            {
                                "target_lang_word": "indeed",
                                "target_lang_sense_clarification": "formal confirmation"
                            },
                            {
                                "target_lang_word": "actually",
                                "target_lang_sense_clarification": "in fact"
                            },
                            {
                                "target_lang_word": "in fact",
                                "target_lang_sense_clarification": "phrase indicating reality"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "表示“确实如此”"
                            },
                            {
                                "target_lang_word": "真的",
                                "target_lang_sense_clarification": "表示事实如此，口语常用"
                            },
                            {
                                "target_lang_word": "的确",
                                "target_lang_sense_clarification": "较正式，表示“的确”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ee36972-7cd5-3c7f-9afb-9862a57b2a1d",
                    "sense_definition": "Верно? Не так ли? (используется как вопрос для получения подтверждения).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "question_tag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы ведь пойдём завтра в кино, <w>правда</w>?",
                            "target_lang_translations": {
                                "en": "We are going to the cinema tomorrow, <w>right</w>?",
                                "zh": "我们明天会去看电影，<w>对吧</w>？"
                            }
                        },
                        {
                            "text": "Ты поможешь мне с этим заданием, <w>правда</w>?",
                            "target_lang_translations": {
                                "en": "You will help me with this task, <w>won't you</w>?",
                                "zh": "你会帮我做这个作业，<w>是吧</w>？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "не правда ли"
                    ],
                    "target_lang_definitions": {
                        "en": "Right? Isn't it? (used as a question tag to seek confirmation).",
                        "zh": "对吧？是吧？用于在句末向对方寻求确认。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "question tag"
                            },
                            {
                                "target_lang_word": "isn't it",
                                "target_lang_sense_clarification": "question tag"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对吧",
                                "target_lang_sense_clarification": "句末征求对方确认"
                            },
                            {
                                "target_lang_word": "是吧",
                                "target_lang_sense_clarification": "较口语的句末确认说法"
                            },
                            {
                                "target_lang_word": "不是吗",
                                "target_lang_sense_clarification": "较书面或固定表达中的反问确认"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "2a203d51-aed7-3313-a223-d0ee6f1f2723",
                    "sense_definition": "Хотя, однако, тем не менее (используется для выражения уступки).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Фильм был интересный, <w>правда</w>, немного затянутый.",
                            "target_lang_translations": {
                                "en": "The movie was interesting, <w>though</w> a bit dragged out.",
                                "zh": "这部电影很有意思，<w>不过</w>有点拖沓。"
                            }
                        },
                        {
                            "text": "Мы успели на поезд, <w>правда</w>, нам пришлось бежать.",
                            "target_lang_translations": {
                                "en": "We caught the train, <w>admittedly</w> we had to run.",
                                "zh": "我们赶上了火车，<w>只是</w>一路都得跑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "хотя",
                        "одна́ко",
                        "следует признать"
                    ],
                    "target_lang_definitions": {
                        "en": "Though, however, admittedly (used to express concession).",
                        "zh": "不过、只是、然而；用于表示让步或补充转折。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "though",
                                "target_lang_sense_clarification": "conjunction expressing contrast"
                            },
                            {
                                "target_lang_word": "admittedly",
                                "target_lang_sense_clarification": "conceding a point"
                            },
                            {
                                "target_lang_word": "however",
                                "target_lang_sense_clarification": "nevertheless"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不过",
                                "target_lang_sense_clarification": "表示让步或轻微转折"
                            },
                            {
                                "target_lang_word": "只是",
                                "target_lang_sense_clarification": "表示承认一点但补充说明"
                            },
                            {
                                "target_lang_word": "然而",
                                "target_lang_sense_clarification": "书面些，表示“然而”"
                            }
                        ]
                    }
                }
            ]
        },
        {
