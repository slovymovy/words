                "senses": [
                    {
                        "sense_id": "7ec2a88b-d703-3f5c-97e0-e1dc7d7fb603",
                        "entry_id": "d1eb691f-2cca-3adc-a078-8df779032ec8",
                        "glosses": [
                            "het harde bovenste deel van het wegdek dat bestaat uit losse elementen waardoor de weg water- en gasdoorlatend is."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1d02311-9925-4b5b-8b4a-2d033d16af7b",
                                "sense_id": "7ec2a88b-d703-3f5c-97e0-e1dc7d7fb603",
                                "text": "Een verharde weg heeft een plaveisel van straatstenen of kinderkopjes. Asfalt is dus geen plaveisel."
                            },
                            {
                                "example_id": "2f25e82c-3476-4aab-8a58-fff86caec0dd",
                                "sense_id": "7ec2a88b-d703-3f5c-97e0-e1dc7d7fb603",
                                "text": "Daarachter ontvouwde zich het tweede deel van het plein, als een verborgen surprise, geflankeerd door het onwereldse dogepaleis, dat leek te zweven met twee breekbaar ogende, opengewerkte benedenverdiepingen onder een stoere, middeleeuwse bovenbouw, en de twee zuilen waarachter het plaveisel zonder muurtje, hek, verkeersbord of waarschuwing overging in het water van Canal Grande, de lagune en de open zee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b5c350a-2f13-4e4d-a30a-3fe950d360ad",
                        "source_entry_id": "d1eb691f-2cca-3adc-a078-8df779032ec8",
                        "source_sense_id": "7ec2a88b-d703-3f5c-97e0-e1dc7d7fb603",
                        "target_lang_word": "pavement",
