                "senses": [
                    {
                        "sense_id": "a7c24e60-55bc-3a56-ae77-da552789b66e",
                        "entry_id": "3291386b-6182-32f4-bbf8-d60a78e09cfc",
                        "glosses": [
                            "hohe, senkrechte, pfeilerähnliche Stange, die elektrische Leitungen trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7987daa5-07d3-44ae-823a-06a107d3d014",
                                "sense_id": "a7c24e60-55bc-3a56-ae77-da552789b66e",
                                "text": "Bei dem heftigen Sturm wurden mehrere Strommasten umgerissen."
                            },
                            {
                                "example_id": "b3530d7f-ffe7-4f42-8a9b-0347bb4e2dd9",
                                "sense_id": "a7c24e60-55bc-3a56-ae77-da552789b66e",
                                "text": "„Es war der 25.Juni 1967, als in der Nacht auf der Porzescharte der Strommast einer italienischen Überlandleitung gesprengt wurde und zwei Sprengminen detonierten.“"
                            },
                            {
                                "example_id": "56561563-cdd0-418a-b704-a6fe0f575ffd",
                                "sense_id": "a7c24e60-55bc-3a56-ae77-da552789b66e",
                                "text": "„Ein morscher Strommast aus Holz ist einem 30-jährigen Monteur am Dienstag in Söcking zum Verhängnis geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2ecb233-289d-4444-8e58-9cc9b2ad94b9",
                        "source_entry_id": "3291386b-6182-32f4-bbf8-d60a78e09cfc",
                        "source_sense_id": "a7c24e60-55bc-3a56-ae77-da552789b66e",
                        "source_sense_description": "hohe, senkrechte, pfeilerähnliche Stange, die elektrische Leitungen trägt",
                        "target_lang_word": "pylon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pylon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9434c332-af85-3ee2-9377-444670924273",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A gateway to the inner part of an Ancient Egyptian temple."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a11e873-d33a-3118-870e-84d721e6a446",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A tower-like structure, usually one of a series, used to support high-voltage electricity cables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8a7e06-1468-4dc3-b5e6-713e8cf15c3b",
                                                "sense_id": "9a11e873-d33a-3118-870e-84d721e6a446",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            },
                                            {
                                                "example_id": "28bdf7cc-c257-4804-be4a-4cf14ce277fa",
                                                "sense_id": "9a11e873-d33a-3118-870e-84d721e6a446",
                                                "text": "After two pylonless months, July's pylon comes all the way from the hills outside Wellington, New Zealand."
                                            },
                                            {
                                                "example_id": "166519fc-1713-48e4-9dc9-ddf2d4181853",
                                                "sense_id": "9a11e873-d33a-3118-870e-84d721e6a446",
                                                "text": "These smaller pylons have might not possess the majesty of the giant 400 kV pylons, but they have a squat charm all of their own and 132 kV was the original voltage of the National Grid when it was rolled out in the 1920s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f55f46-d1f0-3d63-8658-620671f1d79f",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A tall steel or concrete tower from which cables are strung."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70f7f986-fa8b-3893-a101-6601a0b828a3",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A lighting mast; a freestanding support for floodlights."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88b5947f-5adb-3288-9e1c-17e529b34e5a",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A structure used to mount engines, missiles etc., to the underside of an aircraft wing or fuselage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5be7ca7a-0c8f-3594-900c-7998e34d3a85",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A starting derrick for an aeroplane."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4cab77e-b7a9-306d-b042-fb7006cae7ee",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A post, tower, etc. as on an aerodrome, or flying ground, serving to bound or mark a prescribed course of flight."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5623ad09-7fa0-3be7-a65c-aa2ea6512f5d",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "An obelisk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b92d86b4-4fce-46eb-a6ee-ae26bacf7778",
                                                "sense_id": "5623ad09-7fa0-3be7-a65c-aa2ea6512f5d",
                                                "text": "The Washington Monument is often described as an obelisk, and sometimes even as a “true obelisk,” even though it is not. A true obelisk is a monolith, a pylon formed out of a single piece of stone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0ac7671-b813-303d-8f76-7de1220b950e",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A traffic cone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dec749c6-cc5f-384a-9b47-94dd90d10f7b",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "An orange marker designating one of the four corners of the end zone in American football."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8360cefd-db2f-34ba-aa23-a324a4cc39f2",
                                        "entry_id": "21d8f5d7-6b4a-3675-98a3-1108ab6b64b7",
                                        "glosses": [
                                            "A rigid prosthesis for the lower leg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26883ca-0af4-4542-bc95-314edb5ac3f6",
                                                "sense_id": "8360cefd-db2f-34ba-aa23-a324a4cc39f2",
                                                "text": "McKenzie uses a pylon for all above knee amputees, and orders a permanent leg when function merits it."
                                            },
                                            {
                                                "example_id": "03c029ff-01a1-4e9a-8042-3a485cfd2886",
                                                "sense_id": "8360cefd-db2f-34ba-aa23-a324a4cc39f2",
                                                "text": "During the early postoperative period, before the patient has a prosthesis, they may have a rigid dressing with a pylon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
