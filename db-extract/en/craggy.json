                "senses": [
                    {
                        "sense_id": "24f1ea68-7b0d-30f7-b620-e1356cc49ee7",
                        "entry_id": "417e1998-1899-3f4d-8b6d-b9a061f4c05f",
                        "glosses": [
                            "Characterized by rugged, sharp, or coarse features."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f84134ac-869a-42cd-9e0d-b95858161b5e",
                                "sense_id": "24f1ea68-7b0d-30f7-b620-e1356cc49ee7",
                                "text": "The goat climbed up the craggy rocks."
                            },
                            {
                                "example_id": "91c4584c-7a48-48fe-8166-ac2350ed315a",
                                "sense_id": "24f1ea68-7b0d-30f7-b620-e1356cc49ee7",
                                "text": "The old man had craggy, uncultured features, but had bright, intelligent eyes."
                            },
                            {
                                "example_id": "49898431-d0f2-46cf-8424-b1a88c522029",
                                "sense_id": "24f1ea68-7b0d-30f7-b620-e1356cc49ee7",
                                "text": "Meete with the foole, and rid your royall ſhoulders\nOf ſuch a burden, as outweighs the ſands\nAnd all the craggie rockes of Caſpea."
                            },
                            {
                                "example_id": "019dc6fa-e0f1-4286-99bd-b0d8edf741ab",
                                "sense_id": "24f1ea68-7b0d-30f7-b620-e1356cc49ee7",
                                "text": "Where Willow was thunderous and craggy, a sort of Makepeace Watermaster without a secret, Murgo writhed inside his habit like a ferret roped into a bag. Where Willow's fearless gaze was unruffled by knowledge, Murgo's signalled the lonely anguish of the cell."
                            },
                            {
                                "example_id": "ef3bbab9-d782-4189-a0f5-ca4c34b98069",
                                "sense_id": "24f1ea68-7b0d-30f7-b620-e1356cc49ee7",
                                "text": "Jones’ sad eyes betray a pervasive pain his purposefully spare dialogue only hints at, while the perfectly cast Brolin conveys hints of playfulness and warmth while staying true to the craggy stoicism at the character’s core."
                            }
                        ]
                    }
                ],
