                        "examples": [
                            {
                                "example_id": "5fbd7b3e-0a37-4f86-9ff7-bb55cf017002",
                                "sense_id": "9912cd62-7b92-328f-a038-7578a28d75dd",
                                "text": "Le cantonalisme vainqueur y trouvera-t-il [dans le refus de reviser la constitution] un nouvel affermissement de son droit de souveraineté ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "2a16ff90-4be4-3ba5-b9e1-e4213012420e",
                        "entry_id": "1d7c1f93-ad84-360e-870c-051071f83ec3",
                        "glosses": [
                            "Mouvement anarchiste important lors de la Première République Espagnole, qui consistait en une réorganisation du territoire national en cantons plus ou moins fédérés dans une Fédération Espagnole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2801a226-273b-4573-8111-8884c5ad43c7",
                                "sense_id": "2a16ff90-4be4-3ba5-b9e1-e4213012420e",
                                "text": "Dès qu’une commune avait fait son pronunciamiento, son premier soin était de détruire le télégraphe et les chemins de fer pour couper toutes ses communications avec ses voisins et avec Madrid. Il n’était pas de méchant bourg qui n’entendit faire sa cuisine à part. Le fédéralisme avait fait place à un cantonalisme brutal, incendiaire et massacreur, et partout se célébraient de sanglantes saturnales."
                            }
                        ]
                    }
