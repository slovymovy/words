                                        "sense_id": "ac15fcab-ce07-37b3-9d1e-d99d99b60e04",
                                        "entry_id": "832aeb64-aea4-3710-941c-241fedb7e713",
                                        "glosses": [
                                            "A female given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79740be-597c-41b0-9cb0-7e5e8e040af6",
                                                "sense_id": "ac15fcab-ce07-37b3-9d1e-d99d99b60e04",
                                                "text": "Is thy face like thy mother's, my fair child! / Ada! Sole daughter of my house and heart?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fed4caf-0b0b-331f-ba83-d381ead9b10f",
                                        "entry_id": "832aeb64-aea4-3710-941c-241fedb7e713",
                                        "glosses": [
