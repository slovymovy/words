                        "source_sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                        "source_sense_description": "ein Flugzeug mit zwei übereinander liegenden Flügeln",
                        "target_lang_word": "биплан",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
