                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>grand-père</w> me racontait toujours de belles histoires avant de dormir.",
                            "target_lang_translations": {
                                "en": "My <w>grandfather</w> always used to tell me lovely stories before bed.",
                                "ru": "Мой <w>дедушка</w> всегда рассказывал мне чудесные истории перед сном.",
                                "nl": "Mijn <w>grootvader</w> vertelde me altijd prachtige verhalen voor het slapengaan.",
                                "de": "Mein <w>Großvater</w> erzählte mir vor dem Schlafengehen immer wunderschöne Geschichten.",
                                "pl": "Mój <w>dziadek</w> opowiadał mi zawsze piękne historie przed snem.",
                                "it": "Mio <w>nonno</w> mi raccontava sempre bellissime storie prima di dormire.",
                                "cs": "Můj <w>dědeček</w> mi před spaním vždycky vyprávěl krásné příběhy.",
                                "tr": "<w>Büyükbabam</w> uyumadan önce bana hep güzel hikâyeler anlatırdı.",
                                "es": "Mi <w>abuelo</w> siempre me contaba bonitas historias antes de dormir.",
                                "zh": "我的<w>爷爷</w>以前睡前总给我讲好听的故事。"
                            }
                        },
                        {
                            "text": "Chaque dimanche, nous allions rendre visite à notre <w>grand-père</w> paternel.",
                            "target_lang_translations": {
                                "en": "Every Sunday we used to visit our <w>paternal grandfather</w>.",
                                "ru": "Каждое воскресенье мы ходили в гости к нашему <w>дедушке</w> по отцовской линии.",
                                "nl": "Elke zondag gingen we op bezoek bij onze <w>grootvader van vaderskant</w>.",
                                "de": "Jeden Sonntag besuchten wir unseren <w>Großvater väterlicherseits</w>.",
                                "pl": "Każdej niedzieli odwiedzaliśmy naszego <w>dziadka od strony ojca</w>.",
                                "it": "Ogni domenica andavamo a trovare il nostro <w>nonno paterno</w>.",
                                "cs": "Každou neděli jsme chodili na návštěvu k našemu <w>dědečkovi z otcovy strany</w>.",
                                "tr": "Her pazar, <w>baba tarafındaki dedemizi</w> ziyaret etmeye giderdik.",
                                "es": "Cada domingo íbamos a visitar a nuestro <w>abuelo paterno</w>.",
                                "zh": "每个星期天，我们都去看望父亲那边的<w>爷爷</w>。"
                            }
                        }
