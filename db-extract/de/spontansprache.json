                        "glosses": [
                            "gesprochene Sprache, wie sie im Alltag verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca92fd8-1080-416a-a27a-39e074388681",
                                "sense_id": "0e76b210-07c1-3df5-be8a-ab3a1d52d4fa",
                                "text": "„Auf die Erhebung von Spontansprache wird bewusst verzichtet, da viele sprachauffällige Jugendliche spontansprachlich weniger auffallen als schriftsprachlich oder im Bereich des Sprachverständnisses […].“"
                            },
                            {
                                "example_id": "afc22af6-25eb-48f1-a32d-c7abc10ed1a9",
                                "sense_id": "0e76b210-07c1-3df5-be8a-ab3a1d52d4fa",
                                "text": "„Um das Symptombild der restaphasischen Störungen noch etwas umfangreicher zu beschreiben, wurden in einem zweiten Schritt die Spontansprachen makrolinguistisch oder gesprächsorientiert analysiert.“"
                            }
                        ],
