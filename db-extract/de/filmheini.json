                "senses": [
                    {
                        "sense_id": "42fcdd29-58dc-3d70-9edd-61e1bdc1606b",
                        "entry_id": "3ed7b13d-b1a6-38ac-9665-e42155df6907",
                        "glosses": [
                            "Mann, der irgendwas mit Kinofilmen zu tun hat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "afe739e9-6532-4567-a967-6d7e6e35ecb2",
                                "sense_id": "42fcdd29-58dc-3d70-9edd-61e1bdc1606b",
                                "text": "„Ich habe dich wieder mit dem komischen Filmheini im Auto sitzen sehen, gestern abend, und du hast dich an ihn geschmiegt, du Luder!“"
                            },
                            {
                                "example_id": "fb3c07fc-fa8f-4397-8f01-793773b72e56",
                                "sense_id": "42fcdd29-58dc-3d70-9edd-61e1bdc1606b",
                                "text": "„Scheint ja 'ne Menge Geld zu haben, dieser Filmheini.“"
                            },
                            {
                                "example_id": "1e703f44-b8f1-4da8-b61c-62944aacce5c",
                                "sense_id": "42fcdd29-58dc-3d70-9edd-61e1bdc1606b",
                                "text": "„Adorf, das schien Dir ein Filmheini, hatte er überhaupt jemals Theater gespielt?“"
                            },
                            {
                                "example_id": "0bb12a1f-719c-4fed-97ec-b502db8c842f",
                                "sense_id": "42fcdd29-58dc-3d70-9edd-61e1bdc1606b",
                                "text": "„»Ich bin ein alter Filmheini«, zuckt Ehrlich bei seiner inzwischen zweiten Lesung in Aschersleben lachend die Schultern, »da fange ich natürlich mit einem Film an.«“"
                            },
                            {
                                "example_id": "02b129c1-a11d-4141-a294-c34d555c2b30",
                                "sense_id": "42fcdd29-58dc-3d70-9edd-61e1bdc1606b",
                                "text": "„Ich bekomme einen Anruf: Schon wieder haben irgendwelche Filmheinis Parkverbotsschilder aufstellen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
