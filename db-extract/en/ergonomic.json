                                                "example_id": "6c606475-5471-4d04-a31b-d753953e00c9",
                                                "sense_id": "dff35c39-a14f-368e-980b-a3b2572d5dae",
                                                "text": "Ergonomisch gestaltete Arbeitsabläufe schützen die Gesundheit des Arbeitnehmers."
                                            },
                                            {
                                                "example_id": "bca20bed-2b4f-4070-9a52-20d14dc32a5d",
                                                "sense_id": "dff35c39-a14f-368e-980b-a3b2572d5dae",
                                                "text": "Durch den Einsatz von ergonomisch geformtem Werkzeug konnte die Taktgeschwindigkeit am Band erhöht werden."
