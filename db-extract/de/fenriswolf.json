                "senses": [
                    {
                        "sense_id": "a33dc730-b3b0-3fae-9fee-9322c71384ac",
                        "entry_id": "37e9bb3a-0711-3fcf-b7d6-21497e11b66e",
                        "glosses": [
                            "Riesenwolf, erstes Kind Lokis und Angrbodas"
                        ],
                        "tags": [
                            "nordische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7a6a8360-add0-405a-8cbd-e33e02022d31",
                                "sense_id": "a33dc730-b3b0-3fae-9fee-9322c71384ac",
                                "text": "„Dieser Fenriswolf hat mit dem Jettenweibe Gyge … zwei Wölfe erzeugt, Skol und Hate.“"
                            },
                            {
                                "example_id": "8734af90-d489-41b7-8db6-e6aeca36ebb5",
                                "sense_id": "a33dc730-b3b0-3fae-9fee-9322c71384ac",
                                "text": "„In der germanischen Mythologie wird die Kraft des Verschlingens und Raubens im Bilde des Fenriswolf beschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a0a513f-224a-44a6-9155-123c2e200cc8",
                        "source_entry_id": "37e9bb3a-0711-3fcf-b7d6-21497e11b66e",
                        "source_sense_id": "a33dc730-b3b0-3fae-9fee-9322c71384ac",
                        "source_sense_description": "nordische Mythologie: Riesenwolf, erstes Kind Lokis und Angrbodas",
                        "target_lang_word": "Fenrir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fenrir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0c7c5d8-59eb-3fe0-b573-81190a18cab8",
                                        "entry_id": "3902cae9-8f40-31ba-b4d5-020f186756b3",
                                        "glosses": [
                                            "A monstrous wolf, one of Loki's offspring, who bites off Tyr's right hand while being bound by the gods in fear of a prophecy that he will kill Odin, remaining so bound until the events of Ragnarok."
                                        ],
                                        "tags": [
                                            "Norse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a3fc0f5-1839-462c-8a2b-7a6226c270e2",
                                                "sense_id": "c0c7c5d8-59eb-3fe0-b573-81190a18cab8",
                                                "text": "Lokasenna, stanzas 37-40, comprise an exchange between Týr and Loki. Loki boasts that Fenrir tore off Týr's arm; Týr responds that although he may be missing his hand, Loki is missing Hródrsvitnir, that is, the famous wolf, Fenrir."
                                            },
                                            {
                                                "example_id": "4e4a4e98-af5b-4824-932b-257bb3da11e8",
                                                "sense_id": "c0c7c5d8-59eb-3fe0-b573-81190a18cab8",
                                                "text": "Feared and misunderstood, Fenrir was the bringer of doom to the gods and was known as \"an axe-age, a sword-age, a wind-age, a wolf-age before the wrecking of the world.\""
                                            },
                                            {
                                                "example_id": "35de7c5b-35ee-46c1-9a0f-dbf38f6486a7",
                                                "sense_id": "c0c7c5d8-59eb-3fe0-b573-81190a18cab8",
                                                "text": "It is my own opinion that the Black Shuck is another manifestation of Fenrir, the large and terrible wolf, who is the eldest child of Loki and the giantess Angrboda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b1b9935-ad2f-3469-874c-6a766a83034f",
                                        "entry_id": "3902cae9-8f40-31ba-b4d5-020f186756b3",
                                        "glosses": [
                                            "A moon of Saturn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
