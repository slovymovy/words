                "senses": [
                    {
                        "sense_id": "0f8f0d91-ae9a-3678-8df2-246d3e4bb337",
                        "entry_id": "17e7e6ca-ffab-3c75-9b10-fe1fe63edf9b",
                        "glosses": [
                            "die Masse eines Protons (sowie seines Antiteilchens, des Antiprotons)"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "ab0df48c-78a9-4f7f-8236-8d5a84bac350",
                                "sense_id": "0f8f0d91-ae9a-3678-8df2-246d3e4bb337",
                                "text": "„Die Masse des Elektrons bestimmt die Frequenz der optischen Atomuhren, während die Protonenmasse die Frequenz der Caesiumuhr beeinflusst.“"
                            },
                            {
                                "example_id": "4fb83d2f-518e-4dc2-b018-d2e45976c5e4",
                                "sense_id": "0f8f0d91-ae9a-3678-8df2-246d3e4bb337",
                                "text": "„Wird das Verhältnis von Elektronenmasse zu Protonenmasse in einem Diagramm über die Feinstrukturkonstante aufgetragen, so kann man nach Max Tegmark einen lokalen Bereich angeben, außerhalb dessen kein Leben möglich ist, das dem unseren gleicht.“"
                            },
                            {
                                "example_id": "4ea1c1ac-a4ea-47a3-886f-42a0cae9dc5c",
                                "sense_id": "0f8f0d91-ae9a-3678-8df2-246d3e4bb337",
                                "text": "„Das bedeute, dass ein Elektron ein 1836,15267377stel der Protonenmasse besitzt. Die genaueren Werte sind bedeutsam für die Überprüfung des Standardmodells der Elementarteilchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
