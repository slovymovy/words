                                        "glosses": [
                                            "Not affected or changed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e18f9876-3ff9-4914-b411-e627b77989c1",
                                                "sense_id": "9d862a39-59de-32b2-8c39-9b85cfb40792",
                                                "text": "Since I work from home, I was unaffected by the office move."
                                            },
                                            {
                                                "example_id": "236ed2f9-9670-4fb4-9ca1-637c641e606e",
                                                "sense_id": "9d862a39-59de-32b2-8c39-9b85cfb40792",
                                                "text": "I've lost my mind, I've spent the night / Crying on the floor of my bathroom / But you're so unaffected, I really don't get it / But I guess good for you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a93028-ca68-3c84-8a3a-5819bd81802d",
                                        "entry_id": "872f44a4-a3f8-39c1-936b-ff03222010cc",
                                        "glosses": [
                                            "Lacking pretense or affectation; natural."
                                        ],
                                        "tags": [],
                                        "examples": [
