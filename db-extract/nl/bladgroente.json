                        "sense_id": "6fcffb96-c281-38ba-b70d-7a85ec29b943",
                        "entry_id": "52cd91c8-d600-39e2-a624-2c1f7fbec237",
                        "glosses": [
                            "planten waarvan men de bladeren als voedsel gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470d3761-878b-466b-b4a7-2336aca88cf8",
                                "sense_id": "6fcffb96-c281-38ba-b70d-7a85ec29b943",
                                "text": "Bladgroentes worden gezien als gezond voedsel."
                            },
                            {
                                "example_id": "ae4cd3e4-4c77-4d2d-a630-9c346ebe46d6",
                                "sense_id": "6fcffb96-c281-38ba-b70d-7a85ec29b943",
                                "text": "Honderdtien varianten bladgroenten en kruiden heeft Urbancrops met de Universiteit van Gent al uitgeprobeerd, vertelt sales manager Gwen Dehaene, en allemaal groeien ze even goed onder ledlampen. Het 2,5 jaar oude bedrijf heeft drie van deze caravans, van 55.000 euro per stuk, nu aan Belgische restaurants verkocht. Hun koks serveren hier nu verse sla en kruiden uit. Een luxe toepassing. Maar de cabines kunnen overal groenten leveren, zegt Dehaene, ook in een arm dorp in de Sahel."
                            }
                        ]
                    }
