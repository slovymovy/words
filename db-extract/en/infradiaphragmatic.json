                            {
                                "example_id": "b211f39e-72ba-4704-9103-2312dce92ad5",
                                "sense_id": "130f84c1-a575-332c-98fb-68393b85e954",
                                "text": "Partial anomalous pulmonary venous connection is usually supradiaphragmatic, but when it is infradiaphragmatic the veins enter the inferior vena cava, forming the scimitar syndrome."
                            },
                            {
                                "example_id": "87bf5cba-3d04-4a88-b0a4-b1afe09d89f4",
                                "sense_id": "130f84c1-a575-332c-98fb-68393b85e954",
                                "text": "Infradiaphragmatic intra- and suprasellar craniopharyngioma: its starting point is intrasellar, and it develops to the suprasellar spaces in distending the diaphragma sellae, which commonly becomes inseparable from the tumor capsule."
                            },
                            {
                                "example_id": "ca2e0210-8fc5-4c7e-8fd8-79e22c6afbff",
                                "sense_id": "130f84c1-a575-332c-98fb-68393b85e954",
                                "text": "The inverted Y field has traditionally been used to treat the infradiaphragmatic lymph node regions including the paraaortic nodes, spleen, pelvic nodes and inguinofemoral nodes."
                            },
                            {
                                "example_id": "247c63ce-1c62-4de2-ab09-91871fdda2b0",
                                "sense_id": "130f84c1-a575-332c-98fb-68393b85e954",
                                "text": "[…] infradiaphragmatic aortic clamping is done just above the celiac plexus level; it is decided after laparotomy because of the torrential uncontrollable bleeding."
                            }
                        ]
