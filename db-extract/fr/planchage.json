                        "glosses": [
                            "Ouvrage en planches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982fbb1e-76db-447a-8a26-4bc95a025f1e",
                                "sense_id": "e2d36ed3-4fb2-3b2c-99ad-2e34719f5817",
                                "text": "Ung petit pillier faict sur led. escouisson et joignant aux jouées de boys et planchage pour réconforter lad. muraille et conduyre l'eaue sur le planchage."
                            },
                            {
                                "example_id": "dbf778fe-5288-47bf-a21f-ce999e2fe4cb",
                                "sense_id": "e2d36ed3-4fb2-3b2c-99ad-2e34719f5817",
                                "text": "Il est protégé contre les charbons de son camarade, qui travaille au-dessus de lui, par un planchage."
                            },
                            {
                                "example_id": "1be4f078-ceee-41ea-8fc4-4a924ced8101",
                                "sense_id": "e2d36ed3-4fb2-3b2c-99ad-2e34719f5817",
                                "text": "Un fort planchage de protection."
                            }
                        ]
                    },
                    {
                        "sense_id": "44db5179-8972-3652-ad5d-e1552bd034fc",
                        "entry_id": "b27a9df8-c74f-35fb-8fb6-bd31c35f83d3",
                        "glosses": [
                            "Reconstitution d’une planche de timbres telle qu’elle était à l’origine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2fd7ea9-c672-434d-a658-6e1c85f0827c",
                                "sense_id": "44db5179-8972-3652-ad5d-e1552bd034fc",
                                "text": "Le planchage se dit de l’activité qui consiste à rechercher sur les timbres anciens, en général les « bleus de france », la reproduction des défauts occasionnés par l'usure du jeu d’impression, d'identifier leur position dans la planche et ainsi reconstituer une planche entière de timbres telle qu'elle était composée à l’origine."
                            }
                        ]
                    }
