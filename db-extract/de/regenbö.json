                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c720c6-70c8-4fcb-8132-f7a2c934da52",
                                "sense_id": "1645262f-9db3-3331-b4e5-9d61332ce44d",
                                "text": "„Auf dem Weg zur Schule greifen Regenböen von vorne an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3048b1cb-ed35-476c-a1da-1d49b0a8ff79",
                        "source_entry_id": "cffa96c3-5c65-3b64-b1da-b7091d049633",
                        "source_sense_id": "1645262f-9db3-3331-b4e5-9d61332ce44d",
                        "source_sense_description": "heftiger Windstoß mit Regen",
                        "target_lang_word": "rafale pluvieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bb25bc06-b73f-4327-9bf8-f9127f11d199",
                        "source_entry_id": "cffa96c3-5c65-3b64-b1da-b7091d049633",
                        "source_sense_id": "1645262f-9db3-3331-b4e5-9d61332ce44d",
                        "source_sense_description": "heftiger Windstoß mit Regen",
                        "target_lang_word": "grain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c8174ca-f6b8-3d4e-9d04-24170666f9e0",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Fruit et semence des céréales contenu dans l’épi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7560e451-1844-44b7-8044-93d71e0a5eae",
                                                "sense_id": "4c8174ca-f6b8-3d4e-9d04-24170666f9e0",
                                                "text": "Chez l’orge vêtue, la lemme et la paléole adhèrent au grain lors du battage, tandis que chez l’orge nue, le grain s'en libère."
                                            },
                                            {
                                                "example_id": "b0c7c7d4-b551-48bf-8820-c3fd7a93ee37",
                                                "sense_id": "4c8174ca-f6b8-3d4e-9d04-24170666f9e0",
                                                "text": "La récolte, le commerce des grains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "004dded3-1689-36ae-80df-e080e8a42956",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Ce qu’on sème pour la reproduction des céréales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3829825-899a-4d64-a364-ae1bd40ae228",
                                                "sense_id": "004dded3-1689-36ae-80df-e080e8a42956",
                                                "text": "Gros grains, froment, méteil et seigle."
                                            },
                                            {
                                                "example_id": "866e61f3-7d77-4d1f-91a1-ea5a953c77c2",
                                                "sense_id": "004dded3-1689-36ae-80df-e080e8a42956",
                                                "text": "Menus grains, orge, avoine, mil, vesce, etc."
                                            },
                                            {
                                                "example_id": "e49e9649-de50-4366-98cb-074b093c8a3e",
                                                "sense_id": "004dded3-1689-36ae-80df-e080e8a42956",
                                                "text": "Poulets de grain, petits poulets qu’on nourrit de grain."
                                            },
                                            {
                                                "example_id": "e78eb52d-36fb-4e56-9c9b-9efd92ad5cc5",
                                                "sense_id": "004dded3-1689-36ae-80df-e080e8a42956",
                                                "text": "Quand un animal a mangé trop de grain , par exemple s’il a pu entrer dans un grenier à grain, le grain qu‘il a consommé se transforme en acide dans son rumen. Cet acide rend l’animal malade et l’empêche de digérer sa nourriture correctement…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72244c36-ede5-3da9-9479-4936ff9014cd",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Fruit de certaines plantes et de certains arbrisseaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae16259d-feac-4e2b-b421-351822a45462",
                                                "sense_id": "72244c36-ede5-3da9-9479-4936ff9014cd",
                                                "text": "Grain de raisin, de grenade, de poivre, de café, etc."
                                            },
                                            {
                                                "example_id": "d94aae80-da83-4f69-bf93-a33e0c667fcb",
                                                "sense_id": "72244c36-ede5-3da9-9479-4936ff9014cd",
                                                "text": "[…]; on cultive aussi un peu de sarrasin, ou “blé noir” qui sert au chauffage dans un pays privé de bois, et dont les grains sont donnés en nourriture à la volaille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7780710d-8706-36e0-b7f6-18259c35a8a9",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Sous les tropiques, désigne les légumes secs (haricots rouges ou blancs, lentilles…)."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4df0ac62-c292-41e5-af2f-72f06ad92b27",
                                                "sense_id": "7780710d-8706-36e0-b7f6-18259c35a8a9",
                                                "text": "Le zembrocal est une préparation de riz cuit avec des grains et de la viande fumée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8322646-02c1-32c6-8614-96e47d9e6e6c",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Petit objet de la taille d’une graine."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a84824da-9cc7-48cc-b6c5-ba822fa02964",
                                                "sense_id": "d8322646-02c1-32c6-8614-96e47d9e6e6c",
                                                "text": "Un grain de sable suffirait à bloquer le mécanisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0086be30-c8a3-33ab-935d-79ff95059294",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Chose faite à peu près en forme de grain."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9cff25-bccb-434f-b097-04eb85da91f5",
                                                "sense_id": "0086be30-c8a3-33ab-935d-79ff95059294",
                                                "text": "Héloïse dit et redit son chapelet. Les grains cliquettent de minute en minute et sans relâche, le chuchotement rapide des oraisons s’allonge."
                                            },
                                            {
                                                "example_id": "42fd20c7-ffa0-40d5-b8cc-2bc8a3971011",
                                                "sense_id": "0086be30-c8a3-33ab-935d-79ff95059294",
                                                "text": "et Un catholique à gros grains. Voyez « catholique »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa737947-3ca0-3615-8a2b-ff29bb7dc861",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Très petite quantité de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "151e2c3e-2ff8-4a97-acae-e0caacc3da08",
                                                "sense_id": "fa737947-3ca0-3615-8a2b-ff29bb7dc861",
                                                "text": "N’avoir pas un grain de bon sens, un grain de jugement, etc., En être tout à fait dépourvu."
                                            },
                                            {
                                                "example_id": "ef532fa9-e8c6-4a86-919b-559e7d161f97",
                                                "sense_id": "fa737947-3ca0-3615-8a2b-ff29bb7dc861",
                                                "text": "Elle a un petit grain de coquetterie, elle a un peu de coquetterie."
                                            },
                                            {
                                                "example_id": "be6bf766-ec74-432d-a22f-3e32efc6d78e",
                                                "sense_id": "fa737947-3ca0-3615-8a2b-ff29bb7dc861",
                                                "text": "Avoir un grain de folie dans la tête, ou Avoir un grain, être un peu fou."
                                            },
                                            {
                                                "example_id": "971856ff-8d83-423a-96f7-452fa4776b68",
                                                "sense_id": "fa737947-3ca0-3615-8a2b-ff29bb7dc861",
                                                "text": "J’aime votre mère, elle est nécessaire à ma vie, et elle ne m’a jamais donné un grain de malheur."
                                            },
                                            {
                                                "example_id": "79030819-3da5-489e-8db7-fff1b61b09fa",
                                                "sense_id": "fa737947-3ca0-3615-8a2b-ff29bb7dc861",
                                                "text": "Voilà un Bucquoy né dans l’Artois qui fait la guerre en Bohême ; - sa figure révèle l’imagination et l’énergie avec un grain de tendance au fantasque."
                                            },
                                            {
                                                "example_id": "2f41798a-b265-41da-b002-e31948e92759",
                                                "sense_id": "fa737947-3ca0-3615-8a2b-ff29bb7dc861",
                                                "text": "De tout temps, Lucile eut l’art de reconnaître ceux qui partageraient avec elle, sous des formes différentes et à des degrés divers, ce petit grain de folie susceptible d’enrayer la mécanique."
                                            },
                                            {
                                                "example_id": "b3ce4851-a22a-46ee-b8ac-a6f7038fcf4d",
                                                "sense_id": "fa737947-3ca0-3615-8a2b-ff29bb7dc861",
                                                "text": "[…] : ces grains de lumière, que Einstein appelait « quanta de lumière », nous les appelons aujourd’hui « photons »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e46963a-955a-362c-ad36-3f3604e349a2",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Poids qui était le soixante-douzième d’un gros."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "528d23c3-e476-4df7-b77f-c80737976d9b",
                                                "sense_id": "9e46963a-955a-362c-ad36-3f3604e349a2",
                                                "text": "Le grain équivaut à cinq centigrammes et trois milligrammes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32671022-7758-3beb-8fc1-96908b524366",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Unité de mesure de poids valant cinq centigrammes soit le quart d’un carat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f0a6c94-300d-3eb1-8cbe-58676a932921",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Petites aspérités présentes à la surface de certaines étoffes, de certains cuirs, de certaines peaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f5edea-c274-47d7-878d-737cb0f0090d",
                                                "sense_id": "0f0a6c94-300d-3eb1-8cbe-58676a932921",
                                                "text": "Le grain de sa peau est d’une finesse incroyable."
                                            },
                                            {
                                                "example_id": "ba2d0eea-8efe-46ea-b2bf-328dea7c2476",
                                                "sense_id": "0f0a6c94-300d-3eb1-8cbe-58676a932921",
                                                "text": "Ce maroquin est d’un beau grain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac7a86a-a560-3f55-b8d0-c553d0870e81",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "La texture visuelle ou au toucher d’un cuir, d’un bois, d’un papier, d’une peau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8c831ac-5916-32bf-8a46-6d5f101375f2",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Petit élément homogène ou monocristallin dans un matériau non amorphe. Parties ténues et serrées entre elles qui forment la masse des pierres, des métaux, etc., et que l’on aperçoit à l’endroit où ils sont cassés ou coupés."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fd8b409-9187-4591-88b4-36197fc99aeb",
                                                "sense_id": "a8c831ac-5916-32bf-8a46-6d5f101375f2",
                                                "text": "La taille des grains est déterminante pour la dureté des aciers."
                                            },
                                            {
                                                "example_id": "33f923b0-d153-4552-a796-bb5afeee4640",
                                                "sense_id": "a8c831ac-5916-32bf-8a46-6d5f101375f2",
                                                "text": "Le marbre des guéridons portait aux angles des cassures où il apparaissait plus blanc, d’un grain serré, friable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1561655a-c310-3206-8bce-44e9459aa758",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Plus petit détail visible d’un tirage photographique, d’une impression et qui définit la qualité de sa résolution."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5962f2b4-0b5b-4ec2-b1b6-94db1864235f",
                                                "sense_id": "1561655a-c310-3206-8bce-44e9459aa758",
                                                "text": "Le grain de cette photographie est particulièrement grossier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f35558a-a69d-3ade-8a98-33f2059784ea",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Vent violent et de peu de durée qui s’élève soudainement et qui est généralement accompagné de précipitations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b4e1303-3a61-4296-98ce-caa08aa9d469",
                                                "sense_id": "3f35558a-a69d-3ade-8a98-33f2059784ea",
                                                "text": "A 7h.1/2 l’udomètre contenait 26 millimètres d’eau donnée presqu’en totalité par ce grain car il n’y avait eu la veille que quelques grenasses qui n’avaient presque pas donné d’eau."
                                            },
                                            {
                                                "example_id": "27438a22-e868-4b8c-8a18-64b852569f4a",
                                                "sense_id": "3f35558a-a69d-3ade-8a98-33f2059784ea",
                                                "text": "Mais qu’une tornade, qu’un grain même éclatât à ce moment, et c’était la mort presque immédiate."
                                            },
                                            {
                                                "example_id": "6ff2a376-02b4-4e69-bb7e-b36cfd47c027",
                                                "sense_id": "3f35558a-a69d-3ade-8a98-33f2059784ea",
                                                "text": "La mer est dure et houleuse, le remorquage pénible. A midi, la remorque casse et le motor yacht me quitte fort vite en me saluant, car il désire rentrer avant l’arrivée du grain."
                                            },
                                            {
                                                "example_id": "5a3f70dc-930e-4ac5-8469-f8ef74beff4d",
                                                "sense_id": "3f35558a-a69d-3ade-8a98-33f2059784ea",
                                                "text": "Le baromètre, disait-il, venait de descendre d’un bon degré. Il fallait s’attendre à un grain, ce qui ferait bien l’affaire de M. Méliset, car chacun sait que le poisson mouve beaucoup et donne aisément dans les nasses, pendant l’orage."
                                            },
                                            {
                                                "example_id": "c73caa9a-bca0-4a6f-90dd-41a98617e1a4",
                                                "sense_id": "3f35558a-a69d-3ade-8a98-33f2059784ea",
                                                "text": "Un grain tombe sur sa mature"
                                            },
                                            {
                                                "example_id": "cb007a0b-b034-4e59-8d88-0729642c5e2f",
                                                "sense_id": "3f35558a-a69d-3ade-8a98-33f2059784ea",
                                                "text": "(Sens figuré) […] quelqu’un doit savoir… que jamais je n’ai dévié de mon cap et que ma volonté de fer a essuyé sans chavirer les grains conjoints des ténèbres et de la mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "532824f1-cbe3-3e01-bd84-e157760bb5d6",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Tonalité de la voix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12cf055b-1a17-48aa-8576-1d7642a226cc",
                                                "sense_id": "532824f1-cbe3-3e01-bd84-e157760bb5d6",
                                                "text": "Elle avait un joli grain de voix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ac555d0-fbac-3ce0-a54b-1a838f64d274",
                                        "entry_id": "df32feac-c36a-3aa5-87b4-e5fa6173f300",
                                        "glosses": [
                                            "Élément graphique de très faible surface et de contour irrégulier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
