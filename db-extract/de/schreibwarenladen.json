                                    {
                                        "sense_id": "3712e2f0-c484-32eb-9cfb-c2fcc0508813",
                                        "entry_id": "15e47114-0aa6-33cb-842d-58bbdf94f58b",
                                        "glosses": [
                                            "Manufacture de papier."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "123a69eb-2e8a-42f8-b2e3-02f0ba76c4a7",
                                                "sense_id": "3712e2f0-c484-32eb-9cfb-c2fcc0508813",
                                                "text": "Une papeterie se trouvait sur le ruisseau de la Maronne vers 1750. En 1813 elle fabriquait encore du papier d'écolier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "210e6cb6-ef2e-3b7e-8235-aed24fef5bc8",
                                        "entry_id": "15e47114-0aa6-33cb-842d-58bbdf94f58b",
                                        "glosses": [
                                            "Art de fabriquer le papier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7b8f6a-d1fa-40b1-a8d9-09957b571b8a",
                                                "sense_id": "210e6cb6-ef2e-3b7e-8235-aed24fef5bc8",
                                                "text": "La papeterie lui doit plusieurs procédés nouveaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae75ff50-9302-3e77-b3e9-498c7204aee3",
                                        "entry_id": "15e47114-0aa6-33cb-842d-58bbdf94f58b",
                                        "glosses": [
                                            "Commerce du papier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d36cffe6-e821-4f2e-adeb-0fbceba883a5",
                                                "sense_id": "ae75ff50-9302-3e77-b3e9-498c7204aee3",
                                                "text": "Il s’est enrichi dans la papeterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1623f31-9c1d-324b-8aa5-e12828975aa6",
                                        "entry_id": "15e47114-0aa6-33cb-842d-58bbdf94f58b",
                                        "glosses": [
                                            "Magasin où l’on vend en détail toutes sortes de papiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14c8f0b-64cf-436b-aa27-2df7e33578c9",
                                                "sense_id": "f1623f31-9c1d-324b-8aa5-e12828975aa6",
                                                "text": "Ouvrir une papeterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061e6c7e-12bf-31e0-bb5e-6c5c0d1aead3",
                                        "entry_id": "15e47114-0aa6-33cb-842d-58bbdf94f58b",
                                        "glosses": [
                                            "Petite boîte qui renferme ce qu’il faut pour écrire et cacheter des lettres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b313b044-03f5-4683-8a7e-b37ad1ffc1df",
                                                "sense_id": "061e6c7e-12bf-31e0-bb5e-6c5c0d1aead3",
                                                "text": "Elle s’était acheté un buvard, une papeterie, un porte-plume et des enveloppes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4e64d2-103b-39b9-a51e-a609026205fb",
                                        "entry_id": "15e47114-0aa6-33cb-842d-58bbdf94f58b",
                                        "glosses": [
                                            "Ensemble d’objets utiles à l’écriture manuscrite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2815c06-98d8-497d-ba86-c47937b9c76b",
                                                "sense_id": "1f4e64d2-103b-39b9-a51e-a609026205fb",
                                                "text": "Vivian Bell, soigneuse et raffinée, avait fait placer sur la table toute une papeterie artiste : des feuillets imitant le vélin des missels, et d’autres, d’un violet pâle, semés d’une cendre d’argent ; des plumes de celluloïd, blanches et légères, qu’il fallait manier comme des pinceaux ; une encre irisée qui, sur la page, se nuait d’azur et d’or."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
