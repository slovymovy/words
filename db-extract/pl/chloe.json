                        "examples": [
                            {
                                "example_id": "205397b6-2269-4c7a-925d-b910cffb3efd",
                                "sense_id": "e07dad39-9e9d-3c05-ac7e-1aa5b20afbc6",
                                "text": "Doniesiono mi bowiem o was, bracia moi, przez ludzi Chloe, że zdarzają się między wami spory"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ca9e123-db44-411a-ad0c-876c5741db32",
                        "source_entry_id": "c60f6f9a-4f0e-377f-976a-92f164ec84dd",
                        "source_sense_id": "e07dad39-9e9d-3c05-ac7e-1aa5b20afbc6",
                        "target_lang_word": "Chloe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chloe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3dd14f8-57b6-3d83-a190-1d34b584a560",
                                        "entry_id": "7dc5353c-1d6d-35be-a396-5160f8614cba",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7007d0a4-e5c4-4f4e-bbd0-786738d783f0",
                                                "sense_id": "b3dd14f8-57b6-3d83-a190-1d34b584a560",
                                                "text": "For it hath been declared unto me of you, my brethren, by them which are of the house of Chloe, that there are contentions among you."
                                            },
                                            {
                                                "example_id": "2a55adbe-3d4f-4b09-8944-5b298024a2cd",
                                                "sense_id": "b3dd14f8-57b6-3d83-a190-1d34b584a560",
                                                "text": "Of Chloe all the town has rung; / By ev'ry Size of Poets sung. / So beautiful a Nymph appears / But once in Twenty Thousand Years."
                                            },
                                            {
                                                "example_id": "203355a3-9ff0-4cd9-aab4-d874997447d1",
                                                "sense_id": "b3dd14f8-57b6-3d83-a190-1d34b584a560",
                                                "text": "Before he had met this one, Morgan had assumed that people called Chloe were either the neurotic brilliant daughters of Oxbridge dons or else silly screaming debutantes."
                                            },
                                            {
                                                "example_id": "94246454-c189-434c-9bec-14dcce1826b1",
                                                "sense_id": "b3dd14f8-57b6-3d83-a190-1d34b584a560",
                                                "text": "New Zealand registration officials apparently blocked other questionable names in the past, including Fish and Chips and Sex Fruit, but allowed others, such as Number 16 Bus Shelter and Violence. […] I’m fine with the Gavins and the Masons and the Chloes, but the Poppy Honeys and the Banjos and the Sex Fruits simply have to go."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
