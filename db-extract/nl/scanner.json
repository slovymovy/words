                    {
                        "sense_id": "a75e0463-2671-38ee-a836-3756635e6b6f",
                        "entry_id": "4783fc87-60c9-36da-9377-9bd1619d9dca",
                        "glosses": [
                            "een elektronisch apparaat waarmee op papier gedrukte tekst of afbeeldingen worden omgezet in digitale bestanden voor een computer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c1fe6e-c7bf-483e-9a29-da548e49c568",
                                "sense_id": "a75e0463-2671-38ee-a836-3756635e6b6f",
                                "text": "Ik heb een scanner gekocht waarmee ik dia's en foto's kan digitaliseren."
                            }
                        ]
                    },
                    {
                        "sense_id": "e969efaa-aa75-388f-a23b-96f45214ee2e",
                        "entry_id": "4783fc87-60c9-36da-9377-9bd1619d9dca",
                        "glosses": [
                            "een (rand-) apparaat om barcodes mee te lezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec116551-3fe7-4fcc-8e9d-9874aa486634",
                                "sense_id": "e969efaa-aa75-388f-a23b-96f45214ee2e",
                                "text": "Naast de ingebouwde scanners heeft elke kassa ook nog een losse handscanner beschikbaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "141c2236-71a4-3fa3-8d3a-6db58204043b",
                        "entry_id": "4783fc87-60c9-36da-9377-9bd1619d9dca",
                        "glosses": [
                            "een radiocommunicatie-ontvanger (mobilofoon, portofoon e.d.) die steeds alle kanalen langsgaat en stopt op een bezet kanaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81829dd-44ab-4353-9957-a95056f7cf53",
                                "sense_id": "141c2236-71a4-3fa3-8d3a-6db58204043b",
                                "text": "De oninteressante kanalen kan ik op deze scanner laten overslaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "b75bc491-d3b9-3b56-b0fb-cc29448500ed",
                        "entry_id": "4783fc87-60c9-36da-9377-9bd1619d9dca",
                        "glosses": [
                            "de in de geneeskunde toegepaste instrumenten waarmee volgens verschillende technieken, beelden worden verkregen die uit vele lagen zijn samengesteld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4768e8a9-2e17-436b-b45c-30340cfc1a0f",
                                "sense_id": "b75bc491-d3b9-3b56-b0fb-cc29448500ed",
                                "text": "We werken al enige maanden met de nieuwe scanner ."
                            }
                        ]
                    },
                    {
                        "sense_id": "308afd26-8e43-3954-ae5e-ef0c23d1eb93",
                        "entry_id": "4783fc87-60c9-36da-9377-9bd1619d9dca",
                        "glosses": [
                            "een toestel voor de identificatie van dieren met een ingebrachte microchip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7583d13a-e517-4987-b8f3-2dd7082d9588",
                                "sense_id": "308afd26-8e43-3954-ae5e-ef0c23d1eb93",
                                "text": "Het dierenasiel heeft nu ook zo'n scanner om weggelopen dieren thuis te brengen."
                            }
                        ]
                    }
