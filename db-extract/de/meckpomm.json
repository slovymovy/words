                        "examples": [
                            {
                                "example_id": "b4da0950-945e-448e-8024-6cb4f4fc48bb",
                                "sense_id": "bfc3dec3-f9bb-3019-9b17-a85dd6048886",
                                "text": "Wie war denn Euer Urlaub im Meckpomm?"
                            },
                            {
                                "example_id": "91f386ea-98c4-4236-8257-680a85b6a31a",
                                "sense_id": "bfc3dec3-f9bb-3019-9b17-a85dd6048886",
                                "text": "In Meckpomm ist gerade Gewitter."
                            },
                            {
                                "example_id": "7df6f781-aa02-4299-ae1d-0f029afac648",
                                "sense_id": "bfc3dec3-f9bb-3019-9b17-a85dd6048886",
                                "text": "„Sie führte im Graben zunächst quer in den Harz, dann nach Meckpomm zur Seenplatte, schließlich an die Ostseeküste nach Daarß, weiter nach Rügen und Usedom, an der Ostseeküste entlang bis Danzig, zurück quer durch Nordpolen bis Frankfurt/ Oder und anschließend über Erzgebirge und Vogelsberg wieder in die Heimat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
