    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3497c6a7-2526-3d91-ba4f-64b58542735c",
                "word": "Geoffrey",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d7016e37-48f8-3ee7-b991-8a579bf8581c",
                        "entry_id": "3497c6a7-2526-3d91-ba4f-64b58542735c",
                        "glosses": [
                            "A male given name from the Germanic languages, popular in the U.K. in the 20th century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bdc40d4-535b-4893-bd4d-1abb7211145c",
                                "sense_id": "d7016e37-48f8-3ee7-b991-8a579bf8581c",
                                "text": "\"Were you not aware mamma had a son as well as three daughters?\"\n\"Yes, but I didn't know his name. I like Geoffrey; there's some sound in it.\""
                            },
                            {
                                "example_id": "ca147ac1-33a7-4897-9a9b-09c202d00b7c",
                                "sense_id": "d7016e37-48f8-3ee7-b991-8a579bf8581c",
                                "text": "Geoff grimaced, then smiled back, reminding himself that when his mother wasn't riding this horse, she was a very interesting woman who had taught medieval literature at Drew University for twenty years. In fact, he had been named Geoffrey because of her great admiration for Chaucer."
                            },
                            {
                                "example_id": "7a0379aa-9d56-4780-a6ea-707e0681d8d2",
                                "sense_id": "d7016e37-48f8-3ee7-b991-8a579bf8581c",
                                "text": "His full name is Benji Duncan Geoffrey Rigby-Monk. 'You're joking,' Kit said, when I first told him. Benji? Not even Benjamin?' Duncan and ''Geoffrey are his two granddads'names ― both unglamorous and old-dufferish, in Kit's view, and not worth inflicting on a new generation ― and Rigby-Monk is a fusion of Fran's surname and Anton's."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d85bbf12-66e6-45e6-9edc-406b6a51102f",
                        "source_entry_id": "3497c6a7-2526-3d91-ba4f-64b58542735c",
