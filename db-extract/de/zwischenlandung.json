                        "examples": [
                            {
                                "example_id": "d77f718d-2d9a-4614-a334-b98304d4de1b",
                                "sense_id": "18f48ec8-206a-3fee-85a6-057b18100bb3",
                                "text": "Der Flug nach Paris ist direkt, ohne Zwischenlandung.",
                                "translation": "Le vol vers Paris est direct, sans escale."
                            },
                            {
                                "example_id": "43435b31-70c7-40a3-bbcc-5f3de4bcebe8",
                                "sense_id": "18f48ec8-206a-3fee-85a6-057b18100bb3",
                                "text": "Ein weiterer Versuch einer Zwischenlandung der Norweger auf den Kerguelen misslingt wegen des schlechten Wetters, sonst verläuft die Reise der Fram bis zum Ende des Jahres relativ ereignislos.",
                                "translation": "Un nouvel tentative des Norvégiens de faire escale aux îles Kerguelen échoue en raison du mauvais temps. Autrement, le voyage du Fram se déroule relativement sans accroc jusqu’à la fin de l’année."
                            }
                        ]
                    }
                ],
