                "senses": [
                    {
                        "sense_id": "34d4a517-8daa-3b3a-8071-90001db9568a",
                        "entry_id": "481cd8bb-1cab-3bd8-bbf5-e7a5558ea052",
                        "glosses": [
                            "Not crisp.",
                            "Not possessing firmness and freshness or brittleness (especially of foods)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5254c09a-fcce-46a6-8333-5f536f7b0aad",
                                "sense_id": "34d4a517-8daa-3b3a-8071-90001db9568a",
                                "text": "[…] if a second crop was taken from the same ground without fertilizing it, the melons would be small and what we called soapy; that is, soft and smooth, utterly uncrisp, and without a trace of the lively freshness and sweetness of those raised on virgin soil."
                            }
                        ]
                    },
                    {
                        "sense_id": "81104056-1df4-36b0-8c91-6c8708309cce",
                        "entry_id": "481cd8bb-1cab-3bd8-bbf5-e7a5558ea052",
                        "glosses": [
                            "Not crisp.",
                            "Not quick, precise, accurate or well-defined."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf2492a-3711-4046-aa93-1bc970739f17",
                                "sense_id": "81104056-1df4-36b0-8c91-6c8708309cce",
                                "text": "[…] from time to time a sort of unhealthy almost-light leaked from the large uncrisp corpse of the sky, returning for a moment to our view the ruined landscape."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac26a9bb-a8da-3ee7-9bec-ed22b757d160",
                        "entry_id": "481cd8bb-1cab-3bd8-bbf5-e7a5558ea052",
                        "glosses": [
                            "Not crisp.",
                            "Not curling in stiff curls or ringlets (of hair)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "de64882a-0d42-4ca7-9cc2-e04b56cfa0be",
                                "sense_id": "ac26a9bb-a8da-3ee7-9bec-ed22b757d160",
                                "text": "His light brown hair fell, in thin, uncrisp locks, about his white, prominent temples,"
                            }
                        ]
                    }
                ],
