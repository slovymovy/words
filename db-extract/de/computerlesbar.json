                "senses": [
                    {
                        "sense_id": "854bcf9e-16c0-3f15-affb-d7ad38838261",
                        "entry_id": "7116eeb8-e72e-3630-bfb4-d511bba8630a",
                        "glosses": [
                            "so beschaffen, dass ein Computer die Daten lesen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6bb266-b1d2-46f1-869e-a84d654371e7",
                                "sense_id": "854bcf9e-16c0-3f15-affb-d7ad38838261",
                                "text": "„In den nächsten Jahren sollen Katasterbände, Kirchenbücher, Briefe, unterschiedlichste Personenlisten (Immigranten, Passagiere etc.), Ratsprotokolle und viele andere historische Dokumente computerlesbar gemacht werden.“"
                            },
                            {
                                "example_id": "ef9c10cd-9bf0-478a-96c6-dcccb2db68b1",
                                "sense_id": "854bcf9e-16c0-3f15-affb-d7ad38838261",
                                "text": "„Dazu müssten Ärzte aber ihre Eintragungen in Krankenakten verbessern, und die Daten müssen computerlesbar sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
