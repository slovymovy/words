                                                "example_id": "98385c58-fcd9-4921-9d20-cbae1828fd51",
                                                "sense_id": "38ed4b90-d545-347d-826e-effa8ab55fa2",
                                                "text": "Une femme sentimentale."
                                            }
                                        ]
                                    }
                                ]
                            }
