                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous commencerons la réunion <w>dès</w> l'arrivée du directeur."
                        },
                        {
                            "text": "Les enfants se réveillent très tôt, souvent <w>dès</w> l'aube."
                        }
                    ],
                    "synonyms": [
                        "à partir de"
                    ],
                    "common_phrases": [
                        "dès le début",
                        "dès l'aube",
                        "dès son arrivée"
                    ]
                },
                {
                    "sense_id": "eb1bf64f-cd51-3a62-aa8a-d5def0ae22a0",
                    "sense_definition": "Aussitôt, sans attendre ; à compter de ce moment précis.",
