    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "09583d3a-cdcb-3002-93d4-3134f605b144",
                "word": "materialization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "75832f09-8123-4466-b395-4d703b13bafb",
                        "entry_id": "09583d3a-cdcb-3002-93d4-3134f605b144",
                        "tags": [
                            "plural"
                        ],
                        "form": "materializations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8458e303-dcab-37fd-a8bb-20a662316146",
                        "entry_id": "09583d3a-cdcb-3002-93d4-3134f605b144",
                        "glosses": [
                            "The conversion of something into a physical form."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a791bc9-13c2-418f-8828-e6ce6933b026",
                                "sense_id": "8458e303-dcab-37fd-a8bb-20a662316146",
                                "text": "\"But I went under nicely and I am glad there were some fine materializations.\""
                            },
                            {
                                "example_id": "5acf745c-1eb0-406f-b481-83295f319c22",
                                "sense_id": "8458e303-dcab-37fd-a8bb-20a662316146",
                                "text": "\"Steamed fish and chicken and vegetable soup and even mushrooms are considered cooling foods, edible materializations of the yang, the pure primal air. The yin, or earth element, inheres in fried dishes and especially in shark's fin soup. Am I right, Mr Lee?\""
                            },
                            {
                                "example_id": "5cf58fd0-ce25-45d1-8002-9337f525bbfb",
                                "sense_id": "8458e303-dcab-37fd-a8bb-20a662316146",
                                "text": "The Triadic Ballet was an antiballet: Schlemmer's model of theater was not influenced by the physical techniques and spatial perspective of ballet, but by the materialization of abstract principles of space and movement in the total mask of the costume."
                            }
                        ]
                    },
                    {
                        "sense_id": "43426f75-2ebb-3329-9859-20a183499686",
                        "entry_id": "09583d3a-cdcb-3002-93d4-3134f605b144",
                        "glosses": [
                            "The conversion of energy into mass."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4df77c06-b4a4-3b4a-aeb7-1b597215d87d",
                        "entry_id": "09583d3a-cdcb-3002-93d4-3134f605b144",
                        "glosses": [
                            "The creation of a temporary table containing the results of a database query."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fff9305d-4041-4852-bea4-1c52848d4714",
                        "source_entry_id": "09583d3a-cdcb-3002-93d4-3134f605b144",
                        "source_sense_description": "conversion of something into a physical form",
                        "target_lang_word": "Materialisation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Materialisation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6213434a-964d-3eec-8d3f-9436f31dce33",
                                        "entry_id": "cd7adbbf-4dc7-3692-8375-80b191d25fad",
                                        "glosses": [
                                            "der Vorgang, bei dem nach der quantitativen Beziehung E = m * c² (mit: E = Energie; m = Masse; c = Lichtgeschwindigkeit) Energie in Masse umgewandelt werden kann"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b21ad6a-27c5-4664-a161-0c996332f35b",
                                                "sense_id": "6213434a-964d-3eec-8d3f-9436f31dce33",
                                                "text": "Durch Absorption sehr durchdringender Strahlung können positive und negative Elektronen paarweise entstehen (Materialisation von Strahlung)."
                                            },
                                            {
                                                "example_id": "f0926f66-82be-43a2-b441-7484b773437c",
                                                "sense_id": "6213434a-964d-3eec-8d3f-9436f31dce33",
                                                "text": "Auch der umgekehrte Prozeß, die „Materialisation\" von Strahlungsenergie wurde beobachtet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea3167f1-d100-36d4-9b0d-6335cda3c9ca",
                                        "entry_id": "cd7adbbf-4dc7-3692-8375-80b191d25fad",
                                        "glosses": [
                                            "Vorgang, bei dem der Geist in unserer Welt in Form von Körpern oder menschlichen Körperteilen (Händen, Füßen und anderen) Gestalt annimmt"
                                        ],
                                        "tags": [
                                            "Parapsychologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f609a5-932d-4236-b328-16289b1ddaeb",
                                                "sense_id": "ea3167f1-d100-36d4-9b0d-6335cda3c9ca",
                                                "text": "Vielfache, äußerst genaue Experimente, über die wir weiter unten berichten, werden den entscheidenden Beweis für die Materialisation liefern."
                                            },
                                            {
                                                "example_id": "da99aedf-a05f-4351-a4c5-506bb5708dbb",
                                                "sense_id": "ea3167f1-d100-36d4-9b0d-6335cda3c9ca",
                                                "text": "Keiner der wissenschaftlichen Forscher (Crookes, Geley, Crawford, Schrenck-Notzing) hat den Beweis geliefert, daß Materialisationen oder Teleplastie bestehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13d216be-a1db-4722-8261-6937cb703bd8",
                        "source_entry_id": "09583d3a-cdcb-3002-93d4-3134f605b144",
                        "source_sense_description": "conversion of something into a physical form",
                        "target_lang_word": "Verkörperung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkörperung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe7a59d0-41b9-3c8d-b3d9-74bddd15aba3",
                                        "entry_id": "2a44d6b2-28a7-342c-8862-31440bfb4167",
                                        "glosses": [
                                            "Darstellung von etwas/jemand durch eine Figur mit ähnlichen/gleichen Eigenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05ddac6-c5a8-4789-92e0-84be698358d9",
                                                "sense_id": "fe7a59d0-41b9-3c8d-b3d9-74bddd15aba3",
                                                "text": "„Weil der Löwe der ägyptischen Mythologie zufolge die Augen immer offen hat, ist er die Verkörperung der Wachsamkeit.“"
                                            },
                                            {
                                                "example_id": "c9581541-0136-4164-bf03-c1e2f0ffce44",
                                                "sense_id": "fe7a59d0-41b9-3c8d-b3d9-74bddd15aba3",
                                                "text": "„Seine Hände spielen mit einer um eine Spule gewickelten Schnur, die mit einem Äffchen verbunden ist, Allegorie und verdoppelnde Verkörperung der ›Narrheit‹ des Kindes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "771ce579-3fc3-3e28-8a83-1cb87a9f5de8",
                                        "entry_id": "2a44d6b2-28a7-342c-8862-31440bfb4167",
                                        "glosses": [
                                            "Art und Weise, wie ein Schauspieler/eine Schauspielerin eine bestimmte Rolle auffasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bb979e8-8616-4508-9d79-e4d8af3f00da",
                                                "sense_id": "771ce579-3fc3-3e28-8a83-1cb87a9f5de8",
                                                "text": "Der junge Schauspieler erhielt besonderen Applaus für seine überzeugende Verkörperung des Hamlet in der neuen Shakespeare-Inszenierung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
