                "senses": [
                    {
                        "sense_id": "7be52e54-4842-3ff6-b8db-49ca7cc12c83",
                        "entry_id": "985c4692-8ea7-352f-bf98-1aecd43a61d7",
                        "glosses": [
                            "Fußboden mit Mosaiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17a7e4f0-c275-486b-bbf5-565c1cd3a871",
                                "sense_id": "7be52e54-4842-3ff6-b8db-49ca7cc12c83",
                                "text": "„In den meisten der Paläste befanden sich Mosaikböden aus Beryll, Lapislazuli, Sardonyx, Karfunkel und anderen erlesenen Materialen, sodass der Betrachter glauben mochte, er wandle über Beete kostbarster Blumen.“"
                            },
                            {
                                "example_id": "4954956f-af90-41b0-9c48-eea424627fb2",
                                "sense_id": "7be52e54-4842-3ff6-b8db-49ca7cc12c83",
                                "text": "„Die zweite Seite gab in Youngs nur allzu vertrauter Handschrift eine lokale Legende wieder, der zufolge die Römer, die den Mosaikboden in Goatswood gelegt hatten, in der Tat einen vergessenen Kult praktizierten.“"
                            },
                            {
                                "example_id": "92d2c9a8-114f-4379-9093-00ffe2a97d67",
                                "sense_id": "7be52e54-4842-3ff6-b8db-49ca7cc12c83",
                                "text": "„Wenige Monate zuvor hatten die Siedler dort eine antike Synagoge mit einem wunderbaren Mosaikboden ausgegraben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
