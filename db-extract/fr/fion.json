            {
                "entry_id": "50d8ac40-b6c8-3877-a82a-c7b37c555a83",
                "word": "fion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "737a77b3-238b-4571-86c3-26b3c39752a5",
                        "entry_id": "50d8ac40-b6c8-3877-a82a-c7b37c555a83",
                        "tags": [
                            "plural"
                        ],
                        "form": "fions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cd32220-4da9-3534-9af0-b190d7fbf155",
                        "entry_id": "50d8ac40-b6c8-3877-a82a-c7b37c555a83",
                        "glosses": [
                            "Derrière ; cul ; fesses , postérieur, popotin."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "05073f80-f2ab-4a34-b275-25395f21b646",
                                "sense_id": "5cd32220-4da9-3534-9af0-b190d7fbf155",
                                "text": "Il aurait préféré la suivre, voir comment roulait le fion, test révélateur."
                            },
                            {
                                "example_id": "ee0658d7-b7a7-4d22-8296-548a2900ac88",
                                "sense_id": "5cd32220-4da9-3534-9af0-b190d7fbf155",
                                "text": "M'est avis que sa haine qui l’animosait contre moi se meurt doucettement, balayée par le désir qui la rebiche en force. C'est ça, le fion, darlinge ; une obsession qui point, s'épanouit et investit complètement l'heureux bénéficiaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "eae5aad6-bfc8-3db9-a8a4-f7758ef2c453",
                        "entry_id": "50d8ac40-b6c8-3877-a82a-c7b37c555a83",
                        "glosses": [
                            "Anus ; fondement."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "08a77027-877e-47e2-b96d-2c35a1ca705a",
                                "sense_id": "eae5aad6-bfc8-3db9-a8a4-f7758ef2c453",
                                "text": "Tes remarques, mon garçon, tu peux te les foutre dans le fion !"
                            }
                        ]
                    },
                    {
                        "sense_id": "a76d824a-c7ec-32bd-94ff-86d9f31990fe",
                        "entry_id": "50d8ac40-b6c8-3877-a82a-c7b37c555a83",
                        "glosses": [
                            "Chance. — → voir bol, cul et pot."
                        ],
                        "tags": [
                            "figuratively",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "e6082881-ac81-42c1-8982-14d14bb2c7b7",
                                "sense_id": "a76d824a-c7ec-32bd-94ff-86d9f31990fe",
                                "text": "Alors, toi, on peut dire que tu manques de fion !"
                            }
                        ]
                    }
                ],
