                    ],
                    "target_lang_definitions": {
                        "ru": "На большой территории или расстоянии; повсюду.",
                        "nl": "Over een groot gebied of grote afstand; uitgebreid.",
                        "tr": "Geniş bir alanda veya mesafede; yaygın bir şekilde.",
                        "zh": "在很大的区域或距离内；广泛地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повсюду",
                                "target_lang_sense_clarification": "везде"
                            },
                            {
                                "target_lang_word": "отовсюду",
                                "target_lang_sense_clarification": "со всех сторон"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "overal",
                                "target_lang_sense_clarification": "van heinde en verre"
                            },
                            {
                                "target_lang_word": "wijd",
                                "target_lang_sense_clarification": "over een groot gebied verspreid"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dört bir yandan",
                                "target_lang_sense_clarification": "her yerden, uzak yerlerden"
                            },
                            {
                                "target_lang_word": "her yerde",
                                "target_lang_sense_clarification": "yaygın bir alanda"
                            }
                        ],
                        "zh": [
