                        "entry_id": "5c9562f1-789d-30f6-9fd2-7cddf442aa7c",
                        "glosses": [
                            "Nom vernaculaire de plusieurs oiseaux passereaux de taille moyenne, montagnards, insectivores ou omnivores, proches du merle :"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9438faad-f88f-439c-9b5c-7d6cddafee4e",
                                "sense_id": "b7b78d34-e43f-3c7e-afd5-ee8cf8e4a670",
                                "text": "le monticole merle-bleu ou monticole bleu (Monticola solitarius) couramment appelé merle bleu, européen, nord-africain et asiatique"
                            },
                            {
                                "example_id": "8b505bc0-5d66-42fe-848a-9cd35e05057c",
                                "sense_id": "b7b78d34-e43f-3c7e-afd5-ee8cf8e4a670",
                                "text": "le monticole merle-de-roche (Monticola saxatilis) traditionnellement appelé merle de roche,"
                            },
                            {
                                "example_id": "df987f83-ced4-4ea3-845d-3ace970ef41d",
                                "sense_id": "b7b78d34-e43f-3c7e-afd5-ee8cf8e4a670",
                                "text": "le monticole à doigts courts (Monticola brevipes), habitant des savanes sèches du sud de l'Afrique"
                            },
                            {
                                "example_id": "a0b20df6-80dc-4658-884e-c8917fadcb09",
                                "sense_id": "b7b78d34-e43f-3c7e-afd5-ee8cf8e4a670",
                                "text": "etc."
                            },
                            {
                                "example_id": "3ff808c4-16a4-4399-bf32-99d30cd7fab8",
                                "sense_id": "b7b78d34-e43f-3c7e-afd5-ee8cf8e4a670",
                                "text": "On y trouve l’aigle de Bonelli, le vautour percnoptère et le grand-duc d’Europe, mais aussi le monticole bleu ou le monticole de roche."
                            }
                        ]
                    }
