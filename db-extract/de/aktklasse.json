                "senses": [
                    {
                        "sense_id": "a164f136-9912-36a0-87fe-7b07057502bb",
                        "entry_id": "02b52ac0-5f3e-3600-a0a5-e45d65b8e4e5",
                        "glosses": [
                            "Kunstunterricht, der sich auf das Zeichnen, Malen oder Fotografieren von unbekleideten Modellen (oder die Darstellung des menschlichen Körpers) konzentriert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b2a1ffb-7edc-46fc-a3ca-b4c1179c219c",
                                "sense_id": "a164f136-9912-36a0-87fe-7b07057502bb",
                                "text": "„Ich schrieb mich in die Aktklasse der Kunstschule ein und zeichnete und malte ein paar Semester lang zweimal in der Woche nackte Modelle von allen Seiten.“"
                            },
                            {
                                "example_id": "6ca1d77b-1399-4c71-a575-6368b7d02ec9",
                                "sense_id": "a164f136-9912-36a0-87fe-7b07057502bb",
                                "text": "„Bei der endgültigen Aufnahme wurde er in die Aktklasse versetzt, in der nach dem lebenden Modell gezeichnet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
