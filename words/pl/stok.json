    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f303c135-409e-397d-8520-ece2a67e1ee4",
                    "sense_definition": "nachylona powierzchnia terenu rozpościerająca się między wierzchołkiem wzniesienia a jego podnóżem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ukształtowanie terenu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zimą narciarze chętnie zjeżdżają na nartach po oświetlonym <w>stoku</w> góry.",
                            "target_lang_translations": {
                                "ru": "Зимой лыжники с удовольствием катаются по освещённому <w>склону</w> горы."
                            }
                        },
                        {
                            "text": "Na północnym <w>stoku</w> Kasprowego Wierchu panują znakomite warunki narciarskie.",
                            "target_lang_translations": {
                                "ru": "На северном <w>склоне</w> Каспровы-Верха отличные условия для катания на лыжах."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbocze",
                        "skłon"
                    ],
                    "common_phrases": [
                        "stok narciarski",
                        "stok góry",
                        "stromy stok"
                    ],
                    "target_lang_definitions": {
                        "ru": "наклонная поверхность местности между вершиной возвышенности и её подножием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "горы, холма или возвышенности"
                            },
                            {
                                "target_lang_word": "спуск",
                                "target_lang_sense_clarification": "горнолыжный или наклонный участок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "300a13f6-3286-3955-a0f7-68cedd7dab46",
                    "sense_definition": "zagłębienie lub struktura anatomiczna w kształcie stoku na kości potylicznej i klinowej",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz szczegółowo opisał <w>stok</w> podstawy czaszki widoczny na badaniu rezonansem.",
                            "target_lang_translations": {
                                "ru": "Врач подробно описал <w>скат</w> основания черепа, видный на снимке МРТ."
                            }
                        },
                        {
                            "text": "W anatomii człowieka <w>stok</w> stanowi nachyloną powierzchnię tworzoną przez kość klinową i potyliczną.",
                            "target_lang_translations": {
                                "ru": "В анатомии человека <w>скат</w> представляет собой наклонную поверхность, образованную клиновидной и затылочной костями."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "наклонная анатомическая структура основания черепа, образованная клиновидной и затылочной костями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скат",
                                "target_lang_sense_clarification": "анатомический термин (скат черепа, clivus)"
                            },
                            {
                                "target_lang_word": "кливус",
                                "target_lang_sense_clarification": "латинский медицинский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "136ce3de-8651-3fb0-84e1-680a414f01ef",
                    "sense_definition": "niewielki strumyk, potok lub wypływ wody ze źródła",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "woda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zmęczeni wędrowcy pili zimną wodę z górskiego <w>stoku</w> płynącego wśród skał.",
                            "target_lang_translations": {
                                "ru": "Уставшие путники пили холодную воду из горного <w>ручья</w>, протекавшего среди скал."
                            }
                        },
                        {
                            "text": "W cieniu drzew szemrał cichy <w>stok</w> dający wytchnienie spragnionym leśnym zwierzętom.",
                            "target_lang_translations": {
                                "ru": "В тени деревьев журчал тихий <w>ручеёк</w>, дававший облегчение испытывающим жажду лесным животным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "znaczenie rzadkie i przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой ручей, поток или исток воды (устаревшее значение)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ручей",
                                "target_lang_sense_clarification": "водный поток"
                            },
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "струящаяся вода"
                            },
                            {
                                "target_lang_word": "исток",
                                "target_lang_sense_clarification": "вытекающая вода, родник"
                            }
                        ]
                    }
                }
            ]
        }
    ]
