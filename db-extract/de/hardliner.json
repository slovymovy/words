                        ],
                        "form": "den Hardliner"
                    },
                    {
                        "form_id": "7f8e9f55-6c79-437a-980b-09ec3a6dfff2",
                        "entry_id": "01b4e1a8-b9d0-3877-a830-0615571f6328",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hardliner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b6de311-9ff6-316f-a12f-4484c4394b28",
                        "entry_id": "01b4e1a8-b9d0-3877-a830-0615571f6328",
                        "glosses": [
                            "Person, die ein meist politisches Ziel gegen jeden Widerstand versucht durchzusetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62534deb-6a94-4f21-9f6e-341a09b4ee90",
                                "sense_id": "7b6de311-9ff6-316f-a12f-4484c4394b28",
                                "text": "„Der oft als Hardliner kritisierte ranghöchste deutsche Kardinal hatte zuletzt von sich reden gemacht, als er öffentlich klarmachte, dass er keinerlei Reformbedarf innerhalb der katholischen Kirche erkennen könne.“"
                            },
                            {
                                "example_id": "e86d5247-98dc-4e90-b2d7-78a3a3c0dcf1",
                                "sense_id": "7b6de311-9ff6-316f-a12f-4484c4394b28",
                                "text": "„Den beiden Hardlinern stehen Trumps Schwiegersohn Jared Kushner und sein Stabschef Reince Priebus gegenüber, ein republikanischer Parteisoldat.“"
                            },
                            {
                                "example_id": "60a4097d-10b3-489c-846c-9096332df0fe",
                                "sense_id": "7b6de311-9ff6-316f-a12f-4484c4394b28",
                                "text": "„Bereits im Wahlkampf hatte der Amerikaner den israelischen Hardlinern Avancen gemacht – den Siedlungsbau unterstützt und sich gegen eine Zweistaatenlösung ausgesprochen.“"
                            },
                            {
                                "example_id": "f718acaf-6bdc-499a-8985-0bb7aac38242",
                                "sense_id": "7b6de311-9ff6-316f-a12f-4484c4394b28",
                                "text": "„Robert Mugabe tat sich hingegen bereits als Hardliner hervor, als er betonte, die Hälfte der Parlamentssitze sei das Minimum dessen, was die Delegation hinnehmen dürfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acea53cf-da53-4fbb-86cc-74cd9eb30dce",
                        "source_entry_id": "01b4e1a8-b9d0-3877-a830-0615571f6328",
                        "source_sense_id": "7b6de311-9ff6-316f-a12f-4484c4394b28",
                        "source_sense_description": "Person, die ein meist politisches Ziel gegen jeden Widerstand versucht durchzusetzen",
                        "target_lang_word": "hard-liner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hard-liner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb432e62-b1b7-318b-9ed0-2b8e51fcb611",
                                        "entry_id": "bbcfac91-35fc-35b2-8485-ca92ced81927",
                                        "glosses": [
                                            "A person who takes a firm and uncompromising position on some policy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88252d3c-6048-45ac-9889-beab83cc849c",
                                                "sense_id": "bb432e62-b1b7-318b-9ed0-2b8e51fcb611",
                                                "text": "Because of what was perceived as his sensitive and fair handling of the \"Revere Cases,\" Butters became the subject of much criticism from hard-liners in law enforcement."
                                            },
                                            {
                                                "example_id": "c73db290-725c-47f0-a6c7-9085bfbf28e3",
                                                "sense_id": "bb432e62-b1b7-318b-9ed0-2b8e51fcb611",
                                                "text": "The hardliners, persistent in their belief that the UK would in the end be afforded special treatment by the EU, have served only to undermine the very mandate they seek to protect."
                                            },
                                            {
                                                "example_id": "d1bfb952-4470-44b2-a018-7ab78a01ae33",
                                                "sense_id": "bb432e62-b1b7-318b-9ed0-2b8e51fcb611",
                                                "text": "As hard-liners gain power within a group, they drive out moderates; what remains of the group is even more extreme, which drives out even more moderates; and so on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48a8c4d8-c29a-4aa3-8307-711519f14bfb",
                        "source_entry_id": "01b4e1a8-b9d0-3877-a830-0615571f6328",
                        "source_sense_id": "7b6de311-9ff6-316f-a12f-4484c4394b28",
                        "source_sense_description": "Person, die ein meist politisches Ziel gegen jeden Widerstand versucht durchzusetzen",
                        "target_lang_word": "hardliner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hardliner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1b622ac-095f-3591-8097-50cac6253f9b",
                                        "entry_id": "201e8cde-52fd-3ed9-8f3c-78bf238bb834",
                                        "glosses": [
                                            "Alternative form of hard-liner."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa950370-cb7d-4d8d-a080-1f255501d62f",
                                                "sense_id": "d1b622ac-095f-3591-8097-50cac6253f9b",
                                                "text": "On the other side, RMT General Secretary Mick Lynch (a moderate) has to contend with the hardliners on his executive, whose intentions go way beyond trying to sort out their members' terms and conditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
