                "translations": [
                    {
                        "translation_id": "c881166d-c93c-4dd9-9f1c-898de16275b3",
                        "source_entry_id": "b64664d5-dd39-3848-96eb-7185067a428b",
                        "source_sense_id": "72eb8beb-ffcc-3e3a-88a8-042bfab83c98",
                        "source_sense_description": "one who is expelled",
                        "target_lang_word": "Vertriebener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vertriebener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "179c14d1-9865-3320-ae8c-a3ca01adf5c2",
                                        "entry_id": "bfac91b7-87a2-388b-816c-b001d64c042e",
                                        "glosses": [
                                            "Person, die unter Zwang ihre Heimat verlassen musste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d90cda9-c335-41e1-b1b2-5bdf2d9822a0",
                                                "sense_id": "179c14d1-9865-3320-ae8c-a3ca01adf5c2",
                                                "text": "In Deutschland wurden nach dem letzten Krieg viele Vertriebene aufgenommen."
                                            },
                                            {
                                                "example_id": "c36ac4e9-f414-4983-8bb5-1cbd18596bb6",
                                                "sense_id": "179c14d1-9865-3320-ae8c-a3ca01adf5c2",
                                                "text": "„Für die Vertriebenen war die Integration oft alles andere als einfach.“"
                                            },
                                            {
                                                "example_id": "aea4bcb9-bed9-49bf-86e7-dad1949f0967",
                                                "sense_id": "179c14d1-9865-3320-ae8c-a3ca01adf5c2",
                                                "text": "„In der Stadt lebten damals einige Tausend Flüchtlinge und Vertriebene, darunter über Tausend Ausländer.“"
                                            },
                                            {
                                                "example_id": "05ba50af-a763-4a55-8a02-0d780dba2d44",
                                                "sense_id": "179c14d1-9865-3320-ae8c-a3ca01adf5c2",
                                                "text": "„Auch sie waren Flüchtlinge, gelegentlich Vertriebene.“"
                                            },
                                            {
                                                "example_id": "d9c07f95-187c-449f-a2cd-3958b2b78853",
                                                "sense_id": "179c14d1-9865-3320-ae8c-a3ca01adf5c2",
                                                "text": "„Die wohnte mit ihren drei Kindern im Dorf und war eine von den Vertriebenen, die geblieben waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
