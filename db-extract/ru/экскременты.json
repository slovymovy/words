                                "target_word": "excrement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8411ece9-bb69-372f-a13a-710240475ea3",
                                        "entry_id": "c18fc8cd-8a9e-34d8-890f-27d8390a028d",
                                        "glosses": [
                                            "Human and non-human animal solid waste excreted from the bowels; feces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8783e68c-8ab9-4ffa-bb56-5d25f2931a6c",
                                                "sense_id": "8411ece9-bb69-372f-a13a-710240475ea3",
                                                "text": "The Roman poet Horace states that the excrement of the crocodile has aphrodisiac virtues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d34c7f-4dab-3af1-af78-864b717ad60a",
                                        "entry_id": "c18fc8cd-8a9e-34d8-890f-27d8390a028d",
                                        "glosses": [
                                            "Any waste matter excreted from the human or non-human animal body, or discharged by bodily organs."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8d788f-16fb-42fc-88ee-5d15c5252b68",
                                                "sense_id": "77d34c7f-4dab-3af1-af78-864b717ad60a",
                                                "text": "A French Gentleman was ever wont to blow his nose in his hand […]. He asked me on a time, what privilege this filthie excrement had, that wee should have a daintie linnen cloth or handkercher to receive the same."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "excrement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
