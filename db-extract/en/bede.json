                                "text": "A turnement were best to bede."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc5de1a8-b34f-36d4-ad5a-1c6f5d813e97",
                        "entry_id": "3727dcb9-a274-3d89-8d1b-18b6623ddccc",
