        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cd739131-8343-3df0-8906-b5e7ebd15c6a",
                "word": "belted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "df867870-2888-3521-abd2-aa6663b3e4ca",
                        "entry_id": "cd739131-8343-3df0-8906-b5e7ebd15c6a",
                        "glosses": [
                            "Fitted with a belt."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a0f5969-6c3d-4676-bbb0-b40fc7fa9efa",
                                "sense_id": "df867870-2888-3521-abd2-aa6663b3e4ca",
                                "text": "Air Force Chief of Staff General Hoyt S. Vandenberg explained to a House Appropriations subcommittee why the Air Force prefers suspenders: “A battle jacket with belted trousers is an unsightly appearing garment. Every time you lean over your shirt sticks out in back...”"
                            },
                            {
                                "example_id": "5fb45ba5-7a77-49fe-a6df-d32c30680fcf",
                                "sense_id": "df867870-2888-3521-abd2-aa6663b3e4ca",
                                "text": "She was a doctor's receptionist, and wore a blouse and skirt under her belted mac."
                            },
                            {
                                "example_id": "fe0baa29-b9f7-4b6a-8e79-0a6880fb206a",
                                "sense_id": "df867870-2888-3521-abd2-aa6663b3e4ca",
                                "text": "And although we’ve certainly seen a variety of blue shades — from periwinkle to cobalt and even Dean Cain’s indigo-washed costume from the 1990’s TV show “Lois & Clark” — Superman’s uniform is still instantly recognizable across generations. In fact, there is only one film — Zack Snyder’s 2013 “Man of Steel” — in which Superman does not wear his iconic red belted trunks."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3251dcc-925f-39b1-b4d5-92357f8590a9",
                        "entry_id": "cd739131-8343-3df0-8906-b5e7ebd15c6a",
                        "glosses": [
                            "Wearing a belt."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "372627fa-8d3d-4448-b2d2-a58c27854a1c",
                                "sense_id": "b3251dcc-925f-39b1-b4d5-92357f8590a9",
                                "text": "How the bayonets gleamed and glistened, as we looked far down, and listened\nTo the trampling and the drum-beat of the belted grenadiers!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c345b27a-be18-3fbf-b3bb-ac8547d25765",
                        "entry_id": "cd739131-8343-3df0-8906-b5e7ebd15c6a",
                        "glosses": [
                            "Characterized by a white band around the body."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "33d3995a-8455-40b6-a42a-be14b88778ae",
                                "sense_id": "c345b27a-be18-3fbf-b3bb-ac8547d25765",
                                "text": "Belted Dutch cattle"
                            },
                            {
                                "example_id": "0d9d90ae-1257-4b10-96d4-5f71a0b58873",
                                "sense_id": "c345b27a-be18-3fbf-b3bb-ac8547d25765",
                                "text": "Belted Galloway"
                            },
