                ],
                "senses": [
                    {
                        "sense_id": "b77b51e3-0cbb-3e51-aa0e-0fb686d7ddad",
                        "entry_id": "04929975-c326-3e26-95cc-dc4f5a34a2c0",
                        "glosses": [
                            "церк., разг., : канун многодневного поста; последний день, когда верующим разрешается приём скоромной пищи"
                        ],
                        "tags": [
                            "у православных"
                        ],
                        "examples": [
                            {
                                "example_id": "cd17a066-4949-4501-8084-a109301d014a",
                                "sense_id": "b77b51e3-0cbb-3e51-aa0e-0fb686d7ddad",
                                "text": "Таким образом в сём нерешительном положении прошло довольно времени, и настало заговенье перед масленой."
                            },
                            {
                                "example_id": "c5bb0d9c-38a8-4b1f-8925-238a411df06f",
                                "sense_id": "b77b51e3-0cbb-3e51-aa0e-0fb686d7ddad",
                                "text": "Так мы провели 10 февраля, день воскресный, заговенье великого поста."
                            },
                            {
                                "example_id": "68821fd1-53e9-4e4a-88dc-d59c44bd5360",
                                "sense_id": "b77b51e3-0cbb-3e51-aa0e-0fb686d7ddad",
                                "text": "Нередко хороводы водились в Троицын день и в заговенье перед Петровым постом."
                            }
                        ]
                    }
                ],
