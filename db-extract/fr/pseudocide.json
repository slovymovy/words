                                        "examples": [
                                            {
                                                "example_id": "165fc657-773f-4790-8e6f-7c95e14bf990",
                                                "sense_id": "24f3add3-03de-364d-af31-3d49432055c3",
                                                "text": "Secondly, the contention that suicide attempts are self-therapy is clarified by introducing the concept pseudocide, with no implication that pseudocides eventually lead to suicides."
                                            },
                                            {
                                                "example_id": "aca6044a-974f-488b-a06f-0c0a3cbd34b3",
                                                "sense_id": "24f3add3-03de-364d-af31-3d49432055c3",
                                                "text": "Some suspect Lord Lucan of pseudocide after he vanished in 1974 on the night of a murder in the Lucan household. His family, though, are convinced the peer killed himself for real."
                                            },
                                            {
                                                "example_id": "252bf760-94d4-40b6-9f75-5bdd2cd78bd0",
                                                "sense_id": "24f3add3-03de-364d-af31-3d49432055c3",
                                                "text": "2005, Philip M. McCarthy, An Assessment of the Range and Usefulness of Lexical Diversity Measures and the Potential of the Measure of Textual, Lexical Diversity (MTLD), PhD dissertation, The University of Memphis.\nOsgood examined suicide notes and compared them to pseudocide notes predicting that greater motivational levels would lead to more frequent use of high frequency words."
                                            }
