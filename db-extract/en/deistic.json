                                        "glosses": [
                                            "auf die Lehre des Deismus bezogen, ihr folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ffa75c-9479-4393-a7b5-58146230e92f",
                                                "sense_id": "11f66461-a2bd-33cf-b218-e00c4c421407",
                                                "text": "„Unser Gegner tritt mit der Behauptung auf, dass die von ihm recensirte Ethik durch und durch deistisch, d.h. verwerflich sei.“"
                                            },
                                            {
                                                "example_id": "44896f2d-df16-49b1-9483-329d3a7dd10a",
                                                "sense_id": "11f66461-a2bd-33cf-b218-e00c4c421407",
                                                "text": "„Freilich weist der Gott, dessen Existenz hier bejaht wird, Züge eines deistisch gedachten Schöpfers auf, der die Welt kausal herstellt bzw. der dann in der Welt nicht mehr vorkommt.“"
                                            }
                                        ],
