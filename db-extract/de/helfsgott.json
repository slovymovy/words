                "senses": [
                    {
                        "sense_id": "3f32ed09-f45a-31ce-af69-f236afe0d08f",
                        "entry_id": "5a04f2a6-64c9-3f0c-ba96-89291649ae3c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb307720-dd33-42af-aded-f701f542acf8",
                                "sense_id": "3f32ed09-f45a-31ce-af69-f236afe0d08f",
                                "text": "Frau Helfsgott ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "10b97f8c-50c1-4a9a-88bb-828527764bda",
                                "sense_id": "3f32ed09-f45a-31ce-af69-f236afe0d08f",
                                "text": "Herr Helfsgott wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9d208072-ad4f-44f0-8373-fa26ce0fe299",
                                "sense_id": "3f32ed09-f45a-31ce-af69-f236afe0d08f",
                                "text": "Die Helfsgotts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "400baf5b-6907-433d-9ff5-a7e4cba3ff64",
                                "sense_id": "3f32ed09-f45a-31ce-af69-f236afe0d08f",
                                "text": "Der Helfsgott trägt nie die Schals, die die Helfsgott ihm strickt."
                            },
                            {
                                "example_id": "ee858155-d15b-40b4-a169-be7bdcc28e5d",
                                "sense_id": "3f32ed09-f45a-31ce-af69-f236afe0d08f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Helfsgott kommt, geht der Herr Helfsgott.“"
                            },
                            {
                                "example_id": "4134356a-0fbd-4de0-a959-bc2d996aa752",
                                "sense_id": "3f32ed09-f45a-31ce-af69-f236afe0d08f",
                                "text": "Helfsgott kommt und geht."
                            },
                            {
                                "example_id": "1ff3fd49-f6bf-432b-a867-72682caad7db",
                                "sense_id": "3f32ed09-f45a-31ce-af69-f236afe0d08f",
                                "text": "Helfsgotts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
