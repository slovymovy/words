                ],
                "senses": [
                    {
                        "sense_id": "5226d21f-f28f-380e-928f-6fce3d97cdfc",
                        "entry_id": "adcb24ec-c329-310f-8887-e0f2d5db0b7b",
                        "glosses": [
                            "Person, die Zither spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4506c11f-08c6-4209-97e3-dd8a0ec79624",
                                "sense_id": "5226d21f-f28f-380e-928f-6fce3d97cdfc",
                                "text": "Der Zitherspieler kam zu spät zu seinem Auftritt."
                            },
                            {
                                "example_id": "61e2bf19-e55b-4172-bc2f-0ae8a0779941",
                                "sense_id": "5226d21f-f28f-380e-928f-6fce3d97cdfc",
                                "text": "„Dafür, dass nicht jeder Zitherspieler das Werk von Karas spielen mag, hat sie hingegen Verständnis.“"
                            },
                            {
                                "example_id": "91fc403b-c243-448c-8565-5b4701b3eff6",
                                "sense_id": "5226d21f-f28f-380e-928f-6fce3d97cdfc",
                                "text": "„Vier Zitherspieler leben in München, der Rest des Orchesters kommt aus den Landkreisen München, Dachau, Starnberg, Wolfratshausen, Miesbach, Traunstein und Fürstenfeldbruck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
