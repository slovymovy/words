                                "target_senses": [
                                    {
                                        "sense_id": "f9dd485b-0651-3655-9bc5-dcb8a2ff5fa5",
                                        "entry_id": "b8f9e00d-15e1-3456-8720-603e0b6d2f3b",
                                        "glosses": [
