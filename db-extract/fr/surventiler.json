                "senses": [
                    {
                        "sense_id": "5c3da385-8b87-311b-a8f3-c31e56c60f88",
                        "entry_id": "e2f4cc85-32b5-375e-ad53-dca4bc2f2bb1",
                        "glosses": [
                            "Ventiler abondamment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09e7d3c6-e512-4615-9de5-7e4059c9172c",
                                "sense_id": "5c3da385-8b87-311b-a8f3-c31e56c60f88",
                                "text": "Au massage doit être coordonnée une ventilation artificielle adéquate. Pourquoi ? Surventiler expose à des risques de lésions pulmonaires."
                            },
                            {
                                "example_id": "9cee5d4a-2272-4f91-b0be-9162a3deff8b",
                                "sense_id": "5c3da385-8b87-311b-a8f3-c31e56c60f88",
                                "text": "La clé d’une bonne ventilation réside dans la maîtrise des débits d’air : aérer sans excès en fonction des besoins, en hiver et de jour lors des chaleurs estivales, et surventiler de nuit en été pour bénéficier de la fraîcheur nocturne."
                            },
                            {
                                "example_id": "05f99f1e-39c5-4678-9635-dc6261a8455b",
                                "sense_id": "5c3da385-8b87-311b-a8f3-c31e56c60f88",
                                "text": "Cette surventilation peut être mécanique, certaines VMC peuvent surventiler automatiquement la nuit, ou manuelle, fenêtres laissées ouvertes la nuit."
                            }
                        ]
                    }
                ],
