{
    "word_family": [
        "expletory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85d11f37-a690-32f9-8e95-86aed7f67971",
                    "sense_definition": "A profane, vulgar, or obscene word, especially an oath or swear word.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "profanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He shouted an angry <w>expletive</w> when he dropped the heavy box on his foot."
                        },
                        {
                            "text": "The television broadcast was censored to remove every offensive <w>expletive</w>."
                        }
                    ],
                    "synonyms": [
                        "swear word",
                        "bad word",
                        "oath"
                    ],
                    "common_phrases": [
                        "shout an expletive",
                        "mutter an expletive",
                        "deleted expletive"
                    ]
                },
                {
                    "sense_id": "3e90d106-e192-3d83-a005-60a83930a111",
                    "sense_definition": "A word that performs a syntactic role in a sentence without contributing meaning of its own.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the sentence 'It is raining,' the pronoun 'it' serves as a grammatical <w>expletive</w>."
                        },
                        {
                            "text": "The linguist analyzed the use of an <w>expletive</w> filler in modern spoken English."
                        }
                    ],
                    "common_phrases": [
                        "expletive pronoun"
                    ]
                },
                {
                    "sense_id": "575530b2-c71d-3d90-bec0-de348b61cd68",
                    "sense_definition": "A word inserted to intensify the force of an utterance without altering its essential meaning.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker threw in an occasional <w>expletive</w> merely to give extra force to his argument."
                        },
                        {
                            "text": "Certain vulgar adverbs function primarily as an <w>expletive</w> rather than providing factual information."
                        }
                    ],
                    "synonyms": [
                        "intensifier"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76f6dc86-422e-3d5c-988c-c37c56ec8b3c",
                    "sense_definition": "Serving merely to fill out a phrase, sentence, or verse without adding to its meaning.",
