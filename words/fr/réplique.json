                        "réplique fidèle"
                    ]
                },
                {
                    "sense_id": "15e0ee44-4d82-3f8b-80e7-6fe9edcaebda",
                    "sense_definition": "Secousse tellurique secondaire qui se produit après un séisme principal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une forte <w>réplique</w> a secoué le centre du pays quelques heures après le tremblement de terre."
                        },
                        {
                            "text": "Les habitants ont passé la nuit dans la rue par peur d'une nouvelle <w>réplique</w>."
                        }
                    ],
                    "synonyms": [
