                                "target_senses": [
                                    {
                                        "sense_id": "257452d4-db8d-308c-b5d5-ae46f6ed7e8d",
                                        "entry_id": "1eecb70a-eda1-3512-979e-cfac3359deb1",
                                        "glosses": [
                                            "To scratch or to tear at."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1693dc88-c4ce-4e62-b94e-35ee47313f21",
                                                "sense_id": "257452d4-db8d-308c-b5d5-ae46f6ed7e8d",
                                                "text": "Using her hands like windshield wipers, she tried to flick snow away from her mouth. When she clawed at her chest and neck, the crumbs maddeningly slid back onto her face. She grew claustrophobic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfe45c1e-6bdf-32be-8ff8-824160c1d3d9",
                                        "entry_id": "1eecb70a-eda1-3512-979e-cfac3359deb1",
                                        "glosses": [
                                            "To use the claws to seize, to grip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8d55162-88af-314a-8496-32952b2322df",
                                        "entry_id": "1eecb70a-eda1-3512-979e-cfac3359deb1",
                                        "glosses": [
                                            "To use the claws to climb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08993698-ee1c-3e0d-b6a2-59e7d90640dd",
                                        "entry_id": "1eecb70a-eda1-3512-979e-cfac3359deb1",
                                        "glosses": [
                                            "To perform a claw catch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e403d9de-06f5-3384-9721-0dd2b4b0e541",
                                        "entry_id": "1eecb70a-eda1-3512-979e-cfac3359deb1",
                                        "glosses": [
                                            "To move with one's fingertips."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0814e996-242d-4ba5-bb67-4f91b1216768",
                                                "sense_id": "e403d9de-06f5-3384-9721-0dd2b4b0e541",
                                                "text": "De Gea was United's hero again within seconds of Hernandez's equaliser, diving to his left to claw away Dirk Kuyt's shot as he got on the end of a superb cross from Stewart Downing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5655e97-eb10-35e1-b08c-9dd8600e44dd",
                                        "entry_id": "1eecb70a-eda1-3512-979e-cfac3359deb1",
                                        "glosses": [
                                            "To relieve an uneasy feeling, such as an itch, by scratching (someone or something); hence (figuratively), to flatter or humour (someone); to court, to fawn on."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a4da52a-a51c-4037-bc1c-9afe5189eaa6",
                                                "sense_id": "f5655e97-eb10-35e1-b08c-9dd8600e44dd",
                                                "text": "I cannot hide what I am: I must be sad when I have cause, and smile at no man's jests; eat when I have stomach, and wait for no man's leisure; sleep when I am drowsy, and tend on no man's business; laugh when I am merry, and claw no man in his humour."
                                            },
                                            {
                                                "example_id": "6aec6b53-4e5e-4640-adf2-cb92c10f8561",
                                                "sense_id": "f5655e97-eb10-35e1-b08c-9dd8600e44dd",
                                                "text": "To be ſhort, a wretched and curſed generation they be; hypocrites, pretending friendſhip, but they can not skill of plaine dealing and franke ſpeech. Rich men they claw, ſooth up and flatter: the poore they contemne and despiſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "126ca281-031d-3396-ae3d-ea7c4434370a",
                                        "entry_id": "1eecb70a-eda1-3512-979e-cfac3359deb1",
                                        "glosses": [
                                            "To rail at, revile, or scold (someone or something)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed95f5cb-d93b-475e-b81b-f387cd547c50",
                                                "sense_id": "126ca281-031d-3396-ae3d-ea7c4434370a",
                                                "text": "In the aforesaid preamble, the king fairly claweth the great monasteries, wherein, saith he, religion, thanks be to God, is right well kept and observed; though he claweth them soon after in another acceptation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63e483bc-993c-30d0-b8a3-4d9ab96ca176",
                                        "entry_id": "1eecb70a-eda1-3512-979e-cfac3359deb1",
                                        "glosses": [
                                            "To do (something) quickly."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc5ff62-5933-4d05-9dcc-e98c552f6f3d",
                                                "sense_id": "63e483bc-993c-30d0-b8a3-4d9ab96ca176",
                                                "text": "Do'n't you remember, Sirrah, ſayes one, hovv vve clavv'd it avvay at ſuch a Place! Yes, ye Damn'd Rogue you, cryes t'other, vvhen you vvere ſo drunk you took your Aunt for the Bavvd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
