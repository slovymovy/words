{
    "word_family": [],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "e1d7b705-7427-31bb-833b-b45c28d6a7e9",
                    "sense_definition": "In spite of; despite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Notwithstanding</w> the bad weather, they decided to go ahead with the outdoor event.",
                            "target_lang_translations": {
                                "tr": "Kötü havaya <w>rağmen</w>, açık hava etkinliğini gerçekleştirmeye karar verdiler.",
                                "zh": "<w>尽管</w>天气不好，他们还是决定继续举办户外活动。",
                                "de": "<w>Trotz</w> des schlechten Wetters entschieden sie sich, die Outdoor-Veranstaltung durchzuführen."
                            }
                        },
                        {
                            "text": "He succeeded in finishing the marathon <w>notwithstanding</w> his severe injury.",
                            "target_lang_translations": {
                                "tr": "Ciddi yaralanmasına <w>rağmen</w> maratonu bitirmeyi başardı.",
                                "zh": "<w>尽管</w>受了重伤，他还是成功跑完了马拉松。",
                                "de": "Er schaffte es, den Marathon <w>trotz</w> seiner schweren Verletzung zu beenden."
                            }
                        }
                    ],
                    "synonyms": [
                        "regardless of"
                    ],
                    "common_phrases": [
                        "notwithstanding the fact"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir duruma, engellemeye veya olumsuzluğa bakılmaksızın; -e rağmen, -e karşın.",
                        "zh": "表示尽管有某种情况或障碍，依然发生某事；用于引出让步条件。",
                        "de": "Trotz eines Umstandes; ungeachtet einer Tatsache."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "-e rağmen",
                                "target_lang_sense_clarification": "bir engel veya olumsuzluğa bakılmaksızın"
                            },
                            {
                                "target_lang_word": "-e karşın",
                                "target_lang_sense_clarification": "bir duruma rağmen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尽管",
                                "target_lang_sense_clarification": "表示姑且承认某种事实，下文往往有转折"
                            },
                            {
                                "target_lang_word": "虽然",
                                "target_lang_sense_clarification": "用于让步复句，表示承认事实"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "trotz",
                                "target_lang_sense_clarification": "Präposition, die einen Gegengrund einleitet (mit Genitiv)"
                            },
                            {
                                "target_lang_word": "ungeachtet",
                                "target_lang_sense_clarification": "gehobene Präposition, die einen Umstand außer Acht lässt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ca7e171d-45b1-31dc-a9a4-e1368f4eb285",
                    "sense_definition": "Nevertheless; in spite of that; all the same.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The task was difficult; he, <w>notwithstanding</w>, persisted until it was finished.",
                            "target_lang_translations": {
                                "tr": "Görev zordu; <w>buna rağmen</w> bitene kadar sebat etti.",
                                "zh": "任务很艰巨，但他<w>尽管如此</w>还是坚持到了最后。",
                                "de": "Die Aufgabe war schwierig; er machte <w>dennoch</w> weiter, bis sie erledigt war."
                            }
                        },
                        {
                            "text": "The evidence against him was strong; <w>notwithstanding</w>, he maintained his innocence.",
                            "target_lang_translations": {
                                "tr": "Aleyhindeki kanıtlar güçlüydü; <w>yine de</w> masum olduğunu savundu.",
                                "zh": "对他不利的证据确凿，但他<w>依然</w>坚称自己是无辜的。",
                                "de": "Die Beweise gegen ihn waren erdrückend; <w>trotzdem</w> beharrte er auf seiner Unschuld."
                            }
                        }
                    ],
                    "synonyms": [
                        "nevertheless",
                        "nonetheless",
                        "still",
                        "anyway",
                        "after all",
                        "regardless",
                        "yet"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yine de, buna rağmen, buna karşın.",
                        "zh": "表示尽管有上述情况，依然如此；用于连接两个句子，表示转折。",
                        "de": "Dennoch; trotz alledem; ungeachtet dessen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buna rağmen",
                                "target_lang_sense_clarification": "yine de, buna karşılık"
                            },
                            {
                                "target_lang_word": "yine de",
                                "target_lang_sense_clarification": "her şeye rağmen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尽管如此",
                                "target_lang_sense_clarification": "表示虽然有前面的情况，但结果不变"
                            },
                            {
                                "target_lang_word": "然而",
                                "target_lang_sense_clarification": "表示转折，语气较正式"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "dennoch",
                                "target_lang_sense_clarification": "drückt einen Gegensatz oder eine Einschränkung aus"
                            },
                            {
                                "target_lang_word": "trotzdem",
                                "target_lang_sense_clarification": "weist auf einen Umstand hin, der das Gesagte nicht verhindert"
                            },
                            {
                                "target_lang_word": "nichtsdestotrotz",
                                "target_lang_sense_clarification": "betonte Form von dennoch"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "c5e29b85-5cea-35d2-b3d3-6880f8e2548a",
                    "sense_definition": "Although; even though.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They continued their journey, <w>notwithstanding</w> that it was getting dark.",
                            "target_lang_translations": {
                                "tr": "Hava kararmakta <w>olduğu halde</w> yolculuklarına devam ettiler.",
                                "zh": "<w>尽管</w>天色渐暗，他们还是继续赶路。",
                                "de": "Sie setzten ihre Reise fort, <w>obwohl</w> es dunkel wurde."
                            }
                        },
                        {
                            "text": "She was accepted into the university, <w>notwithstanding</w> that her test scores were slightly low.",
                            "target_lang_translations": {
                                "tr": "Sınav puanları biraz düşük <w>olmasına rağmen</w> üniversiteye kabul edildi.",
                                "zh": "<w>尽管</w>考试成绩略低，她还是被大学录取了。",
                                "de": "Sie wurde an der Universität angenommen, <w>obgleich</w> ihre Testergebnisse etwas niedrig waren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "notwithstanding that"
                    ],
                    "target_lang_definitions": {
                        "tr": "-dığı halde, olmasına rağmen.",
                        "zh": "用于引导从句，表示尽管存在某种事实或情况。",
                        "de": "Obwohl; obgleich; auch wenn."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "olmasına rağmen",
                                "target_lang_sense_clarification": "-dığı halde"
                            },
                            {
                                "target_lang_word": "olduğu halde",
                                "target_lang_sense_clarification": "-masına karşın"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尽管",
                                "target_lang_sense_clarification": "引导让步从句"
                            },
                            {
                                "target_lang_word": "虽然",
                                "target_lang_sense_clarification": "引导让步从句"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "obwohl",
                                "target_lang_sense_clarification": "leitet einen Nebensatz ein, der einen Gegengrund nennt"
                            },
                            {
                                "target_lang_word": "obgleich",
                                "target_lang_sense_clarification": "gehobene Konjunktion für einen Gegengrund"
                            },
                            {
                                "target_lang_word": "wenngleich",
                                "target_lang_sense_clarification": "gehobene Konjunktion, die eine Einschränkung einleitet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}