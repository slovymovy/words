                            },
                            {
                                "target_word": "écarté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce17f25-6d3d-3457-b060-4f04082eedc5",
                                        "entry_id": "815edf7c-5622-350c-a152-7ce3e3b40c82",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe écarter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c75ffd7c-949a-498c-8291-55dfc082046e",
                                                "sense_id": "6ce17f25-6d3d-3457-b060-4f04082eedc5",
                                                "text": "Ainsi serait écarté l’inconvénient de dénuméroter la rue Saint-Martin sur toute sa longueur, la partie de l’avenue Victoria que je vise étant occupée, sur un côté, par l’immeuble du Chåtelet et, sur l’autre, par cinq maisons seulement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fb6927d-3c17-43fb-abc0-283173345925",
                        "source_entry_id": "f721410d-7dc7-3982-bf12-192a43cf8461",
                        "source_sense_id": "8dc08f02-d966-3be2-8df5-e51e255a7dca",
                        "source_sense_description": "Kartenspiel für zwei Personen",
                        "target_lang_word": "экарте",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "экарте",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c36bdac8-26fa-3245-b330-35ab249c57c1",
                                        "entry_id": "586a553c-3841-3585-823a-6b347ecbd924",
                                        "glosses": [
                                            "карт. старинная азартная карточная игра для двух игроков из рода преферансовых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e6d6f3-e56b-4ae4-90da-a189085bd13b",
                                                "sense_id": "c36bdac8-26fa-3245-b330-35ab249c57c1",
                                                "text": "Лишь хозяйка с явным неудовольствием стояла у стола, за которым два дипломата доигрывали последнюю игру в экарте."
                                            },
                                            {
                                                "example_id": "05307ecc-1148-49f2-a986-4529e87b751f",
                                                "sense_id": "c36bdac8-26fa-3245-b330-35ab249c57c1",
                                                "text": "Вздохнув свободнее, он пошёл дальше; в другой зале множество игорных столиков стояло около стен; игроки пересыпали кучами золото; технические выражения экарте и других игор раздавались во всех углах .."
                                            },
                                            {
                                                "example_id": "98b5d4b6-3160-4d0e-ac15-7fafb96c9e96",
                                                "sense_id": "c36bdac8-26fa-3245-b330-35ab249c57c1",
                                                "text": "Я скажу тебе новость: от нечего делать поймал я какого-то барина, сел с ним играть в экарте и выиграл пятьсот рублей: вот и деньги…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf2f1cbc-9695-3c0f-9f2c-ee7aa7d34b6d",
                                        "entry_id": "586a553c-3841-3585-823a-6b347ecbd924",
                                        "glosses": [
                                            "хореогр. поза классического танца, при которой тело танцовщика опирается на выпрямленную ногу, другая, тоже прямая, поднята и отведена в сторону"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d5dd7d-383c-4798-8c02-399e64ef76f0",
                                                "sense_id": "bf2f1cbc-9695-3c0f-9f2c-ee7aa7d34b6d",
                                                "text": "После длительного перерыва Осипенко вернулась к партии феи Сирени. Всё так же широк и величав её танец, так же скульптурны экарте и арабески, тонкие руки всё так же плавно округляются над головой и простираются вперёд, даря людям счастье."
                                            },
                                            {
                                                "example_id": "7123cc72-fcba-4ddc-af8f-ca74d6f8e937",
                                                "sense_id": "bf2f1cbc-9695-3c0f-9f2c-ee7aa7d34b6d",
                                                "text": "Тридцать две танцовщицы, тридцать два экарте — вам ничего это не напоминает?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
