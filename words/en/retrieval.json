                    "frequency": "Low",
                    "semantic_group_id": "physical_recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>retrieval</w> of the sunken vessel took several weeks of careful planning.",
                            "target_lang_translations": {
