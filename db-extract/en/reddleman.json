                        ],
                        "examples": [
                            {
                                "example_id": "7b438637-4df2-40bb-9195-d16926b1d38a",
                                "sense_id": "84683a95-bb76-3367-bef1-77734d4fa8f2",
                                "text": "A child’s first sight of a reddleman was an epoch in his life. That blood-coloured figure was a sublimation of all the horrible dreams which had afflicted the juvenile spirit since imagination began. ‘The reddleman is coming for you!’ had been the formulated threat of Wessex mothers for many generations."
                            }
                        ]
