                            {
                                "example_id": "c7bccbc6-1553-4475-bbe0-15f942bd7d90",
                                "sense_id": "8f282d2d-a13a-3040-b19b-cce18da82846",
                                "text": "De vaste Judaspenning heeft een hartvormige"
                            },
                            {
                                "example_id": "ccd13e60-7e17-4884-a8aa-7aa3be7f3ba9",
                                "sense_id": "8f282d2d-a13a-3040-b19b-cce18da82846",
                                "text": "Pompebladeren zijn hartvormig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e851e63-95ee-43b5-bda4-0accaefae57c",
                        "source_entry_id": "bcab806f-fcf0-37ad-bbc2-4811e2a8a4af",
                        "source_sense_id": "8f282d2d-a13a-3040-b19b-cce18da82846",
                        "source_sense_description": "vorm van een hart hebbend",
                        "target_lang_word": "herzförmig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herzförmig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa06f431-94a1-3010-aabc-c7847b7aec00",
                                        "entry_id": "357769d7-c1c2-346a-9068-3c53cf41f8dc",
                                        "glosses": [
                                            "in der Form eines Herzens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74051230-b8ec-4c37-95bd-5fd580fa0972",
                                                "sense_id": "aa06f431-94a1-3010-aabc-c7847b7aec00",
                                                "text": "„In der Gipfelregion [des Queen Mary’s Peak] findet sich ein 300 Meter weiter Krater, in welchem sich ein herzförmiger Kratersee befindet.“"
                                            },
                                            {
                                                "example_id": "d95e224a-a7a0-46e5-b560-629237a7a4da",
                                                "sense_id": "aa06f431-94a1-3010-aabc-c7847b7aec00",
                                                "text": "„Die Bilder zeigten eine junge Frau mit herzförmigem Gesicht, herzförmig geschminkten Lippen und einem tiefen Blusenausschnitt, der auch herzförmig war.“"
                                            },
                                            {
                                                "example_id": "b3d0b59d-439a-45c2-8f2e-c42192039044",
                                                "sense_id": "aa06f431-94a1-3010-aabc-c7847b7aec00",
                                                "text": "„Blätter einfach kerbig gesägt, die unteren gestielt, eiförmig, an der Basis herzförmig, die oberen schmäler, die obersten lineal wie die Deckblätter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
