                "senses": [
                    {
                        "sense_id": "0422b9f5-5bc6-3941-8845-78a54187ca98",
                        "entry_id": "61e27d12-7239-37d6-ac2f-b3b742cb0e71",
                        "glosses": [
                            "eine Bewohnerin der Stadt Aalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5692f5a5-8c7f-419e-ae24-e9466319cc9b",
                                "sense_id": "0422b9f5-5bc6-3941-8845-78a54187ca98",
                                "text": "„Er brachte seinen verlotterten Haushalt ‚in Ordnung‘ mit der Hilfe einer derben Magd, der Aalenerin Barbara Streicher, die ihm tüchtig putzte und säuberte und mit der er bald schlief.“"
                            },
                            {
                                "example_id": "16fb07dd-7a5d-43b0-a1b1-8002cb22e938",
                                "sense_id": "0422b9f5-5bc6-3941-8845-78a54187ca98",
                                "text": "„Die Aalenerin steht zu ihrem Körperschmuck – er ist ein Teil von ihr, von ihrer Identität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
