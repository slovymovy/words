                        "examples": [
                            {
                                "example_id": "0a680ee5-ce9b-4d4d-8119-c05d1d3004ee",
                                "sense_id": "483ba1f9-4134-3077-9bc5-68346481e51c",
                                "text": "'Als zij', zijn stemvolume daalde nog meer, 'ieens omvalt, is dat vreemd, op die leeftijd.'"
                            },
                            {
                                "example_id": "fa9792b3-4c21-4deb-bfc5-15b124c6fef9",
                                "sense_id": "483ba1f9-4134-3077-9bc5-68346481e51c",
                                "text": "Je hoorde het feilloos aan het stemvolume van de bondscoach: een resultaat tegen Italië was cruciaal voor De Boer, juist op een avond die hem en Oranje ook qua veldspel weer wat zuurstof verschafte. Tevreden wandelde De Boer meteen na afloop naar binnen, eindelijk met wat kleur op de wangen."
                            }
