                "senses": [
                    {
                        "sense_id": "f91fdeea-6abb-3996-a3ae-1936afa5ef8f",
                        "entry_id": "af3df8cd-4c0b-38e8-ba95-9ea3e1bf3636",
                        "glosses": [
                            "niet gebonden aan een vaste plek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5594c6-e4fb-4c90-bfb1-5f6f9ef97d11",
                                "sense_id": "f91fdeea-6abb-3996-a3ae-1936afa5ef8f",
                                "text": "Met Centaur, dat schitterende beelden van het steppen- en berglandschap bevat, zet Aktan Arym Kubat het pastorale en nomadische verleden van Kirgizië tegenover het moderne heden."
                            },
                            {
                                "example_id": "6803d571-5052-4515-8ea7-8b5d6988419a",
                                "sense_id": "f91fdeea-6abb-3996-a3ae-1936afa5ef8f",
                                "text": "Het moslimmeisje maakte deel uit van een nomadische stam. De politie heeft acht verdachten opgepakt. Onder hen zijn een voormalige regeringsmedewerker en vier politiemensen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3864b956-ca9f-488c-8c72-a360adf20d23",
                        "source_entry_id": "af3df8cd-4c0b-38e8-ba95-9ea3e1bf3636",
                        "source_sense_id": "f91fdeea-6abb-3996-a3ae-1936afa5ef8f",
