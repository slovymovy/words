                ],
                "senses": [
                    {
                        "sense_id": "fa703db3-3794-3e74-bfb6-7170c1487708",
                        "entry_id": "fb16295b-49af-3370-9094-83e30c2a9388",
                        "glosses": [
                            "Adapter pour en faire un roman."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "d6fe8b66-5f42-4412-bfba-2a831a723223",
                                "sense_id": "fa703db3-3794-3e74-bfb6-7170c1487708",
                                "text": "Là où transposer un livre à l’écran obéit parfaitement à cette logique de renouvellement et de dépassement continus, novelliser un film semble être un geste rétrograde, opposé à l’esprit du temps et difficilement justifiable sur le plan commercial."
                            },
                            {
                                "example_id": "c6a00d04-a141-4e46-8113-d071ff4357bd",
                                "sense_id": "fa703db3-3794-3e74-bfb6-7170c1487708",
                                "text": "C'est vrai que dans cette collection, nous ne pensions novelliser que les très grands succès de l’’écran."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac61c4ce-9424-469b-a527-aa3aea99ee28",
                        "source_entry_id": "fb16295b-49af-3370-9094-83e30c2a9388",
                        "source_sense_id": "fa703db3-3794-3e74-bfb6-7170c1487708",
