                    },
                    {
                        "translation_id": "99d8d0ba-acef-445e-8d06-bb3eb8301c86",
                        "source_entry_id": "024454f0-274f-3d96-80dd-2f0deaf423f9",
                        "source_sense_id": "98226771-7a9a-35f9-8c42-fc16a4f40742",
                        "source_sense_description": "enthousiaste stemming, houding, instelling",
                        "target_lang_word": "exultation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exultation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c33b661e-0393-385f-8841-039967ee1eff",
                                        "entry_id": "3e47d104-8d15-38bb-9ea5-e87a13bc64e5",
                                        "glosses": [
                                            "The act of exulting; great joy at success or victory, or at any advantage gained; rapturous delight"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0cefead-8151-443f-a25d-9d1de1fca1e1",
                                                "sense_id": "c33b661e-0393-385f-8841-039967ee1eff",
                                                "text": "Strange that this idea carried with it something of exultation! so much does the pride of man rejoice in aught that marks him from his fellows, and little does it seem to matter whether that mark be for good or for evil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "731ebdda-ec6e-4315-94fd-6850ca098e90",
                        "source_entry_id": "024454f0-274f-3d96-80dd-2f0deaf423f9",
                        "source_sense_id": "98226771-7a9a-35f9-8c42-fc16a4f40742",
                        "source_sense_description": "enthousiaste stemming, houding, instelling",
                        "target_lang_word": "enchantement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchantement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54c211fd-5d29-3c12-89a0-a05bc90883b5",
                                        "entry_id": "c74fe30e-2288-32fd-9bca-5c5bea32a765",
                                        "glosses": [
                                            "ou Action d’enchanter; ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e45969a-111a-4998-b4a4-161d55452aec",
                                                "sense_id": "54c211fd-5d29-3c12-89a0-a05bc90883b5",
                                                "text": "Quelle fut sa surprise ! la Bête avait disparu, et elle ne vit plus à ses pieds qu’un prince plus beau que l’Amour, qui la remerciait d’avoir fini son enchantement."
                                            },
                                            {
                                                "example_id": "af2ccf36-e779-46cb-904f-e28e0be462a3",
                                                "sense_id": "54c211fd-5d29-3c12-89a0-a05bc90883b5",
                                                "text": "Dans ces instants fertiles en enchantements, […], il est difficile de résister aux vœux du cœur qui ont alors tant de magie !"
                                            },
                                            {
                                                "example_id": "ae9e1a5b-31f1-4469-935d-77efc059a504",
                                                "sense_id": "54c211fd-5d29-3c12-89a0-a05bc90883b5",
                                                "text": "Pourquoi restaurer les histoires vermoulues et poudreuses du moyen-âge, lorsque la chevalerie s’en est allée pour toujours, accompagnée des concerts de ses ménestrels, des enchantements de ses fées et de la gloire de ses preux ?"
                                            },
                                            {
                                                "example_id": "42bfb230-22fe-40f6-9e43-e0f858b680fb",
                                                "sense_id": "54c211fd-5d29-3c12-89a0-a05bc90883b5",
                                                "text": "Mais combien sont redoutables aussi ses voluptés foudroyantes et ses enchantements énervants."
                                            },
                                            {
                                                "example_id": "966a835d-28f4-4d9d-87cb-81193dc99911",
                                                "sense_id": "54c211fd-5d29-3c12-89a0-a05bc90883b5",
                                                "text": "Il était encore sous le coup du grand enchantement, de la griserie intense de l'arrivée, et il s'y abandonnait voluptueusement."
                                            },
                                            {
                                                "example_id": "8f1d71e0-89a0-4237-b61d-c2193d333d29",
                                                "sense_id": "54c211fd-5d29-3c12-89a0-a05bc90883b5",
                                                "text": "Pourtant, il était possible de se préserver des enchantements des sorciers ; dès qu’un sorcier vous avait touché, il fallait le battre à bras raccourcis, en répétant trois fois : « Sorcier, je te rends le mal »."
                                            },
                                            {
                                                "example_id": "ae3af72d-b947-44e6-b246-0c0bc53c9900",
                                                "sense_id": "54c211fd-5d29-3c12-89a0-a05bc90883b5",
                                                "text": "Elle livrait un culte magnifique à l’érotisme, dans une sexualité débordante qui constituait pour elle la vraie musique de l'être, la fureur et l’enchantement pour « inouïr » la vie. Géraldine B. aimait les hommes et ceux-ci le lui rendaient à merveille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c78a36de-742d-39b2-b30f-32b8251d5ad2",
                                        "entry_id": "c74fe30e-2288-32fd-9bca-5c5bea32a765",
                                        "glosses": [
                                            "Sentiment d’admiration intense ou enfantine analogue à celui que produirait un phénomène surnaturel ou un tour de magie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a520e2-0afc-462b-bcd0-8de3adc3ca27",
                                                "sense_id": "c78a36de-742d-39b2-b30f-32b8251d5ad2",
                                                "text": "Revenir à Cambridge sera toujours pour moi un enchantement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
