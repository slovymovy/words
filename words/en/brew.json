    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9acc1931-30a9-34d0-b228-317a10cd2fff",
                    "sense_definition": "To prepare a hot beverage, such as tea or coffee, by infusing ingredients in hot water.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "make_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning, I <w>brew</w> a fresh pot of coffee before heading to work.",
                            "target_lang_translations": {
                                "ru": "Каждое утро перед выходом на работу я <w>варю</w> свежий кофейник кофе."
                            }
                        },
                        {
                            "text": "She learned how to <w>brew</w> herbal tea using dried leaves from her garden.",
                            "target_lang_translations": {
                                "ru": "Она научилась <w>заваривать</w> травяной чай из сушёных листьев из своего сада."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brew coffee",
                        "brew tea",
                        "brew a pot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приготавливать горячий напиток (чай или кофе), настаивая его на горячей воде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заваривать",
                                "target_lang_sense_clarification": "чай или кофе (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "заварить",
                                "target_lang_sense_clarification": "чай или кофе (совершенный вид)"
                            },
                            {
                                "target_lang_word": "варить",
                                "target_lang_sense_clarification": "кофе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edfd2f1b-022f-3982-85bb-578ed43661fd",
                    "sense_definition": "To make beer or ale by steeping, boiling, and fermenting malt and hops.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "make_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local company has been <w>brewing</w> traditional ale for over a century.",
                            "target_lang_translations": {
                                "ru": "Местная компания <w>варит</w> традиционный эль уже более века."
                            }
                        },
                        {
                            "text": "He decided to <w>brew</w> his own beer at home on the weekends.",
                            "target_lang_translations": {
                                "ru": "Он решил по выходным <w>варить</w> собственное пиво дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brew beer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить пиво или эль путём вымачивания, кипячения и сбраживания солода и хмеля."
                    },
                    "translations": {
