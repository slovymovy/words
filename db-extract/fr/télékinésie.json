                    {
                        "sense_id": "3cb6f98f-6bae-3afb-b42c-2f5f17fe6c86",
                        "entry_id": "e99010ed-a19b-34a0-ad88-88b1ca1ea8c1",
                        "glosses": [
                            "Faculté métapsychique hypothétique de mettre en mouvement un objet matériel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d095835-b9d8-4eba-8e86-07f86999b7d4",
                                "sense_id": "3cb6f98f-6bae-3afb-b42c-2f5f17fe6c86",
                                "text": "La société québécoise de psilogie est un institut qui étudie les phénomènes comme la télékinésie et la télépathie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1245479f-c054-42a4-bd72-828cea1b69f6",
