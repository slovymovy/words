        "nl-extract.jsonl": [
            {
                "entry_id": "90cf780a-953c-3c49-865d-a4ede2f87fc0",
                "word": "grommend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "300a7d08-0c2c-3dcf-ad2b-55c2a199f1f0",
                        "entry_id": "90cf780a-953c-3c49-865d-a4ede2f87fc0",
                        "glosses": [
                            "een stoer wat bozig brommend geluid makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98fa9d05-8e02-4bcd-b9bb-e5bbf7ce78da",
                                "sense_id": "300a7d08-0c2c-3dcf-ad2b-55c2a199f1f0",
                                "text": "Vlaggen wapperen in de wind en het grasveld staat vol met kleurige tenten en glimmende motoren. Lichamen vol tatoeages, zwart lederen kleding en soms woeste baarden sieren de bestuurders van de grommende motoren."
                            },
                            {
                                "example_id": "cdc31c52-0534-4eaf-ac09-25e5f95836e0",
                                "sense_id": "300a7d08-0c2c-3dcf-ad2b-55c2a199f1f0",
                                "text": "Het station zegt dat de interruptie van hijgende en grommende mannengeluiden het resultaat was van 'niet toegestane activiteiten en ongepast gedrag in de studio', meldt de Britse krant The Guardian."
                            },
                            {
                                "example_id": "50653880-a8f1-49a9-ba13-e4ca7f419f05",
                                "sense_id": "300a7d08-0c2c-3dcf-ad2b-55c2a199f1f0",
                                "text": "Met grommende motor komt de enorme drietonner het Burgemeester Jansenplein opgereden. Zijn vrachtje? Dit keer geen tot op de tanden toe bewapende militairen op missie, maar kinderen met hun ouders, die in de ‘dikke DAF’ een kort ritje door Hengelo hebben gemaakt. Om even te ervaren hoe het is om militair te zijn."
                            }
                        ]
                    }
