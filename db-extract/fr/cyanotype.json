                "senses": [
                    {
                        "sense_id": "893cf3e2-6487-3cd9-8cfc-c34d711028cf",
                        "entry_id": "aeedddcf-0309-3249-919a-02842c259762",
                        "glosses": [
                            "Procédé photographique utilisant du ferrocyanure de potassium et produisant des épreuves de couleur bleue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dbb84d8-9fc3-4469-8508-6697b3cbbbd0",
                                "sense_id": "893cf3e2-6487-3cd9-8cfc-c34d711028cf",
                                "text": "[…] ses maquettes de verre – construction/déconstruction – photographiées selon les techniques primitives de l’ambrotype ou du cyanotype."
                            }
                        ]
                    },
                    {
                        "sense_id": "c40b4e4a-3090-3d1f-8120-285b338e9929",
                        "entry_id": "aeedddcf-0309-3249-919a-02842c259762",
                        "glosses": [
                            "Photographie obtenue par ce procédé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea1d75c-fe60-4a7b-9036-f0f3b591273d",
                                "sense_id": "c40b4e4a-3090-3d1f-8120-285b338e9929",
                                "text": "(...) c’est maintenant la nuit, nous montons sur le toit du Ponant avec du pain beurré et du vin de cantine, lumière de cyanotype, jamais vu un ciel si net, si lisible (...)"
                            }
                        ]
                    }
                ],
