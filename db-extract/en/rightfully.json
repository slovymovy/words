                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ff89b75-bb37-3a3d-9d50-3d39dd985f62",
                        "entry_id": "d7e7e64f-aee9-3dc6-9c88-8ddef3081c95",
                        "glosses": [
                            "dem Recht nach, den Gesetzen nach, dem Gerechtigkeitsempfinden entsprechend: rechtmäßig, gerechterweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2dddcae-bcfb-4600-8b7e-701e380dabd2",
                                "sense_id": "2ff89b75-bb37-3a3d-9d50-3d39dd985f62",
                                "text": "I only want back what is rightfully mine.",
                                "translation": "Ich will nur zurückhaben, was mir rechtmäßig zusteht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb4428ba-7ce6-4cba-bde3-546d5377549d",
                        "source_entry_id": "d7e7e64f-aee9-3dc6-9c88-8ddef3081c95",
                        "source_sense_id": "2ff89b75-bb37-3a3d-9d50-3d39dd985f62",
                        "source_sense_description": "dem Recht nach, dem Rechtsempfinden nach",
                        "target_lang_word": "rechtmäßig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rechtmäßig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6530e43c-461c-3510-9875-03e08b132c8f",
                                        "entry_id": "dc6fddb9-a9f9-322c-a71a-f0e44e4e0528",
                                        "glosses": [
                                            "dem Recht entsprechend, mit dem Recht vereinbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e211fc85-50e7-4c38-bbb8-693ee1cf249b",
                                                "sense_id": "6530e43c-461c-3510-9875-03e08b132c8f",
                                                "text": "Es ist umstritten, ob die Einführung von Studiengebühren rechtmäßig ist."
                                            },
                                            {
                                                "example_id": "bdc189f7-b496-47b4-982a-04dd465519e9",
                                                "sense_id": "6530e43c-461c-3510-9875-03e08b132c8f",
                                                "text": "„Die Abgrenzung zwischen Schiiten und Sunniten geht ursprünglich auf den Streit um die rechtmäßige Nachfolge des Propheten im Jahr 632 n.Chr. zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9bfe25c-d56d-4071-94ea-fb7ea2b2e0d7",
                        "source_entry_id": "d7e7e64f-aee9-3dc6-9c88-8ddef3081c95",
                        "source_sense_id": "2ff89b75-bb37-3a3d-9d50-3d39dd985f62",
                        "source_sense_description": "dem Recht nach, dem Rechtsempfinden nach",
                        "target_lang_word": "gerechterweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gerechterweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4b213e-dbc3-31e7-8d20-35b5dcde8d59",
                                        "entry_id": "195fd1b1-d71d-36e1-ba41-ebd23fc5f1ea",
                                        "glosses": [
                                            "auf eine gerecht anmutende Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88869aa-9896-45d5-b0f1-8a640846aa67",
                                                "sense_id": "cb4b213e-dbc3-31e7-8d20-35b5dcde8d59",
                                                "text": "„Die zweite Halbzeit beginnt mit zwei Toren für die Bayern, die aber von Dortmund ausgeglichen werden können, so dass das Endergebnis gerechterweise 3:3 lautet.“"
                                            },
                                            {
                                                "example_id": "f098e32f-ad0d-4d61-be01-354f9738e9d5",
                                                "sense_id": "cb4b213e-dbc3-31e7-8d20-35b5dcde8d59",
                                                "text": "„Er sagt hierüber wörtlich: -\" Die Zölle sollen so beschaffen sein, dass sie jeglicher Arbeit -, sei es auf dem Felde, im Bergwerke oder in der Fabrik, einen Tarifschutz - gewähren, der dem Unterschiede zwischen den Erzeugungskosten des Auslandes und denjenigen des Inlandes gleichkommt. Es soll aber auch Vorsorge dafür getroffen werden, dass ein höherer oder der Maximaltarif - gegen jene Länder in Anwendung kommen soll, deren Handelspolitik uns gegenüber gerechterweise eine solche Unterscheidung erfordert. - Es werden in der Inaugurationsrede weiter gefordert: - Weitgehender Schutz der natürlichen Hilfsquellen; Vergrößerung der Marine -, \"damit die europäischen Monarchien - in ihren kolonisatorischen Absichten - auf unserer Hemisphäre behindert seien\"; Förderung der internationalen Friedensbestrebungen -; Einschränkung unliebsamer Einwanderung -, jedoch unter Vermeidung unnützer Reibung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
