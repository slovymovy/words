                "senses": [
                    {
                        "sense_id": "f87198f9-7955-337b-8fe7-a23ea27dcf7d",
                        "entry_id": "3550920a-70ae-3b80-a7c8-19bd838a9fe8",
                        "glosses": [
                            "bak waardoor men verkeer geleidt op een niveau dat lager is dan het maaiveld, met een al dan niet geheel gesloten dak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b393a3a2-42e5-472d-a2fb-a61ad93c4294",
                                "sense_id": "f87198f9-7955-337b-8fe7-a23ea27dcf7d",
                                "text": "Op de Verlengde Holterstraatweg in Rijssen heeft zondag een eenzijdig ongeval plaatsgevonden. Het ongeval gebeurde in de tunnelbak."
                            },
                            {
                                "example_id": "3f8d1189-84a8-4893-b990-d62490d6af14",
                                "sense_id": "f87198f9-7955-337b-8fe7-a23ea27dcf7d",
                                "text": "De bewoners van enkele verderop gelegen huizen aan de Piet Heinweg ondervinden al jaren overlast van het treinverkeer in de tunnelbak."
                            },
                            {
                                "example_id": "b72919d2-0687-4709-a37c-f837642a4b8f",
                                "sense_id": "f87198f9-7955-337b-8fe7-a23ea27dcf7d",
                                "text": "Nu de werkzaamheden voor het verkeersveiliger maken van de tunnelbak bijna zijn afgerond, komt de wijkvereniging aan bod. Die had een plan ontwikkeld om de tunnel te verfraaien, en dat wordt binnenkort uitgevoerd."
                            }
                        ]
                    }
