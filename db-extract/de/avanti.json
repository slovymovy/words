                        "glosses": [
                            "Aufruf zum Weitermachen oder Weitergehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0081eafc-5844-486b-9520-9bdfa4897004",
                                "sense_id": "d47a1a84-7da4-3403-84fd-28d7a1919883",
                                "text": "Avanti! Wir haben noch einen weiten Weg vor uns."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "858299b1-8252-4df5-9e26-25dcd75b8343",
                        "source_entry_id": "9ad86921-b051-38ff-a3d8-a4daecbdd69b",
                        "source_sense_id": "d47a1a84-7da4-3403-84fd-28d7a1919883",
                        "source_sense_description": "Aufruf zum Weitermachen oder Weitergehen",
                        "target_lang_word": "allez",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allez",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "070a0fb8-9154-3110-b3e0-2e61cee540ea",
                                        "entry_id": "7b6f00f4-afc2-31ac-ac08-d7d29cf4d0c7",
                                        "glosses": [
                                            "Deuxième personne du pluriel de l’indicatif présent de aller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c547c3-8f27-4928-b550-d35ba126bad8",
                                                "sense_id": "070a0fb8-9154-3110-b3e0-2e61cee540ea",
                                                "text": "Si vous avez un bon coup de fourchette et qu’en plus vous n’y allez pas avec le dos de la cuillère, ne soyez pas surpris si l’on vous fait remarquer en Bretagne que vous « kloukez »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94fbcfa0-759d-3641-b439-4d9f93123ec0",
                                        "entry_id": "7b6f00f4-afc2-31ac-ac08-d7d29cf4d0c7",
                                        "glosses": [
                                            "Deuxième personne du pluriel de l’impératif présent de aller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "356279d0-f49c-4a54-b675-d5e8cf1b4dff",
                                                "sense_id": "94fbcfa0-759d-3641-b439-4d9f93123ec0",
                                                "text": "Chapoteau, allez me chercher ce poët-poët."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allez",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ff152b6-bd84-3bb3-be18-705658ff6b5b",
                                        "entry_id": "945bb507-ff9d-32c2-9e46-bcb3e99f7f43",
                                        "glosses": [
                                            "Exprime l’encouragement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aeed122-3fc4-4613-89b9-f22a99612280",
                                                "sense_id": "9ff152b6-bd84-3bb3-be18-705658ff6b5b",
                                                "text": "Allez les bleus !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4a3da31-04c3-30f6-a829-912ebc43ec3c",
                                        "entry_id": "945bb507-ff9d-32c2-9e46-bcb3e99f7f43",
                                        "glosses": [
                                            "Exprime une prière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ae3327-e896-4f06-813a-3fa6175def43",
                                                "sense_id": "a4a3da31-04c3-30f6-a829-912ebc43ec3c",
                                                "text": "Allez ! Juste une petite heure. Donnez-moi une seule raison valable de refuser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53425cfa-06f7-3d8c-8bc1-4df0f74b2a68",
                                        "entry_id": "945bb507-ff9d-32c2-9e46-bcb3e99f7f43",
                                        "glosses": [
                                            "Exprime l’exaspération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71d23c4-373c-4afb-b264-3b09e5f1a276",
                                                "sense_id": "53425cfa-06f7-3d8c-8bc1-4df0f74b2a68",
                                                "text": "Il en avait surtout aux gendarmes qui pourtant ne venaient pas souvent le déranger dans ses sapins ; ils n’avaient pas envie de le désembucher allez !"
                                            },
                                            {
                                                "example_id": "4b867455-d028-43bd-a66a-41235b12fce4",
                                                "sense_id": "53425cfa-06f7-3d8c-8bc1-4df0f74b2a68",
                                                "text": "Bref, bredouille la maréchaussée, autant que pour un voleur ou un contrebandier ! On y était bien habitué, allez : pas de semaines qu’une poule disparaisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c7c72dd-7d42-3674-8f8d-4a92307a969a",
                                        "entry_id": "945bb507-ff9d-32c2-9e46-bcb3e99f7f43",
                                        "glosses": [
                                            "Lancer le départ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ee7541-9238-4c73-abdb-ae65cecc66b0",
                                                "sense_id": "3c7c72dd-7d42-3674-8f8d-4a92307a969a",
                                                "text": "Qui n'a jamais mangé un calendos comme ça avec un bon gros rouge ne connaît rien à la gastronomie. Allez, avant de retourner dans mon placard-palace, encore un petit gorgeon pour faire glisser le tout..."
                                            },
                                            {
                                                "example_id": "c56d2364-1272-4578-a485-efe89825abab",
                                                "sense_id": "3c7c72dd-7d42-3674-8f8d-4a92307a969a",
                                                "text": "Allez ! Allez ! C’est parti !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcb44a7f-a61e-3621-ab2b-dcf593b15046",
                                        "entry_id": "945bb507-ff9d-32c2-9e46-bcb3e99f7f43",
                                        "glosses": [
                                            "En incise, exprime une certaine hésitation, une concession. Même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b588503c-247c-41f1-ae05-40e4b788ed40",
                                                "sense_id": "fcb44a7f-a61e-3621-ab2b-dcf593b15046",
                                                "text": "Elle (la philosophie) est bien chahutée, la pauvre. Les philosophes sont fatigués, mélancoliques, en repli. Ils parlent toujours, remarquez, mais ils doivent être désormais modestes, consensuels, un peu conservateurs, allez, puisque tout a tendance à s’effondrer et qu’ils ont tellement déliré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e65e2fb3-0830-4df4-9027-3a06fa49d016",
                        "source_entry_id": "9ad86921-b051-38ff-a3d8-a4daecbdd69b",
                        "source_sense_id": "d47a1a84-7da4-3403-84fd-28d7a1919883",
                        "source_sense_description": "Aufruf zum Weitermachen oder Weitergehen",
                        "target_lang_word": "allons",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allons",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bc92051-2607-364d-b9bd-b95b25c8662a",
                                        "entry_id": "b6a6ea42-ef35-366c-be72-1d7a1b3531a2",
                                        "glosses": [
                                            "Première personne du pluriel de l’indicatif présent du verbe aller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40710ca5-b11f-4eeb-8acd-5d4918b97f71",
                                                "sense_id": "6bc92051-2607-364d-b9bd-b95b25c8662a",
                                                "text": "La douleur n’est qu’un accident de ce mouvement vital ; loin de le favoriser, elle lui nuit au contraire ; elle retarde le rétablissement de l’ordre; elle favorise, comme nous allons le voir, les causes qui tendent à désalcaliser le sang."
                                            },
                                            {
                                                "example_id": "55569886-663b-47fc-b42c-06703b99057f",
                                                "sense_id": "6bc92051-2607-364d-b9bd-b95b25c8662a",
                                                "text": "Aussi allons-nous chercher dans la suite à robustifier le correcteur par les techniques multi-modèles développées précédemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fee6fb4-7a76-397d-9283-102a867cd76f",
                                        "entry_id": "b6a6ea42-ef35-366c-be72-1d7a1b3531a2",
                                        "glosses": [
                                            "Première personne du pluriel de l’impératif présent du verbe aller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b867f68a-2c09-4994-9d9f-ace3211dddcc",
                                                "sense_id": "9fee6fb4-7a76-397d-9283-102a867cd76f",
                                                "text": "Allons, n’exagérons rien, cher monsieur."
                                            },
                                            {
                                                "example_id": "7be2ccba-690c-4156-9b19-94b59ff027fc",
                                                "sense_id": "9fee6fb4-7a76-397d-9283-102a867cd76f",
                                                "text": "N’allons point, sous prétexte d’écrire un beau chapitre, ré-assortir les faits et leur imposer un rôle qui ne cadre point avec la juste notion historique."
                                            },
                                            {
                                                "example_id": "e1079bf6-9df1-4690-afed-e56c5db51c75",
                                                "sense_id": "9fee6fb4-7a76-397d-9283-102a867cd76f",
                                                "text": "Allons, a dit Léon avec bonhomie, comme si tout était évident, comme s’il parlait à une pouliche mal débourrée et qu’il suffise de dire cela, allons, pour que ça passe, pour qu’on recommence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f7f39b1-00c7-444b-88fc-84f86fad8135",
                        "source_entry_id": "9ad86921-b051-38ff-a3d8-a4daecbdd69b",
                        "source_sense_id": "d47a1a84-7da4-3403-84fd-28d7a1919883",
                        "source_sense_description": "Aufruf zum Weitermachen oder Weitergehen",
                        "target_lang_word": "va",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "va",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed18934-ec09-33f1-9a44-4c5d57f8c572",
                                        "entry_id": "35807568-4824-3bd7-8395-84773ba9fa06",
                                        "glosses": [
                                            "Soit ; j’y consens."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff78f72e-458d-41ed-ab2b-8197c22a245e",
                                                "sense_id": "1ed18934-ec09-33f1-9a44-4c5d57f8c572",
                                                "text": "Bon, va pour une petite promenade, mais c’est juste pour me détendre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "va",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af6a3ae1-99fa-35f9-8f86-1c6c3398e505",
                                        "entry_id": "e48e8fcf-8a7e-3961-9e1e-e2252d9a8f36",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de aller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4753b4d8-8288-42d5-acb2-d18988c0c190",
                                                "sense_id": "af6a3ae1-99fa-35f9-8f86-1c6c3398e505",
                                                "text": "Elle reste peu dans un bal, comme un éclair, le temps d’éblouir, et puis voilà ; ce même effet elle le répète dans deux ou trois autres bals, s’en va, rentre de bonne heure, bien avant que la fatigue ou la danse aient abattu l’éclat de ses yeux, défrisé ses cheveux, débrillanté sa robe."
                                            },
                                            {
                                                "example_id": "641049e1-fee8-4315-b147-97c87a399b20",
                                                "sense_id": "af6a3ae1-99fa-35f9-8f86-1c6c3398e505",
                                                "text": "Cette animation va vous démontrer qu’il est très simple de pré-programmer un symbole, vous n’aurez alors plus besoin de saisir le moindre script sur la timeline principale de votre animation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "298e0f43-6d09-363c-9619-ae1f56c87110",
                                        "entry_id": "e48e8fcf-8a7e-3961-9e1e-e2252d9a8f36",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif présent de aller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89ab9882-680c-4fda-8e55-4610de1d0196",
                                                "sense_id": "298e0f43-6d09-363c-9619-ae1f56c87110",
                                                "text": "Va donc, joujou de contrebande, va donc, amusette d’alcôve, fais ton métier."
                                            },
                                            {
                                                "example_id": "017b985f-ba04-4dd5-82fb-5aee992972bc",
                                                "sense_id": "298e0f43-6d09-363c-9619-ae1f56c87110",
                                                "text": "Va, on n’est jamais laide, quand on est jeune. Tandis que, lorsqu’on n’est plus jeune, ma pauvre maman, va, c’est bien fini. On a beau avoir été belle, s’entêter à l’être encore, rien ne reste que des ruines, que la honte et le dégoût."
                                            },
                                            {
                                                "example_id": "247209e8-11fb-421e-a8e8-f435fc00be05",
                                                "sense_id": "298e0f43-6d09-363c-9619-ae1f56c87110",
                                                "text": "– Julie, conjuguez-moi le verbe aller, à l’impératif !\n– Impératif du verbe aller : Va, vasons, vasez !\nJulie s’était déjà assise, débarrassée de « sa récitation ». Elle avait commencé même à ne plus se rappeler ce qu’elle venait de dire.\nIl y eut une seconde pendant laquelle toute la première division, pour mieux se pénétrer de l’erreur commise, conjugua mentalement l’impératif du verbe aller. Mais lorsque cette seconde fut écoulée, la première division partit dans un rire entrecoupé d’exclamations, qui déborda les bancs qu’elle occupait et gagna dans le fond de la salle les toutes petites de la dernière division. On eût pu comparer la classe entière à une rivière sur laquelle nageaient les bateaux : Va, vasons, vasez."
                                            },
                                            {
                                                "example_id": "1c8ae4a5-9be8-4fa9-a053-eedf7af40941",
                                                "sense_id": "298e0f43-6d09-363c-9619-ae1f56c87110",
                                                "text": "Sa façon à lui de douter, ça devait être sa mauvaise humeur subite, ses crises d’agressivité qui nous menaient jusqu’à la rupture. Une heure. Rabibochage. On le scelle au Montaigne autour d’un jus. Il me sourit : « On y arrivera, va. »"
                                            },
                                            {
                                                "example_id": "769f3df3-0d90-471a-ae9d-00e0ac72d56e",
                                                "sense_id": "298e0f43-6d09-363c-9619-ae1f56c87110",
                                                "text": "Alors, il lui dit : « Va… aime, et puis reviens. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37bd1c4c-bffe-450a-9b6e-30e73993f9eb",
