            "senses": [
                {
                    "sense_id": "1decca35-cc82-3dfd-831c-4238be81a1e2",
                    "sense_definition": "Qui inspire l'admiration ou le respect par sa grandeur imposante, sa beauté ou son caractère grandiose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grandeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du haut de la colline, les randonneurs ont admiré un <w>majestueux</w> paysage de montagnes enneigées."
                        },
                        {
                            "text": "Ce chêne centenaire possède une ramure <w>majestueuse</w> qui ombrage toute la place du village."
                        }
                    ],
                    "synonyms": [
                        "grandiose",
                        "imposant",
                        "somptueux"
                    ],
                    "antonyms": [
                        "chétif",
                        "insignifiant",
                        "minuscule"
                    ],
                    "common_phrases": [
                        "paysage majestueux",
                        "arbre majestueux",
                        "décor majestueux"
                    ]
                },
                {
                    "sense_id": "1b556398-e9fd-3f28-b4cd-f0da21fc2624",
                    "sense_definition": "Qui manifeste de la noblesse, de la dignité et de l'autorité dans sa personne, son port ou son maintien.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grandeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La reine s'est avancée d'un pas lent avec un maintien <w>majestueux</w> qui imposait le respect."
                        },
                        {
                            "text": "Le vieil homme conservait un port de tête <w>majestueux</w> malgré le poids des années."
                        }
                    ],
                    "synonyms": [
                        "altier",
                        "digne",
                        "noble"
                    ],
                    "antonyms": [
                        "servile",
                        "vulgaire"
                    ],
                    "common_phrases": [
                        "maintien majestueux",
                        "air majestueux",
                        "allure majestueuse"
                    ]
                }
            ]
        }
