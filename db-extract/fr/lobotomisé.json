                "senses": [
                    {
                        "sense_id": "b79c91e3-90e6-3b48-84b0-7718dd0e6521",
                        "entry_id": "d36a6df6-21ba-3a96-9ea0-dfc6b9578f75",
                        "glosses": [
                            "Qui a subi une lobotomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "954ebd08-7023-422d-b1b8-d18861b0eaf7",
                                "sense_id": "b79c91e3-90e6-3b48-84b0-7718dd0e6521",
                                "text": "Une pensionnaire lobotomisée, Noëlle, internée depuis 25 ans, nous parle longuement des ragouts, des gaufres, des pot-au-feux, qu’elle aimait faire avant que son internement l’ait mutilée."
                            },
                            {
                                "example_id": "10c6e9b8-2b92-4897-a404-c63bcfa6f650",
                                "sense_id": "b79c91e3-90e6-3b48-84b0-7718dd0e6521",
                                "text": "Dans la salle supérieure, se faisaient face Le Brésil : avec le bel album du Prof. Mauricio de Médeiros, et les sculptures d’un malade lobotomisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "cafe88c4-307d-3638-9386-facc073ac343",
                        "entry_id": "d36a6df6-21ba-3a96-9ea0-dfc6b9578f75",
                        "glosses": [
                            "À qui on a fait perdre ses capacités de raisonner, de s’émouvoir, de réagir."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0783ade8-0dbc-4c77-a83c-8aec15ba8dc4",
                                "sense_id": "cafe88c4-307d-3638-9386-facc073ac343",
                                "text": "Prenez le Cameroun où un satrape de 86 ans, au pouvoir depuis 37 ans, cherche à présent à imposer une monarchie matrimoniale à un peuple avachi et lobotomisé, où l’on ne compte plus le nombre de prisonniers politiques, de captifs et autres otages d’un régime désormais qualifié par les siens eux-mêmes de «diabolique», preuve heureusement qu’il y en a de plus en plus qui refusent de se laisser sodomiser à crédit."
                            },
                            {
                                "example_id": "99719bbc-2ae4-4f59-9b67-cfd79a088664",
                                "sense_id": "cafe88c4-307d-3638-9386-facc073ac343",
                                "text": "Outre des propos peu amènes à l’égard de la grand-mère du médecin, « il m’a insulté, traité d’assassin, d’imbécile lobotomisé… », confie-t-il."
                            }
                        ]
                    }
