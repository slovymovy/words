                            "singular"
                        ],
                        "form": "das Exonym"
                    },
                    {
                        "form_id": "e99190ae-dd47-4174-9bc5-ad5ef45609ea",
                        "entry_id": "dbebef5e-cf9c-3fb9-b79e-ecaf378bc37c",
                        "tags": [
                            "accusative",
