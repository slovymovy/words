                        "entry_id": "2ae3eb73-07d0-3360-9c7b-ed56ef16fe08",
                        "glosses": [
                            "Celui de la même classe d’âge, née la même année ou une année se terminant par le même chiffre, conscrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec59845d-e263-4f61-a433-8fec09e47d07",
                                "sense_id": "b4054621-451f-31a5-aba6-72eef18b5fa2",
                                "text": "Les conscrits de l’année ont commencé la ronde des bals ; en principe on en fait un par classard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71a04a9a-d649-49d8-ac71-a7f9d224b6a0",
                        "source_entry_id": "2ae3eb73-07d0-3360-9c7b-ed56ef16fe08",
                        "source_sense_id": "b4054621-451f-31a5-aba6-72eef18b5fa2",
                        "target_lang_word": "Altersgenosse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altersgenosse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eeea520-fa9a-3480-a60e-ab11552614dc",
                                        "entry_id": "7db81d9f-a0a9-348e-904a-6dd07bfb8428",
                                        "glosses": [
                                            "Person gleichen Alters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12654f4f-5617-4a04-9f0e-0f6784d39caf",
                                                "sense_id": "2eeea520-fa9a-3480-a60e-ab11552614dc",
                                                "text": "„Unsere Kenntnisse vom Verhalten des Kleinkindes innerhalb einer Gruppe von Altersgenossen sind noch ziemlich begrenzt, besonders spärlich sind die Informationen über Kinder unter drei Jahren.“"
                                            },
                                            {
                                                "example_id": "229de8fd-1156-458e-a157-163bc7a94202",
                                                "sense_id": "2eeea520-fa9a-3480-a60e-ab11552614dc",
                                                "text": "„Wie viele meiner Altersgenossen wurde ich noch zum Kriegsdienst herangezogen.“"
                                            },
                                            {
                                                "example_id": "615d20c5-fe41-4f65-b44e-6569260a7957",
                                                "sense_id": "2eeea520-fa9a-3480-a60e-ab11552614dc",
                                                "text": "„Der Junge beteiligte sich nie an den Zoten seiner Altersgenossen, und wenn er liebte, beobachtete er sich wie ein Arzt den Patienten, auch lehnte er ab, zu den Huren zu gehen, denn ihm war bei einem ersten Versuch unwohl gewesen dabei.“"
                                            }
                                        ],
