                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "860db0ce-300c-4a39-a524-6d857208e9f7",
                                                "sense_id": "85d7cbf8-4ad0-34be-ac2c-582f89e24061",
                                                "text": "Znalazł tam pewnego Żyda, imieniem Akwila, rodem z Pontu, który z żoną Pryscyllą przybył niedawno z Italii, ponieważ Klaudiusz wysiedlił z Rzymu wszystkich Żydów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39c1bb66-5dd2-49f7-b41e-4f4744fa92d5",
                        "source_entry_id": "cdaa81d4-1112-30a3-adb0-c3dff4fcc6d7",
                        "source_sense_description": "biblical woman",
                        "target_lang_word": "Приски́лла",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5d5a039f-d2fd-4fed-a892-b2db19a36b4f",
                        "source_entry_id": "cdaa81d4-1112-30a3-adb0-c3dff4fcc6d7",
                        "source_sense_description": "biblical woman",
                        "target_lang_word": "Присци́лла",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Присци́лла",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d13d74c3-3e50-3e81-97af-5e933138d4fc",
                                        "entry_id": "f1a6cdca-af7a-31d9-9502-d6f6e642f466",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc92ad6-d875-40e7-961c-93ac88ae1c6c",
                                                "sense_id": "d13d74c3-3e50-3e81-97af-5e933138d4fc",
                                                "text": "В другой раз, в крытом ходу, под окнами кухни, мальчик нечаянно подслушал, как старый пьяница-повар, раздраженный какой-то дерзостью Галла, говорил своей любовнице, рабыне, перемывавшей посуду: «Господь да сохранит мою душу, Присцилла, ― удивляюсь я, как это их еще до сей поры не придушили!»"
                                            },
                                            {
                                                "example_id": "50933fc0-4e05-417b-8eab-a6aeafb17115",
                                                "sense_id": "d13d74c3-3e50-3e81-97af-5e933138d4fc",
                                                "text": "Детей было четверо: сыновья Джон, Майкл и Кристофер и дочь Присцилла."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
