                "senses": [
                    {
                        "sense_id": "082e81d1-a1a1-3ac1-b1d4-28a045d4b27d",
                        "entry_id": "1efbff02-2f73-3fa8-8150-5be386033741",
                        "glosses": [
                            "An outer garment (robe or cloak) worn by men and women in Europe in the Middle Ages, either as civilian clothing or over armor."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "9d7535a0-6ae9-4664-817a-85ff1c58829c",
                                "sense_id": "082e81d1-a1a1-3ac1-b1d4-28a045d4b27d",
                                "text": "there came one that seemed to be a messenger , in a rich huke"
                            },
                            {
                                "example_id": "0a9f7933-ae44-49ad-a8e4-468a32054e10",
                                "sense_id": "082e81d1-a1a1-3ac1-b1d4-28a045d4b27d",
                                "text": "Her only extravagances were fine accoutrements, gorgeous hukes, and mighty war-horses."
                            },
                            {
                                "example_id": "8551011c-a2a2-421f-940a-0e6270a34506",
                                "sense_id": "082e81d1-a1a1-3ac1-b1d4-28a045d4b27d",
                                "text": "Judging from the surviving documents it would appear that Charles VII did nothing at all about Joan of Arc [...] but [she] also swore that she herself was often visited by God, dressed in a white robe with a scarlet huke over it."
                            },
                            {
                                "example_id": "3b9651b9-56f1-4efc-806e-a10b82c2ecd5",
                                "sense_id": "082e81d1-a1a1-3ac1-b1d4-28a045d4b27d",
                                "text": "[…] but after this date “white” armor, or highly polished metal armor, was rarely covered except by a tabard or huke[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a73bccc2-a2ed-45f5-bf94-3718ff78767f",
                        "source_entry_id": "1efbff02-2f73-3fa8-8150-5be386033741",
                        "source_sense_id": "082e81d1-a1a1-3ac1-b1d4-28a045d4b27d",
