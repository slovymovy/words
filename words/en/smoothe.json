{
    "word_family": [
        "smooth",
        "smoothie",
        "smoothly",
        "smoothness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e9d017e-ce27-3cc8-9566-50cdbe70f56f",
                    "sense_definition": "To make even or flat; alternative form of <w>smooth</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "make_flat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to <w>smoothe</w> the wrinkled tablecloth before setting the dinner plates.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>разгладить</w> помятую скатерть перед тем, как расставить обеденные тарелки."
                            }
                        },
                        {
                            "text": "The carpenter used fine sandpaper to <w>smoothe</w> the rough edges of the wooden frame.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал мелкую наждачную бумагу, чтобы <w>сгладить</w> шероховатые края деревянной рамы."
                            }
                        }
                    ],
                    "synonyms": [
                        "flatten",
                        "level"
                    ],
                    "antonyms": [
                        "roughen"
                    ],
                    "common_phrases": [
                        "smoothe the surface",
                        "smoothe the way"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать ровным, гладким или плоским (вариант написания smooth)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разглаживать",
                                "target_lang_sense_clarification": "ткань, складки или поверхность"
                            },
                            {
                                "target_lang_word": "сглаживать",
                                "target_lang_sense_clarification": "неровности, края"
                            },
                            {
                                "target_lang_word": "заглаживать",
                                "target_lang_sense_clarification": "выравнивать поверхность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6a001582-f385-3bc6-a7ea-4beff6e43973",
                    "sense_definition": "Archaic spelling of <w>smooth</w>: having an even surface free from roughness or bumps.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flat_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old text described polished stones with a remarkably <w>smoothe</w> finish.",
                            "target_lang_translations": {
                                "ru": "В старинном тексте описывались полированные камни с удивительно <w>гладкой</w> поверхностью."
                            }
                        },
                        {
                            "text": "Early botanists noted that certain pea varieties possessed a distinctly <w>smoothe</w> texture.",
                            "target_lang_translations": {
                                "ru": "Ранние ботаники отмечали, что некоторые сорта гороха обладали отчетливо <w>гладкой</w> текстурой."
                            }
                        }
                    ],
                    "synonyms": [
                        "even",
                        "flat"
                    ],
                    "antonyms": [
                        "rough"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание smooth: имеющий ровную поверхность, без шероховатостей и бугров; гладкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гладкий",
                                "target_lang_sense_clarification": "без шероховатостей"
                            },
                            {
                                "target_lang_word": "ровный",
                                "target_lang_sense_clarification": "без выступов и неровностей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}