                    {
                        "sense_id": "d7f4df6f-5e98-3f89-8dc0-fc7a72d764e1",
                        "entry_id": "9c5ccb7e-b6eb-3321-a5cc-a2cf2afde218",
                        "glosses": [
                            "отсутствие ветра, спокойствие воздуха, тихая погода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d04142a-e2d3-4b9b-ab69-e112e5ab46c2",
                                "sense_id": "d7f4df6f-5e98-3f89-8dc0-fc7a72d764e1",
                                "text": "Безветрие летнего зноя может смениться внезапно налетевшим ветром, несущим прохладу."
                            }
                        ]
                    },
                    {
                        "sense_id": "bee8aa66-5c2e-3233-b6ae-862c6776d33f",
                        "entry_id": "9c5ccb7e-b6eb-3321-a5cc-a2cf2afde218",
                        "glosses": [
                            "метеорол. безветренная погода; состояние моря, когда на его поверхности отсутствуют ветровые волны"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
