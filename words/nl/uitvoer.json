                {
                    "sense_id": "22e82aea-9406-3091-844f-195d0e395011",
                    "sense_definition": "De verkoop en verzending van goederen of diensten naar het buitenland.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "handel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitvoer</w> van olie is een grote bron van inkomsten voor het land.",
                            "target_lang_translations": {
                                "en": "The <w>export</w> of oil is a major source of income for the country."
                            }
                        },
                        {
                            "text": "Deze havenstad is cruciaal voor de <w>uitvoer</w> van agrarische producten.",
                            "target_lang_translations": {
                                "en": "This port city is crucial for the <w>export</w> of agricultural products."
                            }
                        }
                    ],
                    "synonyms": [
                        "export"
                    ],
                    "antonyms": [
                        "invoer"
                    ],
                    "common_phrases": [
                        "uitvoer van goederen",
                        "belast met uitvoer"
                    ],
                    "target_lang_definitions": {
                        "en": "The sale and shipment of goods or services to foreign countries."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "export",
                                "target_lang_sense_clarification": "the act of sending goods abroad"
                            },
                            {
                                "target_lang_word": "exportation",
                                "target_lang_sense_clarification": "the formal process of exporting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dd378cf-76ea-37a9-a90f-e1c282350447",
                    "sense_definition": "Het proces van het realiseren of volbrengen van een plan, taak of opdracht.",
