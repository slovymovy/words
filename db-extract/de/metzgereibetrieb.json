                "senses": [
                    {
                        "sense_id": "24997fa4-47c4-3902-9c7a-dd6c382d3c7e",
                        "entry_id": "c0d73085-5161-3765-99a5-c9a1a9d17841",
                        "glosses": [
                            "Unternehmen, das Fleisch und Fleischerzeugnissen vertreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7792a47-8812-420f-bb90-f6a7331117e7",
                                "sense_id": "24997fa4-47c4-3902-9c7a-dd6c382d3c7e",
                                "text": "In eurer Stadt schließt der letzte verbliebene Metzgereibetrieb."
                            },
                            {
                                "example_id": "0293a4a9-3ca3-42ba-9f15-48b926b5fc52",
                                "sense_id": "24997fa4-47c4-3902-9c7a-dd6c382d3c7e",
                                "text": "„Nur die wenigsten wollen heute noch Metzger werden. Viele Metzgereibetriebe schließen, weil es keine Mitarbeiter und vor allem keine Nachfolger mehr gibt.“"
                            },
                            {
                                "example_id": "71198632-f084-4de6-8dd8-f3e098dcc734",
                                "sense_id": "24997fa4-47c4-3902-9c7a-dd6c382d3c7e",
                                "text": "„Endlich habe der Beklagte seit einiger Zeit den Metzgereibetrieb unter Übertragung des Geschäfts auf einen Neffen völlig aufgegeben, er beabsichtige auch nicht, das Geschäft wieder aufzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
