                                        "sense_id": "1548bda9-2a2f-3f97-8d2b-c85664add187",
                                        "entry_id": "0d1695d2-32d6-3192-a647-d8636871664b",
                                        "glosses": [
                                            "Split rattan, as used in wickerwork and basketry."
                                        ],
                                        "tags": [
