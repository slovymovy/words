                        "examples": [
                            {
                                "example_id": "ed92581f-e83a-488d-8473-7f9904018686",
                                "sense_id": "bc7c423b-2c11-3d4d-a2de-55d591b231cd",
                                "text": "De dief werd in de kerker geworpen."
                            }
                        ]
