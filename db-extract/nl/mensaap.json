                                "target_senses": [
                                    {
                                        "sense_id": "cc7f39f1-5056-3399-b102-c659225dcada",
                                        "entry_id": "83e85457-b267-3f30-bd7d-494c8c48a23a",
                                        "glosses": [
                                            "A primate of the superfamily Hominoidea, generally larger than monkeys and distinguished from them by having no tail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0036d277-e609-4271-b943-fddb31cef04c",
                                                "sense_id": "cc7f39f1-5056-3399-b102-c659225dcada",
                                                "text": "Of vvhat texte thou proveſt hell / vvill a nother prove purgatory / a nother lymbo patrum / and a nother the aſſumpcion of oure ladi: And a nother ſhall prove of the ſame texte that an Ape hath a tayle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0260a6-bae5-3fa5-99e6-73a9af72c49e",
                                        "entry_id": "83e85457-b267-3f30-bd7d-494c8c48a23a",
                                        "glosses": [
                                            "Any such primate other than a human."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "019f449b-ab1b-3d8d-95b4-8d02779f22fd",
                                        "entry_id": "83e85457-b267-3f30-bd7d-494c8c48a23a",
                                        "glosses": [
                                            "An uncivilized person."
