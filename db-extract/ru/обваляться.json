                        ]
                    },
                    {
                        "translation_id": "a8e48cc0-29a6-48e1-a1fd-73175ba2c772",
                        "source_entry_id": "cd10fec9-ca0e-3ba6-9c2a-51f2f368cfd0",
                        "source_sense_id": "01cc435c-171c-3bff-b4bb-d2a01de438f1",
                        "target_lang_word": "se vautrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se vautrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eeb53bdf-19f2-331f-877b-a2e4126264ed",
                                        "entry_id": "5d917210-61c5-3b28-889a-1abf01599710",
                                        "glosses": [
                                            "S’enfoncer, s’étendre, se rouler dans la boue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa611da-7280-49a0-92c6-fb1508d0f139",
                                                "sense_id": "eeb53bdf-19f2-331f-877b-a2e4126264ed",
                                                "text": "Le sanglier, le cochon se vautre dans la fange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbb03b5f-218b-3303-9814-d54f63d7c2c4",
                                        "entry_id": "5d917210-61c5-3b28-889a-1abf01599710",
                                        "glosses": [
                                            "S’affaler, s’étendre de tout son long, se rouler sur ou dans quelque chose, se vituler."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a6afc49-21d2-45d3-8cae-3b06af0ef0d9",
                                                "sense_id": "bbb03b5f-218b-3303-9814-d54f63d7c2c4",
                                                "text": "Se vautrer sur un lit, sur un canapé, sur l’herbe."
                                            },
                                            {
                                                "example_id": "67743c0c-100f-4889-a966-9872b8721695",
                                                "sense_id": "bbb03b5f-218b-3303-9814-d54f63d7c2c4",
                                                "text": "Antoine appartenait à sa mère par un manque absolu de volonté digne, par un égoïsme de femme voluptueuse qui lui faisait accepter n’importe quel lit d’infamie, pourvu qu’il s’y vautrât à l’aise et qu’il y dormît chaudement."
                                            },
                                            {
                                                "example_id": "520a0056-946d-4d08-a30a-813b9154c186",
                                                "sense_id": "bbb03b5f-218b-3303-9814-d54f63d7c2c4",
                                                "text": "Par une inconcevable mansuétude, Elle avait toléré l’affront des fêtes décadaires, l’outrage de la déesse Raison vautrée sur l’autel à sa place."
                                            },
                                            {
                                                "example_id": "67346a7b-3ea1-4f25-8b14-0b498e24bba0",
                                                "sense_id": "bbb03b5f-218b-3303-9814-d54f63d7c2c4",
                                                "text": "On se gronde de ne s'être pas creusé, même au prix de ses haines les plus chères, un trou heureux, pour vautrer ses lâchetés d'âme et de corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fac9739-8179-3b74-996b-8ad2d0c1ed55",
                                        "entry_id": "5d917210-61c5-3b28-889a-1abf01599710",
                                        "glosses": [
                                            "S’abandonner entièrement dans quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb84bf67-e0d1-401c-99a6-80bd976e48be",
                                                "sense_id": "7fac9739-8179-3b74-996b-8ad2d0c1ed55",
                                                "text": "Comme si le peuple était un vil troupeau d’esclaves stupidement attaché au stupide tyran qu’il a proscrit, voulant, à quelque prix que ce soit, se vautrer dans la bassesse et dans la servitude."
                                            },
                                            {
                                                "example_id": "a076d571-02a8-45da-bef8-84b55825ef8e",
                                                "sense_id": "7fac9739-8179-3b74-996b-8ad2d0c1ed55",
                                                "text": "Arrière l’honnêteté ! fi de la probité ! vautrons-nous dans toutes les jouissances d’abord…"
                                            },
                                            {
                                                "example_id": "8ddf2008-5f8d-49ac-9c2f-d3b1dd6aaae5",
                                                "sense_id": "7fac9739-8179-3b74-996b-8ad2d0c1ed55",
                                                "text": "Il aurait voulu préserver l’unité familiale, mais sa femme se vautrait dans le deuil et n’avait plus d'amour pour lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d3fca11-4636-3d4b-91a2-97afed7a613f",
                                        "entry_id": "5d917210-61c5-3b28-889a-1abf01599710",
                                        "glosses": [
                                            "Échouer lamentablement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0769b8d8-3bd9-44b7-8ce2-bfcb2ed04849",
                                                "sense_id": "1d3fca11-4636-3d4b-91a2-97afed7a613f",
                                                "text": "Je me suis bien vautré à l’exam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
