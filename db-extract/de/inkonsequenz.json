                "senses": [
                    {
                        "sense_id": "7c382316-e453-3cc9-a90d-47d24bd1d659",
                        "entry_id": "9ed6b412-9eb0-3609-9fbc-5282079de9e8",
                        "glosses": [
                            "Eigenschaft/Umstand, dass etwas eine (logische) Folgerichtigkeit (Konsequenz) vermissen lässt, dass eine gewisse Durchsetzungskraft (Konsequenz) fehlt"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "6dc49c46-3e7f-4415-850c-4f63f60a0285",
                                "sense_id": "7c382316-e453-3cc9-a90d-47d24bd1d659",
                                "text": "„Diese Beispiele erscheinen uns deshalb so bezeichnend, weil sie auf eine gewisse logische Inkonsequenz und generelle philosophische Undifferenziertheit hinweisen.“"
                            },
                            {
                                "example_id": "60d625ba-367d-421b-a592-d0b12e900f4a",
                                "sense_id": "7c382316-e453-3cc9-a90d-47d24bd1d659",
                                "text": "Ihr Erziehungsstil ist von Zaghaftigkeit, Inkonsequenz, mangelnder Disziplin und fehlender Übersicht geprägt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
