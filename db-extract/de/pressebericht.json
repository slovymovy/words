                "senses": [
                    {
                        "sense_id": "5d4e06b4-ffce-342f-b467-62c7c5b7d238",
                        "entry_id": "c9b5dc7b-d39b-36ba-85cc-e79ebfee7588",
                        "glosses": [
                            "in der Presse erschienener Bericht"
