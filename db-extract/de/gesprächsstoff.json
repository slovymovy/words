                "senses": [
                    {
                        "sense_id": "4c697467-c83c-3139-be04-ad9abf43adf4",
                        "entry_id": "e0736643-004a-375b-8ca5-d0d644fdc3a9",
                        "glosses": [
                            "Themen (oder deren Grundlage), über die Gespräche geführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67260180-f383-4227-9ceb-f3c1d75e5804",
                                "sense_id": "4c697467-c83c-3139-be04-ad9abf43adf4",
                                "text": "Die Affäre des Chefs zu seiner Sekretärin war ausreichend Gesprächsstoff, um die ganze Firma monatelang zu unterhalten."
                            },
                            {
                                "example_id": "c5ad14d6-e551-4f29-9ff1-8189ad0275ac",
                                "sense_id": "4c697467-c83c-3139-be04-ad9abf43adf4",
                                "text": "„Ausführlich führte Gaus, es ist wahr, auch im SPIEGEL die Gesprächsstoffe vor, über die man sich eben im Kreise von Bekannten so unterhält.“"
                            },
                            {
                                "example_id": "93600306-2871-4f01-bf66-488d04ab08b7",
                                "sense_id": "4c697467-c83c-3139-be04-ad9abf43adf4",
                                "text": "„Da gab es neuen Gesprächsstoff und sogar ein kleines Wunder.“"
                            },
                            {
                                "example_id": "fb84a6b6-3e40-4552-9a1b-a89d6ffb3ab0",
                                "sense_id": "4c697467-c83c-3139-be04-ad9abf43adf4",
                                "text": "„Zwei Verliebten fehlt es nie an Gesprächsstoff, denn sie sprechen von sich selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76713cf0-ae1d-4cd6-b8f7-2b43952d0bbd",
