        "fr-extract.jsonl": [
            {
                "entry_id": "3582d48d-e2d8-3215-9f75-b28d957878c0",
                "word": "avant-toit",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7ea028d1-1ba4-4044-b8f9-6976718bbe9d",
                        "entry_id": "3582d48d-e2d8-3215-9f75-b28d957878c0",
                        "tags": [
                            "plural"
                        ],
                        "form": "avant-toits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                        "entry_id": "3582d48d-e2d8-3215-9f75-b28d957878c0",
                        "glosses": [
                            "Toit en saillie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25fefde6-5f25-4ca3-9fd5-fcb120b34645",
                                "sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                                "text": "Sa chambre d’hôtel spacieuse, nichée sous les avant-toits de la vieille bâtisse, formait un long L, idéal pour tourner en rond fébrilement. Elle marcha du lit king size au bureau, puis au lit et ainsi de suite, caressant son ventre gonflé, le cerveau en ébullition."
                            },
                            {
                                "example_id": "e8d072df-c4f1-40bd-8cc4-f6af491c8968",
                                "sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                                "text": "Plus tard, Ella guetta les deux hirondelles sous les avant-toits à l’extérieur de la fenêtre afin de les observer encore de plus près à présent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f99187f2-15f1-4ccd-a3bf-feefa98dccce",
                        "source_entry_id": "3582d48d-e2d8-3215-9f75-b28d957878c0",
                        "source_sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                        "target_lang_word": "Schutzdach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schutzdach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21394637-26df-30fd-9096-10decb12d01d",
                                        "entry_id": "00ec9815-ed7e-35ca-9567-ebc6cc39fd31",
                                        "glosses": [
                                            "Dach, das Schutz bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8274511-92d3-44d9-bb2b-26835d197ba8",
                                                "sense_id": "21394637-26df-30fd-9096-10decb12d01d",
                                                "text": "„Es regnete stromweise, und Rostow sass mit Iljin, einem jungen, von ihm protegierten Offizier, unter einem rasch errichteten, behelfmässigen Schutzdach.“"
                                            },
                                            {
                                                "example_id": "54e72479-3619-4cb8-9dcd-dbc10a17512b",
                                                "sense_id": "21394637-26df-30fd-9096-10decb12d01d",
                                                "text": "„Heidekraut und Epilobium wuchsen umher, und weit vorhängende Tannenzweige bildeten ein Schutzdach gegen die Sonne.“"
                                            },
                                            {
                                                "example_id": "66684844-387b-4aa8-87ed-5f82eef9a162",
                                                "sense_id": "21394637-26df-30fd-9096-10decb12d01d",
                                                "text": "„Am nächsten Tag erzählen ein paar neu angekommene russische Flüchtlinge, daß sie unterwegs einer jungen Bäuerin in einer Pelzjacke begegnet seien und sich mit ihr während eines kurzen Schneesturms unter das Schutzdach einer Wildhütte geflüchtet hätten.“"
                                            },
                                            {
                                                "example_id": "21eaabd4-2852-4452-948a-26f63284687b",
                                                "sense_id": "21394637-26df-30fd-9096-10decb12d01d",
                                                "text": "„Die Auswanderer selbst hatten augenscheinlich die Nacht über im Innern der Wagen zugebracht, da weiter kein Zelt oder Schutzdach den Platz verriet, wo ein Mensch im Regen geschlafen haben könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84ac6cd0-3454-4c05-bfe2-006bff983556",
                        "source_entry_id": "3582d48d-e2d8-3215-9f75-b28d957878c0",
                        "source_sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                        "target_lang_word": "Dachvorsprung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dachvorsprung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "096168fe-5d95-375f-ab1a-326ea3c39502",
                                        "entry_id": "16cfd67c-53ed-3ea8-a77d-d1c13c1d50f4",
                                        "glosses": [
                                            "Überstand des Daches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bef9d71-7ab7-4aa9-b7ee-3723e8f48772",
                                                "sense_id": "096168fe-5d95-375f-ab1a-326ea3c39502",
                                                "text": "„Am Dachvorsprunge wirbelte im Winde der Schnee vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1dfb6ec-d2ad-47ad-affd-ae07e89b42d8",
                        "source_entry_id": "3582d48d-e2d8-3215-9f75-b28d957878c0",
                        "source_sense_id": "13bce41d-7457-3dc2-a8bc-93702fa16dbc",
                        "target_lang_word": "eaves",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eaves",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                        "entry_id": "ab7b6d70-d59f-3565-b9c3-e6b87b5499b4",
                                        "glosses": [
                                            "The underside of a roof that extends beyond the external walls of a building."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c395de3c-d797-4e01-a277-6819fd921660",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "Him that you term'd Sir, the good old Lord Gonzallo, / His teares runs downe his beard like winters drops / From eaues of reeds: […]"
                                            },
                                            {
                                                "example_id": "23d479e1-fa86-4cfc-9acc-2f256d89c89f",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "Thus night oft ſee me in thy pale career, / Till civil-ſuited morn appeer, / […] / Or uſher'd with a ſhower ſtill, / When the guſt hath blown his fill, / Ending on the ruſsling Leaves, / With minute drops from off the Eaves."
                                            },
                                            {
                                                "example_id": "e0f63a99-e467-4ffa-8371-f0aa511617c0",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "By my window bowered round with leaves, / And down my cheeks the quick tears ran / Like twinkling rain-drops from the eaves, / When warm spring showers are passing o'er: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                        "entry_id": "ab7b6d70-d59f-3565-b9c3-e6b87b5499b4",
                                        "glosses": [
                                            "Something that extends over or projects beyond."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe62c57b-0624-47e8-98dc-9d35a81c2ba7",
                                                "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                                "text": "But after many strains and heaves / He got up to the Saddle eaves."
                                            },
                                            {
                                                "example_id": "4648dd4e-fb97-439c-a218-5154273ad044",
                                                "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                                "text": "The mystic glory swims away; / From off my bed the moonlight dies; / And closing eaves of wearied eyes / I sleep till dusk is dipt in gray: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eaves",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72d3810f-2477-34e9-b613-6d04b82fb982",
                                        "entry_id": "b8b322b1-7fd9-3ae9-ad91-f2aad9717a1d",
