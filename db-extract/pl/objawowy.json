                    },
                    {
                        "translation_id": "9be7741e-eddc-49a7-8914-2d819f07bfb0",
                        "source_entry_id": "776b6339-ea74-3596-9ec7-b550f00a815c",
                        "source_sense_id": "09f1d5f4-ef9f-3d6a-8cd8-0316fe1d30a6",
                        "target_lang_word": "symptomatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symptomatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bae082e-4266-36e4-9053-2cd1058999ac",
                                        "entry_id": "704d15cc-212c-337f-932a-d4da866c4bed",
                                        "glosses": [
                                            "typisch, bezeichnend für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "567bebaa-2875-4242-830d-cef431f42364",
                                                "sense_id": "4bae082e-4266-36e4-9053-2cd1058999ac",
                                                "text": "„Ihre Skepsis ist symptomatisch für eine weit verbreitete Scheu vor der Zusammenschreibung zusammengesetzter Eigenschaftswörter.“"
                                            },
                                            {
                                                "example_id": "c8748883-7b6f-4313-b43f-35288f5da739",
                                                "sense_id": "4bae082e-4266-36e4-9053-2cd1058999ac",
                                                "text": "„Symptomatisch für diese gipfelbezogene Erlebnisweise des Höhenbergsteigens ist die Motivationskurve, die sich in zahlreichen, von mir geführten Interviews sinngleich wie in den folgenden Aussagen offenbart: Wenn ich einen Gipfel erreicht habe, sinkt meine Motivation rapide ab […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc0d401e-43fa-3e15-828a-ec1a8eeb1005",
                                        "entry_id": "704d15cc-212c-337f-932a-d4da866c4bed",
                                        "glosses": [
                                            "die Symptome einer Krankheit betreffend; Symptome zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e65433-2b2d-47cb-a5a1-5745225cc7e9",
                                                "sense_id": "dc0d401e-43fa-3e15-828a-ec1a8eeb1005",
                                                "text": "„Antigentests zeigen nicht selten ein falsch-negatives Ergebnis an, auch bei Personen, die symptomatisch infiziert sind. Da bei symptomatischen Personen das Risiko, infiziert zu sein, höher ist als bei Personen ohne Symptome, sollten Sie auf Nummer Sicher gehen und gleich einen PCR-Test machen lassen. “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
