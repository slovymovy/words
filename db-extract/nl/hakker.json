                        "examples": [
                            {
                                "example_id": "e83e80ac-66e5-486d-acdf-39708ff53eb1",
                                "sense_id": "7cfddf26-aac9-38f8-a12f-4856ed056505",
                                "text": "”Fred the Shred” (de hakker), zoals Goodwin vanwege zijn rigoureuze kostenbesparingen bij de bank werd genoemd, gaf niet toe aan druk van de Britse regering om een deel van zijn pensioenuitkering af te staan."
                            }
                        ]
                    },
                    {
                        "sense_id": "d526edff-de7f-3310-9c2a-3abe0671a28e",
                        "entry_id": "700e64d2-5793-30f8-8a1a-e4bd11653ddf",
                        "glosses": [
                            "apparaat dat hakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7336303-01f4-413b-a36f-cc3ac66636fe",
                                "sense_id": "d526edff-de7f-3310-9c2a-3abe0671a28e",
                                "text": "„Futurologen hebben twee hobby’s: vooruit kijken én achterom, of het klopte. Als het over de toekomst gaat, zijn de ogen gericht op technologie. En die is goed te voorspellen, hooguit zit de timing ernaast. Afbeeldingen van de keuken van de toekomst uit de jaren tachtig kloppen met nu. Alles automatisch, magnetron, vaatwasser, hakkers en kloppers. Maar één ding was consequent fout: achter het aanrecht stond steevast een vrouw.”"
                            }
                        ]
                    }
