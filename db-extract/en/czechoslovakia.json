                                "target_senses": [
                                    {
                                        "sense_id": "df6a378a-0584-3c0d-a994-12fc09887882",
                                        "entry_id": "1cfbb93e-db10-33a9-b711-574ab785a934",
                                        "glosses": [
                                            "zaniklý stát ve střední Evropě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd1b29d-9f0b-492a-a903-79d40d4fa4dd",
                                                "sense_id": "df6a378a-0584-3c0d-a994-12fc09887882",
                                                "text": "Ve skutečnosti nebyla světová veřejnost na naší straně. Proti nám probíhala intenzivní propagandistická kampaň ze strany Německa, v níž bylo Československo líčeno jako stát stojící na násilí, který Evropu strhne do války. Hitler se stavěl do role obránce práva a rozumu proti síle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c3a4137-1c5a-4986-af1e-69dd1dbbf169",
                        "source_entry_id": "cb1fc959-a385-33ce-ab87-68d274b2ae81",
