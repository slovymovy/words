                    {
                        "translation_id": "5d5690ec-5204-4705-b656-3a9ce94358e8",
                        "source_entry_id": "de8ffed6-9097-3b57-8521-a8956edf9141",
                        "source_sense_id": "63fd4dd1-939a-3874-9223-abc3190dcbeb",
                        "target_lang_word": "pubis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pubis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a698261-494c-3488-93e8-2246d4adeeca",
                                        "entry_id": "9d3ce914-ef03-39fc-8f0a-d5d51922443a",
                                        "glosses": [
                                            "Os situé à la partie antérieure et supérieure du bassin, l'un des trois os pelviens (soudés pour former l’os coxal)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d4499d9-5635-4cb0-9953-7a15b54171a8",
                                                "sense_id": "5a698261-494c-3488-93e8-2246d4adeeca",
                                                "text": "Certains muscles de la ceinture abdominale sont insérés sur les pubis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a478222f-2303-36ff-aa1e-1a458045588d",
                                        "entry_id": "9d3ce914-ef03-39fc-8f0a-d5d51922443a",
                                        "glosses": [
                                            "Éminence triangulaire située à la partie inférieure du bas-ventre, qui se couvre de poils à l’époque de la puberté. → voir pénil et mont de Vénus"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f108064-e359-4c85-a850-169ee977d0ad",
                                                "sense_id": "a478222f-2303-36ff-aa1e-1a458045588d",
                                                "text": "Quand tout fut accompli, Djala se mit à genoux devant sa maîtresse et rasa de près son pubis renflé, afin que la jeune fille eût, aux yeux de ses amants, toute la nudité d’une statue."
                                            },
                                            {
                                                "example_id": "e649f7d2-9afd-4856-bd2d-ffa8ac013469",
                                                "sense_id": "a478222f-2303-36ff-aa1e-1a458045588d",
                                                "text": "La kinésithérapeute s’approcha du lit, rabattit le drap, empoigna la jambe gauche de maman : sa chemise de nuit ouverte, celle-ci exhibait avec indifférence son ventre froissé, plissé de rides minuscules, et son pubis chauve. « Je n’ai plus aucune pudeur », a-t-elle dit d’un air surpris. « Tu as bien raison », lui dis-je. Mais je me détournai et je m’absorbai dans la contemplation du jardin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
