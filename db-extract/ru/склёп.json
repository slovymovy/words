                "senses": [
                    {
                        "sense_id": "937471b0-667a-3493-88ba-b76b8ee6b139",
                        "entry_id": "ef77c441-ca2d-359f-9f15-0e19a5808ee5",
                        "glosses": [
                            "устар. или прост. то же, что склеп"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c83d12-2efa-4640-9940-83211d6121c4",
                                "sense_id": "937471b0-667a-3493-88ba-b76b8ee6b139",
                                "text": "Кругом было темно, как в душе, и тихо, будто в могильном склёпе."
                            },
                            {
                                "example_id": "6c37ef80-fb23-4e58-b4fe-256afb377309",
                                "sense_id": "937471b0-667a-3493-88ba-b76b8ee6b139",
                                "text": "Барин умер, у его был склёп."
                            },
                            {
                                "example_id": "8c326a31-6184-41fc-8178-2efb2d7c86ed",
                                "sense_id": "937471b0-667a-3493-88ba-b76b8ee6b139",
                                "text": "Под церковью склёп открылся, архиерей лежал, сам — череп, а мантия цела."
                            }
                        ]
                    }
                ],
