                        "target_lang_word": "Gegenfüßler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenfüßler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8cf8a13-15e2-34a6-b069-4d94c096ac07",
                                        "entry_id": "8fa9395d-180f-34ca-9899-6c8d921679b9",
                                        "glosses": [
                                            "Mensch, der auf der Gegenseite der Erde lebt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecdf39ba-94b4-4261-8a2a-47d14bce18eb",
                                                "sense_id": "e8cf8a13-15e2-34a6-b069-4d94c096ac07",
                                                "text": "„Es wurde ebenso wenig aus den Briefgranaten wie aus Kleists Plänen für ein U-Boot oder seiner Idee, mit ‚Maschinen ein Loch durch die Erde bis zu den Gegenfüßlern zu graben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4b7c3cd-97f4-4334-bcab-71e3f9c2217e",
                        "source_entry_id": "478d8707-09ac-3592-869c-e2aa020f6cdc",
