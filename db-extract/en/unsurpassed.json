                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4eb3a600-06ba-4b65-9d1c-c79051a12b39",
                                "sense_id": "45804a7a-62cb-3496-b24c-c4254e147284",
                                "text": "All grades of coal, deepmined and opencast, are produced, and Durham coking coal is unsurpassed for iron and steel making and is world-famous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
