                "senses": [
                    {
                        "sense_id": "11eaf06c-ba3b-38df-a351-b845d51bb55a",
                        "entry_id": "54d57b02-e991-34a0-8e14-541449481a8c",
                        "glosses": [
                            "financiele vergoeding voor geleden onherstelbaar immaterieel leed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e790bc53-3cd6-405d-be1a-4f984f6d6d86",
                                "sense_id": "11eaf06c-ba3b-38df-a351-b845d51bb55a",
                                "text": "Smartengeld: Vergoeding van immateriële schade door lichamelijk letsel, aantasting van eer of goede naam of een ander persoonsaspect."
                            },
                            {
                                "example_id": "86b246e6-99fe-4a48-a4ee-6ba131d360ac",
                                "sense_id": "11eaf06c-ba3b-38df-a351-b845d51bb55a",
                                "text": "De bezoeker gaat knock-out en wordt per ambulance naar het Medisch Spectrum Twente afgevoerd. Hij heeft een hersenschudding en drie botbreuken in het gezicht. Een oog zit dicht, hij zegt 14 dagen niets te kunnen. De afdelingschef van de groente-afdeling in een supermarkt claimt 2.500 euro smartengeld, dik 1.200 euro materiële schade en 2.340 euro aan advocaatkosten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95c7261d-8ca8-4661-965d-adb4fa07768b",
                        "source_entry_id": "54d57b02-e991-34a0-8e14-541449481a8c",
