                                "sense_id": "c6c70f26-5ede-3620-819f-52954469590f",
                                "text": "Die langgestreckten Wurzelknollen der Batate werden auch zur Herstellung von Spiritus genutzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
