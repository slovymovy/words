                        "entry_id": "7fddc09d-4cee-39a9-8c1c-9722a2fbab57",
                        "glosses": [
                            "zwischen dem umgebenden Nagelwall und dem Nagel, der eigentlichen Nagelplatte, sichtbar aufliegende Hautpartikel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "682e69fe-54ec-4e49-98af-420ae0e951e9",
                                "sense_id": "234e64d6-f32d-3296-b286-f9ad116af6c2",
                                "text": "Was ist denn nun besser: die Nagelhaut zu entfernen oder zurückzuschieben?"
                            },
                            {
                                "example_id": "a0c2ee42-b55b-490f-9c4c-9e5bced2de9a",
                                "sense_id": "234e64d6-f32d-3296-b286-f9ad116af6c2",
                                "text": "Eingerissene Nagelhäute verursachen Schmerzen."
                            }
                        ],
