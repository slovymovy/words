                "senses": [
                    {
                        "sense_id": "3294c65a-b843-34b9-bb23-709d1f28428c",
                        "entry_id": "c75751d6-be65-3919-9810-5a6987c78e6d",
                        "glosses": [
                            "anderes Wort für Faustregel (eine eingebürgerte ungenaue Regel oder Vorgehensweise, die sich im Laufe der Zeit bewährt hat, aber nicht von Gremien oder Institutionen als allgemeingültige Formel festgesetzt wurde)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "795f50bf-9667-4bea-bb45-436d8d3303d3",
                                "sense_id": "3294c65a-b843-34b9-bb23-709d1f28428c",
                                "text": "Eine einfache Daumenregel ist, pro Kilometer eine Viertelstunde anzusetzen. Im Einzelfall kann das natürlich zu viel oder auch einmal zu wenig sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b65acbf5-f371-435e-89b0-86321923475f",
                        "source_entry_id": "c75751d6-be65-3919-9810-5a6987c78e6d",
                        "source_sense_id": "3294c65a-b843-34b9-bb23-709d1f28428c",
                        "source_sense_description": "anderes Wort für Faustregel",
                        "target_lang_word": "rule of thumb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rule of thumb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38ca18bb-5214-353e-a370-43df37b43469",
                                        "entry_id": "7cead9ab-431b-3d32-bb41-875edb284109",
                                        "glosses": [
                                            "A general guideline, rather than a strict rule; an approximate measure or means of reckoning based on experience or common knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1d7e57-af82-4336-aa30-f85f883a1042",
                                                "sense_id": "38ca18bb-5214-353e-a370-43df37b43469",
                                                "text": "The usual rule of thumb says that to calculate when an investment will double, divide 70 by the interest rate."
                                            },
                                            {
                                                "example_id": "8cb59dd9-63b7-49e8-9c0d-e8bbe487d5ed",
                                                "sense_id": "38ca18bb-5214-353e-a370-43df37b43469",
                                                "text": "Here's a good rule of thumb:\nToo clever is dumb."
                                            },
                                            {
                                                "example_id": "eab13270-0752-4bef-9c30-3e6ab7c77669",
                                                "sense_id": "38ca18bb-5214-353e-a370-43df37b43469",
                                                "text": "Since it is impossible to second-guess what a user will want to look up, there is a general lexicographical rule of thumb to err on the side of inclusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db276a3-fd4e-33c2-8a75-d2f4033c8e55",
                                        "entry_id": "7cead9ab-431b-3d32-bb41-875edb284109",
                                        "glosses": [
                                            "Approximated, guesstimated."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e42f4be2-ec6d-4067-8a85-7bef4a4757f7",
                                                "sense_id": "1db276a3-fd4e-33c2-8a75-d2f4033c8e55",
                                                "text": "I made a quick, rule-of-thumb estimate of the manhours required for the job."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
