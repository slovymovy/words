                    "sense_definition": "Het gevoel van genoegdoening of wraak na onrecht.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eindelijk kon de atleet zijn <w>gram</w> halen door de wedstrijd te winnen.",
                            "target_lang_translations": {
                                "en": "The athlete was finally able to get his <w>vindication</w> by winning the race."
                            }
