                        "sense_id": "417f6784-4238-3ee8-8f10-78c4ce52c4d0",
                        "entry_id": "a719e3d9-9a73-3b59-bb49-f184c6391a33",
                        "glosses": [
                            "An anthropomorphic animal character used to represent oneself online or in furry role-playing."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "81ee1917-003c-4d68-b2d5-972bf9aa3af7",
                                "sense_id": "417f6784-4238-3ee8-8f10-78c4ce52c4d0",
                                "text": "Fursuiters dress the part of their furry persona or fursona."
                            },
                            {
                                "example_id": "d6f8a9b8-6935-4e4f-9a36-077bc86312a0",
                                "sense_id": "417f6784-4238-3ee8-8f10-78c4ce52c4d0",
                                "text": "Especially interesting in this regard are furries with more than one fursona. […] Consider, for instance, how Muse describes his two fursonas: My two current sonas are a bat and a rabbit."
                            }
                        ]
                    }
                ],
