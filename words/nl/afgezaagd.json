            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bfe80ea1-90a7-3013-bb9e-a2dabbf0ad37",
                    "sense_definition": "Al te bekend, voorspelbaar en daardoor saai of banaal geworden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertelt op elk familiefeestje dezelfde <w>afgezaagde</w> grappen.",
                            "target_lang_translations": {
                                "en": "He tells the same <w>stale</w> jokes at every family gathering."
                            }
                        },
                        {
                            "text": "Het plot van deze romantische komedie was helaas nogal <w>afgezaagd</w>.",
                            "target_lang_translations": {
                                "en": "The plot of this romantic comedy was unfortunately rather <w>cliché</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "clichématig",
                        "banaal",
                        "afgezaagd",
                        "platgetreden"
                    ],
                    "antonyms": [
                        "origineel",
                        "verrassend"
                    ],
                    "common_phrases": [
                        "afgezaagde grappen",
                        "afgezaagd verhaal",
                        "afgezaagd onderwerp"
                    ],
                    "target_lang_definitions": {
                        "en": "Overly familiar, predictable, and therefore dull, unoriginal, or banal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cliché",
                                "target_lang_sense_clarification": "unoriginal or stereotypical"
                            },
                            {
                                "target_lang_word": "hackneyed",
                                "target_lang_sense_clarification": "overused and unoriginal"
                            },
                            {
                                "target_lang_word": "trite",
                                "target_lang_sense_clarification": "lacking originality or freshness"
                            },
                            {
                                "target_lang_word": "stale",
                                "target_lang_sense_clarification": "jokes, stories, or ideas no longer fresh"
                            }
                        ]
                    }
                }
            ]
        },
        {
