                ],
                "senses": [
                    {
                        "sense_id": "a6cb9842-bffa-343a-998d-fd386d8116ec",
                        "entry_id": "30b88567-44f9-3504-ba8e-3915c4f2476d",
                        "glosses": [
                            "to wipe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec335b2-9b34-4df6-9d6e-f366eac21fd5",
                                "sense_id": "a6cb9842-bffa-343a-998d-fd386d8116ec",
                                "text": "Буфе́тчик Гаври́ло, примя́в о́коло себя́ зелёную со́чную траву́, перетира́л таре́лки и достава́л из коро́бочки завёрнутые в ли́стья сли́вы и пе́рсики.",
                                "translation": "The butler, Gabriel, had stamped down the surrounding grass, wiped the plates in readiness, and unpacked from a basket a quantity of plums and peaches wrapped in leaves.",
                                "english": "The butler, Gabriel, had stamped down the surrounding grass, wiped the plates in readiness, and unpacked from a basket a quantity of plums and peaches wrapped in leaves."
                            },
                            {
                                "example_id": "bd42f9b4-aead-4c06-8fdf-150fab1d5f84",
                                "sense_id": "a6cb9842-bffa-343a-998d-fd386d8116ec",
                                "text": "Она́ облокоти́лась на стол и дово́льно при́стально взгляну́ла на Евпраксе́юшку, кото́рая, вся раскрасне́вшись, перетира́ла стака́ны и то́же исподло́бья взгля́дывала на неё свои́ми больши́ми, му́тными глаза́ми.",
                                "translation": "She leant her elbows on the table and looked quite hard at Evprakseyushka who, with flushed cheeks, was wiping the glasses and casting furtive glances at her too with her great lustreless eyes.",
                                "english": "She leant her elbows on the table and looked quite hard at Evprakseyushka who, with flushed cheeks, was wiping the glasses and casting furtive glances at her too with her great lustreless eyes."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cd0cfd3-06ac-3dad-8f1e-7d99fca23e6b",
                        "entry_id": "30b88567-44f9-3504-ba8e-3915c4f2476d",
                        "glosses": [
                            "to grind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2afb6a4d-09fd-4ef2-8a00-466b4dfef915",
                                "sense_id": "8cd0cfd3-06ac-3dad-8f1e-7d99fca23e6b",
                                "text": "Неандерта́льцы со стоя́нки Челю́скинец II в Волгогра́дской о́бласти не то́лько собира́ли о́хру, но и гото́вили из неё кра́ску: перетира́ли э́тот приро́дный пигме́нт, вероя́тно, нагрева́ли его́ и сме́шивали с вя́жущими вещества́ми.",
                                "translation": "Nauka i Zhizn",
                                "english": "Nauka i Zhizn"
                            }
                        ]
                    },
