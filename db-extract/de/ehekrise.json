                ],
                "senses": [
                    {
                        "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                        "entry_id": "5c0d067d-68d1-3e85-a969-d36674ed55c2",
                        "glosses": [
                            "Schwierigkeiten eines verheiratetes Paares, bei denen mindestens einer der Partner große Probleme mit der Beziehung empfindet / über Trennung nachdenkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8d5a9a-bf8b-4149-9383-a59ff1fbdc5a",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "Ein klassischer Auslöser einer Ehekrise ist, wenn ein Partner fremdgeht."
                            },
                            {
                                "example_id": "22418a04-ffd3-4607-b94a-84f0380dd9ef",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "„Bei Franziska und ihrem Mann hat eine handfeste Ehekrise für einen neuen Umgang mit dem Thema Sex gesorgt.“"
                            },
                            {
                                "example_id": "b5e59d19-6d99-4735-b6e1-6472f1e51edb",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "„Die Krisengerüchte um Fürst Albert und seine Charlène wollen und wollen nicht abreissen. Seit Wochen spekulieren die Medien über eine handfeste Ehekrise der beiden.“ [Anmerkung: 'abreissen' ist Schweizer Rechtschreibung, die deutsche Rechtschreibung lautet 'abreißen']"
                            },
                            {
                                "example_id": "587ad98c-f7a3-4862-9e45-2bea77be16bf",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "„Weil sie sich aber auf keinen Fall bevormunden lässt, entwickelt sich daraus […] eine dicke Ehekrise.“"
                            },
                            {
                                "example_id": "775c180d-90b6-4ed9-9405-580250d5b782",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "Während meiner Ehekrise war ich tief verzweifelt."
                            },
                            {
                                "example_id": "1c8ecb9b-a52b-4f65-8124-adab310f94a0",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "„[…] das Paar Kirsten und Rabih [gerät sich] in der IKEA beim Gläser-Einkauf in die Haare: sie will verschnörkelte, er bevorzugt schlichte – und schon stecken sie in einer Ehekrise.“"
                            },
                            {
                                "example_id": "4cd38539-ea30-44cb-a030-064724f47bce",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "[Jakobs] „Eltern Claas und Irina wissen wenig von ihm, zu sehr sind sie mit sich selbst beschäftigt. Sie stecken in einer Ehekrise - beinahe täglich wird Jakob Zeuge eines Streits.“"
                            },
                            {
                                "example_id": "6a8f76df-d2ef-4ee0-8980-c7a7f12d472e",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "„Spekulationen gab es schon seit längerem: Das einstige Traumpaar Catherine Zeta-Jones (43) und Michael Douglas (68) stecke in einer tiefen Ehekrise, wurde gemunkelt.“"
                            },
                            {
                                "example_id": "3782f949-12d4-44e8-a4c3-3e64e3a028e8",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "„Sie haben ihre Ehekrise überwunden: Hollywoodstar Michael Douglas und seine Frau Catherine Zeta-Jones sind nach ihrer kurzzeitigen Trennung wieder glücklich.“"
                            },
                            {
                                "example_id": "cc8c20a1-046b-4311-b9b5-348a11d476f2",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "„Oberschwester Arzu und Dr. Philipp Brentano wollen ihre Ehekrise mithilfe einer Paartherapie überwinden.“"
                            },
                            {
                                "example_id": "87c721bb-29b0-4d43-89a3-0bd35e9d1bf7",
                                "sense_id": "879b2a4b-14a5-3463-a88e-d7df37c212fb",
                                "text": "„Von wegen Ehekrise! Tomaso Trussardi postet ein Bild von Michelle Hunziker und seinen zwei Töchtern auf Facebook.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
