            {
                "entry_id": "ea4efbd0-bb30-3b2d-8f35-8f0866a40fcb",
                "word": "élusif",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3dbc584c-3a88-4fbb-a647-fb431fe15dc6",
                        "entry_id": "ea4efbd0-bb30-3b2d-8f35-8f0866a40fcb",
                        "tags": [
