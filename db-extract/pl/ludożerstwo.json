                "senses": [
                    {
                        "sense_id": "fd4d7bd7-3dc9-3e6c-a55b-163235683ca2",
                        "entry_id": "c4306a65-e1bb-32b4-a96e-d6c5a2cec0bb",
                        "glosses": [
                            "jedzenie mięsa ludzkiego przez innych ludzi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef7c57a-eca9-4cfe-b042-08fc3f530359",
                                "sense_id": "fd4d7bd7-3dc9-3e6c-a55b-163235683ca2",
                                "text": "Wiele jest przyczyn, dla których uprawia się ludożerstwo. Spożycie ludzkiego mięsa może być częścią ceremonii ku czci zmarłych lub magicznych obrzędów wojennych, w których trakcie męstwo i inne cnoty poległego wroga wchłaniane są przez zwycięzców"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43f0f605-3900-4fc8-b7dd-9cf31ed52309",
                        "source_entry_id": "c4306a65-e1bb-32b4-a96e-d6c5a2cec0bb",
                        "source_sense_id": "fd4d7bd7-3dc9-3e6c-a55b-163235683ca2",
                        "target_lang_word": "Menschenfresserei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenfresserei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                        "entry_id": "ab04d2d5-fc35-3e5b-b07f-9cd19c9df8e7",
                                        "glosses": [
                                            "Verspeisen von Menschenfleisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e23d1456-37f8-4398-b2f9-e6f3f4bdca41",
                                                "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                                "text": "„Da sie sich bewusst waren, dass die meisten Afrikaner sie - stillschweigend oder explizit - bezichtigten, der Menschenfresserei zu frönen, reagierten Europäer oft mit Gegenanklagen:…“"
                                            },
                                            {
                                                "example_id": "6d79fbd3-13d9-45a8-93bf-9862f1b685f5",
                                                "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                                "text": "„Schilderungen von Menschenfressereien dienten häufig aber auch dazu, die Unterjochung und Ausrottung \"wilder Völker\" zu rechtfertigen. “"
                                            },
                                            {
                                                "example_id": "69c9a288-4678-42a6-823b-0de47eab84ad",
                                                "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                                "text": "„Die Frage von Colonel Sebastiani zur Menschenfresserei überraschte mich nicht.“"
                                            },
                                            {
                                                "example_id": "e5d6ac42-95fb-4bbf-b986-fcf11f8c1eb0",
                                                "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                                "text": "„Aber auch weiße Händler, Missionare und Schiffbrüchige wurden Opfer der Menschenfresserei, wie durch glaubwürdige Zeugen und Aufzeichnungen belegt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10dc7247-37ce-4fff-9f3b-1388cd4cc75e",
                        "source_entry_id": "c4306a65-e1bb-32b4-a96e-d6c5a2cec0bb",
