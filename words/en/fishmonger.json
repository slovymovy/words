{
    "word_family": [
        "fishmongery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "608bbb03-fb79-3661-8593-9618cfa574eb",
                    "sense_definition": "A person who sells fish.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fish_seller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>fishmonger</w> always recommends the freshest catch of the day.",
                            "target_lang_translations": {
                                "ru": "Местный <w>торговец рыбой</w> всегда рекомендует самый свежий улов дня."
                            }
                        },
                        {
                            "text": "He decided to work as a <w>fishmonger</w> at the busy harbor market.",
                            "target_lang_translations": {
                                "ru": "Он решил работать <w>продавцом рыбы</w> на оживленном портовом рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "fishman",
                        "ichthyopolist"
                    ],
                    "common_phrases": [
                        "local fishmonger",
                        "traditional fishmonger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который продает рыбу; торговец рыбой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торговец рыбой",
                                "target_lang_sense_clarification": "человек, продающий рыбу"
                            },
                            {
                                "target_lang_word": "рыботорговец",
                                "target_lang_sense_clarification": "человек, занимающийся продажей рыбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                    "sense_definition": "A shop that sells fish.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fish_seller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the <w>fishmonger</w> to buy some fresh salmon for dinner.",
                            "target_lang_translations": {
                                "ru": "Она пошла в <w>рыбный магазин</w>, чтобы купить свежего лосося на ужин."
                            }
                        },
                        {
                            "text": "There is a wonderful <w>fishmonger</w> down the street that sells excellent seafood.",
                            "target_lang_translations": {
                                "ru": "Дальше по улице есть отличная <w>рыбная лавка</w>, где продают великолепные морепродукты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "at the fishmonger",
                        "visit the fishmonger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Магазин, в котором продается рыба и морепродукты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыбный магазин",
                                "target_lang_sense_clarification": "торговая точка"
                            },
                            {
                                "target_lang_word": "рыбная лавка",
                                "target_lang_sense_clarification": "небольшой магазин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "598cf8ce-9895-3242-bc2e-50cd48a2c49f",
                    "sense_definition": "A pimp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Shakespeare's Hamlet, the prince famously calls Polonius a <w>fishmonger</w>.",
                            "target_lang_translations": {
                                "ru": "В шекспировском «Гамлете» принц, как известно, называет Полония <w>торговцем рыбой</w>."
                            }
                        },
                        {
                            "text": "The use of <w>fishmonger</w> to mean a procurer is well-known to students of Elizabethan drama.",
                            "target_lang_translations": {
                                "ru": "Использование слова <w>fishmonger</w> в значении сводника хорошо известно исследователям елизаветинской драмы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically or in literary contexts, notably in Shakespearean English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сутенер (устаревшее, шекспировское значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сутенер",
                                "target_lang_sense_clarification": "архаичное сленговое значение"
                            },
                            {
                                "target_lang_word": "торговец живым товаром",
                                "target_lang_sense_clarification": "переносное устаревшее значение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}