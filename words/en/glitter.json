{
    "word_family": [
        "glittery",
        "glittering",
        "glitteringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3b7763f-0a45-3649-b314-63038ecdfc5f",
                    "sense_definition": "Tiny pieces of shiny material used for decoration or crafts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "craft_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children used glue and <w>glitter</w> to make their holiday cards.",
                            "target_lang_translations": {
                                "ru": "Дети использовали клей и <w>блёстки</w>, чтобы сделать поздравительные открытки.",
                                "zh": "孩子们用胶水和<w>闪粉</w>制作节日贺卡。",
                                "es": "Los niños usaron pegamento y <w>purpurina</w> para hacer sus tarjetas navideñas."
                            }
                        },
                        {
                            "text": "It is very difficult to clean up <w>glitter</w> once it spills on the carpet.",
                            "target_lang_translations": {
                                "ru": "Очень трудно убрать <w>блёстки</w>, если они просыпались на ковёр.",
                                "zh": "一旦<w>亮片</w>洒在地毯上，就很难清理干净。",
                                "es": "Es muy difícil limpiar la <w>purpurina</w> una vez que se derrama en la alfombra."
                            }
                        }
                    ],
                    "synonyms": [
                        "sparkles"
                    ],
                    "common_phrases": [
                        "gold glitter",
                        "glitter glue",
                        "sprinkle glitter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкие блестящие частицы, используемые для украшения или поделок.",
                        "zh": "用于装饰或手工制作的细小闪光材料。",
                        "es": "Pequeñas partículas brillantes utilizadas para decoración o manualidades."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блёстки",
                                "target_lang_sense_clarification": "материал для украшения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亮片",
                                "target_lang_sense_clarification": "用于装饰的闪光小片"
                            },
                            {
                                "target_lang_word": "闪粉",
                                "target_lang_sense_clarification": "用于手工的细小闪光粉末"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "purpurina",
                                "target_lang_sense_clarification": "material decorativo brillante"
                            },
                            {
                                "target_lang_word": "brillantina",
                                "target_lang_sense_clarification": "polvo brillante para manualidades"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9bd394b-ac1d-35a3-b26e-23c7e23834df",
                    "sense_definition": "A bright, sparkling light or shine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She admired the <w>glitter</w> of the diamond ring on her finger.",
                            "target_lang_translations": {
                                "ru": "Она любовалась <w>блеском</w> бриллиантового кольца на своём пальце.",
                                "zh": "她欣赏着手指上钻戒的<w>闪光</w>。",
                                "es": "Ella admiraba el <w>brillo</w> del anillo de diamantes en su dedo."
                            }
                        },
                        {
                            "text": "The <w>glitter</w> of the sun on the ocean waves was blindingly bright.",
                            "target_lang_translations": {
                                "ru": "<w>Сверкание</w> солнца на океанских волнах было ослепительно ярким.",
                                "zh": "海浪上太阳的<w>闪耀</w>刺眼夺目。",
                                "es": "El <w>resplandor</w> del sol sobre las olas del océano era cegador."
                            }
                        }
                    ],
                    "synonyms": [
                        "sparkle",
                        "shimmer",
                        "shine",
                        "gleam",
                        "brilliance"
                    ],
                    "antonyms": [
                        "dullness",
                        "darkness"
                    ],
                    "common_phrases": [
                        "glitter of gold",
                        "soft glitter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий, искрящийся свет или сияние.",
                        "zh": "明亮、闪烁的光芒或光泽。",
                        "es": "Una luz brillante o un resplandor."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "яркий свет"
                            },
                            {
                                "target_lang_word": "сверкание",
                                "target_lang_sense_clarification": "искрящийся свет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪光",
                                "target_lang_sense_clarification": "明亮的光芒"
                            },
                            {
                                "target_lang_word": "光泽",
                                "target_lang_sense_clarification": "物体表面反射出的光"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brillo",
                                "target_lang_sense_clarification": "luz emitida o reflejada"
                            },
                            {
                                "target_lang_word": "resplandor",
                                "target_lang_sense_clarification": "luz intensa y brillante"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "895d3f2b-4a2e-3ab4-aaba-733176cb339a",
                    "sense_definition": "Superficial glamour or showiness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_showiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was attracted by the <w>glitter</w> and fame of Hollywood.",
                            "target_lang_translations": {
                                "ru": "Его привлекали <w>блеск</w> и слава Голливуда.",
                                "zh": "他被好莱坞的<w>浮华</w>与名声所吸引。",
                                "es": "Él se sentía atraído por el <w>brillo</w> y la fama de Hollywood."
                            }
                        },
                        {
                            "text": "Behind the <w>glitter</w> of the event, there was very little substance.",
                            "target_lang_translations": {
                                "ru": "За внешним <w>блеском</w> этого события скрывалось очень мало содержания.",
                                "zh": "在这场活动的<w>浮华</w>背后，其实并没有多少实质内容。",
                                "es": "Detrás del <w>brillo</w> del evento, había muy poco contenido."
                            }
                        }
                    ],
                    "synonyms": [
                        "glitz",
                        "glamour",
                        "flashiness"
                    ],
                    "common_phrases": [
                        "glitter and glamour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешняя, часто поверхностная, роскошь или эффектность.",
                        "zh": "表面的浮华、奢华或虚荣。",
                        "es": "Glamour o apariencia superficial y llamativa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "великолепие, гламур"
                            },
                            {
                                "target_lang_word": "мишура",
                                "target_lang_sense_clarification": "показная роскошь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浮华",
                                "target_lang_sense_clarification": "表面上的繁华"
                            },
                            {
                                "target_lang_word": "光环",
                                "target_lang_sense_clarification": "引人注目的外在表现"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brillo",
                                "target_lang_sense_clarification": "esplendor o apariencia llamativa"
                            },
                            {
                                "target_lang_word": "oropel",
                                "target_lang_sense_clarification": "riqueza o belleza falsa y superficial"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                    "sense_definition": "To shine with a bright, shimmering, and often broken light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fresh snow <w>glittered</w> in the bright morning sunlight.",
                            "target_lang_translations": {
                                "ru": "Свежий снег <w>сверкал</w> на ярком утреннем солнце.",
                                "zh": "新雪在明亮的晨光下<w>闪烁</w>着。",
                                "es": "La nieve fresca <w>brillaba</w> bajo la intensa luz del sol de la mañana."
                            }
                        },
                        {
                            "text": "Her eyes <w>glittered</w> with excitement when she saw the surprise gift.",
                            "target_lang_translations": {
                                "ru": "Её глаза <w>заблестели</w> от волнения, когда она увидела сюрприз.",
                                "zh": "当她看到惊喜礼物时，双眼因兴奋而<w>闪耀</w>。",
                                "es": "Sus ojos <w>centellearon</w> de emoción cuando vio el regalo sorpresa."
                            }
                        }
                    ],
                    "synonyms": [
                        "sparkle",
                        "shimmer",
                        "twinkle",
                        "gleam"
                    ],
                    "common_phrases": [
                        "glitter in the sun",
                        "eyes glittered"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светиться ярким, мерцающим светом.",
                        "zh": "发出明亮、闪烁且通常断续的光。",
                        "es": "Brillar con una luz intensa, parpadeante o centelleante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверкать",
                                "target_lang_sense_clarification": "ярко искриться"
                            },
                            {
                                "target_lang_word": "блестеть",
                                "target_lang_sense_clarification": "излучать свет"
                            },
                            {
                                "target_lang_word": "искриться",
                                "target_lang_sense_clarification": "мерцать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "光线忽明忽暗"
                            },
                            {
                                "target_lang_word": "闪耀",
                                "target_lang_sense_clarification": "发出光芒"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brillar",
                                "target_lang_sense_clarification": "emitir o reflejar luz"
                            },
                            {
                                "target_lang_word": "centellear",
                                "target_lang_sense_clarification": "brillar con luz vibrante o intermitente"
                            },
                            {
                                "target_lang_word": "resplandecer",
                                "target_lang_sense_clarification": "emitir luz intensa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b525baac-06c6-3855-a18b-02dee7b06319",
                    "sense_definition": "To be impressively showy or attractive, often superficially.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_showiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grand ballroom <w>glittered</w> with expensive jewelry and fine clothes.",
                            "target_lang_translations": {
                                "ru": "Большой бальный зал <w>сверкал</w> дорогими украшениями и изысканными нарядами.",
                                "zh": "宏伟的宴会厅里，昂贵的珠宝和华丽的服饰交相<w>辉映</w>。",
                                "es": "El gran salón de baile <w>brillaba</w> con joyas costosas y ropa elegante."
                            }
                        },
                        {
                            "text": "The royal court <w>glittered</w> with wealth during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Королевский двор <w>блистал</w> богатством во время церемонии.",
                                "zh": "典礼期间，皇室宫廷因财富而显得金碧<w>辉煌</w>。",
                                "es": "La corte real <w>brillaba</w> de riqueza durante la ceremonia."
                            }
                        }
                    ],
                    "synonyms": [
                        "dazzle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить сильное впечатление роскошью или внешним видом.",
                        "zh": "因奢华或外表出众而引人注目。",
                        "es": "Destacar de manera impresionante por su apariencia o lujo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блистать",
                                "target_lang_sense_clarification": "выделяться великолепием"
                            },
                            {
                                "target_lang_word": "сиять",
                                "target_lang_sense_clarification": "выглядеть великолепно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪耀",
                                "target_lang_sense_clarification": "因华丽而引人注目"
                            },
                            {
                                "target_lang_word": "辉煌",
                                "target_lang_sense_clarification": "形容场面宏大华丽"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brillar",
                                "target_lang_sense_clarification": "sobresalir por méritos o apariencia"
                            },
                            {
                                "target_lang_word": "lucirse",
                                "target_lang_sense_clarification": "destacar por su aspecto o actuación"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}