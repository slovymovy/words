                    }
                ],
                "senses": [
                    {
                        "sense_id": "4156f539-0091-3b5b-9d97-dd69266a4c04",
                        "entry_id": "7c3ff775-3844-3207-9a48-baeb9b02334d",
                        "glosses": [
                            "kostenlose Bereitstellung von erforderlichen Mitteln zur Durchführung des Unterrichts in Schulen (beispielsweise Schulbüchern)"
                        ],
                        "tags": [
                            "Bildungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "7c0c708b-72db-489a-8090-4a4ced16edc6",
                                "sense_id": "4156f539-0091-3b5b-9d97-dd69266a4c04",
                                "text": "Lehrmittelfreiheit bedeutet Chancengleichheit für alle Kinder, auch solche aus armen Familien."
                            },
                            {
                                "example_id": "1b4b9aad-2d8f-4f9f-a36d-4b8c16685c15",
                                "sense_id": "4156f539-0091-3b5b-9d97-dd69266a4c04",
                                "text": "Die Wichtigkeit der Lehrmittelfreiheit wusste man in Deutschland schon 1848 zu schätzen."
                            },
                            {
                                "example_id": "8ec6fcd8-470c-415e-b898-1f9055fb5c3d",
                                "sense_id": "4156f539-0091-3b5b-9d97-dd69266a4c04",
                                "text": "In Schleswig-Holstein gibt es, anders als in anderen deutschen Bundesländern, keine Lehrmittelfreiheit."
                            },
                            {
                                "example_id": "636168ba-846c-4cbf-8190-f4e4f79c274c",
                                "sense_id": "4156f539-0091-3b5b-9d97-dd69266a4c04",
                                "text": "„Manche Bundesländer gewähren allen Schülern eine sogenannte Lehrmittelfreiheit, Bücher werden dann etwa ausgeliehen.“"
                            },
                            {
                                "example_id": "38cd57ab-ac0e-4cf5-8e56-bc186c3a5ec0",
                                "sense_id": "4156f539-0091-3b5b-9d97-dd69266a4c04",
                                "text": "„»Wir haben in Deutschland Lehrmittelfreiheit.«“ [Anmerkung: Die Aussage der bildungspolitischen Sprecherin der AfD im sächsischen Landtag, Karin Wilke, ist falsch.]"
                            },
                            {
                                "example_id": "269a7770-a33d-40c2-b7be-69219501fb3a",
                                "sense_id": "4156f539-0091-3b5b-9d97-dd69266a4c04",
                                "text": "Durch die Digitalisierung der Klassenzimmer, die Ausstattung mit Tablets und Laptops, bekommt die Lehrmittelfreiheit eine neue Bedeutung. Schließlich kostet ein Laptop ein Vielfaches eines Buches."
                            },
                            {
                                "example_id": "798d56d6-c9f8-436d-bf31-4776bca21dab",
                                "sense_id": "4156f539-0091-3b5b-9d97-dd69266a4c04",
                                "text": "„Da es 1969 in seinem Heimatland Rheinland-Pfalz keine Lehrmittelfreiheit gab, musste der damals Zehnjährige [Anmerkung: der stellvertretende SPD-Vorsitzende Ralf Stegner] aus Bad Dürkheim nach Mannheim pendeln, das Gymnasium zuhause wäre zu teuer für die Familie mit fünf Kindern gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
