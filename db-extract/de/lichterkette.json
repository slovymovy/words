                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fairy lights",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b17829e8-c82c-3d37-95da-739e76a60021",
                                        "entry_id": "b0c58a78-fc9a-3080-8dc9-c5167797591f",
                                        "glosses": [
                                            "Small electric lights on a strand which are used decoratively, especially on Christmas trees."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed1dc8c4-129b-4fd9-a810-b7c8eaa97f8f",
                                                "sense_id": "b17829e8-c82c-3d37-95da-739e76a60021",
                                                "text": "Through the trees ahead came odd strains from the dance band in the Casino, and now I could see many twinkling fairy lights and detect moving figures."
                                            },
                                            {
                                                "example_id": "2417eb70-0b7e-435e-8b41-1acb0b622d89",
                                                "sense_id": "b17829e8-c82c-3d37-95da-739e76a60021",
                                                "text": "I managed to put quite a lot of small baubles on the top of the tree that way and helped drape the long string of fairy lights around it, […]"
                                            },
                                            {
                                                "example_id": "4b803500-8f82-4899-ad9f-a1bde879541a",
                                                "sense_id": "b17829e8-c82c-3d37-95da-739e76a60021",
                                                "text": "A constant, slightly defocused, dinner party with relaxed glamorous friends, carrying on just outside the kitchen door, under the fairy lights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
