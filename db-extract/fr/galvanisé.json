                "senses": [
                    {
                        "sense_id": "2d4c0067-81a0-3bcd-aad5-5aa42119d91e",
                        "entry_id": "4b42b5f8-2a4d-3e1d-aa32-1f1dbdc9364f",
                        "glosses": [
                            "Qualifie un métal qui est recouvert d’une fine couche de zinc par galvanisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd85a8a7-6670-455f-ae7f-ca3f05c61d58",
                                "sense_id": "2d4c0067-81a0-3bcd-aad5-5aa42119d91e",
                                "text": "Le gréement dormant en fil d’acier galvanisé, peut supporter un effort de dix tonnes sans se rompre."
                            },
                            {
                                "example_id": "27c60e27-8084-441e-9925-4f772b8cb386",
                                "sense_id": "2d4c0067-81a0-3bcd-aad5-5aa42119d91e",
                                "text": "Manu entrait dans une petite pièce qu’on avait dénichée pour lui : des murs sales, un banc et, dans un coin, des seaux galvanisés et des balais."
                            }
                        ]
                    },
                    {
                        "sense_id": "8302e620-4440-3dab-ac84-219b351180e9",
                        "entry_id": "4b42b5f8-2a4d-3e1d-aa32-1f1dbdc9364f",
                        "glosses": [
                            "Sous les effets d'une pile galvanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56792bb2-f9d5-4945-98b4-a2e7914c0985",
                                "sense_id": "8302e620-4440-3dab-ac84-219b351180e9",
                                "text": "Un cheval mort, couché sur une autre table et galvanisé, détacha des ruades qui brisèrent des appareils qu'on avait négligé d'éloigner suffisamment, et faillirent renverser et blesser plusieurs assistants."
                            }
                        ]
                    },
                    {
                        "sense_id": "4044b325-f3e1-30a5-adc3-ab4408204072",
                        "entry_id": "4b42b5f8-2a4d-3e1d-aa32-1f1dbdc9364f",
                        "glosses": [
                            "Qui bénéficie temporairement d’énergie et d'un enthousiasme accru."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "513360ff-771b-4709-8a30-4dbf4e141bfc",
                                "sense_id": "4044b325-f3e1-30a5-adc3-ab4408204072",
                                "text": "Retraites : galvanisés, les syndicats appellent à manifester jeudi prochain"
                            }
                        ]
                    }
