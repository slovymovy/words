                "translations": [
                    {
                        "translation_id": "ef019cf7-f1c3-49eb-853b-77602e7aa22b",
                        "source_entry_id": "39bebc2c-d423-35e3-815c-6ac5da3777fe",
                        "source_sense_id": "94f485d2-7a1c-3c8a-b42f-c1a5c54ca1bd",
                        "target_lang_word": "assimilation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assimilation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16ed900e-f705-3420-abc8-078cc5b7740b",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "The act of assimilating or the state of being assimilated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17b70f09-1c28-4f4e-ac1d-441687361da7",
                                                "sense_id": "16ed900e-f705-3420-abc8-078cc5b7740b",
                                                "text": "--France swarms with Gracchus's and Publicolas, who by imaginary assimilations of acts, which a change of manners has rendered different, fancy themselves more than equal to their prototypes."
                                            },
                                            {
                                                "example_id": "25e47fbf-ebec-4c21-9031-e4249f2b89dc",
                                                "sense_id": "16ed900e-f705-3420-abc8-078cc5b7740b",
                                                "text": "His work generally is full of assimilations and quotations from art that is not Mexican, and he's said, \"Nationalism has nothing to do with my work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc7d5e94-17be-3e7c-b554-812747a662e0",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "The metabolic conversion of nutrients into tissue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a787d65-847f-401f-933b-ad5a59e66a35",
                                                "sense_id": "dc7d5e94-17be-3e7c-b554-812747a662e0",
                                                "text": "We have great need to be careful in these assimilations; some kinds of food are rich but not easily digested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898b295e-2fe6-3cd1-add0-f9f914b70bf2",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "The absorption of new ideas into an existing cognitive structure."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "665f4137-e2ac-366c-beff-2ab19a68fe85",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "A sound change process by which the phonetics of a speech segment becomes more like that of another segment in a word (or at a word boundary), so that a change of phoneme occurs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea274d1a-1783-4a81-8909-6df5e7234fc8",
                                                "sense_id": "665f4137-e2ac-366c-beff-2ab19a68fe85",
                                                "text": "Hence, rather than being the result of mishearing and assimilation, the application of Hobson-Jobson to the Muharram was intentionally disparaging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db00957-0283-386f-9d39-d78ede05ebed",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "The adoption, by a minority group, of the customs and attitudes of the dominant culture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee92ac35-b741-4d47-920b-7d4f6f82e492",
                                                "sense_id": "0db00957-0283-386f-9d39-d78ede05ebed",
                                                "text": "After centuries of British cultural assimilation, a majority of Irish now speak English instead of Irish."
                                            },
                                            {
                                                "example_id": "afe59825-ed37-4fa3-ba89-547964f32473",
                                                "sense_id": "0db00957-0283-386f-9d39-d78ede05ebed",
                                                "text": "Assimilation was one of the words they used for Indians becoming white in order to survive, in order that they might not be killed for being Indians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d657aca-5c2d-4d07-91d5-ec52d2a7cadf",
                        "source_entry_id": "39bebc2c-d423-35e3-815c-6ac5da3777fe",
