            "senses": [
                {
                    "sense_id": "ffee0ebd-94fe-3dc8-ac90-3cc17213b072",
                    "sense_definition": "Directed towards the back or opposite to the usual direction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
