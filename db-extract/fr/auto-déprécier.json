                ],
                "senses": [
                    {
                        "sense_id": "f90b4345-e368-30ca-ad38-f10d1999334c",
                        "entry_id": "c711ef9d-eb77-3ad2-a0e7-f0e73c6b3367",
                        "glosses": [
                            "Déprécier quelque chose qui nous appartient en propre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e77cc5a-ec8b-4a78-a587-f7e115f65a2a",
                                "sense_id": "f90b4345-e368-30ca-ad38-f10d1999334c",
                                "text": "Comme le mélancolique, l'obsessionnel ne cesse de s’auto-déprécier; il situe la souillure - le Mal - dans lui-même alors qu'il se lance dans une quête éperdue de pureté."
                            },
                            {
                                "example_id": "f34a527a-a495-4e01-810b-e4a5e5047ad8",
                                "sense_id": "f90b4345-e368-30ca-ad38-f10d1999334c",
                                "text": "L’objet est porteur de ce qui leur est nécessaire, s’il les abandonne, ils s’en trouvent mutilés et ne peuvent que s’auto-déprécier."
                            }
                        ]
                    }
                ],
