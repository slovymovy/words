                    {
                        "form_id": "346748bc-9464-4b0e-abfa-c4e586789b55",
                        "entry_id": "2dd64f7f-2c94-3650-8294-7e9c501c7b98",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kinderheime"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                        "entry_id": "2dd64f7f-2c94-3650-8294-7e9c501c7b98",
                        "glosses": [
                            "eine Einrichtung, in der Kinder untergebracht werden, die nicht bei ihrer Familie leben können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e751a972-d371-4075-b7ff-4b482e8bde12",
                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                "text": "Das Kinderheim ist glücklicherweise nicht voll ausgelastet."
                            },
                            {
                                "example_id": "3372e279-d9cf-456b-893c-fde976528aa1",
                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                "text": "„Alle arbeitenden Frauen ziehen in die Hamburger, die Beamten aus der Hamburger in die »Sonne« (ehemaliges Hotel), Mütter mit Säuglingen ins Säuglingsheim, Kinder ins Kriechlingsheim und ins Kinderheim, größere Mädchen ins Mädchenheim, die Jungen ins Jungenheim und ins Lehrlingsheim.“"
                            },
                            {
                                "example_id": "e111aafc-9a89-428d-bf35-79c3ef61cbb9",
                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                "text": "„Im Herbst werden sie und die beiden Brüder in eines der wenigen russischen Kinderheime der Oblast in der Elchniederung gebracht.“"
                            },
                            {
                                "example_id": "8063b6e0-67c1-4008-8c2c-da25537c9a46",
                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                "text": "„Das Gutshaus in Klenzin, das seit zehn Jahren leerstand, soll ein Kinderheim aufnehmen.“"
                            },
                            {
                                "example_id": "f02cee83-226c-477b-975f-391465a31595",
                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                "text": "„Mit vier Jahren war er in das katholische Kinderheim gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
