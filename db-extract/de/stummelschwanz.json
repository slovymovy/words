                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f882c878-763e-4e65-aa59-d8003a082b50",
                                                "sense_id": "c11b7cc4-babe-3601-af62-a152670eac89",
                                                "text": "―A fat lot you know about it, Thunder! Wells said. I know why they scut."
                                            }
                                        ]
