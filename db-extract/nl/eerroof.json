                "translations": [
                    {
                        "translation_id": "b57c57fd-ae96-4fea-92bb-54eff22aad4d",
                        "source_entry_id": "9adedf22-fa6e-358b-b532-a80ecc19023f",
                        "source_sense_id": "c6baca1c-ec9f-346b-b2bf-f2cd9e23e8fc",
                        "target_lang_word": "Verleumdung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verleumdung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                        "entry_id": "cee8490b-b862-32b4-ba2e-a784e5cd7d76",
                                        "glosses": [
                                            "Rufschädigung durch falsche Aussagen oder Behauptungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dca24f7-47c3-4147-8f1b-0310965f8578",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "Die Verleumdung hinterlässt auch bei Widerruf ein schlechtes Image."
                                            },
                                            {
                                                "example_id": "18e5d9b8-d47c-44c9-8e33-e8ef27ae9cf1",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "Der Arbeitskollege meiner Tante wurde wegen Verleumdung angeklagt, weil er in der Abteilung behauptet hatte, er hätte meine Tante beim Ladendiebstahl beobachtet."
                                            },
                                            {
                                                "example_id": "0cff0c36-0fa2-4bef-87cf-74e1c37e7648",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "„Mengs schloß sich dem Gesandten an; er lud mich ein, bei ihm zu wohnen, damit ich nicht mehr der Verleumdung von Spitzeln ausgesetzt sei, von denen Madrid voll war.“"
                                            },
                                            {
                                                "example_id": "cd94be79-c71f-45cf-b9b6-0b843baddc1e",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "„Eine Verleumdung desjenigen, der anders in die Welt sieht, ist damit natürlich nicht per se gegeben, aber sie kann neheliegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a4156c3-c358-3663-a8fa-4239f2426ef4",
                                        "entry_id": "cee8490b-b862-32b4-ba2e-a784e5cd7d76",
                                        "glosses": [
                                            "Straftatbestand des § 187 StGB, der verwirklicht ist, wenn jemand wider besseres Wissen über einen anderen eine unwahre Tatsache, also Vorgänge oder Zustände der Vergangenheit oder der Gegenwart, die dem Beweis zugänglich sind, behauptet, das heißt, als nach seiner eigenen Überzeugung wahr hinstellt oder verbreitet, sie also als Gegenstand fremden Wissens weitergibt, die dazu geeignet ist, diesen verächtlich zu machen, ihn in der öffentlichen Meinung herabzuwürdigen oder seinen Kredit zu gefährden"
                                        ],
                                        "tags": [
                                            "deutsches Strafrecht"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e1bb173-c7f6-4c97-84d4-35c45dff5c2a",
                        "source_entry_id": "9adedf22-fa6e-358b-b532-a80ecc19023f",
                        "source_sense_id": "c6baca1c-ec9f-346b-b2bf-f2cd9e23e8fc",
                        "target_lang_word": "defamation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defamation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                        "entry_id": "f3835acf-71e6-322a-baeb-25850966d48c",
                                        "glosses": [
                                            "The act of injuring another person's reputation by any slanderous communication, written or oral; the wrong of maliciously injuring the good name of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d99e7a4-7a62-470f-a05a-fd7bb51c80d2",
                                                "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                                "text": "She sued his ex-boyfriend for defamation and is seeking $14,000."
                                            },
                                            {
                                                "example_id": "7d261924-66e3-446f-b888-2b35316a94a9",
                                                "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                                "text": "In a closed trial on December 24, 2004, the People’s Court of Jinshui District in the city of Zhengzhou, Henan Province, convicted Zhang Ruquan, along with his associate Zhang Zhengyao, in a public prosecution on charges of defamation that “seriously undermined social order or the state interest.” The two were sentenced to three years in prison for defaming former Chinese President Jiang Zemin."
                                            },
                                            {
                                                "example_id": "142f3666-4acd-4fbf-ac68-55a3edaabe68",
                                                "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                                "text": "An hour later, when the Fox board approved the wire payment for $787.5 million — one of the largest known defamation settlements in history — Fox acknowledged what we needed it to acknowledge: spreading false claims comes with a huge price tag."
                                            },
                                            {
                                                "example_id": "7d53dc7c-0039-450d-9828-4728e62750f1",
                                                "sense_id": "394fe247-f616-365e-96bf-2c9b2a29aa00",
                                                "text": "Merryday, who was appointed by President Geroge^([sic]) H. W. Bush, said the complaint contains eighty pages of repetitive claims and praise for President Trump, but fails to establish the two counts of defamation alleged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa6a98ce-9add-4481-9ad3-bb1d462732c3",
                        "source_entry_id": "9adedf22-fa6e-358b-b532-a80ecc19023f",
                        "source_sense_id": "c6baca1c-ec9f-346b-b2bf-f2cd9e23e8fc",
                        "target_lang_word": "backbiting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backbiting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb1fd9f-19dd-3990-b66d-21901fdea226",
                                        "entry_id": "5e5782d9-7799-3169-9e72-78e0ee572e3c",
                                        "glosses": [
                                            "The action of slandering a person without that person's knowledge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71cb29d0-d248-4879-bfbd-11eb60775180",
                                                "sense_id": "fbb1fd9f-19dd-3990-b66d-21901fdea226",
                                                "text": "[…]ending his epistle by saying, \"that his uncle having doubtless lent his ear to some old woman's tales and backbiting, he did not choose to place his property in the hands of a spendthrift,[…]"
                                            },
                                            {
                                                "example_id": "c315d095-3b0b-4f0c-ba66-f7ebe72ca3b2",
                                                "sense_id": "fbb1fd9f-19dd-3990-b66d-21901fdea226",
                                                "text": "She was not given to backbiting—though, when stirred by any motive near to her own belongings, she would say an illnatured word or two."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "backbiting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d503c713-ee1c-3267-8fdc-69f810ad9005",
                                        "entry_id": "62687f80-2ead-3c20-bd31-098405a1e080",
                                        "glosses": [
                                            "Slanderous or speaking badly, especially of a person without that person's knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6bee53f-df0a-4c02-8a53-07d2956c383d",
                                                "sense_id": "d503c713-ee1c-3267-8fdc-69f810ad9005",
                                                "text": "Backbiting talk that flattering blabs know wily how to blenge."
                                            },
                                            {
                                                "example_id": "2910688e-aca8-4624-b3e9-ec5ac208d3de",
                                                "sense_id": "d503c713-ee1c-3267-8fdc-69f810ad9005",
                                                "text": "Am I to have a backbiting wife?"
                                            },
                                            {
                                                "example_id": "7a8ece90-5cde-4af7-8d1e-9b6c58752b55",
                                                "sense_id": "d503c713-ee1c-3267-8fdc-69f810ad9005",
                                                "text": "If the world’s premier A.I. start-up can so easily plunge into crisis over backbiting behavior and slippery ideas of wrongdoing, can it be trusted to advance a technology that may have untold effects on billions of people?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "backbiting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae1b9d9-da5f-3085-89e2-6f4fdf98e39e",
                                        "entry_id": "a25bd60e-2ef3-374f-9202-28672e3ce255",
                                        "glosses": [
                                            "present participle and gerund of backbite"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6aa87c1-a64f-4c49-b758-0ed1d8a06cb5",
                        "source_entry_id": "9adedf22-fa6e-358b-b532-a80ecc19023f",
                        "source_sense_id": "c6baca1c-ec9f-346b-b2bf-f2cd9e23e8fc",
                        "target_lang_word": "scandal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scandal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "An incident or event that disgraces or damages the reputation of the persons or organization involved."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274ba692-01de-4470-b257-ba39a53d74de",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "Their affair was reported as a scandal by most tabloids."
                                            },
                                            {
                                                "example_id": "8cf00712-04b3-435b-bc2a-6b33c5e56577",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "O, what a scandal is it to our crown,\nThat two such noble peers as ye should jar!"
                                            },
                                            {
                                                "example_id": "845c00c4-2b7b-4728-ba42-4f81acb6c7a4",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "It would not be fair to record the adventures of Father Brown, without admitting that he was once involved in a grave scandal."
                                            },
                                            {
                                                "example_id": "7ca07f09-7446-4272-8381-acb838acf817",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "Well, yes, a couple of leaks are all very well, but it takes more than that... A big scandal perhaps. A political scandal. Or a scandal about something people really understand: Sex... or money."
                                            },
                                            {
                                                "example_id": "64c1dcd4-05f4-4803-b1e0-0db7dd91ad3d",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b20a9f3e-5e22-3ca1-9f62-884ddb9d49ce",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "Damage to one's reputation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30874845-4468-4ac5-aaf6-3a0e7a0b5426",
                                                "sense_id": "b20a9f3e-5e22-3ca1-9f62-884ddb9d49ce",
                                                "text": "The incident brought considerable scandal to his family."
                                            },
                                            {
                                                "example_id": "f157e648-d86d-48e6-b9cb-f5c3cfe1b53b",
                                                "sense_id": "b20a9f3e-5e22-3ca1-9f62-884ddb9d49ce",
                                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability:[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ebebfd-b32e-3d0a-8d00-b14970f096db",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "Widespread moral outrage, indignation, as over an offence to decency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09724c20-3fa7-4e60-ae88-791046a1bfad",
                                                "sense_id": "53ebebfd-b32e-3d0a-8d00-b14970f096db",
                                                "text": "When their behaviour was made public it caused a great scandal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74f151b-7c8d-31c2-8df1-b544f2f7c7a1",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "A word or deed, lacking in rectitude in some manner, which is an occasion of the spiritual ruin of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e9833eb-9300-3364-9f95-e79dd5cf0bdd",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "Defamatory talk; gossip, slander."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "003be142-8906-4127-a914-00fcda7ab9ce",
                                                "sense_id": "9e9833eb-9300-3364-9f95-e79dd5cf0bdd",
                                                "text": "According to village scandal, they weren't even married."
                                            },
                                            {
                                                "example_id": "b763f554-49e1-4c30-bf31-3e3dda321383",
                                                "sense_id": "9e9833eb-9300-3364-9f95-e79dd5cf0bdd",
                                                "text": "Scandal at Barchester affirmed that had it not been for the beauty of his daughter, Mr. Harding would have remained a minor canon; but here probably Scandal lied, as she so often does; for even as a minor canon no one had been more popular among his reverend brethren in the close, than Mr. Harding; and Scandal, before she had reprobated Mr. Harding for being made precentor by his friend the bishop, had loudly blamed the bishop for having so long omitted to do something for his friend Mr. Harding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163c547f-4c1c-36aa-9459-c3e2dbabaa97",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "amateur or homemade pornography; (informal) commotion."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scandal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f613fb-0435-34e6-93ac-fe2812f9ff83",
                                        "entry_id": "1a8ac212-a629-3bc9-bc83-0daa529a9600",
                                        "glosses": [
                                            "To defame; to slander."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3c7214-31bd-4f7f-9384-f918ed9babb8",
                                                "sense_id": "e8f613fb-0435-34e6-93ac-fe2812f9ff83",
                                                "text": "I do fawn on men and hug them hard\n And after scandal them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52fcca39-8789-31f2-bab5-9ee12d9c92d6",
                                        "entry_id": "1a8ac212-a629-3bc9-bc83-0daa529a9600",
                                        "glosses": [
                                            "To scandalize; to offend."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc85783-b4f4-4ca4-b49f-f1346ddf6fef",
                                                "sense_id": "52fcca39-8789-31f2-bab5-9ee12d9c92d6",
                                                "text": "A propensity to scandal may partly proceed from an inability to distinguish the proper objects of censure"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cd98003-f2c3-40cb-874c-210e9af5e84e",
                        "source_entry_id": "9adedf22-fa6e-358b-b532-a80ecc19023f",
