                                        "entry_id": "e043eb49-c0bc-35ab-822b-f178def288d2",
                                        "glosses": [
                                            "gegen Fremde nur ablehnend oder direkt feindlich gesinnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "178a930d-59ab-44e2-a948-85f2a90fb651",
                                                "sense_id": "361c609e-6f79-3311-9903-3f8345f36cb5",
                                                "text": "„Die fremdenfeindliche Stimmung im Land entsprang aus der Mitte der Gesellschaft.“"
