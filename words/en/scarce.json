    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a55df43d-1ad8-3832-9e63-3323d88969fd",
                    "sense_definition": "Uncommon, rare, or difficult to find; not enough to meet a demand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "availability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the long drought, fresh water became extremely <w>scarce</w> in the rural villages.",
                            "target_lang_translations": {
                                "ru": "Во время долгой засухи пресная вода в сельских деревнях стала крайне <w>дефицитной</w>."
                            }
                        },
                        {
                            "text": "Good jobs are <w>scarce</w> in this small town, so many young people move to the city.",
                            "target_lang_translations": {
                                "ru": "Хорошие рабочие места в этом маленьком городке — <w>редкость</w>, поэтому многие молодые люди уезжают в город."
                            }
                        }
                    ],
                    "synonyms": [
                        "rare",
                        "infrequent",
                        "limited",
                        "insufficient"
                    ],
                    "antonyms": [
                        "abundant",
                        "plentiful"
                    ],
                    "common_phrases": [
                        "become scarce",
                        "increasingly scarce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Редкий, дефицитный или труднодоступный; недостаточно для удовлетворения спроса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефицитный",
                                "target_lang_sense_clarification": "о товарах или ресурсах"
                            },
                            {
                                "target_lang_word": "редкий",
                                "target_lang_sense_clarification": "встречающийся нечасто"
                            },
                            {
                                "target_lang_word": "недостаточный",
                                "target_lang_sense_clarification": "в малом количестве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d781389-61aa-3934-80a6-854e18e50679",
                    "sense_definition": "Scantily supplied or deficient in something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "availability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expedition struggled because they were in a region <w>scarce</w> of prey and clean water.",
                            "target_lang_translations": {
                                "ru": "Экспедиция столкнулась с трудностями, так как они находились в регионе со <w>скудными</w> запасами дичи и чистой воды."
                            }
                        },
                        {
                            "text": "The project failed primarily due to the <w>scarce</w> resources available in the national market.",
                            "target_lang_translations": {
                                "ru": "Проект провалился прежде всего из-за <w>ограниченных</w> ресурсов, доступных на национальном рынке."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "rich",
                        "replete"
                    ],
                    "common_phrases": [
                        "scarce of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скудно снабженный или испытывающий недостаток в чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скудный",
                                "target_lang_sense_clarification": "о ресурсах или запасах"
                            },
                            {
                                "target_lang_word": "ограниченный",
                                "target_lang_sense_clarification": "о возможностях или средствах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "aaeab549-a7b2-30be-9204-ee240f0d53bb",
                    "sense_definition": "Only just; barely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind was so light that I <w>scarce</w> felt it against my face as I walked.",
                            "target_lang_translations": {
                                "ru": "Ветер был таким легким, что я <w>едва</w> чувствовал его на своем лице во время прогулки."
                            }
                        },
                        {
                            "text": "He <w>scarce</w> could reach her hand from his position on the horse.",
                            "target_lang_translations": {
                                "ru": "Он <w>едва</w> мог дотянуться до ее руки, сидя на лошади."
                            }
