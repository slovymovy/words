                ],
                "senses": [
                    {
                        "sense_id": "4c8b9e35-70a5-3305-86e0-180663e24d8f",
                        "entry_id": "41dc6e66-688c-30eb-bb5e-7b3906ef8b0e",
                        "glosses": [
                            "To marry a member of another group, social stratum, or religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b52893-8378-4ead-9991-e47114c2dfe6",
                                "sense_id": "4c8b9e35-70a5-3305-86e0-180663e24d8f",
                                "text": "Mary was Catholic and Ron was Jewish, but they decided that it was acceptable to intermarry."
                            },
                            {
                                "example_id": "4c586d8b-cc91-4c71-9ad7-2bf4a50e5730",
                                "sense_id": "4c8b9e35-70a5-3305-86e0-180663e24d8f",
                                "text": "The state where most intermarriages took place was Hawaii, where more than four in 10 newlyweds (42.4%) were intermarried."
                            }
                        ]
                    },
                    {
                        "sense_id": "0eb9071c-94a8-3295-b419-68193e13f6d7",
                        "entry_id": "41dc6e66-688c-30eb-bb5e-7b3906ef8b0e",
                        "glosses": [
                            "To marry within the same ethnic, social, or family group."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95524952-a62b-4789-aeea-ba4add40b42e",
                                "sense_id": "0eb9071c-94a8-3295-b419-68193e13f6d7",
                                "text": "Mainland China and Taiwan do not border each other by land; they face each other across a 140-km-wide ocean strait. Taiwan-held Dadan Island sits 2 km away from Xiamen. Xiamenese can use binoculars to observe their kinfolk on Dadan Island, with whom they have traditionally intermarried (Mellor, 1993)."
                            },
                            {
                                "example_id": "3b0f12d9-39c1-4597-8542-2e61d2d9dbb0",
                                "sense_id": "0eb9071c-94a8-3295-b419-68193e13f6d7",
                                "text": "Did European royals sometimes intermarry? Yes. There are a couple of examples of that. The Habsburgs are not beating the allegations."
                            }
                        ]
                    }
                ],
