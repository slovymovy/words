                "senses": [
                    {
                        "sense_id": "4705b38d-e94b-3b48-a4d1-cabc07e5f278",
                        "entry_id": "e3d7cdd8-d2ae-34b3-83c5-90b5db4b7071",
                        "glosses": [
                            "Ajouter un additif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c3ee70-c3a2-4f46-92b5-0bde8899c5cf",
                                "sense_id": "4705b38d-e94b-3b48-a4d1-cabc07e5f278",
                                "text": "L’interdiction des composés organiques du plomb a conduit à additiver les carburants avec de nouvelles molécules pour maintenir l’indice d’octane : MTBE (MéthylTertButylÉther) et ETBE (ÉthylTertButylÉther)."
                            },
                            {
                                "example_id": "dd684019-1590-49b2-b6b0-d3e807e88df6",
                                "sense_id": "4705b38d-e94b-3b48-a4d1-cabc07e5f278",
                                "text": "Il faut toutefois signaler que, dans les cas de compression de produits comme le butadiène chloré ou le chlorure de vinyle, des actions catalytiques de dégradation des polyglycols sont connus, qui obligent à additiver la base lubrifiante de façon particulière."
                            }
                        ]
                    }
