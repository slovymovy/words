                                                "sense_id": "e44b0ae9-4e61-3b8e-b3cd-b7ddda3e2e07",
                                                "text": "Im Norden Schwedens leben viele Rentiere."
                                            },
                                            {
                                                "example_id": "efefe25d-d157-4c39-b9c6-32bf258d4aff",
                                                "sense_id": "e44b0ae9-4e61-3b8e-b3cd-b7ddda3e2e07",
                                                "text": "Seit 2000 sind Dänemark und Schweden über die Öresundbrücke verbunden."
                                            },
                                            {
                                                "example_id": "25b52dd0-efa8-4fec-a98f-a1800cafa635",
                                                "sense_id": "e44b0ae9-4e61-3b8e-b3cd-b7ddda3e2e07",
                                                "text": "Stockholm ist die Hauptstadt von Schweden."
                                            },
                                            {
                                                "example_id": "51761dba-d4b4-4061-8f54-f301425ee433",
                                                "sense_id": "e44b0ae9-4e61-3b8e-b3cd-b7ddda3e2e07",
                                                "text": "„Der Sohn einer Indianerin und eines irischen Schmiedes trat in Schweden noch unter seinem ursprünglichen Namen Wa Tho Huck an.“"
                                            }
