                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5820583-4878-35d1-aee5-55c479139b84",
                        "entry_id": "f3314bef-dd6f-355a-a96e-94b2ed6cced7",
                        "glosses": [
                            "A village north of Perth in Scotland; the coronation site of Scottish kings until 1651"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17a9fa48-0aa8-4cfb-adca-0eabdadc7733",
                                "sense_id": "b5820583-4878-35d1-aee5-55c479139b84",
                                "text": "ROSS: Will you to Scone?\nMACDUFF: No, cousin, I'll to Fife."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cd0e72a4-26a8-311f-9f17-f75925c981ef",
                "word": "scone",
