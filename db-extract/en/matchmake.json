                    },
                    {
                        "translation_id": "cf1b8574-f36c-404a-8d9d-6e72e3c1bae8",
                        "source_entry_id": "61c4177c-5e93-38f0-b147-217406307cdc",
                        "source_sense_id": "2ecfa8c7-8c6f-35eb-8c78-1d8a3658a52c",
                        "source_sense_description": "to do matchmaking: to set up a date between two people or to arrange a marriage",
                        "target_lang_word": "swatać",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swatać",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "132d2a26-11bd-3dfe-81ae-d8fab443eb92",
                                        "entry_id": "ccba6b5f-9510-3599-8596-311807a64749",
                                        "glosses": [
                                            "pośredniczyć w zaaranżowaniu małżeństwa; namawiać kogoś do poślubienia konkretnej osoby"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87b1b93-7edb-4434-9153-c1b1bca7db33",
                                                "sense_id": "132d2a26-11bd-3dfe-81ae-d8fab443eb92",
                                                "text": "Babcia swatała swoją wnuczkę z doktorem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac155381-e347-4487-b48e-bdec0fcadc48",
                        "source_entry_id": "61c4177c-5e93-38f0-b147-217406307cdc",
                        "source_sense_id": "2ecfa8c7-8c6f-35eb-8c78-1d8a3658a52c",
                        "source_sense_description": "to do matchmaking: to set up a date between two people or to arrange a marriage",
                        "target_lang_word": "сва́тать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сва́тать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7fee968c-42f8-31e9-8c62-a15f944c8e93",
                                        "entry_id": "c02538a0-5e21-39a9-8fd3-5f49d6e4d22a",
                                        "glosses": [
                                            "предлагать кого-либо в мужья или в жёны; хлопотать о чьей-либо женитьбе, чьем-либо замужестве"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e1a826-c8b8-4983-a5fe-b09ba38ef62e",
                                                "sense_id": "7fee968c-42f8-31e9-8c62-a15f944c8e93",
                                                "text": "— Кого же ты сватаешь? — Кого угодно, сударь: купцов, чиновников и даже бар."
                                            },
                                            {
                                                "example_id": "d9f2ec0a-5661-49ad-9260-a2e05a14a46c",
                                                "sense_id": "7fee968c-42f8-31e9-8c62-a15f944c8e93",
                                                "text": "— Девушка на выданьи, а каков сват, таков и жених, — дай бог любовь да совет, а чести много. За кого же царь её сватает?"
                                            },
                                            {
                                                "example_id": "00d46333-83ec-4880-8326-62dc6a65d72b",
                                                "sense_id": "7fee968c-42f8-31e9-8c62-a15f944c8e93",
                                                "text": "— Я, может быть, вместо вояжа-то женюсь; мне невесту сватают."
                                            },
                                            {
                                                "example_id": "24bd8902-352b-48a6-a848-c131932d19e2",
                                                "sense_id": "7fee968c-42f8-31e9-8c62-a15f944c8e93",
                                                "text": "Ну, начинаю я его сватать; отягощаюсь, хожу, выискала ему невесту из купечества ― дом свой на Песках, и девушка порядочная, полная, румяная〈…〉"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c0a0ec0-2df6-3d13-98fa-8e63936cd78f",
                                        "entry_id": "c02538a0-5e21-39a9-8fd3-5f49d6e4d22a",
                                        "glosses": [
                                            "просить согласия на брак с кем-либо (у невесты или её родителей, родственников)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f28e2d5-5845-480d-829d-11f46dc709c4",
                                                "sense_id": "1c0a0ec0-2df6-3d13-98fa-8e63936cd78f",
                                                "text": "Он окрестится в русскую веру… будет сватать её… отец спросит: люб ли тебе Антон? Люб мне, как свет божий, скажет она."
                                            },
                                            {
                                                "example_id": "27ce38bc-af57-4ecd-aa70-c66aaaec1fea",
                                                "sense_id": "1c0a0ec0-2df6-3d13-98fa-8e63936cd78f",
                                                "text": "Он сватал у Филиппа сестру Лимпиаду и, подвыпивши, бахвалился своей мошной."
                                            },
                                            {
                                                "example_id": "715f0dfc-da88-4141-917b-413759b1fbed",
                                                "sense_id": "1c0a0ec0-2df6-3d13-98fa-8e63936cd78f",
                                                "text": "— Я не шучу. Ты скажи, пойдёшь ли? — Отчего же не пойти, коли батюшка отдаст? 〈…〉 Завтра я скажу твоей матери и отцу, сватать приду."
                                            },
                                            {
                                                "example_id": "da2bac81-a8dd-4b3f-920e-89c95038aa38",
                                                "sense_id": "1c0a0ec0-2df6-3d13-98fa-8e63936cd78f",
                                                "text": "— Мы, девка, сватать тебя пришли. Эллочка от неожиданности приоткрыла рот. — Как?.. — Ну как сватают! Сын вон у меня, — Егор кивнул в сторону Степана, — хочет, чтобы ты за него выходила."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "620569d9-c504-3f34-83ac-261742a30bb4",
                                        "entry_id": "c02538a0-5e21-39a9-8fd3-5f49d6e4d22a",
                                        "glosses": [
                                            "перен., разг. усиленно предлагать кого-либо, что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848e3481-29ec-418e-aee6-e788ae93d056",
                                                "sense_id": "620569d9-c504-3f34-83ac-261742a30bb4",
                                                "text": "Сначала Райкконена сватали в «Феррари», с которой «Заубер» тесно связан контрактными обязательствами на поставку двигателей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
