                "senses": [
                    {
                        "sense_id": "823c663a-0bcb-3a93-bfa2-d36e8e160507",
                        "entry_id": "db74fcaa-cf1f-3680-9d67-92e1758877f7",
                        "glosses": [
                            "im Freien stehendes Kreuz um Wettersegen zu erbitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f83c80-b9a2-4498-8bcd-1b3709da3977",
                                "sense_id": "823c663a-0bcb-3a93-bfa2-d36e8e160507",
                                "text": "„Am Wetterkreuz (597 m) finden Sie zwar eine Bank, leider kann die Aussicht durch Büsche - je nach Beschnitt - deutlich eingeschränkt sein.“"
                            },
                            {
                                "example_id": "55be81b7-ecb2-4e2e-b3c4-9a315600278b",
                                "sense_id": "823c663a-0bcb-3a93-bfa2-d36e8e160507",
                                "text": "„Beeindruckend ist die Rundsicht am Wetterkreuz: in der Nachbarschaft der Acherkogel, unten in der Waldsenke der Piburger See und Sautens.“"
                            },
                            {
                                "example_id": "e8f3fabf-7308-4bdc-b4d7-116e97f5dec8",
                                "sense_id": "823c663a-0bcb-3a93-bfa2-d36e8e160507",
                                "text": "„Statt auf dem selben Weg zurückzukehren, nimmt man nach einer kurzen Rast unter dem Wetterkreuz den Th.-Streich-Weg (AV149) in nördlicher Richtung zur Bielefelder Hütte (2.112 m).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
