                "senses": [
                    {
                        "sense_id": "17c1d7aa-e195-381a-8448-adea9e1240b0",
                        "entry_id": "257c07fa-324e-3f74-b5a2-ce84ba8633bd",
                        "glosses": [
                            "Trouble de la parole qui se caractérise par la répétition ou l'allongement involontaire de sons, de syllabes ou de mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3954fc5-240a-4236-850b-38be98bde10c",
                                "sense_id": "17c1d7aa-e195-381a-8448-adea9e1240b0",
                                "text": "La dysphémie tient, dans d'autres cas, à un trouble de la faculté du langage articulé ou de la coordination des mouvements nécessaires à la parole."
                            },
                            {
                                "example_id": "302a5f20-d956-4e5a-8a01-0db41b767f76",
                                "sense_id": "17c1d7aa-e195-381a-8448-adea9e1240b0",
                                "text": "À proprement parler, la dysphémie est le trouble sous-jacent au bégaiement, bien que dans la littérature scientifique et générale, les deux termes soient souvent utilisés indistinctement."
                            },
                            {
                                "example_id": "11168c54-3cee-453a-ae95-7a9f28162d20",
                                "sense_id": "17c1d7aa-e195-381a-8448-adea9e1240b0",
                                "text": "Les dysphémies se définissent comme des altérations du langage qui sont caractérisées par de spasmes à répétition dus à une mauvaise coordination de l’idéomotricité cérébrale. Un exemple de dysphémie est le bégaiement, que nous avons déjà mentionné."
                            }
                        ]
                    }
                ],
