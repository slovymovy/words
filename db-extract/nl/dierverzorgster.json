                        "examples": [
                            {
                                "example_id": "72a4f8a8-9b8b-457e-acb1-2502b33cb8d3",
                                "sense_id": "3e0f9673-bd7e-31d5-bcde-a3932af387c7",
                                "text": "De Britse dierverzorgster die gistermiddag door een tijger werd aangevallen is aan haar verwondingen overleden. De 24-jarige Sarah McClay werd aangevallen toen ze aan het het werk was in het verblijf van het dier."
                            },
                            {
                                "example_id": "30dd55b9-0e98-46b7-868e-7374d1851909",
                                "sense_id": "3e0f9673-bd7e-31d5-bcde-a3932af387c7",
                                "text": "In een dierentuin in Zweden is een dierverzorgster om het leven gekomen toen ze werd aangevallen door wolven. Dat gebeurde in Kolmarden Zoo, de grootste dierentuin van het land op zo'n 140 kilometer van Stockholm."
                            }
                        ]
                    }
