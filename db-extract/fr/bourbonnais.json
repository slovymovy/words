                    {
                        "translation_id": "b0c8ced4-3eb6-4dda-829a-b6c31de085cb",
                        "source_entry_id": "1f53a8b4-2150-38b3-b7fe-022caae93810",
                        "source_sense_id": "2064de58-cd0a-31f7-ac43-632d2f916ca3",
