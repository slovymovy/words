                "senses": [
                    {
                        "sense_id": "08b929ad-09b2-3a3e-84cc-6c65945b0db4",
                        "entry_id": "311b6364-0d23-3cab-8c05-99f390965f9c",
                        "glosses": [
                            "A Central and Eastern European coffee cake flavored with orange rind, rum, almonds, and raisins; or with some single flavoring, e.g. chocolate, lemon, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac17e49-f787-4f29-b6da-c04334ef1e65",
                                "sense_id": "08b929ad-09b2-3a3e-84cc-6c65945b0db4",
                                "text": "A couple of weeks ago, my family and I also travelled an hour or so to sample the babkas and honey croissants at Farro bakery in Bristol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a23a492-a513-4b84-943a-aa42943fc013",
                        "source_entry_id": "311b6364-0d23-3cab-8c05-99f390965f9c",
                        "source_sense_id": "08b929ad-09b2-3a3e-84cc-6c65945b0db4",
                        "source_sense_description": "coffee cake",
                        "target_lang_word": "babka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2a4c96e-76fe-30b5-b2e2-82074f64d570",
                                        "entry_id": "3b18ef89-ab58-3a46-a3dc-fcc9a743b244",
                                        "glosses": [
                                            "Brioche légère originaire de l’Europe de l’Est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def2c019-44a5-4457-a07a-2c5efdba2866",
                                                "sense_id": "b2a4c96e-76fe-30b5-b2e2-82074f64d570",
                                                "text": "C’est le même babka au chocolat que tu avais fait pour le Nouvel An ?"
                                            },
                                            {
                                                "example_id": "9476c3ca-b9e0-44bc-aa85-6fe7f01d9d3b",
                                                "sense_id": "b2a4c96e-76fe-30b5-b2e2-82074f64d570",
                                                "text": "Attendre 10 min, puis placer la babka dans le four éteint pendant 1 h 30."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24bc287b-af99-4e74-b101-fbf51ee3224e",
                        "source_entry_id": "311b6364-0d23-3cab-8c05-99f390965f9c",
