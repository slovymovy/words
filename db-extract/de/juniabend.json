                ],
                "senses": [
                    {
                        "sense_id": "cf249c46-3d24-30f1-a86f-64dfe14d7164",
                        "entry_id": "2a15e141-9e67-39b8-86d4-67caa1f71970",
                        "glosses": [
                            "Abend im Juni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a549121-4865-4d9f-acb2-cf58846a117a",
                                "sense_id": "cf249c46-3d24-30f1-a86f-64dfe14d7164",
                                "text": "Meta kam an einem Juniabend."
                            },
                            {
                                "example_id": "8ec61591-ae2c-4160-bcaf-50462704c63b",
                                "sense_id": "cf249c46-3d24-30f1-a86f-64dfe14d7164",
                                "text": "„Als Bond and diesem Juniabend in den Salle privée ging, war er von Vertrauen und freudiger Erwartung erfüllt, sodass er eine Million Francs in Chips zu je fünfzigtausend Francs einwechselte und sich an den Rouletttisch Nr. 1 neben den Chef de partie setzte.“"
                            },
                            {
                                "example_id": "bce207b3-6eff-41bb-85a2-5f80e50e9664",
                                "sense_id": "cf249c46-3d24-30f1-a86f-64dfe14d7164",
                                "text": "„Dann stiegen sie wieder ein und fuhren zurück in die Stadt, am Eiffelturm und – wild hupend – an der Wohnung der Familie Joyce vorbei, bevor sie schließlich in die Rue de l'Odéon einbogen, wo die Sonne sich über einem prachtvollen Juniabend herabsenkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
