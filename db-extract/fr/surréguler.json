                "senses": [
                    {
                        "sense_id": "8c61ccf6-5484-3e8a-949f-68d458dcee8e",
                        "entry_id": "f2690444-9d68-3f7f-9ae3-a59831e79e1e",
                        "glosses": [
                            "Réguler de façon excessive, ou de façon supérieure à la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23c9f4a7-e4a2-4ace-ab0d-195e958e3b11",
                                "sense_id": "8c61ccf6-5484-3e8a-949f-68d458dcee8e",
                                "text": "Relayant cette inquiétude, Olli Rehn a reconnu qu'il ne fallait « pas surréguler »."
                            },
                            {
                                "example_id": "264d4e0c-411c-4cd8-b37d-092d4e6b3dda",
                                "sense_id": "8c61ccf6-5484-3e8a-949f-68d458dcee8e",
                                "text": "L'objectif est d'offrir plus de sécurité sans pour autant surréguler."
                            },
                            {
                                "example_id": "4d061016-4ca1-4e80-a0c9-a9d7abb9b28d",
                                "sense_id": "8c61ccf6-5484-3e8a-949f-68d458dcee8e",
                                "text": "Mais le sénateur a aussi mis en garde contre la tentation de vouloir surréguler le marché."
                            }
                        ]
                    }
