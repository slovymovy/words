                                                "sense_id": "2b26b9f5-c951-3cc3-8923-f355c0b0f23c",
                                                "text": "Cette transaction lui a rapporté le quintuple de son investissement."
                                            },
                                            {
                                                "example_id": "73298284-27b6-47be-9f33-52ccf996535a",
                                                "sense_id": "2b26b9f5-c951-3cc3-8923-f355c0b0f23c",
                                                "text": "Rendre le quintuple."
                                            },
                                            {
                                                "example_id": "b89b2a50-d619-4e89-8308-37e118ca45d4",
                                                "sense_id": "2b26b9f5-c951-3cc3-8923-f355c0b0f23c",
                                                "text": "Peut-être que tu n’auras plus envie que je revienne quand je t’aurai dit ce que je sais sur le quintuple meurtre de Varvasena, et donné mon sentiment."
                                            }
                                        ]
