                                                "example_id": "b78b7ab1-7f00-41f2-8f13-346b7093750d",
                                                "sense_id": "b1069598-104e-3f3c-beb0-f73e3bc76ded",
                                                "text": "Конная железная дорога."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa31a69b-4795-3f9c-b4f4-9cf4dcf4b840",
                                        "entry_id": "04e0e7ef-158a-3dbf-874e-1d9f68f9bd25",
                                        "glosses": [
                                            "связанный с ездой на лошадях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7477282-6657-4462-92f9-126e893025ea",
                                                "sense_id": "fa31a69b-4795-3f9c-b4f4-9cf4dcf4b840",
                                                "text": "Дерсу остановился и сказал, что тропа эта не конная, а пешеходная."
