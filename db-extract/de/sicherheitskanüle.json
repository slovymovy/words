                        "glosses": [
                            "spezielle Injektionsnadel, die eine mögliche Verletzung durch den Nadelstich verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85969b9a-7900-4ad2-8e76-dc8b43a24e31",
                                "sense_id": "1626f904-049f-381b-9d1e-d9c3c1879623",
                                "text": "Die Blutabnahme erfolgt mithilfe einer Sicherheitskanüle."
                            },
                            {
                                "example_id": "4b213bd6-6181-4824-8836-a1a23eb69947",
                                "sense_id": "1626f904-049f-381b-9d1e-d9c3c1879623",
                                "text": "„Auf dem Markt setzen sich Sicherheitskanülen (Venenverweilkanülen), Nadelschutz für Blutentnahmekanülen und Sicherheitsspritzen immer mehr durch. Diese schließen Nadelstichverletzungen nach der Punktion aus […]“"
                            },
                            {
                                "example_id": "4b756320-3750-47f4-9453-6f20174faf2d",
                                "sense_id": "1626f904-049f-381b-9d1e-d9c3c1879623",
                                "text": "„Aus hygienischen Gründen ist der Gebrauch von Handschuhen und durchstichsicheren Abwurfgefäßen – auch für Sicherheitskanülen – obligat.“"
                            }
                        ],
