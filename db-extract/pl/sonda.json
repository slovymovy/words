                                                "example_id": "a1f51288-0240-437d-8cd1-3a0f9ef0feb5",
                                                "sense_id": "e6ef49d4-ef68-385a-980a-2bad489f54ce",
                                                "text": "„Der Kasten mit den chirurgischen Instrumenten stand mitten auf dem Schreibtisch, in einer Ecke lagen Sonden in einem Becken, und die Abbildung eines Muskelmannes hing an der Wand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
