                        "sense_id": "b4e4185d-f4e8-347e-a4e8-c3e7fb371a06",
                        "entry_id": "63220572-5b5c-3ea5-b430-ef543a7f38a9",
                        "glosses": [
                            "lijst van bezittingen, inkomsten, bedragen e.d."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45286593-784e-489c-986f-38b99899d77d",
                                "sense_id": "b4e4185d-f4e8-347e-a4e8-c3e7fb371a06",
                                "text": "Mijn petekind van 11 kreeg onlangs Compagnie des Alpes cadeau. Hij trok aanvankelijk zijn neus op toen ik hem een borderel gaf (weliswaar met enkele kleurrijke foto's) in plaats van een videogame."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c7f127f-77b2-44d5-a826-cf20aaa36cea",
                        "source_entry_id": "63220572-5b5c-3ea5-b430-ef543a7f38a9",
                        "source_sense_id": "b4e4185d-f4e8-347e-a4e8-c3e7fb371a06",
                        "source_sense_description": "lijst van bezittingen, inkomsten, bedragen e.d.",
                        "target_lang_word": "bill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68eb219b-57ed-3b92-b67b-a61d01153d69",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A written list or inventory. (Now obsolete except in specific senses or set phrases; bill of lading, bill of goods, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7c4989a-c9db-3e35-bce7-cc1456d61d11",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A document, originally sealed; a formal statement or official memorandum. (Now obsolete except with certain qualifying words; bill of health, bill of sale etc.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d75da685-a9b9-3fcd-bf48-60909681aa72",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A draft of a law, presented to a legislature for enactment; a proposed or projected law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5253fdd9-2974-4f24-a7e7-3142512a8e90",
                                                "sense_id": "d75da685-a9b9-3fcd-bf48-60909681aa72",
                                                "text": "Mr. Speaker, on behalf of the Prime Minister, I beg to introduce a bill entitled[…]"
                                            },
                                            {
                                                "example_id": "cd19270b-7be6-486c-90a3-14333725212d",
                                                "sense_id": "d75da685-a9b9-3fcd-bf48-60909681aa72",
                                                "text": "Why, I'll exhibit a bill in the parliament for the putting down of men."
                                            },
                                            {
                                                "example_id": "969e0d41-9f41-4324-9d3d-c7c02465f947",
                                                "sense_id": "d75da685-a9b9-3fcd-bf48-60909681aa72",
                                                "text": "David Cameron insists that his latest communications data bill is “vital to counter terrorism”. Yet terror is mayhem. It is no threat to freedom. That threat is from counter-terror, from ministers capitulating to securocrats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b6567c-0984-3d1a-959d-eadb36a0d44d",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A declaration made in writing, stating some wrong the complainant has suffered from the defendant, or a fault committed by some person against a law."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8abda0b6-469f-4874-afdf-108f39652475",
                                                "sense_id": "69b6567c-0984-3d1a-959d-eadb36a0d44d",
                                                "text": "... the legion of bills in the suit have been transformed into mere bills of mortality ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "026597b6-4b19-38fd-9bbe-f30a6fb2b11b",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A piece of paper money; a banknote."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e37dcca-ccf1-4c4a-bade-e0deb17d3eb0",
                                                "sense_id": "026597b6-4b19-38fd-9bbe-f30a6fb2b11b",
                                                "text": "He gave the change for a three dollar bill. Upon examination, the bill proved to be counterfeit."
                                            },
                                            {
                                                "example_id": "7d1ef4bb-5c83-4132-869e-24efe1bee2a1",
                                                "sense_id": "026597b6-4b19-38fd-9bbe-f30a6fb2b11b",
                                                "text": "[…]So I wropped 'em up in a five dollar bill and tied 'em up and sent 'em, and they ain't back yet.”"
                                            },
                                            {
                                                "example_id": "d7f080d2-29bb-4d1e-88e1-833379134906",
                                                "sense_id": "026597b6-4b19-38fd-9bbe-f30a6fb2b11b",
                                                "text": "I ran into the Devil, babe, he loaned me 20 bills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "724cc889-1a25-3089-bafc-046cbfaaf401",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A piece of paper money; a banknote.",
                                            "One hundred dollars."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00dc4cec-47b9-4cbe-a3a8-e058f28981c9",
                                                "sense_id": "724cc889-1a25-3089-bafc-046cbfaaf401",
                                                "text": "There was no excuse, simply no excuse for not making four or five bills a week. A little initiative, that's all."
                                            },
                                            {
                                                "example_id": "3febe668-91ae-4847-aef2-b356775feb21",
                                                "sense_id": "724cc889-1a25-3089-bafc-046cbfaaf401",
                                                "text": "All we got from her was Stranahan's location, and barely that. A house in the bay, she said. A house with a windmill. Easiest five bills that woman ever made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb8b8d8d-4e14-350a-9526-0a258ee7cfef",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "One hundred pounds sterling."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0edcee2b-aabc-43b2-bd78-7c87fbb7a390",
                                                "sense_id": "bb8b8d8d-4e14-350a-9526-0a258ee7cfef",
                                                "text": "In the conversation Henshall says he \"struggling to find people to go up the roads\" explaining how it would be \"no good for black people\" and how they need a \"young white boy to go up there\".\nStock agrees, saying how he knows \"this kid\" who \"owes me 12 bills\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ced1a47-e704-3fc4-907c-7a9419da2f6d",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A written note of goods sold, services rendered, or work done, with the price or charge; an invoice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a31424-871e-47f8-add7-77b701f6222c",
                                                "sense_id": "6ced1a47-e704-3fc4-907c-7a9419da2f6d",
                                                "text": "He received a bill of £9 for the groceries."
                                            },
                                            {
                                                "example_id": "eb6d076c-0669-4f1f-a9e1-6a5c9c8cb1c5",
                                                "sense_id": "6ced1a47-e704-3fc4-907c-7a9419da2f6d",
                                                "text": "My lord, here is my bill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e845e76-f509-3447-995e-933d773efc6b",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A paper, written or printed, and posted up or given away, to advertise something, as a lecture, a play, or the sale of goods"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559f3158-1d59-445d-bb64-a5791662a925",
                                                "sense_id": "2e845e76-f509-3447-995e-933d773efc6b",
                                                "text": "In the meantime I will draw a bill of properties, such as our play wants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bd165a3-ddfb-3d8d-80b1-243f7c38e793",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A writing that binds the signer or signers to pay a certain sum at a future day or on demand, with or without interest, as may be stated in the document; a bill of exchange. In the United States, it is usually called a note, a note of hand, or a promissory note."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd381c5-9594-4f0e-bbdc-de7c938b3627",
                                                "sense_id": "6bd165a3-ddfb-3d8d-80b1-243f7c38e793",
                                                "text": "Ay, and Rato-lorum too; and a gentleman born, Master Parson; who writes himself Armigero, in any bill, warrant, quittance, or obligation, Armigero."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c4e0f6-cdd5-3835-b8c5-cb30062cd70d",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A set of items presented together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec341b0-ac91-46a7-89cb-c6055dbf6b25",
                                                "sense_id": "60c4e0f6-cdd5-3835-b8c5-cb30062cd70d",
                                                "text": "Meanwhile, the bills on the main stages skewed towards mainstream pop, with mixed results. Lorde’s Friday evening Other stage appearance was one of the weekend’s highlights. The staging and choreography were fantastic – a giant glass tank on a hydraulic platform, in and around which a troupe of dancers acted out the highs and lows of a teenage party"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e20124-43aa-3820-9181-3aee70578987",
                                        "entry_id": "c751e7d3-06fb-32b1-a643-9801cec2830c",
                                        "glosses": [
                                            "A list of pupils to be disciplined for breaking school rules."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61b5aad9-14cf-4d4d-abb0-7dec75debfa7",
                                                "sense_id": "38e20124-43aa-3820-9181-3aee70578987",
                                                "text": "One of the best stories of the period describes the misadventure of a batch of candidates for confirmation whose names were by accident sent up to the Head-Master on a piece of paper identical in size and shape with the \"bill\" used by the Masters for the purpose of reporting delinquents. Keate, we are told, insisted on flogging all the boys mentioned in the document […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52eda12b-c16e-3ffd-aad8-48451439117f",
                                        "entry_id": "aae49a3a-f307-38f9-a448-b51d5665ac11",
                                        "glosses": [
                                            "To advertise by a bill or public notice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a65f51c7-a337-4d16-b892-5db8ca8d9326",
                                                "sense_id": "52eda12b-c16e-3ffd-aad8-48451439117f",
                                                "text": "[...] it will be recalled that in 1960 they were billed as the long-distance express multiple-units of the future, [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8fb764c-fdb4-3a97-909e-5afb6868488f",
                                        "entry_id": "aae49a3a-f307-38f9-a448-b51d5665ac11",
                                        "glosses": [
                                            "To charge; to send a bill to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb222aa-13c1-49d2-aff2-68449d3b88a9",
                                                "sense_id": "e8fb764c-fdb4-3a97-909e-5afb6868488f",
                                                "text": "The physician explains that this is an option for her and that she can sign the facility's ABN so that if Medicare denies the claim, the facility can bill her for the scan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53a4f9de-8aad-30cd-b96e-f780993d25d9",
                                        "entry_id": "be57af4a-f1b2-346d-affa-1c946269dd6c",
                                        "glosses": [
                                            "The beak of a bird, especially when small or flattish; sometimes also used with reference to a platypus, turtle, or other animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751c6453-be2e-4287-ba63-274f202c64c0",
                                                "sense_id": "53a4f9de-8aad-30cd-b96e-f780993d25d9",
                                                "text": "The woosel cock so black of hue, With orange-tawny bill, The throstle with his note so true, The wren with little quill[…]"
                                            },
                                            {
                                                "example_id": "ac362354-4690-4487-8d11-050c2cc416d8",
                                                "sense_id": "53a4f9de-8aad-30cd-b96e-f780993d25d9",
                                                "text": "[…] The flesh [of the mistletoe berry] is sticky, and forms strings and ribbons between my thumb and forefinger. For the mistletoe, this viscous goop – and by the way, viscous comes to English from viscum – is crucial. The stickiness means that, after eating the berries, birds often regurgitate the seeds and then wipe their bills on twigs – leading to the seeds' getting glued to the tree, where they can germinate and begin the cycle anew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d545b83-2092-31ca-b4a1-c190fb2e609b",
                                        "entry_id": "be57af4a-f1b2-346d-affa-1c946269dd6c",
                                        "glosses": [
                                            "A beaklike projection, especially a promontory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e9fa628-2d33-4d41-8f3c-a9a23e69b967",
                                                "sense_id": "1d545b83-2092-31ca-b4a1-c190fb2e609b",
                                                "text": "There is a lighthouse on Portland Bill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b539c20d-a296-33a7-b7f3-6db7a4992e82",
                                        "entry_id": "be57af4a-f1b2-346d-affa-1c946269dd6c",
                                        "glosses": [
                                            "Of a cap or hat: the brim or peak, serving as a shade to keep sun off the face and out of the eyes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cfe6971-0e89-328e-95ee-d42736befe75",
                                        "entry_id": "0c1f6bf7-35b8-3ce5-b88d-7045dacb0c8c",
                                        "glosses": [
                                            "to peck"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1f737f2-6c7e-3942-a698-d606c0f1f64c",
                                        "entry_id": "0c1f6bf7-35b8-3ce5-b88d-7045dacb0c8c",
                                        "glosses": [
                                            "to stroke bill against bill, with reference to doves; to caress in fondness"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "074ae130-5399-4db1-827b-2a4ce15122d2",
                                                "sense_id": "a1f737f2-6c7e-3942-a698-d606c0f1f64c",
                                                "text": "As the ox hath his bow, sir, the horse his curb and the falcon her bells, so man hath his desires; and as pigeons bill, so wedlock would be nibbling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60ed1437-956d-350a-9838-53c9e8476a52",
                                        "entry_id": "95f6682b-9848-324f-8cc2-629737ab7a2f",
                                        "glosses": [
                                            "Any of various bladed or pointed hand weapons, originally designating an Anglo-Saxon sword, and later a weapon of infantry, especially in the 14th and 15th centuries, commonly consisting of a broad, heavy, double-edged, hook-shaped blade, with a short pike at the back and another at the top, attached to the end of a long staff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1660d4d-5eac-446e-8cc3-7b13cadc90f2",
                                                "sense_id": "60ed1437-956d-350a-9838-53c9e8476a52",
                                                "text": "At Floddon hyllys, / Our bowys, our byllys / Slew all the floure / Of theyr honoure."
                                            },
                                            {
                                                "example_id": "4fa04a6b-8090-4221-8e69-087c8537e43d",
                                                "sense_id": "60ed1437-956d-350a-9838-53c9e8476a52",
                                                "text": "In the British Museum there is an entry of a warrant, granted to Nicholas Spicer, authorising him to impress smiths for making two thousand Welch bills or glaives."
                                            },
                                            {
                                                "example_id": "dc2e44ae-812a-4ddc-acef-b30f8cf8f681",
                                                "sense_id": "60ed1437-956d-350a-9838-53c9e8476a52",
                                                "text": "France had no infantry that dared to face the English bows and bills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b6bc45-6410-3585-80c7-5296d621415e",
                                        "entry_id": "95f6682b-9848-324f-8cc2-629737ab7a2f",
                                        "glosses": [
                                            "A cutting instrument, with hook-shaped point, and fitted with a handle, used in pruning, etc.; a billhook."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
