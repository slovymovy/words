                                "example_id": "6307a09f-1a87-4423-bfba-29c95aff590b",
                                "sense_id": "8a4367b4-e999-376a-a9f4-8d07f7eac03d",
                                "text": "De gestreste docent was de hele tijd heen en weer aan het lopen."
                            },
                            {
                                "example_id": "47db2b03-0570-46c5-bee2-c2c2024b6dd5",
                                "sense_id": "8a4367b4-e999-376a-a9f4-8d07f7eac03d",
                                "text": "De gestreste varkens beten elkaar"
                            },
                            {
                                "example_id": "e35eec33-3308-48d6-abdc-9c5e243afdc5",
                                "sense_id": "8a4367b4-e999-376a-a9f4-8d07f7eac03d",
                                "text": "Hoe dan ook, het was geweldig om de soms wat knorrige, gestreste kant van me af te kunnen schudden."
                            }
                        ]
                    }
