                                "sense_id": "99670ea5-a6fc-37cf-bdbe-a6d6a7a183b9",
                                "text": "The United States Coast Guard also has furnished the committee with records of depth soundings taken in the North Atlantic in the course of its repatrol work which have their application to the study of the seismic area of the Grand Banks."
                            },
                            {
                                "example_id": "03a66655-09a8-45f2-a820-1f091d567ee7",
                                "sense_id": "99670ea5-a6fc-37cf-bdbe-a6d6a7a183b9",
                                "text": "...medical scheme, travel on appointment and repatrol."
                            },
                            {
                                "example_id": "28f61b2e-5845-42cd-9601-969ae1162d23",
                                "sense_id": "99670ea5-a6fc-37cf-bdbe-a6d6a7a183b9",
                                "text": "... thought it smarter to move them down there and make productive use of that 8-days' transit time that they were spending on a repatrol."
                            }
                        ]
                    }
