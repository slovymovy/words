                "senses": [
                    {
                        "sense_id": "86ea2beb-0790-35ad-a81f-868d43976cd2",
                        "entry_id": "e7285643-e8dc-3b44-8202-93fc37b921b8",
                        "glosses": [
                            "nackt, ohne Kleidung, wie von Gott geschaffen"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "a596de07-7c4f-41de-81e5-882099eea844",
                                "sense_id": "86ea2beb-0790-35ad-a81f-868d43976cd2",
                                "text": "Er stand da in seinem Adamskostüm."
                            },
                            {
                                "example_id": "fac59b84-a6fc-4bc7-a9ee-52abf4bc7f57",
                                "sense_id": "86ea2beb-0790-35ad-a81f-868d43976cd2",
                                "text": "„Gleich am nächsten Tag ließ Requiem die Fotos des Touristen im Adamskostüm in allen Klatschblättern von Stadtland veröffentlichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3de44d60-de8d-403d-a275-4ab5699fca1a",
                        "source_entry_id": "e7285643-e8dc-3b44-8202-93fc37b921b8",
                        "source_sense_id": "86ea2beb-0790-35ad-a81f-868d43976cd2",
                        "source_sense_description": "nackt, ohne Kleidung, wie von Gott geschaffen",
                        "target_lang_word": "birthday suit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birthday suit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54d426e1-630a-3525-a36b-a6c6f43cd694",
                                        "entry_id": "c4d6fc2f-de54-3cfc-b20e-a8e59f40d220",
                                        "glosses": [
                                            "Nakedness, unclothed skin; an exposure of a human's natural anatomy without clothing."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "idiomatic",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70218391-199c-45ca-a499-657937d55b81",
                                                "sense_id": "54d426e1-630a-3525-a36b-a6c6f43cd694",
                                                "text": "George embarrassed his aunt by answering the door in his birthday suit."
                                            },
                                            {
                                                "example_id": "24641b18-bfeb-4eb7-9c8d-912093d5c87c",
                                                "sense_id": "54d426e1-630a-3525-a36b-a6c6f43cd694",
                                                "text": "Nature, the universal tailor, provides for every other animal a birthday suit of clothes which is to outlast his life; but man, though so peculiarly sensitive to the assaults of the elements, is ushered into this nether sphere without any covering, in order that he may be compelled to exert his faculties, and become his own tailor, and thereby his own civilizer."
                                            },
                                            {
                                                "example_id": "5ded5c08-8f1a-4ef1-92de-f555e52b5c80",
                                                "sense_id": "54d426e1-630a-3525-a36b-a6c6f43cd694",
                                                "text": "At last I'm down to the nitty-gritty, my original birthday suit. Where do I put my hands? I need pockets."
                                            },
                                            {
                                                "example_id": "fcb3868c-5317-4f12-9809-267a2b72bdd5",
                                                "sense_id": "54d426e1-630a-3525-a36b-a6c6f43cd694",
                                                "text": "The terms naturalistic and naturalism suffer from the fact that they have a range of meanings, covering a variety of things from the Romantic submission to nature or the collecting of butterflies to the practice of bathing on the beach clad only in one's birthday suit."
                                            },
                                            {
                                                "example_id": "2b2d523a-770b-4319-a074-f803b3f661dc",
                                                "sense_id": "54d426e1-630a-3525-a36b-a6c6f43cd694",
                                                "text": "A person suddenly caught naked by the collapse of a building wall is treated quite differently than a person who intentionally “streaks” a public gathering in his or her birthday suit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f39b3a-897c-394d-b802-884aa2aa0141",
                                        "entry_id": "c4d6fc2f-de54-3cfc-b20e-a8e59f40d220",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see birthday, suit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
