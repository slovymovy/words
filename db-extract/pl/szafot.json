                                                "example_id": "a11de79b-f226-4873-b2da-b9c2391a41df",
                                                "sense_id": "d823583d-5ad9-37a5-89ad-baeafc1cd5bf",
                                                "text": "Louis XVI. starb auf dem Schafott."
                                            },
                                            {
                                                "example_id": "a377da55-0f5a-41cc-83f2-015a14b3c2af",
                                                "sense_id": "d823583d-5ad9-37a5-89ad-baeafc1cd5bf",
                                                "text": "„Das Fenster lag gegenüber der Vorderseite des Schafotts.“"
                                            },
                                            {
                                                "example_id": "3cc2d68a-a11f-4c04-9b64-a64ef4aa7551",
                                                "sense_id": "d823583d-5ad9-37a5-89ad-baeafc1cd5bf",
                                                "text": "„Das tat er übrigens auch, als im Jahre 1793 Ludwig XVI. aufs Schafott geführt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
