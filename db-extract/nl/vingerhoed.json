                                        "entry_id": "ec2aeaa5-4391-32b2-ab47-d0b335707a72",
                                        "glosses": [
                                            "Schutz für den Finger gegen Verletzungen, die im Verlauf des Nähens entstehen könnten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b39ac8-b534-4716-a6d1-b8137bf7b133",
                                                "sense_id": "cb3bac0e-8d94-390b-a4a5-cfb371976eb0",
                                                "text": "Fingerhüte sind heutzutage begehrte Sammlerstücke."
                                            },
                                            {
                                                "example_id": "94562ec6-0755-4cfb-8fee-7298b6d5ae14",
                                                "sense_id": "cb3bac0e-8d94-390b-a4a5-cfb371976eb0",
                                                "text": "„Sarah hatte tatsächlich ebenjenen Silberschmied geheiratet, der unsere Namen in den Fingerhut graviert hatte!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e16d2a7a-9d1c-3d79-a4f9-2e1236f8e9c7",
                                        "entry_id": "ec2aeaa5-4391-32b2-ab47-d0b335707a72",
                                        "glosses": [
                                            "eine Gattung der Familie der Wegerichgewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f69168-8976-440a-ae5e-8baf36a19e89",
                                                "sense_id": "e16d2a7a-9d1c-3d79-a4f9-2e1236f8e9c7",
                                                "text": "Der Fingerhut findet in der Pflanzenheilkunde Verwendung und liefert Herzalkaloide."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d9628cf-3f22-4e38-8c31-0c3c6b3bc9d2",
                        "source_entry_id": "e7e4b9af-5f04-3ed7-a0d9-c8e5407a40fa",
                        "source_sense_id": "8dfeacda-f1ae-304d-a19b-7233975b5313",
                        "source_sense_description": "hard dopje dat het eerste kootje van de vinger beschermt bij het naaien",
                        "target_lang_word": "thimble",
