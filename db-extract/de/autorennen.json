                "senses": [
                    {
                        "sense_id": "afd1f0fe-a8b0-3331-a168-ad3f3ff0e95b",
                        "entry_id": "d7d7b5b5-5f02-3574-a2ef-50f8773daa17",
                        "glosses": [
                            "Wettkampfveranstaltung, an der meistens vierrädrige Fahrzeuge teilnehmen, die möglichst schnell gefahren werden"
                        ],
                        "tags": [
                            "Automobilsport"
                        ],
                        "examples": [
                            {
                                "example_id": "639e0093-355f-43a2-93eb-1e18d4f6b4de",
                                "sense_id": "afd1f0fe-a8b0-3331-a168-ad3f3ff0e95b",
                                "text": "Kommst du mit zum Autorennen?"
                            },
                            {
                                "example_id": "f78e8288-12ce-436f-bfcc-9691e18a483e",
                                "sense_id": "afd1f0fe-a8b0-3331-a168-ad3f3ff0e95b",
                                "text": "Das Autorennen beginnt um 14:00 Uhr."
                            },
                            {
                                "example_id": "2df59f07-2663-45f7-abb1-bccf42dcf1ff",
                                "sense_id": "afd1f0fe-a8b0-3331-a168-ad3f3ff0e95b",
                                "text": "„Bei einem Autorennen verunglückt er tödlich.“"
                            },
                            {
                                "example_id": "c8440e1b-fbd5-4ef7-815f-8c922f2e0f45",
                                "sense_id": "afd1f0fe-a8b0-3331-a168-ad3f3ff0e95b",
                                "text": "„Adam, Miss Runcible, Miles und Archie Schwert fuhren in Archie Schwerts Wagen zu den Autorennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
