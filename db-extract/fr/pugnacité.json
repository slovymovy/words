                "senses": [
                    {
                        "sense_id": "d087ad95-5fdd-3b81-97b2-7ff8f7368ef6",
                        "entry_id": "d19719ee-a44e-32ca-9063-51b2ee885b7f",
                        "glosses": [
                            "Ardeur dans un combat physique, idéologique ou dans la défense d’intérêts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ae61136-17f0-4ace-af77-71f43fd4a00c",
                                "sense_id": "d087ad95-5fdd-3b81-97b2-7ff8f7368ef6",
                                "text": "Les campagnes présidentielles excluant, en principe, qu’on en vienne aux mains et aux poings, surtout devant les indispensables caméras, la pugnacité des candidats est réservée à la lutte d’idées et d’images."
                            },
                            {
                                "example_id": "ef9faf8b-519a-42d5-b255-90c955e964a3",
                                "sense_id": "d087ad95-5fdd-3b81-97b2-7ff8f7368ef6",
                                "text": "Il y a quelque chose d’amusant, sinon d’ouvertement ironique, dans la pugnacité de l’imam marocain Hassan Iquioussen à vouloir rester en France, et éviter par mille contorsions et recours l’expulsion vers le Maroc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a9089f1-da9a-4f89-ba2e-952f35b2a608",
                        "source_entry_id": "d19719ee-a44e-32ca-9063-51b2ee885b7f",
                        "source_sense_id": "d087ad95-5fdd-3b81-97b2-7ff8f7368ef6",
