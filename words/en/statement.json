    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a07ea615-235c-35a3-91ec-598dda922823",
                    "sense_definition": "A formal or clear expression of something in speech or writing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer asked the witness to make a <w>statement</w> about what she saw.",
                            "target_lang_translations": {
                                "ru": "Полицейский попросил свидетеля <w>дать показания</w> о том, что она видела.",
                                "tr": "Polis memuru tanıktan gördükleri hakkında <w>ifade vermesini</w> istedi."
                            }
                        },
                        {
                            "text": "The company issued an official <w>statement</w> regarding the recent changes in management.",
                            "target_lang_translations": {
                                "ru": "Компания выпустила официальное <w>заявление</w> относительно недавних изменений в руководстве.",
                                "tr": "Şirket, yönetimdeki son değişikliklere ilişkin resmi bir <w>açıklama</w> yaptı."
                            }
                        }
                    ],
                    "synonyms": [
                        "declaration",
                        "remark",
                        "expression"
                    ],
                    "common_phrases": [
                        "make a statement",
                        "official statement",
                        "written statement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное или четкое выражение чего-либо в устной или письменной форме.",
                        "tr": "Bir şeyin sözlü veya yazılı olarak resmi veya net bir şekilde ifade edilmesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "официальное сообщение"
                            },
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "высказывание, доказывающее что-либо"
                            },
                            {
                                "target_lang_word": "показание",
                                "target_lang_sense_clarification": "свидетельское в полиции"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "açıklama",
                                "target_lang_sense_clarification": "resmi veya genel duyuru"
                            },
                            {
                                "target_lang_word": "ifade",
                                "target_lang_sense_clarification": "polise veya mahkemeye verilen sözlü/yazılı beyan"
                            },
                            {
                                "target_lang_word": "demeç",
                                "target_lang_sense_clarification": "basına yapılan resmi açıklama"
                            },
                            {
                                "target_lang_word": "beyan",
                                "target_lang_sense_clarification": "resmi bildirim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1702345d-229d-3cc3-b5b2-042a3161ee60",
                    "sense_definition": "A document that summarizes financial activity over a specific period.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to check my bank <w>statement</w> to see if the payment was processed.",
                            "target_lang_translations": {
                                "ru": "Мне нужно проверить банковскую <w>выписку</w>, чтобы посмотреть, прошел ли платеж.",
                                "tr": "Ödemenin işleme alınıp alınmadığını görmek için banka <w>ekstremi</w> kontrol etmem gerekiyor."
                            }
                        },
                        {
                            "text": "You will receive a monthly bank <w>statement</w> showing all your recent transactions.",
                            "target_lang_translations": {
                                "ru": "Вы будете получать ежемесячную банковскую <w>выписку</w> со всеми вашими последними операциями.",
                                "tr": "Son zamanlardaki tüm işlemlerinizi gösteren aylık bir banka <w>hesap özeti</w> alacaksınız."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bank statement",
                        "monthly statement",
                        "financial statement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ, обобщающий финансовую деятельность за определенный период.",
                        "tr": "Belirli bir dönemdeki finansal hareketleri özetleyen belge."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выписка",
                                "target_lang_sense_clarification": "банковская"
                            },
                            {
                                "target_lang_word": "отчёт",
                                "target_lang_sense_clarification": "финансовый документ"
                            },
                            {
                                "target_lang_word": "ведомость",
                                "target_lang_sense_clarification": "перечень операций"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ekstre",
                                "target_lang_sense_clarification": "hesap özeti"
                            },
                            {
                                "target_lang_word": "hesap özeti",
                                "target_lang_sense_clarification": "banka veya kredi kartı hareketleri dökümü"
                            },
                            {
                                "target_lang_word": "dekont",
                                "target_lang_sense_clarification": "işlem belgesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "908db46d-d02c-3b93-aeb3-cc720574c71d",
                    "sense_definition": "A presentation of a particular opinion, position, or style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist's work is a powerful <w>statement</w> against social injustice.",
                            "target_lang_translations": {
                                "ru": "Работа художника — это мощное <w>высказывание</w> против социальной несправедливости.",
                                "tr": "Sanatçının eseri, toplumsal adaletsizliğe karşı güçlü bir <w>duruştur</w>."
                            }
                        },
                        {
                            "text": "Wearing such a bright color was a bold fashion <w>statement</w> for the gala.",
                            "target_lang_translations": {
                                "ru": "Выбор такого яркого цвета был смелым <w>заявлением</w> о стиле для торжественного вечера.",
                                "tr": "Gala için bu kadar canlı bir renk giymek cesur bir <w>tarz gösterisiydi</w>."
                            }
                        }
