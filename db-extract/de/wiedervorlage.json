                "senses": [
                    {
                        "sense_id": "3a868101-3147-3141-b50d-dffbb9b1cadf",
                        "entry_id": "68c48ab5-af98-3c2b-8311-4f548d947bdd",
                        "glosses": [
                            "Handlung, einen Vorgang in schriftlicher Form, der zunächst beiseitegelegt wurde, erneut zu präsentieren/vorzulegen"
                        ],
                        "tags": [
                            "Amtsdeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "a9f0149d-46a6-4723-bc7c-b5e489d7e465",
                                "sense_id": "3a868101-3147-3141-b50d-dffbb9b1cadf",
                                "text": "Schicken Sie den Antrag an den Ausschussvorsitzenden mit der Bitte um Wiedervorlage in der nächsten Sitzung."
                            },
                            {
                                "example_id": "8cbfb7f0-2cb2-481c-b259-09c233603057",
                                "sense_id": "3a868101-3147-3141-b50d-dffbb9b1cadf",
                                "text": "Themen, die Sie zu einem späteren Zeitpunkt bearbeiten wollen, können Sie im Programm zur Wiedervorlage kennzeichnen und mit einem Erinnerungsdatum versehen."
                            }
                        ],
