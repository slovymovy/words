                                "target_senses": [
                                    {
                                        "sense_id": "3262f0b6-0317-38b4-b72d-ac81a66b73bf",
                                        "entry_id": "061afcf3-faa8-3932-8b00-cd95b097294a",
                                        "glosses": [
                                            "Tissu de crêpe fin et léger, originellement en soie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc4ae37-8764-4a30-b038-35988c11cc20",
                                                "sense_id": "3262f0b6-0317-38b4-b72d-ac81a66b73bf",
                                                "text": "Prenez soit du satin, soit du velours de laine ou bien encore de l’ottoman, voire du crêpe Georgette."
                                            },
                                            {
                                                "example_id": "52ab577b-247f-420f-862c-acca134c8e87",
                                                "sense_id": "3262f0b6-0317-38b4-b72d-ac81a66b73bf",
                                                "text": "En crêpe Georgette, Madame ! Oui, vous voyez l’effet d’ici, si jamais Mlle Vony Myrianne prend fantaisie d’entrer dans l’eau !"
                                            },
                                            {
                                                "example_id": "e447113f-f252-4cf6-a750-653048734e0a",
                                                "sense_id": "3262f0b6-0317-38b4-b72d-ac81a66b73bf",
                                                "text": "Le crêpe georgette, se distingue grâce à un tissage plus serré que le crêpe. C’est un tissu léger, souple, à grain plus ou moins marqué, légèrement transparent. Le crêpe georgette doit son nom à une célèbre couturière parisienne qui fut la première à l’utiliser : Madame Georgette de la Plante contemporaine de Coco Chanel."
                                            }
                                        ]
                                    }
                                ]
