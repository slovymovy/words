{
    "word_family": [
        "uciążliwość"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d644351e-ecef-3b47-952d-129807514498",
                    "sense_definition": "Taki, którego wykonanie sprawia kłopot, trudności lub wymaga dużego wysiłku.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trudność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam dość tych codziennych, <w>uciążliwych</w> czynności.",
                            "target_lang_translations": {
                                "ru": "Я устал от этих ежедневных, <w>обременительных</w> дел."
                            }
                        },
                        {
                            "text": "Wypełnianie tych formularzy jest bardzo <w>uciążliwe</w> dla każdego klienta.",
                            "target_lang_translations": {
                                "ru": "Заполнение этих бланков очень <w>утомительно</w> для каждого клиента."
                            }
                        }
                    ],
                    "synonyms": [
                        "pracochłonny",
                        "żmudny",
                        "trudny",
                        "mozolny"
                    ],
                    "common_phrases": [
                        "uciążliwe obowiązki",
                        "uciążliwa praca"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, выполнение которого доставляет хлопоты, трудности или требует больших усилий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обременительный",
                                "target_lang_sense_clarification": "связанный с трудностями или тяжелыми обязанностями"
                            },
                            {
                                "target_lang_word": "трудоемкий",
                                "target_lang_sense_clarification": "требующий много времени и усилий"
                            },
                            {
                                "target_lang_word": "утомительный",
                                "target_lang_sense_clarification": "вызывающий усталость из-за монотонности или сложности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "330b3e41-17ca-3a13-8514-887561e7ddf2",
                    "sense_definition": "Powodujący dyskomfort, męczący lub dokuczliwy w odczuciu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trudność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spanie na brzuchu sprawia, że bóle pleców stają się mniej <w>uciążliwe</w>.",
                            "target_lang_translations": {
                                "ru": "Сон на животе делает боли в спине менее <w>мучительными</w>."
                            }
                        },
                        {
                            "text": "Hałas z ulicy jest bardzo <w>uciążliwy</w> dla mieszkańców tego bloku.",
                            "target_lang_translations": {
                                "ru": "Уличный шум очень <w>докучлив</w> для жителей этого дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "męczący",
                        "dokuczliwy",
                        "przykry",
                        "dotkliwy"
                    ],
                    "common_phrases": [
                        "uciążliwy hałas",
                        "uciążliwy ból"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий дискомфорт, утомляющий или неприятный в ощущениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "докучливый",
                                "target_lang_sense_clarification": "назойливый, вызывающий раздражение"
                            },
                            {
                                "target_lang_word": "мучительный",
                                "target_lang_sense_clarification": "причиняющий сильные страдания или дискомфорт"
                            },
                            {
                                "target_lang_word": "назойливый",
                                "target_lang_sense_clarification": "неприятно постоянный, например, о шуме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}