                        ],
                        "examples": [
                            {
                                "example_id": "d8cae4d9-065c-40dd-ab59-0760f26bfdc6",
                                "sense_id": "f79d8d89-a67b-3b55-9b11-d53f62e383ed",
                                "text": "W tym laseczku rosną same jodełki i brzózki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "74126512-36e6-3879-a1ca-d66ffa1dde58",
                        "entry_id": "c0dc67be-c2e6-3985-8d60-63ce43d91893",
                        "glosses": [
                            "mała jodła"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "420c4179-6235-43f0-b04a-9be39ec03631",
                                "sense_id": "74126512-36e6-3879-a1ca-d66ffa1dde58",
                                "text": "Na podwórku stała jodełka przystrojona świecidełkami."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "4555e366-33ba-393c-ad9d-ec9ba4531abc",
                        "entry_id": "c0dc67be-c2e6-3985-8d60-63ce43d91893",
                        "glosses": [
                            "rodzaj splotu tkaniny, przypominający układ igieł jodły"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da71f2ec-bad1-4fc0-8ea0-97d3227b8670",
                                "sense_id": "4555e366-33ba-393c-ad9d-ec9ba4531abc",
                                "text": "Założę dziś ten nowy płaszcz w jodełkę."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "3e10ddc2-0087-338f-872a-bccd1cb5ed21",
                        "entry_id": "c0dc67be-c2e6-3985-8d60-63ce43d91893",
                        "glosses": [
                            "tkanina o takim splocie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda95dc4-2586-47eb-88ae-7e8684f4ee58",
                                "sense_id": "3e10ddc2-0087-338f-872a-bccd1cb5ed21",
                                "text": "Kupiłam cztery metry jodełki, muszę zanieść ją do krawcowej."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33f8c77e-3fec-43f4-9e9e-f6d8b9308ed3",
                        "source_entry_id": "c0dc67be-c2e6-3985-8d60-63ce43d91893",
                        "source_sense_id": "4555e366-33ba-393c-ad9d-ec9ba4531abc",
                        "target_lang_word": "herringbone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herringbone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ffc9615-cca7-3efe-9654-31ebb568dfc8",
                                        "entry_id": "b1213e13-7d76-330d-9df2-5f29f90cd5da",
                                        "glosses": [
                                            "A bone of a herring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57632be9-50ac-42a5-bb87-4ab279f3f939",
                                                "sense_id": "6ffc9615-cca7-3efe-9654-31ebb568dfc8",
                                                "text": "The prosperity of Amsterdam was then so great that it was said that Amsterdam was \"founded on herring-bones.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5fac8a6-4411-33c9-8afb-5740b5cbae9f",
                                        "entry_id": "b1213e13-7d76-330d-9df2-5f29f90cd5da",
                                        "glosses": [
                                            "A zigzag pattern, especially made by bricks, on a cloth, or by stitches in sewing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "363b1609-a7a1-4ba8-b70e-a271b4b3248c",
                                                "sense_id": "c5fac8a6-4411-33c9-8afb-5740b5cbae9f",
                                                "text": "'The best path of life is but a herring-bone pattern.'"
                                            },
                                            {
                                                "example_id": "32d6926c-d01b-4101-af19-54483b9a6459",
                                                "sense_id": "c5fac8a6-4411-33c9-8afb-5740b5cbae9f",
                                                "text": "Mr Bloom walked behind the eyeless feet, a flatcut suit of herringbone tweed."
                                            },
                                            {
                                                "example_id": "cc14a40a-2607-4116-8f42-ffab25876977",
                                                "sense_id": "c5fac8a6-4411-33c9-8afb-5740b5cbae9f",
                                                "text": "Though almost engulfed by Bedford, Elstow's claim to villagedom is still maintained by two fine rows of timber-framed, overhung, black-and-white cottages and the timber and herringbone-brick Swan pub."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92424732-8194-3645-bb71-983c96be6b01",
                                        "entry_id": "b1213e13-7d76-330d-9df2-5f29f90cd5da",
                                        "glosses": [
                                            "A method of climbing a hill by pointing the skis outward in a V-shape to keep from sliding backwards."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f7692c4-89c9-3044-8d1d-a620abd9dd77",
                                        "entry_id": "b1213e13-7d76-330d-9df2-5f29f90cd5da",
                                        "glosses": [
                                            "Twilled fabric woven in rows of parallel sloping lines."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2249f74-7625-4acb-8b1f-fe395fa00ec0",
                                                "sense_id": "9f7692c4-89c9-3044-8d1d-a620abd9dd77",
                                                "text": "For some strange and elusive reason, the staid, prosaic herringbones have angled themselves into a position of fashion prominence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "herringbone",
