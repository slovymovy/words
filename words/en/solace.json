{
    "word_family": [
        "solacement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b626879-45f5-368b-a441-37855f865d0f",
                    "sense_definition": "Comfort or consolation in a time of loneliness or distress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You cannot put a monetary value on emotional <w>solace</w>.",
                            "target_lang_translations": {
                                "ru": "Нельзя оценить душевное <w>утешение</w> в денежном эквиваленте."
                            }
                        },
                        {
                            "text": "After the loss of his dog, he sought <w>solace</w> in the quiet of the forest.",
                            "target_lang_translations": {
                                "ru": "После потери собаки он искал <w>утешения</w> в лесной тишине."
                            }
                        }
                    ],
                    "synonyms": [
                        "comfort",
                        "consolation",
                        "relief",
                        "solace"
                    ],
                    "antonyms": [
                        "distress",
                        "anguish"
                    ],
                    "common_phrases": [
                        "seek solace",
                        "find solace",
                        "emotional solace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утешение или облегчение в моменты одиночества или душевных страданий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утешение",
                                "target_lang_sense_clarification": "облегчение горя или страданий"
                            },
                            {
                                "target_lang_word": "отрада",
                                "target_lang_sense_clarification": "чувство удовольствия и успокоения"
                            },
                            {
                                "target_lang_word": "успокоение",
                                "target_lang_sense_clarification": "состояние покоя после тревоги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5be68fe6-a709-339b-b772-4719aa6fb472",
                    "sense_definition": "A person, thing, or activity that provides a source of comfort or consolation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The proper <w>solaces</w> of age are not music and compliments, but wisdom and devotion.",
                            "target_lang_translations": {
                                "ru": "Истинные <w>утешения</w> старости — это не музыка и комплименты, а мудрость и преданность."
                            }
                        },
                        {
                            "text": "Music was her only <w>solace</w> during those long, lonely winter nights.",
                            "target_lang_translations": {
                                "ru": "Музыка была её единственной <w>отрадой</w> в те долгие, одинокие зимние ночи."
                            }
                        }
                    ],
                    "synonyms": [
                        "comfort",
                        "consolation",
                        "respite"
                    ],
                    "common_phrases": [
                        "only solace",
                        "great solace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, вещь или занятие, которые служат источником утешения или успокоения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утешение",
                                "target_lang_sense_clarification": "то, что приносит успокоение"
                            },
                            {
                                "target_lang_word": "отдушина",
                                "target_lang_sense_clarification": "занятие, помогающее отвлечься от забот"
                            },
                            {
                                "target_lang_word": "отрада",
                                "target_lang_sense_clarification": "источник радости в трудное время"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2020b03e-8cdc-3478-a5f3-965f47d1fc70",
                    "sense_definition": "To give comfort, cheer, or consolation to someone in distress.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "to comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to <w>solace</w> the grieving family with kind words and warm meals.",
                            "target_lang_translations": {
                                "ru": "Она старалась <w>утешить</w> скорбящую семью добрыми словами и горячей едой."
                            }
                        },
                        {
                            "text": "The nurse stayed by his side to <w>solace</w> him through the difficult night.",
                            "target_lang_translations": {
                                "ru": "Медсестра оставалась рядом, чтобы <w>успокаивать</w> его в эту трудную ночь."
                            }
                        }
                    ],
                    "synonyms": [
                        "soothe",
                        "cheer",
                        "comfort",
                        "console"
                    ],
                    "antonyms": [
                        "distress",
                        "upset"
                    ],
                    "common_phrases": [
                        "solace the soul"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Утешать, подбадривать или успокаивать кого-либо в беде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утешать",
                                "target_lang_sense_clarification": "стараться облегчить чье-то горе"
                            },
                            {
                                "target_lang_word": "успокаивать",
                                "target_lang_sense_clarification": "приводить в состояние покоя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2392f30b-e586-3a6f-b00a-b7b8700b173c",
                    "sense_definition": "To allay, assuage, or lessen grief or misfortune.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "to comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hoped that the peaceful scenery would <w>solace</w> his troubled mind.",
                            "target_lang_translations": {
                                "ru": "Он надеялся, что мирный пейзаж <w>смягчит</w> его встревоженный ум."
                            }
                        },
                        {
                            "text": "Nothing could <w>solace</w> the pain of such a profound disappointment.",
                            "target_lang_translations": {
                                "ru": "Ничто не могло <w>облегчить</w> боль от такого глубокого разочарования."
                            }
                        }
                    ],
                    "synonyms": [
                        "soothe",
                        "alleviation"
                    ],
                    "antonyms": [
                        "aggravate"
                    ],
                    "common_phrases": [
                        "solace grief"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смягчать, облегчать или уменьшать горе или несчастье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "делать горе менее острым"
                            },
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "уменьшать тяжесть страданий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c7e2350-cbc7-39c9-9e22-b94d1c54383f",
                    "sense_definition": "To take comfort or to be cheered by something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "to comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "But one thing to rejoice and <w>solace</w> in, and cruel death hath caught it from my sight.",
                            "target_lang_translations": {
                                "ru": "Была лишь одна вещь, которой можно было радоваться и в которой можно было <w>утешаться</w>, но жестокая смерть похитила её у меня."
                            }
                        },
                        {
                            "text": "The weary travelers began to <w>solace</w> in the warmth of the campfire.",
                            "target_lang_translations": {
                                "ru": "Утомленные путники начали <w>находить утешение</w> в тепле походного костра."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheer"
                    ],
                    "common_phrases": [
                        "solace in"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находить утешение или радоваться чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утешаться",
                                "target_lang_sense_clarification": "находить для себя облегчение в чем-то"
                            },
                            {
                                "target_lang_word": "находить утешение",
                                "target_lang_sense_clarification": "получать облегчение от чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}