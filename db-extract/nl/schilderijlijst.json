                        "sense_id": "ca42591c-c119-3e72-8438-6b2914a8be31",
                        "entry_id": "cd191395-892c-3152-9ab9-575a88f02128",
                        "glosses": [
                            "een rand in een speciale vorm die een schilderij omvat"
