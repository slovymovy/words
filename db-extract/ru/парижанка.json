                                            {
                                                "example_id": "a2bd1c32-71b5-42b0-8c8c-63eaffd17c51",
                                                "sense_id": "5b495d66-1191-3d73-8ba8-3ae77d60dafd",
                                                "text": "Paryżanki podobno zajadają się kasztanami, żabami i ślimakami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
