            "senses": [
                {
                    "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                    "sense_definition": "Een aanmoediging of prikkel om iemand tot actie of betere prestaties te bewegen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aanmoediging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een kleine <w>aansporing</w> wilde de meester toch wel beginnen met de uitleg.",
                            "target_lang_translations": {
                                "en": "After a little <w>encouragement</w>, the teacher was willing to start the explanation after all."
                            }
                        },
                        {
                            "text": "Zijn woorden dienden als een krachtige <w>aansporing</w> om harder te studeren.",
                            "target_lang_translations": {
                                "en": "His words served as a powerful <w>incentive</w> to study harder."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanmoediging",
                        "prikkel",
                        "stimulans"
                    ],
                    "antonyms": [
                        "ontmoediging"
                    ],
                    "common_phrases": [
                        "een krachtige aansporing",
                        "aansporing tot actie"
                    ],
                    "target_lang_definitions": {
                        "en": "An encouragement or stimulus to move someone to action or better performance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "encouragement",
                                "target_lang_sense_clarification": "the act of giving someone support, confidence, or hope"
                            },
                            {
                                "target_lang_word": "stimulus",
                                "target_lang_sense_clarification": "something that promotes activity, interest, or enthusiasm"
                            },
                            {
                                "target_lang_word": "incitement",
                                "target_lang_sense_clarification": "the action of provoking unlawful behavior or urging someone to act"
                            },
                            {
                                "target_lang_word": "urge",
                                "target_lang_sense_clarification": "a strong encouragement or prompting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9ddf365-9c4c-3f7d-b2b8-90f710691bdb",
                    "sense_definition": "Iets wat dient als een motief of stimulans; een prikkel die aanzet tot een bepaalde handeling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanmoediging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De financiële bonus werkte als een goede <w>aansporing</w> voor het hele team.",
                            "target_lang_translations": {
                                "en": "The financial bonus worked as a good <w>incentive</w> for the entire team."
                            }
                        },
                        {
                            "text": "Zonder enige vorm van <w>aansporing</w> komen deze studenten helaas niet in beweging.",
                            "target_lang_translations": {
                                "en": "Without any form of <w>prompting</w>, these students unfortunately do not get moving."
                            }
                        }
                    ],
                    "synonyms": [
                        "incentive",
                        "prikkel",
                        "stimulans"
                    ],
                    "common_phrases": [
                        "financiële aansporing"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that serves as a motive or stimulus; an incentive that prompts a specific action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incentive",
