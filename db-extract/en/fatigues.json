                        "cross_references": [
                            {
                                "target_word": "Tarnanzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d918283d-8833-39c9-adfa-4e5793417f6d",
                                        "entry_id": "4a8493f9-a47b-3aa9-8588-b4e37dab019a",
                                        "glosses": [
                                            "Kleidung für Soldaten, die durch Muster und Farbe (Tarnfarben) den Träger vor einem Hintergrund weitgehend unsichtbar machen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4105a32f-251b-440d-914c-c2feeac663d0",
                                                "sense_id": "d918283d-8833-39c9-adfa-4e5793417f6d",
                                                "text": "Anfang der Woche waren sie noch überall sichtbar: Bewaffnete Männer in Tarnanzügen mit dem Emblem der von prorussischen Separatisten ausgerufenen \"Volksrepublik Donezk\"."
                                            },
                                            {
                                                "example_id": "b2354960-372b-4deb-8973-90e228b24e21",
                                                "sense_id": "d918283d-8833-39c9-adfa-4e5793417f6d",
                                                "text": "AP-Mitarbeiter sahen am Samstagnachmittag rund zehn Männer in Tarnanzügen in die Stadt kommen, die Schnellfeuergewehre bei sich hatten und Barrikaden aus Reifen aufbauten."
                                            },
                                            {
                                                "example_id": "e87f0e35-64ed-46bc-ab82-40c9348c5df5",
                                                "sense_id": "d918283d-8833-39c9-adfa-4e5793417f6d",
                                                "text": "Gegen 9.30 Uhr war der Junge in einem schwarzen Tarnanzug in die Schule gegangen und hatte sowohl im Gebäude als auch auf dem Schulhof mit einer Schusswaffe der italienischen Marke Beretta wahllos um sich geschossen."
                                            },
                                            {
                                                "example_id": "167f55be-32e8-4bec-af09-edcce0848a8f",
                                                "sense_id": "d918283d-8833-39c9-adfa-4e5793417f6d",
                                                "text": "„Bald hatte sich eine Menschenmenge um uns versammelt, wir wurden mit Händeschütteln und von den freundlichen Soldaten in Tarnanzügen mit High Fives begrüßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
