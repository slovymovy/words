                "senses": [
                    {
                        "sense_id": "51673e1f-286a-338b-9908-f278def0866a",
                        "entry_id": "26e5cdfd-9d4c-39ce-ae99-3396f9ad93bc",
                        "glosses": [
                            "Ladestation, an der die Batterien von Elektrofahrzeugen aufgeladen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fcb8a58-7f68-4a53-8fe9-9024cbfd0c69",
                                "sense_id": "51673e1f-286a-338b-9908-f278def0866a",
                                "text": "„Auf dem weitläufigen Gelände sind weiters bereits Elektromobile und e-Bikes unterwegs - die an einer betriebseigenen Stromtankstelle aufgeladen werden, die wiederum von einer Fotovoltaikanlage gespeist wird.“"
                            },
                            {
                                "example_id": "40b6657b-5b21-4c2d-8fb3-1df39e06cc4d",
                                "sense_id": "51673e1f-286a-338b-9908-f278def0866a",
                                "text": "„Einen Überblick über die Standorte von Stromtankstellen gibt es bei Informationsdiensten und Vereinen wie Going Electric, Chargemap oder Lemnet, die Karten im Internet oder per App anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
