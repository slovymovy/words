                "senses": [
                    {
                        "sense_id": "da41cf24-6106-3b2c-ae98-1b581a2740da",
                        "entry_id": "5915d672-a078-3c99-b7fd-33e58c6694a7",
                        "glosses": [
                            "Faire perdre son caractère orthodoxe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55f28e20-4c57-4782-a6e2-09b22d62f5e0",
                                "sense_id": "da41cf24-6106-3b2c-ae98-1b581a2740da",
                                "text": "Je me souviens aussi d’une autre jeune Russe, Maria (oui, curieusement, parmi ces Russes désorthodoxisées il y avait aussi beaucoup de Maria)."
                            },
                            {
                                "example_id": "9e50dfe2-ab13-45e7-b3ce-0c4d1524fd69",
                                "sense_id": "da41cf24-6106-3b2c-ae98-1b581a2740da",
                                "text": "C’est pour les désorthodoxiser et les uniatiser que les papes fondèrent le Collegio Greco de Rome."
                            },
                            {
                                "example_id": "56f9406a-14e3-4179-b665-6114e9eab67c",
                                "sense_id": "da41cf24-6106-3b2c-ae98-1b581a2740da",
                                "text": "Pas certain que Poutine accepte aussi facilement que la partie grecque de Chypre se \"désorthodoxise\" au profit de la partie turque…"
                            }
                        ]
                    }
                ],
