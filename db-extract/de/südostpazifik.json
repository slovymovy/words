                "senses": [
                    {
                        "sense_id": "bd2dab14-f73c-32bd-91d3-ebd4a1539f64",
                        "entry_id": "19944df3-ae7f-38aa-a843-67d04d04c23f",
                        "glosses": [
                            "südöstlicher Teil des Pazifiks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d14d68e-e71f-4d26-b376-75bc1c2015e4",
                                "sense_id": "bd2dab14-f73c-32bd-91d3-ebd4a1539f64",
                                "text": "„Vor den Ostküsten der USA, Australiens und Sri Lankas, südlich von Hawaii und vor allem im Südostpazifik weisen Raubfische der offenen Meere die größte Biodiversität auf.“"
                            },
                            {
                                "example_id": "bc02a748-4c4e-4137-a4d4-28fd7dcfd036",
                                "sense_id": "bd2dab14-f73c-32bd-91d3-ebd4a1539f64",
                                "text": "„Die Wirkung des Entrainment aber kann global sein: Wenn sich Wolken beispielsweise über dem häufig bedeckten Südostpazifik auflösen, erhöht sich die Sonneneinstrahlung auf dieses Meeresgebiet und es wird wärmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
