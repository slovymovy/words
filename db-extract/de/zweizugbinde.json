                ],
                "senses": [
                    {
                        "sense_id": "cb19a021-2268-306a-b5ec-110934f9f3b3",
                        "entry_id": "04e577c6-663f-3388-97ec-9c3b5604bb1b",
                        "glosses": [
                            "Binde, die in zwei Richtungen, also sowohl längs- als auch querelastisch ist"
                        ],
                        "tags": [
                            "Technische Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "7b9bfc33-1d20-4dbe-b120-5b80dcc82d20",
                                "sense_id": "cb19a021-2268-306a-b5ec-110934f9f3b3",
                                "text": "„Verband: Ohne jede Strangulation anlegen. […] Erwünscht ist leichte Kompression von distal nach proximal hin absteigend durch elastische Zweizugbinden, diagonal angelegt.“"
                            },
                            {
                                "example_id": "4ed20828-42fc-4c7d-a2ed-bcd377aa6691",
                                "sense_id": "cb19a021-2268-306a-b5ec-110934f9f3b3",
                                "text": "„Ein elastischer Stumpfverband muss einen von distal nach proximal hin absteigenden Druck ausüben […] Dazu dienen weiche, elastische Zweizugbinden. Der Verband ist mindestens einmal täglich neu anzulegen, um Strangulationen zu vermeiden. Die Funktion der Drainage darf durch den Verband nicht behindert werden.“"
                            },
                            {
                                "example_id": "2b828708-3b15-4e85-a433-f28429475bda",
                                "sense_id": "cb19a021-2268-306a-b5ec-110934f9f3b3",
                                "text": "„Der Druck dieser starken elastischen Zweizugbinden […] kann ansteigen für 1 Tour auf 40 Torr für 2 Touren auf 100 Torr für 3 Touren auf 150 Torr. Dieser Druck übersteigt den normalen Blutdruck in den Hautkapillaren, […]“"
                            },
                            {
                                "example_id": "4ddef97c-eb73-49c1-b963-8476224b0c73",
                                "sense_id": "cb19a021-2268-306a-b5ec-110934f9f3b3",
                                "text": "„Aber ich glaube, dieser Dauerverband […], wobei ich besonders die […]binde von xyz, eine längs- und querelastische Zweizugbinde, bevorzuge, während die […]binden nur in einer Richtung dehnbar sind, erfüllt seinen Zweck ebenso gut. Also es gibt keinen Patentverband.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
