{
    "word_family": [
        "секундный",
        "секундомер",
        "секундочка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f88d8f9-9cc9-34a8-ba9d-9c52ea811fb3",
                    "sense_definition": "Единица измерения времени, равная одной шестидесятой части минуты.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В одной минуте ровно шестьдесят <w>секунд</w>.",
                            "target_lang_translations": {
                                "en": "There are exactly sixty <w>seconds</w> in one minute."
                            }
                        },
                        {
                            "text": "Спортсмен пробежал дистанцию за десять <w>секунд</w>.",
                            "target_lang_translations": {
                                "en": "The athlete ran the distance in ten <w>seconds</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "век"
                    ],
                    "common_phrases": [
                        "десять секунд",
                        "каждая секунда"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit of time equal to one-sixtieth of a minute."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "second",
                                "target_lang_sense_clarification": "A unit of time."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3441992-2f70-306f-956d-bae5ffa4957c",
                    "sense_definition": "Очень короткий промежуток времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Подожди меня здесь одну <w>секунду</w>.",
                            "target_lang_translations": {
                                "en": "Wait for me here for a <w>second</w>."
                            }
                        },
                        {
                            "text": "В эту <w>секунду</w> он понял свою ошибку.",
                            "target_lang_translations": {
                                "en": "In that <w>second</w>, he realized his mistake."
                            }
                        }
                    ],
                    "synonyms": [
                        "мгновение"
                    ],
                    "common_phrases": [
                        "подожди секунду",
                        "сию секунду"
                    ],
                    "target_lang_definitions": {
                        "en": "A very short period of time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "second",
                                "target_lang_sense_clarification": "A short, indeterminate amount of time."
                            },
                            {
                                "target_lang_word": "moment",
                                "target_lang_sense_clarification": "A brief point in time."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a75f97fe-177e-391d-9db9-f7dfea2bf9b7",
                    "sense_definition": "Единица измерения углов, равная одной шестидесятой части угловой минуты.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "angle_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Точность прибора составляет одну угловую <w>секунду</w>.",
                            "target_lang_translations": {
                                "en": "The precision of the instrument is one arc<w>second</w>."
                            }
                        },
                        {
                            "text": "Координаты были определены с точностью до <w>секунды</w>.",
                            "target_lang_translations": {
                                "en": "The coordinates were determined with an accuracy of one <w>second</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "угловая секунда"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit of angular measurement equal to one-sixtieth of an arcminute."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arcsecond",
                                "target_lang_sense_clarification": "A unit of angular measurement."
                            },
                            {
                                "target_lang_word": "second",
                                "target_lang_sense_clarification": "A unit of angle equal to one-sixtieth of a minute of arc."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "162550ef-cd18-39f7-97e2-aeb1021134c5",
                    "sense_definition": "Музыкальный интервал между двумя соседними ступенями звукоряда.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_interval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Малая <w>секунда</w> звучит довольно резко.",
                            "target_lang_translations": {
                                "en": "A minor <w>second</w> sounds quite sharp."
                            }
                        },
                        {
                            "text": "Ученик сыграл большую <w>секунду</w> на фортепиано.",
                            "target_lang_translations": {
                                "en": "The student played a major <w>second</w> on the piano."
                            }
                        }
                    ],
                    "common_phrases": [
                        "малая секунда",
                        "большая секунда"
                    ],
                    "target_lang_definitions": {
                        "en": "A musical interval between two adjacent notes in a scale."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "second",
                                "target_lang_sense_clarification": "The interval between two adjacent notes in a diatonic scale."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}