                            {
                                "example_id": "d3264736-5e07-4ae5-af80-cecc3760fc14",
                                "sense_id": "671904d4-3bf5-3562-98b0-2032983abe51",
                                "text": "Le titre de généralissime comporte l'idée du commandement de toutes les troupes de l'État.",
                                "translation": "\"Bonaparte\" in Larousse 19e",
                                "english": "\"Bonaparte\" in Larousse 19e"
                            },
                            {
                                "example_id": "9d716d23-9b36-489c-baf9-57290cdf1d56",
                                "sense_id": "671904d4-3bf5-3562-98b0-2032983abe51",
                                "text": "Et c'est entre ministres plus ou moins républicains et généralissimes toujours réactionnaires, un état de crise, qui, latent d'abord, éclate aux yeux de tous. (Victor Margueritte, Au bord du gouffre - Août-Septembre 1914, 1919)"
                            }
                        ]
                    }
                ],
