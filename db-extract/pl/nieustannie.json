                        "source_entry_id": "21cc9da2-95de-3986-af7b-4a7e119fff3e",
                        "source_sense_id": "76b61ef6-4c94-31d1-958e-9653836c46a8",
                        "target_lang_word": "неустанно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неустанно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fd8087f2-fe7d-34a6-8a9b-8c2fd9a11d23",
                                        "entry_id": "31f799f9-5ca7-37dc-91d9-1cd85adc1ee0",
                                        "glosses": [
                                            "наречие к неустанный; постоянно, непрерывно или регулярно, часто, при каждом удобном случае (обычно о чьей-либо деятельности)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc20b991-f947-4d1a-ab6e-13b6d35af2a4",
                                                "sense_id": "fd8087f2-fe7d-34a6-8a9b-8c2fd9a11d23",
                                                "text": "Везде она меня как-то случайно отыскивала, встречалась со мной с дружескими поцелуями и объятиями и всегда неустанно жаловалась на злокозненные происки человеческого рода, избравшего её, Домну Платоновну, своей любимой жертвой и каким-то вечным игралищем."
                                            },
                                            {
                                                "example_id": "df9f7251-1783-4846-9c18-98c07ddab363",
                                                "sense_id": "fd8087f2-fe7d-34a6-8a9b-8c2fd9a11d23",
                                                "text": "Мысль человеческая, с той самой минуты, как она сознает в себе стремление обмирщиться и сделаться общим достоянием человечества, постоянно ищет преодолеть все преграды, которые представляются ей на пути к этой цели, неустанно ищет свободы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
