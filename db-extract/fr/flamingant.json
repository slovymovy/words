                        "entry_id": "78f7686f-5aa0-35f3-8c49-a6c35a27ab26",
                        "glosses": [
                            "Relatif à, qui relève du nationalisme flamand."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0985ea6e-2b48-41e0-846a-b3512f4cb2bb",
                                "sense_id": "e5a54f77-211f-3bf2-9295-7cc5b0b39ed5",
                                "text": "Nul gâcheur d'encre ou de salive ne proclamait le \"België barst\" (que la Belgique crève), le vomissement de la convulsion flamingante."
                            }
                        ]
