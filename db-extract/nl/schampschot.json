                "senses": [
                    {
                        "sense_id": "6d1fd2a2-845b-3de6-8a06-c19a0989edde",
                        "entry_id": "28620ba9-83e5-3c44-bc11-1f6c02bdf6c4",
                        "glosses": [
                            "een schot dat het doel maar net geraakt heeft zonder erin door te dringen, een afglijdend schot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32f5e0bc-7b07-40e4-9bd6-a14476b1b2df",
                                "sense_id": "6d1fd2a2-845b-3de6-8a06-c19a0989edde",
                                "text": "Daarbij kreeg één man drie kogels in het lichaam, raakte een tweede gewond aan de heup en liep een derde een schampschot op. Het eerste slachtoffer werd in kritieke toestand overgebracht naar het ziekenhuis maar zou intussen buiten levensgevaar zijn."
                            },
                            {
                                "example_id": "6f7f78c6-c475-4f78-9993-05ba89c04a36",
                                "sense_id": "6d1fd2a2-845b-3de6-8a06-c19a0989edde",
                                "text": "De Nederlandse oorlogsverslaggever Bud Wichers is gisteravond gewond geraakt tijdens een beschieting door een scherpschutter in de Iraakse stad Kirkuk. Hij liep een schampschot op aan zijn arm."
                            }
                        ]
                    }
