                                "target_senses": [
                                    {
                                        "sense_id": "40d845e1-8735-3e8c-ae58-c8cbae221a3b",
                                        "entry_id": "8a1f213a-33af-3b46-a718-d10c40a1aca9",
                                        "glosses": [
                                            "„polycyclische—oder: polyzyklische— aromatische Kohlenwasserstoffe“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb794663-4f0e-4cb6-81b3-a9bfe1556f47",
                                                "sense_id": "40d845e1-8735-3e8c-ae58-c8cbae221a3b",
                                                "text": "„PAK begegnen uns als Luftschadstoffe verursacht durch Kleinfeuerungen […], den Verkehr, durch Industrieprozesse und Tabakrauch. Auch sind sie in Nahrungsmitteln, besonders beim sommerlichen Grillvergnügen oder in geräucherten Produkten, nachweisbar.“"
                                            },
                                            {
                                                "example_id": "bdec3cd4-3f60-481e-b3fc-33f78ad869a1",
                                                "sense_id": "40d845e1-8735-3e8c-ae58-c8cbae221a3b",
                                                "text": "„Vom PAK-belasteten Boden geht laut Stadtverwaltung keine unmittelbare Gefahr aus. […] Im Boden schlummern polyzyklische aromatische Kohlenwasserstoffe (PAK), die derzeit laut Verwaltung ‚keine unmittelbare Gefährdung‘ darstellen, im Moment der Bodenbewegung aber nach dem Abfallrecht zu entsorgen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
