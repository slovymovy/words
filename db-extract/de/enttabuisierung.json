                "senses": [
                    {
                        "sense_id": "f0a0a8cb-46fc-3eed-99ca-fc2953c49668",
                        "entry_id": "edfa7e39-e532-3ac5-820a-18f69190d6b0",
                        "glosses": [
                            "Verletzung, Bruch eines bestehenden Tabus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bedcd25d-1d98-4b8a-9d63-5095b13b82bd",
                                "sense_id": "f0a0a8cb-46fc-3eed-99ca-fc2953c49668",
                                "text": "„Ihr Herausgeber, Reinhold Aman, glaubt jedoch, die Enttabuisierung der meisten Lebensbereiche sowie die sprachliche Ausdrucksarmut des Durchschnitt-Amerikaners, dessen Repertoire kaum mehr als zweitausend Wörter umfasse, führten zu einem Niedergang der amerikanischen Schimpfkultur und damit zu einem verstärkten Umsichgreifen von Gewalt..“"
                            },
                            {
                                "example_id": "ed887cb1-2323-4db1-ae35-a75726ccb31f",
                                "sense_id": "f0a0a8cb-46fc-3eed-99ca-fc2953c49668",
                                "text": "„Als Beispiel für Letzteres, also für eine Enttabuisierung, möchte ich ein Wort nennen, dessen Entwicklung alle Älteren miterlebt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
