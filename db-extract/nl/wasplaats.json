                                "sense_id": "16a66ab7-59c2-32ee-90a6-9d99183735f3",
                                "text": "Zijn collega’s, die in de schemer op badslippers tussen de wasplaats en het tentenkamp pendelen, zijn al net zo opgewonden."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1b23dd8-6a7b-30e4-a9d8-d5981f971d99",
                        "entry_id": "e53b9a53-7a0e-3410-815d-0777b1b40da8",
                        "glosses": [
                            "locatie waar kleding en ander textiel met water wordt gereinigd"
