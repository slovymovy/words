                "senses": [
                    {
                        "sense_id": "28c42c75-a271-33dc-a42f-8b6807b1cb43",
                        "entry_id": "bb5d9cc7-bcd7-3e79-b970-55f86136596a",
                        "glosses": [
                            "onprettig koud of fris"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "971dbd5a-4093-4378-a37a-f002ec2a2eb3",
                                "sense_id": "28c42c75-a271-33dc-a42f-8b6807b1cb43",
                                "text": "Buiten was het grijs en killig, maar een tapwagen aan de ingang van de concertzaal suggereerde een beetje de sfeer van de begindagen van de Gentse Feesten bij Sint-Jacobs."
                            },
                            {
                                "example_id": "e65d2d69-ff16-4315-9e28-d866eac949b9",
                                "sense_id": "28c42c75-a271-33dc-a42f-8b6807b1cb43",
                                "text": "Het romantische park loopt tot en met het Groot Melkhuis. Aeyelts: “De sfeer is er intiem, nostalgisch, doet denken aan oude vervlogen tijden.” Op een killige dag begin juni fietsen we samen door het park en laat de beheerder mij zien wat hij de mooiste plekjes van het park vindt."
                            }
                        ]
                    },
                    {
                        "sense_id": "afbccc5e-99b4-3eff-96e0-784beab2e3ba",
                        "entry_id": "bb5d9cc7-bcd7-3e79-b970-55f86136596a",
                        "glosses": [
                            "zonder medeleven"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f39a87e2-2aaa-4445-bc7c-e7b2ab3ff869",
                                "sense_id": "afbccc5e-99b4-3eff-96e0-784beab2e3ba",
                                "text": "Het is best killig ontwaken in dit decennium. Na jaren bezig zijn met wat jij over de wereld denkt en wat de wereld over jou denkt, plots inzien dat die wereld eigenlijk gewoon helemaal niet met je bezig is: dat is een opluchting, ja, alleen besef je dat niet meteen. Het is het reality check-decennium."
                            }
                        ]
                    }
