                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e954c22-c7a4-434d-b27f-ad68947b6875",
                        "source_entry_id": "c150903d-c448-34fc-873f-6b66676f043e",
                        "source_sense_id": "817e099d-bb73-33ec-bcf8-1c705f04db04",
                        "source_sense_description": "iemand die alleen en in afzondering leeft",
                        "target_lang_word": "Einsiedler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einsiedler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                        "entry_id": "5cdeadc1-6661-3193-ae25-dfd048df697c",
                                        "glosses": [
                                            "in Zurückgezogenheit lebender Mann (zum Beispiel aus religiöser Überzeugung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eddb9ebb-0b1a-4b74-a27f-1acacf159e6f",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "Der Einsiedler sagte, sie hätte ja noch ihre königlichen Kleider an, damit könne sie nicht reisen."
                                            },
                                            {
                                                "example_id": "50ab3c5e-6ba6-4017-af04-ccaad5734d27",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "„Er wird Einsiedler, erst im Schwarzwald, schließlich, am Ende einer seltsamen Weltreise, auf einer einsamen Insel.“"
                                            },
                                            {
                                                "example_id": "7c6e5a8c-dc2a-4ee6-9504-6e9fd39662c0",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "„Ich wurde von dem Einsiedler geweckt, der sehr zufrieden schien, mich gesund und heil zu sehen.“"
                                            },
                                            {
                                                "example_id": "8cf2526d-3be6-4ac0-b7f5-6db43f229915",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "„Preben Kauffmann fand hinter dem Strand eine Höhle und richtete sie gemütlich her, um die nächsten vierzig Jahre seines Lebens als Einsiedler zu verbringen.“"
                                            },
                                            {
                                                "example_id": "ed251bcc-b467-4a8a-952c-6880de5cd9a0",
                                                "sense_id": "ea94319a-56f8-36c9-9f07-c18e3537d949",
                                                "text": "„Der Besucher verrichtete artig einen vierfachen Stirnaufschlag, erst vor dem Buddhabildnis, dann vor dem alten Einsiedler, dann nahm er schweigend und abwartend zu Seiten der Andachtsmatte Aufstellung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3efe6faa-05f4-4567-a4a9-194e2c8bcd73",
                        "source_entry_id": "c150903d-c448-34fc-873f-6b66676f043e",
                        "source_sense_id": "817e099d-bb73-33ec-bcf8-1c705f04db04",
