                        ]
                    },
                    {
                        "translation_id": "c0f3074f-dda3-4cf6-9586-e0fa9a001879",
                        "source_entry_id": "98bd91e9-f743-3e71-9b0f-daef292c1c84",
                        "source_sense_description": "light cavalry of any of several European armies",
                        "target_lang_word": "huzaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huzaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "05bc2d67-9d83-3cd4-b281-7b9249297cea",
                                        "entry_id": "9877571b-9a8b-35e3-b6a9-6fc1a27801a9",
                                        "glosses": [
                                            "een ruiterijsoldaat"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429b0de9-8687-447b-ab39-e16f18b3958b",
                                                "sense_id": "05bc2d67-9d83-3cd4-b281-7b9249297cea",
                                                "text": "Noch onze dappere huzaren, noch de niet minder dappere infanterie, verdienen hier eenigen blaam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c52d79b-e0b7-4c84-8947-d2f72dd83ed6",
                        "source_entry_id": "98bd91e9-f743-3e71-9b0f-daef292c1c84",
                        "source_sense_description": "light cavalry of any of several European armies",
                        "target_lang_word": "hussard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hussard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af03c198-2a8e-31ca-a2ce-d6845eb5c871",
                                        "entry_id": "d1373551-dbe0-3fce-8036-a7f3da8c0e07",
                                        "glosses": [
                                            "Qui est propre aux hussards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83969fb7-3452-453f-afca-a211f03d65a9",
                                                "sense_id": "af03c198-2a8e-31ca-a2ce-d6845eb5c871",
                                                "text": "Il est vêtu d’une capote ancien modèle, bleu foncé, avec une grande poche rapportée, d’un joli bleu hussard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cfff13a-757a-33fd-92c5-a5686bf747f2",
                                        "entry_id": "d1373551-dbe0-3fce-8036-a7f3da8c0e07",
                                        "glosses": [
                                            "Qui a les manières brusques, sans distinction."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a40792d-38c9-4f86-8124-92d930bc46bd",
                                                "sense_id": "8cfff13a-757a-33fd-92c5-a5686bf747f2",
                                                "text": "— L’Argentière, tu fais le roué !… Non, mon ami, non, ce n’est point une fille digne d’un traitement aussi hussard, c’est une jeune enfant infortunée !"
                                            },
                                            {
                                                "example_id": "c18c4cf7-8a21-435b-8ed0-42048ff550db",
                                                "sense_id": "8cfff13a-757a-33fd-92c5-a5686bf747f2",
                                                "text": "Je vous déclare ça brusquement, d’une façon hussarde, et, quand j’aperçois le fossé, je ne m’attarde pas à effeuiller des marguerites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hussard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1754fa39-30ed-3390-84a4-9c93977fd201",
                                        "entry_id": "5a4df68e-938d-3784-b956-4f3ba37cb333",
                                        "glosses": [
                                            "Cavalier hongrois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f90ff24-3ca8-3548-8c7c-0542be1b81c9",
                                        "entry_id": "5a4df68e-938d-3784-b956-4f3ba37cb333",
                                        "glosses": [
                                            "Soldat du corps de cavalerie légère dont l’uniforme rappelait celui de la cavalerie hongroise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6715c6a7-7a72-4ea7-b83c-258a7b9688a1",
                                                "sense_id": "2f90ff24-3ca8-3548-8c7c-0542be1b81c9",
                                                "text": "Là étaient les débris vivants des meurtrières rencontres des premiers jours : dragons, zouaves, chasseurs de Vincennes, turcos, soldats de la ligne, hussards, lanciers, tous hâves, silencieux, mornes, traînant ce qui leur restait de souffle."
                                            },
                                            {
                                                "example_id": "ce5308dc-a8a8-4f56-b101-80fed2c9ea65",
                                                "sense_id": "2f90ff24-3ca8-3548-8c7c-0542be1b81c9",
                                                "text": "Guerre vaine, où l’on ne capturera pas des chevau-légers bleus, des hussards blancs, mais dans la même veste grise, des garçons de café, des peintres de Dresde qui découpent déjà en cubes la sentinelle berrichonne qui les conduit à l'arrière."
                                            },
                                            {
                                                "example_id": "4469f1e0-3dcf-46ae-afc6-e2a4508d7b0f",
                                                "sense_id": "2f90ff24-3ca8-3548-8c7c-0542be1b81c9",
                                                "text": "On dirait que rien ne s'est passé depuis l'heureux temps où les reines toisaient leurs hussards cornemusistes du centre sévère de leurs faces-à-main. C'étaient les soupapes de l'Empire, et le monde allait aussi bien que possible."
                                            },
                                            {
                                                "example_id": "633844a4-53e6-4fb0-b413-da5d8494d45f",
                                                "sense_id": "2f90ff24-3ca8-3548-8c7c-0542be1b81c9",
                                                "text": "« S’il est aussi grand que tu le dis, il n’a certainement pas servi dans les hussards, qui appartiennent à la cavalerie légère. »\nComme il vit que j’étais un peu déçu, il ajouta :\n« Dans les dragons, c’est possible, ou même dans les cuirassiers… »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48724b49-68c6-3f82-a9c4-cda70348ee71",
                                        "entry_id": "5a4df68e-938d-3784-b956-4f3ba37cb333",
                                        "glosses": [
                                            "Militaire de la cavalerie légère blindée."
                                        ],
                                        "tags": [
                                            "Aujourd'hui"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04a4be1d-62aa-4ac3-9035-54f4af444bb7",
                        "source_entry_id": "98bd91e9-f743-3e71-9b0f-daef292c1c84",
                        "source_sense_description": "light cavalry of any of several European armies",
                        "target_lang_word": "Husar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Husar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d0d8316-2bcf-3099-b2f3-767a00d6f350",
                                        "entry_id": "cd1a4ae4-3770-3ba8-a1dc-666ef66d3eb6",
                                        "glosses": [
                                            "berittener (ursprünglich ungarischer) Soldat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1228df8d-b664-4151-ae05-d12aee4d92eb",
                                                "sense_id": "4d0d8316-2bcf-3099-b2f3-767a00d6f350",
                                                "text": "Die Husaren stürmten in der Schlacht voran."
                                            },
                                            {
                                                "example_id": "a784b008-dc7e-4c66-80b7-7d7b16dabb4e",
                                                "sense_id": "4d0d8316-2bcf-3099-b2f3-767a00d6f350",
                                                "text": "„Zwei weitere Husaren von der gleichen Statur hatten sich hinter einer Bank aufgestellt - der kaiserliche Kammerherr wollte wohl kein Risiko eingehen.“"
                                            },
                                            {
                                                "example_id": "c16640dc-6e0a-4c08-a340-9a6bd631495a",
                                                "sense_id": "4d0d8316-2bcf-3099-b2f3-767a00d6f350",
                                                "text": "„Sie mußten zur Seite springen, sich an eine Häuserwand drängen, denn die ganze Straße wurde von einer Schwadron roter Husaren eingenommen, die in so schnellem Trab in Kriegsausrüstung vorbeizogen, daß die Karabiner auf ihren Rücken hin und her hüpften.“"
                                            },
                                            {
                                                "example_id": "0fabb95b-f544-4eaf-86d0-22db21a78e10",
                                                "sense_id": "4d0d8316-2bcf-3099-b2f3-767a00d6f350",
                                                "text": "„Murat erschien als Erster im Zentrum von Moskau, eskortiert von Württemberger Husaren.“"
                                            },
                                            {
                                                "example_id": "73eef6ff-8f04-4d11-9d8e-ddb31e394103",
                                                "sense_id": "4d0d8316-2bcf-3099-b2f3-767a00d6f350",
                                                "text": "„Für die Husaren des Pawlogradschen Regiments aber war dieser ganze Rückzug, der in der günstigsten Jahreszeit und unter guten Verpflegungsverhältnissen vor sich ging, die einfachste und lustigste Sache der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
