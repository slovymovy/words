                "senses": [
                    {
                        "sense_id": "371a8e5b-2bb0-38b8-a322-2d7059dc87d4",
                        "entry_id": "beea026d-200e-3273-bef0-d63caf4fc53c",
                        "glosses": [
                            "Participer (en commun avec d'autres)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ee51b3-13ab-47a8-8623-24ccdd65682a",
                                "sense_id": "371a8e5b-2bb0-38b8-a322-2d7059dc87d4",
                                "text": "Il lui faut coparticiper à la possession de plusieurs morceaux."
                            },
                            {
                                "example_id": "646124f9-e82c-464b-b81e-ca2cc7fac544",
                                "sense_id": "371a8e5b-2bb0-38b8-a322-2d7059dc87d4",
                                "text": "Elle ne pouvait pas se contenter de coparticiper, de n'être qu'une voix consultative."
                            },
                            {
                                "example_id": "2054c5b4-b764-49ce-9164-4562036945fc",
                                "sense_id": "371a8e5b-2bb0-38b8-a322-2d7059dc87d4",
                                "text": "« Non sans une crâne audace, il adopte le point de vue d’un Dieu coparticipant, aux côtés de l’homme, à la (re)construction du monde. »"
                            }
                        ]
                    }
