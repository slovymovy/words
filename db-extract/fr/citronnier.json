                    },
                    {
                        "translation_id": "d0c9f8b4-4371-4537-b110-a46552385936",
                        "source_entry_id": "286d8f98-4ce1-3af7-ae08-326454b5bc0f",
                        "target_lang_word": "cytryna zwyczajna",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
