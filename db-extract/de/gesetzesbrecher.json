                "senses": [
                    {
                        "sense_id": "927c2926-a1f1-3658-a65e-9f791cc534c7",
                        "entry_id": "bbea5299-010c-3e2f-b95e-a519b635376e",
                        "glosses": [
                            "Person, die geltende Gesetze verletzt/verletzt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11027cf-7bf2-4948-9471-0a6e5ef85061",
                                "sense_id": "927c2926-a1f1-3658-a65e-9f791cc534c7",
                                "text": "„Doch am sehnsüchtigsten wurde das Eintreffen der Gesetzesbrecher erwartet, die - in Eisen gelegt - aus dem Gefängnis heranschlurften und ihre Geschichten erzählten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f0c7dbb-1f50-49ed-b4c3-f02bfb137d98",
                        "source_entry_id": "bbea5299-010c-3e2f-b95e-a519b635376e",
                        "source_sense_id": "927c2926-a1f1-3658-a65e-9f791cc534c7",
                        "source_sense_description": "Person, die geltende Gesetze verletzt/verletzt hat",
                        "target_lang_word": "lawbreaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lawbreaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                                        "entry_id": "dffe938c-661f-3f79-8c90-12515e6f2c6b",
                                        "glosses": [
                                            "One who breaks (violates) the law, a criminal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf2914d0-6918-478c-88b5-1bc7922238a4",
                                                "sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                                                "text": "I'm just a poor old man. I have no time for law-breakers. My legs are grey. My ears are gnarled. My eyes are old and bent."
                                            },
                                            {
                                                "example_id": "1f11c07b-6e31-430a-b25c-7a693a91f898",
                                                "sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                                                "text": "People often assume that speedboarders are disrespectful lawbreakers."
                                            },
                                            {
                                                "example_id": "9ba00557-a4d9-4437-ab0c-ded6343b9a93",
                                                "sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                                                "text": "Mr. Grimm pleaded guilty to a single count of tax fraud and was convicted in July 2015; he went on to serve eight months in prison. Lawmaker, law enforcer and lawbreaker — that’s a heck of a résumé, and alliterative, too!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
