                "senses": [
                    {
                        "sense_id": "3b50c1a9-2aee-325d-9d21-0341e786e30a",
                        "entry_id": "756d5d39-229e-399a-8504-0ecf665d01d4",
                        "glosses": [
                            "kurzer, spannender Ausflug, der nicht fernab vom Wohnort häufig im Freien stattfindend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8454b98-ab99-407c-a713-db7d7059d85c",
                                "sense_id": "3b50c1a9-2aee-325d-9d21-0341e786e30a",
                                "text": "„Der Zwilling braucht das Gefühl, jederzeit gehen zu können, wohin es ihn auch zieht, und sei es nur ein Mikroabenteuer, aber genauso muss er wissen, dass er von jetzt auf gleich zurück in sein gemütliches Bettchen krabbeln kann.“"
                            },
                            {
                                "example_id": "40b7b1b0-8b78-4151-8746-ece70d3bddb7",
                                "sense_id": "3b50c1a9-2aee-325d-9d21-0341e786e30a",
                                "text": "„Wenn ihr euch in euer erstes Mikroabenteuer stürzen wollt und eine Übernachtung unter freien Himmel plant, ist es völlig unnötig, erst auf eine Profi-Outdoorausrüstung, auf die Reinhold Messner neidisch werden würde, zu sparen.“"
                            },
                            {
                                "example_id": "4782179f-3f86-4c22-97bf-7e5fae5b5580",
                                "sense_id": "3b50c1a9-2aee-325d-9d21-0341e786e30a",
                                "text": "„Wenn ich mich auf ein Mikroabenteuer begebe, um den Sonnenaufgang am Berg zu bestaunen, packe ich mir gerne ein würziges Käsebrot mit Spiegelei und Salat ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
