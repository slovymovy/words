                "senses": [
                    {
                        "sense_id": "65b06256-92e6-3da1-b98b-8b016b0a0be1",
                        "entry_id": "939faa99-363b-3228-bf45-1b97ee358790",
                        "glosses": [
                            "Ladentisch"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "df9863b1-8e4d-48ef-9443-ecfe530df381",
                                "sense_id": "65b06256-92e6-3da1-b98b-8b016b0a0be1",
                                "text": "Der sitzt unter de Tonbank un spielt mit's Hack. - (Bruchstück eines Klein-Erna-Witzes)"
                            },
                            {
                                "example_id": "34d5eca9-c37d-4854-ad13-259b109cd890",
                                "sense_id": "65b06256-92e6-3da1-b98b-8b016b0a0be1",
                                "text": "„Wir hoffen, du kommst mit, sagte er leise, lauschte den Gang hinab, packte mich an der Brust, zog mich über die behelfsmäßige Tonbank zu sich heran.“"
                            },
                            {
                                "example_id": "165ef424-0e7f-4bdc-8e76-bb16113e129b",
                                "sense_id": "65b06256-92e6-3da1-b98b-8b016b0a0be1",
                                "text": "„Kalübbe geht durch den Mittelgang der Gaststube zur Tonbank hin.“"
                            },
                            {
                                "example_id": "752bfaa3-d3d4-47e2-8ede-933d33323170",
                                "sense_id": "65b06256-92e6-3da1-b98b-8b016b0a0be1",
                                "text": "„Wer im Blauen Schimmel Bescheid weiß, schenkt sich darum selber ein und legt das Geld auf die Tonbank, und der Wirt tut so, als ginge ihn das kein bißchen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
