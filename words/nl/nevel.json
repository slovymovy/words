                },
                {
                    "sense_id": "e8e619d6-ccb9-3a6c-8d7e-010f2acfb125",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>nevelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Nevel</w> je de orchideeën even in voordat je weggaat?",
                            "target_lang_translations": {
                                "ru": "Ты <w>опрыскиваешь</w> орхидеи перед уходом?",
                                "en": "Will you <w>mist</w> the orchids briefly before you leave?",
                                "fr": "Est-ce que tu <w>brumises</w> un peu les orchidées avant de partir ?"
                            }
                        },
                        {
                            "text": "Waarom <w>nevel</w> je zoveel water op die ene plek?",
                            "target_lang_translations": {
                                "ru": "Почему ты <w>распыляешь</w> столько воды в одном месте?",
                                "en": "Why do you <w>spray</w> so much water on that one spot?",
                                "fr": "Pourquoi <w>vaporises</w>-tu autant d'eau à cet endroit précis ?"
                            }
                        }
                    ],
