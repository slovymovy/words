            {
                "entry_id": "47cb07da-26d6-310a-af26-e8e8994c9f7f",
                "word": "Robin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3e3cecc-0b76-36f6-8565-b63b3a74b6e9",
                        "entry_id": "47cb07da-26d6-310a-af26-e8e8994c9f7f",
                        "glosses": [
