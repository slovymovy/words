                ],
                "senses": [
                    {
                        "sense_id": "9409d86c-9ffb-3afe-91bb-7c788329679d",
                        "entry_id": "95560133-570a-3260-9b5d-3e0fcb47c99a",
                        "glosses": [
                            "intensiv erfahrener Moment des Sonnenscheins, wie etwa der erste Lichtstrahl am Morgen, der letzte am Abend oder ein kurzer Sonnenstrahl, der an einem bewölkten Tag durch die Wolken bricht"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "e07c12c5-45ec-46c1-8680-87795714db54",
                                "sense_id": "9409d86c-9ffb-3afe-91bb-7c788329679d",
                                "text": "„Da, am letzten Tag gegen Mittag ein Sonnengruß! Die dicken Wolkenmassen schoben sich auseinander; ein paar armselige Sonnenstrahlen stahlen sich schüchtern zur Erde nieder. Leni, die eben daran gewesen war, ihren Badeanzug in den Koffer zu packen, hielt damit inne.“"
                            },
                            {
                                "example_id": "37eb1ca4-646e-4e34-9c08-b04b4f2f4d02",
                                "sense_id": "9409d86c-9ffb-3afe-91bb-7c788329679d",
                                "text": "„Es war Spätherbst, letzter Sonnengruß spiegelte sich in den Scheiben.“"
                            },
                            {
                                "example_id": "fdb7a051-f089-4519-9b46-8571e7d8124b",
                                "sense_id": "9409d86c-9ffb-3afe-91bb-7c788329679d",
                                "text": "„Da begann in der blauen Dämmerung plötzlich die Waldkuppe des Schwarzbrunner Berges wundervoll zu leuchten von einem letzten Sonnengruß unter fernen Wolken.“"
                            },
                            {
                                "example_id": "1472c025-66e1-4a4b-874f-4b96939d623c",
                                "sense_id": "9409d86c-9ffb-3afe-91bb-7c788329679d",
                                "text": "„Um vier Uhr, als es draußen hell geworden war und der Himmel perlmuttern schimmerte von ersten, fernen Sonnengrüßen, wachte Cornelius Friebott auf; er meinte, die kräftige Morgenluft, die durch das Fenster strich, habe ihn geweckt.“"
                            },
                            {
                                "example_id": "e6212381-9627-4b12-869f-e4251ee5beec",
                                "sense_id": "9409d86c-9ffb-3afe-91bb-7c788329679d",
                                "text": "„Darüber war der flüchtige Sonnengruss vorüber; es dunkelte, und nun ward's auf ein halb Stündchen lebendig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d749b6ea-fea8-3b28-8032-56453f2b75a1",
                        "entry_id": "95560133-570a-3260-9b5d-3e0fcb47c99a",
                        "glosses": [
                            "Abfolge von üblicherweise zwölf Yogahaltungen (Asanas), die im Atemrhythmus ineinander übergehend geübt werden, insbesondere als Aktivierungsübung am Morgen oder zum Aufwärmen zu Beginn einer Yogastunde"
                        ],
                        "tags": [
                            "Yoga"
                        ],
                        "examples": [
                            {
                                "example_id": "f023dcd3-b099-43c3-b645-8d11172617ca",
                                "sense_id": "d749b6ea-fea8-3b28-8032-56453f2b75a1",
                                "text": "„Wir tasten uns an den Sonnengruss und klassische Yogapositionen heran, erkunden den Atem und praktizieren Atemübungen und Meditation.“"
                            },
                            {
                                "example_id": "414df180-aea1-4a85-9d3c-3dd2c97b26ae",
                                "sense_id": "d749b6ea-fea8-3b28-8032-56453f2b75a1",
                                "text": "„Nach einem sanften Ankommen in deinem Körper vitalisierst du dein ganzes System über verschiedene Varianten von Sonnengrüßen und Flows.“"
                            },
                            {
                                "example_id": "c2d2a33a-edbd-4659-95d1-f1071d6cee84",
                                "sense_id": "d749b6ea-fea8-3b28-8032-56453f2b75a1",
                                "text": "„Du hast schon mal YOGA gemacht und kennst den Sonnengruß und die Grundasanas und möchtest einfach YOGA praktizieren?“"
                            },
                            {
                                "example_id": "814ce1b4-4ab2-47a6-9f36-6ad9d41ec096",
                                "sense_id": "d749b6ea-fea8-3b28-8032-56453f2b75a1",
                                "text": "„Du fließt in dieser Stunde durch den Sonnengruß, Surya Namaskar – eine anstrengende und dynamische Yogapraxis, bei der du deine inneren und äußeren Widerstände kennen und zu meistern lernst.“"
                            },
                            {
                                "example_id": "c1824f21-cd5e-47d6-9a73-4fdd12607016",
                                "sense_id": "d749b6ea-fea8-3b28-8032-56453f2b75a1",
                                "text": "„Du wirst bei verschiedenen Lehrer*innen [sic] verschiedene Sonnengrüße üben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
