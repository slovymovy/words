                "senses": [
                    {
                        "sense_id": "0603d997-4d94-3fd7-990a-4a4a543f79ba",
                        "entry_id": "95ae5514-95d1-3a67-b507-db3bc479276e",
                        "glosses": [
                            "One of the six parts of the writings of the Greek-speaking philosopher Plotinus (c. 204–205 – 270), each containing nine treatises, compiled by his student Porphyry (c. 234 – c. 305)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1c746b-5389-4914-baef-f3d090d0d38a",
                                "sense_id": "0603d997-4d94-3fd7-990a-4a4a543f79ba",
                                "text": "Which Darkneſs is a fourth Property of the Moſaick Matter, and on which Plotinus inſiſts pretty copiouſly in this ſecond Ennead, and contends we can have no other notion of it, […]"
                            },
                            {
                                "example_id": "b8fd2c1e-6435-4ce4-95b0-09697c3c70f3",
                                "sense_id": "0603d997-4d94-3fd7-990a-4a4a543f79ba",
                                "text": "[W]e find side by side in the Enneads the positive and negative conceptions of the One."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
