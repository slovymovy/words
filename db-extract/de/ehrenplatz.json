                "senses": [
                    {
                        "sense_id": "3515e0a0-d37f-3b1f-a9a4-a11af78bc01b",
                        "entry_id": "97197513-a26b-33a2-9fee-fa1c535ec1e1",
                        "glosses": [
                            "Platz, dessen Inhaber dadurch geehrt wird, dass er diesen Platz einnehmen darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "842c4f57-3dee-46ca-ace0-d0222ee2d60f",
                                "sense_id": "3515e0a0-d37f-3b1f-a9a4-a11af78bc01b",
                                "text": "„Ach, das waren noch Zeiten, als Aggression, Kampf und sinnlose Gewalt einen Ehrenplatz in der Gesellschaft einnahmen.“"
                            },
                            {
                                "example_id": "7255a23e-7248-492b-8d58-94a2002635d8",
                                "sense_id": "3515e0a0-d37f-3b1f-a9a4-a11af78bc01b",
                                "text": "In einer Tischrunde ist der Platz am Kopf des Tisches oft der Ehrenplatz, den zum Beispiel das Familienoberhaupt oder ein Ehrengast einnehmen darf."
                            },
                            {
                                "example_id": "a4ae2289-1ea3-4632-9dfe-5986a5cb15ef",
                                "sense_id": "3515e0a0-d37f-3b1f-a9a4-a11af78bc01b",
                                "text": "„Nach dem Rundgang serviert uns seine Frau Tee und weist uns einen Ehrenplatz in der Hollywoodschaukel zu.“"
                            },
                            {
                                "example_id": "1aaa5cdd-3e5a-4e02-a45f-fe404c83e070",
                                "sense_id": "3515e0a0-d37f-3b1f-a9a4-a11af78bc01b",
                                "text": "„Onkel Gerhard, als der Älteste auf einem Ehrenplatz den Brautleuten gegenüber, klopft ans Glas.“"
                            },
                            {
                                "example_id": "42eaa8f1-8fdc-4c0d-800f-8164c742e1e4",
                                "sense_id": "3515e0a0-d37f-3b1f-a9a4-a11af78bc01b",
                                "text": "„Väsele Li wurde der Ehrenplatz angewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
