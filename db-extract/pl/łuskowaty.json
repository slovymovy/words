                    {
                        "translation_id": "d0a55b62-f2e7-4188-bcb9-f923a430e109",
                        "source_entry_id": "5010f258-30a5-3bbc-964d-55309fddf03a",
                        "source_sense_id": "65c33239-c2b7-321a-87d3-1a0367acbcc1",
                        "target_lang_word": "schuppig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schuppig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab33334-93c9-358d-b6cd-da655c003627",
                                        "entry_id": "f3fead26-721a-3c88-880b-dfaeb1bee1c8",
                                        "glosses": [
                                            "uneben, oftmals durch kleine, hochstehende Hautablösungen gekennzeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af80b7a-5047-487d-885c-cb31a47e8bc0",
                                                "sense_id": "3ab33334-93c9-358d-b6cd-da655c003627",
                                                "text": "„Das Gesicht ist rot und schuppig und zeigt dicke Lidfalten.“"
                                            },
                                            {
                                                "example_id": "e34c4eef-9170-430a-a260-691ff6c7e7c3",
                                                "sense_id": "3ab33334-93c9-358d-b6cd-da655c003627",
                                                "text": "„Wenn also der Körper zu wenig Selen zur Verfügung hat, dann kann es dazu kommen, dass er beispielsweise eine schuppige Haut hat, keine Kinder kriegen kann, nicht groß und kräftig heranwächst, sich leichter eine Erkältung einfängt oder auch dass er schneller herzkrank wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f4cb2d5-49b1-361b-ab8a-562c43791d99",
                                        "entry_id": "f3fead26-721a-3c88-880b-dfaeb1bee1c8",
                                        "glosses": [
                                            "mit Schuppen bedeckt"
                                        ],
                                        "tags": [
                                            "bei Fischen oder Reptilien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0179aaf-d857-4fe7-b8a2-fa8c797edf9e",
                                                "sense_id": "6f4cb2d5-49b1-361b-ab8a-562c43791d99",
                                                "text": "„Fisch und Vitamine? Nein, die schuppigen Tiere kräftigen das Immunsystem vor allem durch das Spurenelement Selen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
