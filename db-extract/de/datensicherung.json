                "senses": [
                    {
                        "sense_id": "9baf0edb-5665-35bf-976c-1a0e1b1f8383",
                        "entry_id": "27be3f26-3afa-3d3d-aab2-32278323bb8b",
                        "glosses": [
                            "Vorgang in der Computertechnik zur Sicherung von Daten gegen unerwünschte Veränderung oder Verlust durch einmalige oder regelmäßige Anfertigung einer oder mehrerer Kopien des zu sichernden Datenbestandes bei gleichzeitiger Dokumentation von Herkunft der Quelldaten und Zeitpunkt der Erstellung."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3375c5f-99e7-4e99-a6ac-f2aa9d755202",
                                "sense_id": "9baf0edb-5665-35bf-976c-1a0e1b1f8383",
                                "text": "Zuständig für die tägliche Datensicherung ist der Systemadministrator."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d1c4f4e8-e250-39d3-a879-dbeb5e4634b9",
                        "entry_id": "27be3f26-3afa-3d3d-aab2-32278323bb8b",
                        "glosses": [
                            "das Ergebnis des in [1] beschriebenen Vorgangs. Meist als Bezeichnung eines Datenträgers verwendet, auf dem die Kopie der gesicherten Daten gespeichert ist. Richtig: Sicherungskopie."
                        ],
