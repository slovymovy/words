                ],
                "senses": [
                    {
                        "sense_id": "b38ef4a9-134f-3d9c-9906-8971a871698f",
                        "entry_id": "803a9a39-780d-36e2-90f3-2e38286200d5",
                        "glosses": [
                            "Hinrichtungsart, bei der eine Person an einen aufrechten Pfahl genagelt oder gefesselt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e710b664-d4db-4273-8bba-3fde361cf045",
                                "sense_id": "b38ef4a9-134f-3d9c-9906-8971a871698f",
                                "text": "Kreuzigungen waren im alten Orient und in der Antike weit verbreitet. Im römischen Reich wurden sie nur bei schweren Verbrechen oder an Nichtrömern und Sklaven angewandt."
                            },
                            {
                                "example_id": "6f3c54b4-0950-4623-b709-e36e47841861",
                                "sense_id": "b38ef4a9-134f-3d9c-9906-8971a871698f",
                                "text": "Der Kreuzigung Jesu wird an Karfreitag gedacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b20dd03-db5f-4d49-afc6-3b83a9a29bf0",
                        "source_entry_id": "803a9a39-780d-36e2-90f3-2e38286200d5",
                        "source_sense_id": "b38ef4a9-134f-3d9c-9906-8971a871698f",
                        "source_sense_description": "Hinrichtungsart, bei der eine Person an einen aufrechten Pfahl genagelt oder gefesselt wird",
                        "target_lang_word": "crucifixion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucifixion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f4c1a9-8e6f-348d-9d7d-bd38209d0eef",
                                        "entry_id": "34667845-cac8-33e1-afd6-087ea8b4f594",
                                        "glosses": [
                                            "An execution by being nailed or tied to an upright cross and left to hang there until dead."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bffb09a-1d39-4208-bb37-8e9701dc8bdd",
                                                "sense_id": "f8f4c1a9-8e6f-348d-9d7d-bd38209d0eef",
                                                "text": "Rome used crucifixions as a deterrent, and standard for the 'vilest' crimes, such as slave rebellion."
                                            },
                                            {
                                                "example_id": "7ca8a1c5-77c6-4d9c-9e5a-fc62365985f9",
                                                "sense_id": "f8f4c1a9-8e6f-348d-9d7d-bd38209d0eef",
                                                "text": "Centurion: Stabbed? Takes a second. Crucifixion lasts hours! It's a slow, horrible death! / Matthias: Well, at least it gets you out in the open air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5fd5a55-4fd6-3781-8fcc-d5ad954f2cb9",
                                        "entry_id": "34667845-cac8-33e1-afd6-087ea8b4f594",
                                        "glosses": [
                                            "An execution by being nailed or tied to an upright cross and left to hang there until dead.",
                                            "The death of Jesus Christ on the Cross."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90d2e609-721b-34fb-aeb6-84243391d997",
                                        "entry_id": "34667845-cac8-33e1-afd6-087ea8b4f594",
                                        "glosses": [
                                            "The military punishment of being tied to a fixed object, often with the limbs in a stretched position."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eda56a33-c421-3017-a18c-7e82b0c2d4e6",
                                        "entry_id": "34667845-cac8-33e1-afd6-087ea8b4f594",
                                        "glosses": [
                                            "An ordeal, terrible, especially malicious treatment imposed upon someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfd0cd19-d641-4d9e-af68-73661c4200c3",
                                                "sense_id": "eda56a33-c421-3017-a18c-7e82b0c2d4e6",
                                                "text": "The suspects' hostile interrogation amounted to a public crucifixion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4da28e81-99a3-4876-ba39-6508c89be711",
                        "source_entry_id": "803a9a39-780d-36e2-90f3-2e38286200d5",
                        "source_sense_id": "b38ef4a9-134f-3d9c-9906-8971a871698f",
                        "source_sense_description": "Hinrichtungsart, bei der eine Person an einen aufrechten Pfahl genagelt oder gefesselt wird",
                        "target_lang_word": "crucifixion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucifixion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "221fbe2b-15dd-3f4b-a49f-4ad2d0728140",
                                        "entry_id": "30ae00b6-33d6-3f89-bcfb-3fc57866160a",
                                        "glosses": [
                                            "Supplice de la mise en croix ; crucifiement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a83dc22-0aa8-4618-84f4-8037e7f4f9ce",
                                                "sense_id": "221fbe2b-15dd-3f4b-a49f-4ad2d0728140",
                                                "text": "La crucifixion n’était ni un mode d’exécution rapide ni une mise à mort « propre ». C’était une longue et humiliante agonie, pleine de bruits et de fureur, au milieu du sang et des râles. Réellement « le pire des supplices »."
                                            },
                                            {
                                                "example_id": "bf86d9ff-fdf1-41b6-bc36-8e67d0db003a",
                                                "sense_id": "221fbe2b-15dd-3f4b-a49f-4ad2d0728140",
                                                "text": "Jésus est donc condamné à mort, à la pire des morts, celle réservée aux agitateurs politiques et aux esclaves fugitifs : la crucifixion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe39534-432b-3143-8b4f-21e484d0ecda",
                                        "entry_id": "30ae00b6-33d6-3f89-bcfb-3fc57866160a",
                                        "glosses": [
                                            "Crucifiement du Christ."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "note": "Dans ce sens, le mot est souvent doté d’une initiale majuscule",
                                        "examples": [
                                            {
                                                "example_id": "e0ad5bcd-7d52-4595-806b-5fb7f811a404",
                                                "sense_id": "afe39534-432b-3143-8b4f-21e484d0ecda",
                                                "text": "Un tableau de la Crucifixion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8972afcd-1bce-38dd-94e0-8843a04aaf75",
                                        "entry_id": "30ae00b6-33d6-3f89-bcfb-3fc57866160a",
                                        "glosses": [
                                            "Tableau où le crucifiement de Jésus-Christ est représenté."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ee6441-f486-418e-ac57-d000b91325a4",
                                                "sense_id": "8972afcd-1bce-38dd-94e0-8843a04aaf75",
                                                "text": "Au-dessus du chancel, face à la nef s’élève une grande crucifixion. Les croix du Christ et des larrons se dressent sur des monticules de terre truffés de crânes et d’ossements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ff2d6ac-d3e9-488c-8465-a554642d3e87",
                        "source_entry_id": "803a9a39-780d-36e2-90f3-2e38286200d5",
                        "source_sense_id": "b38ef4a9-134f-3d9c-9906-8971a871698f",
                        "source_sense_description": "Hinrichtungsart, bei der eine Person an einen aufrechten Pfahl genagelt oder gefesselt wird",
                        "target_lang_word": "crucifixión",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucifixión",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "34406006-c9f2-306d-bbef-ef075c40533b",
                                        "entry_id": "013e2c00-66e1-3941-bf06-1813bd2a886c",
                                        "glosses": [
                                            "Acción o efecto de crucificar, clavar a alguien en una cruz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0c91d0-9381-48ad-9491-c10a2b597432",
                                                "sense_id": "34406006-c9f2-306d-bbef-ef075c40533b",
                                                "text": "Y porque lo que duró la crucifixión fué de dolor increíble, mayor que el que sufrieron todos los mártires, y junto con eso tuvo más de deshonra, por ser castigo de infames y gente facinerosa, sin duda fué este el paso más riguroso y terrible, más digno de consideración y sentimiento."
                                            },
                                            {
                                                "example_id": "4c938696-b38b-4d65-9a64-2fd20a3d2554",
                                                "sense_id": "34406006-c9f2-306d-bbef-ef075c40533b",
                                                "text": "Y todos los habitantes de Bagdad afluían por las calles para presenciar la crucifixión de Giafar y sus primos, sin que nadie supiese la causa; y todo el mundo se condolía y se lamentaba de aquel castigo, pues el visir y los Baramka eran muy apreciados por su generosidad y sus buenas obras."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f24082e-779b-3c17-b315-2da54a165b65",
                                        "entry_id": "013e2c00-66e1-3941-bf06-1813bd2a886c",
                                        "glosses": [
                                            "Representación de una crucifixión₁, en especial de la de Jesucristo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e44ea0-83e7-4c1f-9771-181428ac6fab",
                                                "sense_id": "3f24082e-779b-3c17-b315-2da54a165b65",
                                                "text": "sobresalían por su buen dibujo y entonación vigorosa lose seis de la familia del archiduqe Leopoldo, y una Crucifixión, estimada como el principal ornato del Dormitorio del Rey."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
