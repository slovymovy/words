                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "2706e84e-5e48-43bd-9c85-e91989c9126a",
                                "sense_id": "0824062c-c634-30b3-8e89-643dc25918ae",
                                "text": "Die wenigen weiblichen Dienstboten, die ihm schon angehörten, schlugen zwar zuweilen eine schärfere Tonart an, wenn die Erinnerung an all die erlittene Unbill sie überwältige, aber sie trugen schwarzweiße Kokarden und verwahrten sich nachdrücklich dagegen, mit der Arbeiterbewegung irgend etwas gemeinsam zu haben.",
                                "translation": "Memoirs of a Woman Socialist",
                                "english": "Memoirs of a Woman Socialist"
                            }
                        ]
                    }
