                    {
                        "sense_id": "fa55fdb5-3ca6-398f-9293-ea72630e2dd6",
                        "entry_id": "cd0b3dad-d4aa-39ae-abae-7fec4d2055a2",
                        "glosses": [
                            "Qui n’aime pas ou a peur de la technologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb21be79-2dc6-4689-a75d-2c20974f98da",
                                "sense_id": "fa55fdb5-3ca6-398f-9293-ea72630e2dd6",
                                "text": "Votre tante technophobe est sur Facebook non parce qu’elle le veut, mais parce qu’elle pense qu’elle le doit, et c’est un peu vrai."
                            },
                            {
                                "example_id": "c59e44a1-158f-41a7-ba76-6875a4a16f1e",
                                "sense_id": "fa55fdb5-3ca6-398f-9293-ea72630e2dd6",
                                "text": "Le genre d’événement qui pousse les plus technophobes à dire qu’il faudrait tout débrancher."
                            },
                            {
                                "example_id": "55304435-5dac-4db4-b8e9-4d9e97ee9b2a",
                                "sense_id": "fa55fdb5-3ca6-398f-9293-ea72630e2dd6",
                                "text": "Mon Manifeste cyborg était donc l’affirmation que le féminisme, dans un monde où les machines ­deviennent omniprésentes, ne peut se permettre d’être technophobe."
                            }
                        ]
                    }
