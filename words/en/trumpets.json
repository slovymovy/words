                    "semantic_group_id": "musical_instruments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jazz band featured three <w>trumpets</w> playing in perfect harmony.",
                            "target_lang_translations": {
                                "ru": "В джазовом оркестре было три <w>трубы</w>, игравшие в идеальной гармонии."
                            }
                        },
                        {
                            "text": "He polished his <w>trumpets</w> before the big concert started.",
                            "target_lang_translations": {
                                "ru": "Он начистил свои <w>трубы</w> перед началом большого концерта."
                            }
                        }
                    ],
                    "common_phrases": [
