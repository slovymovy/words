                ],
                "senses": [
                    {
                        "sense_id": "94f147c3-155c-38f7-9972-107458b05158",
                        "entry_id": "528b030a-ba55-364e-96f3-98b6d52d4bc5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed51a719-6892-4219-a508-069d274ea656",
                                "sense_id": "94f147c3-155c-38f7-9972-107458b05158",
                                "text": "Frau Eyth ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "83ca9618-f6ab-45b7-a3f2-8f324784301b",
                                "sense_id": "94f147c3-155c-38f7-9972-107458b05158",
                                "text": "Herr Eyth wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5dc05e5e-4ba7-48a7-a1c5-37b0e1fe8bed",
                                "sense_id": "94f147c3-155c-38f7-9972-107458b05158",
                                "text": "Die Eyths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "76de6e57-2788-4830-9954-7e6ad61911d2",
                                "sense_id": "94f147c3-155c-38f7-9972-107458b05158",
                                "text": "Der Eyth trägt nie die Schals, die die Eyth ihm strickt."
                            },
                            {
                                "example_id": "3ee75b06-9e0c-4b0c-82ec-ec72a0ce1f10",
                                "sense_id": "94f147c3-155c-38f7-9972-107458b05158",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eyth kommt, geht der Herr Eyth.“"
                            },
                            {
                                "example_id": "1b3f3df8-e5f4-476e-b010-a6f5abfd22b5",
                                "sense_id": "94f147c3-155c-38f7-9972-107458b05158",
                                "text": "Eyth kommt und geht."
                            },
                            {
                                "example_id": "4f375fb2-e249-48f1-918d-267799de7430",
                                "sense_id": "94f147c3-155c-38f7-9972-107458b05158",
                                "text": "Eyths kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
