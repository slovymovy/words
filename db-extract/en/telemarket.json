                        "sense_id": "9e7b427c-c763-3bec-9052-1106d2b76a89",
                        "entry_id": "592e7d70-d51f-3817-8373-911aabf9f3b9",
                        "glosses": [
                            "To engage in telemarketing (unsolicited telephone calls to potential customers)."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5f86f53c-8110-4e71-b19d-f69df16d84fc",
                                "sense_id": "9e7b427c-c763-3bec-9052-1106d2b76a89",
                                "text": "If people hate to receive telephone sales calls, why should you telemarket?"
                            },
                            {
                                "example_id": "bd77f8d8-6142-4d36-8b68-194104de6937",
                                "sense_id": "9e7b427c-c763-3bec-9052-1106d2b76a89",
                                "text": "I tried canvassing for a paint company, and failed. I telemarketed for another business, and failed. I had no people skills."
                            },
                            {
                                "example_id": "80b1fde8-72ca-4cfc-a87d-29acd44ff9a9",
                                "sense_id": "9e7b427c-c763-3bec-9052-1106d2b76a89",
                                "text": "In addition, nearly every company that telemarkets is subject to the FCC's telemarketing rules, which were expanded in July 2003..."
                            }
                        ]
                    }
