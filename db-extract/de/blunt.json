                            {
                                "target_word": "blunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5edf0f0-1fb1-340a-a64f-65914a509b28",
                                        "entry_id": "df38aa16-a76f-361b-811f-ec38bfe5e436",
                                        "glosses": [
                                            "To dull the edge or point of, by making it thicker; to make blunt."
