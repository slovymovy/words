                ],
                "senses": [
                    {
                        "sense_id": "9123325b-9784-366f-8693-e8f28ef60b84",
                        "entry_id": "d5264536-e6ad-315b-a023-57a8f03db947",
                        "glosses": [
                            "äußerst wütend, mit sehr viel Wut (Zorn)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7a04839-a8e1-4815-b3e5-3611f42f782c",
                                "sense_id": "9123325b-9784-366f-8693-e8f28ef60b84",
                                "text": "„Und die beiden Herren stürzten zornbebend die Straße hinab, ein jeder nach seiner Seite.“"
                            },
                            {
                                "example_id": "863f4137-d381-4f6f-bcee-33a34e1308e1",
                                "sense_id": "9123325b-9784-366f-8693-e8f28ef60b84",
                                "text": "„Erneut sprang Walter auf und schrie, seine Hände zornbebend in die Seiten gestemmt, die angebliche Miss Kellaway an, sie sei eine Schwindlerin.“"
                            },
                            {
                                "example_id": "160844b3-63cf-4354-bd90-ec7035f2e43f",
                                "sense_id": "9123325b-9784-366f-8693-e8f28ef60b84",
                                "text": "„Eine jüngere Journalistin drängte sich vor und baute sich zornbebend vor den Ärzten auf.“"
                            },
                            {
                                "example_id": "0e8cd66e-0528-453d-8968-50adc12448ba",
                                "sense_id": "9123325b-9784-366f-8693-e8f28ef60b84",
                                "text": "„‚Hüte dich,‘ scholl die zornbebende Stimme der Alten ihr nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
