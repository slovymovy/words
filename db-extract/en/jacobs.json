                    {
                        "sense_id": "4a255798-e500-30f9-a5d1-a7a2e7e3b8d6",
                        "entry_id": "f63c90b7-9219-3b3c-b0e6-2bbc5156996b",
                        "glosses": [
                            "Testicles (sometimes spelt Jacob's)."
                        ],
                        "tags": [
                            "UK",
