                    {
                        "form_id": "d2a5c7cd-65c5-4c61-9c14-d74a761f665e",
                        "entry_id": "6369eba4-85ab-3a4c-84f5-f82858782e6e",
                        "tags": [
                            "accusative",
                            "singular",
                            "neuter"
                        ],
                        "form": "dasjenige"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "008de364-68c0-3dad-a141-2c5b1c432bcb",
                        "entry_id": "6369eba4-85ab-3a4c-84f5-f82858782e6e",
                        "glosses": [
                            "Nominativ Plural des Demonstrativpronomens derjenige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2af0d5c2-22e4-4f55-92de-4920243127af",
                                "sense_id": "008de364-68c0-3dad-a141-2c5b1c432bcb",
                                "text": "„Noch gar nicht berücksichtigt sind dabei diejenigen, die nach ihrer Zeit als \"Arzt im Praktikum\" (AiP) den Beruf wechseln“."
                            },
                            {
                                "example_id": "cdfae18c-9073-4c11-b961-9a062a4e32f8",
                                "sense_id": "008de364-68c0-3dad-a141-2c5b1c432bcb",
                                "text": "„Selbst diejenigen, die gar nichts haben, geben noch ab“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5e4b823-a82f-3875-94b6-d63e749454b0",
                        "entry_id": "6369eba4-85ab-3a4c-84f5-f82858782e6e",
                        "glosses": [
                            "Akkusativ Plural des Demonstrativpronomens derjenige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434504f4-acfd-40e0-90a2-313eac4c0ee0",
                                "sense_id": "c5e4b823-a82f-3875-94b6-d63e749454b0",
                                "text": "„Die Freiheit ist immer Freiheit für diejenigen, die anders denken“."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11c7850c-f4b4-4853-a13d-e7521cb323a3",
                        "source_entry_id": "6369eba4-85ab-3a4c-84f5-f82858782e6e",
                        "source_sense_id": "008de364-68c0-3dad-a141-2c5b1c432bcb",
                        "source_sense_description": "Nominativ Plural des Demonstrativpronomens derjenige",
                        "target_lang_word": "those",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "those",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2303bb5a-7ad0-3a7a-b597-abd72ecc5b08",
                                        "entry_id": "1c963155-114e-316d-b858-3f7c1e834c88",
                                        "glosses": [
                                            "plural of that"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9919bd-9c85-4b33-876d-cc2e40ab4aeb",
                                                "sense_id": "2303bb5a-7ad0-3a7a-b597-abd72ecc5b08",
                                                "text": "Those bolts go with these parts."
                                            },
                                            {
                                                "example_id": "e4395a58-c57e-43fb-8c1c-a40cc3478f47",
                                                "sense_id": "2303bb5a-7ad0-3a7a-b597-abd72ecc5b08",
                                                "text": "Forasmuch as many have taken in hand to set forth in order a declaration of those things which are most surely believed among us."
                                            },
                                            {
                                                "example_id": "777ad62a-1d05-485d-a89c-a0df9dc2aac6",
                                                "sense_id": "2303bb5a-7ad0-3a7a-b597-abd72ecc5b08",
                                                "text": "When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose. And the queerer the cure for those ailings the bigger the attraction. A place like the Right Livers' Rest was bound to draw freaks, same as molasses draws flies."
                                            },
                                            {
                                                "example_id": "673601f2-e2cc-453a-8caa-eee4d139a8c7",
                                                "sense_id": "2303bb5a-7ad0-3a7a-b597-abd72ecc5b08",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "those",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d318255-9225-3534-8479-86ef41c905df",
                                        "entry_id": "10710a47-12ab-3aa7-9396-3dfcb2fb9114",
                                        "glosses": [
                                            "plural of that"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fc6fe0a-3c47-4620-a5bd-d404c5935e05",
                                                "sense_id": "6d318255-9225-3534-8479-86ef41c905df",
                                                "text": "don't touch those [those objects over there]"
                                            },
                                            {
                                                "example_id": "f73e465f-f0fe-4007-9410-987cbd86c7e8",
                                                "sense_id": "6d318255-9225-3534-8479-86ef41c905df",
                                                "text": "those who serve [those persons who serve]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
