{
    "word_family": [
        "gangster",
        "gangway",
        "gangplank",
        "gangland",
        "gangmaster",
        "press-gang"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dffe649c-59f4-3885-942a-942989a46f81",
                    "sense_definition": "A group of criminals or young people who band together for mutual protection, profit, or social identity, often associated with a particular territory or illegal activities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are trying to reduce <w>gang</w> violence in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Полиция пытается снизить насилие со стороны <w>банд</w> в этом районе.",
                                "tr": "Polis, mahalledeki <w>çete</w> şiddetini azaltmaya çalışıyor."
                            }
                        },
                        {
                            "text": "He decided to leave the <w>gang</w> and go back to school.",
                            "target_lang_translations": {
                                "ru": "Он решил уйти из <w>банды</w> и вернуться в школу.",
                                "tr": "<w>Çeteden</w> ayrılıp okula geri dönmeye karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "crew",
                        "mob"
                    ],
                    "common_phrases": [
                        "street gang",
                        "gang member",
                        "join a gang",
                        "gang violence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа преступников или молодых людей, объединившихся для защиты, выгоды или социального самоопределения, часто связанная с определенной территорией.",
                        "tr": "Genellikle belirli bir bölge veya yasa dışı faaliyetlerle bağlantılı, karşılıklı koruma, çıkar veya sosyal kimlik amacıyla bir araya gelen suçlu veya genç grubu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банда",
                                "target_lang_sense_clarification": "преступная группировка"
                            },
                            {
                                "target_lang_word": "шайка",
                                "target_lang_sense_clarification": "презрительное название группы преступников"
                            },
                            {
                                "target_lang_word": "группировка",
                                "target_lang_sense_clarification": "организованная группа"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çete",
                                "target_lang_sense_clarification": "yasa dışı veya suç örgütü"
                            },
                            {
                                "target_lang_word": "şebeke",
                                "target_lang_sense_clarification": "organize suç grubu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a652af7f-253f-31b7-bd8a-3b5fdf299836",
                    "sense_definition": "A group of friends or associates who regularly spend time together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whole <w>gang</w> is coming over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Вся <w>компания</w> придет сегодня на ужин.",
                                "tr": "Bu akşam akşam yemeğine bütün <w>ekip</w> geliyor."
                            }
                        },
                        {
                            "text": "I miss the old <w>gang</w> from my college days.",
                            "target_lang_translations": {
                                "ru": "Я скучаю по старой <w>компании</w> моих студенческих времен.",
                                "tr": "Üniversite günlerimdeki eski <w>arkadaş grubunu</w> özlüyorum."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the whole gang",
                        "office gang"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used affectionately"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа друзей или знакомых, которые регулярно проводят время вместе.",
                        "tr": "Düzenli olarak birlikte vakit geçiren arkadaş veya dost grubu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компания",
                                "target_lang_sense_clarification": "круг друзей"
                            },
                            {
                                "target_lang_word": "ватага",
                                "target_lang_sense_clarification": "шумная группа (разг.)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ekip",
                                "target_lang_sense_clarification": "arkadaş grubu"
                            },
                            {
                                "target_lang_word": "grup",
                                "target_lang_sense_clarification": "birlikte takılan arkadaşlar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afa65bc8-3cee-3a32-9bcf-b8e8754bcb78",
                    "sense_definition": "A term of address used to speak to a group of people in a friendly or informal way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alright <w>gang</w>, let's get this meeting started.",
                            "target_lang_translations": {
                                "ru": "Ладно, <w>ребята</w>, давайте начнем собрание.",
                                "tr": "Evet <w>millet</w>, hadi toplantıyı başlatalım."
                            }
                        },
                        {
                            "text": "Hey <w>gang</w>, look what I found!",
                            "target_lang_translations": {
                                "ru": "Эй, <w>народ</w>, смотрите, что я нашел!",
                                "tr": "Hey <w>gençler</w>, bakın ne buldum!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hey gang",
                        "hi gang"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращение к группе людей в дружеской или неформальной манере.",
                        "tr": "Bir insan grubuna dostça veya samimi bir şekilde hitap etmek için kullanılan söz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ребята",
                                "target_lang_sense_clarification": "дружеское обращение"
                            },
                            {
                                "target_lang_word": "народ",
                                "target_lang_sense_clarification": "коллективное обращение (разг.)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "millet",
                                "target_lang_sense_clarification": "samimi hitap şekli"
                            },
                            {
                                "target_lang_word": "gençler",
                                "target_lang_sense_clarification": "grup içi hitap"
                            },
                            {
                                "target_lang_word": "millet/ekip",
                                "target_lang_sense_clarification": "topluluğa hitap"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d6356ec-c125-38a2-b4f4-3d1c009ac967",
                    "sense_definition": "An organized group of laborers working together on a specific task, often under a supervisor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>gang</w> of workmen arrived to repair the damaged road.",
                            "target_lang_translations": {
                                "ru": "<w>Бригада</w> рабочих прибыла для ремонта поврежденной дороги.",
                                "tr": "Hasarlı yolu tamir etmek için bir işçi <w>ekibi</w> geldi."
                            }
                        },
                        {
                            "text": "The prisoners were forced to work on a chain <w>gang</w>.",
                            "target_lang_translations": {
                                "ru": "Заключенных принуждали работать в <w>бригаде</w> скованных цепью.",
                                "tr": "Mahkûmlar birbirine zincirlenmiş bir çalışma <w>ekibinde</w> çalıştırılmaya zorlandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chain gang",
                        "road gang",
                        "work gang"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованная группа рабочих, выполняющих определенную задачу, часто под руководством бригадира.",
                        "tr": "Genellikle bir amir gözetiminde belirli bir iş üzerinde birlikte çalışan organize işçi grubu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бригада",
                                "target_lang_sense_clarification": "рабочая группа"
                            },
                            {
                                "target_lang_word": "артель",
                                "target_lang_sense_clarification": "объединение для совместной работы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ekip",
                                "target_lang_sense_clarification": "çalışma veya iş grubu"
                            },
                            {
                                "target_lang_word": "takım",
                                "target_lang_sense_clarification": "işçilerden oluşan grup"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cc2ce73-b906-3a4c-8154-09fe1cf79b38",
                    "sense_definition": "A set of matched tools, machines, or devices arranged to work together simultaneously.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine uses a <w>gang</w> of saws to cut multiple boards at once.",
                            "target_lang_translations": {
                                "ru": "Станок использует <w>блок</w> пил для одновременной резки нескольких досок.",
                                "tr": "Makine, birden fazla tahtayı aynı anda kesmek için bir testere <w>bloğu</w> kullanıyor."
                            }
                        },
                        {
                            "text": "They installed a <w>gang</w> of switches to control the stage lighting.",
                            "target_lang_translations": {
                                "ru": "Они установили <w>группу</w> выключателей для управления сценическим освещением.",
                                "tr": "Sahne aydınlatmasını kontrol etmek için bir <w>grup</w> anahtar kurdular."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор одинаковых инструментов, машин или устройств, соединенных для одновременной работы.",
                        "tr": "Aynı anda birlikte çalışacak şekilde düzenlenmiş eşleşen alet, makine veya cihaz seti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "технический узел"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "совокупность устройств"
                            },
                            {
                                "target_lang_word": "набор",
                                "target_lang_sense_clarification": "комплект инструментов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "blok",
                                "target_lang_sense_clarification": "teknik düzenek/takım"
                            },
                            {
                                "target_lang_word": "grup",
                                "target_lang_sense_clarification": "bir arada çalışan cihaz seti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5010f159-3ddc-3731-86ce-249a1b0ef201",
                    "sense_definition": "To connect or arrange multiple items, tools, or devices to operate together as a single unit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The volume controls were <w>ganged</w> together for easier adjustment.",
                            "target_lang_translations": {
                                "ru": "Регуляторы громкости были <w>сгруппированы</w> вместе для упрощения настройки.",
                                "tr": "Daha kolay ayar yapabilmek için ses kontrolleri birbirine <w>bağlandı</w>."
                            }
                        },
                        {
                            "text": "You can <w>gang</w> the chairs to form neat, immovable rows.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>сцепить</w> стулья, чтобы сформировать аккуратные неподвижные ряды.",
                                "tr": "Düzenli ve kıpırdamaz sıralar oluşturmak için sandalyeleri birbirine <w>kenetleyebilirsiniz</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gang together"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять или располагать несколько предметов, инструментов или устройств для совместной работы как единое целое.",
                        "tr": "Birden fazla ögeyi, aleti veya cihazı tek bir birim olarak birlikte çalışacak şekilde bağlamak veya düzenlemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группировать",
                                "target_lang_sense_clarification": "объединять в группу"
                            },
                            {
                                "target_lang_word": "сцеплять",
                                "target_lang_sense_clarification": "соединять механически"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gruplamak",
                                "target_lang_sense_clarification": "birlikte çalışacak şekilde bir araya getirmek"
                            },
                            {
                                "target_lang_word": "bağlamak",
                                "target_lang_sense_clarification": "mekanik olarak birleştirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a5b9361-0bd2-3500-bc8a-b81b597b22f4",
                    "sense_definition": "To go, walk, or proceed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The best-laid schemes of mice and men <w>gang</w> aft agley.",
                            "target_lang_translations": {
                                "ru": "Лучшие планы мышей и людей часто <w>идут</w> прахом.",
                                "tr": "Farelerin ve insanların en iyi yaptığı planlar bile sıkça ters <w>gider</w>."
                            }
                        },
                        {
                            "text": "I must <w>gang</w> home now before the weather turns bad.",
                            "target_lang_translations": {
                                "ru": "Я должен <w>идти</w> домой сейчас, пока погода не испортилась.",
                                "tr": "Hava bozmadan önce şimdi eve <w>gitmeliyim</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Scottish and Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти, ходить или направляться (диалектное).",
                        "tr": "Gitmek, yürümek veya ilerlemek (İskoçya ve Kuzey İngiltere diyalekti)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "двигаться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "hareket etmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}