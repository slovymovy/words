                ],
                "senses": [
                    {
                        "sense_id": "ceac6d29-81e4-3e90-8992-deab41cfbd3e",
                        "entry_id": "20eaeb39-9ce6-33d1-a7d7-7fbd3bcc9e32",
                        "glosses": [
                            "Kopf eines Vogels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0410bf3-c738-4370-8709-709a3c7ca912",
                                "sense_id": "ceac6d29-81e4-3e90-8992-deab41cfbd3e",
                                "text": "„Er trat an die Tür, legte vorsichtig einen Finger unter den spitzen Schnabel und hob den Vogelkopf hoch. Das Tier war sicher schon ein paar Tage tot […].“"
                            },
                            {
                                "example_id": "ab586a77-67ed-465b-b123-55ff88bab897",
                                "sense_id": "ceac6d29-81e4-3e90-8992-deab41cfbd3e",
                                "text": "„Ein Vogelkopf ragte aus einem Baumloch, verschwand, schnellte hervor, verschwand.“"
                            },
                            {
                                "example_id": "75864030-d3da-414a-9966-2ee0e099f7c9",
                                "sense_id": "ceac6d29-81e4-3e90-8992-deab41cfbd3e",
                                "text": "„In dem Steinadlerbild ist der Vogelkopf scharf, aber die Flügel und der Hintergrund zeigen Bewegung.“"
                            },
                            {
                                "example_id": "c7586fd5-bd7c-49ef-99b1-f1508bfd99e9",
                                "sense_id": "ceac6d29-81e4-3e90-8992-deab41cfbd3e",
                                "text": "„Mit einem Fisch im Schnabel tauchte der Vogelkopf wieder auf, doch es war zu spät. Der Fisch glitt aus dem Schnabel und die Zähne zermalmten den schlanken Vogelkörper. Kleine Federchen schwebten durch die Luft.“"
                            },
                            {
                                "example_id": "31da2bd6-dc9a-47f6-ac79-019fae78ff39",
                                "sense_id": "ceac6d29-81e4-3e90-8992-deab41cfbd3e",
                                "text": "„Till hebt das Tier auf. Der Vogelkopf ruht auf seinen Fingern. Er spürt die verklebten Federn auf der Haut. Der Vogel bewegt sich nicht.“"
                            },
                            {
                                "example_id": "8a893f5b-6972-4985-86ca-489923f17127",
                                "sense_id": "ceac6d29-81e4-3e90-8992-deab41cfbd3e",
                                "text": "„Die frontale Darstellung des Vogelkopfes ist äußerst ungewöhnlich und durchbricht den ikonographischen Kanon der ägyptischen Kunst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "56108e65-ac88-3b5a-9891-b29eeb9eeceb",
                        "entry_id": "20eaeb39-9ce6-33d1-a7d7-7fbd3bcc9e32",
                        "glosses": [
                            "Gesicht mit fliehendem Kinn und einer großen Nase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d713de8c-8c92-4cfe-bf55-c56e26fd7562",
                                "sense_id": "56108e65-ac88-3b5a-9891-b29eeb9eeceb",
                                "text": "„Frau Marga war sehr zierlich, um nicht zu sagen klein und dürr, sie hatte einen winzigen Vogelkopf, aber er war umwuchert von gekräuseltem Haar.“"
                            },
                            {
                                "example_id": "bf6103f5-ade1-4bb8-a411-cd53d41e7f40",
                                "sense_id": "56108e65-ac88-3b5a-9891-b29eeb9eeceb",
                                "text": "„Sie trug immer schwarze Sachen, der Hals unter ihrem Vogelkopf war sehnig und weiß, und ihre schwarzgrauen Haare batte sie mit einem Gummiband zusammengebunden.“"
                            },
                            {
                                "example_id": "1da6310b-ae12-480f-85ff-9084413c9f60",
                                "sense_id": "56108e65-ac88-3b5a-9891-b29eeb9eeceb",
                                "text": "„Amüsiert beobachtete Jeanne, wie sein Vogelkopf beim Reden vorruckte, als pickte er mit seiner spitzen Nase Körner auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
