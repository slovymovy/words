                                    },
                                    {
                                        "sense_id": "9a1a9d46-b3a8-334a-a2ce-b1b6708c5343",
                                        "entry_id": "df5f5c8c-a298-3bef-b686-67c34951f916",
                                        "glosses": [
                                            "Anything that is characteristic of modernity."
                                        ],
