                "senses": [
                    {
                        "sense_id": "62b15cfd-c444-3b70-8cec-fd973603dda6",
                        "entry_id": "125adb20-fb54-36b6-9441-b12368e5882c",
                        "glosses": [
                            "Faire perdre son référentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094d1ad6-437b-4976-9edc-56d5d6e50178",
                                "sense_id": "62b15cfd-c444-3b70-8cec-fd973603dda6",
                                "text": "Il s'agit de couper l'écriture de toute réalité, de la dé-référentialiser, de manipuler des signes en occultant soigneusement leurs référents, de préférer les signifiants aux signifiés, de refuser toute profondeur sémantique, (...)"
                            },
                            {
                                "example_id": "61512018-17ba-4be1-abe1-d6c5f10fa881",
                                "sense_id": "62b15cfd-c444-3b70-8cec-fd973603dda6",
                                "text": "Mais, projet presque contraire, dé-référentialiser l'objet cadré, c'est aussi affirmer le pouvoir démiurgique de l'artiste."
                            }
                        ]
                    }
