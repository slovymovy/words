                "senses": [
                    {
                        "sense_id": "adffa596-d925-34e4-86bd-0f4a385e4d06",
                        "entry_id": "86821d6a-b0ef-3c7a-9681-9d21b79c7a3e",
                        "glosses": [
                            "Relativadverb, Einzahl männlich"
                        ],
                        "tags": [
                            "rückbezügliches Pronomen, das dem zugehörigen Wort die Ursache für den im Satz geschilderten Sachverhalt zuweist, kann als Relativpronomen verwendet werden"
                        ],
                        "examples": [
                            {
                                "example_id": "0fc8ad7f-37c8-45d2-b4a3-9368dacbd5c6",
                                "sense_id": "adffa596-d925-34e4-86bd-0f4a385e4d06",
                                "text": "„Pauli 47 nennt den Hergang, dessetwegen Becket hier angeklagt wurde, »allerdings zweideutig«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "db2e1fad-19ce-38b5-8811-0f9377a2f73f",
                        "entry_id": "86821d6a-b0ef-3c7a-9681-9d21b79c7a3e",
                        "glosses": [
                            "Relativadverb, Einzahl sächlich"
                        ],
                        "tags": [
                            "rückbezügliches Pronomen, das dem zugehörigen Wort die Ursache für den im Satz geschilderten Sachverhalt zuweist, kann als Relativpronomen verwendet werden"
                        ],
                        "examples": [
                            {
                                "example_id": "013142a6-ed4e-40c1-ac84-3583665528f2",
                                "sense_id": "db2e1fad-19ce-38b5-8811-0f9377a2f73f",
                                "text": "„Endlich wurde er wegen eines noch anderen Preßvergehens in Untersuchung genommen, dessetwegen er freigesprochen und dessetwegen der Ober-Staatsanwalt die Nichtigkeitsbeschwerde an das Obertribunal verfolgt hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f8f29d29-0225-3752-b866-56ce950f2350",
                        "entry_id": "86821d6a-b0ef-3c7a-9681-9d21b79c7a3e",
                        "glosses": [
                            "Demonstrativadverb, Einzahl männlich"
                        ],
                        "tags": [
                            "rückbezügliches Pronomen, das dem zugehörigen Wort die Ursache für den im Satz geschilderten Sachverhalt zuweist, kann als Demonstrativpronomen verwendet werden"
                        ],
                        "examples": [
                            {
                                "example_id": "e9ef695a-5858-4bab-a0e6-c69965cd20bd",
                                "sense_id": "f8f29d29-0225-3752-b866-56ce950f2350",
                                "text": "„Wagner, ein germanischer Riese, der im Orchesterklang den irdischen Horizont streifte, der die Ausdrucksform zwar steigerte, aber in ein System brachte ( Musikdrama, Deklamation, Leitmotiv) ist dessetwegen, nicht weiter steigerungsfähig.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "04005873-7407-3e08-af2d-141849929b4e",
                        "entry_id": "86821d6a-b0ef-3c7a-9681-9d21b79c7a3e",
                        "glosses": [
                            "Demonstrativadverb, Einzahl sächlich"
                        ],
                        "tags": [
                            "rückbezügliches Pronomen, das dem zugehörigen Wort die Ursache für den im Satz geschilderten Sachverhalt zuweist, kann als Demonstrativpronomen verwendet werden"
                        ],
                        "examples": [
                            {
                                "example_id": "47df9890-f0c7-47f5-8d91-83fae5c65a50",
                                "sense_id": "04005873-7407-3e08-af2d-141849929b4e",
                                "text": "„Er hätte dessetwegen nie gefragt, was es hätte, und wie viel es mit brächte, und wenn es nichts hätte, so sei es ihm recht.“"
                            },
                            {
                                "example_id": "f9d3f691-2947-4e2f-a74c-7479e74c84c4",
                                "sense_id": "04005873-7407-3e08-af2d-141849929b4e",
                                "text": "„Und Schriftsteller tauchten in Kanada häufiger in den Nachrichten auf als in den Vereinigten Staaten – nicht nur dessetwegen, was sie schrieben, sondern auch dessetwegen, was sie sagten und taten.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
