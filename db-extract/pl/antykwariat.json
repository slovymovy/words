                "translations": [
                    {
                        "translation_id": "35f786f7-7f4c-4cb0-b40f-2190fde35415",
                        "source_entry_id": "baf1a3a9-4138-3f47-9549-d38a662907de",
                        "source_sense_id": "b1104301-cbbf-3ecd-b7a2-f337a8fbbfea",
                        "target_lang_word": "antique shop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antique shop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92697f8e-8fa3-3dcf-8a1b-6fe38c78da28",
                                        "entry_id": "09f3411a-305d-386b-8b69-90049a44203f",
                                        "glosses": [
                                            "A business dedicated to storing, selling, restoring, and trading in items from previous eras for their superficial and historical value, especially furniture and trinkets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc818d0-8dd3-41d9-ad68-9bd39f88c021",
                                                "sense_id": "92697f8e-8fa3-3dcf-8a1b-6fe38c78da28",
                                                "text": "My grandmother Rosemary never cared much for antique shops, she preferred modern goods as opposed to the things of yore."
                                            },
                                            {
                                                "example_id": "c67e349a-d9b3-4942-9793-0aaa168fe585",
                                                "sense_id": "92697f8e-8fa3-3dcf-8a1b-6fe38c78da28",
                                                "text": "New Alresford is constantly mispronounced, T-shaped, honeycombed with cellars, packed with antique shops, riddled with woodworm, surrounded by watercress. The name - which means 'ford by the alders' - is pronounced 'Allsford'; and no one ever uses 'New', though they do call the adjoining village Old Alresford."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
