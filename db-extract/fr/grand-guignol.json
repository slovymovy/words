                            {
                                "target_word": "gore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ca4e4b1-86cc-3558-8280-60ecedf2f181",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "A triangular piece of land where roads meet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "997b16af-ba8d-4fbd-bc8b-2b9ef2f35e51",
                                                "sense_id": "3ca4e4b1-86cc-3558-8280-60ecedf2f181",
                                                "text": "I have a number of these, but this gentleman up in the gore just below the arrow was traveling in the fast lane of 495."
                                            },
                                            {
                                                "example_id": "8317c745-5ddd-4631-977a-617826b40aca",
                                                "sense_id": "3ca4e4b1-86cc-3558-8280-60ecedf2f181",
                                                "text": "With the addition of pavement marking arrows, erratic maneuvers such as lane changes through the gore and attempted lane changes decreased."
                                            },
                                            {
                                                "example_id": "cac650ca-f086-419a-bac4-70afd1b4aceb",
                                                "sense_id": "3ca4e4b1-86cc-3558-8280-60ecedf2f181",
                                                "text": "Unfortunately, there will be situations where placement of a major obstruction in a gore is unavoidable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47a9f450-c092-305c-ae15-2589985b2d09",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "A triangular strip of land left over at the end of a not-fully-rectangular field."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "288168de-6e84-34f5-9b61-c248c2269701",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "A small piece of land left unincorporated due to competing surveys or a surveying error."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34c182e6-fc0b-3e9b-beae-9de3031d8144",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "The curved surface that lies between two close lines of longitude on a globe, or an equivalent section of a spherical or dome-shaped object in general.ᵂᵖ"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fb9a3b1-94e0-3d48-853b-77a2a896fb98",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "A triangular or rhomboid piece of fabric, especially one forming part of a three-dimensional surface such as a sail or a skirt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ee6d76-3c95-4689-ab39-70be8423900b",
                                                "sense_id": "6fb9a3b1-94e0-3d48-853b-77a2a896fb98",
                                                "text": "Mind you, clothes were clothes in those days. […] Frills, ruffles, flounces, lace, complicated seams and gores: not only did they sweep the ground and have to be held up in one hand elegantly as you walked along, but they had little capes or coats or feather boas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2b6d6cb-4fe4-329f-9c8a-99634cb3007c",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "An elastic gusset for providing a snug fit in a shoe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8b971b9-f7ca-3b07-a03e-a57a8af2e543",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "A projecting point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eedfc85-c684-3017-a2fa-1a76ba8c9d38",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "A charge, delineated by two inwardly curved lines, starting respectively from the middle base corner and one of the two chief corners and meeting in the fess point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3205215-23e3-3d70-8c04-951fa451773a",
                                        "entry_id": "55cde6cc-8484-3eb7-a0c1-af09a99725fc",
                                        "glosses": [
                                            "A sign immediately adjacent to an exit from a roadway identifying it as an exit, optionally with the exit's identification number."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1ea4ed1-6645-384d-9ba8-29b9b44c988d",
                                        "entry_id": "c2a8b8b4-79f4-36e0-a871-437d3804aef0",
                                        "glosses": [
                                            "To cut into a triangular form."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "566f9be3-93dc-377b-a7e6-fb5eb89d4465",
                                        "entry_id": "c2a8b8b4-79f4-36e0-a871-437d3804aef0",
                                        "glosses": [
                                            "To provide with a gore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778632a3-1196-4fb5-aac4-a36a95a1c484",
                                                "sense_id": "566f9be3-93dc-377b-a7e6-fb5eb89d4465",
                                                "text": "to gore an apron"
                                            },
                                            {
                                                "example_id": "5c48f2bc-0178-45ca-999a-bbd11ff51c49",
                                                "sense_id": "566f9be3-93dc-377b-a7e6-fb5eb89d4465",
                                                "text": "If Miss McFlimsey has neat ankles, she can wear short dresses: if she has clumsy ones she can wear a trail; if she is inclined to be (pardon the word) “scrawny,” she can indulge in expensive skirts and protuberant “panniers;” if inclined to embonpoint, she can discard these and “gore” her robes; if her neck and arms are exquisitely moulded, she can undrape their dazzling charms; if bone predominates over plumpitude, she can cover them from the gaze of flying eyes; if she has a disease of the spine, she need not sport “the Grecian bend;” if she is unfortunately healthy, she can call in the aid of that modern deformity—and so on, ad infinitum and ad nauseum.^([sic])"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
