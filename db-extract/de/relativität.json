                        "form_id": "34869d42-71dc-48ac-ae89-5d131b5b6e95",
                        "entry_id": "3234b890-fe14-318f-ba38-00cbdaeb59b8",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Relativität"
                    },
                    {
                        "form_id": "9c93cc45-8478-40db-aa58-18e877dbb2b7",
                        "entry_id": "3234b890-fe14-318f-ba38-00cbdaeb59b8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Relativitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4072517e-48e0-3679-861f-4a3764cd8b60",
                        "entry_id": "3234b890-fe14-318f-ba38-00cbdaeb59b8",
                        "glosses": [
                            "Eigenschaft einer Erscheinung/eines Phänomens, von anderen Gegebenheiten abhängig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee03a40-2c56-467b-8f8d-7f2c2ec9b002",
                                "sense_id": "4072517e-48e0-3679-861f-4a3764cd8b60",
                                "text": "„Damit wird eine unhintergehbare Relativität der Standpunkte und Perspektiven geschaffen - eine Relativität im Wortsinne, denn das Individuum steht immer in Relation zu anderen, wobei diese Differenz durch die Relativität der Perspektive gerade nicht überbrückt wird.“"
                            },
                            {
                                "example_id": "55d0e279-b12f-42a1-a2a0-73b06f94c955",
                                "sense_id": "4072517e-48e0-3679-861f-4a3764cd8b60",
                                "text": "„Das schließt aber keineswegs Relativitäten aus. So ist – a priori – die Gesamtsphäre der körperlichen Natur eine Sphäre von Relativitäten. Körperliches Sein ist Sein in einem Zusammenhang endloser Relativitäten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4ddc1a7f-5087-3946-bae2-0c40f0f29d7d",
                        "entry_id": "3234b890-fe14-318f-ba38-00cbdaeb59b8",
                        "glosses": [
                            "Eigenschaft einer Erscheinung/eines Phänomens, nur unter gewissen Umständen Gültigkeit zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cc4ce48-443f-4385-9ad5-ae3665b73733",
                                "sense_id": "4ddc1a7f-5087-3946-bae2-0c40f0f29d7d",
                                "text": "„Neben dieser offenen und fragmentarischen Gestalt ist aber eine Relativität auch des Geltungsanspruchs dieses Wissenschaftssystems festzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42db9efd-06d0-4260-a176-61102c6f6164",
                        "source_entry_id": "3234b890-fe14-318f-ba38-00cbdaeb59b8",
                        "source_sense_id": "4072517e-48e0-3679-861f-4a3764cd8b60",
                        "source_sense_description": "Eigenschaft einer Erscheinung/eines Phänomens, von anderen Gegebenheiten abhängig zu sein",
