                            {
                                "example_id": "83c86c0a-22c8-4db7-9d7d-e835bcf22c93",
                                "sense_id": "7453a709-3cb8-3258-9061-9cece41720d5",
                                "text": "„Das Insulin wird direkt in die Kapillargefäße abgegeben und gelangt so über den Blutkreislauf zu seinem Zielort, den Körperzellen.“"
                            },
                            {
                                "example_id": "aae6fe22-ab43-44cf-afd2-b5c1547524a5",
                                "sense_id": "7453a709-3cb8-3258-9061-9cece41720d5",
                                "text": "„Im oberen Teil standen Anfangs- und Zielort der Bahnpoststrecke (mitunter waren auch drei Namen angegeben).“"
                            }
                        ],
