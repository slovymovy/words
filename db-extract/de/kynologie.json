                                "target_senses": [
                                    {
                                        "sense_id": "d725c6f7-0093-3f35-b2e7-7bb3e01952d4",
                                        "entry_id": "e0dd084c-b994-324a-b9f5-d5358c2f985f",
                                        "glosses": [
                                            "The study of dogs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79dc2628-0811-41fc-80ee-7517f0ef0d66",
                                                "sense_id": "d725c6f7-0093-3f35-b2e7-7bb3e01952d4",
                                                "text": "Professor Mills has done excellent work in his course on \"Cynology, the Dog and his Diseases,\" a subject hitherto only taught incidentally in any college ..."
                                            },
                                            {
                                                "example_id": "f823461b-82a3-4fa0-90ad-eb2d8967dadc",
                                                "sense_id": "d725c6f7-0093-3f35-b2e7-7bb3e01952d4",
                                                "text": "1951, The American Mercury,\nStudents of cynology can trace in the dictionary the dog's remarkable rise in the public esteem in this century."
                                            },
                                            {
                                                "example_id": "f4704599-62aa-4185-952d-4b6481558ba1",
                                                "sense_id": "d725c6f7-0093-3f35-b2e7-7bb3e01952d4",
                                                "text": "1985, The Complete Dog Book, published by the American Kennel Club,\nThe annals of cynology make no further mention of the breed until 1901 when a combined Rottweiler and Leonberger Club was formed."
                                            },
                                            {
                                                "example_id": "fcc6b5af-969b-435e-9cae-d3edd8751eeb",
                                                "sense_id": "d725c6f7-0093-3f35-b2e7-7bb3e01952d4",
                                                "text": "1990, Austin Farrer, in his introduction to G. W. Leibniz’ Theodicy; quoted in Charles Taliaferro’s 2005 Evidence and Faith,\nNow neither probatology nor cynology could hope to be universal — the world is not all sheep nor all dog: it would have to be hylology; ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "306a7441-66b3-4df2-8d5e-b32e440b1d93",
                        "source_entry_id": "cd9cb3e8-cbcc-3a83-b66e-943d560a145e",
                        "source_sense_id": "c198f2ac-e22d-3c2c-acb7-6ac05fd69582",
                        "source_sense_description": "Lehre von Rassen, Zucht, Pflege, Verhalten, Erziehung und Krankheiten der Haushunde",
                        "target_lang_word": "cynologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cynologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ada0332-3fbd-3f0f-ad28-44e35a009350",
                                        "entry_id": "fa5e70e9-7952-3bda-a35a-9b6c9a6c6bb7",
                                        "glosses": [
                                            "Branche de la mammalogie consacrée à l’étude des chiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7ee0865-2b58-4dc1-a8a2-050afcf53cb0",
                                                "sense_id": "7ada0332-3fbd-3f0f-ad28-44e35a009350",
                                                "text": "Toute race canine reconnue par l’organisme officiel de cynologie du pays dont elle est originaire est régie par un standard."
                                            },
                                            {
                                                "example_id": "b53d73b5-2308-451a-a2fe-201b3d193422",
                                                "sense_id": "7ada0332-3fbd-3f0f-ad28-44e35a009350",
                                                "text": "Gros et grand Chien ; ou, si vous l’aimez mieux,\nCet animal que la cynologie\nAppela Chine d’Épire ou d’Albanie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "859a1536-b7bf-4dc8-8dbe-7f0385d3c3f6",
                        "source_entry_id": "cd9cb3e8-cbcc-3a83-b66e-943d560a145e",
