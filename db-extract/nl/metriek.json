                "translations": [
                    {
                        "translation_id": "dce134a6-bb96-4ce4-bdad-de61dec48b83",
                        "source_entry_id": "f4f3360d-dafe-30f0-9e1f-251fff62bb80",
                        "target_lang_word": "metric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04d0a362-0dd4-3e2d-9b71-e24d845c8ad2",
                                        "entry_id": "c6964fcb-16ad-3e05-a8ea-3075768142b7",
                                        "glosses": [
                                            "Of or relating to the metric system of measurement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6f2800f-83da-4cfc-87de-fd885290ef47",
                                                "sense_id": "04d0a362-0dd4-3e2d-9b71-e24d845c8ad2",
                                                "text": "But the red planet has been a graveyard for Russian, European and American missions, including an embarrassing 1999 NASA fail caused when a computer, running on metric numbers, and engineers, dealing in nonmetric numbers, got their signals crossed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4657503-1c02-3599-9ce3-1044ac0e59ad",
                                        "entry_id": "c6964fcb-16ad-3e05-a8ea-3075768142b7",
                                        "glosses": [
                                            "Of or relating to the meter of a piece of music."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cf83120-0205-3c6f-bbfa-eedbbe531832",
                                        "entry_id": "c6964fcb-16ad-3e05-a8ea-3075768142b7",
                                        "glosses": [
                                            "Of or relating to distance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "metric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                        "entry_id": "055da003-f9a7-32e3-8778-d8a7ba978cb3",
                                        "glosses": [
                                            "A measure for something; a means of deriving a quantitative measurement or approximation for otherwise qualitative phenomena (especially used in engineering)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81442e0-c6d1-48c9-88c5-cc108c03347e",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "What metric should be used for performance evaluation?"
                                            },
                                            {
                                                "example_id": "2d0145e4-74db-47e1-a86c-bf91b4b2cb20",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "What are the most important metrics to track for your business?"
                                            },
                                            {
                                                "example_id": "a7b61094-d465-4414-8508-8daf7e3c9e15",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "It's the most important single metric that quantifies the predictive performance."
                                            },
                                            {
                                                "example_id": "ff0f9de2-df5d-46f2-b18b-81b15226b81d",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "How to measure marketing? Use these key metrics for measuring marketing effectiveness."
                                            },
                                            {
                                                "example_id": "1142a2c1-b292-4fae-a3c0-1eb5bb4b6959",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "There is a lack of standard metrics."
                                            },
                                            {
                                                "example_id": "79f3b883-8d8b-4022-bacd-3958b0156244",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "As for the large number of official statements that Spain is safe, I think they are merely a metric of the complacency that has characterised the European crisis from the start."
                                            },
                                            {
                                                "example_id": "20ab08a1-08f9-4751-8b9c-e083d6bb7cd5",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            },
                                            {
                                                "example_id": "2eef1fcc-d0cb-4634-be1f-2417f0c8b39c",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "The insight underlying such wordlists is that frequency, combined with metrics such as range and dispersion, profiles for teachers and students the relative usefulness of words."
                                            },
                                            {
                                                "example_id": "facf94e0-11f2-4b6f-ac9d-c4d2767d82f6",
                                                "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                                                "text": "Ibanez had seen things with worse implications for herself, personally. That was the only metric of horror on which this sight knew remote equal. It was a wall, in a basic sense. It stretched from one side of the tunnel to the other, floor to ceiling, barring further passage. It was pink. It bubbled inside, and it sounded like a hundred simultaneous cases of indigestion which echoed off the rock around it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06a3a45-60e5-31f5-ae15-3c307f6b1595",
                                        "entry_id": "055da003-f9a7-32e3-8778-d8a7ba978cb3",
                                        "glosses": [
                                            "A function which satisfies a particular set of formal conditions, created to generalize the notion of the distance between two points. Formally, a real-valued function d on M×M, where M is a set, is called a metric if (1) d(x,y)=0 if and only if x=y, (2) d(x,y)=d(y,x) for all pairs (x,y), and (3) d obeys the triangle inequality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c635618-fce8-4c92-94fb-80209e08829a",
                                                "sense_id": "f06a3a45-60e5-31f5-ae15-3c307f6b1595",
                                                "text": "As we shall see, these metrics are constructed from a Green function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa425a23-f875-3373-8073-54d725959fe5",
                                        "entry_id": "055da003-f9a7-32e3-8778-d8a7ba978cb3",
                                        "glosses": [
                                            "A metric tensor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f56f568a-78b2-3c26-bcbb-2dd52ed764af",
                                        "entry_id": "055da003-f9a7-32e3-8778-d8a7ba978cb3",
                                        "glosses": [
                                            "Abbreviation of metric system."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "metric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79959209-984a-363b-8eaa-550ce02d5cde",
                                        "entry_id": "819f8d79-f31d-3487-8a2b-9d5a0eeb130f",
                                        "glosses": [
                                            "To measure or analyse statistical data concerning the quality or effectiveness of a process."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff23fb55-94f5-428a-8cfb-eb6dd11d9b92",
                                                "sense_id": "79959209-984a-363b-8eaa-550ce02d5cde",
                                                "text": "We need to metric the status of software documentation."
                                            },
                                            {
                                                "example_id": "16df6952-56b8-401b-af5d-d1199d92ec4d",
                                                "sense_id": "79959209-984a-363b-8eaa-550ce02d5cde",
                                                "text": "We need to metric the verification of requirements."
                                            },
                                            {
                                                "example_id": "cf770c2b-e0f3-4327-a5c9-8acd7a584ded",
                                                "sense_id": "79959209-984a-363b-8eaa-550ce02d5cde",
                                                "text": "We need to metric the system failures."
                                            },
                                            {
                                                "example_id": "c268d4d8-cd0d-48b1-a0e5-00b98559e4f2",
                                                "sense_id": "79959209-984a-363b-8eaa-550ce02d5cde",
                                                "text": "The project manager is metricking the closure of the action items."
                                            },
                                            {
                                                "example_id": "c5a6e401-2310-40af-b1ed-a3eb8de56c0e",
                                                "sense_id": "79959209-984a-363b-8eaa-550ce02d5cde",
                                                "text": "Customer satisfaction was metricked by the marketing department."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
