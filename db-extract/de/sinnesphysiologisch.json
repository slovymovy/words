                    },
                    {
                        "form_id": "07bbc363-ff4e-478f-9dcf-aff1ec546507",
                        "entry_id": "9b847dc5-bd5b-3038-bd02-a75880397e53",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind sinnesphysiologisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7994b3a0-9b7d-38e1-8424-cf4c2ba2aa13",
                        "entry_id": "9b847dc5-bd5b-3038-bd02-a75880397e53",
                        "glosses": [
                            "die Sinnesphysiologie betreffend"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "708a19e7-ef13-4112-b34a-112b9d2bd0aa",
                                "sense_id": "7994b3a0-9b7d-38e1-8424-cf4c2ba2aa13",
                                "text": "„In einer großen Zahl wahrnehmungspsychologischer und sinnesphysiologischer Untersuchungen ist man diesem Problem nachgegangen."
                            },
                            {
                                "example_id": "f7b2b74b-fd23-4831-95a0-100233f5a13c",
                                "sense_id": "7994b3a0-9b7d-38e1-8424-cf4c2ba2aa13",
                                "text": "„Dies erkannte in seinen frühen Forschungen Karl von Frisch, dessen Schwerpunkt mehr die sinnesphysiologischen Grundlagen des Verhaltens waren.“"
                            },
                            {
                                "example_id": "b41499c8-48a5-47d5-bdc0-06d4752c610e",
                                "sense_id": "7994b3a0-9b7d-38e1-8424-cf4c2ba2aa13",
                                "text": "„Auf der Ebene eines vielzelligen Organismus bedeutet Reizschwelle sinnesphysiologisch die Schwelle für eine Sinnesempfindung: die kleinste Reizintensität, die bei einer bestimmten Reizkonstellation gerade noch eine Empfindung hervorruft.“"
                            },
                            {
                                "example_id": "aa479d58-54e7-4de4-a8bc-cdabbc2c3060",
                                "sense_id": "7994b3a0-9b7d-38e1-8424-cf4c2ba2aa13",
                                "text": "„Bei der Beurteilung, ob ein Tier sinnesphysiologisch niedriger entwickelt ist, ist die zoologische Systematik zu beachten.“"
                            },
                            {
