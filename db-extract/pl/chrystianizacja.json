                "senses": [
                    {
                        "sense_id": "467e83a4-071b-3cca-9d0d-0c428696d5df",
                        "entry_id": "e52d3da0-1c91-3856-96e8-af5dad30372e",
                        "glosses": [
                            "narzucanie wiary chrześcijańskiej poganom; proces dobrowolnego przechodzenia na chrześcijaństwo przez ludy niechrześcijańskie"
                        ],
                        "tags": [
                            "also"
                        ],
                        "examples": [
                            {
                                "example_id": "3b56df37-8b51-4e37-9d78-60938602094a",
                                "sense_id": "467e83a4-071b-3cca-9d0d-0c428696d5df",
                                "text": "Wprawdzie chrystianizacja Słowian trwała kilkaset lat, a do jej celów przygotowywano misjonarzy, czy wręcz całe konwenty czy biskupstwa, nie przyniosło to jednak rezultatu w postaci szerszej charakterystyki zwalczanego kultu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac88e09d-e778-4261-acf2-641f32d5b4ef",
                        "source_entry_id": "e52d3da0-1c91-3856-96e8-af5dad30372e",
                        "source_sense_id": "467e83a4-071b-3cca-9d0d-0c428696d5df",
                        "target_lang_word": "christianization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "46e57d5b-3c16-4a3c-81c4-27e430f995a9",
                        "source_entry_id": "e52d3da0-1c91-3856-96e8-af5dad30372e",
                        "source_sense_id": "467e83a4-071b-3cca-9d0d-0c428696d5df",
                        "target_lang_word": "christianisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "christianisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff6773ab-03ad-3706-ba15-69fe9d512759",
                                        "entry_id": "000cf646-0e7d-3c3f-b61f-24955fce3f79",
                                        "glosses": [
                                            "Conversion au christianisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8994735-f64e-4f16-94e0-e589741016eb",
                                                "sense_id": "ff6773ab-03ad-3706-ba15-69fe9d512759",
                                                "text": "La Gaule était restée longtemps en dehors de cette christianisation. Pendant près de deux siècles, le paganisme résista aux entreprises de la nouvelle religion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7592f114-0aa4-48ef-9ca4-28ed3559651c",
                        "source_entry_id": "e52d3da0-1c91-3856-96e8-af5dad30372e",
                        "source_sense_id": "467e83a4-071b-3cca-9d0d-0c428696d5df",
                        "target_lang_word": "cristianización",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7e4e13a8-2e25-4a4a-b1c0-10e915c06098",
                        "source_entry_id": "e52d3da0-1c91-3856-96e8-af5dad30372e",
                        "source_sense_id": "467e83a4-071b-3cca-9d0d-0c428696d5df",
                        "target_lang_word": "Christianisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christianisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cc6cb3e-9a8a-3cd7-b754-1c48768e9be5",
                                        "entry_id": "abe2a7fa-0f5e-3e09-8ed8-be6ec011ac2a",
                                        "glosses": [
                                            "der Prozess, bei dem ein eine Volksgruppe zum Christentum als Religion und Kultur bekehrt wird"
                                        ],
                                        "tags": [
                                            "Kirchengeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d386ca9-e601-4409-bbe5-d61d6a645673",
                                                "sense_id": "7cc6cb3e-9a8a-3cd7-b754-1c48768e9be5",
                                                "text": "„Die Christianisierungen im Süden erklären sich nicht nur durch den relativ frühen Kontakt mit europäischen Missionaren, sondern auch durch eine gewisse Nähe der dort vorherrschenden Religionen zur Vorstellung einer einzigen übergeordneten Gottheit.“"
                                            },
                                            {
                                                "example_id": "04f7746b-d3e7-41f7-83c7-e56bfc8664c0",
                                                "sense_id": "7cc6cb3e-9a8a-3cd7-b754-1c48768e9be5",
                                                "text": "„Wandelte sich durch die Christianisierungen der Alltag der Menschen? Wurde er gar besser? Das lässt sich nicht ermessen, zumal es unterschiedliche Kriterien gibt, dies zu bewerten.“"
                                            },
                                            {
                                                "example_id": "9473767f-cbf7-451b-8ef0-5b28a0ef313d",
                                                "sense_id": "7cc6cb3e-9a8a-3cd7-b754-1c48768e9be5",
                                                "text": "„Der Überlieferung nach war der heilige Patrick derjenige, dem die Christianisierung Irlands zu verdanken ist.“"
                                            },
                                            {
                                                "example_id": "9060aef9-1d14-49da-8a28-25bcf876ddb9",
                                                "sense_id": "7cc6cb3e-9a8a-3cd7-b754-1c48768e9be5",
                                                "text": "„Und obwohl Norwegen ab etwa 960 für längere Zeit unter dänische Oberhoheit gerät, können einheimische Adelige mehrfach Teile des Landes unter ihre Kontrolle bringen, sich zu Königen erheben und die Christianisierung vorantreiben.“"
                                            },
                                            {
                                                "example_id": "889ad5a4-1b2d-4340-b3f3-0ba5ffddded5",
                                                "sense_id": "7cc6cb3e-9a8a-3cd7-b754-1c48768e9be5",
                                                "text": "„Unter Papst Gregor dem Großen (590-604) waren Benediktinermönche aus Rom nach England gekommen und hatten die Christianisierung in die Wege geleitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c79832cc-17b4-4dbb-a746-9ce44b809902",
                        "source_entry_id": "e52d3da0-1c91-3856-96e8-af5dad30372e",
                        "source_sense_id": "467e83a4-071b-3cca-9d0d-0c428696d5df",
