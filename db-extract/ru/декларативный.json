                                        "entry_id": "90a6bf6d-a325-3b5a-95af-58250a6e1651",
                                        "glosses": [
                                            "Eigenschaft einer Aussage, die rechtsbekundend, rechtserklärend ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f1d5349-2b6b-428c-9727-b26757be6c19",
                                                "sense_id": "b93d1df4-14df-35c7-a2fe-529ba6052fc0",
                                                "text": "„Deklaratorische Eintragungen sind rechtsbekundend, betreffen also einen Vorgang der an sich unabhängig von der Eintragung stattfindet, etwa die Eintragung der Prokura gemäß § 53 HGB, die gemäß § 48 I HGB bereits durch die Willenserklärung wirksam erteilt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
