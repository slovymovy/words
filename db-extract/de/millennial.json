                                "example_id": "ad2cd374-a490-4219-8321-015492bd0ab7",
                                "sense_id": "5fcbad61-8499-3eda-ac7c-0698f31a48f6",
                                "text": "Die eingängigen Beats und Texte bohren sich ins Gehirn. Ihre Musik holt nicht nur Gen Alpha ab, Haftbefehl-Hommage und Cro-Sample lassen auch Millennials und Gen Z nostalgisch mit dem Kopf nicken."
                            },
                            {
                                "example_id": "169a4d96-e11b-4bc1-94ed-fdffe354c527",
                                "sense_id": "5fcbad61-8499-3eda-ac7c-0698f31a48f6",
                                "text": "Wie jeder anständige Millennial shoppe ich dabei am liebsten am Rechner."
                            }
