                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55d9c33f-2a1a-4cfb-87a1-a3df93c0aa81",
                                                "sense_id": "61fb043d-f584-3fdc-94e1-65f04c2b255a",
                                                "text": "We have an airtight argument they won’t be able to punch holes in."
                                            },
