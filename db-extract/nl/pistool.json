                                    },
                                    {
                                        "sense_id": "e1cdfbd1-4a58-341b-a9f9-416fc1998d95",
                                        "entry_id": "acd30cf9-2b46-3738-8e09-21d632366830",
                                        "glosses": [
                                            "A lively, high-energy person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d4ae80c-56d1-4f5d-b2ed-d4a9b0a4e2b8",
                                                "sense_id": "e1cdfbd1-4a58-341b-a9f9-416fc1998d95",
                                                "text": "She was gregarious, opinionated, and in charge, the kind of person you'd describe as a real pistol, and I was immediately drawn to her."
                                            },
                                            {
                                                "example_id": "840c649e-0f59-48fe-be93-5c29b5681448",
                                                "sense_id": "e1cdfbd1-4a58-341b-a9f9-416fc1998d95",
                                                "text": "KENT NELSON —Until my wife Inza convinced me there was more to life. Ah, she was a real pistol, that Inza."
                                            },
                                            {
                                                "example_id": "147f8541-0c3a-4038-a8d4-bdc86ce5dfe3",
                                                "sense_id": "e1cdfbd1-4a58-341b-a9f9-416fc1998d95",
                                                "text": "She features so many dance tunes and is a pistol with her sharp and witty remarks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9adb2528-46af-3902-b375-646a01ccfb5f",
