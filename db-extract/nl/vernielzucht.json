                                        "sense_id": "149f3c16-1d00-39fe-b6f1-11d19739e896",
                                        "entry_id": "77057ec0-f532-35cc-8125-0154f6be674f",
                                        "glosses": [
                                            "The state or quality of being destructive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcf47ec1-d92e-4e70-92f1-7407a525d6d9",
                                                "sense_id": "149f3c16-1d00-39fe-b6f1-11d19739e896",
                                                "text": "Would Helen’s face-seductiveness have wrought as much destructiveness,\nWould Antony have followed Cleopatra like a lamb,\nUnless those ladies’ vanities for snaring male humanities\nHad been associated with a quantum suff. of glam.?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "884c0a0f-b7f7-466a-9501-a766817b5cb8",
                        "source_entry_id": "3bb4cecd-9342-3e18-9a9e-5ca4a7164e32",
                        "source_sense_id": "7d7f26a1-1110-335f-94f3-5de8aa643ee0",
                        "source_sense_description": "de drang om dingen kapot te maken",
