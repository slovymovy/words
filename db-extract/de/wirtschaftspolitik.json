                    {
                        "form_id": "62e83442-4f10-4b29-8f16-2005d0ec3c30",
                        "entry_id": "e2394895-cda3-369f-b8ce-84981edb3c46",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wirtschaftspolitiken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b999ae6-9d04-320b-a9ff-778cebcc0e82",
                        "entry_id": "e2394895-cda3-369f-b8ce-84981edb3c46",
                        "glosses": [
                            "Summe der Maßnahmen, die politisch zur Beeinflussung der Wirtschaft getätigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba71306a-1ff3-4b8c-a370-dd3762ec624b",
                                "sense_id": "0b999ae6-9d04-320b-a9ff-778cebcc0e82",
                                "text": "Sie war in der Koalition Beraterin in Sachen Wirtschaftspolitik."
                            },
                            {
                                "example_id": "86e3340b-d83a-4ca3-a666-0ec3ade271f1",
                                "sense_id": "0b999ae6-9d04-320b-a9ff-778cebcc0e82",
                                "text": "„Nur der Urheber des Ganzen [einer gemeinsamen Währung], die Regierung Helmut Kohls, verhielt sich begriffsstutzig: Sie wollte nicht einsehen, daß sich eine einheitliche Währung nicht mit elf unterschiedlichen Wirtschaftspolitiken verträgt.“"
                            },
                            {
                                "example_id": "d9705c99-20f9-4b43-baa3-f90833c8e994",
                                "sense_id": "0b999ae6-9d04-320b-a9ff-778cebcc0e82",
                                "text": "„‘Wir müssen einiges von dem nachholen, was wir bei der Einführung des Euro nicht ausreichend gemacht haben‘, sagte sie [Angela Merkel] mit Blick auf eine mangelnde politische Zusammenarbeit und Koordination der Wirtschaftspolitiken in der Eurozone.“"
                            },
                            {
                                "example_id": "c9614f1c-fea5-43ab-8381-844b519d5a66",
                                "sense_id": "0b999ae6-9d04-320b-a9ff-778cebcc0e82",
                                "text": "„Die Studierenden haben Grundkenntnisse ausgewählter Wirtschaftspolitiken erworben, insbesondere der Ordnungspolitik, der europäischen Geldpolitik, der Finanzpolitik, der Lohn- und Einkommenspolitik, der Arbeitsmarkt- und Beschäftigungspolitik und der Umweltpolitik.“"
                            },
                            {
                                "example_id": "9fc6eacf-4dbf-453e-a23a-74b3cf3e672b",
                                "sense_id": "0b999ae6-9d04-320b-a9ff-778cebcc0e82",
                                "text": "„VERORDNUNG (EG) Nr. 1466/97 DES RATES vom 7. Juli 1997 über den Ausbau der haushaltspolitischen Überwachung und der Überwachung und Koordinierung der Wirtschaftspolitiken“"
                            },
                            {
                                "example_id": "e554ebc5-5516-43eb-ae98-4a9450cfe955",
                                "sense_id": "0b999ae6-9d04-320b-a9ff-778cebcc0e82",
                                "text": "„Mit dem Euro-Plus-Pakt verpflichten sich die Euro-Länder, ihre nationalen Wirtschaftspolitiken stärker zu koordinieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
