                                    },
                                    {
                                        "sense_id": "7dde4b67-3daf-39ca-9134-bdcb2b47af5c",
                                        "entry_id": "829459d0-881a-34cb-89f8-6aaa607fcc31",
                                        "glosses": [
                                            "Evil, wicked, morally reprehensible."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3f0aa2-d07e-4205-acba-f75a7bd85096",
                                                "sense_id": "7dde4b67-3daf-39ca-9134-bdcb2b47af5c",
                                                "text": "my proneſſe to ſinne, and naughty appetites and desires, woulde drawe me headlong to the pitte of hell"
                                            },
                                            {
                                                "example_id": "c69e09ab-2ab8-4a88-94c8-6d976a95d65a",
                                                "sense_id": "7dde4b67-3daf-39ca-9134-bdcb2b47af5c",
                                                "text": "[…]How far that little candle throws his beams!\nSo shines a good deed in a naughty world."
                                            },
                                            {
                                                "example_id": "446c52aa-e111-42b5-a4aa-61296bf082f6",
                                                "sense_id": "7dde4b67-3daf-39ca-9134-bdcb2b47af5c",
                                                "text": "Wholesome meats to a vitiated stomack differ little or nothing from unwholesome; and best books to a naughty mind are not unappliable to occasions of evill."
                                            },
                                            {
                                                "example_id": "76a33214-183a-4273-a1a2-b27d22abdb50",
                                                "sense_id": "7dde4b67-3daf-39ca-9134-bdcb2b47af5c",
                                                "text": "Meowky as naughty folks"
