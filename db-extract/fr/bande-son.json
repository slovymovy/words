                ],
                "senses": [
                    {
                        "sense_id": "7b541688-8e92-3b08-9584-cd1646879697",
                        "entry_id": "502f3d4c-e78d-3e6b-9831-6deba22b6fc2",
                        "glosses": [
                            "Composante sonore d’un film, d’un téléfilm, d’un jeu vidéo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90676112-aaef-4dfa-b2e8-99ce6442fada",
                                "sense_id": "7b541688-8e92-3b08-9584-cd1646879697",
                                "text": "Une anecdote racontée par le saxophoniste Barney Wilen qui figurait sur l’enregistrement de la bande-son du film de Vadim Les liaisons dangereuses (1960) éclaire immédiatement les rapports de Thelonius avec la Baronne."
                            },
                            {
                                "example_id": "40801dae-59b9-4b23-89ae-e7d79f129ca0",
                                "sense_id": "7b541688-8e92-3b08-9584-cd1646879697",
                                "text": "Son équipe, et notamment sa monteuse, jouée dans le film par Blanche Gardin, s’arrachant les cheveux face à ses idées parfois géniales, mais souvent farfelues, comme de faire venir le chanteur Sting pour la bande-son de sa nouvelle réalisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "6474bc4c-e7dd-3500-8d2f-7d3402739e11",
                        "entry_id": "502f3d4c-e78d-3e6b-9831-6deba22b6fc2",
                        "glosses": [
                            "Fond sonore."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "37f6a22d-d6ed-432e-91bb-4f49511bbfe3",
                                "sense_id": "6474bc4c-e7dd-3500-8d2f-7d3402739e11",
                                "text": "Des bruits de marteau, de perceuses et de scie-sauteuse, voilà la bande-son de la capitale américaine à quelques jours de l’élection présidentielle."
                            }
                        ]
                    }
                ],
