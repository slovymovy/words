                        "examples": [
                            {
                                "example_id": "97813649-160b-49ba-ad41-ce3cd970b46a",
                                "sense_id": "e64c7d78-b6df-35cb-9df9-95615bd617a8",
                                "text": "„Innen- und Sozialbehörde hätten sich mit den Hamburger Hilfsorganisationen zu diesem Schritt entschieden, weil die im November geschaffenen Notunterkünfte schon jetzt an ihre Kapazitätsgrenzen gestoßen seien.“"
                            },
                            {
                                "example_id": "6c8da1c7-e9cd-48ae-a6a6-836638f50755",
                                "sense_id": "e64c7d78-b6df-35cb-9df9-95615bd617a8",
                                "text": "„Auf der Eninger Weide sind Notunterkünfte entstanden, in denen die Aussiedler bleiben können, bis sie im Landkreis Reutlingen Wohnraum gefunden haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
