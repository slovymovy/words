                                "target_senses": [
                                    {
                                        "sense_id": "34f8ce60-0f39-34ff-a95d-b77a99bd29f6",
                                        "entry_id": "c85477be-1121-376e-a398-cb24a42898da",
                                        "glosses": [
                                            "кино комедийный жанр немого кино, для которого характерен балаганный юмор с обилием падений, драк, погонь и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586e6448-601f-4c98-b5b6-e8666f8d581d",
                                                "sense_id": "34f8ce60-0f39-34ff-a95d-b77a99bd29f6",
                                                "text": "Авторы с упоением создателей ранних слэпстиков изобретают для Ларри всё новые и новые пинки, шлепки и удары судьбы."
                                            }
                                        ]
                                    }
                                ]
