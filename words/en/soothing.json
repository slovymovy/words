                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother was gently <w>soothing</w> the crying baby until he drifted off to sleep.",
                            "target_lang_translations": {
                                "pl": "Matka delikatnie <w>uspokajała</w> płaczące niemowlę, aż w końcu zasnęło."
                            }
                        },
                        {
                            "text": "He tried <w>soothing</w> his angry friend by offering an apology and a cup of coffee.",
                            "target_lang_translations": {
                                "pl": "Próbował <w>udobruchać</w> wściekłego przyjaciela, przepraszając go i proponując kawę."
                            }
