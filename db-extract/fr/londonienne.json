                    },
                    {
                        "translation_id": "88b7bb17-b974-4db7-9e06-6951ffa7347d",
                        "source_entry_id": "f2ba7003-06dd-3f1b-abb0-f484ce186d41",
                        "source_sense_id": "dc13e271-9bef-37f6-b084-c81f4fe7e76b",
