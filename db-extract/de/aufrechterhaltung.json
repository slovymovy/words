                "senses": [
                    {
                        "sense_id": "c461117d-3389-30e8-9569-53a640b853c3",
                        "entry_id": "49287b9a-0fa4-3677-8b78-11cf61e3879f",
                        "glosses": [
                            "Maßnahme, etwas aufrechtzuerhalten, dafür zu sorgen, dass etwas bestehen bleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba97b63-4062-4812-8f92-16624e23b370",
                                "sense_id": "c461117d-3389-30e8-9569-53a640b853c3",
                                "text": "„Grübeln gilt als zentraler Risikofaktor für die Entstehung und Aufrechterhaltung emotionaler Störungen.“"
                            },
                            {
                                "example_id": "810ab3ab-94f1-4990-ba5c-4d15bb912aac",
                                "sense_id": "c461117d-3389-30e8-9569-53a640b853c3",
                                "text": "„Die Aufrechterhaltung regionaler Versorgung mit medizinischen Dienstleistungen stellt in vielen ländlichen Regionen, die vom demographischen Wandel betroffen sind, eine Herausforderung in Gegenwart und Zukunft dar.“"
                            },
                            {
                                "example_id": "ba06400e-fff7-4f04-a420-a9ab2289f2f8",
                                "sense_id": "c461117d-3389-30e8-9569-53a640b853c3",
                                "text": "„Der wichtigste Grund für uns ist, daß sie bei der Aufrechterhaltung der amerikanischen Truppenpräsenz in Europa helfen.“"
                            },
                            {
                                "example_id": "f5b279ec-4ca3-457b-b588-6c982dc9548d",
                                "sense_id": "c461117d-3389-30e8-9569-53a640b853c3",
                                "text": "„Das Vertrauen, das ein Mensch in einen anderen setzt, ist unverzichtbar für die Gestaltung und Aufrechterhaltung sozialer Beziehungen.“"
                            },
                            {
                                "example_id": "ca6b3f0b-5d5b-4ceb-9ea8-f02d2703a54a",
                                "sense_id": "c461117d-3389-30e8-9569-53a640b853c3",
                                "text": "„Sufi-Anhänger organisieren sich politisch meist über die Orden sowie über die Barelvi-Bewegung, benannt nach der nordindischen Stadt Bareilly, in der ihr Gründer Ahmed Reza Khan ((1856–1921) lebte; sie setzt sich für die Aufrechterhaltung des Sufismus ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
