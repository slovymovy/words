                ],
                "senses": [
                    {
                        "sense_id": "c28b5532-914e-36d4-9e4f-371268409a21",
                        "entry_id": "a108e19f-578e-3d13-96ef-1fcb3a148cf2",
                        "glosses": [
                            "aus Ziegelsteinen errichtetes Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3970018-42d0-4441-a1a8-c57823b2351a",
                                "sense_id": "c28b5532-914e-36d4-9e4f-371268409a21",
                                "text": "„Mein Zimmer entpuppte sich als ein trostloser, zur Rückseite des Gebäudes hin gelegener Raum mit billigem Mobiliar und zwei Fenstern, die einen Ausblick auf einen schmutzigen Hof boten, der von niedrigen verlassenen Ziegelbauten umsäumt war.“"
                            },
                            {
                                "example_id": "0e1f76c5-54d5-45e7-b4a1-6e8aeb2c5da2",
                                "sense_id": "c28b5532-914e-36d4-9e4f-371268409a21",
                                "text": "„Wir gingen von einem plumpen Ziegelbau zum nächsten, von Gehöft zu Gehöft, aber sie waren alle verlassen.“"
                            },
                            {
                                "example_id": "2f08f747-68a3-44d2-ba4c-da4ce7259f9f",
                                "sense_id": "c28b5532-914e-36d4-9e4f-371268409a21",
                                "text": "„Über ihnen ragte ein Ziegelbau auf, in dem eine riesige Maschine arbeitete, die wie ein gigantischer Korkenzieher aussah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
