                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hormesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7078a0c-c084-3ec4-b7e8-20ef92f82e64",
                                        "entry_id": "f10a9cd6-3390-394b-97a9-ee61bf44d913",
                                        "glosses": [
                                            "A phenomenon in which an environmental agent or stressor produces a stimulatory or beneficial effect at low doses and an inhibitory or harmful effect at higher doses, corresponding to a biphasic dose-response relationship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7c98eb1-c76a-4eee-8ac7-a79599208902",
                                                "sense_id": "c7078a0c-c084-3ec4-b7e8-20ef92f82e64",
                                                "text": "So the concept of a permissible, safe, or “threshold” dose gained currency, and this was used to set standards in industries where workers were exposed to radiation, such as uranium mining and nuclear power generation. Some people went even further, arguing for radiation hormesis—that small doses of radiation were actually good for you."
                                            },
                                            {
                                                "example_id": "b1d5c4b4-aa52-4123-82e1-858ea48f0627",
                                                "sense_id": "c7078a0c-c084-3ec4-b7e8-20ef92f82e64",
                                                "text": "Though he is given to gee-whizzery about anything “super awesome”—Small amounts of radiation are actually good for you! It’s called radiation hormesis!—he has scant interest in the specifics of the apps that many YC companies produce; what intrigues him is their potential effect on the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
