        "fr-extract.jsonl": [
            {
                "entry_id": "bdec9c12-13d8-3db2-ae30-6a5372b1afed",
                "word": "nerveusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36d2e512-c863-3707-b0dd-b1ad746a19ea",
                        "entry_id": "bdec9c12-13d8-3db2-ae30-6a5372b1afed",
                        "glosses": [
                            "Avec nerf, avec vigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "303225db-8e8c-44b9-9312-6e1d744ae1f7",
                                "sense_id": "36d2e512-c863-3707-b0dd-b1ad746a19ea",
                                "text": "On ne peut donner trop d’adresse, de délicatesse et de soins pour dignement et nerveusement dresser ce canevas."
                            },
                            {
                                "example_id": "326b28cf-1b46-472f-8060-6d0318245ec8",
                                "sense_id": "36d2e512-c863-3707-b0dd-b1ad746a19ea",
                                "text": "Il gratouilla tout aussi nerveusement le reçu de ses objets personnels, que Lenimphe agita dans l’air pour le faire sécher, après l’avoir relu attentivement."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7813a60-8dd8-3b4e-9278-d47817230c8b",
                        "entry_id": "bdec9c12-13d8-3db2-ae30-6a5372b1afed",
                        "glosses": [
                            "D’une façon nerveuse, avec nervosité ; sous l’influence d’une affection des nerfs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2b13fb-4004-4440-9303-3a7a9e24f9b5",
                                "sense_id": "d7813a60-8dd8-3b4e-9278-d47817230c8b",
                                "text": "Elle sanglotait nerveusement. — Rire nerveusement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "538f75e2-43e7-41dd-b558-de5b3f7232dc",
                        "source_entry_id": "bdec9c12-13d8-3db2-ae30-6a5372b1afed",
                        "target_lang_word": "nervously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nervously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94e2630e-9bbf-396e-80f5-3fc260bc89d7",
                                        "entry_id": "61867f81-6774-3d89-9039-0180286eee4b",
                                        "glosses": [
                                            "In a nervous manner; feeling or displaying nervousness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e942f3fa-e9e2-40c2-9af7-4f38c46eed88",
                                                "sense_id": "94e2630e-9bbf-396e-80f5-3fc260bc89d7",
                                                "text": "He paced nervously as he waited for the important phone call."
                                            },
                                            {
                                                "example_id": "72fa48c7-3437-4fef-9a81-8e897ddc63de",
                                                "sense_id": "94e2630e-9bbf-396e-80f5-3fc260bc89d7",
                                                "text": "Then he could see the modest bookseller, somewhat clammy in his extremities and lost within his academic robe and hood, nervously fidgeting his mortar-board, haled forward by ushers, and tottering rubescent before the chancellor, provost, president (or whoever it might be) who hands out the diploma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfbf74ea-f87a-4f08-9955-629e33063c3d",
                        "source_entry_id": "bdec9c12-13d8-3db2-ae30-6a5372b1afed",
                        "target_lang_word": "nervily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nervily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20bcf09d-e778-34a5-82c3-5ad6cac97047",
                                        "entry_id": "1cd0eeb3-88f7-3b1d-b988-f34e719f8937",
                                        "glosses": [
                                            "In a nervy way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfdf6c9b-f3b9-4afd-a633-47f595db747e",
                                                "sense_id": "20bcf09d-e778-34a5-82c3-5ad6cac97047",
                                                "text": "To put it more nervily, and of course Ms. Rice does: “Well, now I knew just what it meant to be the man who knew he was God.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
