                    "sense_id": "4234e9fd-2f3d-3f65-a7d5-88a1dd2861be",
                    "sense_definition": "iemand bang maken door te zeggen dat je diegene iets aan gaat doen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intimidatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overvaller <w>bedreigde</w> de medewerker van de winkel met een mes.",
                            "target_lang_translations": {
                                "en": "The robber <w>threatened</w> the shop employee with a knife.",
                                "ru": "Грабитель <w>угрожал</w> сотруднику магазина ножом."
                            }
                        },
                        {
                            "text": "Het is verboden om iemand met geweld te <w>bedreigen</w> via het internet.",
                            "target_lang_translations": {
                                "en": "It is forbidden to <w>threaten</w> someone with violence over the internet.",
                                "ru": "Запрещено <w>угрожать</w> кому-либо насилием через интернет."
                            }
