                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e2c3ca9-3cb4-4fda-b9dd-1b01a68e765b",
                        "source_entry_id": "754d8261-7c78-39a3-a7e0-1a7a93824d4d",
                        "source_sense_id": "194dbfb9-5b3e-33ee-a62f-202fcb73d06a",
                        "target_lang_word": "Druide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Druide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                        "entry_id": "d3f047c4-cb62-3bbb-ae30-0605bae939c5",
                                        "glosses": [
                                            "keltischer Priester"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f2142d7-357b-4205-add7-5fcf4a5d909b",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "In Gallien hatten die Druiden große Macht."
                                            },
                                            {
                                                "example_id": "c13e592c-ccb0-4322-8b7f-f1fbcdfcf716",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "„Den Neukelten beziehungsweise Neuheiden und vor allem den neuen Druiden geht es um eine Wiederbelebung keltischer Tradition, vor allem der keltischen Religion nach dem Motto: Nicht das Christentum, sondern das Heidentum ist die für Europa adäquate Religion.“"
                                            },
                                            {
                                                "example_id": "e637918f-6613-4f4d-81b6-256d01921b6d",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "„Ihre Priester, die Druiden, trafen sich einmal im Jahr an geweihtem Ort.“"
                                            },
                                            {
                                                "example_id": "48a3669e-fc7c-40eb-8d0c-0341376103b5",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "„Bei der Vermittlung zwischen Göttern und Menschen spielten die Druiden, was soviel wie ‚die Wissenden um die Eiche‘ bedeutet, eine wichtige Rolle.“"
                                            },
                                            {
                                                "example_id": "0ce4597e-c0f6-4704-a7d5-4e03145ab88a",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "„Die Druiden waren die ausgebildeten Spezialisten für Religion und Ritus, zudem Richter in privaten und öffentlichen Angelegenheiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "238b9f24-3858-477f-ac2f-acac5468e96c",
