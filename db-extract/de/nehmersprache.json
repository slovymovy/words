                ],
                "senses": [
                    {
                        "sense_id": "6785b47a-d42a-3f77-80d2-f1ca03c59acd",
                        "entry_id": "f706a457-b7d3-3233-a7f6-80bcd8f39f42",
                        "glosses": [
                            "die Sprache, die Wörter oder andere sprachliche Ausdrücke aus anderen Sprachen entlehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a98df4a3-97ae-483d-bef3-0e3b1b848606",
                                "sense_id": "6785b47a-d42a-3f77-80d2-f1ca03c59acd",
                                "text": "„Ein Lehnwort ist das Ergebnis einer sprachlichen Entlehnung, bei der ein Wort aus einer Sprache (Gebersprache, Quellsprache) in eine (Nehmersprache, Zielsprache) übernommen wird."
                            },
                            {
                                "example_id": "dce0bd30-a261-4a93-ba66-ddae563d360e",
                                "sense_id": "6785b47a-d42a-3f77-80d2-f1ca03c59acd",
                                "text": "„Sie sind das Ergebnis eines Sprachkontakts, bei dem ein Wort von einer Gebersprache in eine Nehmersprache übernommen wird.“"
                            },
                            {
                                "example_id": "50e71a8d-e03b-452e-a2d8-b28a345d717f",
                                "sense_id": "6785b47a-d42a-3f77-80d2-f1ca03c59acd",
                                "text": "„Lehnbedeutung (engl. semantic calque, frz. calque sémantique) Bezeichnung für die Übernahme der Bedeutung eines fremdsprachigen Ausdrucks in ein bereits vorhandenes Wort der Nehmersprache […]“"
                            },
                            {
                                "example_id": "80a8c3b8-4336-40d7-91db-ab0abe0d4623",
                                "sense_id": "6785b47a-d42a-3f77-80d2-f1ca03c59acd",
                                "text": "„In weitgehender Übereinstimmung betrachten die meisten Forscher ein Wort als Fremdwort, das sich in Lautung oder/und Intonation oder/und Schreibung nicht in die Nehmersprache eingepaßt hat und somit eindeutig als Wort fremder Herkunft zu erkennen ist.“"
                            },
                            {
                                "example_id": "147651a1-f00b-4ea8-bb10-de958258a2ae",
                                "sense_id": "6785b47a-d42a-3f77-80d2-f1ca03c59acd",
                                "text": "„Ich würde sogar so weit gehen zu sagen, dass solche neuen Gebräuche in der Nehmersprache keineswegs als falsch bezeichnet werden können, wie dies von manchen heutigen Sprachpuristen zu hören ist, denn das entlehnte Wort und seine neue Bedeutung gehören in dieser Kombination gar nicht mehr ihrer bisherigen Sprache an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
