            {
                "entry_id": "fa266953-d191-3be8-a371-4d96ffeae704",
                "word": "téléspectateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "edfa0788-1d78-423a-9169-6c17b7d40eca",
                        "entry_id": "fa266953-d191-3be8-a371-4d96ffeae704",
                        "tags": [
