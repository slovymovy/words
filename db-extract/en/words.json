                        ],
                        "examples": [
                            {
                                "example_id": "afc71b0f-1ac7-4c5e-bb63-3509fed094c7",
                                "sense_id": "bf95eae9-f6f6-3a6a-9511-c792d900fb7e",
                                "text": "Words have a longer life than deeds. — Pindar (translated)"
                            }
