                ],
                "senses": [
                    {
                        "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                        "entry_id": "8b7a3050-15c6-36ba-894a-da835a9977ff",
                        "glosses": [
                            "utopisches Wunschbild, das sich verwirklichen lassen kann, realisiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b752968-0c4e-46ac-937a-a3ba847bdc32",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„In diesem Sinne werden die Verheißungen, nach denen sich die Glaubenshoffnung richtet, zu Realutopien umgedeutet, deren Verwirklichung geboten ist.“"
                            },
                            {
                                "example_id": "d127d994-e947-401d-89cc-8ac33eb95e95",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„Aber nochmals: Es geht um Realutopien, nicht um fiktive Fantasiegebilde, die man heute auch oft ‚Visionen‘ nennt.“"
                            },
                            {
                                "example_id": "b6136c70-f9c6-4c58-a075-490ece426669",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„Es handelt sich dann nicht mehr um Schöpfung und Widerlegung utopischer Systeme, sondern um Realutopien, genauer, um real gelebte Utopie.“"
                            },
                            {
                                "example_id": "dee5b9b4-4360-471b-a660-d1c2e952aa49",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„Menschenrechte werden als Realutopien betrachtet, deren Umsetzung stets neu verdeutlicht und erkampft werden muss.“"
                            },
                            {
                                "example_id": "c751d3b8-b5ab-4527-a7bb-e47abc905a87",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„Einige sehen im Wirken der Zivilgesellschaft sogar ein Beispiel für zukünftiges gesellschaftliches Handeln (feministische Realutopie).“"
                            },
                            {
                                "example_id": "e6b61e0c-caab-48a9-8eb2-a5f3434f193e",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„Der Intellektuelle endlich übertrifft an Unbestimmtheit und Unfixiertheit noch den Philosophen, er bildet die Realutopie des geistigen Nirgendwo.“"
                            },
                            {
                                "example_id": "2d17e54a-2acf-4552-a5aa-597e222ca84d",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„Der besondere Charakter der Kinderrechte als ‚Realutopie‘ ist für die Mehrheit der Interviewpartner/innen schwierig zu fassen.“"
                            },
                            {
                                "example_id": "ef5a4351-5743-42dc-99d4-d8c1153031ff",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„Sie verweisen aber gleichzeitig als Realutopien über die Soziale Arbeit hinaus auf eine ethische Orientierung aller Menschen und staatlichen Institutionen.“"
                            },
                            {
                                "example_id": "ee22f374-b353-400d-8673-d53f49399b6a",
                                "sense_id": "23f812a5-e11d-3461-8d8f-0a106183e8c8",
                                "text": "„Die Kritische Soziale Arbeit wird von der Realutopie getragen, dass eine solidarische und gerechte Welt möglich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
