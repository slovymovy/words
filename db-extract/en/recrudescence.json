                        "source_entry_id": "2a9104b6-403a-33b0-b1a1-9b167e01eb9b",
                        "source_sense_description": "acute recurrence of a disease, or its symptoms, after a period of improvement",
                        "target_lang_word": "recrudescence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
