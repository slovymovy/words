                    {
                        "sense_id": "30df67ae-e167-3207-9ba7-a65591a44b58",
                        "entry_id": "f67c25a1-cabe-36c4-89ae-f3028656a5b3",
                        "glosses": [
                            "meubel of plaats in een gebouw met voorzieningen om zich te wassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a28df0-c100-4160-afce-a30cac79a284",
                                "sense_id": "30df67ae-e167-3207-9ba7-a65591a44b58",
                                "text": "Elke kamer had lavabo en bidet doch er was maar één badkamer voor de gasten."
                            }
                        ]
                    },
                    {
                        "sense_id": "e846fdeb-8c5b-327c-9177-49ac3900afc1",
                        "entry_id": "f67c25a1-cabe-36c4-89ae-f3028656a5b3",
                        "glosses": [
                            "nis voor een wasbekken in middeleeuwse gebouwen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c1d900c8-3c20-4475-b75f-8f8e21e4ec4f",
                                "sense_id": "e846fdeb-8c5b-327c-9177-49ac3900afc1",
                                "text": "De kruisgang, met uitgebouwd lavabo, wordt gedekt door een zoldering met samengestelde balklaag en troggewelfjes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cc9499b-b8ee-35a3-8933-0fa5e1fa6bef",
                        "entry_id": "f67c25a1-cabe-36c4-89ae-f3028656a5b3",
                        "glosses": [
                            "waskom om handen te wassen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f0a9c8fc-51d4-40a2-ac44-c9aaf691413d",
                                "sense_id": "5cc9499b-b8ee-35a3-8933-0fa5e1fa6bef",
                                "text": "De lavabo is volgens Bitter vele tienduizenden euro's waard. De waterpot deed dienst bij speciale feestmalen. Gasten gebruikten de pot om de handen te wassen, wat een soort ritueel was. De eigenaar ontleende status aan het bezit van een lavabo."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ecee8e6-5651-332f-9c6b-e15d77ce021a",
                        "entry_id": "f67c25a1-cabe-36c4-89ae-f3028656a5b3",
                        "glosses": [
                            "kom of kan voor de rituele handwassing in de Latijnse mis"
                        ],
                        "tags": [
                            "rooms-katholiek"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "765065c8-ffaa-4372-8984-e73e2eaf0b88",
                        "source_entry_id": "f67c25a1-cabe-36c4-89ae-f3028656a5b3",
                        "source_sense_id": "30df67ae-e167-3207-9ba7-a65591a44b58",
                        "source_sense_description": "meubel of plaats in een gebouw met voorzieningen om zich te wassen",
                        "target_lang_word": "Waschbecken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschbecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                        "entry_id": "089a549d-16ac-3652-b6ab-73a42f433fae",
                                        "glosses": [
                                            "meist an einer Wand befestigte, sanitäre Anlage zum Waschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dff3ea3-d87f-4694-9586-fa0cc63ef60a",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "Er wusch sich am Waschbecken die dreckigen Hände."
                                            },
                                            {
                                                "example_id": "17621eb5-1d71-4671-b188-a8b7c02e5219",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "„Nicht weit von Mr. Smile und mir entfernt wusch eine Frau Wäsche, sie schlug auf nasse Kleider in einem kleinen öffentlichen Waschbecken ein, das an einer Wasserstelle neben der unbefestigten Straße stand.“"
                                            },
                                            {
                                                "example_id": "ddbc16e2-67b3-4a83-b7e9-0f0194c62c8f",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "„Grenfeld stützte sich am Waschbecken ab.“"
                                            },
                                            {
                                                "example_id": "921a1281-5810-4ee7-93bf-b4bdc3f58af6",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "„Wir wählen ein Zimmer im Untergeschoß, das gleich zweifach Vorteile bietet: ein Waschbecken mit Wasserleitung, die sogar funktioniert, und einen rückwärtigen Ausgang.“"
                                            },
                                            {
                                                "example_id": "451d51d8-c6a2-488d-8679-1eba94e08e6c",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "„Mr. Sipple wollte durch die Küche gehen und war stehengeblieben, um über die Schulter seiner Frau hinweg das winzige Mädchen im Waschbecken auf dem Küchentisch zu betrachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "650afac3-259c-4bff-87b3-87c2b40fc819",
                        "source_entry_id": "f67c25a1-cabe-36c4-89ae-f3028656a5b3",
                        "source_sense_id": "30df67ae-e167-3207-9ba7-a65591a44b58",
                        "source_sense_description": "meubel of plaats in een gebouw met voorzieningen om zich te wassen",
                        "target_lang_word": "lavabo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lavabo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c79dd99a-c700-3293-872a-b4b8c8a4f010",
                                        "entry_id": "0a4111c4-05fc-3f6e-9c24-2f58242cd230",
                                        "glosses": [
                                            "Prière que le prêtre dit en lavant ses doigts durant la messe, avant la consécration."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd11ee8b-1b29-3511-a671-8d43ec46c37c",
                                        "entry_id": "0a4111c4-05fc-3f6e-9c24-2f58242cd230",
                                        "glosses": [
                                            "Vasque destinée aux ablutions du prêtre officiant."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "494d5ecd-4402-33be-bcc7-b18778486915",
                                        "entry_id": "0a4111c4-05fc-3f6e-9c24-2f58242cd230",
                                        "glosses": [
                                            "Dispositif mobile garni d’une cuvette et d’un pot à eau ou d’une cuvette fixe, surmontée de robinets et dotée d’un trou d’évacuation d’eau et destinée à se laver."
                                        ],
                                        "tags": [
                                            "Ordinairement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66558260-7b06-4859-a979-f68daa3c5f55",
                                                "sense_id": "494d5ecd-4402-33be-bcc7-b18778486915",
                                                "text": "Mistingue.– Une brosse ! du savon !…\nIls courent au lavabo, qu’ils apportent sur le devant de la scène et s’y lavent les mains."
                                            },
                                            {
                                                "example_id": "2e713ed8-f220-456c-ada6-492e6860b7d7",
                                                "sense_id": "494d5ecd-4402-33be-bcc7-b18778486915",
                                                "text": "Il serait difficile de décrire le pittoresque désordre qui règne dans ce noir séjour à l’heure où chacun attend son tour de passer à l’unique lavabo."
                                            },
                                            {
                                                "example_id": "0760ac5b-ed1e-431a-8783-271ff7942b53",
                                                "sense_id": "494d5ecd-4402-33be-bcc7-b18778486915",
                                                "text": "Il saisit rageusement sa perruque, qui lui redonnait pour un soir la chevelure bananoïde de ses chères sixties, et la jette dans le lavabo où elle se met à sombrer comme un transatlantique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac605b30-37ce-302a-afa1-b9fe86041fb5",
                                        "entry_id": "0a4111c4-05fc-3f6e-9c24-2f58242cd230",
                                        "glosses": [
                                            "Pièce où est fixée cette sorte de cuvette."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b175e676-164c-36b6-82a0-3ef1218f9c02",
                                        "entry_id": "0a4111c4-05fc-3f6e-9c24-2f58242cd230",
                                        "glosses": [
                                            "Cabinet d’aisances installé dans cette pièce ou à proximité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adc6f988-13e9-4d6c-b639-650eaf8a6dd3",
                                                "sense_id": "b175e676-164c-36b6-82a0-3ef1218f9c02",
                                                "text": "Toutes les dix minutes, elle répare son maquillage au lavabo."
                                            },
                                            {
                                                "example_id": "9a3dc5a6-6eea-42ae-832a-ff10939da488",
                                                "sense_id": "b175e676-164c-36b6-82a0-3ef1218f9c02",
                                                "text": "Il se rendit aux lavabos, en revint les mains nettes, les cheveux brossés, le regard éclairé d’une petite flamme."
                                            },
                                            {
                                                "example_id": "18216a6b-97a4-486d-b522-e1d9da2209c6",
                                                "sense_id": "b175e676-164c-36b6-82a0-3ef1218f9c02",
                                                "text": "Pourtant, comme le train venait de dépasser Bréauté et qu’il ralentissait quelque peu — ce qui mettait sa vitesse à trente kilomètres à l’heure pour le moins, — il feignit de pénétrer au lavabo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
