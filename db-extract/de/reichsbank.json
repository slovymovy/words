                                "sense_id": "10774211-6a37-305f-956e-28f7fe02b45d",
                                "text": "„Vor allem vor der Reichsbank in Berlin sowie vor großen Filialen der Reichspost in wichtigen Städten bildeten sich bald lange Schlangen.“"
                            },
                            {
                                "example_id": "1e7bc0cd-b5e7-421e-af3d-0558e865af05",
                                "sense_id": "10774211-6a37-305f-956e-28f7fe02b45d",
                                "text": "„Dennoch wurde die Reichsbank in mehrfacher Hinsicht gegenüber den übrigen Notenbanken privilegiert.“"
                            }
