                        "glosses": [
                            "Nouveau banditisme des cités, utilisant certains moyens violents du grand banditisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c600b3e-18ed-42bf-b813-e4285013b7b7",
                                "sense_id": "5acfa848-753b-3166-a99d-f70d69adfd5c",
                                "text": "Tout cela serait donc du « néobanditisme » pour désigner les faits d’armes des jeunes des cités qui veulent se hisser au niveau de leurs aînés, mais n’en ont que rarement la carrure."
                            },
                            {
                                "example_id": "eb2e8fa5-5819-4a66-b481-9f0d2240fea7",
                                "sense_id": "5acfa848-753b-3166-a99d-f70d69adfd5c",
                                "text": "Comment expliquer les dernières dérives du banditisme ?\nPar l’émergence d’un «néobanditisme», monté en puissance ces trois dernières années dans les cités."
                            }
                        ]
                    }
