                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bf096fd-3436-3954-9da0-1c9797d805f8",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To give (someone or something) food to eat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3353f452-7bcf-4a20-bd74-3ba5b0434389",
                                                "sense_id": "8bf096fd-3436-3954-9da0-1c9797d805f8",
                                                "text": "Feed the dog every evening."
                                            },
                                            {
                                                "example_id": "a6c86c03-a35e-480f-8b6f-641f394a9ff1",
                                                "sense_id": "8bf096fd-3436-3954-9da0-1c9797d805f8",
                                                "text": "If thine enemy hunger, feed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3d77d93-18b6-39a3-93b2-744a8c8a19a4",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To eat (usually of animals)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfea0b98-4d07-4beb-87a5-1bd3fbfaffa1",
                                                "sense_id": "a3d77d93-18b6-39a3-93b2-744a8c8a19a4",
                                                "text": "Spiders feed on gnats and flies."
                                            },
                                            {
                                                "example_id": "2d064b3d-707f-43af-8290-cb0fba5ee86c",
                                                "sense_id": "a3d77d93-18b6-39a3-93b2-744a8c8a19a4",
                                                "text": "“The treasurer was of the same opinion: he showed to what straits his majesty’s revenue was reduced, by the charge of maintaining you, which would soon grow insupportable; that the secretary’s expedient of putting out your eyes, was so far from being a remedy against this evil, that it would probably increase it, as is manifest from the common practice of blinding some kind of fowls, after which they fed the faster, and grew sooner fat;[...]"
                                            },
                                            {
                                                "example_id": "5be33b68-d9d8-43b9-9091-426426858406",
                                                "sense_id": "a3d77d93-18b6-39a3-93b2-744a8c8a19a4",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window at the old mare feeding in the meadow below by the brook, and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge,[…]."
                                            },
                                            {
                                                "example_id": "cdcee340-5973-4fca-9e12-0bc39f64eb04",
                                                "sense_id": "a3d77d93-18b6-39a3-93b2-744a8c8a19a4",
                                                "text": "While feeding, the basking shark swims at about two knots per hour, and this enables it to eat and breathe in the same motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a088b0e-beb1-3a57-8d22-5262bcd7348b",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To give (someone or something) to (someone or something else) as food."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8bd9fb9-8c9f-4aab-80ea-132e7c8e82d8",
                                                "sense_id": "0a088b0e-beb1-3a57-8d22-5262bcd7348b",
                                                "text": "Don't feed him too much; he's still a baby."
                                            },
                                            {
                                                "example_id": "181dce9d-8699-4836-9766-0e4a2d0a7fdb",
                                                "sense_id": "0a088b0e-beb1-3a57-8d22-5262bcd7348b",
                                                "text": "Feed the fish to the dolphins."
                                            },
                                            {
                                                "example_id": "59fde4f8-94a1-4c08-9fae-faf2e67df8ee",
                                                "sense_id": "0a088b0e-beb1-3a57-8d22-5262bcd7348b",
                                                "text": "DR SIMEON: I said I'd feed you. I didn't say who to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01c30977-48c1-37f3-88bd-906a88e795a0",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To give to a machine to be processed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e1247bc-e1cf-4f68-8415-85ed24192619",
                                                "sense_id": "01c30977-48c1-37f3-88bd-906a88e795a0",
                                                "text": "Feed the paper gently into the document shredder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb960695-9308-3511-b3d3-6c144b62d5a1",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To supply (a machine) with something to be processed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b9966f-2957-45a6-a7c0-d46a7d8e470f",
                                                "sense_id": "cb960695-9308-3511-b3d3-6c144b62d5a1",
                                                "text": "We got interesting results after feeding the computer with the new data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3298abcc-0242-30e6-ab3e-fadc500a1d0f",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To satisfy, gratify, or minister to (a sense, taste, desire, etc.)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44760e60-b841-4196-be1a-1dfa907afa5d",
                                                "sense_id": "3298abcc-0242-30e6-ab3e-fadc500a1d0f",
                                                "text": "If I can catch him once upon the hip, / I will feed fat the ancient grudge I bear him."
                                            },
                                            {
                                                "example_id": "ba3ff179-9b61-4c05-a34c-6f77c2bca4d5",
                                                "sense_id": "3298abcc-0242-30e6-ab3e-fadc500a1d0f",
                                                "text": "feeding him with the hope of liberty"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57cf06b5-2d6d-3550-97ae-b8d518f04dea",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To supply with something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05fb5d0a-4ae1-4b94-93fd-e3d01527d734",
                                                "sense_id": "57cf06b5-2d6d-3550-97ae-b8d518f04dea",
                                                "text": "Springs feed ponds with water."
                                            },
                                            {
                                                "example_id": "10c790b4-58b6-41bb-b5af-bab42eee3fc6",
                                                "sense_id": "57cf06b5-2d6d-3550-97ae-b8d518f04dea",
                                                "text": "The hand that mocked them and the heart that fed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e57cda-7c5d-36d2-9f72-a6aad52d7ccd",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To graze; to cause to be cropped by feeding, as herbage by cattle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b7430f5-0de1-44ec-aa8d-b64c50943ee8",
                                                "sense_id": "a7e57cda-7c5d-36d2-9f72-a6aad52d7ccd",
                                                "text": "If grain is too forward in autumn, feed it with sheep."
                                            },
                                            {
                                                "example_id": "1f8cf95b-310f-43bf-9a17-9e56deef7446",
                                                "sense_id": "a7e57cda-7c5d-36d2-9f72-a6aad52d7ccd",
                                                "text": "Once in three years, or every other year, feed your mowing-lands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ecad688-3f5a-3103-bea8-8c2c533ab49b",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To pass to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63508486-184c-4fa7-8da0-32a1882c34ed",
                                                "sense_id": "9ecad688-3f5a-3103-bea8-8c2c533ab49b",
                                                "text": "Morrison then played a pivotal role in West Brom's equaliser, powering through the middle and feeding Tchoyi, whose low, teasing right-wing cross was poked in by Thomas at the far post"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9088805-4901-3f64-b82d-1cd68bb4adb8",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To create the environment where another phonological rule can apply; to be applied before (another rule)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd19eaef-7686-4573-b8dd-ddebd1a8eaa2",
                                                "sense_id": "d9088805-4901-3f64-b82d-1cd68bb4adb8",
                                                "text": "Nasalization feeds raising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e2118b-2bf8-3b34-8e7b-a8426923298f",
                                        "entry_id": "a0eda558-e456-37d3-b9b4-33fcffef6da4",
                                        "glosses": [
                                            "To create the syntactic environment in which another syntactic rule is applied; to be applied before (another syntactic rule)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "826c40e3-5181-47a4-9e04-aa8d89974acf",
                                                "sense_id": "09e2118b-2bf8-3b34-8e7b-a8426923298f",
                                                "text": "This orthodox analysis […] leads to the conclusion that […] Subject–Auxiliary Inversion (SAI) is fed by the contraction operation."
                                            }
                                        ]
                                    }
                                ]
