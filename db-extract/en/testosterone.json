    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a6191cc8-b850-3154-ad90-c5b09e9a36f8",
                "word": "testosterone",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "82c92551-57e1-41ac-a059-423b2b853513",
                        "entry_id": "a6191cc8-b850-3154-ad90-c5b09e9a36f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "testosterones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd02236f-b16d-338c-aa21-4e1e79e8e989",
                        "entry_id": "a6191cc8-b850-3154-ad90-c5b09e9a36f8",
                        "glosses": [
                            "A steroid hormone that stimulates development of male secondary sexual characteristics, produced mainly in the testes, but also in the ovaries and adrenal cortex."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a0fb2a0e-1ed3-4f92-8ca8-79f841a2c267",
                                "sense_id": "fd02236f-b16d-338c-aa21-4e1e79e8e989",
                                "text": "Mammalian testes contain almost no testosterone because it is sent out into the body as quickly as it is made."
                            },
                            {
                                "example_id": "9797b5e7-aeb6-4671-86ad-ce945d0f08a3",
                                "sense_id": "fd02236f-b16d-338c-aa21-4e1e79e8e989",
                                "text": "The text recounts a 2011 experiment: Researchers tested 136 healthy young men’s testosterone levels, asked them about their political party affiliations, then gave them either a placebo or ten grams of AndroGel one percent, a high-end dose of a common form of testosterone often used in hormone replacement therapies."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c13f654-9f3f-31b2-9db6-e8d040626e86",
                        "entry_id": "a6191cc8-b850-3154-ad90-c5b09e9a36f8",
                        "glosses": [
                            "Manly behavior, often of an aggressive or foolishly reckless nature."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b812b89-b3af-4925-b8e4-c1918e48a760",
                                "sense_id": "6c13f654-9f3f-31b2-9db6-e8d040626e86",
                                "text": "Mother encouraged James to rely more on intelligence and less on testosterone to deal with the neighbor's son."
                            },
                            {
                                "example_id": "3c74a4a0-7fa4-4f96-b171-05bbac09546b",
                                "sense_id": "6c13f654-9f3f-31b2-9db6-e8d040626e86",
                                "text": "The MPS is a male orientated and misogynistic environment filled with testosterone, notches on bed posts and conquests."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd900016-51a3-4e4c-b12e-c3d3f2012481",
                        "source_entry_id": "a6191cc8-b850-3154-ad90-c5b09e9a36f8",
                        "source_sense_description": "steroid hormone",
                        "target_lang_word": "testosteron",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bb53a60e-cf1e-4554-98bb-d78fd29d081e",
                        "source_entry_id": "a6191cc8-b850-3154-ad90-c5b09e9a36f8",
                        "source_sense_description": "steroid hormone",
                        "target_lang_word": "testosteron",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "testosteron",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "59c2771b-2bb3-3260-86dd-1411a6b095ae",
                                        "entry_id": "1db261cb-99c2-3bcd-819d-c02e5367784e",
                                        "glosses": [
                                            "mannelijk geslachtshormoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6673783-43c1-4793-a1ca-aec8adb35c64",
                                                "sense_id": "59c2771b-2bb3-3260-86dd-1411a6b095ae",
                                                "text": "Er ontstaat een soort gelukscocktail zodra je de hele dag loopt. Een mix van endorfine, serotonine, dopamine, oxytocine en testosteron."
                                            },
                                            {
                                                "example_id": "f260d353-23d5-4f4c-b2ec-427a5689304a",
                                                "sense_id": "59c2771b-2bb3-3260-86dd-1411a6b095ae",
                                                "text": "Als de baas van het nieuwe D 25 de codenaam 'Eva'had gehad, had geen van al deze min of meer verwarde maar vol testosteron zittende verzetslui haar serieus genomen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c204e1f4-ab54-4756-8a40-338e670a89ec",
                        "source_entry_id": "a6191cc8-b850-3154-ad90-c5b09e9a36f8",
                        "source_sense_description": "steroid hormone",
                        "target_lang_word": "testostérone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "testostérone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1294a794-f045-3609-81dd-2f71eaf377d2",
                                        "entry_id": "e02b1e4b-5a49-3e6c-a0d5-9425e279bcde",
                                        "glosses": [
                                            "Hormone stéroïdienne androgène principalement produite par les cellules de Leydig des testicules, ainsi que par les ovaires et les glandes surrénales, qui participe au développement et au maintien des caractères sexuels masculins, notamment à la puberté."
                                        ],
                                        "tags": [
                                            "Endocrinologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67733db9-4175-460d-badd-36276ea5dc8d",
                                                "sense_id": "1294a794-f045-3609-81dd-2f71eaf377d2",
                                                "text": "Des études ont montré, par exemple, que les supporters d'une équipe de football qui perd voient leur niveau de testostérone chuter, contrairement à celui des supporters de l'équipe vainqueure, dont le taux de testostérone augmente (sachant que les niveaux étaient comparables avant le match)."
                                            },
                                            {
                                                "example_id": "10f3922a-f16e-4ea1-9f5a-1296fee89166",
                                                "sense_id": "1294a794-f045-3609-81dd-2f71eaf377d2",
                                                "text": "Seules la testostérone et la dihydrotestostérone sont des androgènes actifs qui se lient spécifiquement aux récepteurs des androgènes."
                                            },
                                            {
                                                "example_id": "f4e4a6b4-80fe-4819-84c7-a1dc1737d279",
                                                "sense_id": "1294a794-f045-3609-81dd-2f71eaf377d2",
                                                "text": "Comme cette équipe de baraques paramilitaires gonflées à la testostérone, surarmés…"
                                            },
                                            {
                                                "example_id": "007f87cc-a358-4941-86ab-b323d9286b1a",
                                                "sense_id": "1294a794-f045-3609-81dd-2f71eaf377d2",
                                                "text": "« La testostérone a un effet sur la libido. Il faut que des taux de testostérone soient présents pour qu’on ait envie d’aller vers un acte sexuel. On sait par ailleurs que lorsqu’on s’adonne à une activité sexuelle, cela fait monter à son tour les taux de testostérone. C’est un effet d’auto-entraînement. »"
                                            },
                                            {
                                                "example_id": "63aa0be7-2646-4373-af2f-29ea54a6d1ff",
                                                "sense_id": "1294a794-f045-3609-81dd-2f71eaf377d2",
                                                "text": "La testostérone que j'ingère quotidiennement me fait muter, intérieur-extérieur. Ma voix s'est égarée dans les graves, mes poils m'ont assaillie, et maintenant c'est moi qui m'occupe de Mathias. Matin, midi et soir. J'ai usé trois godes-ceintures, jusqu'à la corne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ea1ab1-3960-34a2-9cfb-3881ce4e4f0b",
                                        "entry_id": "e02b1e4b-5a49-3e6c-a0d5-9425e279bcde",
                                        "glosses": [
                                            "Virilité ostentatoire ; comportement perçu comme particulièrement masculin ou machiste."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7ea12a6-2043-4759-8424-8041f89e45d9",
                                                "sense_id": "a1ea1ab1-3960-34a2-9cfb-3881ce4e4f0b",
                                                "text": "À bien y regarder, ces braqueurs, c'étaient pas des pégreleux mais des frangines ! Trois gazelles, avec plus de testostérone que le pauvre mariole que je suis, apparemment. Quand elles ont aperçu les flics, elles ont toutes plongé dans la marave, sans un fétu de pétoche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0071a36f-7c5b-43ae-a8eb-8c7d55d646a4",
                        "source_entry_id": "a6191cc8-b850-3154-ad90-c5b09e9a36f8",
                        "source_sense_description": "steroid hormone",
                        "target_lang_word": "Testosteron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Testosteron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                                        "entry_id": "ae386f12-75a8-3b24-b0d4-9cfc62269124",
                                        "glosses": [
                                            "Hormon, das für die männlichen Eigenschaften einer Person verantwortlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d46615-f787-4602-b08e-2e61be5db8a5",
                                                "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                                                "text": "„Vor vielen Jahrhunderten, als das Leben noch Sinn hatte, da zog der junge Mann voller Energie und Testosteron in den Krieg und reagierte sich dort ab, während die Frauen daheim ihm drohten, er solle entweder siegreich oder tot nach Hause kommen.“"
                                            },
                                            {
                                                "example_id": "212d74e7-ecaf-40b5-ae53-8b079c66e9c0",
                                                "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                                                "text": "„Dass Männer sich in jungen Jahren deutlich risikobereiter verhalten und dementsprechend häufiger in tödliche Autounfälle verwickelt sind, führen Wissenschaftler zwar teilweise auf die Wirkung des Testosterons zurück, das die Risikobereitschaft steigert. Aber das ist nur ein Teil der Wahrheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
