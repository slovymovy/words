                                        "sense_id": "c2367a4b-d70d-3983-a72d-1443d35534f0",
                                        "entry_id": "4dc0a5c2-5868-3712-8395-b40b61928e73",
                                        "glosses": [
                                            "The supporting member of an aerial cable (electric power or telephone or data)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2a8bf42-65c8-348d-8d33-1e2a5c96f386",
                                        "entry_id": "4dc0a5c2-5868-3712-8395-b40b61928e73",
                                        "glosses": [
                                            "A person appointed to perform certain ministerial duties under bankrupt and insolvent laws, such as to take charge of the estate of the bankrupt or insolvent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1f46510-7107-49f8-9d5b-d511150d7b3d",
                                                "sense_id": "c2a8bf42-65c8-348d-8d33-1e2a5c96f386",
                                                "text": "The Messenger under the joint Commission of Bankruptcy might have seized the Whole, if they had remained in their Warehouse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ce703f0-ccc4-3f39-ba6e-f72545c16bb5",
                                        "entry_id": "4dc0a5c2-5868-3712-8395-b40b61928e73",
                                        "glosses": [
                                            "An instant messenger program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "472fbac2-9d0b-4342-b21f-5d843c4650ee",
                                                "sense_id": "8ce703f0-ccc4-3f39-ba6e-f72545c16bb5",
                                                "text": "The 4 primary messengers include ^([sic]) AOL Instant Messenger, ICQ, Yahoo! Messenger, and MSN Messenger."
                                            },
                                            {
                                                "example_id": "0a228ed2-a64d-4c2e-a5cf-8d97ef04ee36",
                                                "sense_id": "8ce703f0-ccc4-3f39-ba6e-f72545c16bb5",
                                                "text": "Have them meet you on your favorite messenger program. IMs provide a means of instant chat without waiting on someone to respond back to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e406d03f-b6e4-3d5f-a830-f5aba37bc2cd",
                                        "entry_id": "4dc0a5c2-5868-3712-8395-b40b61928e73",
                                        "glosses": [
                                            "A forerunner or harbinger."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3ae9e83-1665-4efb-a1cd-5d074e19f964",
                                                "sense_id": "e406d03f-b6e4-3d5f-a830-f5aba37bc2cd",
