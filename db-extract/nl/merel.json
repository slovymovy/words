                    {
                        "sense_id": "1e7ef589-36e5-3f25-906d-26d0531893f8",
                        "entry_id": "e0d3aa3f-f99b-3a11-b9cd-50352d315940",
                        "glosses": [
                            "bepaald soort zwarte vogel met een gele snavel, Turdus merula, uit de familie van de lijsters"
                        ],
                        "tags": [
                            "zangvogels"
                        ],
                        "examples": [
                            {
                                "example_id": "3a9e8f9a-044d-44b5-b250-ce672adc611e",
                                "sense_id": "1e7ef589-36e5-3f25-906d-26d0531893f8",
                                "text": "Wij hebben de laatste tijd veel merels in de achtertuin."
                            },
                            {
                                "example_id": "9ed83387-2b71-42a3-8947-e2297b2f0ea6",
                                "sense_id": "1e7ef589-36e5-3f25-906d-26d0531893f8",
                                "text": "Pierewiet. Pierewiet. Het lied met pierewiet gaat over een merel in de lente. Dat mag best, nu de lente in het jasje van de herfst is gaan wonen. Samuel heeft geregeld muziektherapie en voor woorden als pierewiet, zeker bij herhaling uitgesproken, kun je hem wakker maken. Mooie, grappige klank. De herhaling van de ie, de rollende r. Hij lacht uitbundig bij een gezongen pierewiet. Nog een keer, dat refrein. En nog eens."
                            }
                        ]
                    }
                ],
