        "fr-extract.jsonl": [
            {
                "entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                "word": "girandole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "56e38874-b473-46b7-a3fb-32e0f4bd57fd",
                        "entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                        "tags": [
                            "plural"
                        ],
                        "form": "girandoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47650088-ddba-31ab-9029-605ab3dcd6f5",
                        "entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                        "glosses": [
                            "Faisceau de plusieurs jets d’eau ou gerbe pyrotechnique de fusées volantes qui partent en même temps ; girande."
                        ],
                        "tags": [
                            "Fontainerie",
                            "Pyrotechnie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e3665106-cf62-377a-a128-66ebdd57e3d2",
                        "entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                        "glosses": [
                            "(Luminaire) Chandelier à plusieurs branches disposées en pyramide, placé en applique ou sur une table, un buffet, un guéridon, ou sur une torchère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2990640d-1372-401d-a7e9-055efffe11be",
                                "sense_id": "e3665106-cf62-377a-a128-66ebdd57e3d2",
                                "text": "Il y avait abondance de girandoles à quatre branches sur les consoles et dont on garnit incontinent chaque petite table de salle à manger."
                            },
                            {
                                "example_id": "4be8d03b-4e97-41f4-b68d-12bb8814be03",
                                "sense_id": "e3665106-cf62-377a-a128-66ebdd57e3d2",
                                "text": "On peut faire l’amour à la lueur des girandoles, pas la vaisselle."
                            },
                            {
                                "example_id": "817f240d-621a-4c2b-a720-99779345804e",
                                "sense_id": "e3665106-cf62-377a-a128-66ebdd57e3d2",
                                "text": "Des girandoles de cristal, au lieu des cierges, faisaient jaillir des jets d’eau de leurs bobèches."
                            },
                            {
                                "example_id": "8e820e00-913a-4900-ad66-d8ad5d8f0930",
                                "sense_id": "e3665106-cf62-377a-a128-66ebdd57e3d2",
                                "text": "Des bahuts et des crédences, des landiers et des girandoles la décorent."
                            }
                        ]
                    },
                    {
                        "sense_id": "a960e844-2c83-3d96-8a48-8cd7dad7180c",
                        "entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                        "glosses": [
                            "Sorte d’éclairage employé dans les fêtes publiques, constitué par les lignes incurvées de lampions, de becs de gaz, d’ampoules électriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b7a5f9-5a74-413b-bbf1-ee6c39aa1767",
                                "sense_id": "a960e844-2c83-3d96-8a48-8cd7dad7180c",
                                "text": "Marions nos mains pour chanter et danser une ronde, […], à la splendeur magique de girandoles de cette nuit rieuse comme le jour."
                            },
                            {
                                "example_id": "f3552456-4b83-40bb-8d7a-a385e60cde3d",
                                "sense_id": "a960e844-2c83-3d96-8a48-8cd7dad7180c",
                                "text": "[…] ; et de ce plafond d’un beau rouge vineux pendaient çà et là, comme autant de girandoles, des clavellines transparentes, des botrilles dont les familles agglomérées ont les couleurs et la translucidité de l'agathe."
                            },
                            {
                                "example_id": "cda39c92-3912-4f18-8245-cdddc57be934",
                                "sense_id": "a960e844-2c83-3d96-8a48-8cd7dad7180c",
                                "text": "L’établissement en fête était orné de girandoles, de guirlandes en veilleuses de couleur, de grappes de lumières."
                            },
                            {
                                "example_id": "9ebb5249-c318-442a-845e-b197c2288609",
                                "sense_id": "a960e844-2c83-3d96-8a48-8cd7dad7180c",
                                "text": "Et Giglio, imaginant des lignes mystérieuses de la planète aux étoiles, décida qu’il ferait d’abord, avec cette girandole céleste, un éventail gemmé de neuf pierres…"
                            },
                            {
                                "example_id": "54389c62-c877-4225-8094-25878a338e3c",
                                "sense_id": "a960e844-2c83-3d96-8a48-8cd7dad7180c",
                                "text": "Ils avaient traversé des quartiers extraordinaires, tout illuminés de lanternes et de girandoles en papier, tout remplis de Bédouins et de burnous …"
                            }
                        ]
                    },
                    {
                        "sense_id": "25e2315d-2e86-36e1-960a-0a196312d7d9",
                        "entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                        "glosses": [
                            "Assemblage de diamants ou d’autres pierres précieuses, qui sert à la parure des femmes, et qu’elles portent à leurs oreilles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6247bfc2-2f23-3ac6-b876-872406dce282",
                        "entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                        "glosses": [
                            "Quelques plantes dont les fleurs forment des sortes de bouquet ; et, en termes de Botanique, de certaines plantes aquatiques dont les feuilles sont disposées en verticilles."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "f2ea2bd2-046d-4eb2-a86f-bf0f2415c49f",
                                "sense_id": "6247bfc2-2f23-3ac6-b876-872406dce282",
                                "text": "Le marronnier géant de l’église était fleuri de girandoles pâles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f597abe2-e821-49da-bd75-1cda8e1f1fb7",
                        "source_entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                        "target_lang_word": "girandole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "girandole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "106fe098-2633-3729-8eae-f0b0460e1aa7",
                                        "entry_id": "85cef7c6-0088-3610-9af7-16c1c92c8f1b",
                                        "glosses": [
                                            "An ornamental branched candle holder, sometimes with a mirror behind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93087592-96ea-4c90-9703-940b8f46571b",
                                                "sense_id": "106fe098-2633-3729-8eae-f0b0460e1aa7",
                                                "text": "1847, Charlotte Brontë, Jane Eyre, Chapter XVIII\nAs I sat in my usual nook, and looked at him with the light of the girandoles on the mantelpiece beaming full over him..."
                                            },
                                            {
                                                "example_id": "84a04745-ce45-4f57-87c0-684bf383835d",
                                                "sense_id": "106fe098-2633-3729-8eae-f0b0460e1aa7",
                                                "text": "It was a scene of gaiety, glitter, and show; of richly–dressed people, handsome mirrors, chalked floors, girandoles and wax–candles; and in all parts of the scene, gliding from spot to spot in silent softness, bowing obsequiously to this party, nodding familiarly to that, and smiling complacently on all, was the sprucely–attired person of Angelo Cyrus Bantam, Esquire, the Master of the Ceremonies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f0d6d8c-2079-300e-904e-3665396164ef",
                                        "entry_id": "85cef7c6-0088-3610-9af7-16c1c92c8f1b",
                                        "glosses": [
                                            "A type of firework which creates a \\\"whirling top\\\" or \\\"flying saucer\\\" effect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86f63030-071f-4dd5-8f5a-9add1046c183",
                        "source_entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
