                        "entry_id": "2d1ed1ea-10d8-3d00-93d0-de82c46b7fa5",
                        "glosses": [
                            "Vorrichtung an Kameras und anderen optischen Geräten, die den Fokus automatisch scharf stellt"
                        ],
                        "tags": [
                            "Fotografie"
                        ],
                        "examples": [
                            {
