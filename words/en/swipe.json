                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With one quick <w>swipe</w>, the bear caught the fish in the river.",
                            "target_lang_translations": {
                                "ru": "Одним быстрым <w>взмахом</w> лапы медведь поймал рыбу в реке."
