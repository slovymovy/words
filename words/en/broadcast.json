                    "frequency": "High",
                    "semantic_group_id": "media_transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We interrupt this <w>broadcast</w> to bring you breaking news.",
                            "target_lang_translations": {
                                "ru": "Мы прерываем эту <w>передачу</w>, чтобы сообщить срочные новости.",
                                "zh": "我们中断本次<w>广播</w>以插播突发新闻。",
