                "senses": [
                    {
                        "sense_id": "fe78d240-aa74-3cae-9515-7dc3e3d6bdb2",
                        "entry_id": "51b25b9f-974f-3b57-85f5-2151376cccad",
                        "glosses": [
                            "разг. остановка, задержка при ходьбе, движении"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "59a4fd78-564d-36ee-b3ec-9ba010b6812d",
                        "entry_id": "51b25b9f-974f-3b57-85f5-2151376cccad",
                        "glosses": [
                            "разг. остановка в речи вследствие затруднения в выборе слов, в произношении"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "728edfa6-8526-4df5-8343-43dc5957291b",
                        "source_entry_id": "51b25b9f-974f-3b57-85f5-2151376cccad",
                        "target_lang_word": "stumble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ab25bbb-a59b-3083-9557-d5fc39f776ec",
                                        "entry_id": "6a830b54-e4d5-339d-b180-bbbd27cb3daf",
                                        "glosses": [
                                            "A fall, trip or substantial misstep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b889b993-1e0f-4d55-8901-1cbef98dcdcf",
                                                "sense_id": "7ab25bbb-a59b-3083-9557-d5fc39f776ec",
                                                "text": "I went to his aid. As he said, a board in the floor was loose. His stepping on it unawares had caused his stumble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f13fcbb2-3a47-316a-a455-169173bf2562",
                                        "entry_id": "6a830b54-e4d5-339d-b180-bbbd27cb3daf",
                                        "glosses": [
                                            "An error or blunder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4849af74-3467-4575-af46-88c98f38962e",
                                                "sense_id": "f13fcbb2-3a47-316a-a455-169173bf2562",
                                                "text": "She owns up to early stumbles, such as bottles being mislabeled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3781e590-5219-37b5-9f70-86408745e5c2",
                                        "entry_id": "6a830b54-e4d5-339d-b180-bbbd27cb3daf",
                                        "glosses": [
                                            "A clumsy walk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b4a5df-652c-4041-8f0a-3e9dbe744e44",
                                                "sense_id": "3781e590-5219-37b5-9f70-86408745e5c2",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b2b70d0-5a19-3248-9da8-6862309e099c",
                                        "entry_id": "23650190-532d-3730-a386-dfde6fc51f3a",
                                        "glosses": [
                                            "To trip or fall; to walk clumsily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "549bcd4d-2e10-4bff-ac09-48d15536a6f4",
                                                "sense_id": "5b2b70d0-5a19-3248-9da8-6862309e099c",
                                                "text": "He stumbled over a rock."
                                            },
                                            {
                                                "example_id": "bc9d1493-3d18-4116-8187-cf596d2e243c",
                                                "sense_id": "5b2b70d0-5a19-3248-9da8-6862309e099c",
                                                "text": "Last night, you drunkenly stumbled to the front door, waking up the whole house."
                                            },
                                            {
                                                "example_id": "4baa0061-cd87-4d32-91d1-eda9b0b29b51",
                                                "sense_id": "5b2b70d0-5a19-3248-9da8-6862309e099c",
                                                "text": "He stumbled up the dark avenue."
                                            },
                                            {
                                                "example_id": "cf844207-1999-45c7-80c0-3a13e9edbf4f",
                                                "sense_id": "5b2b70d0-5a19-3248-9da8-6862309e099c",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1678fc7c-7625-30b9-bdc1-2da3738b6220",
                                        "entry_id": "23650190-532d-3730-a386-dfde6fc51f3a",
                                        "glosses": [
                                            "To make a mistake or have trouble."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "476bc73e-e7db-4ff6-a084-77313756980a",
                                                "sense_id": "1678fc7c-7625-30b9-bdc1-2da3738b6220",
                                                "text": "I always stumble over verbs in Spanish."
                                            },
                                            {
                                                "example_id": "f17bc295-d238-487c-8569-9846bd6102b3",
                                                "sense_id": "1678fc7c-7625-30b9-bdc1-2da3738b6220",
                                                "text": "[…] they are out of the way through strong drinke, they erre in vision, they stumble in iudgement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc18a6c-91a4-3dba-acd3-19cd28a11fb5",
                                        "entry_id": "23650190-532d-3730-a386-dfde6fc51f3a",
                                        "glosses": [
                                            "To cause to stumble or trip."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9477be00-b2bc-4929-8739-1a0a3c7fe739",
                                                "sense_id": "8fc18a6c-91a4-3dba-acd3-19cd28a11fb5",
                                                "text": "Slowly, I turned around and the shock of it stumbled me back a few steps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c0cc83-2183-3f8e-9156-b63e2a2af7a8",
                                        "entry_id": "23650190-532d-3730-a386-dfde6fc51f3a",
                                        "glosses": [
                                            "To mislead; to confound; to cause to err or to fall."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c701915b-eb9a-4528-92a0-91a2c23712cd",
                                                "sense_id": "52c0cc83-2183-3f8e-9156-b63e2a2af7a8",
                                                "text": "False and dazzling fires to stumble men."
                                            },
                                            {
                                                "example_id": "f294ec1b-5e0f-4689-949f-a12f0a716b2d",
                                                "sense_id": "52c0cc83-2183-3f8e-9156-b63e2a2af7a8",
                                                "text": "One thing more stumbles me in the very foundation of this hypothesis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7bf0d85-d2ef-30fb-8f98-e89b75074ee3",
                                        "entry_id": "23650190-532d-3730-a386-dfde6fc51f3a",
                                        "glosses": [
                                            "To strike or happen (upon a person or thing) without design; to fall or light by chance; with on, upon, or against."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f725276f-3b68-414f-be87-1d96bd81639d",
                                                "sense_id": "d7bf0d85-d2ef-30fb-8f98-e89b75074ee3",
                                                "text": "It ſeems more probable that Ovid vvas either the Confident of ſome other paſſion, or that he had ſtumbled by ſome inadvertency, upon the privacies of Livia, and ſeen her in a Bath: […]"
                                            },
                                            {
                                                "example_id": "42db8795-29c2-46b2-80c2-0f1c961f1d02",
                                                "sense_id": "d7bf0d85-d2ef-30fb-8f98-e89b75074ee3",
                                                "text": "Forth as she waddled in the brake, / A grey goose stumbled on a snake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
