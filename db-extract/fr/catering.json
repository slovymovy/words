                "forms": [
                    {
                        "form_id": "2a616e11-4ffa-4ef0-a84b-936d8e8b9423",
                        "entry_id": "1a0e445d-2056-3ed0-af0e-5e282158ae11",
                        "tags": [
                            "plural"
                        ],
                        "form": "caterings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8fbfd5f-7d20-3d7c-841d-176bb6a60bfd",
                        "entry_id": "1a0e445d-2056-3ed0-af0e-5e282158ae11",
                        "glosses": [
                            "Ravitaillement ; restauration collective."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "bf3a8637-ed64-42d3-a42f-4ed8d811910e",
                                "sense_id": "f8fbfd5f-7d20-3d7c-841d-176bb6a60bfd",
                                "text": "Catering en anglais, traduisez \"restauration\" en français. C'est amusant cette manie d’angliciser tous les mots."
                            },
                            {
                                "example_id": "aea873bc-1566-4dfb-8805-8db762fa54ef",
                                "sense_id": "f8fbfd5f-7d20-3d7c-841d-176bb6a60bfd",
                                "text": "J'ai toujours eu trois ou quatre kilos en trop lorsque j'étais sur la route, car c'est vrai que le catering de Notre-Dame de Paris était des plus copieux et que je mangeais facilement quatre ou cinq fois dans la journée."
                            },
                            {
                                "example_id": "39dacbcf-48f8-4f92-99ff-cb9c326c9b5c",
                                "sense_id": "f8fbfd5f-7d20-3d7c-841d-176bb6a60bfd",
                                "text": "On ne vivait que sur les caterings, les buffets servis pour les groupes dans les salles de concert, reprend Fabrice."
                            }
                        ]
                    },
                    {
                        "sense_id": "38983b2c-c48b-3313-bc06-00b67356d5eb",
                        "entry_id": "1a0e445d-2056-3ed0-af0e-5e282158ae11",
                        "glosses": [
                            "Cantine d'avion ou de spectacle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68010f58-4e44-4913-9830-f38fddd5c1af",
                                "sense_id": "38983b2c-c48b-3313-bc06-00b67356d5eb",
                                "text": "Pour ses seules activités de catering aérien, elle dispose de 190 unités de production et d'un personnel de 2 000 agents en 1990."
                            },
                            {
                                "example_id": "3a74f1f3-418d-49f5-9cc3-76798a4b1194",
                                "sense_id": "38983b2c-c48b-3313-bc06-00b67356d5eb",
                                "text": "A Dakar, Servair a signé, le 1ᵉʳ janvier 1989, un contrat d’assistance technique avec la SORES (Société sénégalaise de restauration), qui exploite un restaurant, une boutique sous douane et le catering de Dakar."
                            },
                            {
                                "example_id": "f1756fb8-9b62-43e2-99de-4f20196cd6e0",
                                "sense_id": "38983b2c-c48b-3313-bc06-00b67356d5eb",
                                "text": "Quittant volontairement le marché du textile, elle a préparé et réussi un CAP de cuisine et s'est inscrite à des cours de gestion avec le projet d'organiser le catering des tournages : assurer la restauration sur place aux équipes réalisant un film."
                            },
                            {
                                "example_id": "04bfe8cb-9597-4a6b-8e2a-21285a62d848",
                                "sense_id": "38983b2c-c48b-3313-bc06-00b67356d5eb",
                                "text": "'Catering : cantine qui se trouve dans les loges"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b7e2d85-11c4-47ca-84f8-65d4b2c25778",
                        "source_entry_id": "1a0e445d-2056-3ed0-af0e-5e282158ae11",
                        "target_lang_word": "Verpflegung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verpflegung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "462dfee0-6294-3517-96ac-510aac6e033a",
                                        "entry_id": "012f9df1-db97-3354-9db3-dd12348caaac",
                                        "glosses": [
                                            "Vorgang respektive Handlung, jemanden mit Essen und Trinken zu versorgen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a43ea8-9c0f-43b4-b30f-c744222d50e8",
                                                "sense_id": "462dfee0-6294-3517-96ac-510aac6e033a",
                                                "text": "Die Verpflegung der Flutopfer hat nun höchste Priorität."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af47d17a-49b0-3914-9832-ce49db318a71",
                                        "entry_id": "012f9df1-db97-3354-9db3-dd12348caaac",
                                        "glosses": [
                                            "Zusammenstellung von Nahrungsmitteln und Getränken"
                                        ],
                                        "tags": [
                                            "meist im Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14c990d-d48b-4f70-b6e1-38f558293f82",
                                                "sense_id": "af47d17a-49b0-3914-9832-ce49db318a71",
                                                "text": "Für eine Wanderung sollte man sich Verpflegung mitnehmen."
                                            },
                                            {
                                                "example_id": "0e4ae956-8183-473a-9e39-98c0fdf00df0",
                                                "sense_id": "af47d17a-49b0-3914-9832-ce49db318a71",
                                                "text": "„Unsere Verpflegung war armselig, und viele unserer Leute starben.“"
                                            },
                                            {
                                                "example_id": "bb8ab5b5-c455-49a8-843d-410ce5a0ce22",
                                                "sense_id": "af47d17a-49b0-3914-9832-ce49db318a71",
                                                "text": "„Was die Verpflegung des Heeres angeht, so verfügt Napoleon, die einzelnen Formationen sollen der Reihe nach à la maraude durch Moskau ziehen, um sich Lebensmittelvorräte zu besorgen, damit die Armee für die nächste Zukunft sichergestellt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
