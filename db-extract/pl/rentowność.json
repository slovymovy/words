                    {
                        "translation_id": "ebbcc8b2-427d-4885-b6ab-af04eea0d265",
                        "source_entry_id": "6b200174-c2aa-3eee-a195-842672b1ceb2",
                        "source_sense_id": "b2ef5f7d-ffae-3b1f-b34b-76a95caf859b",
                        "target_lang_word": "рентабельность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рентабельность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb71149-4a43-3f08-bce2-53543e3294d3",
                                        "entry_id": "8d4febcf-c74d-34a3-b727-c33dbfddf1e9",
                                        "glosses": [
                                            "фин. свойство по значению прилагательного рентабельный; самоокупаемость, выгодность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21021256-5764-4c7b-829d-45b93230ba86",
                                                "sense_id": "3bb71149-4a43-3f08-bce2-53543e3294d3",
                                                "text": "Погова́ривали, что цирк, собира́вший аншла́ги во Дворце́ спо́рта, обеспе́чивал рента́бельность о́перных гастро́лей."
                                            },
                                            {
                                                "example_id": "36fae8e6-13e9-48ab-9ea3-c86e074d8718",
                                                "sense_id": "3bb71149-4a43-3f08-bce2-53543e3294d3",
                                                "text": "Тари́фы должны́ обеспе́чивать рента́бельность медици́нских учрежде́ний и совреме́нный у́ровень медици́нской по́мощи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787cd4c6-37be-39e9-92d3-82d2aa223bc9",
                                        "entry_id": "8d4febcf-c74d-34a3-b727-c33dbfddf1e9",
                                        "glosses": [
                                            "фин. величина, характеризующая прибыльность некоего предприятия, бизнеса; отношение полученной прибыли к затратам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d36bd9-5e65-42b4-87f3-82c4f6f02181",
                                                "sense_id": "787cd4c6-37be-39e9-92d3-82d2aa223bc9",
                                                "text": "Рентабельность «Баярда» ― 15%, что сопоставимо с прибыльностью других предприятий сферы услуг."
                                            },
                                            {
                                                "example_id": "71911480-4564-41db-b386-85d90b01e08b",
                                                "sense_id": "787cd4c6-37be-39e9-92d3-82d2aa223bc9",
                                                "text": "Конечно, доля таких туристов в общем потоке никогда не будет велика, зато рентабельность этих туров может составлять 20 процентов, то есть вчетверо выше, чем для обычных туристических программ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
