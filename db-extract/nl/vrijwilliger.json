                    {
                        "sense_id": "58464b66-62c5-3056-9b89-a20b012a556f",
                        "entry_id": "d80c8d43-fbc0-3fda-833b-2c8ce7dc79d5",
                        "glosses": [
                            "volunteer (one engaged in volunteering work)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "c2bebaf2-f6cb-4049-9f35-088c2a97a07c",
                                "sense_id": "58464b66-62c5-3056-9b89-a20b012a556f",
                                "text": "Hij werkt als vrijwilliger in een lokaal dierenasiel.",
                                "translation": "He works as a volunteer at a local animal shelter.",
                                "english": "He works as a volunteer at a local animal shelter."
                            },
                            {
                                "example_id": "52d3bf30-b5ae-4ba9-bad5-907102c38291",
                                "sense_id": "58464b66-62c5-3056-9b89-a20b012a556f",
                                "text": "De organisatie is afhankelijk van vrijwilligers om evenementen te organiseren.",
                                "translation": "The organization relies on volunteers to organize events.",
                                "english": "The organization relies on volunteers to organize events."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a0493fb-658c-37ef-a3dc-ab42b8c37609",
                        "entry_id": "d80c8d43-fbc0-3fda-833b-2c8ce7dc79d5",
                        "glosses": [
                            "voluntary (para)military recruit or soldier, volunteer"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "65075709-7fbe-47a0-ac6e-ce4a36ade20f",
                                "sense_id": "1a0493fb-658c-37ef-a3dc-ab42b8c37609",
                                "text": "In de 19e eeuw meldden veel mannen zich als vrijwilliger voor het leger.",
                                "translation": "In the 19th century, many men signed up as voluntary recruits for the army.",
                                "english": "In the 19th century, many men signed up as voluntary recruits for the army."
                            },
                            {
                                "example_id": "998e1a57-8748-492b-bca0-f2d0cbe6d827",
                                "sense_id": "1a0493fb-658c-37ef-a3dc-ab42b8c37609",
                                "text": "Tijdens de oorlog was er een tekort aan soldaten, dus deden ze een beroep op vrijwilligers.",
                                "translation": "During the war, there was a shortage of soldiers, so they called for volunteers.",
                                "english": "During the war, there was a shortage of soldiers, so they called for volunteers."
                            }
                        ]
                    }
