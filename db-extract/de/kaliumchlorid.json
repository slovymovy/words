                        "source_sense_id": "3549d7ae-3f24-35ea-92a0-dc378c958f89",
                        "source_sense_description": "Ionenverbindung aus einem Kalium-Kation und einem Chlor-Anion",
                        "target_lang_word": "chlorure de potassium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlorure de potassium",
