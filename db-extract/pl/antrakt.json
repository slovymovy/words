                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b8faac8-0ce3-4850-9f7e-e4028f663116",
                                                "sense_id": "7c032017-d4f9-393d-a65e-3bbdcf17a14c",
                                                "text": "„Kuragin stand diesen ganzen Zwischenakt hindurch mit Dolochow vorn an der Rampe und sah nach der Rostowschen Loge hinüber.“"
                                            }
