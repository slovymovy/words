                ],
                "senses": [
                    {
                        "sense_id": "bd82edce-a9a7-3f91-9826-516bcdfeb36b",
                        "entry_id": "ee0af32b-82da-38a7-ad9f-994f81ef1e59",
                        "glosses": [
                            "Se livrer au farniente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc3ab6c-a18e-491e-9049-f66de10a0fc7",
                                "sense_id": "bd82edce-a9a7-3f91-9826-516bcdfeb36b",
                                "text": "Nous farnientons une quinzaine de jours à Benney, qui laissera dans notre mémoire le souvenir de savoureuses tartes aux cerises et d’une excursion à la Colline inspirée, gravie sous un ciel orageux, contre un vent fougueux qui soulevait nos manteaux, ébouriffait les crinières de nos chevaux, et nous donnait une allure romantique de rigueur."
                            },
                            {
                                "example_id": "e75c53fe-cf4c-45b4-9ce2-534784e673d8",
                                "sense_id": "bd82edce-a9a7-3f91-9826-516bcdfeb36b",
                                "text": "Je farniente et imprime mon corps dans les draps."
                            },
                            {
                                "example_id": "9d1e2793-deb9-4cc5-a5d3-4a43ba16bcda",
                                "sense_id": "bd82edce-a9a7-3f91-9826-516bcdfeb36b",
                                "text": "J’ai l’intention de « farnienter » sérieusement cet été, répondit ce dernier, et j’ai pris, pour cela, toutes mes dispositions."
                            }
                        ]
                    }
                ],
