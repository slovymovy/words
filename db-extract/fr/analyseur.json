                "translations": [
                    {
                        "translation_id": "69f5269b-544f-4190-899e-2a6bee917b79",
                        "source_entry_id": "ec0d2e9c-a2b3-3258-95d3-634bbb328482",
                        "target_lang_word": "Analyst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Analyst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "608b4170-2bca-3043-b528-1e84f492f587",
                                        "entry_id": "8e657657-398f-3a59-893e-36280425d1a7",
                                        "glosses": [
                                            "Person, die einen komplexen Sachverhalt im Detail untersucht; die eine Analyse erstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33252b1b-1e00-4c31-8977-72760a115057",
                                                "sense_id": "608b4170-2bca-3043-b528-1e84f492f587",
                                                "text": "Die Analysten sind einflussreiche Beobachter der Börse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "200da91d-47cc-4c64-a482-66af516c6fa4",
                        "source_entry_id": "ec0d2e9c-a2b3-3258-95d3-634bbb328482",
                        "target_lang_word": "Analytiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Analytiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72c8ee11-57b5-3e7d-a3c4-1fd85fc3d523",
                                        "entry_id": "191ed02c-024b-324f-9fca-0132d0a8c7fd",
                                        "glosses": [
                                            "Person, die einen komplexen Sachverhalt im Detail untersucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299746fb-57f8-4833-b2bd-c33e006adf7a",
                                                "sense_id": "72c8ee11-57b5-3e7d-a3c4-1fd85fc3d523",
                                                "text": "„Der Ausdruck Analyst, in der Schweiz auch Analytiker, laut österreichischem Wörterbuch nur Letzteres, ist zu einem Sammelbegriff für unterschiedliche Berufsbilder geworden. Es ist jedoch möglich, anhand der Schwerpunkte in der täglichen Arbeit von Analysten eine relativ klare Unterscheidung zu treffen.“"
                                            },
                                            {
                                                "example_id": "ab707581-e60a-41c4-93fb-7912e16fcbcc",
                                                "sense_id": "72c8ee11-57b5-3e7d-a3c4-1fd85fc3d523",
                                                "text": "„Wenn der Analytiker sich seiner gewöhnlichen Hilfsquellen beraubt sieht, denkt er sich in den Geist seines Gegners hinein, identifiziert sich mit ihm, und dann gelingt es ihm nicht selten, auf den ersten Blick eine oft verblüffend einfache Methode zu finden, durch die er den andern irreführen oder zu einem unbesonnenen Zug veranlassen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "512161ce-a0d8-3ffe-b576-a41e0ea3426d",
                                        "entry_id": "191ed02c-024b-324f-9fca-0132d0a8c7fd",
                                        "glosses": [
                                            "Person, die die Analytik (Schluss- und Beweislehre in der Logik) beherrscht"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6033bfb9-0624-43cf-8399-751d493b853d",
                                                "sense_id": "512161ce-a0d8-3ffe-b576-a41e0ea3426d",
                                                "text": "„Manchmal wird \"analytische Philosophie\" auch als Bezeichnung für die Kerndisziplinen der Theoretischen Philosophie (Logik, Wissenschaftstheorie, Sprachphilosophie, Erkenntnistheorie) oder auch für eine bestimmte Herangehensweise an diese Kerndisziplinen verwendet (etwa wenn gelegentlich universitäre Philosophiestellen mit den Titeln \"analytische Philosophie\" oder \"analytische Philosophie und Logik\" ausgeschrieben werden). Dies ist wohl darauf zurückzuführen, daß ein i.w.S. analytischer Ansatz in diesen Disziplinen weltweit dominant ist. Aber das ist weder notwendig so, noch war es historisch immer so, und auch heute gibt es weltweit noch genügend Sprachphilosophen, Erkenntnistheoretiker und auch ein paar Wissenschaftstheoretiker und Logiker, die keine Analytiker sind. Diese Verwendung von \"analytische Philosophie\" ist letztlich eine Fehlbezeichnung, die philosophische Disziplinen mit einer philosophischen Richtung vermengt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "642dffae-f436-3bb0-af4d-6bbb54881e54",
                                        "entry_id": "191ed02c-024b-324f-9fca-0132d0a8c7fd",
                                        "glosses": [
                                            "Person, die in der Lage ist, eine Psychoanalyse durchzuführen"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Psychoanalyse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bbb9759-1636-43e1-bb10-e1a824b58cdc",
                                                "sense_id": "642dffae-f436-3bb0-af4d-6bbb54881e54",
                                                "text": "Ich muss morgen dringend zu meinem Analytiker."
                                            },
                                            {
                                                "example_id": "33fe2a96-c27d-4a34-aeaf-211ae713bfe2",
                                                "sense_id": "642dffae-f436-3bb0-af4d-6bbb54881e54",
                                                "text": "„Um dem abzuhelfen, machten sich Soziologen, Analytiker, Gynäkologen, Psychologen und diverse Sachbuchautoren an die Arbeit.“"
                                            },
                                            {
                                                "example_id": "46a24e04-b7bc-496d-b1ff-96ea3d237c1c",
                                                "sense_id": "642dffae-f436-3bb0-af4d-6bbb54881e54",
                                                "text": "Der Analytiker analysiert die Daten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
