        "fr-extract.jsonl": [
            {
                "entry_id": "167316ad-9e26-3a84-adda-a237f2e1b160",
                "word": "Вадим",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "00e9f9a1-b7b7-3516-9ab0-29cf398573cd",
                        "entry_id": "167316ad-9e26-3a84-adda-a237f2e1b160",
                        "glosses": [
                            "Vadim."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e747c4b1-1c35-407a-847c-e371ff4e63d5",
                                "sense_id": "00e9f9a1-b7b7-3516-9ab0-29cf398573cd",
                                "text": "Вадим опомнился, схватил поводья и так сильно осадил коня, что тот сразу присел на хвост, замотал головою, сделал ещё два скачка вбок и остановился: тёплый пар поднялся от хребта его, и пена, стекая по стальным удилам, клока́ми падала на землю.",
                                "translation": "Vadim a repris ses esprits, a saisi les rênes et a freiné le cheval si fort qu'il s'est immédiatement assis sur sa queue, a secoué la tête, a fait deux autres sauts sur le côté et s'est arrêté: de la vapeur chaude s'est élevée de sa colonne vertébrale et de la mousse, coulant les mèches d'acier, tombaient en touffes sur le sol."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
