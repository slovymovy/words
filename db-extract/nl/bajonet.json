                                                "text": "Bagnet złamał się przy wyciąganiu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad97e486-92ed-4e9b-91c7-93e4505985e5",
                        "source_entry_id": "351cf92d-fee3-3dd8-a5e1-bfae7dc56397",
                        "source_sense_id": "cae7b543-8e70-3568-a225-b0f051664fa0",
                        "source_sense_description": "een steekwapen bovenop de loop van een geweer",
                        "target_lang_word": "штык",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "штык",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ccafeaad-1b71-3637-b5d9-2fdae9d8e50a",
                                        "entry_id": "3ff2194f-287d-3320-ae68-2a7073e865b9",
                                        "glosses": [
                                            "воен. колющее оружие, насаживаемое на конец ствола военного ружья, винтовки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a82d09-b205-441a-9148-946e963ace14",
                                                "sense_id": "ccafeaad-1b71-3637-b5d9-2fdae9d8e50a",
                                                "text": "Стреляй редко, да метко, штыком коли крепко. Пуля обмишулится, а штык не обмишулится. Пуля — дура, штык — молодец!"
                                            },
                                            {
                                                "example_id": "0e0e5718-f59c-493a-ac10-8f586df4333a",
                                                "sense_id": "ccafeaad-1b71-3637-b5d9-2fdae9d8e50a",
                                                "text": "О спасении нельзя было и подумать; всякий только продавал свою жизнь как можно дороже и падал очень доволен, если успевал всадить штык свой в бок хоть одному латнику."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "100dd202-e3ca-3787-a4b8-bc908d4e582b",
                                        "entry_id": "3ff2194f-287d-3320-ae68-2a7073e865b9",
                                        "glosses": [
                                            "воен. мн. ч. единица счёта стрелков-пехотинцев"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdcd00d3-286e-3b4f-969b-b7268d17bcd6",
                                        "entry_id": "3ff2194f-287d-3320-ae68-2a7073e865b9",
                                        "glosses": [
                                            "морск. особый морской узел при связывании толстых верёвок, канатов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a383e8-1504-4543-9407-cf887cefcbce",
                                                "sense_id": "fdcd00d3-286e-3b4f-969b-b7268d17bcd6",
                                                "text": "Коровий узел фактически представляет собой неправильный (перевёрнутый) штык, работающий в другом качестве."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c3f70e-4695-3d23-9def-6d9f7779fcee",
                                        "entry_id": "3ff2194f-287d-3320-ae68-2a7073e865b9",
                                        "glosses": [
                                            "заострённый лоток заступа, лопаты для землекопных работ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a876c134-7d71-452d-9c1e-a516994b369c",
                                                "sense_id": "21c3f70e-4695-3d23-9def-6d9f7779fcee",
                                                "text": "Стандартные лопаты со штыком 20x30 см нужны для тяжелых работ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0470fbc0-b46e-36b7-a75b-e47da27f311e",
                                        "entry_id": "3ff2194f-287d-3320-ae68-2a7073e865b9",
                                        "glosses": [
                                            "спец. слой земли в глубину, который можно захватить лопатой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78457b23-34e0-4625-a481-a052283d79af",
                                                "sense_id": "0470fbc0-b46e-36b7-a75b-e47da27f311e",
                                                "text": "В кв. VI-1, почти не затронутом ямой, ребята раскопали 2й и 3й горизонт вместе ― ребята сильные (Спирин и Синицын), не смогли копать на 1/2 штыка."
                                            },
                                            {
                                                "example_id": "7b483e51-a06f-4332-b467-42e747b95265",
                                                "sense_id": "0470fbc0-b46e-36b7-a75b-e47da27f311e",
                                                "text": "Вскопайте участок на один штык лопаты, разрыхлите землю, выберите сорняки и посторонние предметы, разровняйте площадку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a5d799-7eb6-3ffc-9047-eee79abe7c6f",
                                        "entry_id": "3ff2194f-287d-3320-ae68-2a7073e865b9",
                                        "glosses": [
                                            "слиток металла (обычно чугуна); чушка"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47dda5c0-4e9b-41dc-8e1b-c1603da72e34",
                        "source_entry_id": "351cf92d-fee3-3dd8-a5e1-bfae7dc56397",
