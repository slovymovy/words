                "senses": [
                    {
                        "sense_id": "cdf2de4d-4c10-35ff-8753-f63fddd90c39",
                        "entry_id": "2c5c69ba-1ff3-37dd-bc32-fd6ac07c5aee",
                        "glosses": [
                            "ktoś, kto jest nieszczery, fałszywy"
                        ],
                        "tags": [],
