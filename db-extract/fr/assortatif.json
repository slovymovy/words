                ],
                "senses": [
                    {
                        "sense_id": "40cdef32-d7d5-3a94-954f-18f302d53111",
                        "entry_id": "e45de24c-4782-3fb1-81b6-64089079143a",
                        "glosses": [
                            "Se dit d’un réseau qui présente un niveau élevé d’assortativité."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "978d2ff0-51cb-4985-95d8-43d660e2154b",
                                "sense_id": "40cdef32-d7d5-3a94-954f-18f302d53111",
                                "text": "Ainsi, un réseau peut être dit assortatif (assortative graph) quand la corrélation entre les degrés des sommets et ceux de leurs voisins est élevée. Autrement dit, les sommets ayant un degré élevé sont connectés entre eux ; les sommets ayant un degré faible sont connectés entre eux et il y a peu de liens entre les sommets de degré élevé et ceux de degré faible. Dans le cas contraire, le réseau est disassortatif (disassortative graph)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6aac0dd-03a0-43e6-8c8c-375aeb1b2ba3",
                        "source_entry_id": "e45de24c-4782-3fb1-81b6-64089079143a",
                        "source_sense_id": "40cdef32-d7d5-3a94-954f-18f302d53111",
                        "target_lang_word": "assortative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assortative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85ca0fc0-b9fc-39ad-bab7-9986597cd8b9",
                                        "entry_id": "a5ae1b2d-00ae-3cce-bc5e-7aad0a2ee38c",
                                        "glosses": [
                                            "Characterized by assorting."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b164ff06-5ed2-45ca-a5d0-c24a32b02b50",
                                                "sense_id": "85ca0fc0-b9fc-39ad-bab7-9986597cd8b9",
                                                "text": "Assortative interactions can generate highly nonrandom variation among groups."
                                            },
                                            {
                                                "example_id": "32df4a80-053c-4837-84b2-08f55e3b592e",
                                                "sense_id": "85ca0fc0-b9fc-39ad-bab7-9986597cd8b9",
                                                "text": "We don’t date the girl next door; we date the girl who has been served up by an assortative algorithm."
                                            },
                                            {
                                                "example_id": "0167d0d7-0c15-43e6-8d6a-8cda0f930b93",
                                                "sense_id": "85ca0fc0-b9fc-39ad-bab7-9986597cd8b9",
                                                "text": "In an assortative network, highly connected individuals are linked mostly to other highly connected people. This results in an outbreak that spreads quickly through these clusters of high-risk individuals, but struggles to reach the other, less connected, parts of the network."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
