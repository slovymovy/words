{
    "word_family": [
        "perwersyjny",
        "perwersyjność",
        "perwersyjnie",
        "perwert"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "921d22c0-bf7b-36b1-881f-ada6deebab4b",
                    "sense_definition": "skłonność do zaspokajania popędów (zwłaszcza seksualnych) w sposób odbiegający od przyjętej normy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seksuologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych podręcznikach medycznych to nietypowe zachowanie traktowano jak groźną <w>perwersję</w>.",
                            "target_lang_translations": {
                                "ru": "В старых медицинских справочниках это нетипичное поведение рассматривалось как опасное <w>извращение</w>."
                            }
                        },
                        {
                            "text": "Dla wielu ludzi takie fantazje erotyczne to zwykła <w>perwersja</w>, a nie norma.",
                            "target_lang_translations": {
                                "ru": "Для многих людей такие эротические фантазии — это обычное <w>извращение</w>, а не норма."
                            }
                        }
                    ],
                    "synonyms": [
                        "dewiacja",
                        "spaczenie",
                        "wynaturzenie",
                        "zboczenie"
                    ],
                    "antonyms": [
                        "norma"
                    ],
                    "common_phrases": [
                        "seksualna perwersja"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонность к удовлетворению влечений (особенно сексуальных) способом, отклоняющимся от принятой нормы; перверсия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извращение",
                                "target_lang_sense_clarification": "сексуальное отклонение от нормы"
                            },
                            {
                                "target_lang_word": "перверсия",
                                "target_lang_sense_clarification": "медицинский или психологический термин"
                            },
                            {
                                "target_lang_word": "девиация",
                                "target_lang_sense_clarification": "сексуальное отклонение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9f66843-07a9-3513-bd89-d5ff5e68e4f1",
                    "sense_definition": "zachowanie lub działanie sprzeczne z przyjętymi obyczajami i normami społecznymi, często mające na celu szokowanie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego nowa wystawa sztuki graniczyła z czystą <w>perwersją</w> i wywołała oburzenie krytyków.",
                            "target_lang_translations": {
                                "ru": "Его новая художественная выставка граничила с чистым <w>извращением</w> и вызвала возмущение критиков."
                            }
                        },
                        {
                            "text": "Czerpanie radości z cudzego cierpienia uważano w tej społeczności za przejaw moralnej <w>perwersji</w>.",
                            "target_lang_translations": {
                                "ru": "Получение удовольствия от чужих страданий считалось в этом обществе проявлением моральной <w>извращённости</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "przewrotność",
                        "wynaturzenie"
                    ],
                    "antonyms": [
                        "przyzwoitość"
                    ],
                    "common_phrases": [
                        "moralna perwersja"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поведение или поступок, противоречащие общественным нормам и морали, часто с целью эпатировать или шокировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извращение",
                                "target_lang_sense_clarification": "моральное или эстетическое искажение нормы"
                            },
                            {
                                "target_lang_word": "извращённость",
                                "target_lang_sense_clarification": "свойство характера или поступка"
                            },
                            {
                                "target_lang_word": "ненормальность",
                                "target_lang_sense_clarification": "вопиющее отклонение от нормы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}