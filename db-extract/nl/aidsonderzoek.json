                "senses": [
                    {
                        "sense_id": "c59b62a9-ca19-3c6f-8f29-924dcd108c11",
                        "entry_id": "78cb2f34-bf33-3203-a927-4fbe56cabc5c",
                        "glosses": [
                            "alle het onderzoek dat betrekking heeft op aids"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "080c63da-b236-47af-90ee-a40c9223edf6",
                                "sense_id": "c59b62a9-ca19-3c6f-8f29-924dcd108c11",
                                "text": "\"Ja, ja, ja! Ik weet wat je gaat zeggen, maar dat is bullshit. Ik las in zo'n blad dat ik krijg over aids dat er geen geld meer binnenkomt voor aidsonderzoek. En eigenlijk is er voor kanker ook te weinig geld beschikbaar, al jaren. Waarom ziet zo'n Pogba zelf niet in dat hij te veel verdient? Dat snap ik niet."
                            },
                            {
                                "example_id": "95d17da6-856f-4a0e-9c37-6ca81ea17c8a",
                                "sense_id": "c59b62a9-ca19-3c6f-8f29-924dcd108c11",
                                "text": "Hij de aidswetenschapper, en zij werkte ooit als verpleegkundige voor patiënten met hiv-aids. Ze deelden een missie. Al jaren. Beiden zijn al van vanaf de jaren tachtig betrokken aidsonderzoek en programma's. Het duurde echter nog een hele tijd totdat de twee elkaar vonden en hun krachten bundelden."
                            }
                        ]
                    }
                ],
