                        ]
                    },
                    {
                        "translation_id": "433b7fce-de20-4a52-aaa5-039ef6b2715a",
                        "source_entry_id": "4537b07f-05ee-361b-9076-585d8da00010",
                        "source_sense_id": "e01ea9b5-cbb4-313c-9ab1-8df635d4f645",
