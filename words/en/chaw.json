{
    "word_family": [
        "chew"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd12b3b2-6b80-3a67-872f-d53332749b99",
                    "sense_definition": "A wad or portion of chewing tobacco.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chewing_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmer took a fresh <w>chaw</w> of tobacco before heading out to the fields.",
                            "target_lang_translations": {
                                "zh": "老农在下地之前塞了口新鲜的<w>嚼烟</w>。"
                            }
                        },
                        {
                            "text": "He offered his friend a <w>chaw</w> from the pouch he kept in his pocket.",
                            "target_lang_translations": {
                                "zh": "他从口袋里的袋子里拿出一块<w>嚼烟</w>分给朋友。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plug",
                        "quid"
                    ],
                    "common_phrases": [
                        "chaw of tobacco"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Southern and rural American English"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一口或一小团嚼烟。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嚼烟",
                                "target_lang_sense_clarification": "口中咀嚼的烟草块"
                            },
                            {
                                "target_lang_word": "烟块",
                                "target_lang_sense_clarification": "压制成块的嚼烟"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "204c58ab-47bc-38ac-b1b6-1bc25064042c",
                    "sense_definition": "A quantity of food or other substance that is chewed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chewing_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bit off a large <w>chaw</w> of dried beef and chewed it thoughtfully.",
                            "target_lang_translations": {
                                "zh": "他咬了一大<w>口</w>牛肉干，若有所思地嚼着。"
                            }
                        },
                        {
                            "text": "The cow rested under the shade while grinding a juicy <w>chaw</w> of grass.",
                            "target_lang_translations": {
                                "zh": "那头牛在树荫下休息，嘴里咀嚼着一<w>团</w>多汁的青草。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wad",
                        "mouthful",
                        "cud"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Dialect variant of chew"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "咀嚼的一团食物或物质；一口。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "口",
                                "target_lang_sense_clarification": "一次咀嚼的量"
                            },
                            {
                                "target_lang_word": "团",
                                "target_lang_sense_clarification": "咀嚼成团的食物或草料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb0f47e1-ac1a-3daf-8041-5bbc20a01169",
                    "sense_definition": "The jaw.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blow struck him squarely on the side of his <w>chaw</w>.",
                            "target_lang_translations": {
                                "zh": "那一记重击正好打在他的<w>下巴</w>侧面。"
                            }
                        },
                        {
                            "text": "He held his painful <w>chaw</w> after the violent accident occurred.",
                            "target_lang_translations": {
                                "zh": "剧烈碰撞发生后，他捂着疼痛的<w>下颌</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jaw",
                        "mandible"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical variant of jaw"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "下巴；颚（废弃词义）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "下巴",
                                "target_lang_sense_clarification": "面部下颚部位"
                            },
                            {
                                "target_lang_word": "下颌",
                                "target_lang_sense_clarification": "解剖学上的下颌骨部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1261911-2d4e-350b-a385-3731f1b0067b",
                    "sense_definition": "Obsolete form of <w>cha</w> (tea).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant served hot <w>chaw</w> to the travelers arriving from the port.",
                            "target_lang_translations": {
                                "zh": "商人为港口前来的旅客端上了热<w>茶</w>。"
                            }
                        },
                        {
                            "text": "They sat around the fire drinking bowls of brewed <w>chaw</w>.",
                            "target_lang_translations": {
                                "zh": "他们围坐在火堆旁，喝着一碗碗泡好的<w>茶</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tea"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Obsolete variant spelling"
                        },
                        {
                            "trait_type": "form",
                            "comment": "Variant of cha"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "茶（cha的废弃拼法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "茶",
                                "target_lang_sense_clarification": "茶水，茶叶饮料"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f91e8bd4-2d56-387f-8371-a9e27cd4e3c3",
                    "sense_definition": "To chew, crush, or grind with the teeth; to masticate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chewing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old dog sat on the porch and <w>chawed</w> slowly on a dried bone.",
                            "target_lang_translations": {
                                "zh": "老狗坐在门廊上，慢慢地<w>啃</w>着一根风干的骨头。"
                            }
                        },
                        {
                            "text": "He nervously <w>chawed</w> his lower lip while waiting for the verdict.",
                            "target_lang_translations": {
                                "zh": "在等待判决时，他紧张地<w>咬</w>着下唇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chew",
                        "masticate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Dialect variant of chew"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "咀嚼；咬碎；慢慢啃咬（chew的方言形式）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嚼",
                                "target_lang_sense_clarification": "用牙齿研磨咀嚼"
                            },
                            {
                                "target_lang_word": "啃",
                                "target_lang_sense_clarification": "一点点咬或咀嚼"
                            },
                            {
                                "target_lang_word": "咀嚼",
                                "target_lang_sense_clarification": "细细咀嚼食物等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4795414b-a3b0-38f4-b686-4eaa3275859e",
                    "sense_definition": "To ruminate on; to ponder or meditate over repeatedly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "thought",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire night quietly <w>chawing</w> over the difficult decision.",
                            "target_lang_translations": {
                                "zh": "他整晚都在静静地<w>琢磨</w>那个艰难的决定。"
                            }
                        },
                        {
                            "text": "She walked home slowly while <w>chawing</w> vengeance in her troubled mind.",
                            "target_lang_translations": {
                                "zh": "她慢慢走回家，心事重重地在脑海中<w>盘算</w>着复仇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ruminate",
                        "ponder",
                        "contemplate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic figurative use"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "反复思考；沉思；琢磨。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "琢磨",
                                "target_lang_sense_clarification": "反复思索考虑"
                            },
                            {
                                "target_lang_word": "反复思考",
                                "target_lang_sense_clarification": "沉思、权衡某事"
                            },
                            {
                                "target_lang_word": "盘算",
                                "target_lang_sense_clarification": "在心中反复思量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07c13008-1fea-35db-bc92-ad7257e6c919",
                    "sense_definition": "To take dishonestly; to steal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He realized that someone had <w>chawed</w> his wallet from the unlocked locker.",
                            "target_lang_translations": {
                                "zh": "他意识到有人从没锁的柜子里把他的钱包<w>偷</w>走了。"
                            }
                        },
                        {
                            "text": "Be careful leaving your tools outside or a thief might <w>chaw</w> them.",
                            "target_lang_translations": {
                                "zh": "别把工具留在外面，小心被贼<w>顺走</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steal",
                        "pinch",
                        "swipe",
                        "nick"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Slang for steal"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "偷窃；顺手牵羊（俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "偷",
                                "target_lang_sense_clarification": "不告而取他人财物"
                            },
                            {
                                "target_lang_word": "顺走",
                                "target_lang_sense_clarification": "趁人不备拿走"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb6fdfc3-bb3a-3d6b-83a4-32b7ece7e354",
                    "sense_definition": "To be sulky, morose, or resentful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of joining the conversation, the boy sat in the corner and began to <w>chaw</w>.",
                            "target_lang_translations": {
                                "zh": "那个男孩没有参与交谈，而是坐在角落里开始<w>生闷气</w>。"
                            }
                        },
                        {
                            "text": "There is no point in continuing to <w>chaw</w> over an honest mistake.",
                            "target_lang_translations": {
                                "zh": "没必要为一个无心之失继续<w>闷闷不乐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sulk",
                        "moke",
                        "brood"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "生闷气；闷闷不乐；郁郁寡欢。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "生闷气",
                                "target_lang_sense_clarification": "郁郁不乐、独自憋闷"
                            },
                            {
                                "target_lang_word": "闷闷不乐",
                                "target_lang_sense_clarification": "心情抑郁不快"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}