{
    "word_family": [
        "piling",
        "pile-up",
        "piler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6323675b-2716-3e1d-bcbd-51772ed4121e",
                    "sense_definition": "A mass of things heaped together; a heap.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "heap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stood on a <w>pile</w> of stones to reach the high window.",
                            "target_lang_translations": {
                                "ru": "Я встал на <w>кучу</w> камней, чтобы дотянуться до высокого окна."
                            }
                        },
                        {
                            "text": "There is a large <w>pile</w> of laundry waiting to be folded on the bed.",
                            "target_lang_translations": {
                                "ru": "На кровати лежит большая <w>гора</w> белья, которую нужно сложить."
                            }
                        }
                    ],
                    "synonyms": [
                        "heap",
                        "stack"
                    ],
                    "common_phrases": [
                        "pile of stones",
                        "pile of clothes",
                        "neat pile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множество предметов, сложенных в одном месте; нагромождение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ку́ча",
                                "target_lang_sense_clarification": "большое количество чего-либо, наваленного в одном месте"
                            },
                            {
                                "target_lang_word": "гру́да",
                                "target_lang_sense_clarification": "большое количество предметов, нагромождённых в беспорядке"
                            },
                            {
                                "target_lang_word": "сто́пка",
                                "target_lang_sense_clarification": "совокупность плоских предметов, аккуратно сложенных один на другой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cb45c0f-e6ce-3acd-8c4c-f61c05cc3773",
                    "sense_definition": "A large amount of money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>pile</w> from that invention of his and retired early.",
                            "target_lang_translations": {
                                "ru": "Он сколотил <w>состояние</w> на своём изобретении и рано ушёл на покой."
                            }
                        },
                        {
                            "text": "They worked hard for years until they had made a <w>pile</w> and could afford a house.",
                            "target_lang_translations": {
                                "ru": "Они много лет упорно трудились, пока не заработали <w>кучу денег</w> и не смогли позволить себе дом."
                            }
                        }
                    ],
                    "synonyms": [
                        "mint",
                        "small fortune",
                        "bundle"
                    ],
                    "common_phrases": [
                        "make a pile"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe wealth"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество денег; целое состояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ку́ча де́нег",
                                "target_lang_sense_clarification": "разговорное обозначение большого богатства"
                            },
                            {
                                "target_lang_word": "состоя́ние",
                                "target_lang_sense_clarification": "крупная сумма денег, накопленный капитал"
                            },
                            {
                                "target_lang_word": "у́йма де́нег",
                                "target_lang_sense_clarification": "огромное количество денег"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb3d647c-6a01-394b-8c6e-53efa80bd241",
                    "sense_definition": "The raised hairs, loops or strands of a fabric; the nap of a cloth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpet has a very thick <w>pile</w> that feels soft under your feet.",
                            "target_lang_translations": {
                                "ru": "У ковра очень густой <w>ворс</w>, который кажется мягким под ногами."
                            }
                        },
                        {
                            "text": "Velvet is known for its soft, dense <w>pile</w> which gives it a unique texture.",
                            "target_lang_translations": {
                                "ru": "Бархат известен своим мягким, плотным <w>ворсом</w>, который придает ему уникальную текстуру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thick pile",
                        "shaggy pile",
                        "carpet pile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающие на поверхности ткани волокна, нити или петли; ворс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворс",
                                "target_lang_sense_clarification": "пушистый слой на поверхности ткани или ковра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25ed3507-671d-3763-9b62-7df9df6be5ed",
                    "sense_definition": "A large building, or mass of buildings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone <w>pile</w> overlooked the town and drew the sight of every traveler.",
                            "target_lang_translations": {
                                "ru": "Древняя каменная <w>громада</w> возвышалась над городом, притягивая взгляды каждого путешественника."
                            }
                        },
                        {
                            "text": "He was born at the Oxfordshire <w>pile</w> built for his famous ancestor.",
                            "target_lang_translations": {
                                "ru": "Он родился в оксфордширском <w>особняке</w>, построенном для его знаменитого предка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "massive pile",
                        "stately pile"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used for grand or imposing structures"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое, внушительное здание или комплекс строений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грома́да",
                                "target_lang_sense_clarification": "огромное, массивное здание"
                            },
                            {
                                "target_lang_word": "зда́ние",
                                "target_lang_sense_clarification": "крупное архитектурное сооружение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60ac3dd7-a2d2-3c27-9589-0806d80611c2",
                    "sense_definition": "A large stake or piece of timber or steel driven into the ground to support a building or pier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers spent weeks driving each <w>pile</w> into the sea-bed for the new pier.",
                            "target_lang_translations": {
                                "ru": "Рабочие потратили недели, забивая каждую <w>сваю</w> в морское дно для нового пирса."
                            }
                        },
                        {
                            "text": "The foundation of the bridge relies on every steel <w>pile</w> being perfectly vertical.",
                            "target_lang_translations": {
                                "ru": "Фундамент моста держится на том, что каждая стальная <w>свая</w> установлена строго вертикально."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drive piles",
                        "foundation pile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный стержень из дерева, стали или бетона, забиваемый в грунт для опоры фундамента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сва́я",
                                "target_lang_sense_clarification": "столб, забиваемый в землю для опоры сооружения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c50d8dcb-eeac-3be6-bcfa-5bdac60913dc",
                    "sense_definition": "A hemorrhoid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was suffering from painful <w>piles</w> and required medical treatment.",
                            "target_lang_translations": {
                                "ru": "Пациент страдал от болезненного <w>геморроя</w> и нуждался в лечении."
                            }
                        },
                        {
                            "text": "He sought advice from a doctor regarding his chronic <w>piles</w>.",
                            "target_lang_translations": {
                                "ru": "Он обратился к врачу по поводу своего хронического <w>геморроя</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually used in the plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Геморроидальный узел; заболевание вен прямой кишки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "геморро́й",
                                "target_lang_sense_clarification": "медицинский термин для данного состояния"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "457b2000-2c30-3792-98fb-149930cdedc6",
                    "sense_definition": "To lay or throw into a pile or heap; to accumulate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "heap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>pile</w> the books on the desk so I can count them.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>сложите</w> книги на столе в стопку, чтобы я мог их сосчитать."
                            }
                        },
                        {
                            "text": "They were <w>piling</w> up wood on the wheelbarrow for the winter fire.",
                            "target_lang_translations": {
                                "ru": "Они <w>складывали</w> дрова в тачку для зимнего костра."
                            }
                        }
                    ],
                    "synonyms": [
                        "heap",
                        "accumulate",
                        "pile up",
                        "stack"
                    ],
                    "common_phrases": [
                        "pile up",
                        "pile high"
                    ],
                    "target_lang_definitions": {
                        "ru": "Складывать или бросать вещи в одну кучу; накапливать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сва́ливать",
                                "target_lang_sense_clarification": "складывать в беспорядочную кучу"
                            },
                            {
                                "target_lang_word": "навали́ть",
                                "target_lang_sense_clarification": "набросать в одно место в большом количестве"
                            },
                            {
                                "target_lang_word": "скла́дывать",
                                "target_lang_sense_clarification": "помещать вещи одну на другую"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c7ceb5e-c111-3f07-8154-badf0641f05e",
                    "sense_definition": "To cover with heaps; to fill or overfill; to load.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "heap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>piled</w> the camel with our heavy loads before starting the journey.",
                            "target_lang_translations": {
                                "ru": "Мы <w>нагрузили</w> верблюда нашей тяжелой поклажей перед началом пути."
                            }
                        },
                        {
                            "text": "The waiter <w>piled</w> the plate with food until nothing else could fit.",
                            "target_lang_translations": {
                                "ru": "Официант <w>навалил</w> еды в тарелку столько, что больше ничего не помещалось."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pile with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнять или покрывать что-либо большим количеством предметов; нагружать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагружа́ть",
                                "target_lang_sense_clarification": "наполнять грузом или кладью"
                            },
                            {
                                "target_lang_word": "завали́ть",
                                "target_lang_sense_clarification": "покрыть или наполнить, набросав много вещей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bd878ccd-878c-3f57-b4dc-a0f9fc526ac0",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Pile</w> was the headmaster of the local school for many years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Пайл</w> много лет был директором местной школы."
                            }
                        },
                        {
                            "text": "The author of the book is listed as Thomas <w>Pile</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги указан как Томас <w>Пайл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пайл",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}