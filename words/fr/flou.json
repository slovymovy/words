        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0af4ae13-5ce2-3044-b768-1ecf5b85ea5a",
                    "sense_definition": "De manière indistincte, sans netteté visuelle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aspect_visuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'il enlève ses lentilles de contact, il commence immédiatement à voir <w>flou</w>.",
                            "target_lang_translations": {
                                "en": "As soon as he takes out his contact lenses, he immediately starts to see <w>blurrily</w>.",
                                "ru": "Как только он снимает контактные линзы, он сразу начинает видеть <w>нечётко</w>.",
                                "de": "Sobald er seine Kontaktlinsen herausnimmt, fängt er sofort an, <w>unscharf</w> zu sehen.",
                                "es": "En cuanto se quita las lentillas, empieza enseguida a ver <w>borroso</w>.",
                                "zh": "他一摘下隐形眼镜，就马上开始<w>模糊地</w>看东西。"
                            }
                        },
                        {
                            "text": "Après des heures devant l'écran de mon ordinateur, mes yeux fatiguent et je vois <w>flou</w>.",
                            "target_lang_translations": {
                                "en": "After hours in front of my computer screen, my eyes get tired and I see <w>blurrily</w>.",
                                "ru": "После нескольких часов перед экраном компьютера глаза устают, и я вижу <w>нечётко</w>.",
                                "de": "Nach Stunden vor dem Bildschirm meines Computers werden meine Augen müde, und ich sehe <w>unscharf</w>.",
                                "es": "Después de horas frente a la pantalla del ordenador, se me cansan los ojos y veo <w>borroso</w>.",
                                "zh": "盯着电脑屏幕几个小时后，眼睛很累，我<w>模糊地</w>看着屏幕。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "voir flou"
                    ],
                    "target_lang_definitions": {
                        "en": "In an indistinct way, without visual sharpness.",
                        "ru": "Неотчётливо, без визуальной резкости.",
                        "de": "Auf unscharfe Weise, ohne optische Schärfe.",
                        "es": "De manera poco nítida, sin claridad visual.",
                        "zh": "以不清晰的方式，视觉上看不清楚地。"
