                "senses": [
                    {
                        "sense_id": "4507d712-e26f-344f-8c32-7f0baf121240",
                        "entry_id": "de0fc870-5661-3452-92ef-10f0cd63b7a1",
                        "glosses": [
                            "Mettre sous forme de pellicule, filmer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494988bd-154c-447e-bb1e-03e6207914a6",
                                "sense_id": "4507d712-e26f-344f-8c32-7f0baf121240",
                                "text": "Il y a des pièce de théâtre qui doivent rester de bonnes pièces de théâtre, pourquoi vouloir à tout prix \"pelliculiser\" une oeuvre."
                            },
                            {
                                "example_id": "35e4611c-eac9-4605-a81c-4e4513de9ce7",
                                "sense_id": "4507d712-e26f-344f-8c32-7f0baf121240",
                                "text": "Il s'agit d'Art. Pas d'éructation existentielle d'un réalisateur qui considère les acteurs comme des simples outils lui permettant de \"pelliculiser\" ses états d'âmes."
                            },
                            {
                                "example_id": "8ea22ef8-f2f1-4fde-9f4a-be7e7b263443",
                                "sense_id": "4507d712-e26f-344f-8c32-7f0baf121240",
                                "text": "Court, moyen ou long métrage ? Le projet, inspiré de l'ouvrage \" Le bleu de la Rivière \" d'Henri Medori, se \"pelliculise \"."
                            }
                        ]
                    }
