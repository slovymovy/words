                        "glosses": [
                            "naam van een literaire prijs waarbij scholieren van de middelbare school als jury fungeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b98e54f-3adf-4b5c-80dd-1aaa433cb179",
                                "sense_id": "3d8d272b-d6d5-303a-9c98-61d8f489dd43",
                                "text": "De Nederlandse schrijver en dichter Ilja Leonard Pfeijffer is dit jaar de winnaar van de literaire jongerenprijs De Inktaap met zijn roman La Superba. Ruim 1250 scholieren uit Nederland, Vlaanderen, Suriname en Curaçao riepen het boek uit tot hun favoriet. Pfeijffer ontving de prijs dinsdag in Antwerpen in het bijzijn van zo'n duizend scholieren."
                            },
                            {
                                "example_id": "eb584cbb-8712-435d-a05e-a05ddc9e84d9",
                                "sense_id": "3d8d272b-d6d5-303a-9c98-61d8f489dd43",
                                "text": "Murat Isik, die met zijn roman Wees onzichtbaar de Libris Literatuur Prijs, de Inktaap, de Boekhandelsprijs én de titel NRC Boek van het Jaar won, schreef het Boekenweekessay van dit jaar."
                            }
                        ]
                    }
