                "senses": [
                    {
                        "sense_id": "ba8b6374-07f5-3455-ac4a-b6af607c1c2b",
                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                        "glosses": [
                            "To decrease the value or price of; to make cheaper."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "abb4a905-9a40-4da9-b8c2-218799638d71",
                                "sense_id": "ba8b6374-07f5-3455-ac4a-b6af607c1c2b",
                                "text": "Now, covered concrete troughs to house the cables are laid parallel with the railway lines, cheapening maintenance because of improved accessibility for inspection and repair."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fd83a10-fc8f-38ae-a194-b86c253ec7cd",
                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                        "glosses": [
                            "To make vulgar."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "994e24bc-7d0f-4ebe-9781-5c5b48e7871e",
                                "sense_id": "5fd83a10-fc8f-38ae-a194-b86c253ec7cd",
                                "text": "The pace of the season can't help but cheapen these scenes, but I can’t deny that it's a blast. I’ve been critical of both the relative depopulation of the cast in this final run and the speedy, schematic narrative that checks off high points and moves on without really building to them."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7b356ae-0aec-30e6-96f5-df030edfad62",
                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                        "glosses": [
                            "To become cheaper."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e8b0588e-877b-3222-808d-23d3d672309e",
                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                        "glosses": [
                            "To bargain for, ask the price of."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ee8665d1-63d9-4edc-b082-c0a9847931d6",
                                "sense_id": "e8b0588e-877b-3222-808d-23d3d672309e",
                                "text": "I should like to have seen that noble old madcap Peterborough in his boots (he actually had the audacity to walk about Bath in boots!), with his blue ribbon and stars, and a cabbage under each arm, and a chicken in his hand, which he had been cheapening for his dinner."
                            },
                            {
                                "example_id": "4d956bbb-ad09-4a63-a0db-91fb1a2eccec",
                                "sense_id": "e8b0588e-877b-3222-808d-23d3d672309e",
                                "text": "The maid was on the step, cheapening fish with a virulent lady who had a sieve-full to dispose of."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5aec9e19-96ab-4023-932e-18da5b3310e9",
