                    "sense_definition": "een dorp en voormalige gemeente in Noord-Holland in Nederland",
                    "learner_level": "B1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "<w>Graft</w> ligt in Noord-Holland en hoort nu bij Alkmaar.",
                            "target_lang_translations": {
                                "en": "<w>Graft</w> is in North Holland and now belongs to Alkmaar."
                            }
                        },
                        {
                            "text": "In <w>Graft</w> staan nog veel oude huizen langs het water.",
                            "target_lang_translations": {
