                "senses": [
                    {
                        "sense_id": "1ac1730e-19da-3738-8490-3022df59c23e",
                        "entry_id": "1d0d2575-2715-38c4-be82-82a57babec3e",
                        "glosses": [
                            "Wasser, das die Donau mit sich führt, das sie enthält oder das aus ihr stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af51a99a-2334-4b6b-aeac-706bcf7a9246",
                                "sense_id": "1ac1730e-19da-3738-8490-3022df59c23e",
                                "text": "„Bis zu 10.000 Liter Donauwasser pro Sekunde sollen in Zukunft abgezweigt werden, um ganz ohne Pumpen ein unterirdisches Labor zu durchfluten.“"
                            },
                            {
                                "example_id": "f22d0408-300a-4b87-b5e7-bb36529f9e77",
                                "sense_id": "1ac1730e-19da-3738-8490-3022df59c23e",
                                "text": "„Seit wenigen Tagen sind fünf Schiffe voller Technik und mit Gewässer-Experten an Bord flussabwärts unterwegs, um die Qualität der Donau zu bewerten. Sie wollen wissen, ob das Donauwasser tatsächlich so blau und sauber ist.“"
                            },
                            {
                                "example_id": "723c7b49-981d-4ff3-b8d2-63f4697ec608",
                                "sense_id": "1ac1730e-19da-3738-8490-3022df59c23e",
                                "text": "„Seit vergangenem Wochenende wird kein Donauwasser mehr in den Rothsee bei Hilpoltstein im Landkreis Roth gepumpt, wie eine Sprecherin des Wasserwirtschaftsamts Ansbach sagte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
