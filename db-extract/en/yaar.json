                                                "sense_id": "e79d5d68-a05b-3b1d-a6d3-04199890c968",
                                                "text": "Ich wohne in Freund."
                                            },
                                            {
                                                "example_id": "639512ac-a20c-46c3-bb43-09180375c2d5",
