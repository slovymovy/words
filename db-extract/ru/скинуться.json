                        "source_entry_id": "1fe0d411-0484-3cc9-9e16-7c8814fbea8d",
                        "target_lang_word": "chip in",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chip in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa68403-c48a-3a62-ac53-3fd168f7314e",
                                        "entry_id": "320d34ca-c3e1-3436-a5fe-8076ed07c23b",
                                        "glosses": [
                                            "To make a contribution; help in a small way; especially, to pay for a part of something."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9686e1b-7275-4af3-9b01-aacb583b8066",
                                                "sense_id": "dfa68403-c48a-3a62-ac53-3fd168f7314e",
                                                "text": "If we all chip in, we can afford to buy a pizza for lunch."
                                            },
                                            {
                                                "example_id": "d75963d4-6bfe-4b60-a6be-c1140c45c17f",
                                                "sense_id": "dfa68403-c48a-3a62-ac53-3fd168f7314e",
                                                "text": "It was England up the right, with Jordan Henderson – back in the starting XI for Kalvin Phillips – chipping in, too, popping up in inside positions to flip over a couple of dangerous crosses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d6546d9-a683-3e02-871f-c946b4e4d725",
                                        "entry_id": "320d34ca-c3e1-3436-a5fe-8076ed07c23b",
                                        "glosses": [
                                            "To make a contribution; help in a small way; especially, to pay for a part of something.",
                                            "To contribute (for, to, or toward something)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88e9fbdb-da3e-4d37-9c5f-75b650c97446",
                                                "sense_id": "5d6546d9-a683-3e02-871f-c946b4e4d725",
                                                "text": "She chipped in for the gift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81dd4425-50ff-3350-9121-ffc3eb9c385c",
                                        "entry_id": "320d34ca-c3e1-3436-a5fe-8076ed07c23b",
                                        "glosses": [
                                            "To contribute (something)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55c8dd97-e2de-45c5-9636-3628794d1f0c",
                                                "sense_id": "81dd4425-50ff-3350-9121-ffc3eb9c385c",
                                                "text": "He chipped in twenty for the retirement gift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "155c0555-8101-3606-8fba-27e9b5b66b76",
                                        "entry_id": "320d34ca-c3e1-3436-a5fe-8076ed07c23b",
                                        "glosses": [
                                            "To ante; to put into the pot the amount of chips or money required to continue."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3349c3d3-e021-4ff8-9002-a338c15f9a45",
                                                "sense_id": "155c0555-8101-3606-8fba-27e9b5b66b76",
                                                "text": "He seemed to hesitate when he chipped in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0af1de5-b076-3728-9b1d-95615e080750",
                                        "entry_id": "320d34ca-c3e1-3436-a5fe-8076ed07c23b",
                                        "glosses": [
                                            "To interrupt a discussion for the purpose of making a comment."
                                        ],
                                        "tags": [
                                            "British",
                                            "idiomatic",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "293eb44f-e048-4ba9-8df3-6c383f473be4",
                                                "sense_id": "e0af1de5-b076-3728-9b1d-95615e080750",
                                                "text": "Will Godfrey, director of economics, finance and markets at ORR, chips in: \"Reducing cancellations and maintaining punctuality as passengers return after the pandemic is a really vital objective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d3c88c-f366-3c6c-9988-40696e102b8b",
                                        "entry_id": "320d34ca-c3e1-3436-a5fe-8076ed07c23b",
                                        "glosses": [
                                            "To put a chip shot in the hole."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0307577f-217b-4cd9-b6d9-804c56f27bba",
                                                "sense_id": "d2d3c88c-f366-3c6c-9988-40696e102b8b",
                                                "text": "He chipped in from 20 yards for a birdie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae59d78f-66a1-3e9b-8c28-590672a2c52d",
                                        "entry_id": "320d34ca-c3e1-3436-a5fe-8076ed07c23b",
                                        "glosses": [
                                            "To join in (something); to butt in or contribute (something) to a conversation; to say (something)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195ec4ea-0db4-4732-8609-5f67dcd2fb82",
                                                "sense_id": "ae59d78f-66a1-3e9b-8c28-590672a2c52d",
                                                "text": "She chipped in that she had seen the whole situation play out."
                                            }
