                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6fc5b12-7a08-472c-a0fc-d2af443e8796",
                        "source_entry_id": "65211609-26de-3be8-b21c-66a9d18fa900",
                        "source_sense_id": "ad24759e-4120-34dd-b506-4b6eecabb91b",
                        "source_sense_description": "seemannssprachlich: in Richtung nach hinten bei einem Seefahrzeug",
                        "target_lang_word": "abaft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abaft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43af73e9-72a3-3a0b-8169-b3f1e78ce663",
                                        "entry_id": "afd17d7a-06cb-3f4e-bd7d-a1543555b56a",
                                        "glosses": [
                                            "Behind; toward the stern relative to some other object or position; aft of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c5d6202-b5e4-443d-bace-ecd0ee112cba",
                                                "sense_id": "43af73e9-72a3-3a0b-8169-b3f1e78ce663",
                                                "text": "The captain stood abaft the wheelhouse."
                                            },
                                            {
                                                "example_id": "75ff723b-45a1-49b8-9b13-048740bd4777",
                                                "sense_id": "43af73e9-72a3-3a0b-8169-b3f1e78ce663",
                                                "text": "[…] two drunken Turkes, that were in the Frigot with twelue others, discharged two Calieuers, with which they killed two Souldiours, that stood abaft our Gally."
                                            },
                                            {
                                                "example_id": "f86e4f35-52bc-4845-a8ca-ab3e9cc45415",
                                                "sense_id": "43af73e9-72a3-3a0b-8169-b3f1e78ce663",
                                                "text": "1773, James Cook, An Account of a Voyage Around the World, Book 3, Chapter 5, in John Hawkesworth (ed.), An Account of the Voyages Undertaken by the Order of His Present Majesty: for Making Discoveries in the Southern Hemisphere, London: W. Strahan and T. Cadell, Volume 3, p. 558,\n[…] we could hear the water rush in a little abaft the foremast, about three feet from the keel: this determined me to clear the hold intirely."
                                            },
                                            {
                                                "example_id": "6d026a9f-14ce-4f94-af28-9b5929180119",
                                                "sense_id": "43af73e9-72a3-3a0b-8169-b3f1e78ce663",
                                                "text": "“[…] Read the sign up there—NO SMOKING ABAFT THE WHEEL!”"
                                            },
                                            {
                                                "example_id": "d4746391-336d-4938-9be1-88819bbe6b6e",
                                                "sense_id": "43af73e9-72a3-3a0b-8169-b3f1e78ce663",
                                                "text": "The bulkhead that separates ladies’ country from the rough characters who shave is not necessarily No. 30 but, by tradition, it is called “bulkhead thirty” in any mixed ship. […] Male officers had a lounge called the cardroom just abaft thirty."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abaft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d246691-d899-3f4d-9689-b846170ff543",
                                        "entry_id": "4c9f81fc-4af2-31d5-8a04-3c3ecc9afc82",
                                        "glosses": [
                                            "On the aft side; in the stern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318a8c55-115b-4974-8eb4-f9e0b1ebb131",
                                                "sense_id": "1d246691-d899-3f4d-9689-b846170ff543",
                                                "text": "By clapping the sails to the mast, and lightening the ship abaft, we swayed her off with little damage."
                                            },
                                            {
                                                "example_id": "8180530c-cf19-4529-b7a3-e54164466963",
                                                "sense_id": "1d246691-d899-3f4d-9689-b846170ff543",
                                                "text": "We drifted with the wind abaft."
                                            },
                                            {
                                                "example_id": "7955463e-84c1-4bee-af6c-48558927aefb",
                                                "sense_id": "1d246691-d899-3f4d-9689-b846170ff543",
                                                "text": "The mate sleeps abaft."
                                            },
                                            {
                                                "example_id": "2efdfab1-e67e-4a88-aa35-f5b17c52e1f2",
                                                "sense_id": "1d246691-d899-3f4d-9689-b846170ff543",
                                                "text": "The Exchange also being farther from the fire, afterward was more easily cleared, and fell off from abaft."
                                            },
                                            {
                                                "example_id": "ce119c04-043b-4993-9f5b-8a7712c38dc0",
                                                "sense_id": "1d246691-d899-3f4d-9689-b846170ff543",
                                                "text": "Stubb was struck by a shower of outcries and anathemas proceeding from the Captain’s round-house abaft;"
                                            },
                                            {
                                                "example_id": "b475a73e-e467-4b08-b164-25d2569a9215",
                                                "sense_id": "1d246691-d899-3f4d-9689-b846170ff543",
                                                "text": "We cover our anterior nakedness with some philosophy—Christian, Marxian, Freudo-Physicalist—but abaft we remain uncovered, at the mercy of the winds of circumstance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "305cae84-4a1d-3208-af8e-cfb1c51456d4",
                                        "entry_id": "4c9f81fc-4af2-31d5-8a04-3c3ecc9afc82",
                                        "glosses": [
                                            "Backwards."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
