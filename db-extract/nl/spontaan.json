                    }
                ],
                "senses": [
                    {
                        "sense_id": "828b4d37-00d4-3022-a336-3afb849e7771",
                        "entry_id": "e6be5989-4370-3513-a715-d788b4720d48",
                        "glosses": [
                            "uit een opwelling voortkomend, niet uitgelokt of door een ander teweeggebracht: een spontane hulde, ontboezeming."
                        ],
                        "tags": [
                            "van handelingen en uitingen"
                        ],
                        "examples": [
                            {
                                "example_id": "d35d8288-996b-4190-a814-39ddac929a91",
                                "sense_id": "828b4d37-00d4-3022-a336-3afb849e7771",
                                "text": "Een spontaan applaus klinkt op."
                            },
                            {
                                "example_id": "ce8a8f43-0b70-47c7-a5ad-d1aaccaa4c17",
                                "sense_id": "828b4d37-00d4-3022-a336-3afb849e7771",
                                "text": "De productie werd door een spontane staking stilgelegd."
                            },
                            {
                                "example_id": "754189ea-93e6-46ed-b208-7ba37d896800",
                                "sense_id": "828b4d37-00d4-3022-a336-3afb849e7771",
                                "text": "\"Dat heb ik ook steeds\", roept een meisje spontaan vanaf haar plek in de kerkzaal. En als de dominee vraagt of dat bij andere kinderen thuis ook wel eens voorkomt, steken meerderen de hand op."
                            }
                        ]
                    },
                    {
                        "sense_id": "77b6be4b-e604-3c9e-88ae-842793edd02d",
                        "entry_id": "e6be5989-4370-3513-a715-d788b4720d48",
                        "glosses": [
                            "geneigd zijn opwellingen aanstonds te uitten: mensen, spontaan in vreugde en verdriet."
                        ],
                        "tags": [
                            "van personen"
                        ],
                        "examples": [
                            {
                                "example_id": "f958ed97-5f83-48de-b4c4-6eb030d7e211",
                                "sense_id": "77b6be4b-e604-3c9e-88ae-842793edd02d",
                                "text": "De jury prees haar spontane uitstraling."
                            }
                        ]
                    },
                    {
                        "sense_id": "76e6a5c2-8ca1-30c1-bf5a-b27a018d217c",
                        "entry_id": "e6be5989-4370-3513-a715-d788b4720d48",
                        "glosses": [
                            "niet door uitwendige oorzaken bewerkt, vanzelf optredend: een spontane infectie; spontaan geïnfecteerd."
                        ],
                        "tags": [
                            "van biologische verschijnselen"
                        ],
                        "examples": [
                            {
                                "example_id": "8009b601-57f4-46d4-be80-b9b861248bd1",
                                "sense_id": "76e6a5c2-8ca1-30c1-bf5a-b27a018d217c",
                                "text": "De streek wordt geteisterd door spontane branden."
                            },
                            {
                                "example_id": "3283662b-0c2a-4508-8453-c8c3d91418a1",
                                "sense_id": "76e6a5c2-8ca1-30c1-bf5a-b27a018d217c",
                                "text": "De ziekte ontstaat als gevolg van een spontane mutatie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "415cba1a-7f95-468b-b2d7-94ac2b319f27",
                        "source_entry_id": "e6be5989-4370-3513-a715-d788b4720d48",
                        "target_lang_word": "spontaneous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spontaneous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b818c9c-4342-3ce0-8111-52ecf10bd8b9",
                                        "entry_id": "e95d01a3-b68e-3397-90db-426ac091b9bc",
                                        "glosses": [
                                            "Self-generated; happening without any apparent external cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f06aa561-60e5-45fb-b6b6-c4fe1ec62d3c",
                                                "sense_id": "6b818c9c-4342-3ce0-8111-52ecf10bd8b9",
                                                "text": "He made a spontaneous offer of help."
                                            },
                                            {
                                                "example_id": "7c97d82b-316f-4878-9d5d-d02f951b7e32",
                                                "sense_id": "6b818c9c-4342-3ce0-8111-52ecf10bd8b9",
                                                "text": "To make a spontaneous decision"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d70de168-41f8-3a4d-b8d8-c9dd7a51e2da",
                                        "entry_id": "e95d01a3-b68e-3397-90db-426ac091b9bc",
                                        "glosses": [
                                            "Done by one's own free choice, or without planning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "122a2cf3-75a9-3ce7-9337-f024f9847a35",
                                        "entry_id": "e95d01a3-b68e-3397-90db-426ac091b9bc",
                                        "glosses": [
                                            "Proceeding from natural feeling or native tendency without external or conscious constraint."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "556702e4-2ab0-3b4a-826f-2a8b687bdc53",
                                        "entry_id": "e95d01a3-b68e-3397-90db-426ac091b9bc",
                                        "glosses": [
                                            "Arising from a momentary impulse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "702447b4-5366-3b22-926d-98b9cbddfc61",
                                        "entry_id": "e95d01a3-b68e-3397-90db-426ac091b9bc",
                                        "glosses": [
                                            "Controlled and directed internally; self-active; spontaneous movement characteristic of living things."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46204dc5-fc08-3033-8b22-993ed0cfa3ba",
                                        "entry_id": "e95d01a3-b68e-3397-90db-426ac091b9bc",
                                        "glosses": [
                                            "Produced without being planted or without human cultivation or labor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66f0081d-4688-40e7-9240-f0c7563899a3",
                                                "sense_id": "46204dc5-fc08-3033-8b22-993ed0cfa3ba",
                                                "text": "He persisted in his design; and, because he would not make his wants known, actually subsisted for several days on hips, haws and sloes, and other spontaneous fruits which he gathered in the woods and fields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b55e9381-1ced-309f-b3a4-15fceaef2443",
                                        "entry_id": "e95d01a3-b68e-3397-90db-426ac091b9bc",
                                        "glosses": [
                                            "Sudden, without warning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "485d5cd1-9515-3db7-9c43-f54f234b80ed",
                                        "entry_id": "e95d01a3-b68e-3397-90db-426ac091b9bc",
                                        "glosses": [
                                            "Said or done without prior planning or prior writing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c67b5285-4123-45ca-8a26-ca497f43afcd",
                                                "sense_id": "485d5cd1-9515-3db7-9c43-f54f234b80ed",
                                                "text": "He made a spontaneous remarks in the court."
                                            }
                                        ]
                                    }
