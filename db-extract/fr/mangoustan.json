        "fr-extract.jsonl": [
            {
                "entry_id": "5bb6807c-6b05-3867-9285-94692d5b2a11",
                "word": "mangoustan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f95a8eb9-73f6-4540-ab62-a0b6bfaf76fc",
                        "entry_id": "5bb6807c-6b05-3867-9285-94692d5b2a11",
                        "tags": [
                            "plural"
                        ],
                        "form": "mangoustans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ddf3a90-5a9b-3dcf-9dc7-b21897abdf4d",
                        "entry_id": "5bb6807c-6b05-3867-9285-94692d5b2a11",
                        "glosses": [
                            "Mangoustanier."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "07fb69da-1c94-4bad-b8a3-c3cdb6474b6e",
                                "sense_id": "8ddf3a90-5a9b-3dcf-9dc7-b21897abdf4d",
                                "text": "Au Bengale (quelques degrés plus au nord de sa patrie), tous les essais pour cultiver le Mangoustan comme arbre fruitier ont été sans succès; il y atteint deux ou trois pieds de haut, puis il périt."
                            }
                        ]
                    },
                    {
                        "sense_id": "ede3c39e-57ef-3140-bb23-b8d42228c67a",
                        "entry_id": "5bb6807c-6b05-3867-9285-94692d5b2a11",
                        "glosses": [
                            "Fruit du mangoustanier, de la grosseur d’une petite orange et d’une saveur sucrée, légèrement acide avec un parfum de framboise."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "66ff2b8e-03fb-4897-b5ba-3042147ed678",
                                "sense_id": "ede3c39e-57ef-3140-bb23-b8d42228c67a",
                                "text": "Le fruit le plus exquis de l’Orient et peut être du monde, est le mangoustan (garcinia mangostana). […]; il est petit et sphérique : une écorce brune, dure à l’extérieur, plus douce et moins foncée intérieurement, recouvre une pulpe blanche et transparente comme la neige : cette pulpe est la seule partie mangeable du fruit."
                            },
                            {
                                "example_id": "a5f1dc5b-1b18-464e-aa62-01de7718088f",
                                "sense_id": "ede3c39e-57ef-3140-bb23-b8d42228c67a",
                                "text": "Vigilante quand ils sillonnèrent le Chinatown derrière la place d’Italie, vigilante quand on lui tendit la mangue juteuse et le mangoustan rarissime […]."
                            },
                            {
                                "example_id": "c91df6a6-7856-451b-ad5c-ce6d158b42c6",
                                "sense_id": "ede3c39e-57ef-3140-bb23-b8d42228c67a",
                                "text": "En Asie du Sud-Est, le mangoustan, fruit du mangoustanier, Garcinia mangostana, est considéré comme l’un des fruits les plus délicieux des tropiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a51c074b-b170-401f-8392-eabc755284f2",
                        "source_entry_id": "5bb6807c-6b05-3867-9285-94692d5b2a11",
