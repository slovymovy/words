    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33bf7db7-4858-3ad7-aa49-0c1c780a20a0",
                    "sense_definition": "Ralentissement important ou blocage de la circulation causé par un excès de véhicules.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "circulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons préféré prendre le train pour éviter les <w>encombrements</w> habituels du vendredi soir."
                        },
                        {
                            "text": "Un grave accident a provoqué un important <w>encombrement</w> à l'entrée de la ville ce matin."
                        }
                    ],
                    "synonyms": [
                        "embouteillage",
                        "bouchon"
                    ],
                    "antonyms": [
                        "fluidité"
                    ],
                    "common_phrases": [
                        "éviter les encombrements"
                    ]
                },
                {
                    "sense_id": "1643f878-84df-3134-b865-009a997f7775",
                    "sense_definition": "Présence excessive d'objets qui gênent le passage ou occupent inutilement un espace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le couloir est difficilement praticable en raison de l'<w>encombrement</w> causé par tous ces cartons."
                        },
                        {
                            "text": "Il faut nettoyer cet atelier pour éliminer tout <w>encombrement</w> inutile avant la visite."
                        }
                    ],
                    "synonyms": [
                        "obstruction",
                        "entassement"
                    ],
                    "antonyms": [
                        "dégagement"
                    ],
                    "common_phrases": [
                        "réduire l'encombrement"
                    ]
                },
                {
                    "sense_id": "c1547199-0073-3967-9cc7-92ccebe50bcc",
                    "sense_definition": "Volume extérieur ou place qu'occupe un objet, un meuble ou un équipement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau lave-linge séduit les clients par son très faible <w>encombrement</w> dans la cuisine."
                        },
                        {
                            "text": "L'<w>encombrement</w> au sol de cette armoire est trop important pour une petite chambre."
                        }
                    ],
                    "synonyms": [
                        "gabarit",
                        "volume"
                    ],
                    "common_phrases": [
                        "faible encombrement",
                        "encombrement au sol"
                    ]
                },
                {
                    "sense_id": "07066142-14b3-3f4e-97b3-39553184869a",
                    "sense_definition": "Saturation ou surcharge d'un service ou d'un système par un afflux excessif de demandes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "saturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a proposé plusieurs réformes pour limiter l'<w>encombrement</w> des tribunaux de grande instance."
                        },
                        {
                            "text": "L'<w>encombrement</w> des urgences hospitalières pendant l'hiver inquiète fortement le personnel soignant."
                        }
                    ],
                    "synonyms": [
                        "engorgement",
                        "saturation",
                        "surcharge"
                    ],
                    "antonyms": [
                        "désengorgement"
                    ],
                    "common_phrases": [
                        "encombrement des urgences",
                        "encombrement des tribunaux"
                    ]
                }
            ]
        }
    ]
