                "senses": [
                    {
                        "sense_id": "3bd5d913-fea2-3711-b2d7-ebe90e09c454",
                        "entry_id": "4318cdd2-f23e-3b54-b98c-115a0dbc8919",
                        "glosses": [
                            "fest im Kraftfahrzeug installiertes Telefon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1d8c78-9537-4118-8115-20682bbb66da",
                                "sense_id": "3bd5d913-fea2-3711-b2d7-ebe90e09c454",
                                "text": "Er rief mit dem Autotelefon den Notruf an."
                            },
                            {
                                "example_id": "30bd876e-f22a-43c2-9055-8fa397dadc3e",
                                "sense_id": "3bd5d913-fea2-3711-b2d7-ebe90e09c454",
                                "text": "„Eigentlich musste ich mich auf Besprechungen konzentrieren, doch das Autotelefon funktionierte nicht.“"
                            },
                            {
                                "example_id": "ec190911-5af8-40d4-9774-7091b5dbc0d3",
                                "sense_id": "3bd5d913-fea2-3711-b2d7-ebe90e09c454",
                                "text": "„Ich drückte meine Zigarre aus, griff zum Autotelefon und wählte die Durchsage mit den Ergebnissen des neunten Rennens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
