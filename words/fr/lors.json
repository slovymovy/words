                    "frequency": "VeryLow",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Lors</w> que le messager arriva au château, tout le monde dormait déjà."
                        },
                        {
                            "text": "On ne savait que penser <w>lors</w> que la nouvelle fut annoncée au peuple."
                        }
                    ],
                    "common_phrases": [
