                        "glosses": [
                            "Pigment contenant des sels de fer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be126730-7675-4fa3-9d96-d529366c8d8d",
                                "sense_id": "5d572aad-fd23-37c8-bc21-f3202686de05",
                                "text": "La présence d'hémosidérine et d'hémofuschine dans les cellules hépatiques et réticulo-endothéliales indique l'étiologie de la cirrhose et explique également l'augmentation de volume du foie."
                            },
                            {
                                "example_id": "bf0161b6-0af5-4b52-8747-379d243a14f2",
                                "sense_id": "5d572aad-fd23-37c8-bc21-f3202686de05",
                                "text": "Ce métal^([note : le fer]) capté en excès est rapidement stocké dans les tissus, sous forme d'hémosiderine ou plus accessoirement d'hémofuschine. Dans l'hémochromatose, le stock devient considérable et peut atteindre 10 à 50 grammes dans le foie."
                            }
                        ]
                    }
