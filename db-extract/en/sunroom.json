                "entry_id": "069928ad-6c78-37c9-a4fe-76c97087fb31",
                "word": "sunroom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "342674c3-cfb8-355d-a5bd-c332e29ae5eb",
                        "entry_id": "069928ad-6c78-37c9-a4fe-76c97087fb31",
                        "glosses": [
                            "ein Raum in einem Wohnhaus mit vielen, großen Fenstern für einen guten Ausblick bzw. bestmöglichen Lichteinfall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837ae37a-2aa2-498d-a91a-e45a5be8b6d3",
                                "sense_id": "342674c3-cfb8-355d-a5bd-c332e29ae5eb",
                                "text": "\"A sunroom is a structure, usually constructed onto the side of a house, to allow enjoyment of the surrounding landscape while being sheltered from adverse weather conditions such as rain and wind.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "757ce08b-11e8-4c5a-908c-b0f0f66e7d43",
                        "source_entry_id": "069928ad-6c78-37c9-a4fe-76c97087fb31",
                        "source_sense_id": "342674c3-cfb8-355d-a5bd-c332e29ae5eb",
                        "source_sense_description": "Raum in einem Wohnhaus mit Fenstern für einen bestmöglichen Lichteinfall",
                        "target_lang_word": "Wintergarten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wintergarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57baa0b9-09d0-30f6-a0c6-d8f7ed89e65c",
                                        "entry_id": "c8a494e5-8ef5-3af6-9219-88c24edbd0ee",
                                        "glosses": [
                                            "Raum, dessen Wände hauptsächlich aus Glas bestehen, um ein Überwintern von Pflanzen zu ermöglichen und der meist direkten Zugang zum Wohnraum im Haus hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c01e289a-5e4c-494d-86e1-55d11a89bf6c",
                                                "sense_id": "57baa0b9-09d0-30f6-a0c6-d8f7ed89e65c",
                                                "text": "Zum Tee gingen wir in den Wintergarten, wo wir uns gemeinsam mit Palmen und Agaven in der Märzsonne sonnten."
                                            },
                                            {
                                                "example_id": "f03cc602-7d72-48fd-9d78-f95adb1c35a4",
                                                "sense_id": "57baa0b9-09d0-30f6-a0c6-d8f7ed89e65c",
                                                "text": "„Vor den Fenstern gibt es eine Zone von hohen Zimmerpflanzen, ein Wintergarten, durch den der Lärm der Straße nicht dringt und in dem sich bei Tag das Licht bricht.“"
                                            },
                                            {
                                                "example_id": "5f274ee5-e53c-4077-870a-9fe926fef7ea",
                                                "sense_id": "57baa0b9-09d0-30f6-a0c6-d8f7ed89e65c",
                                                "text": "„Zurück im Wintergarten, traf er Minni vor den Künstlergarderoben unruhig auf und ab gehen.“"
                                            },
                                            {
                                                "example_id": "9b297992-a8cb-4457-9fd5-7341e673c034",
                                                "sense_id": "57baa0b9-09d0-30f6-a0c6-d8f7ed89e65c",
                                                "text": "„Mademoiselle Bourienne ging an diesem Abend lange im Wintergarten auf und nieder; vergeblich wartete sie auf irgend jemand und lächelte bald diesem Irgendjemand zu, bald rührte sie sich selbst bis zu Tränen, wenn sie sich die Worte vergegenwärtigte, mit denen die pauvre mère ihr einen getanen Fehltritt vorhielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1245512c-7947-3893-9e82-065b7cd163b6",
                                        "entry_id": "c8a494e5-8ef5-3af6-9219-88c24edbd0ee",
                                        "glosses": [
                                            "freie Fläche am Turm eines U-Bootes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00f33abb-e2e8-4c06-b561-99d022225619",
                                                "sense_id": "1245512c-7947-3893-9e82-065b7cd163b6",
                                                "text": "„Der Leitende bleibt im Wintergarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3191ad3d-6d1e-4e75-b25c-39cfd2269daa",
                        "source_entry_id": "069928ad-6c78-37c9-a4fe-76c97087fb31",
                        "source_sense_id": "342674c3-cfb8-355d-a5bd-c332e29ae5eb",
                        "source_sense_description": "Raum in einem Wohnhaus mit Fenstern für einen bestmöglichen Lichteinfall",
                        "target_lang_word": "Glasveranda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glasveranda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d23a73e7-c40a-3252-b857-ead556c8ca37",
                                        "entry_id": "b54b4f8e-e0d6-3a79-ae37-8026b0542f1c",
                                        "glosses": [
                                            "Veranda, die nach außen mit Glasscheiben geschützt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc6a4bb6-e38f-4fba-82aa-626cf91cfc7b",
                                                "sense_id": "d23a73e7-c40a-3252-b857-ead556c8ca37",
                                                "text": "„Ich sah im Vorbeigehen den Korsen in der geheizten Glasveranda des Cafés Kongo.“"
