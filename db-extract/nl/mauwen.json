                        ],
                        "examples": [
                            {
                                "example_id": "5ac2c856-f0a3-4fc4-b4c7-9479c07739af",
                                "sense_id": "58a06376-9074-35cb-9f7b-dd82dbcc2fc0",
                                "text": "Vanwege de kalk nam ze een beker melk, ze riep de kat binnen die op de vensterbank zat en ging eten. Hij sprong meteen op het aanrecht en keek haar daarvandaan indringend aan. ‘Eerst ik’, zei Louise en at rustig verder. Maar de kat kende zijn macht en begon aanhoudend te miauwen zodat ze toch opstond en een blikje voor hem opende."
                            }
                        ]
                    }
