                "senses": [
                    {
                        "sense_id": "75de9ced-b70f-300a-bc42-46b1667bf4d6",
                        "entry_id": "e67bcc0d-78bf-3a71-bee1-de921cf65618",
                        "glosses": [
                            "Donner un caractère tendance à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f6f84b-f0bb-49cf-bdf8-f78a17bad862",
                                "sense_id": "75de9ced-b70f-300a-bc42-46b1667bf4d6",
                                "text": "Mais qui sont ces gens qui essayent de tout tendanciser ?"
                            },
                            {
                                "example_id": "90aae554-8513-4a3b-a52f-711cd865e264",
                                "sense_id": "75de9ced-b70f-300a-bc42-46b1667bf4d6",
                                "text": "Pour réchauffer et « tendanciser » son mug, une théière, une paire de bottes ou même une selle de vélo, il existe maintenant les « Knit Kit »."
                            },
                            {
                                "example_id": "a779d85f-a781-43d9-a43c-1ab621fed5a7",
                                "sense_id": "75de9ced-b70f-300a-bc42-46b1667bf4d6",
                                "text": "Rare de faire une rencontre aussi intéressante, quand ailleurs tout à tendance à s'uniformiser, se « tendanciser » et s'« astuciser »."
                            }
                        ]
                    }
