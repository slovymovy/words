                                "target_lang_sense_clarification": "皮肤、黏膜，医学用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63966375-3b85-3496-b973-f8b2595292d8",
                    "sense_definition": "Rendre plus vif ou plus violent un sentiment, une passion ou une douleur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses paroles maladroites n'ont fait qu'<w>irriter</w> la rancœur de son collègue.",
                            "target_lang_translations": {
                                "en": "His clumsy words only <w>aggravated</w> his colleague's resentment.",
                                "ru": "Его неловкие слова лишь <w>обострили</w> затаённую обиду коллеги.",
                                "de": "Seine ungeschickten Worte haben den Groll seines Kollegen nur <w>verstärkt</w>.",
                                "es": "Sus palabras desafortunadas solo <w>avivaron</w> el rencor de su compañero de trabajo.",
                                "zh": "他笨拙的话只是<w>加深</w>了同事的怨恨。"
                            }
                        },
                        {
                            "text": "L'absence de dialogue risque d'<w>irriter</w> la colère des usagers mécontents.",
                            "target_lang_translations": {
                                "en": "The lack of dialogue risks <w>inflaming</w> the anger of dissatisfied users.",
                                "ru": "Отсутствие диалога грозит <w>разжечь</w> гнев недовольных пользователей.",
                                "de": "Das Fehlen eines Dialogs droht, den Zorn der unzufriedenen Nutzer <w>anzufachen</w>.",
                                "es": "La falta de diálogo corre el riesgo de <w>avivar</w> la cólera de los usuarios descontentos.",
                                "zh": "缺乏对话可能会<w>加剧</w>不满用户的愤怒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attiser",
                        "exacerber",
                        "envenimer"
                    ],
                    "antonyms": [
                        "modérer",
                        "calmer"
                    ],
                    "common_phrases": [
                        "irriter la colère",
                        "irriter la douleur"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a feeling, passion or pain stronger or more violent.",
                        "ru": "Делать сильнее или острее чувство, страсть или боль.",
                        "de": "Ein Gefühl, eine Leidenschaft oder einen Schmerz stärker und heftiger machen.",
                        "es": "Hacer más intensos o violentos un sentimiento, una pasión o un dolor.",
                        "zh": "使感情、激情或疼痛变得更强烈或更剧烈。"
                    },
