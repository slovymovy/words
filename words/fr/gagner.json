    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54344e9c-e263-3b88-94de-fd548ce7402e",
                    "sense_definition": "Être le vainqueur dans une compétition, un jeu ou une épreuve.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "victoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe de football a réussi à <w>gagner</w> le match hier soir."
                        },
                        {
                            "text": "Les enfants jouent souvent aux cartes et espèrent toujours <w>gagner</w> la partie."
                        }
                    ],
                    "synonyms": [
                        "remporter"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "gagner le match",
                        "gagner la partie"
                    ]
                },
                {
                    "sense_id": "3ef6bac0-737c-320c-bfa8-44560aab1c0a",
                    "sense_definition": "Recevoir de l'argent ou un salaire en contrepartie d'un travail ou par le hasard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle travaille d'arrache-pied chaque jour pour <w>gagner</w> sa vie honnêtement."
                        },
                        {
                            "text": "Il espère <w>gagner</w> une grosse somme d'argent à la loterie ce week-end."
                        }
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "gagner sa vie",
                        "gagner de l'argent"
                    ]
                },
                {
                    "sense_id": "255209b2-3a26-3b2b-8049-d57f13d92382",
                    "sense_definition": "Se diriger vers un lieu précis et y parvenir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le personnel a demandé aux voyageurs de <w>gagner</w> la sortie sans courir."
                        },
                        {
                            "text": "Après une marche fatigante, les touristes ont enfin pu <w>gagner</w> leur hôtel."
                        }
                    ],
                    "common_phrases": [
                        "gagner la sortie"
                    ]
                },
                {
                    "sense_id": "5cf183f2-223c-3a3e-91d6-293d24ca0279",
                    "sense_definition": "S'étendre, progresser ou envahir un espace, un groupe ou une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers constatent avec inquiétude que le feu continue de <w>gagner</w> du terrain."
                        },
                        {
                            "text": "La fatigue commençait à <w>gagner</w> tous les participants après cette longue réunion."
                        }
                    ],
                    "common_phrases": [
                        "gagner du terrain"
                    ]
                },
                {
                    "sense_id": "4e6eeeff-73b8-3649-8e1a-935a74c5a902",
                    "sense_definition": "Se concilier la bienveillance, l'amitié ou l'estime de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat cherche constamment à <w>gagner</w> la confiance des électeurs locaux."
                        },
                        {
                            "text": "Sa grande générosité lui a permis de <w>gagner</w> l'affection de ses collègues."
                        }
                    ],
                    "common_phrases": [
                        "gagner la confiance"
                    ]
                }
            ]
        }
    ]
