                                        "glosses": [
                                            "Ansammlung von Eiter in einem durch Gewebseinschmelzung (Nekrose) entstandenen unnatürlichen Hohlraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3ff8192-7d3f-4dc3-a8c8-2b478f4eb2b2",
                                                "sense_id": "022ef720-d6ef-3e1c-adb8-4dce76dc8934",
                                                "text": "Abszesse können ohne offenbare äußere Ursache auftreten, aber sie können auch Folge einer Operation, einer Spritze, eines Fremdkörpers oder durch eine Abwehrschwäche des Betroffenen begünstigt sein."
                                            }
                                        ],
