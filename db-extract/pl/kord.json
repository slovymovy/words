                "senses": [
                    {
                        "sense_id": "9dfaeab7-2698-3248-8f58-7a1e36bf7f7c",
                        "entry_id": "e2e825be-b31a-3332-8558-54e26b2451fa",
                        "glosses": [
                            "krótki miecz, używany zazwyczaj przez niższe warstwy społeczeństwa"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "f69bea7e-2baa-42d1-a860-572c72c79b7a",
                                "sense_id": "9dfaeab7-2698-3248-8f58-7a1e36bf7f7c",
                                "text": "Za frajbitrem każda w wodę by skoczyła! Byle kord czy tasak u boku miał, a już białka świata za nim nie widzi!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7de074e2-4d61-3333-8c69-7db46514b2f0",
                        "entry_id": "e2e825be-b31a-3332-8558-54e26b2451fa",
                        "glosses": [
                            "mocne włókno syntetyczne służące do wzmacniania opon samochodowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2f2948-b490-4319-b948-4aac72cda347",
                                "sense_id": "7de074e2-4d61-3333-8c69-7db46514b2f0",
                                "text": "Opona przetarła się – widać już kord!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9638f6ba-5dd8-4567-8dec-c198cfc0f8ea",
                        "source_entry_id": "e2e825be-b31a-3332-8558-54e26b2451fa",
