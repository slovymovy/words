                "senses": [
                    {
                        "sense_id": "ebcaea6a-0e27-3cb5-9d02-da03d4fe3b8d",
                        "entry_id": "1f11b4b0-f97d-3a7d-822a-28ba8846fdef",
                        "glosses": [
                            "Gesamtheit der Maßnahmen, mit denen die Kriminalität vermindert werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d024bf03-b5d4-41f4-a26c-b6f8f91f47ab",
                                "sense_id": "ebcaea6a-0e27-3cb5-9d02-da03d4fe3b8d",
                                "text": "„Die Kriminalpolizei arbeitet mit den Landeskriminalämtern zusammen, die sich mit dem Bundeskriminalamt, der Zentralstelle für Verbrechensbekämpfung, abstimmen.“"
                            },
                            {
                                "example_id": "b4aa55ab-4aad-49ed-a00b-666c4625fea5",
                                "sense_id": "ebcaea6a-0e27-3cb5-9d02-da03d4fe3b8d",
                                "text": "„Die Internationale Kriminalpolizeiliche Organisation mit Sitz in Lyon dient der gegenseitigen Unterstützung der Polizeibehörden bei der staatsübergreifenden Verbrechensbekämpfung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
