                ],
                "senses": [
                    {
                        "sense_id": "29aed79e-a33f-39ba-8517-80b003dbf3f0",
                        "entry_id": "d373655b-d3d0-34aa-b56f-58758d3f05ea",
                        "glosses": [
                            "mit (Kraft-)Fahrzeugen befahrbare Straße"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "6f5eb39f-cab4-4df9-9363-861d6ac5a1c8",
                                "sense_id": "29aed79e-a33f-39ba-8517-80b003dbf3f0",
                                "text": "„Bei der Vorprüfung hat die Behörde festzustellen, ob dem Vorhaben […] bis zur Erteilung der Baubewilligung nicht behebbare Hindernisse einer Verbindung mit einer öffentlichen Fahrstraße […] entgegenstehen.“"
                            },
                            {
                                "example_id": "2874a5a6-c870-4b2d-9586-f230c67c53d6",
                                "sense_id": "29aed79e-a33f-39ba-8517-80b003dbf3f0",
                                "text": "„Die Entlüftung der Fahrstraße im Tunnel sind in den beiden hohen Häusern vorgesehen - über Schächte mit Kohlefiltern.“"
                            },
                            {
                                "example_id": "ef63cde1-ae2f-4b1a-98dc-4054354c2321",
                                "sense_id": "29aed79e-a33f-39ba-8517-80b003dbf3f0",
                                "text": "„Die überdeckelte Fahrstraße dieser Ebene (‚Innerer Ring‘) bildet mittels einer Rampe die Verlängerung der Althanstraße und endet am Josef-Holaubek-Platz bzw. an der Nordbergbrücke.“"
                            },
                            {
                                "example_id": "ce2871ca-bd13-47f5-a677-491cc6ef13ce",
                                "sense_id": "29aed79e-a33f-39ba-8517-80b003dbf3f0",
                                "text": "„Sie sei nicht nur eine Fahrstraße mit Parkflächen sondern auch mit Gehwegen und Bereichen, wie dem Dorfplatz, die zur Begegnung einladen.“"
                            },
                            {
                                "example_id": "b38f6d47-a015-4f4e-b9d3-64d4d8c51e1d",
                                "sense_id": "29aed79e-a33f-39ba-8517-80b003dbf3f0",
                                "text": "„Der Exerzier- und Paradeplatz durfte von keiner Fahrstraße durchquert und nicht bepflanzt werden, sodass sich vor allem für die Verbindung der Vorstadt (beziehungsweise des Bezirks) Josefstadt mit dem Stadtzentrum für die Bevölkerung schwere Behinderungen ergaben; …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6187c639-1cdd-3a94-84d6-cffa4d154422",
                        "entry_id": "d373655b-d3d0-34aa-b56f-58758d3f05ea",
                        "glosses": [
                            "mit (Kraft-)Fahrzeugen befahrbare Straße",
                            "bedeutender und/oder schneller Verkehrsweg"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "ff7f789d-9a58-486f-b7db-f501cfd317cb",
                                "sense_id": "6187c639-1cdd-3a94-84d6-cffa4d154422",
                                "text": "„Sonst soll aber im Anschluße an den Quai längs dem Donaukanal rings um die innere Stadt ein Gürtel in der Breite von mindestens vierzig (40) Klafter, bestehend aus einer Fahrstraße mit Fuß- und Reitwegen zu beiden Seiten, auf dem Glacisgrunde in der Art angelegt werden, daß dieser Gürtel eine angemessene Einfassung von Gebäuden abwechselnd mit freien zu Gartenanlagen bestimmten Plätzen erhalte.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "cbf1e81d-0843-331e-9c2d-39fe61158db3",
                        "entry_id": "d373655b-d3d0-34aa-b56f-58758d3f05ea",
                        "glosses": [
                            "mit (Kraft-)Fahrzeugen befahrbare Straße",
                            "befahrbarer Waldweg"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "3fb7a96a-0509-466a-8100-4a9277b2cd30",
                                "sense_id": "cbf1e81d-0843-331e-9c2d-39fe61158db3",
                                "text": "„Auf einer steilen Fahrstraße geht es durch den Bergwald zu einer großen Übersichtstafel, auf der alle wichtigen Informationen zum Klettersteig nachzulesen sind.“"
                            },
                            {
                                "example_id": "b8e3ac14-94d4-481f-a1d8-d7db7ec5856e",
                                "sense_id": "cbf1e81d-0843-331e-9c2d-39fe61158db3",
                                "text": "„Von der Kreisstraße 35 (Hemfurth - Bringhausen) führt auch eine breite Fahrstraße auf den Peterskopf. Diese Werksstraße ist größtenteils für den KFZ gesperrt.“"
                            },
                            {
                                "example_id": "484b7d4e-2283-4cb2-aed3-87f05c89d2a3",
                                "sense_id": "cbf1e81d-0843-331e-9c2d-39fe61158db3",
                                "text": "„Auf halber Höhe ziehen um die Festung zwei schmale Fahrstraßen, die für den öffentlichen Verkehr gesperrt sind.“"
                            },
                            {
                                "example_id": "bb72429f-d1c1-4d20-89f4-1c47bc7c0f68",
                                "sense_id": "cbf1e81d-0843-331e-9c2d-39fe61158db3",
                                "text": "„Die Bergerhube am Ende der Fahrstraße ist immer noch der Treffpunkt von Wanderern und Kletterern, die den Trubel meiden und die stille Schönheit in den Niederen Tauern suchen.“"
                            },
                            {
                                "example_id": "cf22121b-2351-4b3c-b9ed-e4f9a366ed48",
                                "sense_id": "cbf1e81d-0843-331e-9c2d-39fe61158db3",
                                "text": "„Die Bartlhütte auf 1060 Metern Seehöhe ist eine namentlich geschützte Holleralm, und sie hat einen Vorzug, der gleichzeitig ein großer Nachteil ist: Nur fünf Minuten unter der Hütte endet die öffentliche Fahrstraße herauf vom Fuschlsee an einem Großparkplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "f336d626-16e2-3c91-8e2a-7d85dd11a76b",
                        "entry_id": "d373655b-d3d0-34aa-b56f-58758d3f05ea",
                        "glosses": [
                            "von einem Zug zu befahrende und gesicherte Strecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd947b81-c526-4460-97c3-dbfb0d452c9f",
                                "sense_id": "f336d626-16e2-3c91-8e2a-7d85dd11a76b",
                                "text": "„Man habe den Fahrgästen mitgeteilt, dass der Zug sich ‚auf der falschen Fahrstraße‘ befinde und umdrehen müssen.“"
                            },
                            {
                                "example_id": "7d053ba9-339b-4313-8d86-5d56dea42109",
                                "sense_id": "f336d626-16e2-3c91-8e2a-7d85dd11a76b",
                                "text": "„Solange das Signal für die Ein- oder Ausfahrt eines Zuges auf Fahrt steht, darf auf den der Fahrstraße benachbarten Gleisen nur rangiert werden, wenn die Fahrstraße gegen die Rangierbewegungen gesichert ist.“"
                            },
                            {
                                "example_id": "cfcdc513-5a12-471e-8d66-cbcb8d3a519b",
                                "sense_id": "f336d626-16e2-3c91-8e2a-7d85dd11a76b",
                                "text": "„Laut Gleisschaubild war eine gesicherte Fahrstraße für Z 54049 gestellt.“"
                            },
                            {
                                "example_id": "8c2a92e6-409a-4812-a128-ab42dfbe4cf7",
                                "sense_id": "f336d626-16e2-3c91-8e2a-7d85dd11a76b",
                                "text": "„Das Risiko von Zusammenstößen und Kollisionen wird jedoch durch die Technik verhindert, indem jede voreingestellte Fahrstraße von einer Rechenmaschine überprüft wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "024e5522-6052-3639-b913-6cbb957938f9",
                        "entry_id": "d373655b-d3d0-34aa-b56f-58758d3f05ea",
                        "glosses": [
                            "für Schiffe vorgesehener Wasserweg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7bf47c2-ceef-449b-b792-604faf9d16a6",
                                "sense_id": "024e5522-6052-3639-b913-6cbb957938f9",
                                "text": "„… besonders zwischen Preßburg und Gönyö bei Raab, wo sie 3 bis 5 Kilom. breit wird und in zahllose Arme verläuft, wo die Schottermassen die Fahrstraße fortwährend verändern, da wird der große Schifffahrtsverkehr verhindert, …“"
                            },
                            {
                                "example_id": "60d73af5-e3f8-4e9c-8e4e-3de2288afc3b",
                                "sense_id": "024e5522-6052-3639-b913-6cbb957938f9",
                                "text": "„…einen neuen Vertrag zur Regelung der gegenseitigen Verpflichtungen Preußens und der Niederlande, betreffend die Unterhaltung des Seefeuers auf Borkum sowie der Betonnung, der Bebakung und der Beleuchtung der Fahrstraßen der Unterems und ihrer Mündungen, abzuschließen …“"
                            },
                            {
                                "example_id": "58b6360a-1f2e-4dfc-a61b-99c04ac2ab14",
                                "sense_id": "024e5522-6052-3639-b913-6cbb957938f9",
                                "text": "„Durch die in den Jahren 1830 – 1832 ausgeführten Arbeiten ist endlich die Fahrstraße im Rhein so erweitert worden, daß sie von den Schiffen ohne Gefahr zurückgelegt werden kann; …“"
                            },
                            {
                                "example_id": "75bbee6b-19f1-4a30-91ad-10b20bb9fa2d",
                                "sense_id": "024e5522-6052-3639-b913-6cbb957938f9",
                                "text": "„In erster Linie pflegten die Schiffe der Svea-Reederei diese Fahrstraße im Küstenverkehr zu benutzen.“"
                            },
                            {
                                "example_id": "d7f2be54-75d2-4b8d-87d1-7cee569a5f15",
                                "sense_id": "024e5522-6052-3639-b913-6cbb957938f9",
                                "text": "„Der Macquarie befand sich nicht in einer Fahrstraße für Schiffe, welche auf Neu-Seeland zu landen suchen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
