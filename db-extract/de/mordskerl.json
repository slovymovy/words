                "senses": [
                    {
                        "sense_id": "146133f8-78c5-31ce-9724-9bba51a7436f",
                        "entry_id": "e8a1b129-106f-31a8-8c43-ab4c5f429c0e",
                        "glosses": [
                            "ein von der äußeren Statur her sehr großer und breitschultriger Mann"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "073416d6-7f8e-42a1-b486-f177a65927c6",
                                "sense_id": "146133f8-78c5-31ce-9724-9bba51a7436f",
                                "text": "Plötzlich stand da so ein Mordskerl von 2 Metern auf, und es wurde sofort ganz still in der Kneipe."
                            },
                            {
                                "example_id": "23a8f5d5-87e2-433f-8a4d-0c6ae9f679f0",
                                "sense_id": "146133f8-78c5-31ce-9724-9bba51a7436f",
                                "text": "Erinnerst du dich nicht an Hannes? Das war so ein Mordskerl, der durch keine Tür passte und Bäume ausreißen konnte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7b0d340e-c7a4-30ea-b72c-4683cc35048e",
                        "entry_id": "e8a1b129-106f-31a8-8c43-ab4c5f429c0e",
                        "glosses": [
                            "ein von den inneren Werten her sehr verlässlicher und anständiger Mann"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "80ab1551-6292-4b10-857e-c5c83017bfad",
                                "sense_id": "7b0d340e-c7a4-30ea-b72c-4683cc35048e",
                                "text": "Der beste Kumpel meines Bruders ist ein echter Mordskerl, auf den man sich zu 100% verlassen kann."
                            },
                            {
                                "example_id": "15433313-ffc0-49c7-9e3b-6ecede19a903",
                                "sense_id": "7b0d340e-c7a4-30ea-b72c-4683cc35048e",
                                "text": "Hey! Ich habe dich immer für einen Mordskerl gehalten! Du kannst mich doch jetzt nicht hängenlassen!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
