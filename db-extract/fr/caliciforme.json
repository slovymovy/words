                        "entry_id": "920966a1-b983-3291-8b66-fa3dd0a9f482",
                        "glosses": [
                            "Qui est en forme de calice."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "24e3e299-6700-436a-ad59-a86546e81aae",
                                "sense_id": "a2eff814-c76d-329f-a05f-a449370834da",
                                "text": "CALICIFORME, adj., calyciformis ; kelchförmig (all.) (ϰαλυξ, calice, forma, forme) ; qui a la forme d’un calice, comme l’involucre des Anemone."
                            },
                            {
                                "example_id": "d491465b-8993-43ea-a408-ad84c8d0675a",
                                "sense_id": "a2eff814-c76d-329f-a05f-a449370834da",
                                "text": "La cellule caliciforme visible dans cette micrographie provenant de l’intestin grêle est composée d’un pôle apical gonflé."
                            },
                            {
                                "example_id": "85d389c0-06b2-4eba-9f34-9a2f20c454c4",
                                "sense_id": "a2eff814-c76d-329f-a05f-a449370834da",
                                "text": "Ce sont, d’une part, trois grands vases caliciformes renfermant chacun un petit vase et, d’autre part, six autres vases."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aec6a13f-9c37-4f7e-835b-adc9a8fc9af8",
                        "source_entry_id": "920966a1-b983-3291-8b66-fa3dd0a9f482",
                        "source_sense_id": "a2eff814-c76d-329f-a05f-a449370834da",
