                "senses": [
                    {
                        "sense_id": "bb056e4d-747e-3453-b721-a53ce7d8920d",
                        "entry_id": "8002abb6-bf93-31a8-b96f-5983afc04e08",
                        "glosses": [
                            "besonders hohe Temperaturbelastung in der Wüste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4a2d593-92b8-425f-aa7a-c1cfc2146c18",
                                "sense_id": "bb056e4d-747e-3453-b721-a53ce7d8920d",
                                "text": "„Als ich sie in der schrecklichen Stille endlosen Schlafes erreichte, sah sie mir kühl unter den Strahlen eines kalten Mondes inmitten der Wüstenhitze entgegen.“"
                            },
                            {
                                "example_id": "a20b6d57-caab-4b59-90c9-0ecf953f89b7",
                                "sense_id": "bb056e4d-747e-3453-b721-a53ce7d8920d",
                                "text": "„Von dort, wo sie über dem fernen Horizont erschien, sah die Gestalt wie ein Gespenst aus. Dünn und schimmernd in der Wüstenhitze, schwankend und flackernd wie eine Flamme, wurde sie mit jedem Schritt entlang des Highways größer.“"
                            },
                            {
                                "example_id": "5e6417fb-b711-4ff5-bdb5-f1a50ab89a8f",
                                "sense_id": "bb056e4d-747e-3453-b721-a53ce7d8920d",
                                "text": "„Nach wochenlangen Gefechten, die in der Wüstenhitze begonnen hatten, trugen viele britische Soldaten immer noch Sommeruniformen und sogar kurze Hosen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
