                "senses": [
                    {
                        "sense_id": "ba7c5bc0-b7f7-36ac-924d-e290bfed39fa",
                        "entry_id": "77d6b4d0-9292-3ee5-84d3-f47167ccb09d",
                        "glosses": [
                            "Action d’exterminer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46f0c94-67f6-4457-922d-7399ea1d8f32",
                                "sense_id": "ba7c5bc0-b7f7-36ac-924d-e290bfed39fa",
                                "text": "Cette sanglante extermination, qui semblait devoir anéantir le bouddhisme, fut ce qui lui livra presque toute la haute Asie. Repoussé de l'Inde, il se répandit sur tous les pays environnans^([sic]), …"
                            }
                        ]
                    },
                    {
                        "sense_id": "b8c67b90-007c-3b8e-a706-5d0eedd70b16",
                        "entry_id": "77d6b4d0-9292-3ee5-84d3-f47167ccb09d",
                        "glosses": [
                            "Destruction totale, ruine absolue."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3dd79273-0e09-4a8d-a65b-8674e1b29775",
                        "source_entry_id": "77d6b4d0-9292-3ee5-84d3-f47167ccb09d",
                        "target_lang_word": "Ausrottung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausrottung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                        "entry_id": "dfa9da4d-068a-3adc-a76b-bcf2e6092740",
                                        "glosses": [
                                            "komplette Tötung einer Gruppe oder Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91532438-add6-47d5-b7c7-c44f6960a44d",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "Überfischung kann zur Ausrottung von Fischarten führen."
                                            },
                                            {
                                                "example_id": "c4b79fa2-3144-42bf-93e3-8797e35f9d58",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "„Der Trieb zur Ausrottung mochte sich zu allen Zeiten an Gewalt entsprochen haben – monologisierte der Uralte –, aber daß die Menschen hierzu ihre Erfindungen und Konstruktionen einsetzten, berühre ihn absonderlich.“"
                                            },
                                            {
                                                "example_id": "ac9f642c-83d8-4373-8c3a-66322d5f441f",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "„Seine prägenden Kriegseindrücke gewann er in der Türkei: Er sah, wie die Türken unter dem Deckmantel des Weltkrieges ein internes Problem klammheimlich lösten: die Vertreibung und Ausrottung der Armenier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16343d33-140c-4173-a7ba-feb6e9781356",
                        "source_entry_id": "77d6b4d0-9292-3ee5-84d3-f47167ccb09d",
                        "target_lang_word": "extermination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extermination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                        "entry_id": "5256ea7f-e63f-3b25-8a50-4ed104f45d1e",
                                        "glosses": [
                                            "The act of exterminating; total destruction or eradication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f742bcad-ce15-4a19-8dd0-04e1562588b6",
                                                "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                                "text": "extermination of error or vice"
                                            },
                                            {
                                                "example_id": "5e441e0a-fbdb-4b82-85c2-5a3d93307b49",
                                                "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                                "text": "extermination of weeds from a field"
                                            },
                                            {
                                                "example_id": "851ead1f-33fd-4148-990a-aa91323c2216",
                                                "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                                "text": "Depending on the case, extermination of a group of people may constitute genocide or crime against humanity."
                                            },
                                            {
                                                "example_id": "d9bebe52-1f03-404c-b554-3041b6789f68",
                                                "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                                "text": "Caley locomotive types, especially such numerous things as McIntosh goods and tank engines, have defied extermination over a good many years now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "047b7ff8-b93a-33a3-8264-295c20c24749",
                                        "entry_id": "5256ea7f-e63f-3b25-8a50-4ed104f45d1e",
                                        "glosses": [
                                            "Elimination."
                                        ],
                                        "tags": [
                                            "countable",
