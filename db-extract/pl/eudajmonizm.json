                        "translation_id": "2d16f6a4-7f80-4bb8-9e2f-3e1cdcdccb21",
                        "source_entry_id": "96820c0e-a8c9-326d-9bda-b27ee9d8ef5b",
                        "source_sense_id": "95b440b5-2c0b-3f30-9d17-2f5c04e9d310",
                        "target_lang_word": "eudaimonismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
