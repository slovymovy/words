                ],
                "senses": [
                    {
                        "sense_id": "51da55a3-58fd-340a-a19e-bb233cd65fe3",
                        "entry_id": "35b5f4b4-a7e6-3dfb-bd02-a50efab1d8d4",
                        "glosses": [
                            "Lokalität, in der Glücksspiel betrieben wird"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "567bc698-0805-416e-a3e6-5129c741e5d8",
                                "sense_id": "51da55a3-58fd-340a-a19e-bb233cd65fe3",
                                "text": "„Nevzorov gelingt es, das Grundkapital in nur sechs Monaten zu verzehnfachen, indem er mit seinem neuen Freund Ritechev in Moskau eine Spielhölle eröffnet.“"
                            },
                            {
                                "example_id": "eaf97c3d-15d3-4c2a-8792-660b376378c1",
                                "sense_id": "51da55a3-58fd-340a-a19e-bb233cd65fe3",
                                "text": "\"Er berichtete von einem Rouletteapparat, der, in einer privaten Spielhölle betrieben, hinsichtlich der Breite einiger Nummernfächer manipuliert war.\""
                            },
                            {
                                "example_id": "fd95ad46-5763-4c33-9dc4-eb9e1ff616d0",
                                "sense_id": "51da55a3-58fd-340a-a19e-bb233cd65fe3",
                                "text": "„Mit seinen Galerien und Arkaden umfaßte er alles, Theater, Spielhöllen, Kaufläden, Cafés, Speisehäuser und Vergnügungsstätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
