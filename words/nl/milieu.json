                {
                    "sense_id": "b23971d2-6cd0-3ace-a1e8-42d866a9ce72",
                    "sense_definition": "De sociale kring of maatschappelijke omgeving waarin iemand leeft, werkt of opgroeit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij komt uit een artistiek <w>milieu</w> waar kunst erg belangrijk is.",
                            "target_lang_translations": {
                                "en": "She comes from an artistic <w>background</w> where art is very important.",
                                "ru": "Она происходит из артистической <w>среды</w>, где искусство очень важно.",
                                "pl": "Ona pochodzi z artystycznego <w>środowiska</w>, w którym sztuka jest bardzo ważna.",
                                "de": "Sie kommt aus einem künstlerischen <w>Milieu</w>, in dem Kunst sehr wichtig ist.",
                                "fr": "Elle est issue d'un <w>milieu</w> artistique où l'art est très important.",
                                "it": "Proviene da un <w>ambiente</w> artistico in cui l'arte è molto importante.",
                                "cs": "Pochází z uměleckého <w>prostředí</w>, kde je umění velmi důležité.",
                                "tr": "Sanatın çok önemli olduğu sanatsal bir <w>çevreden</w> geliyor.",
                                "es": "Ella proviene de un <w>ambiente</w> artístico donde el arte es muy importante."
                            }
                        },
                        {
                            "text": "Hij voelt zich niet thuis in dat chique <w>milieu</w>.",
                            "target_lang_translations": {
                                "en": "He does not feel at home in those chic <w>circles</w>.",
                                "ru": "Он не чувствует себя как дома в этих шикарных <w>кругах</w>.",
                                "pl": "On nie czuje się dobrze w tych eleganckich <w>kręgach</w>.",
                                "de": "Er fühlt sich in diesen schicken <w>Kreisen</w> nicht wohl.",
                                "fr": "Il ne se sent pas chez lui dans ce <w>milieu</w> chic.",
                                "it": "Non si sente a casa in quell'<w>ambiente</w> chic.",
                                "cs": "V těch nóbl <w>kruzích</w> se necítí dobře.",
                                "tr": "O şık <w>çevrede</w> kendini evinde hissetmiyor.",
                                "es": "Él no se siente como en casa en ese <w>ambiente</w> tan elegante."
                            }
                        }
                    ],
                    "synonyms": [
                        "omgeving",
                        "kring",
                        "sfeer",
                        "wereldje"
