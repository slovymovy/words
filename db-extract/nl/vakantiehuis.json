                    {
                        "sense_id": "2eee3b80-cc32-3347-8159-8e9a2f1af2c3",
                        "entry_id": "bd426e4d-f456-3454-aefb-c1319f7d55e2",
                        "glosses": [
                            "vakantieverblijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1be6b820-e3f9-4f15-aeff-c5f1e4dfc56b",
                                "sense_id": "2eee3b80-cc32-3347-8159-8e9a2f1af2c3",
                                "text": "Sommige mensen hebben een vakantiehuisje als tweede woning, maar je kunt ze ook huren, of er zelfs je permanente woonplaats van maken."
                            },
                            {
                                "example_id": "237830b8-d32d-44fe-baff-fbd7bb892028",
                                "sense_id": "2eee3b80-cc32-3347-8159-8e9a2f1af2c3",
                                "text": "Bij een vakantiehuisje is de locatie van de woning meestal belangrijker dan de kwaliteit van de woning zelf."
                            },
                            {
                                "example_id": "75c35f37-6d3c-4df4-9f1a-c1a236ca71c7",
                                "sense_id": "2eee3b80-cc32-3347-8159-8e9a2f1af2c3",
                                "text": "De brand ontstond bij het dorp Bordezac, bijna 100 kilometer ten noorden van Montpellier en de Middellandse Zee. Ongeveer honderd mensen moesten worden geëvacueerd en zijn ondergebracht in vakantiehuisjes en restaurants. Mensen in het zuiden van Frankrijk worden opgeroepen dit weekend voorzichtig te doen, omdat het risico op branden hoog blijft."
                            }
                        ]
                    }
