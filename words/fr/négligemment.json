                    "sense_definition": "D'une manière négligente, sans soin, sans ordre ou sans application soutenue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maniere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle avait posé <w>négligemment</w> ses clés sur la commode de l'entrée avant de repartir."
                        },
                        {
                            "text": "Il effectuait son travail <w>négligemment</w>, laissant passer de nombreuses erreurs d'inattention."
                        }
                    ],
                    "synonyms": [
                        "nonchalamment",
                        "légèrement"
                    ],
                    "antonyms": [
