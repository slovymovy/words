                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8ef3cb4-84b4-4470-8671-4c38471be52d",
                                "sense_id": "9c934178-36b7-3a20-9999-f9244d6064e4",
                                "text": "Tristesse insondable des écoles et des cours de récréation vidées par les vacances de Noël. Comment vivre sans ces petits îlots de fraîcheur vivifiante, sans ces ballonnets d’oxygène qui font oublier quelques instants la pestilence de l’adultat ?"
                            },
                            {
                                "example_id": "c11a62da-7e49-4d16-b98c-ad73267daedf",
                                "sense_id": "9c934178-36b7-3a20-9999-f9244d6064e4",
                                "text": "Ne pas sortir de la « troupe », ne pas trahir la franc-maçonnerie juvénile, c'est se garantir contre l’affreuse déchéance de l'adultat."
                            }
                        ]
                    }
