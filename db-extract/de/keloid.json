                                        "glosses": [
                                            "Forme de cicatrice résultant d’une excroissance du derme au niveau d’une blessure guérie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06325e52-0d69-4db4-9fbb-0309daf60d31",
                                                "sense_id": "7d6fef7e-566e-31d8-8bd3-642d0cbe41d2",
                                                "text": "Nous avons vu disparaître par ce procédé des chéloïdes prépectorales qui avaient résisté pendant des années à tous les autres traitements."
                                            },
                                            {
                                                "example_id": "fd4f51ae-006e-4fed-b827-78e4a88c7e3f",
                                                "sense_id": "7d6fef7e-566e-31d8-8bd3-642d0cbe41d2",
                                                "text": "Au modèle subtil de ce masque tribal viennent se conjuguer les cicatrices chéloïdes, ndoma, caractéristiques de l'ethnie baoulé"
                                            }
                                        ]
                                    }
                                ]
                            }
