                        "sense_id": "7dd44a19-5db4-30a2-a19d-2a0174a5fc37",
                        "entry_id": "23c5a5e7-c35c-36e2-b37b-494f0f544560",
                        "glosses": [
                            "Qui est se rapporte à la Libye antique ou à ses habitants, les Libyens (Berbères)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073063bf-7d80-4780-b2ff-3fd581c32e5a",
                                "sense_id": "7dd44a19-5db4-30a2-a19d-2a0174a5fc37",
                                "text": "Écriture libyque."
                            },
                            {
                                "example_id": "f24df2a4-6f8d-427c-ac43-1acb97bfbabe",
                                "sense_id": "7dd44a19-5db4-30a2-a19d-2a0174a5fc37",
                                "text": "Populations libyques."
                            },
                            {
                                "example_id": "41920455-44f7-4e8f-8648-236d63a06dcc",
                                "sense_id": "7dd44a19-5db4-30a2-a19d-2a0174a5fc37",
                                "text": "Religion libyque."
                            },
                            {
                                "example_id": "65c46803-366c-4a7a-a748-6ec3c9111328",
                                "sense_id": "7dd44a19-5db4-30a2-a19d-2a0174a5fc37",
                                "text": "Montagnes libyques."
                            },
                            {
                                "example_id": "fbfc772e-6427-49e5-88ae-8670627957a8",
                                "sense_id": "7dd44a19-5db4-30a2-a19d-2a0174a5fc37",
                                "text": "Désert libyque."
                            },
                            {
                                "example_id": "0710ac44-08a6-487a-893e-7c7cbf53ce7f",
                                "sense_id": "7dd44a19-5db4-30a2-a19d-2a0174a5fc37",
                                "text": "En quittant la partie de la chaîne libyque où sont creusées ces grottes nombreuses, si l’on monte sur le sommet le plus élevé des rochers calcaires qui forment la vallée des tombeaux des rois, on domine sur toute la plaine de Thèbes et sur tout le désert montueux de la Libye."
                            },
                            {
                                "example_id": "cc935108-9f62-4da1-929e-7d6f3c1ad219",
                                "sense_id": "7dd44a19-5db4-30a2-a19d-2a0174a5fc37",
                                "text": "Au milieu de la chambre, dans cette atmosphère éblouissante, une forme humaine, énormément agrandie par la réfraction de la lentille — quelque chose comme un des sphinx du désert libyque, — était assise dans une immobilité de marbre."
                            }
                        ]
                    }
