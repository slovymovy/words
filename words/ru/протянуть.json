            "senses": [
                {
                    "sense_id": "34da3ff8-2b9a-3375-b9ca-7a1a5e6fbc9e",
                    "sense_definition": "Вытянуть руку или предмет в чью-либо сторону",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>протянул</w> руку, чтобы поздороваться с новым коллегой."
                        },
                        {
                            "text": "Мать <w>протянула</w> ребенку яблоко."
                        }
                    ],
                    "synonyms": [
                        "выдвинуть",
                        "преподнести"
                    ],
                    "common_phrases": [
                        "протянуть руку"
                    ]
                },
                {
                    "sense_id": "5c151fdb-7a1c-3b48-aa3a-2ee029b9ef98",
                    "sense_definition": "Проложить или провести что-либо на определенном расстоянии",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочие <w>протянули</w> новый кабель через весь дом."
                        },
                        {
                            "text": "В деревне <w>протянули</w> газовую трубу к каждому дому."
                        }
                    ],
                    "synonyms": [
                        "провести"
                    ],
                    "common_phrases": [
                        "протянуть кабель",
                        "протянуть линию"
                    ]
                },
                {
                    "sense_id": "559d9b48-3fe6-3246-bf1e-92f638c5892f",
                    "sense_definition": "Произносить слова медленно, растягивая звуки",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он задумчиво <w>протянул</w> ответ, глядя в окно."
                        },
                        {
                            "text": "Учитель <w>протянул</w> последнее слово, чтобы привлечь внимание класса."
                        }
                    ]
                },
                {
                    "sense_id": "d5ddeb3b-06d1-32b7-bb22-bdf16951ee2f",
                    "sense_definition": "Прожить или просуществовать какое-то время в трудных условиях",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "survival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый автомобиль без ремонта долго не <w>протянет</w>."
                        },
                        {
                            "text": "Больной <w>протянул</w> еще несколько дней благодаря лекарствам."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ]
                },
                {
                    "sense_id": "1bdab623-ec01-3677-af39-99aba22f1cea",
                    "sense_definition": "Затягивать выполнение дела, медлить",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит <w>протягивать</w> с ответом на важное письмо."
                        },
                        {
                            "text": "Они специально <w>протянули</w> с подписанием договора до конца месяца."
                        }
                    ]
                }
            ]
