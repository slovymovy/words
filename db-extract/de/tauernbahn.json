                        "glosses": [
                            "Bahnstrecke, die von Schwarzach-St. Veit nach Spittal-Millstättersee verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f70696de-6ddb-4679-b129-941ffcb8d7f6",
                                "sense_id": "95613ab0-d9a7-30ee-8544-93cd021ca80d",
                                "text": "„Um den Gesamtfahrplan möglichst pünktlich zu halten, müssen auf der Kärntner Seite der Tauernbahn zwischen Böckstein und Klagenfurt die Fahrpläne angepasst werden.“"
                            },
                            {
                                "example_id": "90cce39d-d343-4b25-91c5-0a44276e79c6",
                                "sense_id": "95613ab0-d9a7-30ee-8544-93cd021ca80d",
                                "text": "„Die Tauernbahn zwischen den Bahnhöfen Schwarzach/St. Veit und Böckstein wird ab Mittwoch wegen Bauarbeiten für drei Wochen - bis einschließlich 14. Mai - gesperrt.“"
                            }
