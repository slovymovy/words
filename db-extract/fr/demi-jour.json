        "fr-extract.jsonl": [
            {
                "entry_id": "a01bf33d-4f0a-3976-83ab-ca27960ff3ff",
                "word": "demi-jour",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5cafeaa6-6e3f-4f9e-ba20-c9310bf259c8",
                        "entry_id": "a01bf33d-4f0a-3976-83ab-ca27960ff3ff",
                        "tags": [
                            "plural"
                        ],
                        "form": "demi-jours"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8dc75cd8-ff45-33e9-92bd-c075aa5b9c05",
                        "entry_id": "a01bf33d-4f0a-3976-83ab-ca27960ff3ff",
                        "glosses": [
                            "Faible clarté, spécialement au début ou à la fin du jour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54388bc0-a390-4eca-94a7-d2b25de11802",
                                "sense_id": "8dc75cd8-ff45-33e9-92bd-c075aa5b9c05",
                                "text": "Elle se condamnait chez elle au demi-jour en faisant la malade afin de rester dans les teintes protectrices d’une lumière passée à la mousseline."
                            },
                            {
                                "example_id": "6bf22ca9-efd7-4aab-a1c2-3730da699b62",
                                "sense_id": "8dc75cd8-ff45-33e9-92bd-c075aa5b9c05",
                                "text": "Les bougie s’éteignaient. Un demi-jour rougeâtre tombant de haut ne formait plus qu’une sorte de brouillard lumineux, composé de la fine poussière odorante et des impalpables vapeurs du bal."
                            },
                            {
                                "example_id": "97ae1b00-8391-4fe0-ab24-d31e677468ae",
                                "sense_id": "8dc75cd8-ff45-33e9-92bd-c075aa5b9c05",
                                "text": "Ils avaient monté la côte dans le demi-jour, car Bert désirait aller aussi loin que possible avant d’allumer ses lanternes ou d’essayer de les allumer, car le résultat semblait douteux."
                            },
                            {
                                "example_id": "56395e4d-6f84-4039-a2f9-c785341379ae",
                                "sense_id": "8dc75cd8-ff45-33e9-92bd-c075aa5b9c05",
                                "text": "Un demi-jour de cave régnait dans la pièce aux volets clos et dans ces volets apparaissaient deux petits trous ronds très lumineux."
                            },
                            {
                                "example_id": "c249d8cd-d569-4404-9cdc-3edc1f17da23",
                                "sense_id": "8dc75cd8-ff45-33e9-92bd-c075aa5b9c05",
                                "text": "Nous avons encore une heure de jour et deux heures de demi-jour."
                            },
                            {
                                "example_id": "9f64ab8d-c4fc-4e27-93b3-9c36dd3140b2",
                                "sense_id": "8dc75cd8-ff45-33e9-92bd-c075aa5b9c05",
                                "text": "Dans l’appartement régnait un demi-jour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccd38010-ef22-4a0f-8c9a-9efe4c8ccdd2",
                        "source_entry_id": "a01bf33d-4f0a-3976-83ab-ca27960ff3ff",
                        "source_sense_id": "8dc75cd8-ff45-33e9-92bd-c075aa5b9c05",
                        "target_lang_word": "twilight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twilight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The soft light in the sky seen before the rising and (especially) after the setting of the sun, occasioned by the illumination of the earth’s atmosphere by the direct rays of the sun and their reflection on the earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139c654f-2701-43e8-b196-eb9ecdaefdf8",
                                                "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                                "text": "Near-synonym: half-light"
                                            },
                                            {
                                                "example_id": "9e841ad3-a0d3-4997-8e06-93b3e952020e",
                                                "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                                "text": "I could just make out her face in the twilight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The time when said light is visible; the period between daylight and darkness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8c779b-0bc2-4e22-8281-dc9676ab6da3",
                                                "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                                "text": "It was twilight by the time I got back home."
                                            },
                                            {
                                                "example_id": "e99ecff9-5aa3-43d4-b499-f5f9a4fb4378",
                                                "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f480d1-670b-3255-8edb-ccc82ad2dabb",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "Any faint light through which something is seen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399a1ac8-1115-4635-bb06-df847497f4f0",
                                                "sense_id": "b3f480d1-670b-3255-8edb-ccc82ad2dabb",
                                                "text": "Two women, Eusabio’s wife and sister, looked on from the deep twilight of the hut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af7fea1b-4fb8-3ce8-bf7c-201dde43ab51",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The time when the sun is less than 18° below the horizon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "An in-between or fading condition through which something is perceived."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89174f90-27e3-4411-bce4-b801125cf05f",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": "“They have not enough heart,” said Edith, with a smile. The very twilight of a smile: so singularly were its light and darkness blended."
                                            },
                                            {
                                                "example_id": "65f71247-2743-449d-9f57-000396575ad9",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": "The twilight of one's life"
                                            },
                                            {
                                                "example_id": "20609165-7131-49e6-88a1-0b45937db4a6",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": ", Book IV, Chapter XIV\nThe twilight […] of probability."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twilight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81688866-86b4-3777-91dd-4f9e828e0d3c",
