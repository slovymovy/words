                        "glosses": [
                            "нар.-поэт. ласк. к былинка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c642c6-31b7-4ee7-bfa0-677415eadb4b",
                                "sense_id": "d7c8d8ef-f47a-3dc6-b998-a7044395ea5b",
                                "text": "Не былинушка в чистом поле зашаталася, / Зашаталася бесприютная моя головушка, / Бесприютная моя головка молодецкая."
                            },
                            {
                                "example_id": "a00738a3-d6df-4a57-b394-1cdb06a3e2e2",
                                "sense_id": "d7c8d8ef-f47a-3dc6-b998-a7044395ea5b",
                                "text": "Ты, душа моя красна девица, / Иссушила ты добра молодца, / Как былинушку во чистом поле…"
                            }
                        ]
                    }
