                "senses": [
                    {
                        "sense_id": "763482e1-9810-3241-868f-be6355ebd99b",
                        "entry_id": "f18ca75d-2f23-328e-97a0-e1a1d7f012cc",
                        "glosses": [
                            "Something that devours or absorbs lots of money; something expensive."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b97412b5-78d9-4627-8307-99bf96ad7e60",
                                "sense_id": "763482e1-9810-3241-868f-be6355ebd99b",
                                "text": "For well London Lykke-peny for ones and eye, / For lake of money I may not spede."
                            },
                            {
                                "example_id": "bc0342ed-d1bf-4c9f-84a4-172003fd3093",
                                "sense_id": "763482e1-9810-3241-868f-be6355ebd99b",
                                "text": "[…] at Smyrna, you talked of a lawsuit—law is a lickpenny, Mr Tyrrel—no counsellor like the pound in purse."
                            }
                        ]
                    },
                    {
                        "sense_id": "716fa940-d077-3ad7-96b7-6f05105ae26f",
                        "entry_id": "f18ca75d-2f23-328e-97a0-e1a1d7f012cc",
                        "glosses": [
                            "A miserly person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e09d568-1c7b-4d3f-a7a9-e1693b67329e",
                                "sense_id": "716fa940-d077-3ad7-96b7-6f05105ae26f",
                                "text": "The Scotsmen, being lickpennies by nature, rode off without paying their bill!"
                            }
                        ]
                    }
                ],
