                "senses": [
                    {
                        "sense_id": "e59054bc-f3a7-310e-96f8-3232aa952339",
                        "entry_id": "7e722d45-7383-3491-bd7b-dbad27eae735",
                        "glosses": [
                            "Vente à trop bas prix."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1558d679-bcd8-4618-8dd7-37e354336336",
                                "sense_id": "e59054bc-f3a7-310e-96f8-3232aa952339",
                                "text": "Les vignerons, dans toute la France, particulièrement dans cinq départements, se plaignaient en 1906-1907 de ce qu'ils appelaient la mévente des vins […]. Les cours se trouvaient dépréciés par l'afflux non seulement des produits naturels mais des produits semi-naturels."
                            }
                        ]
                    },
                    {
                        "sense_id": "25cca134-2ef5-31c5-b2f6-884fa0f8335c",
                        "entry_id": "7e722d45-7383-3491-bd7b-dbad27eae735",
                        "glosses": [
                            "Non-vente, interruption, cessation, ralentissement de vente."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": [
                            {
                                "example_id": "fcef1438-b9fd-431e-ac1f-597a729ae948",
                                "sense_id": "25cca134-2ef5-31c5-b2f6-884fa0f8335c",
                                "text": "Nos magasins sont encombrés de marchandises par suite de mévente."
                            },
                            {
                                "example_id": "2b8d4b7a-412d-41e0-89aa-ff816769c865",
                                "sense_id": "25cca134-2ef5-31c5-b2f6-884fa0f8335c",
                                "text": "Une contrée ruinée par la mévente du café, du sucre, du caoutchouc."
                            }
                        ]
                    }
                ],
