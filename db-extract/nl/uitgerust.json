        "nl-extract.jsonl": [
            {
                "entry_id": "f91576a0-f564-3705-9c5a-6337a0f4901b",
                "word": "uitgerust",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1976f0dd-0334-3a7f-832a-cf873bee937c",
                        "entry_id": "f91576a0-f564-3705-9c5a-6337a0f4901b",
                        "glosses": [
                            "niet meer moe, met hernieuwde energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9031cf-aa89-4e9d-a6e0-ce0a3cb2af84",
                                "sense_id": "1976f0dd-0334-3a7f-832a-cf873bee937c",
                                "text": "Alsof hij zich verantwoordelijk voelde voor de hele schepping, verontschuldigde hij zich voor de argwaan in de moderne wereld, die hem ertoe verplichtte bepaalde formaliteiten in acht te nemen, maar hij verzekerde mij dat we daar later nog een geschikt moment voor konden vinden, wanneer ik zou zijn uitgerust van mijn verplaatsing."
                            },
                            {
                                "example_id": "2fbae6c9-73a0-48de-a19d-54a1517a55e1",
                                "sense_id": "1976f0dd-0334-3a7f-832a-cf873bee937c",
                                "text": "Ik zei er niets van, maar ik was er toch veel mee bezig, vooral als bekenden opeens helemaal uitgerust voor me opdoken en deden alsof er niks aan de hand was."
                            }
                        ]
                    },
                    {
                        "sense_id": "b66b6255-2fb5-3ee0-985c-40750b84748a",
                        "entry_id": "f91576a0-f564-3705-9c5a-6337a0f4901b",
                        "glosses": [
                            "van benodigdheden voorzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523746cc-dbd1-44b7-a819-145faf250faf",
                                "sense_id": "b66b6255-2fb5-3ee0-985c-40750b84748a",
                                "text": "En daar staan we weer voor de strijd uitgerust, dacht Albert, klaar om het schavot te beklimmen (zo werd de ladder genoemd die ze gewoonlijk gebruikten om de loopgraaf uit te komen, over perspectief gesproken) en dan met het hoofd vooruit op de vijandelijke linies af te stormen."
                            },
                            {
                                "example_id": "ed3ce4b7-a3fa-405b-bf2f-a738525a0422",
                                "sense_id": "b66b6255-2fb5-3ee0-985c-40750b84748a",
                                "text": "De broers hadden zich op identieke manier uitgerust toen ze na het ontbijt de schitterende winterdag in stapten."
                            },
                            {
                                "example_id": "6f7759f8-2ed4-4383-a007-9a5733e321e3",
                                "sense_id": "b66b6255-2fb5-3ee0-985c-40750b84748a",
                                "text": "De met kernwapens uitgeruste Tupolev 16 van de Sovjet-Unie zou een spitsroedeloop met achthonderd jachtvliegtuigen niet overleven wanneer ze Zweden probeerden aan te vallen."
                            }
                        ]
                    }
