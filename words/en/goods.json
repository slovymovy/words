                        "cs": [
                            {
                                "target_lang_word": "kompromitující materiály",
                                "target_lang_sense_clarification": "důkazy proti někomu"
                            },
                            {
                                "target_lang_word": "výsledky",
                                "target_lang_sense_clarification": "splnění očekávání (v idiomech)"
                            }
