                "senses": [
                    {
                        "sense_id": "a74be823-03c9-3578-946a-becb4d77b1b3",
                        "entry_id": "69be225c-c37e-3a08-b915-422e4513eb9f",
                        "glosses": [
                            "Außenseite eines Gebäudes aus Glas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95c7e2d-c22c-475c-b967-4a92185b9488",
                                "sense_id": "a74be823-03c9-3578-946a-becb4d77b1b3",
                                "text": "„Durch die Glasfront sah das Dorf finster und öde aus.“"
                            },
                            {
                                "example_id": "52429188-1201-410a-8eba-21ae7346b3a0",
                                "sense_id": "a74be823-03c9-3578-946a-becb4d77b1b3",
                                "text": "„Meine Mutter steht an der Glasfront, den Blick Richtung Startbahn, wo gerade ein Flugzeug abhebt.“"
                            },
                            {
                                "example_id": "fe028704-ec99-4d9c-9615-8b13d3359000",
                                "sense_id": "a74be823-03c9-3578-946a-becb4d77b1b3",
                                "text": "„Die Glasfronten des“ […] „Flughafens Berlin-Brandenburg (BER) sind bis heute ein Problem für Vögel. Hier verenden sie massenhaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
