                ],
                "senses": [
                    {
                        "sense_id": "a7e63ff3-1e0e-3bed-bdd3-4d6ec25b0485",
                        "entry_id": "65cca8fc-cf84-3313-8297-27f5750ccbad",
                        "glosses": [
                            "in Deutschland das Gericht zwischen Amtsgericht und Oberlandesgericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91546284-92bd-4636-8063-e55a6094e4b4",
                                "sense_id": "a7e63ff3-1e0e-3bed-bdd3-4d6ec25b0485",
                                "text": "Derzeit laufen beim Hamburger Landgericht 25 Verfahren von Bankkunden, die ihr Geld durch den Erwerb von Lehman-Zertifikaten verloren haben."
                            },
                            {
                                "example_id": "54712079-e65e-4669-8584-7f28f8f13dec",
                                "sense_id": "a7e63ff3-1e0e-3bed-bdd3-4d6ec25b0485",
                                "text": "„Das Stuttgarter Landgericht urteilt über einen Hochstapler, der es mit Hauptschulabschluss bis an den Operationstisch schaffte.“"
                            },
                            {
                                "example_id": "cd3a8457-79d1-4581-9d11-8f7ab3c7bb61",
                                "sense_id": "a7e63ff3-1e0e-3bed-bdd3-4d6ec25b0485",
                                "text": "„Wenn demnächst vor dem Landgericht im schwäbischen Ellwangen der Prozess beginnt, wird Serdal Ö. als Nebenkläger dabei sein.“"
                            },
                            {
                                "example_id": "d084a97b-d6fd-449f-b52a-60449330180b",
                                "sense_id": "a7e63ff3-1e0e-3bed-bdd3-4d6ec25b0485",
                                "text": "„Aber auch sonst ist der Prozess vor dem Landgericht in Braunschweig einer, der ein Leben und einen mörderischen Ausraster wie aus einer anderen Zeit, einer längst abgelebten Welt, zeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d5ba578f-86dd-3de3-be28-741426982597",
                        "entry_id": "65cca8fc-cf84-3313-8297-27f5750ccbad",
                        "glosses": [
                            "Gebäude, in dem sich ^([1]) befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08d5884d-bb81-4943-990e-88dfa344beb4",
                                "sense_id": "d5ba578f-86dd-3de3-be28-741426982597",
                                "text": "Bevor er das Landgericht betrat, richtet er seine Krawatte sowie seine Frisur und hielt für einen Moment seinen Atem an."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
