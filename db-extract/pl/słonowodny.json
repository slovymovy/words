                    },
                    {
                        "sense_id": "b91dc5ae-1e16-3dbd-9e4d-3600c572c63a",
                        "entry_id": "47804763-d2d0-3916-8d2a-5049f002d44a",
                        "glosses": [
                            "typowy dla wód morskich, żyjący w wodach morskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e6cdb8-9f31-4b71-9f44-98d032faf185",
                                "sense_id": "b91dc5ae-1e16-3dbd-9e4d-3600c572c63a",
                                "text": "Nieliczne zwierzęta słonowodne jak omułki, małgwie, chełbia, śledzie czy dorsze, żyjące w Bałtyku, są o połowę mniejsze niż w Morzu Północnym."
