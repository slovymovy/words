                    {
                        "sense_id": "41a760c8-ce42-3e81-aa8c-b71751989dc7",
                        "entry_id": "ddd51af6-10a7-353d-b115-dcbe6ffd8c50",
                        "glosses": [
                            "Être fabuleux doté d’une unique jambe, décrit par des historiens et des poètes de l’Antiquité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "933353a2-25c1-4765-a54a-331cf144fc55",
                                "sense_id": "41a760c8-ce42-3e81-aa8c-b71751989dc7",
                                "text": "Parmi les êtres légendaires dont l’art du moyen âge reproduisit la figure, on a souvent signalé le mystérieux sciapode, cet homme muni d’une jambe unique, terminé par un énorme pied, dont il se sert comme d’un abri contre les rayons du soleil."
                            },
                            {
                                "example_id": "8463f840-18fc-43a3-8e46-dc79986a0283",
                                "sense_id": "41a760c8-ce42-3e81-aa8c-b71751989dc7",
                                "text": "Le sciapode n’a qu’une jambe, mais cette jambe unique lui permet de courir avec une merveilleuse vitesse."
                            }
                        ]
                    }
                ],
