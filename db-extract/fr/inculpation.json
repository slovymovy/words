        "fr-extract.jsonl": [
            {
                "entry_id": "1004e7e7-be8f-3a9d-9d57-9a7dfce846a2",
                "word": "inculpation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "716d63c1-d807-4dd8-b0e9-c6dd6ede5671",
                        "entry_id": "1004e7e7-be8f-3a9d-9d57-9a7dfce846a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "inculpations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6188894e-8dde-3969-ac0d-0e846281e49a",
                        "entry_id": "1004e7e7-be8f-3a9d-9d57-9a7dfce846a2",
                        "glosses": [
                            "Action d’inculper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b934b503-f0b8-452d-a156-3d693b0854c0",
                                "sense_id": "6188894e-8dde-3969-ac0d-0e846281e49a",
                                "text": "Aujourd’hui les homélies misérables d’un vieillard cauteleux, ennemi de la République,[…],ont servit de prétexte à de nouvelles inculpations; […]."
                            },
                            {
                                "example_id": "c09b6e7b-7378-453f-90fc-880f1227bfa2",
                                "sense_id": "6188894e-8dde-3969-ac0d-0e846281e49a",
                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes. De là résulte qu’ils n’éprouvaient aucune pitié pour les généraux ou les fonctionnaires qu’ils voyaient guillotiner après quelque défaite, sous l’inculpation de manquement à leur devoir ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "61072118-ee11-3820-9287-cda26838b898",
                        "entry_id": "1004e7e7-be8f-3a9d-9d57-9a7dfce846a2",
                        "glosses": [
                            "Mise en examen (jusqu'en 1993)."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d57632f6-f4a1-48fa-87cd-49dd393c1a20",
                                "sense_id": "61072118-ee11-3820-9287-cda26838b898",
                                "text": "L’expression de « mise en examen » est apparue en 1993 (loi du 4 janvier) en remplacement du vocable napoléonien d’inculpation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd81f370-e852-47cf-bc5b-0c094f80e946",
                        "source_entry_id": "1004e7e7-be8f-3a9d-9d57-9a7dfce846a2",
                        "target_lang_word": "Anklage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anklage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f6421b8-2906-3ec8-b3fe-89e8cb795d6a",
                                        "entry_id": "ae645c71-f929-3f06-968c-1ebcd8698198",
                                        "glosses": [
                                            "Antrag auf Strafverfolgung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f06cfae0-abe2-4a1c-9dc2-dd956d0b6f3f",
                                                "sense_id": "3f6421b8-2906-3ec8-b3fe-89e8cb795d6a",
                                                "text": "Die Staatsanwaltschaft erhebt nun Anklage wegen Nötigung."
                                            },
                                            {
                                                "example_id": "fab72c80-f2cc-4abc-99a8-ed9a69ea5241",
                                                "sense_id": "3f6421b8-2906-3ec8-b3fe-89e8cb795d6a",
                                                "text": "Trotz der vielen Tatverdächtigen kam es nur in zwei Fällen zu Anklagen."
                                            },
                                            {
                                                "example_id": "f54c02cd-e47a-4dc1-8d71-55f54c2a1f4f",
                                                "sense_id": "3f6421b8-2906-3ec8-b3fe-89e8cb795d6a",
                                                "text": "„Helena ließ sich nicht entmutigen, sie behauptete weiterhin, Sarale sei eine wichtige Zeugin der Anklage.“"
                                            },
                                            {
                                                "example_id": "84934487-3b31-45f8-9985-ecf16aba4294",
                                                "sense_id": "3f6421b8-2906-3ec8-b3fe-89e8cb795d6a",
                                                "text": "„Es gab Hausdurchsuchungen und Anklagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e90568dc-d8f4-3abf-aaeb-d04dac5bc44a",
                                        "entry_id": "ae645c71-f929-3f06-968c-1ebcd8698198",
                                        "glosses": [
                                            "Beschuldigung einer Person, etwas Schlimmes getan zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81273111-b5c8-43cf-a194-9ab83d90c0a4",
                                                "sense_id": "e90568dc-d8f4-3abf-aaeb-d04dac5bc44a",
                                                "text": "In seinem Buch formuliert er eine bittere Anklage gegen die öffentlich rechtlichen Sendeanstalten."
                                            },
                                            {
                                                "example_id": "2980b751-1ebf-4078-8f80-65f513152880",
                                                "sense_id": "e90568dc-d8f4-3abf-aaeb-d04dac5bc44a",
                                                "text": "„Es ist eine Anklage, eine Abrechnung mit Kolonialismus und Rassismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
