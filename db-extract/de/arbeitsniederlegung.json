                "senses": [
                    {
                        "sense_id": "508dd887-d7dc-3702-a7db-a5a41045c45e",
                        "entry_id": "68a63adc-4248-3b62-ae44-b89960a21b13",
                        "glosses": [
                            "an instance of organised stoppage of work",
                            "a strike"
                        ],
                        "tags": [
                            "feminine",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2e8d6f24-bff3-45f4-b59f-1a0579609593",
                                "sense_id": "508dd887-d7dc-3702-a7db-a5a41045c45e",
                                "text": "Die aktuellen Arbeitsniederlegungen im öffentlichen Dienst werden vom Gericht auf ihre Zulässigkeit geprüft.",
                                "translation": "The court will investigate the lawfulness of the current strikes in the public sector.",
                                "english": "The court will investigate the lawfulness of the current strikes in the public sector."
                            }
                        ]
                    },
                    {
                        "sense_id": "970fc5e9-8720-309d-acc6-05ad6169229b",
                        "entry_id": "68a63adc-4248-3b62-ae44-b89960a21b13",
                        "glosses": [
                            "an instance of organised stoppage of work",
                            "an interruption of work in order to pay respect, commemorate, celebrate, etc."
                        ],
                        "tags": [
                            "feminine",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "5b07c6ea-3004-4862-a0f8-d9776389b47d",
                                "sense_id": "970fc5e9-8720-309d-acc6-05ad6169229b",
                                "text": "Mit Arbeitsniederlegung und Schweigeminuten gedenkt das Volk jährlich seiner Gefallenen.",
                                "translation": "Every year, the people commemorate their fallen with work stoppage and moments of silence.",
                                "english": "Every year, the people commemorate their fallen with work stoppage and moments of silence."
                            }
                        ]
                    }
                ],
