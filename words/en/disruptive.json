{
    "word_family": [
        "disrupt",
        "disruption",
        "disruptor",
        "disruptively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b9c9d047-a380-3f6a-93c7-36e304a6859f",
                    "sense_definition": "Causing trouble, confusion, or interruption, preventing something from continuing smoothly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children who exhibit <w>disruptive</w> behaviour may be suspended from school.",
                            "target_lang_translations": {
                                "ru": "Детей, проявляющих <w>деструктивное</w> поведение, могут временно отстранить от занятий в школе."
                            }
                        },
                        {
                            "text": "The protest was highly <w>disruptive</w> to the evening commuter traffic.",
                            "target_lang_translations": {
                                "ru": "Протест сильно <w>парализовал</w> вечернее пригородное движение."
                            }
                        }
                    ],
                    "synonyms": [
                        "troublesome",
                        "unruly",
                        "distracting"
                    ],
                    "antonyms": [
                        "non-disruptive",
                        "nondisruptive"
                    ],
                    "common_phrases": [
                        "disruptive behaviour",
                        "disruptive influence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий помехи, беспорядок или сбои; нарушающий нормальный ход событий или порядок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деструктивный",
                                "target_lang_sense_clarification": "нарушающий нормальное функционирование или дисциплину"
                            },
                            {
                                "target_lang_word": "нарушающий порядок",
                                "target_lang_sense_clarification": "мешающий работе, учебному процессу или поведению"
                            },
                            {
                                "target_lang_word": "подрывной",
                                "target_lang_sense_clarification": "подрывающий устои или стабильность"
                            },
                            {
                                "target_lang_word": "разрушительный",
                                "target_lang_sense_clarification": "несущий сильное расстройство или разрушение планов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a85d49a5-2a11-358f-80c0-4c54eb4f7175",
                    "sense_definition": "Relating to an innovation or technology that completely replaces an existing industry, product, or way of doing business.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smartphones proved to be a <w>disruptive</w> technology for the traditional camera industry.",
                            "target_lang_translations": {
                                "ru": "Смартфоны оказались <w>прорывной</w> технологией для традиционной индустрии фотоаппаратов."
                            }
                        },
                        {
                            "text": "Many startups aim to create <w>disruptive</w> business models to challenge existing market leaders.",
                            "target_lang_translations": {
                                "ru": "Многие стартапы стремятся создавать <w>подрывные</w> бизнес-модели, чтобы бросить вызов существующим лидерам рынка."
                            }
                        }
                    ],
                    "synonyms": [
                        "revolutionary",
                        "game-changing"
                    ],
                    "common_phrases": [
                        "disruptive innovation",
                        "disruptive technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к инновациям или технологиям, которые кардинально меняют и преобразуют существующий рынок или бизнес-модель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорывной",
                                "target_lang_sense_clarification": "о технологиях и инновациях, меняющих правила игры"
                            },
                            {
                                "target_lang_word": "подрывной",
                                "target_lang_sense_clarification": "калька от 'disruptive' в контексте подрывных инноваций"
                            },
                            {
                                "target_lang_word": "революционный",
                                "target_lang_sense_clarification": "коренным образом меняющий индустрию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}