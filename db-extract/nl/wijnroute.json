                        "examples": [
                            {
                                "example_id": "591861f3-b2b9-41e4-b58e-0ef73ba3c9aa",
                                "sense_id": "1aa8fb6a-9d0b-3603-be28-8ebb2aa71bf5",
                                "text": "Een wijnroute met de grootste ondergrondse wijnopslag ter wereld, een culturele- en historische route, een culinaire route met traditionele gerechten en traditionele volksdans. Dit zijn enkele hoogtepunten waarmee Moldavië de Nederlandse toerist probeert te lokken."
                            },
                            {
                                "example_id": "d1d1ed4d-705b-47c7-ba05-f24462e6839d",
                                "sense_id": "1aa8fb6a-9d0b-3603-be28-8ebb2aa71bf5",
                                "text": "Hoewel Luxemburg een van de kleinste landen van Europa is, heeft het een omvangrijk fietsroutenetwerk. Maar liefst 23 routes, met een gezamenlijke lengte van ruim 600 kilometer, tonen de hoogtepunten van het ministaatje. Behalve deze tochten biedt het land themaroutes, zoals een wijnroute en een bioroute. Voordeel voor de fietser is dat de routes gevrijwaard zijn van autoverkeer."
                            }
                        ]
                    }
