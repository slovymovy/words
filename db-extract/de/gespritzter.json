                "senses": [
                    {
                        "sense_id": "a86022b1-be09-3b6a-ad2d-ef723961ccf4",
                        "entry_id": "38432389-b181-3649-b2ce-e691216010d8",
                        "glosses": [
                            "Wein, der mit Wasser (Mineralwasser, Sodawasser/Sprudelwasser) verdünnt wurde"
                        ],
                        "tags": [
                            "Bavarian",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "40df2552-e957-454b-9b3b-fa85b93b606a",
                                "sense_id": "a86022b1-be09-3b6a-ad2d-ef723961ccf4",
                                "text": "„Nicht weniger als zehn Halbe Bier und zehn Gespritzte tankte ein 42-jähriger Angestellter in einem Linzer Lokal, bevor er sich in sein Auto setzte und losbrauste.“"
                            },
                            {
                                "example_id": "31e4b823-889e-4cec-8d3f-bd84a6d8219b",
                                "sense_id": "a86022b1-be09-3b6a-ad2d-ef723961ccf4",
                                "text": "„Die Kultur-für-alle-Konservierung vollzieht sich heute in ununterbrochenen Straßenfesten mit Crevettchen, Gespritztem und Wok.“"
                            },
                            {
                                "example_id": "bfca1ea1-5c3d-40ff-900d-fee3da4486d1",
                                "sense_id": "a86022b1-be09-3b6a-ad2d-ef723961ccf4",
                                "text": "„Später setzte sich Elsas Mann mit einem Gespritzten zu ihr. […] Er klopfte mit den Handknöcheln auf den Tisch, schüttete den Gespritzten wie Selters hinunter und bestellte gleich noch einen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
