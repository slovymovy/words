{
    "word_family": [
        "wrap",
        "wrapper",
        "unwrap"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "619c591d-33b8-3600-9f4a-dcc45806c7af",
                    "sense_definition": "The material in which something is wrapped.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully removed the decorative <w>wrapping</w> from the birthday gift.",
                            "target_lang_translations": {
                                "ru": "Она аккуратно сняла праздничную <w>обёртку</w> с подарка на день рождения."
                            }
                        },
                        {
                            "text": "Plastic <w>wrapping</w> is used to keep food fresh for longer periods.",
                            "target_lang_translations": {
                                "ru": "Пластиковая <w>упаковка</w> используется для более длительного сохранения свежести продуктов."
                            }
                        }
                    ],
                    "synonyms": [
                        "casing",
                        "packaging"
                    ],
                    "common_phrases": [
                        "plastic wrapping",
                        "gift wrapping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал, бумага или пленка, используемые для упаковывания или заворачивания предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обёртка",
                                "target_lang_sense_clarification": "бумага или пленка, покрывающая предмет"
                            },
                            {
                                "target_lang_word": "упаковка",
                                "target_lang_sense_clarification": "материал для упаковывания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b529905-63b9-38bd-9f30-33dd3f541a28",
                    "sense_definition": "The automatic breaking of lines of text to fit within the width of a display area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Enabling word <w>wrapping</w> makes reading long paragraphs much easier on a small screen.",
                            "target_lang_translations": {
                                "ru": "Включение <w>переноса</w> слов делает чтение длинных абзацев на маленьком экране гораздо удобнее."
                            }
                        },
                        {
                            "text": "The text editor handles <w>wrapping</w> automatically according to window size.",
                            "target_lang_translations": {
                                "ru": "Текстовый редактор выполняет <w>перенос строк</w> автоматически в зависимости от размера окна."
                            }
                        }
                    ],
                    "synonyms": [
                        "line breaking",
                        "line wrapping",
                        "text wrapping",
                        "word wrapping"
                    ],
                    "common_phrases": [
                        "text wrapping",
                        "word wrapping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Автоматический перенос строк текста по ширине области отображения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перенос строк",
                                "target_lang_sense_clarification": "в компьютерных программах и верстке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b79f7688-eb8f-3012-a8d7-f4c9e0a1cca6",
                    "sense_definition": "Present participle and gerund of <w>wrap</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole evening <w>wrapping</w> Christmas presents for his children.",
                            "target_lang_translations": {
                                "ru": "Он провёл весь вечер, <w>упаковывая</w> рождественские подарки для своих детей."
                            }
                        },
                        {
                            "text": "She was <w>wrapping</w> a warm scarf around her neck before going outside.",
                            "target_lang_translations": {
                                "ru": "Она <w>обматывала</w> тёплый шарф вокруг шеи перед выходом на улицу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrapping a present",
                        "wrapping up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по значению глагола wrap: заворачивать, упаковывать, обматывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заворачивание",
                                "target_lang_sense_clarification": "процесс оборачивания чего-либо"
                            },
                            {
                                "target_lang_word": "упаковывание",
                                "target_lang_sense_clarification": "процесс помещения в упаковку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}