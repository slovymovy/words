                        "zh": "为娱乐目的而举行的聚会，通常由俱乐部或团体组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечери́нка",
                                "target_lang_sense_clarification": "развлекательное мероприятие"
                            },
                            {
                                "target_lang_word": "встре́ча",
                                "target_lang_sense_clarification": "собрание группы людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社交聚会",
                                "target_lang_sense_clarification": "正式或非正式的联谊活动"
