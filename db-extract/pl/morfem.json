                "senses": [
                    {
                        "sense_id": "ffe716d5-363b-3504-94b1-19ee27e07578",
                        "entry_id": "106a4240-e4a4-3a2d-a919-0c790abdef88",
                        "glosses": [
                            "Morphem"
                        ],
                        "tags": [],
