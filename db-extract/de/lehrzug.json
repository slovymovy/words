                ],
                "senses": [
                    {
                        "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                        "entry_id": "2f97a458-be15-37a1-867f-707074ee811c",
                        "glosses": [
                            "(zu) unterweisende Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50547c7b-d78d-436f-812e-4c871b5e7499",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Im Jahre 1961 wären also an den Ingenieurschulen etwa 41 Lehrzüge erforderlich.“"
                            },
                            {
                                "example_id": "78b3301b-06e7-4040-9f9a-55eab3027b56",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Dem Leiter des Schulstabes, der die Stabsarbeit koordiniert, ist die Luftwaffenunterstützungskompanie Fürstenfeldbruck (LwUstgKp FFB) mit dem Lehrzug unterstellt, die Aufgaben für alle am Standort Fürstenfeldbruck stationierten Dienststellen wahrnimmt.“"
                            },
                            {
                                "example_id": "a241820d-7a82-4433-9f48-cd0f4d534cec",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Als Teil des vierten Lehrzuges der Bundesoberrealschule lagen unsere Unterrichtsstätten im Turm der Burg zu Wiener Neustadt – im Rakoczyturm.“"
                            },
                            {
                                "example_id": "793e829b-9acd-4a63-b6c0-7c48b9b65892",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Verwendungen der Funktionsgruppe 6 sind zB: […] Kommandant des Lehrzuges Alpin der Jägerschule.“"
                            },
                            {
                                "example_id": "5c08130c-da20-4f33-a713-998585e5154f",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Alle neuen kamen für die Grundausbildung in einen Lehrzug.“"
                            },
                            {
                                "example_id": "d7d9de11-ec21-4380-929a-bf070a47ad24",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Die Lehrzüge der Bundesbahndirektion Essen, Hannover, Köln, München und Stuttgart dienen der Heranbildung von Gieisbauern und von Werkführern (Bau), während in dem Lehrzug der Bundesbahndirektion Kassel fast ausschließlich bautechnische Bb-Inspektoren-Anwärter […]“"
                            },
                            {
                                "example_id": "49e5d968-531e-4bf4-8134-9563d979c375",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Der erste Lehrzug wurde im Spätsommer 1952 angeschafft.“"
                            },
                            {
                                "example_id": "660c8e90-dccc-462d-b4da-fe59f6a4cac8",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Hier sei nur erwähnt, daß der Lehrzug der Landwirtschaftsausstellung in Schönhausen mit einer Sonderschau Aufstellung genommen hatte und die Abende der beiden Tage mit einem FDJ-Forum und einer Kulturveranstaltung gefüllt waren.“"
                            },
                            {
                                "example_id": "a5290a9a-8cfa-4ed3-9faf-ee4b844baef4",
                                "sense_id": "ec0aac48-f7cc-3072-97b2-1e079d8f8ed0",
                                "text": "„Die schnelle Anwendung der neuesten Ergebnisse der Wissenschaft und Praxis unterstützen auch die Lehrzüge und Wanderausstellungen der Landwirtschaftsausstellung der DDR.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
