                                        "entry_id": "dd4111d8-23cf-3b72-8315-1a468e69f853",
                                        "glosses": [
                                            "uitscheidingsproduct van bevers uit een klier tussen de anus en geslachtsorganen waarin castoreum wordt gevormd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebd3ecb-c422-4c0a-813f-4d04dd66f3cc",
                                                "sense_id": "d02a65cf-f44f-3010-a858-d79e90ac675e",
                                                "text": "Bevergeil, door Bilderdijk in De ziekte der geleerden (1807) nog aanbevolen tegen kramp, wordt tegenwoordig alleen nog gebruikt in de parfumindustrie"
                                            }
                                        ]
                                    }
                                ]
