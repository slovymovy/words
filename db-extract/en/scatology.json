                    {
                        "translation_id": "8f4aed79-6e4f-453e-9824-f6a9b8a11a85",
                        "source_entry_id": "3f2c4b0e-7490-3e43-ada2-f591f9a29dfa",
                        "source_sense_description": "filthy epithet",
                        "target_lang_word": "Fäkalsprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fäkalsprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8796ab2-655d-3d66-b779-97df5ecb3683",
                                        "entry_id": "d3c0acaa-d51e-33b9-a13e-4b835bac5d6c",
                                        "glosses": [
                                            "Ausdrucksweise, bei der gehäuft Wörter aus dem Fäkalbereich verwendet werden, also Wörter, die die Ausscheidungen von Blase und Darm bezeichnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf958067-86b0-43dd-8304-6597e56770c2",
                                                "sense_id": "d8796ab2-655d-3d66-b779-97df5ecb3683",
                                                "text": "„Statt das Kind ständig zu ermahnen, sollten Eltern die Fäkalsprache besser ignorieren – oder ab und zu einen ruhigen Hinweis dazu geben.“"
                                            },
                                            {
                                                "example_id": "9f0b323e-ca6a-4380-b1aa-b54415dd57a5",
                                                "sense_id": "d8796ab2-655d-3d66-b779-97df5ecb3683",
                                                "text": "Zum berühmten Götz-Zitat: „Gerade in gereizter Stimmung, etwa bei Auseinandersetzungen mit dem Hauswirt, kann es einem nach Auffassung des Nürnberger Amtsgerichts schon mal rausrutschen, weil »zunehmend Ausdrücke der Fäkalsprache in den allgemeinen Sprachgebrauch, insbesondere auch bei Theater, Film und Fernsehen sowie in der Literatur Einzug gehalten« haben (AZ 26 C 4676/93).“"
                                            },
                                            {
                                                "example_id": "4eadba0f-6815-4530-b258-c8ff42e3fb49",
                                                "sense_id": "d8796ab2-655d-3d66-b779-97df5ecb3683",
                                                "text": "„Erlaubt die Enthemmung der Namenlosen, ihre Fäkalsprache und ihr Sexismus, einen unverstellten Blick in die Abgründe des kollektiven Unbewussten?“"
                                            },
                                            {
                                                "example_id": "dad1feb6-2ff9-4b66-b762-91275d06692d",
                                                "sense_id": "d8796ab2-655d-3d66-b779-97df5ecb3683",
                                                "text": "„Frappierend war etwa die unglaublich große Vielfalt im Bereich der Sexual- und Fäkalsprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
