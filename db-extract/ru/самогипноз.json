                                    {
                                        "sense_id": "65d88df9-f7e8-36e2-99de-81bdefbe1004",
                                        "entry_id": "56d7f807-647d-305f-b64c-e585f3759666",
                                        "glosses": [
                                            "Hypnose, die durch Autosuggestion herbeigeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbaa8659-4bd8-4364-b87b-72f1269afade",
                                                "sense_id": "65d88df9-f7e8-36e2-99de-81bdefbe1004",
                                                "text": "„Als [Josef] Breuer sie [Anna O.] bei seinen ärztlichen Besuchen mehrfach in einer Art Autohypnose antraf, erkannte er, daß sie sich in diesen ›Absencen‹ jeweils intensiv mit einem bestimmten, offenbar sehr privaten Thema beschäftigte, und gab ihr daraufhin gezielt Stichworte, die sie zur Offenlegung ihrer geheimen Gedanken veranlaßten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83e39381-34ad-43bb-b255-419430a7693a",
                        "source_entry_id": "04cac878-7531-3830-b188-c6f896cb8b65",
                        "source_sense_id": "f3f0743e-3a8c-3e03-ae0b-ba5e1b75af7c",
                        "target_lang_word": "Selbsthypnose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbsthypnose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb59783-b905-3bff-8506-c40b04dc2172",
                                        "entry_id": "4645e131-d2a1-3dce-90bb-a90229ca8421",
                                        "glosses": [
                                            "selber herbeigeführter hypnotischer Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d25ace99-ba6f-495c-91b1-aae563950283",
                                                "sense_id": "ebb59783-b905-3bff-8506-c40b04dc2172",
                                                "text": "„Man hätte sich vorstellen können, der Patient sei durch eine obskure Art der Selbsthypnose in ein früheres Zeitalter transferiert worden.“"
                                            },
                                            {
                                                "example_id": "b60d880a-b0f6-4f11-acd6-3df8c5f05183",
                                                "sense_id": "ebb59783-b905-3bff-8506-c40b04dc2172",
                                                "text": "„Vielleicht hatten die Skeptiker Recht, und wir selbst waren die Opfer einer seltsamen Illusion? Selbsthypnose?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a781e8e-195b-46de-8ce6-d3997ecf54af",
                        "source_entry_id": "04cac878-7531-3830-b188-c6f896cb8b65",
