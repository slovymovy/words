                    {
                        "sense_id": "c1ccd01e-a4c9-3941-88b0-5e7208875687",
                        "entry_id": "665f6ff2-f471-3bea-b602-da5f3d592feb",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord gast"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "34a450d2-2b59-448c-b08a-31425b35dae7",
                                "sense_id": "c1ccd01e-a4c9-3941-88b0-5e7208875687",
                                "text": "‘Hebben mijn gasten zin in een pot thee?’ Thea zegt niets."
                            },
                            {
                                "example_id": "634407eb-1391-4e1a-99ef-5f33d6c8bf58",
                                "sense_id": "c1ccd01e-a4c9-3941-88b0-5e7208875687",
                                "text": "Als het een avond in november was geweest, waren ze gewoon naar bed gegaan zodra de laatste gasten waren vertrokken. Maar deze witte juninachten waren, volgens Ingeborg, onmogelijk te weerstaan, hoe moe je ook was."
                            },
                            {
                                "example_id": "29f6b92d-66e1-4871-90de-30e565f4b026",
                                "sense_id": "c1ccd01e-a4c9-3941-88b0-5e7208875687",
                                "text": "Denemarken ook nauwelijks, in de pers hadden ze het uitgebreid gehad over de gemoedelijke verhouding tussen de Deense bevolking en de Duitse gasten. De koning en de regering van Denemarken zaten nog op hun plaats en de samenwerking leek uitstekend te functioneren binnen de Germaanse verbroedering."
                            }
                        ]
