                        "examples": [
                            {
                                "example_id": "138291a8-c809-4a68-856d-c6d885f69d17",
                                "sense_id": "b17f684b-8d4b-38af-901b-fae73320bdff",
                                "text": "Op de lage salontafel zette Quispel alles voor het bezoek klaar. Kopjes, suikerpot, cake, schaaltje bonbons... Het leek verdomme wel of hij een kinderpartijtje gaf."
                            },
                            {
                                "example_id": "96c163ab-41f1-4cb3-ba35-beafeeeb4681",
                                "sense_id": "b17f684b-8d4b-38af-901b-fae73320bdff",
                                "text": "Staatssecretaris Dijkhoff maakt zich zorgen over arcadehallen onder de naam 'Gamestate'. Daar kan gespeeld worden op allerlei soorten automaten. Er kunnen tickets mee worden gewonnen die kunnen worden ingewisseld voor speelgoed en elektronica. Volgens de site van Gamestate lenen de filialen zich uitstekend voor een kinderpartijtje."
                            }
                        ]
