                "senses": [
                    {
                        "sense_id": "a610954c-218e-3c68-87fa-21b3218bdf4a",
                        "entry_id": "b9793376-c660-3fe5-b21e-7d755c4b8ab9",
                        "glosses": [
                            "Relatif aux bronches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8919761b-8364-4c7f-9488-5cb8ae7f4e99",
                                "sense_id": "a610954c-218e-3c68-87fa-21b3218bdf4a",
                                "text": "Ce fait permet de prévoir l'utilité du spirophore pour combattre l'asphyxie due à l'abondance de mucosités bronchiques."
                            },
                            {
                                "example_id": "6a8a0fb1-7bc0-48eb-a6cf-25f605be963b",
                                "sense_id": "a610954c-218e-3c68-87fa-21b3218bdf4a",
                                "text": "Seize jours après l'injection, les ganglions prépectoraux sont encore les seuls où le carmin soit visible à l'œil nu, mais on le retrouve, au microscope, dans les ganglions œsophagiens et bronchiques."
                            },
                            {
                                "example_id": "371c959c-f53d-4cff-b996-b24f7a74418e",
                                "sense_id": "a610954c-218e-3c68-87fa-21b3218bdf4a",
                                "text": "Le jour de Noël, j’avais cru mourir de cette infection bronchique qui m’étouffait. À Dieulefit, on pouvait en guérir."
                            }
                        ]
                    }
                ],
