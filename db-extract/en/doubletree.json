                                                "example_id": "fcd85f24-9e21-446e-8af6-94fb197bcdd1",
                                                "sense_id": "87f6d904-6cd4-368d-b9de-ddf544761517",
                                                "text": "„Wie kann eine Waage überhaupt bestimmen, ob das auf ihr lastende Gewicht von kräftigen Muskeln oder schwabbelndem Fett rührt?“"
                                            }
                                        ],
