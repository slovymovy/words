                    {
                        "translation_id": "d5981ca0-c500-46b1-9098-d52f2cec7155",
                        "source_entry_id": "43fc55fd-077c-35d9-bec7-d6c309a7da13",
                        "source_sense_id": "684304c4-d2b1-34b6-92f9-3d4e3f32dc1c",
                        "target_lang_word": "Philatelie",
                        "target_lang_code": "de",
