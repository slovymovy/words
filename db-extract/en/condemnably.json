                        "glosses": [
                            "In a condemnable manner."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8499d30c-e530-4820-ac75-65f744b47748",
                                "sense_id": "25d1e1ff-3f29-3f7c-9891-6615eb741f8d",
                                "text": "[…] yet if they be not guilty of gross faileur of Duty in Mind, Will and Meaning, they are so far from being villainous, wicked, nefarious and condemnably Criminal, that they are highly commendable for their unstain'd Integrity and Faithfulness."
                            },
                            {
                                "example_id": "5dd41730-f2a0-4c03-84c8-f34e38a8f8cd",
                                "sense_id": "25d1e1ff-3f29-3f7c-9891-6615eb741f8d",
                                "text": "While in most departments of conduct there is a wide neutral ground between the right and the condemnably wrong, there are matters of business in which there seems to be no such intermediate territory, but in, which what is fair, honorable, and even necessary, is closely contiguous to dishonesty."
                            },
                            {
                                "example_id": "065fb4fd-099c-45fb-9e92-1dda0729ad66",
                                "sense_id": "25d1e1ff-3f29-3f7c-9891-6615eb741f8d",
                                "text": "But just because the court freed them was not reason enough for the police to close the case file as lamentably and condemnably as they did."
                            }
                        ]
                    }
