                ],
                "senses": [
                    {
                        "sense_id": "e80ceb1b-8f6c-366f-9398-9d3cb634a483",
                        "entry_id": "71fe3297-e141-324d-94dd-403f606a6763",
                        "glosses": [
                            "Faire perdre son caractère de fiction à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "927d911e-c630-4932-a751-d45096c0b3f3",
                                "sense_id": "e80ceb1b-8f6c-366f-9398-9d3cb634a483",
                                "text": "Les tentatives pour « défictionaliser » le spectacle, depuis Brecht notamment, sont plus avancées au théâtre qu’au cinéma, et non par hasard."
                            },
                            {
                                "example_id": "d4550ed0-126f-4c76-b336-cfec8e1dcf19",
                                "sense_id": "e80ceb1b-8f6c-366f-9398-9d3cb634a483",
                                "text": "Pire, la tendance serait plutôt inverse et consisterait à mettre l’accent sur le sérieux des œuvres d’imagination, autrement dit à « défictionaliser » la fiction en tant que le récit d’invention chercherait aussi à dire le vrai."
                            },
                            {
                                "example_id": "1450a4a3-4c73-4a4c-b528-0e6030db1406",
                                "sense_id": "e80ceb1b-8f6c-366f-9398-9d3cb634a483",
                                "text": "Les tentatives de certains auteurs contemporains de « défictionaliser » la littérature ont-elles échoué ?"
                            }
                        ]
                    }
                ],
