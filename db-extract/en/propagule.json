                                    },
                                    {
                                        "sense_id": "bcc07251-46dc-3e5b-9ba0-64840d292fd0",
                                        "entry_id": "61e3855a-82be-30e1-ae44-0dd3f26d83c5",
                                        "glosses": [
                                            "Tissu ou fragment tissulaire caduc qui assure la propagation végétative chez les plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f0f5581-0e54-4700-a55c-652324500ff9",
                                                "sense_id": "bcc07251-46dc-3e5b-9ba0-64840d292fd0",
                                                "text": "Six millions de propagules de palétuviers ont été plantées en Casamance pour la recréation des mangroves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9371e59-f20d-3876-be0b-f92a14ec0af1",
                                        "entry_id": "61e3855a-82be-30e1-ae44-0dd3f26d83c5",
                                        "glosses": [
                                            "Toute partie de la plante qui sert à la propagation de l'espèce : spore, graine, prothalle, drageon, etc → voir diaspore."
                                        ],
