                        "cross_references": [
                            {
                                "target_word": "pascalization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28d08532-cb9b-3c98-b354-d9ed3942806b",
                                        "entry_id": "fb05ce2a-76d4-3fef-950b-ed8ed9297888",
                                        "glosses": [
                                            "A method of preserving and sterilizing food through the use of high pressure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb9b8dca-2bec-4b01-ba9d-ac31e232843f",
                                                "sense_id": "28d08532-cb9b-3c98-b354-d9ed3942806b",
                                                "text": "High isostatic pressure processing has been termed \"pascalization\" because it follows Pascal's principle. High isostatic pressure is instantaneously and uniformly transmitted throughout the pressure medium and the food product."
                                            },
                                            {
                                                "example_id": "914299bb-70b7-42b6-b021-f4591722d689",
                                                "sense_id": "28d08532-cb9b-3c98-b354-d9ed3942806b",
                                                "text": "It is also termed as hyperbaric pressure processing or ultra-high pressure or high-pressure processing (HPP) or pascalization. In HPP, a food is subjected to high-pressure in the range of 100 to 1000 MPa with or without heat in which pressure is instantaneousy and uniformly transmitted throughout the product irrespective of its size and geometry."
                                            },
                                            {
                                                "example_id": "66e67411-0b9c-4f64-a347-25cc89fda20d",
                                                "sense_id": "28d08532-cb9b-3c98-b354-d9ed3942806b",
                                                "text": "This type of high pressure applied at moderate temperatures is sometimes called pascalization because of its correlation with pasteurization (application of high temperatures at atmospheric pressure)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
