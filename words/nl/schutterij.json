            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52dba38b-0585-39a5-a29e-f7993096cc97",
                    "sense_definition": "Een historische gewapende burgerwacht die tot het begin van de twintigste eeuw in Nederlandse steden bestond om de orde te handhaven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burgerwacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zeventiende eeuw speelde de lokale <w>schutterij</w> een belangrijke rol bij de verdediging van de stad.",
                            "target_lang_translations": {
                                "en": "In the seventeenth century, the local <w>civic guard</w> played an important role in the defense of the city."
                            }
                        },
                        {
                            "text": "De officieren van de <w>schutterij</w> lieten zich vaak op een groepsportret vereeuwigen.",
                            "target_lang_translations": {
                                "en": "The officers of the <w>civic guard</w> often had themselves immortalized in a group portrait."
                            }
                        }
                    ],
                    "synonyms": [
                        "burgerwacht",
                        "schuttersgilde"
                    ],
                    "common_phrases": [
                        "de historische schutterij"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Verwijst naar een historische instelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A historical armed civic guard that existed in Dutch towns until the early twentieth century to maintain order."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "civic guard",
                                "target_lang_sense_clarification": "historical Dutch militia"
                            },
                            {
                                "target_lang_word": "militia",
                                "target_lang_sense_clarification": "historical citizen army"
                            },
                            {
                                "target_lang_word": "town guard",
                                "target_lang_sense_clarification": "historical local defense force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bab0d22-2cc7-30c3-8426-ade77d58cc79",
                    "sense_definition": "Een vereniging van sportschutters; schietvereniging.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vereniging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is al jaren actief lid van de plaatselijke <w>schutterij</w>.",
                            "target_lang_translations": {
                                "en": "He has been an active member of the local <w>shooting club</w> for years."
                            }
                        },
                        {
                            "text": "Tijdens het jaarlijkse feest van de <w>schutterij</w> wordt er gestreden om de titel van koning.",
                            "target_lang_translations": {
                                "en": "During the annual festival of the <w>shooting guild</w>, members compete for the title of king."
                            }
                        }
                    ],
                    "synonyms": [
                        "schietvereniging"
                    ],
                    "common_phrases": [
                        "lid van de schutterij"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Vooral gebruikt in het zuiden van Nederland en in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An association of sport shooters; shooting club."
                    },
                    "translations": {
