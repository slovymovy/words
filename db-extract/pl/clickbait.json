                "translations": [
                    {
                        "translation_id": "d51473a6-b9d4-4157-a266-9047a7244e02",
                        "source_entry_id": "a9c98f53-c323-3ded-bebf-a4d9ea3fd9d4",
                        "source_sense_id": "bc528d96-358f-30ce-9132-c060cf6af00f",
                        "target_lang_word": "clickbait",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clickbait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                        "entry_id": "776b4f7b-b238-3f33-8b3b-ccdfff5a5c07",
                                        "glosses": [
                                            "Website content that is aimed at generating advertising revenue, especially at the expense of quality or accuracy, relying on sensationalist headlines to attract click-throughs; such headlines."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26bc1b96-d3d6-4715-8220-fad68ee1de9f",
                                                "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                                "text": "Fairfax's sites are renowned for what is sometimes called ‘clickbait’: headlines written to beguile passing eyeballs but which obscure nondescript or irrelevant stories."
                                            },
                                            {
                                                "example_id": "95f5b113-f297-43bf-821b-aa643d369310",
                                                "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                                "text": "\"His careful lawyerly writing would be out of fashion now\", wrote one commenter after Kettle's piece. \"It wasn't clickbait\"."
                                            },
                                            {
                                                "example_id": "1213d4d1-67b7-4d2f-87d7-f17c02656f31",
                                                "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                                "text": "In August 2016, leaders at Facebook announced a plan to identify and limit clickbait, because the Facebook newsfeed goal is to “show people the stories most relevant to them.”"
                                            },
                                            {
                                                "example_id": "9c3fbd32-11e2-4922-ade7-c0eae24cf488",
                                                "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                                "text": "In comparison with algorithms used in the past, this SI based technique provided a better accuracy and a human interpretable set of rules to classify clickbaits"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clickbait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f841bf6-a018-35ce-b7d7-dd70e433f732",
                                        "entry_id": "d4e4f9e4-7c25-3a96-8357-c4b89b7e4cac",
                                        "glosses": [
                                            "To add clickbait to a web page; to direct clickbait at someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35194cdc-883e-406e-8ad0-a8e5b4a6e346",
                                                "sense_id": "9f841bf6-a018-35ce-b7d7-dd70e433f732",
                                                "text": "Whether they're acts of clickbaiting or dumbness, internet headlines routinely mischaracterize quotes, inaccurately paraphrase statements, and misuse specific terms, all to make readers click."
                                            },
                                            {
                                                "example_id": "9a298f52-6907-4990-82c3-f9032ec9405f",
                                                "sense_id": "9f841bf6-a018-35ce-b7d7-dd70e433f732",
                                                "text": "But he'd clickbaited her."
                                            },
                                            {
                                                "example_id": "c1a55f5e-03b9-42d0-8a7e-306a57c20948",
                                                "sense_id": "9f841bf6-a018-35ce-b7d7-dd70e433f732",
                                                "text": "I have never clickbaited anyone with overexaggerated titles, but also never downplayed the severity of the content within."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
