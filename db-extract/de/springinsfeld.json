                        "entry_id": "ebc68b3e-9e16-37a9-b951-8f4901290194",
                        "glosses": [
                            "Person, die sich unbekümmert treiben lässt"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "6f4f349c-31de-4c66-b96a-e33b9c6fec36",
                                "sense_id": "956c00cc-9e0d-3664-814d-6f16491e879e",
                                "text": "„Ich war ein interessanter Springinsfeld, ein recht schönes Pferd von guter Rasse, aber gar nicht oder, was noch schlimmer ist, schlecht abgerichtet.“"
                            },
                            {
                                "example_id": "5de87231-a29f-410c-ba60-dfe42b4a45ea",
                                "sense_id": "956c00cc-9e0d-3664-814d-6f16491e879e",
                                "text": "„Im Grunde hatte er diesen Springinsfeld und Heldendummkopf nicht ungern.“"
                            }
                        ],
