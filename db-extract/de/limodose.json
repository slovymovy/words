                "senses": [
                    {
                        "sense_id": "8317e31b-b0c6-357d-b632-4c4619f92f53",
                        "entry_id": "4355286d-75f5-3097-88d8-58ee5b964ac5",
                        "glosses": [
                            "Getränkedose, in der Limonade aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de0f05a-f5b6-42b8-a821-f01a59a2a32b",
                                "sense_id": "8317e31b-b0c6-357d-b632-4c4619f92f53",
                                "text": "„Und es war Steinhice, der dazwischenging, als der Mann nach seinem Geständnis eine Limodose auseinanderriss und versuchte, sich mit den scharfen Kanten die Pulsadern aufzuschneiden.“"
                            },
                            {
                                "example_id": "f5435092-14d2-431b-b812-1b73a705b007",
                                "sense_id": "8317e31b-b0c6-357d-b632-4c4619f92f53",
                                "text": "„Ab und zu bückte er sich, hob etwas auf und hielt es zwischen den Fingern - den Kronkorken einer Bierflasche, zwei Ringverschlüsse von Limodosen, eine verrostete Metallscheibe, eine leere weiße Plastiktüte.“"
                            },
                            {
                                "example_id": "7fb38b7e-200a-489a-a205-6f4a3e73ec99",
                                "sense_id": "8317e31b-b0c6-357d-b632-4c4619f92f53",
                                "text": "„Das Servicepersonal hat zwei Klapptische aufgebaut, auf denen sich offene Mais-Chips-Tüten und Limodosen stapeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
