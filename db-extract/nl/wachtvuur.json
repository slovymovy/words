                        "examples": [
                            {
                                "example_id": "b9ed10de-4775-4989-bee5-e47837f0a148",
                                "sense_id": "81218b1a-e51e-3c60-aea0-5ac550de5d03",
                                "text": "De tijd spant zeereiskaarten op de wanden\nvan mijn ziel. Vóór het open ogenraam\nhet knagend wachtvuur van het lied blijft branden\nbij deze dode zee, mijn jeugd: uw naam."
                            },
                            {
                                "example_id": "8ab3f748-d42e-4494-a25b-58ab25641bdb",
                                "sense_id": "81218b1a-e51e-3c60-aea0-5ac550de5d03",
                                "text": "‘Ja,’ zei Jan, die plotseling een aangenaam idée kreeg, ‘dan legeren zij zich om hun wachtvuur. Zeg jongens, dat moeten wij ook doen, en dan wordt het zelfs nog aardig. Ik krijg er zin in.’"
                            }
                        ]
                    }
