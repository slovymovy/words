                        "glosses": [
                            "Having no conclusion; unfinished."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "17ab4370-2845-472b-8d71-ab81751f95f6",
                                "sense_id": "cd1237aa-b2d0-333d-9648-05f15600077d",
                                "text": "Journey to no end, Conclusion of all that Is inconclusible"
                            },
                            {
                                "example_id": "aaf9307f-c6ae-418b-b776-3ad146a8300b",
                                "sense_id": "cd1237aa-b2d0-333d-9648-05f15600077d",
                                "text": "Any occurrence recorded photographically is seized in the process of its unfolding and condensed into a single image in which all the inconclusible energies of movement and interaction are arrested as a pattern."
                            },
                            {
                                "example_id": "3c37d7de-0a20-40a5-90a6-7cbeb7167873",
                                "sense_id": "cd1237aa-b2d0-333d-9648-05f15600077d",
                                "text": "With regard to the story or novel or novella or long poem, or maybe merely lyric, epigram, haiku, couplet, line, or less, a word, sign, phoneme, brief pause, inconclusive pause, inconclusible breath, why dead go on, unless I say this such that, when all is said and done (not necessarily, but at least said), in February, such that this, by late September, or early October (at the latest) is that."
                            },
                            {
                                "example_id": "3f5d7a21-6645-4ffd-95b4-f4e9d535f9af",
                                "sense_id": "cd1237aa-b2d0-333d-9648-05f15600077d",
                                "text": "Its 'evidence is less a stationary content than a principle, ... a ferment that exists for the progressive realization—in an inconclusible movement—of truth within the world'."
                            }
                        ]
                    }
