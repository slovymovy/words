        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b86cc882-bb0e-32e4-ad06-94570c7b9aa7",
                    "sense_definition": "Simple past and past participle of <w>esteem</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respected",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community greatly <w>esteemed</w> him for his years of public service.",
                            "target_lang_translations": {
                                "tr": "Toplum, kamuya sunduğu yıllar süren hizmetlerinden ötürü ona büyük <w>saygı duyuyordu</w>.",
                                "ru": "Общество глубоко <w>уважало</w> его за долгие годы государственной службы."
                            }
                        },
                        {
                            "text": "She was widely <w>esteemed</w> as one of the best doctors in the country.",
                            "target_lang_translations": {
                                "tr": "Ülkenin en iyi doktorlarından biri olarak geniş çapta <w>saygı görüyordu</w>.",
                                "ru": "Её повсеместно <w>почитали</w> как одного из лучших врачей в стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "valued",
                        "respected",
                        "regarded"
                    ],
                    "antonyms": [
                        "disregarded",
                        "scorned"
                    ],
                    "common_phrases": [
                        "highly esteemed",
                        "greatly esteemed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "'Esteem' fiilinin geçmiş zaman ve geçmiş zaman sıfat-fiil biçimi; saygı duydu, değer verdi veya saygı duyulan.",
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола esteem (уважать, глубоко почитать)."
                    },
                    "translations": {
                        "tr": [
                            {
