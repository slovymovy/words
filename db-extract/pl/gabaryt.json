                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f8e2aa-2c31-44b4-a3d1-8b4ab9214074",
                                "sense_id": "bbec42ea-8256-3b9f-994a-8e31ba43d859",
                                "text": "Jakie gabaryty ma ten samochód?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59952f7e-3575-4c28-907c-517610aac063",
                        "source_entry_id": "18551a98-ebc0-36e5-a99e-0fdb596755f6",
                        "source_sense_id": "bbec42ea-8256-3b9f-994a-8e31ba43d859",
                        "target_lang_word": "gabarit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gabarit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21245267-3154-3608-b96d-d094ccc6b1ca",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Modèle ou patron de construction fait avec des pièces de bois fort mince, sur lequel les charpentiers travaillent, en donnant aux pièces de bois qui doivent entrer dans la composition du bâtiment la même forme, les mêmes contours et les mêmes proportions que ces pièces ont dans le modèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332baad8-22d8-4f5e-a701-fffd544f3561",
                                                "sense_id": "21245267-3154-3608-b96d-d094ccc6b1ca",
                                                "text": "Les outils de tracé et de contrôle sont l’équerre, la règle, la fausse équerre dite sauterelle, le biveau, le panneau ou gabarit, le compas, le fil à plomb et le niveau. Ces outils se retrouvent dessinés ou gravés sur de nombreux documents ou monumets de l'Antiquité à nos jours."
                                            },
                                            {
                                                "example_id": "14816b1e-f50b-4013-a8a5-e73e4a678c1f",
                                                "sense_id": "21245267-3154-3608-b96d-d094ccc6b1ca",
                                                "text": "Si la technologie était déjà prête depuis plusieurs années - Candela produit des bateaux volants de plaisance - il a fallu, pour cette navette au gabarit plus conséquent, « remplir nombre de normes pour être en état de naviguer et être sûr pour les passagers », dit à l'AFP Karin Hallén, responsable de programme chez Candela."
                                            },
                                            {
                                                "example_id": "43010bfa-0d78-464d-bb8b-85d1f2102efb",
                                                "sense_id": "21245267-3154-3608-b96d-d094ccc6b1ca",
                                                "text": "Le gabarit d’un vaisseau."
                                            },
                                            {
                                                "example_id": "17c7225b-f1b2-4522-993c-afe2140069e0",
                                                "sense_id": "21245267-3154-3608-b96d-d094ccc6b1ca",
                                                "text": "Un bâtiment de tel gabarit est du port de cent, de deux cents, de cinq cents tonneaux."
                                            },
                                            {
                                                "example_id": "dd946135-d748-49e8-a63b-ec10f319c424",
                                                "sense_id": "21245267-3154-3608-b96d-d094ccc6b1ca",
                                                "text": "Le gabarit du maître couple, de l’étrave, du gouvernail, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b80fc8-bc85-31a4-8cb3-727527f640a3",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Modèle ou patron de construction fait avec des pièces de bois fort mince, sur lequel les charpentiers travaillent, en donnant aux pièces de bois qui doivent entrer dans la composition du bâtiment la même forme, les mêmes contours et les mêmes proportions que ces pièces ont dans le modèle.",
                                            "Patron, modèle en fer qui, dans les ateliers d’artillerie, sert pour la construction de diverses pièces, notamment des affûts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03254b79-812f-34d0-9535-8013cd48b3bb",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Modèle ou patron de construction fait avec des pièces de bois fort mince, sur lequel les charpentiers travaillent, en donnant aux pièces de bois qui doivent entrer dans la composition du bâtiment la même forme, les mêmes contours et les mêmes proportions que ces pièces ont dans le modèle.",
                                            "Appareil vérificateur, de forme et de dimensions déterminées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27cade2c-ce1c-4638-9bc8-5cb79ab79d35",
                                                "sense_id": "03254b79-812f-34d0-9535-8013cd48b3bb",
                                                "text": "Ti Nono plia les genoux et assura sa positions en équilibre à croupetons sur la grume, coudes sur les cuisses, tenant le gabarit de marquage à deux mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0475c87-0c64-35cd-8476-1b978a90ad11",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Dimension réglementaire, spécialement pour les véhicules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540dff14-0aef-4cc6-8b9f-67780394ece3",
                                                "sense_id": "d0475c87-0c64-35cd-8476-1b978a90ad11",
                                                "text": "Le chargement de ce wagon est conforme au gabarit."
                                            },
                                            {
                                                "example_id": "96b662be-936c-4c7e-9007-4712d8d905e3",
                                                "sense_id": "d0475c87-0c64-35cd-8476-1b978a90ad11",
                                                "text": "Ce camion, cette voiture sont conformes au gabarit réglementaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a891dce-1959-3b97-b486-c2c81174c85e",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Mesure, taille."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adc778a2-6c45-436c-8849-3670e23b206c",
                                                "sense_id": "8a891dce-1959-3b97-b486-c2c81174c85e",
                                                "text": "Un grand, un petit gabarit, personne de grande, de petite stature."
                                            },
                                            {
                                                "example_id": "9d6f88c6-5a85-4154-8415-79abf9b39064",
                                                "sense_id": "8a891dce-1959-3b97-b486-c2c81174c85e",
                                                "text": "Il est de plus en plus difficile de se garer pour les véhicules neufs dont le gabarit gonfle, au point de frôler - et parfois de dépasser - celui des places de parking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daebd227-9291-3c71-9800-a4849cc7ce61",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Arceau sous lequel on essaie les wagons chargés pour s’assurer qu’ils pourront passer sous les tunnels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1bf3d9-f49a-40e8-95f0-36b649475580",
                                                "sense_id": "daebd227-9291-3c71-9800-a4849cc7ce61",
                                                "text": "La nécessité de cette précaution n’a pas besoin d’être démontrée; un wagon, dont le chargement ne passerait pas dans le gabarit, serait exposé à heurter les parois ou le sommet des ouvrages d’art et, par suite, à détériorer les marchandises dont il serait chargé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "596f6416-dd24-36ef-839d-d1eb8f01e86d",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Modèle de document dans lequel il ne reste plus qu’à introduire un contenu spécifique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5cda27-3af7-448b-be37-ada8b4fb0a80",
                                                "sense_id": "596f6416-dd24-36ef-839d-d1eb8f01e86d",
                                                "text": "Le gabarit d’InDesign contient des éléments (dits éléments de gabarit) qui sont placés en fond de page comme si l’on travaillait sur une page à entête au lieu d'une page blanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16df882-7511-3c72-bb94-61a635927044",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Modèle ou guide destiné à faciliter l’exécution ou le contrôle d’un tracé déterminé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c525c5cd-5db1-3284-8c76-d2811271d946",
                                        "entry_id": "d67e90dd-c920-367d-97d2-099051d09095",
                                        "glosses": [
                                            "Morceau de carton utilisé pour découper le matériau (en particulier la peau) qui sera utilisé pour la couvrure d'une reliure."
                                        ],
                                        "tags": [
                                            "Reliure"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
