                                        "sense_id": "0b02294c-1aa5-3dd9-b0eb-ee83822dde44",
                                        "entry_id": "86f0bd5a-7e8a-3e75-973a-3849eb0e0a48",
                                        "glosses": [
                                            "Arborisation, ramification."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02af9ef4-1562-38fc-b2d8-96344ef23c8f",
                                        "entry_id": "86f0bd5a-7e8a-3e75-973a-3849eb0e0a48",
                                        "glosses": [
                                            "Arborisation, ramification.",
                                            "Prolongement ramifié d'un neurone le reliant aux neurones voisins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541be4ac-4036-43dd-b524-adde60e19cdd",
                                                "sense_id": "02af9ef4-1562-38fc-b2d8-96344ef23c8f",
                                                "text": "Ainsi le neurone présente une polarisation fonctionnelle : la circulation des informations y est unidirectionnelle, cellulipète dans les dendrites et cellulifuge dans l'axone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c3275f-5a77-3b43-a34d-1036efe1a800",
                                        "entry_id": "86f0bd5a-7e8a-3e75-973a-3849eb0e0a48",
                                        "glosses": [
                                            "Arborisation, ramification.",
                                            "Sur certaines roches, cristallisation évoquant la figure d'un arbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdb2511-122f-40a1-9f90-e40b3e36c273",
                                                "sense_id": "26c3275f-5a77-3b43-a34d-1036efe1a800",
                                                "text": "Mais lors de charges rapides, on constate l’apparition de « dendrites », excroissances de lithium métallique qui se forment par une réaction parasite au niveau des électrodes. Et lorsqu’une dendrite partie de l’électrode négative entre en contact avec l’électrode positive, il se crée un court-circuit qui endommage la batterie et peut provoquer un emballement thermique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "946c7b0b-f01b-33c3-91c0-9f63fc452abc",
                                        "entry_id": "86f0bd5a-7e8a-3e75-973a-3849eb0e0a48",
                                        "glosses": [
                                            "Arborisation, ramification.",
                                            "Croissance fractale ressemblant aux dendrites biologiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
