                "senses": [
                    {
                        "sense_id": "8b410de2-1275-3920-85e0-f85e5f0912a0",
                        "entry_id": "b179b45f-d1c2-3c17-bee3-8ef08d29ca28",
                        "glosses": [
                            "Vertreter des Manierismus"
                        ],
                        "tags": [
                            "Kunstgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "c54ce631-17d8-4e03-bbda-aa7035429fc6",
                                "sense_id": "8b410de2-1275-3920-85e0-f85e5f0912a0",
                                "text": "Auf den Außenseiten der Flügel ist die Verkündigung gemalt. und zwar von einem deutschen Manieristen unter italienischem Einfluß; um 1600."
                            },
                            {
                                "example_id": "a3efbea4-3e50-45f5-b155-dd2a74f338fb",
                                "sense_id": "8b410de2-1275-3920-85e0-f85e5f0912a0",
                                "text": "Nachdem er im J. 1770 Mitglied der Akademie geworden war, begab er sich nach Italien und verlegte sich hier fast ausschließlich auf die Landschaftsmalerei, in der er es als geschickter Manierist zu großem Ruf brachte."
                            },
                            {
                                "example_id": "a138a091-aa2e-4ef5-8b0a-87d708f4d75d",
                                "sense_id": "8b410de2-1275-3920-85e0-f85e5f0912a0",
                                "text": "Vater und Sohn zeichneten sich durch ihre glückliche Compositionsgabe und ihre große Technik als Frescomaler aus; in ihrer Darstellungsweise gehörten sie den italienischen Manieristen ihrer Zeit an."
                            },
                            {
                                "example_id": "6d61c967-8307-4c2b-92da-09a820192ec5",
                                "sense_id": "8b410de2-1275-3920-85e0-f85e5f0912a0",
                                "text": "Allein es fehlt überall die Durchbildung der Form wie der Farbe, er ist mit seinem oberflächlichen Geschick ein bloßer Manierist, und seine Werke, die seiner Zeit sehr geschätzt wurden, haben jetzt nur noch ein geschichtliches Interesse."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
