                "senses": [
                    {
                        "sense_id": "b180a6a7-ddd3-3738-8fff-0170dcea16d2",
                        "entry_id": "6a5104b5-4652-346c-a1df-ad27f5898488",
                        "glosses": [
                            "Ort am Lago Maggiore im schweizerischen Kanton Tessin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c91c3276-77bc-4e67-819f-f3904db9a978",
                                "sense_id": "b180a6a7-ddd3-3738-8fff-0170dcea16d2",
                                "text": "„Dies ist nun schon der 10. Band in der Neuen Folge der Eranos-Bände, die aus den Eranos-Tagungen in Ascona hervorgehen.“"
                            },
                            {
                                "example_id": "e09ad2f4-a5f6-41cd-97c7-346fd48016b4",
                                "sense_id": "b180a6a7-ddd3-3738-8fff-0170dcea16d2",
                                "text": "„Bald sieben Jahre ist es her, dass sie sich dazu entschlossen hat – nach einem Jazzkonzert in Ascona, in Erinnerung daran, wie sie selbst in schwerster Zeit während des Zweiten Weltkriegs Menschlichkeit erfahren habe.“"
                            },
                            {
                                "example_id": "814b6dc7-e795-451a-8fa6-54011f58fd64",
                                "sense_id": "b180a6a7-ddd3-3738-8fff-0170dcea16d2",
                                "text": "„Ascona ist Anfang der Dreißiger noch immer das kleine Fischerdorf, das es immer war.“"
                            },
                            {
                                "example_id": "3a1ddcee-64fe-47ca-a5b8-eef38341b5d3",
                                "sense_id": "b180a6a7-ddd3-3738-8fff-0170dcea16d2",
                                "text": "„Ascona lag still mit seiner Piazza am Ufer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
