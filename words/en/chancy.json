{
    "word_family": [
        "chance",
        "chanciness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6dbc892a-a618-35c3-86aa-af1016a05bd3",
                    "sense_definition": "Uncertain, risky, or hazardous; liable to fail or cause problems.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investing in that brand new startup seems like a <w>chancy</w> business given current economic trends.",
                            "target_lang_translations": {
                                "pl": "Inwestowanie w ten zupełnie nowy startup wydaje się <w>ryzykownym</w> interesem, biorąc pod uwagę obecne trendy gospodarcze."
                            }
                        },
                        {
                            "text": "Travelling across the mountains during a winter storm is a <w>chancy</w> proposition at best.",
                            "target_lang_translations": {
                                "pl": "Podróż przez góry podczas zimowej burzy to w najlepszym razie <w>niepewne</w> przedsięwzięcie."
                            }
                        }
                    ],
                    "synonyms": [
                        "dicey",
                        "iffy"
                    ],
                    "antonyms": [
                        "safe",
                        "sure"
                    ],
                    "common_phrases": [
                        "chancy business",
                        "chancy proposition"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niepewny, ryzykowny lub niebezpieczny; niosący ryzyko porażki lub problemów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ryzykowny",
                                "target_lang_sense_clarification": "związany z ryzykiem"
                            },
                            {
                                "target_lang_word": "niepewny",
                                "target_lang_sense_clarification": "o wątpliwym wyniku"
                            },
                            {
                                "target_lang_word": "niebezpieczny",
                                "target_lang_sense_clarification": "grożący niepowodzeniem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3a7761f-42e4-34b8-ac8a-81d7986b0a9b",
                    "sense_definition": "Subject to or determined by chance; unpredictable or random.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evolution of the species was shaped by a <w>chancy</w> sequence of genetic mutations.",
                            "target_lang_translations": {
                                "pl": "Ewolucja tego gatunku została ukształtowana przez <w>przypadkową</w> sekwencję mutacji genetycznych."
                            }
                        },
                        {
                            "text": "Weather predictions weeks in advance remain subject to extremely <w>chancy</w> atmospheric patterns.",
                            "target_lang_translations": {
                                "pl": "Prognozy pogody z wielotygodniowym wyprzedzeniem wciąż zależą od skrajnie <w>nieprzewidywalnych</w> układów atmosferycznych."
                            }
                        }
                    ],
                    "antonyms": [
                        "predictable"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zależny od przypadku; losowy lub nieprzewidywalny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przypadkowy",
                                "target_lang_sense_clarification": "zależny od zbiegu okoliczności"
                            },
                            {
                                "target_lang_word": "losowy",
                                "target_lang_sense_clarification": "wynikający z przypadku"
                            },
                            {
                                "target_lang_word": "nieprzewidywalny",
                                "target_lang_sense_clarification": "trudny do przewidzenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76f51fda-9f4b-34b4-9706-7f7d2d1e6230",
                    "sense_definition": "Fortunate, auspicious, or bringing good luck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meeting an old friend on the train was a <w>chancy</w> event that changed his life.",
                            "target_lang_translations": {
                                "pl": "Spotkanie starego przyjaciela w pociągu było <w>szczęśliwym</w> zrządzeniem losu, które zmieniło jego życie."
                            }
                        },
                        {
                            "text": "He managed to escape unharmed through a bit of <w>chancy</w> luck during the storm.",
                            "target_lang_translations": {
                                "pl": "Udało mu się uciec bez szwanku dzięki odrobinie <w>fortunnego</w> zbiegu okoliczności podczas burzy."
                            }
                        }
                    ],
                    "antonyms": [
                        "unlucky"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in traditional or older contexts to mean lucky."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przynoszący szczęście, pomyślny lub fortunny (znaczenie archaiczne)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szczęśliwy",
                                "target_lang_sense_clarification": "przynoszący pomyślność"
                            },
                            {
                                "target_lang_word": "pomyślny",
                                "target_lang_sense_clarification": "sprzyjający"
                            },
                            {
                                "target_lang_word": "fortunny",
                                "target_lang_sense_clarification": "udany dzięki szczęściu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fe2f5a8f-bf0f-3b27-a0b4-7c26938df49d",
                    "sense_definition": "An English surname derived from Old French.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Chancy</w> arrived early to deliver the keynote speech at the conference.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Chancy</w> przybył wcześnie, aby wygłosić przemówienie otwierające konferencję."
                            }
                        },
                        {
                            "text": "The local library was founded by the wealthy <w>Chancy</w> family over a century ago.",
                            "target_lang_translations": {
                                "pl": "Miejscowa biblioteka została ufundowana ponad sto lat temu przez zamożną rodzinę <w>Chancy</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Angielskie nazwisko pochodzenia starofrancuskiego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Chancy",
                                "target_lang_sense_clarification": "nazwisko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "352d5c98-04f3-3b56-b58a-b4e658285b1a",
                    "sense_definition": "A male given name transferred from the surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I went to school with a boy named <w>Chancy</w> who excelled at athletics.",
                            "target_lang_translations": {
                                "pl": "Chodziłem do szkoły z chłopcem o imieniu <w>Chancy</w>, który był znakomity w lekkoatletyce."
                            }
                        },
                        {
                            "text": "Young <w>Chancy</w> showed a talent for playing the piano at an early age.",
                            "target_lang_translations": {
                                "pl": "Młody <w>Chancy</w> już we wczesnym wieku przejawiał talent do gry na fortepianie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Męskie imię nadawane od nazwiska."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Chancy",
                                "target_lang_sense_clarification": "imię męskie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}