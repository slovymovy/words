                "senses": [
                    {
                        "sense_id": "df61eaab-192e-349f-8637-7c29e471c104",
                        "entry_id": "20da5f87-2051-3676-a678-459c1abdfda4",
                        "glosses": [
                            "Flasche, auf die Pfand erhoben wird und die – als Leergut zurückgebracht – neu befüllt wieder in den Handel kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18830b9d-8105-4a99-8f15-49121ca64b9c",
                                "sense_id": "df61eaab-192e-349f-8637-7c29e471c104",
                                "text": "„Künftig sollen Kunden auch in Großbritannien ihre Einweg- und Mehrwegpfandflaschen zum Händler zurückbringen können.“"
                            },
                            {
                                "example_id": "c3fb1623-6c61-4530-b25c-144f14d5c7c7",
                                "sense_id": "df61eaab-192e-349f-8637-7c29e471c104",
                                "text": "„Während es Mehrwegpfandflaschen schon seit einer gefühlten Ewigkeit gibt, wurde das Einwegpfand erst vor einigen Jahren eingeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
