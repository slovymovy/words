                "senses": [
                    {
                        "sense_id": "aab91822-b8c1-3a48-9b7c-1bfcc6e907b9",
                        "entry_id": "6e6e2ebc-b61a-39af-a9fe-a9f316d2ece9",
                        "glosses": [
                            "Zeitraum am Ende eines Semesters; Termin, an dem ein Semester vorbei ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b784632c-413f-4292-ac3d-2174754d8193",
                                "sense_id": "aab91822-b8c1-3a48-9b7c-1bfcc6e907b9",
                                "text": "„Dort treffe ich mich heute Abend mit ein paar Freunden, um den Semesterschluss zu feiern.“"
                            },
                            {
                                "example_id": "e13210e6-0697-4b90-8fb8-a21105b615c4",
                                "sense_id": "aab91822-b8c1-3a48-9b7c-1bfcc6e907b9",
                                "text": "„Während der Prüfungszeit an jedem Semesterschluss befreien die Betriebe die Studenten zeitweilig von der Arbeit.“"
                            },
                            {
                                "example_id": "b2b6ee76-dac8-4d7b-8814-17fd3c39c943",
                                "sense_id": "aab91822-b8c1-3a48-9b7c-1bfcc6e907b9",
                                "text": "„Die Frau des Schusters war sorgenvoll wegen des Zimmers, da es vier Wochen vor Semesterschluss war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
