                "senses": [
                    {
                        "sense_id": "a5c911a9-a80f-32af-aedf-803811a23002",
                        "entry_id": "158e5e13-1954-36b1-a17e-8cd2234d0eb5",
                        "glosses": [
                            "Spezialist im Kampf oder allgemein Umgang mit dem Schwert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a186e9f3-ebcd-45b0-83cd-b8120b34eb12",
                                "sense_id": "a5c911a9-a80f-32af-aedf-803811a23002",
                                "text": "„[…] Ein wahrer Schwertmeister ist nicht, wer andere im Kampf besiegt, sondern nur derjenige, der sich »selbst« besiegt hat.“"
                            },
                            {
                                "example_id": "fc1cb932-c634-475d-899f-e683c7eb5b79",
                                "sense_id": "a5c911a9-a80f-32af-aedf-803811a23002",
                                "text": "„[…] Die [‚Star Wars‘-]Filme schöpften aus derselben Quelle wie die amerikanischen Großwestern: den japanischen Historienfilmen, in denen heimatlose Schwertmeister durch die Welt irren, bis das Schicksal ihrem Leben, durch den Schutz jener ohne teuren Stahl in den Händen, einen Sinn verleiht.“"
                            },
                            {
                                "example_id": "3f574e36-562a-4141-836b-6010581a02c8",
                                "sense_id": "a5c911a9-a80f-32af-aedf-803811a23002",
                                "text": "„50 Jahre lang wirkte [der britische Olympionike Bob Anderson] als Schwertmeister, Kampf-Choreograf und Stuntman.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
