                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df95102-3e83-4041-b782-00e2e435b92d",
                                                "sense_id": "db7e8ae3-7654-387e-86cd-25f067888bb6",
                                                "text": "Le Service de la Statistique générale, avec le concours de l’Ifan, a mené à bien une série d’enquêtes dans des villages typiques de la Guinée française, en 1955 : Kawa (Guinée maritime), Dantari (Fouta Dialon), Kobané (Haut-Niger), enquêtes auxquelles ont participé plus ou moins longtemps les géographes E. Bernus (C.O.M., 1956), C. Hiernaux et Brasseur (voir les publications de la Mission démographique de Guinée, 1955)."
                                            }
                                        ]
                                    }
