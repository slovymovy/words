                                "target_senses": [
                                    {
                                        "sense_id": "8feb427e-ab46-3a6e-bae0-d645d3a58db9",
                                        "entry_id": "3628c5f8-bfbb-39ae-86c5-2ccc3f1dd370",
                                        "glosses": [
                                            "биол. организм, использующий для своей жизнедеятельности углекислоту как единственный или основной источник углерода"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c750ec58-1a89-4085-a4be-05a850c4b8e8",
                                                "sense_id": "8feb427e-ab46-3a6e-bae0-d645d3a58db9",
                                                "text": "Автотрофы, используя энергию света или энергию окисления химических веществ, усваивают CO2 и восстанавливают его до органических соединений."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
