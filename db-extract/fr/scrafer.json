                "senses": [
                    {
                        "sense_id": "fc0991c8-8cd7-310f-b24e-b3a3b5594a9b",
                        "entry_id": "d1f57b8f-2d7f-377d-b52b-a87dab01ac56",
                        "glosses": [
                            "Tuer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f8f3d7-7904-4a04-8217-cfb3b07a7d78",
                                "sense_id": "fc0991c8-8cd7-310f-b24e-b3a3b5594a9b",
                                "text": "Le chef va faire une drôle de frite lorsque je vais lui avouer que j’ai scrafé Stumer."
                            },
                            {
                                "example_id": "47ae4b03-e2a7-440f-a58b-bc15dee260ef",
                                "sense_id": "fc0991c8-8cd7-310f-b24e-b3a3b5594a9b",
                                "text": "Quand le cher Bastien a voulu scrafer l’autre Charles, il l’a raté parce que Dieu protégeait ce dernier, mais uniquement."
                            },
                            {
                                "example_id": "5871a4eb-28ff-4255-8a77-36a594844ecb",
                                "sense_id": "fc0991c8-8cd7-310f-b24e-b3a3b5594a9b",
                                "text": "Un premier tour d’horizon nous réconforte sur un point : celui qui a perquisitionné n’a pas scrafé Miss Lesbos."
                            }
                        ]
                    }
