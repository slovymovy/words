                                        "sense_id": "5c292d2a-6901-343a-936b-20e202b2a9c7",
                                        "entry_id": "a89053eb-5650-32cd-9eee-a6d2a530111f",
                                        "glosses": [
                                            "A strong, dominating pitching performance."
                                        ],
                                        "tags": [
