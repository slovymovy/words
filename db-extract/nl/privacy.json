        "nl-extract.jsonl": [
            {
                "entry_id": "cc67c744-8483-316a-a07c-54d0b697f7dd",
                "word": "privacy",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c4d570a-0ee0-379f-9c2c-2c6cd0954a42",
                        "entry_id": "cc67c744-8483-316a-a07c-54d0b697f7dd",
                        "glosses": [
                            "de sfeer van persoonlijke afzonderlijkheid hetgeen betekent dat iemand dingen kan doen zonder dat de buitenwereld daar weet van heeft, inbreuk op maakt, of een corrigerende invloed op uitoefent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbef012e-1c55-4368-b3f7-c67535281a20",
                                "sense_id": "3c4d570a-0ee0-379f-9c2c-2c6cd0954a42",
                                "text": "Het recht op privacy is zienderogen in gevaar gekomen."
                            },
                            {
                                "example_id": "0d2083ba-46b4-4feb-9adb-6b4315a63420",
                                "sense_id": "3c4d570a-0ee0-379f-9c2c-2c6cd0954a42",
                                "text": "Dochter Melanie: “In het begin kwamen er ook fans aan de deur, dat was wel wennen. We hebben een tijdje met de gordijnen dicht geleefd. Daarna nam Gio een video op om te vragen of ze wel onze privacy wilden respecteren. Dat hielp, een beetje. Soms komen er nog wel eens mensen, maar vaak doen we niet open.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14c01aa6-2366-444f-ac42-75471c2f3758",
                        "source_entry_id": "cc67c744-8483-316a-a07c-54d0b697f7dd",
                        "source_sense_id": "3c4d570a-0ee0-379f-9c2c-2c6cd0954a42",
                        "target_lang_word": "Privatsphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Privatsphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                        "entry_id": "52524c71-0e6c-3666-aae0-cfed6146003e",
                                        "glosses": [
                                            "grundgesetzlich geschütztes, persönliches Lebensumfeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf6ff8c3-2ce1-4f52-a1a2-83c7587cbaff",
                                                "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                                "text": "Zur Verwendung anonymer Nutzerkennzeichnungen: „Für die einen ist genau sie eine der großen Stärken des Netzes, ein Garant für Meinungsfreiheit und Privatsphäre.“"
                                            },
                                            {
                                                "example_id": "3d70f853-de3b-40b0-a709-2b34fb27d61e",
                                                "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                                "text": "„Holländer benutzen ohne weiteres mit Hunderten Wildfremden zusammen die sanitären Anlagen auf einem Campingplatz, doch wenn es um die eigene Wohnung geht, soll die Privatsphäre gleich unten an der Straße beginnen.“"
                                            },
                                            {
                                                "example_id": "1a90fc2a-6648-4194-a3d0-9baff8446086",
                                                "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                                "text": "„Eine Privatsphäre gab es nicht.“"
                                            },
                                            {
                                                "example_id": "00a288ba-c4ad-4496-b761-8313faad92a5",
                                                "sense_id": "50f368fa-3209-33c5-951d-c160c790f787",
                                                "text": "„Dann hörte man ein Rumpeln und Quietschen, und wir gingen aus Achtung vor der Privatsphäre hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11a013b7-821c-4d88-92d8-006d50645899",
                        "source_entry_id": "cc67c744-8483-316a-a07c-54d0b697f7dd",
                        "source_sense_id": "3c4d570a-0ee0-379f-9c2c-2c6cd0954a42",
                        "target_lang_word": "vie privée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vie privée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                        "entry_id": "aea76fdd-9bd2-361d-a50a-442a4fb76087",
                                        "glosses": [
                                            "Domaine personnel, par opposition au domaine public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3be017e-9c09-4f17-b67c-f7bd6aa95317",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "Nous ne voulons pas entrer dans la vie privée de beaucoup de canotiers ; mais à en croire les apparences, le canotage ne serait, pour quelques amateurs, qu’un prétexte d’orgies, une occasion de plaisirs faciles, au lieu d’un amusement salutaire et convenable à la dignité de l’homme."
                                            },
                                            {
                                                "example_id": "aeadd717-2ef1-4f8a-8aa6-613fac2f6adf",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "La maxime de M. Royer-Collard : « La vie privée doit être murée, » avait été inventée depuis bien des siècles par l’Orient, cette terre du soleil, d’où vient toute lumière et toute sagesse."
                                            },
                                            {
                                                "example_id": "8172fbae-d134-4fee-aecf-0f823b5a4746",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "Et puis, qu’est-ce que ça le regarde, celui-là, que je fasse de la peinture, des bottes ou des chaussons de lisière ?… C’est de la vie privée, ça !"
                                            },
                                            {
                                                "example_id": "df9b33fd-81ea-4ab5-aef2-edf57b2571ff",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "Dubois se veut le successeur de Richelieu et de Mazarin ; il rêve de la pourpre cardinalice, mais sa vie privée milite peu en faveur d’une telle promotion. Il n’a jamais caché son goût pour les femmes."
                                            },
                                            {
                                                "example_id": "7abe27b8-f549-40ea-89ad-69a1f7543aaf",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "Toute personne qui souhaite protéger sa vie privée peut chiffrer ses communications."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
