                ],
                "senses": [
                    {
                        "sense_id": "87db6599-cd46-32f1-942e-7a4b37d45ee0",
                        "entry_id": "de13f553-5e6f-382e-b47d-7c713debb0fd",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02c334b2-f781-453f-8dd3-b5ae2609a42c",
                                "sense_id": "87db6599-cd46-32f1-942e-7a4b37d45ee0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Koschmieder kommt, geht der Herr Koschmieder.“"
                            },
                            {
                                "example_id": "7405cdbc-f4e9-469e-85ef-be149116ab4b",
                                "sense_id": "87db6599-cd46-32f1-942e-7a4b37d45ee0",
                                "text": "Koschmieder kommt und geht."
                            },
                            {
                                "example_id": "3a669504-4641-4399-8c2f-770f3a392001",
                                "sense_id": "87db6599-cd46-32f1-942e-7a4b37d45ee0",
                                "text": "Koschmieders kamen, sahen und siegten."
                            },
                            {
                                "example_id": "61ca7cee-e58f-4056-912c-fca7605e1ebe",
                                "sense_id": "87db6599-cd46-32f1-942e-7a4b37d45ee0",
                                "text": "Frau Koschmieder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e6e48655-0c82-4779-9105-6ea81d69f47f",
                                "sense_id": "87db6599-cd46-32f1-942e-7a4b37d45ee0",
                                "text": "Herr Koschmieder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ba8aecf2-effc-45c7-a613-27552092b90b",
                                "sense_id": "87db6599-cd46-32f1-942e-7a4b37d45ee0",
                                "text": "Die Koschmieders fahren heute nach Frankfurt."
                            },
                            {
                                "example_id": "f44c441e-85c8-430b-8b67-2faa92c36d9e",
                                "sense_id": "87db6599-cd46-32f1-942e-7a4b37d45ee0",
                                "text": "Der Koschmieder trägt nie die Pullover, die die Koschmieder ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
