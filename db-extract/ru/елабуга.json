                        "examples": [
                            {
                                "example_id": "c15dbf90-671a-48a7-aad6-642e253dae99",
                                "sense_id": "89742578-2a81-39b5-a7e8-a31a80b2349f",
                                "text": "Елабуга небось такая же дыра, как и Чистополь."
                            },
                            {
                                "example_id": "0e9ed651-7318-4edf-a32c-9f13d813e173",
                                "sense_id": "89742578-2a81-39b5-a7e8-a31a80b2349f",
                                "text": "В июле 1919 года Елабугу в ходе круиза посетила Н. К. Крупская. Она выполняла миссию по революционной агитации среди жителей недавно оставленных белыми населённых пунктов."
                            }
                        ]
