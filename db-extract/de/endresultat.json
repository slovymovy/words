                "senses": [
                    {
                        "sense_id": "5ab7f164-446a-3999-bbc0-b69bce630250",
                        "entry_id": "ad2b4e75-c606-3abf-8053-fae05fd589e2",
                        "glosses": [
                            "Resultat, das nicht mehr änderbar ist; das feststeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c48855-6f99-48a9-8908-45d7e5077eb7",
                                "sense_id": "5ab7f164-446a-3999-bbc0-b69bce630250",
                                "text": "„Das Endresultat kann dennoch ein verlässliches Bild des Wählerwillens liefern, da die große Zahl an Stimmen die Zufälligkeiten individueller Wahlentscheidungen ausgleicht.“"
                            },
                            {
                                "example_id": "ef6cdf2c-863f-4245-bdc1-8f0e28c3720a",
                                "sense_id": "5ab7f164-446a-3999-bbc0-b69bce630250",
                                "text": "„Das Endresultat zeigt ein gespaltenes Königreich. England und Wales haben für den Brexit gestimmt, Schottland und Nordirland dagegen.“"
                            },
                            {
                                "example_id": "652683e0-9f6c-4a48-9804-31c59371a2fd",
                                "sense_id": "5ab7f164-446a-3999-bbc0-b69bce630250",
                                "text": "„Das soll nicht heißen, daß diese Kunst im wahrsten Sinn des Wortes einem Schiller fremd gewesen sei, doch das ertrebte Ziel, die benutzten Methoden und das Endresultat sind wesentlich andere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
