                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1bcaf05-d496-4f7f-b555-eed14aa31bdc",
                                "sense_id": "63ae79ae-3736-3155-9cd5-ab2fb27bca01",
                                "text": "„Bei den Trabern enden etwa 70 Prozent aller Rennen mit Favoritensiegen, entsprechend wenig zahlt die Siegwette.“"
                            },
                            {
                                "example_id": "a5cbab1f-cb89-481b-b533-40c7f5cde28a",
                                "sense_id": "63ae79ae-3736-3155-9cd5-ab2fb27bca01",
                                "text": "„Von eindeutigen Favoriten kann höchstens beim französischen Rennbahn-Toto die Rede sein, wo alle Pferde eines Besitzers unter einer Siegwette laufen.“"
                            }
