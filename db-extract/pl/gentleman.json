                "senses": [
                    {
                        "sense_id": "f0a840be-1e6c-3f0a-a4e5-fa9982d3d466",
                        "entry_id": "9b6ae0b4-ea17-3faa-a7e5-def2f8f650dc",
                        "glosses": [
                            "inna pisownia wyrazu dżentelmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d13d5c-8bd1-48e0-81b3-196b7d22d991",
                                "sense_id": "f0a840be-1e6c-3f0a-a4e5-fa9982d3d466",
                                "text": "Nic, kochani, więcej z nas nie wyciągniecie, • gentlemani oraz damy, • a o takich dziś śpiewamy, • o szczegółach nie powiedzą za nic w świecie!"
                            },
                            {
                                "example_id": "8166b71a-6221-4392-8302-291e7e2aa56a",
                                "sense_id": "f0a840be-1e6c-3f0a-a4e5-fa9982d3d466",
                                "text": "Mój mąż jest to grzeczny i delikatny gentleman, dyplomata, prawnik, nawet prawodawca, amator sztychów, akwafort, akwatint i innych jakichś tam jeszcze grawiur"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
