    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2108e68f-c20a-388a-b854-2ac62ab05ae7",
                    "sense_definition": "traktowany poważnie, wypowiadany oficjalnie, uroczysty",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uroczysty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta <w>solenna</w> przysięga miała zostać nagrana i stać się częścią programu.",
                            "target_lang_translations": {
                                "ru": "Эта <w>торжественная</w> клятва должна была быть записана и стать частью программы."
                            }
                        },
                        {
                            "text": "Złożyliśmy <w>solenną</w> obietnicę, że nigdy nie zdradzimy naszych wspólnych tajemnic.",
                            "target_lang_translations": {
                                "ru": "Мы дали <w>торжественное</w> обещание, что никогда не выдадим наших общих тайн."
                            }
                        }
                    ],
                    "synonyms": [
                        "uroczysty",
                        "oficjalny"
                    ],
                    "common_phrases": [
                        "solenna przysięga",
                        "solenna obietnica"
                    ],
                    "target_lang_definitions": {
                        "ru": "воспринимаемый всерьез, произносимый официально, торжественный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торжественный",
                                "target_lang_sense_clarification": "официальный, серьезный, праздничный"
                            },
                            {
                                "target_lang_word": "священный",
                                "target_lang_sense_clarification": "о клятве или обещании, имеющий особую важность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68bf9391-f148-3230-9736-b69b1d3f44bd",
                    "sense_definition": "podniosły, patetyczny",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uroczysty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W muzeum panuje <w>solenna</w> powaga, która skłania do głębokiej refleksji nad historią.",
                            "target_lang_translations": {
                                "ru": "В музее царит <w>торжественная</w> серьезность, которая располагает к глубоким размышлениям об истории."
                            }
                        },
                        {
                            "text": "Jego <w>solenny</w> ton głosu sprawił, że wszyscy goście natychmiast umilkli.",
                            "target_lang_translations": {
                                "ru": "Его <w>торжественный</w> тон голоса заставил всех гостей мгновенно замолчать."
                            }
                        }
                    ],
                    "synonyms": [
                        "podniosły",
                        "patetyczny"
                    ],
                    "common_phrases": [
                        "solenna powaga"
                    ],
                    "target_lang_definitions": {
                        "ru": "возвышенный, патетический"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торжественный",
                                "target_lang_sense_clarification": "о настроении, тоне или обстановке"
                            },
                            {
                                "target_lang_word": "важный",
                                "target_lang_sense_clarification": "имеющий серьезный, значимый характер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be5e9180-e54c-3af5-9038-5d8dc3985d90",
                    "sense_definition": "taki, na którym można polegać, rzetelny",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rzetelny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed podjęciem decyzji przeprowadził <w>solenny</w> przegląd wszystkich dostępnych dokumentów.",
                            "target_lang_translations": {
                                "ru": "Перед принятием решения он провел <w>тщательный</w> обзор всех доступных документов."
                            }
                        },
                        {
                            "text": "To był bardzo <w>solenny</w> pracownik, który zawsze wywiązywał się ze swoich zadań.",
                            "target_lang_translations": {
                                "ru": "Это был очень <w>добросовестный</w> сотрудник, который всегда выполнял свои задачи."
                            }
                        }
                    ],
                    "synonyms": [
                        "rzetelny",
                        "sumienny"
                    ],
                    "common_phrases": [
                        "solenny przegląd"
                    ],
                    "target_lang_definitions": {
                        "ru": "такой, на который можно положиться, добросовестный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добросовестный",
                                "target_lang_sense_clarification": "о человеке, который ответственно относится к работе"
                            },
                            {
                                "target_lang_word": "тщательный",
                                "target_lang_sense_clarification": "о действии, выполненном с большим вниманием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c5335e2-3d20-3c2b-ab2a-8c65ae7ea19f",
                    "sense_definition": "wielki, znacznych rozmiarów",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wielki",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długiej wędrówce wszyscy zjedli <w>solenny</w> obiad w pobliskiej karczmie.",
                            "target_lang_translations": {
                                "ru": "После долгого похода все съели <w>обильный</w> обед в ближайшем трактире."
                            }
                        },
                        {
                            "text": "Przygotowano <w>solenny</w> posiłek dla wszystkich gości przybyłych na uroczystość.",
                            "target_lang_translations": {
                                "ru": "Для всех гостей, прибывших на торжество, был приготовлен <w>обильный</w> пир."
                            }
                        }
                    ],
                    "common_phrases": [
                        "solenny obiad"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "użycie w znaczeniu 'wielki' jest przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "большой, значительных размеров (устаревшее)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обильный",
                                "target_lang_sense_clarification": "о еде, которой много"
                            },
                            {
                                "target_lang_word": "знатный",
                                "target_lang_sense_clarification": "разговорное, о большом количестве еды"
                            }
                        ]
                    }
                }
            ]
        }
