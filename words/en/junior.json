                },
                {
                    "sense_id": "494b3394-8c37-3b45-bf23-325224712cc2",
                    "sense_definition": "Relating to the education of children aged approximately 7 to 11.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "edu_uk_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children usually move to <w>junior</w> school after completing the infant stage.",
                            "target_lang_translations": {
                                "ru": "Дети обычно переходят в <w>младшую</w> школу после завершения подготовительного этапа.",
                                "zh": "孩子们通常在完成幼儿阶段后进入<w>小学</w>。"
                            }
                        },
                        {
                            "text": "The <w>junior</w> department is located in a separate building from the nursery.",
                            "target_lang_translations": {
                                "ru": "<w>Младшее</w> отделение расположено в отдельном здании от детского сада.",
                                "zh": "<w>小学</w>部位于与幼儿园分开的建筑内。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "junior school",
                        "junior department"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
