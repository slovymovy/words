                        "glosses": [
                            "A general strike, shutdown, or other form of protest used in South Asia in which a substantial portion of the population stays home and does not report to work."
                        ],
                        "tags": [
                            "South-Asia"
                        ],
                        "examples": [
                            {
                                "example_id": "545f2323-cf26-4366-b121-1f83d151e2ed",
                                "sense_id": "fbcdce07-5b47-35f1-8e04-a5fcdc65dae2",
                                "text": "The impending course of events and the patterns of violence could have readily been foreseen after the incident in Godhra, and particularly after the VHP's declaration of a state-wide bandh, both by the city's residents and government authorities […]"
                            },
                            {
                                "example_id": "37f46362-ba35-493f-aee1-71e51375d788",
                                "sense_id": "fbcdce07-5b47-35f1-8e04-a5fcdc65dae2",
                                "text": "A week-long bandh was in progress. People had nothing to do."
                            },
                            {
                                "example_id": "c7940a6f-23ba-4994-adc3-c040abd1daf3",
                                "sense_id": "fbcdce07-5b47-35f1-8e04-a5fcdc65dae2",
                                "text": "Opposition parties said that the bandh was a success. The ruling parties said the opposite. Some saw government insensitivity in the bandh and the beginning of the fight against inflationary trends."
                            }
                        ]
                    }
