                        "glosses": [
                            "Formed by redoubling; reduplicate, double"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d3ef0ed3-197f-40ba-a286-361b97d7c2c6",
                                "sense_id": "52967c99-e1f1-3aad-b653-c1a60474b35f",
                                "text": "The loss of the reduplicative syllable in the perfect is sufficiently accounted for by the same occurrence in almost all the modern, and even some of the ancient branches of the Indo-Germanic family."
                            },
                            {
                                "example_id": "c0391e51-006f-433d-b7fe-613bd8b79061",
                                "sense_id": "52967c99-e1f1-3aad-b653-c1a60474b35f",
                                "text": "A hyphen (-) is generally used to indicate the boundary between the components of ordinary and reduplicative compounds in derivational morphology."
                            }
                        ]
                    }
                ],
