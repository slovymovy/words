                ],
                "senses": [
                    {
                        "sense_id": "187cf3d1-a53b-3705-b683-adedb8802aa8",
                        "entry_id": "5d7d7787-2a7d-3787-bc43-5c37c692adb6",
                        "glosses": [
                            "Bibliothek, die Teil eines Kongresses ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e283e295-0a8c-42a8-8d77-0bd9e66f1ca8",
                                "sense_id": "187cf3d1-a53b-3705-b683-adedb8802aa8",
                                "text": "„Also hab ich's überprüft. Ich meine, wirklich überprüft. Ich habe die Kongressbibliothek darauf losgelassen.“"
                            },
                            {
                                "example_id": "75857f1a-029d-422d-b48e-54009f648efa",
                                "sense_id": "187cf3d1-a53b-3705-b683-adedb8802aa8",
                                "text": "„»Ich wurde nicht von einem professionellen Hacker programmiert, per se, sondern von einem Forscher der Kongressbibliothek, der sich das Programmieren selbst beigebracht hat«, sagt der Bibliothekar.“"
                            },
                            {
                                "example_id": "b45f4657-8140-48f2-9561-d3114b3ad3f7",
                                "sense_id": "187cf3d1-a53b-3705-b683-adedb8802aa8",
                                "text": "„Diese Leitartikelschreiber, denen anscheinend nicht bekannt war, dass jedes in den Vereinigten Staaten veröffentlichte Buch in der Kongressbibliothek registriert werden muss, zitierten sogar die von der Bibliothek verliehene Katalognummer als schlüssigen Beweis dafür, dass die Regierung der Vereinigten Staaten das Buch subventioniert hatte.“"
                            },
                            {
                                "example_id": "85e7b5c7-15e9-4a38-8ed3-79b7626eb50c",
                                "sense_id": "187cf3d1-a53b-3705-b683-adedb8802aa8",
                                "text": "„Danach beschaffte er sich in den Kongressbibliotheken sämtliche verfügbaren Aufzeichnungen über Strafaussetzungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
