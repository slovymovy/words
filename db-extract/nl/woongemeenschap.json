                                "target_senses": [
                                    {
                                        "sense_id": "96327d0d-533a-39ff-9eb7-0f00722dfbb4",
                                        "entry_id": "daef5fe2-0bbc-3013-a32d-0be3a2c28f60",
                                        "glosses": [
                                            "Wohnung, die sich mehrere Personen teilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863d918d-e3fc-4023-b8ba-77ac6ff0c36c",
                                                "sense_id": "96327d0d-533a-39ff-9eb7-0f00722dfbb4",
                                                "text": "Der Student lebte mit zwei guten Freundinnen in einer Wohngemeinschaft."
                                            },
                                            {
                                                "example_id": "817bd9d7-3ed2-4d89-8f69-b6ba9c1139f6",
                                                "sense_id": "96327d0d-533a-39ff-9eb7-0f00722dfbb4",
                                                "text": "„Dann hörte ich von einer Wohngemeinschaft, wo die Vermieterin toleranter war, dort wohnten noch andere wie ich, und wir könnten beieinander übernachten, wenn wir nur diskret waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c6d18fc-7b43-3264-93f3-82d7ad02e7be",
                                        "entry_id": "daef5fe2-0bbc-3013-a32d-0be3a2c28f60",
                                        "glosses": [
                                            "Gemeinschaft von Personen (Mitbewohner), die sich eine Wohnung teilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2979d58-cf4c-4473-9738-e086b5a5cf9b",
                                                "sense_id": "7c6d18fc-7b43-3264-93f3-82d7ad02e7be",
                                                "text": "Unsere Wohngemeinschaft macht morgen einen Spieleabend."
                                            },
                                            {
                                                "example_id": "36789389-2e15-4bf1-a079-bed91bcff9c5",
                                                "sense_id": "7c6d18fc-7b43-3264-93f3-82d7ad02e7be",
                                                "text": "„Wer jedoch die Stadt in Richtung Norden verließ, der konnte in einem stattlichen Haus an den Hängen des Montmartre eine kleine Wohngemeinschaft antreffen, die entschlossen schien, der Stimmung in der Stadt zu trotzen.“"
                                            },
                                            {
                                                "example_id": "3bb7879d-f706-4f15-9e19-3646d3f27ce5",
                                                "sense_id": "7c6d18fc-7b43-3264-93f3-82d7ad02e7be",
                                                "text": "„In einem ihrer Kölner Häuser hatten ihm seine Eltern eine Fünf-Zimmer-Wohnung überlassen, die Arnfried unverzüglich in eine Wohngemeinschaft, eine WG, umfunktionierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
