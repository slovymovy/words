                        "entry_id": "1e8f9171-1088-3f49-8605-495a8d12431c",
                        "glosses": [
                            "истор., прост. сторублёвый кредитный билет в дореволюционной России, на котором была изображена Екатерина II"
                        ],
                        "tags": [],
                        "examples": [
                            {
