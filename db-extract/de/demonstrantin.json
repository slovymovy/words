                                "target_senses": [
                                    {
                                        "sense_id": "2346a395-1517-3c33-af3a-66637ce6b1cf",
                                        "entry_id": "d294c219-1c7e-3c05-b6ef-44722d134d0f",
                                        "glosses": [
                                            "Alternative spelling of protester."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04de60c5-d0fa-4f9f-b5f4-fb0473afdbba",
                                                "sense_id": "2346a395-1517-3c33-af3a-66637ce6b1cf",
                                                "text": "No flashy dressers, skimpily dressed starlets, or celebrities stepping out of stretch limos. Instead, on a warm Friday evening in June 2009, one hundred protestors sang prayers, chanted slogans, and carried signs […]"
                                            },
                                            {
                                                "example_id": "3fd7f826-335a-4c19-b92a-a42d18da21c5",
                                                "sense_id": "2346a395-1517-3c33-af3a-66637ce6b1cf",
                                                "text": "We also talk about dealing with protestors, whose actions are creating additional costs of tens of millions of pounds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
