                                            {
                                                "example_id": "f2f7163d-1968-47d3-bb9d-0365dd72ff9e",
                                                "sense_id": "55badc21-9787-3792-9c71-48f06a52768a",
                                                "text": "The cinema is right across the street from the restaurant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a739390-6f82-3f71-bfdc-fc5d2960ad5b",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "Films collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "701828ff-337b-42f8-9a1b-45cc4a69e4e2",
                                                "sense_id": "1a739390-6f82-3f71-bfdc-fc5d2960ad5b",
                                                "text": "Despite the critics, he produced excellent cinema."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae77c62e-7469-33b3-bb4a-c4bd4f58b207",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "The film and movie industry."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be76f4c-6c07-40ab-a33a-85d66e446b87",
                                                "sense_id": "ae77c62e-7469-33b3-bb4a-c4bd4f58b207",
                                                "text": "In the long history of Spanish cinema[…]."
                                            },
                                            {
                                                "example_id": "d1945d82-a580-4f84-a5ce-afc4f9a3bc93",
                                                "sense_id": "ae77c62e-7469-33b3-bb4a-c4bd4f58b207",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4feda90f-9a01-3278-902b-f7330a2f316c",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "The art of making films and movies; cinematography"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d9a75c-d7fd-4190-a2b6-2b9018e5d420",
                                                "sense_id": "4feda90f-9a01-3278-902b-f7330a2f316c",
                                                "text": "Throughout the history of cinema, filmmakers[…]."
                                            },
                                            {
                                                "example_id": "56ebf3b5-ca31-4c64-af58-3de3ec30b922",
                                                "sense_id": "4feda90f-9a01-3278-902b-f7330a2f316c",
                                                "text": "The French and Italian cinemas can seem to persist autonomously—in the sense of being spaces of separate development and marked difference from Hollywood and other national cinemas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e82fc5-9edd-3afa-a6b8-f62c9daed03e",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "A sophisticated or exemplary film, representative of the art of cinema."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf2b1318-2979-37f2-9645-3f4c56ab4963",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "A sophisticated or exemplary film, representative of the art of cinema.",
                                            "Any media or event that is exemplary."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
