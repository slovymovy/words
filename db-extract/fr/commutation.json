                "senses": [
                    {
                        "sense_id": "32b07263-0824-377d-b0c2-3d6b2a3b8406",
                        "entry_id": "bdb8f112-d7e6-3e49-b6f1-73e3035805d4",
                        "glosses": [
                            "Action de commuer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ede9cd2-1983-40fa-858b-d4906c29ebf7",
                                "sense_id": "32b07263-0824-377d-b0c2-3d6b2a3b8406",
                                "text": "Il propose au Roi d’accorder ou de refuser les commutations de peines."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c525ed9-c090-3533-84dd-353b3e188a53",
                        "entry_id": "bdb8f112-d7e6-3e49-b6f1-73e3035805d4",
                        "glosses": [
                            "Méthode qui consiste à changer un son pour un autre pour savoir s'il permet de distinguer des unités significatives."
                        ],
                        "tags": [],
