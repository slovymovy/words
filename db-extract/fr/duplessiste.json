                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fc3dc868-585f-47a2-96ca-46e658d0c2b5",
                                "sense_id": "d8486968-f3ca-3fc6-bb43-4dc1d252d356",
                                "text": "Mon père était un duplessiste convaincu."
                            },
                            {
                                "example_id": "9ae5a348-ef83-48b7-89a2-a0ae1ccec59b",
                                "sense_id": "d8486968-f3ca-3fc6-bb43-4dc1d252d356",
                                "text": "Julia Richer, épouse d’un duplessiste notoire, est un bel exemple de cette réaction."
