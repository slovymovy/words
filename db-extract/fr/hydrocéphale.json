                "senses": [
                    {
                        "sense_id": "bc18d4bb-f2e8-372f-ad9e-0d51eb6f89b7",
                        "entry_id": "2174c26c-bef0-30b8-b5da-33acbe91c587",
                        "glosses": [
                            "Qui est atteint d’hydrocéphalie. Qualifie une personne, un animal dont la boîte crânienne a une taille anormalement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9697e5a-f646-43b4-967e-20c32d438e57",
                                "sense_id": "bc18d4bb-f2e8-372f-ad9e-0d51eb6f89b7",
                                "text": "Les patients hydrocéphales sont aujourd'hui traités par une dérivation qui évacue le liquide céphalorachidien."
                            },
                            {
                                "example_id": "dd511820-d36a-4142-81a3-75e892b387ef",
                                "sense_id": "bc18d4bb-f2e8-372f-ad9e-0d51eb6f89b7",
                                "text": "Naît-on pied-bot, hydrocéphale, avec un bec-de-lièvre, une arthrogrypose, des mains syndactyles, une scoliose ou des jambes arquées ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c53a5a60-c833-3c3a-8f8f-b0a741a574ae",
                        "entry_id": "2174c26c-bef0-30b8-b5da-33acbe91c587",
                        "glosses": [
                            "Qui a la grosse tête, est prétentieux."
                        ],
                        "tags": [
                            "Par dérision"
                        ],
                        "examples": [
                            {
                                "example_id": "91836b90-a41e-4565-83f5-d24f0c7abf63",
                                "sense_id": "c53a5a60-c833-3c3a-8f8f-b0a741a574ae",
                                "text": "« De grâce… Pas de lieux communs sur ce sujet ! … Gardez cela pour vos réunions publiques et pour les hydrocéphales qui vous écoutent. »"
                            }
                        ]
                    }
                ],
