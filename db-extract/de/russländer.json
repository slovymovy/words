                "senses": [
                    {
                        "sense_id": "4c186581-83b8-389c-b34d-b1404a560a7e",
                        "entry_id": "e0a9e39a-1780-35a3-9091-5cd113ca30ff",
                        "glosses": [
                            "Staatsbürger von Russland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d1f616-d9e5-4c15-97bf-33de5b54b0fd",
                                "sense_id": "4c186581-83b8-389c-b34d-b1404a560a7e",
                                "text": "Die Bürger Kasans bestehen hauptsächlich aus Russen, Tataren, Tschuwaschen, Ukrainern und Aserbaidschanern. Sie alle sind jedoch Russländer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b330e6ea-7188-48de-bb56-7bcb39631897",
                        "source_entry_id": "e0a9e39a-1780-35a3-9091-5cd113ca30ff",
                        "source_sense_id": "4c186581-83b8-389c-b34d-b1404a560a7e",
                        "source_sense_description": "Staatsbürger von Russland",
                        "target_lang_word": "Russien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Russien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7972fe11-8af7-38f1-aa8d-1f0e6dcd91d6",
                                        "entry_id": "77598502-87f3-3e94-8078-c49922fd5b8a",
                                        "glosses": [
                                            "ou Habitant de la Russie, de nationalité russe."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08dac405-b440-4b53-a3d0-c89e78a701cb",
                                                "sense_id": "7972fe11-8af7-38f1-aa8d-1f0e6dcd91d6",
                                                "text": "Je me sers du nom de Russes pour désigner les habitants de ce grand empire… les gazettes et d’autres mémoires depuis quelque temps emploient le mot de Russiens ; mais, comme ce mot approche trop de Prussiens, je m’en tiens à celui de Russes, que presque tous nos auteurs leur ont donné."
                                            },
                                            {
                                                "example_id": "3ef668a6-5c6c-4714-89a9-3fe2428dea5e",
                                                "sense_id": "7972fe11-8af7-38f1-aa8d-1f0e6dcd91d6",
                                                "text": "Nous ne sommes pas des Russiens accoutumés aux frimas scythiques pour hiverner ici jusqu’à demain matin, le derrière dans la neige."
                                            },
                                            {
                                                "example_id": "f7b45dac-5485-40ec-a178-3551ddd1e575",
                                                "sense_id": "7972fe11-8af7-38f1-aa8d-1f0e6dcd91d6",
                                                "text": "On peut dire que c’est grâce à Voltaire que le mot Russe a prévalu sur Russien."
                                            },
                                            {
                                                "example_id": "433a6bc1-559b-4730-8c1d-ad4cc0747632",
                                                "sense_id": "7972fe11-8af7-38f1-aa8d-1f0e6dcd91d6",
                                                "text": "Une grande majorité des Russiens sont russophones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
