                                        "sense_id": "da9f4d66-7d82-3c72-b861-0cd76195d793",
                                        "entry_id": "5eab4f7e-0495-37fa-8fa3-59452dd7fe11",
                                        "glosses": [
                                            "die Wissenschaft und die Lehre vom Zahnsystem der Wirbeltiere und des Menschen"
