                "senses": [
                    {
                        "sense_id": "f445eaff-9c90-322b-b8f8-c634fde78a2d",
                        "entry_id": "2d4dfa7b-f7a5-3ea9-8d2b-95b142c34803",
                        "glosses": [
                            "Furcht davor, bald sterben zu müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2484e4d3-19b4-4189-b74c-4a8ac350400e",
                                "sense_id": "f445eaff-9c90-322b-b8f8-c634fde78a2d",
                                "text": "„Er empfand keine Todesfurcht mehr.“"
                            },
                            {
                                "example_id": "7da92286-446c-4ea6-b1a2-cd47a8a51789",
                                "sense_id": "f445eaff-9c90-322b-b8f8-c634fde78a2d",
                                "text": "„Iljin redete viel und unruhig, und es tat Rostow jedesmal leid, wenn er sein aufgeregtes Gesicht sah, da er ja aus eigener Erfahrung den qualvollen Zustand des bangen Harrens und der Todesfurcht kannte, in welchem der junge Kornett sich befand, und wusste, dass ihm nichts helfen konnte als die Zeit.“"
                            },
                            {
                                "example_id": "2d9e6c6e-98f1-42c3-9241-8101159baee2",
                                "sense_id": "f445eaff-9c90-322b-b8f8-c634fde78a2d",
                                "text": "„Ernsthafter geschah dies erst, als in den späteren Jahren schwere Herzattacken seine Todesfurcht verstärkten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
