                                        "sense_id": "1831ad5e-7150-349b-b6e5-3df5635992cf",
                                        "entry_id": "8358ffe9-8258-396c-83f5-361c645040d2",
                                        "glosses": [
                                            "A person with a general but superficial interest in any art or a branch of knowledge."
