                "senses": [
                    {
                        "sense_id": "0ecb2263-bbd6-3ec0-ab27-cae03d0a024b",
                        "entry_id": "f729c29d-6efb-3faf-a8e3-4c4a4f3d8c2a",
                        "glosses": [
                            "abstoßender, unsympathischer, widerlicher Mann"
                        ],
                        "tags": [
                            "Austrian German",
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c0dcb275-0cf5-4a6c-afab-644677a4408b",
                                "sense_id": "0ecb2263-bbd6-3ec0-ab27-cae03d0a024b",
                                "text": "„Jedenfalls ist man sich ziemlich einig, dass ein Ungustl wie Heinzl sowieso eine in die Pappen verdient hätte.“"
                            },
                            {
                                "example_id": "58be24a7-6664-4aae-86bf-e42c01a54c86",
                                "sense_id": "0ecb2263-bbd6-3ec0-ab27-cae03d0a024b",
                                "text": "„Der Krone-Leser, eh schon rundum von Scheinasylanten, Unholden, EU-Bonzen, Feuerteufeln und anderen Ungustln eingekreist, muss sich jetzt auch noch auf Eier-Schwindler einstellen, die ihm das Kernweiche, das er sich zum Frühstück einverleibt, mit falschen Deklarationen versehen haben“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
