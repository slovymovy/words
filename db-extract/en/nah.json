                                                "sense_id": "b81a9191-144c-3d70-b32d-bd84183eb236",
                                                "text": "Heute ist doch Donnerstag, ne?"
                                            },
                                            {
                                                "example_id": "5b0c9b8d-e33b-4004-b494-7b340de6f611",
                                                "sense_id": "b81a9191-144c-3d70-b32d-bd84183eb236",
                                                "text": "„Stellt sich irgendjemand hin und gründet 'ne Kirche, und dann ist gut, ne.“"
                                            },
                                            {
                                                "example_id": "3a58e0ae-ad62-49fe-99b1-2f84709edba2",
                                                "sense_id": "b81a9191-144c-3d70-b32d-bd84183eb236",
                                                "text": "„Ha, ha, der war gut, ne?“"
                                            }
                                        ],
