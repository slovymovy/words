                ],
                "senses": [
                    {
                        "sense_id": "183023e0-1b72-327c-9212-f16fbebdefd4",
                        "entry_id": "41508362-0ca3-31ff-87d1-bb69511c173f",
                        "glosses": [
                            "Lieu où l’on garde des meubles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75cabb4-ff8a-4b9f-a212-27b344796948",
                                "sense_id": "183023e0-1b72-327c-9212-f16fbebdefd4",
                                "text": "Il faut mettre cette tapisserie dans le garde-meuble."
                            },
                            {
                                "example_id": "685a2e40-8863-4f80-9d9f-c9a8d1b92b2a",
                                "sense_id": "183023e0-1b72-327c-9212-f16fbebdefd4",
                                "text": "Le garde-meuble de la couronne. - Le garde-meuble national."
                            },
                            {
                                "example_id": "1f55ae87-7edf-40bf-80da-954319f329a2",
                                "sense_id": "183023e0-1b72-327c-9212-f16fbebdefd4",
                                "text": "Son château des Guillettes abondait en meubles précieux, en vaisselle d’or et d’argent, en tapisseries, en broderies, qu’il tenait renfermés dans des garde-meubles."
                            },
                            {
                                "example_id": "50d03ef6-012b-4efb-bf85-a1243b1b5fbb",
                                "sense_id": "183023e0-1b72-327c-9212-f16fbebdefd4",
                                "text": "Les « beaux » meubles au contraire, bergères Louis XV vraies ou fausses, argenterie, tapis d’Orient, lustres de cristal jugés démodés, piles de linge inusable accumulées par cinq générations et portraits d’ancêtres authentifiés ou non furent mis au garde-meuble par ce même fils auquel Michel avait laissé tous pouvoirs. (« Qu’ai-je à faire de ces vieilleries ? »)"
                            },
                            {
                                "example_id": "15d77a9f-1498-42ac-91b0-55c16be28bce",
                                "sense_id": "183023e0-1b72-327c-9212-f16fbebdefd4",
                                "text": "Ton armoire part au garde-meuble, tu la reverras quand tu seras prêt à grandir. (Sous-titres Breaking Bad)"
                            }
                        ]
                    },
                    {
                        "sense_id": "df356d84-837f-36f6-9542-d9a2b0b78ae1",
                        "entry_id": "41508362-0ca3-31ff-87d1-bb69511c173f",
                        "glosses": [
                            "Entreprise ou personne qui fait l’activité de garder les meubles d’autrui."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
