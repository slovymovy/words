                "senses": [
                    {
                        "sense_id": "215c07fd-a74d-3d8e-96b3-5000622e2689",
                        "entry_id": "1bfc5ec5-b618-3132-b9e3-a653ed235c20",
                        "glosses": [
                            "Biologie, Medizin: Zelle, die Knochensubstanz abbaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f95e23b3-f621-48ff-afed-d03b9b04dbfd",
                                "sense_id": "215c07fd-a74d-3d8e-96b3-5000622e2689",
                                "text": "Osteoblasten sind die Zellen, die den Knochen aufbauen; Osteoklasten dagegen bauen Knochensubstanz ab."
                            },
                            {
                                "example_id": "32c0439b-605e-451a-9d61-5f6395d8bf77",
                                "sense_id": "215c07fd-a74d-3d8e-96b3-5000622e2689",
                                "text": "„Bei der Entstehung der Knochenmetastasen spielt die unheilvolle Allianz zwischen Tumorzellen und Knochenzellen eine wesentliche Rolle: Tumorzellen stimulieren die Fresszellen des Knochens (Osteoklasten) und diese setzen aus dem zerstörten Knochen wichtige Überlebensfaktoren für die Tumorzellen frei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "520d83e6-83b4-4eea-89c6-a9d4e9f0ada9",
