    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "91b19ad4-20a6-306f-aed2-306782699fa5",
                    "sense_definition": "Hot enough to make a hissing sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "heat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sizzling</w> pan was placed carefully on the wooden table.",
                            "target_lang_translations": {
                                "cs": "<w>Syčící</w> pánev byla opatrně položena na dřevěný stůl.",
                                "zh": "那只<w>滚烫</w>的平底锅被小心地放在了木桌上。"
                            }
                        },
                        {
                            "text": "We could hear the <w>sizzling</w> meat cooking over the open fire.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme <w>syčící</w> maso, které se peklo na otevřeném ohni.",
                                "zh": "我们能听到明火上烤肉发出的<w>滋滋作响的</w>声音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hot",
                        "searing"
                    ],
                    "common_phrases": [
                        "sizzling pan"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi horký, vydávající syčivý zvuk při kontaktu s teplem.",
                        "zh": "温度极高、发出滋滋声的；滚烫的"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "syčící",
                                "target_lang_sense_clarification": "vydávající zvuk při smažení"
                            },
                            {
                                "target_lang_word": "rozpálený",
                                "target_lang_sense_clarification": "velmi horký"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滋滋作响的",
                                "target_lang_sense_clarification": "因受热发出声响"
                            },
                            {
                                "target_lang_word": "滚烫的",
                                "target_lang_sense_clarification": "温度极高"
                            }
                        ]
                    }
                },
                {
