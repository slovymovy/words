                        "translation_id": "3ea5c372-c52a-4205-a429-d80062a1596e",
                        "source_entry_id": "8127dd16-3f52-36c1-ab1d-d40e00297e93",
                        "source_sense_id": "915e2e2c-ca02-3987-a6be-0b5beccfc0ce",
