                "senses": [
                    {
                        "sense_id": "6acc968c-26a9-3c69-a671-2d2b83383be9",
                        "entry_id": "1909c816-84cd-3dae-a52a-58575008e7f2",
                        "glosses": [
                            "Genoese"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c3dfe9-0639-4ae0-9a0c-29f410d643e3",
                                "sense_id": "6acc968c-26a9-3c69-a671-2d2b83383be9",
                                "text": "Его́ порази́ла э́та теснота́ ме́жду дома́ми, высо́кими, огро́мными, отсу́тствие экипа́жного сту́ку, треуго́льные ма́ленькие площа́дки и ме́жду ни́ми, как те́сные коридо́ры, изгиба́ющиеся ли́нии у́лиц, напо́лненных ла́вочками генуэ́зских серебряников и золоты́х мастеро́в.",
                                "translation": "Nikolai Gogol",
                                "english": "Nikolai Gogol"
                            }
                        ]
                    }
