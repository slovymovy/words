                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c90ff1-dc3b-44e1-8001-fcc6da1c2e7d",
                                "sense_id": "48b70bc7-4be4-3414-b829-a59090abf2c0",
                                "text": "Die Strecke umfasst 2000 Höhenmeter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e36c9e5d-6ebd-3f1f-bfbf-b0c0a3d7e211",
                        "entry_id": "271dfb4b-356c-3190-8216-3d7ecb7c7dff",
                        "glosses": [
                            "vom Flugkörper erreichte Höhe über Grund; auch das Messgerät, mit welchem die Höhe über Grund gemessen wird"
                        ],
                        "tags": [
                            "Aviatik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e0a883be-26d2-3f4a-bd2d-a2c4fea5b75e",
                        "entry_id": "271dfb4b-356c-3190-8216-3d7ecb7c7dff",
                        "glosses": [
                            "Höhe über Meer und Ähnlichem"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e6e19a89-1836-47a8-9970-8dd06c9e23c5",
                                "sense_id": "e0a883be-26d2-3f4a-bd2d-a2c4fea5b75e",
                                "text": "Die Camps lagen 1000 Höhenmeter auseinander."
                            },
                            {
                                "example_id": "d25ba3dc-221b-43de-85f6-d63b35119d9c",
                                "sense_id": "e0a883be-26d2-3f4a-bd2d-a2c4fea5b75e",
                                "text": "„Einige von ihnen treffen wir, nachdem wir uns auf der Piste ein paar Höhenmeter hinaufgeschraubt haben.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5127ad6-22b5-4f38-a27a-6137ed8c00bc",
                        "source_entry_id": "271dfb4b-356c-3190-8216-3d7ecb7c7dff",
                        "source_sense_id": "48b70bc7-4be4-3414-b829-a59090abf2c0",
                        "source_sense_description": "Sport: ein in Auf- oder Abwärtsbewegung zu überwindender Meter",
                        "target_lang_word": "dénivelé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dénivelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f543cd37-8a6e-321f-a9d6-0b58bad9c31a",
                                        "entry_id": "1040e855-6675-3cbe-9a50-4252acfc9798",
                                        "glosses": [
                                            "Participe passé masculin singulier de déniveler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dénivelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bff6c11-527b-3590-8ace-069236ab29cb",
                                        "entry_id": "c59263c8-7724-3ca4-816f-5e20055c6a7d",
                                        "glosses": [
                                            "Différence d’altitude entre deux endroits ou deux points sur une carte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "345ef400-3b05-42b6-b10c-bef8f3fe97fb",
                                                "sense_id": "8bff6c11-527b-3590-8ace-069236ab29cb",
                                                "text": "Par exemple à Amman (capitale de la Jordanie), l'eau est pompée à une distance de 40 km avec un dénivelé de 1 200 m."
                                            },
                                            {
                                                "example_id": "a1dbd813-8aad-44e6-a5e1-a5d9cab820aa",
                                                "sense_id": "8bff6c11-527b-3590-8ace-069236ab29cb",
                                                "text": "Mt Hutt est la plus grande station de l'île du Sud, avec 3,65 km2 de domaine skiable. C'est aussi l'une des plus célèbres et des plus appréciées, avec ses 683 mètres de dénivelé. Elle est très accessible et peut accueillir tous les niveaux, aussi bien en ski qu'en snowboard."
                                            },
                                            {
                                                "example_id": "26cc2da9-a473-4e51-a5c4-21c0c8a8f3fa",
                                                "sense_id": "8bff6c11-527b-3590-8ace-069236ab29cb",
                                                "text": "La plupart des cuirasses dans la région se répartissent grossièrement en deux niveaux, séparés par des dénivelés d'altitude de l'ordre de 10 à 100 mètres. Le niveau supérieur, le plus ancien, ne subsiste que sous la forme de buttes témoins […]."
                                            },
                                            {
                                                "example_id": "1069c211-a478-4675-a86e-a786e01a45e9",
                                                "sense_id": "8bff6c11-527b-3590-8ace-069236ab29cb",
                                                "text": "Les montagnards, éduqués par le chaos des reliefs, savent que survivre, c’est se tenir à distance. 1 000 mètres de dénivelé éloignent davantage que 1 000 kilomètres de distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4581ca00-5a7f-4f0f-8ff8-9778d0b43990",
                        "source_entry_id": "271dfb4b-356c-3190-8216-3d7ecb7c7dff",
                        "source_sense_id": "48b70bc7-4be4-3414-b829-a59090abf2c0",
