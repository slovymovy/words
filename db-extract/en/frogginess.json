                        "glosses": [
                            "The state or condition of being froggy."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b7e8139f-0dd0-4e18-a6d8-6b05ecf14dbc",
                                "sense_id": "bafb2663-8b81-3b2e-9303-a1fee60fe6c8",
                                "text": "There is an audience of seven frogs, listening to a speaker, or croaker, in the middle; and Bewick has set himself to show in all, but especially in the speaker, essential frogginess of mind — the marsh temper."
                            },
                            {
                                "example_id": "88cc3082-3bd2-4346-b827-681f99ca9525",
                                "sense_id": "bafb2663-8b81-3b2e-9303-a1fee60fe6c8",
                                "text": "This corner of the net is home to all kinds of virtual frogginess, from the silly to the scientific."
                            },
                            {
                                "example_id": "c7331a00-2f6e-439f-ba86-e2abf406ea15",
                                "sense_id": "bafb2663-8b81-3b2e-9303-a1fee60fe6c8",
                                "text": "However grateful I am to discard my frogginess, I wonder: if she's not a Princess, am I really a Prince?"
                            }
                        ]
                    }
