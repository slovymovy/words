                ],
                "senses": [
                    {
                        "sense_id": "c7f0a014-9db6-303c-8980-b7deed698cdd",
                        "entry_id": "dc1ca4a4-6323-3bbe-a7c5-7fbb9bc9879f",
                        "glosses": [
                            "datenkraken, data leech (Internet companies that have a large number of users and possess detailed personal information on them)"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "d6d9ac6e-2b91-4629-87e9-e2426b16900b",
                                "sense_id": "c7f0a014-9db6-303c-8980-b7deed698cdd",
                                "text": "Während es gerade bei der Presse fast schon chic geworden ist, Google als Datenkrake oder übermächtige Organisation darzustellen, vor der man Angst haben müsste, findet man umgekehrt wenig valide Informationen über die […]"
                            },
                            {
                                "example_id": "0768939a-0682-404a-87b2-4717c7b266b0",
                                "sense_id": "c7f0a014-9db6-303c-8980-b7deed698cdd",
                                "text": "Google gilt als Datenkrake, weil es alle Suchanfragen bis zu 18 Monaten lang speichert. Aus diesen Anfragen lassen sich theoretisch ganze Persönlichkeitsprofile einzelner User ableiten."
                            },
                            {
                                "example_id": "2fa8b463-9a7f-42ef-9079-b79c61d66bc6",
                                "sense_id": "c7f0a014-9db6-303c-8980-b7deed698cdd",
                                "text": "Wir lächeln – aber das gegenseitige Ausspionieren, die Allgegenwärtigkeit des Großen Bruders, die sich emsig voranschiebende Datenkrake, das ist zum Lachen"
                            }
                        ]
                    }
                ],
