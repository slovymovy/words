                                        "glosses": [
                                            "Person, die einen vorgegebenen Text für den Druck vorbereitet"
                                        ],
                                        "tags": [
                                            "Druckwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3cfda18-a033-4d6b-8c7a-88bcb838235a",
                                                "sense_id": "7458077c-b63c-34a7-9721-7ba98731c40a",
                                                "text": "„Ein Schriftsetzer am Stadtrand von Rotterdam durchlitt gerade eine persönliche Krise.“"
                                            },
                                            {
                                                "example_id": "d20f4c55-5183-4ff1-91ae-c30ff287ea4b",
                                                "sense_id": "7458077c-b63c-34a7-9721-7ba98731c40a",
                                                "text": "„In Lübeck hat er Schriftsetzer gelernt, nahm als Kriegsfreiwilliger an den Befreiungskriegen gegen Napoleon teil und kam um 1814 nach Frankfurt.“"
                                            },
                                            {
                                                "example_id": "0f5d07e4-b197-42a3-8e7d-da6d4a810360",
                                                "sense_id": "7458077c-b63c-34a7-9721-7ba98731c40a",
                                                "text": "„Auf den folgenden Stationen, als Schriftsetzer, als Reporter und als Schriftsteller, kam er immer wieder mit ihr in Berührung.“"
                                            },
                                            {
                                                "example_id": "13c88430-95c1-443e-b18b-481bf1f9bfaf",
                                                "sense_id": "7458077c-b63c-34a7-9721-7ba98731c40a",
                                                "text": "„Die Zeichensetzung könnte demnach eine Mischung sein, die von Shakespeare, den Kopisten und Schriftsetzern geschaffen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
