                ],
                "senses": [
                    {
                        "sense_id": "74a0c490-3373-351a-9513-31c5b1397df4",
                        "entry_id": "b9975034-c7e7-35f2-b1fe-8207e7c05943",
                        "glosses": [
                            "Bezeichnung für ein höheres Niveau in der Evolutionsstufe des Bewusstseins"
                        ],
                        "tags": [
                            "Bewusstseinswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "10714baf-819c-4b97-9e6c-ba414ba7c11f",
                                "sense_id": "74a0c490-3373-351a-9513-31c5b1397df4",
                                "text": "„…Demgegenüber haben die menschlichen Gesellschaften unterschiedliche evolutionäre Niveaus, sowohl Individuen, die ausgegrenzt werden, als auch Menschen, die ein höheres Evolutionsniveau haben. Ein Beispiel ist der Homo sapiens serenissimus, das maximale evolutive Vorbild an bewusstheitlicher Effizienz…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ba853b8-f23a-3061-aff7-c35e00604114",
                        "entry_id": "b9975034-c7e7-35f2-b1fe-8207e7c05943",
                        "glosses": [
                            "Anrede oder Titel eines regierenden Fürsten (zur Zeit der Kleinstaaterei)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0028ffc6-8df5-4d97-8a35-6ee5c19c03fc",
                                "sense_id": "9ba853b8-f23a-3061-aff7-c35e00604114",
                                "text": "„Schon allein um Bismarck als bloßen »Ratgeber« und »Diener« zu marginalisieren, glorifizierte der Serenissimus seinen Großvater, den er gar zu »Kaiser Wilhelm dem Großen« proklamieren wollte.“"
                            },
                            {
                                "example_id": "dc8c7a60-92f3-4641-b7d0-3f791feb9f32",
                                "sense_id": "9ba853b8-f23a-3061-aff7-c35e00604114",
                                "text": "„Die mecklenburgischen Serenissimi haben durchaus nicht auf der Seite der Fischländer gestanden.“"
                            },
                            {
                                "example_id": "d15cd834-9aa0-40b6-a8d3-0ad55e90720a",
                                "sense_id": "9ba853b8-f23a-3061-aff7-c35e00604114",
                                "text": "„…unter den Intendanten [waren viele bedeutende Persönlichkeiten], die es wohl verstanden, neben Serenissimus auch der Kunst zu dienen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b76cf281-f32a-3be2-8079-6a6da8c72f00",
                        "entry_id": "b9975034-c7e7-35f2-b1fe-8207e7c05943",
                        "glosses": [
                            "Kleinstaatfürst; Witzfigur"
                        ],
                        "tags": [
                            "archaic",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "81e042d6-9a44-43ca-b414-3f2ece0e7aef",
                                "sense_id": "b76cf281-f32a-3be2-8079-6a6da8c72f00",
                                "text": "„Die Anekdoten kannte man alle, und selbst Serenissimus wirkten am Ende enerviert, als er seine Jugendkarriere im Kaninchenzüchterverein zum hundertsten Mal von sich gab.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
