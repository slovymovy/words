                "senses": [
                    {
                        "sense_id": "958859a9-5fe9-3e7e-ba5a-ff8ff8d3a111",
                        "entry_id": "7d5a3931-828f-3a13-afc7-bf7aca6645db",
                        "glosses": [
                            "Datum, über das hinaus etwas, besonders ein Lebensmittel, nicht mehr genießbar oder nicht mehr verwendbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b0360d-350d-48dd-8346-3e05ef2efcc2",
                                "sense_id": "958859a9-5fe9-3e7e-ba5a-ff8ff8d3a111",
                                "text": "„Atomkraft und Kohleabbau haben ein Ablaufdatum.“"
                            },
                            {
                                "example_id": "314dc9dd-af89-47cf-bf54-b0099d1f280d",
                                "sense_id": "958859a9-5fe9-3e7e-ba5a-ff8ff8d3a111",
                                "text": "„Für jeden Patienten wird ein medizinisches Ablaufdatum errechnet, das ihn als Risikopatienten oder hoffnungslosen Fall ausweist.“"
                            },
                            {
                                "example_id": "a59311fa-aa32-4178-b543-d29b254c0ec6",
                                "sense_id": "958859a9-5fe9-3e7e-ba5a-ff8ff8d3a111",
                                "text": "„Wir drehen ab, wenn wir ein überzogenes Ablaufdatum auf einer Packung sehen.“"
                            },
                            {
                                "example_id": "b8e16909-b5e9-4297-b54f-e1ec3482e99d",
                                "sense_id": "958859a9-5fe9-3e7e-ba5a-ff8ff8d3a111",
                                "text": "„So stark sich die Arbeitswelt auch gewandelt hat, das Vorstellungsgespräch ist dabei eine Konstante, die sich in den vergangenen Jahrzehnten kaum veränderte aber mittlerweile ein gewisses Ablaufdatum hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
