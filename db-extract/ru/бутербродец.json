                "senses": [
                    {
                        "sense_id": "b7370a92-9f63-36da-961b-a4ed776cb844",
                        "entry_id": "0696f2ad-91b0-3b5d-8c00-d0809d1cf784",
                        "glosses": [
                            "разг. то же, что бутерброд"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8735e6e-71c6-43b0-a4a2-431a1c1dd2f2",
                                "sense_id": "b7370a92-9f63-36da-961b-a4ed776cb844",
                                "text": "Барышня! — обращается он к сестрице,— осчастливьте! соорудите бутербродец с икрой вашими прекрасными ручками!"
                            },
                            {
                                "example_id": "06a67c07-1fc1-4011-a771-4b69d14dc86a",
                                "sense_id": "b7370a92-9f63-36da-961b-a4ed776cb844",
                                "text": "На фаянсовой тарелочке, под тугой крахмальной салфеткой ― сушки с маком, бутербродец с сыром и яблоко…"
                            }
                        ]
                    }
