                            {
                                "example_id": "77bf2605-f8c9-48e9-95a8-9e7bb32b00f8",
                                "sense_id": "0c06190c-f051-3e4c-9aeb-5a6d3ee82776",
                                "text": "Als op een badstrand of op een balkon, met haar arm ontbloot, het operatielicht het laatste wat ze zag voordat ze wegdoezelde in de narcose."
                            },
                            {
                                "example_id": "a7bb01c9-2a09-4ee0-8b87-e65f348343f5",
                                "sense_id": "0c06190c-f051-3e4c-9aeb-5a6d3ee82776",
                                "text": "Strandgangers van het Badstrand in Vlissingen werden zondagmiddag verrast door een enorme vloedgolf. Een meisje van 10 jaar werd bedolven onder het water."
                            }
                        ]
