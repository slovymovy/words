                                        "entry_id": "bec40288-fd4d-37cd-984c-382105c2c18f",
                                        "glosses": [
                                            "hardloopwedstrijd van 3000 meter waarbij de hardloper in totaal 28 op horden gelijkende hindernissen en zevenmaal een waterbak moet passeren"
                                        ],
                                        "tags": [
                                            "atletiek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc7a60b-95a3-4c48-98f4-f31c9221a4f2",
                                                "sense_id": "c6d400c3-46c7-33a2-8b2c-33ee6520cf30",
                                                "text": "De Keniaan Conseslus Kipruto heeft woensdag olympisch goud veroverd in de 3.000m steeplechase bij de mannen op de Olympische Spelen in Rio de Janeiro."
                                            },
                                            {
                                                "example_id": "d350d67a-8fa4-40f0-9799-2e8715dfa631",
                                                "sense_id": "c6d400c3-46c7-33a2-8b2c-33ee6520cf30",
                                                "text": "De 18-jarige inwoner van Boulder, Colorado (VS) werd zaterdag in Vught knap tweede op de 3000 meter steeplechase voor junioren A. Met zijn 10.18.79 moest hij alleen Achraf Boutkabout (10.07.22) voor zich dulden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6beed7e3-903e-3fbd-b015-b89fd6ae6054",
                                        "entry_id": "bec40288-fd4d-37cd-984c-382105c2c18f",
