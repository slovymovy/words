                            {
                                "example_id": "18a86c3a-672f-441c-87ad-731f9aabf8ea",
                                "sense_id": "b9a58506-dc9d-3f75-b7d3-ccf025ee9e1d",
                                "text": "Volkslied: „Ein Wächterlein auf dem Türmlein saß“"
