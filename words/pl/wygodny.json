                },
                {
                    "sense_id": "b02d08a7-176c-364f-b03a-6e89a3e25ab5",
                    "sense_definition": "O człowieku: taki, który unika wysiłku i problemów, dbając przede wszystkim o własny spokój.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat jest bardzo <w>wygodny</w> i nigdy nie pomaga w sprzątaniu domu.",
                            "target_lang_translations": {
                                "ru": "Мой брат очень <w>любит комфорт</w> и никогда не помогает в уборке дома.",
                                "de": "Mein Bruder ist sehr <w>bequem</w> und hilft nie beim Aufräumen des Hauses."
                            }
                        },
                        {
                            "text": "Nie bądź taki <w>wygodny</w>, musisz czasem zrobić coś dla innych ludzi.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>ленивым</w>, ты должен иногда делать что-то для других людей.",
                                "de": "Sei nicht so <w>bequem</w>, du musst manchmal etwas für andere Leute tun."
                            }
                        }
                    ],
                    "synonyms": [
