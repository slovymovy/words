                "senses": [
                    {
                        "sense_id": "6c0fc0af-44ca-3a48-bf94-d03fedea1f54",
                        "entry_id": "487edb73-41d2-3a2a-845f-05b698890e7f",
                        "glosses": [
                            "in einem Museum ausgestelltes (oft wichtiges) Objekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d728fd7b-e072-4101-beac-3926ae3cea50",
                                "sense_id": "6c0fc0af-44ca-3a48-bf94-d03fedea1f54",
                                "text": "Die «Endeavour» ist auf ihrem allerletzten Flug sicher in Kalifornien gelandet. Dort soll die ausgemusterte amerikanische Raumfähre zum Museumsstück werden."
                            },
                            {
                                "example_id": "59eb104f-dbde-4518-b846-b82145199429",
                                "sense_id": "6c0fc0af-44ca-3a48-bf94-d03fedea1f54",
                                "text": "„Ein Handwerker, der beim Umbau von Bautzen II dabei war, schenkte mir ein Schloss aus einer Tür zum Kinosaal, der ursprünglichen Kirche. Reliquie, Museumsstück. Nach 1990 ging nicht alles wünschenswert.“"
                            },
                            {
                                "example_id": "a983e894-9b60-4a6f-a749-6daf75b9347c",
                                "sense_id": "6c0fc0af-44ca-3a48-bf94-d03fedea1f54",
                                "text": "„Das Haus an der Allee der Kosmonauten 145 wirkt wie ein Museumsstück.“"
                            },
                            {
                                "example_id": "2dbc0a51-e61d-4742-bb26-898bb7b75f6c",
                                "sense_id": "6c0fc0af-44ca-3a48-bf94-d03fedea1f54",
                                "text": "„Das Museum ist selbst ein Museumsstück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "599a8a54-0db4-48ad-ac56-e6c4f18520f4",
                        "source_entry_id": "487edb73-41d2-3a2a-845f-05b698890e7f",
