                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dec99c5-b372-40c6-9cb9-59722bcb7586",
                                "sense_id": "91d43b82-2d42-37e6-9af0-776229cae329",
                                "text": "De bewonersavond in de gemeente Wormerland over de eventuele komst van asielzoekers gaat door. De gemeente overlegt met de politie hoe die veilig kan verlopen en hoe er wordt omgegaan met \"raddraaiers\"."
                            },
                            {
                                "example_id": "19d31cb0-c628-439c-9b4f-e986cd65bbd4",
                                "sense_id": "91d43b82-2d42-37e6-9af0-776229cae329",
                                "text": "Afgelopen nacht werden twee auto's van GroenLinks-fractievoorzitter Halewijn in brand gestoken. Ondanks dat ging de bewonersavond gewoon door."
                            },
                            {
                                "example_id": "e0dfd494-e61a-4f5d-8898-98f3aee91c74",
                                "sense_id": "91d43b82-2d42-37e6-9af0-776229cae329",
                                "text": "De gemeente Kaatsheuvel zet extra politie in tijdens de bewonersavonden over de komst van een noodopvang voor asielzoekers. Burgemeester Wim Luijendijk van Loon op Zand heeft dat bekendgemaakt, schrijft Omroep Brabant."
                            }
                        ]
                    }
