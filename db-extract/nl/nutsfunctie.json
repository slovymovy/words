                        "glosses": [
                            "wiskundige vergelijking die laat zien hoe de hoeveelheid van iets dat genoegen geeft, samenhangt met de hoeveelheid genoegen die het oplevert"
                        ],
                        "tags": [
                            "welvaartstheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "a33839ac-9d6c-4e03-92e2-f3553fee721e",
                                "sense_id": "b9b4f2fb-6408-32a3-98f5-af315dc4cdd3",
                                "text": "De nutsfunctie geeft aan hoe het nut afhangt van de hoeveelheid goederen. Het is een functie in de wiskundige zin."
                            }
                        ]
