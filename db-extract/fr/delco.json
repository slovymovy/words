                        "sense_id": "d2cb30e1-6ee9-3fe2-b1ee-05c03d74dd30",
                        "entry_id": "9d6e09ab-de88-3bcc-9920-7f284441bcf5",
                        "glosses": [
                            "Allumeur électromécanique, rotatif, d’un moteur à explosion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da07e470-2aca-407e-a4aa-a9d4d206d56d",
                                "sense_id": "d2cb30e1-6ee9-3fe2-b1ee-05c03d74dd30",
                                "text": "Relié à l’arbre à cames, le delco produit une impulsion électrique par le contact sur une vis platinée et qui sert à faire jaillir une étincelle à la bougie d’allumage."
                            },
                            {
                                "example_id": "ada6408e-9101-4de2-bb53-26f89f90528d",
                                "sense_id": "d2cb30e1-6ee9-3fe2-b1ee-05c03d74dd30",
                                "text": "Le chauffeur conduisait lentement. C’était un garçon de mon âge, comme son voisin.\n— Un problème de delco…\n— Même un diesel ?"
                            },
                            {
                                "example_id": "9aab740c-f8ae-4108-aad5-283e0007f3fd",
                                "sense_id": "d2cb30e1-6ee9-3fe2-b1ee-05c03d74dd30",
                                "text": "Tantôt c’est la batterie qui bat de l’aile, tantôt le delco ou les bougies, ou alors un pneu qui est à plat."
                            }
                        ]
                    }
                ],
