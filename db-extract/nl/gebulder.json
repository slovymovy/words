                "entry_id": "b5ffdff6-f53d-34c4-83ab-5d69357a5051",
                "word": "gebulder",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f5cd8e59-2e76-3b77-b2c9-97bd87424bcb",
                        "entry_id": "b5ffdff6-f53d-34c4-83ab-5d69357a5051",
                        "glosses": [
                            "aanhoudend zeer luid schreeuwen door mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "448f0ee7-8e81-4b97-9457-29b5316dc45c",
                                "sense_id": "f5cd8e59-2e76-3b77-b2c9-97bd87424bcb",
                                "text": "En daarna gaf het publiek hem een duw in de rug. ,,Dat gebulder is een geweldige eer. Ik kan het niet omschrijven."
                            },
                            {
                                "example_id": "eca5a20b-4701-47b2-aa0d-af5c06f660b4",
                                "sense_id": "f5cd8e59-2e76-3b77-b2c9-97bd87424bcb",
                                "text": "Het was eng, dat gebulder over God, het dreigde bijna uit de hand te lopen, maar dat gebeurde gelukkig niet. De luidruchtige lui werden door een peloton ME'ers naar het Centraal Station geleid. Een paar jaar later kwam ik er via nieuwsberichten en foto's achter dat meer dan de helft van die jongens is omgekomen in Syrië."
                            }
                        ]
                    },
                    {
                        "sense_id": "186d5608-230b-3b6b-9c4e-7b6fb920e4ae",
                        "entry_id": "b5ffdff6-f53d-34c4-83ab-5d69357a5051",
                        "glosses": [
                            "aanhoudend luid lachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b555180b-f2a1-46d1-a970-6eca356ccf47",
                                "sense_id": "186d5608-230b-3b6b-9c4e-7b6fb920e4ae",
                                "text": "Aan het eind van de gang hoor ik gebulder. Het is Kafka die zich de ballen uit zijn broek lacht."
                            }
                        ]
                    },
                    {
                        "sense_id": "a471ef14-2b3a-3249-85e6-72b1022e2760",
                        "entry_id": "b5ffdff6-f53d-34c4-83ab-5d69357a5051",
                        "glosses": [
                            "aanhoudend zeer veel lawaai maken door de wind, een storm of zware regenbui"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
