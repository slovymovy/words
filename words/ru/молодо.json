    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "54677558-6935-3419-9f6b-31e62618285f",
                    "sense_definition": "Свойственно молодости, по-юношески или свежо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "возраст_и_вид",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для своих преклонных лет он выглядит удивительно <w>молодо</w>.",
                            "target_lang_translations": {
                                "pl": "Jak na swój podeszły wiek wygląda zadziwiająco <w>młodo</w>."
                            }
                        },
                        {
                            "text": "Она улыбнулась так <w>молодо</w> и открыто, что все вокруг заулыбались в ответ.",
                            "target_lang_translations": {
                                "pl": "Uśmiechnęła się tak <w>młodzieńczo</w> i otwarcie, że wszyscy wokół odwzajemnili uśmiech."
                            }
                        }
                    ],
                    "synonyms": [
                        "юно"
                    ],
                    "antonyms": [
                        "старо"
                    ],
                    "common_phrases": [
                        "выглядеть молодо"
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób charakterystyczny dla młodości, młodzieńczo lub świeżo."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "młodo",
                                "target_lang_sense_clarification": "świeżo, młodzieńczo"
                            },
                            {
                                "target_lang_word": "młodzieńczo",
                                "target_lang_sense_clarification": "z energią lub wyglądem młodego człowieka"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76381955-b409-36d2-b7a0-22fe2ff010eb",
                    "sense_definition": "Краткая форма среднего рода единственного числа от прилагательного <w>молодой</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "возраст_и_вид",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его лицо было чисто и <w>молодо</w>, несмотря на все пережитые испытания.",
                            "target_lang_translations": {
                                "pl": "Jego twarz była czysta i <w>młoda</w>, pomimo wszystkich przeżytych trudów."
                            }
                        },
                        {
                            "text": "Дерево ещё совсем <w>молодо</w> и поэтому пока не даёт плодов.",
                            "target_lang_translations": {
                                "pl": "Drzewo jest jeszcze całkiem <w>młode</w> i dlatego na razie nie owocuje."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Krótka forma przymiotnika rodzaj nijaki liczby pojedynczej od «молодой» (młody)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "młode",
                                "target_lang_sense_clarification": "w odniesieniu do rzeczownika rodzaju nijakiego"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9a9407fe-cd2d-3507-a91e-b4805d077896",
                    "sense_definition": "Река в Якутии, левый приток реки Оленёк.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Река <w>Молодо</w> течёт по территории Якутии в условиях сурового климата.",
                            "target_lang_translations": {
                                "pl": "Rzeka <w>Mołodo</w> płynie przez terytorium Jakucji w warunkach surowego klimatu."
                            }
                        },
                        {
                            "text": "В летний период русло <w>Молодо</w> привлекает любителей водного туризма и рыбалки.",
                            "target_lang_translations": {
                                "pl": "W okresie letnim koryto rzeki <w>Mołodo</w> przyciąga miłośników turystyki wodnej i wędkarstwa."
                            }
                        }
                    ],
                    "common_phrases": [
                        "река Молодо"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rzeka w Jakucji, lewy dopływ Olenioka."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Mołodo",
                                "target_lang_sense_clarification": "nazwa własna rzeki w Rosji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}