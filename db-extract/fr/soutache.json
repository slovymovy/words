                                            {
                                                "example_id": "d244b388-7a7c-425e-a09c-9ab9fa65bfe9",
                                                "sense_id": "0143fee5-7616-3dfc-9974-894a558587b0",
                                                "text": "Het onderscheidingsteken voor dienstjaren is voor elke 6 dienstjaren een rode chevron met witte soutache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5b303d4-7d81-37ae-8c61-f2703707c903",
                                        "entry_id": "f1750562-3f58-3076-82ce-2a6b56f6289b",
                                        "glosses": [
                                            "opgestikte smalle gevlochten band ter versiering en versteviging",
                                            "op dameskleding"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bde9c858-84c3-4c3f-99d4-1cdb39e9a050",
                                                "sense_id": "e5b303d4-7d81-37ae-8c61-f2703707c903",
                                                "text": "Soutache is een smal plat zijden of kunstzijden koord, per meter verkrijgbaar in allerlei mooie tinten. Met mate en smaak op een japon aangebracht geeft soutache een mooie afwerking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c30917e2-8eac-3524-b1a4-69c4c5e57d8b",
                                        "entry_id": "f1750562-3f58-3076-82ce-2a6b56f6289b",
                                        "glosses": [
                                            "opgestikte smalle gevlochten band ter versiering en versteviging",
                                            "op andere voorwerpen van textiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae6e58d-3549-4aee-9202-84d0a2bd3ae0",
                                                "sense_id": "c30917e2-8eac-3524-b1a4-69c4c5e57d8b",
                                                "text": "Dit taschje knipt men van laken, twee lappen even groot als No. A. Aan den buitenkant werkt men van zijde of soutache een randje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20bf25b2-cb39-38bd-82b9-0dc9bd4bac91",
