                "senses": [
                    {
                        "sense_id": "c433779e-1844-3d23-a01e-397f6e1757fe",
                        "entry_id": "6ab5f554-f84d-380e-92cb-a67ea51a6a55",
                        "glosses": [
                            "A subspecies of baboon, Papio cynocephalus kindae, primarily found in Angola, the Democratic Republic of the Congo, Zambia, and possibly western Tanzania."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f0ceb8-0167-4661-9709-696caef2ecd1",
                                "sense_id": "c433779e-1844-3d23-a01e-397f6e1757fe",
                                "text": "In the wild, when a baboon called a kinda pairs with a chacma or yellow baboon, their progeny is still a baboon — but it's a hybrid of interest to Society grantees Jane Phillips-Conroy and Clifford Jolly, who are tracking gene flow in Zambia's South Luangwa National Park."
                            }
                        ]
                    }
                ],
