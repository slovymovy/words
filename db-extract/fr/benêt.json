                    },
                    {
                        "translation_id": "72e1166b-bc3f-4c38-be96-d5a7087bc045",
                        "source_entry_id": "a0b86728-98e8-3730-b32a-1127a1588139",
                        "source_sense_id": "5b64a34a-e7d0-36ca-ae90-c5c82318e8c7",
                        "source_sense_description": "Sot",
                        "target_lang_word": "Blödian",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blödian",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                        "entry_id": "9cca6c6b-336d-33ab-97b4-145099de777d",
                                        "glosses": [
                                            "dummer Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783beffb-578d-4c30-bdea-b94cc00ce6a6",
                                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                                "text": "„Auf dem Plakat ist ein Blödian in Hippie-Outfit zusehen, der seine zu einem Victory-Zeichen gespreizten Finger mit Aufschnitt umwickelt hat.“"
                                            },
                                            {
                                                "example_id": "59e8a379-194a-4dda-8305-ec410757fb7f",
                                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                                "text": "„Er hatte einen enormen Misthaufen von Blödian dabei.“"
                                            },
                                            {
                                                "example_id": "632afa89-63c7-4584-a8e1-3b2fb79132b0",
                                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                                "text": "„Aber wie es so geht – hin und wieder tauchte doch mal ein richtig ausgekochter Blödian auf – einer, der neunzig Prozent seines Lebens seiner Wirbelsäule verdankte – und fing immer wieder damit an, bis schließlich sogar Mr. McAllister es nicht länger mit anhören konnte.“"
                                            },
                                            {
                                                "example_id": "422975ab-8cce-4b24-8773-1f483e0da20f",
                                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                                "text": "„Dieser Blödian in der Feldkommandantur wußte ja nicht einmal, wo die Straße gesperrt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a252d1b-90f9-4164-b432-2801f26fcf6a",
                        "source_entry_id": "a0b86728-98e8-3730-b32a-1127a1588139",
                        "source_sense_id": "5b64a34a-e7d0-36ca-ae90-c5c82318e8c7",
                        "source_sense_description": "Sot",
                        "target_lang_word": "Dumpfbacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dumpfbacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                        "entry_id": "a7566c3c-56ac-33af-ad07-ff10594d08bc",
                                        "glosses": [
                                            "naive, törichte und dumme Person, die es an jeglichem Einfühlungsvermögen gegenüber Mitmenschen fehlen lässt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f57a8b4-c33f-411b-8c6a-afad8e3d440d",
                                                "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                                "text": "„Mit drastischen Worten haben die Bundesminister Steinmeier und Schäuble vor Stimmungsmache mit den Ängsten der Bürger gewarnt. Steinmeier bezeichnete dies als „geistige Brandstiftung“. Sein Kabinettskollege warnte vor dem Wetteifern mit „Dumpfbacken“.“"
                                            },
                                            {
                                                "example_id": "84dcd6e1-49d1-4317-b95d-40033bae026e",
                                                "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                                "text": "Du bist eine Dumpfbacke!"
                                            },
                                            {
                                                "example_id": "160351c1-aac6-48df-8018-32e7da195bfb",
