                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1de110dc-ccb6-3afb-87aa-5350765d33f9",
                                        "entry_id": "0212a5ec-3de6-3ee1-b386-957a5efd8b43",
                                        "glosses": [
                                            "Variante orthographique de akène."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
