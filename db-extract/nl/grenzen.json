                        "examples": [
                            {
                                "example_id": "0c607368-b9ce-4ad0-96cd-1f811c3a4e39",
                                "sense_id": "7ad9b1c0-b88d-36e8-94c4-1897e07b71ac",
                                "text": "Luxemburg grenst aan België, Frankrijk en Duitsland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe1dd5bd-f67f-4012-98f3-7082f89f97f1",
