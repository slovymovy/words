                "senses": [
                    {
                        "sense_id": "a1e9794e-1dcc-349d-be9c-0507ef3fcca1",
                        "entry_id": "a2da3625-13d6-31d0-a35d-bf74a078240b",
                        "glosses": [
                            "Extrêmement performant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82dc59f-b18d-4f14-b9f0-00fde9fcf1f6",
                                "sense_id": "a1e9794e-1dcc-349d-be9c-0507ef3fcca1",
                                "text": "Les plates-formes que nous utilisons aujourd’hui sont, toutes choses égales par ailleurs, ultra-fiables et ultra-performantes comparées au logiciel."
                            },
                            {
                                "example_id": "0d2b97fd-25b1-471c-8c98-9f8d1e348774",
                                "sense_id": "a1e9794e-1dcc-349d-be9c-0507ef3fcca1",
                                "text": "Pour certains adultes, cette société ultratechnologisée, ultra-informatisée, ultra-performante et surinformée, a des effets insidieux qui conduisent à la paupérisation des relations humaines et probablement à l’érosion éducative."
                            },
                            {
                                "example_id": "ee168fd0-dd07-4cf0-978b-237de6c56cac",
                                "sense_id": "a1e9794e-1dcc-349d-be9c-0507ef3fcca1",
                                "text": "C’est, notamment, grâce à des moyens de calculs ultra-performants que nous avons pu réaliser les moyens de transports révolutionnaires conduisant jusqu’à la lune et la diffusion massive des biens de confort."
                            }
                        ]
                    }
