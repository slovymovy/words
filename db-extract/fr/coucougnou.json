                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7ee83320-5949-4ff5-b27d-1ff6ab1896a1",
                                "sense_id": "ced90e3b-c65e-332a-9e52-9bfc949b3a49",
                                "text": "@ANDA Phill Parfait\n koi d neuf coucougnou"
                            },
                            {
                                "example_id": "5a9905b5-f0d5-4926-ba11-3f4fc8f86c9c",
                                "sense_id": "ced90e3b-c65e-332a-9e52-9bfc949b3a49",
                                "text": "C’est l’hiver coucougnou !"
                            },
                            {
                                "example_id": "163ec735-d2c2-4704-b037-ab853ed23352",
                                "sense_id": "ced90e3b-c65e-332a-9e52-9bfc949b3a49",
                                "text": "D’accord arobase le coucougnou"
                            },
                            {
                                "example_id": "7bcb7059-61bf-4c74-acf8-3c9ab5fa3e25",
                                "sense_id": "ced90e3b-c65e-332a-9e52-9bfc949b3a49",
                                "text": "Espèce de coucougnou va même pas capable de dire une bonne phrase."
                            }
