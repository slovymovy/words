                        "glosses": [
                            "Plat gallois à base de cheddar fondu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3961b9d1-f5e1-4d6e-8b18-4c5d3c5a714b",
                                "sense_id": "e3fa5120-4d13-3f45-b653-8411a0516bc7",
                                "text": "De son côté le maître d’hôtel Charles qui a un bon et rond visage, un empressement affectueux et l’habitude de la clientèle, veillait à la confection du welsh-rarebit ou du bœuf en salade, auxquels recouraient volontiers nos appétits creusés par un dîner en ville et les vaines conversations du fumoir."
                            },
                            {
                                "example_id": "857154fb-ed8e-46ce-a00e-7f25cd7cc3da",
                                "sense_id": "e3fa5120-4d13-3f45-b653-8411a0516bc7",
                                "text": "Le welsh-rarebit était à un franc."
                            },
                            {
                                "example_id": "87a31ccc-e2a2-4999-bf5f-e73ee692d72a",
                                "sense_id": "e3fa5120-4d13-3f45-b653-8411a0516bc7",
                                "text": "Le garçon m’apporta un welsh-rarebit et un verre de pouilly-ladoucette."
                            }
                        ]
                    }
