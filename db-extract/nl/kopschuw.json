                "translations": [
                    {
                        "translation_id": "94ffb45a-1395-4d5b-a850-92331653b4fa",
                        "source_entry_id": "1cb2d8a5-309c-391c-8088-1bfaaf2ed717",
                        "source_sense_id": "29955f46-2fe4-33d2-9d5d-315713c5ea9d",
                        "target_lang_word": "afraid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afraid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de85db87-83a7-313f-9cd6-edba28ce7a67",
                                        "entry_id": "814ea8c6-dbb9-3d1f-be40-22ad078f9bf4",
                                        "glosses": [
                                            "Impressed with fear or apprehension; in fear."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dcfb7b5-9757-4ab2-b644-efcbd6a1c4fe",
                                                "sense_id": "de85db87-83a7-313f-9cd6-edba28ce7a67",
                                                "text": "He is afraid of death."
                                            },
                                            {
                                                "example_id": "37770e3b-39fa-4fb5-b2c7-ea83c0eecd37",
                                                "sense_id": "de85db87-83a7-313f-9cd6-edba28ce7a67",
                                                "text": "He is afraid to ask her out."
                                            },
                                            {
                                                "example_id": "c9946177-bd63-4ee5-97b1-50307b6beb8a",
                                                "sense_id": "de85db87-83a7-313f-9cd6-edba28ce7a67",
                                                "text": "He is afraid of the future."
                                            },
                                            {
                                                "example_id": "792b45cc-b34e-4cad-b9f8-71442c84ea0c",
                                                "sense_id": "de85db87-83a7-313f-9cd6-edba28ce7a67",
                                                "text": "I’m not afraid of telling / to tell you the truth: I'm reluctant to go in you car because I’m too afraid of crashing."
                                            },
                                            {
                                                "example_id": "06a79046-99c2-43ab-9cd9-8cf4a8db499e",
                                                "sense_id": "de85db87-83a7-313f-9cd6-edba28ce7a67",
                                                "text": "I went through the worst Ku Klux proposition in the country at the time it was at its height. And I had to go down to the Ku Klux meeting and tell them what I thought of them, and I wasn't afraid of them at all. And I'm not afraid of this situation because I think it'll work out in a way that when these people sit down and get a chance to think and study the situation, they're going to be ashamed of some of the things they've done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f3059ac-d8f7-3341-8c57-8a654a93fbd7",
                                        "entry_id": "814ea8c6-dbb9-3d1f-be40-22ad078f9bf4",
                                        "glosses": [
                                            "Regretful, sorry; expressing a reluctance to face an unpleasant situation."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e199621-f3c9-4ee7-b9b8-cb8d18f855ca",
                                                "sense_id": "6f3059ac-d8f7-3341-8c57-8a654a93fbd7",
                                                "text": "I am afraid I cannot help you in this matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0a0828f-5f23-3d4f-a656-1dca0b21ad3b",
                                        "entry_id": "814ea8c6-dbb9-3d1f-be40-22ad078f9bf4",
                                        "glosses": [
                                            "Worried about, feeling concern for, fearing for (someone or something)."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed3b7281-fd11-4022-9af8-b56e8f14d5a2",
                        "source_entry_id": "1cb2d8a5-309c-391c-8088-1bfaaf2ed717",
                        "source_sense_id": "29955f46-2fe4-33d2-9d5d-315713c5ea9d",
                        "target_lang_word": "fearful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fearful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57739382-f0e1-34ee-b4a7-b834a68e82df",
                                        "entry_id": "d52fbcc3-92b7-3d5f-8fa1-03097f3da578",
                                        "glosses": [
                                            "Frightening; causing fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be41e871-4f55-4fce-96b5-b98646dc0820",
                                                "sense_id": "57739382-f0e1-34ee-b4a7-b834a68e82df",
                                                "text": "Sirs, stop their mouths, let them not speak to me,\nBut let them hear what fearful words I utter."
                                            },
                                            {
                                                "example_id": "6660a689-a025-481e-8779-2ebcdb92969c",
                                                "sense_id": "57739382-f0e1-34ee-b4a7-b834a68e82df",
                                                "text": "In the later Hebrew midrash Lilith is presented as the woman who knows how to recite the fearful name of God to work calamity; that this little girl cries out the fearful name of the sun god and thereby causes an earthquake would indicate that this girl is linked in the structure of the myth with Lilith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f1ea97a-54d9-36b9-b42e-e7a9a692e867",
                                        "entry_id": "d52fbcc3-92b7-3d5f-8fa1-03097f3da578",
                                        "glosses": [
                                            "Tending to fear; timid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acbba78c-fec1-42b2-bda4-c9c31686d6b7",
                                                "sense_id": "6f1ea97a-54d9-36b9-b42e-e7a9a692e867",
                                                "text": "a fearful boy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1d956c5-1812-3215-b615-f25ff0466185",
                                        "entry_id": "d52fbcc3-92b7-3d5f-8fa1-03097f3da578",
                                        "glosses": [
                                            "Terrible; shockingly bad."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f759f5-53d6-471c-8add-a60fad61da5b",
                                                "sense_id": "f1d956c5-1812-3215-b615-f25ff0466185",
                                                "text": "But every day after dinner, for an hour, we were all together, and then the Favourite and the rest of the Royal Hareem competed who should most beguile the leisure of the Serene Haroun reposing from the cares of State — which were generally, as in most affairs of State, of an arithmetical character, the Commander of the Faithful being a fearful boggler at a sum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "216c9d5d-019c-3c9f-9e7e-1d87f5cda136",
                                        "entry_id": "d52fbcc3-92b7-3d5f-8fa1-03097f3da578",
                                        "glosses": [
                                            "Frightened; filled with terror."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ad73032-828f-422a-87ab-54dc6336778f",
                                                "sense_id": "216c9d5d-019c-3c9f-9e7e-1d87f5cda136",
                                                "text": "kings ſhall crouch vnto our conquering ſwords,\nAnd hoſtes of Souldiers ſtand amazd at vs,\nWhen with their fearfull tongues they ſhall confeſſe\nTheſe are the men that al the world admires,"
                                            },
                                            {
                                                "example_id": "4d7f792f-848d-48d9-99c6-e1808a16465a",
                                                "sense_id": "216c9d5d-019c-3c9f-9e7e-1d87f5cda136",
                                                "text": "Those two great champions did attonce pursew / The fearefull damzell with incessant payns […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fearful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a41a3b64-37b1-3b83-a8af-b4ec72d66b59",
                                        "entry_id": "7e2b64df-f4d9-3469-94a8-3031097bc4bd",
                                        "glosses": [
                                            "Extremely; fearfully."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82e2baae-7359-4828-b2dc-5c4864dc1f9f",
                                                "sense_id": "a41a3b64-37b1-3b83-a8af-b4ec72d66b59",
                                                "text": "“He is fearful handsome, as you know,” she said remorsefully, “you cannot imagine, Georgiana, the joy when I first fell in love with him.”"
                                            },
                                            {
                                                "example_id": "8e96bdee-e266-4af5-a71f-925595f51741",
                                                "sense_id": "a41a3b64-37b1-3b83-a8af-b4ec72d66b59",
                                                "text": "“It's a fearful strong charm needs dragon's blood,” he said plaintively."
                                            },
                                            {
                                                "example_id": "8113104b-84bd-47bc-9d98-ebd6bd1182cb",
                                                "sense_id": "a41a3b64-37b1-3b83-a8af-b4ec72d66b59",
                                                "text": "His Dardanelles expedition gave the Turk a fearful long start."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
