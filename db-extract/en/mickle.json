                        ],
                        "examples": [
                            {
                                "example_id": "763a9c6a-11be-485a-a941-4fda62d75dc6",
                                "sense_id": "6ba7d2b8-9bcf-321a-aa7f-74fe3f0cebdc",
                                "text": "Seek mickle, and get ſomething; ſeek little, and get nothing."
                            }
                        ]
