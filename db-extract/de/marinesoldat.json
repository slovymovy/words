                ],
                "senses": [
                    {
                        "sense_id": "92f7e6db-2782-3c98-896e-dc2970d9baa4",
                        "entry_id": "6649cab7-51b6-3fd8-a5ac-6d1d5a7cfa3f",
                        "glosses": [
                            "Soldat der Marine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b00d856-ec4d-4dc0-aa03-72d81cf8d404",
                                "sense_id": "92f7e6db-2782-3c98-896e-dc2970d9baa4",
                                "text": "Mit neunzehn Jahren wurde er Marinesoldat."
                            },
                            {
                                "example_id": "2b13e04b-2cc4-43e8-ab1c-274216553da4",
                                "sense_id": "92f7e6db-2782-3c98-896e-dc2970d9baa4",
                                "text": "„Cook befahl einer Gruppe von Marinesoldaten, eine Schutzlinie hinter ihm zu bilden, dann näherte er sich in Begleitung einiger Gentlemen dem Fluss.“"
                            },
                            {
                                "example_id": "0dc45e2e-e3ad-402c-992d-30f94a72e353",
                                "sense_id": "92f7e6db-2782-3c98-896e-dc2970d9baa4",
                                "text": "„Am Kai trafen wir eine große Gruppe Marinesoldaten, die unter Major Smith anrückten.“"
                            },
                            {
                                "example_id": "0846ff9f-ddff-42f2-aaa8-210c9c3b4e3d",
                                "sense_id": "92f7e6db-2782-3c98-896e-dc2970d9baa4",
                                "text": "„Jeder zukünftige Marinesoldat sollte das einmal erfahren haben, um so, wahrlich gestählt, in den Kampf zu ziehen.“"
                            },
                            {
                                "example_id": "ba747756-d440-453b-ab87-68ccb4c8826e",
                                "sense_id": "92f7e6db-2782-3c98-896e-dc2970d9baa4",
                                "text": "„Die Marinesoldaten, die Posten stehen müssen, sehen hingegen mit Koppel und Seitengewehr übertrieben martialisch aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
