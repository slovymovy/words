                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <drawn> a picture of my house for the art class.",
                            "target_lang_translations": {
                                "ru": "Я <нарисовал> картину своего дома для урока рисования.",
                                "pl": "<Narysowałem> obrazek mojego domu na lekcję plastyki.",
                                "es": "He <dibujado> una imagen de mi casa para la clase de arte."
                            }
                        },
                        {
                            "text": "The curtains were <drawn> to keep the room cool and dark.",
                            "target_lang_translations": {
                                "ru": "Шторы были <задернуты>, чтобы сохранить в комнате прохладу и темноту.",
                                "pl": "Zasłony zostały <zaciągnięte>, aby w pokoju było chłodno i ciemno.",
                                "es": "Las cortinas estaban <corridas> para mantener la habitación fresca y oscura."
                            }
