                    {
                        "sense_id": "05924161-ab9e-3bac-aa8a-8160bd38deb3",
                        "entry_id": "564bdd53-a867-353b-abd5-be34dd05e149",
                        "glosses": [
                            "ein Land in Vorderasien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7159671-1ab7-4eaa-a38e-c951e677cd82",
                                "sense_id": "05924161-ab9e-3bac-aa8a-8160bd38deb3",
                                "text": "Mit dem geringen Jahresniederschlag von unter 100 mm gehört Katar zu den trockensten Landschaften der Erde."
                            },
                            {
                                "example_id": "68ac05b9-fb71-4bdd-a26b-07560c926967",
                                "sense_id": "05924161-ab9e-3bac-aa8a-8160bd38deb3",
                                "text": "Doha ist die Hauptstadt von Katar."
                            },
                            {
                                "example_id": "aa27994a-c06f-4355-b8b9-9ef2598f028c",
                                "sense_id": "05924161-ab9e-3bac-aa8a-8160bd38deb3",
                                "text": "Das Katar der letzten Jahre war wirtschaftlich erfolgreich."
                            },
                            {
                                "example_id": "df8d0549-fbca-434f-9f75-90255372709d",
                                "sense_id": "05924161-ab9e-3bac-aa8a-8160bd38deb3",
                                "text": "„Donald Trump ist käuflich. Er verdient an der eigenen Kryptowährung und nimmt Geschenke aus Katar an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
