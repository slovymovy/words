                "senses": [
                    {
                        "sense_id": "5569e2f1-8c40-35e6-b9f5-f2db44aceca6",
                        "entry_id": "8334fd6a-cb0e-3b4b-a251-59f9729608ba",
                        "glosses": [
                            "in Körpern von Schweinen auftretender behülltes Virus mit einer einzelsträngigen, segmentierten RNA von negativer Polarität als Genom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9cfdc1-9180-4b90-9554-62e17f4a13a0",
                                "sense_id": "5569e2f1-8c40-35e6-b9f5-f2db44aceca6",
                                "text": "„Als letzte Barriere für das Schweinegrippevirus sollen sich die Menschen Zellstoff-Läppchen vor das Gesicht binden.“"
                            },
                            {
                                "example_id": "f3b5b738-fad5-4994-a141-f99ec72dea4b",
                                "sense_id": "5569e2f1-8c40-35e6-b9f5-f2db44aceca6",
                                "text": "„Im Juni 2009 löste ein verändertes Schweinegrippevirus eine Pandemie, die Neue Grippe, aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
