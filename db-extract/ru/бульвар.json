                    {
                        "form_id": "e365d200-99e9-49ca-84bb-46b55a077910",
                        "entry_id": "cf787501-bfca-3c40-aaef-54dbf8a2124f",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "бульва́рах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba265cbe-223f-3aa8-b86e-bd950220ed0b",
                        "entry_id": "cf787501-bfca-3c40-aaef-54dbf8a2124f",
                        "glosses": [
                            "широкая, обсаженная деревьями аллея, дорога для прогулок, идущая по линии прежнего крепостного вала или вдоль городской улицы, берега моря и т. п. (первоначально в Париже, а с конца XIX века и в других городах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a6acbe1-e3d7-4d1c-8a50-99a58c455980",
                                "sense_id": "ba265cbe-223f-3aa8-b86e-bd950220ed0b",
                                "text": "Тогда на месте нынешних Конногвардейских казарм простиралась перед этим домом площадь до самого Крюкова канала, теперь засыпанного, с устроенным над ним бульваром."
                            },
                            {
                                "example_id": "7496d23a-7d11-4fe8-bbf2-1267a2c4b5dd",
                                "sense_id": "ba265cbe-223f-3aa8-b86e-bd950220ed0b",
                                "text": "В качестве примера приведу бульвар на центральной улице Ленина, который реконструировали к чемпионату: высадили деревья, сделали лавочки, заменили дорожное покрытие на тротуаре."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e9da97c-e475-3b89-9bb6-b7d37b59cf3b",
                        "entry_id": "cf787501-bfca-3c40-aaef-54dbf8a2124f",
                        "glosses": [
                            "название городской улицы, вдоль которой проложен бульвар [1]; в некоторых населённых пунктах — название любой широкой, благоустроенной улицы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "526d2034-436b-42bd-a856-cf645d4e6278",
                                "sense_id": "3e9da97c-e475-3b89-9bb6-b7d37b59cf3b",
                                "text": "Но, к её досаде, строгий надзор матери и острая наблюдательность услужливых соседок замкнули её свободу в тесное пространство, ограниченное квадратом, образуемым четырьмя улицами: улицей Ранеляг, авеню Мозар, улицей Ассомпсьон и бульваром Босежур."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1e5d147-27da-34a2-b094-5f6e571a6ece",
                        "entry_id": "cf787501-bfca-3c40-aaef-54dbf8a2124f",
                        "glosses": [
                            "истор. сомкнутые земляные укрепления, применявшиеся в XV в. при осадах"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e9636d5-f98b-4731-a3a7-3979a0c458e3",
                        "source_entry_id": "cf787501-bfca-3c40-aaef-54dbf8a2124f",
                        "target_lang_word": "boulevard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boulevard",
