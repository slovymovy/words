                            {
                                "example_id": "cbabe252-fba0-4bbe-b2e0-858b7403f132",
                                "sense_id": "4a534d99-0504-3631-be3b-6bfaaf23734c",
                                "text": "De Russische minister van Defensie stelt dat een tak van het Russische Reconciliatie Centrum in de noordwestelijke Afrin is ingezet om verdere escalatie in het gebied te voorkomen. Volgens het ministerie is het de bedoeling dat het centrum het contact tussen de Koerdische milities en het door Turkije ondersteunde Vrije Syrische Leger gaat onderhouden."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e0d43d3-f00d-3da7-9f83-db05bbaed107",
                        "entry_id": "421b4692-41b6-38a8-9066-93eb4dd12673",
                        "glosses": [
                            "vergelijkingsproces of twee gerelateerde handelingen in een boekhouding met elkaar in balans zijn, het opsporen van verschillen indien dit niet het geval is en het oplossen van die boekhoudkundige verschillen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e85ad21f-70a9-4a40-8d3d-d380ce86e8cb",
                                "sense_id": "3e0d43d3-f00d-3da7-9f83-db05bbaed107",
                                "text": "„We houden ons al jaren bezig met blockchaintechnologie, waarbij we mogelijkheden zien voor gedeelde processen en gegevens tussen marktdeelnemers, clearing, afwikkeling en reconciliatie en vereenvoudigde effectenuitgifte.”"
                            }
                        ]
                    }
