                "senses": [
                    {
                        "sense_id": "9c559687-cade-3e36-a754-6e60fc9c3a09",
                        "entry_id": "885404c7-3d44-390a-87de-7955e96f5f7b",
                        "glosses": [
                            "Any of the many beetles of the family Buprestidae, which in the larval stage are destructive wood borers and as adults are often brightly coloured."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4191ba6-4231-42ea-a158-082436965646",
                                "sense_id": "9c559687-cade-3e36-a754-6e60fc9c3a09",
                                "text": "Other species are recognized pests, and various buprestids attack either living or dead trees."
                            },
                            {
                                "example_id": "de6bcbd3-c601-487a-b107-3872290e997d",
                                "sense_id": "9c559687-cade-3e36-a754-6e60fc9c3a09",
                                "text": "The buprestid Capnodis tenebrionis L. is a major root pest of cherries and other stone fruits in semiarid areas of southern Europe, around the Mediterranean, and Asia Minor."
                            },
                            {
                                "example_id": "3f0d5269-a821-49ab-96b4-ec6f143682fc",
                                "sense_id": "9c559687-cade-3e36-a754-6e60fc9c3a09",
                                "text": "An example is the golden buprestid (Buprestis aurulenta), a brilliant copper-colored beetle that bores into living pines, firs, Douglas-fir, spruces, and other conifers in the western mountains. Its pest rating is high."
                            }
                        ]
                    }
                ],
