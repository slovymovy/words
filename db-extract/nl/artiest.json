                        "sense_id": "a8db27bb-79ce-36f1-8a4c-20243e487185",
                        "entry_id": "b6db4409-f0e2-39da-853a-a170859b0333",
                        "glosses": [
                            "iemand die zijn creatieve talenten gebruikt om kunst te maken, uitvoerend kunstenaar"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "34942044-49bf-45dc-91e4-5b506d432f97",
                                "sense_id": "a8db27bb-79ce-36f1-8a4c-20243e487185",
                                "text": "Het jonge meisje voelde zich al een hele artiest toen ze op de vrijmarkt speelde op haar viool."
                            },
                            {
                                "example_id": "610b6aa6-b53c-4a05-9141-fdde1077b74b",
                                "sense_id": "a8db27bb-79ce-36f1-8a4c-20243e487185",
                                "text": "'Scènes uit een trans-Atlantisch huwelijk Hbib was ook ooit artiest geweest, al had hij dat zelf nooit zo genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0648ec02-f1d0-461a-89c9-629174161cea",
                        "source_entry_id": "b6db4409-f0e2-39da-853a-a170859b0333",
                        "source_sense_id": "a8db27bb-79ce-36f1-8a4c-20243e487185",
                        "target_lang_word": "Künstler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Künstler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcea44c9-463c-3577-a616-ac855a2eb44b",
                                        "entry_id": "dc5cddcf-7979-3c5a-bdf1-3dca856f7d44",
                                        "glosses": [
                                            "Person, die oft, vielleicht beruflich, Kunstwerke erschafft oder kreativen Tätigkeiten nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3055415c-b123-4114-9c83-b97312c241f2",
                                                "sense_id": "bcea44c9-463c-3577-a616-ac855a2eb44b",
                                                "text": "Nicht nur Künstler produzieren Kunst."
                                            },
                                            {
                                                "example_id": "d1ec00d7-9b4f-4f3c-8c69-9a97c2ab05c5",
                                                "sense_id": "bcea44c9-463c-3577-a616-ac855a2eb44b",
                                                "text": "„Nicht nur Literaten, auch bildende Künstler stellten sich begeistert in den Dienst der kolonialen Sache.“"
                                            },
                                            {
                                                "example_id": "869187ac-d6ee-41a2-8501-9806ca5b0001",
                                                "sense_id": "bcea44c9-463c-3577-a616-ac855a2eb44b",
                                                "text": "„Und natürlich dachte der Künstler schon bald daran, seinen neuen Freund zu porträtieren.“"
                                            },
                                            {
                                                "example_id": "cb8a6059-342c-44cb-983e-469235d94c09",
                                                "sense_id": "bcea44c9-463c-3577-a616-ac855a2eb44b",
                                                "text": "„Kurt Schwitters ist heute sicherlich der bekannteste Künstler aus Hannover.“"
                                            },
                                            {
                                                "example_id": "4c0f8a41-7d26-4e33-b184-e8608cc544d5",
                                                "sense_id": "bcea44c9-463c-3577-a616-ac855a2eb44b",
                                                "text": "„Unter den Künstlern war Janoschs Vorbild Paul Klee, mit dem ihn die Vorliebe für reine, klare Grundfarben verbindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f80b5563-acae-3e0c-b9e5-e18b4dbf64a0",
                                        "entry_id": "dc5cddcf-7979-3c5a-bdf1-3dca856f7d44",
                                        "glosses": [
                                            "ein Mensch mit einer besonderen Begabung in einem bestimmten Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aff0d100-a90d-4d86-a34b-75b3d52d6487",
                                                "sense_id": "f80b5563-acae-3e0c-b9e5-e18b4dbf64a0",
                                                "text": "Auf dem Skateboard ist Ahlff ein wahrer Künstler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
