                "senses": [
                    {
                        "sense_id": "9c866ce9-94bf-324f-83e7-60c5640dbc4c",
                        "entry_id": "bad63da6-ff07-37e4-85d9-8b32a27baa3f",
                        "glosses": [
                            "имеющий, получивший лёгкое, не угрожающие жизни ранение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b62f4488-8182-4834-8ba3-38c9eb3725fe",
                                "sense_id": "9c866ce9-94bf-324f-83e7-60c5640dbc4c",
                                "text": "У входа в палатку поднялся с соломы легкораненый боец, молодой, бравый ― хоть под знамя ставь."
                            }
                        ]
                    },
                    {
                        "sense_id": "e575bbef-d2cc-344a-b0f0-68c23a3f3d5a",
                        "entry_id": "bad63da6-ff07-37e4-85d9-8b32a27baa3f",
                        "glosses": [
                            "субстантивир. тот, кто имеет лёгкое ранение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0217f9d5-7985-4919-b0ce-9255d0b23602",
                                "sense_id": "e575bbef-d2cc-344a-b0f0-68c23a3f3d5a",
                                "text": "Легкораненых размещали в госпиталях вблизи от фронта, лечили и снова отправляли на фронт."
                            }
                        ]
                    }
                ],
