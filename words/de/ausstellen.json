                    "frequency": "Low",
                    "semantic_group_id": "ausschalten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte <w>stell</w> den Fernseher <w>aus</w>, bevor du ins Bett gehst."
                        },
                        {
                            "text": "Wenn du den Raum verlässt, solltest du immer das Licht <w>ausstellen</w>."
