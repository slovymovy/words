                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63965a16-379f-36a9-a9bd-9376ea313a85",
                                        "entry_id": "efeea632-38d2-3b5b-b4c0-89837f4e50c6",
                                        "glosses": [
                                            "etwas zu einem späteren Zeitpunkt stattfinden lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46279145-d534-4a73-9373-b5516cf69634",
                                                "sense_id": "63965a16-379f-36a9-a9bd-9376ea313a85",
                                                "text": "Wir können das Treffen leider nicht verschieben."
                                            },
                                            {
                                                "example_id": "2f3e7409-9581-41ba-86d6-bec3cd69dd41",
                                                "sense_id": "63965a16-379f-36a9-a9bd-9376ea313a85",
                                                "text": "Meine Damen und Herren, leider verschiebt sich der Abflug um eine halbe Stunde."
                                            },
                                            {
                                                "example_id": "6e71d2e7-47f9-4cd4-8259-1ab81f4f2e00",
                                                "sense_id": "63965a16-379f-36a9-a9bd-9376ea313a85",
                                                "text": "Die Unterrichtsstunde fällt nicht aus, sie wird nur verschoben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d0a73744-063f-3dec-ad31-25dc28f5dddc",
                                        "entry_id": "efeea632-38d2-3b5b-b4c0-89837f4e50c6",
                                        "glosses": [
                                            "verbotenerweise Produkte auf einem schwarzen Markt veräußern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94cec69-a5c7-4516-b60c-278c95ee05a6",
                                                "sense_id": "d0a73744-063f-3dec-ad31-25dc28f5dddc",
                                                "text": "Mein Opa hat damals Zigaretten verschoben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8e9ab70b-2854-32a0-bd27-bc0cdd9d9f47",
                                        "entry_id": "efeea632-38d2-3b5b-b4c0-89837f4e50c6",
                                        "glosses": [
                                            "verändern von Gewichtungen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78a3f6da-0d7b-4c3b-91cb-0360a54e7782",
                                                "sense_id": "8e9ab70b-2854-32a0-bd27-bc0cdd9d9f47",
                                                "text": "Zwischenzeitlich haben sich leider meine Prioritäten verschoben, so dass aus dem Geschäft nichts mehr wird."
                                            },
                                            {
                                                "example_id": "77377f5c-bfe4-4ce6-9930-53d1c6694913",
