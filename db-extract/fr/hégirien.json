                "senses": [
                    {
                        "sense_id": "ddad3859-0d86-3ffb-a679-54ac980a3dee",
                        "entry_id": "f1869965-1fda-324f-8898-a3af16c418b6",
                        "glosses": [
                            "Relatif au calendrier lunaire musulman avec pour origine l’Hégire, soit le 16 juillet 622 dans le calendrier grégorien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f0336cc-6e6e-47d4-af48-7e778fdb2ba5",
                                "sense_id": "ddad3859-0d86-3ffb-a679-54ac980a3dee",
                                "text": "Les deux calendriers, hégirien et julien, sont également en usage chez les Touaregs."
                            },
                            {
                                "example_id": "c7e45f2b-6a9e-4949-82a0-dae8f704e543",
                                "sense_id": "ddad3859-0d86-3ffb-a679-54ac980a3dee",
                                "text": "En fait les paysans ont souvent vécu sur trois temps, l’hégirien, l’ajmi c’est-à-dire le julien, et le grégorien."
                            },
                            {
                                "example_id": "8ff5e2f7-0ffe-41f4-86d3-58de9c1af11f",
                                "sense_id": "ddad3859-0d86-3ffb-a679-54ac980a3dee",
                                "text": "L’addition du nombre de jours qui sépare la date donnée du 1ᵉʳ janvier avec le quantième d’année hégirien répondant au 1ᵉʳ janvier peut nous donner un nombre plus grand que le nombre de jours contenu dans l’année hégirienne correspondante."
                            }
                        ]
                    }
                ],
