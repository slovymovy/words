                                "fr": "Elle <w>téléphone</w> chaque semaine à sa mère à l'étranger.",
                                "it": "Lei <w>telefona</w> ogni settimana a sua madre all'estero.",
                                "cs": "Každý týden <w>telefonuje</w> se svou matkou v zahraničí.",
                                "tr": "Yurtdışındaki annesini her hafta <w>arıyor</w>.",
                                "es": "Ella <w>llama</w> a su madre en el extranjero todas las semanas."
                            }
                        },
                        {
                            "text": "Heb jij de dokter al <w>gebeld</w> voor een afspraak?",
                            "target_lang_translations": {
                                "en": "Have you <w>called</w> the doctor for an appointment yet?",
                                "ru": "Ты уже <w>позвонил</w> врачу, чтобы записаться на прием?",
                                "pl": "Czy <w>zadzwoniłeś</w> już do lekarza, żeby umówić się na wizytę?",
                                "de": "Hast du schon beim Arzt <w>angerufen</w>, um einen Termin zu vereinbaren?",
                                "fr": "As-tu déjà <w>appelé</w> le médecin pour un rendez-vous ?",
                                "it": "Hai già <w>chiamato</w> il medico per un appuntamento?",
                                "cs": "Už jsi <w>volal</w> lékaři, abys se objednal?",
                                "tr": "Randevu almak için doktoru çoktan <w>aradın</w> mı?",
                                "es": "¿Ya has <w>llamado</w> al médico para pedir una cita?"
                            }
                        }
