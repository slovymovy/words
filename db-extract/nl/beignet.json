                                                "sense_id": "fc36fbd2-d2a6-30c7-a693-b59851f09c3d",
                                                "text": "I was supposed to do work, but I frittered around all afternoon."
                                            },
                                            {
                                                "example_id": "9122a907-988f-42a5-a9dd-b3184c05098d",
                                                "sense_id": "fc36fbd2-d2a6-30c7-a693-b59851f09c3d",
                                                "text": "He can’t figure out how to finish the paper he’s writing, so he’s resorted to frittering with the fonts."
                                            },
                                            {
                                                "example_id": "2caaf446-bb71-4cd1-a931-6c966a30b056",
                                                "sense_id": "fc36fbd2-d2a6-30c7-a693-b59851f09c3d",
                                                "text": "It is quite possible to fritter one's life away in answer to the endless calls of others."
                                            }
                                        ]
