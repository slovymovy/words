                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2782828d-108f-4772-beee-0d1fea1cc2fe",
                                                "sense_id": "7b095008-a426-30ec-8aec-8783cb0f32ad",
                                                "text": "„An diesem Freitag musste der Aachener Traditionsverein beim örtlichen Amtsgericht Insolvenz anmelden.“"
                                            },
                                            {
                                                "example_id": "697a7887-8b7d-4f8d-b861-8317690acdd1",
                                                "sense_id": "7b095008-a426-30ec-8aec-8783cb0f32ad",
                                                "text": "„Immer mehr Menschen im Aachener Umland werden von Neonazis in Angst und Schrecken versetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
