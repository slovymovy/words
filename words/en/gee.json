{
    "word_family": [
        "gee-gee"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a81cdd93-2ea2-3a20-b20f-d5fb93d59204",
                    "sense_definition": "A general exclamation of surprise or frustration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Gee</w>, I did not know that!",
                            "target_lang_translations": {
                                "cs": "<w>Páni</w>, to jsem nevěděl!"
                            }
                        },
                        {
                            "text": "<w>Gee</w>, you did not have to kick me!",
                            "target_lang_translations": {
                                "cs": "<w>Teda</w>, nemusel jsi do mě kopat!"
                            }
                        }
                    ],
                    "synonyms": [
                        "gosh",
                        "wow"
                    ],
                    "common_phrases": [
                        "gee whiz"
                    ],
                    "target_lang_definitions": {
                        "cs": "Citoslovce vyjadřující překvapení, údiv nebo mírnou frustraci."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "páni",
                                "target_lang_sense_clarification": "vyjádření údivu nebo překvapení"
                            },
                            {
                                "target_lang_word": "teda",
                                "target_lang_sense_clarification": "vyjádření údivu nebo zdůraznění"
                            },
                            {
                                "target_lang_word": "jejda",
                                "target_lang_sense_clarification": "vyjádření mírného překvapení nebo politování"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b261f94-3249-33b7-8804-f9d1b34542bb",
                    "sense_definition": "A thousand dollars.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car cost me ten <w>gees</w>.",
                            "target_lang_translations": {
                                "cs": "To auto mě stálo deset <w>tisíc</w>."
                            }
                        },
                        {
                            "text": "He borrowed five <w>gees</w> to start his business.",
                            "target_lang_translations": {
                                "cs": "Půjčil si pět <w>tisíc</w> na rozjezd podnikání."
                            }
                        }
                    ],
                    "synonyms": [
                        "grand"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for money."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Slangové označení pro tisíc dolarů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "litr",
                                "target_lang_sense_clarification": "slangově tisíc korun nebo jednotek měny"
                            },
                            {
                                "target_lang_word": "tisícovka",
                                "target_lang_sense_clarification": "hovorové označení pro tisíc"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00527609-7984-3b0a-86aa-45a3cf3035d8",
                    "sense_definition": "A unit of acceleration equal to that exerted by gravity at the earth's surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot experienced high <w>gees</w> during the sharp turn.",
                            "target_lang_translations": {
                                "cs": "Pilot během ostré zatáčky zažil vysoké <w>přetížení</w>."
                            }
                        },
                        {
                            "text": "The rocket launch subjects the crew to several <w>gees</w>.",
                            "target_lang_translations": {
                                "cs": "Start rakety vystavuje posádku několika <w>géčkům</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Jednotka zrychlení odpovídající tíhovému zrychlení na povrchu Země."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "géčko",
                                "target_lang_sense_clarification": "hovorové označení pro násobek tíhového zrychlení"
                            },
                            {
                                "target_lang_word": "přetížení",
                                "target_lang_sense_clarification": "fyzikální stav vyjádřený v násobcích tíhového zrychlení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ffd8731-0dd4-3632-bd28-926ee4a5eb9e",
                    "sense_definition": "The name of the Latin-script letter G/g.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "alphabet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word goat starts with a <w>gee</w>.",
                            "target_lang_translations": {
                                "cs": "Slovo goat začíná na <w>gé</w>."
                            }
                        },
                        {
                            "text": "Make sure you write a capital <w>gee</w> at the start.",
                            "target_lang_translations": {
                                "cs": "Ujisti se, že na začátek napíšeš velké <w>gé</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Název písmene G v latinské abecedě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "gé",
                                "target_lang_sense_clarification": "název písmene G"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5bb956be-70a4-3de5-b75f-1c8451fe7d76",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Gee</w> is our new neighbor.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Gee</w> je náš nový soused."
                            }
                        },
                        {
                            "text": "The report was written by Dr. <w>Gee</w>.",
                            "target_lang_translations": {
                                "cs": "Zprávu napsal Dr. <w>Gee</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Gee",
                                "target_lang_sense_clarification": "příjmení (nepřekládá se)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}