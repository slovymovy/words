                    {
                        "sense_id": "ce8f817f-ddb4-3ee4-9ca7-4d4c1d7af072",
                        "entry_id": "eaeed498-41c9-3032-aaea-eff65cd35bd1",
                        "glosses": [
                            "Exitus, der eintritt, weil das Herz seinen Geist aufgibt"
