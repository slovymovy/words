                    },
                    {
                        "translation_id": "3b4442a8-4808-4d8e-9205-249b824395d1",
                        "source_entry_id": "51d51e4d-32b9-3da6-9bb1-12fd0053a960",
                        "source_sense_description": "to transform into bone",
                        "target_lang_word": "ossifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ossifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d59ee9c-7788-3cc0-94e0-3f7761134aae",
                                        "entry_id": "da9d969e-340a-3c3a-b130-484944851059",
                                        "glosses": [
                                            "Changer en substance osseuse les parties membraneuses et cartilagineuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f65526f3-5c4d-4627-a65e-9fc44433c03b",
                                                "sense_id": "9d59ee9c-7788-3cc0-94e0-3f7761134aae",
                                                "text": "Plusieurs causes contribuent à ossifier, dans la vieillesse, certaines parties du corps qui auparavant étaient molles. - Les membranes et les cartilages s’ossifient quelquefois."
                                            },
                                            {
                                                "example_id": "20cb99de-e45c-4aa5-afe6-68ec6a6789da",
                                                "sense_id": "9d59ee9c-7788-3cc0-94e0-3f7761134aae",
                                                "text": "Épuisé de fatigue, je retombai dans ma première torpeur, mes articulations s’ossifièrent : de nouveau je redevins cadavre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7428550-2cdd-31ad-bfdf-823bddfe40f2",
                                        "entry_id": "da9d969e-340a-3c3a-b130-484944851059",
                                        "glosses": [
                                            "Rendre dur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78703f9c-e5cd-49c1-823d-d1542c627f83",
                                                "sense_id": "d7428550-2cdd-31ad-bfdf-823bddfe40f2",
                                                "text": "Peu à peu le cœur de ces messieurs s'ossifie; le positif et l'utile sont tout pour eux, et leur âme se ferme à celui de tous les sentiments qui a le plus grand besoin de loisir …."
                                            },
                                            {
                                                "example_id": "b2d55bad-7688-4cf3-a616-78e037be1c2e",
                                                "sense_id": "d7428550-2cdd-31ad-bfdf-823bddfe40f2",
                                                "text": "Pierre. – Où est mon père ? Viens, Thomas ; point de larmes. Par le ciel ! mon cœur se serre comme s’il allait s’ossifier dans mes entrailles, et rester un rocher pour l’éternité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
