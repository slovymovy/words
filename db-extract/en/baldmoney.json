                        "sense_id": "b1407c9e-b76a-3b58-9280-78baf81371c3",
                        "entry_id": "8108886c-cac9-303f-8dd9-e2404fc15b81",
                        "glosses": [
                            "A Gentianeae tribe plant, gentian or felwort."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a6b54d60-59b8-44fe-b2d4-5c1875ba545f",
                                "sense_id": "b1407c9e-b76a-3b58-9280-78baf81371c3",
                                "text": "Gentius king of Illyria was the first founder of this herbe, and the first that used it in medicine, for which cause it was called Gentian after his own name: in Greek, γεντιανή, which name also the apothecaries retaine unto this daie, and call it Gentiana: it is named in English Felwoort Gentian; Bitterwoort; Baldmoyne, and Baldmoney."
                            }
                        ]
                    }
