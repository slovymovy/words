                "senses": [
                    {
                        "sense_id": "6324430c-d05e-3066-be4f-222a92198d0c",
                        "entry_id": "94749570-43a6-3165-bd5b-d8a2486b2adb",
                        "glosses": [
                            "рег. ссохшийся, покрывшийся плотной коркой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84a11d8d-87b3-4335-925e-5a2b5b349a71",
                                "sense_id": "6324430c-d05e-3066-be4f-222a92198d0c",
                                "text": "— Прошлый год мы пахали — земля как хрящ, до бесконца краю клёклая."
                            }
                        ]
                    },
                    {
                        "sense_id": "15e3855b-a7cb-3984-b589-938b2feedf8d",
                        "entry_id": "94749570-43a6-3165-bd5b-d8a2486b2adb",
                        "glosses": [
                            "рег. непропечённый; тяжёлый, плотный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed828ed5-9736-404b-93fa-e843e604e9c4",
                                "sense_id": "15e3855b-a7cb-3984-b589-938b2feedf8d",
                                "text": "Тесто получилось какое-то клёклое, и начинка выползла наружу."
                            }
                        ]
                    }
