                                        "entry_id": "8945ec5b-c0fa-3d7a-bba9-844244bd56ad",
                                        "glosses": [
                                            "Soldat, der in der Artillerie dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26932eab-d35c-47ca-b93c-7d51c5159dc4",
                                                "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                                "text": "„Nachdem sich der Rauch verzogen hat, können die Artilleristen wieder schießen.“"
                                            },
                                            {
                                                "example_id": "d3c00f4b-f8f9-49a1-8dc8-3d392e918300",
                                                "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                                "text": "„Ein Artillerist von der Schießschule kam vorbei, mit hohen Stiefeln und klingenden Sporen, und grüßte.“"
                                            },
                                            {
                                                "example_id": "f5e26a94-9d96-4b82-b8c6-53269ecf1861",
                                                "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                                "text": "„Von rechts kamen ein paar Artilleristen und schleppten einen zwischen sich.“"
                                            },
                                            {
                                                "example_id": "c366ed02-89c3-4447-9743-9b013e82b278",
                                                "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                                "text": "„Und im selben Augenblick stürzten die Artilleristen auch schon von ihren Lagerfeuern auf die Geschütze zu und begannen zu laden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
