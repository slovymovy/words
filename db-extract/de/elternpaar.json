                        "sense_id": "2c6ffdd5-3c11-3cd3-96da-31a3c7b8ab4b",
                        "entry_id": "968813b5-328c-3f60-8589-130808b45f88",
                        "glosses": [
                            "zwei Personen, die Eltern von mindestens einem Kind sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb804c31-0b35-4491-adf5-80c4c0da7ffd",
                                "sense_id": "2c6ffdd5-3c11-3cd3-96da-31a3c7b8ab4b",
                                "text": "„Es sind Orte wie diese, an die Elternpaare aller Generationen die Scherben ihrer Liebe tragen.“"
                            },
                            {
                                "example_id": "a0da5005-50f7-4715-b906-420f65abef2c",
                                "sense_id": "2c6ffdd5-3c11-3cd3-96da-31a3c7b8ab4b",
                                "text": "„Es war noch stockdunkel, da hörte ich schon auf der Treppe die aufgeregten Stimmen des Elternpaares, die zu dem verlorenen Sohn fuhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
