{
    "word_family": [
        "aanbeveling",
        "bevelen",
        "bevel",
        "aanbevolen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43187712-64d9-3551-8d08-be3b4af0fa82",
                    "sense_definition": "iets of iemand bij een ander positief presenteren en adviseren om daar gebruik van te maken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adviseren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan je Jan <w>aanbevelen</w>, want hij is een kundig en betrouwbaar boekhouder.",
                            "target_lang_translations": {
                                "en": "I can <w>recommend</w> Jan to you, because he is a skilled and reliable accountant."
                            }
                        },
                        {
                            "text": "De ober kan ons de dagschotel van harte <w>aanbevelen</w>.",
                            "target_lang_translations": {
                                "en": "The waiter can highly <w>recommend</w> the daily special to us."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanraden",
                        "recommanderen",
                        "adviseren"
                    ],
                    "antonyms": [
                        "afraden"
                    ],
                    "common_phrases": [
                        "van harte aanbevelen",
                        "iemand aanbevelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to present something or someone positively to another and advise them to make use of it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recommend",
                                "target_lang_sense_clarification": "to suggest someone or something as a good choice"
                            },
                            {
                                "target_lang_word": "vouch for",
                                "target_lang_sense_clarification": "to confirm the quality or reliability of someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c40383cb-bb92-397a-b331-eb7bca5415f2",
                    "sense_definition": "iets met nadruk gunstig voorstellen of aanprijzen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adviseren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan je deze oude auto niet <w>aanbevelen</w> want hij heeft veel gebreken.",
                            "target_lang_translations": {
                                "en": "I cannot <w>recommend</w> this old car to you because it has many defects."
                            }
                        },
                        {
                            "text": "Zij <w>beveelt</w> dit nieuwe product <w>aan</w> bij al haar vrienden.",
                            "target_lang_translations": {
                                "en": "She <w>recommends</w> this new product to all her friends."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanraden",
                        "recommanderen"
                    ],
                    "antonyms": [
                        "afraden"
                    ],
                    "common_phrases": [
                        "een product aanbevelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to emphatically present or praise something as favorable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recommend",
                                "target_lang_sense_clarification": "to suggest as being good or suitable"
                            },
                            {
                                "target_lang_word": "commend",
                                "target_lang_sense_clarification": "to formally praise or present as worthy"
                            },
                            {
                                "target_lang_word": "promote",
                                "target_lang_sense_clarification": "to encourage the use or purchase of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "833ea462-47fa-33bd-a9a6-8f396c7dc527",
                    "sense_definition": "pleiten voor een bepaald idee, plan of handelwijze",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adviseren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De commissie zal een strenger milieubeleid <w>aanbevelen</w> aan de regering.",
                            "target_lang_translations": {
                                "en": "The committee will <w>recommend</w> a stricter environmental policy to the government."
                            }
                        },
                        {
                            "text": "Het is geen carrière die ik zou <w>aanbevelen</w> aan jonge studenten.",
                            "target_lang_translations": {
                                "en": "It is not a career that I would <w>recommend</w> to young students."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanraden"
                    ],
                    "common_phrases": [
                        "een beleid aanbevelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to advocate for a specific idea, plan, or course of action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recommend",
                                "target_lang_sense_clarification": "to advise a specific course of action"
                            },
                            {
                                "target_lang_word": "advise",
                                "target_lang_sense_clarification": "to offer suggestions about the best thing to do"
                            },
                            {
                                "target_lang_word": "advocated",
                                "target_lang_sense_clarification": "to publicly support or suggest a policy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "971b44cd-002a-3869-90fd-8cf410b8f526",
                    "sense_definition": "iets of iemand aan de zorg van een ander overlaten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toevertrouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>beval</w> zijn ziel <w>aan</w> in de handen van de Schepper.",
                            "target_lang_translations": {
                                "en": "He <w>commended</w> his soul into the hands of the Creator."
                            }
                        },
                        {
                            "text": "Ik <w>beveel</w> mijn kinderen in uw hoede <w>aan</w> tijdens mijn afwezigheid.",
                            "target_lang_translations": {
                                "en": "I <w>entrust</w> my children to your care during my absence."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich aanbevelen in"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in religieuze of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to entrust something or someone to the care of another"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "commend",
                                "target_lang_sense_clarification": "to entrust someone or something to another's care (formal/archaic)"
                            },
                            {
                                "target_lang_word": "entrust",
                                "target_lang_sense_clarification": "to put something into someone's care or protection"
                            },
                            {
                                "target_lang_word": "commit",
                                "target_lang_sense_clarification": "to give over for safekeeping"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}