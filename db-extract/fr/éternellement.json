                    },
                    {
                        "translation_id": "a3511421-e56a-4bd6-8f6d-9bf5b9492513",
                        "source_entry_id": "4088350f-953a-3f4e-8df1-301b775b04d0",
                        "source_sense_id": "d2384002-2662-3f14-940e-31c016fda34a",
                        "source_sense_description": "D’une façon éternelle.",
                        "target_lang_word": "eeuwig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eeuwig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "caa970df-3985-330f-a294-988d5248ef6b",
                                        "entry_id": "c266a2a5-8239-3b79-8f3a-6a204fe3cd43",
                                        "glosses": [
                                            "voortdurend, zonder einde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6348c5fa-fe78-427b-b3d5-9cbed79fafc8",
                                                "sense_id": "caa970df-3985-330f-a294-988d5248ef6b",
                                                "text": "Niets is eeuwig aan alles komt een einde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c891ab20-ff99-3447-b735-aebbb993d139",
                                        "entry_id": "c266a2a5-8239-3b79-8f3a-6a204fe3cd43",
                                        "glosses": [
                                            "voor een zeer lange tijd"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ead34c8-ba92-4377-b9d1-93bdc926752a",
                                                "sense_id": "c891ab20-ff99-3447-b735-aebbb993d139",
                                                "text": "Ze slaat haar armen niet om de jongen heen, maar de kus lijkt eeuwig te duren."
                                            },
                                            {
                                                "example_id": "26084040-d3e0-4597-8401-e4d646090d61",
                                                "sense_id": "c891ab20-ff99-3447-b735-aebbb993d139",
                                                "text": "Ze werkte aan kleinere doeken en krabbelde het ene na het andere schetsboekje vol met tekeningen; het was alsof er een luik was opengegaan - waar dat luik op uitkwam, wist ze niet precies - en hoewel ze doodsbang was dat deze stroom van inspiratie zou opdrogen, had ze ook het gevoel dat ze misschien eeuwig door zou kunnen gaan zolang Isaac in de buurt was, en zij er klaar voor was, klaar voor hem."
                                            },
                                            {
                                                "example_id": "c9cf266b-38e3-4191-ad17-e538cacb49e2",
                                                "sense_id": "c891ab20-ff99-3447-b735-aebbb993d139",
                                                "text": "Dit was het moeilijke moment, dat was altijd zo. Nu moest hij zeggen dat de dienst hem helaas riep en dat hij rond lunchtijd al opgehaald zou worden met een geheim transport. Maar dat ze elkaar altijd konden schrijven, dat de oorlog niet eeuwig duurde en dat hij haar onmogelijk zou kunnen vergeten. Ze was natuurlijk wanhopig en vond dat hij haar erin had geluisd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eeuwig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9f7dcb2f-5a6e-3d3d-9262-7945a71c9340",
                                        "entry_id": "4b5b2d67-2569-3c74-82ed-b976dd71d7e0",
                                        "glosses": [
                                            "voortdurend, zonder einde"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2e86261-685a-317d-ad6f-53f9050252a3",
                                        "entry_id": "4b5b2d67-2569-3c74-82ed-b976dd71d7e0",
                                        "glosses": [
                                            "voor een zeer lange tijd"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea6c8bf-12df-4242-aa23-0ec069b030b5",
                                                "sense_id": "e2e86261-685a-317d-ad6f-53f9050252a3",
                                                "text": "Het kind bleef maar eeuwig doorzeuren en kreeg uiteindelijk haar zin."
                                            },
                                            {
                                                "example_id": "5e2a4d52-8361-423f-8f23-88b8718d5a36",
                                                "sense_id": "e2e86261-685a-317d-ad6f-53f9050252a3",
                                                "text": "Veel belangrijker nog, ik had de tocht niet kunnen lopen zonder haar zegen en support en ben eeuwig dankbaar voor de vrijheid die ze mij gaf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
