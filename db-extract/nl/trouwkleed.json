                "senses": [
                    {
                        "sense_id": "a7e0cdad-e090-344d-97b4-65917d928cfc",
                        "entry_id": "0e2e76a0-7234-30d2-ace3-d8e1f237ee93",
                        "glosses": [
                            "jurk die door de bruid speciaal wordt aangekocht of op maat gemaakt voor op de huwelijksdag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9662961f-5f19-4057-89f4-5b76e9b7d655",
                                "sense_id": "a7e0cdad-e090-344d-97b4-65917d928cfc",
                                "text": "Het gezicht van Maria Anna is behoorlijk gedetailleerd geschilderd, maar de zilveren jurk (het officiële trouwkleed voor de allerhoogste adel, zo ontdekte een kostuumhistorica) is veel vluchtiger opgezet."
                            },
                            {
                                "example_id": "61802fcb-9b47-447a-92e5-f35e44eb0ea5",
                                "sense_id": "a7e0cdad-e090-344d-97b4-65917d928cfc",
                                "text": "Bakken geld worden er tegen de huwelijksdag aan gegooid en weer legt de deskundige het verschil met de koele Nederlander uit. De kijker mag een kijkje nemen in het meisjesparadijs bij uitstek, de winkel waar het 'trouwkleed'aangeschaft wordt door een bloedserieuze aanstaande bruid."
                            }
                        ]
                    }
