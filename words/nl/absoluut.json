                    ],
                    "common_phrases": [
                        "absolute waarde",
                        "absolute temperatuur"
                    ],
                    "target_lang_definitions": {
                        "en": "standing on its own, not compared with or dependent on something else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absolute",
                                "target_lang_sense_clarification": "not relative or comparative"
                            },
                            {
                                "target_lang_word": "intrinsic",
                                "target_lang_sense_clarification": "belonging naturally; essential"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e993301-c254-30e4-bf75-7e7d1d942268",
                    "sense_definition": "geheel onafhankelijk en met onbeperkte macht, vaak gezegd van een vorst",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "macht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dat land is een <w>absolute</w> koning aan de macht die alles beslist.",
                            "target_lang_translations": {
                                "en": "In that country, an <w>absolute</w> king is in power who decides everything."
                            }
