                ],
                "senses": [
                    {
                        "sense_id": "050e9519-3306-3358-8c1d-5bdd55271cec",
                        "entry_id": "1c6d0281-5bba-36ab-b1e3-810f0174980c",
                        "glosses": [
                            "im Seniorenalter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68084d78-0560-4942-8989-0d71ff43954f",
                                "sense_id": "050e9519-3306-3358-8c1d-5bdd55271cec",
                                "text": "„Das meist seniorige Opfer wird dabei mit einer Horrorgeschichte überrascht und unter Druck gesetzt, schnell viel Geld rauszurücken.“"
                            },
                            {
                                "example_id": "d2ff9d1f-4157-4ed3-8274-759ab5f7c122",
                                "sense_id": "050e9519-3306-3358-8c1d-5bdd55271cec",
                                "text": "Der Anteil der seniorigen Arbeitskräfte ist in den letzten Jahren kontinuierlich gestiegen."
                            },
                            {
                                "example_id": "8b751ca9-0798-465f-96db-661926a1d1c0",
                                "sense_id": "050e9519-3306-3358-8c1d-5bdd55271cec",
                                "text": "Regelmäßige tierärztliche Untersuchungen sind das Fundament der Pflege für seniorige Katzen."
                            },
                            {
                                "example_id": "f490628a-d23e-4a56-bda5-b170e7bd3faa",
                                "sense_id": "050e9519-3306-3358-8c1d-5bdd55271cec",
                                "text": "Nur wenige Erhebungen konzentrierten sich auf das seniorige Klientel."
                            },
                            {
                                "example_id": "cde4758b-bfe5-4aac-82ad-1c9f7b0bd9f4",
                                "sense_id": "050e9519-3306-3358-8c1d-5bdd55271cec",
                                "text": "Diese seniorige Seelenruhe wirkt auch deshalb so echt, weil das Leben Schweinsteiger schon früh mit einem Bergsteigergesicht und dazu passenden grauen Haaren auszeichnete, und nicht einmal Til Schweiger kann sie stören."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
