    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62e2cacc-b496-36c9-a038-03881070814b",
                    "sense_definition": "Avoir ou s'assurer le monopole d'un commerce, d'une industrie ou d'une ressource.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "economie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande entreprise cherche à <w>monopoliser</w> le marché des télécommunications dans tout le pays."
                        },
                        {
                            "text": "L'État a longtemps <w>monopolisé</w> la distribution de l'énergie avant l'ouverture à la concurrence."
                        }
                    ],
                    "synonyms": [
                        "contrôler"
                    ],
                    "antonyms": [
                        "libéraliser",
                        "partager"
                    ],
                    "common_phrases": [
                        "monopoliser le marché",
                        "monopoliser un secteur"
                    ]
                },
                {
                    "sense_id": "2b43f077-10e9-38ca-85a8-8631879b0210",
                    "sense_definition": "Accaparer entièrement des personnes, du temps, la parole ou une ressource à l'exclusion des autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accaparement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant toute la réunion, il n'a cessé de <w>monopoliser</w> la parole sans écouter ses collègues."
                        },
                        {
                            "text": "Ce projet complexe <w>monopolise</w> tout notre temps et notre énergie depuis deux semaines."
                        }
                    ],
                    "synonyms": [
                        "accaparer",
                        "confisquer"
                    ],
                    "antonyms": [
                        "partager"
                    ],
                    "common_phrases": [
                        "monopoliser la parole",
                        "monopoliser le débat"
                    ]
                }
            ]
        }
    ]
}