                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5cf0419b-e9d3-3d62-9929-496e0e91c632",
                        "entry_id": "85a9d7a5-0a03-322d-93a6-092d86e3e3a7",
                        "glosses": [
                            "Vertreter der Gattung Corydalis aus der Familie der Erdrauchgewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31b0369c-2c11-423a-a5b6-f332ece44fba",
                                "sense_id": "5cf0419b-e9d3-3d62-9929-496e0e91c632",
                                "text": "Lerchensporne blühen sehr zeitig im Jahr."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74daed0a-46d5-451d-a2a1-06ff5e3c65d4",
                        "source_entry_id": "85a9d7a5-0a03-322d-93a6-092d86e3e3a7",
                        "source_sense_id": "446a9011-9491-3cab-b924-0d52d9416dde",
                        "source_sense_description": "Ornithologie, umgangssprachlich: verlängerte Kralle der nach hinten gerichteten Zehe von Lerchen",
                        "target_lang_word": "хохлатка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хохлатка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf7914b-36e9-39fa-82f1-d26403cd6b75",
                                        "entry_id": "d3e1956e-5f58-38eb-a2b0-797bcc5227e0",
                                        "glosses": [
                                            "разг. хохлатая птица (обычно о курах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24077da1-d7c6-4b1c-949c-0c0cbf11039e",
                                                "sense_id": "0cf7914b-36e9-39fa-82f1-d26403cd6b75",
                                                "text": "Увидел, что к реке пришли напиться куры. // «Негодные! ― кричит, ― хохлатки, дуры! // Я и без вас воды не знаю где достать; // А вы пришли её здесь вдосталь допивать»."
                                            },
                                            {
                                                "example_id": "6281d17c-f747-4bde-8f63-6c14c367df77",
                                                "sense_id": "0cf7914b-36e9-39fa-82f1-d26403cd6b75",
                                                "text": "Уехал Сальский противоэпидемический отряд, сезонники поселились в домике, сколоченном из тары, большая хохлатка с цыплятами бродила на том месте, где сидели в изоляторе скучные комбайнеры и рулевые;〈…〉"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed961ef2-f020-32a1-8cbe-3e4581b1d292",
                                        "entry_id": "d3e1956e-5f58-38eb-a2b0-797bcc5227e0",
                                        "glosses": [
                                            "энтомол. семейство ночных бабочек разнообразных вида и окраски с чешуйчатым хохолком на переднем крыле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41ae798-decb-41ea-b051-ca4bc7216bc6",
                                                "sense_id": "ed961ef2-f020-32a1-8cbe-3e4581b1d292",
                                                "text": "Хохлатки — бабочки средних размеров, активные в основном ночью. Всего их насчитывается примерно 3500 видов."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "хохлатка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1520b7dc-aae1-320a-8412-e12ba9e728fe",
                                        "entry_id": "397c0bc9-2654-3bab-ad36-29e1ed2b8465",
                                        "glosses": [
                                            "ботан. травянистое растение семейства маковых (Corydalis)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cedf3207-0e6c-4265-987b-c20af74ef1bb",
                                                "sense_id": "1520b7dc-aae1-320a-8412-e12ba9e728fe",
                                                "text": "Возле притемнённого зарослями ключа, в тени и холодке цвели последним накалом жарки, везде уже осыпавшиеся, зато марьины коренья были в самой поре, кукушкины слёзки, венерины башмачки, грушанка ― сердечная травка ― цвели повсюду, и по логам, где долго лежал снег, приморились ветреницы, хохлатки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b752daf3-0b1b-4869-b1c1-75d37cc31056",
                        "source_entry_id": "85a9d7a5-0a03-322d-93a6-092d86e3e3a7",
