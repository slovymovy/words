                                "example_id": "215c11a9-acc9-4f2e-8165-8204be503dc7",
                                "sense_id": "98837a90-eebd-3525-b30b-96586aaac495",
                                "text": "Талантливые ирландцы."
                            },
                            {
                                "example_id": "6afe8a44-f283-4ba4-8d96-1b56aad01e62",
                                "sense_id": "98837a90-eebd-3525-b30b-96586aaac495",
                                "text": "Молодой ирландец."
                            }
                        ]
                    }
                ],
                "translations": [
