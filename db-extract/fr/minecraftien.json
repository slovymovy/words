                        "entry_id": "0bb3f68e-bb06-341c-aa74-901d71efdcaa",
                        "glosses": [
                            "Qui est en rapport avec le jeu vidéo Minecraft."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "6d39e111-83ad-4bc1-8a28-0f05759d2e1f",
                                "sense_id": "4843b9b3-4612-3140-9173-4d74795a36f3",
                                "text": "En cours d’enchantements minecraftien et vous ?"
                            },
                            {
                                "example_id": "cfe6747f-c48a-4c63-9c6c-369f45bff5a1",
                                "sense_id": "4843b9b3-4612-3140-9173-4d74795a36f3",
                                "text": "Etre un joueur minecraftien sa a des risques !!"
                            },
                            {
                                "example_id": "0da5507e-bb9c-4ecb-8d5e-cba808654cb5",
                                "sense_id": "4843b9b3-4612-3140-9173-4d74795a36f3",
                                "text": "Un bébé loup Minecraftien de la 1.2"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
