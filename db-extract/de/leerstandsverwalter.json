                "senses": [
                    {
                        "sense_id": "d6e2cbed-2923-3c11-8226-aa9468e81402",
                        "entry_id": "76aaa7d5-6e85-31b4-be2c-516dda876f26",
                        "glosses": [
                            "Person, die beruflich leerstehende Gebäude verwaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2355f3b1-84e1-4d51-a1a5-265c7f89562c",
                                "sense_id": "d6e2cbed-2923-3c11-8226-aa9468e81402",
                                "text": "„Der holländische Leerstandsverwalter betreut mehr als 4000 Gebäude europaweit, das hiesige Finanzamt ist der erste Auftrag in Münster.“"
                            },
                            {
                                "example_id": "fbbadb15-1221-48ec-b658-eb47b6d0881c",
                                "sense_id": "d6e2cbed-2923-3c11-8226-aa9468e81402",
                                "text": "„Auch Leerstandsverwalter Linde räumt ein, dass die hohe Nachfrage nach bezahlbarem Wohnungen seinem Unternehmen sehr entgegenkomme.“"
                            },
                            {
                                "example_id": "1bca009b-09d7-4c88-9588-a5d3a659f6fe",
                                "sense_id": "d6e2cbed-2923-3c11-8226-aa9468e81402",
                                "text": "„Der unabhängige Makler für Versicherungen und Risikomanagement hat für den Leerstandsverwalter eine innovative Haftpflichtversicherung nach Maß entwickelt.“"
                            },
                            {
                                "example_id": "a3cd3cde-29d8-4652-ba64-8d02039aa58e",
                                "sense_id": "d6e2cbed-2923-3c11-8226-aa9468e81402",
                                "text": "„Die Vereine müssen sich nicht sorgen: ‚Da bleibt etwas für sie übrig‘, versichert Leerstandsverwalter Kahlau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
