                    {
                        "translation_id": "a1e1424e-bd64-4147-a4cd-814bd89001de",
                        "source_entry_id": "062b1aed-92e3-359a-b8fd-f187cf0bb439",
                        "source_sense_id": "9b9350a8-727d-311e-b74e-963d5a57a090",
