                "senses": [
                    {
                        "sense_id": "8fad8f03-3d00-3411-98f2-f4d814702b16",
                        "entry_id": "efa51496-45f1-3cc2-84f5-51359dd1fc53",
                        "glosses": [
                            "(zeitlich begrenzter, persönlicher) Nachweis, dass der Inhaber entweder von Covid-19 genesen, gegen das Coronavirus SARS-CoV-2 geimpft oder auf das Virus getestet und aktuell nicht infiziert ist"
                        ],
                        "tags": [
                            "Coronapandemie"
                        ],
                        "examples": [
                            {
                                "example_id": "2aa633d8-0092-4466-bb7a-b404283e4c3a",
                                "sense_id": "8fad8f03-3d00-3411-98f2-f4d814702b16",
                                "text": "„Das Covid-Zertifikat ist eine Möglichkeit, eine Covid-19-Impfung, eine durchgemachte Erkrankung oder ein negatives Testergebnis zu dokumentieren. Das Covid-Zertifikat wird Ihnen auf Antrag in Papierform oder als PDF-Dokument mit einem QR-Code ausgestellt.“"
                            },
                            {
                                "example_id": "c3f99ba5-fb3e-4861-8631-7124c69f7302",
                                "sense_id": "8fad8f03-3d00-3411-98f2-f4d814702b16",
                                "text": "„Die Verordnung über das digitale COVID-Zertifikat der EU ist am 1. Juli 2021 in Kraft getreten. Alle Menschen, die in der EU wohnen, können sich das Zertifikat nun ausstellen lassen und bei Bedarf vorzeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
