                "senses": [
                    {
                        "sense_id": "213e9428-0dde-3880-aa83-c4505516f8b5",
                        "entry_id": "a254e40e-69d9-34af-92af-f8edc5e15f33",
                        "glosses": [
                            "Verfahren zur Feststellung des Standorts eines eingeschalteten Mobiltelefons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3688a34-af83-4823-bd73-3f924f0a8c99",
                                "sense_id": "213e9428-0dde-3880-aa83-c4505516f8b5",
                                "text": "„Es wurde auch eine Handypeilung durchgeführt, doch der Wanderer wurde nicht in Bad Hofgastein, wie die Ortung ergeben hatte, sondern im Kötschachtal in Bad Gastein entdeckt.“"
                            },
                            {
                                "example_id": "df3ee093-27cf-4b64-bd62-5f0054bffd95",
                                "sense_id": "213e9428-0dde-3880-aa83-c4505516f8b5",
                                "text": "„Gegen 2.00 Uhr alarmierte er eine Wiener Polizeidienststelle, die daraufhin eine Handypeilung einleitete.“"
                            },
                            {
                                "example_id": "307d9ad3-ce75-4b35-8f7d-842032500382",
                                "sense_id": "213e9428-0dde-3880-aa83-c4505516f8b5",
                                "text": "„Bei der am Abend eingeleiteten Suchaktion wurde mit Handypeilung und Wärmebildkamera nach dem Mann gesucht.“"
                            },
                            {
                                "example_id": "d33e7b94-91c8-4358-a462-1730b921c672",
                                "sense_id": "213e9428-0dde-3880-aa83-c4505516f8b5",
                                "text": "„Wie die \"Salzburger Nachrichten\" unter Berufung auf die Nachrichtenagentur APA meldet, hatten die Beamten den mutmaßlichen Mörder auf seiner Fahrt in Richtung Wien mittels Handypeilung geortet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
