                "senses": [
                    {
                        "sense_id": "0a8f96a5-f5a0-3571-b265-33da04786a9d",
                        "entry_id": "8b66e889-c315-35dc-9917-30f173378881",
                        "glosses": [
                            "boczne pomieszczenie w świątyniach chrześcijańskich sąsiadujące z prezbiterium, służące kapłanom do przygotowywania się do liturgii oraz do przechowywania szat i naczyń liturgicznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b38ea0-382a-49c2-85dc-ad6aae258d8f",
                                "sense_id": "0a8f96a5-f5a0-3571-b265-33da04786a9d",
                                "text": "Ministrant, wchodząc do zakrystii, mówi głośno i wyraźnie „Króluj nam, Chryste”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb8b152c-112a-4720-a005-d35bf1fc8307",
                        "source_entry_id": "8b66e889-c315-35dc-9917-30f173378881",
                        "source_sense_id": "0a8f96a5-f5a0-3571-b265-33da04786a9d",
                        "target_lang_word": "vestry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vestry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c75a8ac2-ff02-3d4c-a347-d3c5cd08b13f",
                                        "entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                                        "glosses": [
                                            "A room in a church where the clergy put on their vestments and where these are stored; also used for meetings and classes; a sacristy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f56487-c20b-481c-a96a-14d193a8eea5",
                                                "sense_id": "c75a8ac2-ff02-3d4c-a347-d3c5cd08b13f",
                                                "text": "The choirboys change into their cassocks in the vestry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eafe6c9-eca3-34fc-9ce4-8dc5113a2e5a",
                                        "entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                                        "glosses": [
                                            "A committee of parishioners elected to administer the temporal affairs of a parish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af6f9308-e629-45a1-853e-b3116575d92a",
                                                "sense_id": "5eafe6c9-eca3-34fc-9ce4-8dc5113a2e5a",
                                                "text": "The vestry meets on the first Tuesday of every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2684ecef-6116-3926-aa77-1e6203026e1b",
                                        "entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                                        "glosses": [
                                            "An assembly of persons who manage parochial affairs; so called because usually held in a vestry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45ffe23e-1772-4b1f-8f5e-2aaf716ef823",
                        "source_entry_id": "8b66e889-c315-35dc-9917-30f173378881",
                        "source_sense_id": "0a8f96a5-f5a0-3571-b265-33da04786a9d",
                        "target_lang_word": "sacristy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16eb2256-7964-3ca2-906a-afb7dca6717e",
                                        "entry_id": "5d5947ce-776b-3374-9ad5-5345a80210fb",
                                        "glosses": [
                                            "A room in a church where sacred vessels, books, vestments, etc. are kept. Sometimes also used by clergy to prepare for worship or for meetings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "946eb174-0336-4d19-9ab6-e1396f8bdaee",
                        "source_entry_id": "8b66e889-c315-35dc-9917-30f173378881",
                        "source_sense_id": "0a8f96a5-f5a0-3571-b265-33da04786a9d",
                        "target_lang_word": "sacristía",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristía",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "14460e6e-07d4-3c7a-abc8-6bbf8138d9a7",
                                        "entry_id": "529871cb-df76-31bc-8e80-84c0fa44c3c6",
                                        "glosses": [
                                            "Habitación en las iglesias cristianas occidentales, en la que se guardan los objetos que son necesarios para la misa, como por ejemplo hostias sin consagrar, cálices, casullas, etc, por lo que suele estar cerrada al público. En especial es empleado por el párroco y demás oficiantes como lugar para realizar las preparaciones necesarias y para cambiarse antes y después de la misa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1497a35f-f49d-42fc-b62e-23d54c00a6bf",
                                                "sense_id": "14460e6e-07d4-3c7a-abc8-6bbf8138d9a7",
                                                "text": "\"Encontraste manera, sin embargo, de escurrirte a la sacristía inmediatamente después de la ceremonia. —Adiós, padre, ruegue por mí —suspiraste casi a mi oído, y me abrazaste."
                                            },
                                            {
                                                "example_id": "fa0f5d08-4e82-4516-924e-a495f53d3c08",
                                                "sense_id": "14460e6e-07d4-3c7a-abc8-6bbf8138d9a7",
                                                "text": "Y naturalmente que rogué por ti.\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d51d22b-eac4-4a60-b0a6-9896ae60c853",
                        "source_entry_id": "8b66e889-c315-35dc-9917-30f173378881",
                        "source_sense_id": "0a8f96a5-f5a0-3571-b265-33da04786a9d",
                        "target_lang_word": "Sakristei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sakristei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                        "entry_id": "9d89371e-0a63-3d2f-938d-f210dbc5a03f",
                                        "glosses": [
                                            "Nebenraum einer Kirche, in dem aufbewahrt wird, was für den Gottesdienst benötigt wird; dient auch als Vorbereitungsraum für die Geistlichen"
                                        ],
                                        "tags": [
                                            "Christentum; Kirchengebäude"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e15c88-2f86-47ca-b4a0-8e8c2b541ff4",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Auch das heutige an der Nordseite erbaute Querhaus entstand im Wesentlichen in diesen Jahren, um dort die Sakristei und die Bibliothek unterzubringen.“"
                                            },
                                            {
                                                "example_id": "38b804de-749f-4996-aba6-33b1fdf1b7ba",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Die Sakristei befand sich neben dem Sanktuarium (Altarraum) und an der dem kleinen Kreuzgang abgewandten Seite.“"
                                            },
                                            {
                                                "example_id": "e8d9ca9a-43dc-4e3a-bf42-87bbfe906bfa",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Auf der Suche nach einem Fluchtweg öffnete er die Seitentüre zur Sakristei und versteckte sich in einem Beichtstuhl.“"
                                            },
                                            {
                                                "example_id": "9a071535-66ad-47c0-9e02-55554f697a91",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Ich saß noch bei Tisch mit der ganzen erlauchten Gesellschaft, als ein Geistlicher erschien und mich daran erinnerte, daß man mich in der Sakristei erwarte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
