                ],
                "senses": [
                    {
                        "sense_id": "89e0b389-ac7d-3228-980a-caa374ec0393",
                        "entry_id": "16f2db0c-b007-3d3c-91d8-e0f7b3944e3f",
                        "glosses": [
                            "im engeren Sinne: der Schutz personenbezogener Daten vor Missbrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89fd785d-ab94-422b-9a16-a5d63af8c11c",
                                "sense_id": "89e0b389-ac7d-3228-980a-caa374ec0393",
                                "text": "Um den Datenschutz kümmern sich die Datenschutzbeauftragten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e831f914-0dbe-3819-b2c1-46f892fdcad8",
                        "entry_id": "16f2db0c-b007-3d3c-91d8-e0f7b3944e3f",
                        "glosses": [
                            "im weiteren Sinne: der Schutz wirtschaftlicher, wissenschaftlicher oder technischer Daten gegen Verlust, Veränderung oder Diebstahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b30caa8c-922a-4801-af48-85ea47afa16c",
                                "sense_id": "e831f914-0dbe-3819-b2c1-46f892fdcad8",
                                "text": "Aus Gründen des Datenschutzes dürfen Besucher unser Unternehmen nur nach Anmeldung betreten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b5baba8-3d47-450b-a2c6-a5d91c35b969",
                        "source_entry_id": "16f2db0c-b007-3d3c-91d8-e0f7b3944e3f",
                        "source_sense_id": "89e0b389-ac7d-3228-980a-caa374ec0393",
                        "source_sense_description": "im engeren Sinne: der Schutz personenbezogener Daten vor Missbrauch",
                        "target_lang_word": "data privacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a5acd373-7ce6-4127-a410-9416a24bc26f",
                        "source_entry_id": "16f2db0c-b007-3d3c-91d8-e0f7b3944e3f",
                        "source_sense_id": "89e0b389-ac7d-3228-980a-caa374ec0393",
                        "source_sense_description": "im engeren Sinne: der Schutz personenbezogener Daten vor Missbrauch",
                        "target_lang_word": "data protection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "data protection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69f8be7d-0a30-3eaa-9a3b-f85ae03b6a59",
                                        "entry_id": "b0c056f6-caca-394c-b260-1aec926ecc0b",
                                        "glosses": [
                                            "The act or process of protecting data from unauthorized use by ensuring security and privacy through consciously chosen and enforced rules and methods."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb629abf-ad6f-42f2-8d27-f213d31681d4",
                                                "sense_id": "69f8be7d-0a30-3eaa-9a3b-f85ae03b6a59",
                                                "text": "The links were mostly to newspaper articles and public records, and Google refused to comply, but with the “right to be forgotten” enshrined as a key objective of the European Union’s 2011 data protection strategy, more and bigger cases are likely to follow."
                                            },
                                            {
                                                "example_id": "e440352e-fbd1-4f28-a0d8-11f5192bf65a",
                                                "sense_id": "69f8be7d-0a30-3eaa-9a3b-f85ae03b6a59",
                                                "text": "The train company did not breach data protection law for publishing the clip during the so-called traingate controversy."
                                            },
                                            {
                                                "example_id": "71415452-a74e-4820-b144-dd32a4566484",
                                                "sense_id": "69f8be7d-0a30-3eaa-9a3b-f85ae03b6a59",
                                                "text": "However, given current sensibilities about individual privacy and data protection, the recording of oral data is becoming increasingly onerous for researchers[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b957657-06b7-3f4c-9527-eb9450ea53d1",
                                        "entry_id": "b0c056f6-caca-394c-b260-1aec926ecc0b",
                                        "glosses": [
                                            "The business function (team, department, squad, etc) that leads others in their performance of this act or process."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f07d96e-f333-4e31-aecb-6f683ff8391c",
                                                "sense_id": "9b957657-06b7-3f4c-9527-eb9450ea53d1",
                                                "text": "This proposal has to be cleared by Legal, Human Resources, and Data Protection before it can proceed further."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
