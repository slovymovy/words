                        "ru": "Технический осмотр транспортного средства, особенно в автоспорте, для проверки соответствия правилам.",
                        "zh": "车辆的技术检查，特别是在赛车运动中，以确保其符合规定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "техосмотр",
                                "target_lang_sense_clarification": "проверка состояния"
