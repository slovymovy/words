                "senses": [
                    {
                        "sense_id": "b8d40b10-c158-3452-9d0d-5a0fc848e0e3",
                        "entry_id": "56f3e5c5-e97f-3652-904b-23a462dbbd61",
                        "glosses": [
                            "Amener un caractère règlementaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc5fb2de-375b-4f61-b53a-b73a584287d6",
                                "sense_id": "b8d40b10-c158-3452-9d0d-5a0fc848e0e3",
                                "text": "Nous souhaitons que toute la partie du projet qui vise à codifier et règlementariser le spectacle vivant soit retirée faute de quoi le bénévolat sera étouffé."
                            },
                            {
                                "example_id": "dcc8445d-cb59-4f56-b7ad-7db9bfa14259",
                                "sense_id": "b8d40b10-c158-3452-9d0d-5a0fc848e0e3",
                                "text": "Afin de pérenniser et de règlementariser cette situation existante, il est proposé d'implanter des impasses de sécurité, permettant d'éviter les dérives de matériels."
                            },
                            {
                                "example_id": "272fddf6-af97-44d8-972b-92a308b8d8c2",
                                "sense_id": "b8d40b10-c158-3452-9d0d-5a0fc848e0e3",
                                "text": "Dans un passage il montre à quel point il est difficile de \"règlementariser\" l'amour autrement dit d'en définir les règles voir de le moraliser."
                            }
                        ]
                    }
