                                        "sense_id": "172d04b6-216f-3615-99c6-1386cc53b739",
                                        "entry_id": "f05ad287-83b3-3e3d-a2cc-62c327d12723",
                                        "glosses": [
                                            "A royal decree issued by a sovereign in certain historical Islamic states, especially by the Sultan of Turkey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7094af5-7d05-4063-b9a0-6837976b7838",
                                                "sense_id": "172d04b6-216f-3615-99c6-1386cc53b739",
                                                "text": "his Sublimity's firman, The most imperative of sovereign spells, / Which every body does without who can […]"
                                            },
                                            {
                                                "example_id": "f4d30a77-adbe-4345-93fd-9de4fce36ae8",
                                                "sense_id": "172d04b6-216f-3615-99c6-1386cc53b739",
                                                "text": "He managed to obtain from the vizier a firman bearing the Emir's personal seal and ordering all Bokharan officials to assist the party in every way possible."
                                            },
                                            {
                                                "example_id": "7e0f2e31-0d14-4333-a674-e08985714bab",
                                                "sense_id": "172d04b6-216f-3615-99c6-1386cc53b739",
                                                "text": "It will be noted that the title of Sultan was adopted partly because that of Khedive had been conferred by an Ottoman firman."
                                            }
                                        ]
                                    }
                                ]
                            }
