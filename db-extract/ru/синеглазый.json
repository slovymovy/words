                                                "sense_id": "bd2975aa-e5b4-317d-ade7-f8b435cbf335",
                                                "text": "Der vermisste Mann wird als braunhaarig und blauäugig beschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                        "entry_id": "9fd79321-3fb4-34e7-8fea-fbd8d8c77bbb",
                                        "glosses": [
                                            "naiv, arglos, weltfremd oder äußerst optimistisch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "497ed5bf-406f-47f1-aeff-53f585471e85",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "Es ist blauäugig, allen Versprechen der Politiker zu glauben."
                                            },
                                            {
                                                "example_id": "031c0219-8eac-4de9-af19-f7c1ad997534",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "Gunda war viel zu blauäugig, als sie ihr Geld in Zertifikaten anlegte."
                                            },
                                            {
                                                "example_id": "2eb4f32c-3ecf-4143-a91c-3f9bd21a7cac",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "Die Argumentation des Redners war sehr blauäugig."
                                            },
                                            {
                                                "example_id": "16d4f4a7-9f53-4372-8a74-6ed25b731145",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "„Wir Reeder waren blauäugig – dachten, der Boom der hört nicht mehr auf, und haben entsprechend Schiffe bestellt, ohne konkreten Bedarf.“"
                                            },
                                            {
                                                "example_id": "5d146fa6-26b5-49ad-9115-da6352bdab84",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "„Waren die Redaktionen wirklich so blauäugig oder die Tarnung der kommerziellen Botschaften so gut?“"
                                            }
