        "de-extract.jsonl": [
            {
                "entry_id": "44a0aeed-20fe-38fe-a618-ddc5d29c0390",
                "word": "einstmals",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b6f63a32-1940-38e7-9662-76918e849d2c",
                        "entry_id": "44a0aeed-20fe-38fe-a618-ddc5d29c0390",
                        "glosses": [
                            "früher, vor langer Zeit"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "e60f0f81-2af2-40c6-bbfb-9527b33a626e",
                                "sense_id": "b6f63a32-1940-38e7-9662-76918e849d2c",
                                "text": "Einstmals, als ich ein berühmter Magier war, bereiste ich die ganze Welt."
                            },
                            {
                                "example_id": "e60be9d7-047d-49ca-be44-7fefbd1e1dcf",
                                "sense_id": "b6f63a32-1940-38e7-9662-76918e849d2c",
                                "text": "Ich weiß noch genau, wie wir einstmals als Buben am Weiher die Kleider der Badenden versteckten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "31605966-d12b-37af-8c4e-4354465bab69",
                        "entry_id": "44a0aeed-20fe-38fe-a618-ddc5d29c0390",
                        "glosses": [
                            "in ferner Zukunft, später einmal"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "8d7104a5-4e91-4f42-aa59-60dc89bbb9a8",
                                "sense_id": "31605966-d12b-37af-8c4e-4354465bab69",
                                "text": "Dir wird all dies einstmals gehören und dann wird es an dir sein, das Familienerbe zu bewahren."
                            },
                            {
                                "example_id": "14e2c0ca-79b1-49d6-87dc-9e9f9bba4c76",
                                "sense_id": "31605966-d12b-37af-8c4e-4354465bab69",
                                "text": "Wirst du auch einstmals noch an mich denken, wenn längst andere an deiner Seite sind?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
