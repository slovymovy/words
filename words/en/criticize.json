{
    "word_family": [
        "critic",
        "critical",
        "criticism",
        "critique",
        "hypercritical",
        "uncritical"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a91c157-712d-34ae-acf7-4ca0a1ece144",
                    "sense_definition": "To express disapproval of someone or something by pointing out faults or mistakes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disapproval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not fair to <w>criticize</w> someone who is doing their best under difficult circumstances.",
                            "target_lang_translations": {
                                "ru": "Несправедливо <w>критиковать</w> того, кто делает всё возможное в трудных обстоятельствах."
                            }
                        },
                        {
                            "text": "The opposition party began to harshly <w>criticize</w> the government for its handling of the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Оппозиционная партия начала жестко <w>критиковать</w> правительство за его действия в условиях экономического кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "condemn",
                        "denounce",
                        "find fault",
                        "reprimand",
                        "scold"
                    ],
                    "antonyms": [
                        "commend",
                        "compliment",
                        "congratulate",
                        "laud",
                        "praise"
                    ],
                    "common_phrases": [
                        "harshly criticize",
                        "criticize someone for",
                        "openly criticize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать неодобрение кому-либо или чему-либо, указывая на недостатки или ошибки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критиковать",
                                "target_lang_sense_clarification": "высказывать замечания и указывать на недостатки"
                            },
                            {
                                "target_lang_word": "раскритиковать",
                                "target_lang_sense_clarification": "подвергнуть резкой критике"
                            },
                            {
                                "target_lang_word": "осуждать",
                                "target_lang_sense_clarification": "выражать неодобрение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d803ecc-a849-31b1-9fed-c368a5699b9b",
                    "sense_definition": "To evaluate or analyze a work of art, literature, or an idea, assessing both its merits and its faults.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students were asked to <w>criticize</w> the work of several modern poets during the seminar.",
                            "target_lang_translations": {
                                "ru": "На семинаре студентов попросили <w>проанализировать</w> работы нескольких современных поэтов."
                            }
                        },
                        {
                            "text": "The professor will <w>criticize</w> the theory by looking at both its strengths and its logical inconsistencies.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>разберет</w> <w>теорию</w>, рассмотрев как её сильные стороны, так и логические несоответствия."
                            }
                        }
                    ],
                    "synonyms": [
                        "appraise",
                        "evaluate",
                        "judge",
                        "review"
                    ],
                    "common_phrases": [
                        "criticize the work",
                        "criticize the theory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценивать или анализировать произведение искусства, литературы или идею, рассматривая как достоинства, так и недостатки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критиковать",
                                "target_lang_sense_clarification": "заниматься профессиональным разбором или анализом"
                            },
                            {
                                "target_lang_word": "анализировать",
                                "target_lang_sense_clarification": "подробно разбирать структуру или содержание"
                            },
                            {
                                "target_lang_word": "рецензировать",
                                "target_lang_sense_clarification": "давать отзыв на произведение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}