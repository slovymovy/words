                        "glosses": [
                            "The quality of a material thing; objectivity; actuality; reality."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fe05d290-4c3d-4e83-b411-9f73c07e28ec",
                                "sense_id": "2f14fb52-eff7-35fc-abb4-896b9e2a1d32",
                                "text": "1994, Shadia B Drury, Alexandre Kojève http://books.google.com/books?ie=UTF-8&hl=en&vid=ISBN0312120923&id=zQRKXLwDPc4C&pg=PA26&lpg=PA26&sig=zR0NpFT9gF4Mo_VTIPTm1274piI\nTo live as a thing, to live for another and as the other expects, is to live unauthentically or in bad faith. To be true to oneself, one must reduce others to thingness and resist being so reduced."
                            },
                            {
                                "example_id": "c38ef0ff-2233-4ec5-99c5-a3d98557a4b4",
                                "sense_id": "2f14fb52-eff7-35fc-abb4-896b9e2a1d32",
                                "text": "Whether we dwell in the thingness of fixity or the thingness of wujūd, we are “at” the wujūd of the Real."
                            },
                            {
                                "example_id": "565aa239-7a95-414a-affd-33d7bcadfc78",
                                "sense_id": "2f14fb52-eff7-35fc-abb4-896b9e2a1d32",
                                "text": "The thingness of a thing precedes the conscious perception of its sensual properties."
                            }
                        ]
                    }
                ],
