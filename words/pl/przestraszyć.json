    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8069d071-4433-32ba-9e29-ae96aee6a310",
                    "sense_definition": "wzbudzić w kimś strach, wywołać w kimś przerażenie lub obawę",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "strach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Głośny huk <w>przestraszył</w> małe dziecko, które zaczęło płakać.",
                            "target_lang_translations": {
                                "en": "The loud bang <w>scared</w> the little child, who started to cry."
                            }
                        },
                        {
                            "text": "Nie chciałem cię <w>przestraszyć</w>, po prostu wszedłem cicho do pokoju.",
                            "target_lang_translations": {
                                "en": "I didn't mean to <w>frighten</w> you, I just walked quietly into the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "przerazić",
                        "zaniepokoić"
                    ],
                    "common_phrases": [
                        "przestraszyć kogoś"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause someone to feel fear, terror, or apprehension"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scare",
                                "target_lang_sense_clarification": "to frighten or cause alarm"
                            },
                            {
                                "target_lang_word": "frighten",
                                "target_lang_sense_clarification": "to make someone feel fear"
                            },
                            {
                                "target_lang_word": "startle",
                                "target_lang_sense_clarification": "to frighten or surprise suddenly"
                            },
                            {
                                "target_lang_word": "terrify",
                                "target_lang_sense_clarification": "to scare intensely or fill with terror"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "979cad1a-3ed1-354f-b04f-cb9bf9001e41",
                    "sense_definition": "poczuć strach lub przerażenie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "strach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pies <w>przestraszył</w> się hałasu i uciekł do ogrodu.",
                            "target_lang_translations": {
                                "en": "The dog <w>got scared</w> of the noise and ran away into the garden."
                            }
                        },
                        {
                            "text": "Nigdy nie <w>przestraszyłeś</w> się ciemności, prawda?",
                            "target_lang_translations": {
                                "en": "You have never <w>been scared</w> of the dark, right?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "przestraszyć się czegoś"
                    ],
                    "target_lang_definitions": {
                        "en": "to become frightened or feel fear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get scared",
                                "target_lang_sense_clarification": "to become afraid"
                            },
                            {
                                "target_lang_word": "get frightened",
                                "target_lang_sense_clarification": "to start feeling fear"
                            },
                            {
                                "target_lang_word": "take fright",
                                "target_lang_sense_clarification": "to suddenly become scared"
                            }
                        ]
                    }
                }
            ]
        }
    ]
