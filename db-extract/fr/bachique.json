            {
                "entry_id": "2cdc21f1-dcbe-337c-8ed8-f6db54e7fa3f",
                "word": "bachique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "681a6b61-8765-4d5e-a5a9-9a14dcc2d000",
                        "entry_id": "2cdc21f1-dcbe-337c-8ed8-f6db54e7fa3f",
