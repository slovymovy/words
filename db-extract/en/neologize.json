                "senses": [
                    {
                        "sense_id": "202d06a2-ba25-37b7-a812-51311b9fe9f3",
                        "entry_id": "c43de1fe-caa9-3c6b-8a3d-14f1ebb5478b",
                        "glosses": [
                            "To coin a new word."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4660fe63-4630-49e5-8010-9cad557525f5",
                                "sense_id": "202d06a2-ba25-37b7-a812-51311b9fe9f3",
                                "text": "I neologize most frequently in my writing when it comes to adverbs."
                            },
                            {
                                "example_id": "a61cd613-c0cf-4a7b-adf9-fec7f07ba884",
                                "sense_id": "202d06a2-ba25-37b7-a812-51311b9fe9f3",
                                "text": "Neologizing, the practice of coining new words, may seem to be an arcane, specialized activity, but it's everywhere -- and the skillful employment of neologism is what gives English much of its verve."
                            }
                        ]
                    }
                ],
