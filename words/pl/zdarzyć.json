    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6b0a3d0-388c-3dde-8b5e-dd555abfb5fe",
                    "sense_definition": "o jakimś fakcie lub sytuacji: nastąpić niespodziewanie, mieć miejsce (zazwyczaj w formie zwrotnej)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wydarzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nikt nie wiedział dokładnie, co właściwie <w>zdarzyło</w> się wczorajszego wieczoru w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Никто точно не знал, что собственно <w>случилось</w> вчера вечером в центре города."
                            }
                        },
                        {
                            "text": "Taki wypadek może się <w>zdarzyć</w> każdemu, nawet bardzo ostrożnemu kierowcy.",
                            "target_lang_translations": {
                                "ru": "Такая авария может <w>случиться</w> с каждым, даже с очень осторожным водителем."
                            }
                        }
                    ],
                    "synonyms": [
                        "zadziać się",
                        "trafić się"
                    ],
                    "common_phrases": [
                        "może się zdarzyć",
                        "zdarzyć się przypadkiem"
                    ],
                    "target_lang_definitions": {
                        "ru": "о факте или событии: неожиданно произойти, иметь место (обычно с частицей się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случиться",
                                "target_lang_sense_clarification": "произойти, совершиться"
                            },
                            {
                                "target_lang_word": "произойти",
                                "target_lang_sense_clarification": "иметь место"
                            },
                            {
                                "target_lang_word": "приключиться",
                                "target_lang_sense_clarification": "неожиданно произойти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a49102ee-cfe6-3c0e-9e3f-199b04ea2749",
                    "sense_definition": "wystąpić sporadycznie lub pojawić się z określoną częstotliwością w określonych warunkach",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wydarzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym górzystym rejonie śnieżyce w maju <w>zdarzają</w> się niezwykle rzadko.",
                            "target_lang_translations": {
                                "ru": "В этом горном районе метели в мае <w>случаются</w> крайне редко."
                            }
                        },
                        {
                            "text": "Czasami <w>zdarzy</w> się awaria prądu, ale technicy zazwyczaj szybko usuwają usterkę.",
                            "target_lang_translations": {
                                "ru": "Иногда <w>случается</w> отключение электричества, но техники обычно быстро устраняют неполадку."
                            }
                        }
                    ],
                    "synonyms": [
                        "trafić się"
                    ],
                    "common_phrases": [
                        "zdarzyć się rzadko"
                    ],
                    "target_lang_definitions": {
                        "ru": "иметь место время от времени, случаться с определенной периодичностью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "бывать, происходить изредка"
                            },
                            {
                                "target_lang_word": "бывать",
                                "target_lang_sense_clarification": "иметь место время от времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7630d1bc-2842-32cc-9a67-fba887ed6da1",
                    "sense_definition": "aspekt dokonany od czasownika <w>zdarzać</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta nieprzyjemna pomyłka <w>zdarzyła</w> się po raz pierwszy od wielu miesięcy.",
                            "target_lang_translations": {
                                "ru": "Эта неприятная ошибка <w>произошла</w> впервые за много месяцев."
                            }
                        },
                        {
                            "text": "Kiedy to się <w>zdarzy</w>, będziemy musieli natychmiast podjąć odpowiednie kroki prawne.",
                            "target_lang_translations": {
                                "ru": "Когда это <w>произойдет</w>, нам придется немедленно предпринять соответствующие правовые шаги."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид к глаголу zdarzać (zdarzać się): произойти, совершиться один раз"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случиться",
                                "target_lang_sense_clarification": "совершенный вид к случаться"
                            },
                            {
                                "target_lang_word": "произойти",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "949372a2-50cb-320f-a607-d29b0b288f12",
                    "sense_definition": "sprawić, spowodować, doprowadzić do zaistnienia czegoś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "przyczyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Los tak <w>zdarzył</w>, że obaj przyjaciele spotkali się po wielu latach w obcym kraju.",
                            "target_lang_translations": {
                                "ru": "Судьба так <w>распорядилась</w>, что оба друга встретились спустя много лет в чужой стране."
                            }
                        },
                        {
                            "text": "Przypadek <w>zdarzył</w>, iż odnaleziono zaginione przed wiekami bezcenne dokumenty.",
                            "target_lang_translations": {
                                "ru": "Случай <w>судил</w> так, что были найдены утерянные века назад бесценные документы."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrządzić"
                    ],
                    "common_phrases": [
                        "los tak zdarzył"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane rzadziej, podniośle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "книжн. устроить, распорядиться (о судьбе, случае), привести к чему-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судить",
                                "target_lang_sense_clarification": "в знач. судьба судила"
                            },
                            {
                                "target_lang_word": "распорядиться",
                                "target_lang_sense_clarification": "о судьбе или случае"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79904564-65c2-3aaf-b6c8-d1035dd7f6e3",
                    "sense_definition": "powieść się, zakończyć się pomyślnie, udać się",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "powodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mieliśmy nadzieję, że to trudne przedsięwzięcie wreszcie nam się <w>zdarzy</w>.",
                            "target_lang_translations": {
                                "ru": "Мы надеялись, что это трудное начинание наконец-то нам <w>удастся</w>."
                            }
                        },
                        {
                            "text": "Nie każde zaplanowane dzieło <w>zdarzy</w> się według pierwotnych zamiarów twórcy.",
                            "target_lang_translations": {
                                "ru": "Не каждое задуманное произведение <w>удается</w> согласно первоначальным намерениям создателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "udać się"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "w znaczeniu: udać się"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устар. увенчаться успехом, благополучно завершиться, удаться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удаться",
                                "target_lang_sense_clarification": "увенчаться успехом"
                            },
                            {
                                "target_lang_word": "посчастливиться",
                                "target_lang_sense_clarification": "повезти"
                            }
                        ]
