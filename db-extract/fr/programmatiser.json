                "senses": [
                    {
                        "sense_id": "4c097ac2-1269-36f1-9b43-425af3da640a",
                        "entry_id": "65539405-4e76-31df-bd34-d45c5edb91c7",
                        "glosses": [
                            "Donner un caractère programmatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c722a962-935f-4ecb-9bb2-569cd90bd0b0",
                                "sense_id": "4c097ac2-1269-36f1-9b43-425af3da640a",
                                "text": "Le cerveau apprend sans programme et programmatise ses apprentissages ; il régule simultanément quantité de fonctions corporelles."
                            },
                            {
                                "example_id": "08fd2cac-d2a5-4559-933a-b9ea5f6595d5",
                                "sense_id": "4c097ac2-1269-36f1-9b43-425af3da640a",
                                "text": "En résumé, même les publics réflexifs des dispositifs de communication interactifs tendent non seulement à reproduire à petite échelle l’asymétrie des dispositifs médiatiques de masse, mais aussi à « programmatiser » le flot de messages mis en circulation."
                            },
                            {
                                "example_id": "65e737d3-ba7a-41a7-875c-dc37b62753f2",
                                "sense_id": "4c097ac2-1269-36f1-9b43-425af3da640a",
                                "text": "Media.Figaro : la régie qui se \"programmatise\"."
                            }
                        ]
                    }
