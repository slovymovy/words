                                "target_senses": [
                                    {
                                        "sense_id": "9eb800df-8c41-38fc-8c66-f2bbc4ac3afd",
                                        "entry_id": "d179afeb-e874-3320-9fc7-91640d8e99aa",
                                        "glosses": [
                                            "In a patriarchal manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "625d1a19-c06f-4e21-84a0-5ea7d8d9341d",
                                                "sense_id": "9eb800df-8c41-38fc-8c66-f2bbc4ac3afd",
                                                "text": "‘Yes,’ continued Takesure, darting pleading glances at my father, who remained patriarchally impervious and stern."
                                            }
