                "senses": [
                    {
                        "sense_id": "e068ca5d-9f4d-3789-adde-afe6c630cbb9",
                        "entry_id": "a453b661-97ba-3940-b966-5c6e3de8fd5d",
                        "glosses": [
                            "сорт чёрного крупнолистового чая, выращиваемого на северо-востоке Индии, в долине реки Брахмапутры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6285405a-3605-41a8-ba74-aecc9d491c3e",
                                "sense_id": "e068ca5d-9f4d-3789-adde-afe6c630cbb9",
                                "text": "У свежезаваренного ассама должен быть насыщенный красный или красно-апельсиновый цвет, а дарджиллинг всегда должен иметь цвет спелого золота."
                            }
                        ]
                    }
                ],
