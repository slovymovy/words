    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93797361-3e1a-3ff8-acd3-a3457b3ac9ca",
                    "sense_definition": "mały <w>płot</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ogrodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wlazł kotek na <w>płotek</w> i mruga.",
                            "target_lang_translations": {
                                "ru": "Залез котик на <w>заборчик</w> и подмигивает."
                            }
                        },
                        {
                            "text": "Dzieci pomalowały drewniany <w>płotek</w> w ogrodzie na biało.",
                            "target_lang_translations": {
                                "ru": "Дети покрасили деревянный <w>заборчик</w> в саду в белый цвет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drewniany płotek",
                        "ogrodowy płotek"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой забор или ограда"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заборчик",
                                "target_lang_sense_clarification": "уменьшительно-ласкательная форма от слова забор, обозначающая небольшое ограждение"
                            },
                            {
                                "target_lang_word": "оградка",
                                "target_lang_sense_clarification": "небольшое ограждение, часто декоративное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4893c70-c5d3-3e9d-b1ba-0712a69336ec",
                    "sense_definition": "sprzęt lekkoatletyczny używany w biegach płotkarskich",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biegacz potknął się na ostatnim <w>płotku</w> i nie dobiegł do mety.",
                            "target_lang_translations": {
                                "ru": "Бегун споткнулся о последний <w>барьер</w> и не добежал до финиша."
                            }
                        },
                        {
                            "text": "Zawodnicy muszą przeskoczyć przez każdy <w>płotek</w> na trasie biegu.",
                            "target_lang_translations": {
                                "ru": "Спортсмены должны перепрыгнуть через каждый <w>барьер</w> на дистанции забега."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bieg przez płotki"
                    ],
                    "target_lang_definitions": {
                        "ru": "спортивный снаряд в виде перекладины на стойках, используемый в беге с препятствиями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барьер",
                                "target_lang_sense_clarification": "спортивное препятствие в виде перекладины"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}