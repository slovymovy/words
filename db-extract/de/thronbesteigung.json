                ],
                "senses": [
                    {
                        "sense_id": "c8b64137-7bd2-3956-8e54-4ff53e5a149a",
                        "entry_id": "c47753eb-465c-3735-960e-9d2a9dbec330",
                        "glosses": [
                            "Amtseinführung eines neuen Monarchen oder Patriarchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9ad727-8d59-4e5c-aebf-8f490d069172",
                                "sense_id": "c8b64137-7bd2-3956-8e54-4ff53e5a149a",
                                "text": "„Schon bald nach der Thronbesteigung zeigte sich, dass im Mogulreich nun ein neuer Wind wehte.“"
                            },
                            {
                                "example_id": "dd76f030-7355-4144-b0e8-e3b0595d79d4",
                                "sense_id": "c8b64137-7bd2-3956-8e54-4ff53e5a149a",
                                "text": "„Der König von Polen, der bei seiner Thronbesteigung den Namen Augustus angenommen hatte, wurde nun ernst und konnte es nicht unterlassen, mich zu unterbrechen.“"
                            },
                            {
                                "example_id": "f4ef262f-228a-4164-883b-53cce3f8e0cf",
                                "sense_id": "c8b64137-7bd2-3956-8e54-4ff53e5a149a",
                                "text": "„Mit der Thronbesteigung verließ er sein Reich im Delta und siedelte nach Thanjavur um.“"
                            },
                            {
                                "example_id": "67b08eed-788c-47de-9fcc-6c84e5be492b",
                                "sense_id": "c8b64137-7bd2-3956-8e54-4ff53e5a149a",
                                "text": "„Nach der Thronbesteigung von Witigis fiel Ibidus in Ungnade und blieb eine Zeit lang inhaftiert; aber beim Herannahen der byzantinisch-römischen Armee unter Belisar erhielt er bald Freiheit und Ehrenrechte zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
