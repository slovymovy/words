                                        "sense_id": "c112abda-f766-341f-8f32-00d153c062e1",
                                        "entry_id": "248b7a03-8fdf-3ad8-beef-45733a1baa47",
                                        "glosses": [
                                            "Person, welche ein Lokal, Hotel oder Ähnliches regelmäßig besucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b23b64-53e2-49dc-bb49-5f1f1fcd04d8",
                                                "sense_id": "c112abda-f766-341f-8f32-00d153c062e1",
                                                "text": "In der Dorfkneipe bin ich Stammgast."
                                            },
                                            {
                                                "example_id": "a14dda26-eab0-4885-be00-7297291f74a9",
                                                "sense_id": "c112abda-f766-341f-8f32-00d153c062e1",
                                                "text": "„Der Verleger war Stammgast im Tram 83.“"
                                            },
                                            {
                                                "example_id": "ed27ce5c-42aa-46e0-b634-530badd38833",
                                                "sense_id": "c112abda-f766-341f-8f32-00d153c062e1",
                                                "text": "„Auch bei den übrigen Stammgästen war er kein Unbekannter, denn regelmäßig schmiss er ohne besonderen Anlass eine Runde.“"
                                            },
                                            {
                                                "example_id": "25247d49-8691-482c-baf2-2e3c4e8c9ec9",
                                                "sense_id": "c112abda-f766-341f-8f32-00d153c062e1",
                                                "text": "„Meist lud er mich ins Café Kranzler ein, mitunter auch ins Excelsior Ernst, wo er Stammgast zu sein schien.“"
                                            },
                                            {
                                                "example_id": "f631c6ed-90e5-4bb9-a38c-019f54c90729",
                                                "sense_id": "c112abda-f766-341f-8f32-00d153c062e1",
                                                "text": "„Sie wurde dort bereits als Stammgast behandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
