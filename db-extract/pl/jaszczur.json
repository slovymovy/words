                                "sense_id": "7dd22f39-6caf-32cd-81d4-ec54feaa6ce6",
                                "text": "Ale jaszczury nie polegają na wzroku, a głównie na węchu – potrafią wyczuć martwe lub zranione zwierzę w promieniu 10 kilometrów!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ac46ccb3-12ce-3e35-80aa-773c635b1459",
                        "entry_id": "45e3a489-75f1-3dca-bf05-a2a39d80e104",
                        "glosses": [
                            "płaz ogoniasty"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "edcb8e53-5c34-3422-8222-70f25a37dd9e",
                        "entry_id": "45e3a489-75f1-3dca-bf05-a2a39d80e104",
                        "glosses": [
                            "skóra używana w kaletnictwie do wyrobu galanterii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74162692-d15d-41b6-ac13-b74f9f5ac162",
                                "sense_id": "edcb8e53-5c34-3422-8222-70f25a37dd9e",
                                "text": "Kupię żonie torebkę z jaszczuru na targu w Jerozolimie."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "c162696b-fa08-3010-bef5-12f2760bb0da",
                        "entry_id": "45e3a489-75f1-3dca-bf05-a2a39d80e104",
                        "glosses": [
                            "pochwa szabli obciągnięta skórą zwierzęcą, także gadzią"
                        ],
                        "tags": [
