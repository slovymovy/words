                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>nick</w> your skin while shaving.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы не <w>порезать</w> кожу во время бритья.",
                                "zh": "刮胡子时要小心，别<w>划破</w>了皮肤。"
                            }
