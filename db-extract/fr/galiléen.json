                ],
                "senses": [
                    {
                        "sense_id": "890d4721-69a0-3e41-90c6-bf191eb6b5f7",
                        "entry_id": "3625ad94-5ff5-332e-9d95-092035217803",
                        "glosses": [
                            "Relatif à la province de Galilée, en Palestine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36e31c28-5f73-4218-9741-4fc1e8d402ea",
                                "sense_id": "890d4721-69a0-3e41-90c6-bf191eb6b5f7",
                                "text": "Le paysan galiléen, moins instruit que l’habitant des villes, pouvait cependant faire preuve de beaucoup plus d’indépendance dans les idées et d’un véritable esprit de liberté."
                            },
                            {
                                "example_id": "bb7d8fc0-ae91-4611-be5e-6fcf5eed2de9",
                                "sense_id": "890d4721-69a0-3e41-90c6-bf191eb6b5f7",
                                "text": "Au départ, l’homme n’avait pas grand-chose pour lui : un physique passe-partout, un accent de bouseux galiléen, et surtout il venait de Nazareth, le trou du cul du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b62024d-87c2-3cba-8469-43576f6ce4fd",
                        "entry_id": "3625ad94-5ff5-332e-9d95-092035217803",
                        "glosses": [
                            "Relatif aux travaux de Galilée, mathématicien, physicien, et astronome italien des XVIᵉ et XVIIᵉ siècles."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "0118bbcd-b2bf-4fa4-976d-60e2e33283ca",
                                "sense_id": "1b62024d-87c2-3cba-8469-43576f6ce4fd",
                                "text": "Les satellites des planètes géantes peuvent se classer en différents groupes. Jupiter possède quatre gros satellites découverts par Galilée au début du XVIIᵉ siècle : Io, Europe, Ganymède et Callisto, appelés satellites galiléens."
                            },
                            {
                                "example_id": "58acdc55-5d6a-48a8-9064-373436004803",
                                "sense_id": "1b62024d-87c2-3cba-8469-43576f6ce4fd",
                                "text": "La relativité galiléenne. — Système, référentiel galiléen."
                            }
                        ]
                    }
                ],
