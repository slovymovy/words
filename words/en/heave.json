{
    "word_family": [
        "upheave",
        "heaving"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3ef31b2-686b-3ba1-ae96-33efdd321285",
                    "sense_definition": "An effort to raise or move something heavy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gave one more <w>heave</w> and the heavy box finally moved.",
                            "target_lang_translations": {
                                "zh": "我们又<w>用力</w>推了一次，沉重的箱子终于动了。"
                            }
                        },
                        {
                            "text": "With a great <w>heave</w>, the workers lifted the stone into place.",
                            "target_lang_translations": {
                                "zh": "工人们<w>用力</w>一举，将石头放到了位置上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a heave"
                    ],
                    "target_lang_definitions": {
                        "zh": "用力举起或移动重物时的努力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用力",
                                "target_lang_sense_clarification": "指为了移动重物而施加的巨大力气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e64e8b8c-7cb7-3796-8d47-fec51c1e7bac",
                    "sense_definition": "An effort to vomit; retching.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell made him feel a sudden <w>heave</w> in his stomach.",
                            "target_lang_translations": {
                                "zh": "那股气味让他胃里一阵<w>干呕</w>。"
                            }
                        },
                        {
                            "text": "After the dry <w>heave</w>, she felt slightly better.",
                            "target_lang_translations": {
                                "zh": "一阵<w>干呕</w>过后，她感觉好了一些。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retch"
                    ],
                    "target_lang_definitions": {
                        "zh": "呕吐的动作或干呕。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "干呕",
                                "target_lang_sense_clarification": "指有呕吐感但未吐出东西的动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9450e9b1-690e-3e88-a150-d329e2a5fbed",
                    "sense_definition": "To lift something heavy with great effort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>heave</w> the piano up the narrow stairs.",
                            "target_lang_translations": {
                                "zh": "他们不得不<w>费力搬动</w>钢琴上狭窄的楼梯。"
                            }
                        },
                        {
                            "text": "He <w>heaved</w> the heavy bag onto his shoulder.",
                            "target_lang_translations": {
                                "zh": "他<w>费力搬动</w>沉重的袋子扛在肩上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hoist"
                    ],
                    "common_phrases": [
                        "heave up"
                    ],
                    "target_lang_definitions": {
                        "zh": "费力地举起或搬动重物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "费力搬动",
                                "target_lang_sense_clarification": "强调搬运重物时的吃力感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75766f4f-ce49-3e2a-91cd-a80a3f0abbe6",
                    "sense_definition": "To throw or cast something with force.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "throwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors <w>heaved</w> the ropes onto the dock.",
                            "target_lang_translations": {
                                "zh": "水手们把绳子<w>用力抛掷</w>到码头上。"
                            }
                        },
                        {
                            "text": "He <w>heaved</w> the rock into the middle of the lake.",
                            "target_lang_translations": {
                                "zh": "他把石头<w>用力抛掷</w>到湖中心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "toss",
                        "hurl"
                    ],
                    "target_lang_definitions": {
                        "zh": "用力投掷或抛出某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用力抛掷",
                                "target_lang_sense_clarification": "指用很大的力气将物体扔出去"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4de09499-3caa-377c-87c1-ed12df7d9d32",
                    "sense_definition": "To utter a sound, such as a sigh, with physical effort.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>heaved</w> a deep sigh after hearing the bad news.",
                            "target_lang_translations": {
                                "zh": "听到坏消息后，她<w>长叹</w>了一声。"
                            }
                        },
                        {
                            "text": "He <w>heaved</w> a weary sigh and sat down to rest.",
                            "target_lang_translations": {
                                "zh": "他<w>长叹</w>了一声，疲惫地坐下来休息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heave a sigh"
                    ],
                    "target_lang_definitions": {
                        "zh": "费力地发出某种声音，如叹气。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "长叹",
                                "target_lang_sense_clarification": "指深沉且费力的叹息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c414212-50fb-3528-97f2-c2f6bef3e6a2",
                    "sense_definition": "To retch or make an effort to vomit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The terrible smell made everyone <w>heave</w>.",
                            "target_lang_translations": {
                                "zh": "那股恶臭让每个人都感到<w>作呕</w>。"
                            }
                        },
                        {
                            "text": "He began to <w>heave</w> after eating the spoiled food.",
                            "target_lang_translations": {
                                "zh": "吃了变质的食物后，他开始<w>作呕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retch",
                        "vomit"
                    ],
                    "target_lang_definitions": {
                        "zh": "干呕或试图呕吐。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "作呕",
                                "target_lang_sense_clarification": "指感到恶心并有呕吐的冲动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}