{
    "word_family": [
        "amaze",
        "amazing",
        "amazed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a1a4ddb-5f60-3980-b5c6-054d00b9bb79",
                    "sense_definition": "A feeling of great surprise or wonder.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stared at the beautiful sunset in <w>amazement</w>.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на красивый закат с <w>изумлением</w>.",
                                "tr": "Güzel gün batımına <w>hayranlıkla</w> baktı."
                            }
                        },
                        {
                            "text": "To my <w>amazement</w>, he finished the difficult project in one day.",
                            "target_lang_translations": {
                                "ru": "К моему <w>удивлению</w>, он закончил сложный проект за один день.",
                                "tr": "<w>Şaşkınlığıma</w> rağmen, zor projeyi bir günde bitirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonishment",
                        "wonder",
                        "surprise"
                    ],
                    "common_phrases": [
                        "in amazement",
                        "to my amazement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильного удивления или восхищения.",
                        "tr": "Büyük bir şaşkınlık, hayranlık veya hayret duygusu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изумление",
                                "target_lang_sense_clarification": "крайняя степень удивления"
                            },
                            {
                                "target_lang_word": "удивление",
                                "target_lang_sense_clarification": "состояние, вызванное чем-то неожиданным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şaşkınlık",
                                "target_lang_sense_clarification": "beklenmedik bir durum karşısında yaşanan şaşırma hali"
                            },
                            {
                                "target_lang_word": "hayret",
                                "target_lang_sense_clarification": "büyük bir şaşkınlık ve merak duygusu"
                            },
                            {
                                "target_lang_word": "hayranlık",
                                "target_lang_sense_clarification": "büyülenme ve takdirle karışık şaşkınlık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "445f3833-0c66-39ef-8fbf-094d57fe5982",
                    "sense_definition": "Something that causes a feeling of great surprise or wonder.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evening was full of small <w>amazements</w> that the children never forgot.",
                            "target_lang_translations": {
                                "ru": "Вечер был полон маленьких <w>чудес</w>, которые дети запомнили навсегда.",
                                "tr": "Akşam, çocukların asla unutmadığı küçük <w>harikalarla</w> doluydu."
                            }
                        },
                        {
                            "text": "The new building is an <w>amazement</w> of modern architecture.",
                            "target_lang_translations": {
                                "ru": "Это новое здание — настоящее <w>диво</w> современной архитектуры.",
                                "tr": "Yeni bina, modern mimarinin bir <w>harikası</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonder",
                        "marvel"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что вызывает чувство сильного удивления или восхищения.",
                        "tr": "Büyük bir şaşkınlık veya hayranlık uyandıran şey; harika, mucize."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "нечто удивительное, поразительное"
                            },
                            {
                                "target_lang_word": "диво",
                                "target_lang_sense_clarification": "нечто необычное, вызывающее восхищение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "harika",
                                "target_lang_sense_clarification": "insanda hayranlık ve şaşkınlık uyandıran şey"
                            },
                            {
                                "target_lang_word": "mucize",
                                "target_lang_sense_clarification": "olağanüstü, şaşırtıcı olay veya varlık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "580dcd62-5fba-3cbc-a91f-a0e0f5bf8013",
                    "sense_definition": "A state of extreme mental confusion or frenzy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden chaos threw the crowd into a state of <w>amazement</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапный хаос поверг толпу в состояние <w>смятения</w>.",
                                "tr": "Ani kaos, kalabalığı tam bir <w>şaşkınlık</w> haline soktu."
                            }
                        },
                        {
                            "text": "He wandered through the streets in a fit of <w>amazement</w>.",
                            "target_lang_translations": {
                                "ru": "Он бродил по улицам в припадке <w>исступления</w>.",
                                "tr": "Sokaklarda bir <w>cinnet</w> halinde dolaştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "frenzy",
                        "madness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильного душевного смятения или исступления.",
                        "tr": "Aşırı zihinsel karmaşa, kafa karışıklığı veya çılgınlık durumu (eskimiş)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "состояние растерянности и беспокойства"
                            },
                            {
                                "target_lang_word": "исступление",
                                "target_lang_sense_clarification": "крайнее возбуждение, потеря самообладания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şaşkınlık",
                                "target_lang_sense_clarification": "zihinsel karmaşa ve ne yapacağını bilememe hali"
                            },
                            {
                                "target_lang_word": "afallama",
                                "target_lang_sense_clarification": "akıl tutulması, sersemlik veya şaşkınlık nöbeti"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}