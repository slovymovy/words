                ],
                "senses": [
                    {
                        "sense_id": "4bb58a42-279f-3000-b1b3-5a73fc29b22c",
                        "entry_id": "52fb9b2f-f38c-34b0-9a6d-ad94ed259c6d",
                        "glosses": [
                            "Rendre noir, ou plus noir (au sens racial)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cbd5372-d867-4a75-8b76-7bd7f11bb206",
                                "sense_id": "4bb58a42-279f-3000-b1b3-5a73fc29b22c",
                                "text": "Durant ses ardeurs juvéniles, il s’était imprégné des mythologies africaines avec lesquelles il essaya de négrifier son esprit orphelin."
                            },
                            {
                                "example_id": "2830355e-659f-4c23-a65f-b2b0b9f16bf2",
                                "sense_id": "4bb58a42-279f-3000-b1b3-5a73fc29b22c",
                                "text": "Ensuite, ils se sont abâtardis, négrifiés, ils se sont amollis dans les délices et la facilité de vivre, tandis qu’au contraire ceux des Tassilis et du Hoggar conservaient intactes leurs qualités primitives de coureurs de pistes."
                            }
                        ]
                    }
                ],
