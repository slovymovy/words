                {
                    "sense_id": "a38a848b-dc23-375e-b56b-1226b5176adc",
                    "sense_definition": "A type of corn or maize with a hard outer hull that, along with the type of starch it contains, makes it suitable for popping.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers grow specific varieties of <w>popcorn</w> that expand significantly when heated.",
                            "target_lang_translations": {
                                "ru": "Фермеры выращивают особые сорта <w>кукурузы для попкорна</w>, которые значительно увеличиваются в объеме при нагревании.",
                                "zh": "农民种植特定的<w>爆裂玉米</w>品种，加热后会显著膨胀。",
                                "es": "Los agricultores cultivan variedades específicas de <w>maíz palomero</w> que se expanden significativamente al calentarse."
                            }
                        },
                        {
                            "text": "You cannot use regular sweet corn for this snack; you must buy <w>popcorn</w> kernels.",
                            "target_lang_translations": {
                                "ru": "Для этой закуски нельзя использовать обычную сладкую кукурузу, нужно покупать зерна <w>для попкорна</w>.",
                                "zh": "做这种零食不能用普通的甜玉米，必须买<w>爆裂玉米</w>粒。",
                                "es": "No puedes usar maíz dulce normal para este aperitivo; debes comprar granos de <w>maíz palomero</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "popcorn kernels",
                        "grow popcorn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сорт кукурузы с твердой оболочкой, пригодный для приготовления попкорна.",
                        "zh": "一种外壳坚硬、适合加热爆裂的玉米品种。",
                        "es": "Variedad de maíz con cáscara dura, apta para hacer palomitas."
                    },
                    "translations": {
