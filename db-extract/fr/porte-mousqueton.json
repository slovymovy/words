                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ccfd7f3-34af-4318-8db7-5f01a783a016",
                                                "sense_id": "60c49041-66ce-3dcd-a913-6e12fe868094",
                                                "text": "a staple town"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e268b90-b6e0-3a45-81d4-57e710ba3825",
                                        "entry_id": "a85702f0-b973-3d5a-92d3-18fb3b8b32af",
                                        "glosses": [
                                            "Established in commerce; occupying the markets; settled."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83160cc9-8087-432a-af44-95ad797276ee",
                                                "sense_id": "3e268b90-b6e0-3a45-81d4-57e710ba3825",
                                                "text": "a staple trade"
                                            },
                                            {
                                                "example_id": "31e443c7-e8c5-416a-b38f-863980f65dda",
                                                "sense_id": "3e268b90-b6e0-3a45-81d4-57e710ba3825",
                                                "text": "To ruin with worse ware our staple trade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44f14a48-60b9-373b-9e47-3a4381b5877d",
                                        "entry_id": "a85702f0-b973-3d5a-92d3-18fb3b8b32af",
                                        "glosses": [
                                            "Fit to be sold; marketable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a14fdce-479a-42e9-a070-c0cdad9bc8f4",
                                                "sense_id": "44f14a48-60b9-373b-9e47-3a4381b5877d",
                                                "text": "What needy writer would not solicit to work under such masters, who will pay us beforehand, take off as much of our ware as we please, at our own rates, and trouble not themselves to examine, either before or after they have bought it, whether it be staple, or not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a3d2c15-063d-329d-af18-2db853f5cc90",
                                        "entry_id": "a85702f0-b973-3d5a-92d3-18fb3b8b32af",
                                        "glosses": [
                                            "Regularly produced or manufactured in large quantities; belonging to wholesale traffic; principal; chief."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f82dee-63e0-4ee1-9a81-87fd36a420a8",
                                                "sense_id": "0a3d2c15-063d-329d-af18-2db853f5cc90",
                                                "text": "wool, the great staple commodity of England"
                                            },
                                            {
                                                "example_id": "923d92a1-f1a0-4ae6-a7fd-b6b632488b81",
                                                "sense_id": "0a3d2c15-063d-329d-af18-2db853f5cc90",
                                                "text": "The pastoral industry, which had weathered the severe depression of the early forties by recourse to boiling down the sheep for their tallow, and was now firmly re-established as the staple industry of the colony, was threatened once more with eclipse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "staple",
                                "target_lang_code": "en",
                                "target_senses": [
