                ],
                "senses": [
                    {
                        "sense_id": "67eb59e2-f9a7-3baf-a659-adf51a7edf57",
                        "entry_id": "e4132847-04c3-3c8f-a8ef-51161883c516",
                        "glosses": [
                            "Anemone L., zawilec"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bcb65687-c346-3187-87ef-61e5854bc123",
                        "entry_id": "e4132847-04c3-3c8f-a8ef-51161883c516",
                        "glosses": [
                            "roślina z rodzaju anemonów (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8667b979-baab-4f42-87a4-9cfff15513d7",
                                "sense_id": "bcb65687-c346-3187-87ef-61e5854bc123",
                                "text": "Uprawiali w milczeniu warzywa i białe kwiaty. Tylko białe - lilie, przebiśniegi, anemony, białe piwonie i georginie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "25fcb92b-1901-3621-888e-ded45a48e6fc",
                        "entry_id": "e4132847-04c3-3c8f-a8ef-51161883c516",
                        "glosses": [
                            "kwiat rośliny z rodzaju anemonów (1.1)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "892afe7d-5179-4f28-80ef-ebba0080f375",
                                "sense_id": "25fcb92b-1901-3621-888e-ded45a48e6fc",
                                "text": "Złociste jaskry, purpurowe anemony, tulipany, ostróżki, maki powiewały unoszącymi się nad nimi rojnie motylkami"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "55d39d9f-2885-3efb-b2e7-ed8fb9b566e2",
                        "entry_id": "e4132847-04c3-3c8f-a8ef-51161883c516",
                        "glosses": [
                            "Actiniaria, ukwiał"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a2d6d32-7acd-4761-b9d9-fae64b70fb96",
                                "sense_id": "55d39d9f-2885-3efb-b2e7-ed8fb9b566e2",
                                "text": "Istnieją w końcu nieśmiertelne gatunki zwierząt (np. anemony czy słodkowodne hydry) niewykazujące żadnych objawów starzenia się, a niektóre wielkie żółwie dożywają 180 lat"
                            },
                            {
                                "example_id": "d0651394-d33c-4401-91be-9e9bd23b2efd",
                                "sense_id": "55d39d9f-2885-3efb-b2e7-ed8fb9b566e2",
                                "text": "W środku groty rozpościera się fascynujący widok na wielobarwne, falujące w płytkiej wodzie anemony i wodorosty"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
