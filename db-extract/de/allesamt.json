        "de-extract.jsonl": [
            {
                "entry_id": "5c7e0c7a-34bf-3e75-9b20-eb5c787f4907",
                "word": "allesamt",
                "pos": "pron",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                        "entry_id": "5c7e0c7a-34bf-3e75-9b20-eb5c787f4907",
                        "glosses": [
                            "alle zusammen, alle miteinander, ausnahmslos"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4c3fb75e-7f2c-4581-b9be-4a496f570c68",
                                "sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                                "text": "Diese Schollen sind allesamt fangfrisch."
                            },
                            {
                                "example_id": "731c0756-8fec-44ca-ad85-2a9c0e4b7bc1",
                                "sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                                "text": "Erstaunlicherweise kam es bei Theodors Junggesellenabschied zu keinerlei peinlichen Zwischenfällen, obwohl die Anwesenden irgendwann allesamt ziemlich betrunken waren."
                            },
                            {
                                "example_id": "41ca8fb0-b3fc-41a6-980a-df7321dbfcb7",
                                "sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                                "text": "Als ihre Gäste eine ernsthafte Gefahr für ihre teuren Möbel zu werden drohten, warf Kriemhilde sie kurzerhand allesamt hinaus."
                            },
                            {
                                "example_id": "43095a64-26da-4f0d-bdb3-8f73cb603f53",
                                "sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                                "text": "Nach dem schlechten Abschneiden seiner Mannschaft beim Turnier zog der Trainer den Spielern in der Kabine allesamt die Hammelbeine lang."
                            },
                            {
                                "example_id": "7e1c5473-e51d-49e6-b351-ba7f25d93347",
                                "sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                                "text": "„Dabei setzen sie allesamt auf die Hochspannungs-Gleichstromübertragung (HGÜ), die es erlaubt, große Strommengen mit vergleichsweise geringen Verlusten über lange Strecken zu übertragen […].“"
                            },
                            {
                                "example_id": "0688db8d-5da2-4fd7-bce9-14c5e2bb6a58",
                                "sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                                "text": "„Auch wenn die besten Spieler den Stadtmeisterschaften allesamt fernblieben, bekamen die Zuschauer auf der Tennisanlage von GWR Büderich bei den Finalspielen am Samstag zum Teil guten Sport geboten.“"
                            },
                            {
                                "example_id": "ebac0f54-b91b-43c4-be46-5772d50b79b0",
                                "sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                                "text": "„Zu stark war noch die Beeinflussung durch die Eltern, Lehrer und Priester, die ihm allesamt eingeredet hatten, es sei eine Schande und Sünde, sich mit Mädchen abzugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10275a49-11ee-45e3-94c9-c3cd3b6ce554",
                        "source_entry_id": "5c7e0c7a-34bf-3e75-9b20-eb5c787f4907",
                        "source_sense_id": "19240926-8559-3504-a67d-d7251ee81640",
                        "source_sense_description": "umgangssprachlich: alle zusammen, alle miteinander, ausnahmslos",
                        "target_lang_word": "all together",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all together",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3af70e30-c7c1-3106-a703-b43c58e310ff",
                                        "entry_id": "33772e94-be1b-392c-afbe-8b8b9d296552",
                                        "glosses": [
                                            "As a group."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77502c86-9055-4914-b7f4-e4fb58234032",
                                                "sense_id": "3af70e30-c7c1-3106-a703-b43c58e310ff",
                                                "text": "If you put these advantages all together, the offer is attractive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8a0fa89-0531-3dd1-bb8c-d083ac7d259e",
                                        "entry_id": "33772e94-be1b-392c-afbe-8b8b9d296552",
                                        "glosses": [
                                            "In the same place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f276ef29-86e5-4852-a9cd-0d83e25f7abd",
                                                "sense_id": "b8a0fa89-0531-3dd1-bb8c-d083ac7d259e",
                                                "text": "We got the family all together to celebrate grandma’s birthday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97ed582-257c-3f6d-8bfa-96828e753855",
                                        "entry_id": "33772e94-be1b-392c-afbe-8b8b9d296552",
                                        "glosses": [
                                            "All at the same time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84adbb28-c9b4-426d-9243-8c19a0c32f71",
                                                "sense_id": "d97ed582-257c-3f6d-8bfa-96828e753855",
                                                "text": "She and her companions rose up and sung all together."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all together",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08923870-1596-36a7-9630-150aba3d8aba",
                                        "entry_id": "3949f7b6-91ce-3b94-a40a-628e7487cbca",
                                        "glosses": [
                                            "Calling for other people to say something together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7dc9b03-1120-4e64-ae6c-9e7e00e3410d",
                                                "sense_id": "08923870-1596-36a7-9630-150aba3d8aba",
                                                "text": "All together! Say it: \"Long live our country!\""
                                            }
