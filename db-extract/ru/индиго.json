                        "cross_references": [
                            {
                                "target_word": "indigo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9641f09-51de-37e1-9719-880b282dee44",
                                        "entry_id": "cb10f0a5-12ae-3ea0-bb06-534e89f3b9bc",
                                        "glosses": [
                                            "A purplish-blue color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4d5f93f-a160-4e3d-a0bd-9676cc654356",
                                                "sense_id": "e9641f09-51de-37e1-9719-880b282dee44",
                                                "text": "The night was considerably clearer than anybody on board her desired when the schooner Ventura headed for the land. It rose in places, black and sharp against the velvety indigo, over her dipping bow, though most of the low littoral was wrapped in obscurity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a463a546-1074-3be7-8ff7-e1c87cd4704d",
                                        "entry_id": "cb10f0a5-12ae-3ea0-bb06-534e89f3b9bc",
                                        "glosses": [
                                            "An indigo-colored dye obtained from certain plants (indigo plant or woad), or a similar synthetic dye."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afae82a6-6d57-3f22-b403-f9f2a546b41b",
                                        "entry_id": "cb10f0a5-12ae-3ea0-bb06-534e89f3b9bc",
                                        "glosses": [
                                            "An indigo plant, such as from species in genera Indigofera, Amorpha (false indigo), Baptisia (wild indigo), and Psorothamnus and Dalea (indigo bush)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "indigo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1fd48e2-58bf-3e9a-895e-89865abd4d5e",
