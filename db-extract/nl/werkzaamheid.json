                                "sense_id": "f640bca1-2f75-31c1-8e0e-713268087106",
                                "text": "Wat een werkzaamheid heeft die jongen toch..."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb5d3783-10d3-36f4-a479-c4e23e94b4d2",
