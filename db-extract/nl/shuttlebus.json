                "senses": [
                    {
                        "sense_id": "7f821c28-ce5c-3afb-b301-02a54acb541c",
                        "entry_id": "db4188dc-3628-3dba-84a9-7b6009ff0973",
                        "glosses": [
                            "een passagiersbus die zonder dienstregeling en zonder tussenstops tussen twee bestemmingen heen en weer blijft rijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d0bfa38-189a-4ca4-9533-f1bdb53c8d16",
                                "sense_id": "7f821c28-ce5c-3afb-b301-02a54acb541c",
                                "text": "Mont Saint-Michel aan de kust van Normandië wordt momenteel ontruimd, dat meldt de Franse nieuwssite BFM TV. Er wordt gezocht naar een persoon die vanochtend op een shuttlebus zou geroepen hebben dat hij agenten wil vermoorden."
                            },
                            {
                                "example_id": "115c0765-c461-4a2f-a68b-17b39d8591db",
                                "sense_id": "7f821c28-ce5c-3afb-b301-02a54acb541c",
                                "text": "“We zijn hier fenomenaal ontvangen en worden met een shuttlebus rondgereden”, aldus Otto-Jan. “Dichter bij een rockster zijn dan dit gaan we nooit komen”, beaamt Jelle."
                            }
                        ]
                    }
