                "senses": [
                    {
                        "sense_id": "0c7a461e-f2b1-31f4-912d-a4c35c24a1d5",
                        "entry_id": "f093d65a-219e-3a3a-a0f3-545b1c0539ee",
                        "glosses": [
                            "Créer une adhérence dans l’œil grâce à la cicatrisation de la brûlure créée par un fort rayon lumineux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0744c95-aa3a-4518-8a9e-e158878618c1",
                                "sense_id": "0c7a461e-f2b1-31f4-912d-a4c35c24a1d5",
                                "text": "Il est donc très important d'avoir une pupille libre pour photocoaguler sans difficultés la périphérie rétinienne."
                            },
                            {
                                "example_id": "0a6a29dd-ce50-4d68-b923-a6785baf4ea6",
                                "sense_id": "0c7a461e-f2b1-31f4-912d-a4c35c24a1d5",
                                "text": "Lorsqu'il s'agit de photocoaguler l'iris ou les tumeurs rétiniennes, les résultats nous ont paru moins probants."
                            }
                        ]
                    }
