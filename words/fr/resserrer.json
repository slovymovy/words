{
    "word_family": [
        "desserrer",
        "resserrement",
        "serrement",
        "serrure",
        "serrurier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60e7fcff-ae94-30bc-b73f-6ceb24fbee2e",
                    "sense_definition": "Serrer davantage ou de nouveau un objet qui s'est détendu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tension_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu devrais <w>resserrer</w> ta ceinture pour que ce pantalon tienne bien."
                        },
                        {
                            "text": "Le mécanicien a dû <w>resserrer</w> les vis de la roue avant le départ."
                        }
                    ],
                    "synonyms": [
                        "retendre",
                        "rajuster"
                    ],
                    "antonyms": [
                        "desserrer",
                        "relâcher"
                    ],
                    "common_phrases": [
                        "resserrer sa ceinture",
                        "resserrer un nœud",
                        "resserrer une vis"
                    ]
                },
                {
                    "sense_id": "2334e979-c6e6-326e-8db1-5196b0820dfc",
                    "sense_definition": "Rendre plus étroits ou plus solides des liens affectifs, diplomatiques ou sociaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce voyage en famille a permis de <w>resserrer</w> les liens entre les cousins."
                        },
                        {
                            "text": "Les deux pays voisins souhaitent <w>resserrer</w> leurs relations économiques."
                        }
                    ],
                    "synonyms": [
                        "consolider",
                        "renforcer"
                    ],
                    "antonyms": [
                        "distendre"
                    ],
                    "common_phrases": [
                        "resserrer les liens",
                        "resserrer les relations"
                    ]
                },
                {
                    "sense_id": "997a1de9-e673-3b2a-b836-45ddef0457ac",
                    "sense_definition": "Devenir plus étroit ou réduire une distance, un écart spatial ou temporel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche du pont, la chaussée commence à se <w>resserrer</w> brutalement."
                        },
                        {
                            "text": "Le coureur accélère dans le dernier tour et <w>resserre</w> l'écart avec le peloton."
                        }
                    ],
                    "synonyms": [
                        "rétrécir",
                        "diminuer"
                    ],
                    "antonyms": [
                        "élargir",
                        "écarter"
                    ],
                    "common_phrases": [
                        "resserrer l'écart",
                        "se resserrer progressivement"
                    ]
                },
                {
                    "sense_id": "9edc0afa-4a38-3cb2-9eb2-e0f9ac24de3c",
                    "sense_definition": "Devenir ou rendre plus strict, plus rigoureux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reglementation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a décidé de <w>resserrer</w> la discipline après plusieurs retards injustifiés."
                        },
                        {
                            "text": "La police a <w>resserré</w> les contrôles aux frontières tout au long de la semaine."
                        }
                    ],
                    "synonyms": [
                        "durcir",
                        "renforcer"
                    ],
                    "antonyms": [
                        "assouplir"
                    ],
                    "common_phrases": [
                        "resserrer la discipline",
                        "resserrer les contrôles"
                    ]
                },
                {
                    "sense_id": "c115927c-579e-3ab9-a165-4048b128769c",
                    "sense_definition": "Abréger ou condenser un texte ou un exposé en supprimant les longueurs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éditeur a demandé à l'auteur de <w>resserrer</w> ce chapitre trop verbeux."
                        },
                        {
                            "text": "Pour respecter le temps imparti, vous devez <w>resserrer</w> votre présentation."
                        }
                    ],
                    "synonyms": [
                        "abréger",
                        "condenser",
                        "élaguer"
                    ],
                    "antonyms": [
                        "développer"
                    ],
                    "common_phrases": [
                        "resserrer un texte",
                        "resserrer un récit"
                    ]
                }
            ]
        }
    ]
}