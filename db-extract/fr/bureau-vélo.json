                        "glosses": [
                            "Bureau (meuble) équipé d’une installation permettant de pédaler tout en y restant assis, afin de ne pas rester trop longtemps inactif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b24c9d-c37e-472f-94f0-f70f9a13ecee",
                                "sense_id": "fad88d71-74dd-3cf3-8dda-209547b01ca3",
                                "text": "Ce bureau-vélo, en plastique recyclé, permet d’éviter de rester trop longtemps inactif devant l’écran de son ordinateur et de travailler, tout en faisant de l’exercice."
                            },
                            {
                                "example_id": "709bf36d-5542-4657-b7cf-cfa1c660a910",
                                "sense_id": "fad88d71-74dd-3cf3-8dda-209547b01ca3",
                                "text": "À Condé-sur-l’Escaut, une association aide à la mise en place de « bureaux-vélos » en milieu scolaire pour aider les élèves à se canaliser."
                            },
                            {
                                "example_id": "6386c4e8-2be8-4861-bcff-a7e13f1c4eb6",
                                "sense_id": "fad88d71-74dd-3cf3-8dda-209547b01ca3",
                                "text": "Les bureaux-vélos se multiplient à Charleville et dans les Ardennes."
                            }
                        ]
