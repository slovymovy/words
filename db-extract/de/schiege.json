                                        "sense_id": "10d46538-33d5-3209-b559-da0ef572cdd2",
                                        "entry_id": "d8afe2cc-d54f-35c8-869d-3ae5c8abb4b0",
                                        "glosses": [
                                            "A young, newly-weaned pig."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf436284-3a11-4e00-a4f8-1ff3629378a6",
                                                "sense_id": "10d46538-33d5-3209-b559-da0ef572cdd2",
                                                "text": "Why, was not one animal of every kind – a calf, and a lamb, and a filly, and a shote – upon the place marked with little Moses's own brand?"
                                            },
                                            {
                                                "example_id": "a6dbc98e-0dca-41bb-bcb1-9ef3d2875422",
                                                "sense_id": "10d46538-33d5-3209-b559-da0ef572cdd2",
                                                "text": "There would have been nature studies – a tiger pursuing a bird of paradise, a choking snake sheathing whole the flayed trunk of a shoat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36fe7266-2d58-3354-a862-b19a676d0a45",
                                        "entry_id": "fc8cc2e5-e001-37a6-bf8c-982205c18fe0",
                                        "glosses": [
                                            "A sheep–goat hybrid (whether artificially produced or the result of animals from these species naturally intermating)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
