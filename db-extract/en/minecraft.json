    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3760a33f-a42b-3c49-9ebb-14924269ec10",
                "word": "Minecraft",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a954063-20c3-3378-9409-6732d4643b59",
                        "entry_id": "3760a33f-a42b-3c49-9ebb-14924269ec10",
                        "glosses": [
                            "A sandbox video game, released in 2011, in which players explore a three-dimensional world made of blocks and can craft items, build structures, fight mobs to get experience points, enchant items and defeat bosses to earn rewards."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f26bad-3c2a-4a42-90ea-d78fad87732f",
                                "sense_id": "9a954063-20c3-3378-9409-6732d4643b59",
                                "text": "Chlorine blue, bordered in forest green and looking out onto a Grecian gazebo, the pool was composed of hundreds of ceramic kitchen tiles, like a Minecraft version of C.Z. Guest’s once-upon-a-time world."
                            },
                            {
                                "example_id": "15ece395-1bac-4722-8adb-1df26afcba94",
                                "sense_id": "9a954063-20c3-3378-9409-6732d4643b59",
                                "text": "Sam has beaten the Ender Dragon twice, killed the wither thrice, obtained netherite armor and built an obsidian fort in Minecraft."
                            },
                            {
                                "example_id": "5eb7bf37-427d-4cfc-86cb-12adc4fccd99",
                                "sense_id": "9a954063-20c3-3378-9409-6732d4643b59",
                                "text": "If you know a tween, chances are you have bought them something sparkly in the past couple of years – and not only if they are a girl. From Next’s boys’ sequinned T-shirt that flips between Minecraft designs to Paperchase’s rainbow-encrusted notebook[…], these addictively tactile surfaces are everywhere."
                            },
                            {
                                "example_id": "c9a579bd-0141-414c-89c7-4f48de370177",
                                "sense_id": "9a954063-20c3-3378-9409-6732d4643b59",
                                "text": "London’s mayoralty insists that its new homes must look like old homes – just new, and more of them. So the city has ended up with endless variations of a Georgian terrace that looks like it’s been rendered in Minecraft."
                            }
                        ]
                    }
                ],
