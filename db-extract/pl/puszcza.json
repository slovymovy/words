                        ],
                        "examples": [
                            {
                                "example_id": "a826b11c-7788-4a5f-971a-693d6f5a7622",
                                "sense_id": "4ba2e8c4-5e72-3201-bdfb-565719f60d6f",
                                "text": "A Mojżesz pasł trzodę Jetra, świekra swego, kapłana Madyjańskiego; i zagnał trzodę na puszczą, a przyszedł do góry Bożej, do Horeb"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28138465-2584-4f61-9937-7c6c2b2cab98",
                        "source_entry_id": "f8a299b4-84ee-35b1-b4c1-c4ffb09a5568",
                        "source_sense_id": "3a7dba0a-1d1e-3a8b-a201-61c492016410",
                        "target_lang_word": "prales",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prales",
