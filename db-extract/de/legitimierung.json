                ],
                "senses": [
                    {
                        "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                        "entry_id": "687ae2bb-b8d7-312c-968c-4cb8185660e3",
                        "glosses": [
                            "Rechtfertigung oder Anerkennung einer Handlung/Person als berechtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae289ba-56f2-4585-aec4-cbdfff4e912b",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„Für Putin ist eine hohe Wahlbeteiligung wichtig, weil in jedem Staat, auch in einem autoritären Staat, der Herrscher Legitimierung braucht.“"
                            },
                            {
                                "example_id": "f13f7311-a789-44bb-87ea-f328f98c5760",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "[Russland:] „Wahlen stellten seit 1991 »einen sekundären Vorgang zur Legitimierung des Status quo dar«.“"
                            },
                            {
                                "example_id": "b36165ad-5a3d-4c9f-97e2-d099e85965ef",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„Wladimir Putins Außenminister Sergej Lawrow sprach der ukrainischen Regierung am zweiten Tag der Angriffe die demokratische Legitimierung ab.“"
                            },
                            {
                                "example_id": "c1e47b15-5f89-4bfb-bfa8-5cd584353f0f",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„Auch kommt der Regierung Assad eine demokratische Legitimierung durch Wahlen sehr gelegen.“"
                            },
                            {
                                "example_id": "e080e304-8c46-4f6b-a6d2-540188be0761",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„Diese Mehrheitsbildung durch Konsens, ausgedrückt in Wahlen, bildet zunächst die Grundlage der Legitimierung einer Regierung. Wie aber erfolgt die Legitimierung eines politischen Systems?“"
                            },
                            {
                                "example_id": "bae6039f-640c-4f29-84b4-680f3904b410",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„Die göttliche Legitimierung des Kaisers blieb jedoch bis in die Neuzeit erhalten.“"
                            },
                            {
                                "example_id": "40b4bc7f-1284-4b1a-ad4d-d4e87a854959",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„Die Konsequenzen der Normalisierung und Legitimierung der radikalen Rechten gehen allerdings weit über die Parteienpolitik hinaus.“"
                            },
                            {
                                "example_id": "7147ee7b-654e-4860-a86d-1ee3743c1560",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "Das Konzept der \"Rasse\" ist der Versuch der Legitimierung von Unterdrückung, Ausgrenzung, Sklaverei, Vertreibung und Völkermord."
                            },
                            {
                                "example_id": "4a589de1-6f04-48e6-ad7a-1254d097077d",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "Viele Menschen stehen vor dem Problem ethischer Legitimierungen, beispielsweise bei Tierversuchen für die Forschung, militärischem Eingreifen bei Genoziden/starken Menschenrechtsverletzungen, Whistleblowing bei staatlichem Fehlverhalten oder Schwangerschaftsabbrüchen."
                            },
                            {
                                "example_id": "2c0e42ca-bcf5-4614-8645-32d229891909",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„Ein letztes Argument der Legitimierung von Ungleichheiten verweist schlicht auf den Markt.“"
                            },
                            {
                                "example_id": "0de05140-1ad6-4fed-bff1-9bdcb8caf9ba",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„Für den Waffeneinsatz gegen DDR-Flüchtlinge gab es zunächst nur mündliche Befehle, eine offizielle Legitimierung erfolgte erst 1982 durch das „Grenz-Gesetz“ (§213 StGB DDR).“"
                            },
                            {
                                "example_id": "4c1f405d-f5f8-43b8-8bf5-1d92ac3216ae",
                                "sense_id": "90f5f659-87ee-3ed2-b0fa-4ffaf9f7cdd1",
                                "text": "„»Nicht zuletzt dienen Online-Petitionen auch der Legitimierung: Als wir zuletzt die Maus-Statue vom WDR entwendet und auf Deutschlandtour geschickt haben, um gegen Einsparungen bei den Bildungs- und Informationsangeboten der öffentlich-rechtlichen Sender zu protestieren, half es zu sagen, hier haben schon 400.000 Menschen unterschrieben.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a3a6998-b6de-3225-a228-95688b6a6eaa",
                        "entry_id": "687ae2bb-b8d7-312c-968c-4cb8185660e3",
                        "glosses": [
                            "rechtliche Anerkennung (beispielsweise der Abstammung eines Kindes durch Heirat)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58162308-eb00-4b79-9134-74fc1e40c226",
                                "sense_id": "4a3a6998-b6de-3225-a228-95688b6a6eaa",
                                "text": "„Ebenso wie in der Legitimierung von Sexualität wird der Zweck der Ehe traditionell in der Zeugung und Erziehung von Kindern gesehen.“"
                            },
                            {
                                "example_id": "fb50ac63-5b35-4b63-98b3-e1483e793e00",
                                "sense_id": "4a3a6998-b6de-3225-a228-95688b6a6eaa",
                                "text": "„Heiratsbeziehungen erfüllen grundsätzlich mehrere unterschiedliche Aufgaben, vor allem dienen sie: […] der Legitimierung der Nachkommenschaft, auch in der Erbfolge“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b678e458-d9f6-3120-ba22-3f77dfea6f34",
                        "entry_id": "687ae2bb-b8d7-312c-968c-4cb8185660e3",
                        "glosses": [
                            "Nachweis einer Person (beispielsweise durch einen Ausweis) oder Organisation, zu etwas berechtigt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98d968e3-0364-4eb3-b38f-8a795d99a46a",
                                "sense_id": "b678e458-d9f6-3120-ba22-3f77dfea6f34",
                                "text": "Zur Kontoeröffnung ist eine Legitimierung mit Ausweis notwendig."
                            },
                            {
                                "example_id": "0b19d603-b2c4-4a74-a516-a85d9ac36385",
                                "sense_id": "b678e458-d9f6-3120-ba22-3f77dfea6f34",
                                "text": "Die Legitimierung bei der Anmeldung am Computer erfolgt durch Abfrage von Benutzername und Passwort."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a09a9ce0-86d3-4489-b47e-08bbd18415d5",
