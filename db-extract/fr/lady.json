                                    },
                                    {
                                        "sense_id": "b3509713-4016-3265-a1e4-0b1d16c0a590",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A five-pound note. (Rhyming slang, Lady Godiva for fiver.)"
                                        ],
