                                    {
                                        "sense_id": "da1149b7-7af6-366f-b9ed-a29c64555fe6",
                                        "entry_id": "fff97717-656c-362b-a3bb-3054ef5c5464",
                                        "glosses": [
                                            "Examining one's own perceptions and sensory experiences; contemplative or thoughtful about oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf6b77f-7fcb-42de-8a39-ac41be110718",
                                                "sense_id": "da1149b7-7af6-366f-b9ed-a29c64555fe6",
                                                "text": "All of a sudden Syme, who was standing as if blind with introspective thought, swung round and cried out, like a man waking from sleep—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdc1d895-5619-4edf-8e3f-e37988ef642e",
                        "source_entry_id": "53b52d0c-9bd3-38f8-aaa9-7daf836c296a",
                        "target_lang_word": "introspectivo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
