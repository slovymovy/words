                        "glosses": [
                            "A narrow outlet from which a body of water pours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f62e00c-1712-4da0-b076-1fb5b8b7ec4f",
                                "sense_id": "14956ce9-eec2-34d4-a11f-a9e20574b4a0",
                                "text": "In level portions of the country vertical shafts are preferred, but where the mine is situated upon a hill a debouch may often be found below the sulphur seam, ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "9df3e3f2-b5e2-3f7a-887b-678360fa216e",
                        "entry_id": "0a24e583-9d22-331d-bee4-e8b2ad3d29cf",
                        "glosses": [
                            "A fortress at the end of a defile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dff8d5c-0919-496d-9aa1-472d699a4b28",
                                "sense_id": "9df3e3f2-b5e2-3f7a-887b-678360fa216e",
                                "text": "To prevent another demonstration of this character, and to insure a debouch on the south bank of the James, it became necessary to occupy Coggin's Point, which was done on the 3d, and the enemy driven back towards Petersburg."
                            }
                        ]
                    }
                ],
