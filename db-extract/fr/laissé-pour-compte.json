                ],
                "senses": [
                    {
                        "sense_id": "1990fa97-f262-348e-9f0b-0157283fbbad",
                        "entry_id": "5bca808c-25d6-3520-96c1-565a7c23e78d",
                        "glosses": [
                            "Variante orthographique de laissé pour compte."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c3a7de54-db62-47dc-be24-351910851f69",
                                "sense_id": "1990fa97-f262-348e-9f0b-0157283fbbad",
                                "text": "Aujourd’hui, un laissé-pour-compte des soleils d’août nous grille, nous étourdit, nous détraque. Hier matin, il gelait."
                            },
                            {
                                "example_id": "13c4249b-f912-41d2-8cff-1f4aa3721fd6",
                                "sense_id": "1990fa97-f262-348e-9f0b-0157283fbbad",
                                "text": "Et quand ils venaient le vendredi ou le samedi soir, il empilait ses livres de politique sur le bureau et faisait semblant de travailler. Il voulait avoir l’air d’un intello, pas d’un laissé-pour-compte."
                            },
                            {
                                "example_id": "7226bb31-0a57-4863-bce0-b443ed7a91b8",
                                "sense_id": "1990fa97-f262-348e-9f0b-0157283fbbad",
                                "text": "Le ressentiment des laissés-pour-compte de la réunification, notamment dans les anciens Länders de l’Est, s’exprimera dans les urnes."
                            },
                            {
                                "example_id": "e7befc39-efdb-4a2d-bd39-6a67a9ee73df",
                                "sense_id": "1990fa97-f262-348e-9f0b-0157283fbbad",
                                "text": "[Titre] Les étudiants africains, laissés-pour-compte de la nouvelle stratégie universitaire française"
                            },
                            {
                                "example_id": "535a3935-1252-47db-b1a8-8be8476d42c0",
                                "sense_id": "1990fa97-f262-348e-9f0b-0157283fbbad",
                                "text": "Dans cette trop longue crise, la liste des laissés-pour-compte s’allonge de jour en jour."
                            }
                        ]
                    }
                ],
