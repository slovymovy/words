                        },
                        {
                            "text": "Cette entreprise nationale est spécialisée dans l'<w>armement</w> lourd destiné aux forces terrestres."
                        }
                    ],
                    "synonyms": [
                        "arsenal",
                        "équipement"
                    ],
                    "common_phrases": [
