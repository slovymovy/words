                                            {
                                                "example_id": "5b0f34cd-67b6-42c9-a73b-15a4f9eb882a",
                                                "sense_id": "c820d0f8-821f-3e69-a75c-32462c67af83",
                                                "text": "Dan was beginning to feel very depressed when suddenly the eerie howl of a dingo rang out[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79278a9d-c7c3-354d-bc35-3dd0d4036e49",
