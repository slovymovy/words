                "senses": [
                    {
                        "sense_id": "a8ab5d19-9015-350a-b47f-380f7a2b8c69",
                        "entry_id": "710c3a32-ec87-32d5-b9c6-07042b7c5189",
                        "glosses": [
                            "starke emotionale Beziehung zu jemandem oder etwas, die sich mal in Zu-, mal in Abneigung äußert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9da78c68-c896-419f-a7b5-176c80cae8e3",
                                "sense_id": "a8ab5d19-9015-350a-b47f-380f7a2b8c69",
                                "text": "Sie empfand für ihn eine Art Hassliebe."
                            },
                            {
                                "example_id": "2e22d982-2534-4f30-8c1a-2f7c809d4be3",
                                "sense_id": "a8ab5d19-9015-350a-b47f-380f7a2b8c69",
                                "text": "„Ich muss das an dieser Stelle erwähnen, weil diese Hassliebe in meinem Leben immer wieder eine große Rolle gespielt hat und später der Anlass sowohl für eigentlich überflüssige Katastrophen als auch für bestimmte Sternstunden war.“"
                            },
                            {
                                "example_id": "9962a492-c6e3-4987-9a17-aade2535ba4d",
                                "sense_id": "a8ab5d19-9015-350a-b47f-380f7a2b8c69",
                                "text": "„Ich bin nicht Mitglied einer Partei, in Hassliebe vielleicht mit einer verbunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f7b43d1-1017-4b70-b38f-b6f1de2ee3a9",
                        "source_entry_id": "710c3a32-ec87-32d5-b9c6-07042b7c5189",
                        "source_sense_id": "a8ab5d19-9015-350a-b47f-380f7a2b8c69",
                        "source_sense_description": "starke emotionale Beziehung zu jemandem oder etwas, die sich mal in Zu-, mal in Abneigung äußert",
                        "target_lang_word": "love-hate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "love-hate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac2dda73-bc93-3051-ad6c-de3645cc9dd3",
                                        "entry_id": "80bde86a-27d8-3402-b768-e52ae5257593",
                                        "glosses": [
                                            "Of a relationship: involving feelings of both love and hate, often simultaneously."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c7776d5-3ce2-4ba0-951f-dbd6deb04e62",
                                                "sense_id": "ac2dda73-bc93-3051-ad6c-de3645cc9dd3",
                                                "text": "The krogan have had a love-hate relationship with varren for millennia, alternately fighting them for territory and embracing them as treasured companions."
                                            },
                                            {
                                                "example_id": "e146856c-e58c-4dac-b151-59e31923fc1c",
                                                "sense_id": "ac2dda73-bc93-3051-ad6c-de3645cc9dd3",
                                                "text": "I loathe reviews in which a critic claims to have love-hate feelings about a work of art. It’s a way of having no opinion at all. But I love and hate “Taipei.”"
                                            },
                                            {
                                                "example_id": "d4fce618-2027-43fd-a993-80619502a282",
                                                "sense_id": "ac2dda73-bc93-3051-ad6c-de3645cc9dd3",
                                                "text": "Still, the movie [Ralph Breaks the Internet] manages to locate some gentle satire in our culture's love-hate relationship with the internet. At one point, Ralph must attain a certain level of viral popularity, assisted by the BuzzFeed-esque content guru Yesss (Taraji P. Henson), and the movie is savvy about how accidental spikes in fame can turn into cynical algorithm manipulation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "love-hate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c66f9417-5172-3163-a6cc-365417beedb3",
                                        "entry_id": "381de4b3-e037-30b7-9455-b41a4650512b",
                                        "glosses": [
                                            "To feel both love and hate (for someone or something), often simultaneously."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c30122d-f076-4054-b9d3-ffefdc894d0c",
                                                "sense_id": "c66f9417-5172-3163-a6cc-365417beedb3",
                                                "text": "[…]Eric got to act out his resentment while also hating himself, really love-hating himself, and he got to do it while masquerading as a warrior for the less fortunate!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
