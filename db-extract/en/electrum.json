                "word": "electrum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "58ed99a2-a8b8-4ab8-aa8b-bab5e550ece6",
                        "entry_id": "b1c02c38-a434-3adf-a026-b508fe78273b",
