                "senses": [
                    {
                        "sense_id": "c6fb88d3-2cdc-3771-8f4d-4d41f72aa89e",
                        "entry_id": "0474835f-040b-3d09-949c-8c81528114cc",
                        "glosses": [
                            "Familie, deren Angehörige und Ahnen zum Teil im Bergbau beschäftigt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a4eb2b-366b-4809-af1b-4488cd2f352b",
                                "sense_id": "c6fb88d3-2cdc-3771-8f4d-4d41f72aa89e",
                                "text": "„Martin Viertel entstammt einer Bergmannsfamilie.“"
                            },
                            {
                                "example_id": "f1b35a99-8022-4ef5-a86c-775a2ff46a0d",
                                "sense_id": "c6fb88d3-2cdc-3771-8f4d-4d41f72aa89e",
                                "text": "„Er entstammte einer unbemittelten Bauern- und Bergmannsfamilie.“"
                            },
                            {
                                "example_id": "2e4efe80-0f80-4264-9a21-cfdfc2760d6d",
                                "sense_id": "c6fb88d3-2cdc-3771-8f4d-4d41f72aa89e",
                                "text": "„Der aus einer Bergmannsfamilie stammende Villis gilt hingegen als bodenständig, ruhig und sachlich.“"
                            },
                            {
                                "example_id": "c7c373e1-b9fe-44a9-a22e-88fbe3527856",
                                "sense_id": "c6fb88d3-2cdc-3771-8f4d-4d41f72aa89e",
                                "text": "„Martin wird am 10. November 1483 im sächsisch-anhaltinischen Eisleben als zweiter Sohn einer Bergmannsfamilie geboren.“"
                            },
                            {
                                "example_id": "c4ea5c59-2e95-48ea-863f-a85b8c4e97e9",
                                "sense_id": "c6fb88d3-2cdc-3771-8f4d-4d41f72aa89e",
                                "text": "„Der Ziegenberg heißt, wie er heißt, weil alle vier Bergmannsfamilien, die dort in einem langgestreckten Grubenhaus wohnen, sich Ziegen halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
