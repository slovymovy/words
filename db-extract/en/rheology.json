                        ],
                        "examples": [
                            {
                                "example_id": "c3537130-6fe5-4854-b05b-c9d8d588969e",
                                "sense_id": "882abcfa-45f3-306f-b5e5-a290548f8631",
                                "text": "The main interest in rheology science is to analyse and describe the behaviour of relevant materials with intermediate properties between those of ideal solids and liquids, which cannot be described by classical theories.",
                                "translation": "Het voornaamste belang van de wetenschap der reologie is om het gedrag van relevante materialen te analyseren en beschrijven die eigenschappen bezitten die het midden houden tussen die van ideale vaste stoffen en vloeistoffen en niet door klassieke theorieën beschreven kunnen worden."
                            }
                        ]
                    }
