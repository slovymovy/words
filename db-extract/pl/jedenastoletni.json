                                                "example_id": "36bb1215-ef78-4f53-a48a-01f4545acfea",
                                                "sense_id": "a7cb8a2e-3ced-3bcc-97e5-f9848505df1d",
                                                "text": "Die elfjährige Sybille geht nun aufs Gymnasium."
