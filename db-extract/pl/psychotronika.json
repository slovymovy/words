                        "sense_id": "fbd5a726-9265-3fed-90f6-e91fc1e559e7",
                        "entry_id": "666be861-429d-3449-8d07-67ea1190e45e",
                        "glosses": [
                            "dziedzina badająca domniemane zależności między świadomością ludzką a zjawiskami energetycznymi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3411aff6-da69-4866-9cd5-268eb572fc82",
                                "sense_id": "fbd5a726-9265-3fed-90f6-e91fc1e559e7",
                                "text": "Szczególnym obiektem badań w psychotronice jest rzekome „pole energetyczne”, odróżniające się od pól energetycznych znanych nauce (elektrycznego, magnetycznego) swoją strukturą, nieuchwytną dla jakiegokolwiek aparatu badawczego mogącego dać sprawdzalny wynik badania, […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
