                        "entry_id": "e6046589-7562-3a28-ae0f-0bbee49c759d",
                        "glosses": [
                            "Étude des relations des êtres vivants fossiles avec leur milieu de vie, sous les aspects physicochimiques aussi bien que biologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88f7ad5e-067e-4770-909a-76b899524380",
                                "sense_id": "90d76729-b907-3345-b6cd-ac7e3fd0b889",
                                "text": "Un autre domaine qui me semble porteur de développements considérables est celui de la paléoécologie, qui ne peut être dissocié de la paléogéographie et de la paléoclimatologie."
                            },
                            {
                                "example_id": "ee68bf5c-3a61-4ae6-81ff-69a46bee8af2",
                                "sense_id": "90d76729-b907-3345-b6cd-ac7e3fd0b889",
                                "text": "Hans Joosten est professeur en études des tourbières et en paléoécologie à l’Université de Greifswald, en Allemagne."
                            }
                        ]
                    }
