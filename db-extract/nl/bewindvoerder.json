                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5edea66-d774-467f-87d1-907e706ed1a6",
                                "sense_id": "9b386a07-9f6e-3b42-a050-79c4a3a7bcfc",
                                "text": "De bewindvoerder van binnenlandse zaken gaf commentaar op de problemen bij de gemeente."
                            }
                        ]
                    },
                    {
                        "sense_id": "05a96f30-a7b1-323e-8726-b6040139ab8c",
                        "entry_id": "903bd81b-ad9f-3b97-822c-1dacf40d3607",
                        "glosses": [
                            "iemand die door de rechter tijdelijk aan het hoofd van een bedrijf wordt gesteld bij uitspreken van surseance van betaling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44514ab3-38ca-4cda-98c6-d0be8564e3d3",
                                "sense_id": "05a96f30-a7b1-323e-8726-b6040139ab8c",
                                "text": "Nadat de meubelzaak in financieel zwaar vaarwater was beland, probeerde de bewindvoerder te zorgen voor een doorstart."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9f583d2-294b-3800-aadf-4e612d97b8a9",
                        "entry_id": "903bd81b-ad9f-3b97-822c-1dacf40d3607",
                        "glosses": [
                            "iemand die door de rechter, of door de erflater in een testament, is aangewezen om uitvoering te geven aan een ingesteld bewind over de goederen van een persoon met als taak de financiën en goederen van die persoon te beheren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749c9c90-f9fc-40f9-bea0-93a38b71bb9f",
                                "sense_id": "f9f583d2-294b-3800-aadf-4e612d97b8a9",
                                "text": "De rechter stak er een stokje voor dat de testamentair bewindvoerder zonder toestemming van de rechthebbende uit de nalatenschap van diens vader gitaren had verkocht die rechthebbende zelf wilde houden."
                            }
                        ]
