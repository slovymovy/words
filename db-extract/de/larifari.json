        "de-extract.jsonl": [
            {
                "entry_id": "843a4f85-47ed-3777-947e-42d7412d403b",
                "word": "larifari",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "1119fc43-254f-4907-b0db-2f35f079bc45",
                        "entry_id": "843a4f85-47ed-3777-947e-42d7412d403b",
                        "tags": [
                            "positive"
                        ],
                        "form": "larifari"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0833d73e-8b2d-3fc4-ba05-3807d9b76746",
                        "entry_id": "843a4f85-47ed-3777-947e-42d7412d403b",
                        "glosses": [
                            "ohne Sorgfalt, nicht mit der nötigen Genauigkeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3d97c35d-9ee2-4c67-baa9-8a3edc8d18e4",
                                "sense_id": "0833d73e-8b2d-3fc4-ba05-3807d9b76746",
                                "text": "Er macht seine Hausaufgaben immer nur so larifari, das wird noch Ärger geben."
                            },
                            {
                                "example_id": "b0c38f6f-4d26-45dd-8d5e-9353f9a00fc5",
                                "sense_id": "0833d73e-8b2d-3fc4-ba05-3807d9b76746",
                                "text": "„Aber damals, das war 1987, stand ich felsenfest auf dem Sockel meiner Überzeugungen und deshalb erschien mir der ganze buntscheckig-turbulente Romanfabrikbetrieb sehr larifari.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0e700c5-603c-4e60-9dac-3ac9bce2de56",
                        "source_entry_id": "843a4f85-47ed-3777-947e-42d7412d403b",
                        "source_sense_id": "0833d73e-8b2d-3fc4-ba05-3807d9b76746",
                        "source_sense_description": "umgangssprachlich: ohne Sorgfalt, nicht mit der nötigen Genauigkeit",
                        "target_lang_word": "lackadaisical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lackadaisical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee398392-b386-3fdf-a36c-24d96fb1b649",
                                        "entry_id": "5cfa6bea-fa29-3285-b628-1a4614e34c57",
                                        "glosses": [
                                            "Showing no interest, vigor, determination, or enthusiasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c99ab475-8dd0-4843-a491-ef9ec3a28d0a",
                                                "sense_id": "ee398392-b386-3fdf-a36c-24d96fb1b649",
                                                "text": "the lackadaisical look on his face"
                                            },
                                            {
                                                "example_id": "1174f5eb-7f0b-4f7e-96cc-4991b77e6660",
                                                "sense_id": "ee398392-b386-3fdf-a36c-24d96fb1b649",
                                                "text": "I, at one time, used to go and take a hand at cribbage with a friend, and afterwards discuss a cold sirloin of beef, and throw out a few lackadaisical remarks, in a way to please myself, but it would not do long."
                                            },
                                            {
                                                "example_id": "5b8265dc-9d9b-47d9-ace4-da5db72702ca",
                                                "sense_id": "ee398392-b386-3fdf-a36c-24d96fb1b649",
                                                "text": "\"Then let those who do know it learn that you are able to bear such wounds without outward complaint. I tell you fairly that I cannot sympathize with a lackadaisical lover.\""
                                            },
                                            {
                                                "example_id": "94033d5e-6180-4f8e-8250-5c6705fb8a6b",
                                                "sense_id": "ee398392-b386-3fdf-a36c-24d96fb1b649",
                                                "text": "I could hear the sound of the janitor's lackadaisical scrubbing against the wooden floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af96274f-a1ea-36db-a4dc-466711e803b5",
                                        "entry_id": "5cfa6bea-fa29-3285-b628-1a4614e34c57",
                                        "glosses": [
                                            "Lazy; slothful; indolent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
