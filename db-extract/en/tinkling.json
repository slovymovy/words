                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9b3d3714-3c6f-3e98-bfa3-80d299b81b25",
                        "entry_id": "5d4a4c18-5aec-3631-95b1-f04cd2262b23",
                        "glosses": [
                            "The action of the verb to tinkle"
                        ],
                        "tags": [],
