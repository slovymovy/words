                "senses": [
                    {
                        "sense_id": "f2f483ea-0c70-3698-a3fe-95b6ab791c15",
                        "entry_id": "d6a6a11f-3aef-3475-9bbb-f9b0736cfca2",
                        "glosses": [
                            "Donner un caractère loufoque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df9ca2b-d3c7-4a3c-9b93-220b2ed0d6a6",
                                "sense_id": "f2f483ea-0c70-3698-a3fe-95b6ab791c15",
                                "text": "Ah ! la maison loufoque se loufoquise de plus en plus !"
                            },
                            {
                                "example_id": "f7e31cdf-2782-4288-8abd-d9cc953ea6a3",
                                "sense_id": "f2f483ea-0c70-3698-a3fe-95b6ab791c15",
                                "text": "Tu te loufoquises, fais gaffe."
                            },
                            {
                                "example_id": "cce65ac1-9e12-4d65-a7a3-8e594d6167bc",
                                "sense_id": "f2f483ea-0c70-3698-a3fe-95b6ab791c15",
                                "text": "Et finalement fallait qu'on se réunisse sur un truc, j'allais pas faire moi du Stupeflip et lui du LOFOFORA, fallait qu'on se rejoigne, moi je me suis un peu plus \"loufoquisé\" sur la facon d'écrire des choses et lui il a fait quelque chose d'un peu plus cadré que dans Stupeflip."
                            }
                        ]
                    }
