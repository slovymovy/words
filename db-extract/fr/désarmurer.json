                "senses": [
                    {
                        "sense_id": "de09379f-6d74-3411-ad94-4eb70edfba01",
                        "entry_id": "64ae4356-6df8-3519-8c96-0fa92fa00859",
                        "glosses": [
                            "Enlever une armure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7098964-b148-4453-8ab9-2512dac25063",
                                "sense_id": "de09379f-6d74-3411-ad94-4eb70edfba01",
                                "text": "Une fois le corps désarmuré, l'âme apaisée, le soin Reiki est parfait pour ancrer et stabiliser votre nouvelle énergie, et accèder aux canaux de vos propres guides."
                            },
                            {
                                "example_id": "9454cbf1-da49-4f9f-a529-5748997e096c",
                                "sense_id": "de09379f-6d74-3411-ad94-4eb70edfba01",
                                "text": "Un nain GW, désarmuré et rhabillé en aventurier."
                            },
                            {
                                "example_id": "7ae0835e-0e1f-4595-84de-d9269beef859",
                                "sense_id": "de09379f-6d74-3411-ad94-4eb70edfba01",
                                "text": "Au menu, et pour commencer, pour les fragiles, de superbes noix de St-Jacques aux petits légumes, alors que pour la Cavalerie et les chevalières désarmurées pour l’occasion, une terrine de boudin noir au foie gras, une véritable machine de guerre du goût, copinage canardo-cochonesque imparable…"
                            },
                            {
                                "example_id": "9e3cbeb4-0296-4568-bbb8-b838e7e6c960",
                                "sense_id": "de09379f-6d74-3411-ad94-4eb70edfba01",
                                "text": "Secrets de la Yoni et plaisir, méthodes et rituels pour « désarmurer » et s'ouvrir à plus de plaisir;"
                            }
                        ]
                    }
                ],
