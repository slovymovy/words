    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2bfaabc-9652-39cb-aed9-e5493bb85d7f",
                    "sense_definition": "A pattern on clothing consisting of irregularly shaped patches of green, brown, or white used for concealment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier wore a jacket with a <w>camouflage</w> pattern to blend into the forest."
                        },
                        {
                            "text": "Many teenagers like to wear <w>camouflage</w> pants as a fashion statement."
                        }
                    ],
                    "synonyms": [
                        "camo"
                    ],
                    "common_phrases": [
                        "camouflage pattern",
                        "camouflage jacket",
                        "camouflage pants"
                    ]
                },
                {
                    "sense_id": "6d4c6430-afd7-3f69-9f17-7032d0f23e40",
                    "sense_definition": "The natural ability of an animal to blend into its surroundings to avoid being seen by predators or prey.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chameleon uses <w>camouflage</w> to hide from predators on the tree branch."
                        },
                        {
                            "text": "Effective <w>camouflage</w> allows the insect to remain hidden from hungry birds."
                        }
                    ],
                    "synonyms": [
                        "crypsis",
                        "mimicry"
                    ],
                    "common_phrases": [
                        "natural camouflage"
                    ]
                },
                {
                    "sense_id": "fa212538-da64-332d-bdd5-0a06ba2f9b11",
                    "sense_definition": "The use of materials to hide or disguise people, objects, or positions from an enemy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army used nets as <w>camouflage</w> to hide their tanks from aerial view."
                        },
                        {
                            "text": "They set up their camp using <w>camouflage</w> to avoid detection by the enemy."
                        }
                    ],
                    "synonyms": [
                        "disguise",
                        "concealment"
                    ],
                    "common_phrases": [
                        "military camouflage"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1c8691b-7982-3f92-bfc1-2bfe35897c89",
                    "sense_definition": "To hide or disguise something by covering it or changing its appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters <w>camouflaged</w> their position with branches and leaves."
                        },
                        {
                            "text": "The bird <w>camouflages</w> its nest to protect its eggs from predators."
                        }
                    ],
                    "synonyms": [
                        "disguise",
                        "hide",
                        "mask"
                    ],
                    "antonyms": [
