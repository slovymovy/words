    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2af8a911-0cd4-3b19-9e0e-d7a8c7831170",
                    "sense_definition": "Qui ne peut se tromper, qui est exempt de toute erreur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "absence_erreur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aucun être humain n'est totalement <w>infaillible</w>, chacun commet des erreurs au cours de sa vie."
                        },
                        {
                            "text": "Ce chercheur possédait une mémoire <w>infaillible</w> et retenait sans peine le moindre détail technique."
                        }
                    ],
                    "synonyms": [
                        "impeccable"
                    ],
                    "antonyms": [
                        "faillible"
                    ],
                    "common_phrases": [
                        "jugement infaillible",
                        "mémoire infaillible"
                    ]
                },
                {
                    "sense_id": "d1aa9fa3-73bf-38ca-8fbb-91472d3706be",
                    "sense_definition": "Qui produit un effet certain, inévitable ou immanquable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "certitude_effet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prendre une tisane chaude le soir est un moyen <w>infaillible</w> pour trouver le sommeil rapidement."
                        },
                        {
                            "text": "Elle applique toujours cette méthode car elle la considère comme un remède <w>infaillible</w> contre le stress."
                        }
                    ],
                    "synonyms": [
                        "immanquable",
                        "inévitable",
                        "sûr"
                    ],
                    "common_phrases": [
                        "moyen infaillible",
                        "recette infaillible",
                        "remède infaillible"
                    ]
                },
                {
                    "sense_id": "276534f4-041e-3da8-a1cc-941b290907dc",
                    "sense_definition": "Qualifie le pape lorsqu'il se prononce solennellement sur les dogmes de la foi chrétienne sans pouvoir errer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "absence_erreur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le concile a proclamé que le pontife romain est <w>infaillible</w> lorsqu'il définit une doctrine de foi."
                        },
                        {
                            "text": "Les théologiens ont longuement analysé les situations précises dans lesquelles le pape est déclaré <w>infaillible</w>."
                        }
                    ],
                    "antonyms": [
                        "faillible"
                    ],
                    "common_phrases": [
                        "pape infaillible"
                    ]
                }
            ]
        }
    ]
}