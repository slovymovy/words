                ],
                "senses": [
                    {
                        "sense_id": "c0d5ebaa-c92c-395c-b648-3971cff063cc",
                        "entry_id": "8ae6bf77-268b-32a5-8cb2-8f7629674369",
                        "glosses": [
                            "Eau ayant servi à laver quelque chose."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b964a9bc-b30b-4781-8cb0-39a98db52c43",
                                "sense_id": "c0d5ebaa-c92c-395c-b648-3971cff063cc",
                                "text": "De la lavure d’écuelles."
                            },
                            {
                                "example_id": "d288f09b-1464-48cb-9bb4-3c0e9b48c841",
                                "sense_id": "c0d5ebaa-c92c-395c-b648-3971cff063cc",
                                "text": "Je me suis approché pour boire, car j'avais soif; l'onde aussitôt s'est changée en lavure de vaisselle, j'y suis entré jusqu'au ventre."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf97df73-a16f-332b-99c7-59495eb5d37e",
                        "entry_id": "8ae6bf77-268b-32a5-8cb2-8f7629674369",
                        "glosses": [
                            "Opération par laquelle on retire l’or ou l’argent des cendres, des terres auxquelles il est mêlé, ou des creusets dans lesquels on l’a fondu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727e9349-001e-4370-bf19-89a0ed9ce946",
                                "sense_id": "cf97df73-a16f-332b-99c7-59495eb5d37e",
                                "text": "Une des principales choses que l'on doive faire dans la préparation d'une lavure c'est de brûler si parfaitement tout ce qui doit passer dans le moulin au vif-argent, que toutes les parties métalliques soient réduites en gouttes ou grains, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "a34e908a-1e7f-39d6-8cd8-c550172d727e",
                        "entry_id": "8ae6bf77-268b-32a5-8cb2-8f7629674369",
                        "glosses": [
                            "Parcelles d’or ou d’argent qui proviennent de cette opération ou qu’on tire des balayures."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": []
                    }
                ],
