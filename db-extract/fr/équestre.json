                                                "example_id": "8cfa9bb2-4cbd-4add-bb71-18c3f1d93a44",
                                                "sense_id": "3297ce79-50eb-39b9-8a6a-7e6717fe6f1f",
                                                "text": "Конный строй."
                                            },
