                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ba1a41b-1eff-3831-8acb-e958f23182c1",
                        "entry_id": "5d31798c-7e6d-3589-942a-b51e74e375c2",
                        "glosses": [
                            "Théorie médicale qui s’efforce de rattacher toute maladie à une lésion matérielle d’un organe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d827a38a-e1a9-3c32-8455-b05d87b4c9cd",
                        "entry_id": "5d31798c-7e6d-3589-942a-b51e74e375c2",
                        "glosses": [
                            "Le fait de considérer la société comme un organisme vivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e9de410-b8c7-46ca-ac0e-d93266ba6b31",
                                "sense_id": "d827a38a-e1a9-3c32-8455-b05d87b4c9cd",
                                "text": "Malgré son souci de dépasser l’organicisme qui assimilait la société humaine à un organisme biologique, Émile Durkheim continua à penser que le développement d’une société humaine se fait à partir d’elle-même."
                            },
                            {
                                "example_id": "7bc474ed-5f5e-4658-9d8d-768c48698a95",
                                "sense_id": "d827a38a-e1a9-3c32-8455-b05d87b4c9cd",
                                "text": "L’organicisme est le cœur de la vision du monde de l’extrême droite. L’unité organique est leur utopie, et leurs rejets (immigration, système politique pluraliste jugé diviseur etc.) en sont une conséquence."
                            }
                        ]
                    }
                ],
