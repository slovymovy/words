                ],
                "translations": [
                    {
                        "translation_id": "bd41d935-3e22-49ff-a4f0-418f530b8fc8",
                        "source_entry_id": "0e4b057b-bea7-3c95-9f12-75f1aa2a04ae",
                        "source_sense_id": "9888bcdd-5ba2-30e3-b68d-343d70d60081",
                        "target_lang_word": "ozeanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ozeanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad76ca58-9616-3e44-9477-9db723941b90",
                                        "entry_id": "24d59603-2a8d-30b8-bc3a-863f96923d4b",
                                        "glosses": [
                                            "den Ozean betreffend; durch den Ozean beeinflusst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a3494d-fcce-4546-b2c9-29265836ec6b",
                                                "sense_id": "ad76ca58-9616-3e44-9477-9db723941b90",
                                                "text": "Die ozeanische Erdkruste unterscheidet sich in Struktur, Aufbau und Genese grundlegend von der kontinentalen Erdkruste."
                                            },
                                            {
                                                "example_id": "1c6a210c-11fc-4e1b-bc7a-f7b5826d42d9",
                                                "sense_id": "ad76ca58-9616-3e44-9477-9db723941b90",
                                                "text": "Die ozeanische Zirkulation sorgt für einen permanenten Wärmetransport."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b5728ca-4581-300e-aac3-ba0a0ccf8d36",
                                        "entry_id": "24d59603-2a8d-30b8-bc3a-863f96923d4b",
                                        "glosses": [
                                            "die Inselwelt Ozeanien betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef35cf6-db0f-4afe-a412-3da6e269ac76",
                                                "sense_id": "1b5728ca-4581-300e-aac3-ba0a0ccf8d36",
                                                "text": "Derzeit umfasst es 16 ozeanische Mitgliedstaaten einschließlich Australien, Neuseeland und Papua Neuguinea."
                                            },
                                            {
