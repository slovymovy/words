                    {
                        "translation_id": "b9d212a9-9fb3-4409-988e-26e874f2f728",
                        "source_entry_id": "fceded11-acc1-3956-b750-421369694379",
                        "target_lang_word": "far-sighted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "far-sighted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae952f14-0965-30f8-a75b-6f52b864946b",
                                        "entry_id": "780145d9-5fb3-3eea-8fc2-33d58c1816b3",
                                        "glosses": [
                                            "Alternative spelling of farsighted."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83131195-ed3e-404f-8e75-8072f5a3560b",
                                                "sense_id": "ae952f14-0965-30f8-a75b-6f52b864946b",
                                                "text": "It was in November, 1932, in an endeavour to reduce working costs, that the first diesel railcar was introduced, and it was a far-sighted move on the part of Mr. D. N. McClure, for diesel propulsion on railways was then more or less in its infancy."
                                            },
                                            {
                                                "example_id": "d4a5126f-107a-4439-bac5-eed58359aac0",
                                                "sense_id": "ae952f14-0965-30f8-a75b-6f52b864946b",
                                                "text": "Gavin Johns, chairman of the Swanage Railway Trust, said: \"I would like to thank our stakeholders for their far-sighted investment of £5.5 million to re-connect Swanage and Corfe Castle with the main line, which included £1.8m from the Government's coastal communities fund, so we could restore our 1950s heritage diesel trains for running on the main line.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10446e3b-0701-417e-90a5-67df492211a6",
                        "source_entry_id": "fceded11-acc1-3956-b750-421369694379",
                        "target_lang_word": "starczowzroczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
