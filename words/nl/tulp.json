{
    "word_family": [
        "tulpenbol",
        "tulpenveld",
        "tulpenboom",
        "tulpenmanie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6e15e47-0a32-3fc6-9c86-5cae4c9310f5",
                    "sense_definition": "Een plant uit het geslacht Tulipa, bekend om zijn kleurrijke bloemen en groei uit een bol.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "flora",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lente staan de velden in de polder vol met de mooiste <w>tulpen</w>.",
                            "target_lang_translations": {
                                "en": "In spring, the fields in the polder are full of the most beautiful <w>tulips</w>.",
                                "ru": "Весной поля в польдере полны красивейших <w>тюльпанов</w>."
                            }
                        },
                        {
                            "text": "Het gazon was omzoomd door een border vol <w>tulpen</w>.",
                            "target_lang_translations": {
                                "en": "The lawn was bordered by a flowerbed full of <w>tulips</w>.",
                                "ru": "Газон был окаймлен бордюром, полным <w>тюльпанов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een rode tulp",
                        "tulpen in de tuin"
                    ],
                    "target_lang_definitions": {
                        "en": "A plant of the genus Tulipa, known for its colorful flowers and growth from a bulb.",
                        "ru": "Растение из рода Tulipa, известное своими яркими цветами и произрастающее из луковицы."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tulip",
                                "target_lang_sense_clarification": "the flowering plant"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тюльпан",
                                "target_lang_sense_clarification": "растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a272e45e-15ca-3278-beef-cb7f25b62ce5",
                    "sense_definition": "De bloem van de tulpenplant, vaak gebruikt in boeketten.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "flora",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bracht een bosje <w>tulpen</w> mee om het goed te maken.",
                            "target_lang_translations": {
                                "en": "He brought a bunch of <w>tulips</w> to make amends.",
                                "ru": "Он принес букет <w>тюльпанов</w>, чтобы загладить свою вину."
                            }
                        },
                        {
                            "text": "Zij zette een enkele gele <w>tulp</w> in een slanke vaas op tafel.",
                            "target_lang_translations": {
                                "en": "She put a single yellow <w>tulip</w> in a slender vase on the table.",
                                "ru": "Она поставила один желтый <w>тюльпан</w> в изящную вазу на столе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een bos tulpen",
                        "verse tulpen"
                    ],
                    "target_lang_definitions": {
                        "en": "The flower of the tulip plant, often used in bouquets.",
                        "ru": "Цветок растения тюльпан, часто используемый в букетах."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tulip",
                                "target_lang_sense_clarification": "the cut flower"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тюльпан",
                                "target_lang_sense_clarification": "цветок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27d75e52-41c6-346e-be3f-3c04d9c5a673",
                    "sense_definition": "Een type stekker of kabel (RCA) die wordt gebruikt voor het aansluiten van audio- en videosignalen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de rode <w>tulp</w> in de juiste ingang van de versterker steken.",
                            "target_lang_translations": {
                                "en": "You need to plug the red <w>RCA connector</w> into the correct input of the amplifier.",
                                "ru": "Нужно вставить красный <w>тюльпан</w> в соответствующий вход усилителя."
                            }
                        },
                        {
                            "text": "Deze oude televisie heeft nog een aansluiting voor een <w>tulpstekker</w>.",
                            "target_lang_translations": {
                                "en": "This old television still has a connection for an <w>RCA plug</w>.",
                                "ru": "У этого старого телевизора еще есть разъем для <w>тюльпана</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tulpstekker",
                        "RCA-stekker"
                    ],
                    "common_phrases": [
                        "een tulp aansluiting",
                        "rode en witte tulp"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele benaming voor RCA-connectoren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A type of plug or cable (RCA) used for connecting audio and video signals.",
                        "ru": "Тип штекера или кабеля (RCA), используемый для подключения аудио- и видеосигналов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "RCA connector",
                                "target_lang_sense_clarification": "audio/video plug"
                            },
                            {
                                "target_lang_word": "phono plug",
                                "target_lang_sense_clarification": "audio/video connector"
                            },
                            {
                                "target_lang_word": "RCA cable",
                                "target_lang_sense_clarification": "the cable itself"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тюльпан",
                                "target_lang_sense_clarification": "разъем RCA"
                            },
                            {
                                "target_lang_word": "разъем RCA",
                                "target_lang_sense_clarification": "техническое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}