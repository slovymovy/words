                                        "entry_id": "f08f610a-ca9a-3c0d-a3cf-0e2576b4ab91",
                                        "glosses": [
                                            "A one-wheeled attachment to the side of a motorcycle to allow for a separate seat for a passenger or cargo space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69c87549-4c8e-3a9d-8bdd-3fabccaa8124",
                                        "entry_id": "f08f610a-ca9a-3c0d-a3cf-0e2576b4ab91",
                                        "glosses": [
                                            "A cocktail made with cognac (or brandy), triple sec liqueur, and lemon juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b77508c6-a735-41f0-a3d2-58fb8d669bf2",
                                                "sense_id": "69c87549-4c8e-3a9d-8bdd-3fabccaa8124",
                                                "text": "Faux 19th-century bartenders in sleeve garters and baroque facial hair ply their trade in pre-Prohibition bars. Women wearing cloche hats order sidecars at speakeasies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "905b2daa-101d-334c-8aa5-e319e4ac7fcf",
                                        "entry_id": "f08f610a-ca9a-3c0d-a3cf-0e2576b4ab91",
                                        "glosses": [
                                            "A software component that runs in a separate process from the rest of the software, to provide isolation and encapsulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c79a6a-d0b6-4c6e-ac5d-32bf459a15b9",
                                                "sense_id": "905b2daa-101d-334c-8aa5-e319e4ac7fcf",
                                                "text": "Using generic sidecars for multiple microservices may introduce functionality overhead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6cb8faa-1ffb-424d-abfc-b47736c6cd65",
                        "source_entry_id": "388d2c15-363b-37c2-a3f6-3a6a5827e7a1",
                        "source_sense_id": "211aaab5-2634-3780-a531-cdfc322cde6f",
                        "source_sense_description": "fest mit einem Motorrad verbundener kleiner Wagen",
                        "target_lang_word": "side-car",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "side-car",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                                        "glosses": [
                                            "Remorque agencée pour accueillir une personne et s'accrochant latéralement sur une motocyclette ou un vélo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "071a1edf-756f-4589-8c14-1104fcd2ef44",
                                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                                "text": "Ça alors! Une Glory de 1948!! Avec un side-car!"
                                            },
                                            {
                                                "example_id": "36fa65f0-f0f7-40d1-b8aa-0645e7aa0bac",
                                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                                "text": "Après 15 000 euros de travaux, le musée a rouvert le 1ᵉʳ juillet, doté d’une nouvelle scénographie, lors d’une inauguration en grande pompe, avec déploiement d’une moto allemande avec side-car et d’une jeep dehors."
                                            },
                                            {
                                                "example_id": "fb446e7e-8f85-47c7-98ed-1273a886ac15",
                                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                                "text": "La Clodoaldienne Élisabeth Gelin - comédienne et auteure de pièces de théâtre - a publié son premier roman l’an dernier, La passagère du side-car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                                        "glosses": [
                                            "Attelage comprenant la motocyclette et le side-car."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af393e57-3ccc-44e8-88a6-8182bab3410a",
                                                "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                                                "text": "Les mains dans les poches, la pipe à la bouche, je n'avais pas fini de contempler le défilé qu'une moto side-car s'arrêta devant moi."
                                            },
                                            {
                                                "example_id": "721bc1ee-271b-4a17-954d-2302cba5dc4b",
                                                "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                                                "text": "Un side-car est donc un véhicule à trois roues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8c4f828-e279-35a3-845a-b2e85c339344",
                                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                                        "glosses": [
                                            "Discipline du motocyclisme, pratiquée avec l’attelage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
