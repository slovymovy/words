{
    "word_family": [
        "parafialny",
        "parafianin",
        "parafianka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33617256-c386-32b9-afc1-353b74d2b854",
                    "sense_definition": "Najmniejsza jednostka podziału administracyjnego w niektórych wspólnotach chrześcijańskich, wspólnota wiernych kierowana przez proboszcza",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "admin_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W maju w naszej <w>parafii</w> odbędzie się uroczystość pierwszej komunii świętej.",
                            "target_lang_translations": {
                                "ru": "В мае в нашем <w>приходе</w> состоится церемония первого причастия.",
                                "en": "In May, the First Holy Communion ceremony will take place in our <w>parish</w>."
                            }
                        },
                        {
                            "text": "Nowy ksiądz został bardzo ciepło przyjęty przez lokalną społeczność, gdy objął tę <w>parafię</w>.",
                            "target_lang_translations": {
                                "ru": "Новый священник был очень тепло принят местным сообществом, когда возглавил этот <w>приход</w>.",
                                "en": "The new priest was received very warmly by the local community when he took charge of this <w>parish</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "parochia"
                    ],
                    "common_phrases": [
                        "należeć do parafii",
                        "parafia rzymskokatolicka",
                        "proboszcz parafii",
                        "zmiana parafii"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наименьшая административная единица в некоторых христианских конфессиях; община верующих, возглавляемая настоятелем",
                        "en": "The smallest administrative subdivision in some Christian communities; a community of believers under the pastoral care of a priest"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приход",
                                "target_lang_sense_clarification": "административная единица"
                            },
                            {
                                "target_lang_word": "церковный приход",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "parish",
                                "target_lang_sense_clarification": "administrative division or local church community"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "166bd1f9-8b42-30aa-8f01-f2097cd5957a",
                    "sense_definition": "Ogół mieszkańców lub wiernych należących do danej jednostki kościelnej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "community",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cała <w>parafia</w> przyszła na mszę z udziałem arcybiskupa.",
                            "target_lang_translations": {
                                "ru": "Весь <w>приход</w> пришел на мессу с участием архиепископа.",
                                "en": "The whole <w>parish</w> came to the Mass with the archbishop."
                            }
                        },
                        {
                            "text": "Podczas zbiórki charytatywnej <w>parafia</w> okazała się niezwykle hojna i pomocna.",
                            "target_lang_translations": {
                                "ru": "Во время благотворительного сбора <w>приход</w> оказался невероятно щедрым и отзывчивым.",
                                "en": "During the charity collection, the <w>parish</w> proved to be exceptionally generous and helpful."
                            }
                        }
                    ],
                    "synonyms": [
                        "parafianie"
                    ],
                    "common_phrases": [
                        "cała parafia",
                        "życie parafii",
                        "wspólnota parafii"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность жителей или верующих, принадлежащих к данной церковной единице",
                        "en": "The body of residents or faithful belonging to a particular ecclesiastical unit; congregation"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приход",
                                "target_lang_sense_clarification": "община людей"
                            },
                            {
                                "target_lang_word": "прихожане",
                                "target_lang_sense_clarification": "люди, посещающие церковь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "parish",
                                "target_lang_sense_clarification": "the community or congregation"
                            },
                            {
                                "target_lang_word": "parishioners",
                                "target_lang_sense_clarification": "the members of a parish"
                            },
                            {
                                "target_lang_word": "congregation",
                                "target_lang_sense_clarification": "assembly of believers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3fe93d7-8721-3274-96a2-978123856978",
                    "sense_definition": "Budynek kościoła parafialnego",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spotkamy się przed <w>parafią</w> tuż po zakończeniu niedzielnej mszy.",
                            "target_lang_translations": {
                                "ru": "Встретимся перед <w>церковью</w> сразу после окончания воскресной мессы.",
                                "en": "We'll meet in front of the <w>church</w> right after Sunday Mass ends."
                            }
                        },
                        {
                            "text": "Ta zabytkowa <w>parafia</w> wymaga natychmiastowego remontu dachu.",
                            "target_lang_translations": {
                                "ru": "Эта старинная <w>приходская церковь</w> требует немедленного ремонта крыши.",
                                "en": "This historic <w>parish church</w> requires immediate roof repair."
                            }
                        }
                    ],
                    "synonyms": [
                        "kościół parafialny"
                    ],
                    "common_phrases": [
                        "obok parafii",
                        "budynek parafii"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w znaczeniu budynku kościoła"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание приходской церкви",
                        "en": "The building of a parish church"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "церковь",
                                "target_lang_sense_clarification": "здание"
                            },
                            {
                                "target_lang_word": "приходская церковь",
                                "target_lang_sense_clarification": "здание"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "parish church",
                                "target_lang_sense_clarification": "church building"
                            },
                            {
                                "target_lang_word": "church",
                                "target_lang_sense_clarification": "building"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95f12403-697f-3dbb-991d-b3152e15cd59",
                    "sense_definition": "Kancelaria parafialna; biuro, gdzie załatwia się sprawy kościelne",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę iść do <w>parafii</w>, żeby zamówić mszę w intencji dziadka.",
                            "target_lang_translations": {
                                "ru": "Мне нужно пойти в <w>канцелярию</w>, чтобы заказать мессу за дедушку.",
                                "en": "I have to go to the <w>parish office</w> to request a Mass intention for my grandfather."
                            }
                        },
                        {
                            "text": "Wszystkie dokumenty potrzebne do ślubu należy złożyć w <w>parafii</w> miesiąc wcześniej.",
                            "target_lang_translations": {
                                "ru": "Все документы, необходимые для венчания, нужно подать в <w>приходскую канцелярию</w> за месяц.",
                                "en": "All documents required for the wedding must be submitted to the <w>parish office</w> a month in advance."
                            }
                        }
                    ],
                    "common_phrases": [
                        "załatwić w parafii",
                        "godziny otwarcia parafii"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w znaczeniu kancelarii"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приходская канцелярия; офис, где решаются церковные дела",
                        "en": "Parish office; an office handling church administration and paperwork"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канцелярия",
                                "target_lang_sense_clarification": "место оформления документов"
                            },
                            {
                                "target_lang_word": "приходская канцелярия",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "parish office",
                                "target_lang_sense_clarification": "administrative office"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}