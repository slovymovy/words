                        "entry_id": "8d4c1698-5d83-30e7-a5c3-7ba16d1eeb85",
                        "glosses": [
                            "Unternehmen, das Personen oder Güter mit Flugzeugen transportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
