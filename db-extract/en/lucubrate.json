                        "examples": [
                            {
                                "example_id": "b3e5f43c-f776-4a94-b460-73096a4f1005",
                                "sense_id": "a16b0e60-ca00-32a0-8117-db4e13cbdf2e",
                                "text": "Instead, as Oklahoma’s tenure committee lucubrated over Hill’s future, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "6c54b504-ca8f-3cb2-ad8d-ef9d0d3f2719",
                        "entry_id": "dc8abe8a-f45c-358e-89a0-19cd5fee1652",
                        "glosses": [
                            "To work or write like a scholar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d685bd04-2b1d-4fb3-bb04-1faf71580f95",
                                "sense_id": "6c54b504-ca8f-3cb2-ad8d-ef9d0d3f2719",
                                "text": "1846, Nathaniel Chipman, in Daniel Chipman, The Life of Hon. Nathaniel Chipman, LL.D., p. 261,\n[…] I shall not hesitate to repeat some of my former thoughts, when lucubrating upon the same subject."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "119b4560-108d-443f-8954-a515ff516113",
                        "source_entry_id": "dc8abe8a-f45c-358e-89a0-19cd5fee1652",
                        "source_sense_description": "work diligently by artificial light; to study at night",
                        "target_lang_word": "pernocter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pernocter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "071614f4-d7fc-3300-9004-1857bfe4ca5e",
                                        "entry_id": "5309961e-cecc-393c-936b-a67024b5d7da",
                                        "glosses": [
                                            "Passer la nuit quelque part, en particulier de façon habituelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b7f3b5a-3985-4902-ad5d-d51ddf0478c7",
                                                "sense_id": "071614f4-d7fc-3300-9004-1857bfe4ca5e",
                                                "text": "La plus lourde des obligations imposées aux coutres était celle de pernocter, c’est-à-dire de passer la nuit tour à tour à veiller dans l’église ;"
                                            },
                                            {
                                                "example_id": "54c0dfb9-069b-4aef-8d04-9e18bd2550e1",
                                                "sense_id": "071614f4-d7fc-3300-9004-1857bfe4ca5e",
                                                "text": "— Hélas ! mon frère, c'est que vous aviez bien raison quand vous me disiez : — Jehan ! Jehan ! cessat doctorum doctrina, discipulorum disciplina. Jehan, soyez sage, Jehan, soyez docte, Jehan, ne pernoctez pas hors le collège sans occasion légitime et congé du maître. […] !"
                                            },
                                            {
                                                "example_id": "d40b5d42-4e6d-424d-97d5-83b0026db4ca",
                                                "sense_id": "071614f4-d7fc-3300-9004-1857bfe4ca5e",
                                                "text": "[les Choucas] fuyaient la cathédrale et n'y revenaient que le lendemain, dès l'aube, après avoir pernocté dans une forêt, à trois lieues de Chartres."
                                            }
                                        ]
                                    }
