                "senses": [
                    {
                        "sense_id": "64b6e801-55f5-3a83-a1a8-18351f6f9066",
                        "entry_id": "28e2a3b9-2bf2-3975-8f02-4c70e39a6322",
                        "glosses": [
                            "Qui présente une élasticité imparfaite ; qui est doué d'anélasticité"
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "8b0ef50f-6b9d-4f95-aec7-58128aece61f",
                                "sense_id": "64b6e801-55f5-3a83-a1a8-18351f6f9066",
                                "text": "Dans le cas des polymères amorphes, il suffit de chauffer le matériau au-dessus de la transition vitreuse pour le voir reprendre sa forme et ses dimensions premières, il serait plus exact alors de parler de déformations anélastiques."
                            },
                            {
                                "example_id": "e3aaf373-e0d3-4248-b37a-162a74d6ee64",
                                "sense_id": "64b6e801-55f5-3a83-a1a8-18351f6f9066",
                                "text": "La connaissance de l'amortissement équivalent permet de considérer comme spectre de réponse anélastique, le spectre de réponse élastique initial pour ce coefficient d'amortissement équivalent."
                            },
                            {
                                "example_id": "cbdef02e-46d6-4295-9886-b1a0d78c5306",
                                "sense_id": "64b6e801-55f5-3a83-a1a8-18351f6f9066",
                                "text": "Quant aux cisaillements anélastiques, ils sont décrits par l'équation phénoménologique d'anélasticité (15.72)."
                            }
                        ]
                    }
                ],
