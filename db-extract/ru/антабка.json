                "senses": [
                    {
                        "sense_id": "440e9ea1-875a-3f2a-a7ac-6a994c744c0b",
                        "entry_id": "77895be6-8e1a-3802-8b05-154104bb34a6",
                        "glosses": [
                            "деталь оружия, приспособление для крепления в виде металлической скобы или кольца на шарнире"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c495124-55d5-45a6-95a4-c0233e9f288a",
                                "sense_id": "440e9ea1-875a-3f2a-a7ac-6a994c744c0b",
                                "text": "Калибр ружья и обмотанные изолентой антабки косвенно указывают на что, что вы охотитесь большей частью с собакой из-под стойки на болотно-луговую дичь."
                            },
                            {
                                "example_id": "10c5585a-9b40-4b68-8238-7e8b69de48a9",
                                "sense_id": "440e9ea1-875a-3f2a-a7ac-6a994c744c0b",
                                "text": "Приклад — пустотелый, усилен внутренними рёбрами жесткости, снабжён насечённым затылком, сбоку заподлицо выполнена антабка ремня (вторая антабка помещена впереди цевья слева)."
                            }
                        ]
                    }
