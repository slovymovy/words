                ],
                "senses": [
                    {
                        "sense_id": "7855a9d8-cb7c-36f4-b158-54f1af48fb1c",
                        "entry_id": "84002eea-4902-3c6e-9277-1bfc4223d284",
                        "glosses": [
                            "Se comporter comme un galopin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d74987-183a-468c-b0e5-2145025d40d0",
                                "sense_id": "7855a9d8-cb7c-36f4-b158-54f1af48fb1c",
                                "text": "Sa fille Marie-Louise, âgée de douze ans, et son fils Philippe-Auguste, âgé de neuf, galopinaient dans les ruisseaux de l’avenue, avec tous les polissons du quartier."
                            },
                            {
                                "example_id": "b3f6ec8e-a771-4384-aee5-7ff36f290461",
                                "sense_id": "7855a9d8-cb7c-36f4-b158-54f1af48fb1c",
                                "text": "Quant à Simon, ils ne le connaissaient pas, car il ne sortait jamais et il ne galopinait point avec eux dans les rues du village ou sur les bords de la rivière."
                            },
                            {
                                "example_id": "16215310-51d3-4ece-92f4-6ff13b6e22bb",
                                "sense_id": "7855a9d8-cb7c-36f4-b158-54f1af48fb1c",
                                "text": "Un petit Alsacien, qui a des tentations d'aller galopiner dans la forêt, se décide pourtant à se rendre à l'école."
                            },
                            {
                                "example_id": "bae6617c-64a8-4fda-a78a-a0c7d5eb61c8",
                                "sense_id": "7855a9d8-cb7c-36f4-b158-54f1af48fb1c",
                                "text": "Il ne pense plus qu'à galopiner, à monter sur vélocipède."
                            },
                            {
                                "example_id": "253af859-3c43-4ef2-bb22-1516dc5d4ff2",
                                "sense_id": "7855a9d8-cb7c-36f4-b158-54f1af48fb1c",
                                "text": "C’était jeudi, au lieu de galopiner dans le quartier, je regardais les terrassiers travailler, la ceinture de flanelle bien serrée à la taille pour protéger les reins."
                            },
                            {
                                "example_id": "41fdcbb2-49fc-42a0-b72a-60f6b6f5744f",
                                "sense_id": "7855a9d8-cb7c-36f4-b158-54f1af48fb1c",
                                "text": "Tout en galopinant par les rues assoupies du vieux Nogent avec les autres graines de Ritals, je nourrissais d’emprunts à la bibliothèque municipale une ogresque frénésie de lecture."
                            }
                        ]
                    }
                ],
