                        "sense_id": "4d4da437-bbb5-3ce3-b625-8ba3dac2f66d",
                        "entry_id": "cfc302ae-ad2e-3904-add7-3505095a68d1",
                        "glosses": [
                            "osoba mówiąca od rzeczy, nieprawdomówna"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9dfbc8ef-94dc-41f4-b2b4-3831c0c089a8",
                                "sense_id": "4d4da437-bbb5-3ce3-b625-8ba3dac2f66d",
                                "text": "Synu, jesteś bardzo nieprawdomówny, oni zaczną cię przezywać bajdurą!"
                            }
                        ],
                        "sense_index_json": "\"2.2\""
                    }
