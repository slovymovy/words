                    "frequency": "Middle",
                    "semantic_group_id": "juristisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Großvater möchte seiner Familie ein altes Haus auf dem Land <w>vererben</w>."
                        },
                        {
                            "text": "Sie hat ihr gesamtes Vermögen an eine gemeinnützige Stiftung <w>vererbt</w>."
                        }
                    ],
                    "synonyms": [
                        "vermachen",
                        "hinterlassen"
                    ],
                    "antonyms": [
                        "erben"
                    ],
                    "common_phrases": [
                        "ein Haus vererben",
                        "sein Vermögen vererben",
                        "an die Kinder vererben"
                    ]
                },
                {
                    "sense_id": "02a47492-ea8b-37fa-ac5f-48328cbf8149",
                    "sense_definition": "genetische Merkmale oder biologische Eigenschaften an die eigenen Nachkommen weitergeben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Manche Krankheiten können von den Eltern auf ihre Kinder <w>vererbt</w> werden."
                        },
                        {
                            "text": "Er hat die blauen Augen seiner Mutter an seine eigene Tochter <w>vererbt</w>."
