                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d72bd1e-b333-4138-86e5-e69d7dc711d2",
                                "sense_id": "dad3d825-7e5e-3341-86fc-fe2935b61b8c",
                                "text": "Vu le relief inexistant en Floride du Sud, je choisis d’y rouler en gravel, vélo aussi adroit sur le tarmac que sur les chemins tant qu’il n’y a pas trop de pierres."
                            }
                        ]
                    },
                    {
                        "sense_id": "db7612da-2aec-3a56-b02d-381cef340322",
                        "entry_id": "f1141e09-d201-337c-b4b5-ee55231f5030",
