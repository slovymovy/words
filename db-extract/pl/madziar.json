                        "form": "Madziarowie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "311826e1-21fa-3636-9cbf-e33eed8ff8dc",
                        "entry_id": "7fa192b6-5e7b-37b0-8579-a7de01f3e811",
                        "glosses": [
                            "Magyar, Hungarian (inhabitant of Hungary)"
                        ],
                        "tags": [
                            "dated",
                            "derogatory",
                            "informal",
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "ba772738-ec87-4199-8b3f-63f30ee777de",
                                "sense_id": "311826e1-21fa-3636-9cbf-e33eed8ff8dc",
                                "text": "Madziarzy są za granicą słowacką.",
                                "translation": "The Magyars are on the other side of the Slovak border.",
                                "english": "The Magyars are on the other side of the Slovak border."
                            },
                            {
                                "example_id": "09873f0d-132d-43cc-ba90-fa28629730c5",
                                "sense_id": "311826e1-21fa-3636-9cbf-e33eed8ff8dc",
                                "text": "Madziar obrazę prędko zapomina, Niemiec trudno, Słowak nigdy.",
                                "translation": "A Magyar forgets the insult fast, a German with difficulty, [and] a Slovak never.",
                                "english": "A Magyar forgets the insult fast, a German with difficulty, [and] a Slovak never."
                            },
                            {
                                "example_id": "b96d9b8f-587c-4588-a0e6-b6122c4a5bfe",
                                "sense_id": "311826e1-21fa-3636-9cbf-e33eed8ff8dc",
                                "text": "Bo Madziar i Turek są jednej nacyje, oba pochodzą z Azyje; skądsi z Tataryje.",
                                "translation": "Because Magyars and Turks are of one nation, both come from Asia; somewhere from Tartary.",
                                "english": "Because Magyars and Turks are of one nation, both come from Asia; somewhere from Tartary."
                            },
                            {
                                "example_id": "877395b0-59ea-4153-bb84-26afe764a982",
                                "sense_id": "311826e1-21fa-3636-9cbf-e33eed8ff8dc",
                                "text": "Madziar był u siebie panem w domu; chałupę z ogrodem nazywał dumnie swoim majątkiem, żonę i dzieci czeladzią, nawzajem żona nigdy go nie tykała i nazywała swoim panem.",
                                "translation": "The Hungarian was a lord at his home; he proudly called a cottage with a garden his property, his wife and children as his servants, and his wife, in turn, never touched him and never called him her lord.",
                                "english": "The Hungarian was a lord at his home; he proudly called a cottage with a garden his property, his wife and children as his servants, and his wife, in turn, never touched him and never called him her lord."
                            },
                            {
                                "example_id": "ff63fd89-cdea-4840-85ae-ae2fdc9b6eb2",
                                "sense_id": "311826e1-21fa-3636-9cbf-e33eed8ff8dc",
                                "text": "Tym samym „Madziarzy” przystąpią do spotkania kończącego dla nich fazę kwalifikacyjną do przyszłorocznego mundialu przeciwko Polsce (15 listopada o godzinie 20:45) poważnie osłabieni brakiem podstawowego bramkarza.",
                                "translation": "Therefore, the \"Magyars\" will participate in the match ending next year's qualification phase to next year's World Cup against Poland (15 November at 20:45) for them, heavily weakened by the lack of a primary goalkeeper.",
                                "english": "Therefore, the \"Magyars\" will participate in the match ending next year's qualification phase to next year's World Cup against Poland (15 November at 20:45) for them, heavily weakened by the lack of a primary goalkeeper."
                            }
                        ]
                    }
                ],
