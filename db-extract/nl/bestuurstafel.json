                        "examples": [
                            {
                                "example_id": "7ab92c84-e4b0-4c97-ac4e-5df483c50aaa",
                                "sense_id": "ad566024-c6b3-3794-874f-d375f3438b46",
                                "text": "Zijn opvolger Mathhias Müller en zijn collega's aan de bestuurstafel bij Volkswagen hebben vorig jaar 30 procent van hun bonus ingeleverd. Overigens wordt dat geld apart gezet in aandelen Volkswagen en kunnen ze het over enkele jaren bij een bepaalde stijging van het aandeel alsnog uitgekeerd krijgen."
                            },
                            {
                                "example_id": "b2b138d7-f83c-4d15-849c-2dd66767c45a",
                                "sense_id": "ad566024-c6b3-3794-874f-d375f3438b46",
                                "text": "De Telegraaf omschrijft Geesink als een markant sportman en bestuurder. \"Anton Geesink was een man die graag tegen de stroom in roeide en ook achter de bestuurstafel de straatvechter bleef die in 1964 olympisch goud veroverde. Hoewel hij altijd het idee had dat er aan zijn poten werd gezaagd, hield Geesink zijn rug recht.\""
                            }
                        ]
                    }
