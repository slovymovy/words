                "senses": [
                    {
                        "sense_id": "631760ba-93c5-342b-b147-43b2076980fe",
                        "entry_id": "c48942c4-a5db-3d00-9022-a88a75e67916",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "256831ef-6c83-49a2-b420-ae12cf5d872f",
                                "sense_id": "631760ba-93c5-342b-b147-43b2076980fe",
                                "text": "Frau Bartle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b479605d-5a96-4ef2-89e2-b2e2b8b80f46",
                                "sense_id": "631760ba-93c5-342b-b147-43b2076980fe",
                                "text": "Herr Bartle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b49ed8ca-3784-4cbb-9523-a7173e4d77e1",
                                "sense_id": "631760ba-93c5-342b-b147-43b2076980fe",
                                "text": "Die Bartles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0b3ed61d-83e8-4018-9ad1-c84f1c16a53d",
                                "sense_id": "631760ba-93c5-342b-b147-43b2076980fe",
                                "text": "Der Bartle trägt nie die Schals, die die Bartle ihm strickt."
                            },
                            {
                                "example_id": "f585e053-fb2a-4b96-821a-c40c27bd78cf",
                                "sense_id": "631760ba-93c5-342b-b147-43b2076980fe",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bartle kommt, geht der Herr Bartle.“"
                            },
                            {
                                "example_id": "eef14f08-c840-4f6f-bfb5-04f536faa5fb",
                                "sense_id": "631760ba-93c5-342b-b147-43b2076980fe",
                                "text": "Bartle kommt und geht."
                            },
                            {
                                "example_id": "8ab55614-3644-402e-aea3-43e23dba60ab",
                                "sense_id": "631760ba-93c5-342b-b147-43b2076980fe",
                                "text": "Bartles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
