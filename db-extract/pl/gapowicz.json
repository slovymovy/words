                "senses": [
                    {
                        "sense_id": "8e06ec02-597a-3b35-881e-24c7b0d79ee6",
                        "entry_id": "95aaf4d3-9bd2-3a0d-b2bf-0c00db668f6f",
                        "glosses": [
                            "pasażer podróżujący bez biletu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36952163-b522-4659-9a9c-0e2e8f5972a0",
                                "sense_id": "8e06ec02-597a-3b35-881e-24c7b0d79ee6",
                                "text": "Konduktorzy złapali w przedziale obok dwóch gapowiczów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "41ee05b6-24e0-37a1-ab03-71773d59d1c1",
                        "entry_id": "95aaf4d3-9bd2-3a0d-b2bf-0c00db668f6f",
                        "glosses": [
                            "osoba przyglądająca się (bezmyślnie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d861fa4b-d123-4e9c-b146-1026eaa42ff3",
                                "sense_id": "41ee05b6-24e0-37a1-ab03-71773d59d1c1",
                                "text": "Dookoła pełno było gapowiczów z aparatami."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fdf1aff-dcd7-4d43-8a47-e97d2fd96450",
                        "source_entry_id": "95aaf4d3-9bd2-3a0d-b2bf-0c00db668f6f",
                        "source_sense_id": "8e06ec02-597a-3b35-881e-24c7b0d79ee6",
                        "target_lang_word": "fare dodger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fare dodger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                        "entry_id": "0039c65b-7b35-3e40-a7dd-c86ea990d350",
                                        "glosses": [
                                            "A person who deliberately avoids payment for public transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ca2ff0-6590-4466-af4a-f173c472a986",
                                                "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                                "text": "Police officers and prosecutors were forced to spend sizeable proportions of their capacity on arresting and prosecuting faredodgers."
                                            },
                                            {
                                                "example_id": "5c973b70-08ae-4d1d-9364-e09d39797384",
                                                "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                                "text": "The fare-dodger and the gate-crasher do, after all, commit a trespass [...]"
                                            },
                                            {
                                                "example_id": "7fc0a705-7c53-4a1c-be1b-66db7fe8e9c7",
                                                "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                                "text": "Alan Pollock was hailed as a hero after millions on the internet watched a video of the ‘Big Man’ hauling an alleged fare dodger off a train."
                                            },
                                            {
                                                "example_id": "c0f79ac4-d217-4a34-adcc-f8fa168af4dd",
                                                "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                                "text": "The subject of dealing with fare dodgers seems to be ripe, particularly on crowded trains where the 'train manager-cum-ticket collector' can have difficulty getting through the carriages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13285c67-c832-4e07-8e40-78de9a7e850e",
                        "source_entry_id": "95aaf4d3-9bd2-3a0d-b2bf-0c00db668f6f",
                        "source_sense_id": "8e06ec02-597a-3b35-881e-24c7b0d79ee6",
                        "target_lang_word": "polizón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polizón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "25e23e9c-3334-3d90-a4ae-ec72605df7c8",
                                        "entry_id": "552bba2a-3162-3e1d-84f7-9e203292dcc0",
                                        "glosses": [
                                            "Persona ociosa."
                                        ],
                                        "tags": [
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a9e3645-e207-3b8d-91df-2364ea0b104f",
                                        "entry_id": "552bba2a-3162-3e1d-84f7-9e203292dcc0",
                                        "glosses": [
                                            "Persona que viaja clandestinamente y sin pagar pasaje en un vehículo, especialmente en un barco."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e10671-8697-478c-89d3-84dcc9d59f64",
                                                "sense_id": "3a9e3645-e207-3b8d-91df-2364ea0b104f",
                                                "text": "Y visto en mi Consejo de las Indias y consultádoseme sobre ello, teniendo presente que el haberse prohibido por las referidas leyes de la Recopilación el pase de los polizones a Indias y impuéstose a ellos y a los jefes que lo permitieren las graves penas que en ellas se expresan es porque resulta de este desorden el perjuicio tan insubsanable de la despoblación de España que es el principal motivo de la prohibición."
                                            },
                                            {
                                                "example_id": "36f7df31-d1f9-4a98-b8d9-76d43f0377a4",
                                                "sense_id": "3a9e3645-e207-3b8d-91df-2364ea0b104f",
                                                "text": "El tronco de esas altaneras familias había sido quizá algún pobre polizón venido de España sin más riquezas que su sombrero embreado y un chaquetón de lana, o algún honrado comerciante que había ganado sus blasones detrás del mostrador de una tienda."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d4ea9566-ebcf-3387-87d0-b6d46e5ffcf2",
                                        "entry_id": "552bba2a-3162-3e1d-84f7-9e203292dcc0",
                                        "glosses": [
                                            "Por extensión, animal que viaja accidentalmente acompañando a la carga principal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056b47fd-5929-42b3-825f-33a8111cc37c",
                                                "sense_id": "d4ea9566-ebcf-3387-87d0-b6d46e5ffcf2",
                                                "text": "Pero, además de los cerdos, perros y aves domésticas y plantas cultivables, llevaron sin darse cuenta algunos polizones, como ratas polinesias, gecos y toda clase de malas hierbas e invertebrados."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a8ef7b4f-6e22-394d-b858-8c9f727a843f",
                                        "entry_id": "552bba2a-3162-3e1d-84f7-9e203292dcc0",
                                        "glosses": [
                                            "Armazón que, para dar vuelo a la falda, se llevaba en la parte lumbar de los vestidos de dama hacia fines del siglo XIX y comienzos del XX."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0072577-d732-413c-bd0a-acc4bc95416a",
                                                "sense_id": "a8ef7b4f-6e22-394d-b858-8c9f727a843f",
                                                "text": "encaramado sobre sus largas canillas, se reia á sus anchas fuera, de todo riesgo, al mirar las fieras de Don Constancio destrozando la crinolina, enaguas y polizón de la comprometida Parepa."
                                            },
                                            {
                                                "example_id": "66af7274-4745-4c95-b4d8-46c9cd2a8a33",
                                                "sense_id": "a8ef7b4f-6e22-394d-b858-8c9f727a843f",
                                                "text": "Todo es apretazón: edificios altos de caliza parda, victorias, tranvías de caballos, gentes de bigote en aparatosas bicicletas, traficantes apurados, damas de bonetillo y polizón que se remangan la cola."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4182d8b-34e7-44cb-9a7e-9c5d6f98cd42",
                        "source_entry_id": "95aaf4d3-9bd2-3a0d-b2bf-0c00db668f6f",
                        "source_sense_id": "8e06ec02-597a-3b35-881e-24c7b0d79ee6",
