                            {
                                "target_lang_word": "dweepziek",
                                "target_lang_sense_clarification": "overdreven bewonderend of geobsedeerd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35c5c60e-8692-3c44-9056-e9edf162f0dd",
                    "sense_definition": "Intoxicated or stupefied by alcohol.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man sat in the corner of the tavern, <w>besotted</w> with cheap wine.",
                            "target_lang_translations": {
                                "ru": "Старик сидел в углу таверны, <w>одурманенный</w> дешевым вином.",
                                "nl": "De oude man zat in de hoek van de herberg, <w>bedwelmd</w> door goedkope wijn."
                            }
                        },
                        {
                            "text": "He stumbled home late at night, <w>besotted</w> and muttering to himself.",
                            "target_lang_translations": {
                                "ru": "Он брел домой поздно ночью, <w>пьяный</w> и бормочущий что-то себе под нос.",
                                "nl": "Hij strompelde laat in de nacht naar huis, <w>dronken</w> en mompelend in zichzelf."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "intoxicated",
                        "inebriated",
                        "sodden",
                        "befuddled"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "besotted with drink"
                    ],
                    "traits": [
