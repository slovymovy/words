                    "sense_id": "e5321ace-5c7a-3640-8933-0c0e1cae03f5",
                    "sense_definition": "Een beleefde toevoeging die wordt gebruikt om een verzoek of vraag vriendelijker te maken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wilt u <w>alstublieft</w> even wachten tot de dokter beschikbaar is?",
                            "target_lang_translations": {
                                "ru": "Подождите, <w>пожалуйста</w>, пока доктор освободится.",
                                "en": "Could you <w>please</w> wait a moment until the doctor is available?",
                                "pl": "Czy mógłby pan/pani <w>proszę</w> chwilę poczekać, aż lekarz będzie dostępny?",
                                "de": "Würden Sie <w>bitte</w> kurz warten, bis der Arzt Zeit hat?",
                                "fr": "Veuillez patienter <w>s'il vous plaît</w> jusqu'à ce que le médecin soit disponible.",
                                "it": "Vuole attendere un momento, <w>per cortesia</w>, finché il medico non sarà disponibile?",
                                "cs": "Mohl byste <w>prosím</w> chvíli počkat, než bude lékař k dispozici?",
                                "tr": "Doktor müsait olana kadar <w>lütfen</w> biraz bekler misiniz?",
                                "es": "¿Podría esperar un momento, <w>por favor</w>, hasta que el médico esté disponible?"
                            }
                        },
                        {
                            "text": "Mag ik de menukaart <w>alstublieft</w> even zien?",
                            "target_lang_translations": {
                                "ru": "Можно мне, <w>пожалуйста</w>, посмотреть меню?",
                                "en": "May I see the menu <w>please</w>?",
                                "pl": "Czy mogę <w>proszę</w> zobaczyć menu?",
                                "de": "Darf ich <w>bitte</w> die Speisekarte sehen?",
                                "fr": "Puis-je voir la carte, <w>s'il vous plaît</w> ?",
                                "it": "Posso vedere il menu, <w>per favore</w>?",
                                "cs": "Mohu <w>prosím</w> vidět jídelní lístek?",
                                "tr": "Menüyü görebilir miyim <w>lütfen</w>?",
                                "es": "¿Puedo ver la carta, <w>por favor</w>?"
                            }
                        }
                    ],
