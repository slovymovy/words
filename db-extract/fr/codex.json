                    {
                        "sense_id": "d9ef05a9-089d-36fe-9584-182af1f9b528",
                        "entry_id": "077eb95e-0585-3a12-9dea-15e9c3893337",
                        "glosses": [
                            "Recueil des formules pharmaceutiques approuvées par la Faculté de Médecine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12542908-0216-43b9-a262-6aa17819664f",
                                "sense_id": "d9ef05a9-089d-36fe-9584-182af1f9b528",
                                "text": "Codex pharmaceutique."
                            },
                            {
                                "example_id": "c5e11b60-fc3e-46f7-bdda-6959a2af629e",
                                "sense_id": "d9ef05a9-089d-36fe-9584-182af1f9b528",
                                "text": "Les formules du Codex."
                            }
                        ]
                    },
                    {
                        "sense_id": "567f913c-8dce-3f19-9e29-8b3f0d638ccc",
                        "entry_id": "077eb95e-0585-3a12-9dea-15e9c3893337",
                        "glosses": [
                            "Manuscrit ancien, relié à la manière des livres modernes."
                        ],
                        "tags": [
                            "Bibliothéconomie"
                        ],
                        "examples": [
                            {
                                "example_id": "19dbedf2-d3c3-40e7-8ae0-ba430f3120f4",
                                "sense_id": "567f913c-8dce-3f19-9e29-8b3f0d638ccc",
                                "text": "Le codex est constitué de 70 feuilles, soit 140 pages ornées de 185 illustrations en couleur, comportant par ailleurs des concepts rédigés au moyen de glyphes."
                            },
                            {
                                "example_id": "25a6a2e9-f716-407f-ae46-ae109a5a9b7f",
                                "sense_id": "567f913c-8dce-3f19-9e29-8b3f0d638ccc",
                                "text": "Seuls les érudits et les familles aisées pouvaient se procurer quelques rares rouleaux ou codex précieux et onéreux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31f8e298-dcb8-4f82-aef2-9d435dcc81eb",
                        "source_entry_id": "077eb95e-0585-3a12-9dea-15e9c3893337",
                        "target_lang_word": "Arzneibuch",
                        "target_lang_code": "de",
