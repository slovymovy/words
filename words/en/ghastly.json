{
    "word_family": [
        "ghastliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d4ef837b-eb42-3494-9975-367b977ef1de",
                    "sense_definition": "Having a pale or death-like appearance resembling a ghost",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His face was so <w>ghastly</w> that he looked like he had seen a spirit.",
                            "target_lang_translations": {
                                "ru": "Его лицо было настолько <w>мертвенно-бледным</w>, будто он увидел призрака."
                            }
                        },
                        {
                            "text": "The patient looked <w>ghastly</w> after being sick for several weeks.",
                            "target_lang_translations": {
                                "ru": "Пациент выглядел <w>ужасно измождённым</w> после нескольких недель болезни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ghastly pale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий мертвенно-бледный, призрачный или измождённый вид"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мертвенно-бледный",
                                "target_lang_sense_clarification": "о внешности, лице"
                            },
                            {
                                "target_lang_word": "призрачный",
                                "target_lang_sense_clarification": "похожий на привидение"
                            },
                            {
                                "target_lang_word": "землистый",
                                "target_lang_sense_clarification": "о цвете лица от болезни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1c4d81-19d9-397b-a6ab-61f1210821d1",
                    "sense_definition": "Causing great horror or shock",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "horror",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news report described the <w>ghastly</w> accident in great detail.",
                            "target_lang_translations": {
                                "ru": "В репортаже новостей подробно описывалась эта <w>ужасная</w> авария."
                            }
                        },
                        {
                            "text": "They discovered a <w>ghastly</w> crime scene in the old abandoned house.",
                            "target_lang_translations": {
                                "ru": "В старом заброшенном доме они обнаружили <w>жуткое</w> место преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "lurid",
                        "grisly",
                        "gruesome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильный ужас, страх или потрясение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "вызывающий ужас"
                            },
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "пугающий, жуткий"
                            },
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "зловещий или леденящий душу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7cfae8c-0c80-3279-9c2c-e50688ac9665",
                    "sense_definition": "Very unpleasant or of poor quality",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather during our vacation was absolutely <w>ghastly</w> every single day.",
                            "target_lang_translations": {
                                "ru": "Погода во время нашего отпуска каждый божий день была абсолютно <w>отвратительной</w>."
                            }
                        },
                        {
                            "text": "I had a <w>ghastly</w> time at the party because I knew nobody there.",
                            "target_lang_translations": {
                                "ru": "Я <w>ужасно</w> провел время на вечеринке, потому что никого там не знал."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне неприятный, скверный или очень низкого качества"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "крайне скверный"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "очень плохой"
                            },
                            {
                                "target_lang_word": "кошмарный",
                                "target_lang_sense_clarification": "о погоде, опыте, времени"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8262c29e-1b8e-3602-8d06-1a4874666364",
                    "sense_definition": "In a manner that is pale, death-like, or horrifying",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He smiled <w>ghastly</w> as he realized the trap had been set.",
                            "target_lang_translations": {
                                "ru": "Он <w>жутко</w> улыбнулся, поняв, что ловушка захлопнулась."
                            }
                        },
                        {
                            "text": "The victim stared <w>ghastly</w> at the wall after the terrible event.",
                            "target_lang_translations": {
                                "ru": "После ужасного происшествия пострадавший <w>с мертвенным оцепенением</w> уставился в стену."
                            }
                        }
                    ],
                    "synonyms": [
                        "ghastlily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мертвенно, жутко или пугающе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жутко",
                                "target_lang_sense_clarification": "пугающе, зловеще"
                            },
                            {
                                "target_lang_word": "мертвенно",
                                "target_lang_sense_clarification": "безжизненно или пугающе бледно"
                            },
                            {
                                "target_lang_word": "ужасающе",
                                "target_lang_sense_clarification": "вызывая ужас"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}