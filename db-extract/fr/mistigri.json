        "fr-extract.jsonl": [
            {
                "entry_id": "7453580d-f7c0-36bd-a985-0cdd4c53f270",
                "word": "mistigri",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4da319d8-61ac-46fc-a32d-fabc9565a811",
                        "entry_id": "7453580d-f7c0-36bd-a985-0cdd4c53f270",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "mistigris"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16ffe904-ca9d-3743-b41c-9e8d84dc6ec0",
                        "entry_id": "7453580d-f7c0-36bd-a985-0cdd4c53f270",
                        "glosses": [
                            "Chat."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "522f27da-3ebc-44a6-adfe-65455d87993f",
                                "sense_id": "16ffe904-ca9d-3743-b41c-9e8d84dc6ec0",
                                "text": "Vous conviendrez qu'une maison sans chat, c'est comme un curé sans sa soutane ou un Basque sans son béret : inconcevable! Les souris, ces amies de l'homme, risquent de pulluler. La présence d'un mistigri est profitable et rassurante à la fois."
                            },
                            {
                                "example_id": "2ca08f83-b0b5-4c82-8f0c-021bce577779",
                                "sense_id": "16ffe904-ca9d-3743-b41c-9e8d84dc6ec0",
                                "text": "— Votre démon aime les souris. N'avez-vous pas ici un chat noir ?\nUn mistigri couleur de charbon trottait sur la balustrade, à la recherche d'une bonne fortune dotée de grandes oreilles roses et d'une queue de rat."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd2e1d48-223d-31b2-949a-d6ba658bd7b9",
                        "entry_id": "7453580d-f7c0-36bd-a985-0cdd4c53f270",
                        "glosses": [
                            "Mauvaise carte d’un jeu qui fait perdre celui qui la conserve en fin de partie."
                        ],
                        "tags": [
                            "Cartes à jouer"
                        ],
                        "examples": [
                            {
                                "example_id": "ab25b302-b7f3-4921-97b0-50ec8bb90477",
                                "sense_id": "cd2e1d48-223d-31b2-949a-d6ba658bd7b9",
                                "text": "Dépêchez-vous de refiler le mistigri mon ami ! Il ne fera pas bon être en train de danser quand la musique s’arrêtera."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf0594eb-6484-32c3-aab9-a6de64e5388c",
                        "entry_id": "7453580d-f7c0-36bd-a985-0cdd4c53f270",
                        "glosses": [
                            "Ce jeu lui-même, appelé également pouilleux ou pissou."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "95ee56a0-346b-4a6f-97a4-8e25592eb978",
                                "sense_id": "cf0594eb-6484-32c3-aab9-a6de64e5388c",
                                "text": "J’aurais pu croire qu’ils jouaient au mistigri si je n’avais su que mon père s’était mis en tête d’expliquer au jardinier l’échelle de Mohs qui gradue les minéraux selon leur dureté, de un (le talc) à dix (le diamant)."
                            },
                            {
                                "example_id": "73523c6d-37ea-4aaa-a7b2-e6d0753217a9",
                                "sense_id": "cf0594eb-6484-32c3-aab9-a6de64e5388c",
                                "text": "Le dimanche après-midi on jouait aux petits chevaux et au mistigri."
                            },
                            {
                                "example_id": "38e200e4-d1d8-49c7-b110-18f2fb0378b9",
                                "sense_id": "cf0594eb-6484-32c3-aab9-a6de64e5388c",
                                "text": "À 19 h 20, après avoir dîné, les Washington ont entamé une partie de mistigri en écoutant de vieux succès de l’ère doo-wop. La conversation, en partie masquée par la musique, était banale."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7ca1d70-87c9-3fb5-ad80-63a2cf5c4d5e",
                        "entry_id": "7453580d-f7c0-36bd-a985-0cdd4c53f270",
                        "glosses": [
                            "Chose difficile que l’on doit assurer sans aide."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5749be92-ba7e-44bc-881b-b132c2256af3",
                                "sense_id": "c7ca1d70-87c9-3fb5-ad80-63a2cf5c4d5e",
                                "text": "Quel désastre, chère sœur ! Chacun se défausse sur l’autre, me voilà avec le mistigri et vous ne me dites même pas ce que je dois faire pour le « soutenir »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7a77507-5547-48eb-95b8-957056d42eba",
                        "source_entry_id": "7453580d-f7c0-36bd-a985-0cdd4c53f270",
                        "source_sense_description": "Jeu de cartes",
                        "target_lang_word": "Mieze",
