                "senses": [
                    {
                        "sense_id": "56393e25-0ff5-32fc-bb0b-9d40b786fce6",
                        "entry_id": "e0eb42ed-6aff-3767-988f-21d7e66e5784",
                        "glosses": [
                            "Demonstration mit sehr vielen Teilnehmern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b8d5d8-bb30-4273-9a0c-232603ae21b2",
                                "sense_id": "56393e25-0ff5-32fc-bb0b-9d40b786fce6",
                                "text": "„Mit einer Massendemonstration hat am Freitagabend das neue Jahr in Ungarn begonnen.“"
                            },
                            {
                                "example_id": "9bb91272-4b16-42db-820a-1223d5d72c04",
                                "sense_id": "56393e25-0ff5-32fc-bb0b-9d40b786fce6",
                                "text": "„Bei einer Massendemonstration vor drei Jahren lernte er einen hoffnungsvollen Oppositionspolitiker namens Alexis Tsipras kennen.“"
                            },
                            {
                                "example_id": "47c54d93-1206-40cd-8441-5471daf2a4b1",
                                "sense_id": "56393e25-0ff5-32fc-bb0b-9d40b786fce6",
                                "text": "„Es gab fast täglich Demonstrationen, die sich gelegentlich zu Massendemonstrationen ausweiteten.“"
                            },
                            {
                                "example_id": "6336a6bf-4f3d-4218-9f74-168fbb40c160",
                                "sense_id": "56393e25-0ff5-32fc-bb0b-9d40b786fce6",
                                "text": "„Die hautnahe Beteiligung an der Massendemonstration vom 15. Juli 1927 in Wien wird unter anderem seine These bestätigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
