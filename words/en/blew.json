                {
                    "sense_id": "5bf72bfa-a6f5-3e6e-bd2b-1fef7203ca16",
                    "sense_definition": "Simple past tense of <w>blow</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind <w>blew</w> the dry leaves across the street.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер <w>гнал</w> сухие листья через улицу.",
                                "zh": "大风把干枯的落叶<w>吹</w>过了街道。"
                            }
                        },
                        {
                            "text": "She <w>blew</w> out the candles on her birthday cake.",
                            "target_lang_translations": {
                                "ru": "Она <w>задула</w> свечи на своем именинном торте.",
                                "zh": "她<w>吹灭</w>了生日蛋糕上的蜡烛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blew it",
                        "blew up",
                        "blew away",
                        "blew over"
                    ],
