                                        ],
                                        "tags": [
                                            "Feuerwehr"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feae2b9e-b825-412d-9f44-f48c85756877",
                                                "sense_id": "8afe1772-616c-3b9e-9fa7-4d3d67f83709",
                                                "text": "Vor der ersten Staffel überflog eine Beobachtungsmaschine die Stadt."
                                            },
                                            {
                                                "example_id": "94ede326-c160-4d32-9b35-4a7ce27ca68b",
                                                "sense_id": "8afe1772-616c-3b9e-9fa7-4d3d67f83709",
                                                "text": "„Später flog eine Staffel über den Bahnhof hinweg und begann zu steigen, bis sie aussah wie eine Schar Lerchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "481dfd63-3f1a-31d0-b238-bac6c593299e",
                                        "entry_id": "042cfcde-5f1e-3c8f-af28-95a5daabc272",
                                        "glosses": [
                                            "eine Gruppe von Sportlern, welche gemeinsam an einem Staffelrennen teilnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57a45535-5319-4ae4-91e8-f5ffcec50984",
                                                "sense_id": "481dfd63-3f1a-31d0-b238-bac6c593299e",
                                                "text": "Bei den olympischen Schwimmwettbewerben der Herren errang die deutsche Staffel die Silbermedaille."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0215ff87-cbef-3b9e-8930-432b87b1d47c",
                                        "entry_id": "042cfcde-5f1e-3c8f-af28-95a5daabc272",
                                        "glosses": [
                                            "eine Anzahl von Episoden einer Serie, die zusammen herausgegeben werden"
                                        ],
                                        "tags": [
                                            "TV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f22fe3-0a63-4810-a652-36a38650d5f0",
                                                "sense_id": "0215ff87-cbef-3b9e-8930-432b87b1d47c",
                                                "text": "Die Serie wurde nach der zweiten Staffel abgesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "793873a1-db18-3d46-8969-180f153cee30",
                                        "entry_id": "042cfcde-5f1e-3c8f-af28-95a5daabc272",
