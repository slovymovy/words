                "senses": [
                    {
                        "sense_id": "d82be7a8-d3b6-3d17-91e3-8baf90cd9f12",
                        "entry_id": "011e6dc8-b96c-3033-81db-4170731c8091",
                        "glosses": [
                            "Soumettre à l’influence du makhzen (État marocain)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "216fe301-e70e-4498-9e80-e31947c4ce78",
                                "sense_id": "d82be7a8-d3b6-3d17-91e3-8baf90cd9f12",
                                "text": "En d’autres termes, si « caméraliser » équivaut à « makhzeniser », le débat est de nature politique."
                            },
                            {
                                "example_id": "c29f321a-beea-4463-9f69-b250b9f5f6db",
                                "sense_id": "d82be7a8-d3b6-3d17-91e3-8baf90cd9f12",
                                "text": "Ah, j’ai oublié, un troisième vieux schnock a été utilisé par le régime et pour makhzeniser à fond l’USFP et pour faire mourir de jalousie les deux premiers schnocks !"
                            },
                            {
                                "example_id": "9b80714b-7a8e-4c30-bb32-8edd88152b5f",
                                "sense_id": "d82be7a8-d3b6-3d17-91e3-8baf90cd9f12",
                                "text": "Difficile de makhzeniser Le Matin DZ aussi."
                            },
                            {
                                "example_id": "cd438109-af66-4fad-aaaa-d6952c8a153a",
                                "sense_id": "d82be7a8-d3b6-3d17-91e3-8baf90cd9f12",
                                "text": "Quelques uns ont interprété l’initiative du roi en faveur de la tamazight comme une forme de 'makhzeniser' une partie de l’élite du mouvement culturel amazigh, qui peut être parfaitement le cas."
                            }
                        ]
                    }
