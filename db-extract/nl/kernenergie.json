                        "translation_id": "0f5a6c56-ce2c-4556-ab14-2ccf9817d1ac",
                        "source_entry_id": "71b4446b-e0af-3e90-bd15-8bed9a9ba8db",
                        "source_sense_id": "543e5e2f-94a9-3bb9-886d-89cf87dff39a",
                        "source_sense_description": "energie geproduceerd door kernfusie of kernsplijting, waarmee in een kerncentrale elektriciteit wordt opgewekt",
                        "target_lang_word": "Atomenergie",
