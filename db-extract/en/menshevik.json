                    {
                        "form_id": "7d9707f7-443d-4051-a45f-555241597894",
                        "entry_id": "f1a391bc-898b-3672-be94-a70d28e1f7f0",
                        "tags": [
                            "literary",
                            "plural"
                        ],
                        "form": "Mensheviki"
