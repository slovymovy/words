                            {
                                "example_id": "3be8883f-645d-4eb4-b300-1ca92774631c",
                                "sense_id": "7115c243-70a5-3808-a4a1-47d9c8295ea3",
                                "text": "„Herr Albin,“ rief eine Dame hinter ihm drein, „holen Sie lieber Ihren Paletot, ziehen Sie ihn an, tun Sie es mir zuliebe! Sechs Wochen haben Sie mit Lungenentzündung gelegen, und nun sitzen Sie hier ohne Überzieher und decken sich nicht einmal zu und rauchen Zigaretten![…]“",
                                "translation": "The Magic Mountain",
                                "english": "The Magic Mountain"
                            }
                        ]
                    }
