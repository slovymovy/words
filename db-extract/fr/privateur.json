                "senses": [
                    {
                        "sense_id": "4b6bc2d3-f5f7-3784-ab10-a1dd88c9d5a1",
                        "entry_id": "bc2cf356-8f52-395e-a990-2c622fc16dfd",
                        "glosses": [
                            "Celui qui prive autrui d'un droit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b00ad19e-c121-4413-9ec7-844c4a381efa",
                                "sense_id": "4b6bc2d3-f5f7-3784-ab10-a1dd88c9d5a1",
                                "text": "D’où sa colère contre le privateur qui selon lui aurait pu être le donateur."
                            },
                            {
                                "example_id": "cac642a5-11ac-40f5-8a50-af3e43179c36",
                                "sense_id": "4b6bc2d3-f5f7-3784-ab10-a1dd88c9d5a1",
                                "text": "Priver un peuple de tout ou de partie de sa liberté, lui imposer seulement même une limitation de liberté, est une grande forfaiture gouvernementale, politique; parce que c'est le priver de tout ou de partie de cette grande vie sociale de bien-être et d'honneur à laquelle il a plus droit que ses privateurs ; et lui arracher cette liberté, c'est attenter au droit naturel de tous, […]."
                            },
                            {
                                "example_id": "15c061e8-65bd-44c7-ab34-d49b48b8b490",
                                "sense_id": "4b6bc2d3-f5f7-3784-ab10-a1dd88c9d5a1",
                                "text": "L'amour de la vie, des siens, de ses passions, de sa maison, c'est ce que Sophie hisse tout au long de ce livre, comme un étendard, un drapeau levé contre les pilleurs de bonheur, les privateurs de lendemains."
                            }
                        ]
                    }
