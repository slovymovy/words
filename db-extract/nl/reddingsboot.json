                        "source_sense_id": "c4b4854e-3e8f-31a5-915b-dba9a634d2a6",
                        "source_sense_description": "een speciaal gebouwde en uitgeruste boot om het schip in geval van nood veilig te kunnen verlaten.",
                        "target_lang_word": "Rettungsboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rettungsboot",
