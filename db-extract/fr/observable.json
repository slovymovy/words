                "forms": [
                    {
                        "form_id": "c5132f55-d0fb-46ed-b093-117189ce9294",
                        "entry_id": "ef3221fc-48fb-36b1-86c4-e380461d2c49",
                        "tags": [
                            "plural",
                            "masculine",
