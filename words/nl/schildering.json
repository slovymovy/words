    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25339179-e41b-3184-84d4-44f4b3806163",
                    "sense_definition": "Een afbeelding die met verf is gemaakt op een oppervlak.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kunst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude kerk is versierd met een prachtige <w>schildering</w> op het plafond.",
                            "target_lang_translations": {
                                "en": "The old church is decorated with a beautiful <w>painting</w> on the ceiling."
                            }
                        },
                        {
                            "text": "Zij maakte een kleurrijke <w>schildering</w> op het doek.",
                            "target_lang_translations": {
                                "en": "She made a colorful <w>painting</w> on the canvas."
                            }
                        }
                    ],
                    "synonyms": [
                        "schilderij"
                    ],
                    "common_phrases": [
                        "kleurrijke schildering",
                        "abstracte schildering"
                    ],
                    "target_lang_definitions": {
                        "en": "An image created with paint on a surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "painting",
                                "target_lang_sense_clarification": "a work of art created with paint"
                            },
                            {
                                "target_lang_word": "depiction",
                                "target_lang_sense_clarification": "a visual representation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdb45f68-404d-379c-881e-8f8f234c3035",
                    "sense_definition": "Een afbeelding die direct op een muur of wand is aangebracht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kunst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De archeologen ontdekten een eeuwenoude <w>schildering</w> in de grot.",
                            "target_lang_translations": {
                                "en": "The archaeologists discovered an ancient <w>painting</w> in the cave."
                            }
                        },
                        {
                            "text": "Deze <w>schildering</w> op de buitenmuur trekt veel toeristen aan.",
                            "target_lang_translations": {
                                "en": "This <w>mural</w> on the exterior wall attracts many tourists."
                            }
                        }
                    ],
                    "common_phrases": [
                        "historische schildering",
                        "grote schildering"
                    ],
                    "target_lang_definitions": {
                        "en": "An image applied directly onto a wall or ceiling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mural",
                                "target_lang_sense_clarification": "a painting on a wall"
                            },
                            {
                                "target_lang_word": "wall painting",
                                "target_lang_sense_clarification": "artwork applied to a wall surface"
                            },
                            {
                                "target_lang_word": "fresco",
                                "target_lang_sense_clarification": "a painting done on wet plaster"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fcfc6ee-e01c-3611-a102-56cd91ddd679",
                    "sense_definition": "Een levendige of gedetailleerde beschrijving in woorden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beschrijving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auteur geeft een treffende <w>schildering</w> van het leven op het platteland.",
                            "target_lang_translations": {
                                "en": "The author gives a striking <w>portrayal</w> of life in the countryside."
                            }
                        },
                        {
                            "text": "Zijn verbale <w>schildering</w> van de situatie was erg indrukwekkend.",
                            "target_lang_translations": {
                                "en": "His verbal <w>depiction</w> of the situation was very impressive."
                            }
                        }
                    ],
                    "common_phrases": [
                        "treffende schildering",
                        "levendige schildering"
                    ],
                    "target_lang_definitions": {
                        "en": "A vivid or detailed description in words."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "portrayal",
                                "target_lang_sense_clarification": "a description or representation in words"
                            },
                            {
                                "target_lang_word": "depiction",
                                "target_lang_sense_clarification": "a detailed verbal account"
                            },
                            {
                                "target_lang_word": "description",
                                "target_lang_sense_clarification": "a vivid representation in language"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}