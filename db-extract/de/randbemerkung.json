                ],
                "senses": [
                    {
                        "sense_id": "98c8174e-b166-37d2-8568-fc1cbf4d9e89",
                        "entry_id": "9b502070-b981-3dcd-aa95-07c68d559590",
                        "glosses": [
                            "auf einen Textrand geschriebene Bemerkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328bc7cd-05f4-4f1d-8d7b-0c5fe1674be2",
                                "sense_id": "98c8174e-b166-37d2-8568-fc1cbf4d9e89",
                                "text": "„Es wurde nichts verheimlicht; selbst die Randbemerkungen des Kaisers zu den einzelnen Botschafterberichten wurden wörtlich abgedruckt.“"
                            },
                            {
                                "example_id": "c17650a3-53b4-43e3-9915-5c0709da0b8a",
                                "sense_id": "98c8174e-b166-37d2-8568-fc1cbf4d9e89",
                                "text": "„Er hat Emerson geradezu als seinen Geistesbruder betrachtet – Nietzsches vierbändige Ausgabe der Essays von Emerson (unter ihnen etwa „Nature“ von 1836 und „The American Scholar“ von 1837) ist zerfleddert, abgegriffen und mit vielen Randbemerkungen versehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ae4e0663-6426-3b7c-8d1d-c1206628b6c4",
                        "entry_id": "9b502070-b981-3dcd-aa95-07c68d559590",
                        "glosses": [
                            "beiläufige, zusätzliche Bemerkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418bfd5a-8e2c-4e4f-95aa-6c5bed1b7233",
                                "sense_id": "ae4e0663-6426-3b7c-8d1d-c1206628b6c4",
                                "text": "„Es war eine Randbemerkung, die Bürgermeister Ole von Beust bei der Grundsteinlegung für eine neue Eis- und Ballsporthalle im Volkspark machte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a010754d-2efa-4991-a7b4-7f9bbddfc481",
                        "source_entry_id": "9b502070-b981-3dcd-aa95-07c68d559590",
                        "source_sense_id": "98c8174e-b166-37d2-8568-fc1cbf4d9e89",
