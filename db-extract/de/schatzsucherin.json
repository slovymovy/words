                        "examples": [
                            {
                                "example_id": "f68b67f1-01d1-4afd-8597-7d1ad691dafe",
                                "sense_id": "182d6467-41d2-3b7f-9c7a-ffb44dc1ba1c",
                                "text": "„Dieselben Inquisitoren verurteilten, nachdem die Angeklagten ihre Häresie abgeschworen, im folgenden Jahre zu Carcassonne drei Hirten, welche durch Loswerfen ihrem Herrn eine Menge Schafe getötet hatten, und acht der Magie ganz ergebene Weiber, welche durch Fascination und Verwünschung ihre Mitmenschen geschädigt, aber auch als Schatzsucherinnen und Wahrsagerinnen fungiert hatten, zu längeren Gefängnisstrafen.“"
                            }
                        ],
