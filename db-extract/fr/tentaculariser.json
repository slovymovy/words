                "senses": [
                    {
                        "sense_id": "97aa85c6-0460-30d2-a4de-e9eda813f0f5",
                        "entry_id": "1123bd79-6fcd-336e-b975-309fcb7e3ec9",
                        "glosses": [
                            "Étendre des tentacules (au sens figuré), s'étendre de divers côtés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "106a574b-1ef8-46fd-8a16-23e68e63a22e",
                                "sense_id": "97aa85c6-0460-30d2-a4de-e9eda813f0f5",
                                "text": "D'ailleurs qui aujourd'hui au travers de l'OTAN est en train de tentaculariser la planète entière?"
                            },
                            {
                                "example_id": "5044ee6d-ae59-4cec-bc53-54833c283161",
                                "sense_id": "97aa85c6-0460-30d2-a4de-e9eda813f0f5",
                                "text": "Une fois de plus, les hospitaliers disent vouloir travailler avec les libéraux et élucubrent dans leur coin des solutions pour \"tentaculariser\" en ville et encadrer les libéraux…"
                            },
                            {
                                "example_id": "fc393b1a-357d-4b65-9305-777b494f7790",
                                "sense_id": "97aa85c6-0460-30d2-a4de-e9eda813f0f5",
                                "text": "Cette boîte était initialement prévue pour contrer les adresses gmail du concurrent Google qui tend à tentaculariser tous ses services (oui j’invente des verbes)."
                            }
                        ]
                    }
