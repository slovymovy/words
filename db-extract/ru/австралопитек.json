                                        "sense_id": "0b3a44b2-9247-304f-9c71-19856ac48f33",
                                        "entry_id": "910c7904-0726-3fd2-abc6-d4b296930f50",
                                        "glosses": [
                                            "Qui concerne les australopithèques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e085239-ba56-4c5f-aea3-8e8f4aebb207",
                                                "sense_id": "0b3a44b2-9247-304f-9c71-19856ac48f33",
                                                "text": "Les premiers hominidés connus sont les cousins australopithèques. Ces « pré-humains » avaient à peu près la taille et le poids d'un enfant de sept ans."
                                            }
                                        ]
                                    }
                                ]
