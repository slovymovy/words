        "nl-extract.jsonl": [
            {
                "entry_id": "5b030221-5d6b-3f48-b6eb-b44caf5d4133",
                "word": "natekenen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb1a98f1-bb70-3e40-9916-60d8d7ca4c15",
                        "entry_id": "5b030221-5d6b-3f48-b6eb-b44caf5d4133",
                        "glosses": [
                            "een voorbeeld door tekenen kopiëren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e7d619-f7e3-4fa7-8def-2b5991fcd9c4",
                                "sense_id": "cb1a98f1-bb70-3e40-9916-60d8d7ca4c15",
                                "text": "‘Ik heb een prínselijke kindertijd gehad. Geprivilegieerd. Tedere ouders en broer. En een halftijds leven bij een boerengezin – vlak bij het buitenverblijf van mijn grootouders in Sinaai. Daar heb ik van mijn 6 tot mijn 19 de seizoenen mogen meemaken. Het bucolische leven, in al zijn idylle en zijn hardheid. Van zaaien tot oogsten, cyclus na cyclus. Ik kan de boerderij nog natekenen, tot aan de kleinste grendel.’"
                            },
                            {
                                "example_id": "ee6b023c-8ee2-4314-a10f-b167c82e7661",
                                "sense_id": "cb1a98f1-bb70-3e40-9916-60d8d7ca4c15",
                                "text": "Kunstenaar Lee John Phillips zal als eerbetoon aan zijn overleden opa alles, écht alles, uit diens schuur natekenen."
                            }
                        ]
                    }
                ],
