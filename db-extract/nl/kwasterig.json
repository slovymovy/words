                "translations": [
                    {
                        "translation_id": "f0d2c49d-a54c-47b2-9cfa-16d7976641d3",
                        "source_entry_id": "b48f1cd8-9cd3-37f3-a21e-8b12d021ac6b",
                        "source_sense_id": "d51d7b88-3ecf-3e12-88e2-bee893c4640e",
                        "source_sense_description": "zoals past bij een rare, vreemde, verwaande kerel",
                        "target_lang_word": "conceited",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conceited",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a9ca850-1429-3d84-87df-204e103543d0",
                                        "entry_id": "d943d574-7a76-3140-bd16-d03552de9945",
                                        "glosses": [
                                            "Having an excessively favourable opinion of one's abilities, appearance, etc.; egotistical and vain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d31c4395-8ac6-47a1-b4d2-518c5709326c",
                                                "sense_id": "1a9ca850-1429-3d84-87df-204e103543d0",
                                                "text": "If you think me too conceited / Or to passion quickly heated."
                                            },
                                            {
                                                "example_id": "e5435161-2566-494d-b2c9-94a2bc37215f",
                                                "sense_id": "1a9ca850-1429-3d84-87df-204e103543d0",
                                                "text": "Conceited of their own wit, and science, and politeness."
                                            },
                                            {
                                                "example_id": "f0d87970-70f6-413b-8951-4071219646c5",
                                                "sense_id": "1a9ca850-1429-3d84-87df-204e103543d0",
                                                "text": "And another asked me if I had come to get a Canadian sweetheart; and a third, one of the impudentest, most conceitedest fellows I ever did set eyes upon, nudged me, so that I spilled my coffee all over my second-best damask-silk apron—the one with bugle fringe, you know, Miss Capel—and says he, ‘Is it a case of Barkis is willin'?'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dd01771-6623-39a6-af50-52f827eb37e6",
                                        "entry_id": "d943d574-7a76-3140-bd16-d03552de9945",
                                        "glosses": [
                                            "Having an ingenious expression or metaphorical idea, especially in extended form or used as a literary or rhetorical device."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39a05904-24fe-4882-822a-6bcd84248aad",
                                                "sense_id": "7dd01771-6623-39a6-af50-52f827eb37e6",
                                                "text": "Conceited wit showed its character towards the end of the fifteenth century in the work of poets who made it their aim to exercise their hearers' minds with cleaver plays of metaphor and ingenious reasoning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6fc18f-0cd0-3ff4-b1c5-c7a3af45fb87",
                                        "entry_id": "d943d574-7a76-3140-bd16-d03552de9945",
                                        "glosses": [
                                            "Endowed with fancy or imagination."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "041e6665-1e9f-44ca-9808-1196caafc1b8",
                                                "sense_id": "1c6fc18f-0cd0-3ff4-b1c5-c7a3af45fb87",
                                                "text": "AN EXCELLENT conceited Tragedie OF Romeo and Iuliet. As it hath been often (with great applause) plaid publiquely"
                                            },
                                            {
                                                "example_id": "ad306766-ad11-48d7-abd7-c749ed3987cc",
                                                "sense_id": "1c6fc18f-0cd0-3ff4-b1c5-c7a3af45fb87",
                                                "text": "He was […] pleasantly conceited, and sharp of wit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8bd08f2-3eb3-3fb4-93b2-87772571bc7c",
                                        "entry_id": "d943d574-7a76-3140-bd16-d03552de9945",
                                        "glosses": [
                                            "Curiously contrived or designed; fanciful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48d6fb4a-1c33-430c-86b8-88bddafa552f",
                                                "sense_id": "a8bd08f2-3eb3-3fb4-93b2-87772571bc7c",
                                                "text": "A conceited chair to sleep in."
                                            }
                                        ]
                                    }
                                ]
                            },
