                "senses": [
                    {
                        "sense_id": "58357556-11e7-3efa-92b9-21dd29e6ae98",
                        "entry_id": "330320e5-cdba-3f6d-b10b-38aa43c6a1a9",
                        "glosses": [
                            "Seil, um jemanden oder etwas festzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca62897-0fd1-4cef-90cc-7be41384a2fe",
                                "sense_id": "58357556-11e7-3efa-92b9-21dd29e6ae98",
                                "text": "„Das Halteseil war eine leichte Kette, die am Halsband des Racoons befestigt war und in einer Schleife an einem verzinkten Pfosten endete, der in die Erde gerammt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aabbd54c-61fa-461c-a109-1ead8160b821",
                        "source_entry_id": "330320e5-cdba-3f6d-b10b-38aa43c6a1a9",
                        "source_sense_id": "58357556-11e7-3efa-92b9-21dd29e6ae98",
                        "source_sense_description": "Seil, um jemanden oder etwas festzuhalten",
                        "target_lang_word": "entrave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56cd73ba-843f-3465-8655-9336897eaffd",
                                        "entry_id": "4807b6de-c853-3eea-83b7-d2c182c61590",
                                        "glosses": [
                                            "Lien qu’on met aux jambes d’un animal, ou traverse suspendue par une corde à son cou, pour en gêner la marche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7b1e2d-b823-4887-9997-e4e51d34f174",
                                                "sense_id": "56cd73ba-843f-3465-8655-9336897eaffd",
                                                "text": "Pourvu que dans leurs champs croisse la betterave,\nOu que dans leur grenier s’empile le froment,\nTout César à leur pied pourra river l’entrave;\nIls n’en marcheront tous que plus allègrement."
                                            },
                                            {
                                                "example_id": "771c0717-1c1f-4198-b541-09d479f267e1",
                                                "sense_id": "56cd73ba-843f-3465-8655-9336897eaffd",
                                                "text": "[…] il était normal que je fusse attaché. Par la suite, si je me montrais vraiment docile, il n’était pas impossible qu’elle pût me sortir sans entraves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d8a817-9d5c-3411-a718-83137e285bb8",
                                        "entry_id": "4807b6de-c853-3eea-83b7-d2c182c61590",
                                        "glosses": [
                                            "Lien pour attacher les prisonniers, les condamnés ou les esclaves."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dbba323-a845-4a7d-b1ae-a53a17672c69",
                                                "sense_id": "d2d8a817-9d5c-3411-a718-83137e285bb8",
                                                "text": "La victime devait être amenée sur ce fatal bûcher pour être enchaînée au poteau par des entraves qui y restaient suspendues pour cet emploi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5fa0cd0-2512-3bf3-854d-c6f349dbae8f",
                                        "entry_id": "4807b6de-c853-3eea-83b7-d2c182c61590",
                                        "glosses": [
                                            "Obstacle, empêchement, gêne, contrainte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a25b39b-d5aa-4b54-b6c2-8fc3d85ae5c3",
                                                "sense_id": "e5fa0cd0-2512-3bf3-854d-c6f349dbae8f",
                                                "text": "Les règles sont pour le génie des entraves salutaires."
                                            },
                                            {
                                                "example_id": "49b491be-cb29-490d-9368-b9155cc5b1bd",
                                                "sense_id": "e5fa0cd0-2512-3bf3-854d-c6f349dbae8f",
                                                "text": "Selon les enquêteurs, les trois étudiants de 19 ans – un Américain et deux Kazakhs – sont accusés d’entrave à la justice, […]"
                                            },
                                            {
                                                "example_id": "01104870-f655-44ce-95e6-9640d6c73c27",
                                                "sense_id": "e5fa0cd0-2512-3bf3-854d-c6f349dbae8f",
                                                "text": "Bref, on pourrait libérer la langue française de ses entraves héritées des siècles passés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entrave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ea49de7-c298-3204-98d4-3bcbfaf166ca",
                                        "entry_id": "a6b84639-c919-34d9-9fba-3fce31695db5",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de entraver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47fc3651-dbdb-3644-a114-f71e2c7d5b4b",
                                        "entry_id": "a6b84639-c919-34d9-9fba-3fce31695db5",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de entraver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7736e9a4-2f57-4e46-8570-3fdb3e0267de",
                                                "sense_id": "47fc3651-dbdb-3644-a114-f71e2c7d5b4b",
                                                "text": "Et ils n’ont toujours pas compris qu’on ne saurait faire céder un ministre avec du blablabla, qu’on ne saurait changer la vie sans changer celle des cons aussi, et qu’on ne saurait vivre ses désirs sans foutre en l’air ce qui les entrave !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c73c35-f60a-3df4-9f74-f028632562f2",
                                        "entry_id": "a6b84639-c919-34d9-9fba-3fce31695db5",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de entraver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20123187-9082-33ec-8b44-a6231f2f547d",
                                        "entry_id": "a6b84639-c919-34d9-9fba-3fce31695db5",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de entraver."
                                        ],
                                        "tags": [
