                "senses": [
                    {
                        "sense_id": "1ff6d4a4-6cc2-39c3-aa1e-0437eb7cf884",
                        "entry_id": "17982a78-8ac7-3045-bcfd-8289089db13d",
                        "glosses": [
                            "dynamite"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "72564606-04e0-4d9f-96fe-1b9e8ee2d2fe",
                                "sense_id": "1ff6d4a4-6cc2-39c3-aa1e-0437eb7cf884",
                                "text": "Писа́тельница огляну́лась, и пря́мо ей в лицо́ полете́ли, как ко́мья, гудки́. Она́ бро́силась к парово́зу. В си́лу того́, что шёл непреме́нно по ре́льсам, он пуга́л её не бо́льше, чем наведённое ду́ло ружья́, тогда́ как автомаши́ны каза́лись динами́тным заря́дом с уже́ запалённым фитилём."
                            }
                        ]
                    }
                ],
