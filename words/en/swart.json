    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0966ed7a-d94e-367c-a5ff-ecbaa5db5398",
                    "sense_definition": "Of a dark color, hue, or complexion; swarthy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mariner returned with weathered features and a <w>swart</w> complexion from his long voyage.",
                            "target_lang_translations": {
                                "de": "Der Seemann kehrte mit wettergegerbten Zügen und einem <w>dunklen</w> Teint von seiner langen Reise zurück."
                            }
                        },
                        {
                            "text": "Old portraits depicted the warrior as a severe man with thick brows and a <w>swart</w> visage.",
                            "target_lang_translations": {
                                "de": "Alte Porträts zeigten den Krieger als strengen Mann mit dichten Brauen und einem <w>dunkelhäutigen</w> Gesicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "swarthy",
                        "dark",
                        "tawny"
                    ],
                    "antonyms": [
                        "pale",
                        "fair"
                    ],
                    "common_phrases": [
                        "swart visage",
                        "swart complexion"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Von dunkler Hautfarbe, Färbung oder Teint; dunkelhäutig oder sonnengebräunt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dunkelhäutig",
                                "target_lang_sense_clarification": "von Teint oder Hautfarbe"
                            },
                            {
                                "target_lang_word": "dunkel",
                                "target_lang_sense_clarification": "von Gesichtszügen oder Haut"
                            },
                            {
                                "target_lang_word": "braun gebrannt",
                                "target_lang_sense_clarification": "durch die Witterung oder Sonne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3240937e-c323-3624-a490-cd54b9ad58f6",
                    "sense_definition": "Dark; black.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travellers were lost amid the <w>swart</w> shadows of the ancient forest.",
                            "target_lang_translations": {
                                "de": "Die Reisenden hatten sich in den <w>düsteren</w> Schatten des uralten Waldes verirrt."
                            }
                        },
                        {
                            "text": "A <w>swart</w> cloud arose on the horizon, threatening the valley with an imminent storm.",
                            "target_lang_translations": {
                                "de": "Eine <w>schwarze</w> Wolke stieg am Horizont auf und bedrohte das Tal mit einem heraufziehenden Unwetter."
                            }
                        }
                    ],
                    "synonyms": [
                        "black",
                        "ebon"
                    ],
                    "antonyms": [
                        "white",
                        "bright"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in poetic or literary texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Dunkel, düster oder schwarz gefärbt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schwarz",
                                "target_lang_sense_clarification": "sehr dunkel oder schwärzlich"
                            },
                            {
                                "target_lang_word": "dunkel",
                                "target_lang_sense_clarification": "von geringer Helligkeit"
                            },
                            {
                                "target_lang_word": "düster",
                                "target_lang_sense_clarification": "finster oder bedrohlich dunkel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85442561-2aab-3ba6-b762-76da3e107bae",
                    "sense_definition": "Gloomy, menacing, or malignant in appearance or character.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storyteller described a <w>swart</w> spirit that haunted the ruined fortress at midnight.",
                            "target_lang_translations": {
                                "de": "Der Geschichtenerzähler beschrieb einen <w>unheilvollen</w> Geist, der um Mitternacht in der Festungsruine spukte."
                            }
                        },
                        {
                            "text": "He scowled down at his captives with a <w>swart</w> gaze full of malicious intent.",
                            "target_lang_translations": {
                                "de": "Er blickte mit einem <w>finsteren</w> Blick voller böser Absichten auf seine Gefangenen herab."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloomy",
                        "malignant",
                        "sinister"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary and poetic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Düster, unheilvoll, bedrohlich oder bösartig in Erscheinung oder Charakter."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "düster",
                                "target_lang_sense_clarification": "finster und bedrohlich"
                            },
                            {
                                "target_lang_word": "unheilvoll",
                                "target_lang_sense_clarification": "Böses erahnend"
                            },
                            {
                                "target_lang_word": "finster",
                                "target_lang_sense_clarification": "vom Blick oder Wesen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee3a828e-13e0-3d41-9426-b374aa08e7ad",
                    "sense_definition": "A black or dark dyestuff.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cloth maker added a measure of <w>swart</w> to darken the wool mixture.",
                            "target_lang_translations": {
                                "de": "Der Tuchmacher fügte eine Prise <w>Schwarzfarbstoff</w> hinzu, um das Wollgemisch abzudunkeln."
                            }
                        },
                        {
                            "text": "Natural <w>swart</w> was commonly extracted from specific minerals to produce deep pigments.",
                            "target_lang_translations": {
                                "de": "Natürliches <w>Dunkelfärbemittel</w> wurde gewöhnlich aus bestimmten Mineralien gewonnen, um tiefe Pigmente herzustellen."
                            }
