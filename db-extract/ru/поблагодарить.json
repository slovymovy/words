                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "поблагодари́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ce7342e-79a1-318e-a708-b6196c4f94d0",
                        "entry_id": "77db8618-6781-35c5-b602-6c1092d010c1",
                        "glosses": [
                            "выразить благодарность, признательность словами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4accb2d3-c127-48ba-beda-3380c2fa8d98",
                                "sense_id": "5ce7342e-79a1-318e-a708-b6196c4f94d0",
                                "text": "Поблагодарить за гостеприимство."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbcd72d2-96a8-4e70-9f68-a44cc8d9ff42",
                        "source_entry_id": "77db8618-6781-35c5-b602-6c1092d010c1",
                        "source_sense_id": "5ce7342e-79a1-318e-a708-b6196c4f94d0",
                        "target_lang_word": "thank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1773016-987f-3479-a313-d9e82d98d9e5",
                                        "entry_id": "d784e108-b242-3de1-98ff-f2723547acca",
                                        "glosses": [
                                            "singular of thanks (“an expression of appreciation or gratitude; grateful feelings or thoughts; favour, goodwill, graciousness”)"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "obsolete",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2732ea36-b204-40c7-b253-a2867dd9d61a",
                                                "sense_id": "e1773016-987f-3479-a313-d9e82d98d9e5",
                                                "text": "If ye do good to them which do good to you, what thank have ye? for sinners also do even the same."
                                            },
                                            {
                                                "example_id": "ca2ae3f5-5b7c-432d-8ffc-fcf34c876cf4",
                                                "sense_id": "e1773016-987f-3479-a313-d9e82d98d9e5",
                                                "text": "What great thank, then, if any man, reputed wise and constant, will neither do, nor permit others under his charge to do, that which he approves not, especially in matter of sin?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                        "entry_id": "f92f18af-4cda-3bd6-90ae-42fe7b761edc",
                                        "glosses": [
                                            "To express appreciation or gratitude toward (someone or something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a5d9230-ec69-4d5c-a445-81d607b2e273",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "She thanked him for the lift."
                                            },
                                            {
                                                "example_id": "341100a4-407a-4c65-a913-43fbf3f13f41",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "[H]aſt thou no ſhame to deſpiſe that perſone, to whom onely and no man els, thou art bounde to thanke, euen for this veraie pointe, that thou ſetteſt ſo moche by thy peinted ſheathe?"
                                            },
                                            {
                                                "example_id": "89dc4872-4ae4-4e8e-b081-13fa02c7c13c",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "I can eate no meate, I thanke you."
                                            },
                                            {
                                                "example_id": "08868077-34f8-4744-b792-b9d19f0b0dca",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "The naked Negro, panting at the line, / Baſks in the glare, or ſtems the tepid vvave, / And thanks his Gods for all the good they gave."
                                            },
                                            {
                                                "example_id": "d214e075-beb6-4ffe-8a97-ecb62923d583",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "[S]ae laigh I need na bovv, / For, Lord be thankit, I can plough; / And vvhen I dovvna yoke a naig, / Then, Lord be thankit, I can beg; […]"
                                            },
                                            {
                                                "example_id": "83364902-bcff-4271-8f46-957ec531851f",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "That his Majesty has good subjects in England, my Lord Duke, he is bound to thank God and the laws—that he has subjects in Scotland, I think he may thank God and the sword."
                                            },
                                            {
                                                "example_id": "92d91195-4c1a-4629-857d-8a88bfe190b6",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "She had at once the air of good fellowship and the dignity of a woman, and she seemed to understand Farrar and me perfectly. […] By the time we reached the house we were thanking our stars she had come."
                                            },
                                            {
                                                "example_id": "673e8908-ef9b-4192-9563-8f07993aedcf",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "The Scarecrow and the Tin Woodman and the Lion now thanked the Good Witch earnestly for her kindness, […]"
                                            },
                                            {
                                                "example_id": "01d23a24-89d5-4d3b-b1da-18ecadd2e01e",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "I told him about everything I could think of; and what I couldn't think of he did. He asked about six questions during my yarn, but every question had a point to it. At the end he bowed and thanked me once more. As a thanker he was main-truck high; I never see anybody so polite."
                                            },
                                            {
                                                "example_id": "a5a3bc7b-d9ee-4233-92c6-e1c42867bea9",
                                                "sense_id": "153e2124-ef80-397a-8337-9b137286c11b",
                                                "text": "We were able to transport goods and critical workers all the way through the pandemic, and at the time we had the Prime Minister thanking everyone for what was achieved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8509bb50-eb80-3ac4-a64f-ad4e7d53874b",
                                        "entry_id": "f92f18af-4cda-3bd6-90ae-42fe7b761edc",
                                        "glosses": [
                                            "In the future tense in the form one will thank someone to do something, chiefly expressing a command or criticism: to request that (someone) do something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "363959c2-961e-4a8e-995e-3caae436c1f5",
                                                "sense_id": "8509bb50-eb80-3ac4-a64f-ad4e7d53874b",
                                                "text": "I’ll thank you not to smoke in my house!"
                                            },
                                            {
                                                "example_id": "7ddb28c7-4d02-46ac-9864-1ffef497d5d9",
                                                "sense_id": "8509bb50-eb80-3ac4-a64f-ad4e7d53874b",
                                                "text": "Our readers would not thank us for going into the badgerings which had for some time annoyed the chancellor on the subject of arrears in his court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b28e3de-a5a4-35d8-b0ee-3adf324f38f9",
                                        "entry_id": "f92f18af-4cda-3bd6-90ae-42fe7b761edc",
                                        "glosses": [
                                            "To express appreciation or gratitude for (something)."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40b71022-2fe9-3330-b967-ebcdc8cadcb4",
                                        "entry_id": "f92f18af-4cda-3bd6-90ae-42fe7b761edc",
                                        "glosses": [
                                            "To respond to (someone) out of, or as if out of, appreciation or gratitude."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bbc43ce-6b12-45c4-8fc1-fcd8486d6ce5",
                                                "sense_id": "40b71022-2fe9-3330-b967-ebcdc8cadcb4",
                                                "text": "I should summon my lord from the Queen's royal presence to do your business, should I?—I were like to be thanked with a horse-whip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0216bc88-bc70-3929-b381-b02ed5342d15",
                                        "entry_id": "f92f18af-4cda-3bd6-90ae-42fe7b761edc",
                                        "glosses": [
                                            "Chiefly followed by for: to credit or hold (someone or something) responsible, especially for something negative; to blame."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d83438c-5d9e-459a-b946-7abf50345875",
                                                "sense_id": "0216bc88-bc70-3929-b381-b02ed5342d15",
                                                "text": "We can thank global warming for this freak weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e45e137-cbd2-3210-b5ae-0552be118bf8",
                                        "entry_id": "f92f18af-4cda-3bd6-90ae-42fe7b761edc",
                                        "glosses": [
                                            "To express gratitude."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
