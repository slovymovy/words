                        "glosses": [
                            "organisatie die een collectie van voorwerpen en documentatie over de werking en de geschiedenis van vaartuigen beheert en tentoonstelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d99218bd-851c-44ad-bfd5-a035bce85cde",
                                "sense_id": "5759e47c-81e3-3aee-999b-1c0e9c82d2a8",
                                "text": "Nu naar Floris Hin in Amsterdam. Scheepstuiger, schieman, assistent-zeilmaker, staaldraadsplitser en ad hoc-adviseur van scheepvaartmusea. Zeker, zegt, Hin, de zeilen waren van hennep. En de gebruikte textielbinding was platbinding, niet keperbinding."
                            },
                            {
                                "example_id": "8cf1d9aa-e96d-4a18-bd52-109ba3cd2fb8",
                                "sense_id": "5759e47c-81e3-3aee-999b-1c0e9c82d2a8",
                                "text": "Door enkele duikteamleden worden diverse boeken met gegevens van schepen en foto’s aangeschaft en wordt er informatie uit archieven van diverse scheepvaartmuseums geraadpleegd."
                            }
                        ]
                    },
