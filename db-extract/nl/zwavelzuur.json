        "nl-extract.jsonl": [
            {
                "entry_id": "fcb5c6a7-3247-3bc5-a241-45d04d52d0fc",
                "word": "zwavelzuur",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "31218ea8-6ac6-424b-82bc-65b236fd9d75",
                        "entry_id": "fcb5c6a7-3247-3bc5-a241-45d04d52d0fc",
                        "tags": [
                            "plural"
