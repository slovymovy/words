                                        "entry_id": "e112bb63-6f37-3488-b9d7-ea9746ee49c1",
                                        "glosses": [
                                            "To write something hastily or illegibly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1b59efb-136b-4d07-9608-7e4dbe39a93f",
                                                "sense_id": "e3e173cf-bcc5-3444-b431-c4d3ed549f45",
