                "senses": [
                    {
                        "sense_id": "7e08d3cb-70f7-39b8-a5d9-8fe5bab7578f",
                        "entry_id": "e2dc6187-7ed6-3a3c-a506-3d0573e899b4",
                        "glosses": [
                            "рег. устар. нечто, кое-что, что-то"
                        ],
                        "tags": [
                            "в знач. местоимения"
                        ],
                        "examples": [
                            {
                                "example_id": "a25989e0-dbb0-4317-a9ae-6e7162d47c67",
                                "sense_id": "7e08d3cb-70f7-39b8-a5d9-8fe5bab7578f",
                                "text": "Как скажу я тебе нещечко, так пожить на свете слюбится."
                            }
                        ]
                    },
                    {
                        "sense_id": "636859f0-cbeb-3e2c-ba5d-2d567715c355",
                        "entry_id": "e2dc6187-7ed6-3a3c-a506-3d0573e899b4",
                        "glosses": [
                            "устар., фам. дорогой предмет, сокровище, любимое существо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e437d31b-ba0c-4f24-a596-ee9128780e55",
                                "sense_id": "636859f0-cbeb-3e2c-ba5d-2d567715c355",
                                "text": "Она посвятила всю себя воспитанию своего нещечка, мальчика Коли."
                            },
                            {
                                "example_id": "90410d34-3104-43a9-8383-5eb2b192e47a",
                                "sense_id": "636859f0-cbeb-3e2c-ba5d-2d567715c355",
                                "text": "⟨…⟩ военные-то барыни ведь так уж и родятся, у них и стыда на то нет; а тебе, сударыня, такому нещечку, такой неженке, где ж вести жизнь солдатскую, в лагерях?"
                            }
                        ]
                    }
