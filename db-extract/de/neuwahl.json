                ],
                "senses": [
                    {
                        "sense_id": "cf339ce6-ec6f-3b51-8afa-1619f78c1088",
                        "entry_id": "777be858-7ba1-3e3c-a0de-6ce2267d0d09",
                        "glosses": [
                            "Vorgang, bei dem jemand/etwas erneut gewählt wird"
                        ],
                        "tags": [
                            "meist Politik"
                        ],
                        "examples": [
                            {
                                "example_id": "8483a11f-b1d7-4533-9b36-2d1dd7b9ee95",
                                "sense_id": "cf339ce6-ec6f-3b51-8afa-1619f78c1088",
                                "text": "„Die Zeit der Massendemos ist zweifellos vorbei, und die Demonstranten müssen sich neu orientieren, nachdem ihre Forderung nach einer Neuwahl des Parlaments unerfüllt geblieben ist.“"
                            },
                            {
                                "example_id": "ad0b3cc0-9401-4e6e-868a-26399f65a09d",
                                "sense_id": "cf339ce6-ec6f-3b51-8afa-1619f78c1088",
                                "text": "„In dieser Zeit fanden zwei weitere Regierungswechsel statt, nicht infolge von Neuwahlen, sondern durch Koalitionswechsel.“"
                            },
                            {
                                "example_id": "268ab6f2-4b1b-444c-8af4-318f72f5ae29",
                                "sense_id": "cf339ce6-ec6f-3b51-8afa-1619f78c1088",
                                "text": "„Und in der Tatsache, dass nach Neuwahlen, wenn sich das Parlament neu konstituiert, der älteste Parlamentarier die erste Sitzung leitet, in der dann der Bundestagspräsident gewählt wird, der nicht mehr der Älteste sein muss und meist auch nicht ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
