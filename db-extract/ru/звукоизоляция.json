                                        "sense_id": "635ddd92-4e66-31dd-8c98-4e7609d75c55",
                                        "entry_id": "667f59ed-7d96-3157-a7ca-5bc52e4f7654",
                                        "glosses": [
                                            "Gesamtheit aller vorbeugenden Sicherheitsmaßnahmen, die das Übertragen von Lärm (= subjektiv störender Schall) verhindern oder dessen Auswirkungen begrenzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f04b88-e369-4352-8053-43f6e521d32f",
                                                "sense_id": "635ddd92-4e66-31dd-8c98-4e7609d75c55",
                                                "text": "„Wichtige neue Instrumente des Lärmschutzes in Deutschland sind die strategische Lärmkartierung und die Lärmaktionsplanung.“"
                                            }
