                                "target_senses": [
                                    {
                                        "sense_id": "236a3e01-dd9d-38ef-b2d7-4ff5a0a7cc57",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Manière d’être assis, sis ou placé, assise."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36b60267-6655-4676-a0f6-f089ea02ea0f",
                                                "sense_id": "236a3e01-dd9d-38ef-b2d7-4ff5a0a7cc57",
                                                "text": "Ce malade ne peut trouver une bonne assiette."
                                            },
                                            {
                                                "example_id": "387caa7c-99a2-4cab-960e-8ca3c5b061b2",
                                                "sense_id": "236a3e01-dd9d-38ef-b2d7-4ff5a0a7cc57",
                                                "text": "C’est un homme inquiet qui ne peut se tenir dans la même assiette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90d9022-3a5b-3c8c-89dd-834d9e8268cc",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Situation du cavalier sur la selle."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66d88304-eb9c-432e-b434-1501ae5ddc34",
                                                "sense_id": "c90d9022-3a5b-3c8c-89dd-834d9e8268cc",
                                                "text": "Cet écuyer fait prendre une bonne assiette à ses élèves."
                                            },
                                            {
                                                "example_id": "91ef8d99-91de-4914-82fe-32c0cbf38505",
                                                "sense_id": "c90d9022-3a5b-3c8c-89dd-834d9e8268cc",
                                                "text": "Perdre son assiette."
                                            },
                                            {
                                                "example_id": "c08d0314-5d44-48a2-94d7-2ff7cfe96481",
                                                "sense_id": "c90d9022-3a5b-3c8c-89dd-834d9e8268cc",
                                                "text": "Manquer d’assiette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b25f92-ef48-3b43-bb83-f68314a41467",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Situation d’un corps posé sur un autre, en sorte qu’il soit ferme et stable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e35d6c-0e76-4916-b68d-47530eedca11",
                                                "sense_id": "60b25f92-ef48-3b43-bb83-f68314a41467",
                                                "text": "L’assiette d’une pierre, d’une poutre."
                                            },
                                            {
                                                "example_id": "739fa7f4-9f4b-4267-9094-adcd89e03da4",
                                                "sense_id": "60b25f92-ef48-3b43-bb83-f68314a41467",
                                                "text": "Cela n’est point dans son assiette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "797bc0cd-115f-30aa-b74d-f0d698fe1de0",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Situation d’une maison, d’une ville, d’une forteresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46750a6f-04e9-4526-8718-9edaf6d7d254",
                                                "sense_id": "797bc0cd-115f-30aa-b74d-f0d698fe1de0",
                                                "text": "L’assiette de cette place est avantageuse."
                                            },
                                            {
                                                "example_id": "63c225be-6458-453c-9d6b-0232394ef1d1",
                                                "sense_id": "797bc0cd-115f-30aa-b74d-f0d698fe1de0",
                                                "text": "Il faut bien choisir l’assiette d’un camp par rapport au choix du terrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd06233d-4051-308e-9de9-7f1e6b6d0aca",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Emprise au sol d’un fonds, d’une servitude."
                                        ],
                                        "tags": [
                                            "Droit de propriété"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb0c5e67-5d5a-4a6e-b124-377d8728d1d7",
                                                "sense_id": "dd06233d-4051-308e-9de9-7f1e6b6d0aca",
                                                "text": "[…] le propriétaire du fonds servant ne peut rien faire qui tende à diminuer l'usage de la servitude ou à le rendre plus incommode et le propriétaire du fonds dominant ne peut en user que suivant son titre, sans rien faire qui aggrave la servitude, ce qui interdit au propriétaire du fonds servant sur lequel pèse, selon le titre constitutif de la servitude de passage, la charge des frais d'aménagement, de rendre onéreux l'usage de l'assiette de la servitude de passage, commun depuis la constitution de la servitude […]."
                                            },
                                            {
                                                "example_id": "2572a12e-2c28-443b-bfba-98814d15b8a6",
                                                "sense_id": "dd06233d-4051-308e-9de9-7f1e6b6d0aca",
                                                "text": "Toutefois, en cas d'écart manifeste entre le nombre de tiges annoncé dans les clauses de la vente et celui trouvé sur le terrain d'assiette de la coupe, une indemnisation peut être sollicitée par l’acheteur afin de réparer le trouble résultant de ce déficit sans que ce dernier puisse prétendre à la compensation exacte, en argent, du volume manquant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "941584cc-1a9b-3af8-a915-eb4c557a84b0",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "État, disposition de l’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49bb3f3b-ab4a-4ccc-8b4c-dc076d0a8349",
                                                "sense_id": "941584cc-1a9b-3af8-a915-eb4c557a84b0",
                                                "text": "Il n’a pas l’esprit dans une bonne assiette."
                                            },
                                            {
                                                "example_id": "1852551f-815d-4d86-9877-2410742d9660",
                                                "sense_id": "941584cc-1a9b-3af8-a915-eb4c557a84b0",
                                                "text": "Il est fort inconstant, il n’a jamais l’esprit dans une assiette ferme."
                                            },
                                            {
                                                "example_id": "888e2c97-a060-47c8-9ace-a245e7900a63",
                                                "sense_id": "941584cc-1a9b-3af8-a915-eb4c557a84b0",
                                                "text": "Il n’est pas dans son assiette aujourd'hui."
                                            },
                                            {
                                                "example_id": "876b83f7-bf4e-45e7-84b9-5f948e2a5fdd",
                                                "sense_id": "941584cc-1a9b-3af8-a915-eb4c557a84b0",
                                                "text": "Le premier précepteur. – Sapientissime doctor, comment se porte Votre Seigneurie ? Le trésor de votre précieuse santé est-il dans une assiette régulière, et votre équilibre se maintient-il convenable par ces tempêtes où nous voilà ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c40a6d4d-c8a3-306f-a15d-fbd084a70268",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Situation sociale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31022e49-16ba-41fd-9af3-d13c46a1d500",
                                                "sense_id": "c40a6d4d-c8a3-306f-a15d-fbd084a70268",
                                                "text": "Il me témoignait cette sorte de bienveillance que les gens d’une certaine assiette réservent à des individus estimables, mais un peu lunaires ou déclassés et qu’ils se gardent de prendre trop au sérieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ada6c45f-399c-3b3c-afa1-4848d9fde66b",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Fonds sur lequel une rente est assise, est assignée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98fc8ce1-bc79-32d9-9362-4518d783c6b6",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Répartition des impôts, des contributions."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ece27e89-4e1f-4a53-b60f-f585a170c2a4",
                                                "sense_id": "98fc8ce1-bc79-32d9-9362-4518d783c6b6",
                                                "text": "Le déficit de notre régime de santé - bien que préoccupant, mais lié, en réalité, au niveau de l'emploi et au périmètre de l'assiette de perception des cotisations - va s'avérer être peu de chose, comparé à la contribution du trésor américain au sauvetage, en catastrophe, des compagnies d'assurances privées."
                                            },
                                            {
                                                "example_id": "11b999d1-b65d-4af7-9936-e822a0934701",
                                                "sense_id": "98fc8ce1-bc79-32d9-9362-4518d783c6b6",
                                                "text": "Depuis que l’administration des impôts a fusionné avec le Trésor public, le métier n’est plus le même car il est désormais demandé de faire l’assiette et le recouvrement."
                                            },
                                            {
                                                "example_id": "129de590-fb56-4e4e-9db4-93795e0ddccd",
                                                "sense_id": "98fc8ce1-bc79-32d9-9362-4518d783c6b6",
                                                "text": "Que proposait la CAQ ? Le rapatriement de points d’impôt. C’est-à-dire « une libération accrue du champ fiscal occupé par le gouvernement fédéral ». Les Québécois enverraient tout simplement moins d’argent au fédéral, qui libérerait l’assiette fiscale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a839da16-bc5e-3e48-8762-555c476e564c",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Élément de vaisselle à fond plat sur laquelle chacun prend ou reçoit les mets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "687afc90-6f5a-4ea9-8a5c-abcd6e52ed5b",
                                                "sense_id": "a839da16-bc5e-3e48-8762-555c476e564c",
                                                "text": "Sur une table en laque de Chine se trouvait une assiette d'or pleine de fruits délicieux."
                                            },
                                            {
                                                "example_id": "1c5a4304-55d1-49af-ae4b-1d7b68d3b44c",
                                                "sense_id": "a839da16-bc5e-3e48-8762-555c476e564c",
                                                "text": "Après leur soupe, ils vidèrent un verre de vin dans leur assiette et firent chabrot, levant la lourde faïence brune jusqu'à leurs lèvres qu'ils essuyèrent ensuite d'un rapide coup de poignet."
                                            },
                                            {
                                                "example_id": "b44aeb1d-e0bb-44e4-b893-1f63d6ec0594",
                                                "sense_id": "a839da16-bc5e-3e48-8762-555c476e564c",
                                                "text": "Elle a une assiette à la main, couverte de petits choux à la crème roses et violets, avec des billes de sucre en argent pour les décorer."
                                            },
                                            {
                                                "example_id": "ac112ebd-e75e-44d4-9d47-8209711968cd",
                                                "sense_id": "a839da16-bc5e-3e48-8762-555c476e564c",
                                                "text": "Déposez un peu de poireau et de tomate dans une assiette profonde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4522b42d-6490-3479-bbe9-f0dcfcd46789",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Assiettée ; contenu d’une assiette."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fdbf2c6-301d-41dd-8598-eec75e50c292",
                                                "sense_id": "4522b42d-6490-3479-bbe9-f0dcfcd46789",
                                                "text": "En début de soirée, il commanda une assiette de pastels à une marchande assise à même la rue. Elle faisait frire ces petits beignets de poisson dans un chaudron d'huile bouillante et les servait dans une coupelle en plastique bleue et rouge."
                                            },
                                            {
                                                "example_id": "70680719-00db-49b8-a431-2cd66eb66067",
                                                "sense_id": "4522b42d-6490-3479-bbe9-f0dcfcd46789",
                                                "text": "Même dans les zones reculées de l’Arctique ou de la forêt amazonienne, présumées vierges, on trouve des traces de plastique, de phtalates, de divers composés toxiques et persistants. Bien souvent, ces substances se fixent dans la chaîne alimentaire et remontent, d’une manière ou d’une autre, jusqu’à nos assiettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4683ef17-3263-3ee9-9265-804528aafa18",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Angle que fait l'axe longitudinal d'un aéronef avec le plan horizontal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69744fec-f6d2-33f5-b49c-2db5dd03c02d",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Angle que fait l'axe longitudinal d'un bâtiment avec le plan horizontal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37e1729a-d5f2-3129-9804-b2939fc97259",
                                        "entry_id": "81211dc1-e6a0-3900-933f-d91e5ebc9d0b",
                                        "glosses": [
                                            "Matériaux utilisés par les doreurs comme sous couche avant la pose de la feuille d'or."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "270317a3-0e02-4378-b010-e439b3ddbfb1",
                                                "sense_id": "37e1729a-d5f2-3129-9804-b2939fc97259",
                                                "text": "Bol d'Arménie, bolus ou assiette à dorer. Ces trois dénominations, employées au gré des utilisateurs, désignent une sorte de pâte brunâtre qui est appliquée au pinceau sur le lekvas pour servir de support adhésif à la feuille d'or libre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "519b54e4-edd5-4c67-a5e2-c75d485c1df9",
                        "source_entry_id": "c12f834e-ae4a-3592-a7c1-140b85b5212b",
                        "source_sense_id": "2a4ffdd7-9b8c-3651-aa61-a5e4c13f45aa",
                        "source_sense_description": "the quantity contained on a plate",
                        "target_lang_word": "assiettée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assiettée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5cf4717-3555-3f9a-97ba-106d2108b092",
                                        "entry_id": "f497dbe0-c22b-3b6d-9e91-413c0e2c4fc4",
                                        "glosses": [
                                            "Contenu d’une assiette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731a82a1-652b-4b39-93b4-08914d518e2b",
                                                "sense_id": "b5cf4717-3555-3f9a-97ba-106d2108b092",
                                                "text": "Si j’avais osé, comme j’aurais demandé une assiettée de soupe, mais Vitalis ne m’avait pas appris à tendre la main, et la nature ne m’avait pas créé mendiant ; je serais plutôt mort de faim que de dire « j’ai faim ». Pourquoi, je n’en sais trop rien ? si ce n’est parce que je n’ai jamais voulu demander que ce que je pouvais rendre."
                                            },
                                            {
                                                "example_id": "76352cbd-a658-4cb8-8f86-78abdab410b6",
                                                "sense_id": "b5cf4717-3555-3f9a-97ba-106d2108b092",
                                                "text": "nᵒ 3 - Après cette période, s'alimenter pendant une semaine à peu près de la manière suivante :\na - le matin : une assiettée de potage Julienne ou un fruit avec une tasse de café ou de thé peu sucré."
                                            },
                                            {
                                                "example_id": "ca628ee7-b2cb-477d-8aa2-830463a5bd6d",
                                                "sense_id": "b5cf4717-3555-3f9a-97ba-106d2108b092",
                                                "text": "Elle lui servait deux grosses assiettées de soupe et encore, elle lui disait d’y casser du pain."
                                            },
                                            {
                                                "example_id": "a6b6d59e-1605-4eb6-a07c-92eebdfa864c",
                                                "sense_id": "b5cf4717-3555-3f9a-97ba-106d2108b092",
                                                "text": "– Même depuis ce temps déjà lointain, il lui est arrivé parfois, bien rarement, il est vrai, de s’adoucir, de rajeunir, comme au cours de ces randonnées à bicyclette dans la forêt de Fontainebleau, ou quand tu la faisais rire en dévorant à côté d’elle d’énormes assiettées de pâtes, ou quand elle recouvrait, excitée, amusée, tes cahiers et tes livres… enfin il y a eu des moments…"
                                            },
                                            {
                                                "example_id": "cb4a41f8-5f41-4c27-8b0f-f55df1522a1f",
                                                "sense_id": "b5cf4717-3555-3f9a-97ba-106d2108b092",
                                                "text": "Madame de… s’incline pour prendre une assiettée de sandwichs au foie gras et l’offrir à Monsieur de C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac5d8f62-106f-469c-8314-614d70a79c52",
                        "source_entry_id": "c12f834e-ae4a-3592-a7c1-140b85b5212b",
                        "source_sense_id": "2a4ffdd7-9b8c-3651-aa61-a5e4c13f45aa",
                        "source_sense_description": "the quantity contained on a plate",
                        "target_lang_word": "platée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "platée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7e352e3-dc80-3db0-8962-1381e106fcdb",
                                        "entry_id": "49020548-e0d4-34c3-a319-2615b5371296",
                                        "glosses": [
                                            "Contenu d’un plat servi abondamment."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c634dec4-610c-49e2-8ffb-947e00194a35",
                                                "sense_id": "d7e352e3-dc80-3db0-8962-1381e106fcdb",
                                                "text": "Il avalait les platées les moins ragoûtantes, d’un air de gourmandise."
                                            },
                                            {
                                                "example_id": "787e423b-1419-46d0-9b7e-2cd1d4ea7f89",
                                                "sense_id": "d7e352e3-dc80-3db0-8962-1381e106fcdb",
                                                "text": "Depuis quatre heures qu’il mangeait, plus de cent étaient venus s’asseoir autour de lui, histoire de prendre une queue d’ablette et de lui offrir le reste de la platée."
                                            },
                                            {
                                                "example_id": "d6ecb1f2-e579-43b8-aa02-30cf9de8fced",
                                                "sense_id": "d7e352e3-dc80-3db0-8962-1381e106fcdb",
                                                "text": "L’habitude, prise dès le séminaire, de recevoir des supérieurs, ainsi qu’une aumône, le pain quotidien ou la platée de haricots fait de nous, jusqu’à la mort, des écoliers, des enfants."
                                            },
                                            {
                                                "example_id": "c0fc8bd6-3bf5-441b-ba7e-801e4f9ac36f",
                                                "sense_id": "d7e352e3-dc80-3db0-8962-1381e106fcdb",
                                                "text": "Strépoukhoff lui apporta une platée de gruau et de choux."
                                            },
                                            {
                                                "example_id": "c73d03d1-f1bc-4820-b4d6-83cdd46969ba",
                                                "sense_id": "d7e352e3-dc80-3db0-8962-1381e106fcdb",
                                                "text": "Une platée de pommes de terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1312cc0-72d6-3dae-9b0e-be8d850aa0ca",
                                        "entry_id": "49020548-e0d4-34c3-a319-2615b5371296",
                                        "glosses": [
                                            "Massif de fondation, qui comprend toute l’étendue du bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be5c5af0-7313-47a8-ad65-92ad0a84e3ac",
                                                "sense_id": "b1312cc0-72d6-3dae-9b0e-be8d850aa0ca",
                                                "text": "Tracer le plan d’un édifice sur la platée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
