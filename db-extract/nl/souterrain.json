                                                "sense_id": "fd9d1109-e884-31a9-b70c-d8da9001c288",
                                                "text": "The farmhouse has several additions, added over many decades; it has three cellars, and one of them is older than the other two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2672145e-b72a-3614-b39a-81002768e80f",
                                        "entry_id": "a9e93ab0-4edb-3a77-becf-cc26d3100fcf",
                                        "glosses": [
                                            "A wine collection, especially when stored in a cellar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09a5ea1b-060e-47d8-94e1-1d42ff25ce7f",
                                                "sense_id": "2672145e-b72a-3614-b39a-81002768e80f",
                                                "text": "The insurance company valued his cellar at $27,000, largely on the strength of his bottles of 1972 Château Hypothetica."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4707eda-c5ff-35d4-8c2f-2ff1da9106a5",
                                        "entry_id": "a9e93ab0-4edb-3a77-becf-cc26d3100fcf",
                                        "glosses": [
                                            "Last place in a league or competition; some rank near last place."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
