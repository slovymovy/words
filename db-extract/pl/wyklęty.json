                ],
                "senses": [
                    {
                        "sense_id": "1a36b36f-5c1b-3e32-ac3b-73f3a27172f6",
                        "entry_id": "bb3c7761-9a34-31b2-88bf-792b47335885",
                        "glosses": [
                            "ten, kogo wyklęto, na kogo rzucono klątwę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b328a6c8-cbba-4e74-8eee-c8e86caad038",
                                "sense_id": "1a36b36f-5c1b-3e32-ac3b-73f3a27172f6",
                                "text": "Tę klątwę rozkazano od Biskupa, powtórzyć w całéj diocezij w niedziele i święta z ambon przed ludem, przy biciu dzwonów, zapaleniu i gaszeniu świec rzucanych o ziemię, na znak nieposłuszeństwa wyklętego i przekleństwa wiecznego na niego"
                            },
                            {
                                "example_id": "84e6ffad-eb60-40ea-8090-4ec9cbc74cd1",
                                "sense_id": "1a36b36f-5c1b-3e32-ac3b-73f3a27172f6",
                                "text": "Więc też Grzegorz IX ogłasza krucjatę [przeciw Prusom]. Nawet zbrodniarze, nawet wyklęci, podpalacze mają zupełny odpust, jeżeli krzyż wezmą i ruszą na pogan"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
