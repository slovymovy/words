{
    "word_family": [
        "déroute",
        "déroutant",
        "déroutement",
        "route",
        "routier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f06d6861-b327-3620-8509-a6863b477457",
                    "sense_definition": "Déconcerter ou déstabiliser quelqu'un dans ses prévisions ou son comportement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa réponse inattendue a complètement <w>dérouté</w> les journalistes présents dans la salle."
                        },
                        {
                            "text": "Ce changement soudain de stratégie a réussi à <w>dérouter</w> l'adversaire pendant la négociation."
                        }
                    ],
                    "synonyms": [
                        "déconcerter"
                    ],
                    "common_phrases": [
                        "dérouter l'adversaire",
                        "dérouter le public"
                    ]
                },
                {
                    "sense_id": "0782248b-f3a9-3ce5-ab0c-c3cd25ad86bc",
                    "sense_definition": "Modifier l'itinéraire initial d'un moyen de transport, comme un avion ou un navire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison d'une violente tempête, la compagnie a dû <w>dérouter</w> un vol vers un autre aéroport."
                        },
                        {
                            "text": "Le commandant a décidé de <w>dérouter</w> le navire pour porter secours aux marins en détresse."
                        }
                    ],
                    "common_phrases": [
                        "dérouter un vol",
                        "dérouter un avion",
                        "dérouter un navire"
                    ]
                },
                {
                    "sense_id": "29ccc403-a89e-35dc-8c37-15773160dd76",
                    "sense_definition": "Égarer quelqu'un, lui faire perdre sa route ou la piste qu'il suivait.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect a emprunté une ruelle sombre pour <w>dérouter</w> les poursuivants lancés à ses trousses."
                        },
                        {
                            "text": "Le cerf a traversé la rivière gelée pour <w>dérouter</w> les chiens qui pistaient son odeur."
                        }
                    ],
                    "synonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "dérouter les poursuivants",
                        "dérouter les chiens"
                    ]
                },
                {
                    "sense_id": "9d4e7d0d-e9b6-38ca-b86e-456e3d048a8a",
                    "sense_definition": "Faire échouer des prévisions, des projets ou déjouer des recherches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "entrave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fugitif a changé plusieurs fois d'identité afin de <w>dérouter</w> les recherches des enquêteurs."
                        },
                        {
                            "text": "Ces événements imprévus sont venus <w>dérouter</w> les projets ambitieux de la jeune équipe."
                        }
                    ],
                    "common_phrases": [
                        "dérouter les projets",
                        "dérouter les recherches"
                    ]
                }
            ]
        }
    ]
}