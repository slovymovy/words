                        {
                            "text": "Ce vieux <w>papi</w> a du mal à porter ses sacs de courses.",
                            "target_lang_translations": {
                                "en": "This <w>old man</w> has trouble carrying his shopping bags.",
                                "ru": "Этому пожилому <w>старику</w> трудно нести свои сумки с покупками.",
                                "nl": "Deze <w>oude man</w> heeft moeite met het dragen van zijn boodschappentassen.",
                                "de": "Dieser <w>alte Mann</w> hat Mühe, seine Einkaufstaschen zu tragen.",
                                "pl": "Ten <w>staruszek</w> z trudem dźwiga swoje torby z zakupami.",
                                "it": "Questo <w>vecchietto</w> fatica a portare le sue borse della spesa.",
                                "cs": "Tenhle <w>stařeček</w> má potíže unést své nákupní tašky.",
                                "tr": "Bu <w>ihtiyar</w> alışveriş torbalarını taşımakta zorlanıyor.",
                                "es": "A este <w>anciano</w> le cuesta trabajo llevar sus bolsas de la compra.",
                                "zh": "这个<w>老头</w>拎购物袋很吃力。"
                            }
                        },
                        {
                            "text": "Un gentil <w>papi</w> s'est assis sur le banc pour lire le journal.",
                            "target_lang_translations": {
                                "en": "A kind <w>old man</w> sat down on the bench to read the newspaper.",
                                "ru": "Какой-то добрый <w>старик</w> присел на скамейку, чтобы почитать газету.",
                                "nl": "Een aardige <w>oude man</w> ging op de bank zitten om de krant te lezen.",
                                "de": "Ein freundlicher <w>alter Mann</w> setzte sich auf eine Parkbank, um die Zeitung zu lesen.",
                                "pl": "Jakiś miły <w>staruszek</w> usiadł na ławce, żeby poczytać gazetę.",
                                "it": "Un gentile <w>vecchietto</w> si è seduto sulla panchina per leggere il giornale.",
                                "cs": "Jakýsi hodný <w>stařeček</w> si sedl na lavičku, aby si přečetl noviny.",
                                "tr": "Nazik bir <w>ihtiyar</w> gazete okumak için bankta oturdu.",
                                "es": "Un <w>anciano</w> amable se sentó en el banco para leer el periódico.",
                                "zh": "一位和蔼的<w>老大爷</w>在长椅上坐下来看报。"
                            }
                        }
