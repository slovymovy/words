            "senses": [
                {
                    "sense_id": "3f447a1c-27fb-3872-985f-430db577218c",
                    "sense_definition": "Groupe principal et le plus compact de coureurs dans une épreuve sportive, en particulier une course cycliste.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cycliste a accéléré pour distancer le <w>peloton</w> dans la dernière montée."
                        },
                        {
                            "text": "Le coureur échappé a finalement été rattrapé par le gros du <w>peloton</w> à dix kilomètres de l'arrivée."
                        }
                    ],
                    "common_phrases": [
                        "gros du peloton",
                        "tête du peloton",
                        "en tête de peloton"
                    ]
                },
                {
                    "sense_id": "e3105420-9d93-32cc-a7be-7992881f140c",
                    "sense_definition": "Petite unité militaire commandée par un officier subalterne ou un sous-officier.",
