                                    {
                                        "sense_id": "8d1c5908-6162-38e2-8ea6-b6c2a44e5b6c",
                                        "entry_id": "f124993e-504c-3fad-9b9b-69ac5292420c",
                                        "glosses": [
                                            "mit Einsatz, mit Nachdruck betrieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "483d67a0-261a-4bae-985f-3985f481dfe9",
                                                "sense_id": "8d1c5908-6162-38e2-8ea6-b6c2a44e5b6c",
                                                "text": "Wir haben uns angelegentlich um die nötigen Informationen bemüht."
                                            },
                                            {
                                                "example_id": "b2e6c0f1-a712-4491-aeed-cd45943a00e4",
                                                "sense_id": "8d1c5908-6162-38e2-8ea6-b6c2a44e5b6c",
                                                "text": "Wir hatten die angelegentliche Bitte, dass ihr uns bei dem Problem aushelft."
                                            },
                                            {
                                                "example_id": "b9804e9b-4318-4f18-9b9a-13fee3496c99",
                                                "sense_id": "8d1c5908-6162-38e2-8ea6-b6c2a44e5b6c",
                                                "text": "„Zu recht umfangreichen Aufträgen halten wir uns angelegentlichst empfohlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "angelegentlich",
