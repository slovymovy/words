    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0d469f86-c48d-34ab-8f02-51051f8a1f4d",
                    "sense_definition": "Bande d'étoffe que l'on porte autour du cou ou sur les épaules pour se protéger du froid ou par parure.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En hiver, il met toujours une grosse <w>écharpe</w> en laine pour sortir."
                        },
                        {
                            "text": "Elle a noué une jolie <w>écharpe</w> colorée autour de son cou."
                        }
                    ],
                    "synonyms": [
                        "cache-col",
                        "cache-nez",
                        "foulard"
                    ],
                    "common_phrases": [
                        "écharpe en laine",
                        "mettre une écharpe",
                        "porter une écharpe"
                    ]
                },
                {
                    "sense_id": "db2a793b-6cb1-3eff-bb49-a5708e29c268",
                    "sense_definition": "Bande d'étoffe passée autour du cou pour soutenir et immobiliser un bras blessé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa mauvaise chute à vélo, il doit garder le bras en <w>écharpe</w>."
                        },
                        {
                            "text": "L'infirmière lui a posé une <w>écharpe</w> propre pour bien soutenir son coude fracturé."
                        }
                    ],
                    "common_phrases": [
                        "bras en écharpe",
                        "porter en écharpe"
                    ]
                },
                {
                    "sense_id": "40c730d3-7490-3e4e-a5ee-58ffb104a7ed",
                    "sense_definition": "Large bande d'étoffe portée en travers de la poitrine ou à la ceinture comme marque de fonction officielle ou de distinction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insigne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire porte fièrement son <w>écharpe</w> tricolore lors des cérémonies officielles de la commune."
                        },
                        {
                            "text": "Pour célébrer les mariages civils, l'adjointe au maire revêt son <w>écharpe</w> d'apparat."
                        }
                    ],
                    "common_phrases": [
                        "écharpe tricolore"
                    ]
                }
            ]
        },
        {
