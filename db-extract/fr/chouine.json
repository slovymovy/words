                "senses": [
                    {
                        "sense_id": "f6dbf05c-d5f6-325e-9026-3b0fa73fc3c6",
                        "entry_id": "00ad5b21-6f10-3177-ad14-18f89085e89a",
                        "glosses": [
                            "Jeu de cartes se jouant à deux joueurs et utilisant un jeu de 32 cartes, avec atout et prise d’une nouvelle carte à chaque levée."
                        ],
                        "tags": [
                            "Cartes à jouer"
                        ],
                        "examples": [
                            {
                                "example_id": "8dafae38-a173-49ac-ae94-4d38ca112069",
                                "sense_id": "f6dbf05c-d5f6-325e-9026-3b0fa73fc3c6",
                                "text": "Dans ce décor de bistrot d’avant-guerre, nous sommes entourées de duos de vieux Nantais jouant à la chouine, le jeu de cartes."
                            },
                            {
                                "example_id": "86d2d791-a22d-4137-8b1b-cef7d8f10467",
                                "sense_id": "f6dbf05c-d5f6-325e-9026-3b0fa73fc3c6",
                                "text": "Il jouait à « la chouine », une querelle venait d’éclater sur un dernier coup de cartes, entre lui et son compagnon, qui maintenait son gain d’un air de tranquille obstination."
                            },
                            {
                                "example_id": "e0e8c560-8435-4062-abe6-bfd6a1ab5d32",
                                "sense_id": "f6dbf05c-d5f6-325e-9026-3b0fa73fc3c6",
                                "text": "À l’auberge, elle avait toujours trouvé à s’occuper à la crapette ou à la chouine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
