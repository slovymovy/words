                    {
                        "sense_id": "04f3e643-3093-347d-93b2-c82ce2d0dd55",
                        "entry_id": "b794effd-50cb-3ed6-995b-31271f2fcc42",
                        "glosses": [
                            "kłopot, ambaras, zamęt, zmartwienie, problem"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d42e1258-88d6-48a8-871c-61c96533498f",
                                "sense_id": "04f3e643-3093-347d-93b2-c82ce2d0dd55",
                                "text": "Światło tak dalece się już rozszerzyło, że wybuch, nastąpi przy pierwszem lepszem wydarzeniu, a wówczas będzie to harmider i skweres nielada."
                            },
                            {
                                "example_id": "86c0eb80-31fd-4b3a-85b0-cc41974417c9",
                                "sense_id": "04f3e643-3093-347d-93b2-c82ce2d0dd55",
                                "text": "Tu pod tą gruszką drzemał Kościuszko, dopieroż robi się skweres, • a pod tą drugą Kołłątaj Hugo załatwiał mały interes."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
