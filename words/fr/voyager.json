                    "frequency": "Low",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vin délicat ne peut pas bien <w>voyager</w> s'il fait trop chaud."
                        },
                        {
                            "text": "Votre colis a beaucoup <w>voyagé</w> avant d'arriver finalement à destination ce matin."
