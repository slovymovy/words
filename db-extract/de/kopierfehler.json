                ],
                "senses": [
                    {
                        "sense_id": "177a685a-f5c5-3839-b749-738083d99aea",
                        "entry_id": "7953c4ab-5b95-30f0-92dd-326acfcb5b1f",
                        "glosses": [
                            "fehlerhafte Vervielfältigung eines Dokuments oder einer Datei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1847d5e0-dea1-45ad-b20c-1830a3104dd3",
                                "sense_id": "177a685a-f5c5-3839-b749-738083d99aea",
                                "text": "„Der Verdacht liegt nahe, dass in REA bei der Jahreszahl ein Kopierfehler unterlaufen ist. Die richtige Jahreszahl dürfte 1466 sein, wo der 12/6 auf einen Donnerstag fiel.“"
                            },
                            {
                                "example_id": "78b1dadd-5f1c-45a2-8d72-47ab211a44f7",
                                "sense_id": "177a685a-f5c5-3839-b749-738083d99aea",
                                "text": "„Nirgendwo findet sich sonst diese Eigenheit und es ist zu vermuten, das hier ein Kopierfehler unterlaufen ist, wobei der Diakon mit dem Chor verwechselt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "209c3ec0-b3b3-3be1-ae78-ddf3268081a6",
                        "entry_id": "7953c4ab-5b95-30f0-92dd-326acfcb5b1f",
                        "glosses": [
                            "fehlerhafte Replikation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a1a8433-ab87-4e3c-a127-2b648cf700e0",
                                "sense_id": "209c3ec0-b3b3-3be1-ae78-ddf3268081a6",
                                "text": "„[M]an glaubt, daß Bromuracil viel häufiger als Thymin in der tautomeren Form existiert und so bei ihm die Wahrscheinlichkeit eines Kopierfehlers sehr viel höher ist.“"
                            },
                            {
                                "example_id": "aecabdc8-f459-41dd-9e0e-4e4d382219f6",
                                "sense_id": "209c3ec0-b3b3-3be1-ae78-ddf3268081a6",
                                "text": "„Im Laufe des Lebens häufen sich die Kopierfehler in den Zellen jedes Organs und Gewebes. Die mutierten Zellen und damit früher oder später der Organismus, können ihre Aufgaben nicht mehr fehlerfrei erfüllen — der unvermeidliche Prozess des Alterns.“"
                            },
                            {
                                "example_id": "7e005b77-af77-4b55-a81c-ce9c49cd465a",
                                "sense_id": "209c3ec0-b3b3-3be1-ae78-ddf3268081a6",
                                "text": "„In der biologischen Evolution erzeugen Kopierfehler und Beschädigungen der Gene neue Varianten der Organismen[.]“"
                            },
                            {
                                "example_id": "e22f2c10-35de-4ce8-828a-25642e8d8653",
                                "sense_id": "209c3ec0-b3b3-3be1-ae78-ddf3268081a6",
                                "text": "„Der Kopierfehler kann aber auch zu einem Fortschritt führen, zu einer Verbesserung des Erbmaterials.“"
                            },
                            {
                                "example_id": "542666b9-b7b2-4c40-8620-6483504417bc",
                                "sense_id": "209c3ec0-b3b3-3be1-ae78-ddf3268081a6",
                                "text": "„Das Bild vom DNS-Raum ist sehr nützlich für Genetiker, die mögliche Veränderungen der DNS-Sequenz betrachten, wie etwa »Punktmutationen«‚ wo ein Codebuchstabe verändert wird, zum Beispiel infolge eines Kopierfehlers.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
