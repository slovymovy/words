                    {
                        "translation_id": "6c255ffa-763c-4e4a-a75a-f3ab25033286",
                        "source_entry_id": "a6c86668-3d7a-3239-bdd8-05c58a22d9f1",
                        "source_sense_id": "82085e84-eaa3-3af1-93a2-ff365cb914b8",
                        "source_sense_description": "heilende Behandlung durch Einsatz bildnerischer Medien",
                        "target_lang_word": "art-thérapie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "art-thérapie",
