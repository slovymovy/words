                                    },
                                    {
                                        "sense_id": "5fed1eed-771c-32f6-96fc-81cedaa42149",
                                        "entry_id": "69ae9454-64f9-3e00-ba98-83110dfcd283",
                                        "glosses": [
                                            "Dativ Singular der starken Flexion des Substantivs Halbstarke"
