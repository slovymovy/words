                "senses": [
                    {
                        "sense_id": "5df74c5e-e7c2-3c01-8c33-f704f66089ea",
                        "entry_id": "d11b9a5f-ed03-339e-b048-f9bb148b2b1f",
                        "glosses": [
                            "мед. свищ, канал, идущий от болезненного очага к коже или слизистой оболочке и кончающийся отверстием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "687dc4ba-e4cb-4156-a998-bd8b7958faef",
                                "sense_id": "5df74c5e-e7c2-3c01-8c33-f704f66089ea",
                                "text": "Фистула открылась внезапно вследствие нарыва с правой стороны живота."
                            }
                        ]
                    },
                    {
                        "sense_id": "2be2c6d6-64e9-3999-9fe8-1eb35c966655",
                        "entry_id": "d11b9a5f-ed03-339e-b048-f9bb148b2b1f",
                        "glosses": [
                            "мед. искусственно сделанный канал из внутренних органов наружу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46cd0ac1-c1ac-405f-8a99-fba03dd82322",
                                "sense_id": "2be2c6d6-64e9-3999-9fe8-1eb35c966655",
                                "text": "Было решено кормить собак в космосе искусственным образом ― через фистулу в желудке."
                            }
                        ]
                    }
                ],
