                        "examples": [
                            {
                                "example_id": "ab674b74-4011-481b-be1b-c3386da59790",
                                "sense_id": "47ff2fd3-30a2-3b52-b73e-b69ba5915c1d",
                                "text": "The same infamous trick, so ignoble and scoundrelish, was practised upon the Russian as upon the British ambassador. The emperor, through pure insolence, insisted on feeding the embassy."
                            },
                            {
                                "example_id": "0b784845-7229-42ad-a3c1-276183b395d8",
                                "sense_id": "47ff2fd3-30a2-3b52-b73e-b69ba5915c1d",
                                "text": "With Goldfaden in Odessa we would have to withdraw. But not too far. Only to the nearby provincial towns. To make sure of success there, Rosenberg thought up one of his brilliantly scoundrelish schemes."
                            },
                            {
                                "example_id": "69e17e7d-5720-495b-bfdd-7f8f9fcd07e9",
                                "sense_id": "47ff2fd3-30a2-3b52-b73e-b69ba5915c1d",
                                "text": "“You are beautiful,” he whispered. She cast about for something lighthearted to say and skimmed a finger over his upper lip. “I see that your mustache is coming right along. Very scoundrelish.”"
                            }
                        ]
                    }
