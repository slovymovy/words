                "senses": [
                    {
                        "sense_id": "f031b03b-a121-3dca-9700-fab0ac28153b",
                        "entry_id": "65566d70-77a2-38a6-b958-73f9284d29a4",
                        "glosses": [
                            "biblia hebrajska składająca się z 24 ksiąg, święta księga judaizmu"
                        ],
                        "tags": [
                            "Jewish"
                        ],
                        "examples": [
                            {
                                "example_id": "021ada4f-afef-4d31-955e-21583e1020ce",
                                "sense_id": "f031b03b-a121-3dca-9700-fab0ac28153b",
                                "text": "Był to bardzo wartościowy młodzieniec. Istne cacko. Biegły w nauce, doskonały znawca Tanachu. Prawdziwy brylant"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a56e30af-ffd1-4380-a6f4-75f884f34bda",
                        "source_entry_id": "65566d70-77a2-38a6-b958-73f9284d29a4",
                        "source_sense_id": "f031b03b-a121-3dca-9700-fab0ac28153b",
                        "target_lang_word": "Tanakh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tanakh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "213efff3-bd60-31f6-8e05-a32d9170b48e",
                                        "entry_id": "7f71651a-4fd7-39d4-a7bc-589134263c85",
                                        "glosses": [
                                            "The body of Jewish scripture comprising the Torah, the Neviim (prophets) and the Ketuvim (writings); corresponding to the Christian Old Testament (or roughly so, depending on the denomination)."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f1e7cf4-924c-4614-b0c6-34cc1cf7f996",
                                                "sense_id": "213efff3-bd60-31f6-8e05-a32d9170b48e",
                                                "text": "Meronyms: Torah, Neviim, Ketuvim"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "818e32e5-57d8-46c7-adf6-8275bca01a51",
                        "source_entry_id": "65566d70-77a2-38a6-b958-73f9284d29a4",
                        "source_sense_id": "f031b03b-a121-3dca-9700-fab0ac28153b",
                        "target_lang_word": "Tanach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tanach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0d669d-3dac-3068-937b-0c973d9a1ea5",
                                        "entry_id": "45fd0789-b36e-34aa-8183-50452b660318",
                                        "glosses": [
                                            "der Kanon der normativen Schriften, nämlich Tora, Nevi’im/Propheten und Ketuvim/(Weisheits-)Schriften"
                                        ],
                                        "tags": [
                                            "Judentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7de10391-a704-4130-ba58-391e594046df",
                                                "sense_id": "ee0d669d-3dac-3068-937b-0c973d9a1ea5",
                                                "text": "„In der jüngeren Sekundärliteratur wird der Tanach oft als ‚jüdische Bibel‘ oder ‚hebräische Bibel‘ bezeichnet.“"
                                            },
                                            {
                                                "example_id": "b90dde39-a057-48ff-87af-0d9ec68f2cf5",
                                                "sense_id": "ee0d669d-3dac-3068-937b-0c973d9a1ea5",
                                                "text": "„Das Christentum hat alle Bücher des Tanach übernommen und kanonisiert.“"
                                            },
                                            {
                                                "example_id": "ad7150f2-1830-4dd4-b6ec-f155a6f598f7",
                                                "sense_id": "ee0d669d-3dac-3068-937b-0c973d9a1ea5",
                                                "text": "„Dies zeigt sich nicht nur an der Diskussion der schwierigen Frage, welche deutsche Übersetzung der Bibel für ein Lehrbuch des Tanach zu verwenden ist (vgl. das Vorwort S. VII und S. 12-15).“"
                                            },
                                            {
                                                "example_id": "77092c32-d2a3-4241-ad7c-4a189874ccfb",
                                                "sense_id": "ee0d669d-3dac-3068-937b-0c973d9a1ea5",
                                                "text": "„Ähnlich wollte eine Gruppe bulgarischer Kinder in Ben- Shemen nicht im Tanach lesen, weil in ihm immer der Name ‚Gott‘ vorkommt.“"
                                            },
                                            {
                                                "example_id": "6e81fb24-9ad0-4681-9d6c-84f1eb734e40",
                                                "sense_id": "ee0d669d-3dac-3068-937b-0c973d9a1ea5",
                                                "text": "„Kurz darauf schlage ich die Stelle im Tanach auf, an der meine Freundin und ich in Hamburg aufgehört haben.“"
                                            },
                                            {
                                                "example_id": "76d72326-46a4-48dc-a0eb-69beaf52e37b",
                                                "sense_id": "ee0d669d-3dac-3068-937b-0c973d9a1ea5",
                                                "text": "„Tanach ist ein Akrostichon aus den hebräischen Wörter Thora, Newi'im und Chetuwim, die sich auf die drei Teile der Bibel beziehen: Thora, das Gesetz, oder auch Pentateuch, heißen die fünf Bücher Mose, Newi'im sind die Propheten und Chetuwim die Hagiographen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
