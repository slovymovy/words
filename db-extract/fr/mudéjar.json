                    {
                        "form_id": "ed42658b-feed-4a50-9b67-4fdf2d87c76e",
                        "entry_id": "f6d8a6a6-5af9-3db7-9d4a-0b931d6bfa3a",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "mudéjares"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95729997-520f-3c45-9ceb-ac58401eccb3",
                        "entry_id": "f6d8a6a6-5af9-3db7-9d4a-0b931d6bfa3a",
                        "glosses": [
                            "Relatif aux musulmans, à la période de coexistence entre chrétiens et musulmans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa512e10-dc55-47cc-bb63-90d87fcc1888",
                                "sense_id": "95729997-520f-3c45-9ceb-ac58401eccb3",
                                "text": "À l’intérieur, son plafond est de style mudéjar, à caissons de bois de cèdre incrusté d’ivoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdf3dde6-7738-4ecb-b95a-d3bd9811c6c6",
                        "source_entry_id": "f6d8a6a6-5af9-3db7-9d4a-0b931d6bfa3a",
                        "source_sense_id": "95729997-520f-3c45-9ceb-ac58401eccb3",
                        "target_lang_word": "Mudéjar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mudéjar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09272317-aa22-3e82-b447-d44f00abcbc2",
                                        "entry_id": "45e61625-33e5-3345-99ab-cbda817d5454",
                                        "glosses": [
                                            "Of or pertaining to the Moors of Al-Andalus who remained in Christian territory after the Reconquista but were not converted to Christianity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c59cf04-d0fb-4572-aa35-c24a073fc1df",
                                                "sense_id": "09272317-aa22-3e82-b447-d44f00abcbc2",
                                                "text": "We must not forget that Mudejar identity was a contractual identity, entered into through myriad treaties between conquerors and conquered, each different from the other, and each subject to constant renegotiation, reinterpretation, and change depending on circumstance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b335788c-5f3e-30ad-8fda-6897a1702c35",
                                        "entry_id": "45e61625-33e5-3345-99ab-cbda817d5454",
                                        "glosses": [
                                            "Of or pertaining to the style of Iberian architecture and decoration of the 12th to 16th centuries."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e3cb93e-6804-4a8a-9144-321082b67a24",
                                                "sense_id": "b335788c-5f3e-30ad-8fda-6897a1702c35",
                                                "text": "These artisans and workers used particular techniques that earlier Muslims under Christian rule had refined into the Mudéjar style."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mudéjar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aee79fa-187a-399a-8694-35124f443220",
                                        "entry_id": "2739490c-9909-3841-9068-f048004c8a82",
                                        "glosses": [
                                            "Any of the Moors of Al-Andalus who remained in Christian territory after the Reconquista but were not converted to Christianity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a77dfab-cc73-4d15-9403-c34b63ae3a91",
                                                "sense_id": "6aee79fa-187a-399a-8694-35124f443220",
                                                "text": "They came to be known as the Mudéjares- the corruption of Mudegelin, an opprobrious term bestowed upon them by the Moors, derived from the word Degel which we are told was equivalent to Antichrist."
                                            },
                                            {
                                                "example_id": "1e38594a-a201-478d-9b6c-09f97e8609e6",
                                                "sense_id": "6aee79fa-187a-399a-8694-35124f443220",
                                                "text": "In this way, the mudéjars of Valencia came to represent a solid Muslim enclave within Christian Iberia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81b3cdd8-85c2-3506-8e90-342c54d2f754",
                                        "entry_id": "2739490c-9909-3841-9068-f048004c8a82",
                                        "glosses": [
                                            "A style of Iberian architecture and decoration of the 12th to 16th centuries."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afb26c23-e5e0-4d68-8333-1cca9fb3b3ac",
                        "source_entry_id": "f6d8a6a6-5af9-3db7-9d4a-0b931d6bfa3a",
