                "senses": [
                    {
                        "sense_id": "ecffdfea-836e-3d45-ad5c-cd35468050d8",
                        "entry_id": "81325a6e-a229-37e4-ba90-6091c8cdbeb4",
                        "glosses": [
                            "Art des pönalen Freiheitsentzuges in folgenden historischen deutschen Strafgesetzbüchern"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5fbe93f-7aac-3b22-8739-c3df0e8f6770",
                        "entry_id": "81325a6e-a229-37e4-ba90-6091c8cdbeb4",
                        "glosses": [
                            "Art des pönalen Freiheitsentzuges in folgenden historischen deutschen Strafgesetzbüchern",
                            "einfache Freiheitsentziehung mit einer Dauer von einem Tag bis zu sechs Wochen (§ 18)"
                        ],
                        "tags": [
                            "Strafgesetzbuch für das Deutsche Reich (1871)"
                        ],
                        "examples": [
                            {
                                "example_id": "ca4a5665-961e-4ced-a99e-21b5f2b72889",
                                "sense_id": "c5fbe93f-7aac-3b22-8739-c3df0e8f6770",
                                "text": "„Im Dezember 1871 wurde der \"Kanzelparagraph\" ins Strafgesetzbuch aufgenommen, der Geistlichen unter der Androhung von Haftstrafen verbot, von der Kanzel staatliche Angelegenheiten kritisch zu erörtern.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "e954ad57-907b-3d84-b504-d83732f3bd5d",
                        "entry_id": "81325a6e-a229-37e4-ba90-6091c8cdbeb4",
                        "glosses": [
                            "Art des pönalen Freiheitsentzuges in folgenden historischen deutschen Strafgesetzbüchern",
                            "Freiheitsentzug mit einer Dauer von einer Woche bis zu sechs Wochen unter Ableistung gesellschaftlich nützlicher Arbeit zur unverzüglichen und nachdrücklichen Disziplinierung des Täters (§ 41)"
                        ],
                        "tags": [
                            "Strafgesetzbuch der Deutschen Demokratischen Republik"
                        ],
                        "examples": [
                            {
                                "example_id": "70a910e2-7164-496f-8039-80a7a068e10a",
                                "sense_id": "e954ad57-907b-3d84-b504-d83732f3bd5d",
                                "text": "„Westliche Kriminologen sprachen der Haftstrafe die ‚unverzügliche‘ disziplinierende Wirkung ab, da sie den Täter aus seinen gewohnten sozialen Bindungen reiße und ihn dem negativen Strafvollzugsmilieu aussetze.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "3c88ae14-1890-32a6-a12e-6bf45a77f4c0",
                        "entry_id": "81325a6e-a229-37e4-ba90-6091c8cdbeb4",
                        "glosses": [
                            "Freiheitsstrafe"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3eb1bc2e-d3f6-4aed-884d-1bf06ceda3c3",
                                "sense_id": "3c88ae14-1890-32a6-a12e-6bf45a77f4c0",
                                "text": "„Der Sohn von Uschi Glas, Ben Tewaag, ist wieder zu einer Haftstrafe verurteilt worden.“"
                            },
                            {
                                "example_id": "354637fd-6f8c-48bc-ab88-b57a169f4374",
                                "sense_id": "3c88ae14-1890-32a6-a12e-6bf45a77f4c0",
                                "text": "„Die Verteidigung hatte dagegen eine Haftstrafe von maximal zehn Jahren Gefängnis wegen Totschlags gefordert.“"
                            },
                            {
                                "example_id": "f8d06f8e-ca38-4a4e-bc8f-c17cebb9b6d0",
                                "sense_id": "3c88ae14-1890-32a6-a12e-6bf45a77f4c0",
                                "text": "„Zu jener Zeit saß er eine dreimonatige Haftstrafe wegen Schmuggels ab - er hatte Feuersteine in den Hosentaschen nach Polen geschmuggelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97b92fb5-e3e7-4e82-b565-bff18876eaaf",
                        "source_entry_id": "81325a6e-a229-37e4-ba90-6091c8cdbeb4",
                        "target_lang_word": "imprisonment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprisonment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                        "entry_id": "fe5aedf6-b95e-3f90-8902-576163ce428b",
                                        "glosses": [
                                            "A confinement in a place, especially a prison or a jail, especially as punishment for a crime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703723e8-a699-43b7-b7e0-5522de697c08",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "His sinews woxen weake and raw / Through long emprisonment and hard constraint."
                                            },
                                            {
                                                "example_id": "3ac79ea7-a2c2-47f0-8141-7d1d309527b4",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Every confinement of the person is an imprisonment, whether it be in a common prison, or in a private house, or even by forcibly detaining one in the public streets."
                                            },
                                            {
                                                "example_id": "567f1ae2-8bd0-4bd3-9da4-3a7859e2107d",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88a5dd9e-f2e4-4837-a294-18cf520058b7",
                        "source_entry_id": "81325a6e-a229-37e4-ba90-6091c8cdbeb4",
                        "target_lang_word": "peine d'emprisonnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1003ff55-e3c9-4d25-b388-2e8101f358eb",
                        "source_entry_id": "81325a6e-a229-37e4-ba90-6091c8cdbeb4",
                        "target_lang_word": "emprisonnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emprisonnement",
