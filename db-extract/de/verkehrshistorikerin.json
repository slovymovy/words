                "senses": [
                    {
                        "sense_id": "56217d10-73f8-3874-b430-8cd993be648c",
                        "entry_id": "dfe0848b-d4dc-33b7-8c3e-a6cb95e8e626",
                        "glosses": [
                            "Historikerin mit dem Fachgebiet Verkehrsgeschichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc622245-2694-48d7-9faa-8fcc6713758c",
                                "sense_id": "56217d10-73f8-3874-b430-8cd993be648c",
                                "text": "„Das Prinzip der Distanzmessung vom Zytglogge geht auf die Antike zurück, wie die Verkehrshistorikerin Sabine Bolliger in einem Fachartikel schrieb.“"
                            },
                            {
                                "example_id": "9864033f-1677-4b77-82a9-421579c10f2f",
                                "sense_id": "56217d10-73f8-3874-b430-8cd993be648c",
                                "text": "„Nach der Tageseröffnung durch den Stadtrat Andres Türler zeigte Frau Dr. Phil. Barbara Schmucki, Verkehrshistorikerin, die Geschichte des Stadtverkehrs nach dem Zweiten Weltkrieg auf.“"
                            },
                            {
                                "example_id": "5ad323f4-56d3-412c-b2c7-9407f8d96938",
                                "sense_id": "56217d10-73f8-3874-b430-8cd993be648c",
                                "text": "„Die freie Verkehrshistorikerin hat sich eingehend mit der Geschichte der Lötschbergbahn beschäftigt und ihre Lizentiatsarbeit darüber verfasst.“"
                            },
                            {
                                "example_id": "92b3ad04-4840-47ca-afac-3bed4cfba168",
                                "sense_id": "56217d10-73f8-3874-b430-8cd993be648c",
                                "text": "„Die Verkehrshistorikerin Barbara Schmucki skizzierte die Geschichte des Stadtverkehrs nach dem Zweiten Weltkrieg, Verkehrspsychologe Markus Hackenfort schilderte, wie wir im Verkehr (und nicht nur dort) funktionieren und weshalb Konflikte entstehen.“"
                            },
                            {
                                "example_id": "cb0c3ef9-e064-4cdf-9190-c65b3360fd57",
                                "sense_id": "56217d10-73f8-3874-b430-8cd993be648c",
                                "text": "„In sieben chronologisch gegliederten Kapiteln hat ein Autorenkollektiv unter Leitung der namhaften Dresdener Verkehrshistorikerin Prof. Dr. sc. oec. Elfriede Rehbein die Geschichte des Phänomens Eisenbahn beschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
