                "forms": [],
                "senses": [
                    {
                        "sense_id": "dc913597-9530-3791-80d3-5a3f933fd11b",
                        "entry_id": "6dfea6be-27fb-397d-9d8d-757a2c468c67",
                        "glosses": [
                            "A diminutive of the male given names Joe or Joseph."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f6b1fa-82e7-40ea-bc5f-0f030bbbf873",
                                "sense_id": "dc913597-9530-3791-80d3-5a3f933fd11b",
                                "text": "Indeed what do the tensomethings, who might be watching the show at that hour, make of jokes like Joey telling Chandler that his uncle Sal has a really big tongue."
                            },
                            {
                                "example_id": "4c57b95b-516d-4af1-bf03-7f2de49256d8",
                                "sense_id": "dc913597-9530-3791-80d3-5a3f933fd11b",
                                "text": "And not to rub salt in wounds, when it comes to making mincemeat of the competition, American Joey Chestnut is still top banana."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc278077-a517-33f6-88da-c2cb8007a9a8",
