                "senses": [
                    {
                        "sense_id": "12157585-ba83-336e-bf73-af3c4f7610fc",
                        "entry_id": "17181014-379a-3270-a7cc-6d5e6f985692",
                        "glosses": [
                            "Enlever son caractère génital, ou purement génital, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a99fdc3a-457a-4eae-8040-cbc7ade8cab1",
                                "sense_id": "12157585-ba83-336e-bf73-af3c4f7610fc",
                                "text": "Si on veut bien la dégénitaliser, la sexualité obsède-t-elle tous les hommes et toutes les femmes, et le fait-elle de façon très précoce ?"
                            },
                            {
                                "example_id": "427c615d-3c0d-4a04-9f75-97b215b55d70",
                                "sense_id": "12157585-ba83-336e-bf73-af3c4f7610fc",
                                "text": "L’accent mis sur un détail concret, technique de la pêche, a pour effet de désexualiser - dégénitaliser - toute la scène, rabattant la dévoration, métaphore sexuelle, sur son sens le plus littéral de mastication mandibulaire."
                            },
                            {
                                "example_id": "ccc6c8b9-5074-4c9b-9457-c9f2d8b70e59",
                                "sense_id": "12157585-ba83-336e-bf73-af3c4f7610fc",
                                "text": "Cette godotectonique permet de dégénitaliser la sexualité et de sortir de l’idée du gode comme imitation du pénis pénétrant."
                            }
                        ]
                    }
