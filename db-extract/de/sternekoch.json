                "senses": [
                    {
                        "sense_id": "3f921d66-2f15-3346-bf84-f824055f7dd1",
                        "entry_id": "8d4b90b3-5cab-31c2-8888-68590afb6485",
                        "glosses": [
                            "Koch, der mit einem oder mehreren Sternen ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de8b8f1-b8b9-4a95-9eeb-3504cfad56b4",
                                "sense_id": "3f921d66-2f15-3346-bf84-f824055f7dd1",
                                "text": "„Geführt wird das Lokal vom spanischen Sternekoch Charles Gaig, der seine Gäste mit traditionellem katalanischen Essen verwöhnt.“"
                            },
                            {
                                "example_id": "b97ee7ec-85dc-48df-9878-b481e4182288",
                                "sense_id": "3f921d66-2f15-3346-bf84-f824055f7dd1",
                                "text": "„Der Sternekoch betreibt die Restaurants in der Semperoper und im Schauspielhaus, er unterhält einen Feinkostladen, eine Kochschule und eine Cateringfirma.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
