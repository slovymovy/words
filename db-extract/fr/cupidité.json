        "fr-extract.jsonl": [
            {
                "entry_id": "67e38d29-2871-3216-a490-bd44fefee0a0",
                "word": "cupidité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cfd05ca6-ef51-4530-a18f-6afbad6886eb",
                        "entry_id": "67e38d29-2871-3216-a490-bd44fefee0a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "cupidités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dde8255-c87f-3b49-a558-78d6572ca2df",
                        "entry_id": "67e38d29-2871-3216-a490-bd44fefee0a0",
                        "glosses": [
                            "Recherche immodérée du gain, des richesses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9dc578b-4c87-47d3-829d-33718d573e62",
                                "sense_id": "1dde8255-c87f-3b49-a558-78d6572ca2df",
                                "text": "Favorisez donc la libre circulation des grains, en empêchant tous les engorgements funestes. Quel est le moyen de remplir cet objet ? Ôter à la cupidité l’intérêt et la facilité de les opérer. Or trois causes les favorisent, le secret, la liberté sans frein, et la certitude de l’impunité."
                            },
                            {
                                "example_id": "d2939047-432f-4780-996c-dfdb87412d39",
                                "sense_id": "1dde8255-c87f-3b49-a558-78d6572ca2df",
                                "text": "Et il attribue ce malheur, ce qui me semble probable, à la cupidité que les grandes fortunes excitent chez les jeunes gens…"
                            },
                            {
                                "example_id": "8190a4ba-40fc-4465-8b00-e0a89ebe100d",
                                "sense_id": "1dde8255-c87f-3b49-a558-78d6572ca2df",
                                "text": "En effet, l’histoire du Nouveau Monde n’est qu’un lamentable martyrologe, dans lequel le fanatisme et la cupidité marchent continuellement côte à côte."
                            },
                            {
                                "example_id": "fb80fc9b-157f-4d3f-b333-1dc8edb40e2a",
                                "sense_id": "1dde8255-c87f-3b49-a558-78d6572ca2df",
                                "text": "Voici l’illustration subliminale d’une société qui s’est foutue en l’air toute seule en s’enfonçant dans un système réchauffé de cupidité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ed54a06-fe8b-4a88-aa06-38c9696f541e",
                        "source_entry_id": "67e38d29-2871-3216-a490-bd44fefee0a0",
                        "source_sense_id": "1dde8255-c87f-3b49-a558-78d6572ca2df",
                        "target_lang_word": "Geldgier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geldgier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "952e20ba-5d6f-34d0-a6e6-b447d7b65ff0",
                                        "entry_id": "1a918958-c87b-346f-b26b-8c2ad084d286",
                                        "glosses": [
                                            "starkes Verlangen nach finanziellen Mitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9fdbc4-bcd3-415c-9fa9-d79d4944f645",
                                                "sense_id": "952e20ba-5d6f-34d0-a6e6-b447d7b65ff0",
                                                "text": "Für seine Geldgier würde er auch über Leichen gehen."
                                            },
                                            {
                                                "example_id": "b5fb4ecf-9524-416a-90eb-32e4999b5a18",
                                                "sense_id": "952e20ba-5d6f-34d0-a6e6-b447d7b65ff0",
                                                "text": "„Ich mußte meine Besuche einstellen und sehen, wie die Sache zwischen ihr und ihrem Vater ausging; in seiner Geldgier mußte er sehr ärgerlich darüber sein, daß Lia keinen Weg gefunden hatte, mich zum Kauf des Wagens zu bewegen, ob sie sich mir nun hingab oder nicht, denn das war ihm gewiß gleichgültig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "816c0804-c0c6-42a3-9f61-a4f0a2a080be",
                        "source_entry_id": "67e38d29-2871-3216-a490-bd44fefee0a0",
                        "source_sense_id": "1dde8255-c87f-3b49-a558-78d6572ca2df",
                        "target_lang_word": "cupidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cupidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dd63b70-b9bd-30a6-8c0b-99271e06c07b",
                                        "entry_id": "109725a7-a899-3854-ad68-b4918ffa9224",
                                        "glosses": [
                                            "Extreme greed, especially for wealth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca498da-39cc-4c35-8887-4d1144dec4c3",
                                                "sense_id": "9dd63b70-b9bd-30a6-8c0b-99271e06c07b",
                                                "text": "A bargain is a social evil; one man's loss, tempting another man's cupidity."
                                            },
                                            {
                                                "example_id": "cfa67284-60f9-4f79-bfcc-be2e422fb925",
                                                "sense_id": "9dd63b70-b9bd-30a6-8c0b-99271e06c07b",
                                                "text": "Now Jonah’s Captain, shipmates, was one whose discernment detects crime in any, but whose cupidity exposes it only in the penniless."
                                            },
                                            {
                                                "example_id": "fde7ae20-bade-4ab7-a169-ea553a4a34da",
                                                "sense_id": "9dd63b70-b9bd-30a6-8c0b-99271e06c07b",
                                                "text": "His affairs, however, were not allowed to subside thus quietly, and people were quite as much inclined to talk about the disinterested sacrifice he had made, as they had before been to upbraid him for his cupidity."
                                            },
                                            {
                                                "example_id": "2f5e8ed7-14e7-46de-bfce-a458fcde2a64",
                                                "sense_id": "9dd63b70-b9bd-30a6-8c0b-99271e06c07b",
                                                "text": "“I have tried, as I hinted, to enlist the co-operation of other capitalists, but experience has taught me that any appeal is futile that does not impinge directly upon cupidity. …”"
                                            },
                                            {
                                                "example_id": "440d4479-8e33-492a-864c-7f2f90f5e2a7",
                                                "sense_id": "9dd63b70-b9bd-30a6-8c0b-99271e06c07b",
                                                "text": "Humanity had always been fascinated by the mystery of the falling dice, the turn of a card, the spin of the pointer. At its lowest level, this interest was based on mere cupidity—and that was an emotion that could have no place in a world where everyone possessed all that they could reasonably need."
                                            },
                                            {
                                                "example_id": "74ea55a1-626d-4ff6-b682-d20223abd82e",
                                                "sense_id": "9dd63b70-b9bd-30a6-8c0b-99271e06c07b",
                                                "text": "It was easy to dissimulate and disperse these modest purchases in such a way as not to excite the cupidity of any passing patrols."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d2326fa-6792-4b82-8c48-18a90be7344a",
                        "source_entry_id": "67e38d29-2871-3216-a490-bd44fefee0a0",
                        "source_sense_id": "1dde8255-c87f-3b49-a558-78d6572ca2df",
                        "target_lang_word": "greed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                        "entry_id": "55171cf4-41ee-31f1-9eaa-90671c1faec9",
                                        "glosses": [
                                            "A selfish or excessive desire for more than is needed or deserved, especially of money, wealth, food, or other possessions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9830e570-5c1d-4e67-a317-8fd1cee96526",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "His greed was his undoing."
                                            },
                                            {
                                                "example_id": "9998a4c5-5551-4fed-990c-e7cd09736564",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "[…]But when I had bestridden the plank, quoth I to myself, \"Thou deserveth all that betideth thee. All this is decreed to me of Allah (whose name be exalted!), to turn me from my greed of gain, whence ariseth all that I endure, for I have wealth galore.\""
                                            },
                                            {
                                                "example_id": "090ab8ff-1782-428a-8903-372d23ae4873",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "Your market gardener is not a well-breeched man, dependant as he is on the imponderables of glut, the inequities of distribution, and the greeds of wholesaler and retailer."
                                            },
                                            {
                                                "example_id": "da05c7f1-cd52-47e9-95d3-7e40241c412f",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "She does not display voracities and greeds like a number of patients […] nor has she shown any significant tendency to possessiveness, grievance, paranoia, or mania."
                                            },
                                            {
                                                "example_id": "e472d04f-fceb-4cd9-8cc5-a17da0d738e1",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "The point is, ladies and gentleman, that greed, for lack of a better word, is good. Greed is right, greed works. Greed clarifies, cuts through, and captures the essence of the evolutionary spirit. Greed, in all of its forms; greed for life, for money, for love, knowledge has marked the upward surge of mankind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "greed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                        "entry_id": "0cc97faf-bca1-385b-82df-ecd5dd0fbb81",
                                        "glosses": [
                                            "To desire in a greedy manner, or to act on such a desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8670af7-9cad-404b-8633-d597266d1af5",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "The ravens sit greeding, / And watching, and heeding: / Thoro' wind, over water, / Comes scent of the slaughter, / And ravens sit greeding / Their share of the bones."
                                            },
                                            {
                                                "example_id": "b0808650-caae-47d5-bdb8-af9168706414",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "Hearing these words he arose, because indeed he greeded for her, and came up behind her as she rested upon her elbows and knees and bending in hand his prickle nailed it into her coynte and did manly devoir."
                                            },
                                            {
                                                "example_id": "de2fb649-fa3f-42e7-8e14-1be5d6d1a96a",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "This conniving bastard has greeded the farm off an old man and I end up with nothing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
