                ],
                "senses": [
                    {
                        "sense_id": "c2999488-5d2e-3ab1-9565-dfab799c5980",
                        "entry_id": "5e5dcf20-2d6c-38cf-b7cc-b3a87d49e576",
                        "glosses": [
                            "Person oder Unternehmen, das Fleisch liefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e253bb0-e6b1-4afa-9e7b-47526f6d6e9c",
                                "sense_id": "c2999488-5d2e-3ab1-9565-dfab799c5980",
                                "text": "„Dazu gehörten die Fleischlieferanten Chicagos, die Kühlhausketten aufbauten, außerdem die großen Brauereien des mittleren Westens und die durch eine Reihe von Zusammenschlüssen entstandene United Fruit Company.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f14aa8b-5863-34ab-b962-709fb2b406d7",
                        "entry_id": "5e5dcf20-2d6c-38cf-b7cc-b3a87d49e576",
                        "glosses": [
                            "Tier, dessen Fleisch als Nahrung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0e2efb0-7267-4630-a30e-69a7c4ca95a2",
                                "sense_id": "4f14aa8b-5863-34ab-b962-709fb2b406d7",
                                "text": "„Rind, Schaf, Ziege und Schwein, die eigentlichen Fleischlieferanten, wurden außerhalb der Stadt gehalten.“"
                            },
                            {
                                "example_id": "804bb800-2eeb-465f-b4e9-93b1c5abe4ce",
                                "sense_id": "4f14aa8b-5863-34ab-b962-709fb2b406d7",
                                "text": "„Der Büffel, im ganzen robuster, ist nun als Milch- und Fleischlieferant doppelt wertvoll geworden.“"
                            },
                            {
                                "example_id": "58dca22c-2a6a-4bc6-969d-1c0d6d2a4987",
                                "sense_id": "4f14aa8b-5863-34ab-b962-709fb2b406d7",
                                "text": "„Da das Rindvieh der bedeutendste Fleischlieferant war und auch die Milch dringend benötigt wurde (und selbst die Häute bildeten eine nicht unwichtige Einnahmequelle), bestand an ihrer Notwendigkeit kein Zweifel, wohl aber an ihrer Rentabilität.“"
                            },
                            {
                                "example_id": "c2ea2acb-72e7-47e0-8542-8bc311bfd251",
                                "sense_id": "4f14aa8b-5863-34ab-b962-709fb2b406d7",
                                "text": "„Man kann sagen, daß seit der Christianisierung das Pferd, aber auch Esel und Maultier allmählich als Fleischlieferanten ausfielen, doch griff man in den zahlreichen Hungersnöten sicher noch wieder darauf zurück.“"
                            },
                            {
                                "example_id": "21b7542b-752a-4a75-9648-e30ed6e68495",
                                "sense_id": "4f14aa8b-5863-34ab-b962-709fb2b406d7",
                                "text": "„Die Schweinezucht wurde lange Zeit vernachlässigt, erlangte aber seit der zweiten Hälfte des 19. Jahrhunderts immer größere Bedeutung, so daß das Schwein zum wichtigsten Fleischlieferanten aufstieg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
