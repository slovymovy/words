                "senses": [
                    {
                        "sense_id": "84509c8a-b42d-3136-8ce8-6d3baf21c9d0",
                        "entry_id": "11ddb531-b18d-3353-9f1a-a7e6b35eaa05",
                        "glosses": [
                            "Profiter des opportunités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "496dd93f-8cab-4cf9-98f3-cb1eafb014f3",
                                "sense_id": "84509c8a-b42d-3136-8ce8-6d3baf21c9d0",
                                "text": "En toute lucidité des enjeux, le motard peut librement décider d'«opportuniser» ou de ne pas «opportuniser» la situation."
                            },
                            {
                                "example_id": "585460e1-16db-4b08-b28c-e129ca4cbdae",
                                "sense_id": "84509c8a-b42d-3136-8ce8-6d3baf21c9d0",
                                "text": "Mais tout cela ne suffit pas : gérer, c'est bien, mais il faut aussi savoir innover, investir, prendre des risques mesurés, opportuniser."
                            },
                            {
                                "example_id": "6d2a9568-aa42-49c4-9916-86c911384302",
                                "sense_id": "84509c8a-b42d-3136-8ce8-6d3baf21c9d0",
                                "text": "Tu vas rien faire tu vas opportuniser :-)."
                            }
                        ]
                    }
