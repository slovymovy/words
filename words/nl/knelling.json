{
    "word_family": [
        "knellen",
        "knellend",
        "knelling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8fe2b875-3e68-3e6b-860e-0a687d7f163d",
                    "sense_definition": "Het onvrije of knellende gevoel dat ontstaat wanneer een kledingstuk of schoeisel te krap zit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke-knelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange wandeling voelde hij eindelijk de <w>knelling</w> van zijn nieuwe schoenen verminderen.",
                            "target_lang_translations": {
                                "en": "After a long walk, he finally felt the <w>pinching</w> of his new shoes subside."
                            }
                        },
                        {
                            "text": "Zij klaagde over de constante <w>knelling</w> van de te strakke broekband.",
                            "target_lang_translations": {
                                "en": "She complained about the constant <w>tightness</w> of the overly tight waistband."
                            }
                        }
                    ],
                    "synonyms": [
                        "beknelling",
                        "druk"
                    ],
                    "common_phrases": [
                        "knelling van schoenen",
                        "knelling van kleding"
                    ],
                    "target_lang_definitions": {
                        "en": "The unfree or pinching feeling that arises when a piece of clothing or footwear is too tight."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinching",
                                "target_lang_sense_clarification": "of tight clothing or shoes"
                            },
                            {
                                "target_lang_word": "tightness",
                                "target_lang_sense_clarification": "of clothing or footwear"
                            },
                            {
                                "target_lang_word": "constriction",
                                "target_lang_sense_clarification": "physical pressure from tight items"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48d1b8e4-d3b9-372a-af12-ec2c898ea1c7",
                    "sense_definition": "Een figuurlijk gevoel van onvrijheid, beklemming of beperking in iemands bewegingsvrijheid of handelen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijke-knelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar probeerde te ontsnappen aan de <w>knelling</w> van de maatschappelijke normen.",
                            "target_lang_translations": {
                                "en": "The artist tried to escape the <w>constraint</w> of societal norms."
                            }
                        },
                        {
                            "text": "Men voelde steeds meer de <w>knelling</w> van de strenge regels binnen de organisatie.",
                            "target_lang_translations": {
                                "en": "People increasingly felt the <w>oppression</w> of the strict rules within the organization."
                            }
                        }
                    ],
                    "synonyms": [
                        "beklemming",
                        "beperking",
                        "onvrijheid"
                    ],
                    "antonyms": [
                        "vrijheid",
                        "ruimte"
                    ],
                    "common_phrases": [
                        "knelling van regels",
                        "gevoel van knelling"
                    ],
                    "target_lang_definitions": {
                        "en": "A figurative feeling of lack of freedom, oppression, or restriction in one's freedom of movement or action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constraint",
                                "target_lang_sense_clarification": "figurative restriction or limitation"
                            },
                            {
                                "target_lang_word": "oppression",
                                "target_lang_sense_clarification": "feeling of being restricted or weighed down"
                            },
                            {
                                "target_lang_word": "confinement",
                                "target_lang_sense_clarification": "figurative lack of freedom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27abe64a-00b3-39de-8389-125b754ef549",
                    "sense_definition": "Een knelpunt of probleem dat ontstaat door een tekort of schaarste aan middelen of personeel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knelpunt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het gebrek aan budget werd de financiële <w>knelling</w> binnen het project direct voelbaar.",
                            "target_lang_translations": {
                                "en": "Due to the lack of budget, the financial <w>squeeze</w> within the project was felt immediately."
                            }
                        },
                        {
                            "text": "De <w>knelling</w> op de arbeidsmarkt zorgt voor grote problemen in de zorgsector.",
                            "target_lang_translations": {
                                "en": "The <w>tightness</w> in the labor market is causing major problems in the healthcare sector."
                            }
                        }
                    ],
                    "synonyms": [
                        "knelpunt",
                        "tekort",
                        "schaarste"
                    ],
                    "antonyms": [
                        "overschot"
                    ],
                    "common_phrases": [
                        "knelling op de arbeidsmarkt"
                    ],
                    "target_lang_definitions": {
                        "en": "A bottleneck or problem arising from a shortage or scarcity of resources or personnel."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bottleneck",
                                "target_lang_sense_clarification": "problem due to scarcity or constraints"
                            },
                            {
                                "target_lang_word": "squeeze",
                                "target_lang_sense_clarification": "financial or labor market pressure"
                            },
                            {
                                "target_lang_word": "tightness",
                                "target_lang_sense_clarification": "scarcity in a market, e.g., labor market"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}