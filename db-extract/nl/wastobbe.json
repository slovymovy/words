                "senses": [
                    {
                        "sense_id": "4b9b140a-c83e-30fb-a667-dd38704be0e0",
                        "entry_id": "e434e4bc-c873-3ba3-8160-3ecf44034569",
                        "glosses": [
                            "een grote, ovale ouderwetse teil, van zink of hout, meestal rond, waarin veel water kan worden gedaan en die gebruikt wordt voor het schoonmaken van kleding en ander textiel of om te baden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0463d817-00a6-4099-8bab-3f8d8151f383",
                                "sense_id": "4b9b140a-c83e-30fb-a667-dd38704be0e0",
                                "text": "De Koninklijke Luchtmacht viert een feestje. De Luchtvaartafdeeling is in honderd jaar tijd uitgegroeid tot een volwaardig, internationaal gerespecteerd krijgsmachtsdeel. Van vliegende wastobbe tot geavanceerde gevechtsjager."
                            },
                            {
                                "example_id": "05ebf3b8-b743-4e53-b3c2-8e63da130726",
                                "sense_id": "4b9b140a-c83e-30fb-a667-dd38704be0e0",
                                "text": "Op de naaktfoto is de man te zien in een wastobbe en hij dekt zijn intieme delen met zijn handen af. De aanleiding voor het plaatsen van deze foto was een kunstzinnige foto van een oud-leerling, die werd verwijderd, omdat er een blote schouder te zien was, zo laat de leraar weten aan Omroep Zeeland. \"Facebook verwijderde die foto, omdat het aanstootgevend zou zijn. Terwijl de foto werkelijk niks, maar dan ook niks met erotiek te maken had!\""
                            }
                        ]
                    }
