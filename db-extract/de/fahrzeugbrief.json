                "senses": [
                    {
                        "sense_id": "7d5ea09d-2218-328a-87b4-1ac73d8ceba9",
                        "entry_id": "5d4be1fc-e119-36a3-840e-caa5eaa2813d",
                        "glosses": [
                            "„amtliche Urkunde über die allgemeine Zulassung eines Kraftfahrzeugs für den öffentlichen Straßenverkehr“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e192635-7c4f-4057-bbc9-bcf4af815d67",
                                "sense_id": "7d5ea09d-2218-328a-87b4-1ac73d8ceba9",
                                "text": "„Den Fahrzeugschein erhalten Sie als Halter bei der Anmeldung Ihres Fahrzeugs mit dem Fahrzeugbrief.“"
                            },
                            {
                                "example_id": "6e2e0945-8516-49ec-b5ff-3cc38203f8ed",
                                "sense_id": "7d5ea09d-2218-328a-87b4-1ac73d8ceba9",
                                "text": "„Als er rauskam, hatte ihm seine Großmutter die Schlüssel und den Fahrzeugbrief ausgehändigt.“"
                            },
                            {
                                "example_id": "61b67e4b-071e-4bd5-87b3-47815425bda1",
                                "sense_id": "7d5ea09d-2218-328a-87b4-1ac73d8ceba9",
                                "text": "„Er hatte die Fahrbefehle und Fahrzeugbriefe der Chauffeure gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
