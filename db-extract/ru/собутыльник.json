                "senses": [
                    {
                        "sense_id": "365bc30a-1cac-359e-ac78-f29360e90c3a",
                        "entry_id": "4f6c593d-3cc3-3c5c-9d2f-9e3d121449ed",
                        "glosses": [
                            "разг. тот, кто пьянствует вместе с кем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93ea9bf-5c8e-4a95-a2ca-43460ae8e0a9",
                                "sense_id": "365bc30a-1cac-359e-ac78-f29360e90c3a",
                                "text": "Он же ― Володя ― для домашних и Вован ― для собутыльников (или Вовчик, смотря сколько примут)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0490c767-747b-4337-a9bb-b480916f6fd1",
                        "source_entry_id": "4f6c593d-3cc3-3c5c-9d2f-9e3d121449ed",
                        "source_sense_id": "365bc30a-1cac-359e-ac78-f29360e90c3a",
                        "target_lang_word": "Saufbruder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saufbruder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7faae588-a745-3d4f-9084-651cac6cabd5",
                                        "entry_id": "3099c5ad-de9d-3764-955d-16226d84dc9c",
                                        "glosses": [
                                            "eine Person, mit der man öfter gemeinsam Alkohol trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d11823-e6ba-40aa-90d8-46a47ef187bc",
                                                "sense_id": "7faae588-a745-3d4f-9084-651cac6cabd5",
                                                "text": "Mit diesem Saufbruder gehe ich nicht mehr in die Stadt!"
                                            },
                                            {
                                                "example_id": "48500770-cc84-4b31-9a2b-955651987979",
                                                "sense_id": "7faae588-a745-3d4f-9084-651cac6cabd5",
                                                "text": "„Die Saufbrüder sind wie vom Blitz getroffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d723ca9-d9af-40c6-b3f3-20d5a4284788",
                        "source_entry_id": "4f6c593d-3cc3-3c5c-9d2f-9e3d121449ed",
                        "source_sense_id": "365bc30a-1cac-359e-ac78-f29360e90c3a",
                        "target_lang_word": "Saufkumpan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saufkumpan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7042b92d-3f9f-3014-8310-2fa863be5c2d",
                                        "entry_id": "201096b1-6a4e-36b4-bfa4-fb9087633beb",
                                        "glosses": [
                                            "ein Bekannter, mit dem man öfters gemeinsam Alkohol trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1db543f-a6e4-43c6-9c74-850233ea40d8",
                                                "sense_id": "7042b92d-3f9f-3014-8310-2fa863be5c2d",
                                                "text": "Heute Abend gehe ich mit meinem alten Saufkumpanen aus."
                                            },
                                            {
                                                "example_id": "870b805e-e2e1-4a58-8fe6-ba33655c1672",
                                                "sense_id": "7042b92d-3f9f-3014-8310-2fa863be5c2d",
                                                "text": "„Er war ein sehr kunstfertiger Mensch, Poëta und Schreiber, ein guter Saufkumpan und berüchtigter Herzendieb, dazu sprach er so gut das Dänische, daß er unter Dänen als ihresgleichen galt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca1e91ea-7e51-4a72-9712-3f3567e1e7fc",
                        "source_entry_id": "4f6c593d-3cc3-3c5c-9d2f-9e3d121449ed",
                        "source_sense_id": "365bc30a-1cac-359e-ac78-f29360e90c3a",
                        "target_lang_word": "Zechbruder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zechbruder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bbc0882-deaa-3dba-9285-5fa3206a9114",
                                        "entry_id": "690241fb-46fc-3841-8e0e-b0a8cf7b1106",
                                        "glosses": [
                                            "eine Person, mit der man öfter gemeinsam Alkohol trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097da122-859a-41a0-92b6-dc4005f9abf5",
                                                "sense_id": "3bbc0882-deaa-3dba-9285-5fa3206a9114",
                                                "text": "„Anatol versäumte kein Trinkgelage bei Danilow und anderen Moskauer Zechbrüdern, trank ganze Nächte durch, bis alle anderen unter dem Tisch lagen, und zeigte sich auf allen Soireen und Bällen der ganzen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "2f10c83c-9c63-4050-9a28-8c6703d83e59",
                                                "sense_id": "3bbc0882-deaa-3dba-9285-5fa3206a9114",
                                                "text": "„Die Zechbrüder waren verschwunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01123371-f753-3618-82f2-1141ee2ba72a",
                                        "entry_id": "690241fb-46fc-3841-8e0e-b0a8cf7b1106",
