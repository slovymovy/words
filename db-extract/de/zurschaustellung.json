                "senses": [
                    {
                        "sense_id": "86d477ca-5115-315b-a118-e679a3bdd42f",
                        "entry_id": "f471d2ff-e08b-399b-9906-80555763a469",
                        "glosses": [
                            "Handlung, etwas dem Blick von anderen bewusst auszusetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3c2a8f9-91ed-419c-8225-2dba16d9ab6b",
                                "sense_id": "86d477ca-5115-315b-a118-e679a3bdd42f",
                                "text": "„Es ist, als wollte er sich für die unliebsame Zurschaustellung rächen, indem er Eos Lügen straft.“"
                            },
                            {
                                "example_id": "29f2bc3a-5c5c-499c-ba90-d45b30fa684c",
                                "sense_id": "86d477ca-5115-315b-a118-e679a3bdd42f",
                                "text": "„Schon der Verdacht des Ehebruchs oder die Zurschaustellung von Weiblichkeit werden als Verletzungen der Ehre verstanden, da der betroffene Mann nicht imstande scheint, die Ehre seiner Frau zu schützen und damit seine eigene Ehre und die seiner Solidargemeinschaft aufrechtzuerhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
