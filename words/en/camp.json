                                "target_lang_word": "лагерь",
                                "target_lang_sense_clarification": "туристический или палаточный"
                            },
                            {
                                "target_lang_word": "стоянка",
                                "target_lang_sense_clarification": "место временной остановки"
                            },
                            {
                                "target_lang_word": "кемпинг",
                                "target_lang_sense_clarification": "оборудованный лагерь для автотуристов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "营地",
                                "target_lang_sense_clarification": "户外露营的场所"
