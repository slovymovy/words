                "forms": [
                    {
                        "form_id": "2f26dfe6-3efc-49f8-a65d-a297e6c2d46c",
                        "entry_id": "0e7587ab-e81c-3ffd-9cf5-51ccfa2cffd3",
                        "tags": [
                            "plural"
                        ],
                        "form": "cholerics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe7ef5f5-9b64-3877-bc7b-8e4a41016896",
                        "entry_id": "0e7587ab-e81c-3ffd-9cf5-51ccfa2cffd3",
                        "glosses": [
                            "A person with a choleric temperament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc16ec0-88a3-42a9-8bb5-b51e42b484d8",
                                "sense_id": "fe7ef5f5-9b64-3877-bc7b-8e4a41016896",
                                "text": "The cholerics show ambition, stubbornness, love of work, courage […]"
                            },
                            {
                                "example_id": "81ab74bc-a260-4a1b-9d08-1f50c128e25f",
                                "sense_id": "fe7ef5f5-9b64-3877-bc7b-8e4a41016896",
                                "text": "1984, Tim LaHaye, Your Temperament: Discover its Potential, republished as Why You Act the Way You Do, Carol Stream, Illinois: Tyndale House, 2012,\nNo one utters more caustic comments than a sarcastic choleric!"
                            }
                        ]
                    },
                    {
                        "sense_id": "0d5a0862-c208-3b19-b85c-7d700566066f",
                        "entry_id": "0e7587ab-e81c-3ffd-9cf5-51ccfa2cffd3",
                        "glosses": [
                            "A person suffering from cholera (infectious disease)."
                        ],
                        "tags": [],
                        "examples": [
