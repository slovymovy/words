                "senses": [
                    {
                        "sense_id": "39024974-4a19-39ca-a729-8fcfcccc5d1d",
                        "entry_id": "9d814831-496d-378b-9f56-d6b509dab352",
                        "glosses": [
                            "etwas, das keinen Sinn hat; unsinnige Idee; unglaubhafte Aussage"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "7bc1cd3b-0c90-4c07-b76d-19a2145056d0",
                                "sense_id": "39024974-4a19-39ca-a729-8fcfcccc5d1d",
                                "text": "„So wie Dobrindt halten es viele seiner Berufskollegen. Ehe sie eine unbequeme Wahrheit aussprechen, geben sie lieber Bullshit von sich, schön verpackten politischen Blödsinn. Das mag strategisch geschickt sein, aber es schadet der politischen Kultur.“"
                            },
                            {
                                "example_id": "51da006d-78ca-40ff-87b0-dde33355716a",
                                "sense_id": "39024974-4a19-39ca-a729-8fcfcccc5d1d",
                                "text": "„Neben dreisten Lügen und Verschwörungstheorien nimmt der Bullshit in unserer Kultur natürlich noch viele andere Formen an: Dazu gehören die Plastikwörter der grossen Konzerne wie ‚impact‘ und ‚sustainability‘, die Manipulation mit Bildern und Wörtern im Marketing und in der Werbung, die technokratische Prosa der Politik, das Geschwurbel einiger Geistes- und Sozialwissenschafter sowie die pseudotiefsinnigen Weisheiten der Lebensberater.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88d6e924-e796-4ff8-8a92-1da4d4c68c8d",
                        "source_entry_id": "9d814831-496d-378b-9f56-d6b509dab352",
                        "source_sense_id": "39024974-4a19-39ca-a729-8fcfcccc5d1d",
