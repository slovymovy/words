                "translations": [
                    {
                        "translation_id": "ee4bbf3b-d458-480d-93b6-667c014c8d05",
                        "source_entry_id": "ca7b5e5d-97db-31b4-be3e-f35f8f2f2e8a",
                        "source_sense_id": "9196f8b2-869d-35ef-a1ca-aeb78db34849",
                        "target_lang_word": "régularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Conformité à un ordre, à des règles, soit naturelles, soit de convention ; constance ; uniformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb3e95a-0b9d-4626-a88b-3c360f87ce60",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La nourriture incrassante qu’elles recevaient de la main de leur maître, en les faisant passer peu à peu à l’état de poulardes, nuisait à la régularité de leur pondaison."
                                            },
                                            {
                                                "example_id": "09bc0616-f87a-4b54-aaad-f7a3d76b98aa",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Comme tous les édifices de cette époque, le château des comtes de Montgommery ne présentait aucune régularité. Les pères l’avaient légué à leurs fils, et chaque propriétaire avait, selon son caprice ou son besoin, ajouté quelque chose au géant de pierre."
                                            },
                                            {
                                                "example_id": "d650c4dc-17bb-4a13-9e1c-bd83119c6a70",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La régularité de ses mœurs, de sa conduite lui a mérité l’estime publique."
                                            },
                                            {
                                                "example_id": "4869a8cc-47ee-4fda-bb95-05a6c9b097b7",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Sa régularité dans son travail est parfaite, est exemplaire."
                                            },
                                            {
                                                "example_id": "ff5d0a44-20f1-432c-b951-8e1d7db21b8d",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Cet ouvrage de tapisserie, de broderie est d’une grande régularité, d’une régularité parfaite."
                                            },
                                            {
                                                "example_id": "40125173-5f38-4712-944d-8c736c0638fc",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La régularité des traits d’un visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304aaa57-99fb-3801-8e9e-08771fd79cdb",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Égalité de tous les côtés et de tous les angles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f80bd4a-b4c5-44ff-9717-5bb580026069",
                                                "sense_id": "304aaa57-99fb-3801-8e9e-08771fd79cdb",
                                                "text": "Régularité dans une figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Exacte observation des règles de chaque ordre, en parlant des ordres religieux,."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7acf6ed2-5e09-49dd-bdcf-7b3f04a6b7fc",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Les religieux de cette maison vivent dans une grande régularité."
                                            },
                                            {
                                                "example_id": "77ae6389-85d0-4533-a967-198d4ff2ec4b",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Ils observent la régularité de leur ordre."
                                            },
                                            {
                                                "example_id": "08227e48-407c-49f2-ab29-3dbfeab2144c",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "On a rétabli la régularité dans ce monastère."
                                            },
                                            {
                                                "example_id": "65798e46-a98f-460f-b5ef-eb5f9cde0ba4",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Le rétablissement de la régularité dans la plupart des monastères de notre ordre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71b07607-d896-4a0b-a621-2fb712d612e5",
                        "source_entry_id": "ca7b5e5d-97db-31b4-be3e-f35f8f2f2e8a",
                        "source_sense_id": "9196f8b2-869d-35ef-a1ca-aeb78db34849",
                        "target_lang_word": "закономе́рность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "закономе́рность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "58bf534f-2a00-3ab7-82cd-4cb2d19fd3f6",
                                        "entry_id": "5e087eac-7e62-3e29-8b23-cef908b46da2",
                                        "glosses": [
                                            "книжн. свойство по значению прилагательного закономерный; регулярность, повторяемость чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a3c4f40-8447-4f86-a5b1-44169726fb16",
                                                "sense_id": "58bf534f-2a00-3ab7-82cd-4cb2d19fd3f6",
                                                "text": "Ограничимся пока лишь указанием на самою проблему, на её закономерность, на её насущность."
                                            },
                                            {
                                                "example_id": "edcc29a2-8463-4a51-8a90-be6f8e8292f8",
                                                "sense_id": "58bf534f-2a00-3ab7-82cd-4cb2d19fd3f6",
                                                "text": "Действительно, молоко, масло и мясо каждый день покупались, а цены на них росли с неуклонной закономерностью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51c63fd-5e18-332a-b231-5f7be2e1cd7e",
                                        "entry_id": "5e087eac-7e62-3e29-8b23-cef908b46da2",
                                        "glosses": [
                                            "правомерность, оправданность, обусловленность чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6437c666-ded5-4963-8fe2-daa01c8c1658",
                                                "sense_id": "d51c63fd-5e18-332a-b231-5f7be2e1cd7e",
                                                "text": "Закономерность присутствия каждого кадра не по абстрактно ритмическому или индивидуалистически-настроенческому принципу, а по необходимости, как элемента действия, опустить который нельзя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31d1203d-8a99-395f-b45c-a54143a76833",
                                        "entry_id": "5e087eac-7e62-3e29-8b23-cef908b46da2",
                                        "glosses": [
                                            "закономерное явление; существенная, постоянно повторяющаяся взаимосвязь явлений реального мира; проявление какого-либо объективного закона, правила"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55cd876-66f5-4561-9a05-8bda75a06c9b",
                                                "sense_id": "31d1203d-8a99-395f-b45c-a54143a76833",
                                                "text": "Имея первоначальным источником материальные потребности человека, борьбу за существование, положительная наука в дальнейшем развитии ставит себе и чисто теоретические цели установления закономерности в мире явлений."
                                            },
                                            {
                                                "example_id": "5a118221-ff96-42ab-ae73-c215399157de",
                                                "sense_id": "31d1203d-8a99-395f-b45c-a54143a76833",
                                                "text": "Опыт дает нам знание только единичных случаев, которые в лучшем случае могут быть лишь частыми и повторяющимися: но по самому существу дела никакой опыт не может нам дать знания о всеобщей или необходимой закономерности."
                                            },
                                            {
                                                "example_id": "4923f890-b372-407e-a966-702e3e4eb5d4",
                                                "sense_id": "31d1203d-8a99-395f-b45c-a54143a76833",
                                                "text": "Разум должен согласить и сочетать хаотические движения и процессы мира, внести в них разумную закономерность."
                                            },
                                            {
                                                "example_id": "f7f0a2c5-acf4-4c3d-a35f-1d10b79c7a92",
                                                "sense_id": "31d1203d-8a99-395f-b45c-a54143a76833",
                                                "text": "Неистребимая привычка научного работника: во всем искать закономерности, повторяющиеся черты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cecf02c-1bc5-4524-9d6b-a8d0e924b806",
                        "source_entry_id": "ca7b5e5d-97db-31b4-be3e-f35f8f2f2e8a",
                        "source_sense_id": "b3951e41-f356-336b-ab88-50456b80cfd2",
                        "target_lang_word": "пра́вильность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пра́вильность",
