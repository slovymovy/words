                "senses": [
                    {
                        "sense_id": "6547209f-a88f-3424-8d33-dac60c6aaa2d",
                        "entry_id": "51233df6-fa64-3e6c-aae5-f54c02f944f4",
                        "glosses": [
                            "To do more than God commands."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "86fc305b-8f6f-4fc2-9607-bab9b14c01e2",
                                "sense_id": "6547209f-a88f-3424-8d33-dac60c6aaa2d",
                                "text": "They who, in their obedience, attain to the greatest height which is possible in this life, are so far from being able to supererogate, and to do more than God requires, […]"
                            },
                            {
                                "example_id": "5b258692-bdd1-40c9-b83f-a7c5f28a2abc",
                                "sense_id": "6547209f-a88f-3424-8d33-dac60c6aaa2d",
                                "text": "Were this all, therefore, or my task confined to such a relation, I should supererogate indeed in making this appearance."
                            }
                        ]
                    },
                    {
                        "sense_id": "78d9ae54-723a-3463-a319-d7a63ff5e484",
                        "entry_id": "51233df6-fa64-3e6c-aae5-f54c02f944f4",
                        "glosses": [
                            "To make up with excess for the lack prepositioned by for."
