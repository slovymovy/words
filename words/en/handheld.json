{
    "word_family": [
        "hand-held",
        "hold",
        "hand"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d33612c9-74ed-3fe5-8e44-b78c929177a1",
                    "sense_definition": "Designed to be held in the hand while being used; portable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "portable_devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer walked across the stage holding a wireless <w>handheld</w> microphone.",
                            "target_lang_translations": {
                                "it": "Il cantante ha attraversato il palco tenendo un microfono senza fili <w>a mano</w>."
                            }
                        },
                        {
                            "text": "Many gamers still enjoy playing on retro <w>handheld</w> consoles during their commute.",
                            "target_lang_translations": {
                                "it": "Molti giocatori amano ancora giocare su console <w>portatili</w> rétro durante il tragitto casa-lavoro."
                            }
                        }
                    ],
                    "synonyms": [
                        "portable"
                    ],
                    "antonyms": [
                        "stationary"
                    ],
                    "common_phrases": [
                        "handheld device",
                        "handheld console",
                        "handheld camera"
                    ],
                    "target_lang_definitions": {
                        "it": "Progettato per essere tenuto in mano durante l'uso; portatile."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "portatile",
                                "target_lang_sense_clarification": "che si può portare e usare a mano"
                            },
                            {
                                "target_lang_word": "palmare",
                                "target_lang_sense_clarification": "utilizzabile nel palmo della mano"
                            },
                            {
                                "target_lang_word": "a mano",
                                "target_lang_sense_clarification": "impugnabile a mano"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7d53535-9356-3ecf-86ec-4990fe53c0c6",
                    "sense_definition": "A small electronic device or gadget designed to be held and operated in the hand.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "portable_devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before smartphones became common, many businesspeople relied on a <w>handheld</w> to manage their schedules.",
                            "target_lang_translations": {
                                "it": "Prima che gli smartphone si diffondessero, molti professionisti si affidavano a un <w>palmare</w> per gestire i propri impegni."
                            }
                        },
                        {
                            "text": "The company introduced a new <w>handheld</w> specifically designed for inventory scanning in warehouses.",
                            "target_lang_translations": {
                                "it": "L'azienda ha introdotto un nuovo <w>dispositivo portatile</w> progettato appositamente per la scansione dell'inventario nei magazzini."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Un piccolo dispositivo elettronico progettato per essere tenuto e utilizzato comodamente con una o due mani."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "palmare",
                                "target_lang_sense_clarification": "dispositivo elettronico portatile tascabile"
                            },
                            {
                                "target_lang_word": "dispositivo portatile",
                                "target_lang_sense_clarification": "apparecchio maneggevole e compatto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}