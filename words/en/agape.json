{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "407c560a-29fc-376b-bae2-841903def7e3",
                    "sense_definition": "Wide open.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "open",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy wooden door stood <w>agape</w> after the wind blew it open.",
                            "target_lang_translations": {
                                "ru": "Тяжёлая деревянная дверь стояла <w>настежь открытой</w> после того, как её распахнул ветер."
                            }
                        },
                        {
                            "text": "He stared at the scene with his mouth <w>agape</w> in total shock.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на происходящее с <w>разинутым</w> ртом в полном шоке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mouth agape",
                        "stood agape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко раскрытый или распахнутый (часто о рте или двери)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разинутый",
                                "target_lang_sense_clarification": "о рте от удивления"
                            },
                            {
                                "target_lang_word": "распахнутый",
                                "target_lang_sense_clarification": "настежь открытый, о двери или окне"
                            },
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "широко раскрытый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6378de49-9cd0-3ffc-843e-801b447842ec",
                    "sense_definition": "In a state of astonishment, wonder, or eager attention.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astonished",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd watched <w>agape</w> as the magician performed his final trick.",
                            "target_lang_translations": {
                                "ru": "Толпа наблюдала <w>с замиранием сердца</w>, как фокусник показывал свой заключительный трюк."
                            }
                        },
                        {
                            "text": "We stood <w>agape</w> at the sight of the beautiful mountain range.",
                            "target_lang_translations": {
                                "ru": "Мы стояли <w>ошеломлённые</w> при виде прекрасного горного хребта."
                            }
                        }
                    ],
                    "synonyms": [
                        "open-mouthed",
                        "dumbstruck",
                        "wide-eyed",
                        "agog"
                    ],
                    "common_phrases": [
                        "stare agape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии крайнего изумления, ошеломления или напряжённого внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошеломлённый",
                                "target_lang_sense_clarification": "крайне поражённый"
                            },
                            {
                                "target_lang_word": "разинувший рот",
                                "target_lang_sense_clarification": "от сильного изумления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2869fd4e-0d45-3f5b-b865-636a588c6947",
                    "sense_definition": "Open wide.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "open",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cave mouth yawned <w>agape</w> in the side of the cliff.",
                            "target_lang_translations": {
                                "ru": "Вход в пещеру <w>широко</w> зиял в склоне скалы."
                            }
                        },
                        {
                            "text": "The suitcase lay <w>agape</w> on the bed with clothes spilling out.",
                            "target_lang_translations": {
                                "ru": "Чемодан лежал на кровати <w>раскрытым настежь</w>, и из него вываливалась одежда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "yawn agape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко, настежь (об открытом положении)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настежь",
                                "target_lang_sense_clarification": "полностью раскрыто"
                            },
                            {
                                "target_lang_word": "широко открыто",
                                "target_lang_sense_clarification": "о проёме, чемодане и т. д."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbb108af-cbaa-3395-a04f-ae962e1c625c",
                    "sense_definition": "In a state of astonishment or eager attention.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astonished",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists stood <w>agape</w> while watching the rare bird fly past.",
                            "target_lang_translations": {
                                "ru": "Туристы стояли <w>разинув рот</w>, наблюдая за полётом редкой птицы."
                            }
                        },
                        {
                            "text": "He looked <w>agape</w> at the screen when the news was announced.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на экран <w>ошеломлённо</w>, когда объявили новости."
                            }
                        }
                    ],
                    "synonyms": [
                        "open-mouthed",
                        "dumbstruck",
                        "wide-eyed",
                        "agog"
                    ],
                    "target_lang_definitions": {
                        "ru": "В состоянии изумления или жадного внимания (разинув рот)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разинув рот",
                                "target_lang_sense_clarification": "в сильном изумлении"
                            },
                            {
                                "target_lang_word": "ошеломлённо",
                                "target_lang_sense_clarification": "с изумлением"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f03950a0-2774-3a00-9fce-b2770bde8a07",
                    "sense_definition": "Spiritual, altruistic, beneficial love which wills good for others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "love",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher described <w>agape</w> as the highest form of selfless love.",
                            "target_lang_translations": {
                                "ru": "Философ описал <w>агапе</w> как высшую форму бескорыстной любви."
                            }
                        },
                        {
                            "text": "True <w>agape</w> requires putting the needs of others before one's own desires.",
                            "target_lang_translations": {
                                "ru": "Истинная <w>любовь к ближнему</w> требует ставить потребности других выше собственных желаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "charity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Духовная, бескорыстная, самоотверженная любовь, желающая блага другим (в христианстве и философии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агапе",
                                "target_lang_sense_clarification": "философское и богословское понятие бескорыстной любви"
                            },
                            {
                                "target_lang_word": "любовь к ближнему",
                                "target_lang_sense_clarification": "бескорыстная, жертвенная любовь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61040ea8-a3b6-3ae4-abd1-e1543f1be35c",
                    "sense_definition": "A love feast, especially one held in the early Christian Church.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "love",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early Christians gathered for an <w>agape</w> to share a meal and fellowship.",
                            "target_lang_translations": {
                                "ru": "Ранние христиане собирались на <w>агапу</w>, чтобы разделить трапезу и общение."
                            }
                        },
                        {
                            "text": "The historical study explains the significance of the <w>agape</w> in early church life.",
                            "target_lang_translations": {
                                "ru": "Историческое исследование объясняет значение <w>вечери любви</w> в жизни ранней церкви."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вечеря любви, братская трапеза у ранних христиан."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агапа",
                                "target_lang_sense_clarification": "вечеря любви у ранних христиан"
                            },
                            {
                                "target_lang_word": "вечеря любви",
                                "target_lang_sense_clarification": "христианская общая трапеза"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}