                ],
                "senses": [
                    {
                        "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                        "entry_id": "4c181ba1-2323-32cd-9907-c8261ce6af09",
                        "glosses": [
                            "Vogelfutter, (meist) aus einer Mischung von Sonnenblumenkernen, Weizen- und Haferflocken, mit Talg/Fett zu einer Kugel gepresst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51631191-6082-46e9-98b5-6f0f1931038e",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Egal ob Blaumeise, Kohlmeise oder Rotkehlchen - sie alle lieben Meisenknödel.“"
                            },
                            {
                                "example_id": "447a6175-c958-437e-b8f5-72d755488e84",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "[…] „in Gärten, in denen Menschen Körner, Nüsse oder Meisenknödel auslegen, wurden im Durchschnitt 26 Prozent mehr Vögel gesichtet als an Orten ohne Futterplatz.“"
                            },
                            {
                                "example_id": "0d4814ed-0c1c-430f-bab1-92e9e2f50e92",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Verfangen sich Vögel in den Plastiknetzen von Meisenknödeln, werden diese zur tödlichen Falle, warnen Vogelschützer.“"
                            },
                            {
                                "example_id": "ce8e3a30-420e-41c6-a84b-70de5b8da806",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Meisen lieben die Kombination aus Fett und Samen. Meisenknödel sind für sie daher ideal. Man kann sie entweder selbst herstellen oder kaufen. Allerdings sollte man keine mit Plastiknetzen auswählen. Denn daran können sich die Meisen verheddern oder verletzen.“"
                            },
                            {
                                "example_id": "9b59bc9f-02c7-4139-83d4-2f5c8e5068ce",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Selbst hergestelltes Futter wie Meisenknödel ist häufig günstiger als gekauftes.“"
                            },
                            {
                                "example_id": "b7cc61d5-948d-46a3-9b89-bb1ca8db3086",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Anstatt fertige Meisenknödel zu verwenden, kann man dieses Fettfutter einfach selbst mischen.“"
                            },
                            {
                                "example_id": "5d194d6d-a45b-4a41-979d-730f02f5a4ba",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Wer im Winter die Meisen bei ihrer Futtersuche unterstützen will, kann Meisenknödel selber machen. Als Basis dienen ungesalzenes Fett und eine Futtermischung etwa im Gewichtsverhältnis 1:1.“"
                            },
                            {
                                "example_id": "10d362ec-1356-4509-a495-476171fbe47e",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Für Körnerfresser wie Finken, Sperlinge und Ammern kann man selbst gemachte Meisenknödel anhängen.“"
                            },
                            {
                                "example_id": "26f11159-bcc3-4401-9f6a-df1608f5d048",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Ich habe da im Winter bei uns solche Meisenknödel rausgehängt, die wurden gar nicht angenommen.“"
                            },
                            {
                                "example_id": "445576ce-a3c1-4610-8367-f45108d81a5d",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "[Der Ornithologe Peter Berthold] „verfüttert im Sommer in seinem Garten bis zu 150 Meisenknödel täglich.“"
                            },
                            {
                                "example_id": "43332f84-72bc-4420-b16a-901ed1e4f0f1",
                                "sense_id": "8fc43b1f-2046-33d5-ad4b-e4502b1c6778",
                                "text": "„Zwei Jahre lang können Meisenknödel, Kerne oder Fettringe bei richtiger Lagerung bedenkenlos verfüttert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
