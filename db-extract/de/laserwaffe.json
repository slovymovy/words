                        "source_sense_id": "565dff11-0ca4-3fd9-8ff0-7f7ae36914d1",
                        "source_sense_description": "Waffe, die Laserstrahlen zur Bekämpfung feindlicher Ziele verwendet",
                        "target_lang_word": "laserwapen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laserwapen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6fae6c98-9049-34ab-bbb2-e2fa97c70cda",
                                        "entry_id": "2392d01c-3cb3-359c-bed7-3824fe4ccbbe",
                                        "glosses": [
                                            "een wapen waarbij een laser gebruikt wordt als middel om te richten of om een vijand te verblinden"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b6c72ed-0089-3514-830c-4afc810d695c",
                                        "entry_id": "2392d01c-3cb3-359c-bed7-3824fe4ccbbe",
                                        "glosses": [
                                            "een 'wapen' tegen snelheidsovertreders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de879fe2-0b46-41b9-a81f-cce1a2b53edc",
                                                "sense_id": "0b6c72ed-0089-3514-830c-4afc810d695c",
                                                "text": "De politie heeft een nieuw laserwapen dat bestand is tegen de lasershields waarmee automobilisten zich weren tegen snelheidscontroles. Dit heeft het openbaar ministerie bekendgemaakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8112e6d2-245b-3b79-aae7-21d290118c9a",
                                        "entry_id": "2392d01c-3cb3-359c-bed7-3824fe4ccbbe",
                                        "glosses": [
                                            "een wapen waarbij een laser een vijand vernietigd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513ae219-56ad-44d2-bffa-1e8fb634bfb4",
                                                "sense_id": "8112e6d2-245b-3b79-aae7-21d290118c9a",
                                                "text": "Het was technologiebedrijf Raytheon dat zich in de verspreide verklaring op de borst sloeg. Het bedrijf werkt met het Amerikaanse leger onder meer samen aan de ontwikkeling van de lasertechnologie. En nu was het een vliegende Apache AH-64-helikopter gelukt om met een Raytheon-laserwapen een onbemand voertuig op de grond onschadelijk te maken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
