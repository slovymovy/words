                "senses": [
                    {
                        "sense_id": "b8135871-9c0b-3475-a9b1-1745c0af6271",
                        "entry_id": "27e9e5ee-18cd-3457-a39b-18c5953056ed",
                        "glosses": [
                            "to find while looking intensely or attentively"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692b2310-4605-407d-8566-ee2a52b03be7",
                                "sense_id": "b8135871-9c0b-3475-a9b1-1745c0af6271",
                                "text": "Она́ угляде́ла сестру́ в толпе́.",
                                "translation": "She found her sister in the crowd.",
                                "english": "She found her sister in the crowd."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4a4d066-79c5-3ee6-bbf9-377f1ff33bb4",
                        "entry_id": "27e9e5ee-18cd-3457-a39b-18c5953056ed",
                        "glosses": [
                            "to save from the danger by watching"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "717f17b0-02f0-4760-a224-dff3569e2c94",
                                "sense_id": "c4a4d066-79c5-3ee6-bbf9-377f1ff33bb4",
                                "text": "Оте́ц не угляде́л за сы́ном и тот стал перебега́ть у́лицу с большим движе́нием.",
                                "translation": "The father missed when his son started to run across the busy street.",
                                "english": "The father missed when his son started to run across the busy street."
                            }
                        ]
                    }
                ],
