                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77003887-d628-41b9-869f-4917d882700d",
                                "sense_id": "55925925-8158-3105-b8c5-8776c2721ada",
                                "text": "Jego zwłoki leżały niepogrzebane w miejscu mordu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e7577a4-eeff-4ee8-97db-d23a2ebea49e",
                        "source_entry_id": "4e3473b9-59ee-3c1c-8312-5a499b6ffe2f",
                        "source_sense_id": "55925925-8158-3105-b8c5-8776c2721ada",
                        "target_lang_word": "unburied",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unburied",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82fbb651-53ce-38a1-8b21-502f9057e906",
                                        "entry_id": "2424d046-2803-39f5-90e7-7d578cc58788",
                                        "glosses": [
                                            "simple past and past participle of unbury"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "unburied",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b68a4a9a-84c1-360d-803b-9fb730163a6a",
                                        "entry_id": "0491df94-0ea6-31dd-bb65-4e389a1a5407",
                                        "glosses": [
                                            "Not having been buried."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb27821e-1ab1-4607-93b7-1941a2182c93",
                                                "sense_id": "b68a4a9a-84c1-360d-803b-9fb730163a6a",
                                                "text": "Titus, unkind and careless of thine own,\nWhy suffer’st thou thy sons, unburied yet,\nTo hover on the dreadful shore of Styx?"
                                            },
                                            {
                                                "example_id": "9f6f8c51-106e-4a91-8928-685306e83f80",
                                                "sense_id": "b68a4a9a-84c1-360d-803b-9fb730163a6a",
                                                "text": "1696, Arthur Gorges (translator), “The SYRENS, or Pleasures” in The Wisdom of the Ancients (De Sapientia Veterum, 1609) by Francis Bacon, p. 95,\nAnd so great were the mischiefs they did, that these Isles of the Syrens, even as far off as Man can ken them, appeared all over white with the Bones of unburied Carcasses."
                                            },
                                            {
                                                "example_id": "24726b7e-c0f0-4cd4-97bf-2e08926c3f8b",
                                                "sense_id": "b68a4a9a-84c1-360d-803b-9fb730163a6a",
                                                "text": "In the first place, I desire, that my body may lie unburied three days after my decease, or till the pleasure of my father be known concerning it."
                                            },
                                            {
                                                "example_id": "1c765561-fe0f-4562-9dc5-989c65c3c57b",
                                                "sense_id": "b68a4a9a-84c1-360d-803b-9fb730163a6a",
                                                "text": "In the direction away from the pit I saw, beyond a red-covered wall, a patch of garden ground unburied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
