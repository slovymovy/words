                    {
                        "translation_id": "5b8cea1e-23be-42fe-9a1d-992bd0107170",
                        "source_entry_id": "e83972b4-766e-3a36-ab68-8326f8bea23d",
                        "source_sense_id": "87e41b18-49a4-305c-9b47-412323954c7a",
                        "target_lang_word": "Jubilar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jubilar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95f171b6-4a21-3537-8536-f5a4d301a1ed",
                                        "entry_id": "ef174d4d-b8fc-3be6-9efc-da94c40befbb",
                                        "glosses": [
                                            "(männliche^☆) Person, die ein Jubiläum begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aafc45b-62fb-4919-bf03-839acb7ace68",
                                                "sense_id": "95f171b6-4a21-3537-8536-f5a4d301a1ed",
                                                "text": "„Dann setzte eine ganz in weiß gekleidete Jungfrau dem Jubilar einen Lorbeerkranz auf den Kopf.“"
                                            },
                                            {
                                                "example_id": "17b303ec-ebec-4a1f-a4dd-3a879da794b3",
                                                "sense_id": "95f171b6-4a21-3537-8536-f5a4d301a1ed",
                                                "text": "„Im ersten Fall wird zum Beispiel ein Jubilar nach Schlüsselerfahrungen seines Lebens befragt.“"
                                            },
                                            {
                                                "example_id": "cb568ca6-c9dc-4828-b60a-61edbbcf6620",
                                                "sense_id": "95f171b6-4a21-3537-8536-f5a4d301a1ed",
                                                "text": "„Überall standen Gäste im Alter des Jubilars, Männer in Schlips und Kragen, Frauen in schönen Blusen und Nylonstrümpfen, mit eleganten Handtaschen an Schulterriemen und diskretem Schmuck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
