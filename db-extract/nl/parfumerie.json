                                                "sense_id": "39d1d4ad-41cd-38f7-ba0e-ddf5ceca3d7d",
                                                "text": "The region supplied the parfumeries at Grasse with cultivated blossoms."
                                            },
                                            {
                                                "example_id": "b1a20941-22fe-4d29-9d1b-1a48fd5061f0",
                                                "sense_id": "39d1d4ad-41cd-38f7-ba0e-ddf5ceca3d7d",
                                                "text": "His sheep had gone further up the mountain for the summer, and he was growing crops of flowers for the parfumeries at Grasse."
                                            },
                                            {
                                                "example_id": "054fb90f-962f-4288-a1c3-0312b4bfcd35",
                                                "sense_id": "39d1d4ad-41cd-38f7-ba0e-ddf5ceca3d7d",
                                                "text": "We literally “took time to smell the roses” as the scents of the mountainside foliage far exceeded anything we had sampled in the parfumeries of Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
