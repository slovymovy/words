                            {
                                "target_lang_word": "фальшивка",
                                "target_lang_sense_clarification": "поддельный предмет или документ"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vervalsing",
                                "target_lang_sense_clarification": "opzettelijk nagemaakt object"
                            },
                            {
                                "target_lang_word": "namaak",
                                "target_lang_sense_clarification": "imitatie van een origineel"
                            },
                            {
                                "target_lang_word": "nep",
                                "target_lang_sense_clarification": "iets wat niet echt is (informeel)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4a62fba-43a2-30f9-8807-d6578678b0e8",
                    "sense_definition": "An impostor, pretender, or cheat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_fraud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man claiming to be the long-lost prince was exposed as a <w>counterfeit</w>.",
                            "target_lang_translations": {
                                "ru": "Мужчина, выдававший себя за давно потерянного принца, был разоблачён как <w>самозванец</w>.",
                                "nl": "De man die beweerde de lang verloren prins te zijn, werd ontmaskerd als een <w>bedrieger</w>."
                            }
                        },
                        {
                            "text": "He played the hero well, but in truth he was nothing more than a cowardly <w>counterfeit</w>.",
                            "target_lang_translations": {
                                "ru": "Он хорошо играл роль героя, но на самом деле был всего лишь трусливым <w>притворщиком</w>.",
                                "nl": "Hij speelde de held met verve, maar in werkelijkheid was hij niets meer dan een laffe <w>huichelaar</w>."
