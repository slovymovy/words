                            {
                                "example_id": "1523d37c-3c81-4465-854b-299a4d0cab47",
                                "sense_id": "e6a7df1a-777d-38f1-8adc-f0a7d9dcc468",
                                "text": "„Der Soldat trug einen bläulichen Mantel von Extratuch, hatte weder Tornister noch Tschako, um den Kopf hatte er eine Binde und über der Schulter hatte er eine französische Patronentasche hängen.“"
                            }
