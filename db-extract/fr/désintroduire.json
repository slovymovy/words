                "senses": [
                    {
                        "sense_id": "7b9cd81d-0f15-3026-a0c2-de8cd6b63a6d",
                        "entry_id": "7395d8c7-e658-3272-bfe7-308dc616886c",
                        "glosses": [
                            "Enlever (quelque chose qui avait été introduit)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c70deef4-339a-47e7-aab7-fd896eb7a591",
                                "sense_id": "7b9cd81d-0f15-3026-a0c2-de8cd6b63a6d",
                                "text": "une fois que mon ami haroldo de campos a introduit ces calligrammes graphiques, j’aimerais les désintroduire."
                            },
                            {
                                "example_id": "d262be33-4bde-425e-a79e-d99b6bb9d9e0",
                                "sense_id": "7b9cd81d-0f15-3026-a0c2-de8cd6b63a6d",
                                "text": "Il faudra, pour cela, la désintroduire des places financières où elle est cotée."
                            },
                            {
                                "example_id": "9cde4121-1de9-4f2e-8fcc-60529e70c9ee",
                                "sense_id": "7b9cd81d-0f15-3026-a0c2-de8cd6b63a6d",
                                "text": "Quand le catalyseur atteint les conditions nécessaires pour déclencher l’oxydation catalytique du gaz, la résistance électrique se désintroduit (après environ. 10 min.), avec la réduction des coûts énergétiques en résultant."
                            }
                        ]
                    }
