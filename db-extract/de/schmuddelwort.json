                    {
                        "sense_id": "a0b15805-844d-3f3d-9fe6-783640388e6d",
                        "entry_id": "c9c88823-5842-3b63-999f-7d90c161f8d6",
                        "glosses": [
                            "Wort, das etwas (ideologisch, sexuell…) Anstößiges bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70f2aef7-6e1e-4b0e-ab68-846764c0b371",
                                "sense_id": "a0b15805-844d-3f3d-9fe6-783640388e6d",
                                "text": "„Hier sank der Anteil der Wortmeldungen mit Schmäh- und Schmuddelwörtern von 27 auf 20 Prozent.“"
                            },
                            {
                                "example_id": "b3b47896-cd22-4796-897e-9653e311ff5f",
                                "sense_id": "a0b15805-844d-3f3d-9fe6-783640388e6d",
                                "text": "„\"Schmuddelwörter\", Schweinereien und zweideutige Andeutungen haben hier nichts zu suchen.“"
                            },
                            {
                                "example_id": "d68ae532-2e3b-4b78-af2f-3f777d889bb0",
                                "sense_id": "a0b15805-844d-3f3d-9fe6-783640388e6d",
                                "text": "„Schmuddelwörter hätten in ihrem Buch nichts verloren. “"
                            },
                            {
                                "example_id": "a4c33aff-3319-4e8f-bebe-5ca7d66df8e4",
                                "sense_id": "a0b15805-844d-3f3d-9fe6-783640388e6d",
                                "text": "„Wir besitzen einen ausgesprochen mächtigen Wortzensurfilter, welcher Schmuddelworte aber auch Sicherheitsverstöße automatisch filtert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
