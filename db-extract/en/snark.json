                "senses": [
                    {
                        "sense_id": "66df6075-03bd-3df6-b99b-991256b56885",
                        "entry_id": "b673f72e-cbf9-3838-8ba2-84235669387e",
                        "glosses": [
                            "To express oneself in a snarky fashion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67e0946d-d94d-445d-a79c-ce2c663b8596",
                                "sense_id": "66df6075-03bd-3df6-b99b-991256b56885",
                                "text": "Other would-be Bright Young People, Lytton Strachey snarked, seemed to have “just a few feathers where brains should be.”"
                            },
                            {
                                "example_id": "68d938f5-39ea-488b-ab4b-988655c932fa",
                                "sense_id": "66df6075-03bd-3df6-b99b-991256b56885",
                                "text": "Ah! That was \"snark\". You snark when your blood sugar is low. I know how to help you. Pizza. Humans seem to find calm in the consumption of food."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d5e11a4-6f12-3224-9b48-edfcb515b2c9",
