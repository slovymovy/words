                                    {
                                        "sense_id": "59a44643-b5f2-3e5b-8ce2-5b41519f82ab",
                                        "entry_id": "020a5436-839b-3c96-9fc3-96f2566141fe",
                                        "glosses": [
                                            "Composé organique dont l’un des atomes de carbone primaire porte un groupement carbonyle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c50d64-46fb-44a6-9576-0927ebe6acf3",
                                                "sense_id": "59a44643-b5f2-3e5b-8ce2-5b41519f82ab",
                                                "text": "À l’aldéhyde éthylique CH₃.CHO correspond un dérivé trichloré, CCl₃.CHO, le chloral, très employé sous forme d’hydrate."
                                            },
                                            {
                                                "example_id": "9d2fb764-6319-4865-a273-45138af77d40",
                                                "sense_id": "59a44643-b5f2-3e5b-8ce2-5b41519f82ab",
                                                "text": "L’essence d’amandes amères contient de l’acide prussique qui est toxique et qu’on enlève, et de l’aldéhyde benzoïque presque pure."
                                            },
                                            {
                                                "example_id": "4b3d0d06-dc93-45b8-83ce-0401e316edc5",
                                                "sense_id": "59a44643-b5f2-3e5b-8ce2-5b41519f82ab",
                                                "text": "Le furfurol (furfural, fural) matière première des résines furaniques, est tiré du son, de certaines parties de l’épi de maïs, etc. C’est un aldéhyde dont on obtient par hydrogénation l’alcool furfurylique (furol)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
