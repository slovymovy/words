    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7adea97f-8ad9-3b69-97b4-bcaef3ab5143",
                    "sense_definition": "Limites extrêmes d'un pays ou d'un territoire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite forteresse médiévale a été construite aux <w>confins</w> du royaume pour repousser les invasions."
                        },
                        {
                            "text": "Le village se situe aux <w>confins</w> du pays, juste avant la chaîne de montagnes."
                        }
                    ],
                    "synonyms": [
                        "frontières"
                    ],
                    "common_phrases": [
                        "aux confins du pays",
                        "aux confins de la région"
                    ]
                },
                {
                    "sense_id": "fe4820ca-3fc3-3af9-9f89-88ebdadc4456",
                    "sense_definition": "Endroits ou régions les plus lointains, les plus reculés du monde ou de l'espace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les explorateurs sont partis en expédition vers les <w>confins</w> de la Terre pour cartographier ces terres inconnues."
                        },
                        {
                            "text": "Ce puissant télescope spatial scrute les <w>confins</w> de l'univers afin de détecter des galaxies lointaines."
                        }
                    ],
                    "common_phrases": [
                        "aux confins de l'univers",
                        "aux confins du monde",
                        "aux confins de la terre"
                    ]
                },
                {
                    "sense_id": "2269c222-60f3-3ae1-ba94-ccc210c3f689",
                    "sense_definition": "Limites extrêmes d'un état psychologique, d'une situation ou d'une notion abstraite.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce récit fantastique nous entraîne aux <w>confins</w> du réel et plonge le lecteur dans un doute permanent."
                        },
                        {
                            "text": "L'artiste semblait vivre aux <w>confins</w> de la folie durant la création de son dernier tableau."
                        }
                    ],
                    "common_phrases": [
                        "aux confins du réel",
                        "aux confins de la folie"
                    ]
                },
                {
                    "sense_id": "9047db0e-6c19-37de-b679-6f9df6c386f4",
                    "sense_definition": "Limites marquant la transition d'une époque ou d'une période temporelle à une autre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette œuvre architecturale remarquable est née aux <w>confins</w> du Moyen Âge et de la Renaissance."
                        },
                        {
                            "text": "L'auteur s'intéresse aux événements politiques survenus aux <w>confins</w> de deux siècles charnières."
                        }
                    ],
                    "common_phrases": [
                        "aux confins de deux époques",
                        "aux confins des siècles"
                    ]
                }
            ]
        }
    ]
