                        "target_lang_word": "Schwabenland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwabenland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1ba9f30-aaac-3daa-b331-c37edd442689",
                                        "entry_id": "7ff36616-8843-344b-bfec-d322b9c6adbd",
                                        "glosses": [
                                            "eine Landschaft im Südwesten Deutschlands"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a027161e-fce8-4351-8136-e5b8cf7c18e9",
                                                "sense_id": "f1ba9f30-aaac-3daa-b331-c37edd442689",
                                                "text": "Stuttgart ist die Hauptstadt vom Schwabenland."
                                            },
                                            {
                                                "example_id": "374f182d-010d-40b7-98f9-87e368ff120c",
                                                "sense_id": "f1ba9f30-aaac-3daa-b331-c37edd442689",
                                                "text": "Das Schwabenland ist für seine leckere Küche bekannt."
                                            },
                                            {
                                                "example_id": "2b8faa67-7f96-475e-8587-ed57d042268a",
                                                "sense_id": "f1ba9f30-aaac-3daa-b331-c37edd442689",
                                                "text": "Mitten im Schwabenland liegt die Universitätsstadt Tübingen."
                                            },
                                            {
                                                "example_id": "f3bcfc13-f118-4ca5-ad1e-33da29cf5b8a",
                                                "sense_id": "f1ba9f30-aaac-3daa-b331-c37edd442689",
                                                "text": "Die Ausläufer der Alpen reichen bis ins Schwabenland hinein."
                                            },
                                            {
                                                "example_id": "3b65b743-dd00-4aca-9acd-7fc3ac0ec00d",
                                                "sense_id": "f1ba9f30-aaac-3daa-b331-c37edd442689",
                                                "text": "Neben großen Teilen Baden-Württembergs gehört auch ein kleinerer Teil des westlichen Bayerns zum Schwabenland."
                                            },
                                            {
                                                "example_id": "29b31027-e036-4b2a-b0fa-e454d2653a8e",
                                                "sense_id": "f1ba9f30-aaac-3daa-b331-c37edd442689",
                                                "text": "„Unterbrochen wurde die Calwer Zeit durch einen fünfjährigen Aufenthalt in Basel. Vom dritten bis zu seinem neunten Lebensjahr hat Hermann Hesse seine Kindheit in der Schweiz, nicht im Schwabenlande verbracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
