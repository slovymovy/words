                                    {
                                        "sense_id": "e0fb3435-ca97-337c-afe5-39607b3587f6",
                                        "entry_id": "a459b7c6-6ce5-3b3d-81ef-7d9de71bca1a",
                                        "glosses": [
                                            "To cajole, wheedle, or coax."
