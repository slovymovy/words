                                        "glosses": [
                                            "Pratique de certains restaurants et traiteurs qui font payer le droit d’apporter ses propres bouteilles de vin ou boissons par le client."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7a55c1-786d-4375-8104-f4514fa64abd",
                                                "sense_id": "138afb1d-0549-341b-b017-03b289eafd3a",
                                                "text": "Et enfin, le droit de bouchon traditionnel permet au client d’apporter sa bouteille de vin en échange d’une somme forfaitaire."
                                            }
                                        ]
                                    }
                                ]
                            }
