                "senses": [
                    {
                        "sense_id": "27ba7216-e76f-3eae-a9f0-3be51f3f726f",
                        "entry_id": "2eda6835-8bad-38bd-9ebc-a0cc0de08fdc",
                        "glosses": [
                            "Wertsteigerung von Kunststoffen und Kunststoffprodukten durch intelligente Bearbeitung, Verarbeitung oder Ausbesserung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47050dc9-1331-41d6-89f2-19aa9cfc14ad",
                                "sense_id": "27ba7216-e76f-3eae-a9f0-3be51f3f726f",
                                "text": "„Kunststoffveredelung ist nicht nur ein Handwerk, sondern eine unserer Passionen.“"
                            },
                            {
                                "example_id": "0d9187c8-9f37-4b49-bff0-1d6d40c0fce4",
                                "sense_id": "27ba7216-e76f-3eae-a9f0-3be51f3f726f",
                                "text": "„Die Produkte aus unserer Kunststoffveredelung werden bereits erfolgreich in zwei Unternehmen für die Faserherstellung eingesetzt: Märkische Faser GmbH, einem der führenden Polyesterfaser-Hersteller in Europa, und Märkische Plastomer GmbH.“"
                            },
                            {
                                "example_id": "097a2d16-178a-4b36-b114-0f26047178f5",
                                "sense_id": "27ba7216-e76f-3eae-a9f0-3be51f3f726f",
                                "text": "„Doch auch die Eigenschaften von Kunststoffen lassen sich durch NP-Kunststoffveredelung noch weiter verbessern.“"
                            },
                            {
                                "example_id": "6ea833af-170b-453e-b369-09ab5521e880",
                                "sense_id": "27ba7216-e76f-3eae-a9f0-3be51f3f726f",
                                "text": "„Im Bereich der Kunststoffveredelung bietet Cetelon eine Vielzahl von Systemen an, die sich für hochbeanspruchbare Einsatzgebiete - mit hoher Resistenz gegenüber den umgebenden Medien - auszeichnen.“"
                            },
                            {
                                "example_id": "b47cc18e-55e1-4e77-9614-0b7043dd73b5",
                                "sense_id": "27ba7216-e76f-3eae-a9f0-3be51f3f726f",
                                "text": "„Um die Kunden umfassend über die Möglichkeiten der Anwendung von Effektpigmenten in der Kunststoffveredelung zu informieren, werden regelmäßig neue Tools entwickelt und neue Verfahren und Produktionsabäufe - auch gemeinsam mit einem Kunden - erarbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
