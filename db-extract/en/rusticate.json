                                "target_senses": [
                                    {
                                        "sense_id": "fe4d4a75-6b17-3f33-8016-e26f90135514",
                                        "entry_id": "db1d147a-da63-3bcb-81b4-172cbef2ee15",
                                        "glosses": [
                                            "jemanden zwangsweise aus der Matrikel (dem Verzeichnis der Studierenden einer Hochschule) streichen; eine studierende Person gegen ihren Willen bei einer Universität, Hochschule oder Akademie abmelden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc799c0-120b-4ce1-8ae0-6c1429433e30",
                                                "sense_id": "fe4d4a75-6b17-3f33-8016-e26f90135514",
                                                "text": "„Nachdem SPIEGEL ONLINE darüber berichtet hatte, dass die Universität zu Köln gerade 32 Diplom- und Magisterstudenten zwangsexmatrikuliert hatte, meldeten sich zahlreiche Betroffene in der Redaktion.“"
                                            },
                                            {
                                                "example_id": "d251d826-fe91-47d5-bde4-5775e067f091",
                                                "sense_id": "fe4d4a75-6b17-3f33-8016-e26f90135514",
                                                "text": "„‚Über 6000 Hochschullehrende und 1500 Verwaltungsangestellte an 122 Universitäten wurden ohne Gerichtsbeschluss gefeuert und abertausende Studierende zwangsexmatrikuliert‘, so Ghawami.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
