                        "glosses": [
                            "Lizenz, die benötigt wird um ein Spielkasino betreiben zu dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "407e00eb-694a-48a5-bae4-305aae1ac036",
                                "sense_id": "e782cc0e-634f-3365-82f2-553012a2cf02",
                                "text": "„Alles steht und fällt mit der Erteilung der Kasinolizenz im Palais Schwarzenberg nahe der Wiener Innenstadt: Die Familienstiftung Schwarzenberg hat einen Masterplan für das Palais und den rund acht Hektar großen Park entwickelt.“"
                            },
                            {
                                "example_id": "71f11b9c-7bf4-4ae2-ac8e-23c277749abe",
                                "sense_id": "e782cc0e-634f-3365-82f2-553012a2cf02",
                                "text": "„Grund dafür war der Entzug der Kasinolizenz in Argentinien und die dadurch nötig gewordene 40-Millionen-Geldspritze für die Auslandstochter CAI.“"
                            }
