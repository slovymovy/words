                "senses": [
                    {
                        "sense_id": "a8a3189d-5167-3307-9489-0ba62c527426",
                        "entry_id": "b99b04ad-371d-370d-b11e-4c0cb3cebf48",
                        "glosses": [
                            "Sofa, das mit Leder bezogen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2554e06a-5f37-4cca-8710-35ad8d9ff502",
                                "sense_id": "a8a3189d-5167-3307-9489-0ba62c527426",
                                "text": "„Serdal Ö. sitzt im Wohnzimmer auf dem schwarzen Ledersofa und spricht über das Leben danach.“"
                            },
                            {
                                "example_id": "fea6512e-eef5-4107-b632-fdca925be6fe",
                                "sense_id": "a8a3189d-5167-3307-9489-0ba62c527426",
                                "text": "„Er stellt die Schale mit den Süßigkeiten auf den Wohnzimmertisch aus weißem Marmor und lässt sich auf das Ledersofa fallen.“"
                            },
                            {
                                "example_id": "48084a3a-cd83-413a-8470-3768fe948569",
                                "sense_id": "a8a3189d-5167-3307-9489-0ba62c527426",
                                "text": "„Überall, an niedrigen Paneelen hin, standen lange, längst eingesessene Ledersofas mit kleinen und großen Tischen davor, und nur eine Stelle war da, wo dieses Mobiliar fehlte.“"
                            },
                            {
                                "example_id": "5a1ceae6-e5b1-4b48-b849-e2c1586ee979",
                                "sense_id": "a8a3189d-5167-3307-9489-0ba62c527426",
                                "text": "„Manche saßen auf dem schwarzen Ledersofa, andere an dem großen Esstisch, aber niemand blickte auf, als sie eintrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
