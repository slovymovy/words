                ],
                "senses": [
                    {
                        "sense_id": "c3e9ea05-dccd-30e3-922b-10cda43d039c",
                        "entry_id": "974f4de4-e2f8-33a2-b55c-4eda197e17c7",
                        "glosses": [
                            "Katholizismus: Kind, das zur Erstkommunion geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1ff05fa-c351-4211-9fbc-54a3cf13fdc0",
                                "sense_id": "c3e9ea05-dccd-30e3-922b-10cda43d039c",
                                "text": "„An diesem Wochenende wird in St. Andreas die Erstkommunion für etwa 60 Kommunionskinder gefeiert.“"
                            },
                            {
                                "example_id": "eded46c3-de71-4256-9d3f-0d0e7a5ed553",
                                "sense_id": "c3e9ea05-dccd-30e3-922b-10cda43d039c",
                                "text": "„Wenn das Kommunionskind mit seiner weißen Kerze in die Kirche zieht.“"
                            },
                            {
                                "example_id": "237af564-2a3e-45ee-a864-14f568702646",
                                "sense_id": "c3e9ea05-dccd-30e3-922b-10cda43d039c",
                                "text": "„Am nächsten Tag fahren Sergio und seine Familie nach Venetien zu den Eltern, um das Kommunionskind vorzustellen.“"
                            },
                            {
                                "example_id": "e9e4b3db-53b4-469f-b010-a985628b0ea7",
                                "sense_id": "c3e9ea05-dccd-30e3-922b-10cda43d039c",
                                "text": "„Am 23. April 2010 besuchten die »Kommunionskinder« aus Markgrafneusiedl den im Gewerbegebiet ansässigen Betrieb »Fischerbrot«.“"
                            },
                            {
                                "example_id": "8712d74a-7120-4e38-92c6-16837eb2eaba",
                                "sense_id": "c3e9ea05-dccd-30e3-922b-10cda43d039c",
                                "text": "„Kardinal Wetter begrüßt Benedikt XVI. anschließend zur Vesper, zu der junge Familien mit Kommunionskindern, Katecheten und Religionslehrer eingeladen sind.“"
                            },
                            {
                                "example_id": "4227b07d-f983-4610-96aa-e9f96f0e75b6",
                                "sense_id": "c3e9ea05-dccd-30e3-922b-10cda43d039c",
                                "text": "„Die Dorfgemeinschaft spendete an die Konfirmanden und Kommunionskinder aus Rossach wieder acht Obstbäume, die unter fachkundiger Leitung gepflanzt wurden - …“"
                            },
                            {
                                "example_id": "8bfe35d1-2db1-490e-bf19-7c2a8c55cc88",
                                "sense_id": "c3e9ea05-dccd-30e3-922b-10cda43d039c",
                                "text": "„Seit September 2008 haben sich die 36 Kommunionskinder von St. Josef auf diesen Tag vorbereitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
