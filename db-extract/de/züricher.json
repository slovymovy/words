                        "examples": [
                            {
                                "example_id": "8b27ff1e-34d5-42c5-9b30-dcf10c095dd9",
                                "sense_id": "f91d035b-40bc-377f-81e4-9b895b3bcd61",
                                "text": "„Marcel Koller ist ab 1. November neuer Teamchef der österreichischen Nationalmannschaft. Doch wie kam es eigentlich zum Engagement des gebürtigen Zürichers?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cc45752b-722f-370a-a940-7891797e1dc7",
                        "entry_id": "fef29f80-35cb-3808-b484-590ec27390ae",
                        "glosses": [
                            "Einwohner des Kantons Zürich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d8d745-031e-48bc-9bda-34c8fe4edb1e",
                                "sense_id": "cc45752b-722f-370a-a940-7891797e1dc7",
                                "text": "Der ganze Kanton ist aufgerufen, zu helfen. Jeder Züricher kann einen Beitrag leisten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
