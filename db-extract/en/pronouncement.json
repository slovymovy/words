                            "plural"
                        ],
                        "form": "pronouncements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67998009-699e-3fa9-8b25-fa70764cc5eb",
                        "entry_id": "8959b16e-6675-3512-b546-2379a641e170",
                        "glosses": [
                            "An official public announcement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd28e759-7112-410c-b23b-316617a81263",
                                "sense_id": "67998009-699e-3fa9-8b25-fa70764cc5eb",
                                "text": "The trial concluded with the pronouncement of a guilty verdict."
                            }
                        ]
                    },
                    {
                        "sense_id": "d71f9392-955f-34f5-b99d-a4f4022bff69",
                        "entry_id": "8959b16e-6675-3512-b546-2379a641e170",
                        "glosses": [
                            "An utterance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a296e600-53d1-4b43-a1c5-0a30980555b8",
                                "sense_id": "d71f9392-955f-34f5-b99d-a4f4022bff69",
                                "text": "Though Bane’s sing-song voice gives his pronouncements a funny lilt, he doesn’t have any of the Joker’s deranged wit, and Nolan isn’t interested in undercutting his seriousness for the sake of a breezier entertainment."
                            },
                            {
                                "example_id": "42b31d47-07e0-4388-9d6f-5aff912adcc9",
                                "sense_id": "d71f9392-955f-34f5-b99d-a4f4022bff69",
                                "text": "His pronouncements carried great authority, but his physical difficulties often caused them to be enigmatic in their brevity."
                            },
                            {
                                "example_id": "93221ce2-3b15-4e75-81e6-2610b27fda63",
                                "sense_id": "d71f9392-955f-34f5-b99d-a4f4022bff69",
                                "text": "This grinchy pronouncement by the president had the value of being truthful."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "693a08e3-a3e8-4309-b487-9043e59aec09",
                        "source_entry_id": "8959b16e-6675-3512-b546-2379a641e170",
                        "source_sense_description": "an official public announcement",
                        "target_lang_word": "oświadczenie",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oświadczenie",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2dc465-8549-3916-9aee-31f0036fde49",
                                        "entry_id": "7e2ecb02-2aed-3c69-93a4-0f1f0f74a538",
                                        "glosses": [
                                            "oficjalna wypowiedź przedstawiająca czyjś punkt widzenia, stan wiedzy o czymś lub wolę oświadczającego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5253be9f-1657-4359-b200-3523c5152128",
                                                "sense_id": "ff2dc465-8549-3916-9aee-31f0036fde49",
                                                "text": "Na konferencji prasowej premier wygłosił oświadczenie w sprawie zmian w systemie emerytalnym."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "74fdd040-133d-3c4d-bc5b-729eae6e815f",
                                        "entry_id": "7e2ecb02-2aed-3c69-93a4-0f1f0f74a538",
                                        "glosses": [
                                            "pismo zawierające oświadczenie (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9931d150-c3f2-4de7-b9fd-cc8876628a82",
                                                "sense_id": "74fdd040-133d-3c4d-bc5b-729eae6e815f",
                                                "text": "Do oferty pracy należy obowiązkowo dołączyć oświadczenia o stanie zdrowia kandydata, niekaralności i zgodzie na przetwarzanie danych osobowych."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29919514-576a-4960-9ab5-a33bbcf89a3b",
                        "source_entry_id": "8959b16e-6675-3512-b546-2379a641e170",
                        "source_sense_description": "an official public announcement",
                        "target_lang_word": "заявле́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "заявле́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f99fdafb-ac4c-346b-ae56-8b85f1615af2",
                                        "entry_id": "6314ee69-10bd-3762-8c89-1e442165ba4a",
                                        "glosses": [
                                            "официальное высказывание, сообщение в устной или письменной форме с изложением точки зрения по какому-либо вопросу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d15ac7-0251-4556-afec-c02ecf648976",
                                                "sense_id": "f99fdafb-ac4c-346b-ae56-8b85f1615af2",
                                                "text": "По крайней мере все, для которых ясны вздорность и лживость уверений, в таких случаях тотчас же отходят в сторону от таких ораторов, вокруг которых остаётся только доверчивая толпа слушателей, мало понимающая в деле, не замечающая ни грубой лести, ни лживых заявлений и потому легко поддающаяся внушению."
                                            },
                                            {
                                                "example_id": "0d7a8e87-511a-4f94-b64d-da3b51fc4919",
                                                "sense_id": "f99fdafb-ac4c-346b-ae56-8b85f1615af2",
                                                "text": "Во всех этих случаях составление проектов и практическое исполнение их лежит на плечах техника; роль же гигиениста ограничивается заявлением известных требований, с которыми и должно сообразоваться техническое искусство: санитарный техник, сколько бы он ни работал на этом поприще, никогда не будет гигиенистом, и гигиенист, со своей стороны, никогда не будет техником, ― он освещает лишь техническое предприятие светом своей науки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4667d3-b207-39c7-b28a-53eb961d9fcc",
                                        "entry_id": "6314ee69-10bd-3762-8c89-1e442165ba4a",
                                        "glosses": [
                                            "официальное обращение, письменная просьба о чём-либо, составленная по установленной форме и подаваемая на имя должностного лица в учреждение, организацию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0295acac-1f11-4c84-9aba-724ef6d9f60c",
                                                "sense_id": "6a4667d3-b207-39c7-b28a-53eb961d9fcc",
                                                "text": "Дело в том, что когда я подал заявление прокурору о деятельности Шальнова, то Шальнов подал, так сказать, встречную жалобу, прося прокуратуру признать меня его соучастником."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2af3275-3577-3262-b6c2-99a9a52cdc42",
                                        "entry_id": "6314ee69-10bd-3762-8c89-1e442165ba4a",
                                        "glosses": [
                                            "устар. проявление, выражение каких-либо чувств"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
