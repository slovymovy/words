                                                "sense_id": "17003a33-2a6c-36ac-a878-bc2a033c3f05",
                                                "text": "Die meisten Passionsblumen stammen aus Südamerika."
                                            },
                                            {
                                                "example_id": "6f44df3a-9047-451f-9760-046a11e9c697",
                                                "sense_id": "17003a33-2a6c-36ac-a878-bc2a033c3f05",
                                                "text": "Die Früchte einiger Passionsblumen werden als Maracuja gehandelt."
                                            }
