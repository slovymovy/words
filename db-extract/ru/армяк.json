                "senses": [
                    {
                        "sense_id": "0565bfff-ffd5-3be3-8e7d-53bb45060514",
                        "entry_id": "0e06b749-ce81-3237-90fb-4b5fe356760d",
                        "glosses": [
                            "истор. крестьянская верхняя мужская одежда из грубого сукна в виде халата или прямого долгополого кафтана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f9b95e-cf74-4d12-911b-3fe19ed8225b",
                                "sense_id": "0565bfff-ffd5-3be3-8e7d-53bb45060514",
                                "text": "На нем был синий армяк, подпоясанный красным кушаком."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3d8bb82-fb34-475f-bf24-3f6bef0c7265",
                        "source_entry_id": "0e06b749-ce81-3237-90fb-4b5fe356760d",
