                                                "example_id": "692f9073-bb8e-424d-8613-6670ece56d59",
                                                "sense_id": "c3d3f2a4-c7b7-39a8-b458-226a9f69ce1d",
                                                "text": "Jeder hat das Recht auf ein Bankkonto."
