                "senses": [
                    {
                        "sense_id": "2b3be2ef-64ef-313d-87ac-776b9d650a11",
                        "entry_id": "935e6f8c-f6eb-3ec7-9c5a-df2652262cc0",
                        "glosses": [
                            "een winkel waar je boeken kunt kopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6135a4dd-6584-4ea5-998c-f70220a8bc7d",
                                "sense_id": "2b3be2ef-64ef-313d-87ac-776b9d650a11",
                                "text": "- „Waar ik mezelf echt moet bedwingen om niet te veel uit te geven is de boekenwinkel. Ik lees heel graag, van Haruki Murakami tot Marianne Fredriksson. Ik vind het echt een feest om naar een boekenwinkel te gaan. Tegenwoordig hebben ze er ook vaak een koffiebarretje bij, dat is helemaal gevaarlijk. Ik kom zo elke twee maanden met een aantal nieuwe boeken thuis.”"
                            }
                        ]
                    }
