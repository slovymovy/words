                    {
                        "translation_id": "d256a186-016e-40f1-9ba1-e00770c77c9b",
                        "source_entry_id": "d96819b1-df97-3e62-a2e9-e09ec309bfb2",
                        "source_sense_description": "utter or out-and-out",
                        "target_lang_word": "vollkommen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vollkommen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce9a71c7-d81c-3cdf-9ed0-336720c7e3e8",
                                        "entry_id": "edfc50ef-a750-3555-b8ef-ae3618aac287",
                                        "glosses": [
                                            "perfekt, ganz ohne Fehler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e25f886c-a4a1-4da8-b159-54f52c98d4ff",
                                                "sense_id": "ce9a71c7-d81c-3cdf-9ed0-336720c7e3e8",
                                                "text": "\"Köln ist nicht perfekt, aber vollkommen, es ist vollkommen Köln.\""
                                            },
                                            {
                                                "example_id": "60d40e8e-ff3e-4a37-b215-6b5295f2eb34",
                                                "sense_id": "ce9a71c7-d81c-3cdf-9ed0-336720c7e3e8",
                                                "text": "Das vollkommene Werk begeistert alle Zuseher."
                                            },
                                            {
                                                "example_id": "66822792-9bce-434a-bc57-a96d636e3520",
                                                "sense_id": "ce9a71c7-d81c-3cdf-9ed0-336720c7e3e8",
                                                "text": "„Anselm von Canterbury entwarf die erste und bekannteste Version des ontologischen Gottesbeweises: Gott ist definiert als das vollkommenste Wesen, über das hinaus nichts Vollkommeneres gedacht werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "304e92bb-7184-3809-aa70-21fd1ec0db6b",
                                        "entry_id": "edfc50ef-a750-3555-b8ef-ae3618aac287",
                                        "glosses": [
                                            "ohne eine Ausnahme"
                                        ],
                                        "tags": [
                                            "adverbielle Verwendung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a7a6dc9-7286-497f-b338-ccb8b5754c7f",
                                                "sense_id": "304e92bb-7184-3809-aa70-21fd1ec0db6b",
                                                "text": "Ich bin auch vollkommen deiner Meinung."
                                            },
                                            {
                                                "example_id": "ad0c9ff6-956e-40ba-bc10-66b3378454aa",
                                                "sense_id": "304e92bb-7184-3809-aa70-21fd1ec0db6b",
                                                "text": "Ach was, das ist doch vollkommen irrelevant."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55528530-a9cb-4e22-8d37-4cf427feb7b9",
                        "source_entry_id": "d96819b1-df97-3e62-a2e9-e09ec309bfb2",
