                        "sense_id": "699d1ac4-0035-35e0-86fe-ce05afbb020e",
                        "entry_id": "c4e3632d-270c-3375-9ca8-cc56e981ccb3",
                        "glosses": [
                            "A tortilla or chapati wrap filled with meat (usually doner kebab meat; seasoned lamb or mutton), chips and cheese."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "242e9935-eef5-42ae-9ad7-c2d626edc26c",
                                "sense_id": "699d1ac4-0035-35e0-86fe-ce05afbb020e",
                                "text": "Known as a \"hoagie\", the combination of chips, doner kebab meat and cheese - which contains 136g of fat and 1224 calories - has been identified as the unhealthiest fastfood meal served to pupils in a recent survey."
                            },
                            {
                                "example_id": "70c16069-d907-4a83-80de-b29676fd3769",
                                "sense_id": "699d1ac4-0035-35e0-86fe-ce05afbb020e",
                                "text": "Many of my early paychecks from waitressing at 15 were spent on hoagies; fat and sauce dripping down my chin as the beige delights in the wrap merged together to create a wrong-but-right finished product."
                            }
                        ]
                    }
                ],
