{
    "word_family": [
        "shady",
        "shadiness",
        "sunshade",
        "lampshade",
        "eyeshadow",
        "unshade",
        "shader",
        "shading"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                    "sense_definition": "Darkness or coolness caused by something blocking direct light, especially sunlight.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat in the <w>shade</w> of the large oak tree to cool down.",
                            "target_lang_translations": {
                                "ru": "Мы сидели в <w>тени</w> большого дуба, чтобы остыть.",
                                "zh": "我们坐在大橡树的<w>阴凉</w>处纳凉。"
                            }
                        },
                        {
                            "text": "The temperature is much higher in the sun than in the <w>shade</w>.",
                            "target_lang_translations": {
                                "ru": "Температура на солнце гораздо выше, чем в <w>тени</w>.",
                                "zh": "阳光下的温度比<w>阴凉</w>处高得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shadow",
                        "darkness"
                    ],
                    "common_phrases": [
                        "in the shade",
                        "shade tree",
                        "seek shade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темнота или прохлада, создаваемая объектом, блокирующим прямой свет.",
                        "zh": "由物体遮挡直接光线（特别是阳光）而形成的黑暗或凉爽区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "отсутствие света"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴凉",
                                "target_lang_sense_clarification": "遮阳处"
                            },
                            {
                                "target_lang_word": "树荫",
                                "target_lang_sense_clarification": "树下的阴凉处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                    "sense_definition": "A particular variety of a color, especially regarding how light or dark it is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She painted her bedroom a lovely pastel <w>shade</w> of green.",
                            "target_lang_translations": {
                                "ru": "Она покрасила свою спальню в приятный пастельный <w>оттенок</w> зелёного.",
                                "zh": "她把卧室漆成了可爱的淡绿色<w>色调</w>。"
                            }
                        },
                        {
                            "text": "I need a darker <w>shade</w> of lipstick to match this dress.",
                            "target_lang_translations": {
                                "ru": "Мне нужен более тёмный <w>оттенок</w> помады под это платье.",
                                "zh": "我需要一种颜色更深的口红<w>色调</w>来搭配这条裙子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tint",
                        "hue",
                        "tone",
                        "color",
                        "nuance"
                    ],
                    "common_phrases": [
                        "shade of blue",
                        "darker shade",
                        "lighter shade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность цвета, отличающаяся степенью светлоты или насыщенности.",
                        "zh": "颜色的特定种类，尤指其明暗程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "цвета"
                            },
                            {
                                "target_lang_word": "тон",
                                "target_lang_sense_clarification": "цветовой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "色调",
                                "target_lang_sense_clarification": "色彩的明暗或浓淡"
                            },
                            {
                                "target_lang_word": "深浅",
                                "target_lang_sense_clarification": "颜色的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1c999ad-4bb7-35a2-8993-ecda66de1753",
                    "sense_definition": "A sheet of material that can be pulled down to cover a window and block light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please pull down the <w>shade</w> because the sun is in my eyes.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, опусти <w>штору</w>, а то солнце светит мне в глаза.",
                                "zh": "请把<w>窗帘</w>拉下来，阳光晃得我睁不开眼。"
                            }
                        },
                        {
                            "text": "The window <w>shade</w> snapped up loudly when he let go of it.",
                            "target_lang_translations": {
                                "ru": "Оконная <w>штора</w> с громким щелчком свернулась, когда он отпустил её.",
                                "zh": "他一松手，<w>窗帘</w>就哗啦一声弹了上去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blind"
                    ],
                    "common_phrases": [
                        "window shade",
                        "pull the shade",
                        "raise the shade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотная занавеска или жалюзи, закрывающие окно от света.",
                        "zh": "可以拉下来遮住窗户以阻挡光线的帘子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штора",
                                "target_lang_sense_clarification": "оконная"
                            },
                            {
                                "target_lang_word": "рулонная штора",
                                "target_lang_sense_clarification": "тип занавески"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窗帘",
                                "target_lang_sense_clarification": "遮光帘"
                            },
                            {
                                "target_lang_word": "遮光帘",
                                "target_lang_sense_clarification": "专门遮光的帘子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3593da2-9e71-375c-8609-8c64dec48ad5",
                    "sense_definition": "A cover placed around or over a light bulb to direct or soften the light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lamp has a beautiful silk <w>shade</w> with a floral pattern.",
                            "target_lang_translations": {
                                "ru": "У лампы красивый шёлковый <w>абажур</w> с цветочным узором.",
                                "zh": "这盏灯有一个漂亮的花卉图案丝绸<w>灯罩</w>。"
                            }
                        },
                        {
                            "text": "He accidentally broke the glass <w>shade</w> while moving the furniture.",
                            "target_lang_translations": {
                                "ru": "Он случайно разбил стеклянный <w>плафон</w>, когда передвигал мебель.",
                                "zh": "他在搬家具时，不小心打碎了玻璃<w>灯罩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lampshade"
                    ],
                    "common_phrases": [
                        "lamp shade",
                        "glass shade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Колпак для лампы, рассеивающий или направляющий свет.",
                        "zh": "放置在灯泡周围或上方，用于引导或柔化光线的罩子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абажур",
                                "target_lang_sense_clarification": "лампы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灯罩",
                                "target_lang_sense_clarification": "灯具配件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                    "sense_definition": "A very slight difference or degree of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are many subtle <w>shades</w> of meaning in this poem.",
                            "target_lang_translations": {
                                "ru": "В этом стихотворении много тонких <w>нюансов</w> смысла.",
                                "zh": "这首诗的含义中包含许多<w>细微差别</w>。"
                            }
                        },
                        {
                            "text": "The new computer model is just a <w>shade</w> faster than the old one.",
                            "target_lang_translations": {
                                "ru": "Новая модель компьютера лишь на <w>чуточку</w> быстрее старой.",
                                "zh": "新款电脑比旧款只快了<w>一点点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nuance",
                        "degree",
                        "trace",
                        "hint"
                    ],
                    "common_phrases": [
                        "shade of meaning",
                        "shade of difference",
                        "a shade better"
                    ],
                    "target_lang_definitions": {
                        "ru": "Едва заметное различие или степень проявления чего-либо.",
                        "zh": "事物之间极其细微的差别或程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нюанс",
                                "target_lang_sense_clarification": "тонкое различие"
                            },
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "细微差别",
                                "target_lang_sense_clarification": "含义上的细微不同"
                            },
                            {
                                "target_lang_word": "一点点",
                                "target_lang_sense_clarification": "程度上的微小差异"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                    "sense_definition": "Subtle or indirect expression of disrespect or contempt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to throw <w>shade</w> at her rival during the interview.",
                            "target_lang_translations": {
                                "ru": "Она решила отпустить <w>колкость</w> в адрес своей соперницы во время интервью.",
                                "zh": "她在采访中决定对竞争对手进行<w>挖苦</w>。"
                            }
                        },
                        {
                            "text": "I mean no <w>shade</w>, but that outfit does not fit the occasion.",
                            "target_lang_translations": {
                                "ru": "Не в <w>обиду</w> сказано, но этот наряд не подходит для такого случая.",
                                "zh": "我不是要<w>讽刺</w>你，但这身装扮确实不适合这个场合。"
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "dig"
                    ],
                    "common_phrases": [
                        "throw shade",
                        "no shade"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "originated in drag culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытое или косвенное выражение неуважения.",
                        "zh": "含蓄或间接地表达不尊重或轻蔑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колкость",
                                "target_lang_sense_clarification": "замечание"
                            },
                            {
                                "target_lang_word": "шпилька",
                                "target_lang_sense_clarification": "острое замечание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖苦",
                                "target_lang_sense_clarification": "言语上的讽刺"
                            },
                            {
                                "target_lang_word": "讽刺",
                                "target_lang_sense_clarification": "隐晦的嘲讽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                    "sense_definition": "A ghost or spirit of a dead person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero descended into the underworld to speak with the <w>shade</w> of his father.",
                            "target_lang_translations": {
                                "ru": "Герой спустился в подземный мир, чтобы поговорить с <w>тенью</w> своего отца.",
                                "zh": "英雄降临冥界，与他父亲的<w>幽灵</w>交谈。"
                            }
                        },
                        {
                            "text": "He felt haunted by the <w>shade</w> of his past mistakes.",
                            "target_lang_translations": {
                                "ru": "Ему казалось, что его преследует <w>призрак</w> прошлых ошибок.",
                                "zh": "他感到自己被过去错误的<w>幽灵</w>所纠缠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ghost",
                        "spirit",
                        "specter",
                        "phantom"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly literary or mythological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дух или призрак умершего человека.",
                        "zh": "死者的灵魂或鬼魂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "призрак"
                            },
                            {
                                "target_lang_word": "призрак",
                                "target_lang_sense_clarification": "дух"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幽灵",
                                "target_lang_sense_clarification": "亡魂"
                            },
                            {
                                "target_lang_word": "鬼魂",
                                "target_lang_sense_clarification": "死者的灵魂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc678a51-ebfd-3e9c-b120-8958d10e0dff",
                    "sense_definition": "An aspect or quality that reminds one of something else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political scandal had <w>shades</w> of the events from the previous decade.",
                            "target_lang_translations": {
                                "ru": "Этот политический скандал имел <w>отголоски</w> событий прошлого десятилетия.",
                                "zh": "这起政治丑闻带有十年前事件的<w>影子</w>。"
                            }
                        },
                        {
                            "text": "There were <w>shades</w> of his grandfather in the way he laughed.",
                            "target_lang_translations": {
                                "ru": "В том, как он смеялся, проскальзывало <w>напоминание</w> о его дедушке.",
                                "zh": "他笑起来的样子里有他祖父的<w>影子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "echoes",
                        "reminders"
                    ],
                    "common_phrases": [
                        "shades of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аспект или качество, напоминающее о чем-то другом.",
                        "zh": "让人联想到其他事物的方面或特质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отголосок",
                                "target_lang_sense_clarification": "напоминание"
                            },
                            {
                                "target_lang_word": "напоминание",
                                "target_lang_sense_clarification": "сходство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "影子",
                                "target_lang_sense_clarification": "比喻过去的痕迹"
                            },
                            {
                                "target_lang_word": "余韵",
                                "target_lang_sense_clarification": "残留的印象"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0cc0e27-f792-3ecd-a438-a6018f073596",
                    "sense_definition": "To protect or screen someone or something from direct light or heat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She raised her hand to <w>shade</w> her eyes from the bright sun.",
                            "target_lang_translations": {
                                "ru": "Она подняла руку, чтобы <w>заслонить</w> глаза от яркого солнца.",
                                "zh": "她举起手来<w>遮挡</w>刺眼的阳光。"
                            }
                        },
                        {
                            "text": "The large umbrella will <w>shade</w> the picnic table perfectly.",
                            "target_lang_translations": {
                                "ru": "Большой зонт отлично <w>затенит</w> стол для пикника.",
                                "zh": "大遮阳伞能完美地为野餐桌<w>遮蔽</w>阳光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "screen",
                        "shield",
                        "cover",
                        "block",
                        "protect"
                    ],
                    "antonyms": [
                        "unshade"
                    ],
                    "common_phrases": [
                        "shade eyes",
                        "shade from the sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищать или закрывать от прямого света.",
                        "zh": "保护或遮挡某人或某物，使其免受直接光线或热量的照射。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заслонять",
                                "target_lang_sense_clarification": "от света"
                            },
                            {
                                "target_lang_word": "затенять",
                                "target_lang_sense_clarification": "создавать тень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遮挡",
                                "target_lang_sense_clarification": "阻挡光线"
                            },
                            {
                                "target_lang_word": "遮蔽",
                                "target_lang_sense_clarification": "使处于阴影中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62c0e87a-a071-3117-bc94-00e81968de3b",
                    "sense_definition": "To make parts of a drawing or painting darker to create the effect of depth or shadow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>shade</w> the circle carefully to make it look like a sphere.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно аккуратно <w>заштриховать</w> круг, чтобы он выглядел как шар.",
                                "zh": "你需要仔细地为圆圈<w>打阴影</w>，使其看起来像个球体。"
                            }
                        },
                        {
                            "text": "The artist began to <w>shade</w> in the background with charcoal.",
                            "target_lang_translations": {
                                "ru": "Художник начал <w>затушёвывать</w> фон углём.",
                                "zh": "艺术家开始用木炭为背景<w>涂阴影</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "darken",
                        "hatch"
                    ],
                    "common_phrases": [
                        "shade in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затемнять участки рисунка для придания объема.",
                        "zh": "通过加深绘画或素描的某些部分来营造深度或阴影效果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заштриховывать",
                                "target_lang_sense_clarification": "рисунок"
                            },
                            {
                                "target_lang_word": "тушевать",
                                "target_lang_sense_clarification": "накладывать тени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涂阴影",
                                "target_lang_sense_clarification": "绘画技法"
                            },
                            {
                                "target_lang_word": "打阴影",
                                "target_lang_sense_clarification": "增加立体感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2923ee8-c636-3e5e-a3a9-bca0b9244e7b",
                    "sense_definition": "To insult someone in a subtle or indirect way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fans believe the singer intended to <w>shade</w> her ex-boyfriend in the new song.",
