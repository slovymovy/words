                {
                    "sense_id": "77c31caa-44cc-3645-acc4-2cca553243d1",
                    "sense_definition": "Vente publique au cours de laquelle un bien est adjugé à la personne qui en offre le prix le plus élevé (souvent employé au pluriel).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tableau rare sera vendu aux <w>enchères</w> la semaine prochaine à Paris."
                        },
                        {
                            "text": "Ils ont décidé de mettre leur maison aux <w>enchères</w> pour régler rapidement la succession."
                        }
                    ],
                    "synonyms": [
                        "adjudication"
                    ],
                    "common_phrases": [
                        "vente aux enchères",
                        "mettre aux enchères"
                    ]
                },
                {
                    "sense_id": "0178ca27-918c-3d00-ba24-e266256e252c",
                    "sense_definition": "Offre d'un prix supérieur faite par un acheteur potentiel lors d'une vente publique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le collectionneur a fait une dernière <w>enchère</w> pour remporter le manuscrit convoité."
                        },
                        {
                            "text": "Son <w>enchère</w> a été immédiatement dépassée par un acheteur anonyme par téléphone."
                        }
                    ],
                    "synonyms": [
                        "offre",
                        "mise"
                    ],
                    "common_phrases": [
                        "faire une enchère",
                        "dernière enchère"
                    ]
                },
                {
                    "sense_id": "fdc24192-fe7b-3ee9-b167-90eeecaa07e7",
                    "sense_definition": "Déclaration par laquelle un joueur s'engage à réaliser un contrat supérieur à celui de ses adversaires dans des jeux comme le bridge ou le tarot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de poser la première carte, les partenaires communiquent grâce à leurs <w>enchères</w>."
                        },
                        {
                            "text": "Son <w>enchère</w> audacieuse a surpris l'ensemble de la table dès le début de la manche."
                        }
                    ],
                    "synonyms": [
                        "annonce",
                        "contrat"
                    ],
                    "common_phrases": [
