                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5c4ea1-8752-4719-9975-09b1e569fc8e",
                                "sense_id": "31eaded9-ec21-303e-a347-6fbd9a0c3c66",
                                "text": "„Dezisionisten mögen dieser Grundentscheidung den Anschein des Fraglosen geben oder sie im Dunkel ihrer Theorie belassen; […]"
                            },
                            {
                                "example_id": "a2c976f8-9830-4147-a78c-01fd82966658",
                                "sense_id": "31eaded9-ec21-303e-a347-6fbd9a0c3c66",
                                "text": "„Darum war Schmitt in keiner seiner Schaffensphasen konsequenter Dezisionist, sondern nutzte dezisionistische Argumente zeitweise zur Stützung jeweiliger inhaltlicher Positionen.“"
                            },
                            {
                                "example_id": "45d67a05-f689-45d4-b99d-59e517bc2724",
                                "sense_id": "31eaded9-ec21-303e-a347-6fbd9a0c3c66",
                                "text": "Der deutsche Staatsrechtler und politische Philosoph Carl Schmitt ist der klassische Vertreter eines Dezisionisten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
