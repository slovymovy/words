                        "glosses": [
                            "schilder die werkt in de kubistische stijl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a30462e-1c62-4b40-a26b-112ab25768fc",
                                "sense_id": "55600bfe-dace-398d-adb4-21b8a9a50cb4",
                                "text": "Nader onderzoek verricht Sohtheby’s naar een werk op van de Amerikaanse kubist Lionel Feininger (mogelijke waarde: 12.000 Euro)."
                            },
                            {
                                "example_id": "d5467a44-36f9-4419-9b0c-0a330126d9e7",
                                "sense_id": "55600bfe-dace-398d-adb4-21b8a9a50cb4",
                                "text": "De werken werden op 3 juli 1988 uit de galerie Solomon gestolen. Hun waarde werd toen op 345.000 dollar geschat, maar zij zouden inmiddels veel meer waard zijn. Het betreft Figuration van de Amerikaanse abstracte expressionist Robert Motherwell, La bouteille bleue van de Franse kubist Fernand Léger, Untitled van de Amerikaanse abstracte expressionist Franz Kline en Effigie van de Fransman Jean Dubuffet."
                            }
                        ]
                    }
                ],
