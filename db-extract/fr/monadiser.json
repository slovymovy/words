                "senses": [
                    {
                        "sense_id": "8ad1772e-cc54-35ee-bc6b-bce95a44f3e4",
                        "entry_id": "6b008c92-18e0-3b83-9ced-8af8761125f3",
                        "glosses": [
                            "Donner un caractère de monades à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3031e3ba-e31b-4b83-8613-f4eb6e80d651",
                                "sense_id": "8ad1772e-cc54-35ee-bc6b-bce95a44f3e4",
                                "text": "Dans la mesure où l’ego absolu s’est lui-même rendu étranger, s’est monadisé, le monadiser lui-même est monadisé."
                            },
                            {
                                "example_id": "58d5a67f-084a-405c-a8aa-bf70a4cc2518",
                                "sense_id": "8ad1772e-cc54-35ee-bc6b-bce95a44f3e4",
                                "text": "Par voie de conséquence, l’Homme a tendance à se monadiser, à se réfugier dans la sphère privée, du sensible, du fini où son équilibre mental lui parait préservé."
                            }
                        ]
                    }
                ],
