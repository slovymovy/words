                                            {
                                                "example_id": "bf1a1f3e-5aa4-48d6-98e2-5d7d55f7ff21",
                                                "sense_id": "0d64b2ba-fbdc-3cd6-aeb9-deac6c4c8cfa",
                                                "text": "Między aktem wiary a aktem niewiary istnieje stan pośredni: nie-niewiary"
                                            },
                                            {
                                                "example_id": "62d7ddee-5b51-450b-b4b3-d1b2900f65cd",
                                                "sense_id": "0d64b2ba-fbdc-3cd6-aeb9-deac6c4c8cfa",
                                                "text": "„Antropolodzy mają prawo twierdzić, że przyczynili się do zachowania kulturowego dziedzictwa społeczeństw, które badali, […]. Lecz prawdą jest również, iż mieli oni swój udział, czasem tylko pośredni, w utrzymywaniu struktur władzy reprezentowanych przez system kolonialny”."
                                            },
                                            {
                                                "example_id": "6beb1fa1-325e-4e0a-91b5-3afdfd2413c0",
                                                "sense_id": "0d64b2ba-fbdc-3cd6-aeb9-deac6c4c8cfa",
                                                "text": "Efekt podobny, ale w sposób pośredni, wywołują inwestycje w infrastrukturę gospodarczą (np. budowa dróg, modernizacja sieci kolejowej, rozbudowa sieci telekomunikacyjnej)."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7b06224a-8083-3bb3-9e9e-04ea4fa0fa21",
                                        "entry_id": "691d3063-1909-3310-8c7c-8a040701e40b",
                                        "glosses": [
                                            "znajdujący się między dwoma stanami lub dwiema wartościami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
