                "senses": [
                    {
                        "sense_id": "12724ec4-96e3-327f-b9b4-66905a89be45",
                        "entry_id": "02769970-f571-3f39-9431-e94db09cfd47",
                        "glosses": [
                            "Linguistik: Sprachform, in der vereinfachtes Deutsch mit Elementen der Herkunftssprache der Sprecher durchsetzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08299519-39c8-4dd0-aff7-4af30c08cada",
                                "sense_id": "12724ec4-96e3-327f-b9b4-66905a89be45",
                                "text": "„In Verbindung mit anderen Eigenschaften - Lassma Körnerpark gehen, lan! - wird das Kiezdeutsch als Ethnolekt, als eine ethnisch bedingte Mischsprache stigmatisiert.“"
                            },
                            {
                                "example_id": "9afd9a3b-2302-44ea-bdd1-bb8f15e0f883",
                                "sense_id": "12724ec4-96e3-327f-b9b4-66905a89be45",
                                "text": "„Begrüßungen, Verabschiedungen, Schimpfwörter, Drohformeln (isch mach disch Messer) oder Flirtsprüche: Im Ethnolekt schrumpft der deutsche Gesamtwortschatz kontinuierlich zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
