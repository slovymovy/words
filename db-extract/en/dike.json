                "senses": [
                    {
                        "sense_id": "d889dba3-1b96-3a22-8bf5-5c8c4a5ffb5d",
                        "entry_id": "b347b7d3-d497-33f8-a462-c4e06a0d88aa",
                        "glosses": [
                            "Alternative spelling of dyke: to dig a ditch; to raise an earthwork; etc."
                        ],
                        "tags": [
                            "US",
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "7c797b0a-9e3e-4900-bb8f-35fbf797f791",
                                "sense_id": "d889dba3-1b96-3a22-8bf5-5c8c4a5ffb5d",
                                "text": "Lakeside water-filtration plants, an 11,000-acre diked airport east of 55th Street, slash-and-bulldoze highway projects through Jackson and Lincoln parks—these and many another grandiose project leapt from the sketchbooks of city planners."
                            },
                            {
                                "example_id": "abcf4324-67ec-4d05-9b89-ca0b96b65e1c",
                                "sense_id": "d889dba3-1b96-3a22-8bf5-5c8c4a5ffb5d",
                                "text": "In 1983, dictator Nicolae Ceausescu decreed that the Romanian Danube delta, one of Europe's largest wetlands, be diked for growing rice and maize."
                            }
                        ]
                    }
