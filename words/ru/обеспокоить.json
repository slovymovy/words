{
    "word_family": [
        "беспокойство",
        "беспокойный",
        "беспокойно"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34d9f58e-5216-3d48-974a-9a5304ac8de6",
                    "sense_definition": "Вызвать у кого-либо чувство тревоги или беспокойства.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его молчание начало <w>обеспокоить</w> всю семью.",
                            "target_lang_translations": {
                                "it": "Il suo silenzio ha iniziato a <w>preoccupare</w> tutta la famiglia."
                            }
                        },
                        {
                            "text": "Не стоит <w>обеспокоить</w> родителей такими пустяками.",
                            "target_lang_translations": {
                                "it": "Non vale la pena <w>preoccupare</w> i genitori con queste sciocchezze."
                            }
                        }
                    ],
                    "synonyms": [
                        "встревожить"
                    ],
                    "antonyms": [
                        "успокоить"
                    ],
                    "target_lang_definitions": {
                        "it": "Causare a qualcuno un sentimento di ansia o preoccupazione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "preoccupare",
                                "target_lang_sense_clarification": "causare ansia o inquietudine in qualcuno"
                            },
                            {
                                "target_lang_word": "allarmare",
                                "target_lang_sense_clarification": "causare un senso di allarme o timore"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48beb64a-f594-304e-a1d9-07dc116deb9b",
                    "sense_definition": "Причинить кому-либо неудобство или помешать своими действиями.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "disturb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Простите, что я вас <w>обеспокоил</w> в столь поздний час.",
                            "target_lang_translations": {
                                "it": "Mi scusi se l'ho <w>disturbato</w> a un'ora così tarda."
                            }
                        },
                        {
                            "text": "Мы старались не <w>обеспокоить</w> спящего ребенка своими разговорами.",
                            "target_lang_translations": {
                                "it": "Abbiamo cercato di non <w>disturbare</w> il bambino che dormiva con le nostre conversazioni."
                            }
                        }
                    ],
                    "common_phrases": [
                        "не обеспокоить"
                    ],
                    "target_lang_definitions": {
                        "it": "Causare disagio a qualcuno o interrompere le sue attività."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "disturbare",
                                "target_lang_sense_clarification": "dare fastidio o interrompere qualcuno"
                            },
                            {
                                "target_lang_word": "scomodare",
                                "target_lang_sense_clarification": "causare un disturbo o un disagio a qualcuno"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}