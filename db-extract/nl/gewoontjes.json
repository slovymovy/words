                                "sense_id": "1efad788-f6f5-343d-a1da-09d56d0e801c",
                                "text": "Wat de een mooi vindt, vindt de ander gewoontjes.",
                                "translation": "What one person finds attractive, another finds rather ordinary.",
                                "english": "What one person finds attractive, another finds rather ordinary."
                            }
