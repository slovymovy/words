                "senses": [
                    {
                        "sense_id": "f12023fb-50b5-31ee-bb59-ddccb417206a",
                        "entry_id": "f308e3c3-e3a6-3b1c-9a33-864061a5579f",
                        "glosses": [
                            "Parade, an der Homosexuelle, Bisexuelle und Transsexuelle teilnehmen, um unter anderem für ihre Rechte zu kämpfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d120af-c8ac-48a9-96b9-f6cb21a50d4e",
                                "sense_id": "f12023fb-50b5-31ee-bb59-ddccb417206a",
                                "text": "„Im Mai 2012 fand die erste Gay-Pride-Parade in Tirana statt.“"
                            },
                            {
                                "example_id": "23460caa-a9bd-441f-bcc2-5ed854505212",
                                "sense_id": "f12023fb-50b5-31ee-bb59-ddccb417206a",
                                "text": "„In den vergangenen Jahren waren Schwule und Lesben zunehmend an die Öffentlichkeit getreten und haben etwa Gay-Pride-Paraden organisiert.“"
                            },
                            {
                                "example_id": "ea7876be-08a6-4f67-9ecc-129fd71c1a83",
                                "sense_id": "f12023fb-50b5-31ee-bb59-ddccb417206a",
                                "text": "„So etwas hat es in Vietnam noch nicht gegeben: Einige Dutzend Schwule, Lesben und Sympathisanten haben am Sonntag in Hanoi die erste Gay-Pride-Parade des Landes veranstaltet.“"
                            },
                            {
                                "example_id": "908e8f45-b45d-47d0-8692-bcddb2a717c6",
                                "sense_id": "f12023fb-50b5-31ee-bb59-ddccb417206a",
                                "text": "„Oder Russland (ebenfalls Rang 134), wo inzwischen sogar \"homosexuelle Propaganda\" unter Strafe steht, darunter fallen auch Gespräche in der Öffentlichkeit über Homosexualität oder Gay-Pride-Paraden.“"
                            },
                            {
                                "example_id": "69ad34ec-7855-4870-a60b-d93f1bf5927e",
                                "sense_id": "f12023fb-50b5-31ee-bb59-ddccb417206a",
                                "text": "„In der kroatischen Hafenstadt Split haben hunderte Teilnehmer einer Gay-Pride-Parade die Gleichberechtigung von Homosexuellen eingefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
