                        "sense_id": "77d08853-7ac5-3ddf-bd64-05bef7bf812d",
                        "entry_id": "e678655a-dceb-3956-807c-da94d934c0cb",
                        "glosses": [
                            "danie z kuchni tatarskiej i uzbeckiej, rodzaj pilawu popularnego również w Rosji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41e92e0-1533-4df9-b48e-1f493dc78119",
                                "sense_id": "77d08853-7ac5-3ddf-bd64-05bef7bf812d",
                                "text": "Płow wyszedł trochę chudy, ale po trzech miesiącach Abdurahim zdążył do tego przywyknąć"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
