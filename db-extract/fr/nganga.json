                        "sense_id": "181dc474-3b5d-37d3-aadc-669934869eb4",
                        "entry_id": "7e4e1562-188b-3d44-a6a1-2a5fa4073c50",
                        "glosses": [
                            "Tradipatricien, guérisseur, féticheur."
