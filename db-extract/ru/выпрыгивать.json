                "senses": [
                    {
                        "sense_id": "92a99909-e374-32df-906e-b7c1e0eccc51",
                        "entry_id": "912f50bb-c2fd-3e1b-b3cd-3ed0f0adf1d0",
                        "glosses": [
                            "прыгать откуда-либо; прыгать изнутри наружу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a615fe19-5181-4d13-a31b-06a7151650cf",
                                "sense_id": "92a99909-e374-32df-906e-b7c1e0eccc51",
                                "text": "Выпрыгивать из окна."
                            },
                            {
                                "example_id": "7f69711b-f930-4232-827c-fc6a5a1e49f1",
                                "sense_id": "92a99909-e374-32df-906e-b7c1e0eccc51",
                                "text": "Это была овца. При каждом ударе грома она выпрыгивала из травы, как собака."
                            },
                            {
                                "example_id": "da80ac03-f581-47bc-b2d4-c17085fac17a",
                                "sense_id": "92a99909-e374-32df-906e-b7c1e0eccc51",
                                "text": "Рабочие стали дружно выпрыгивать из грузовика и выкидывать свои инструменты."
                            }
                        ]
                    },
                    {
                        "sense_id": "48cbd16e-cd5e-3226-aad9-e53212e0ea2b",
                        "entry_id": "912f50bb-c2fd-3e1b-b3cd-3ed0f0adf1d0",
                        "glosses": [
                            "спорт. прыгать вверх, выполняя упражнение, гимнастический приём и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fff7e913-6b14-3f22-92ec-d3a0b64a8e74",
                        "entry_id": "912f50bb-c2fd-3e1b-b3cd-3ed0f0adf1d0",
                        "glosses": [
                            "перен. быстро, неожиданно переместиться откуда-либо, появиться где-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a3564e0-c45f-4c3a-9db4-782106fe0210",
                                "sense_id": "fff7e913-6b14-3f22-92ec-d3a0b64a8e74",
                                "text": "Из гаража выпрыгнул луч фонарика, за ним — ещё один, ещё, лучи пересеклись, затем оттуда вышли друг за другом парни в камуфляже…"
                            }
                        ]
                    }
                ],
