                "senses": [
                    {
                        "sense_id": "304a980f-4105-3108-b12c-85c6c638cce1",
                        "entry_id": "e2c97df6-cd93-3917-b150-2f7eb3a31708",
                        "glosses": [
                            "postprandial, after-lunch, after-dinner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd512cb2-12bf-473f-bf51-8233cf7b367f",
                                "sense_id": "304a980f-4105-3108-b12c-85c6c638cce1",
                                "text": "Порфи́рий Влади́мирыч ложи́лся на послеобе́денный о́тдых, Евпраксеюшка зарыва́лась в свое́й ко́мнате в пери́ну, Про́хор уходи́л в людску́ю, и Аннинька остава́лась соверше́нно одна́.",
                                "translation": "Porfiry Vladimirych went to take his after-dinner nap; Evprakseyushka snuggled beneath her feather-quilt; Prokhor went off to the servants’ quarters; and Anninka was left entirely alone.",
                                "english": "Porfiry Vladimirych went to take his after-dinner nap; Evprakseyushka snuggled beneath her feather-quilt; Prokhor went off to the servants’ quarters; and Anninka was left entirely alone."
                            }
                        ]
                    }
