                ],
                "senses": [
                    {
                        "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                        "entry_id": "d727cf81-9f59-3c0c-af11-be7f698c71d9",
                        "glosses": [
                            "jemand, der etwas in unbrauchbaren oder nicht mehr vorhandenen Zustand überführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81129429-37b0-465a-aa47-17882ad77a89",
                                "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                "text": "„In den ‚Buddenbrooks‘ sind die Lehrer grausame oder lächerliche Vernichter der Kindheit.“"
                            },
                            {
                                "example_id": "a31863ff-f8d9-4633-8757-a56dade0c1a3",
                                "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                "text": "„Seine zweifelhafte Doppelfunktion brachte ihm im Jahr 2005 ‚Die goldene Kettensäge‘ ein, die alljährlich von Greenpeace an den größten Vernichter von Regenwald verliehen wird.“"
                            },
                            {
                                "example_id": "a8625f9b-c9e2-48b7-96cf-5c089d223a5f",
                                "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                "text": "„Aber wir haben noch dich, den Vernichter. Übe unseren Willen aus und setzte allem ein Ende! Die Sonne hast du bereits gestohlen.“"
                            },
                            {
                                "example_id": "627fa47a-7001-41f8-a543-69f7794232da",
                                "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                "text": "„Es existieren nicht wenige Filme und noch viel mehr Romane, in denen [Südamerikanische Wanderameisen] eine unrühmliche Nebenrolle spielen als Vernichter ganze Vieherden [sic!], die auch vor menschlichen Opfern nicht Halt machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
