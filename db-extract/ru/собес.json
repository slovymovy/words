                                                "sense_id": "7e17b9fe-2169-3ab4-be26-2707b9492e03",
                                                "text": "Die Beiträge zur Sozialversicherung sind erneut gestiegen."
                                            },
                                            {
                                                "example_id": "e97015e4-b023-499f-8c9f-46b2f9d130b6",
                                                "sense_id": "7e17b9fe-2169-3ab4-be26-2707b9492e03",
                                                "text": "Eine Reform der Sozialversicherung wird in vielen Parteiprogrammen angestrebt."
                                            }
