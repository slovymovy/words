                "senses": [
                    {
                        "sense_id": "17a88709-8942-395c-895d-1f891746e3e2",
                        "entry_id": "c402851f-2395-3ae4-bac2-587f1f9c1053",
                        "glosses": [
                            "een sierknoop die de manchet aan de mouw van een overhemd sluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "786ce747-9edb-4f9a-ab26-1e66161b1f1d",
                                "sense_id": "17a88709-8942-395c-895d-1f891746e3e2",
                                "text": "Bij een chique overhemd horen manchetknopen gedragen te worden."
                            },
                            {
                                "example_id": "e48e3918-935c-4901-a007-13feb71b4608",
                                "sense_id": "17a88709-8942-395c-895d-1f891746e3e2",
                                "text": "Vervolgens boog hij zich naar mij toe en zei mij op een fluistertoon dat hij er zeker geen gewoonte van wilde maken om zich te bemoeien met zaken die hem niet aangingen, maar dat hij het niet kon helpen dat het hem was opgevallen dat mijn linker manchetknoop niet goed was gesloten en dat hij het zichzelf nooit zou vergeven als ik hem zou verliezen ten gevolge van zijn discretie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "294bd20e-488d-4e2f-89e5-e418504a6222",
                        "source_entry_id": "c402851f-2395-3ae4-bac2-587f1f9c1053",
                        "source_sense_id": "17a88709-8942-395c-895d-1f891746e3e2",
                        "source_sense_description": "een sierknoop die de manchet aan de mouw van een overhemd sluit",
                        "target_lang_word": "Manschettenknopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manschettenknopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                        "entry_id": "70db2103-fb75-3321-ad42-0e0aead69e35",
                                        "glosses": [
                                            "Utensil (zwei untereinander verbundene Knöpfe), mit dem das untere Ende des Ärmels eines Herrenhemdes, das keinen Knopf, sondern nur zwei Knopflöcher aufweist, geschlossen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c207b53a-b455-4bee-98c2-4a3ca951ef38",
                                                "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                                "text": "„Hier hob Dr. Valenti die Hand, wobei seine goldenen Manschettenknöpfe im Sonnenlicht blitzten.“"
                                            },
                                            {
                                                "example_id": "133ec854-59ff-48cd-a561-c019c9bbba9c",
                                                "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                                "text": "„Renate schenkte Opa zum 78. Geburtstag zwei emaillierte Manschettenknöpfe.“"
                                            },
                                            {
                                                "example_id": "476c5a73-6096-49ec-be66-2dd24c9e205c",
                                                "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                                "text": "„Alles andere ist zu Gold geworden, das keusche Gold der Manschettenknöpfe, ein goldenes feinmaschiges Uhrenarmband, ein goldenes Cartierfeuerzeug.“"
                                            },
                                            {
                                                "example_id": "c0855828-31ae-425b-b27d-620ef920c98a",
                                                "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                                "text": "„Als sie aus dem Schlafzimmer kam, hatte sie die Manschettenknöpfe und die Krawattennadel in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14235d27-a49f-43ba-881d-057659c734fb",
