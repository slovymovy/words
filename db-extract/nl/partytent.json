                    {
                        "sense_id": "0b29d2b5-73df-37d6-b740-c04d37b02c94",
                        "entry_id": "04d1f11c-ddde-33bd-be56-d318090ca46d",
                        "glosses": [
                            "een tent die men gebruikt op feesten, ze zijn hoog genoeg om in te kunnen staan en als bescherming tegen de wind kan men de wanden sluiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "178af7a1-1377-46b0-9fbc-7e1963bd746d",
                                "sense_id": "0b29d2b5-73df-37d6-b740-c04d37b02c94",
                                "text": "Rond de as van de tachtig meter hoge paal klimt en draait een soort spaceshuttle de hoogte in. Van de gigantische Pukkelpop-letters aan de ingang schuift het zicht in slow motion over de Marquee richting Main Stage. Wanneer de duizenden campingtenten in beeld komen wordt er druk gewezen. ‘Ik herken mijn partytent! Die van ons staat een beetje scheef. Dat is ze zonder twijfel’, roept Thomas. ‘Je krijgt een beeld van de wei en de camping dat je anders nooit ziet’."
                            },
                            {
                                "example_id": "135560d9-5cdd-4d92-aee6-30b81ff08799",
                                "sense_id": "0b29d2b5-73df-37d6-b740-c04d37b02c94",
                                "text": "Op elke straathoek kan je wel feesten deze week. Van doodgewone partytent tot eeuwenoud gebouw. De leukste historische feestplekken in beeld."
                            }
                        ]
                    }
