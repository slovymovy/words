                        "form": "die Kinderfeste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b40ed4d9-58be-331f-b68e-993926f24877",
                        "entry_id": "8a12694b-d5e0-3dcf-b784-94e730b2109b",
                        "glosses": [
                            "Event, feierliche Veranstaltung für Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d349e75-c17b-493c-b337-f578513ba3f5",
                                "sense_id": "b40ed4d9-58be-331f-b68e-993926f24877",
                                "text": "„Um Frauen mit einer Burka aus der Öffentlichkeit zu kriegen, mussten Clownsbemalungen außerhalb von Kinderfesten und Zirkuszelten verboten werden.“"
                            },
                            {
                                "example_id": "52ff63be-e3d7-40e2-9968-665e26801d55",
                                "sense_id": "b40ed4d9-58be-331f-b68e-993926f24877",
                                "text": "„Die Partei veranstaltet regelmäßig Fackelmärsche, Kinderfeste und macht Propaganda vor Asylbewerberheimen in der Umgebung.“"
                            },
                            {
                                "example_id": "6b678f28-5a75-46e4-8dfb-544a18e84f3d",
                                "sense_id": "b40ed4d9-58be-331f-b68e-993926f24877",
                                "text": "„Steht ein Kinderfest an, eine Sportstunde, ein Ausflug oder ein Hüttenabend, erscheint es bequem, zu einem fertigen Spielevorrat zu greifen, der in großen Mengen von Spielexperten bereitgestellt wird.“"
                            },
                            {
                                "example_id": "0dda2dde-e66e-46a2-82cc-59109fe2fef9",
                                "sense_id": "b40ed4d9-58be-331f-b68e-993926f24877",
                                "text": "„In Niedersachsen wurden acht Kinder verletzt, als eine Windböe bei einem Kinderfest auf einem Autohof an der A1 eine zehn Meter hohe aufblasbare Rutsche umwarf.“"
                            },
                            {
                                "example_id": "a6346830-12eb-49ec-a351-9366e723e621",
                                "sense_id": "b40ed4d9-58be-331f-b68e-993926f24877",
                                "text": "„Nur zweieinhalb Wochen nach der Taufe der jüngsten Prinzessin, Charlotte, haben die Royals wieder ein Kinderfest gefeiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
