                        "glosses": [
                            "afdeling van een bedrijf die contact houdt met klanten vanuit het bedrijf zelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdcbfd3f-b88b-4a42-a412-aa38ca6b7cce",
                                "sense_id": "1270e983-2eb9-3474-9ffb-d795362b5503",
                                "text": "Ze begeleidt mensen uit alle sectoren, legt ze uit. „Van een 23-jarige verkoper binnendienst tot een 55-jarige technicus en alles wat daartussen zit."
                            },
                            {
                                "example_id": "a5e5425f-f8a4-4e9e-85fb-eaf7b89e80e0",
                                "sense_id": "1270e983-2eb9-3474-9ffb-d795362b5503",
                                "text": "Het ene na het andere bedrijf maakt bekend mensen te moeten ontslaan. Reden: corona. Er zijn minder vluchten, minder treinreizen, minder vakanties, minder festivals, en ga zo nog maar even door. Marcel Beijerink (46) uit Borne was commercieel medewerker binnendienst. Hij kon kiezen uit twee functies, maar na twee weken moest hij al afscheid nemen van zijn nieuwe collega’s."
                            }
                        ]
                    }
