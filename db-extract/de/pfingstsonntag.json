                                            {
                                                "example_id": "7dadbcc1-7b28-4728-8048-f4b5256ffb73",
                                                "sense_id": "1bf58b66-762c-3ffe-adb3-4db54b246d13",
                                                "text": "1909, Sidney Heath, Romance of Symbolism: Fonts and the symbols of baptism - The times [for baptism] of which Whitsun Eve is one, are specified by ... the constitutions for Orthobon for England, Gerona, 517, c. iv."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad76b35-dcca-39a9-b0cb-35f3ceadc1fd",
                                        "entry_id": "57ef1d8e-b439-37cb-b6f0-363cf94527ca",
