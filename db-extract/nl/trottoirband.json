                "senses": [
                    {
                        "sense_id": "b9158063-177d-36a5-9dd9-36cf29c41cee",
                        "entry_id": "2273cf2a-162b-3037-a0ac-1c21a0539435",
                        "glosses": [
                            "hardstenen rand tussen de rijweg en het iets hoger liggende voetpad of trottoir"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78301ce7-7e0c-45ab-9e2e-c602a1fc6340",
                                "sense_id": "b9158063-177d-36a5-9dd9-36cf29c41cee",
                                "text": "Twee begrafenisondernemers, van 25 en 34 jaar, wachten geduldig het moment af om hun diensten aan te bieden. Ze zitten stilletjes op de trottoirband een eind verderop. Met z’n tweeën dwalen ze al zeventien jaar ’s nachts door de stad, wachtend op een tip van een politieagent of ambulancier. Wachtend op een moord."
                            },
                            {
                                "example_id": "d320e179-f9bc-47b7-9902-8eae0df6049e",
                                "sense_id": "b9158063-177d-36a5-9dd9-36cf29c41cee",
                                "text": "Ook hadden ze de trottoirband geel geverfd en de tekst 'no parking'in reliëfletters aangebracht. Buren hadden hierover geklaagd bij de verkeersdienst van de stad New York, die woensdag besloot dat Madonna de stoep binnen dertig dagen in originele staat moet terugbrengen. Anders krijgt ze een boete van 250 dollar."
                            },
                            {
                                "example_id": "ae75b15b-5343-4482-9a59-21816fb4adb8",
                                "sense_id": "b9158063-177d-36a5-9dd9-36cf29c41cee",
                                "text": "Dat betekent bijvoorbeeld een obstakelvrij trottoir (zonder losse reclamepanelen, bloembakken midden op de stoep en rondslingerende fietsen) gemaakt van stroef, slipvrij materiaal en met verlaagde trottoirbanden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e4ba024-858c-4669-8331-ef34a935181f",
                        "source_entry_id": "2273cf2a-162b-3037-a0ac-1c21a0539435",
                        "source_sense_id": "b9158063-177d-36a5-9dd9-36cf29c41cee",
                        "source_sense_description": "opstaande rand van een trottoir",
                        "target_lang_word": "Bordstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bordstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb1249d-2fab-378c-a18c-ced1b5a960e9",
                                        "entry_id": "a9c151ae-940f-386b-a9d9-8132a8d18403",
                                        "glosses": [
                                            "befestigte Reihe von Steinen, welche den Bürgersteig von der Straße abtrennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69d6e486-71c3-4b50-8d9a-e69a9e550895",
                                                "sense_id": "4cb1249d-2fab-378c-a18c-ced1b5a960e9",
                                                "text": "Beim Einparken passiert es des Öfteren, dass man gegen den Bordstein fährt."
                                            },
                                            {
                                                "example_id": "5d6c2c7e-c378-4191-9d79-0b67cfb2ca00",
                                                "sense_id": "4cb1249d-2fab-378c-a18c-ced1b5a960e9",
                                                "text": "„Er stellte erfreut fest, dass der Regen seinen Pissefleck vom Bordstein gewaschen hatte.“"
                                            },
                                            {
                                                "example_id": "3be4d183-bebc-4af3-aa12-54d698c44044",
                                                "sense_id": "4cb1249d-2fab-378c-a18c-ced1b5a960e9",
                                                "text": "„Eilig wurde ich geschoben und holperte über Bordsteine an den Stationen vorbei.“"
                                            },
                                            {
                                                "example_id": "06807862-7e08-499b-a79f-7095fc3697f2",
                                                "sense_id": "4cb1249d-2fab-378c-a18c-ced1b5a960e9",
                                                "text": "„Ich stolperte über den Bordstein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
