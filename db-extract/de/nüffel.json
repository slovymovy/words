                "senses": [
                    {
                        "sense_id": "b88605e4-eccd-3bbb-91de-91f398464cf5",
                        "entry_id": "1dcc7dad-f3a4-3a6e-a16a-7dc7d18129be",
                        "glosses": [
                            "Kind"
                        ],
                        "tags": [
                            "Namibia"
                        ],
                        "examples": [
                            {
                                "example_id": "7f721a74-e2b4-4fd3-8c46-3673bcb3e1fd",
                                "sense_id": "b88605e4-eccd-3bbb-91de-91f398464cf5",
                                "text": "Ich bin chattvoll von dem bleddy Krach, den die Nüffels machen. — So langsam habe ich die Nase voll von dem vielen Lärm, den die Kinder fabrizieren."
                            },
                            {
                                "example_id": "a790d9f2-eee1-4302-b902-9dd504d081da",
                                "sense_id": "b88605e4-eccd-3bbb-91de-91f398464cf5",
                                "text": "„Zur Krönung ist in dieser Woche aber das Angebot von Amos Taylor gekommen. Amos ist der Nüffel vom Charles Taylor aus Liberia, der jetzt im nigerianischen Exil lebt - der Arme.“"
                            },
                            {
                                "example_id": "faef4bc1-41b6-4478-8baf-7f5298a21f93",
                                "sense_id": "b88605e4-eccd-3bbb-91de-91f398464cf5",
                                "text": "„Um den Beruf auch für künftigen Nachwuchs attraktiv zu machen, empfiehlt der große Fürsprecher der Gemeindepolizei, Ovendukas Bürgerbaas Matheus Shikongo, dass die Kinder künftig nicht mehr Cowboy und Crook sondern Räuber und Gendarm spielen. (Zum besseren Verständnis für Überseedeutsche hier eine Übersetzung: Kinder sind Kids ? Zicklein, also junge Bockies, Nüffel etc.)“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
