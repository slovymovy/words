                    {
                        "form_id": "3fc00fe6-52cf-43b1-8583-ad7884c89547",
                        "entry_id": "fced74a7-f373-3c79-af9e-a7d76681e05a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Prügelstrafen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e170e201-c5f2-3398-ae12-6e1a56d547b3",
                        "entry_id": "fced74a7-f373-3c79-af9e-a7d76681e05a",
                        "glosses": [
                            "Bestrafung von jemandem mittels Schlägen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf85b18-cd35-4d40-b7fb-766d9725f951",
                                "sense_id": "e170e201-c5f2-3398-ae12-6e1a56d547b3",
                                "text": "„In Cassville, einer Kleinstadt in den USA, ist die Prügelstrafe für Schulkinder wieder erlaubt.“"
                            },
                            {
                                "example_id": "75d6a3ad-a14d-4e16-bed1-5cf06c7da228",
                                "sense_id": "e170e201-c5f2-3398-ae12-6e1a56d547b3",
                                "text": "„Ein Schulbezirk im US-Bundesstaat Missouri hat die Prügelstrafe wieder eingeführt.“"
                            },
                            {
                                "example_id": "f5c1e937-b9bb-464e-911c-4c799bf70590",
                                "sense_id": "e170e201-c5f2-3398-ae12-6e1a56d547b3",
                                "text": "„Gelegentlich werden sie sogar verdächtigt, dass sie mit den Taliban, den Mullahs oder mit den Ultraorthodoxen sympathisieren und womöglich sogar Prügelstrafen oder Steinigungen klammheimlich in Kauf nehmen.“"
                            },
                            {
                                "example_id": "3d0d8dcd-eda0-4c61-a58a-df4aadfc146c",
                                "sense_id": "e170e201-c5f2-3398-ae12-6e1a56d547b3",
                                "text": "„Er schaffte die Prügelstrafe ab, ermöglichte Nichtadeligen die Offizierslaufbahn und baute eine neue Heeresstruktur auf.“"
                            },
                            {
                                "example_id": "8be73a71-2e68-4598-b2e5-476d57fe25d2",
                                "sense_id": "e170e201-c5f2-3398-ae12-6e1a56d547b3",
                                "text": "„Landeshauptmann Jesko von Puttkamer, später auch Statthalter in Kamerun, räumte ein, in gut hundert Fällen selbst die Prügelstrafe verhängt zu haben.“"
                            },
                            {
                                "example_id": "3f0742c7-f1b6-47bf-8cdd-137044e45c05",
                                "sense_id": "e170e201-c5f2-3398-ae12-6e1a56d547b3",
                                "text": "„Als sie nach der Prügelstrafe aus dem Strafvollzugsamt ihres Weges gegangen waren, sann jeder von ihnen nach, warum sie völlig unerwartet heute dieses Mißgeschick betroffen habe und wo die Zündschnur zu suchen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
