                "senses": [
                    {
                        "sense_id": "dd4e4bec-a929-3f29-86d5-9543eaa59ada",
                        "entry_id": "f6f86118-2b23-306f-94ea-4d3a9edc6d81",
                        "glosses": [
                            "Que l’on n’a pas compté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f9f5be-fea1-4246-9fb2-ec1704e226e8",
                                "sense_id": "dd4e4bec-a929-3f29-86d5-9543eaa59ada",
                                "text": "Dante brûle comme une pure étoile, fixée là au firmament , où ce qu’il y a de grand et de haut dans tous les ages vient s’allumer : il est la possession de tous les élus du monde pour un temps incompté."
                            },
                            {
                                "example_id": "21f6ce21-f682-4f05-9e6f-9694a36a8723",
                                "sense_id": "dd4e4bec-a929-3f29-86d5-9543eaa59ada",
                                "text": "Laisse-moi dans le nombre, incompté, me glisser :\nJe compterai quand même en la somme totale !"
                            },
                            {
                                "example_id": "162ed0e5-c0f4-47cd-ac63-7149057c7596",
                                "sense_id": "dd4e4bec-a929-3f29-86d5-9543eaa59ada",
                                "text": "Les neuf morts du métro Charonne plaqués contre les grilles et les morts incomptés de la Seine ne se rejoindraient pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ebc310f-ac20-3bcf-9ea5-b22547f4d2f8",
                        "entry_id": "f6f86118-2b23-306f-94ea-4d3a9edc6d81",
                        "glosses": [
                            "Dont on ne tient pas compte, que l’on ne prend pas en compte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4958eb44-32e0-4914-ba87-98ca9b44171e",
                                "sense_id": "3ebc310f-ac20-3bcf-9ea5-b22547f4d2f8",
                                "text": "Lui, sur une voie de garage, incompté, se contentait de humer de loin l’âcre saveur du massacre.,"
                            },
                            {
                                "example_id": "477979d5-45c1-4f89-80dc-822cd5613dcf",
                                "sense_id": "3ebc310f-ac20-3bcf-9ea5-b22547f4d2f8",
                                "text": "Moins on a d’argent et plus les courses réclament un calcul minutieux, sans faille. Plus le temps. Faire la liste du nécessaire. Cocher sur le catalogue des promos les meilleures affaires. C’est un travail économique incompté, obsédant, qui occupe entièrement des milliers de femmes et d’hommes."
                            }
                        ]
                    }
