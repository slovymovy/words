                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tachymètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "029d8488-2a16-3ad4-ad1d-41d96f785d66",
                                        "entry_id": "f362eaea-1ef3-355b-9e2a-e6ce245d0bde",
                                        "glosses": [
                                            "Appareil de mesure indiquant en continu la vitesse angulaire d’une machine tournante, par exemple l’arbre de sortie d’un moteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2052103b-20ee-4759-94a5-f3912fb32279",
                                                "sense_id": "029d8488-2a16-3ad4-ad1d-41d96f785d66",
                                                "text": "Un compte-tours moteur est une sorte de tachymètre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                        "entry_id": "f362eaea-1ef3-355b-9e2a-e6ce245d0bde",
                                        "glosses": [
                                            "Instrument servant à mesurer la vitesse."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d403e1f7-0fc6-4c10-bb24-992325dfa8a1",
                                                "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                                "text": "Il a l’œil constamment rivé sur le tachymètre."
                                            },
                                            {
                                                "example_id": "5dde99d1-f19e-4763-8535-3a3e406f57ec",
                                                "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                                "text": "Le conducteur jeta un coup d’œil sur son tachymètre, où l’aiguille blanche se déplaçait en éventail, de gauche à droite, sur les chiffres verts marquant les vitesses de 20 en 20 km/h."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13124e74-9bb3-404a-b239-20b13422ea8f",
                        "source_entry_id": "354a1d14-fb33-3560-a6b1-c1038bd0f4a0",
                        "source_sense_description": "surveying instrument",
                        "target_lang_word": "Tachymeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tachymeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                        "entry_id": "5cab95a2-389e-3ace-9bf6-66fadf013951",
                                        "glosses": [
                                            "Gerät zum Messen von Winkeln und Strecken in einem Gelände"
                                        ],
                                        "tags": [
                                            "Geodäsie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a055836-0509-47ce-80ad-e61da63af3c7",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Das Tachymeter misst horizontale Richtungen, Vertikalwinkel und die schräge Distanz zwischen Instrument und anvisiertem Zielpunkt.“"
                                            },
                                            {
                                                "example_id": "423cb068-ce81-407d-b37e-bc045487e18f",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Tachymeter sind im Prinzip Theodolite, jedoch zusätzlich ausgestattet mit einer eingebauten Distanzmesseinheit.“"
                                            },
                                            {
                                                "example_id": "c04a89f4-3237-40a2-8db1-c4fe943c7ec5",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Der nächste große Schritt war getan, als das erste koaxiale Tachymeter entwickelt wurde.“"
                                            },
                                            {
                                                "example_id": "a81c91c9-483b-43b1-ad2e-1f4c4a57815b",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Man wird also bestrebt sein, mit dem Tachymeter Linienzüge längs der Bauteilkanten anzuzielen und einzumessen.“"
                                            },
                                            {
                                                "example_id": "0e957d44-51cd-4b95-96fa-c3c0289c5609",
                                                "sense_id": "ea2e768e-cd6b-3406-bc0a-823a564c3e9e",
                                                "text": "„Der Tachymeter als Weiterentwicklung des Theodolits kann neben Winkeln auch Strecken messen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
