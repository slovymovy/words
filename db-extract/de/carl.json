                        "source_sense_id": "c38bf154-1cf1-3425-91d7-cc046d9e0e83",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Charlot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Charlot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dfdcb89-0554-36c2-b107-cd7e512c25ec",
                                        "entry_id": "afb9578c-b998-3754-824b-1c5c6ddbff43",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7ead46f-ca6f-4b53-a3b9-b8982f6e8587",
                                                "sense_id": "4dfdcb89-0554-36c2-b107-cd7e512c25ec",
                                                "text": "Tim Dahan, pianiste et compositeur, Aurélien Charlot à la basse et Brendan Costaire à la batterie forment les membres de ce groupe porté par une musique aux différentes influences."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Charlot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d835f892-b6a0-3422-81a1-c66879aa43c3",
                                        "entry_id": "29f9b87d-0679-373b-91f5-6f103a3a57a5",
                                        "glosses": [
                                            "Bourreau exécutant les condamnés à mort à Paris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b9dfb5-39ba-4cb9-842e-2c0f5fca284b",
                                                "sense_id": "d835f892-b6a0-3422-81a1-c66879aa43c3",
                                                "text": "Mais oui, Charlot est là, répondit le surveillant avec une parfaite indifférence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffdd37f8-ae91-3f78-99bd-f972a06634c9",
                                        "entry_id": "29f9b87d-0679-373b-91f5-6f103a3a57a5",
                                        "glosses": [
                                            "Personnage de comique, qui a pour accessoires, une moustache, un chapeau melon, une canne, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9814bb27-614e-497a-ac45-3c48e82127da",
                                                "sense_id": "ffdd37f8-ae91-3f78-99bd-f972a06634c9",
                                                "text": "Laurel et Hardy, Charlot, Harold Lloyd, Fatty, Buster Keaton, Doublepatte et Patachon, Beaucitron, Max Linder, Fil-de-Fer, Félix-le-Chat qu’est du dessin animé…"
                                            },
                                            {
                                                "example_id": "a16eace0-9bc0-49da-99ce-b32a342501ce",
                                                "sense_id": "ffdd37f8-ae91-3f78-99bd-f972a06634c9",
                                                "text": "Charlot est un des plus célèbres personnages du cinéma muet, et du cinéma tout court."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Charlot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cea6ebf-c90c-3899-91e4-5bbc8489f1ce",
                                        "entry_id": "70733bec-b37a-3050-815d-826cc042d3b2",
                                        "glosses": [
                                            "Diminutif du prénom Charles."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13fb6be9-ea30-44cb-812b-214183543a94",
                                                "sense_id": "2cea6ebf-c90c-3899-91e4-5bbc8489f1ce",
                                                "text": "— J’ai l’âge du général, chevrotait-il, on est de la même classe, moi et Charlot. Je suis-t-y à l’Élysée, moi ? Je suis-t-y à l’Élysée ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
