                ],
                "senses": [
                    {
                        "sense_id": "2beea110-ad46-31a3-b981-e08fbefe1ead",
                        "entry_id": "92496b34-e6b7-356f-bff2-75f8822b8935",
                        "glosses": [
                            "Bedürfnis zu urinieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc2ef4fe-aa98-4052-9bfb-dccde72eebbf",
                                "sense_id": "2beea110-ad46-31a3-b981-e08fbefe1ead",
                                "text": "Der nächtliche Harndrang bereitet vielen Menschen eine unruhige Nacht."
                            },
                            {
                                "example_id": "a5ca3285-79e7-41f2-9ec5-ac5f3f9c90ff",
                                "sense_id": "2beea110-ad46-31a3-b981-e08fbefe1ead",
                                "text": "Mein Harndrang zwingt mich, den Artikel schnellstmöglich zu beenden."
                            },
                            {
                                "example_id": "37f25be8-8ebe-4009-9208-6e8014a0d167",
                                "sense_id": "2beea110-ad46-31a3-b981-e08fbefe1ead",
                                "text": "„Als ich mit leisem Bedauern erwachte und erkannte, wo ich mich befand, schien die abendliche Frühlingssonne schon sehr schräg durch das Barackenfenster, und ich verspürte einen starken Harndrang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
