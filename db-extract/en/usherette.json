                ],
                "senses": [
                    {
                        "sense_id": "7eda5c83-cdc5-33c3-9847-a9ae05e0b696",
                        "entry_id": "5ad75c14-116e-3b41-af1b-3cda55cec100",
                        "glosses": [
                            "A female usher."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "db558d08-3058-404d-9636-a8a487f9ce4c",
                                "sense_id": "7eda5c83-cdc5-33c3-9847-a9ae05e0b696",
                                "text": "It is such a tiny little place that at first I thought I had gone wrong, and was in an antechamber. Plain papered walls, ascetic chairs, a moldy piano, and a couple of usherettes seemed extremely bare."
                            },
                            {
                                "example_id": "27c5cd0e-b853-4f40-b85f-a492eb3c8a7f",
                                "sense_id": "7eda5c83-cdc5-33c3-9847-a9ae05e0b696",
                                "text": "And then the usherette opened the doors of this dark palace and with a flashlight held behind her took him to his seat."
                            },
                            {
                                "example_id": "4ea9a859-fa50-4cec-99cb-9f741bda3e68",
                                "sense_id": "7eda5c83-cdc5-33c3-9847-a9ae05e0b696",
                                "text": "He says, “Mike, let's do the town.” Can you refuse a guy who just gives you a thirty thousand dollar property? We do the town. We do the girl shows, and he yells at all the dames and tries to date the usherettes until we finally get pitched out. […]”"
                            },
                            {
                                "example_id": "fa64b004-03d3-4fe1-8b2a-f9a1a46223d4",
                                "sense_id": "7eda5c83-cdc5-33c3-9847-a9ae05e0b696",
                                "text": "[…] I won’t even see her again till next Saturday night on account of her doing week-nights as an usherette at the Regal […]"
                            },
                            {
                                "example_id": "1cb6b36f-3114-48c9-b4b7-b49b363e96bb",
                                "sense_id": "7eda5c83-cdc5-33c3-9847-a9ae05e0b696",
                                "text": "But please don’t call them usherettes. […] “Usherette makes us sound as if we’re miniature ushers or something. It’s an old term that we’re trying to get rid of.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99dd8e08-3a74-4851-84b2-8828d4681c4f",
                        "source_entry_id": "5ad75c14-116e-3b41-af1b-3cda55cec100",
                        "source_sense_id": "7eda5c83-cdc5-33c3-9847-a9ae05e0b696",
                        "source_sense_description": "a female usher",
                        "target_lang_word": "ouvreuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouvreuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27eb0911-66ef-3350-9e91-0df0d3974e6b",
                                        "entry_id": "919115ae-42d6-39d6-991b-30834d2f5228",
                                        "glosses": [
                                            "Celle qui ouvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c67e33-1356-452b-b937-e8b33d0956d6",
                                                "sense_id": "27eb0911-66ef-3350-9e91-0df0d3974e6b",
                                                "text": "Ouvreuse d’huîtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77f3d07-fb1f-315f-8958-26ca286c3f59",
                                        "entry_id": "919115ae-42d6-39d6-991b-30834d2f5228",
                                        "glosses": [
                                            "Femme chargée d’ouvrir les loges ou de placer les spectateurs dans une salle de spectacle."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58fd4564-1c06-47fe-8b36-d7e95456d71c",
                                                "sense_id": "a77f3d07-fb1f-315f-8958-26ca286c3f59",
                                                "text": "Cette femme était, je crois, une duchesse, ou peut-être une ouvreuse. Ma mémoire est si confuse que je crois plus à l’ouvreuse qu’à la duchesse. Cependant elle avait des plumes et des dentelles !…"
                                            },
                                            {
                                                "example_id": "df2d6935-f4ce-4690-a5f6-479a84949690",
                                                "sense_id": "a77f3d07-fb1f-315f-8958-26ca286c3f59",
                                                "text": "Voici la classe de la directrice, autant dire ma classe : les cartes murales montrent des animaux ; les tables et les bancs ont la hauteur du « petit banc » cher aux ouvreuses."
                                            },
                                            {
                                                "example_id": "8d92dcaa-4307-4366-817c-4ffd69bbf2cd",
                                                "sense_id": "a77f3d07-fb1f-315f-8958-26ca286c3f59",
                                                "text": "Elle était par ailleurs, portée à les croire peu chic, depuis qu’elle avait vu passer dans la rue la marquise de Villeparisis en robe de laine noire, avec un bonnet à brides.\n— Mais elle a l’air d’une ouvreuse, d’une vieille concierge, darling ! Ça, une marquise ! Je ne suis pas marquise, mais il faudrait me payer bien cher pour me faire sortir nippée comme ça !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5825b2b5-43ea-38bf-82c9-3b50c9c57ceb",
                                        "entry_id": "919115ae-42d6-39d6-991b-30834d2f5228",
                                        "glosses": [
                                            "Joueuse de rugby à quinze, aussi appelée demi d’ouverture, ayant pour rôle d’orienter les mouvements offensifs de son équipe."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca82e65-fd80-481b-acbd-1ea215803366",
                                                "sense_id": "5825b2b5-43ea-38bf-82c9-3b50c9c57ceb",
                                                "text": "La Rennaise Caroline Drouin sera l’ouvreuse titulaire de l’équipe de France féminine pour son entrée dans la Coupe du monde de rugby, ce mercredi face au Japon (20h45) à Dublin, et Montserrat Amédée connaîtra sa toute première sélection à l’arrière."
                                            },
                                            {
                                                "example_id": "f4a44488-1033-4d00-96bc-d7b3f49e9719",
                                                "sense_id": "5825b2b5-43ea-38bf-82c9-3b50c9c57ceb",
                                                "text": "Alors, le bronze en poche, c’est un coup de gueule poussé dans L’Équipe par l’ouvreuse Jessy Trémoulière, frustrée d’avoir joué les utilités en Nouvelle-Zélande, qui a remis une pièce dans le nourrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cd33501-ec14-3d80-8523-f52357019919",
                                        "entry_id": "919115ae-42d6-39d6-991b-30834d2f5228",
                                        "glosses": [
                                            "Machine servant à traiter par effilochage, les matières premières textiles."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e051e44-9f94-47e0-b836-c7332b297887",
                                                "sense_id": "1cd33501-ec14-3d80-8523-f52357019919",
                                                "text": "L’ouvreuse la plus communément employée est la machine Garnet du nom de son inventeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619b0f9c-8d2b-359e-93c7-65712f513531",
                                        "entry_id": "919115ae-42d6-39d6-991b-30834d2f5228",
                                        "glosses": [
                                            "Véhicule précédant une chargeuse dans un convoi de transport de marchandise illicite, afin de vérifier que la route est « claire », c’est-à-dire sans danger pour le convoi."
                                        ],
