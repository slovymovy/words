                    "frequency": "Low",
                    "semantic_group_id": "bril",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor de deur stond een ernstig <w>brillende</w> jongeman.",
                            "target_lang_translations": {
                                "ru": "Перед дверью стоял серьёзный молодой человек в <w>очках</w>."
                            }
                        },
                        {
                            "text": "Hij is de enige in de klas die altijd <w>brilt</w> tijdens het werk.",
                            "target_lang_translations": {
