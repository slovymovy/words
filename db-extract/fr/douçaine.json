                                        "entry_id": "0af1a3fd-33f2-3a0a-9ec0-947170e81bdf",
                                        "glosses": [
                                            "Holzblasinstrument aus der Familie der Schalmeien, das zur Renaissancezeit benutzt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e273b34-d253-4ed5-821b-030db842a1ff",
                                                "sense_id": "d0c40183-893e-3d0a-b7fa-3b79a7721f28",
                                                "text": "Das Dulzian wurde in der Renaissance von umherziehenden Musikern gespielt."
                                            },
                                            {
                                                "example_id": "2668267d-8d34-446c-9955-44e1524d1c95",
                                                "sense_id": "d0c40183-893e-3d0a-b7fa-3b79a7721f28",
                                                "text": "„Daß es sich dabei um historische Instrumente, Gamben, Zinken, Blockflöten, Posaunen, Dulziane und Pommer handelt, ist, für die Jubiläumsausgabe des immer noch selten komplett aufgeführten Buches, so selbstverständlich wie notwendig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fce6a3c7-cfa7-3e39-a503-e2e182e61e8e",
                                        "entry_id": "0af1a3fd-33f2-3a0a-9ec0-947170e81bdf",
                                        "glosses": [
                                            "ein Orgelregister, das nasal klingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faedcbb2-02ec-419e-96f7-b923c99b1a6b",
                                                "sense_id": "fce6a3c7-cfa7-3e39-a503-e2e182e61e8e",
                                                "text": "Das Dulzian ist vor allem bei Orgeln im norddeutschen Raum üblich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
