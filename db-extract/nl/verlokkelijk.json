                                "target_senses": [
                                    {
                                        "sense_id": "5019085c-658d-36ee-bae8-5349397e2e1f",
                                        "entry_id": "1fbfd3d6-6b83-3760-9b26-e2d8789992f9",
                                        "glosses": [
