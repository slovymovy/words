                "senses": [
                    {
                        "sense_id": "96aab56e-a38a-3852-b1c4-d57f1dc7f191",
                        "entry_id": "601eda5a-ab41-31da-bf82-a0c698360ba2",
                        "glosses": [
                            "miasto i gmina we Francji, w regionie Prowansja-Alpy-Lazurowe Wybrzeże, w departamencie Var"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c339f091-a2b4-4579-a828-701a3f46adc9",
                                "sense_id": "96aab56e-a38a-3852-b1c4-d57f1dc7f191",
                                "text": "Wreszcie znalazłem go, wcale nie w świetnym uniformie admirała eskadry lewantyńskiej, w jakiej wypłynął był na okręcie flagowym „Le Cid“ z Tulonu owego roku, gdy miał objąć tron meksykański, ani też w zielonym fraku generała kawalerii, który tak chętnie nosił w swych dniach ostatnich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
