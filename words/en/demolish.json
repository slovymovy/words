{
    "word_family": [
        "demolition",
        "demolisher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e495e020-a625-3976-b610-14b547f0f512",
                    "sense_definition": "To destroy buildings or other structures, especially in a planned or intentional fashion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council decided to <w>demolish</w> the old mill and put up four modern townhouses.",
                            "target_lang_translations": {
                                "ru": "Городской совет решил <w>снести</w> старую мельницу и построить четыре современных таунхауса."
                            }
                        },
                        {
                            "text": "They plan to <w>demolish</w> the building next month to make room for a new park.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>сносить</w> здание в следующем месяце, чтобы освободить место для нового парка."
                            }
                        }
                    ],
                    "synonyms": [
                        "raze",
                        "knock down",
                        "tear down",
                        "dismantle",
                        "destroy",
                        "flatten."
                    ],
                    "antonyms": [
                        "construct",
                        "build",
                        "erect"
                    ],
                    "common_phrases": [
                        "demolish the building",
                        "completely demolish",
                        "plan to demolish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушать здания или другие сооружения, особенно запланированным или преднамеренным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сносить",
                                "target_lang_sense_clarification": "о зданиях и сооружениях"
                            },
                            {
                                "target_lang_word": "снести",
                                "target_lang_sense_clarification": "завершить снос здания"
                            },
                            {
                                "target_lang_word": "разрушать",
                                "target_lang_sense_clarification": "уничтожать структуру чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00b8f404-6e03-3f31-bd0d-e9084f26ef1c",
                    "sense_definition": "To defeat an opponent easily or to prove a theory or belief to be completely wrong.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defeat_or_refute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local team managed to <w>demolish</w> their rivals with a final score of five to zero.",
                            "target_lang_translations": {
                                "ru": "Местной команде удалось <w>разгромить</w> своих соперников с финальным счетом пять-ноль."
                            }
                        },
                        {
                            "text": "The lawyer used new evidence to <w>demolish</w> the argument presented by the prosecution.",
                            "target_lang_translations": {
                                "ru": "Адвокат использовал новые улики, чтобы <w>опровергнуть</w> аргумент, представленный обвинением."
                            }
                        }
                    ],
                    "synonyms": [
                        "refute",
                        "disprove",
                        "annihilate",
                        "crush"
                    ],
                    "antonyms": [
                        "confirm",
                        "support",
                        "uphold"
                    ],
                    "common_phrases": [
                        "demolish an argument",
                        "demolish the opposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко победить противника или полностью опровергнуть теорию или убеждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "одержать полную победу над противником"
                            },
                            {
                                "target_lang_word": "опровергнуть",
                                "target_lang_sense_clarification": "доказать ложность аргумента или теории"
                            },
                            {
                                "target_lang_word": "разбить в пух и прах",
                                "target_lang_sense_clarification": "полностью уничтожить аргументацию или оппонента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42448ae4-23af-388e-aa01-7541e6028508",
                    "sense_definition": "To eat a large amount of food very quickly and completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so hungry after the race that he <w>demolished</w> a whole pizza in minutes.",
                            "target_lang_translations": {
                                "ru": "Он был так голоден после забега, что за считанные минуты <w>уплел</w> целую пиццу."
                            }
                        },
                        {
                            "text": "Watch him <w>demolish</w> that chocolate cake as if he hasn't eaten all day.",
                            "target_lang_translations": {
                                "ru": "Посмотри, как он <w>сметает</w> этот шоколадный торт, будто не ел весь день."
                            }
                        }
                    ],
                    "synonyms": [
                        "devour",
                        "consume",
                        "polish off"
                    ],
                    "common_phrases": [
                        "demolish a meal",
                        "quickly demolish"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe eating"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень быстро и полностью съесть большое количество еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уплетать",
                                "target_lang_sense_clarification": "есть быстро и с аппетитом"
                            },
                            {
                                "target_lang_word": "смести",
                                "target_lang_sense_clarification": "очень быстро съесть всё содержимое тарелки"
                            },
                            {
                                "target_lang_word": "уничтожить",
                                "target_lang_sense_clarification": "иронично о быстром поедании блюда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}