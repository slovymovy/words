                            },
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "иронично о поведении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皇后",
                                "target_lang_sense_clarification": "俚语，指特定风格的男同性恋者"
                            }
                        ]
                    }
                }
            ]
        },
        {
