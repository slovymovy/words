                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e23f77d-afdc-3176-bedb-404cb98ffef9",
                                        "entry_id": "4f3b8ec5-97ea-35ff-90df-d4218a424765",
                                        "glosses": [
                                            "miasto we Włoszech, w regionie autonomicznym Friuli-Wenecja Julijska"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4248731f-a24a-4d2b-b3c9-1e34307ce1c9",
                                                "sense_id": "2e23f77d-afdc-3176-bedb-404cb98ffef9",
                                                "text": "O Udine mówił Andrzej Litwornia w biograficznym filmie telewizyjnym jemu poświęconym, że bliżej stąd do Wiednia niż do Rzymu, do Warszawy niż do Neapolu; tak jak cały region Friuli, którego Udine jest stolicą, stanowi ono geograficzny i kulturowy punkt przecięcia świata łacińskiego, słowiańskiego i germańskiego. Uniwersytet w Udine, w tym także slawistyka, próbował tworzyć swoją odrębność na tym naturalnym gruncie integracji Środkowej Europy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
