                                "target_senses": [
                                    {
                                        "sense_id": "1dede71e-7064-3891-96c1-d7d7267dec13",
                                        "entry_id": "57e1bc31-f2eb-3cd0-a230-f046c29fdb02",
                                        "glosses": [
                                            "Partie de l’entomologie qui traite des lépidoptères (chenilles et papillons)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a71a443-5000-47bc-b855-76466ccb0fbb",
                                                "sense_id": "1dede71e-7064-3891-96c1-d7d7267dec13",
                                                "text": "Depuis le milieu du siècle, la lépidoptérologie continentale était, dans l’ensemble, une discipline simple et stable que les Allemands faisaient progresser doucement."
                                            }
                                        ]
                                    }
                                ]
