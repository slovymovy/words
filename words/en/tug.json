                            },
                            {
                                "target_lang_word": "牵引",
                                "target_lang_sense_clarification": "拉动船只"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "holować",
                                "target_lang_sense_clarification": "ciągnąć inny statek na linie"
                            },
                            {
                                "target_lang_word": "odholować",
                                "target_lang_sense_clarification": "dostarczyć statek w inne miejsce przez holowanie"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "táhnout",
                                "target_lang_sense_clarification": "vléci jiné plavidlo"
                            },
                            {
                                "target_lang_word": "odvléci",
                                "target_lang_sense_clarification": "dopravit plavidlo na místo"
                            },
                            {
                                "target_lang_word": "remorkovat",
                                "target_lang_sense_clarification": "odborný termín pro vlečení lodí"
                            }
                        ]
                    }
