                                "target_senses": [
                                    {
                                        "sense_id": "04ba1621-0670-3ac4-aba0-72f19caa9ed3",
                                        "entry_id": "9aeae276-77fd-30a9-8282-8c2168871911",
                                        "glosses": [
                                            "A large, striped, African antelope of the species Tragelaphus imberbis (lesser kudu) or Tragelaphus strepsiceros (greater kudu)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b23fd41c-33ac-4f1b-ba0e-66899135e4dc",
                                                "sense_id": "04ba1621-0670-3ac4-aba0-72f19caa9ed3",
                                                "text": "Martha, on a hot, wet, steamy afternoon, had spent two hours wriggling on her stomach through the undergrowth to reach a point where she might shoot a big koodoo that was grazing in a corner of the Hundred Acres."
                                            },
                                            {
                                                "example_id": "3c1521d5-6dba-4dd3-b373-9671246efe20",
                                                "sense_id": "04ba1621-0670-3ac4-aba0-72f19caa9ed3",
                                                "text": "I watched from a distance as rangers left a kudu carcass to entice the lions to walk through the gates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8420559e-2dbc-459b-a9d0-0266c9ce6861",
                        "source_entry_id": "a2473b9f-d802-3931-86e8-23057609572c",
                        "source_sense_id": "e5e21971-3730-306e-8c25-1b05812f8ca7",
                        "source_sense_description": "Antilopenart",
                        "target_lang_word": "koudou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koudou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b52ab888-af75-3bf1-be7a-e0a3b7e13746",
                                        "entry_id": "d055838d-2d67-3e72-b177-288cd7288d6e",
                                        "glosses": [
                                            "Une des espèces de grandes antilopes d’Afrique, à longues cornes droites torsadées chez le mâle, à pelage rayé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5fa6a2-7082-4f61-b6f0-b3a647a116e0",
                                                "sense_id": "b52ab888-af75-3bf1-be7a-e0a3b7e13746",
                                                "text": "– Sais-tu ce que c’est qu’un koudou ?\n– Un koudou ? Oui.\n– Qu’est-ce que c’est ?\n– Une espèce de grande bête, mi-cerf, mi-buffle, avec une crinière noire, et des raies blanches sur les flancs.\n– C’est ça, bravo !"
                                            },
                                            {
                                                "example_id": "92aed9e2-7510-421a-9854-a1ecdbe9b9c8",
                                                "sense_id": "b52ab888-af75-3bf1-be7a-e0a3b7e13746",
                                                "text": "Après des jours de poursuite, le koudou aux cornes merveilleuses est là, devant moi, à 300 mètres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
