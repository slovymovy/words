                    {
                        "sense_id": "03c14468-d845-34b8-b33a-70024cc06e9c",
                        "entry_id": "86d93e8d-24c4-32b1-bcb0-adefa9e6a3db",
                        "glosses": [
                            "Kosten für das Material, aus dem ein Gegenstand besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b824d1ba-c60c-485f-a349-77e0ceec2499",
                                "sense_id": "03c14468-d845-34b8-b33a-70024cc06e9c",
                                "text": "„Die Materialkosten lassen sich relativ einfach aus den Lieferantenrechnungen für die unterschiedlichen Verbrauchsstoffe ermitteln.“"
                            },
                            {
                                "example_id": "a9b9917c-249b-4f5c-af01-c23b4f9654d1",
                                "sense_id": "03c14468-d845-34b8-b33a-70024cc06e9c",
                                "text": "„In der hierarchischen Betrachtung lassen sich die Herstellkosten in Materialkosten und Fertigungskosten aufteilen.“"
                            },
                            {
                                "example_id": "d9bb444e-a9c8-41ae-90f7-dce2667cfdc6",
                                "sense_id": "03c14468-d845-34b8-b33a-70024cc06e9c",
                                "text": "„Bestellt er bei dem kostengünstigsten Lieferanten, kann er in diesem Beschaffungsfall die Materialkosten im Unternehmen reduzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
