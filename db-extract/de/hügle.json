                ],
                "senses": [
                    {
                        "sense_id": "b0e1f47d-6812-32b3-bbbd-5e273d624fd2",
                        "entry_id": "69bea633-dd07-37f5-9535-8a20186543b8",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d6b6ec2-8a4c-406a-a74e-2a880cd3a6d5",
                                "sense_id": "b0e1f47d-6812-32b3-bbbd-5e273d624fd2",
                                "text": "Frau Hügle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0070efdd-c178-4a51-9e0f-f8ff9644561b",
                                "sense_id": "b0e1f47d-6812-32b3-bbbd-5e273d624fd2",
                                "text": "Herr Hügle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "42829a8d-025d-405b-b38e-593c0f500390",
                                "sense_id": "b0e1f47d-6812-32b3-bbbd-5e273d624fd2",
                                "text": "Die Hügles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a22abb15-4433-4edb-9cc6-49da87f45e7c",
                                "sense_id": "b0e1f47d-6812-32b3-bbbd-5e273d624fd2",
                                "text": "Der Hügle trägt nie die Pullover, die die Hügle ihm strickt."
                            },
                            {
                                "example_id": "9e39c048-6f1c-45b0-b5e2-888c2ec4ccf8",
                                "sense_id": "b0e1f47d-6812-32b3-bbbd-5e273d624fd2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hügle kommt, geht der Herr Hügle.“"
                            },
                            {
                                "example_id": "a0bfc871-c26a-4cff-8b20-99f91ecd2bff",
                                "sense_id": "b0e1f47d-6812-32b3-bbbd-5e273d624fd2",
                                "text": "Hügle kommt und geht."
                            },
                            {
                                "example_id": "6fb22879-667e-4872-ad41-d1ef03b54219",
                                "sense_id": "b0e1f47d-6812-32b3-bbbd-5e273d624fd2",
                                "text": "Hügles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
