                        ],
                        "examples": [
                            {
                                "example_id": "23c99096-eb61-4cd9-9ce9-06b9fbf50108",
                                "sense_id": "35dee831-c6ad-39b7-90ac-446d140d9222",
                                "text": "Les producteurs cherchent un idéateur qui pourra les aider à renouveler l'émission."
