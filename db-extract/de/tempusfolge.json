                "senses": [
                    {
                        "sense_id": "a228f9d0-ea8f-3ae3-bec9-b1ed69292863",
                        "entry_id": "a9549180-8fb9-3740-bcbd-4cb59030c3e3",
                        "glosses": [
                            "Regelung der Wahl der Tempora im komplexen Satz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd44104-4600-47a7-a60f-11ecb13a793e",
                                "sense_id": "a228f9d0-ea8f-3ae3-bec9-b1ed69292863",
                                "text": "„Und wenn er im Englischen die Tempusfolge durcheinanderbrachte, war die Grammatik eben nicht für sein Gehirn gemacht.“"
                            },
                            {
                                "example_id": "92a4ef99-5bc9-421b-9176-a8ca74a0991a",
                                "sense_id": "a228f9d0-ea8f-3ae3-bec9-b1ed69292863",
                                "text": "„Das beginnt bei der terminologischen Fassung der grammatischen Inhalte und reicht bis zum „richtigen“ Gebrauch grammatischer Formen wie des Konjunktivs oder der „Tempusfolge“ in Texten.“"
                            },
                            {
                                "example_id": "4641fb3e-5b00-419b-ad43-16682783ed36",
                                "sense_id": "a228f9d0-ea8f-3ae3-bec9-b1ed69292863",
                                "text": "„In der Grammatik erweitern Sie Ihre Kenntnisse gegenüber der Stufe A 2 vor allem in den Bereichen: Tempora (Präteritum, Plusquamperfekt) Tempusfolge, Nebensätze, Relativsätze, Konjunktiv II, Aktiv-Passiv, Verben mit Präposition u.a.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
