                                "target_senses": [
                                    {
                                        "sense_id": "9b614c12-1823-33d8-8451-396b94293724",
                                        "entry_id": "253f2ece-867c-34dd-bbcb-e928badc349c",
                                        "glosses": [
                                            "eine Gemeinde in Baden-Württemberg, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "438ae4ee-42c9-4cdb-9fdf-fc8b11042d16",
                                                "sense_id": "9b614c12-1823-33d8-8451-396b94293724",
                                                "text": "Hasel liegt in Deutschlands Südwesten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hasel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb74605-7cfe-3903-9922-6b7f8e0f55da",
                                        "entry_id": "98d78f13-3fa1-31e0-bbf1-0d866c293660",
                                        "glosses": [
                                            "kleiner europäischer Süßwasserfisch mit gegabelter Schwanzflosse, ähnlich dem Döbel"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43d10fb-aafa-4080-951f-6b396f9482e0",
                                                "sense_id": "2cb74605-7cfe-3903-9922-6b7f8e0f55da",
                                                "text": "Der Hasel schwimmt meistens im Schwarm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hasel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e71fa716-d313-3685-85b6-8c6fb03088e0",
                                        "entry_id": "1592c83d-f483-30d4-8682-9327c770ce9e",
                                        "glosses": [
                                            "Strauch, der Haselnüsse trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c7a6d2-4790-49be-97ab-8ef689f0cfee",
                                                "sense_id": "e71fa716-d313-3685-85b6-8c6fb03088e0",
                                                "text": "„Die Hasel wächst in der Regel als vielstämmiger, aufrechter Strauch von fünf bis sechs Metern Höhe.“"
                                            },
                                            {
                                                "example_id": "6be2dd94-9933-4696-8090-684eb6471e85",
                                                "sense_id": "e71fa716-d313-3685-85b6-8c6fb03088e0",
                                                "text": "„Die Hasel bildet viele Bodentriebe, die Sträucher werden im Alter oft sehr breit.“"
                                            },
                                            {
                                                "example_id": "6623d3d4-95a3-46ae-8d87-6c2318e9d0af",
                                                "sense_id": "e71fa716-d313-3685-85b6-8c6fb03088e0",
                                                "text": "„Milde Temperaturen und trockenes Wetter sorgen bereits in den ersten Wochen des Jahres für einen Pollenflug. Dies vor allem in Basel und im Tessin, wo der Hasel blüht.“"
                                            },
                                            {
                                                "example_id": "0004a63d-8a7f-4402-a59b-e21f20ab377b",
                                                "sense_id": "e71fa716-d313-3685-85b6-8c6fb03088e0",
                                                "text": "„Wenn der Hasel blüht, kann es für Allergiker unangenehm werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
