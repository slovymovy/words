                        ],
                        "examples": [
                            {
                                "example_id": "6474315c-6691-4a67-ae34-2945bbad3fb3",
                                "sense_id": "34739a12-38ff-34c8-8533-fcb6b4beebcf",
                                "text": "Nous ne demandons pas mieux que l’on passe au tarif, et que la lice soit ouverte ; et c’est-là que nous attendons le membre qui nous dit que sa raison n’étoit point combattable."
                            },
                            {
