                {
                    "sense_id": "c5ba3c3f-4f95-38df-adf2-a87fdeeda5ad",
                    "sense_definition": "A very long river in South America that flows through Brazil to the Atlantic Ocean.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Amazon</w> is the second longest river in the world.",
