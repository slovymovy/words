                        "examples": [
                            {
                                "example_id": "f0a9dba1-8df8-414b-98e1-660e1543e2ad",
                                "sense_id": "e55336aa-2713-354c-b966-833b3427cf6f",
                                "text": "O beautiful for spacious skies, for amber wafes of grain, for purple mountain majesties above the fruited plain!"
                            },
                            {
                                "example_id": "fe8f38d0-1703-4ccb-abe6-60f8bbccba66",
                                "sense_id": "e55336aa-2713-354c-b966-833b3427cf6f",
                                "text": "Jim, importuned, had come with his axe and at her wish had felled it with the fruited but unripe mistletoe."
                            },
                            {
                                "example_id": "d0f0ba71-9b80-468a-853a-062a507199fe",
                                "sense_id": "e55336aa-2713-354c-b966-833b3427cf6f",
                                "text": "Sea Bass With Fruited Tomatillo Salsa"
                            },
                            {
                                "example_id": "c545e5cf-2ebd-4bab-b5ab-0fe079836914",
                                "sense_id": "e55336aa-2713-354c-b966-833b3427cf6f",
                                "text": "Kikuchi (1946) classified Pyrus species into three groups, small fruited species with two carpels, large fruited species with five carpels, and their hybrids with 3-4 carpels."
                            }
                        ]
                    },
                    {
                        "sense_id": "53d684d2-99f6-35e8-b2a4-08155c08de00",
                        "entry_id": "48172956-f96a-3443-a2ee-b4eb77188ee8",
                        "glosses": [
                            "Containing fruit; bearing fruit.",
                            "Bearing fruit or acorns, typically of a specified tincture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "269e1b2d-32f3-4859-aaba-5c70f063b0f8",
                                "sense_id": "53d684d2-99f6-35e8-b2a4-08155c08de00",
                                "text": "[…] the first gules, a chevron or, between three heads erased; the second vert, an oak tree, fruited or[…]"
                            },
                            {
                                "example_id": "28cc3f37-8f20-40b9-b035-e952cd3ae630",
                                "sense_id": "53d684d2-99f6-35e8-b2a4-08155c08de00",
                                "text": "[…]; Or, an olive tree eradicated proper, by the name of Montolivet; Or, on a mound a pear tree fruited proper, by the name of Pyrton; Sable, an apple tree or, fruited gules, by the name of Verse, in Flanders."
                            },
                            {
                                "example_id": "f4e56a4d-7545-4234-98e7-297684884aa3",
                                "sense_id": "53d684d2-99f6-35e8-b2a4-08155c08de00",
                                "text": "A white horse holding in his mouth a sprig of oak. 2. The same galloping before an oak-tree fruited or (Fig. 178)."
                            },
                            {
                                "example_id": "76fa6a52-455f-4eb2-bb19-7aec328ad32c",
                                "sense_id": "53d684d2-99f6-35e8-b2a4-08155c08de00",
                                "text": "Azure , on a mount an apple tree fruited proper, are the armes parlantes of the Dutch APPELBOOMS, and of the Barons APFALTRER."
                            },
                            {
                                "example_id": "311f4a9c-307e-4194-b56f-13f3a166c7e4",
                                "sense_id": "53d684d2-99f6-35e8-b2a4-08155c08de00",
                                "text": "Gold a pear tree fruited gules"
                            }
                        ]
