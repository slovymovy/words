    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "516d0d62-5e7d-3594-9064-d1d15920bfef",
                    "sense_definition": "Of an acceptable standard or quality; satisfactory.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quality_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room was small but <w>decent</w> for the price.",
                            "target_lang_translations": {
                                "ru": "Номер в отеле был маленьким, но <w>прили́чным</w> для такой цены.",
                                "zh": "酒店房间虽小，但在这个价位已经很<w>不错</w>了。"
                            }
                        },
                        {
                            "text": "He finally found a <w>decent</w> job with a good salary.",
                            "target_lang_translations": {
                                "ru": "Он наконец нашел <w>досто́йную</w> работу с хорошей зарплатой.",
                                "zh": "他终于找到了一份薪水<w>体面</w>的工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "satisfactory",
                        "good",
                        "adequate",
                        "respectable"
                    ],
                    "antonyms": [
                        "poor",
                        "unsatisfactory",
                        "inadequate"
                    ],
                    "common_phrases": [
                        "decent job",
                        "decent meal",
                        "decent quality",
                        "pretty decent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приемлемого уровня или качества; удовлетворительный.",
                        "zh": "达到可接受的标准或质量；令人满意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прили́чный",
                                "target_lang_sense_clarification": "хорошего качества"
                            },
                            {
                                "target_lang_word": "неплохо́й",
                                "target_lang_sense_clarification": "удовлетворительный"
                            },
                            {
                                "target_lang_word": "досто́йный",
                                "target_lang_sense_clarification": "заслуживающий уважения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不错",
                                "target_lang_sense_clarification": "质量尚可"
                            },
                            {
                                "target_lang_word": "体面",
                                "target_lang_sense_clarification": "质量较好，令人满意"
                            },
                            {
                                "target_lang_word": "像样",
                                "target_lang_sense_clarification": "达到一定标准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2816b314-9a08-35de-bb98-05c1576f1596",
                    "sense_definition": "Honest, polite, and following accepted moral standards.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "moral_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>decent</w> person who always tries to help her neighbors.",
                            "target_lang_translations": {
                                "ru": "Она <w>поря́дочный</w> человек, который всегда старается помочь соседям.",
                                "zh": "她是个<w>正派</w>人，总是尽力帮助邻居。"
                            }
                        },
                        {
                            "text": "It was very <w>decent</w> of him to apologize for his mistake.",
                            "target_lang_translations": {
                                "ru": "С его стороны было очень <w>поря́дочно</w> извиниться за свою ошибку.",
                                "zh": "他能为自己的错误道歉，真是非常<w>体面</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moral",
                        "good"
                    ],
                    "antonyms": [
                        "immoral",
                        "bad"
                    ],
                    "common_phrases": [
                        "decent human being",
                        "decent thing to do",
                        "decent guy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Честный, вежливый и соблюдающий принятые моральные нормы.",
                        "zh": "诚实、有礼貌且遵循公认的道德标准。"
                    },
                    "translations": {
                        "ru": [
                            {
