                    {
                        "sense_id": "0558421a-1c26-3c75-94fc-d15d9918042f",
                        "entry_id": "7847f62c-9844-39d2-9c16-5822a2fa74fa",
                        "glosses": [
                            "Sorte de trottinette pour adultes, montée sur deux roues pneumatiques et pourvue d’un petit moteur."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "bc8e2225-f72f-47ee-9368-c0d2a1d72a4e",
                                "sense_id": "0558421a-1c26-3c75-94fc-d15d9918042f",
                                "text": "L’autopède, surnommée à tort l’automobile du pauvre, a une grande vogue sur les plages et terrains de sport d’Amérique."
                            },
                            {
                                "example_id": "98d1564d-6c09-4413-a4ec-de7055ff2843",
                                "sense_id": "0558421a-1c26-3c75-94fc-d15d9918042f",
                                "text": "L’autopède est une patinette à l’usage des adultes. Si vous rencontrez, rue de Presbourg, un monsieur en veston de coupe irréprochable, le monocle à l’œil, un peu grave, monté sur une planchette à deux roues pneumatiques qui fait un bruit de teuf-teuf, filant à toute allure sur l’asphalte du trottoir, l’instrument s’appelle l’autopède, le monsieur qui le conduit se nomme l’autopédon."
                            }
                        ]
                    }
