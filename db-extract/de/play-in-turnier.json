                "senses": [
                    {
                        "sense_id": "1a7bd4ec-d643-336a-b6e7-2a712a6060d4",
                        "entry_id": "f7687510-a083-3aec-b7f2-d1c826bbb2fc",
                        "glosses": [
                            "Anfangsphase eines Turniers, in der die niedrigsten Qualifikanten gegeneinander spielen, bevor der Hauptteil des Turniers beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15601abc-024b-4167-bc58-77171f6dc48b",
                                "sense_id": "1a7bd4ec-d643-336a-b6e7-2a712a6060d4",
                                "text": "„Im sogenannten Play-in-Turnier werden innerhalb von vier Tagen in K.o.-Duellen die verbleibenden vier Plätze für die Playoffs ausgespielt.“"
                            },
                            {
                                "example_id": "2b90ccad-d69d-4aca-8050-862ab363d4b4",
                                "sense_id": "1a7bd4ec-d643-336a-b6e7-2a712a6060d4",
                                "text": "„Die Qualifikation zur Postseason läuft in der Saison 2020/21 dank des Play-In-Turniers etwas anders ab als in den vergangenen Jahren.“"
                            },
                            {
                                "example_id": "efb793c1-96e6-4aa4-8c60-ea24e59ae0a9",
                                "sense_id": "1a7bd4ec-d643-336a-b6e7-2a712a6060d4",
                                "text": "„Die letzten beiden Play-off-Plätze jeder Conference werden zudem von den siebt- bis zehntplatzierten Teams in einem \"Play-In\"-Turnier vergeben.“"
                            },
                            {
                                "example_id": "319d3c7d-6556-46f9-b77d-3a9cdadf4058",
                                "sense_id": "1a7bd4ec-d643-336a-b6e7-2a712a6060d4",
                                "text": "„Dennoch kann sich der Titelverteidiger noch im Play-In-Turnier ein Playoff-Ticket erkämpfen. “"
                            },
                            {
                                "example_id": "a943791e-4dad-46ba-a4cf-58bd00e78f29",
                                "sense_id": "1a7bd4ec-d643-336a-b6e7-2a712a6060d4",
                                "text": "„Die NBA bekommt bei der Premiere des Play-In-Turniers direkt ein absolutes Traum-Matchup serviert. Selbst ohne LeBron James und Stephen Curry hätte sich das Konzept aber bereits als voller Erfolg erwiesen - und dürfte in Zukunft fester Bestandteil des NBA-Spielplans werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
