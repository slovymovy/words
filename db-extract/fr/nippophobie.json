                                        "entry_id": "294cef71-7661-37ab-9919-308063fd2a53",
                                        "glosses": [
                                            "A fear or hate of Japan and Japanese people or culture."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c78a74-18d3-4f7e-bcb8-9a73a402a5f0",
                                                "sense_id": "5ed3bb30-05f6-3a01-be7b-0bc5b88f05e7",
                                                "text": "Perhaps this is one of the reasons of their Japanophobia. But if Japan became the ally of France, all this fear and suspicion of Japan would disappear, ..."
                                            },
                                            {
                                                "example_id": "294b9041-a022-4276-ac33-95496fa88d73",
                                                "sense_id": "5ed3bb30-05f6-3a01-be7b-0bc5b88f05e7",
                                                "text": "This would require discarding the extreme Japanophobia that characterises the so-called “revisionists” who are really “regressionists” twice over."
                                            }
                                        ]
                                    }
                                ]
                            }
