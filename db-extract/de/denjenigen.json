                ],
                "senses": [
                    {
                        "sense_id": "f2edb2f8-1976-3740-b0dd-28b816f0d9e4",
                        "entry_id": "8dfe7223-2a1f-31e8-afde-241e898ad173",
                        "glosses": [
                            "Akkusativ Singular Maskulin des Demonstrativpronomens derjenige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ef1939-d287-4642-8498-433e2ec62665",
                                "sense_id": "f2edb2f8-1976-3740-b0dd-28b816f0d9e4",
                                "text": "„Sie arbeiten nur für denjenigen, der ihre Bemühung für sein Vergnügen belohnen kann.“"
                            },
                            {
                                "example_id": "7f9ce9bf-d19d-45be-a79b-1563308b2588",
                                "sense_id": "f2edb2f8-1976-3740-b0dd-28b816f0d9e4",
                                "text": "„Ich war schon achtzehn Jahre alt, eh ich denjenigen kannte, dem ich mein Dasein zu danken habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "353f0f0a-7a80-30b7-9147-4bdcfc945116",
                        "entry_id": "8dfe7223-2a1f-31e8-afde-241e898ad173",
                        "glosses": [
                            "Dativ Plural des Demonstrativpronomens derjenige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2897e73b-f83a-45a2-9a05-31dfa0ca4c4e",
                                "sense_id": "353f0f0a-7a80-30b7-9147-4bdcfc945116",
                                "text": "„Vergleichen wir einmal diese Völker mit denjenigen, welche unter den Bedrückungen der willkürlichen Gewalt einer harten Regierung schmachten!“"
                            },
                            {
                                "example_id": "58886942-82bd-4045-8703-f8316a0809f3",
                                "sense_id": "353f0f0a-7a80-30b7-9147-4bdcfc945116",
                                "text": "„Und droht schon mal denjenigen, die diesem Zeitplan noch im Wege stehen könnten: den Ärzten und Krankenkassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bafab7f5-7d5b-49d3-849e-40cdf575b8eb",
                        "source_entry_id": "8dfe7223-2a1f-31e8-afde-241e898ad173",
                        "source_sense_id": "f2edb2f8-1976-3740-b0dd-28b816f0d9e4",
                        "source_sense_description": "Akkusativ Singular Maskulin des Demonstrativpronomens derjenige",
                        "target_lang_word": "aquel",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquel",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "aae1589f-a065-3d7d-9310-309f54543e11",
                                        "entry_id": "ed97a46f-7898-329b-8484-0650b7a17974",
                                        "glosses": [
                                            "Se refiere a algo que está lejos, en el espacio o en el tiempo, de la persona que habla y de la persona con quien se habla."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bce0d03-44f9-4562-ad36-f39bf21f83f9",
                                                "sense_id": "aae1589f-a065-3d7d-9310-309f54543e11",
                                                "text": "No quiero este libro que está aquí, sino aquel que está allá."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "aquel",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "86e53d0f-cb09-3221-85a9-3a8416971c38",
                                        "entry_id": "495cbde9-afe6-3991-a856-ee34f4d2a777",
                                        "glosses": [
                                            "Se refiere a algo que está lejos, en el espacio o en el tiempo, de la persona que habla y de la persona con quien se habla."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda41b99-c173-48a3-8787-48f5511a79e9",
                                                "sense_id": "86e53d0f-cb09-3221-85a9-3a8416971c38",
                                                "text": "¿Recuerdas a aquella joven que vimos el mes pasado cantando en el bus?"
                                            },
                                            {
                                                "example_id": "4259df48-0c47-4f29-b4f2-acab4e58cead",
                                                "sense_id": "86e53d0f-cb09-3221-85a9-3a8416971c38",
                                                "text": "(como sustantivo): \"Ambos libros son muy bonitos, y traen un aquel de amores y besos, que me daba mucho gusto ouando a escondidas los leía yo\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de7cf7cc-aa34-32dc-a74c-01d0ce8c79dd",
                                        "entry_id": "495cbde9-afe6-3991-a856-ee34f4d2a777",
                                        "glosses": [
                                            "Designa una persona u objeto cuyo nombre no quiere mencionarse, denotando complicidad con quien se habla."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80220071-84ac-4790-b80c-d8e0c5258a97",
                                                "sense_id": "de7cf7cc-aa34-32dc-a74c-01d0ce8c79dd",
                                                "text": "Ayer me vi con aquel (una persona especial o particular)."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "aquel",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "632fe4de-f6b8-33be-bbe4-e4ac3122199f",
                                        "entry_id": "17b3672c-e457-317f-980f-d8f63be87987",
                                        "glosses": [
                                            "Característica, atractivo o encanto que no se puede definir (indefinible) o complejidad que no es evidente."
