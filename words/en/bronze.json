{
    "word_family": [
        "bronzer",
        "bronzy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3608472-03cb-3545-b59a-d2f49d4d4430",
                    "sense_definition": "A metal alloy made of copper and tin, used historically for tools and weapons and currently for statues and medals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient tools were crafted from <w>bronze</w>.",
                            "target_lang_translations": {
                                "ru": "Древние инструменты были изготовлены из <w>бронзы</w>.",
                                "zh": "古代工具是用<w>青铜</w>制作的。"
                            }
                        },
                        {
                            "text": "Statues made of <w>bronze</w> can withstand the weather for centuries.",
                            "target_lang_translations": {
                                "ru": "Статуи из <w>бронзы</w> могут веками противостоять непогоде.",
                                "zh": "<w>青铜</w>雕像可以抵御几个世纪的风雨。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cast in bronze",
                        "Bronze Age",
                        "bronze sculpture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплав меди с оловом, исторически использовавшийся для инструментов и оружия, а в настоящее время — для статуй и медалей.",
                        "zh": "一种铜和锡的合金，历史上用于制造工具和武器，目前用于制作雕像和奖牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бро́нза",
                                "target_lang_sense_clarification": "сплав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "青铜",
                                "target_lang_sense_clarification": "金属合金"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c35dd1b-ebee-3cc2-9f5c-58ad59581052",
                    "sense_definition": "A medal awarded to the person or team that finishes third in a competition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was proud to bring home the <w>bronze</w> for her country.",
                            "target_lang_translations": {
                                "ru": "Она гордилась тем, что привезла домой <w>бронзу</w> для своей страны.",
                                "zh": "她为能给国家带回一枚<w>铜牌</w>而感到自豪。"
                            }
                        },
                        {
                            "text": "He missed the silver by a fraction of a second but secured the <w>bronze</w>.",
                            "target_lang_translations": {
                                "ru": "Он упустил серебро на долю секунды, но завоевал <w>бронзу</w>.",
                                "zh": "他以微弱差距错失银牌，但还是拿到了<w>铜牌</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "win the bronze",
                        "take the bronze",
                        "bronze medalist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медаль, присуждаемая человеку или команде, занявшим третье место в соревновании.",
                        "zh": "授予比赛中获得第三名的个人或团队的奖牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бро́нза",
                                "target_lang_sense_clarification": "медаль (разговорное)"
                            },
                            {
                                "target_lang_word": "бро́нзовая меда́ль",
                                "target_lang_sense_clarification": "награда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜牌",
                                "target_lang_sense_clarification": "奖牌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47db687d-455d-390a-a112-2b3a368bb3d4",
                    "sense_definition": "A reddish-brown color resembling the metal bronze.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car is painted a deep, metallic <w>bronze</w>.",
                            "target_lang_translations": {
                                "ru": "Машина покрашена в глубокий металлический <w>бронзовый цвет</w>.",
                                "zh": "这辆车漆成了深邃的金属<w>青铜色</w>。"
                            }
                        },
                        {
                            "text": "She chose a warm <w>bronze</w> for the living room curtains.",
                            "target_lang_translations": {
                                "ru": "Она выбрала теплую <w>бронзу</w> для штор в гостиной.",
                                "zh": "她为客厅的窗帘选择了温暖的<w>青铜色</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dark bronze",
                        "metallic bronze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красновато-коричневый цвет, напоминающий металл бронзу.",
                        "zh": "一种类似于青铜金属的红褐色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бро́нза",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "цвет бро́нзы",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "青铜色",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f32eaf5-989d-380a-8506-db42390a1bd7",
                    "sense_definition": "A work of art, especially a sculpture, made of bronze.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum has a fine collection of Renaissance <w>bronzes</w>.",
                            "target_lang_translations": {
                                "ru": "В музее есть прекрасная коллекция ренессансной <w>бронзы</w>.",
                                "zh": "博物馆收藏了许多精美的文艺复兴时期<w>青铜器</w>。"
                            }
                        },
                        {
                            "text": "He bought a small <w>bronze</w> of a horse at the auction.",
                            "target_lang_translations": {
                                "ru": "Он купил на аукционе небольшую <w>бронзовую статуэтку</w> лошади.",
                                "zh": "他在拍卖会上买了一件小型的马形<w>青铜雕塑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ancient bronzes",
                        "exhibition of bronzes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произведение искусства, особенно скульптура, сделанное из бронзы.",
                        "zh": "艺术品，特别是用青铜制成的雕塑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бро́нза",
                                "target_lang_sense_clarification": "предметы искусства (собирательное)"
                            },
                            {
                                "target_lang_word": "изде́лие из бро́нзы",
                                "target_lang_sense_clarification": "предмет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "青铜器",
                                "target_lang_sense_clarification": "艺术品"
                            },
                            {
                                "target_lang_word": "青铜雕塑",
                                "target_lang_sense_clarification": "艺术品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3562a67c-887a-3f87-bf43-9a7a730b406f",
                    "sense_definition": "Boldness or lack of shame; impudence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attitude_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He faced the crowd with characteristic <w>bronze</w> despite his errors.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свои ошибки, он предстал перед толпой с характерной <w>наглостью</w>.",
                                "zh": "尽管犯了错，他还是以一贯的<w>厚颜无耻</w>面对人群。"
                            }
                        },
                        {
                            "text": "Such <w>bronze</w> is rarely seen in polite society these days.",
                            "target_lang_translations": {
                                "ru": "Такое <w>бесстыдство</w> редко можно встретить в приличном обществе в наши дни.",
                                "zh": "如今在文明社会中很少见到这种<w>无耻</w>行径。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brass"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage is literary or obsolete"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дерзость или отсутствие стыда; наглость.",
                        "zh": "大胆或不知羞耻；厚颜无耻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на́глость",
                                "target_lang_sense_clarification": "поведение"
                            },
                            {
                                "target_lang_word": "бессты́дство",
                                "target_lang_sense_clarification": "поведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厚颜无耻",
                                "target_lang_sense_clarification": "行为"
                            },
                            {
                                "target_lang_word": "无耻",
                                "target_lang_sense_clarification": "行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "854f1814-13e6-34dd-8639-9582e9d46e12",
                    "sense_definition": "Made of the metal bronze.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They found a <w>bronze</w> artifact buried in the ground.",
                            "target_lang_translations": {
                                "ru": "Они нашли в земле <w>бронзовый</w> артефакт.",
                                "zh": "他们在地下发现了一件<w>青铜</w>文物。"
                            }
                        },
                        {
                            "text": "The <w>bronze</w> gate was heavy and covered in ornate designs.",
                            "target_lang_translations": {
                                "ru": "<w>Бронзовые</w> ворота были тяжелыми и покрытыми витиеватыми узорами.",
                                "zh": "<w>青铜</w>大门很重，上面布满了华丽的图案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bronzen"
                    ],
                    "common_phrases": [
                        "bronze statue",
                        "bronze coin",
                        "bronze medal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из металла бронзы.",
                        "zh": "由青铜金属制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бро́нзовый",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "青铜的",
                                "target_lang_sense_clarification": "材质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca0ff97c-e3b7-3758-ab5e-1c771adf2278",
                    "sense_definition": "Having a reddish-brown color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leaves turned <w>bronze</w> and gold in the autumn.",
                            "target_lang_translations": {
                                "ru": "Осенью листья стали <w>бронзовыми</w> и золотыми.",
                                "zh": "秋天，树叶变成了<w>青铜色</w>和金色。"
                            }
                        },
                        {
                            "text": "She wore a beautiful <w>bronze</w> dress to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела красивое <w>бронзовое</w> платье на вечеринку.",
                                "zh": "她穿着一件漂亮的<w>青铜色</w>礼服去参加聚会。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bronze tone",
                        "bronze highlights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий красновато-коричневый цвет.",
                        "zh": "具有红褐色的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бро́нзовый",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "青铜色的",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a86117cd-befa-31b4-b36c-26dc6cf91d99",
                    "sense_definition": "Having skin that is darkened or tanned by the sun.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked fit and <w>bronze</w> after his summer holiday.",
                            "target_lang_translations": {
                                "ru": "После летнего отпуска он выглядел подтянутым и <w>загорелым</w>.",
                                "zh": "暑假过后，他看起来既健康又<w>晒黑</w>了。"
                            }
                        },
                        {
                            "text": "The lifeguard was tall, muscular, and <w>bronze</w>.",
                            "target_lang_translations": {
                                "ru": "Спасатель был высоким, мускулистым и <w>бронзовым</w> от загара.",
                                "zh": "救生员身材高大、肌肉发达，皮肤呈<w>古铜色</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bronze skin",
                        "bronze body"
                    ],
                    "target_lang_definitions": {
                        "ru": "О коже: потемневшая или загорелая от солнца.",
                        "zh": "指皮肤因阳光照射而变黑或晒黑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загоре́лый",
                                "target_lang_sense_clarification": "о коже"
                            },
                            {
                                "target_lang_word": "бро́нзовый",
                                "target_lang_sense_clarification": "о цвете загара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晒黑的",
                                "target_lang_sense_clarification": "皮肤状态"
                            },
                            {
                                "target_lang_word": "古铜色的",
                                "target_lang_sense_clarification": "肤色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a996152-5362-35fe-bb1e-7341bd03502e",
                    "sense_definition": "To make or become brown or tanned from exposure to the sun.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We lay on the beach all afternoon to <w>bronze</w> our legs.",
                            "target_lang_translations": {
                                "ru": "Мы пролежали на пляже весь день, чтобы наши ноги <w>загорели</w>.",
                                "zh": "我们在海滩上躺了一下午，想把腿<w>晒黑</w>。"
                            }
                        },
                        {
                            "text": "His skin <w>bronzed</w> quickly in the intense tropical heat.",
                            "target_lang_translations": {
                                "ru": "Его кожа быстро <w>покрылась бронзовым загаром</w> на сильной тропической жаре.",
                                "zh": "在强烈的热带阳光下，他的皮肤很快就<w>晒黑</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bronze in the sun",
                        "bronzed skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать или становиться коричневым или загорелым от воздействия солнца.",
                        "zh": "因暴露在阳光下而变棕色或晒黑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загора́ть",
                                "target_lang_sense_clarification": "становиться смуглым"
                            },
                            {
                                "target_lang_word": "бронзове́ть",
                                "target_lang_sense_clarification": "приобретать бронзовый оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晒黑",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc90c30c-9ecf-346c-bd4e-f2e74038e177",
                    "sense_definition": "To cover an object with a layer of bronze for preservation or decoration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>bronze</w> her son's first pair of shoes as a keepsake.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>забронзировать</w> первую пару обуви своего сына на память.",
                                "zh": "她决定把儿子第一双鞋<w>镀青铜</w>作为纪念。"
                            }
                        },
                        {
                            "text": "The artist <w>bronzes</w> organic materials like leaves to create jewelry.",
                            "target_lang_translations": {
                                "ru": "Художник <w>бронзирует</w> органические материалы, такие как листья, для создания украшений.",
                                "zh": "艺术家将树叶等有机材料<w>镀青铜</w>来制作首饰。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bronze baby shoes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать предмет слоем бронзы для сохранения или украшения.",
                        "zh": "为了保存或装饰，在物体表面覆盖一层青铜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бронзи́ровать",
                                "target_lang_sense_clarification": "покрывать бронзой"
                            },
                            {
                                "target_lang_word": "покрыва́ть бро́нзой",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镀青铜",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5480a45f-a6e3-32ed-bfac-17e0a2ff0ee5",
                    "sense_definition": "To finish in third place in a competition and win a bronze medal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>bronzed</w> in the 100-meter dash after a close race.",
                            "target_lang_translations": {
                                "ru": "Он <w>взял бронзу</w> в забеге на 100 метров после напряженной гонки.",
                                "zh": "在激烈的比赛后，他在100米短跑中<w>获得铜牌</w>。"
                            }
                        },
                        {
                            "text": "After winning gold last year, she only <w>bronzed</w> this time around.",
                            "target_lang_translations": {
                                "ru": "Выиграв золото в прошлом году, в этот раз она лишь <w>взяла бронзу</w>.",
                                "zh": "继去年夺金后，她这次只<w>获得铜牌</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Занять третье место в соревновании и выиграть бронзовую медаль.",
                        "zh": "在比赛中获得第三名并赢得铜牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять бро́нзу",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "завоева́ть бро́нзу",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得铜牌",
                                "target_lang_sense_clarification": "体育"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
