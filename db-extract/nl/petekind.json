                "senses": [
                    {
                        "sense_id": "1b179e8a-a451-3c38-ac0a-85f15e9fdd6e",
                        "entry_id": "31326d1c-c02e-33fe-9969-ef440b2a9254",
                        "glosses": [
                            "een kind dat men ten doop gehouden heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "388c6a43-f563-4842-9118-5b7a1204bd98",
                                "sense_id": "1b179e8a-a451-3c38-ac0a-85f15e9fdd6e",
                                "text": "Hij is een petekind."
                            },
                            {
                                "example_id": "c080a685-26c4-43f6-ba6e-5d45099f2b32",
                                "sense_id": "1b179e8a-a451-3c38-ac0a-85f15e9fdd6e",
                                "text": "Oortman die de afgelopen jaren acht keer in Sri Lanka geweest en er een petekind heeft, kent het land en de katholieke gemeenschap heel goed. „Ik heb vanmorgen nog contact gehad met de katholieke familie van mijn petekind. Zij zijn niet direct getroffen, maar leven in grote angst. De aanslag, uitgerekend op het Paasfeest, kwam voor hen totaal onverwacht. Ik leef met deze mensen mee. Het zijn mijn vrienden.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc497026-46f5-4c5d-bb92-ebbe43f44363",
                        "source_entry_id": "31326d1c-c02e-33fe-9969-ef440b2a9254",
                        "source_sense_id": "1b179e8a-a451-3c38-ac0a-85f15e9fdd6e",
                        "target_lang_word": "Patenkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patenkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ee45c63-bfb5-31cb-be06-b15da72f92d1",
                                        "entry_id": "e76fdc22-8f9a-3c14-ab2c-c77725cb9e65",
                                        "glosses": [
                                            "Kind, bei dessen Taufe, weltlichen Feier anlässlich der Geburt oder Firmung eine Person als Pate beteiligt war, also die Patenschaft übernommen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11104689-7f67-41f9-a873-f94a0d675bb3",
                                                "sense_id": "5ee45c63-bfb5-31cb-be06-b15da72f92d1",
                                                "text": "Ich habe zwei Patenkinder."
                                            },
                                            {
                                                "example_id": "3a7836d0-f7d8-42e1-a190-932134ed514a",
                                                "sense_id": "5ee45c63-bfb5-31cb-be06-b15da72f92d1",
                                                "text": "„Dafür müssen sich die Patenkinder aber auch offiziell bedanken.“"
                                            },
                                            {
                                                "example_id": "02faa566-9cca-40c0-a143-f5b12984260a",
                                                "sense_id": "5ee45c63-bfb5-31cb-be06-b15da72f92d1",
                                                "text": "„Wer mehr als einmal Pate wird, gibt seinen Namen entsprechend oft weiter; werden die Patenkinder selbst zu Paten, vermehren sie ihrerseits einen ihrer Patennamen, den Rufnamen, bei ihren Patenkindern und so fort.“"
                                            },
                                            {
                                                "example_id": "0008812f-c1cb-48d4-a543-819d68ff6c18",
                                                "sense_id": "5ee45c63-bfb5-31cb-be06-b15da72f92d1",
                                                "text": "„Er dankte mir in väterlichem Ton für die Freundschaft, die ich seinem Patenkind entgegenbrächte, und bat mich, am nächsten Tag zu ihm zum Essen zu kommen; er habe dann das Vergnügen, mich seiner Frau vorstellen zu können.“"
                                            },
                                            {
                                                "example_id": "ade95bb9-51a3-4696-a606-bbfbe61a5b74",
                                                "sense_id": "5ee45c63-bfb5-31cb-be06-b15da72f92d1",
                                                "text": "„Sie gelobten christlichen Beistand bei der Erziehung und bei einem frühen Tod der Eltern an deren Stelle zu treten und entsprechend für ihr Patenkind zu sorgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be47c407-197e-4c71-ab6c-52d3aacb23dc",
                        "source_entry_id": "31326d1c-c02e-33fe-9969-ef440b2a9254",
                        "source_sense_id": "1b179e8a-a451-3c38-ac0a-85f15e9fdd6e",
                        "target_lang_word": "godchild",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "godchild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17c873ae-c34a-336a-a27e-d8d436c99722",
                                        "entry_id": "1487f321-ff71-31db-a7f8-3b2ebc0d3d48",
                                        "glosses": [
                                            "A child whose baptism is sponsored by a godparent. In some cases the relationship is maintained indefinitely, with the godchild being treated much like a niece or nephew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb3a6fb-8781-4f7c-bbc5-6a2d06708fae",
                                                "sense_id": "17c873ae-c34a-336a-a27e-d8d436c99722",
                                                "text": "Mary stood as godmother for little Emily, her godchild."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cccbb822-30d4-43eb-a75a-e2e5ac9d2403",
                        "source_entry_id": "31326d1c-c02e-33fe-9969-ef440b2a9254",
                        "source_sense_id": "1b179e8a-a451-3c38-ac0a-85f15e9fdd6e",
                        "target_lang_word": "filleul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filleul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05833e4d-09cc-3594-b8c5-2da81a4e5ae4",
                                        "entry_id": "1993e031-a547-3220-adf0-91278b4aa9fb",
                                        "glosses": [
                                            "Fils spirituel d’un parrain ou d’une marraine; enfant pour lequel une cérémonie de parrainage a eu lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b982e8-e61e-4ec4-b858-2c0fc544dfe4",
                                                "sense_id": "05833e4d-09cc-3594-b8c5-2da81a4e5ae4",
                                                "text": "Cet enfant est mon filleul."
                                            },
                                            {
                                                "example_id": "579cff26-43b5-4583-9c96-78d80c5bc912",
                                                "sense_id": "05833e4d-09cc-3594-b8c5-2da81a4e5ae4",
                                                "text": "Plus jeune d’ailleurs,après des vacances à Monaco chez Yella et Numa, ébloui par la futilité de la relève de la garde d’opérette, j’avais raconté à mes rares amis rémois que j’étais le filleul de Rainier."
                                            },
                                            {
                                                "example_id": "455ee5dc-c787-4dcb-bcc0-ffe783e63dad",
                                                "sense_id": "05833e4d-09cc-3594-b8c5-2da81a4e5ae4",
                                                "text": "La formule préconisée par Maréchal : « Je promets et m’engage d’élever mon fils dans les seuls principes de la Raison, dans les seules pratiques de la Vertu », est très proche, par exemple, de l’engagement pris par des parrains vis-à-vis de leur filleul, lors d’un baptême civil à Lagny, le 12 septembre 1909 : « Ils prennent l'engagement de l’élever dans le seul culte de la Raison, du bon sens et de l’honnêteté et aussi dans l’amour de l’humanité, de la fraternité et de la solidarité »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d028ef0-c624-309d-85c2-da78c96aea27",
                                        "entry_id": "1993e031-a547-3220-adf0-91278b4aa9fb",
                                        "glosses": [
                                            "Celui qui bénéficie d’une protection spéciale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95b88f97-24c5-4b4e-ac6a-a932a8aa1978",
                                                "sense_id": "6d028ef0-c624-309d-85c2-da78c96aea27",
                                                "text": "Filleul des fées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "filleul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c1233a5-2935-37f7-8f26-2674134e0b87",
                                        "entry_id": "5f4787e4-c3f8-33e0-bcc5-c83cf7ba7133",
                                        "glosses": [
                                            "Surnom donné dans quelques régions (Périgord, Limousin) à la lépiote élevée ou coulemelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19af89e-c953-434d-b0bf-c1f8531459a2",
                                                "sense_id": "2c1233a5-2935-37f7-8f26-2674134e0b87",
                                                "text": "Le pauvre Petit rat Justin s’était réfugié tout tremblant sous un champignon gris, une belle filleule (sic) qui avait ouvert son élégant parapluie sur le pâturage."
                                            },
                                            {
                                                "example_id": "4dd91617-ed49-4910-97d9-b6a834113ea8",
                                                "sense_id": "2c1233a5-2935-37f7-8f26-2674134e0b87",
                                                "text": "Nous négligions les fades champignons des prés, les filleuls, la barbe-de-capucin, les girolles gaufrées ; nous évitions avec soin les bolets de Satan à la queue rouge, et les faux cèpes que nous reconnaissions à leur couleur terne, à la raideur de leur ligne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
