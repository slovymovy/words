                "forms": [],
                "senses": [
                    {
                        "sense_id": "24f25efa-661a-3e27-8fca-0278a71dd00b",
                        "entry_id": "825c7423-c07e-3379-b573-7c1764186434",
                        "glosses": [
                            "very well, perfectly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017780fa-39ea-4913-b7ce-f48ac3ddd257",
                                "sense_id": "24f25efa-661a-3e27-8fca-0278a71dd00b",
                                "text": "Ich habe mich bestens amüsiert.",
                                "translation": "I thoroughly enjoyed myself.",
                                "english": "I thoroughly enjoyed myself."
                            },
                            {
                                "example_id": "a29a6578-f943-426d-9461-88bcb3cc80a8",
                                "sense_id": "24f25efa-661a-3e27-8fca-0278a71dd00b",
                                "text": "Alles bestens!",
                                "translation": "Everything in order!",
                                "english": "Everything in order!"
                            },
                            {
                                "example_id": "43c1743a-4dc1-4119-9dde-91414ce19fbf",
                                "sense_id": "24f25efa-661a-3e27-8fca-0278a71dd00b",
                                "text": "Du bist so gut, meiner Mutter zu sagen, daß ich ihr Geschäft bestens betreiben und ihr ehstens Nachricht davon geben werde.",
                                "translation": "The Sorrows of Young Werther",
                                "english": "The Sorrows of Young Werther"
                            },
                            {
                                "example_id": "26a01c28-ed18-4080-b29c-e5f3d39189cb",
                                "sense_id": "24f25efa-661a-3e27-8fca-0278a71dd00b",
                                "text": "Ihre Mitglieder gelten als bestens in Wirtschaft und Politik vernetzt und gehören zu Indiens wohlhabendsten Gemeinschaften, stellen selbst aber nur einen Bruchteil der Bevölkerung."
                            }
                        ]
                    },
                    {
                        "sense_id": "451bd256-f22b-3bfc-9bd1-7aaab776e268",
                        "entry_id": "825c7423-c07e-3379-b573-7c1764186434",
                        "glosses": [
                            "cordially"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e764346-abe2-459b-9779-14ec814d2d61",
                                "sense_id": "451bd256-f22b-3bfc-9bd1-7aaab776e268",
                                "text": "Ich danke bestens.",
                                "translation": "I thank (you) cordially.",
                                "english": "I thank (you) cordially."
                            },
                            {
                                "example_id": "ec31e022-d68c-4029-a278-959633fa2a0c",
                                "sense_id": "451bd256-f22b-3bfc-9bd1-7aaab776e268",
                                "text": "(dated, idiomatic) Ich empfehle mich bestens.",
                                "translation": "I bid you farewell. (Literally, \"I recommend myself cordially\")",
                                "english": "I bid you farewell. (Literally, \"I recommend myself cordially\")"
                            },
                            {
                                "example_id": "e44e8cfc-7bc5-4a82-a70b-17fa8f5b0818",
                                "sense_id": "451bd256-f22b-3bfc-9bd1-7aaab776e268",
                                "text": "[…]»daß Sie an dieser Stelle Ihres Berichtes neu wären, kann ich zwar nicht behaupten; aber etwas was mir hier interessanter und willkommener sein könnte, kenne ich wahrhaftig nicht. Also gratuliere ich bestens!«"
                            }
                        ]
                    }
