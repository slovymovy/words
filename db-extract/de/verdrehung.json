                        ],
                        "examples": [
                            {
                                "example_id": "c5f8c604-276b-47fe-84ab-c5e153ba0a36",
                                "sense_id": "224bea06-fec8-3e13-9142-a9a5991be268",
                                "text": "„Eine Verdrehung der Tatsachen, die dem Prinzip der Freiheit des Denkens diametral entgegengesetzt ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
