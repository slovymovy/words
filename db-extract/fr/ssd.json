                ],
                "translations": [
                    {
                        "translation_id": "291c099b-12d8-46ce-895d-f23dae1acd54",
                        "source_entry_id": "6d9c47c7-1356-3a0d-8362-7075f76beb34",
                        "source_sense_id": "b99a807b-3521-3d77-b716-7e5f55960136",
