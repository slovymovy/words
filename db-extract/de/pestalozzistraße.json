                "senses": [
                    {
                        "sense_id": "0095c507-3d63-378f-909c-f9352f598bf0",
                        "entry_id": "5fd2d28a-90ba-3a3f-ae48-ab1c7128f437",
                        "glosses": [
                            "in der Regel nach dem Schweizer Pädagogen und Sozialreformer Johann Heinrich Pestalozzi benannte Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f0351e-ff36-433c-8138-d7bfd216334c",
                                "sense_id": "0095c507-3d63-378f-909c-f9352f598bf0",
                                "text": "Wir bitten Sie, schriftliche Bewerbungen (im Doppel sowie auf CD) für diese Stelle bis zum 30. Juni 2011 an das Dekanat der Medizinischen Fakultät der Universität Zürich, Berufungskoordination, Pestalozzistrasse 3, CH-8091 Zürich zu richten."
                            },
                            {
                                "example_id": "e0f84e08-edcc-448e-b026-7ae86f4d9ee0",
                                "sense_id": "0095c507-3d63-378f-909c-f9352f598bf0",
                                "text": "Seit 1996 ist er Schulleiter in dem Betongebäude in der Pestalozzistraße, in dem 150 Kollegen lehren und 2700 Schüler lernen."
                            },
                            {
                                "example_id": "d445681d-4723-462e-b3d5-4243c7a5176f",
                                "sense_id": "0095c507-3d63-378f-909c-f9352f598bf0",
                                "text": "Beim gemäßigt liberalen Gottesdienst in der Synagoge Pestalozzistraße wird auch Orgelmusik eingesetzt – was orthodoxe Juden als „gojisch“-christlich ablehnen."
                            },
                            {
                                "example_id": "d4c3a0cc-b4ae-4dad-8af5-06c6b8c78d76",
                                "sense_id": "0095c507-3d63-378f-909c-f9352f598bf0",
                                "text": "Die Pestalozzistraße ist eine Straße im Salzburger Stadtteil Elisabeth-Vorstadt."
                            },
                            {
                                "example_id": "60cb297f-7237-4da4-8d1b-2d6f905a4d91",
                                "sense_id": "0095c507-3d63-378f-909c-f9352f598bf0",
                                "text": "Der Brand war laut Polizei in einer Wohnung im ersten Stock eines Mehrparteienhauses in der Pestalozzistraße ausgebrochen."
                            },
                            {
                                "example_id": "86d3e7ee-8aeb-4179-af1f-8bbdd2f1c8c5",
                                "sense_id": "0095c507-3d63-378f-909c-f9352f598bf0",
                                "text": "„In vielen Städten gibt es Pestalozzistraßen, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
