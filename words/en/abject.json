                            {
                                "target_lang_word": "сокрушительный",
                                "target_lang_sense_clarification": "о провале, поражении"
                            },
                            {
                                "target_lang_word": "безудержный",
                                "target_lang_sense_clarification": "о страхе, ужасе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78cabfc3-cc59-3bf3-ae22-669c624dc5ca",
                    "sense_definition": "A person who is in a very low, miserable, or oppressed condition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "miserable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel depicts the struggles of the <w>abjects</w> living on the fringes of society.",
                            "target_lang_translations": {
                                "ru": "Роман описывает борьбу <w>отверженных</w>, живущих на обочине общества."
