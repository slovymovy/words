                    },
                    {
                        "translation_id": "15ae7363-1caa-40db-a5c3-9154c8fd2577",
                        "source_entry_id": "951b0869-d7ff-3479-878d-56a022c72818",
                        "source_sense_description": "strongly affected, especially favourably",
                        "target_lang_word": "beeindruckt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beeindruckt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00be57de-6d6b-3b1c-8ceb-fd6c94f0d111",
                                        "entry_id": "68ad89cb-fbef-3b74-b8f4-5406e8cc75fe",
                                        "glosses": [
                                            "von etwas stark fasziniert oder positiv berührt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0a2dc2-5aac-470b-9214-a1ec054066ee",
                                                "sense_id": "00be57de-6d6b-3b1c-8ceb-fd6c94f0d111",
                                                "text": "„Nicht zu vergessen die zahlreichen Staatsgäste wie den Briten Neville Chamberlain und den Italiener Benito Mussolini, die der Diktator auf den ‚Berghof‘ lud und die erwartungsgemäß von der Kulisse tief beeindruckt waren.“"
                                            },
                                            {
                                                "example_id": "b6241a51-2f32-42f4-af55-60ba78301835",
                                                "sense_id": "00be57de-6d6b-3b1c-8ceb-fd6c94f0d111",
                                                "text": "„Die prominenten Zuhörer rund um Bezirkstagspräsident Franz Löffler zeigten sich beeindruckt.“"
                                            },
                                            {
                                                "example_id": "dd0214af-0a2a-4821-ad3d-40d3805f4232",
                                                "sense_id": "00be57de-6d6b-3b1c-8ceb-fd6c94f0d111",
                                                "text": "„Noch beeindruckter war ich von seiner Gelassenheit im Umgang mit Kritik oder Stunk.“"
                                            },
                                            {
                                                "example_id": "951be32f-610e-400f-aec2-e6942b35a373",
                                                "sense_id": "00be57de-6d6b-3b1c-8ceb-fd6c94f0d111",
                                                "text": "„Becht zeigte sich besonders beeindruckt von der Qualität und Vielfalt der heimischen Betriebe.“"
                                            },
                                            {
                                                "example_id": "6c133990-1910-4be5-a127-321909c0f734",
                                                "sense_id": "00be57de-6d6b-3b1c-8ceb-fd6c94f0d111",
                                                "text": "„Er war beeindruckt vom Erfolg seines Sohnes und dessen aufwendigem Lebensstil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
