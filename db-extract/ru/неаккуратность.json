                "translations": [
                    {
                        "translation_id": "651aba6b-75a8-429c-8eae-f1b721a8cc21",
                        "source_entry_id": "0116eca7-09ae-38a7-a2b4-b9b3c8b8dd22",
                        "source_sense_id": "7e050950-3fc8-3682-9948-06fbd1fb7112",
                        "target_lang_word": "négligence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "négligence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Défaut de soin, d’exactitude, d’application."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d3b7329-3dff-4739-a16f-05699140d1c1",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Des prêtres prêchaient que les malheurs du pays étaient la conséquence des hérésies et de la négligence des devoirs religieux."
                                            },
                                            {
                                                "example_id": "2c77602d-5c39-4988-bac0-d6961bc08e93",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Ce texte a été corrigé avec beaucoup de négligence."
                                            },
                                            {
                                                "example_id": "dea35157-175e-49c2-836c-2496075a8b09",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Il aura peine à se faire pardonner ses négligences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "148b93df-034f-36fc-af16-848d07f53373",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Le peu de soin qu’une personne apporte à son vêtement, à son extérieur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c85935b8-59e8-4d56-8d0e-862eb6308b32",
                                                "sense_id": "148b93df-034f-36fc-af16-848d07f53373",
                                                "text": "Ce savant affecte dans sa mise une excessive négligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "911e4d2d-4228-382f-a529-5d6c5dd1c3bd",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Faute légère que fait un auteur, lorsqu’il n’apporte pas assez de soin à corriger son style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ddd82a-072b-4069-999d-8a099caa3f2d",
                                                "sense_id": "911e4d2d-4228-382f-a529-5d6c5dd1c3bd",
                                                "text": "Il y a dans cet ouvrage des négligences qu’il sera facile de corriger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5f9fa4-07d9-3ccf-9a47-536c1383bc60",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Faute involontaire qui néanmoins peut donner lieu à des poursuites judiciaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfa927b9-d26e-3372-ab6a-b2ef6d1413fd",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Problème neurologique qui empêche un patient d’avoir conscience d’une partie de son environnement ou de son corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86bcdb26-2275-4d2d-840f-2145915184e3",
                                                "sense_id": "cfa927b9-d26e-3372-ab6a-b2ef6d1413fd",
                                                "text": "La négligence ne se limite pas à une modalité sensorielle, mais elle peut affecter l’ensemble de nos sens et toucher notre capacité à agir. Par exemple, un malade négligera aussi bien les informations visuelles, auditives ou tactiles que certaines odeurs. D’autre part, il n’utilisera plus son bras et sa jambe gauche, même si elles ne sont pas paralysées. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 85)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d5ec80d-a5d3-4ee8-b6b7-f487544fd6a4",
                        "source_entry_id": "0116eca7-09ae-38a7-a2b4-b9b3c8b8dd22",
                        "source_sense_id": "7e050950-3fc8-3682-9948-06fbd1fb7112",
                        "target_lang_word": "laisser-aller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laisser-aller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52555883-58f0-3e25-aa6d-27ed8a191556",
                                        "entry_id": "f6834163-96be-3981-a11b-b260e23cfbbd",
                                        "glosses": [
                                            "Liberté d’habillement, de comportement ou d’attitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91eed1a-f224-40b4-ac13-b4c20a9fbb1b",
                                                "sense_id": "52555883-58f0-3e25-aa6d-27ed8a191556",
                                                "text": "Sa stature est haute et sa physionomie mobile et expressive. Il a le laisser-aller, le sans-gêne, le déboutonné d'un grand seigneur qui parle devant des bourgeois. Il ne fait pas tant de façon avec eux , il se met à aise et cause tout comme s’il était en robe de chambre."
                                            },
                                            {
                                                "example_id": "a4f9478a-d9fc-4887-ba37-b46f40737af5",
                                                "sense_id": "52555883-58f0-3e25-aa6d-27ed8a191556",
                                                "text": "Vêtu avec le laisser-aller du vaudevilliste, le sous-chef portait le matin un pantalon à pied, des souliers chaussons, un gilet mis à la réforme, une redingote olive et une cravate noire."
                                            },
                                            {
                                                "example_id": "ca0a0aa9-b90f-4c51-82fb-b3d08263416a",
                                                "sense_id": "52555883-58f0-3e25-aa6d-27ed8a191556",
                                                "text": "Quant à l’autre, sans doute que dans son temps il avait eu l’aimable laisser-aller de son compagnon ; … mais l’âge était venu, cette neige du cœur qui avait éteint sa flamme et calmé sa voix."
                                            },
                                            {
                                                "example_id": "87bd7bd1-7e98-4d07-b40a-7b40b4bcf750",
                                                "sense_id": "52555883-58f0-3e25-aa6d-27ed8a191556",
                                                "text": "Ce que l'on sait de l’évolution de la sexualité européenne confirme l'idée d'une coupure entre classes laborieuse d'une part, petite et grande bourgeoisie d'autre part. La bourgeoisie se puritanise plus tôt que la classe ouvrière. […]. L'opposition entre le laisser-aller du prolétariat et le puritanisme névrosé des classes moyennes est l'un des lieux communs de la littérature du XIXᵉ siècle."
                                            },
                                            {
                                                "example_id": "0b2daaf3-8570-4d77-a329-d0c3348231c8",
                                                "sense_id": "52555883-58f0-3e25-aa6d-27ed8a191556",
                                                "text": "La quiétude que nous éprouvons lorsque nous sommes seuls, cette certitude de nous-mêmes dans la sérénité de la solitude ne sont rien en comparaison du laisser-aller, laisser-venir et laisser-parler qui se vit avec l’autre, en compagnie complice…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57699fcc-cca3-39c9-bbfc-4f4d11eebad6",
                                        "entry_id": "f6834163-96be-3981-a11b-b260e23cfbbd",
                                        "glosses": [
                                            "Manque de rigueur, de soin, laxisme, négligence dans les manières, mollesse dans la conduite."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c64ad59d-14a6-4f81-99d5-bccdfdd7d3ca",
                                                "sense_id": "57699fcc-cca3-39c9-bbfc-4f4d11eebad6",
                                                "text": "Il y a du laisser-aller dans ce groupe."
                                            },
                                            {
                                                "example_id": "c74089d2-3d36-43e5-8028-86a7f55cefc8",
                                                "sense_id": "57699fcc-cca3-39c9-bbfc-4f4d11eebad6",
                                                "text": "Les Allemands ont considérablement embelli Strasbourg et nombre d’Alsaciens préféraient l’organisation allemande au laisser-aller français."
                                            },
                                            {
                                                "example_id": "20031f5d-6be7-4d87-a2da-859e929b441f",
                                                "sense_id": "57699fcc-cca3-39c9-bbfc-4f4d11eebad6",
                                                "text": "Aucun luxe, au contraire, une bonhomie spécifiquement belge, un certain laisser-aller même et, à l’encontre du Soudan anglais, des boys familiers, vêtus de blanc, qui vous souriaient de toutes leurs dents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef4bc1bd-02f1-4103-9d23-7856318cdc98",
                        "source_entry_id": "0116eca7-09ae-38a7-a2b4-b9b3c8b8dd22",
                        "source_sense_id": "7e050950-3fc8-3682-9948-06fbd1fb7112",
                        "target_lang_word": "inexactitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexactitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c85232d-dc97-318b-9a8b-1f726fd31fae",
                                        "entry_id": "b86d4952-59ba-39bf-a1ed-a5c10fe5ab62",
                                        "glosses": [
                                            "Défaut d’exactitude ou de précision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c75c8d4-066b-4bdf-ad4b-2e90af7d0853",
                                                "sense_id": "1c85232d-dc97-318b-9a8b-1f726fd31fae",
                                                "text": "Le père Clément Pérès avait cru découvrir de légères inexactitudes dans ce dernier voyage ; il les avait marquées sur des feuilles volantes, et il me fit présent de ces notes."
                                            },
                                            {
                                                "example_id": "04af4d39-f3d3-43a9-b46d-0c3270957766",
                                                "sense_id": "1c85232d-dc97-318b-9a8b-1f726fd31fae",
                                                "text": "[…], il narra, en une esquisse sommaire et avec les omissions et les inexactitudes naturelles à son genre de mentalité, la série de ses aventures."
                                            },
                                            {
                                                "example_id": "9a4c82c2-586e-48e4-a931-c61abddb1a5f",
                                                "sense_id": "1c85232d-dc97-318b-9a8b-1f726fd31fae",
                                                "text": "Même fourmillement de fautes innombrables, d’erreurs ou d’inexactitudes phonétiques, dans les mots souletins que porte le dictionnaire du P. Lhande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "506230ac-5e4a-32c4-85d7-b9c0b411042f",
                                        "entry_id": "b86d4952-59ba-39bf-a1ed-a5c10fe5ab62",
                                        "glosses": [
                                            "Manque de régularité ou de ponctualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee9bd575-5800-41a6-a8c1-e344bac81a2f",
                                                "sense_id": "506230ac-5e4a-32c4-85d7-b9c0b411042f",
                                                "text": "Milady B***, disait-il, avait eu la bonté de me donner un rendez-vous au bois de Boulogne et l’inhumanité d’y manquer. Au bout de deux heures, je m’ennuyai de l’attendre, et, de retour chez moi, je lui écrivis pour me plaindre de son inexactitude."
                                            },
                                            {
                                                "example_id": "f0600156-f0a4-4b26-9a5d-7d666b81ee32",
                                                "sense_id": "506230ac-5e4a-32c4-85d7-b9c0b411042f",
                                                "text": "Quand il entra dans le salon, tout le monde était réuni ; on l’attendait depuis dix minutes déjà pour se mettre à table, au grand mécontentement de M. Donis, qui n’admettait pas plus l’inexactitude pour un déjeuner que pour une échéance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
