                ],
                "senses": [
                    {
                        "sense_id": "46927312-e833-361a-b81c-eb1c7606abb4",
                        "entry_id": "34d4fbc3-a7b7-3864-b898-9fed33c8f177",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79627b09-7228-4b23-9a00-9736e1d6acc2",
                                "sense_id": "46927312-e833-361a-b81c-eb1c7606abb4",
                                "text": "Frau Pecher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8b787cf0-f794-4b55-bae2-2da1751f2364",
                                "sense_id": "46927312-e833-361a-b81c-eb1c7606abb4",
                                "text": "Herr Pecher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "86f8f470-dab9-40fb-8614-0ace0ba4717b",
                                "sense_id": "46927312-e833-361a-b81c-eb1c7606abb4",
                                "text": "Die Pechers fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "b0768bc4-57a0-498c-9a63-a56979480205",
                                "sense_id": "46927312-e833-361a-b81c-eb1c7606abb4",
                                "text": "Der Pecher trägt nie die Pullover, die die Pecher ihm strickt."
                            },
                            {
                                "example_id": "b907fe45-089a-49ca-ac66-1f02385af766",
                                "sense_id": "46927312-e833-361a-b81c-eb1c7606abb4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pecher kommt, geht der Herr Pecher.“"
                            },
                            {
                                "example_id": "42a35f65-e664-48af-9ebd-d80b2fdf64c0",
                                "sense_id": "46927312-e833-361a-b81c-eb1c7606abb4",
                                "text": "Pecher kommt und geht."
                            },
                            {
                                "example_id": "7a33c30e-df3d-43bd-b9ef-3abbe0ee64d8",
                                "sense_id": "46927312-e833-361a-b81c-eb1c7606abb4",
                                "text": "Pechers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
