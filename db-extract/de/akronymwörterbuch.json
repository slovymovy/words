                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc172945-8c1e-4cbc-9ef8-21090e010553",
                                "sense_id": "100f4e51-0974-3727-ae17-a270d36ddf14",
                                "text": "In einem Akronymwörterbuch kann man nachschlagen, was Akronyme bedeuten und wie die vollständige Form, die gekürzt wurde, aussieht.",
                                "translation": "Dans un dictionnaire de sigles, on peut rechercher ce que les sigles signifient et à quoi ressemble la forme complète qui a été abrégée."
                            },
                            {
                                "example_id": "6131d04b-bdeb-45aa-b8f4-cf25d6d95be6",
                                "sense_id": "100f4e51-0974-3727-ae17-a270d36ddf14",
                                "text": "In einem deutschen Akronymwörterbuch kann z.B. stehen, dass das Initialkurzwort Lkw für die Bezeichnung Lastkraftwagen steht.",
                                "translation": "Dans un dictionnaire allemand de sigles, il peut par exemple être écrit que le sigle « Lkw » correspond à la désignation « Lastkraftwagen »."
                            }
                        ]
                    }
