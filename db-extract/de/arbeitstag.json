                                "target_senses": [
                                    {
                                        "sense_id": "49fdf421-68a3-3839-9f96-af4101235319",
                                        "entry_id": "002b81b4-a586-3331-bab8-4b5537eb466a",
                                        "glosses": [
                                            "Any of those days of a week on which work is done, officially Monday to Friday in many countries (even though many people work on weekends)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "mainly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923e70e2-a719-445b-925b-a4c2356e38dc",
                                                "sense_id": "49fdf421-68a3-3839-9f96-af4101235319",
                                                "text": "It will take five working days to process your application."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d7e83c-dc70-34d0-8b29-af74a8839f88",
                                        "entry_id": "002b81b4-a586-3331-bab8-4b5537eb466a",
                                        "glosses": [
                                            "The part of a day in which work is done; the number of hours one must work per day for a specified wage."
                                        ],
                                        "tags": [
                                            "UK",
                                            "mainly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e7f179-f6da-441f-975e-e9ba38672d52",
                                                "sense_id": "b0d7e83c-dc70-34d0-8b29-af74a8839f88",
                                                "text": "Your working day is 8 hours."
                                            },
                                            {
                                                "example_id": "469fa7e8-82e7-4126-a575-b71cc3b24379",
                                                "sense_id": "b0d7e83c-dc70-34d0-8b29-af74a8839f88",
                                                "text": "That's all they really want / Is some fun / When the working day is done / Oh, girls, they wanna have fun / Oh, girls just wanna have..."
                                            }
                                        ]
                                    }
                                ]
