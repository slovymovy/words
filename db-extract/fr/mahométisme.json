                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0154557b-a973-3e6e-a8c9-383acaf5148c",
                                        "entry_id": "a40dfdd6-7787-3ec6-9d80-64eba6cbd3b3",
                                        "glosses": [
                                            "The religion introduced by Muhammad: Islam."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895a651f-b03f-4b5b-90a6-6a9ed6074acd",
                                                "sense_id": "0154557b-a973-3e6e-a8c9-383acaf5148c",
                                                "text": "In a general estimate of Mohammedanism it should not be forgotten what Islam has done for the cause of humanity and more particularly the share it had in the development of science and art in Europe. Broadly speaking, the Mohammedans may be said to have been the teachers of barbarous Europe from the ninth to the thirteenth century. It is from the days of the Abbasside rulers that the real renaissance of the Greek spirit and Greek culture is to be dated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02bd07e3-d6d6-4515-b6cd-6189a7bfb4ab",
                        "source_entry_id": "d341f96b-4ce1-32dd-b007-fc8e22629e79",
                        "source_sense_id": "8db166f0-3159-3504-aa6d-3b30e899eaa6",
