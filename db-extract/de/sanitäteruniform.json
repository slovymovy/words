                "senses": [
                    {
                        "sense_id": "5b357ec6-18db-3b31-a5d9-7829eb829ebd",
                        "entry_id": "80393599-3f6f-39a8-85d0-9045c36ac562",
                        "glosses": [
                            "Berufskleidung, die Sanitäter in Ausübung ihres Berufs tragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc848ab-ceaf-4125-9991-43b8a7f7861f",
                                "sense_id": "5b357ec6-18db-3b31-a5d9-7829eb829ebd",
                                "text": "„Er besorgte sich eine schlecht sitzende Sanitäteruniform und umging damit das allgemeine Reiseverbot.“"
                            },
                            {
                                "example_id": "f27b33fb-a3a1-4fba-b29f-f23a73f950ea",
                                "sense_id": "5b357ec6-18db-3b31-a5d9-7829eb829ebd",
                                "text": "„Er selbst saß damals am Steuer, neben ihm Hollywoodregisseur Hal Needham, beide in Sanitäteruniform.“"
                            },
                            {
                                "example_id": "efe35108-dc3d-4a59-8a77-366a5d0ab35d",
                                "sense_id": "5b357ec6-18db-3b31-a5d9-7829eb829ebd",
                                "text": "„Der Mann, der in der roten Sanitäteruniform daneben steht, ist übrigens August Kock.“"
                            },
                            {
                                "example_id": "998cbe7a-3c69-4ccd-866e-8c1a78a48389",
                                "sense_id": "5b357ec6-18db-3b31-a5d9-7829eb829ebd",
                                "text": "„Der Zivi verlor rapide an Umfang und steckte zunehmend windig und inkompetent in seiner Sanitäteruniform.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
