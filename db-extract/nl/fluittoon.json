                                        "entry_id": "741185eb-c12e-3bda-96e1-6bce90ad7e57",
                                        "glosses": [
                                            "Any of several passerine birds of the genera Pachycephala and Coracornis, of Australasia and the western Pacific."
                                        ],
                                        "tags": [],
