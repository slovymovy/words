                "senses": [
                    {
                        "sense_id": "a4ce2c8b-a6d2-3462-b7c5-43a591ec47dd",
                        "entry_id": "b7e09f8b-33fa-3bcb-9f5b-f74fbe75d226",
                        "glosses": [
                            "dasjenige Eigentum, das einem Mitbesitzer einer Immobilie alleine gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59def0a8-f08c-4196-97b1-95a63569618f",
                                "sense_id": "a4ce2c8b-a6d2-3462-b7c5-43a591ec47dd",
                                "text": "Der konkrete Umfang des Sondereigentums ist in der Regel genau in der Teilungserklärung definiert."
                            },
                            {
                                "example_id": "6c18acad-6232-4585-a8ed-8af2e1929188",
                                "sense_id": "a4ce2c8b-a6d2-3462-b7c5-43a591ec47dd",
                                "text": "Nach dem deutschen Wohnungseigentumsgesetz ein Sondereigentum ein dem Volleigentum weitgehend gleichgestelltes Recht an einer Wohnung."
                            },
                            {
                                "example_id": "0980f09d-5290-4a65-8ba8-986465ebf078",
                                "sense_id": "a4ce2c8b-a6d2-3462-b7c5-43a591ec47dd",
                                "text": "Sondereigentum muss auf eigene Kosten instand gehalten werden."
                            },
                            {
                                "example_id": "6870a343-e649-45ce-bb57-c3bff39e12d9",
                                "sense_id": "a4ce2c8b-a6d2-3462-b7c5-43a591ec47dd",
                                "text": "„Ein unselbständiger Bestandteil einer Liegenschaft, an dem kein Sondereigentum möglich ist, kann nur dann vorliegen, wenn die Sache entweder überhaupt nicht oder nur unter so schweren Beschädigungen oder Kosten vom Grund entfernt werden kann, daß dies untunlich wäre (§ 293 ABGB.).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
