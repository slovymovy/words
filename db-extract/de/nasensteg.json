                "senses": [
                    {
                        "sense_id": "7a14e2a2-6193-34eb-9f29-93e62c0a4487",
                        "entry_id": "f7496d52-a664-3c6e-a91c-ae517fc6b75b",
                        "glosses": [
                            "Teil des Brillengestells, der auf dem Nasenrücken aufliegt und die Entstehung von Druckstellen verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319037e0-3cda-476a-b57e-5ba8e73788d2",
                                "sense_id": "7a14e2a2-6193-34eb-9f29-93e62c0a4487",
                                "text": "„Auffällige Nasenstege liegen bei Brillen im Trend - sowohl bei Korrektions- als auch bei Sonnenbrillen.“"
                            },
                            {
                                "example_id": "80ebba98-27d9-4763-8280-8804a418d38b",
                                "sense_id": "7a14e2a2-6193-34eb-9f29-93e62c0a4487",
                                "text": "„Das dauert mehrere Wochen, je nachdem, ob man zwei Millimeter Dicke benötigt für einen Bügel oder sieben Millimeter für einen Nasensteg.“"
                            },
                            {
                                "example_id": "88390fdd-402b-4b7b-be08-11fd56d3e581",
                                "sense_id": "7a14e2a2-6193-34eb-9f29-93e62c0a4487",
                                "text": "„Vergil benutzt hier die Bügelbrille, bei der zwei geschliffene Eingläser über einen Nasensteg verbunden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
