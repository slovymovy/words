                        "sense_id": "8ba1b309-c009-3438-abc8-35b453399a11",
                        "entry_id": "7332932d-d513-36ba-a77b-ad72dcb01cab",
                        "glosses": [
                            "Brettspiel für zwei bis vier Spieler, das mit dem Ziel, aus Buchstabensteinen Wörter zu legen und damit Punkte zu erzielen, gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f0da12d-ce4c-4593-9208-eb9c88703ea6",
                                "sense_id": "8ba1b309-c009-3438-abc8-35b453399a11",
                                "text": "Das Grundprinzip des Scrabbles ist das des Kreuzworträtsels kombiniert mit Feldern, die zur Erhöhung der Buchstaben- und Wortwerte genutzt werden können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70905423-0f5b-43bc-9fb9-45054514224b",
                        "source_entry_id": "7332932d-d513-36ba-a77b-ad72dcb01cab",
                        "source_sense_id": "8ba1b309-c009-3438-abc8-35b453399a11",
                        "target_lang_word": "scrabble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrabble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e66ad715-f9a1-3f13-900a-1bb2076e8cf3",
                                        "entry_id": "ae124907-d55f-3e69-b73c-26194eb911dd",
                                        "glosses": [
                                            "To scrape or scratch powerfully with hands or claws."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a798af72-7337-4f2d-a593-e47611adaf5c",
                                                "sense_id": "e66ad715-f9a1-3f13-900a-1bb2076e8cf3",
                                                "text": "[…] there came no answer, except the echo of my own voice sounding hollow and far off down in the vault. So in despair I turned back to the earth wall below the slab, and scrabbled at it with my fingers, till my nails were broken and the blood ran out; having all the while a sure knowledge, like a cord twisted round my head, that no effort of mine could ever dislodge the great stone."
                                            },
                                            {
                                                "example_id": "e65c6ad3-3a59-4e44-a28d-57f052d026ab",
                                                "sense_id": "e66ad715-f9a1-3f13-900a-1bb2076e8cf3",
                                                "text": "So he scraped and scratched and scrabbled and scrooged, then he scrooged again[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7cace7c-29dc-36bd-b39a-e219a6b3f2e2",
                                        "entry_id": "ae124907-d55f-3e69-b73c-26194eb911dd",
                                        "glosses": [
                                            "To gather hastily."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9629aa7e-780b-4b68-9d92-bc2a24b8c3d2",
                                                "sense_id": "d7cace7c-29dc-36bd-b39a-e219a6b3f2e2",
                                                "text": "“Oh. The perfect ending to the perfect-- [chuckles] I almost said evening. More like months, though, isn't it? Since we started scrabbling for coins because the damn government took away our-- every thing. They took everything. And the only thing that was left, you idiots either lost, gave away, ate, or just blew up and sank.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d152835-4c91-315f-bc50-fd498e94490a",
                                        "entry_id": "ae124907-d55f-3e69-b73c-26194eb911dd",
                                        "glosses": [
                                            "To move with difficulty by making rapid movements back and forth with the hands or paws."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d923e8a2-313e-4c4f-a17f-558098722662",
                                                "sense_id": "3d152835-4c91-315f-bc50-fd498e94490a",
                                                "text": "She was on her hands and knees scrabbling in the mud, looking for her missing wedding ring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfe27dd-8b67-3271-8925-764744587186",
                                        "entry_id": "ae124907-d55f-3e69-b73c-26194eb911dd",
                                        "glosses": [
                                            "To scribble."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a174c8-3c92-4fc4-8b3a-5fea2df4ebb4",
                                                "sense_id": "3dfe27dd-8b67-3271-8925-764744587186",
                                                "text": "David […] scrabbled on the doors of the gate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9dd000-0dfc-30b6-b07e-8c6722a8a06e",
                                        "entry_id": "ae124907-d55f-3e69-b73c-26194eb911dd",
                                        "glosses": [
                                            "To mark with irregular lines or letters; to scribble on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
