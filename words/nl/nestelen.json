                            "target_lang_translations": {
                                "en": "In the spring, many birds go to <w>nest</w> in this old tree."
                            }
                        },
                        {
                            "text": "Op die afgelegen rots <w>nestelen</w> honderden zeekoeten tijdens het broedseizoen.",
                            "target_lang_translations": {
                                "en": "Hundreds of guillemots <w>nest</w> on that remote rock during the breeding season."
                            }
