                            "prepositional"
                        ],
                        "form": "расса́днике"
                    },
                    {
                        "form_id": "9690ddd9-1f83-4728-b9ef-5756b6416dee",
                        "entry_id": "3d73bf10-ed34-3838-8576-303a24761983",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "расса́дниках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e18db756-ae86-33ad-8f7d-0f9dbb5e86c1",
                        "entry_id": "3d73bf10-ed34-3838-8576-303a24761983",
                        "glosses": [
                            "место, где выращивают молодые растения; питомник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "412912e1-fe4b-40e7-a18c-7a056b763dd4",
                                "sense_id": "e18db756-ae86-33ad-8f7d-0f9dbb5e86c1",
                                "text": "Растения, выращиваемые из семян, первые два года поднимаются очень медленно, и это время их лучше держать в рассаднике, регулярно поливая и удаляя сорняки."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3b55749-502a-3a4f-9c95-f73a827d8ecc",
                        "entry_id": "3d73bf10-ed34-3838-8576-303a24761983",
                        "glosses": [
                            "школа (вообще место, откуда разносится наука, знание)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af76b400-e1cc-4c06-aa41-e54482947865",
                                "sense_id": "b3b55749-502a-3a4f-9c95-f73a827d8ecc",
                                "text": "Затем один из учеников вышел вперёд, и учитель французского языка спросил его: «Не имеет ли он им что-нибудь сказать по поводу высокого посещения рассадника наук?»"
                            },
                            {
                                "example_id": "2a74898a-a0d2-40f0-93be-35416282ca5a",
                                "sense_id": "b3b55749-502a-3a4f-9c95-f73a827d8ecc",
                                "text": "Вырастет ли из наших скромных воскресных школ рассадник повсеместного образования, а не просто грамотности?"
                            },
                            {
                                "example_id": "b4e1728a-674b-460a-b6fc-881f2fc0a63e",
                                "sense_id": "b3b55749-502a-3a4f-9c95-f73a827d8ecc",
                                "text": "Надо сказать, что в то отдалённое время, о котором идёт речь, закрытые заведения ― мужские пансионы и мужские институты, а также кадетские корпуса ― представляли из себя какие-то тепличные рассадники."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf1301b2-145a-3d0c-a9c2-eba5104b5ace",
                        "entry_id": "3d73bf10-ed34-3838-8576-303a24761983",
                        "glosses": [
                            "неодобр. место, являющееся источником или средоточием чего-либо (обычно о чём-либо негативном, предосудительном или социально опасном)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63841c15-1288-4cf8-8391-4de61bdb6db3",
                                "sense_id": "cf1301b2-145a-3d0c-a9c2-eba5104b5ace",
                                "text": "Одно время в городе передавали о нас, что кружок наш рассадник вольнодумства, разврата и безбожия; да и всегда крепился этот слух."
                            },
                            {
                                "example_id": "8671b785-aac7-4ce8-8e4d-d1966d4023ae",
                                "sense_id": "cf1301b2-145a-3d0c-a9c2-eba5104b5ace",
                                "text": "В эти же дни закрыли ипподром ― рассадник буржуазных настроений."
                            },
                            {
                                "example_id": "f7ef3487-813c-4514-86d9-f68b8871af59",
                                "sense_id": "cf1301b2-145a-3d0c-a9c2-eba5104b5ace",
                                "text": "Рекомендуется ежемесячная замена зубной щётки, именно этот срок приводит к кульминационному накоплению микроорганизмов в ней, и она становится рассадником инфекции."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2621c833-cb8c-4664-b0e3-cd1326705164",
                        "source_entry_id": "3d73bf10-ed34-3838-8576-303a24761983",
                        "target_lang_word": "breeding-ground",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breeding-ground",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56bd470c-6323-3db3-9bc2-d3220523c74b",
                                        "entry_id": "a76e2dfa-af5c-34b3-99b1-057f3b75781d",
                                        "glosses": [
                                            "A place or region where animals go to breed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1be66700-d216-34eb-b0c3-9de167812fbd",
                                        "entry_id": "a76e2dfa-af5c-34b3-99b1-057f3b75781d",
                                        "glosses": [
                                            "A place or institution seen as creating large numbers of a stated thing, type of person, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bbadc10-85c0-4011-9a11-3c710970188d",
                                                "sense_id": "1be66700-d216-34eb-b0c3-9de167812fbd",
                                                "text": "Harris criticized the report's emphasis on enforcement, noting that, \"Putting people in jail won't stop the virus from spreading.\" In fact, prisons are virtual breeding grounds for AIDS, due to lack of safer sex and safer drug use education, condoms and uncontaminated needles."
                                            },
                                            {
                                                "example_id": "96f9c728-cfe3-43f9-ac15-a57d28c30a06",
                                                "sense_id": "1be66700-d216-34eb-b0c3-9de167812fbd",
                                                "text": "Echoing Allen Ginsberg, he contends that the suburban setting of “Father Knows Best” is most accurately seen as America's “ludicrous breeding ground for the young meat who will be fed into its wars and rat races and inhuman conformities.”"
                                            },
                                            {
                                                "example_id": "89004ae4-0f2a-47d3-97ac-1f11c48dfc98",
                                                "sense_id": "1be66700-d216-34eb-b0c3-9de167812fbd",
                                                "text": "What, wonder the denigrators, is county cricket for (if you ignore for a moment the small matter of providing a breeding-ground for the Test team)?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
