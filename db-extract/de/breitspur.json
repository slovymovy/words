                "senses": [
                    {
                        "sense_id": "787b6f77-eab1-37e4-bf10-7844d734ad22",
                        "entry_id": "292c9f0c-ab32-3b16-953b-049cad07e494",
                        "glosses": [
                            "gegenüber der Normalspur vergrößerte Spurweite bei Schienen- und Kraftfahrzeugen"
                        ],
                        "tags": [
                            "Eisenbahnwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "d72d2293-d770-4122-b396-26e5233fdf92",
                                "sense_id": "787b6f77-eab1-37e4-bf10-7844d734ad22",
                                "text": "„Schnell gefahrene Kurven lassen sich mit Frontantrieb und Breitspur mühelos und ohne Korrektur durchziehen.“"
                            },
                            {
                                "example_id": "cb92bceb-f274-49c6-9aa0-8deabc1c3163",
                                "sense_id": "787b6f77-eab1-37e4-bf10-7844d734ad22",
                                "text": "„Außerdem plant der Hafen, künftig wieder verstärkt Eisenbahnwaggons auf die russische Breitspur umzurüsten, um sie anschließend über die Ostsee zu verschiffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
