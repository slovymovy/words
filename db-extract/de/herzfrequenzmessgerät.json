                            {
                                "example_id": "364cf381-f80e-4452-b077-ab078a0a85b1",
                                "sense_id": "be59e0c8-4d3a-3e8b-9079-3112964fe52b",
                                "text": "„Der Zwölfjährige trägt ein Herzfrequenzmessgerät, weil sein Herz plötzlich nachts schnell und heftig schlug.“"
                            },
                            {
                                "example_id": "b6edddf4-b670-4f40-8be8-3e8bd53dcb47",
                                "sense_id": "be59e0c8-4d3a-3e8b-9079-3112964fe52b",
                                "text": "„Als Anfang der achtziger Jahre die ersten teuren Herzfrequenzmessgeräte für das Handgelenk auf den Markt kamen, hat das die Trainingswissenschaft im Freizeitbereich revolutioniert.“"
                            }
                        ],
