                                        "entry_id": "76b9072a-6325-3da1-833a-5baa3850d3ea",
                                        "glosses": [
                                            "pracownik kościelny odpowiedzialny za prowadzenie śpiewu i zwykle przygrywający na organach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
