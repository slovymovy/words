                "senses": [
                    {
                        "sense_id": "a9ae15a3-1e86-3d1d-a714-59f18c5dbb59",
                        "entry_id": "478669a2-52b9-32d2-ba9f-fa8e27b68dbc",
                        "glosses": [
                            "Freistellung seitens der Firma wegen berechtigter Gründe wie Geburt, Kindererziehung oder Weiterbildung"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "11a48293-4664-4adb-8e7a-973b9699b854",
                                "sense_id": "a9ae15a3-1e86-3d1d-a714-59f18c5dbb59",
                                "text": "Wenn Männer von der Karenz die letzten sechs Monate nicht beanspruchen, darf die Frau trotzdem nicht länger als eineinhalb Jahre auf Karenz gehen."
                            },
                            {
                                "example_id": "9dcecbad-7778-4691-a48d-771ca4b1370a",
                                "sense_id": "a9ae15a3-1e86-3d1d-a714-59f18c5dbb59",
                                "text": "„Der Dienstnehmerin ist auf ihr Verlangen im Anschluss an die Frist des § 5 Abs. 1 und 2 Karenz gegen Entfall des Arbeitsentgelts bis zum Ablauf des zweiten Lebensjahres des Kindes, soweit im Folgenden nicht anderes bestimmt ist, zu gewähren, wenn sie mit dem Kind im gemeinsamen Haushalt lebt.“"
                            },
                            {
                                "example_id": "dfd779a3-7716-482b-9ebb-9fde8d9e95ee",
                                "sense_id": "a9ae15a3-1e86-3d1d-a714-59f18c5dbb59",
                                "text": "„Seit 1992 war er als Bediensteter der Stadt Wien in Karenz und beim Jüdischen Museum der Stadt Wien G.m.b.H. als Projektkoordinator […] angestellt und seit 1993 in dieser Funktion […] tätig.“"
                            },
                            {
                                "example_id": "f1a8aa31-4d27-41f4-a95a-394c8f1e2dc7",
                                "sense_id": "a9ae15a3-1e86-3d1d-a714-59f18c5dbb59",
                                "text": "„Immer mehr Väter gehen in Karenz, dafür aber immer kürzer, wie eine aktuelle Studie der Arbeiterkammer zeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4220ddc9-9485-3f4f-b76a-73c96af2f13e",
                        "entry_id": "478669a2-52b9-32d2-ba9f-fa8e27b68dbc",
                        "glosses": [
                            "Verzicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcb948f5-1e84-463f-90a7-1b21b89fb71e",
                                "sense_id": "4220ddc9-9485-3f4f-b76a-73c96af2f13e",
                                "text": "Sie wollen auf Zucker verzichten? Hier finden Sie Wissenswertes über Tricks und Stolperfallen in der Karenz."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "916b5ebe-7d9a-3f67-8ca3-37a254936dd9",
                        "entry_id": "478669a2-52b9-32d2-ba9f-fa8e27b68dbc",
                        "glosses": [
                            "Wartezeit/Sperrfrist bevor eine vertraglich zugesicherte Leistung erbracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b07ee97a-f3b9-4313-bf6f-4fe8f8fff35b",
                                "sense_id": "916b5ebe-7d9a-3f67-8ca3-37a254936dd9",
                                "text": "Die Karenz ist die Wartezeit für Versicherungsleistungen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1e8e2e9-1a36-4186-9d6d-d4d3697fd100",
                        "source_entry_id": "478669a2-52b9-32d2-ba9f-fa8e27b68dbc",
                        "source_sense_id": "a9ae15a3-1e86-3d1d-a714-59f18c5dbb59",
                        "target_lang_word": "maternity leave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maternity leave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f47825-5fab-3cc9-ae16-ca1b32aab5ee",
                                        "entry_id": "804d8b32-c4c1-365e-8f07-2c4893ac4af8",
                                        "glosses": [
                                            "A leave of absence from a job for a mother to care of a baby."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92f9b1ce-f8ee-449d-983a-0963e154f08c",
                                                "sense_id": "e9f47825-5fab-3cc9-ae16-ca1b32aab5ee",
                                                "text": "My wife is on a two year maternity leave while she takes care of her newborn baby."
                                            },
                                            {
                                                "example_id": "ca12a19c-80cd-4374-8954-748558393aff",
                                                "sense_id": "e9f47825-5fab-3cc9-ae16-ca1b32aab5ee",
                                                "text": "I went on maternity leave in May 2022, so have been away for nearly 14 months."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae1bd4ee-1584-45f9-afdf-c3b3e65f2861",
                        "source_entry_id": "478669a2-52b9-32d2-ba9f-fa8e27b68dbc",
                        "source_sense_id": "a9ae15a3-1e86-3d1d-a714-59f18c5dbb59",
                        "target_lang_word": "congé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "congé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Permission d’aller, de venir, de s’absenter, de se retirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1902bf12-161d-4b90-909c-c5b8897a967f",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Cet employé a obtenu un congé de huit jours."
                                            },
                                            {
                                                "example_id": "f4554727-6834-4a1f-80fe-5ef89304f8ec",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Lui-même, à son dernier congé, en plaisantait devant moi, d'être un gradé de la marine qui, comme le petit navire de la chanson, n'avait ja-ja-jamais navigué."
                                            },
                                            {
                                                "example_id": "3f37c9dc-cabc-40b6-931f-0a6d871cebaf",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Alors maman, qui, en toutes circonstances, savait ce qui se fait et ce qui ne se fait pas, se leva et nous obligea tous à nous lever, sauf Mme Duport qui dut sentir le congé que lui signifiait maman, adouci d’une formule de gratitude pour les renseignements qu’elle nous avait donnés."
                                            },
                                            {
                                                "example_id": "354ed9e5-e587-4232-a9b5-11cc4ec180e6",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Congé de convalescence. Être en congé."
                                            },
                                            {
                                                "example_id": "cfbb8304-5457-46d2-80d2-47b797ccdb7a",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Accorder un congé de huit jours."
                                            },
                                            {
                                                "example_id": "496148d3-ae59-4a93-b58b-b27f1a4d3f61",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Ce député a demandé un congé à la Chambre, pour cause de maladie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639c24da-475a-388f-b73a-22f4768497e7",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "En parlant d’un domestique, action de se retirer tout à fait ou fait d'être renvoyé par son maître."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "note": "Dans ce sens, s'emploie généralement avec l'adjectif possessif",
                                        "examples": [
                                            {
                                                "example_id": "4141e1f2-623d-49bd-9508-91205783168b",
                                                "sense_id": "639c24da-475a-388f-b73a-22f4768497e7",
                                                "text": "Un domestique qui demande son congé."
                                            },
                                            {
                                                "example_id": "864a25c0-029c-4ec2-80f8-9f8ff6673b55",
                                                "sense_id": "639c24da-475a-388f-b73a-22f4768497e7",
                                                "text": "Son maître lui a donné congé, son congé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Vacances scolaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae2493c-9135-4f43-9539-9285393674a5",
                                                "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                                "text": "Jours de congé."
                                            },
                                            {
                                                "example_id": "b888742a-381f-4900-abe5-834e5d315c01",
                                                "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                                "text": "Les élèves ont eu congé."
                                            },
                                            {
                                                "example_id": "5b514715-4b10-488c-b7a4-e91ce6b2cb2d",
                                                "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                                "text": "C’est demain congé."
                                            },
                                            {
                                                "example_id": "226c64bb-6cda-4ce9-99f1-eb932330cf0a",
                                                "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                                "text": "Les congés de Noël, de Pâques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e68ab2d-f959-3aa5-94e5-85653193fc47",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Permission, autorisation."
                                        ],
                                        "tags": [
                                            "Simplement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebea0542-a274-458f-b3b1-b006cf3483ce",
                                                "sense_id": "1e68ab2d-f959-3aa5-94e5-85653193fc47",
                                                "text": "Se marier sans le congé de ses parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23479163-15c1-3ce7-8cc2-7181f28fac0e",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Permission de transporter la marchandise dont les droits ont été acquittés."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c7e80a-8546-4f19-98b8-0225289bddb5",
                                                "sense_id": "23479163-15c1-3ce7-8cc2-7181f28fac0e",
                                                "text": "On peut expédier ce vin, voici le congé."
                                            },
                                            {
                                                "example_id": "f62a1b95-7e47-4113-a258-dcdb3a2a3b05",
                                                "sense_id": "23479163-15c1-3ce7-8cc2-7181f28fac0e",
                                                "text": "Le 29 janvier 1686, il stipule que tout canot chargé de marchandises et ne possédant pas de congé dûment signé sera confisqué."
                                            }
                                        ]
                                    },
                                    {
