                    {
                        "translation_id": "3a47622c-c21d-44b5-8a9e-e0a72b4136ad",
                        "source_entry_id": "07eb1417-8c04-3431-99e4-b19a77a89500",
                        "source_sense_id": "5b30eae1-9048-371d-b2be-0f2c9c2f489f",
                        "source_sense_description": "de hoofdstad van Zwitserland",
                        "target_lang_word": "Berne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fba9d79d-32f9-34e8-a826-b17958b4dff6",
                                        "entry_id": "45af9adb-a87e-3e6e-bbb0-824861892cd1",
                                        "glosses": [
                                            "Canton suisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad88ff9-739a-49b0-80c8-65c2ef00985f",
                                                "sense_id": "fba9d79d-32f9-34e8-a826-b17958b4dff6",
                                                "text": "Le canton de Berne en fait aussi partie, sous la pression conjuguée du Jura bernois (où se produit du Gruyère et de la Tête de Moine) et de l’Oberland bernois, où naît le projet d'une AOC pour le fromage d'alpage et le fromage à rebibes (Hobelkäse)."
                                            },
                                            {
                                                "example_id": "ed5004dc-05b1-4554-b39c-805534b9a901",
                                                "sense_id": "fba9d79d-32f9-34e8-a826-b17958b4dff6",
                                                "text": "Réunies à Vienne, en congrès, les puissances vainqueures de l'empereur décident d'attribuer le territoire de l'Ancien évêché de Bâle au canton de Berne, donc à la Confédération helvétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fba1afd0-064d-3db2-9e36-8a019efb2834",
                                        "entry_id": "45af9adb-a87e-3e6e-bbb0-824861892cd1",
                                        "glosses": [
                                            "Ville et commune du canton de Berne , capitale fédérale de la Suisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fd6fabb-cfec-495e-be39-9d0fbd20e974",
                                                "sense_id": "fba1afd0-064d-3db2-9e36-8a019efb2834",
                                                "text": "Bien que né à Berne de parents bernois, Aloïs Werner était de complexion amoureuse."
                                            },
                                            {
                                                "example_id": "94e49a11-a38f-4d0d-af2f-dea17db88ab4",
                                                "sense_id": "fba1afd0-064d-3db2-9e36-8a019efb2834",
                                                "text": "Il y a 100 ans cette année, un modeste commis aux brevets de Berne, en Suisse, publiait les principaux éléments de sa théorie dite de la relativité."
                                            },
                                            {
                                                "example_id": "144a9e64-15b9-4e12-a884-2def5d01b0ae",
                                                "sense_id": "fba1afd0-064d-3db2-9e36-8a019efb2834",
                                                "text": "En même temps, le Conseil de Berne sollicitait du Conseil de Lausanne son appui contre le duc de Savoie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Berne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26b389b9-aab5-36bd-a2a3-209ce31bc5bb",
                                        "entry_id": "2b914595-50d5-3dda-97a9-03a184aa49b7",
                                        "glosses": [
                                            "Commune d’Allemagne, située dans la Basse-Saxe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Berne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72fede7d-b2ea-3734-92e8-ed42ea0acb36",
                                        "entry_id": "51356450-5679-3fa2-9db1-48f6f648e9a5",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2451cc84-33a3-4b6e-94f5-ce7874e47beb",
                                                "sense_id": "72fede7d-b2ea-3734-92e8-ed42ea0acb36",
                                                "text": "Eric Berne a posé les bases d’une théorie puissante, l’analyse transactionnelle (AT) et nous vous en présentons ici les premiers concepts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
