                    {
                        "sense_id": "750bdb91-8157-3d6a-90ef-fafae940ae95",
                        "entry_id": "f65878c2-18ca-353d-a6ad-a421075beae5",
                        "glosses": [
                            "iemand die veel durft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee43b93-0a15-442a-9592-07b334913678",
                                "sense_id": "750bdb91-8157-3d6a-90ef-fafae940ae95",
                                "text": "Er staat een waaghals op het punt om van de klif af te springen."
                            },
                            {
                                "example_id": "eff8a27b-98e9-4242-8c5e-5e6bb909658a",
                                "sense_id": "750bdb91-8157-3d6a-90ef-fafae940ae95",
                                "text": "Ik ben duidelijk geen waaghals maar, bedacht ik ineens, als je niet uitkijkt vliegt het leven voorbij zonder dat je het door hebt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9d7a02a-95fc-4a8e-aa99-3b042bf15138",
                        "source_entry_id": "f65878c2-18ca-353d-a6ad-a421075beae5",
                        "source_sense_id": "750bdb91-8157-3d6a-90ef-fafae940ae95",
                        "source_sense_description": "iemand die veel durft",
                        "target_lang_word": "Draufgänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Draufgänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                        "entry_id": "28524dfc-f433-3da0-9ee5-b9692354add2",
                                        "glosses": [
                                            "verwegener Mensch, der mit Elan ein Ziel anstrebt und dabei weder zögert noch sich von etwaigen Gefahren abhalten lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78da17a9-4e6f-4a96-881d-ca0190a2f040",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "„Letzte Woche sind uns die Draufgänger und die Minenpolizei auf den Leib gerückt.“"
                                            },
                                            {
                                                "example_id": "a8b9fd4e-d03e-4dd1-962f-724620780971",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "An deiner Stelle hätte ich einen Draufgänger wie Landofrank gar nicht erst geheiratet und jetzt siehst du ja, was du davon hast."
                                            },
                                            {
                                                "example_id": "8ca184bf-c300-4626-89b9-7f56964dd877",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "„Gott sei Dank war mein neuer Ehemann auch motorradfahrender Weltenbummler wie ich, ein Draufgänger wie aus dem Bilderbuch.“"
                                            },
                                            {
                                                "example_id": "b1475343-6323-4d21-979f-fe0123b99f72",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "„Skorzeny war nicht nur ein Draufgänger, sondern auch sehr intelligent.“"
                                            },
                                            {
                                                "example_id": "574795ee-30b8-4336-9f7a-1fbf1880ee6d",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "„Der Ablauf des riskanten illegalen Tiefflugs der beiden amerikanischen Piloten, die Umstände der Videoaufzeichnung, eine verbreitete Mentalität in der US-Armee, die lebendige internationale Fliegertradition legen es nahe, von einem fehlgeschlagenen Versuch auszugehen, sich mit einem beweisbaren Mutakt, dem Unterfliegen einer Seilbahn, als unverwüstliche Draufgänger auszuweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d3440d-08b3-4774-aa24-280428b56bf5",
                        "source_entry_id": "f65878c2-18ca-353d-a6ad-a421075beae5",
                        "source_sense_id": "750bdb91-8157-3d6a-90ef-fafae940ae95",
                        "source_sense_description": "iemand die veel durft",
                        "target_lang_word": "daredevil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daredevil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "224227a1-f0cd-391d-b9a1-40f59899d007",
                                        "entry_id": "a7af527f-12da-3dab-ade7-c5e19cf7ceb5",
                                        "glosses": [
                                            "A person who engages in very risky behavior, especially one who is motivated by a craving for excitement or attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31981f6e-993f-43a1-8cfc-b4839cdbfb55",
                                                "sense_id": "224227a1-f0cd-391d-b9a1-40f59899d007",
                                                "text": "Even as a youngster, Steven was a bit of a daredevil riding up homemade wooden ramps on his BMX."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daredevil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e6244e2-7d39-395c-aaa3-ce10c9288bda",
                                        "entry_id": "6905e1b4-760e-3b75-b576-1fd3dc6c812b",
                                        "glosses": [
                                            "Recklessly bold; adventurous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc7bc5e-6b2f-4bf6-902e-52105bdd8735",
                                                "sense_id": "7e6244e2-7d39-395c-aaa3-ce10c9288bda",
                                                "text": "The climactic scene of “Rebel without a Cause” is the group of very daredevil teens playing chicken."
                                            },
                                            {
                                                "example_id": "fad6068b-c564-4869-8051-e7d1f3cfd16b",
                                                "sense_id": "7e6244e2-7d39-395c-aaa3-ce10c9288bda",
                                                "text": "Not only do they glide gracefully with burdens on their heads, they bend to pick money that has been flung at them; dash across roads with cars zooming by and the most daredevil do all this with a child strapped to their back."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daredevil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27a556c9-c751-3d1e-acaa-f7752c4256a9",
                                        "entry_id": "4128c0da-7cde-39e6-9fb9-0307c9e0b95a",
                                        "glosses": [
                                            "To behave in a reckless, adventurous, or physically risky manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "085f14bb-0247-429d-8588-a9e19b0b538e",
                        "source_entry_id": "f65878c2-18ca-353d-a6ad-a421075beae5",
                        "source_sense_id": "750bdb91-8157-3d6a-90ef-fafae940ae95",
                        "source_sense_description": "iemand die veel durft",
                        "target_lang_word": "casse-cou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casse-cou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5acc73eb-225f-351d-bea4-bb5b5a8e7485",
                                        "entry_id": "84cfd2ee-2400-3477-b165-847f51769a7d",
                                        "glosses": [
                                            "Endroit où l’on risque de tomber, si l’on n’y prend garde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b15426-2137-424a-98d8-e3a10dab390b",
                                                "sense_id": "5acc73eb-225f-351d-bea4-bb5b5a8e7485",
                                                "text": "À partir d’Illescas, le terrain devient plus accidenté, et il résulte de là une route encore plus abominable ; ce ne sont que fondrières et casse-cou."
                                            },
                                            {
                                                "example_id": "06148d06-7816-4549-9dea-219173efa660",
                                                "sense_id": "5acc73eb-225f-351d-bea4-bb5b5a8e7485",
                                                "text": "Pour le reste, il habite une espèce de casse-cou dans une rue déserte, pas de lumière à la porte ni sous le vestibule."
                                            },
                                            {
                                                "example_id": "e5fb3839-1dcb-4d52-9eb4-141aa374a387",
                                                "sense_id": "5acc73eb-225f-351d-bea4-bb5b5a8e7485",
                                                "text": "Dès les premières marches ils rencontrèrent des traces de sang. Au bas du casse-cou, dans la ruelle étroite et sans nom qui redescend dans la street, ils trouvèrent un sanglant et informe pêle-mêle. Le cheval avait été littéralement broyé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78fa6b35-6e07-3d97-a3b9-2de7d8aea5a3",
                                        "entry_id": "84cfd2ee-2400-3477-b165-847f51769a7d",
                                        "glosses": [
                                            "Risque, opération périlleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120945ab-8924-4043-a28b-b7af7429841e",
                                                "sense_id": "78fa6b35-6e07-3d97-a3b9-2de7d8aea5a3",
                                                "text": "[…] offrez à tous ces endormis de se mettre à la chasse de l’impossible, des millions conquis en deux heures, au milieu des plus effroyables casse-cou ; et la course commence, les énergies sont décuplées, la bousculade est telle, que, tout en suant uniquement pour leur plaisir, les gens arrivent parfois à faire des enfants, je veux dire des choses vivantes, grandes et belles…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10c0b43-9776-31b6-8755-e04910a4896f",
                                        "entry_id": "84cfd2ee-2400-3477-b165-847f51769a7d",
                                        "glosses": [
                                            "En termes du jeu de colin-maillard, s’emploie comme interjection pour avertir la personne qui a les yeux bandés qu’elle s’approche d’un endroit où elle pourrait se blesser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c17b51-2165-4e09-b25d-edb376ddfab5",
                                                "sense_id": "f10c0b43-9776-31b6-8755-e04910a4896f",
                                                "text": "Crier casse-cou à quelqu’un."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "casse-cou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb5aa052-2d25-3cda-b158-ea6cccb55b97",
                                        "entry_id": "c4c9054c-6ea9-3722-bdb7-4f36f003915c",
                                        "glosses": [
                                            "Personne qui se lance dans une affaire hasardeuse ou dangereuse sans en calculer les conséquences."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a701a96c-a1eb-46c5-83bf-0cc7f899c5c4",
                                                "sense_id": "bb5aa052-2d25-3cda-b158-ea6cccb55b97",
                                                "text": "Je vous présente un hardi casse-cou."
                                            },
                                            {
                                                "example_id": "506675d2-085c-4e08-ab7b-7e457e615027",
                                                "sense_id": "bb5aa052-2d25-3cda-b158-ea6cccb55b97",
                                                "text": "Rien n’est triste dans un duel comme une guimbarde qui s’avance cahin-caha : il ne faut pas arriver en casse-cou, mais il ne faut pas arriver en invalide."
                                            },
                                            {
                                                "example_id": "8be70588-5402-4102-9835-9c65fc53f9c3",
                                                "sense_id": "bb5aa052-2d25-3cda-b158-ea6cccb55b97",
                                                "text": "Il n’y avait de garde-fou que d’un côté, et, sur ces planchettes, mon père, toujours casse-cou, nous fit passer d’écluse en écluse jusque sur le quai."
                                            },
                                            {
                                                "example_id": "5f97477f-646f-4114-b8d1-3cb25ec6bf8c",
                                                "sense_id": "bb5aa052-2d25-3cda-b158-ea6cccb55b97",
                                                "text": "La mission était difficile, on l’a confiée à un casse-cou."
                                            },
                                            {
                                                "example_id": "b25d2b85-22b9-4305-aadc-bf9fb608bd1b",
                                                "sense_id": "bb5aa052-2d25-3cda-b158-ea6cccb55b97",
                                                "text": "un usager de trottinette électrique s'est montré trop imprudent en empruntant la Vélo voie verte longeant le canal latéral à Castelsarrasin, direction le Mc Donald's, son lieu de travail, raconte La Dépêche du Midi. Un peu trop vite, un peu trop casse-cou à tel point qu'il finit par percuter une autre trottinette roulant moins vite et conduite par un autre homme. Sous le choc, le trottinettiste (ou trottineur) employé de McDo fait une chute et tombe sur la tête."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "casse-cou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "baf0779f-9e12-3506-8404-b6a588808209",
                                        "entry_id": "a9561d1a-ab65-3fde-a96c-e691731233b2",
                                        "glosses": [
                                            "Se dit d’un endroit où l’on risque de tomber, si l’on n’y prend garde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aca7bae3-6369-45fb-9caf-e65e62dc3a5f",
                                                "sense_id": "baf0779f-9e12-3506-8404-b6a588808209",
                                                "text": "Ah ! avec quelle joie au contraire il eût grimpé les étages noirs, malodorants et casse-cou de la petite couturière retirée, dans le « cinquième » de laquelle il aurait été si heureux de payer plus cher qu’une avant-scène hebdomadaire à l’Opéra le droit de passer la soirée quand Odette y venait […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f16c131-15ca-36d0-82de-9ffe47bcdb00",
                                        "entry_id": "a9561d1a-ab65-3fde-a96c-e691731233b2",
                                        "glosses": [
                                            "Se dit d’une personne qui se lance dans une affaire hasardeuse ou dangereuse sans en calculer les conséquences."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47e435f9-4976-3bc8-bc63-025a5b4bdd56",
                                        "entry_id": "a9561d1a-ab65-3fde-a96c-e691731233b2",
                                        "glosses": [
                                            "Qualifie l’affaire en question."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9436400e-9277-4e91-b058-835793f3969c",
                                                "sense_id": "47e435f9-4976-3bc8-bc63-025a5b4bdd56",
                                                "text": "De fait, jamais l’influent Gesac n’a osé soulever à leurs oreilles les conséquences d’une remise en cause du statut des hébergeurs, impliquant autant d’atteintes à la liberté d’expression. Dommage. Certes, ces points sont beaucoup moins sexy, extrêmement techniques, mais cela montre avant tout que légiférer sous le coup des bons sentiments est toujours casse-cou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
