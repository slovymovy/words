                ],
                "senses": [
                    {
                        "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                        "entry_id": "593e343a-0cc1-3057-b86f-a11ee4ad6075",
                        "glosses": [
                            "Einrichtung zur Verbesserung der Gesundheit chronisch/ernsthaft Kranker oder Genesender"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7242d07c-e8ec-4e18-8a8f-28bc944fa8bd",
                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                "text": "„Man teilt ihr mit, dass ihr Vater im Sanatorium Saint-Paul in Dallas an einer Lungenentzündung gestorben ist.“"
                            },
                            {
                                "example_id": "8f188ee8-611f-47b7-826c-14c0b4f64fa5",
                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                "text": "Sie besuchten ihren Großvater im Sanatorium, doch er erkannte sie nicht einmal."
                            },
                            {
                                "example_id": "bc320f9e-dac9-4c6c-9aae-cb0180b13ec0",
                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                "text": "„Kurz vor seiner Entlassung aus dem Sanatorium hatte eine Frau Laverino aus Bad Harzburg Isolde telefonisch mitgeteilt, dass sie ein Päckchen aufbewahre, das für ihn bestimmt sei.“"
                            },
                            {
                                "example_id": "e62945bc-2d50-414c-a455-c7fb3664951f",
                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                "text": "„Als die Krankheit der Tante entdeckt wurde und sie in ein Sanatorium kam, mußte ich den Herzlein beaufsichtigen.“"
                            },
                            {
                                "example_id": "99070ae0-8f26-4bdf-8d06-b618b5661759",
                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                "text": "„Pat stirbt in einem Sanatorium an Tuberkulose.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dcdf62a-e336-4528-b635-804d364e32f3",
                        "source_entry_id": "593e343a-0cc1-3057-b86f-a11ee4ad6075",
                        "source_sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
