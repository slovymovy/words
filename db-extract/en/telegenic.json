                                            {
                                                "example_id": "18ef830b-96d7-4fad-8866-7ac400bcbee2",
                                                "sense_id": "f288d654-b3bc-33a3-93f6-e845b18c78c5",
                                                "text": "Ihre Ausstrahlung macht sie telegen."
                                            },
                                            {
                                                "example_id": "31886dbf-c5cc-4cdd-9a00-f29270ec51bf",
                                                "sense_id": "f288d654-b3bc-33a3-93f6-e845b18c78c5",
                                                "text": "Um als Moderator beim Fernsehen arbeiten zu können, muss man nicht nur fachlich geeignet, sondern auch telegen sein."
                                            },
                                            {
                                                "example_id": "f60a1ece-a2b7-4782-8e45-b6fa0ec4929e",
                                                "sense_id": "f288d654-b3bc-33a3-93f6-e845b18c78c5",
                                                "text": "Sie ist die telegenste von allen Moderatorinnen, die ich bisher gesehen habe."
                                            },
                                            {
                                                "example_id": "cf7ab697-82a4-47d7-993f-e5e61b552560",
                                                "sense_id": "f288d654-b3bc-33a3-93f6-e845b18c78c5",
                                                "text": "„Die Fernsehgewaltigen begannen plötzlich zu begreifen, wie telegen diese Sportart doch ist und dass es kaum einen besseren Weg gab, sein Fernsehprogramm zu füllen.“"
                                            }
