                                                "example_id": "c17d9109-7239-4d62-973e-895b09217771",
                                                "sense_id": "feb8bd28-fabf-33e6-b31c-769f5503638a",
                                                "text": "[...] ethnic groups, the Afars. The majority of the Somali-speaking Issas, the other main group, do support President Hassan Gouled and his RPP, though the Prime Minister, Barkat Gourad is an Afar himself."
                                            },
                                            {
                                                "example_id": "791ddb7c-94df-4e97-8c7e-f14c8c007795",
                                                "sense_id": "feb8bd28-fabf-33e6-b31c-769f5503638a",
                                                "text": "Shortly thereafter he broke with Aref and supported independence. Aref was an Afar, and Gouled came from the Issa ethnic group, which for years had been at odds with the Afars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
