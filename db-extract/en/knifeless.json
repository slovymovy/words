                        "examples": [
                            {
                                "example_id": "eea99be9-03bb-446d-a7b4-0cefcecf2252",
                                "sense_id": "d222880d-4856-37ff-9d9b-fa8e2c4e8275",
                                "text": "He was completely nonpushed – he didn’t know what to do – but, not daring to come back again knife-less, had at last determined to buy a dozen; and there they were, a dozen of as good “sheer steel” blades and prongs as were ever crossed on a platter."
                            },
                            {
                                "example_id": "f38a785b-f371-4949-ae1d-473635921c71",
                                "sense_id": "d222880d-4856-37ff-9d9b-fa8e2c4e8275",
                                "text": "He advocates a “knife-less” method of treatment, consisting essentially of nerves sedatives, such as asafætida, valerian, etc., combined with fluid extract of hydrastis in 10 minim doses before meals."
                            }
                        ]
