{
    "word_family": [
        "observateur",
        "observation",
        "observable",
        "observatoire",
        "observance",
        "inobservable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fbd33029-65d7-3ff9-8b9c-f00a05e7227f",
                    "sense_definition": "Regarder quelqu'un ou quelque chose avec attention et soin.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle aime <w>observer</w> les oiseaux dans le jardin depuis sa fenêtre."
                        },
                        {
                            "text": "Le professeur <w>observe</w> les élèves pendant qu'ils travaillent en silence."
                        }
                    ],
                    "common_phrases": [
                        "observer en silence",
                        "observer attentivement"
                    ]
                },
                {
                    "sense_id": "263d351e-f972-333a-bcb7-e7f89c1340bd",
                    "sense_definition": "Se conformer à une règle, une loi ou une tradition ; respecter scrupuleusement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "respect_regle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les usagers doivent <w>observer</w> scrupuleusement le code de la route."
                        },
                        {
                            "text": "Les citoyens ont décidé d'<w>observer</w> une minute de silence en hommage aux victimes."
                        }
                    ],
                    "synonyms": [
                        "suivre"
                    ],
                    "common_phrases": [
                        "observer les règles",
                        "observer la loi",
                        "observer une minute de silence"
                    ]
                },
                {
                    "sense_id": "fa7b488f-8f7f-39aa-8916-91409f89bb84",
                    "sense_definition": "Constater un fait ou remarquer un détail particulier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "constat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On <w>observe</w> une nette amélioration de la situation au cours des dernières semaines."
                        },
                        {
                            "text": "Le médecin a <w>observé</w> des réactions positives dès le début du traitement."
                        }
                    ],
                    "common_phrases": [
                        "observer un changement",
                        "observer une amélioration"
                    ]
                },
                {
                    "sense_id": "4cd1cf78-1e8c-3132-aec0-5359a0edebe3",
                    "sense_definition": "Examiner méthodiquement des phénomènes ou des objets en vue d'une étude scientifique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astronomes utilisent ce puissant télescope pour <w>observer</w> les galaxies lointaines."
                        },
                        {
                            "text": "Le chercheur passe des heures à <w>observer</w> l'évolution des cellules en laboratoire."
                        }
                    ],
                    "common_phrases": [
                        "observer au microscope",
                        "observer les étoiles"
                    ]
                },
                {
                    "sense_id": "a8c2d766-50d9-3fc6-96c7-cca7e69adaf4",
                    "sense_definition": "Faire remarquer quelque chose à quelqu'un dans un discours ou un écrit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat fit <w>observer</w> au juge que le témoin semblait hésitant dans ses déclarations."
                        },
                        {
                            "text": "Je me permets de vous faire <w>observer</w> qu'il est déjà tard pour modifier ce projet."
                        }
                    ],
                    "common_phrases": [
                        "faire observer"
                    ]
                }
            ]
        }
    ]
}