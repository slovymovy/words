                ],
                "senses": [
                    {
                        "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                        "entry_id": "da6a13ae-64d9-30d0-a878-106169890ca9",
                        "glosses": [
                            "Ort/Stelle, an der Tiere (beispielsweise Vögel, Fische, Insekten) ortsfest ihre Nachkommen großziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87700c1f-439e-4989-a5ba-88001c08d8cc",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "Brutplätze von Vögeln müssen in Deutschland häufig geschützt werden."
                            },
                            {
                                "example_id": "c344a6c4-168a-43bc-9307-ca19ca6ff34d",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "Der Westküstenpark St. Peter-Ording ist ein Brutplatz für Störche."
                            },
                            {
                                "example_id": "4fb6be5c-e6cf-4e55-9979-2565459a51e3",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "Die Bekassine braucht als Brutplatz Feuchtwiesen."
                            },
                            {
                                "example_id": "0ab983f2-e0a3-47ff-a1af-eb318ccba28e",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "Die Kaiserpinguine haben den kältesten Brutplatz auf der Erde: die Antarktis."
                            },
                            {
                                "example_id": "d64a130e-588b-450e-a854-02f53d0d28fe",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "Es gibt immer weniger Schwalben. Es fehlen für die Vögel Brutplätze an Hauswänden oder in Ställen."
                            },
                            {
                                "example_id": "0ab9119e-b8b8-48aa-a5d7-78f379d93c63",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "Die Brutplätze der Malariamücken müssen beseitigt werden: deckt Regenfässer ab, stellt Gießkannen, Blumentöpfe und Eimer so auf, dass sich darin kein Regenwasser ansammeln kann."
                            },
                            {
                                "example_id": "c301cbc4-984e-4808-8a4d-fe73639afdba",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "„Die ausgedehnten Schilfflächen des Neusiedler Sees bieten ideale Brutplätze für Rohrdommeln, Haubentaucher, Rohrsänger“ […]."
                            },
                            {
                                "example_id": "b21da5ae-5746-4191-a812-821696871f7c",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "„Im Osten von Ameland ist das Oerd ein wichtiger Brutplatz für blaue und braune Weihen.“"
                            },
                            {
                                "example_id": "7c58e31c-a73a-4e48-ba47-8a7c09113b71",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "[Die Naturschutzgebiete] „Böhmke und Werder sind Brutplatz und Biotop für Zigtausende von Küstenvögeln, die zum großen Teil unter Naturschutz stehen.“"
                            },
                            {
                                "example_id": "8b902ea6-21a6-4129-89f0-e58d0f594751",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "„Mitten im Skagafjörður, einem der größten Fjorde der Region, liegt die Insel Drangey, ein steiler, schroffer Felsen, der Brutplatz von Möwen und Papageientauchern ist.“"
                            },
                            {
                                "example_id": "fbab1205-7e10-48b1-8f1a-302437e6acea",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "„Zwei Pelikanpärchen brüten ihre Eier aus. Ein weiteres sucht noch nach dem geeigneten Brutplatz.“"
                            },
                            {
                                "example_id": "5a6923bf-42d9-4561-ab9b-a13c2cb160a7",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "[Pfeilschwanzkrebse:] […] „einige der Brutplätze an der Delaware Bay wurden inzwischen durch Zäune geschützt, damit weniger Tiere während der Laichzeit umkommen.“"
                            },
                            {
                                "example_id": "c5e2534e-d34e-4667-8c22-d94355de80e5",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "„Frauen aus den Gemeinden Kahtupika, Wagina und Kia haben sich zusammengeschlossen, um die wichtigen Brutplätze der Echten Karettschildkröte im Südpazifik zu schützen.“"
                            },
                            {
                                "example_id": "e005d5e8-d97b-47bd-bb50-394b53b6bae3",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "[…] „die Mangroven-Lagunen, oft als Kinderstube von Fischen und Garnelen bezeichnet, weil sie deren Brutplätze sind, sind bedroht.“"
                            },
                            {
                                "example_id": "c866fea4-17f1-42e9-a0d4-ceba169f9cb0",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "[Dümmersee:] „Die Teichrosenfelder auf dem See bieten“ […] „der größten niedersächsischen Kolonie von Trauerseeschwalben einen Brutplatz.“"
                            },
                            {
                                "example_id": "e69803ba-78f0-4faf-8399-77cf96e3ba4b",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "„Störche sind wieder unter anderem in Schleswig-Holstein unterwegs und suchen Nester zum Brüten. Einen Brutplatz gibt es jetzt in Norstedt.“"
                            },
                            {
                                "example_id": "5a4f75ed-bb1a-4742-a1ee-bf829edff57d",
                                "sense_id": "596f6d6e-e4e1-37ec-9a8f-925109489e0e",
                                "text": "[Im Wattenmeer rasten jedes Jahr] „zwischen zehn und zwölf Millionen Zugvögel auf ihrem Weg von den Brutplätzen in der Arktis zu ihren Überwinterungsgebieten in Afrika.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
