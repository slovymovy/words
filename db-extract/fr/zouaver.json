                        "entry_id": "adf45058-923d-37f5-a4b2-df8dbfe3e96c",
                        "glosses": [
                            "Se comporter comme un zouave (par exemple en se pavanant)."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6f8cc755-28c7-41d5-b661-1280c99fb0ee",
                                "sense_id": "eb54a291-5a2a-3d4b-938e-c953ca37ae4c",
                                "text": "Dites-leur donc de grandir plus vite que çà, et de venir zouaver avec moi, pour l’amour du bon Dieu !"
                            },
                            {
                                "example_id": "fe2d2e4b-5763-4c70-a4c3-1a629d3e4417",
                                "sense_id": "eb54a291-5a2a-3d4b-938e-c953ca37ae4c",
                                "text": "Y en a qui font leurs niches ici, y en a d’autres qui zouavent dans le bordel."
                            }
                        ]
                    }
