                    {
                        "translation_id": "02d2865a-bc33-4c89-a100-eb2dc06d8ec9",
                        "source_entry_id": "4e898a9c-1e9e-36e9-8aba-3cdcb8da22c5",
                        "source_sense_id": "db5f9c5e-32c0-35c3-a00c-c5818c5de693",
                        "source_sense_description": "a single handheld percussion instrument",
                        "target_lang_word": "castagnette",
