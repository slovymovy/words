                                            "gelukzaligheid in religieuze context"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f062a7a-a781-4744-bdc3-33a997312b37",
                                                "sense_id": "55ae4b3c-5bf3-3cea-b9a6-99cd2d7a8cff",
                                                "text": "Want Uw is het Koninkrijk, en de kracht, en de heerlijkheid, in der eeuwigheid, amen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d14725-14d9-3a17-9dd9-d1f56f48f2b0",
                                        "entry_id": "8e6fbce4-4485-3cca-87c6-555b79f1ac79",
                                        "glosses": [
                                            "iets bijzonder aangenaams"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58789239-b61c-4e21-b388-251eccb29c38",
                                                "sense_id": "a8d14725-14d9-3a17-9dd9-d1f56f48f2b0",
                                                "text": "Dat je eindelijk dat examen achter de rug hebt is echt een heerlijkheid!"
                                            }
                                        ]
                                    }
                                ]
                            }
