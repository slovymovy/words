                                            {
                                                "example_id": "00e1078d-4127-406a-84c7-41069e2f90c4",
                                                "sense_id": "63412b8e-c5bb-381d-99e7-d317d6367e6f",
                                                "text": "Vzhledem k mimořádné koncentraci moci zanikala diktatura nejen dosažením cíle (např. porážkou nepřítele), ale i uplynutím relativně krátké lhůty: diktátor se po 6 měsících musel své funkce vzdát. Diktatura rovněž zanikala s koncem úřední lhůty konsula, který jmenování diktátora provedl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d66723bc-153d-386f-b8c5-2b15eb15843c",
                                        "entry_id": "f58db645-cbb2-3221-9162-528be997a7d0",
                                        "glosses": [
                                            "neomezená vláda jednotlivce"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc51f2a-010c-4ec7-b09a-d678680f2b21",
                                                "sense_id": "d66723bc-153d-386f-b8c5-2b15eb15843c",
                                                "text": "Každá diktatura (i ta podniková nebo rodinná) je svým způsobem legrační. Tyranie svými každodenními i slavnostními projevy buď nedosahuje na míru lidské důstojnosti, nebo ji zbrkle překračuje ve snaze vytvářet cosi gigantického, nebývalého a neopakovatelného."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c10188-1919-3dcf-8c00-53cfa988dd45",
                                        "entry_id": "f58db645-cbb2-3221-9162-528be997a7d0",
                                        "glosses": [
                                            "neomezená moc, ovládání diktátem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1c2bd5-54ec-4bf4-8974-f1b0fc46d06b",
                                                "sense_id": "e4c10188-1919-3dcf-8c00-53cfa988dd45",
                                                "text": "Dlouhá diktatura komunistů se podepsala na vztahu obyvatelstva k církvi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b00adce4-3937-395d-a9cb-7ede32106ffa",
                                        "entry_id": "f58db645-cbb2-3221-9162-528be997a7d0",
                                        "glosses": [
                                            "stát ovládaný diktátorem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4909c7-f12a-454f-84f6-869fa4bcb1d7",
                                                "sense_id": "b00adce4-3937-395d-a9cb-7ede32106ffa",
                                                "text": "Zvláštní diktatura Barma je dnes izolovaným, zaostalým ostrovem s padesáti miliony obyvatel uvězněných uprostřed bouřlivě se rozvíjejícího regionu."
                                            }
                                        ]
                                    }
                                ]
                            },
