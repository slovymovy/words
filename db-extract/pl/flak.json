                "translations": [
                    {
                        "translation_id": "3cd37593-7f55-4ab5-b32c-f5725e6bc5e9",
                        "source_entry_id": "6b8aa639-1475-38a3-9bf9-763e5cfbfe59",
                        "source_sense_id": "d23b778b-0dc2-30c0-b5d5-41923df11e6e",
                        "target_lang_word": "tripe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tripe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "330272ac-9e31-301e-b105-b095c724b116",
                                        "entry_id": "fd9abce2-2d33-3878-9c76-d133a3987da6",
                                        "glosses": [
                                            "The lining of the large stomach of ruminating animals, when prepared for food."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7e5a22c-eb3e-47a1-8511-90dedc0773f1",
                                                "sense_id": "330272ac-9e31-301e-b105-b095c724b116",
                                                "text": "You saw only your mother die. I see them pop off every day in the Mater and Richmond and cut up into tripes in the dissectingroom."
                                            },
                                            {
                                                "example_id": "3f571bcc-0a8a-44e1-92d2-a34065be0b5c",
                                                "sense_id": "330272ac-9e31-301e-b105-b095c724b116",
                                                "text": "Tripe: A popular dish commonly believed to be a sexual stimulant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29fb41bd-8df8-3af2-ac8c-14e271b5fb61",
                                        "entry_id": "fd9abce2-2d33-3878-9c76-d133a3987da6",
                                        "glosses": [
                                            "The entrails; (by extension, humorous or derogatory) the belly."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d939d2e2-fe94-495c-8e41-6d20f889a86c",
                                                "sense_id": "29fb41bd-8df8-3af2-ac8c-14e271b5fb61",
                                                "text": "Next morning Miss Dolly complained of her Tripes; / Drinking cold water had given her gripes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04b1386d-6ea5-3b7e-bc08-0a7164edc12b",
                                        "entry_id": "fd9abce2-2d33-3878-9c76-d133a3987da6",
                                        "glosses": [
                                            "Something foolish or valueless, especially written works and popular entertainment (movies, television)."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b73df2a1-1173-428d-8e8d-ae4166817a40",
                                                "sense_id": "04b1386d-6ea5-3b7e-bc08-0a7164edc12b",
                                                "text": "No, I'm not kidding. Professor, Broadway stands for a lot of baloney; but, it will never digest a piece of tripe like this!"
                                            },
                                            {
                                                "example_id": "36531795-e0d6-4a22-a41a-1f747f9a4903",
                                                "sense_id": "04b1386d-6ea5-3b7e-bc08-0a7164edc12b",
                                                "text": "We believe that the purpose of science is to serve mankind. You, however, seem to regard science as some kind of dodge… or hustle. Your theories are the worst kind of popular tripe, your methods are sloppy, and your conclusions are highly questionable! You are a poor scientist, Dr. Venkman!"
                                            },
                                            {
                                                "example_id": "43bb80c3-9f6d-4eb3-a7fb-aba6c728360d",
                                                "sense_id": "04b1386d-6ea5-3b7e-bc08-0a7164edc12b",
                                                "text": "It was dismissed by Mr. Johnson as “sexist, misogynist, tripe,” and prompted more than 5,500 complaints, according to the independent regulator of most of Britain’s newspapers and magazines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1e381c9-dc05-3c46-a000-bc113f39bbf1",
                                        "entry_id": "fd9abce2-2d33-3878-9c76-d133a3987da6",
                                        "glosses": [
                                            "An edible lichen, especially rock tripe."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tripe",
                                "target_lang_code": "en",
                                "target_senses": [
