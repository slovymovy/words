                        ]
                    },
                    {
                        "sense_id": "c0aefd61-3c50-384d-897c-a120ebb1d646",
                        "entry_id": "9fc0ca0c-77d6-3dd8-8514-260db3322628",
                        "glosses": [
                            "osteometry, osteology, investigation into bone matters"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
