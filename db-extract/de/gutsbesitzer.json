                "senses": [
                    {
                        "sense_id": "9ff4234f-90e5-3b95-a2da-fb8c2f3f6d68",
                        "entry_id": "6846b4b6-32a0-3ecf-a4fa-aad886adc873",
                        "glosses": [
                            "jemand, der ein Gut - einen größeren landwirtschaftlichen Betrieb - besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac319841-1830-436b-8541-ececa24d1624",
                                "sense_id": "9ff4234f-90e5-3b95-a2da-fb8c2f3f6d68",
                                "text": "„Gutsbesitzer im östlichsten Ostpreußen zu sein heißt vor dem Krieg nicht automatisch, mit der Landwirtschaft auch großes Geld zu verdienen.“"
                            },
                            {
                                "example_id": "7eadfa38-f73c-4330-bd78-95d75db1d673",
                                "sense_id": "9ff4234f-90e5-3b95-a2da-fb8c2f3f6d68",
                                "text": "„Der Gutsbesitzer hat das Gesehen.“"
                            },
                            {
                                "example_id": "56f6ad1b-b83b-47cb-baf2-7b4943dbeb7a",
                                "sense_id": "9ff4234f-90e5-3b95-a2da-fb8c2f3f6d68",
                                "text": "„Als Anatol vor zwei Jahren mit seinem Regiment in Polen gestanden hatte, war er von einem kleinen polnischen Gutsbesitzer gezwungen worden, dessen Tochter zu heiraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
