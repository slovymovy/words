                    {
                        "sense_id": "31f47db7-cd09-31e1-a2ee-12e79f5fa506",
                        "entry_id": "2408b864-2af7-3ab5-9dc7-4bed30a305a6",
                        "glosses": [
                            "Relatif à l’amygdale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0257db19-9e0b-4711-8a32-58e58803d5e9",
                                "sense_id": "31f47db7-cd09-31e1-a2ee-12e79f5fa506",
                                "text": "Je reprends mes prouesses amygdaliennes là où je les ai laissées."
                            },
                            {
                                "example_id": "09079ee2-75e0-4201-b815-b2e565f80e71",
                                "sense_id": "31f47db7-cd09-31e1-a2ee-12e79f5fa506",
                                "text": "L’attribution d’une valence émotionnelle à des mots écrits qui nécessite préalablement un décodage du sens des mots repose également sur le même système amygdalien. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 167)"
                            },
                            {
                                "example_id": "831d78b1-48a5-4c8a-94d5-9add2a8b4739",
                                "sense_id": "31f47db7-cd09-31e1-a2ee-12e79f5fa506",
                                "text": "Outre le fait que le sérum contient un transmetteur, il stimule le complexe amygdalien, la zone du cerveau qui traite les émotions négatives comme la peur ; et il induit une hallucination."
                            }
                        ]
                    }
