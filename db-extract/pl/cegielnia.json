                                "target_senses": [
                                    {
                                        "sense_id": "ad981e8c-8bfa-39b0-8631-3cb1da9622cb",
                                        "entry_id": "ef298524-31ef-3b8d-a542-accdad8fd984",
                                        "glosses": [
                                            "A place where bricks are, or once were, produced or distributed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da57f949-88c2-4e41-822f-31ad8621fcb8",
                                                "sense_id": "ad981e8c-8bfa-39b0-8631-3cb1da9622cb",
                                                "text": "Since Vanita was a child, the family has roamed the country in search of work — in construction and road-building, and finally, here to this brickyard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
