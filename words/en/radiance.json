{
    "word_family": [
        "radiant",
        "radiate",
        "radiation",
        "radiator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17585c71-2496-3928-96e4-50dbfb9d41fd",
                    "sense_definition": "The quality or state of being bright, shining, or splendid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>radiance</w> of the morning sun filled the entire room with warmth.",
                            "target_lang_translations": {
                                "ru": "<w>Сия́ние</w> утреннего солнца наполнило всю комнату теплом."
                            }
                        },
                        {
                            "text": "She was known for the <w>radiance</w> of her smile, which brought joy to everyone.",
                            "target_lang_translations": {
                                "ru": "Она была известна <w>сия́нием</w> своей улыбки, которая приносила радость всем окружающим."
                            }
                        }
                    ],
                    "synonyms": [
                        "brightness",
                        "brilliance",
                        "glow"
                    ],
                    "antonyms": [
                        "dullness",
                        "gloom"
                    ],
                    "common_phrases": [
                        "soft radiance",
                        "pure radiance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние яркости, сияния или великолепия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сия́ние",
                                "target_lang_sense_clarification": "ровный, яркий свет или радостное выражение лица"
                            },
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "яркий свет или выдающееся проявление чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b0f7eca-2f09-30e5-b516-1924bba86fa6",
                    "sense_definition": "The amount of radiation emitted from a surface in a specific direction per unit area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sensor measured the spectral <w>radiance</w> of the distant star.",
                            "target_lang_translations": {
                                "ru": "Датчик измерил спектральную <w>я́ркость</w> далекой звезды."
                            }
                        },
                        {
                            "text": "Engineers calculated the <w>radiance</w> to determine the heat output of the material.",
                            "target_lang_translations": {
                                "ru": "Инженеры рассчитали <w>излуче́ние</w>, чтобы определить теплоотдачу материала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spectral radiance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество излучения, испускаемого поверхностью в определенном направлении на единицу площади."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излуче́ние",
                                "target_lang_sense_clarification": "поток энергии или частиц, испускаемый источником"
                            },
                            {
                                "target_lang_word": "я́ркость",
                                "target_lang_sense_clarification": "физическая величина, характеризующая интенсивность света в данном направлении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}