                "senses": [
                    {
                        "sense_id": "f87b7fac-52e0-3700-9322-ef14ed6186c7",
                        "entry_id": "58c08359-53d2-3966-bbaa-a8a1d7796a36",
                        "glosses": [
                            "Buch, das Themen behandelt, die mit Krieg zu tun haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101de363-59e6-4481-8fc2-37be036b0724",
                                "sense_id": "f87b7fac-52e0-3700-9322-ef14ed6186c7",
                                "text": "„Für eine demokratische Gesellschaft in hohem Maße problematisch bleibe Jüngers Frühwerk, jene noch in den 1950er Jahren vielgelesenen Kriegsbücher, darin er seine Erlebnisse im Ersten Weltkrieg als Offizier an der Westfront darstellt.“"
                            },
                            {
                                "example_id": "ad675052-8844-4f6b-bf3f-d14a7ea23124",
                                "sense_id": "f87b7fac-52e0-3700-9322-ef14ed6186c7",
                                "text": "„Ein freundlicher Kritiker hat da im Hugenberg-Konzern über Kriegsbücher geschrieben.“"
                            },
                            {
                                "example_id": "79bfc958-0af0-4c7e-a5f3-9c95e6ac2534",
                                "sense_id": "f87b7fac-52e0-3700-9322-ef14ed6186c7",
                                "text": "„Man sollte nicht immer glauben, was man in Kriegsbüchern liest; es gibt Schlimmeres.“"
                            },
                            {
                                "example_id": "50c4e32a-9c67-4357-a8ca-515e2df12e19",
                                "sense_id": "f87b7fac-52e0-3700-9322-ef14ed6186c7",
                                "text": "„Ich habe viele Kriegsfilme gesehen, das ist wahr. Auch Kriegsbücher gelesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
