                "senses": [
                    {
                        "sense_id": "9da497de-dfa8-3e23-8303-d162d50dd049",
                        "entry_id": "22ad6644-f21e-38a0-90a0-bb1cf2f25132",
                        "glosses": [
                            "member of the Black Hundreds, a reactionary anti-Semitic political movement in Russia in the 1900-1910s"
                        ],
                        "tags": [
                            "historical",
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "67e7b773-423a-45bb-b5fc-c88aa973596f",
                                "sense_id": "9da497de-dfa8-3e23-8303-d162d50dd049",
                                "text": "Któż w kółku bakińskich koleżków mógłby się był przyznawać do patryotyzmu rosyjskiego, mocarstwowego, przedwojennego, carskiego? Byłby to czarnoseciniec, huligan, karyerowicz, drab, zbir.",
                                "translation": "Which of his circle of pals in Baku would ever have admitted to feeling any kind of patriotism toward Russia, toward the pre-war tsarist regime? He would have been a black-hundredist, a hooligan, a careerist, a ruffian and a thug.",
                                "english": "Which of his circle of pals in Baku would ever have admitted to feeling any kind of patriotism toward Russia, toward the pre-war tsarist regime? He would have been a black-hundredist, a hooligan, a careerist, a ruffian and a thug."
                            }
                        ]
                    },
