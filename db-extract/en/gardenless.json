                        "examples": [
                            {
                                "example_id": "317150ed-4f80-4242-8a72-7e4dfe49e37a",
                                "sense_id": "1b440b69-5cf3-390f-a683-1ba19bf9e481",
                                "text": "I was disgusted the other day, in a prosperous district of the West Riding, where public-spirited men have erected libraries and institutes for the factory hands, to find that even new cottages are still, as a rule, gardenless or with only a tiny patch."
                            },
                            {
                                "example_id": "aab0b685-abf9-4efc-b37d-67aa96334950",
                                "sense_id": "1b440b69-5cf3-390f-a683-1ba19bf9e481",
                                "text": "Predictably, however, developers made a travesty of Cerdà's plans and a concrete orchard of gardenless, fortress-like, six- or seven-storey blocks grew up instead."
                            },
                            {
                                "example_id": "453e093c-bf73-42a8-80d9-3d6a208a7f20",
                                "sense_id": "1b440b69-5cf3-390f-a683-1ba19bf9e481",
                                "text": "I'm talking this morning to Wanda Relphs from the charity, Bleak Midwinter. Wanda, tell us what Bleak Midwinter aims to do for the homeless and gardenless."
                            }
                        ]
