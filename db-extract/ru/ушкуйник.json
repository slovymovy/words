                                        "glosses": [
                                            "A medieval Novgorodian pirate who led a life similar to that of a Viking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f50006-f4a8-440a-86fc-41dc52427ce3",
                                                "sense_id": "b6c478be-851f-3ffa-812b-40ee89389f2e",
                                                "text": "Vasily tells his mother that he wants to travel to Jerusalem because the time has come for him to repent his earlier misdeeds, possibly an allusion to a life of fighting, killing, and robbery as a Viking-like ushkuinik."
                                            }
