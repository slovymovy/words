            "senses": [
                {
                    "sense_id": "a16977b0-ccb5-38de-9bdb-b1a97df7dc4c",
                    "sense_definition": "Foolish, silly, or lacking common sense.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "foolishness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>daft</w> idea to go for a walk in the middle of a thunderstorm.",
                            "target_lang_translations": {
                                "ru": "Это была <w>глупая</w> затея — отправиться на прогулку в самый разгар грозы.",
                                "nl": "Het was een <w>dwaas</w> idee om midden in een onweersbui te gaan wandelen."
                            }
                        },
                        {
                            "text": "Don't be so <w>daft</w>, there is no such thing as ghosts in this old house.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>глупым</w>, в этом старом доме нет никаких привидений.",
                                "nl": "Doe niet zo <w>dwaas</w>, spoken bestaan niet in dit oude huis."
                            }
                        }
                    ],
                    "synonyms": [
                        "silly",
                        "stupid",
                        "foolish",
                        "idiotic",
                        "absurd"
                    ],
                    "antonyms": [
                        "sensible",
                        "wise"
                    ],
                    "common_phrases": [
                        "daft idea",
                        "don't be daft"
                    ],
                    "traits": [
                        {
