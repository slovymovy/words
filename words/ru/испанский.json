    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd1bcee3-2118-315e-90f0-f67bb1ec7312",
                    "sense_definition": "Относящийся к Испании, испанцам или их языку.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "отношение к Испании",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я изучаю <w>испанский</w> язык в университете.",
                            "target_lang_translations": {
                                "nl": "Ik studeer <w>Spaans</w> aan de universiteit."
                            }
                        },
                        {
                            "text": "Мы посетили много <w>испанских</w> городов во время отпуска.",
                            "target_lang_translations": {
                                "nl": "We hebben tijdens de vakantie veel <w>Spaanse</w> steden bezocht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "испанский язык",
                        "испанский город"
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op Spanje, de Spanjaarden of hun taal."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Spaans",
                                "target_lang_sense_clarification": "algemeen bijvoeglijk naamwoord met betrekking tot Spanje of de taal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "447e006e-2b81-3572-b779-746424c25521",
                    "sense_definition": "Свойственный испанцам, характерный для них или для Испании.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "отношение к Испании",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему очень нравится <w>испанский</w> темперамент.",
                            "target_lang_translations": {
                                "nl": "Hij houdt erg van het <w>Spaanse</w> temperament."
                            }
                        },
                        {
                            "text": "Это был типичный <w>испанский</w> танец с гитарой.",
                            "target_lang_translations": {
                                "nl": "Dat was een typische <w>Spaanse</w> dans met gitaar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "испанский темперамент"
                    ],
                    "target_lang_definitions": {
