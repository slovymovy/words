                "senses": [
                    {
                        "sense_id": "27539f33-e519-3b67-89b6-f3356538ebfe",
                        "entry_id": "cabb8f01-39ae-38b4-adc7-46e71b258b82",
                        "glosses": [
                            "to rest (against), to set (against)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3457919-61e9-40c9-8fc6-6ec68e992b1a",
                                "sense_id": "27539f33-e519-3b67-89b6-f3356538ebfe",
                                "text": "упира́ться ло́ктем в стену",
                                "translation": "to set one's elbow against the wall, lean one's elbow against the wall",
                                "english": "to set one's elbow against the wall, lean one's elbow against the wall"
                            },
                            {
                                "example_id": "13fbd050-e30b-4763-9bf5-78d03859963c",
                                "sense_id": "27539f33-e519-3b67-89b6-f3356538ebfe",
                                "text": "упира́ться нога́ми в зе́млю",
                                "translation": "to take a firm stand, dig one's heels in the ground",
                                "english": "to take a firm stand, dig one's heels in the ground"
                            },
                            {
                                "example_id": "82e7e202-d753-4828-9908-887233ad81cc",
                                "sense_id": "27539f33-e519-3b67-89b6-f3356538ebfe",
                                "text": "упира́ться глаза́ми",
                                "translation": "stare",
                                "english": "stare"
                            },
                            {
                                "example_id": "df70d43e-c3a2-470f-ba58-8f73e905b9e1",
                                "sense_id": "27539f33-e519-3b67-89b6-f3356538ebfe",
                                "text": "упира́ться ро́гом, упира́ться рука́ми и нога́ми",
                                "translation": "be dead set (against), run one's head (against)",
                                "english": "be dead set (against), run one's head (against)"
                            }
                        ]
                    },
                    {
                        "sense_id": "9e90e56f-3fde-30ea-95fa-43c5547956d7",
                        "entry_id": "cabb8f01-39ae-38b4-adc7-46e71b258b82",
                        "glosses": [
                            "to jib, to balk, to refuse"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "96e4d1fe-7cfe-3d83-8656-c07577c4f3f3",
                        "entry_id": "cabb8f01-39ae-38b4-adc7-46e71b258b82",
                        "glosses": [
                            "to be hampered, to be held back, to hinge (on)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf75560-ca15-4f11-8eb2-45764875fa0e",
                                "sense_id": "96e4d1fe-7cfe-3d83-8656-c07577c4f3f3",
                                "text": "реше́ние вопро́са упира́ется в недоста́ток вре́мени",
                                "translation": "progress on the issue is being hampered by the lack of time",
                                "english": "progress on the issue is being hampered by the lack of time"
                            },
                            {
                                "example_id": "92eb30e2-0694-4912-9229-88596f5e8848",
                                "sense_id": "96e4d1fe-7cfe-3d83-8656-c07577c4f3f3",
                                "text": "всё упира́ется в реше́ние нача́льника",
                                "translation": "everything hinges on the boss's decision",
                                "english": "everything hinges on the boss's decision"
                            }
                        ]
