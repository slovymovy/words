                "senses": [
                    {
                        "sense_id": "5296b58d-0a37-3b50-951b-72a94e9d520f",
                        "entry_id": "5360d7b7-dbe6-3d46-b9a6-61848715cdba",
                        "glosses": [
                            "Femme française d’origine maghrébine."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ca2082da-047a-43c3-b056-9c2d3a4f466a",
                                "sense_id": "5296b58d-0a37-3b50-951b-72a94e9d520f",
                                "text": "En tout cas, l’accession d’une beurette au sommet de l’État n’a pas modifié en profondeur la façon souvent caricaturale dont est perçue la « deuxième génération » dans le débat politique."
                            },
                            {
                                "example_id": "2f32b379-ef47-488c-82d3-fd2e282badad",
                                "sense_id": "5296b58d-0a37-3b50-951b-72a94e9d520f",
                                "text": "Rachida Dati représenterait la version classique : une beurette travailleuse, ayant gravi une à une les marches de la méritocratie, essayant successivement la chaussure de vair de comptable, puis de magistrate et enfin de ministre."
                            },
                            {
                                "example_id": "ae4aabb2-dc96-491f-b568-75ae37e32678",
                                "sense_id": "5296b58d-0a37-3b50-951b-72a94e9d520f",
                                "text": "Des « beurettes » photographiées avec leur accord pour un sujet sur les banlieues ont découvert leur portrait illustrant un article sur les femmes arabes qui se font refaire une virginité avant le mariage."
                            }
                        ]
                    }
