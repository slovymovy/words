                        "sense_id": "6dbad416-6ca1-3f51-9ead-8b2355220231",
                        "entry_id": "c468a97e-6fb1-3bc7-b9fe-646a22d88c63",
                        "glosses": [
                            "die Hebamme, die Geburtshelferin"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "9ca87dcc-c49b-4bb5-9c1a-97830c4ec0e0",
                                "sense_id": "6dbad416-6ca1-3f51-9ead-8b2355220231",
                                "text": "Die Obstetrix ist eine Frau, „die u.a. auch die werdenden Mütter berät und die Pflege von Wöchnerin und Kind übernimmt.“"
                            },
                            {
                                "example_id": "882e0f2d-afdc-4e1a-bb38-873e9941b33c",
                                "sense_id": "6dbad416-6ca1-3f51-9ead-8b2355220231",
                                "text": "„Obstetrix, eine Hebamme, Wehe-Mutter, ist eine Kunsterfahrne Frau, welche denen Weibern in der Schwangerschafft, und sonderlich bey der Geburt hilfft und an die Hand gehet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
