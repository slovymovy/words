{
    "word_family": [
        "homogénéité",
        "homogénéiser",
        "homogénéisation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e057ec65-1bab-39fe-8fd7-a53d60081906",
                    "sense_definition": "Qualifie une matière ou un mélange dont la composition est uniforme et dont les composants ne peuvent être distingués.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut remuer la pâte jusqu'à obtenir une texture parfaitement <w>homogène</w>."
                        },
                        {
                            "text": "Le lait entier vendu en bouteille est un mélange <w>homogène</w> préparé avec soin."
                        }
                    ],
                    "synonyms": [
                        "uniforme"
                    ],
                    "antonyms": [
                        "hétérogène"
                    ],
                    "common_phrases": [
                        "mélange homogène",
                        "pâte homogène"
                    ]
                },
                {
                    "sense_id": "283d223c-264d-3540-bae0-8367957d5bf7",
                    "sense_definition": "Dont les éléments sont semblables, formant un ensemble cohérent et uni.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ensemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette classe constitue un groupe <w>homogène</w> où tous les élèves progressent au même rythme."
                        },
                        {
                            "text": "L'entraîneur a sélectionné une équipe <w>homogène</w> pour affronter les champions en titre."
                        }
                    ],
                    "synonyms": [
                        "uni",
                        "cohérent"
                    ],
                    "antonyms": [
                        "hétérogène"
                    ],
                    "common_phrases": [
                        "groupe homogène",
                        "équipe homogène"
                    ]
                },
                {
                    "sense_id": "b18bc6bc-bc65-3a8f-99e6-b555e7676ffb",
                    "sense_definition": "Qualifie une répartition ou une distribution régulière et uniforme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "repartition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éclairage de la salle assure une répartition <w>homogène</w> de la lumière sur les bureaux."
                        },
                        {
                            "text": "Les experts recommandent une distribution <w>homogène</w> de la chaleur dans toute la maison."
                        }
                    ],
                    "synonyms": [
                        "régulier",
                        "uniforme"
                    ],
                    "antonyms": [
                        "hétérogène",
                        "inhomogène"
                    ],
                    "common_phrases": [
                        "répartition homogène",
                        "distribution homogène"
                    ]
                },
                {
                    "sense_id": "f3a8d66b-4a9e-3a83-b0ab-f6830ee13512",
                    "sense_definition": "Qualifie un bois dont la structure et les cernes de croissance sont très réguliers et peu distincts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tilleul est un bois <w>homogène</w> particulièrement apprécié des artisans pour la sculpture."
                        },
                        {
                            "text": "Les ébénistes recherchent des essences au grain <w>homogène</w> pour fabriquer des meubles soignés."
                        }
                    ],
                    "antonyms": [
                        "hétérogène"
                    ],
                    "common_phrases": [
                        "bois homogène"
                    ]
                }
            ]
        }
    ]
