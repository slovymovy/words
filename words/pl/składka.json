    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00cf09c4-f69c-321f-8ad6-695ea0404c48",
                    "sense_definition": "obowiązkowa lub regularna opłata wynikająca z członkostwa w organizacji lub z tytułu ubezpieczenia",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdy pracownik musi co miesiąc płacić odpowiednią <w>składkę</w> na ubezpieczenie zdrowotne.",
                            "target_lang_translations": {
                                "ru": "Каждый работник обязан ежемесячно выплачивать соответствующий <w>взнос</w> на медицинское страхование."
                            }
                        },
                        {
                            "text": "Roczna <w>składka</w> członkowska w naszym klubie sportowym wynosi sto złotych.",
                            "target_lang_translations": {
                                "ru": "Годовой членский <w>взнос</w> в нашем спортивном клубе составляет сто злотых."
                            }
                        }
                    ],
                    "common_phrases": [
                        "składka członkowska",
                        "składka ubezpieczeniowa",
                        "składka na ubezpieczenie",
                        "płacić składkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обязательный или регулярный платеж, вытекающий из членства в организации или по условиям страхования"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взнос",
                                "target_lang_sense_clarification": "членский или страховой платеж"
                            },
                            {
                                "target_lang_word": "отчисление",
                                "target_lang_sense_clarification": "регулярный страховой или пенсионный платеж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3fa8bd6-0386-3c07-9dce-ee9f22ea3b9d",
                    "sense_definition": "wspólne zbieranie pieniędzy przez grupę osób na określony cel",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zorganizowaliśmy w biurze <w>składkę</w> na prezent urodzinowy dla naszej koleżanki.",
                            "target_lang_translations": {
                                "ru": "Мы организовали в офисе <w>складчину</w> на подарок ко дню рождения нашей коллеги."
                            }
                        },
                        {
                            "text": "Uczniowie chętnie wzięli udział w <w>składce</w> na pomoc dla schroniska.",
                            "target_lang_translations": {
                                "ru": "Ученики охотно приняли участие в <w>сборе средств</w> для приюта."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrzutka",
                        "zbiórka"
                    ],
                    "antonyms": [
                        "sponsoring"
                    ],
                    "common_phrases": [
                        "zrobić składkę",
                        "składka na prezent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совместный сбор денег группой людей на определенную цель"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складчина",
                                "target_lang_sense_clarification": "совместный сбор денег"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "сбор денег"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "789fcb23-6baf-304c-939b-98321975c6e1",
                    "sense_definition": "kwota wpłacana przez jedną osobę w ramach wspólnego pokrywania kosztów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pojedyncza <w>składka</w> wynosiła dwadzieścia złotych od każdego uczestnika spotkania.",
                            "target_lang_translations": {
                                "ru": "Индивидуальный <w>взнос</w> составлял двадцать злотых с каждого участника встречи."
                            }
                        },
                        {
                            "text": "Nie pamiętam dokładnie, ile wynosiła nasza <w>składka</w> na ten wspólny wyjazd.",
                            "target_lang_translations": {
                                "ru": "Я точно не помню, сколько составляла наша <w>доля</w> на эту совместную поездку."
                            }
                        }
                    ],
                    "synonyms": [
                        "udział"
                    ],
                    "common_phrases": [
                        "wysokość składki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма, вносимая одним человеком в рамках совместного покрытия расходов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "сумма при складчине"
                            },
                            {
                                "target_lang_word": "взнос",
                                "target_lang_sense_clarification": "часть общей суммы с человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0664d26-4026-301a-8272-7b4d6d365400",
                    "sense_definition": "zadrukowany i złożony arkusz papieru stanowiący część składową książki lub czasopisma",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "poligrafia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dziale introligatorskim poszczególne <w>składki</w> są starannie zszywane w jeden blok książki.",
                            "target_lang_translations": {
                                "ru": "В переплетном цехе отдельные <w>тетради</w> аккуратно сшиваются в единый книжный блок."
                            }
                        },
                        {
                            "text": "Introligator zauważył, że jedna <w>składka</w> została omyłkowo wydrukowana do góry nogami.",
                            "target_lang_translations": {
                                "ru": "Переплетчик заметил, что одна <w>тетрадь</w> по ошибке была напечатана вверх ногами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запечатанный и сфальцованный (сложенный) лист бумаги, являющийся частью книги или журнала"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тетрадь",
                                "target_lang_sense_clarification": "в полиграфии и переплетном деле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}