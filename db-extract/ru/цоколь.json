                                        "examples": [
                                            {
                                                "example_id": "2a79e3a1-2a28-4371-b8b6-1aca8f32eaf1",
                                                "sense_id": "5f022a10-d574-31e7-88c3-574f0e788b95",
                                                "text": "Het beeld werd op een sokkel geplaatst."
                                            },
                                            {
                                                "example_id": "3434dc9d-0c39-4ebd-9bf6-97c448c22225",
                                                "sense_id": "5f022a10-d574-31e7-88c3-574f0e788b95",
                                                "text": "Midden op het plein staat een monument van blauw brons, een man in poolkleding op een vierkante sokkel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
