                "senses": [
                    {
                        "sense_id": "86e08c3f-141e-3dc8-ab63-1d23b41cd01a",
                        "entry_id": "7b989ac0-cd3b-3f0b-97e4-f09608f3f716",
                        "glosses": [
                            "Temporiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42755a36-d9b7-47e8-9fc6-d39c72a37a8b",
                                "sense_id": "86e08c3f-141e-3dc8-ab63-1d23b41cd01a",
                                "text": "On peut retemporiser l'additionneur séquentiel → introduction de bascules, pipelinage."
                            },
                            {
                                "example_id": "f10e8806-e1a3-4ab6-af85-1629ebfb4de9",
                                "sense_id": "86e08c3f-141e-3dc8-ab63-1d23b41cd01a",
                                "text": "Disons que \"faire un dessin animé\" si court soit il implique un énorme boulot en amont. Mais énorme de chez énorme : scénariser, découper plan par plan, temporiser, tout dessiner, tout coloriser, puis retemporiser avec le son, finaliser..."
                            },
                            {
                                "example_id": "94043ab5-c690-41fc-9dc6-50ea428d2b82",
                                "sense_id": "86e08c3f-141e-3dc8-ab63-1d23b41cd01a",
                                "text": "Pull à la Adhaize: détourner, temporiser, retemporiser pour laisser bien écouler les 20 secondes du détournement, puis puller et mourir dignement"
                            }
                        ]
                    }
