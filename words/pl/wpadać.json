{
    "word_family": [
        "wpadka",
        "wpadnięcie",
        "wpadkowy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2438c01e-9d65-39fe-8666-709a0f4a103e",
                    "sense_definition": "przemieszczać się do wnętrza czegoś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po mocnym uderzeniu bila <w>wpada</w> prosto do łozy.",
                            "target_lang_translations": {
                                "en": "After a hard hit, the ball <w>falls</w> straight into the pocket."
                            }
                        },
                        {
                            "text": "Piłka <w>wpada</w> do bramki po celnym strzale.",
                            "target_lang_translations": {
                                "en": "The ball <w>falls</w> into the goal after an accurate shot."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wpadać do wody",
                        "wpadać do środka"
                    ],
                    "target_lang_definitions": {
                        "en": "To move into the interior of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall into",
                                "target_lang_sense_clarification": "To move into a space or container, often due to gravity or force."
                            },
                            {
                                "target_lang_word": "drop into",
                                "target_lang_sense_clarification": "To descend or be placed into a specific area or container."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18435024-4ae3-33bb-ba89-4cb5edea636d",
                    "sense_definition": "przychodzić z nieformalną, krótką wizytą",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wizyta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Często <w>wpada</w> do mnie na kawę po pracy.",
                            "target_lang_translations": {
                                "en": "He often <w>drops in</w> for coffee after work."
                            }
                        },
                        {
                            "text": "Muszę <w>wpadać</w> do babci częściej, bo zawsze się cieszy.",
                            "target_lang_translations": {
                                "en": "I need to <w>drop in</w> on my grandmother more often because she is always happy."
                            }
                        }
                    ],
                    "synonyms": [
                        "odwiedzać"
                    ],
                    "common_phrases": [
                        "wpadać na kawę",
                        "wpadać z wizytą"
                    ],
                    "target_lang_definitions": {
                        "en": "To pay a short, informal visit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drop in",
                                "target_lang_sense_clarification": "To visit someone casually without an appointment."
                            },
                            {
                                "target_lang_word": "pop in",
                                "target_lang_sense_clarification": "To make a quick, informal visit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bafede9d-0def-393a-bc41-545fd9e58b93",
                    "sense_definition": "spotykać kogoś niespodziewanie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spotkanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj <w>wpadałem</w> na kolegę w sklepie.",
                            "target_lang_translations": {
                                "en": "Yesterday I <w>ran into</w> a friend at the store."
                            }
                        },
                        {
                            "text": "Często <w>wpada</w> na dyrektora na korytarzu.",
                            "target_lang_translations": {
                                "en": "He often <w>runs into</w> the director in the hallway."
                            }
                        }
                    ],
                    "synonyms": [
                        "natykać się"
                    ],
                    "common_phrases": [
                        "wpadać na kogoś"
                    ],
                    "target_lang_definitions": {
                        "en": "To meet someone unexpectedly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run into",
                                "target_lang_sense_clarification": "To meet someone by chance."
                            },
                            {
                                "target_lang_word": "bump into",
                                "target_lang_sense_clarification": "To encounter someone unexpectedly."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cefa297-5835-3cfe-b916-7fe8595b03a6",
                    "sense_definition": "ulegać nagłemu działaniu silnych emocji lub stanów",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ojciec <w>wpada</w> w złość, gdy widzi bałagan.",
                            "target_lang_translations": {
                                "en": "My father <w>falls</w> into a rage when he sees a mess."
                            }
                        },
                        {
                            "text": "Nie <w>wpadaj</w> w panikę, wszystko będzie dobrze.",
                            "target_lang_translations": {
                                "en": "Don't <w>fall</w> into a panic, everything will be fine."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wpadać w złość",
                        "wpadać w panikę"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly experience strong emotions or states."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall into",
                                "target_lang_sense_clarification": "To enter a state or condition, often negative (e.g., panic, despair)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebaac499-a5e1-370e-bc23-da098c158ef7",
                    "sense_definition": "popadać w kłopotliwą sytuację lub problem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "problemy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przez swoją naiwność Jacek wiecznie <w>wpada</w> w tarapaty.",
                            "target_lang_translations": {
                                "en": "Because of his naivety, Jacek is always <w>falling</w> into trouble."
                            }
                        },
                        {
                            "text": "Ludzie często <w>wpadają</w> w długi przez nieprzemyślane zakupy.",
                            "target_lang_translations": {
                                "en": "People often <w>fall</w> into debt through impulsive shopping."
                            }
                        }
                    ],
                    "synonyms": [
                        "popadać"
                    ],
                    "common_phrases": [
                        "wpadać w tarapaty",
                        "wpadać w długi"
                    ],
                    "target_lang_definitions": {
                        "en": "To get into a difficult situation or problem."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get into",
                                "target_lang_sense_clarification": "To become involved in a difficult or problematic situation."
                            },
                            {
                                "target_lang_word": "fall into",
                                "target_lang_sense_clarification": "To become trapped in a negative state like debt or trouble."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b68e3ef-d053-3ba6-9267-89a3f4e92d35",
                    "sense_definition": "nagle na coś wpaść, wymyślić coś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "myślenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nagle <w>wpadłem</w> na świetny pomysł rozwiązania tego zadania.",
                            "target_lang_translations": {
                                "en": "I suddenly <w>hit on</w> a great idea for solving this task."
                            }
                        },
                        {
                            "text": "Długo myślałem, aż w końcu <w>wpadłem</w> na odpowiedź.",
                            "target_lang_translations": {
                                "en": "I thought for a long time until I finally <w>hit on</w> the answer."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymyślać"
                    ],
                    "common_phrases": [
                        "wpadać na pomysł"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly think of something or come up with an idea."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come up with",
                                "target_lang_sense_clarification": "To produce an idea or solution."
                            },
                            {
                                "target_lang_word": "hit on",
                                "target_lang_sense_clarification": "To suddenly have a good idea."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cacc1121-772f-3827-854a-4dfb1ab3e5ab",
                    "sense_definition": "zostać przyłapanym na czymś zabronionym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodzieje <w>wpadają</w> podczas próby kradzieży.",
                            "target_lang_translations": {
                                "en": "Thieves <w>get caught</w> during an attempted robbery."
                            }
                        },
                        {
                            "text": "W końcu <w>wpadł</w> na oszustwie podatkowym.",
                            "target_lang_translations": {
                                "en": "He finally <w>got caught</w> for tax fraud."
                            }
                        }
                    ],
                    "synonyms": [
                        "zostać złapanym"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w kontekście przestępczym"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be caught doing something forbidden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get caught",
                                "target_lang_sense_clarification": "To be discovered while doing something wrong."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a39fe53f-f1d2-38eb-9713-95d2e3fdcd4d",
                    "sense_definition": "mieć odcień lub domieszkę innego koloru",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kolory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten brąz na ścianie <w>wpada</w> lekko w czerwień.",
                            "target_lang_translations": {
                                "en": "That brown on the wall <w>leans</w> slightly towards red."
                            }
                        },
                        {
                            "text": "Sukienka ma kolor, który <w>wpada</w> w fiolet.",
                            "target_lang_translations": {
                                "en": "The dress has a color that <w>leans</w> towards purple."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wpadać w odcień"
                    ],
                    "target_lang_definitions": {
                        "en": "To have a slight shade or hint of another color."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lean towards",
                                "target_lang_sense_clarification": "To have a tendency or slight quality of a specific color."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c508dfa-13cf-3aec-9024-8ae73f56c721",
                    "sense_definition": "o rzece: wpływać do większego zbiornika wodnego",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geografia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wisła <w>wpada</w> do Morza Bałtyckiego.",
                            "target_lang_translations": {
                                "en": "The Vistula <w>flows</w> into the Baltic Sea."
                            }
                        },
                        {
                            "text": "Ten strumień <w>wpada</w> do jeziora w dolinie.",
                            "target_lang_translations": {
                                "en": "This stream <w>flows</w> into the lake in the valley."
                            }
                        }
                    ],
                    "synonyms": [
                        "wpływać"
                    ],
                    "target_lang_definitions": {
                        "en": "Of a river: to flow into a larger body of water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flow into",
                                "target_lang_sense_clarification": "To move as a river into a larger body of water."
                            },
                            {
                                "target_lang_word": "empty into",
                                "target_lang_sense_clarification": "To discharge water into a larger body."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}