                                                "example_id": "f68a119a-b00e-4e0c-ab13-1703819eca99",
                                                "sense_id": "7274f29d-4d61-3b11-858c-b5ba71fb8e49",
                                                "text": "I have no objection to any person's religion."
                                            },
                                            {
                                                "example_id": "6ac8a749-28cd-408c-acfa-d30e007e450d",
                                                "sense_id": "7274f29d-4d61-3b11-858c-b5ba71fb8e49",
                                                "text": "There are millions of Jews living in this country, who have known no other home than America, many of whom have strong objections to racism–and who vote, in a supermajority, for the Democratic Party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bde781-270c-38ac-b7d8-5c18ea96f283",
                                        "entry_id": "9ec5984d-c4f1-3ea0-bcb3-d7504243bf64",
                                        "glosses": [
                                            "An official protest raised in a court of law during a legal trial over a violation of the rules of the court by the opposing party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8798a856-2415-4482-9df4-82a0b1738542",
                                                "sense_id": "95bde781-270c-38ac-b7d8-5c18ea96f283",
                                                "text": "Counsel for the property owner immediately raised an objection which was sustained following argument outside the presence of the jury."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "objection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e524ec9-f2dd-3518-91d9-588c85ecd1d0",
                                        "entry_id": "82393ceb-0fad-35f8-9ab5-7d4a36e357e1",
                                        "glosses": [
                                            "An assertion that a question or statement is in violation of the rules of the court."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ce6ae8-3c32-45a3-9265-36676127220d",
                                                "sense_id": "2e524ec9-f2dd-3518-91d9-588c85ecd1d0",
                                                "text": "Objection! That is irrelevant to this case, Your Honor!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
