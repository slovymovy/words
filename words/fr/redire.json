            "senses": [
                {
                    "sense_id": "033d8900-e672-3e41-85ef-7d3662827ce2",
                    "sense_definition": "Répéter ou exprimer une nouvelle fois ce que l'on a déjà dit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne vais pas te le <w>redire</w> une deuxième fois, commence tes devoirs maintenant."
                        },
                        {
                            "text": "Le professeur <w>redit</w> patiemment la consigne pour les élèves distraits."
                        }
                    ],
                    "synonyms": [
                        "répéter",
                        "réitérer"
                    ],
                    "common_phrases": [
                        "redire la même chose"
                    ]
                },
                {
                    "sense_id": "1982990f-18fb-39c7-8faf-a1045d5405ba",
                    "sense_definition": "Critiquer, blâmer ou trouver un défaut, presque exclusivement employé dans la tournure « trouver à redire ».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le travail a été parfaitement exécuté et personne n'a trouvé à <w>redire</w>."
                        },
                        {
                            "text": "Il n'y a absolument rien à <w>redire</w> sur la qualité irréprochable de ce repas."
                        }
                    ],
                    "synonyms": [
                        "blâmer",
                        "critiquer",
                        "reprocher"
                    ],
                    "antonyms": [
                        "approuver",
                        "louer"
                    ],
                    "common_phrases": [
