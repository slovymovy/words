        "fr-extract.jsonl": [
            {
                "entry_id": "574d17d0-a26c-3ab8-98a6-97b2623fd8e5",
                "word": "mâtin",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7526baa5-a7c0-3d48-8d05-fa78cb044d36",
                        "entry_id": "574d17d0-a26c-3ab8-98a6-97b2623fd8e5",
                        "glosses": [
                            "Exprime la surprise, l’étonnement parfois teinté d’admiration."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8bc4c776-c2a1-4625-b463-9057fb50846d",
                                "sense_id": "7526baa5-a7c0-3d48-8d05-fa78cb044d36",
                                "text": "Ribadier. — Mâtin ! Mais c’est une flotte !… Trois cent soixante-cinq !… Autant qu’il y a de jours dans l’année !"
                            },
                            {
                                "example_id": "44318afa-96e2-456b-a5ec-bda4a63bcdc9",
                                "sense_id": "7526baa5-a7c0-3d48-8d05-fa78cb044d36",
                                "text": "« Tu verras tes cousines, elles sont jolies. »\nOui, elles le sont, et comme elles ont l’air déluré, mâtin !"
                            },
                            {
                                "example_id": "048194be-54a0-4cb6-9924-8bdc26752807",
                                "sense_id": "7526baa5-a7c0-3d48-8d05-fa78cb044d36",
                                "text": "Mâtin ! qu’il faisait froid cette année-là !"
                            },
                            {
                                "example_id": "a4f4ab4e-9274-42ec-9c48-a00cf9e02e59",
                                "sense_id": "7526baa5-a7c0-3d48-8d05-fa78cb044d36",
                                "text": "– Mâtin, la belle meurtrière !…"
                            },
                            {
                                "example_id": "a7b155f3-6b5e-453d-b787-0569da96319e",
                                "sense_id": "7526baa5-a7c0-3d48-8d05-fa78cb044d36",
                                "text": "— Il n'y a pas trop de bobo et la plaie est bien propre.\n— On l'a lavée au whisky.\n— Mâtin ! C'est ça que vous faites avec votre whisky. Moi, je le bois."
                            },
                            {
                                "example_id": "c6a6bdf7-9b2b-43e3-8e2a-569ac999ce3b",
                                "sense_id": "7526baa5-a7c0-3d48-8d05-fa78cb044d36",
                                "text": "Pilote. Mâtin, quel journal !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "22d3c9ab-4091-3f93-82d2-36b49642af38",
                "word": "mâtin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "958c194f-6e4d-4caf-ba3c-736582785024",
                        "entry_id": "22d3c9ab-4091-3f93-82d2-36b49642af38",
                        "tags": [
                            "plural"
                        ],
                        "form": "mâtins"
                    },
                    {
                        "form_id": "0dd30512-4a87-4523-9dd7-93001035ee0b",
                        "entry_id": "22d3c9ab-4091-3f93-82d2-36b49642af38",
                        "tags": [
                            "une femelle ou une femme"
                        ],
                        "form": "mâtine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1bb237f6-b333-3150-9fa5-1629ec95fcf9",
                        "entry_id": "22d3c9ab-4091-3f93-82d2-36b49642af38",
                        "glosses": [
                            "Gros chien de garde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a86c0e3-fdb3-4b95-a862-27a067dc636a",
                                "sense_id": "1bb237f6-b333-3150-9fa5-1629ec95fcf9",
                                "text": "Le bruit de cette chute souleva une tempête de jappements féroces parmi tous les dogues, mâtins et molosses qui faisaient ripaille à la ronde."
                            },
                            {
                                "example_id": "21f14ad4-fcf1-4be3-a054-2849a67a2ecc",
                                "sense_id": "1bb237f6-b333-3150-9fa5-1629ec95fcf9",
                                "text": "Des mâtins de Tartarie, presque aussi hauts que des ânes, couleur de feu, l’échine large et le jarret droit, étaient destinés à poursuivre les aurochs."
                            },
                            {
                                "example_id": "1c811ee9-2f4a-4c77-bd40-b7d2a4d36330",
                                "sense_id": "1bb237f6-b333-3150-9fa5-1629ec95fcf9",
                                "text": "Des chiens aboyèrent à l’entrée de la Creuse. On eût dit que tous les mâtins du village s’étaient donné rendez-vous, faisant sonner leur large coup de gueule, et, quand ils se taisaient, on entendait le grondement rageur des petits roquets, qui ne décoléraient pas."
                            },
                            {
                                "example_id": "4ef996e4-959d-4652-b9a5-584ba92ea248",
                                "sense_id": "1bb237f6-b333-3150-9fa5-1629ec95fcf9",
                                "text": "Contre sa jambe trottinait son chien « Lirot », un fort mâtin à museau aigu, à poil d’hyène, hérissé de piquants noirs de l’échine au panache."
                            },
                            {
                                "example_id": "857cd308-8b1e-4069-b8c1-bf5acec19d45",
                                "sense_id": "1bb237f6-b333-3150-9fa5-1629ec95fcf9",
                                "text": "Pourtant je me demande à quoi elles me seront bonnes, si le mâtin est de taille ! »."
                            },
                            {
                                "example_id": "cc549f1b-6c45-4e0d-b9c4-9014f50b714e",
                                "sense_id": "1bb237f6-b333-3150-9fa5-1629ec95fcf9",
                                "text": "Le matin était de taille à se défendre hardiment"
                            }
                        ]
                    },
                    {
                        "sense_id": "bd5c5a83-f0c6-33ef-9f21-e8d0de004d99",
                        "entry_id": "22d3c9ab-4091-3f93-82d2-36b49642af38",
                        "glosses": [
                            "Personne désagréable et grossière, qu'on assimile à un chien de garde."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "96f06042-4f02-45dd-85cb-307fb452687a",
                                "sense_id": "bd5c5a83-f0c6-33ef-9f21-e8d0de004d99",
                                "text": "– Sacré lâche, lui dit à voix basse le soldat, tâche au moins de marcher ferme devant ces mâtins d’Allemands, afin de sauver l’honneur de la République."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a4e5bbe-75c3-3746-a552-eb4aa1a7b392",
                        "entry_id": "22d3c9ab-4091-3f93-82d2-36b49642af38",
                        "glosses": [
                            "Personne ou animal qui a fait preuve de malice ou de hardiesse."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f2978834-cf2d-4199-94b6-37b277f5df4e",
                                "sense_id": "5a4e5bbe-75c3-3746-a552-eb4aa1a7b392",
                                "text": "Paris, Paris !… Oh ! ces têtes folles de jeunes gens !… Mais veux-tu me dire, sacré mâtin, ce que tu as fait de bon à Paris ?…"
                            },
                            {
                                "example_id": "db0e64ab-6f22-447d-bbef-432909eb6680",
                                "sense_id": "5a4e5bbe-75c3-3746-a552-eb4aa1a7b392",
                                "text": "Mais qu’a-t-il donc tant pour lui, ce grand mâtin de vieux baron ? reprit-il."
                            },
                            {
                                "example_id": "967c1093-699a-4612-b01c-cb4eb5f878a8",
                                "sense_id": "5a4e5bbe-75c3-3746-a552-eb4aa1a7b392",
                                "text": "« Est-il bête, avec tout son esprit, ce mâtin-là ! » se disait-il parfois en découvrant silencieusement dans un rire muet les trente-deux « dominos » de sa mâchoire."
                            },
                            {
                                "example_id": "bfa9b783-6ead-42e7-9d51-ea9960e65aa3",
                                "sense_id": "5a4e5bbe-75c3-3746-a552-eb4aa1a7b392",
                                "text": "À la promenade, chaque fois qu’il apercevait un oiseau sur une branche, s’il n’avait pas son fusil, il le visait avec sa canne et ne manquait jamais de dire : « Pan ! il y était, le mâtin ! » ou bien : « Pan ! je l’aurais raté, pour sûr, c’est trop loin. » Ce sont les seules réflexions que lui aient jamais inspirées les oiseaux."
                            },
                            {
                                "example_id": "f9381301-f221-4b7f-9d42-61d40ca248dd",
                                "sense_id": "5a4e5bbe-75c3-3746-a552-eb4aa1a7b392",
                                "text": "DE GUICHE Par exemple ! Et lequel ? CYRANO Je vous le donne en cent !...\nDE GUICHE C'est que ce mâtin-là devient intéressant !"
                            },
                            {
                                "example_id": "3f6e35af-a31e-4a6c-84ad-1a79f7e3cf54",
                                "sense_id": "5a4e5bbe-75c3-3746-a552-eb4aa1a7b392",
                                "text": "Et le capitaine Faillard, qui avait été décoré dans la campagne de Russie, levait son chapeau chaque fois qu’il parlait du Kremlin, que ces mâtins de Russes avaient allumé comme un punch ! « Des crânes ! ces Kaiserlicks », disait-il en tordant sa moustache."
                            },
                            {
                                "example_id": "bc906e55-9f5a-4815-97d2-d8ea3bc13dd4",
                                "sense_id": "5a4e5bbe-75c3-3746-a552-eb4aa1a7b392",
                                "text": "Il adressait à Pierre des clignements d’yeux complices : sacré mâtin, il n’avait pas dû s’embêter en faisant la route."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbed880f-f47b-3de8-883a-00428544b982",
                        "entry_id": "22d3c9ab-4091-3f93-82d2-36b49642af38",
                        "glosses": [
                            "Enfant turbulent."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7260f4fa-53ba-493c-9d49-abdd399df28c",
                                "sense_id": "bbed880f-f47b-3de8-883a-00428544b982",
                                "text": "Alors mon petit mâtin, à dix ans, battait tout le monde et s’amusait à couper le cou aux poules, il éventrait les cochons, enfin il se roulait dans le sang comme une fouine. — « Ce sera un fameux soldat ! disait Cambremer, il a goût au sang. »"
                            },
                            {
                                "example_id": "dea8fbca-5e51-473d-ada1-0bc09d9fd397",
                                "sense_id": "bbed880f-f47b-3de8-883a-00428544b982",
                                "text": "Il en pleure de douleur, le pauvre mâtin, il se prive de tout, exprès, quand il soupe le soir, et boit avec une paille."
                            }
                        ]
                    }
                ],
