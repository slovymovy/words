                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e427baa-2b3a-4bd9-af70-063c6e0a9d1a",
                        "source_entry_id": "662213fc-60fb-317d-a7e0-b69183ed30bb",
                        "source_sense_id": "f9bf1e07-51f0-31f8-a6ec-44a0552e3c45",
                        "target_lang_word": "sweetness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sweetness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07ae1cdc-7eb4-3847-9101-25567ee51503",
                                        "entry_id": "7fca62f8-1813-305e-9031-7c93b9604f0d",
                                        "glosses": [
                                            "The condition of being sweet (all senses)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a33b1db-3bae-4f07-a3a9-a5b76b5ef2cb",
                                                "sense_id": "07ae1cdc-7eb4-3847-9101-25567ee51503",
                                                "text": "At the same time, that pain is soothed by the brain’s perception of sweetness on a totally different area of your taste buds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e13a7d5d-055f-3859-83ae-14ca5b5450fa",
                                        "entry_id": "7fca62f8-1813-305e-9031-7c93b9604f0d",
                                        "glosses": [
                                            "A pleasant disposition; kindness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44687d25-04ea-46f8-881f-5392b4a506f9",
                                                "sense_id": "e13a7d5d-055f-3859-83ae-14ca5b5450fa",
                                                "text": "Ruth's overwhelming sweetness made Robert forget about his hopelessly low school grades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5294ec1f-68fe-3419-8dd6-db0deef5a2f6",
                                        "entry_id": "7fca62f8-1813-305e-9031-7c93b9604f0d",
                                        "glosses": [
                                            "The quality of giving pleasure to the mind or senses, pleasantness, agreeableness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de912810-d17f-4b66-b619-e469207b8288",
                                                "sense_id": "5294ec1f-68fe-3419-8dd6-db0deef5a2f6",
                                                "text": "The thirſt of raigne and ſweetnes of a crowne, […] / Moou’d me to menage armes againſt thy ſtate."
                                            },
                                            {
                                                "example_id": "fa6ea26f-8a55-489a-8d27-ceb72f92ef35",
                                                "sense_id": "5294ec1f-68fe-3419-8dd6-db0deef5a2f6",
                                                "text": "Quiet people too, for I think that about this time a sort of remorseful tenderness comes over the bullies and the nagsters, so that they go about gently and deprecatingly, hoping by one day's record sweetness to outface the year's blusterings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68094988-4d92-3a2e-8e54-3bfb40020850",
                                        "entry_id": "7fca62f8-1813-305e-9031-7c93b9604f0d",
                                        "glosses": [
                                            "A term of address for one's sweetheart."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b708bfbd-9dd6-482f-b9d3-b74d67b0c30a",
                                                "sense_id": "68094988-4d92-3a2e-8e54-3bfb40020850",
                                                "text": "Sweetness, sweetness, I was only joking when I said / I'd like to smash every tooth in your head."
                                            },
                                            {
                                                "example_id": "8e5608d0-d774-4e66-a0cb-fe6c10ba2ae5",
                                                "sense_id": "68094988-4d92-3a2e-8e54-3bfb40020850",
                                                "text": "\"Hey sweetness,\" he said. \"How was practice?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68de5baf-2fb7-4c0e-aa1a-56e0b47e4ba0",
                        "source_entry_id": "662213fc-60fb-317d-a7e0-b69183ed30bb",
                        "source_sense_id": "f9bf1e07-51f0-31f8-a6ec-44a0552e3c45",
                        "target_lang_word": "kindness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                        "entry_id": "c96eba70-ee76-3630-a286-7398193bcd26",
                                        "glosses": [
                                            "The state of being kind."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b64ef6-5462-418a-8af6-4e71ad930cc9",
                                                "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                                "text": "Jamie's kindness is legendary, so much that people have taken advantage of her."
                                            },
                                            {
                                                "example_id": "f9b2b7d7-ef5b-47b7-8b3a-7ef7986e4d5d",
                                                "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                                "text": "If attending to your childhood wounds and responding with kindness feels selfish, it is important to remember that compassion for oneself often makes people more compassionate to others, Lev said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                        "entry_id": "c96eba70-ee76-3630-a286-7398193bcd26",
                                        "glosses": [
                                            "An instance of kind or charitable behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c828946f-6ab7-4e60-84b3-67ae6975cb42",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "How can I thank you for your many kindnesses?"
                                            },
                                            {
                                                "example_id": "891af2e3-a28b-4c81-bd15-09d0a1fe2f68",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "Do me a kindness and leave."
                                            },
                                            {
                                                "example_id": "bb3885f8-fea5-4449-a2bf-a24340da0ca8",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "i'm going to turn a blind eye to this misdemeanour, out of the kindness of my heart."
                                            },
                                            {
                                                "example_id": "f61e6fa4-502f-4f9e-8b88-d09025a0a72e",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "They are grateful for kindnesses that they may have received."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
