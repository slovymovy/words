                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b67517d9-6e76-441f-88f9-5913b1270fc1",
                        "source_entry_id": "68f63d34-a522-3ca4-aecc-7ecdbdfe3451",
                        "source_sense_description": "Héraldique",
                        "target_lang_word": "conjoined",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjoined",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c3351fc-da0c-3825-9ff4-066b00c90843",
                                        "entry_id": "1ef93a86-1f9b-3a47-9b11-5c984ebe3740",
                                        "glosses": [
                                            "Of persons (conjoined twins) or things: joined together physically."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "630ee347-988f-4efe-877c-cc8c8fdf7cd3",
                                                "sense_id": "3c3351fc-da0c-3825-9ff4-066b00c90843",
                                                "text": "1580s, Ovid, Elegia VI, Book I, translated by Christopher Marlowe, in Christopher Marlowe: The Complete Poems and Translations, Stephen Orgel (ed.), Penguin, 1971, p. 110,\nAnd farewell cruel posts, rough threshold's block, / And doors conjoined with an hard iron lock!"
                                            },
                                            {
                                                "example_id": "4483d5fd-ddb3-4a4c-8dbe-af8994b00b12",
                                                "sense_id": "3c3351fc-da0c-3825-9ff4-066b00c90843",
                                                "text": "Now envy and antipathy, passions irreconcilable in reason, nevertheless in fact may spring conjoined like Chang and Eng in one birth."
                                            },
                                            {
                                                "example_id": "ebf8e1e4-207c-43ed-b711-0da694380249",
                                                "sense_id": "3c3351fc-da0c-3825-9ff4-066b00c90843",
                                                "text": "Blood vessels are fused to increase circulation and these conjoined or grafted veins and arteries make great painful lumps which have to be soaked daily."
                                            },
                                            {
                                                "example_id": "8299bcc7-f569-4ec4-afff-31f524eb09a0",
                                                "sense_id": "3c3351fc-da0c-3825-9ff4-066b00c90843",
                                                "text": "These 'signatures' (in Arabic ‘alāmāt; singular, ‘alāma) typically consisted of a phrase of up to half a dozen conjoined words written as a monogram in which the reed pen usually maintained contact with the parchment throughout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19313a41-82f3-3f90-9b7d-e10924080c40",
                                        "entry_id": "1ef93a86-1f9b-3a47-9b11-5c984ebe3740",
                                        "glosses": [
                                            "Joined or bound together; united (in a relationship)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a751df-6ede-4159-ae1d-4f5602fe1b7f",
                                                "sense_id": "19313a41-82f3-3f90-9b7d-e10924080c40",
                                                "text": "If either of you know any inward impediment why you ſhould not be conioyned, I charge you on your ſoules to vtter it."
                                            },
                                            {
                                                "example_id": "5870ca8b-6ab4-4b80-b0fa-f839dbae17ff",
                                                "sense_id": "19313a41-82f3-3f90-9b7d-e10924080c40",
                                                "text": "O my lord / The glory of whose new state is hidden from us, / Pray for us of your charity; now in the sight of God / Conjoined with all the saints and martyrs gone before you, / Remember us."
                                            },
                                            {
                                                "example_id": "6df1893b-175d-4606-ad9e-0f94db5d66eb",
                                                "sense_id": "19313a41-82f3-3f90-9b7d-e10924080c40",
                                                "text": "But as representatives of a loosely conjoined nation split in a hundred ways by personal, tribal, religious and economic rivalries and jealousies, no two of them went to the conference agreed on what independence should mean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f36d1fd2-0d45-3c15-9aec-354c91ca45b9",
                                        "entry_id": "1ef93a86-1f9b-3a47-9b11-5c984ebe3740",
                                        "glosses": [
                                            "Combined."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323bb775-406f-4207-9df0-e352c1302da0",
                                                "sense_id": "f36d1fd2-0d45-3c15-9aec-354c91ca45b9",
                                                "text": "Their garb and stillness conjoined, present an uniformity, tranquil and herd-like—as in the pasture—\"forty feeding like one.\""
                                            },
                                            {
                                                "example_id": "cafdfe5c-5b26-4c4f-871e-e639932e52c2",
                                                "sense_id": "f36d1fd2-0d45-3c15-9aec-354c91ca45b9",
                                                "text": "I have seen another woman who, from taste and necessity conjoined, has gone into practical affairs, carries on a mechanical business, partly works at it herself, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
