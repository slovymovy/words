                            }
                        },
                        {
                            "text": "De kinderen spelen <w>ginder</w> op het veld terwijl wij hier wachten.",
                            "target_lang_translations": {
                                "en": "The children are playing <w>yonder</w> on the field while we wait here."
                            }
