                        "glosses": [
                            "Divination par l’inspection de la combustion des offrandes."
                        ],
                        "tags": [
                            "Pseudo-sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "87428acc-26b0-42cd-9d35-fabe8c10160c",
                                "sense_id": "ad7df42f-58fe-3f3d-b723-cbe17fae0f1c",
                                "text": "L’empyromancie a été cultivée par tous les peuples de l’antiquité ; les observations avaient surtout pour objet la couleur, le grésillement, les changements de forme et accessoirement l’éclat de la flamme."
                            },
                            {
                                "example_id": "082b3177-d33a-4761-9ef5-0d4d8591e30c",
                                "sense_id": "ad7df42f-58fe-3f3d-b723-cbe17fae0f1c",
                                "text": "On rencontre l’empyromancie pratiquée en grand autour des cratères des volcans ou des crevasses ouvertes dans le sol par des vapeurs enflammées."
                            }
                        ]
                    }
