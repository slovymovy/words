                                            {
                                                "example_id": "3ceabf86-e33e-4a7e-806e-ec4a19b6ce17",
                                                "sense_id": "5622ad78-5fce-3b2b-aac1-6c096aeb06ea",
                                                "text": "Der Jäger kaufte sich eine doppelläufige Schrotflinte."
                                            },
                                            {
                                                "example_id": "602413bd-911c-4b5c-9fc7-c6de487bbe8e",
                                                "sense_id": "5622ad78-5fce-3b2b-aac1-6c096aeb06ea",
                                                "text": "„Eine doppelläufige Flinte erhöhe die Sicherheit, so der US-Vizepräsident, ein Sturmgewehr sei aber nicht nötig.“"
