                {
                    "sense_id": "eba3ece8-256b-345b-925e-e0e42e4b8067",
                    "sense_definition": "Taki, który ma dobry humor, często się śmieje i jest optymistycznie nastawiony do życia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "happiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat jest bardzo <w>wesołym</w> człowiekiem i wszyscy go lubią.",
                            "target_lang_translations": {
                                "ru": "Мой брат — очень <w>весёлый</w> человек, и все его любят.",
                                "de": "Mein Bruder ist ein sehr <w>fröhlicher</w> Mensch und alle mögen ihn."
                            }
                        },
                        {
                            "text": "Mimo zmęczenia po pracy, Marek był <w>wesoły</w> i chętnie z nami rozmawiał.",
                            "target_lang_translations": {
                                "ru": "Несмотря на усталость после работы, Марек был <w>весёлым</w> и охотно с нами разговаривал.",
                                "de": "Trotz der Müdigkeit nach der Arbeit war Marek <w>fröhlich</w> und unterhielt sich gerne mit uns."
                            }
                        }
                    ],
                    "synonyms": [
                        "radosny",
                        "pogodny."
                    ],
                    "antonyms": [
                        "smutny",
                        "ponury",
                        "zmartwiony",
                        "niewesoły"
                    ],
                    "common_phrases": [
                        "wesoły człowiek",
                        "wesoła mina"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто в хорошем настроении, часто смеется и оптимистично относится к жизни.",
                        "de": "Jemand, der gute Laune hat, oft lacht und dem Leben gegenüber optimistisch eingestellt ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весёлый",
                                "target_lang_sense_clarification": "о человеке или настроении"
                            },
                            {
                                "target_lang_word": "жизнерадостный",
                                "target_lang_sense_clarification": "полный жизни и оптимизма"
                            }
                        ],
