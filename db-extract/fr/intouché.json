                "senses": [
                    {
                        "sense_id": "9e034af4-5856-38db-9fce-a4c2288ae321",
                        "entry_id": "f1d3e282-f1e0-3fc9-a191-66ab8ff06f5a",
                        "glosses": [
                            "Qui n'a pas été touché, qui n'a subi aucune atteinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6be6bd3a-3307-4eee-9fc2-903e2bf90f57",
                                "sense_id": "9e034af4-5856-38db-9fce-a4c2288ae321",
                                "text": "Un écosystème intouché."
                            },
                            {
                                "example_id": "e0531684-baa7-4323-8076-aab58e7eb773",
                                "sense_id": "9e034af4-5856-38db-9fce-a4c2288ae321",
                                "text": "Il savait très bien que son université avait pour principe fondamental le Système de l’Honneur (on ne triche pas, on passait les examens sans surveillance et l’on pouvait laisser ses livres, ses vêtements sur n’importe quel coin du campus, on les retrouvait plus tard, intouchés)."
                            },
                            {
                                "example_id": "f47b8231-153f-4819-b43b-7f3eb26b450f",
                                "sense_id": "9e034af4-5856-38db-9fce-a4c2288ae321",
                                "text": "Et je jouis, médiocrement sans doute, de me savoir intouché par le jus quand je barbote dans 1 autre, à mariner quelque scène terrifique : 1 femme masquée faisant irruption 1 batteur de cuisine à la main qu’elle jette dans l’eau pour m’électrocuter !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b47b7f3-3b70-4739-9dfb-50f7fefc205f",
                        "source_entry_id": "f1d3e282-f1e0-3fc9-a191-66ab8ff06f5a",
                        "source_sense_id": "9e034af4-5856-38db-9fce-a4c2288ae321",
                        "source_sense_description": "taxinomie — biologie",
                        "target_lang_word": "untouched",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untouched",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb6005a3-58d7-3084-ae76-0002d46624a6",
                                        "entry_id": "98e5bedc-275e-3afd-8524-ba143110d047",
                                        "glosses": [
                                            "Remaining in its original, pristine state, undamaged; not altered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc23993d-99d8-4f8d-a043-668002a15ef0",
                                                "sense_id": "eb6005a3-58d7-3084-ae76-0002d46624a6",
                                                "text": "There are practically no untouched forests left in Europe."
                                            },
                                            {
                                                "example_id": "d63b7d86-7bc6-478c-9f3c-68a6f77a32b2",
                                                "sense_id": "eb6005a3-58d7-3084-ae76-0002d46624a6",
                                                "text": "The altars used for magical purposes were of carved wood or, if made of stone, had to be a natural slab, unhewn and untouched by hammer or chisel."
                                            },
                                            {
                                                "example_id": "0230da2e-ad85-4334-b2b4-219f7c112b9b",
                                                "sense_id": "eb6005a3-58d7-3084-ae76-0002d46624a6",
                                                "text": "Most of the Himalayan rivers have been relatively untouched by dams near their sources. Now the two great Asian powers, India and China, are rushing to harness them as they cut through some of the world's deepest valleys."
                                            },
                                            {
                                                "example_id": "5c0fbafd-77f3-4d45-9a30-f26b60c074e3",
                                                "sense_id": "eb6005a3-58d7-3084-ae76-0002d46624a6",
                                                "text": "HS2 Ltd has continued to refine the designs, so that seven fewer ancient woodlands will be affected. This reduces the total number to 25. And of those 25 woodlands, 85% of the total area will remain untouched by HS2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f976c7b-d446-3877-b46b-e2ea203ede16",
                                        "entry_id": "98e5bedc-275e-3afd-8524-ba143110d047",
                                        "glosses": [
                                            "Not eaten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ba3bab-ace1-42d5-b338-3dc881ffe889",
                                                "sense_id": "9f976c7b-d446-3877-b46b-e2ea203ede16",
                                                "text": "He left his vegetables untouched."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "307c06e9-c0cc-3e07-8960-56aaa448b95f",
                                        "entry_id": "98e5bedc-275e-3afd-8524-ba143110d047",
                                        "glosses": [
                                            "Not influenced, affected or swayed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d2da09-6c20-4fc8-b447-863155e6e5e9",
                                                "sense_id": "307c06e9-c0cc-3e07-8960-56aaa448b95f",
                                                "text": "She was untouched by his tale of woes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c12d1f-d0f5-331f-a01a-d3d91a6ad540",
                                        "entry_id": "98e5bedc-275e-3afd-8524-ba143110d047",
                                        "glosses": [
                                            "Not having come in contact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef628da5-7936-4da2-a75d-4b1665fb9cee",
                                                "sense_id": "21c12d1f-d0f5-331f-a01a-d3d91a6ad540",
                                                "text": "Our chocolates are untouched by human hands."
                                            },
                                            {
                                                "example_id": "166d6d3c-cbce-4003-9e55-ea6cf3d7f1da",
                                                "sense_id": "21c12d1f-d0f5-331f-a01a-d3d91a6ad540",
                                                "text": "Once the tough job is done for Prosser, he says he can then get his golf clubs back out - they have been in the cupboard untouched for a decade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ee19642-db29-3410-82c2-a7504f00b2a8",
                                        "entry_id": "98e5bedc-275e-3afd-8524-ba143110d047",
                                        "glosses": [
                                            "Not read or examined."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff87b56f-27b0-429b-8c12-b554edb1f90b",
                                                "sense_id": "3ee19642-db29-3410-82c2-a7504f00b2a8",
                                                "text": "He was about to open one of the scrolls, when Francesca took them from his hand. \"Nay, Guido, we will not read them: there are some letters never meant but for one eye, and such are these. This packet shall be given untouched into Lord Avonleigh's\"—she corrected her words—\"into my father's own hands.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f882fb-b9ef-3133-a084-12f6fdbc8453",
                                        "entry_id": "98e5bedc-275e-3afd-8524-ba143110d047",
                                        "glosses": [
                                            "Not discussed or talked about."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90974050-d442-48fa-a2a0-24e90e27b1f9",
                                                "sense_id": "39f882fb-b9ef-3133-a084-12f6fdbc8453",
                                                "text": "Politics was an untouched topic in our family."
                                            }
                                        ]
                                    }
                                ]
                            },
