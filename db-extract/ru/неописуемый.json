                ],
                "senses": [
                    {
                        "sense_id": "d75d1dc7-dbb8-3c52-a028-0bee39c5bab9",
                        "entry_id": "bd04a37d-ccb2-3056-9d07-2d36e555e92e",
                        "glosses": [
                            "такой, что его трудно, невозможно описать, передать словами; непередаваемый, невыразимый"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "deadcf3e-c4fc-3619-a509-5727ca9f3256",
                        "entry_id": "bd04a37d-ccb2-3056-9d07-2d36e555e92e",
                        "glosses": [
                            "перен. чрезмерный по силе проявления; очень сильный, чрезвычайный, невообразимый"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7017f548-cda3-44ec-a3c8-78d0bb8503bd",
                        "source_entry_id": "bd04a37d-ccb2-3056-9d07-2d36e555e92e",
                        "source_sense_description": "не поддающийся описанию словами",
                        "target_lang_word": "ineffable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ineffable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b682843-1166-36fa-b252-18f8203e6d1b",
                                        "entry_id": "28dc487f-2b42-340d-b719-9c7fa553c285",
                                        "glosses": [
                                            "Beyond expression in words; unspeakable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1776c6a6-d45f-415e-b15f-d06f61991fe8",
                                                "sense_id": "9b682843-1166-36fa-b252-18f8203e6d1b",
                                                "text": "Devotion bids aspire to nobler things, to boundless love, and joys ineffable: and such her expectation from kind Heav'n."
                                            },
                                            {
                                                "example_id": "c2a67c76-1ba8-4756-a289-7b01a478e245",
                                                "sense_id": "9b682843-1166-36fa-b252-18f8203e6d1b",
                                                "text": "Stroeve was trying to express a feeling which he had never known before, and he did not know how to put it into common terms. He was like the mystic seeking to describe the ineffable."
                                            },
                                            {
                                                "example_id": "57fe9c52-707f-48a9-b427-7faa7c525aea",
                                                "sense_id": "9b682843-1166-36fa-b252-18f8203e6d1b",
                                                "text": "God does not play dice with the universe; He plays an ineffable game of his own devising, which might be compared, from the perspective of any of the other players, to being involved in an obscure and complex version of poker in a pitch dark room, with blank cards, for infinite stakes, with a dealer who won't tell you the rules, and who smiles all the time."
                                            },
                                            {
                                                "example_id": "d5c6d2d4-0b03-44c0-8262-aea227f7d777",
                                                "sense_id": "9b682843-1166-36fa-b252-18f8203e6d1b",
                                                "text": "As Alan Watts (1961) wrote, it involves trying to speak the unspeakable, scrute the inscrutable and eff the ineffable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b193066-a272-3460-ab87-e0736a46983c",
                                        "entry_id": "28dc487f-2b42-340d-b719-9c7fa553c285",
                                        "glosses": [
                                            "Forbidden to be uttered; taboo."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80c0dec3-ea82-4886-9474-8aa01990a545",
                        "source_entry_id": "bd04a37d-ccb2-3056-9d07-2d36e555e92e",
                        "source_sense_description": "не поддающийся описанию словами",
                        "target_lang_word": "indescribable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indescribable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3ca83f-4bb6-3844-9f08-311cbfdfd24b",
                                        "entry_id": "caa1fcdb-acf9-3e12-9a8d-ed7671d4c937",
                                        "glosses": [
                                            "Impossible (or very difficult) to describe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fcb5258-42fb-461c-b4f7-7e4bb2a8166d",
                                                "sense_id": "7e3ca83f-4bb6-3844-9f08-311cbfdfd24b",
                                                "text": "He proved it with indescribable mathematics."
                                            },
                                            {
                                                "example_id": "cfd49ab5-9a09-41a9-a2ce-909644fa0360",
                                                "sense_id": "7e3ca83f-4bb6-3844-9f08-311cbfdfd24b",
                                                "text": "Presently the men set up the melancholy little chant that I had heard on the first night when we were captured in the whaleboat, and the effect produced by their voices was very curious, and quite indescribable."
                                            },
                                            {
                                                "example_id": "da6fec10-d5be-427f-9d0b-f56425fc1ada",
                                                "sense_id": "7e3ca83f-4bb6-3844-9f08-311cbfdfd24b",
                                                "text": "But there was also about him an indescribable air which no mechanic could have acquired in the practice of his handicraft however dishonestly exercised: [...] the air of moral nihilism common to keepers of gambling hells and disorderly houses; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c46774b0-1fc8-3492-b0cb-f4328ea740e4",
                                        "entry_id": "caa1fcdb-acf9-3e12-9a8d-ed7671d4c937",
                                        "glosses": [
                                            "Exceeding all description."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0139d94e-2250-4964-ad6d-1aaab2f596b8",
                                                "sense_id": "c46774b0-1fc8-3492-b0cb-f4328ea740e4",
                                                "text": "Our hotel had an indescribable view of the Bay of Naples."
                                            },
                                            {
                                                "example_id": "8ff1d9c1-3839-4c1f-8087-f4272ad39645",
                                                "sense_id": "c46774b0-1fc8-3492-b0cb-f4328ea740e4",
                                                "text": "The time was when, had such an idea entered her mind, it would have been torture indescribable and agony the most intense; but then, subdued as was the usual warmth of her temperament, an awful suspension seemed to hold her feelings in control."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
