                        {
                            "text": "The <w>sum</w> and substance of his argument is that we should wait.",
                            "target_lang_translations": {
                                "ru": "<w>Суть</w> его аргумента сводится к тому, что нам следует подождать.",
                                "zh": "他论点的<w>要点</w>在于我们应该等待。"
                            }
                        }
                    ],
                    "synonyms": [
                        "essence",
                        "gist",
                        "substance",
                        "core",
                        "summary"
                    ],
                    "common_phrases": [
