                    },
                    {
                        "sense_id": "5f6fb4eb-3b63-30bb-ab6a-1e933556c91b",
                        "entry_id": "63a62a8b-5431-37d4-a269-308c6eb26760",
                        "glosses": [
                            "Taxe ou redevance payée autrefois, pour avoir l'eau dans les prés, les jardins, pour l'irrigation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e859006-cbd3-4552-94c6-f049336ee101",
                                "sense_id": "5f6fb4eb-3b63-30bb-ab6a-1e933556c91b",
                                "text": "Droit d’arrosage concédé à perpétuité à la commune."
                            }
                        ]
                    },
                    {
                        "sense_id": "3db0349c-c009-393d-8245-4f94dd92268a",
