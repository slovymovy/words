                                "target_senses": [
                                    {
                                        "sense_id": "6c6e1bf9-95ac-3cfc-a3c4-02e8608f086c",
                                        "entry_id": "9d88595d-6ab9-33a5-b2ba-7014960603c9",
                                        "glosses": [
                                            "erotische Beziehung eines Mannes zu einem männlichen Kind oder Jugendlichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9f8df88-d5b5-4bdd-9384-ecd1983b0321",
                                                "sense_id": "6c6e1bf9-95ac-3cfc-a3c4-02e8608f086c",
                                                "text": "„An Schen stammte aus Hangdschou und neigte zur Knabenliebe.“"
                                            },
                                            {
                                                "example_id": "486cbee2-ffcf-4c86-a34b-878d7c817fff",
                                                "sense_id": "6c6e1bf9-95ac-3cfc-a3c4-02e8608f086c",
                                                "text": "„Aus dem gleichen Grunde triumphiert dort die Knabenliebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bfbe50d-8727-4048-a0e8-965fa65cee6e",
                        "source_entry_id": "03ee35e5-f456-33c5-a95a-4a598dd4ee5f",
                        "target_lang_word": "Päderastie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Päderastie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                                        "entry_id": "25a8e98d-ea66-3b1d-bb6f-67f7eebf0fc6",
                                        "glosses": [
                                            "„homosexuelle Neigungen, Beziehungen zu Jungen“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9b2ad2-8a78-4a5f-b44e-6deb07ef3969",
                                                "sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                                                "text": "„Päderastie und Homosexualität waren bei den Griechen keineswegs verboten, sondern wurden höher bewertet als die normale Heterosexualität.“"
                                            },
                                            {
                                                "example_id": "ac4a0edf-8d53-46a3-b7c1-822f8f935374",
                                                "sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                                                "text": "„Rom, die heilige Stadt, die gleichwohl durch diese Anordnung das ganze Menschengeschlecht zur Päderastie zwingt, will es weder zugeben, noch eine Illusion für möglich halten, die sie mit allen Mitteln im Geist der Theaterbesucher erzeugt.“"
                                            },
                                            {
                                                "example_id": "2d839d87-9517-4a2e-ae5d-0d10e6cd4cae",
                                                "sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                                                "text": "„Sade war mit allen Formen des Eros vertraut; Neugier, der echt französische Trieb zur Systematik, Überdruß an der normalen Befriedigung, Haß gegen die sentimentale Belastung und Herausforderung hatten beträchtlichen Anteil an seiner Wendung zur Päderastie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
