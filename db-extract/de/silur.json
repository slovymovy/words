                "senses": [
                    {
                        "sense_id": "21382ca7-a489-3b5c-927d-2c0ee6ecbdf7",
                        "entry_id": "0b8ba209-3c33-36c6-b273-c6c95bfb107c",
                        "glosses": [
                            "die dritte Formation des Paläozoikums oder Erdaltertums von etwa 416 bis 444 Millionen Jahren, die zwischen dem Ordovizium und dem Devon liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19d4791e-07ee-4624-bfe0-6e2ca0a4012a",
                                "sense_id": "21382ca7-a489-3b5c-927d-2c0ee6ecbdf7",
                                "text": "„Die Fauna des Silurs umfaßt schon über 10000 uns noch fremde Arten, darunter die ersten Ammoniten und Krebse … die ersten Insekten und Fische, Seelilien, Korallen, Spinnentiere …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
