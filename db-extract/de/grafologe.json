                        "examples": [
                            {
                                "example_id": "eee67460-593f-493c-9e7a-4c4b3ea88a16",
                                "sense_id": "6e55b4a6-3bc9-36e1-93e0-8b62b62b9a45",
                                "text": "„Hermann Adler zieht nach Prag, arbeitet als Grafologe für die böhmische Credit- und Escomptebank, trifft den Exilanten Ossip Kalenter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
