                "senses": [
                    {
                        "sense_id": "f1ec8de9-218d-3eef-9dfb-101ef2153556",
                        "entry_id": "33efce84-d9fa-324c-abee-4ca6454d6e4f",
                        "glosses": [
                            "Ausscheidung des Darms eines Pferdes"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bfef1e9d-fc9c-433e-a0e5-0586fbc7d292",
                                "sense_id": "f1ec8de9-218d-3eef-9dfb-101ef2153556",
                                "text": "Vorsicht! Nicht, dass du in die Pferdeäpfel hineintrittst."
                            },
                            {
                                "example_id": "e9a25c01-2c29-42fc-ab9f-d81989825859",
                                "sense_id": "f1ec8de9-218d-3eef-9dfb-101ef2153556",
                                "text": "„Ein Pförtner mit einem Blechschild an der Mütze kehrte Pferdeäpfel auf.“"
                            },
                            {
                                "example_id": "56b8825d-afcd-4004-bf32-e33d46cb8a5c",
                                "sense_id": "f1ec8de9-218d-3eef-9dfb-101ef2153556",
                                "text": "„Ein Helfer fegte die Pferdeäpfel weg.“"
                            },
                            {
                                "example_id": "d63e168c-290b-450d-ae63-b8af586a5d0b",
                                "sense_id": "f1ec8de9-218d-3eef-9dfb-101ef2153556",
                                "text": "„Die Pferdeäpfel waren gelb und pelzig.“"
                            },
                            {
                                "example_id": "bf42e806-9291-4b9d-aa63-6c5764a4f917",
                                "sense_id": "f1ec8de9-218d-3eef-9dfb-101ef2153556",
                                "text": "„In diesem Augenblick benimmt sich das Pferd unprogrammgemäß und läßt einige Pferdeäpfel fallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
