{
    "word_family": [
        "beweeglijk",
        "beweeglijkheid",
        "onbeweeglijkheid",
        "beweging",
        "bewegen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba2f1cf2-3568-398a-a58e-f019b14048a0",
                    "sense_definition": "zonder enige beweging te maken of te vertonen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stilstaand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogel bleef minutenlang <w>onbeweeglijk</w> op de tak zitten.",
                            "target_lang_translations": {
                                "en": "The bird sat <w>motionless</w> on the branch for minutes."
                            }
                        },
                        {
                            "text": "Hij stond <w>onbeweeglijk</w> stil toen hij het vreemde geluid hoorde.",
                            "target_lang_translations": {
                                "en": "He stood <w>perfectly still</w> when he heard the strange noise."
                            }
                        }
                    ],
                    "synonyms": [
                        "statisch"
                    ],
                    "antonyms": [
                        "beweeglijk"
                    ],
                    "common_phrases": [
                        "onbeweeglijk stil staan",
                        "onbeweeglijk blijven zitten"
                    ],
                    "target_lang_definitions": {
                        "en": "without making or showing any movement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "motionless",
                                "target_lang_sense_clarification": "completely still"
                            },
                            {
                                "target_lang_word": "still",
                                "target_lang_sense_clarification": "not moving"
                            },
                            {
                                "target_lang_word": "immobile",
                                "target_lang_sense_clarification": "unable to move or not moving"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e228fef6-21f9-38cf-98ea-1039787e2353",
                    "sense_definition": "onmogelijk om van zijn plaats te krijgen of te veranderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vastzittend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat daar is <w>onbeweeglijk</w> en massief ijzer dat niemand kan tillen.",
                            "target_lang_translations": {
                                "en": "That over there is <w>immovable</w> and solid iron that no one can lift."
                            }
                        },
                        {
                            "text": "De grote rotsblokken bleven <w>onbeweeglijk</w> liggen ondanks de harde wind.",
                            "target_lang_translations": {
                                "en": "The large boulders remained <w>stationary</w> despite the strong wind."
                            }
                        }
                    ],
                    "antonyms": [
                        "beweeglijk"
                    ],
                    "common_phrases": [
                        "onbeweeglijk en massief"
                    ],
                    "target_lang_definitions": {
                        "en": "impossible to move from its place or to change"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immovable",
                                "target_lang_sense_clarification": "fixed in place"
                            },
                            {
                                "target_lang_word": "fixed",
                                "target_lang_sense_clarification": "attached firmly"
                            },
                            {
                                "target_lang_word": "stationary",
                                "target_lang_sense_clarification": "not intended to be moved"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecc3695c-c7b0-3724-8ae9-2166eb3034eb",
                    "sense_definition": "vastberaden en niet te beïnvloeden door anderen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn standpunt in deze politieke kwestie bleek volkomen <w>onbeweeglijk</w>.",
                            "target_lang_translations": {
                                "en": "His position on this political issue proved to be completely <w>unwavering</w>."
                            }
                        },
                        {
                            "text": "Zij hield vast aan haar principes met een <w>onbeweeglijk</w> geloof in de goede afloop.",
                            "target_lang_translations": {
                                "en": "She stuck to her principles with a <w>steadfast</w> belief in a good outcome."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een onbeweeglijk geloof"
                    ],
                    "target_lang_definitions": {
                        "en": "determined and not to be influenced by others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unwavering",
                                "target_lang_sense_clarification": "steady and firm"
                            },
                            {
                                "target_lang_word": "immovable",
                                "target_lang_sense_clarification": "steadfast in purpose"
                            },
                            {
                                "target_lang_word": "unyielding",
                                "target_lang_sense_clarification": "not giving way to pressure"
                            },
                            {
                                "target_lang_word": "steadfast",
                                "target_lang_sense_clarification": "resolute"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}