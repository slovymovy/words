{
    "word_family": [
        "digger",
        "digging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96344610-285a-3b37-bd68-cb8fde3a0f16",
                    "sense_definition": "To break up and move earth, sand, or snow using a tool, machine, or hands, often to make a hole.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "earth_excavation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog went into the garden to <w>dig</w> a hole for its bone.",
                            "target_lang_translations": {
                                "ru": "Собака пошла в сад <w>копать</w> яму для своей кости.",
                                "zh": "狗跑到花园里去<w>挖</w>了一个坑来埋它的骨头。"
                            }
                        },
                        {
                            "text": "Workers had to <w>dig</w> deep into the ground to lay the new pipes.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>копать</w> глубоко в землю, чтобы проложить новые трубы.",
                                "zh": "工人们必须向地下深处<w>挖掘</w>以铺设新管道。"
                            }
                        }
                    ],
                    "antonyms": [
                        "fill",
                        "bury"
                    ],
                    "common_phrases": [
                        "dig a hole",
                        "dig up",
                        "dig deep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрыхлять и перемещать землю, песок или снег с помощью инструментов, машин или рук, часто для создания ямы.",
                        "zh": "使用工具、机器或手来挖掘或移动泥土、沙子或雪，通常是为了挖出一个坑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копать",
                                "target_lang_sense_clarification": "разрыхлять землю"
                            },
                            {
                                "target_lang_word": "рыть",
                                "target_lang_sense_clarification": "делать углубление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖",
                                "target_lang_sense_clarification": "挖掘泥土"
                            },
                            {
                                "target_lang_word": "掘",
                                "target_lang_sense_clarification": "挖掘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "579fe78f-03b7-383f-aba1-80302ae82bec",
                    "sense_definition": "To search thoroughly or investigate to find information or objects.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reporters started to <w>dig</w> for more details about the scandal.",
                            "target_lang_translations": {
                                "ru": "Репортеры начали <w>копать</w>, чтобы узнать больше подробностей о скандале.",
                                "zh": "记者们开始<w>挖掘</w>关于这起丑闻的更多细节。"
                            }
                        },
                        {
                            "text": "If you <w>dig</w> deep enough, you will find the truth about what happened.",
                            "target_lang_translations": {
                                "ru": "Если <w>копнуть</w> достаточно глубоко, вы узнаете правду о том, что произошло.",
                                "zh": "如果你<w>深究</w>得足够深，你就会发现事情的真相。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dig for",
                        "dig up facts",
                        "dig deeper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно искать или расследовать с целью найти информацию или предметы.",
                        "zh": "彻底搜寻或调查以获取信息或发现事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копать",
                                "target_lang_sense_clarification": "искать информацию"
                            },
                            {
                                "target_lang_word": "докапываться",
                                "target_lang_sense_clarification": "выяснять истину"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖掘",
                                "target_lang_sense_clarification": "深入探究信息"
                            },
                            {
                                "target_lang_word": "深究",
                                "target_lang_sense_clarification": "深入调查"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb266dc-672a-3933-9701-80fad8c3935b",
                    "sense_definition": "To push or poke something sharply into someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_thrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy straps of the backpack began to <w>dig</w> into her shoulders.",
                            "target_lang_translations": {
                                "ru": "Тяжелые лямки рюкзака начали <w>врезаться</w> ей в плечи.",
                                "zh": "沉重的背包带开始<w>陷入</w>她的肩膀里。"
                            }
                        },
                        {
                            "text": "He <w>dug</w> his elbow into my side to get my attention.",
                            "target_lang_translations": {
                                "ru": "Он <w>ткнул</w> меня локтем в бок, чтобы привлечь мое внимание.",
                                "zh": "他用肘部<w>戳</w>了我的侧身以引起我的注意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jab"
                    ],
                    "common_phrases": [
                        "dig into",
                        "dig in heels"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко толкать или тыкать чем-то в кого-то или что-то; сильно давить.",
                        "zh": "用力推或戳某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врезаться",
                                "target_lang_sense_clarification": "о лямках, веревках"
                            },
                            {
                                "target_lang_word": "тыкать",
                                "target_lang_sense_clarification": "толкать острым предметом или локтем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陷入",
                                "target_lang_sense_clarification": "指物体压入身体"
                            },
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "用尖锐物或肘部推挤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e37127e-5747-38a5-8698-03d814cac645",
                    "sense_definition": "To like, appreciate, or understand something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_appreciate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really <w>dig</w> your new style; it looks great on you.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>тащусь</w> от твоего нового стиля; он тебе очень идет.",
                                "zh": "我真的很<w>喜欢</w>你的新风格，你穿起来很好看。"
                            }
                        },
                        {
                            "text": "He tried to explain the plan, but I just didn't <w>dig</w> what he was saying.",
                            "target_lang_translations": {
                                "ru": "Он пытался объяснить план, но я просто не <w>врубался</w> в то, что он говорил.",
                                "zh": "他试图解释这个计划，但我就是没<w>明白</w>他在说什么。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dig it",
                        "can you dig it"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in 1960s-70s, still used informally"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нравиться, ценить или понимать что-либо (сленг).",
                        "zh": "喜欢、欣赏或理解某事（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тащиться",
                                "target_lang_sense_clarification": "очень нравиться"
                            },
                            {
                                "target_lang_word": "врубаться",
                                "target_lang_sense_clarification": "понимать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喜欢",
                                "target_lang_sense_clarification": "欣赏"
                            },
                            {
                                "target_lang_word": "明白",
                                "target_lang_sense_clarification": "理解"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "38a77bb6-2c7c-38a8-a0b8-e24bfe79c873",
                    "sense_definition": "An organized excavation site where archaeologists look for ancient objects.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "earth_excavation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students spent their summer volunteering at a Roman <w>dig</w> in Italy.",
                            "target_lang_translations": {
                                "ru": "Студенты провели лето волонтерами на римских <w>раскопках</w> в Италии.",
                                "zh": "学生们在意大利的一个罗马<w>考古现场</w>度过了他们的暑假志愿者生活。"
                            }
                        },
                        {
                            "text": "Artifacts found at the <w>dig</w> provided new insights into the ancient civilization.",
                            "target_lang_translations": {
                                "ru": "Артефакты, найденные на <w>раскопках</w>, дали новое представление о древней цивилизации.",
                                "zh": "在<w>发掘</w>现场发现的文物为研究古代文明提供了新的见解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excavation"
                    ],
                    "common_phrases": [
                        "archaeological dig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованное место раскопок, где археологи ищут древние предметы.",
                        "zh": "考古学家寻找古代物品的有组织的挖掘现场。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскопки",
                                "target_lang_sense_clarification": "археологические"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发掘",
                                "target_lang_sense_clarification": "考古挖掘"
                            },
                            {
                                "target_lang_word": "考古现场",
                                "target_lang_sense_clarification": "挖掘地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7d9c146-0ce3-3be1-bfe9-e47b38a80d05",
                    "sense_definition": "A sarcastic, critical, or mocking remark directed at someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal_criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She couldn't resist making a sly <w>dig</w> at his poor timekeeping.",
                            "target_lang_translations": {
                                "ru": "Она не удержалась от хитрой <w>шпильки</w> по поводу его непунктуальности.",
                                "zh": "她忍不住对他糟糕的时间观念进行了一番<w>挖苦</w>。"
                            }
                        },
                        {
                            "text": "His comment was clearly a <w>dig</w> at the way the company was managed.",
                            "target_lang_translations": {
                                "ru": "Его комментарий был явной <w>насмешкой</w> над тем, как управлялась компания.",
                                "zh": "他的评论显然是对公司管理方式的一种<w>嘲讽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jibe",
                        "jab"
                    ],
                    "common_phrases": [
                        "take a dig at",
                        "have a dig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Саркастическое, критическое или насмешливое замечание в чей-то адрес.",
                        "zh": "针对某人的讽刺、批评或嘲弄的话语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шпилька",
                                "target_lang_sense_clarification": "колкость"
                            },
                            {
                                "target_lang_word": "насмешка",
                                "target_lang_sense_clarification": "издевка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖苦",
                                "target_lang_sense_clarification": "讽刺的话"
                            },
                            {
                                "target_lang_word": "嘲讽",
                                "target_lang_sense_clarification": "讥讽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeedeee6-db05-3610-ab1e-dcbbe4b73c43",
                    "sense_definition": "A quick thrust or poke, often with an elbow or finger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_thrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave me a painful <w>dig</w> in the ribs to stop me from laughing.",
                            "target_lang_translations": {
                                "ru": "Он дал мне болезненный <w>тычок</w> под ребра, чтобы я перестал смеяться.",
                                "zh": "他用力<w>捅</w>了我的肋骨一下，疼得我止住了笑。"
                            }
                        },
                        {
                            "text": "With a sharp <w>dig</w> of his elbow, he signaled that we should leave.",
                            "target_lang_translations": {
                                "ru": "Резким <w>тычком</w> локтя он подал знак, что нам пора уходить.",
                                "zh": "他用肘部猛地一<w>戳</w>，示意我们该走了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jab"
                    ],
                    "common_phrases": [
                        "dig in the ribs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый толчок или тычок, часто локтем или пальцем.",
                        "zh": "快速的推或戳，通常用肘部或手指。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тычок",
                                "target_lang_sense_clarification": "удар"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "用手指或肘部推"
                            },
                            {
                                "target_lang_word": "捅",
                                "target_lang_sense_clarification": "用力戳"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}