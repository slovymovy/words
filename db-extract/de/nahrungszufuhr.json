                "senses": [
                    {
                        "sense_id": "cd620524-36db-395a-85e9-7b3a160da9fa",
                        "entry_id": "6d49be5d-ace8-34d6-b9ee-19a5e802ee24",
                        "glosses": [
                            "Aufnahme von Nahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d5f452-ba21-4f2e-8e6a-0d277b261685",
                                "sense_id": "cd620524-36db-395a-85e9-7b3a160da9fa",
                                "text": "„Die unregelmäßige Nahrungszufuhr und die heißen Temperaturen in Dhaka, der Hauptstadt von Bangladesh, machen diesem Fastenden zu schaffen.“"
                            },
                            {
                                "example_id": "e03e2678-6c28-45f1-bc51-8d6f2ea4f4f6",
                                "sense_id": "cd620524-36db-395a-85e9-7b3a160da9fa",
                                "text": "„Der Schlüssel für eine gesunde Ernährung dürfte in Mäßigung und einer ausgewogenen Nahrungszufuhr liegen, die neben rotem Fleisch auch Alternativen zuläßt.“"
                            },
                            {
                                "example_id": "73582dbe-623c-4081-a49c-cb8b382abe7a",
                                "sense_id": "cd620524-36db-395a-85e9-7b3a160da9fa",
                                "text": "„Wie wenig in ganz Europa im Mittelalter der Zustand der Landwirthschaft mit der heutigen Blüthe Aderbaues und der gegenwärtigen Leichtigkeit der Nahrungszufuhren verglichen werden kann, sieht man am besten aus den Englischen Fruchttabellen die Jacob vorzugsweise aus dein Chronicon pretiosum des Bischofs Fletwood zusammengestellt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
