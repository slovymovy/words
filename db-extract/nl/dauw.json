                                "target_senses": [
                                    {
                                        "sense_id": "70bb34c0-086f-3e5a-9400-25cc0c1e197a",
                                        "entry_id": "962ce48e-1bad-3e41-b491-7cbcb0bf487a",
                                        "glosses": [
                                            "Niederschlag, durch Abkühlung (in Bodennähe) kondensierter Wasserdampf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2645d49b-cbe4-4be6-aef7-ead19f08914a",
                                                "sense_id": "70bb34c0-086f-3e5a-9400-25cc0c1e197a",
                                                "text": "Die Wiesen sind morgens feucht vom Tau."
                                            },
                                            {
                                                "example_id": "8423b0d7-c0b2-4ce0-96e8-e0d9612958ca",
                                                "sense_id": "70bb34c0-086f-3e5a-9400-25cc0c1e197a",
                                                "text": "„In dem sandigen Staube der viele Zoll tief aufgefurchten Strasse versickerte der Tau ohne jede Wirkung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                        "entry_id": "f0f60c3c-f463-3db4-adbd-f85105d2286b",
                                        "glosses": [
                                            "starkes Schiffsseil aus Hanf oder Stahldraht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c5355c-1ff3-4094-ad56-6a40470916e5",
                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "Das Schiff war mit einem Tau am Bollwerk befestigt."
                                            },
                                            {
                                                "example_id": "545e05e9-3420-4a8b-8cc1-8112a608a6da",
                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "„Er trat mit dem Tau aufs Dock und warf es über einen Poller.“"
                                            },
                                            {
                                                "example_id": "b6110d7a-7826-498b-9096-aa7f615e6be2",
                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "„Auf diesem lief er bis ans Ufer und befestigte dort das Tau in einem der zu diesem Zweck angebrachten eisernen Ringe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae6cd3dc-4f00-3e22-bd3e-e9b3ca6b5d0b",
                                        "entry_id": "f0f60c3c-f463-3db4-adbd-f85105d2286b",
                                        "glosses": [
                                            "Seil, insbesondere zum Klettern"
                                        ],
                                        "tags": [
                                            "Geräteturnen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc09be0-2d12-48af-aa18-181b426e70e6",
                                                "sense_id": "ae6cd3dc-4f00-3e22-bd3e-e9b3ca6b5d0b",
                                                "text": "Versuch dich mit Unterstützung der Beine langsam und gleichmäßig am Tau hochzuziehen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "147cf756-c7bd-3e10-8bd3-fcf17053f05d",
