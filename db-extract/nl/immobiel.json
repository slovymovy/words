                "senses": [
                    {
                        "sense_id": "6b2006d1-bdd6-3459-9d96-130eda838afe",
                        "entry_id": "f148acb2-7d6d-398c-b2b1-c952edf7624a",
                        "glosses": [
                            "vast op zijn plaats blijvend of weinig van plaats veranderend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283032db-c1a3-4264-95f8-05981d9a26e5",
                                "sense_id": "6b2006d1-bdd6-3459-9d96-130eda838afe",
                                "text": "Ik zou, als het tot een discussie kwam, het gelijk aan mijn kant kunnen krijgen: een tot stilstand gekomen gelijk. Het gelijk is immobiel. De orde van hun rangschikking zou aan mijn woorden een zekere schoonheid geven; maar het leven trekt eruit weg nog voor ik ze heb uitgesproken. Het gelijk zou me een plaats geven buiten alles wat beweegt."
                            }
                        ]
                    },
                    {
                        "sense_id": "9394a3c1-16c7-3789-988c-98f7f8785b38",
                        "entry_id": "f148acb2-7d6d-398c-b2b1-c952edf7624a",
                        "glosses": [
                            "vast op zijn plaats blijvend of weinig van plaats veranderend",
                            "niet in staat om zich te verplaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2015f490-1529-4cd7-8fda-d03849d3d64e",
                                "sense_id": "9394a3c1-16c7-3789-988c-98f7f8785b38",
                                "text": "Ik zou, als het tot een discussie kwam, het gelijk aan mijn kant kunnen krijgen: een tot stilstand gekomen gelijk. Het gelijk is immobiel. De orde van hun rangschikking zou aan mijn woorden een zekere schoonheid geven; maar het leven trekt eruit weg nog voor ik ze heb uitgesproken. Het gelijk zou me een plaats geven buiten alles wat beweegt."
                            },
                            {
                                "example_id": "5aff5658-e0a8-424f-9d75-1472aaf6ee34",
                                "sense_id": "9394a3c1-16c7-3789-988c-98f7f8785b38",
                                "text": "Nog treuriger verliep het bij de 2de Gepantserde Divisie, die door het 1ste Leger was afgestaan, maar door een gebrek aan organisatie haar brandstofwagens kwijt raakte en immobiel was."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ecdc092-828e-3fbf-a708-e6447537bd35",
                        "entry_id": "f148acb2-7d6d-398c-b2b1-c952edf7624a",
                        "glosses": [
                            "vast op zijn plaats blijvend of weinig van plaats veranderend",
                            "zich door lichamelijke beperkingen niet of nauwelijks kunnend verplaatsen, doorgaans in bed moeten blijvend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94767ef3-90e8-410c-bd03-36644b4e5ddc",
                                "sense_id": "3ecdc092-828e-3fbf-a708-e6447537bd35",
                                "text": "Ik zou, als het tot een discussie kwam, het gelijk aan mijn kant kunnen krijgen: een tot stilstand gekomen gelijk. Het gelijk is immobiel. De orde van hun rangschikking zou aan mijn woorden een zekere schoonheid geven; maar het leven trekt eruit weg nog voor ik ze heb uitgesproken. Het gelijk zou me een plaats geven buiten alles wat beweegt."
                            },
                            {
                                "example_id": "e113039f-09d1-4d8e-9657-65391ad34367",
                                "sense_id": "3ecdc092-828e-3fbf-a708-e6447537bd35",
                                "text": "Hij waakt er naar eigen zeggen voor, een detail te beschrijven dat hij niet heeft kunnen controleren. Dat blijkt vele malen als hij een relaas optekent uit de mond van een door verwonding immobiel geworden zegsman, die martelingen alleen kon horen, of er later de resultaten van zag."
                            }
                        ]
                    },
                    {
                        "sense_id": "9caca0fb-a349-3af3-8950-8795d59e7d79",
                        "entry_id": "f148acb2-7d6d-398c-b2b1-c952edf7624a",
                        "glosses": [
                            "vast op zijn plaats blijvend of weinig van plaats veranderend",
                            "met geen of weinig mogelijkheden tot verbetering van maatschappelijke positie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d437d2-843d-4eeb-9ecc-139aba36c727",
                                "sense_id": "9caca0fb-a349-3af3-8950-8795d59e7d79",
                                "text": "Ik zou, als het tot een discussie kwam, het gelijk aan mijn kant kunnen krijgen: een tot stilstand gekomen gelijk. Het gelijk is immobiel. De orde van hun rangschikking zou aan mijn woorden een zekere schoonheid geven; maar het leven trekt eruit weg nog voor ik ze heb uitgesproken. Het gelijk zou me een plaats geven buiten alles wat beweegt."
                            },
                            {
                                "example_id": "77ee88fe-8b5a-4268-bebf-fe7bca0f9f26",
                                "sense_id": "9caca0fb-a349-3af3-8950-8795d59e7d79",
                                "text": "Al lijkt de samenleving van de dertiende tot vijftiende eeuw vaak immobiel, en al zijn tal van structuren gericht op het verhinderen van mobiliteit, in werkelijkheid is er altijd beweging geweest, en klommen steeds nieuwe homines novi, ambitieuze individuen, en nieuwe families de maatschappelijke ladder op."
                            }
                        ]
                    }
