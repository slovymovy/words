                ],
                "senses": [
                    {
                        "sense_id": "6893682f-08a6-3097-b501-2db3ebaf589e",
                        "entry_id": "2f6d344b-0197-3c83-94e3-4ccd04f16fae",
                        "glosses": [
                            "Corps dans lequel la déperdition d’énergie est nulle ou faible quand ce corps est soumis à un champ électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f0b93dc-08c7-4e8d-8eb7-cbd4af4c0c54",
                                "sense_id": "6893682f-08a6-3097-b501-2db3ebaf589e",
                                "text": "Le diélectrique est défini comme l’isolant entre les lames d’un condensateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54d1d4ad-b8f4-461a-ba6d-40b5e7c3d6f1",
                        "source_entry_id": "2f6d344b-0197-3c83-94e3-4ccd04f16fae",
                        "source_sense_id": "6893682f-08a6-3097-b501-2db3ebaf589e",
                        "target_lang_word": "Dielektrikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dielektrikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                                        "entry_id": "ece3f3fb-c5c9-3270-8f99-09041de93b42",
                                        "glosses": [
                                            "elektrisch schwach- oder nichtleitende Substanz, in der die vorhandenen Ladungsträger nicht frei beweglich sind"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41dbfd60-0f00-4f55-9ae1-ac42d037b180",
                                                "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                                                "text": "„Bei kapazitiven Sensoren wirkt die Feuchtigkeit auf das Dielektrikum und ändert so die Kapazität des Sensors, […]“"
                                            },
                                            {
                                                "example_id": "180fa54f-e90e-47ce-89b5-d765aa6a4dc3",
                                                "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                                                "text": "„Metallisiert werden Kunststofffolien als Dielektrikum eingesetzt und zu Kondensatoren zusammengerollt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
