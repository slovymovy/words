                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un léger <w>dépôt</w> au fond de la bouteille n'altère pas la saveur du vin."
                        },
                        {
                            "text": "L'eau dure a laissé un épais <w>dépôt</w> de calcaire dans la bouilloire."
