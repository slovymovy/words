                        "entry_id": "edaa0cdd-18df-3d4a-b18b-13865d9c2888",
                        "glosses": [
                            "Femme pratiquant le snowboard, sport de glisse pratiqué sur la neige."
                        ],
                        "tags": [
                            "Snowboard"
                        ],
                        "examples": [
                            {
                                "example_id": "639276d6-8b30-402f-8eb8-d6da99f0ea57",
                                "sense_id": "06b83bd1-7c0e-39b8-a75e-52a8a9ef9f2b",
                                "text": "La snowboardeuse américaine, médaillée d’or olympique, a annoncé dans une vidéo postée sur les réseaux sociaux qu’elle ne participerait pas à la prochaine saison."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cc6a599-9464-4cc8-b80a-9332daae25a9",
                        "source_entry_id": "edaa0cdd-18df-3d4a-b18b-13865d9c2888",
                        "source_sense_id": "06b83bd1-7c0e-39b8-a75e-52a8a9ef9f2b",
