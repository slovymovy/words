                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bad7553-af41-32c2-843a-0763ac763425",
                        "entry_id": "ec1fdc3c-cca5-3a80-b209-e77419b965cb",
                        "glosses": [
                            "The end or final point of something."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a09af915-9fd0-3547-99ba-32cb5bc2c2e2",
                        "entry_id": "ec1fdc3c-cca5-3a80-b209-e77419b965cb",
                        "glosses": [
                            "The end point of a transportation system, or the town or city in which it is located."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d4954b-9ecc-4e27-a238-51f5cd1490e6",
                                "sense_id": "a09af915-9fd0-3547-99ba-32cb5bc2c2e2",
                                "text": "My brother supposes they must have filled outside London, for at that time the furious terror of the people had rendered the central termini impossible."
                            },
                            {
                                "example_id": "429929e2-54e1-4888-ad79-a3e2dde83b15",
                                "sense_id": "a09af915-9fd0-3547-99ba-32cb5bc2c2e2",
                                "text": "The arrangement for certain long-distance trains to call at suburban stations (saving passengers the trouble of journeying to the termini), which proved popular last year, is being extended."
                            },
                            {
                                "example_id": "f96163f8-7515-4986-9552-14194c2b4f6d",
                                "sense_id": "a09af915-9fd0-3547-99ba-32cb5bc2c2e2",
                                "text": "Wuhan is the terminus for cruises to the Yanzi^([sic – meaning Yangtze]) River gorges."
                            },
                            {
                                "example_id": "482d0d6f-7dce-4d56-b645-1661c0fb1106",
                                "sense_id": "a09af915-9fd0-3547-99ba-32cb5bc2c2e2",
                                "text": "Thirty-five years ago, many journeys around London meant having to pass through the centre of the capital. That's no longer the case, which takes real pressure off the city's termini as well as underground routes such as the Circle Line."
                            }
                        ]
                    },
                    {
                        "sense_id": "abc8eac4-f7fe-3ad9-81da-a3844d1bd7bc",
                        "entry_id": "ec1fdc3c-cca5-3a80-b209-e77419b965cb",
                        "glosses": [
                            "A boundary or border, or a post or stone marking such a boundary."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ad3bea9-7a99-432a-8c08-02c32cc89d34",
                        "source_entry_id": "ec1fdc3c-cca5-3a80-b209-e77419b965cb",
                        "source_sense_description": "end point of a transport system",
                        "target_lang_word": "eindpunt",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindpunt",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7b2fb007-a437-336f-8fa9-e270c7c32e99",
                                        "entry_id": "368f4f3a-541b-39a4-8f5a-a88fd54b4dd5",
                                        "glosses": [
                                            "het punt waar iets eindigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d59d2aa7-723f-492a-8763-c0d78a902429",
                                                "sense_id": "7b2fb007-a437-336f-8fa9-e270c7c32e99",
                                                "text": "Het eindpunt van de grafiek was niet goed af te lezen."
                                            },
                                            {
                                                "example_id": "7286204e-a81e-4846-bdb3-e1e981cfcac7",
                                                "sense_id": "7b2fb007-a437-336f-8fa9-e270c7c32e99",
                                                "text": "Er is slechts een beperkt aantal maanden (tussen maart en september) geschikt om de sneeuwstormen te vermijden in de High Sierra’s en de Cascadebergen bij Canada. Hierdoor starten de meeste North Bounders (NOBO) tussen maart en mei om in september het eindpunt te bereiken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6ca3efa-9352-4ddd-899c-c45409412a70",
                        "source_entry_id": "ec1fdc3c-cca5-3a80-b209-e77419b965cb",
                        "source_sense_description": "end point of a transport system",
                        "target_lang_word": "eindstation",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindstation",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a918fc63-ab6d-3260-831e-ef20db0c0917",
                                        "entry_id": "87673217-3b80-365d-80e1-6aa260433b6f",
                                        "glosses": [
                                            "de bestemming van een tram of trein"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4618c0ad-45f4-359e-a269-d5e0b43e868f",
                                        "entry_id": "87673217-3b80-365d-80e1-6aa260433b6f",
                                        "glosses": [
                                            "de definitieve bestemming; daar waar een proces tot een einde komt"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd5ec1e9-44ac-4737-b5c8-7c221f274bef",
                                                "sense_id": "4618c0ad-45f4-359e-a269-d5e0b43e868f",
                                                "text": "Het WK sprint staat voor het eerst sinds 2011 op de racekalender. Rachel Klamer werd dertiende in die editie. Sinds de start van de World Triathlon Series (WTS) worden wereldtitels vergeven na een reeks van wedstrijden over een heel seizoen met de Grand Final als eindstation."
                                            },
                                            {
                                                "example_id": "1ebbb98d-6c65-44a8-b7b6-bffb2ad62d8b",
                                                "sense_id": "4618c0ad-45f4-359e-a269-d5e0b43e868f",
                                                "text": "In die zin was het ‘premierschap van alle Nederlanders’ dan ook nooit een keuze geweest voor de jonge Wim Kok. Hij was min of meer van de ene verantwoordelijkheid in de andere gerold. Het Torentje als eindstation was meer een logisch gevolg van dat proces, dan een zorgvuldig bedacht plan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2df815f6-8872-42a3-abd2-8ed3c848a832",
                        "source_entry_id": "ec1fdc3c-cca5-3a80-b209-e77419b965cb",
                        "source_sense_description": "end point of a transport system",
                        "target_lang_word": "terminus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terminus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2fe3b3-74be-3c4c-b674-1091fc4280e8",
                                        "entry_id": "dfeccf6b-604b-3cd5-b206-238ad26b4b93",
                                        "glosses": [
                                            "Point final, endroit où s’arrête une ligne de chemins de fer, de bateaux, d’avions, de transports quelconques ; point d'arrêt non suivi d’autres stations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b36ead4-af06-4779-b429-4e348c957187",
                                                "sense_id": "5e2fe3b3-74be-3c4c-b674-1091fc4280e8",
                                                "text": "Où est le terminus de cette ligne ? Par apposition,"
                                            },
                                            {
                                                "example_id": "2787b51f-4fa4-42c3-8eb9-83df087ebe18",
                                                "sense_id": "5e2fe3b3-74be-3c4c-b674-1091fc4280e8",
                                                "text": "Point terminus."
                                            },
                                            {
                                                "example_id": "901ad7f2-c499-45d4-93a9-592f530160cb",
                                                "sense_id": "5e2fe3b3-74be-3c4c-b674-1091fc4280e8",
                                                "text": "Hôtel terminus."
                                            },
                                            {
                                                "example_id": "ccec0476-e50f-43c0-920e-ee00705f6ecc",
                                                "sense_id": "5e2fe3b3-74be-3c4c-b674-1091fc4280e8",
                                                "text": "Terminus, tout le monde descend !"
                                            },
                                            {
                                                "example_id": "21e87070-ab3b-482e-be90-2bc6aa5184b5",
                                                "sense_id": "5e2fe3b3-74be-3c4c-b674-1091fc4280e8",
                                                "text": "Tant que nous sommes vivantes, nous avons en nous des possibilités que nous pouvons exploiter et des choix que nous pouvons faire pour nous même. Aucune situation n’est le terminus de nos vies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74de7889-1ea2-3bd4-8caf-48b8be6538c9",
                                        "entry_id": "dfeccf6b-604b-3cd5-b206-238ad26b4b93",
                                        "glosses": [
                                            "Point au delà duquel l’exploration d’une grotte ne peut pas continuer."
                                        ],
                                        "tags": [
                                            "Spéléologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f245cf05-d173-46ac-96c7-a43c2c8317f9",
                                                "sense_id": "74de7889-1ea2-3bd4-8caf-48b8be6538c9",
                                                "text": "Depuis le 2 Décembre 1979, date à laquelle Eric LEGUEN parvint à 360 m de distance de l’entrée, diverses plongées ont été effectuées (relevés topographiques notamment). Seul un plongeur aurait dépassé ce terminus en 1989 pour atteindre la profondeur de 70 m avec vision à – 80 m."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8f53ebf-e62a-4a6b-9c18-e3bf9938462e",
                        "source_entry_id": "ec1fdc3c-cca5-3a80-b209-e77419b965cb",
                        "source_sense_description": "end point of a transport system",
                        "target_lang_word": "Endstation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Endstation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                        "entry_id": "f4a28894-d745-3c0d-a048-4de091296001",
                                        "glosses": [
                                            "letzte Haltestelle eines Verkehrsmittels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "906f209b-14f7-4836-a033-8a6cd9bb1833",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "Die Straßenbahn erreicht ihre Endstation in wenigen Minuten."
                                            },
                                            {
                                                "example_id": "61c8ffec-bf74-4267-bc3e-65163eb9a547",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "„Und dann die große, rußgeschwärzte Endstation in Paris, diese dreckige Kathedrale, unfruchtbar und erschöpft, durch die man in die grauen Straßen hinausgeht.“"
                                            },
                                            {
                                                "example_id": "cbcb8159-1f93-49f6-a3a8-faf74c8c132c",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "„Zusammen mit der Tochter ihrer Zimmerwirtin fuhr Ditti abends mit der Straßenbahn zur Endstation, sie kletterten auf die Güterwaggons mit den Eierbriketts, stopften die Rucksäcke voll und schleppten sie – verdammt schwer, wie sie waren – wieder zurück nach Hause.“"
                                            },
                                            {
                                                "example_id": "222da2d8-2933-4b6a-897b-c54fd4d50627",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "„Als der Zug seine Geschwindigkeit verminderte und langsam über die große Flußbrücke fuhr, die unmittelbar vor der Endstation lag, trat Robert an das Fenster des Abteils und warf noch einen Blick auf das zurückliegende Land.“"
                                            },
                                            {
                                                "example_id": "3555417b-12b7-4ac4-9d25-046a845c96ab",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "„Die Blätter lagen durchnässt im Regen, und der Wind trieb den Regen gegen den großen grünen Autobus an der Endstation, und das Café des Amateurs war überfüllt, und drinnen beschlugen die Fenster von Wärme und Rauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2683c862-a08a-3c64-98df-79b3b92f63e6",
                                        "entry_id": "f4a28894-d745-3c0d-a048-4de091296001",
                                        "glosses": [
                                            "Endpunkt einer Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78f17bbe-fcc6-417b-957f-56925edd8e75",
                                                "sense_id": "2683c862-a08a-3c64-98df-79b3b92f63e6",
                                                "text": "„Tómas hatte geklungen, als ob für Ari der Posten in Siglufjörđur die Endstation wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
