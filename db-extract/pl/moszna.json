                                                "example_id": "1d8da182-c95b-4a7e-b966-ca7bc5a6d057",
                                                "sense_id": "7e2cfc79-a354-3d91-a34d-5b727c3d54b4",
                                                "text": "„Während die offenen Fenster der Bauerskirche noch immer auf Wind warteten, die Rættará in die Bucht floss und der Mond hell am Himmel stand, spürte Obram, wie sich gnadenlose Finger um seinen Hodensack legten.“"
                                            },
                                            {
                                                "example_id": "8724d79d-6dc3-4829-894f-20e7e72ff1b7",
                                                "sense_id": "7e2cfc79-a354-3d91-a34d-5b727c3d54b4",
                                                "text": "„Sein Kopf war bleischwarz, und sein Hodensack so aufgebläht, als habe er einen schweren Bruch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1990a7a0-7d0d-4c06-ae20-83e7e1d35809",
                        "source_entry_id": "c99487a6-b880-311d-924d-d9ea3e2c80c3",
                        "source_sense_id": "74910831-50d6-3a89-9374-86cbab60ec28",
                        "target_lang_word": "мошонка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мошонка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61e3e9ff-66db-3a5f-b2b2-aa2a638e56c9",
                                        "entry_id": "e5632404-859c-3b64-b041-5bad70bbe7b2",
                                        "glosses": [
                                            "анат. кожно-мышечное образование в паху в виде мешочка, между промежностью и половым членом, где находятся мужские половые железы у самцов большинства живородящих млекопитающих и мужчин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e691d2f-12fa-4c9b-9ca3-e930503c5e03",
                                                "sense_id": "61e3e9ff-66db-3a5f-b2b2-aa2a638e56c9",
                                                "text": "К наружным половым органам у мужчин относятся половой член и мошонка, то есть тот мешочек, где находятся яички."
                                            },
                                            {
                                                "example_id": "cface0dd-8588-4f3f-8cda-ebb84f16b2bf",
                                                "sense_id": "61e3e9ff-66db-3a5f-b2b2-aa2a638e56c9",
                                                "text": "Под пенисом у каждого мальчика маленький мешочек, мошонка, в котором расположены яички."
                                            },
                                            {
                                                "example_id": "65d1a082-5dd0-4b71-8762-e7ff5d8f0ce6",
                                                "sense_id": "61e3e9ff-66db-3a5f-b2b2-aa2a638e56c9",
                                                "text": "Кроме того, во всём теле зуд нестерпимый; у меня сверх того сильный зуд в мошонке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a388749-395c-3abe-a275-bcff030f2b0b",
                                        "entry_id": "e5632404-859c-3b64-b041-5bad70bbe7b2",
                                        "glosses": [
                                            "устар. уменьш. к мошна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a500d905-6a8d-48d3-bc02-443d245cece4",
                                                "sense_id": "0a388749-395c-3abe-a275-bcff030f2b0b",
                                                "text": "В этой мошонке у старой княгини хранились два ключа, с которыми она никогда не расставалась: днём носила в кармане, а ночью клала к себе под подушку."
                                            },
                                            {
                                                "example_id": "a615f5ed-5b5d-4f70-8886-82b1fce71793",
                                                "sense_id": "0a388749-395c-3abe-a275-bcff030f2b0b",
                                                "text": "Мне почему-то начинает казаться, что старичишка-то врёт, что у него за голенищем мошонка с сотней рублей, которые он привёз с тою целью, чтобы обхлопотать своё дело."
                                            },
                                            {
                                                "example_id": "186b26e3-939f-41f1-99bf-a2fcc02f91fc",
                                                "sense_id": "0a388749-395c-3abe-a275-bcff030f2b0b",
                                                "text": "Крестьянин отвернулся и снял у себя с горла, из-под рубашки, кожаную мошонку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
