{
    "word_family": [
        "roil"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "788e51f1-35a2-3776-9e26-37f9689d09de",
                    "sense_definition": "To make someone angry, annoyed, or irritated.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His rude remarks really <w>riled</w> the host of the party.",
                            "target_lang_translations": {
                                "ru": "Его грубые замечания по-настоящему <w>разозлили</w> хозяина вечеринки."
                            }
                        },
                        {
                            "text": "It always <w>riles</w> me when people cut in front of the line.",
                            "target_lang_translations": {
                                "ru": "Меня всегда <w>раздражает</w>, когда люди влезают без очереди."
                            }
                        }
                    ],
                    "synonyms": [
                        "anger",
                        "annoy",
                        "irritate",
                        "provoke",
                        "vex"
                    ],
                    "antonyms": [
                        "appease",
                        "calm",
                        "pacify",
                        "placate",
                        "soothe"
                    ],
                    "common_phrases": [
                        "rile up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злить, сердить или раздражать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать досаду или недовольство"
                            },
                            {
                                "target_lang_word": "злить",
                                "target_lang_sense_clarification": "приводить в злость"
                            },
                            {
                                "target_lang_word": "выводить из себя",
                                "target_lang_sense_clarification": "сильно злить, лишать терпения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ae46278-b223-3504-bd17-83b708b98e9f",
                    "sense_definition": "To disturb, stir up, or agitate liquid or a calm state.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rains began to <w>rile</w> the calm waters of the creek.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди начали <w>мутить</w> спокойные воды ручья."
                            }
                        },
                        {
                            "text": "The rich food seemed to <w>rile</w> his sensitive stomach.",
                            "target_lang_translations": {
                                "ru": "Жирная пища, похоже, <w>раздражала</w> его чувствительный желудок."
                            }
                        }
                    ],
                    "synonyms": [
                        "roil",
                        "ruffle"
                    ],
                    "antonyms": [
                        "settle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мутить или взбаламучивать воду, либо нарушать состояние покоя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мутить",
                                "target_lang_sense_clarification": "делать воду или жидкость мутной, взбалтывать"
                            },
                            {
                                "target_lang_word": "баламутить",
                                "target_lang_sense_clarification": "взбалтывать воду, нарушать спокойствие"
                            },
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "о желудке, организме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}