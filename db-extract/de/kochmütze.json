                "senses": [
                    {
                        "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                        "entry_id": "56d9c4b8-e1d6-3089-808e-dc526b1c0e1c",
                        "glosses": [
                            "zur Berufskleidung gehörende Kopfbedeckung für Berufsköche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ae17fed-06bd-45d7-84bd-ea98e9ecdb90",
                                "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                "text": "Gerne würde ich auch mal so eine schöne weiße, ganz hohe Kochmütze tragen."
                            },
                            {
                                "example_id": "98ded5eb-76f1-4641-80c2-7d215acc8c35",
                                "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                "text": "„Unter der weißen Kochmütze bilden sich Schweißperlen auf der Stirn von Olivier Demol. Mit einem Plastikschaber rührt er in einem großen Bottich voll flüssiger Schokolade.“"
                            },
                            {
                                "example_id": "59ce4864-d2d5-4436-8ea9-35c5b56cbfa4",
                                "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                "text": "„Du liebe Scheiße, er hatte eine so riesige Kochmütze auf dem Kopf, dass die Deckenlampen klirrten, wenn er von einem Zimmer ins andere ging. Ich erwartete irgendeinen Aperitif, aber Kristian servierte uns selbstgemachten Möhrensaft.“"
                            },
                            {
                                "example_id": "b92a3997-2c46-40e4-9ce6-f7bf7464c709",
                                "sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                                "text": "„[…] und hinter dem Eisengitter einer rauchgeschwärzten Höhle des Erdgeschosses, welche die Küche vorstellte, lehnte eine dicke Figur in vormals weißer Jacke und Kochmütze und schlief trotz der zahllosen Fliegen, die das breite, weinrothe Gesicht umschwärmten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8786089-60c2-4e8b-a82a-0fc0cb2d8d8b",
                        "source_entry_id": "56d9c4b8-e1d6-3089-808e-dc526b1c0e1c",
                        "source_sense_id": "ef51da40-c503-37be-84b2-914840acb4df",
                        "source_sense_description": "zur Berufskleidung gehörende Kopfbedeckung für Berufsköche",
                        "target_lang_word": "toque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9109408-0933-367a-b716-8cac113a3b28",
                                        "entry_id": "4ae8677d-8f22-36d4-b985-2052c1fe2f45",
                                        "glosses": [
                                            "A type of hat with no brim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3883216e-48d9-49bd-8a61-ff6cbb3d8d34",
                                                "sense_id": "d9109408-0933-367a-b716-8cac113a3b28",
                                                "text": "Toques are for the most part indented in the mural style, in two rows, between which are placed marabout feathers. Flowers, feathers, ears of corn, in gold or silver: such are the chief ornaments on the heads of young ladies, either as separate decorations or all blended together. Black velvet toques are ornamented with marabout feathers of a light grey, mingled with a few ears of gold corn."
                                            },
                                            {
                                                "example_id": "89408931-c7e3-4a51-8741-2443496ed5db",
                                                "sense_id": "d9109408-0933-367a-b716-8cac113a3b28",
                                                "text": "\"Because Esmé said she was going out this afternoon to choose a new toque, and she hoped I should like it, and I’m not quite sure what it is, or where she'll wear it. Do you mind explaining?\"\n\"Not at all. A toque is that which if it had strings would be a bonnet, and if it had brim, would be a hat. It is worn on the head.\"\n\"Thanks, now I know where I am,\" said the vicar of St. Machars, with a sigh of relief."
                                            },
                                            {
                                                "example_id": "f099cd56-c531-477e-bcf3-5d6832b7970c",
                                                "sense_id": "d9109408-0933-367a-b716-8cac113a3b28",
                                                "text": "She drank a glass of wine mixed with water, took off her felt toque and her shoes, and slid beneath the red eiderdown."
                                            },
                                            {
                                                "example_id": "19143f46-7fc3-4408-be50-b292e255b132",
                                                "sense_id": "d9109408-0933-367a-b716-8cac113a3b28",
                                                "text": "1957—Samuel Beckett, \"Endgame\",\nIn a dressing-gown, a stiff toque on his head, a large blood-stained handkerchief over his face, a whistle hanging from his neck, a rug over his knees, thick socks on his feet, Hamm seems to be asleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd56b062-9dfa-3f1b-8abb-6e25646b0ed1",
                                        "entry_id": "4ae8677d-8f22-36d4-b985-2052c1fe2f45",
                                        "glosses": [
                                            "A tall white hat with no brim of the sort worn by chefs"
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d9be11-480e-4f03-9d5d-d1beec0ad510",
                                                "sense_id": "bd56b062-9dfa-3f1b-8abb-6e25646b0ed1",
                                                "text": "Chef Felder was in her early forties, slender, with short wavy brown hair, almost all of which could be contained within her toque."
                                            },
                                            {
                                                "example_id": "8f5fceb9-5158-451c-8333-67aa957874d3",
                                                "sense_id": "bd56b062-9dfa-3f1b-8abb-6e25646b0ed1",
                                                "text": "When I came to the back of a man's head, wearing a toque, I knew I'd spotted my quarry.\n\"Chef Reynoso?\""
                                            },
                                            {
                                                "example_id": "3d4f8cdf-2ef2-4b2d-be2e-931ab1ff8dee",
                                                "sense_id": "bd56b062-9dfa-3f1b-8abb-6e25646b0ed1",
                                                "text": "Minutes later, a red-faced man in a chef's toque approached our table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d782f5e-0aff-352a-b48a-62e62d288a43",
                                        "entry_id": "4ae8677d-8f22-36d4-b985-2052c1fe2f45",
                                        "glosses": [
                                            "A chef."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "472b936c-333d-49c8-85ad-6f306f2a0d5d",
                                                "sense_id": "9d782f5e-0aff-352a-b48a-62e62d288a43",
                                                "text": "2007—October, Nicole Berrie, \"Green Eggs and Sam\", in Elle, page 360,\nSam Mason first grabbed the spotlight as the pastry chef ... for being the most rock 'n' roll toque in town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e19966d-bcd9-3223-82fb-238f0945cb95",
                                        "entry_id": "4ae8677d-8f22-36d4-b985-2052c1fe2f45",
                                        "glosses": [
                                            "A variety of bonnet monkey; toque macaque, Macaca sinica."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "243631d2-8a10-33f8-8c10-1c39235872de",
                                        "entry_id": "4ae8677d-8f22-36d4-b985-2052c1fe2f45",
                                        "glosses": [
                                            "An African nominal money of account, equal to 40 cowries."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "toque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "617f23a9-d6ac-341a-ba27-164a2e8342d1",
                                        "entry_id": "dc418459-1c8e-3224-b7f1-2a5aa9e838f8",
                                        "glosses": [
                                            "A knitted hat, usually conical but of varying shape, often woollen, and sometimes topped by a pom-pom or tassel."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "011fdc58-9fea-44d8-8e13-40bab2aaf76f",
                                                "sense_id": "617f23a9-d6ac-341a-ba27-164a2e8342d1",
                                                "text": "Such is the demented nature of the universe that I was too weak to properly respond to my being hit on by carloads of Betties and Veronicas—all except for the cheeky Cheryl Anderson who gave me ‘manual release’ the day I lost my eyebrows, followed by a flood of tears and the snapping of Polaroids in which I wear a knit toque. Gush gush."
                                            },
                                            {
                                                "example_id": "c349ee49-fac9-432b-87d9-c536178d6ba4",
                                                "sense_id": "617f23a9-d6ac-341a-ba27-164a2e8342d1",
                                                "text": "It was like entering the Millennial id. Craft beer and cucumber water poured from kitchen taps. Laptoppers in jeans and toques clacked along to MGMT in the wood-paneled common area."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f39513c4-d96f-3344-9869-6fb307885b74",
                                        "entry_id": "77ac5da9-5741-3a02-825c-7617c8535465",
                                        "glosses": [
                                            "A rhythm used in Latin music, especially Cuban religious rituals."
                                        ],
