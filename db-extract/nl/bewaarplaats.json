                                                "sense_id": "9c634971-c2fe-390b-8a15-f1e15b094724",
                                                "text": "Near-synonyms: depository, repository"
                                            },
                                            {
                                                "example_id": "5e1213cc-9fbb-42cb-87cf-bf89280cdf30",
                                                "sense_id": "9c634971-c2fe-390b-8a15-f1e15b094724",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23607a58-f32f-3750-b3b3-dd98fa66c777",
                                        "entry_id": "80ce38ce-d141-3d41-a479-1fff5f74abaf",
