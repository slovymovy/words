                    {
                        "sense_id": "3a962686-3b49-3d93-b354-b7bb28b6b709",
                        "entry_id": "e3859d0d-4f53-31dc-b02c-ad5b79aec819",
                        "glosses": [
                            "voltooid deelwoord van aanbrengen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8a6851f6-8461-452b-ac03-549b8ac33425",
                                "sense_id": "3a962686-3b49-3d93-b354-b7bb28b6b709",
                                "text": "Het was een vrouw van rond de zestig met kort haar waarin dramatisch grote krullen waren aangebracht die haar de coupe van een ouderwetse actrice gaven. Ze keek boven haar brillenglazen streng naar de bebloede theedoek, noteerde de gegevens van Laarbi en gebood hun toen in de wachtkamer plaats te nemen. Eenmaal gezeten bood Slaoui duizendmaal zijn excuses aan, drukte kussen op het voorhoofd van Laarbi, die nog altijd tegen zijn tranen vocht."
                            },
                            {
                                "example_id": "3132cb4d-606a-4ceb-bb52-603bafa4f7f5",
                                "sense_id": "3a962686-3b49-3d93-b354-b7bb28b6b709",
                                "text": "Haar nagellak was van dezelfde kleur en de make-up die ze droeg was zo zorgvuldig aangebracht dat het puur natuur leek."
                            }
                        ]
                    }
