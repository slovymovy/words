                "senses": [
                    {
                        "sense_id": "eab27395-2e7c-381e-a2f6-758095a534d8",
                        "entry_id": "922a5ce5-d6ae-3327-bb12-e7619f72445f",
                        "glosses": [
                            "действие по значению гл. выпадать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ead4fd3-641c-488e-a02b-79a23742e7f9",
                                "sense_id": "eab27395-2e7c-381e-a2f6-758095a534d8",
                                "text": "Светильники с люминесцентными лампами должны иметь решетки или сетки либо ламподержатели, исключающие выпадание ламп."
                            }
                        ]
                    },
                    {
                        "sense_id": "5582c91c-2893-330d-8c66-a188c1c7fb75",
                        "entry_id": "922a5ce5-d6ae-3327-bb12-e7619f72445f",
                        "glosses": [
                            "результат такого действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d98fbe3b-86d5-44dc-b477-804ac9e7b65d",
                                "sense_id": "5582c91c-2893-330d-8c66-a188c1c7fb75",
                                "text": "Отсюда легко заключить, что вероятность выпадания, скажем, герба при любом бросании равна 1/2."
                            }
                        ]
                    }
