                        "entry_id": "1a6b4783-3600-3ae1-9029-6390ef822d23",
                        "glosses": [
                            "The act or process of making divine."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a64318a5-a0e1-4cc3-b5ac-6d97a41158dc",
                                "sense_id": "d3ab5f34-3cf6-3489-b5c6-0db9d772ccc6",
                                "text": "[W]here would they be now if it had not been for Israel, and the stern check which Israel put upon the glorification and divinisation of this natural bent of mankind, this attractive aspect of the not ourselves?"
                            },
                            {
                                "example_id": "7d1f3013-141c-48f9-8caf-9a2fd1ced803",
                                "sense_id": "d3ab5f34-3cf6-3489-b5c6-0db9d772ccc6",
                                "text": "And farther back still in the evolutionary process we may trace […] the divinisation of four-footed animals and birds and snakes and trees and the like[.]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad5e53bd-cd2d-4703-8cb9-98d53ecef72b",
                        "source_entry_id": "1a6b4783-3600-3ae1-9029-6390ef822d23",
                        "source_sense_id": "d3ab5f34-3cf6-3489-b5c6-0db9d772ccc6",
                        "source_sense_description": "act or process of making divine",
                        "target_lang_word": "divinisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divinisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a05562d1-4999-382a-bfe9-a9be9858941c",
                                        "entry_id": "e6ba52d3-1b87-38d1-b8d6-d0bff2332c3c",
                                        "glosses": [
                                            "Action de diviniser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4f9db4f-188e-4708-9193-f9b6347737d4",
                                                "sense_id": "a05562d1-4999-382a-bfe9-a9be9858941c",
                                                "text": "Cette perpétuelle divinisation grise si violemment, que je ne m’étonne plus de voir les femmes devenir égoïstes, oublieuses et légères au milieu de cette fête."
                                            },
                                            {
                                                "example_id": "c5430ada-e7b5-4fb4-b229-a7805c088dba",
                                                "sense_id": "a05562d1-4999-382a-bfe9-a9be9858941c",
                                                "text": "Je crois que cela ne signifie pas notre néant ni notre malheur, mais, au contraire, notre réalisation et notre divinisation, puisque tout est en nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
