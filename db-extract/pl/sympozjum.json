                                        "sense_id": "3e558f47-ea4f-3e62-8f4a-c7b1b0017496",
                                        "entry_id": "1bc16d53-f1e3-34e4-af31-781dba9591c1",
                                        "glosses": [
                                            "A drinking party in Ancient Greece, especially one with intellectual discussion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45222ae3-a670-3f05-843e-5aabf1c8bccf",
                                        "entry_id": "1bc16d53-f1e3-34e4-af31-781dba9591c1",
                                        "glosses": [
                                            "A collection of essays, articles or papers on a particular subject by a number of contributors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "693adecb-8ccd-4551-966d-0e787d288eb0",
                                                "sense_id": "45222ae3-a670-3f05-843e-5aabf1c8bccf",
                                                "text": "THE CONCISE ENCYCLOPAEDIA OF WORLD RAILWAY LOCOMOTIVES. Edited by P. Ransome-Wallis. Hutchinson. 50s. [...] The work is a symposium by writers who are mostly specialists in the topics about which they write."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59f48276-e228-45d8-9f4e-b6400deb1a9e",
