{
    "word_family": [
        "outgo",
        "outgone"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8276e636-c811-3e2c-9ec8-5c3421e113ae",
                    "sense_definition": "Friendly and energetic and finding it easy and enjoyable to be with others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tom is very <w>outgoing</w> and enjoys meeting people; his brother, on the other hand, is painfully shy.",
                            "target_lang_translations": {
                                "ru": "Том очень <w>общительный</w> и любит знакомиться с людьми; его брат, напротив, мучительно застенчив.",
                                "zh": "汤姆很<w>外向</w>，喜欢结交朋友；而他哥哥却非常害羞。"
                            }
                        },
                        {
                            "text": "She has an <w>outgoing</w> personality that makes everyone feel welcome at the party.",
                            "target_lang_translations": {
                                "ru": "У неё такой <w>открытый</w> характер, что каждый на вечеринке чувствует, что ему рады.",
                                "zh": "她性格很<w>外向</w>，让聚会上的每个人都感到宾至如归。"
                            }
                        }
                    ],
                    "antonyms": [
                        "introverted",
                        "asocial",
                        "reserved",
                        "shy",
                        "bashful",
                        "withdrawn",
                        "quiet",
                        "mousy"
                    ],
                    "common_phrases": [
                        "outgoing personality",
                        "bubbly and outgoing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружелюбный, энергичный и легко находящий общий язык с другими людьми.",
                        "zh": "友好、有活力，并且觉得与他人相处轻松愉快。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общительный",
                                "target_lang_sense_clarification": "легко вступающий в контакт"
                            },
                            {
                                "target_lang_word": "коммуникабельный",
                                "target_lang_sense_clarification": "умеющий общаться"
                            },
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "о характере человека"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外向",
                                "target_lang_sense_clarification": "形容人性格开朗，善于交际"
                            },
                            {
                                "target_lang_word": "开朗",
                                "target_lang_sense_clarification": "强调喜欢与人来往、容易相处"
                            },
                            {
                                "target_lang_word": "善于交际",
                                "target_lang_sense_clarification": "强调善于交际"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d13c4f8-d310-30eb-a0cf-bd51c801a35f",
                    "sense_definition": "Moving away from a place or being sent out.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please place all <w>outgoing</w> mail in the tray by the front door.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, кладите всю <w>исходящую</w> почту в лоток у входной двери.",
                                "zh": "请把所有<w>寄出</w>的邮件放在前门旁边的托盘里。"
                            }
                        },
                        {
                            "text": "The <w>outgoing</w> tide left many small shells scattered across the sand.",
                            "target_lang_translations": {
                                "ru": "<w>Отливное</w> течение оставило множество мелких ракушек, разбросанных по песку.",
                                "zh": "<w>退去</w>的潮水过后，沙滩上散落着许多小贝壳。"
                            }
                        }
                    ],
                    "antonyms": [
                        "incoming"
                    ],
                    "common_phrases": [
                        "outgoing mail",
                        "outgoing tide",
                        "outgoing calls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся из какого-либо места или отправляемый наружу.",
                        "zh": "从某处向外移动，或被发送出去的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исходящий",
                                "target_lang_sense_clarification": "о почте или звонках"
                            },
                            {
                                "target_lang_word": "отливный",
                                "target_lang_sense_clarification": "о течении или приливе"
                            },
                            {
                                "target_lang_word": "отправляющийся",
                                "target_lang_sense_clarification": "о транспорте или грузе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发出的",
                                "target_lang_sense_clarification": "指邮件、电话等发出去的"
                            },
                            {
                                "target_lang_word": "寄出的",
                                "target_lang_sense_clarification": "指信件、包裹等已寄送出去的"
                            },
                            {
                                "target_lang_word": "退去的",
                                "target_lang_sense_clarification": "指潮水等向外退去"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bf09a8d-c2c0-39e9-bcf9-2ba98ef3a56d",
                    "sense_definition": "Leaving a position of power or responsibility, especially after an election.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outgoing</w> president gave a final speech before the new leader took office.",
                            "target_lang_translations": {
                                "ru": "<w>Уходящий в отставку</w> президент произнес прощальную речь перед тем, как новый лидер вступил в должность.",
                                "zh": "这位<w>卸任</w>总统在新领导人就职前发表了最后一次讲话。"
                            }
                        },
                        {
                            "text": "There was a brief meeting between the <w>outgoing</w> and incoming ministers to discuss the transition.",
                            "target_lang_translations": {
                                "ru": "Состоялась короткая встреча между <w>уходящим</w> и вступающим в должность министрами для обсуждения передачи дел.",
                                "zh": "<w>卸任</w>部长和新任部长举行了一次简短会谈，讨论交接事宜。"
                            }
                        }
                    ],
                    "antonyms": [
                        "incoming"
                    ],
                    "common_phrases": [
                        "outgoing president",
                        "outgoing administration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покидающий пост или должность, особенно после выборов.",
                        "zh": "离开权力或职责职位的，尤指在选举之后。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уходящий в отставку",
                                "target_lang_sense_clarification": "о чиновнике или лидере"
                            },
                            {
                                "target_lang_word": "слагающий полномочия",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卸任的",
                                "target_lang_sense_clarification": "指官员、领导人等离任"
                            },
                            {
                                "target_lang_word": "即将离任的",
                                "target_lang_sense_clarification": "较正式，指结束任期、交出职务"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d60260e6-bed3-3f26-842f-866a980727f7",
                    "sense_definition": "The amount of money that a person or business regularly spends.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to calculate our monthly <w>outgoings</w> to see if we can afford a new car.",
                            "target_lang_translations": {
                                "ru": "Нам нужно подсчитать наши ежемесячные <w>расходы</w>, чтобы понять, можем ли мы позволить себе новую машину.",
                                "zh": "我们得计算一下每月的<w>开支</w>，看看是否买得起一辆新车。"
                            }
                        },
                        {
                            "text": "The company is trying to reduce its <w>outgoings</w> by cutting travel expenses.",
                            "target_lang_translations": {
                                "ru": "Компания пытается сократить свои <w>издержки</w>, урезая расходы на командировки.",
                                "zh": "公司正试图通过削减差旅费用来减少<w>支出</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "monthly outgoings",
                        "reduce outgoings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, которую человек или компания регулярно тратит.",
                        "zh": "个人或企业经常花费的钱款总额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходы",
                                "target_lang_sense_clarification": "регулярные траты"
                            },
                            {
                                "target_lang_word": "издержки",
                                "target_lang_sense_clarification": "затраты на бизнес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开支",
                                "target_lang_sense_clarification": "日常用语，指经常性的花费"
                            },
                            {
                                "target_lang_word": "支出",
                                "target_lang_sense_clarification": "较通用，指支出的金额"
                            },
                            {
                                "target_lang_word": "费用",
                                "target_lang_sense_clarification": "多用于公司经营成本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c706a6e-5251-38f5-b65c-807e0f2d5e19",
                    "sense_definition": "The act of leaving or departing from a place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outgoings</w> of the morning and evening were marked by the ringing of bells.",
                            "target_lang_translations": {
                                "ru": "<w>Уход</w> утра и вечера отмечался звоном колоколов.",
                                "zh": "晨昏的<w>消逝</w>以钟声为标志。"
                            }
                        },
                        {
                            "text": "He watched the <w>outgoing</w> of the tide from the harbor wall.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал за <w>отливом</w> с портовой стены.",
                                "zh": "他站在港墙上观看潮水的<w>退去</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outgang"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт ухода или отправления из какого-либо места.",
                        "zh": "从某处离开或出发的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "отправление"
                            },
                            {
                                "target_lang_word": "отлив",
                                "target_lang_sense_clarification": "уход воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离去",
                                "target_lang_sense_clarification": "指离开、离去这一行为"
                            },
                            {
                                "target_lang_word": "消逝",
                                "target_lang_sense_clarification": "较书面，指事物逐渐过去或消失"
                            },
                            {
                                "target_lang_word": "退去",
                                "target_lang_sense_clarification": "用于潮水退落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e5337e3-8371-3543-bc27-489a5c19ddc4",
                    "sense_definition": "The furthest limit or the place where something ends.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outgoings</w> of the border were at the north bay of the salt sea.",
                            "target_lang_translations": {
                                "ru": "<w>Пределы</w> границы находились у северного залива соленого моря.",
                                "zh": "那片边界的<w>尽头</w>位于咸海北湾。"
                            }
                        },
                        {
                            "text": "They reached the <w>outgoings</w> of the forest just as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Они достигли <w>окраины</w> леса как раз в тот момент, когда солнце начало садиться.",
                                "zh": "太阳刚开始落山时，他们到达了森林的<w>边缘</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older texts or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый дальний предел или место, где что-то заканчивается.",
                        "zh": "最远的界限，或某物终止的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предел",
                                "target_lang_sense_clarification": "граница"
                            },
                            {
                                "target_lang_word": "окраина",
                                "target_lang_sense_clarification": "край чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尽头",
                                "target_lang_sense_clarification": "指最远的边界或终点"
                            },
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "指某区域的外缘"
                            },
                            {
                                "target_lang_word": "边界",
                                "target_lang_sense_clarification": "用于地方、区域的外围"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a77f417-b45e-3240-832f-cf5733934d98",
                    "sense_definition": "The present participle and gerund of <w>outgo</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>outgoing</w> its competitors in terms of innovation this year.",
                            "target_lang_translations": {
                                "ru": "В этом году компания <w>превосходит</w> своих конкурентов в плане инноваций.",
                                "zh": "今年这家公司在创新方面正<w>超过</w>竞争对手。"
                            }
                        },
                        {
                            "text": "By <w>outgoing</w> the previous records, the athlete secured a gold medal.",
                            "target_lang_translations": {
                                "ru": "<w>Опередив</w> предыдущие рекорды, атлет обеспечил себе золотую медаль.",
                                "zh": "这位运动员凭借<w>超过</w>此前纪录，拿下了金牌。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола outgo (превосходить).",
                        "zh": "动词 outgo 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосходящий",
                                "target_lang_sense_clarification": "в чем-либо"
                            },
                            {
                                "target_lang_word": "опережающий",
                                "target_lang_sense_clarification": "по показателям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超过",
                                "target_lang_sense_clarification": "作动词，指在数量、水平等方面胜过"
                            },
                            {
                                "target_lang_word": "胜过",
                                "target_lang_sense_clarification": "强调比别的对象更好或更强"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}