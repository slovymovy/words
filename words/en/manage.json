{
    "word_family": [
        "manager",
        "management",
        "manageable",
        "managerial",
        "mismanage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96700cbd-fd0b-3923-9bcf-3e0d723a7251",
                    "sense_definition": "To succeed in doing something despite difficulties or obstacles.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even though the climb was steep, he <w>managed</w> to reach the top before sunset.",
                            "target_lang_translations": {
                                "ru": "Хотя подъем был крутым, ему <w>удалось</w> добраться до вершины до захода солнца.",
                                "tr": "Tırmanış dik olmasına rağmen, güneş batmadan önce zirveye ulaşmayı <w>başardı</w>.",
                                "zh": "尽管山势陡峭，他还是<w>设法</w>在日落前到达了山顶。"
                            }
                        },
                        {
                            "text": "I do not know how she <w>managed</w> to <w>manage</w> the workload with so little time.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, как она <w>сумела</w> <w>справиться</w> с таким объемом работы за столь короткое время.",
                                "tr": "Bu kadar az zamanla bu iş yükünün üstesinden gelmeyi nasıl <w>başardığını</w> ve onu nasıl <w>idare ettiğini</w> bilmiyorum.",
                                "zh": "我不知道她是怎么<w>设法</w>在这么短的时间内<w>处理</w>完这些工作量的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contrive"
                    ],
                    "antonyms": [
                        "fail"
                    ],
                    "common_phrases": [
                        "manage the workload",
                        "manage to find",
                        "manage to escape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суметь сделать что-либо, несмотря на трудности или препятствия.",
                        "tr": "Zorluklara veya engellere rağmen bir şeyi başarmak, üstesinden gelmek.",
                        "zh": "在困难或障碍面前成功完成某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суметь",
                                "target_lang_sense_clarification": "сделать что-то"
                            },
                            {
                                "target_lang_word": "удаваться",
                                "target_lang_sense_clarification": "получаться"
                            },
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "с задачей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "başarmak",
                                "target_lang_sense_clarification": "zor bir şeyi yapabilmek"
                            },
                            {
                                "target_lang_word": "halletmek",
                                "target_lang_sense_clarification": "bir işi başarıyla sonuçlandırmak"
                            },
                            {
                                "target_lang_word": "üstesinden gelmek",
                                "target_lang_sense_clarification": "zorluğun üstesinden gelmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成功",
                                "target_lang_sense_clarification": "达成目标"
                            },
                            {
                                "target_lang_word": "设法",
                                "target_lang_sense_clarification": "努力做到"
                            },
                            {
                                "target_lang_word": "搞定",
                                "target_lang_sense_clarification": "口语中处理好某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8654c99f-82c5-3bd1-9fd1-50da308d7353",
                    "sense_definition": "To be in charge of a business, a team, or an organization.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "leadership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was promoted last year and now <w>manages</w> a large team of developers.",
                            "target_lang_translations": {
                                "ru": "В прошлом году её повысили, и теперь она <w>руководит</w> большой командой разработчиков.",
                                "tr": "Geçen yıl terfi etti ve şimdi büyük bir yazılımcı ekibini <w>yönetiyor</w>.",
                                "zh": "她去年获得了晋升，现在<w>管理</w>着一个庞大的开发团队。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>manage</w> a business when the economy is so unstable.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>управлять</w> бизнесом, когда экономика так нестабильна.",
                                "tr": "Ekonomi bu kadar istikrarsızken bir iş yerini <w>yönetmek</w> zordur.",
                                "zh": "当经济如此不稳定时，<w>经营</w>一家企业非常困难。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "manage a team",
                        "manage a business",
                        "manage a project"
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководить бизнесом, командой или организацией.",
                        "tr": "Bir iş yerinden, ekipten veya organizasyondan sorumlu olmak, onu yönetmek.",
                        "zh": "负责管理企业、团队或组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "коллективом или проектом"
                            },
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "бизнесом или организацией"
                            },
                            {
                                "target_lang_word": "заведовать",
                                "target_lang_sense_clarification": "отделом или хозяйством"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yönetmek",
                                "target_lang_sense_clarification": "şirket veya ekibi"
                            },
                            {
                                "target_lang_word": "idare etmek",
                                "target_lang_sense_clarification": "yöneticilik yapmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理",
                                "target_lang_sense_clarification": "负责组织或业务"
                            },
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "带领团队"
                            },
                            {
                                "target_lang_word": "经营",
                                "target_lang_sense_clarification": "管理商业活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02c43aef-6cda-38eb-b241-8b3921a35138",
                    "sense_definition": "To handle or control a specific situation, task, or resource effectively.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>managed</w> the crisis much better than anyone had expected.",
                            "target_lang_translations": {
                                "ru": "Правительство <w>справилось</w> с кризисом гораздо лучше, чем кто-либо ожидал.",
                                "tr": "Hükümet krizi herkesin beklediğinden çok daha iyi <w>yönetti</w>.",
                                "zh": "政府在<w>处理</w>这场危机时的表现远超所有人的预期。"
                            }
                        },
                        {
                            "text": "You need to learn how to <w>manage</w> your time if you want to succeed.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно научиться <w>управлять</w> своим временем, если хочешь добиться успеха.",
                                "tr": "Başarılı olmak istiyorsan zamanını nasıl <w>yöneteceğini</w> öğrenmelisin.",
                                "zh": "如果你想成功，就需要学会如何<w>管理</w>你的时间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "manage your time",
                        "manage the situation",
                        "manage expectations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эффективно справляться с ситуацией, задачей или ресурсом.",
                        "tr": "Belirli bir durumu, görevi veya kaynağı etkili bir şekilde ele almak veya kontrol etmek.",
                        "zh": "有效地处理或控制特定的情况、任务或资源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "временем или рисками"
                            },
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "с ситуацией"
                            },
                            {
                                "target_lang_word": "контролировать",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yönetmek",
                                "target_lang_sense_clarification": "zamanı veya süreci"
                            },
                            {
                                "target_lang_word": "idare etmek",
                                "target_lang_sense_clarification": "durumu kontrol altında tutmak"
                            },
                            {
                                "target_lang_word": "başa çıkmak",
                                "target_lang_sense_clarification": "sorunlarla mücadele etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "处理",
                                "target_lang_sense_clarification": "应对情况"
                            },
                            {
                                "target_lang_word": "掌控",
                                "target_lang_sense_clarification": "控制局面"
                            },
                            {
                                "target_lang_word": "安排",
                                "target_lang_sense_clarification": "规划时间或资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74704140-780e-3ec2-8de2-24282525e9cd",
                    "sense_definition": "To cope or survive without outside help or with limited resources.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "coping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry about me; it is a tough job but I will <w>manage</w> on my own.",
                            "target_lang_translations": {
                                "ru": "Не беспокойся обо мне; это тяжелая работа, но я <w>справлюсь</w> сам.",
                                "tr": "Benim için endişelenme; zor bir iş ama kendi başıma <w>idare edeceğim</w>.",
                                "zh": "别担心我；虽然工作很艰苦，但我自己能<w>应付</w>。"
                            }
                        },
                        {
                            "text": "They had very little money but they <w>managed</w> to live comfortably for years.",
                            "target_lang_translations": {
                                "ru": "У них было очень мало денег, но они <w>умудрялись</w> безбедно жить годами.",
                                "tr": "Çok az paraları vardı ama yıllarca rahat bir şekilde yaşamayı <w>becerdiler</w>.",
                                "zh": "他们虽然钱很少，但多年来一直<w>设法</w>过着舒适的生活。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "manage on own",
                        "manage without help",
                        "just about manage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Справляться или выживать без посторонней помощи или с ограниченными ресурсами.",
                        "tr": "Dışarıdan yardım almadan veya sınırlı kaynaklarla geçinmek, idare etmek.",
                        "zh": "在没有外界帮助或资源有限的情况下维持生活或应对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "самостоятельно"
                            },
                            {
                                "target_lang_word": "обходиться",
                                "target_lang_sense_clarification": "своими силами"
                            },
                            {
                                "target_lang_word": "выкручиваться",
                                "target_lang_sense_clarification": "в трудной ситуации"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "idare etmek",
                                "target_lang_sense_clarification": "kendi kendine yetmek"
                            },
                            {
                                "target_lang_word": "geçinmek",
                                "target_lang_sense_clarification": "kısıtlı imkanlarla yaşamak"
                            },
                            {
                                "target_lang_word": "idare edip gitmek",
                                "target_lang_sense_clarification": "zorlukla dayanmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "应付",
                                "target_lang_sense_clarification": "勉强维持"
                            },
                            {
                                "target_lang_word": "维持",
                                "target_lang_sense_clarification": "生活或生存"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85e66ee4-5ee5-3e61-abb4-10dc2dd23faf",
                    "sense_definition": "To accidentally or foolishly end up doing something that should have been avoided.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accidental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not know how he <w>managed</w> to lock himself out of his own house.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, как он <w>умудрился</w> запереться снаружи собственного дома.",
                                "tr": "Kendi evinin kapısında kalmayı nasıl <w>becerdi</w> bilmiyorum.",
                                "zh": "我不知道他是怎么<w>竟然</w>把自己锁在门外的。"
                            }
                        },
                        {
                            "text": "She somehow <w>managed</w> to sit on the wet paint despite the warning sign.",
                            "target_lang_translations": {
                                "ru": "Она каким-то образом <w>ухитрилась</w> сесть на свежеокрашенную скамейку, несмотря на предупреждающий знак.",
                                "tr": "Uyarı tabelasına rağmen bir şekilde ıslak boyanın üzerine oturmayı <w>başardı</w>.",
                                "zh": "尽管有警告标志，她还是<w>竟然</w>坐到了湿油漆上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "somehow managed to",
                        "managed to lose",
                        "managed to break"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайно или по глупости сделать то, чего следовало избегать.",
                        "tr": "Kaçınılması gereken bir şeyi kazaen veya aptalca yapmayı becermek/başarmak.",
                        "zh": "意外地或愚蠢地最终做了本应避免的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умудриться",
                                "target_lang_sense_clarification": "сделать что-то нелепое"
                            },
                            {
                                "target_lang_word": "ухитриться",
                                "target_lang_sense_clarification": "сделать что-то вопреки логике"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "becermek",
                                "target_lang_sense_clarification": "istemeden de olsa yapmak"
                            },
                            {
                                "target_lang_word": "nasıl yaptıysa yapmak",
                                "target_lang_sense_clarification": "bir şekilde başarmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竟然",
                                "target_lang_sense_clarification": "表示出乎意料"
                            },
                            {
                                "target_lang_word": "糊涂地",
                                "target_lang_sense_clarification": "因疏忽而做错"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2252ab43-d847-3a0e-97b3-dcfe971cb643",
                    "sense_definition": "To produce a sound or words with difficulty, often due to strong emotion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I am so sorry,\" she <w>managed</w> through her tears before leaving the room.",
                            "target_lang_translations": {
                                "ru": "«Мне так жаль», — <w>выдавила</w> она сквозь слезы, прежде чем выйти из комнаты.",
                                "tr": "Oradan ayrılmadan önce gözyaşları içinde \"Çok üzgünüm\" diye <w>fısıldayabildi</w>.",
                                "zh": "“我很抱歉，”她在离开房间前泪流满面地<w>挤出</w>了这句话。"
                            }
                        },
                        {
                            "text": "He was so shocked by the news that he only <w>managed</w> a weak smile.",
                            "target_lang_translations": {
                                "ru": "Он был так потрясен новостью, что <w>смог</w> лишь слабо улыбнуться.",
                                "tr": "Haber karşısında o kadar şok olmuştu ki sadece zayıfça <w>gülümseyebildi</w>.",
                                "zh": "他被这个消息震惊得只能<w>勉强</w>露出一丝微笑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "managed a smile",
                        "managed a reply",
                        "barely managed to"
                    ],
                    "target_lang_definitions": {
                        "ru": "С трудом произнести звуки или слова, часто из-за сильных эмоций.",
                        "tr": "Genellikle güçlü duygular nedeniyle güçlükle bir ses çıkarmak veya kelime söylemek.",
                        "zh": "因强烈情绪而难以发出声音或说出话语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавить",
                                "target_lang_sense_clarification": "из себя слова или улыбку"
                            },
                            {
                                "target_lang_word": "проговорить",
                                "target_lang_sense_clarification": "с трудом"
                            },
                            {
                                "target_lang_word": "суметь",
                                "target_lang_sense_clarification": "произнести"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zar zor söylemek",
                                "target_lang_sense_clarification": "güçlükle kelimeleri dökebilmek"
                            },
                            {
                                "target_lang_word": "çıkarabilmek",
                                "target_lang_sense_clarification": "güçlükle ses veya gülümseme çıkarabilmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挤出",
                                "target_lang_sense_clarification": "勉强说出"
                            },
                            {
                                "target_lang_word": "勉强",
                                "target_lang_sense_clarification": "费力地做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50f5a794-16a6-3654-8fb2-63afa4823744",
                    "sense_definition": "To handle or wield a tool, weapon, or instrument with skill.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight <w>managed</w> his heavy sword with surprising grace and speed.",
                            "target_lang_translations": {
                                "ru": "Рыцарь <w>владел</w> своим тяжелым мечом с удивительным изяществом и скоростью.",
                                "tr": "Şövalye, ağır kılıcını şaşırtıcı bir zarafet ve hızla <w>kullandı</w>.",
                                "zh": "骑士以惊人的优雅和速度<w>操纵</w>着他那把沉重的剑。"
                            }
                        },
                        {
                            "text": "It takes years of practice to <w>manage</w> such a complex musical instrument.",
                            "target_lang_translations": {
                                "ru": "Требуются годы практики, чтобы <w>управляться</w> с таким сложным музыкальным инструментом.",
                                "tr": "Böyle karmaşık bir müzik enstrümanını <w>çalabilmek</w> yıllarca pratik gerektirir.",
                                "zh": "需要多年的练习才能<w>驾驭</w>如此复杂的乐器。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bewield"
                    ],
                    "common_phrases": [
                        "manage a weapon",
                        "manage a tool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умело обращаться с инструментом, оружием или прибором.",
                        "tr": "Bir aleti, silahı veya enstrümanı beceriyle kullanmak veya idare etmek.",
                        "zh": "熟练地操作工具、武器或乐器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владеть",
                                "target_lang_sense_clarification": "оружием или инструментом"
                            },
                            {
                                "target_lang_word": "управляться",
                                "target_lang_sense_clarification": "с чем-либо сложным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kullanmak",
                                "target_lang_sense_clarification": "aleti veya silahı ustalıkla"
                            },
                            {
                                "target_lang_word": "yönlendirmek",
                                "target_lang_sense_clarification": "kontrol etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "操纵",
                                "target_lang_sense_clarification": "控制工具或机器"
                            },
                            {
                                "target_lang_word": "使用",
                                "target_lang_sense_clarification": "熟练运用"
                            }
                        ]
                    }
                },
                {
