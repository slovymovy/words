                        "entry_id": "b159cc1a-92e1-3766-8020-aa48d676dc2d",
                        "glosses": [
                            "Tressage de lanières de canne destiné à confectionner l’assise ou le dossier d’un siège."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a3468d-e582-4407-bb6f-9c2629104051",
                                "sense_id": "076d2a0b-1752-3dde-a54b-32d262617175",
                                "text": "Le cannage est une activité artisanale qui demande patience et dextérité."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a7e63cd-80c8-3953-b0b0-ee51501a5166",
                        "entry_id": "b159cc1a-92e1-3766-8020-aa48d676dc2d",
                        "glosses": [
                            "Partie cannée d’un siège."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "267215e8-1e26-43dd-82ab-c5bff4d40abc",
                                "sense_id": "8a7e63cd-80c8-3953-b0b0-ee51501a5166",
                                "text": "Cette technique peut être utilisée pour recanner un siège ancien. Il faut, dans ce cas, creuser une gorge périphérique à l’emplacement des trous de passage de l’ancien cannage."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9f9c7b2-5508-3795-b43b-5dc2ebd0e687",
                        "entry_id": "b159cc1a-92e1-3766-8020-aa48d676dc2d",
                        "glosses": [
                            "Action de mesurer une étoffe, un tissu, à l’aide d’une canne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
