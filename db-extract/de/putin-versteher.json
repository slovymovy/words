                ],
                "senses": [
                    {
                        "sense_id": "65591b86-86ad-3783-81b4-4ccaf1421454",
                        "entry_id": "3126bd7f-2c61-323d-b5d0-203544715963",
                        "glosses": [
                            "Person, die Verständnis, Zustimmung oder Sympathien zu Positionen der russischen Regierung, insbesondere zum russischen Krieg gegen die Ukraine seit 2014, zeigt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a929dd22-9499-4580-a16a-b6ab386dea11",
                                "sense_id": "65591b86-86ad-3783-81b4-4ccaf1421454",
                                "text": "„Hier wirkt bis heute nach, dass der Außenminister als Vertrauter des damaligen Kanzlers und Putin-Verstehers Schröder maßgeblich an dessen Russland-Politik mitgewirkt hat.“"
                            },
                            {
                                "example_id": "810922d5-d89d-4b30-bcd5-f2418ab66b27",
                                "sense_id": "65591b86-86ad-3783-81b4-4ccaf1421454",
                                "text": "„Im Extremfall kann es sogar passieren, dass Politiker und Kommentatoren, die versuchen, sich den Beweggründen von Diktatoren und semi-demokratischen Staatschefs zu nähern, genau dafür gescholten werden. In diesem Zusammenhang ist wohl auch der neu-deutsche Begriff des ‚Putin-Verstehers‘ zu sehen.“"
                            },
                            {
                                "example_id": "64bc86ca-0bd3-4b08-b4dc-86ab69863400",
                                "sense_id": "65591b86-86ad-3783-81b4-4ccaf1421454",
                                "text": "„Dabei wird besonders auf die Rolle Russlands geblickt - von einer Zwickmühle für Moskau ist die Rede, von der ‘Unaufrichtigkeit des Kreml‘ und auch von ‘naiven Putin-Verstehern‘.“"
                            },
                            {
                                "example_id": "91430a90-0a27-4614-a34f-19438f5ae780",
                                "sense_id": "65591b86-86ad-3783-81b4-4ccaf1421454",
                                "text": "„Der Konflikt in der Ukraine hat gezeigt, wie wichtig soziale Medien sind, aber auch dass für die Putin-Versteher gerade Hochsaison im Netz ist.“"
                            },
                            {
                                "example_id": "532c7ed9-5460-4bc9-9817-69ac2aec9d19",
                                "sense_id": "65591b86-86ad-3783-81b4-4ccaf1421454",
                                "text": "„Wenn die Gegenseite Krieg will, hilft Friedensliebe wenig. Pazifisten gelten heute als Träumer, Populisten oder Putin-Versteher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
