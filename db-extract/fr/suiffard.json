                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26228321-10f0-4bf9-adb5-b7e6fdeb3848",
                                "sense_id": "66ecc4b9-833c-3bde-957d-a54a951b5730",
                                "text": "Le suiffard, à fuir comme son nom l'indique. Des précisions sur les appellations : il y a les dénominations traditionnelles, telles l'agneau de Sisteron ou de pré-salé, de Nîmes ou des Alpilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "08e538ff-ca03-3772-9ba8-7373e5121292",
                        "entry_id": "72aae7da-d6a4-3849-b55f-7644cbd7d266",
                        "glosses": [
                            "Riche."
