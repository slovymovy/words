                "translations": [
                    {
                        "translation_id": "0b605980-048a-4924-889e-743d8afc9d00",
                        "source_entry_id": "5c298f5d-40db-3f03-a3c0-962f926fe21f",
                        "source_sense_id": "71cba5c0-1b69-3f4a-8419-b4f176962d31",
                        "target_lang_word": "Flussbiegung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flussbiegung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b29a949b-5223-3bfc-a638-07cc4bba92e4",
                                        "entry_id": "13f2f3bd-2a4e-37f6-884b-aaece53a9406",
                                        "glosses": [
                                            "Stelle der Richtungsänderung eines Flusses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b12f49-3834-4745-bfd3-54d8b3d4ebd3",
                                                "sense_id": "b29a949b-5223-3bfc-a638-07cc4bba92e4",
                                                "text": "„An Flussbiegungen, wo die Strömung Erde weggespült hatte, sodass steile Hänge entstanden waren, wie mit einem Messer abgeschnitten, mussten sie kraxeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "279c0559-13d7-4037-9fad-49071c238a9b",
                        "source_entry_id": "5c298f5d-40db-3f03-a3c0-962f926fe21f",
                        "source_sense_id": "71cba5c0-1b69-3f4a-8419-b4f176962d31",
                        "target_lang_word": "изги́б",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "изги́б",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "589bdacf-f818-36f1-88ff-f1596dc76d31",
                                        "entry_id": "a5ce382f-139b-3b01-967b-8c34a2ab3a27",
                                        "glosses": [
                                            "действие по значению гл. изгибать, изгибаться"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d709e94-006f-3bab-823a-6bd47d668b4f",
                                        "entry_id": "a5ce382f-139b-3b01-967b-8c34a2ab3a27",
                                        "glosses": [
                                            "дугообразный поворот, плавное искривление"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f39cf53b-58fe-42c4-b66e-254d3fa648d8",
                                                "sense_id": "9d709e94-006f-3bab-823a-6bd47d668b4f",
                                                "text": "Переход был не длинен, шагов в пятьсот, не более; в этот час никто бы не мог и повстречаться, но вдруг на первом изгибе дорожки он заметил Ракитина."
                                            },
                                            {
                                                "example_id": "a1bd2be2-51e3-4e74-9319-4ac9084d81bb",
                                                "sense_id": "9d709e94-006f-3bab-823a-6bd47d668b4f",
                                                "text": "Как отдыхающие верблюды, лежали они [острова] посреди моря, и я угадывал длинные шеи, маленькие головки и характерный изгиб задних ног."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "724db2af-1dfc-3264-8cb8-50d20f1183c9",
                                        "entry_id": "a5ce382f-139b-3b01-967b-8c34a2ab3a27",
                                        "glosses": [
                                            "перен. тонкий оттенок, переход"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad3f2b6e-be00-48eb-ad9b-b22d5f8ebef9",
                                                "sense_id": "724db2af-1dfc-3264-8cb8-50d20f1183c9",
                                                "text": "Другие, и таких меньшинство, берутся за перо при первом проблеске поэтической мысли; они творят «на бумаге», отмечая, записывая каждый поворот, каждый изгиб своей творческой мысли, весь процесс создания запечатлевается у таких писателей в рукописи; рукопись отражает не только техническую работу над стилем, но и всю психологию поэта в моменты творчества."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "782d3022-d47c-4b6d-95d2-7febcca81369",
                        "source_entry_id": "5c298f5d-40db-3f03-a3c0-962f926fe21f",
                        "source_sense_id": "71cba5c0-1b69-3f4a-8419-b4f176962d31",
                        "target_lang_word": "излу́чина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "излу́чина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c457d88f-70c3-37c1-a791-9b2104dfa73c",
                                        "entry_id": "8e4c12c2-f8bf-3105-ac4b-440448914883",
                                        "glosses": [
                                            "крутой поворот, изгиб (часто — реки́)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95462cfc-a6ee-4645-be7e-2ac94e33eed2",
                                                "sense_id": "c457d88f-70c3-37c1-a791-9b2104dfa73c",
                                                "text": "В этом месте река делала излучину, так что получалось нечто вроде полуострова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e247ba16-6f96-36a7-87e5-2df6915e6119",
                                        "entry_id": "8e4c12c2-f8bf-3105-ac4b-440448914883",
                                        "glosses": [
                                            "перен., устар. тонкий оттенок, также неожиданный, своеобразный ход мысли, чувства и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731a8723-45ae-43b3-b20d-9b5699357924",
                                                "sense_id": "e247ba16-6f96-36a7-87e5-2df6915e6119",
                                                "text": "Я с жадностью схватился за эту новую мысль, с жадностью разбирал ее во всех ее излучинах, во всех видах ее..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cb5ed37-4b51-495a-ba22-e70db7552285",
                        "source_entry_id": "5c298f5d-40db-3f03-a3c0-962f926fe21f",
