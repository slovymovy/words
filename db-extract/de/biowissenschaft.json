                        "entry_id": "f20d1f19-112b-3570-b9d9-840a86d2e912",
                        "glosses": [
                            "Wissenschaft, die sich mit Prozessen oder Strukturen von Lebewesen beschäftigt oder an denen Lebewesen beteiligt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c34afd1-547d-4e02-be88-99dadf7af7de",
                                "sense_id": "8a7663ba-1b1c-38c7-8735-98edb8d5c700",
                                "text": "„Besonders im Fall der Biowissenschaften muß jedoch bezweifelt werden, ob eine überproportionale Förderung dieser Disziplin gerechtfertigt ist.“"
                            },
                            {
                                "example_id": "8d828900-ec9b-4420-88fa-01cfe665fea5",
                                "sense_id": "8a7663ba-1b1c-38c7-8735-98edb8d5c700",
                                "text": "„Zurück in Chile begann sie das Studium Molekulare Biowissenschaft und ist damit auch äußerst erfolgreich.“"
                            }
                        ],
