        "nl-extract.jsonl": [
            {
                "entry_id": "a3b0c05b-f7b3-3235-98bd-c6b3a312b70d",
                "word": "overhaasten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6fd15f29-aef9-3f53-b929-2ae8c847f2c4",
                        "entry_id": "a3b0c05b-f7b3-3235-98bd-c6b3a312b70d",
                        "glosses": [
                            "iets te snel willen doen zodat er fouten gemaakt worden"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fca6e0d8-79e5-410a-a68e-3c5702f5a962",
                                "sense_id": "6fd15f29-aef9-3f53-b929-2ae8c847f2c4",
                                "text": "Minister voor Eenwording, Cho Myong-gyon, voerde namens de Zuid-Koreaanse delegatie het woord. Hij liet vlak voor de ontmoeting weten kalm het gesprek aan te gaan en de zaken niet te overhaasten."
                            },
                            {
                                "example_id": "ddfdbd68-ab32-478a-bca0-65511ac0501f",
                                "sense_id": "6fd15f29-aef9-3f53-b929-2ae8c847f2c4",
                                "text": "Onlangs liet de zangeres, die sinds de scheiding met Van Ingen op een vakantiepark in De Lutte woont, weten dat haar relatie „hartstikke goed” ging en dat ze „een enorme lieverd” had getroffen. „We willen echter niets overhaasten”, vertelde de Dutch Diva aan Privé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "614bee8b-a6fa-40ca-91aa-f3b96f6d526e",
                        "source_entry_id": "a3b0c05b-f7b3-3235-98bd-c6b3a312b70d",
                        "source_sense_id": "6fd15f29-aef9-3f53-b929-2ae8c847f2c4",
                        "target_lang_word": "hurry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c19ecf87-9af5-31e0-ba39-5c60d15cb50a",
                                        "entry_id": "3b2116f7-140c-33ec-805f-5e80b32aeb15",
                                        "glosses": [
                                            "Rushed action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7eb7bb7-490a-4fd1-86f9-69391a4adb76",
                                                "sense_id": "c19ecf87-9af5-31e0-ba39-5c60d15cb50a",
                                                "text": "Why are you in such a big hurry?"
                                            },
                                            {
                                                "example_id": "e867b160-2b73-43a9-846e-d61fd56cab05",
                                                "sense_id": "c19ecf87-9af5-31e0-ba39-5c60d15cb50a",
                                                "text": "At length, one night, when the company by ſome accident broke up much ſooner than ordinary, ſo that the candles were not half burnt out, ſhe was not able to reſiſt the temptation, but reſolved to have them ſome way or other. Accordingly, as ſoon as the hurry was over, and the ſervants, as ſhe thought, all gone to ſleep, ſhe ſtole out of her bed, and went down ſtairs, naked to her ſhift as ſhe was, with a deſign to ſteal them […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d4a50e1-72e6-3ad5-9c8d-1e728d0270e6",
                                        "entry_id": "3b2116f7-140c-33ec-805f-5e80b32aeb15",
                                        "glosses": [
                                            "Urgency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c207cb2-8d0e-47e5-bd17-9d95af513050",
                                                "sense_id": "9d4a50e1-72e6-3ad5-9c8d-1e728d0270e6",
                                                "text": "There is no hurry on that paperwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7602324-7f58-38aa-9472-75a08233e07e",
                                        "entry_id": "3b2116f7-140c-33ec-805f-5e80b32aeb15",
                                        "glosses": [
                                            "an incidence of a defensive player forcing the quarterback to act faster than the quarterback was prepared to, resulting in a failed offensive play."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed3e9c4-9a0d-4084-b370-580b57bf7550",
                                                "sense_id": "f7602324-7f58-38aa-9472-75a08233e07e",
                                                "text": "At Alabama, Jedrick Wills Jr. anchored the right side of the offensive line for two years, allowing only one sack and three-and-a-half quarterback hurries on 714 snaps last season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6157a40-732c-32b6-88e3-4bdbd13fac52",
                                        "entry_id": "3b2116f7-140c-33ec-805f-5e80b32aeb15",
                                        "glosses": [
                                            "A tremolando passage for violins, etc., accompanying an exciting situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hurry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab801892-b7cb-37f2-a8d0-3986c84437e8",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To do things quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "964d400e-286c-4a2e-9f54-c4d9f64e10e8",
                                                "sense_id": "ab801892-b7cb-37f2-a8d0-3986c84437e8",
                                                "text": "He's hurrying because he's late."
                                            },
                                            {
                                                "example_id": "35c0e637-bbc7-4edb-affb-7665276b753c",
                                                "sense_id": "ab801892-b7cb-37f2-a8d0-3986c84437e8",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Stewards, carrying cabin trunks, swarm in the corridors. Passengers wander restlessly about or hurry, with futile energy, from place to place."
                                            },
                                            {
                                                "example_id": "e959a9ad-3c32-4e09-aa27-3beab34da439",
                                                "sense_id": "ab801892-b7cb-37f2-a8d0-3986c84437e8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa4efa0f-ac9a-3a98-bd59-a9614c87352b",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "Often with up, to speed up the rate of doing something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f67713b-85a6-4811-9ce8-a9dc9b6d661f",
                                                "sense_id": "aa4efa0f-ac9a-3a98-bd59-a9614c87352b",
                                                "text": "If you don't hurry (up) you won't finish on time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e75bcf0-8511-3e56-b74a-51e79542798d",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To cause to be done quickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e33ce65-6b74-3c2d-a4f0-f74f336b83b8",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To hasten; to impel to greater speed; to urge on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "068434b1-5182-4c9e-acc1-8d6fa34025eb",
                                                "sense_id": "9e33ce65-6b74-3c2d-a4f0-f74f336b83b8",
                                                "text": "the rapid Stream presently draws him in , carries him away , and hurries him down violently."
                                            },
                                            {
                                                "example_id": "a6b6dcc2-c782-4ac0-a896-cd0c1e5546cb",
                                                "sense_id": "9e33ce65-6b74-3c2d-a4f0-f74f336b83b8",
                                                "text": "They hurried him aboard a bark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afad6877-8398-3a1f-bc10-010cf3155894",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To impel to precipitate or thoughtless action; to urge to confused or irregular activity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1c2c33-8542-48ec-852a-fee277d68166",
                                                "sense_id": "afad6877-8398-3a1f-bc10-010cf3155894",
                                                "text": "And wild amazement hurries up and down / The little number of your doubtful friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0844210-531b-3f98-97a2-13a15b9c4415",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To put: to convey coal in the mine, e.g. from the working to the tramway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee2bf58-5b7a-4f07-9eb0-1eb3b7d314a3",
                                                "sense_id": "b0844210-531b-3f98-97a2-13a15b9c4415",
                                                "text": "Elizabeth Day, aged seventeen […] \"I have been nearly nine years in the pit. I trapped for two years when I first went, and have hurried ever since. I have hurried for my father until a year ago. I have to help to riddle and fill, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2055c904-2b4e-4321-bf33-c11b870c47a3",
                        "source_entry_id": "a3b0c05b-f7b3-3235-98bd-c6b3a312b70d",
                        "source_sense_id": "6fd15f29-aef9-3f53-b929-2ae8c847f2c4",
                        "target_lang_word": "rouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "344b9192-b22d-3ce7-97e2-ff7e3e53e14f",
                                        "entry_id": "ea7a0a0b-9cb1-3078-9fc2-af6e724ee907",
                                        "glosses": [
                                            "An arousal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4cd58a1-4807-3cf2-bfa3-f08e2b694c06",
                                        "entry_id": "ea7a0a0b-9cb1-3078-9fc2-af6e724ee907",
                                        "glosses": [
                                            "The sounding of a bugle in the morning after reveille, to signal that soldiers are to rise from bed, often the rouse."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0b90da2-e8c2-3c58-b3a4-4dfcc578dae0",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To wake (someone) from sleep, or from apathy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fece7b-9ea3-42ef-a605-882f4815de74",
                                                "sense_id": "e0b90da2-e8c2-3c58-b3a4-4dfcc578dae0",
                                                "text": "John Hedley was Locomotive Foreman at Beattock. He was in bed, but they roused him, and he gave orders for one of his pilot engines to go up to the summit, get Mitchell's train, and take it to Carlisle."
                                            },
                                            {
                                                "example_id": "451f5b82-910b-430f-bfcc-af1761be13a9",
                                                "sense_id": "e0b90da2-e8c2-3c58-b3a4-4dfcc578dae0",
                                                "text": "Dubin slept through the ringing alarm, aware of Kitty trying to rouse him and then letting him sleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caee538d-0438-3a01-9272-9d597f1f33ad",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To be awoken from sleep, or from apathy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f944c0-7028-4abd-9b93-b242d16311a3",
                                                "sense_id": "caee538d-0438-3a01-9272-9d597f1f33ad",
                                                "text": "Good things of day begin to droop and drowse;\nNight’s black agents to their preys do rouse."
                                            },
                                            {
                                                "example_id": "ea768272-232c-41cb-b798-dff3ee73e1b7",
                                                "sense_id": "caee538d-0438-3a01-9272-9d597f1f33ad",
                                                "text": "As for the heat, with which he treated his other adversaries, ’twas sometimes strain’d a little too far, but in the general was extremely well fitted by the Providence of God to rowse up a people, the most phlegmatic of any in Christendome."
                                            },
                                            {
                                                "example_id": "190c46fd-3498-473b-8f37-f089d49ffabb",
                                                "sense_id": "caee538d-0438-3a01-9272-9d597f1f33ad",
                                                "text": "At Musick, Melancholy lifts her Head;\nDull Morpheus rowzes from his Bed;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To cause, stir up, excite (a feeling, thought, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2deb9a90-6ca5-42a6-9128-3e8636cf7df7",
                                                "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                                "text": "to rouse the faculties, passions, or emotions"
                                            },
                                            {
                                                "example_id": "277d7b45-5048-4e9e-b850-68c3521f3486",
                                                "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                                "text": "[…] their first Step in Dangers, after the common Efforts are over, was always to despair, lie down under it, and die, without rousing their Thoughts up to proper Remedies for Escape."
                                            },
                                            {
                                                "example_id": "70a00437-3064-4fe0-bd0d-2360bc4eae74",
                                                "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                                "text": "‘You may think it all very fine, Mr. Huntingdon, to amuse yourself with rousing my jealousy; but take care you don’t rouse my hate instead. And when you have once extinguished my love, you will find it no easy matter to kindle it again.’"
                                            },
                                            {
                                                "example_id": "c3691a88-123a-4009-a00b-61f26093010c",
                                                "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                                "text": "[…] he had grown to look upon houses as things that concerned other people, like churches, butchers’ stalls, cricket matches and football matches. They had ceased to rouse ambition or misery. He had lost the vision of the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To provoke (someone) to action or anger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f7c56fe-9e8a-4095-b7f0-f34a2ede1c97",
                                                "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                                "text": "He scarce had finisht, when such murmur filld\nTh’ Assembly, as when hollow Rocks retain\nThe sound of blustring winds, which all night long\nHad rous’d the Sea […]"
                                            },
                                            {
                                                "example_id": "5ed4cb00-0acc-4a53-9ac5-7b3acd68dc41",
                                                "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                                "text": "“A surgeon!” said Anne.\nHe caught the word; it seemed to rouse him at once, and saying only—“True, true, a surgeon this instant,” was darting away, when Anne eagerly suggested—\n“Captain Benwick, would not it be better for Captain Benwick? […]”"
                                            },
                                            {
                                                "example_id": "b0922f77-fdf8-45d4-b913-90e7b84acfee",
                                                "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                                "text": "He tried to argue with her. But it was like trying to argue with a tree: she did not even rouse herself to deny, she just listened quietly and then talked again in that level, cold tone as if he had never spoken."
                                            },
                                            {
                                                "example_id": "803994be-4f50-4fa2-ad04-f13b354482dc",
                                                "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                                "text": "The words they stopped me from uttering may have been very paltry indeed, hardly words to rouse the rabble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To cause to start from a covert or lurking place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97fbc5e8-e484-45da-91f9-63dcf4fbd6f2",
                                                "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                                "text": "to rouse a deer or other animal of the chase"
                                            },
                                            {
                                                "example_id": "7bcd927e-885e-4eef-a4b2-a8cd70d7faeb",
                                                "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                                "text": "Deformed creatures, in straunge difference,\nSome hauing heads like Harts, some like to Snakes,\nSome like wilde Bores late rouzd out of the brakes,"
                                            },
                                            {
                                                "example_id": "3d95b91e-9d60-40d6-a692-6dd3c2c83185",
                                                "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                                "text": "Hark, the game is roused!"
                                            },
                                            {
                                                "example_id": "88300820-a023-424d-91b0-ef94929030a4",
                                                "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                                "text": "The Youth rush eager to the Sylvan War;\nSwarm o’er the Lawns, the Forest Walks surround,\nRowze the fleet Hart, and chear the opening Hound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d471cdcb-2c73-330b-8c80-380f821ebf26",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To pull by main strength; to haul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dda6c0e-44de-41fa-8291-37aeba34a848",
                                                "sense_id": "d471cdcb-2c73-330b-8c80-380f821ebf26",
                                                "text": "Tom, you and the boy rouse the cable up—get about ten fathoms on deck, and bend it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24dce6f-e278-380b-b9e6-858efaf7cc73",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To raise; to make erect."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb0cde5f-b0e0-48a2-aa25-742023da36cf",
                                                "sense_id": "b24dce6f-e278-380b-b9e6-858efaf7cc73",
                                                "text": "And ouer, all with brasen scales was armd,\nLike plated cote of steele, so couched neare,\nThat nought mote perce, ne might his corse bee harmd\nWith dint of swerd, nor push of pointed speare,\nWhich as an Eagle, seeing pray appeare,\nHis aery plumes doth rouze, full rudely dight,\nSo shaked he, that horror was to heare,\nFor as the clashing of an Armor bright,\nSuch noyse his rouzed scales did send vnto the knight."
                                            },
                                            {
                                                "example_id": "a63c7b88-24f6-42c3-86bd-fa32dee08481",
                                                "sense_id": "b24dce6f-e278-380b-b9e6-858efaf7cc73",
                                                "text": "He that outlives this day, and comes safe home,\nWill stand a tip-toe when the day is named,\nAnd rouse him at the name of Crispian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c909bc87-6f30-3601-ae06-3080c30299c4",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To tell off; to criticise."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0f0f512-b2f1-4056-b390-3b67f79b1480",
                                                "sense_id": "c909bc87-6f30-3601-ae06-3080c30299c4",
                                                "text": "He roused on her for being late yet again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adb861a4-6ff3-3df3-a623-c905d09476c7",
                                        "entry_id": "63e48bd8-e5de-30ae-ad50-3e7ce7c065ca",
                                        "glosses": [
                                            "An official ceremony over drinks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d05d7a9-d4e1-4c7c-8562-450d39d89911",
                                                "sense_id": "adb861a4-6ff3-3df3-a623-c905d09476c7",
                                                "text": "No jocund health that Denmark drinks to-day\nBut the great cannon to the clouds shall tell,\nAnd the King’s rouse the heaven shall bruit again,\nRespeaking earthly thunder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de432a7c-ad1e-3e99-b013-6ca5f9a7716e",
                                        "entry_id": "63e48bd8-e5de-30ae-ad50-3e7ce7c065ca",
                                        "glosses": [
                                            "A carousal; a festival; a drinking frolic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7982008-f4a6-4d8f-882f-e5c8feb3831a",
                                                "sense_id": "de432a7c-ad1e-3e99-b013-6ca5f9a7716e",
                                                "text": "Fill the cup, and fill the can:\nHave a rouse before the morn:\nEvery minute dies a man,\nEvery minute one is born."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99f5cb4a-cf59-361e-8824-cccc779080a5",
                                        "entry_id": "63e48bd8-e5de-30ae-ad50-3e7ce7c065ca",
                                        "glosses": [
                                            "Wine or other liquor considered an inducement to mirth or drunkenness; a full glass; a bumper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ad6a1fe-a493-4b34-a346-547a401c7fd8",
                        "source_entry_id": "a3b0c05b-f7b3-3235-98bd-c6b3a312b70d",
                        "source_sense_id": "6fd15f29-aef9-3f53-b929-2ae8c847f2c4",
                        "target_lang_word": "make haste",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "make haste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec101d29-2d4b-3565-9e74-9b4819cd86f7",
                                        "entry_id": "bf6bf93b-fee2-324e-b4bd-366d1c7b1a3f",
                                        "glosses": [
                                            "To hurry or hasten."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f190abdb-d680-4903-bf67-63b6d111402e",
                                                "sense_id": "ec101d29-2d4b-3565-9e74-9b4819cd86f7",
                                                "text": "Since I have your good leave to go away,\nI will make haste: but, till I come again,\nNo bed shall e'er be guilty of my stay,\nNor rest be interposer 'twixt us twain."
                                            },
                                            {
                                                "example_id": "504275c8-216b-483f-bf44-aa78914c424f",
                                                "sense_id": "ec101d29-2d4b-3565-9e74-9b4819cd86f7",
                                                "text": "Bid the players make haste.\nWill you two help to hasten them?"
                                            },
                                            {
                                                "example_id": "b8f90a1e-0941-46fd-ac1c-eef6a5285ce4",
                                                "sense_id": "ec101d29-2d4b-3565-9e74-9b4819cd86f7",
                                                "text": "“The second will be to promise me upon pain of death that you will permit no word of this affair to get into the newspapers. If you do not do both, neither of you will be alive when I pass next through that doorway. Do you understand?” And, without waiting for a reply: “Make haste; there is ink before you, and paper and a pen.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
