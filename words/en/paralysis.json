{
    "word_family": [
        "paralyse",
        "paralyze",
        "paralytic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43eab8b7-13f8-3401-9ac7-4ff9975cc069",
                    "sense_definition": "The loss of the ability to move all or part of the body, often caused by illness or injury.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The severe injury to his spine caused permanent <w>paralysis</w> in both legs.",
                            "target_lang_translations": {
                                "zh": "他脊柱的严重损伤导致双腿永久性<w>瘫痪</w>。"
                            }
                        },
                        {
                            "text": "She suffered temporary facial <w>paralysis</w> following a viral infection.",
                            "target_lang_translations": {
                                "zh": "病毒感染后，她出现了暂时性的面部<w>麻痹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immobility",
                        "palsy"
                    ],
                    "common_phrases": [
                        "sleep paralysis",
                        "temporary paralysis",
                        "permanent paralysis",
                        "facial paralysis"
                    ],
                    "target_lang_definitions": {
                        "zh": "（由于疾病或受伤导致全部或部分身体部位丧失活动能力的）瘫痪，麻痹"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瘫痪",
                                "target_lang_sense_clarification": "身体肢体失去运动功能"
                            },
                            {
                                "target_lang_word": "麻痹",
                                "target_lang_sense_clarification": "神经或肌肉功能丧失、失去知觉或运动能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6dd4260-1315-39cb-a1ef-54323c61ee4b",
                    "sense_definition": "A state of complete inability to act, decide, or function normally.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inability_to_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Political disagreements led to complete <w>paralysis</w> in the government.",
                            "target_lang_translations": {
                                "zh": "政治分歧导致政府工作彻底<w>瘫痪</w>。"
                            }
                        },
                        {
                            "text": "Faced with too many choices, he experienced analysis <w>paralysis</w> and made no decision.",
                            "target_lang_translations": {
                                "zh": "面对过多的选择，他陷入了过度分析导致的思维<w>停滞</w>，没有做出任何决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immobility"
                    ],
                    "common_phrases": [
                        "political paralysis",
                        "analysis paralysis",
                        "economic paralysis"
                    ],
                    "target_lang_definitions": {
                        "zh": "完全无法行动、做决定或正常运转的瘫痪状态，停滞"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瘫痪",
                                "target_lang_sense_clarification": "系统、组织或工作全面停顿、失去运转能力"
                            },
                            {
                                "target_lang_word": "停滞",
                                "target_lang_sense_clarification": "陷入僵局无法行动或做决定"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}