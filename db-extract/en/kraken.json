                                        "entry_id": "8f733db7-07e9-3fc5-a43b-bad351e06cbc",
                                        "glosses": [
                                            "een techniek voor het vervaardigen van chemische producten uit aardolie"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
