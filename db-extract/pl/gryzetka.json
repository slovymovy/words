                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grisette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc2b31ba-2506-3ca8-b41c-09eed8908639",
                                        "entry_id": "f1a0710e-0dab-3b9d-a347-3c877d32cba0",
                                        "glosses": [
                                            "Vêtement d’étoffe grise de peu de valeur."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17274496-c4ee-319a-ad1f-2dc6961be617",
                                        "entry_id": "f1a0710e-0dab-3b9d-a347-3c877d32cba0",
                                        "glosses": [
                                            "La jeune fille ou jeune femme de médiocre condition qui portait ce vêtement (souvent employé avec une connotation de prostitution)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7a864b0-4fad-453c-bf14-17b13fb61962",
                                                "sense_id": "17274496-c4ee-319a-ad1f-2dc6961be617",
                                                "text": "J’ai affaire à une petite grisette à qui je ne veux dire ni mon titre ni ma condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe74104-90ea-3252-bc59-53cce90ff492",
                                        "entry_id": "f1a0710e-0dab-3b9d-a347-3c877d32cba0",
                                        "glosses": [
                                            "Jeune ouvrière coquette et galante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212452af-6149-4756-b0ab-ea9c65521dbf",
                                                "sense_id": "7fe74104-90ea-3252-bc59-53cce90ff492",
                                                "text": "Il commençait à faire jour : je montai, je montai, regardant aux vitres des mansardes des grisettes qui se levaient et faisaient leur toilette, me servant des cheminées comme de tubes acoustiques pour entendre ce qu’on disait dans les appartements."
                                            },
                                            {
                                                "example_id": "06f2ba7a-f8c2-4220-9f48-9f19e6f05438",
                                                "sense_id": "7fe74104-90ea-3252-bc59-53cce90ff492",
                                                "text": "La grisette joyeuse et se contentant de peu est morte et enterrée, tuée par l’exploitation grippe-sou des grands magasins et des grands ateliers et par la prostitution légale et illégale."
                                            },
                                            {
                                                "example_id": "29d3e653-4c2c-46e7-86ad-aaf0cc82c8b7",
                                                "sense_id": "7fe74104-90ea-3252-bc59-53cce90ff492",
                                                "text": "POITIERS – […] Quand j’y étais, faute d’autres divertissements, les jeunes gens prenaient des grisettes quelconques ; ils les installaient dans deux chambres et les entretenaient magnifiquement à trois francs par jour."
                                            },
                                            {
                                                "example_id": "2040b5d8-e178-4a71-bf6a-ee0564a36b98",
                                                "sense_id": "7fe74104-90ea-3252-bc59-53cce90ff492",
                                                "text": "Les robes vertes enfin sont celles des grisettes, Caroline Crochard installée par M. de Granville, Ida Gruget (Ferragus), Suzanne (La Vieille Fille) qui porte une robe de reps vert et un délicieux chapeau vert doublé rose."
                                            },
                                            {
                                                "example_id": "c44f64fc-528d-49fc-96af-32723944bdfe",
                                                "sense_id": "7fe74104-90ea-3252-bc59-53cce90ff492",
                                                "text": "Un jeune homme se doit de partager les plaisirs de son pays et de son temps, de provoquer l’aventure, d’en courir les risques, de se prouver à soi-même qu’il peut conquérir autre chose qu’une gentille grisette, qu’il est capable de reconnaître l’élégance et le charme sous le capuchon banal et le loup de dentelle noire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff3cdff-0336-331b-9cbc-056709a1040a",
                                        "entry_id": "f1a0710e-0dab-3b9d-a347-3c877d32cba0",
                                        "glosses": [
                                            "Courtisane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d763b265-5dbb-47e4-9f1f-d26012d6fbb3",
                                                "sense_id": "fff3cdff-0336-331b-9cbc-056709a1040a",
                                                "text": "« Voulez-vous bien rentrer ! s’emportait le vétérinaire. Vous êtes une grisette, madame ! une grisette ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b230ceed-105f-384e-888a-919577764ef4",
                                        "entry_id": "f1a0710e-0dab-3b9d-a347-3c877d32cba0",
                                        "glosses": [
                                            "Nom vulgaire de certaines espèces de petits oiseaux, comme la fauvette grisette."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1fe8708-f035-35d7-a4bd-68a752c8a8a5",
