                        "sense_id": "fd4ff5c5-9561-31c4-b0b2-1079b4af8f25",
                        "entry_id": "bd8892a0-71b0-34b3-b546-f37501c4ea9f",
                        "glosses": [
                            "a small social gathering at someone's home"
