                                "sense_id": "bf06ff09-1c1a-3ddc-9897-8a18f1265c5a",
                                "text": "Z urny pełnej ponumerowanych kul wylosowałem dwudziestkę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a2cea707-c177-34ae-aab3-466e5a1c5665",
