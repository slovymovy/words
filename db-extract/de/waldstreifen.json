                "senses": [
                    {
                        "sense_id": "fec8e6b1-a859-325f-9037-ab7a7a72b53c",
                        "entry_id": "f5cc384f-6ad2-3f5c-a90c-4747dc896032",
                        "glosses": [
                            "schmales, langgestrecktes Areal, das von wild wachsenden Bäumen bestanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d9e7d5-efe9-4b25-b9e1-b55203cecb82",
                                "sense_id": "fec8e6b1-a859-325f-9037-ab7a7a72b53c",
                                "text": "„Die Lufttemperatur ist auf den von Waldstreifen geschützten Feldern in der ersten Tageshälfte etwa 1° höher als auf den offenen Feldern, in der zweiten Tageshälfte dagegen 1 bis 2° niedriger.“"
                            },
                            {
                                "example_id": "4127ea5a-0dc6-445d-8341-e3564a7a6e7c",
                                "sense_id": "fec8e6b1-a859-325f-9037-ab7a7a72b53c",
                                "text": "„Über dem First des Wuthenower Herrenhauses hing die Sonne, während drüben am andern Ufer die Wolken im Widerschein glühten und die Waldstreifen ihren Schatten in den See warfen.“"
                            },
                            {
                                "example_id": "a8af6c2c-f6c3-4216-9761-0b054f7fbfa2",
                                "sense_id": "fec8e6b1-a859-325f-9037-ab7a7a72b53c",
                                "text": "„Im Waldstreifen, der die beiden KLärungen mit ihren Weilern voneinander trennte, begegnete sich die vogelfreie Knabenjugend zu Spiel und Sport.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
