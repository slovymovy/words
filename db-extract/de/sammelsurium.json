                                "target_senses": [
                                    {
                                        "sense_id": "6513f137-1970-3524-ac90-c4afa06569f6",
                                        "entry_id": "def88fdf-fec7-3a23-b322-c40af12e123e",
                                        "glosses": [
                                            "Variante orthographique de mélimélo."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fcec3f1-8cf9-4989-afe2-e043932884e6",
                                                "sense_id": "6513f137-1970-3524-ac90-c4afa06569f6",
                                                "text": "La case correspondant à la couleur « méli-mélo » (la première en haut à gauche) était couverte d’un ton indécis, olivâtre ou violacé."
                                            },
                                            {
                                                "example_id": "f3c93169-c62c-4fc0-a4bd-1b47a16c868b",
                                                "sense_id": "6513f137-1970-3524-ac90-c4afa06569f6",
                                                "text": "Howard jette un coup d'œil aux profondeurs insondables des niveaux inférieurs par-dessus la rambarde et aperçoit un méli-mélo de robes cerise, de corps au bronzage artificiel et de chaussures de strip-teaseuse"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5af6dc8-d315-4d0f-974c-28a7e55d7ec7",
                        "source_entry_id": "ddaa2227-0868-3e1b-8285-07e2a6e26796",
                        "source_sense_id": "a9fb7b53-a70b-3f86-b7cf-2fa9a1a65341",
                        "source_sense_description": "ungeordnetes Durcheinander, unsystematische Sammlung",
                        "target_lang_word": "salmigondis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salmigondis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07fd81c0-e804-3b4b-b94a-d53d2976953c",
                                        "entry_id": "dc5676c4-2e71-3f9d-8d0a-9c5a1890005a",
                                        "glosses": [
                                            "Ragoût de diverses sortes de viandes réchauffées."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac3d0e2-f4ed-426f-a0a2-36ddcb0f587c",
                                                "sense_id": "07fd81c0-e804-3b4b-b94a-d53d2976953c",
                                                "text": "Elle fit un salmigondis de toutes les viandes qui étaient restées de la veille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1040d5e-52a2-38a7-9886-63f8c2893216",
                                        "entry_id": "dc5676c4-2e71-3f9d-8d0a-9c5a1890005a",
                                        "glosses": [
                                            "Repas festif où chacun des convives apporte un plat ou une partie du repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5051621-7774-497d-9a2c-976d514afbc5",
                                                "sense_id": "a1040d5e-52a2-38a7-9886-63f8c2893216",
                                                "text": "Je suis invité ce soir chez Lorenzo à un salmigondis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5459188-bfa6-308f-88d7-54a121b1b315",
                                        "entry_id": "dc5676c4-2e71-3f9d-8d0a-9c5a1890005a",
                                        "glosses": [
                                            "Conversation, discours ou écrit où sont mêlées confusément toutes sortes de choses disparates."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10661e3a-ca50-42fe-bbc7-43b1af67d493",
                                                "sense_id": "e5459188-bfa6-308f-88d7-54a121b1b315",
                                                "text": "Sa conversation n’est qu’un salmigondis."
                                            },
                                            {
                                                "example_id": "8a4f68d7-5785-4c69-8048-ec3aba1a105c",
                                                "sense_id": "e5459188-bfa6-308f-88d7-54a121b1b315",
                                                "text": "Ce livre est un salmigondis où il y a quelques bonnes choses mêlées à beaucoup de sottises."
                                            },
                                            {
                                                "example_id": "42298969-a595-4ceb-a47e-c53108829f06",
                                                "sense_id": "e5459188-bfa6-308f-88d7-54a121b1b315",
                                                "text": "Cette coïncidence résulte du grand salmigondis de la Toile, où chacun retient ce qui lui plaît et ajoute ce qui lui passe par la tête, laissant émerger au final de grands fantasmes universels : le prestige d’une haute naissance, et la fascination pour les peuples premiers."
                                            },
                                            {
                                                "example_id": "37c7a3b9-5ba0-4749-9531-5feae2cfd5c2",
                                                "sense_id": "e5459188-bfa6-308f-88d7-54a121b1b315",
                                                "text": "Mourir dans le fatras des illusions factorielles, le salmigondis des puissances, des translations et des monogènes infinis, la bouche pleine de fractions continues et d’exposants et, cependant, sans un mot pour son enfant."
                                            },
                                            {
                                                "example_id": "c3851b45-2e35-41a8-8248-d954e761864f",
                                                "sense_id": "e5459188-bfa6-308f-88d7-54a121b1b315",
                                                "text": "Ces vérités et ces illusions mêlées faisaient un tel salmigondis que le spectre de José Arcadio Buendia, sous le châtaignier, fut pris de convulsions d’impatience et se trouva contraint d’arpenter la maison même en plein jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38bbc7e4-8434-3db6-8133-0a5b386b3968",
                                        "entry_id": "dc5676c4-2e71-3f9d-8d0a-9c5a1890005a",
                                        "glosses": [
                                            "Personnes réunies au hasard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
