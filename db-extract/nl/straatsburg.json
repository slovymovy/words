                "forms": [],
                "senses": [
                    {
                        "sense_id": "eb5abb3c-7ce4-3037-8ea9-42ce5278e2c9",
                        "entry_id": "e9697a05-0092-35e8-a06b-b5ef7b87e136",
                        "glosses": [
                            "hoofdstad van de Franse regio Grand Est en thuisplaats voor diverse Europese instanties"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "99449221-badb-46eb-a274-dd7c5942c2c0",
                                "sense_id": "eb5abb3c-7ce4-3037-8ea9-42ce5278e2c9",
                                "text": "De Raad van Europa is een organisatie waarvan 47 Europese landen lid zijn en zetelt in Straatsburg."
                            },
                            {
                                "example_id": "6682419d-b0fc-4d5a-82b8-d577bdc5cc8b",
                                "sense_id": "eb5abb3c-7ce4-3037-8ea9-42ce5278e2c9",
                                "text": "Rusland erkent het Europese Hof voor de Mensenrechten in Straatsburg niet langer als de hoogste instantie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44003bc4-d76c-4199-b618-efea104bab45",
                        "source_entry_id": "e9697a05-0092-35e8-a06b-b5ef7b87e136",
                        "source_sense_id": "eb5abb3c-7ce4-3037-8ea9-42ce5278e2c9",
                        "source_sense_description": "hoofdstad van de Franse regio Grand Est",
                        "target_lang_word": "Straßburg",
