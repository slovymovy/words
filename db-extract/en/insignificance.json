                                            {
                                                "example_id": "2d397a48-e0ba-46de-8137-694ee4e1a360",
                                                "sense_id": "496c4d90-5a39-35c3-8ed4-9429537ec261",
                                                "text": "Así la poesía femenina reitera ese antiguo lugar común formal, la \"falsa disculpa\", al insistir en las declaraciones sobre su ignorancia, la modestia de sus ambiciones y la insignificancia de sus emprendimientos"
                                            }
