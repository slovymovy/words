                        "translation_id": "e71a5f96-4e95-400c-8927-02e8d049757e",
                        "source_entry_id": "751bcc70-cbfe-36f4-91e6-9d51a1041e5b",
                        "source_sense_id": "39c9159e-6eb7-32c5-b0fe-b5527d0b1b76",
                        "source_sense_description": "Person, die (meist beruflich) Obst anbaut",
                        "target_lang_word": "fruit farmer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ad6b0c52-b3b4-4f28-992a-84941d2f56cb",
                        "source_entry_id": "751bcc70-cbfe-36f4-91e6-9d51a1041e5b",
                        "source_sense_id": "39c9159e-6eb7-32c5-b0fe-b5527d0b1b76",
                        "source_sense_description": "Person, die (meist beruflich) Obst anbaut",
                        "target_lang_word": "arboriculteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arboriculteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31b270b0-ffe5-3343-a556-5c77305b2e24",
                                        "entry_id": "38fc6ea7-73ef-3c0f-b7c7-0162f852f45b",
                                        "glosses": [
                                            "Agriculteur qui cultive des espèces arboricoles, en vue d'en récolter et vendre les fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d97c358-6319-4846-9372-d691e6ba9fd6",
                                                "sense_id": "31b270b0-ffe5-3343-a556-5c77305b2e24",
                                                "text": "Ce qui résulte de tous ces renseignements, c’est que les Bagas étaient déjà, à l’époque de René Caillié (1828), à la fois chasseurs, pêcheurs, pratiqueurs de cueillette et arboriculteurs, pasteurs et cultivateurs."
                                            },
                                            {
                                                "example_id": "ac4f7597-0444-45cc-9e75-5dbf03c0f4af",
                                                "sense_id": "31b270b0-ffe5-3343-a556-5c77305b2e24",
                                                "text": "Les concours agricoles montrent que les éleveurs charolais, limousins ou normands, que les arboriculteurs rhodaniens ou roussillonnais sont à la tête du progrès et le renom de nos crus de vins démontre que nous avons des vignerons qui savent travailler."
                                            },
                                            {
                                                "example_id": "92497b47-7fe9-45c8-895d-722a744956f9",
                                                "sense_id": "31b270b0-ffe5-3343-a556-5c77305b2e24",
                                                "text": "Du côté des arboriculteurs, le moral est bon aussi, à écouter Daniel Sauvaitre, secrétaire général d’Interfel, l’Interprofession de la filière fruits et légumes frais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4506b9c3-a45d-485b-80ba-ff04699d9647",
                        "source_entry_id": "751bcc70-cbfe-36f4-91e6-9d51a1041e5b",
                        "source_sense_id": "39c9159e-6eb7-32c5-b0fe-b5527d0b1b76",
                        "source_sense_description": "Person, die (meist beruflich) Obst anbaut",
                        "target_lang_word": "fruiticulteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fruiticulteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7d0bbc4-e6e7-3e9f-978c-570312b94373",
                                        "entry_id": "e85c0ed9-dd70-3a1b-9b23-8be65f2a5176",
                                        "glosses": [
                                            "Personne qui cultive la terre pour la fruiticulture, pour la production de fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae74ec89-6bc3-45ff-b4e8-7edfa6028868",
                                                "sense_id": "d7d0bbc4-e6e7-3e9f-978c-570312b94373",
                                                "text": "« On n'est pas des casseurs comme en Angleterre, on se bat pour survivre, c'est tout,\" dit un jeune fruiticulteur. — (AFP, « Des fruiticulteurs au bord de l’asphyxie manifestent contre “une concurrence déloyale” » 20Minutes.fr, 12 aout 2011)"
                                            },
                                            {
                                                "example_id": "4c8f73d4-1bb7-45f8-b8c0-8501ca0be6d8",
                                                "sense_id": "d7d0bbc4-e6e7-3e9f-978c-570312b94373",
                                                "text": "Et pour effectuer le travail, des centaines de saisonniers sont actuellement recruter par les fruiticulteurs."
                                            },
                                            {
                                                "example_id": "0ae3fc70-7425-4d64-9edd-8a370979ffa6",
                                                "sense_id": "d7d0bbc4-e6e7-3e9f-978c-570312b94373",
                                                "text": "Un fruiticulteur ou une fruiticultrice est responsable de la plantation, de la culture, de la multiplication, de l’arrosage, de l’irrigation, du repiquage, de la taille et de la récolte de toutes sortes de fruits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
