                "senses": [
                    {
                        "sense_id": "23ffa4bf-d69b-3626-9ec1-dd41ceaf8260",
                        "entry_id": "7af40a75-c2e9-3f0d-bfe9-f3ce89c3ba88",
                        "glosses": [
                            "Dichtungstheorie (Theorie der Poesie), Dichtungslehre, Dichtungskritik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74427c77-5319-4727-9e34-e0001ce59e31",
                                "sense_id": "23ffa4bf-d69b-3626-9ec1-dd41ceaf8260",
                                "text": "„Gewiß gehörte schon im 17. Jahrhundert zur vollkommenen Erziehung eines jungen Mannes eine Unterweisung in den Elementen der Poetik.“"
                            },
                            {
                                "example_id": "6a82689c-2cbd-48be-b542-4e21c12b7ed7",
                                "sense_id": "23ffa4bf-d69b-3626-9ec1-dd41ceaf8260",
                                "text": "„Die Poetik ist nur eine der Disziplinen, die sich mit poetischen Texten beschäftigen.“"
                            },
                            {
                                "example_id": "6a47e839-58d7-4cab-a8fa-d4ce32f6c64f",
                                "sense_id": "23ffa4bf-d69b-3626-9ec1-dd41ceaf8260",
                                "text": "„Hier kommt auch bereits die Poetik mit ins Spiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
