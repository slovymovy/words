                ],
                "senses": [
                    {
                        "sense_id": "0e60e0bf-6ee5-3c0b-96ca-934872fc6d84",
                        "entry_id": "921feb71-d336-3a82-84b1-bf1c7045a564",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "349e4cd2-f9e7-4be7-a271-7203d1607d50",
                                "sense_id": "0e60e0bf-6ee5-3c0b-96ca-934872fc6d84",
                                "text": "Główna bohaterka tragifarsy kołtuńskiej „Moralność pani Dulskiej” Gabrieli Zapolskiej ma na imię Aniela."
                            },
                            {
                                "example_id": "3bf4bdf6-49b3-44c8-b7bb-486d5458b9bb",
                                "sense_id": "0e60e0bf-6ee5-3c0b-96ca-934872fc6d84",
                                "text": "W Kościele katolickim na 4 stycznia przypada wspomnienie św. Anieli z Foligno, mistyczki, pokutnicy i pustelnicy."
                            },
                            {
                                "example_id": "fd572549-dd16-43f5-8ed2-f4ad41b59264",
                                "sense_id": "0e60e0bf-6ee5-3c0b-96ca-934872fc6d84",
                                "text": "Aniele dzień swej patronki, czyli imieniny, obchodzą 4 stycznia, a także 27 stycznia, 28 i 30 marca, 1 i 31 maja, 10 i 21 lipca, 7 października, 18, 20 i 30 listopada."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e41315e-2bd6-4c83-984c-85b61c05dfbe",
                        "source_entry_id": "921feb71-d336-3a82-84b1-bf1c7045a564",
                        "source_sense_id": "0e60e0bf-6ee5-3c0b-96ca-934872fc6d84",
                        "target_lang_word": "Angela",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angela",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b17914f-3dc1-343f-88e5-1c2f8e960b34",
                                        "entry_id": "7dda357a-4f93-3a45-979c-7c00bf8ef956",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f0f5da-4a91-4258-8e3c-31a69579c24d",
                                                "sense_id": "9b17914f-3dc1-343f-88e5-1c2f8e960b34",
                                                "text": "Faire Angela (quoth she) men do her call, / No whit lesse faire, then terrible in fight: / She hath the leading of a Martiall / And mighty people, dreaded more then all / The other Saxons, which do for her sake / And love, themselves of her name Angles call."
                                            },
                                            {
                                                "example_id": "0b1299e8-7d9b-4eac-a312-b7cbaaaf199c",
                                                "sense_id": "9b17914f-3dc1-343f-88e5-1c2f8e960b34",
                                                "text": "And the child was named Angela for the Angelus which rang the midnight hour, the New Year, the minute of her coming and because she was a little angel anyway.\nibid., page 39:\nThe man says his name is Mr. Dimino and that's his wife, Angela, behind the counter. I tell him that's my mother's name. No kiddin', kid. Your mother is Angela? I didn't know the Irish had any Angelas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc1bfcab-3380-4f7d-b5af-fb9004f17417",
                        "source_entry_id": "921feb71-d336-3a82-84b1-bf1c7045a564",
                        "source_sense_id": "0e60e0bf-6ee5-3c0b-96ca-934872fc6d84",
                        "target_lang_word": "Anděla",
                        "target_lang_code": "cs",
