                "senses": [
                    {
                        "sense_id": "70cdb221-37c8-3e47-8ab0-a47f5802a080",
                        "entry_id": "92faf3a8-c8d1-35ec-bc86-07ddf6a7198b",
                        "glosses": [
                            "język, z którego wywodzą się inne języki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738c5543-3f0f-42b6-80cc-f4a2139e377f",
                                "sense_id": "70cdb221-37c8-3e47-8ab0-a47f5802a080",
                                "text": "Pochodzenie języków bantu od wspólnego prajęzyka nie jest dziś w zasadzie przez nikogo podważane."
                            },
                            {
                                "example_id": "1018d6c5-d902-48e6-9c32-b13c11f1e580",
                                "sense_id": "70cdb221-37c8-3e47-8ab0-a47f5802a080",
                                "text": "Trzy najważniejsze grupy językowe: indoaryjska, semicka i mongolska zakładają istnienie jakiegoś wspólnego prajęzyka, bo niektóre podstawowe źródłosłowy są w nich wspólne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
