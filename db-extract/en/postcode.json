                                            {
                                                "example_id": "b67a5911-5844-4e75-aecd-d337bf62c2fe",
                                                "sense_id": "8cfa12c3-e59b-3e00-a7a6-79559e0a2a75",
                                                "text": "Wohnort mit Postleitzahl, Straße und Hausnummer sowie Datum der Unterzeichnung sind lesbar einzutragen."
                                            },
                                            {
                                                "example_id": "cce53336-a885-4f38-a10f-97fb79c34c7c",
                                                "sense_id": "8cfa12c3-e59b-3e00-a7a6-79559e0a2a75",
                                                "text": "„Daher sollte man in der Folgezeit immer ein O oder ein W vor die jeweilige Postleitzahl schreiben.“"
                                            },
                                            {
                                                "example_id": "d62e47a4-8a61-44ce-87dd-6b93530d1b38",
                                                "sense_id": "8cfa12c3-e59b-3e00-a7a6-79559e0a2a75",
                                                "text": "„Postleitzahlen werden im Allgemeinen nicht gegliedert.“"
                                            },
                                            {
                                                "example_id": "858b3da7-e903-48cf-98f4-735e7e5b8e89",
                                                "sense_id": "8cfa12c3-e59b-3e00-a7a6-79559e0a2a75",
                                                "text": "„Postleitzahlen wurden in der DDR am 1. Januar 1965 eingeführt.“"
                                            },
                                            {
                                                "example_id": "2cb0fd46-48a5-4eab-9ab8-d12dde8ba9ed",
                                                "sense_id": "8cfa12c3-e59b-3e00-a7a6-79559e0a2a75",
                                                "text": "„Sie befinden sich jenseits aller Postleitzahlen.“"
                                            }
