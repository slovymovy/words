                "senses": [
                    {
                        "sense_id": "213f25b4-a81e-3580-9447-54f24e774fcd",
                        "entry_id": "2691549b-46b2-30d6-99c3-424bfa88d180",
                        "glosses": [
                            "An opening, an orifice, or a short passage, especially in a bone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17ef180-129c-4496-9e22-e44a4e60418e",
                                "sense_id": "213f25b4-a81e-3580-9447-54f24e774fcd",
                                "text": "The skull contains a number of foramina through which arteries, veins, nerves, and other structures enter and exit."
                            },
                            {
                                "example_id": "73f6c588-9082-48f7-a130-56bc4b9fd709",
                                "sense_id": "213f25b4-a81e-3580-9447-54f24e774fcd",
                                "text": "There is — as I have explained — a slight want of alignment in the cervical vertebrae which has, as I perceive it, the effect of lessening the foramina through which the nerve roots emerge."
                            }
                        ]
                    }
                ],
                "translations": [
