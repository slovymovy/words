            {
                "entry_id": "36b8980e-1774-3bc7-ab66-6b918ec30dfb",
                "word": "anisotrope",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ddd7c002-6ccd-4402-9710-ae5cbb124a43",
                        "entry_id": "36b8980e-1774-3bc7-ab66-6b918ec30dfb",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "anisotropes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                        "entry_id": "36b8980e-1774-3bc7-ab66-6b918ec30dfb",
                        "glosses": [
                            "Qui possède des propriétés différentes selon la direction."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "1bc30e60-a65b-4373-a7af-a6b895ae7b19",
                                "sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                                "text": "Certains cristaux sont anisotropes et présentent une biréfringence : ils dédoublent les images lorsque l’on regarde à travers."
                            },
                            {
                                "example_id": "3138a1ca-5cfe-4113-a8b2-89123e1b2966",
                                "sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                                "text": "Les lunettes de soleil polarisantes sont faites d’un matériau anisotrope."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74405a74-b956-47af-8319-22326d3f830b",
                        "source_entry_id": "36b8980e-1774-3bc7-ab66-6b918ec30dfb",
                        "source_sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                        "target_lang_word": "anisotrop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anisotrop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                        "entry_id": "ebb7988d-6838-3f56-9046-3b0992e198ed",
                                        "glosses": [
                                            "von der Richtung abhängende Eigenschaften zeigend; in Bezug auf die Anisotropie, sie aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a465cf95-2224-4887-bfe6-36d84f921ec1",
                                                "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                                "text": "„Werden bestimmte Raumrichtungen bevorzugt, ist das Material optisch anisotrop und es ergeben sich Ellipsoide mit zwei oder drei Hauptachsen.“"
                                            },
                                            {
                                                "example_id": "6077a330-b178-4a27-a8ef-4a6a4efd4472",
                                                "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                                "text": "„Man denke etwa an eine ebene Welle, die selbstverständlich homogen, aber hochgradig anisotrop ist.“"
                                            },
                                            {
                                                "example_id": "e972b54d-fb07-4cc5-9f83-4dd8907218f2",
                                                "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                                "text": "„Bis zeigt gute aber schwierige Spaltbarkeit in einer Richtung, muscheligen Bruch und ist anisotrop, also nicht kubisch.“"
                                            },
                                            {
                                                "example_id": "87329540-b660-4444-a95d-c837aac6341e",
                                                "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                                "text": "„Hier zu nennen sind die Elastizitätseigenschaften, das anisotrope plastische Verhalten sowie, bei nichtkubischen Kristallen, die anisotrope Wärmeausdehnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ca4814f-2704-4398-8986-9be16a813694",
                        "source_entry_id": "36b8980e-1774-3bc7-ab66-6b918ec30dfb",
                        "source_sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                        "target_lang_word": "anisotropisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anisotropisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd1f92a-49fe-3328-a38b-64bfa5282863",
                                        "entry_id": "aa13e999-63cd-37a2-b64f-05071a767053",
                                        "glosses": [
                                            "von der Richtung abhängende Eigenschaften zeigend; in Bezug auf die Anisotropie, sie aufweisend"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bd05dac-4c5c-43db-ac47-3ba4559a7eb6",
                                                "sense_id": "ebd1f92a-49fe-3328-a38b-64bfa5282863",
                                                "text": "„Gebürstete oder geschliffene Oberflächen besitzen anisotropische Effekte.“"
                                            },
                                            {
                                                "example_id": "77be5626-9735-4e61-80d2-f5ee33a572e9",
                                                "sense_id": "ebd1f92a-49fe-3328-a38b-64bfa5282863",
                                                "text": "„Aufgrund seiner Gefügestruktur weist Holz in radialer, tangentialer und in Längsrichtung unterschiedliche Schwind- und Quelleigenschaften auf, es verhält sich anisotropisch.“"
                                            },
                                            {
                                                "example_id": "a2b2c3d6-b538-44ce-9bf1-99113b6a68f3",
                                                "sense_id": "ebd1f92a-49fe-3328-a38b-64bfa5282863",
                                                "text": "„Diese Krystalle sind anisotropisch, rufen eine chromatische Polarisation hervor und erscheinen mit einer prächtig gelborangen Färbung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fea103d-bb59-4185-9101-b0e31cc4b417",
                        "source_entry_id": "36b8980e-1774-3bc7-ab66-6b918ec30dfb",
                        "source_sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                        "target_lang_word": "anisotropic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anisotropic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6c94be9-1728-367a-b731-af0aed30e656",
                                        "entry_id": "b9b2d6e8-6310-3e31-8384-611ea37f8a8d",
                                        "glosses": [
                                            "Having properties that differ according to the direction of measurement; exhibiting anisotropy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27062907-c540-41a5-ac96-f021d5db139b",
                                                "sense_id": "d6c94be9-1728-367a-b731-af0aed30e656",
                                                "text": "The crystal has an anisotropic structure, as it is stronger along its length than laterally."
                                            },
                                            {
                                                "example_id": "285ed0a6-e963-4f54-b3ed-8a2bf6b296d3",
                                                "sense_id": "d6c94be9-1728-367a-b731-af0aed30e656",
                                                "text": "The obtained low and anisotropic thermal conductivity, and feasibility of synthesis, in addition to other reports on high electron mobility, make arsenene a promising material for a variety of applications, including thermal management and thermoelectric devices.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
