                                "example_id": "c5fb7f6e-52ca-4104-8013-a20bd86920e3",
                                "sense_id": "7720c46d-97f4-3ef7-89fd-e2ae35dd27b5",
                                "text": "Est-ce que la lampe à lumé ?"
