                        "examples": [
                            {
                                "example_id": "adcfe313-0d67-49b2-bcaa-656e62d6f685",
                                "sense_id": "08fae5fd-8341-3be0-9f12-0fab03e71de8",
                                "text": "Lodewijk Napoleon voerde een landelijk uniform belastingstelsel door, richtte een ministerie van Waterstaat op, een ministerie van Eredienst, hervormde het schoolwezen, moedigde ambachten, kunsten en wetenschappen aan en –niet te vergeten– voerde een uniform burgerlijk wetboek in."
                            },
                            {
                                "example_id": "54558123-b062-441a-9d3d-549965a6b575",
                                "sense_id": "08fae5fd-8341-3be0-9f12-0fab03e71de8",
                                "text": "DeVos is voorstander van privaat onderwijs. De nieuwe minister heeft echter geen enkele praktische ervaring in het schoolwezen."
                            }
                        ]
                    }
