                        "glosses": [
                            "Bestleistung im nationalen Vergleich in einer bestimmten Disziplin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b7d27a-2966-4c15-9e8e-9c7a3673243a",
                                "sense_id": "a5a9ee3a-49e9-3926-85f7-b49c670803bb",
                                "text": "Der deutsche 100-Meter-Sprinter müsste schon Landesrekord laufen, um mit den Besten der Welt mithalten zu können."
                            },
                            {
                                "example_id": "f6f1261b-501b-4323-8872-04f2f313d073",
                                "sense_id": "a5a9ee3a-49e9-3926-85f7-b49c670803bb",
                                "text": "„Nackt wie ein Fisch glitt ich mit kräftigen Zügen durchs Becken – es war, als ob mich das Wasser schieben würde – und stellte einen neuen Landesrekord auf.“"
                            }
                        ],
