                        "glosses": [
                            "Instrument avec lequel on coupait et on divisait les calculs vésicaux, afin de l’extraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63cba46c-8074-4146-8454-0b0afc81159e",
                                "sense_id": "610e6396-ef95-34d1-a310-7d8263221f09",
                                "text": "Si le calcul était trop gros, on usait du lithotome à lame mousse, qu’on faisait glisser par la plaie tracée par le bistouri pour fractionner la pierre à l’intérieur de la vessie avant d’en extraire les morceaux, fragments et résidus."
                            }
