                "senses": [
                    {
                        "sense_id": "1f044076-3876-35e5-8212-20139c9dd53d",
                        "entry_id": "a168b413-7ca4-3599-9f8c-f7fc01647b04",
                        "glosses": [
                            "Festtag, am 14. September"
                        ],
                        "tags": [
                            "insbesondere katholische und orthodoxe Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "d700d3ca-9877-47ea-8f84-ed5a5ae8fe27",
                                "sense_id": "1f044076-3876-35e5-8212-20139c9dd53d",
                                "text": "„Das Fest der Kreuzerhöhung erinnert an das Auffinden des Kreuzes Christi am 13. September 326 und dessen feierliche Präsentation in der Grabeskirche am darauffolgenden Tag.“"
                            },
                            {
                                "example_id": "6ab50cc2-0407-4b59-b8fe-56cdcff12613",
                                "sense_id": "1f044076-3876-35e5-8212-20139c9dd53d",
                                "text": "„Das Fest der Kreuzerhöhung ist möglicherweise ursprünglich ein Kirchweihfest, da 14. September 335 die Doppelbasilika durch Kaiser Konstantin geweiht wurde. Dieser Tag wurde jedoch nicht zufällig gewählt, denn der Erzählung nach war es Helena, die Mutter Kaiser Konstantin des Großen, die das Kreuz am 13. September 326 fand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
