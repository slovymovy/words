                                        "glosses": [
                                            "Of, from, or pertaining to Algeria or the Algerian people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb77b172-4fde-450f-b385-c1323fe73006",
                                                "sense_id": "f67c7fb0-c27e-3930-bdb1-a25b6a368d60",
                                                "text": "(Yasmina Khadra is a female pseudonym for a former Algerian army officer, Mohammed Moulessehoul, who lives in France and whose work has once again been overheatedly translated by John Cullen.)"
                                            }
                                        ]
                                    }
