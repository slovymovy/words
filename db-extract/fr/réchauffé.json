                "senses": [
                    {
                        "sense_id": "a10c63b9-1a0f-3c65-8afa-4a29fed1cc56",
                        "entry_id": "d2f312ed-5a7c-3e7c-addc-aa1ee2e7d579",
                        "glosses": [
                            "Qui a été chauffé après avoir été refroidi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86696335-ec2c-4ae7-b911-32bb3507321f",
                                "sense_id": "a10c63b9-1a0f-3c65-8afa-4a29fed1cc56",
                                "text": "Un plat réchauffé."
                            },
                            {
                                "example_id": "d48c92aa-0ba7-4b9b-904a-49777c9e32ba",
                                "sense_id": "a10c63b9-1a0f-3c65-8afa-4a29fed1cc56",
                                "text": "Un dîner réchauffé."
                            },
                            {
                                "example_id": "6544462e-b45b-4354-8fc8-4b72f59d28b2",
                                "sense_id": "a10c63b9-1a0f-3c65-8afa-4a29fed1cc56",
                                "text": "Puis il fit observer au Baron qu’il allait être midi, et qu’il était temps de diriger l’aiguille de la boussole vers le pôle de la soupe, rien n’étant pire qu’un dîner froid, si ce n’est un dîner réchauffé."
                            }
                        ]
                    },
                    {
                        "sense_id": "0cf7ece6-23da-3485-9b43-ea315502b74b",
                        "entry_id": "d2f312ed-5a7c-3e7c-addc-aa1ee2e7d579",
                        "glosses": [
                            "Qui n’a plus froid, après avoir eu froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78bdbd18-0e3f-4a58-9c6b-601136dd2e03",
                                "sense_id": "0cf7ece6-23da-3485-9b43-ea315502b74b",
                                "text": "Vous êtes réchauffé, à présent? demanda Roy. Et il répondit, tout heureux : « Oui, je suis bien réchauffé maintenant. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "3d442e33-cd30-36e2-9316-afa8f7cf92cd",
                        "entry_id": "d2f312ed-5a7c-3e7c-addc-aa1ee2e7d579",
                        "glosses": [
                            "Qui n’a pas froid, bien qu’il devrait, selon le bon sens."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "42bc42ed-2701-4842-84e7-c2472116ca48",
                                "sense_id": "3d442e33-cd30-36e2-9316-afa8f7cf92cd",
                                "text": "(…) mourant de faim il poussa la porte (…) « T’es réchauffé, toi ! fit le patron derrière le bar. Mais si tu fermais ça irait mieux. »"
                            }
                        ]
                    }
                ],
