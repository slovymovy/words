                ],
                "senses": [
                    {
                        "sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                        "entry_id": "28299494-7e75-3d2c-a264-88a128285b8f",
                        "glosses": [
                            "автомобиль, приводимый в движение электродвигателем с питанием от автономного источника электроэнергии, а не двигателем внутреннего сгорания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aae4805-d0b2-4a09-82c0-e76d84f4708c",
                                "sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                                "text": "Клуб электриков сообщал о постройке новой аккумуляторной станции для нужд электромобилей…"
                            },
                            {
                                "example_id": "2674fcbd-d0d3-452a-b79e-89073bf64389",
                                "sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                                "text": "Подсчитано, что двухтонный электромобиль с батареей весом около 200 кг и электрической емкостью 25 квт-час может пройти 130–160 километров без перезарядки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c1e88c0-abe0-4528-a8db-bc5c3361c8c1",
                        "source_entry_id": "28299494-7e75-3d2c-a264-88a128285b8f",
                        "source_sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                        "target_lang_word": "auto elettrica",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auto elettrica",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "1d42c2cb-d19d-386b-9a8d-8d6b51d2339c",
                                        "entry_id": "0ad027c7-352b-390f-a7b2-46c8c6186c16",
                                        "glosses": [
                                            "automobile il cui spostamento è permesso da un motore elettrico"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04a6aeaf-4626-4807-9c75-814388785cb6",
                                                "sense_id": "1d42c2cb-d19d-386b-9a8d-8d6b51d2339c",
                                                "text": "il tempo impiegato per il rifornimento di un'auto per la percorrenza di 500 km, per un'auto elettrica sarebbe 100 volte di più"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6a61be8-d47b-4342-a6ac-c39a39b1d2e8",
                        "source_entry_id": "28299494-7e75-3d2c-a264-88a128285b8f",
                        "source_sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                        "target_lang_word": "Elektroauto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektroauto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d907ad2a-0452-3656-9525-ab741e60d471",
                                        "entry_id": "3e3d6776-2efc-39f3-a01e-75c76293c702",
                                        "glosses": [
                                            "Auto, das von einem Elektromotor angetrieben wird"
                                        ],
                                        "tags": [
                                            "Transport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebcfa5ef-347a-4fb3-b257-4fa40f8de637",
                                                "sense_id": "d907ad2a-0452-3656-9525-ab741e60d471",
                                                "text": "„Der Markt für Elektroautos ist entgegen der Medienpräsenz des Themas (bislang) gering.“"
                                            },
                                            {
                                                "example_id": "b63f3cb3-804f-4470-af69-715f9887215c",
                                                "sense_id": "d907ad2a-0452-3656-9525-ab741e60d471",
                                                "text": "„Die Behauptung, dem Elektroauto fehle zu seinem Glück nur noch eine Oberleitung, zählt unter Fahrzeugbauern zu den bewährten Blödeleien.“"
                                            },
                                            {
                                                "example_id": "17524d0f-aadd-48c2-b7c2-7c68ff2d34db",
                                                "sense_id": "d907ad2a-0452-3656-9525-ab741e60d471",
                                                "text": "„Sicher, ohne ein flächendeckendes Ladenetz für Elektroautos geht es nicht.“"
                                            },
                                            {
                                                "example_id": "e88ef835-3d8e-44b3-8fe6-163aa9e968bd",
                                                "sense_id": "d907ad2a-0452-3656-9525-ab741e60d471",
                                                "text": "„Gut möglich, dass bis dahin die etablierten Hersteller ihre anfängliche Trägheit bei der Entwicklung von Elektroautos überwunden haben.“"
                                            },
                                            {
                                                "example_id": "7d0be0e6-c2d9-4107-b184-b021c6323616",
                                                "sense_id": "d907ad2a-0452-3656-9525-ab741e60d471",
                                                "text": "„Daraus entsteht bei der Stromerzeugung für die Elektroautos relativ viel CO2. Und wenn man eine Gesamtbilanz macht, Betrieb der Elektroautos und Herstellung der Elektroautos, insbesondere der Batterie, dann ergibt sich, dass ein einzelnes Elektroauto von der Klimawirksamkeit her praktisch ähnlich schädlich ist wie ein Benziner oder Diesel.“"
                                            },
                                            {
                                                "example_id": "b0b7ab0f-b638-42e5-8db4-769d9e12342a",
                                                "sense_id": "d907ad2a-0452-3656-9525-ab741e60d471",
                                                "text": "[2025:] „In der Diskussion über Elektroautos halten sich viele Vorurteile über Wertverlust, Reichweite, Ladedauer und Reparaturkosten. Welche stimmen, welche nicht?“"
                                            },
                                            {
                                                "example_id": "3344840d-b302-4c58-9f46-6200167c8bee",
                                                "sense_id": "d907ad2a-0452-3656-9525-ab741e60d471",
                                                "text": "[2025:] „[…] Die Zukunft gehört dem Elektroauto. Es stößt im Betrieb kein CO2 aus und ist über seinen gesamten Lebenszyklus deutlich klimafreundlicher als ein Verbrenner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae81c332-6409-46bd-ad3e-e83740107c4e",
                        "source_entry_id": "28299494-7e75-3d2c-a264-88a128285b8f",
                        "source_sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                        "target_lang_word": "samochód elektryczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6f9ff675-cfc2-4fcd-9fe0-6b8c3457c00b",
                        "source_entry_id": "28299494-7e75-3d2c-a264-88a128285b8f",
                        "source_sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                        "target_lang_word": "elektromobil",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8de1f847-9793-4e9a-99f9-6e2d16f7bde3",
                        "source_entry_id": "28299494-7e75-3d2c-a264-88a128285b8f",
                        "source_sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                        "target_lang_word": "électromobile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électromobile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae8a0ca-5872-3c13-b722-e3551ac2759a",
                                        "entry_id": "2d872478-6344-3f94-9a35-df281016b816",
                                        "glosses": [
                                            "Qui se meut grâce à l’électricité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9240497d-d458-4a42-974e-b1f4dc2a4e81",
                                                "sense_id": "0ae8a0ca-5872-3c13-b722-e3551ac2759a",
                                                "text": "→ Voir l’attestation historique sus-citée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e37d461-3d46-3330-ad22-a311e85ec248",
                                        "entry_id": "2d872478-6344-3f94-9a35-df281016b816",
                                        "glosses": [
                                            "Qui concerne les électromobiles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aca8fcc-cd80-47c0-8c65-af6d8eb8c94d",
                                                "sense_id": "5e37d461-3d46-3330-ad22-a311e85ec248",
                                                "text": "Cette semaine, le site HybridCars.com a rapporté la millionième voiture électrique vendue dans le monde, une étape fort importante a donc été franchie dans l’industrie électromobile."
                                            },
                                            {
                                                "example_id": "eefc221b-1340-4672-8232-9ac29c6f6f3e",
                                                "sense_id": "5e37d461-3d46-3330-ad22-a311e85ec248",
                                                "text": "Entre les acteurs publics et les usagers, les relations formelles se traduisent par des mesures fiscales nationales en défaveur des véhicules polluants (malus écologique) ou en faveur de l’équipement électromobile, mises en œuvre pour pallier le prix élevé du passage à l’électromobilité […]"
                                            },
                                            {
                                                "example_id": "428393b5-df3a-433c-ad94-eeb53146a4f0",
                                                "sense_id": "5e37d461-3d46-3330-ad22-a311e85ec248",
                                                "text": "L’utilisation des piles à combustible, autant que celle des batteries d’accumulateurs, renferme donc de multiples contraintes. S’il en était autrement, la situation du secteur électromobile serait probablement différente de la réalité actuelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "électromobile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f473a39e-35c6-37a2-9001-76de0722fae3",
                                        "entry_id": "a4ac9c8d-d040-3b7c-bf01-7ebedd70917e",
                                        "glosses": [
                                            "Véhicule électrique"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df805d6-7484-4a8d-b2a0-9231ec18cb41",
                                                "sense_id": "f473a39e-35c6-37a2-9001-76de0722fae3",
                                                "text": "Il est évident que les expériences faites ces derniers temps vont attirer, et avec juste motif, l’attention sur les électromobiles, dont les qualités si précieuses ne seraient plus dès lors contre-balancées par les défauts que l’on a pu leur reprocher jusqu’ici"
                                            },
                                            {
                                                "example_id": "7f9682c6-bfbd-47c1-84d4-bef81b8ea9dd",
                                                "sense_id": "f473a39e-35c6-37a2-9001-76de0722fae3",
                                                "text": "Quelques constructeurs arrivèrent bien à obtenir des vitesses très satisfaisantes pendant un certain temps (témoin le « Jamais content » de Jenalzy, record du kilomètre), mais ces électromobiles n’avaient aucune valeur pratique. Les voitures à moteur électrique ont d’autres qualités qui ne sont pas discutables : la simplicité de la construction, la facilité de la direction et l’absolue propreté du fonctionnement. Ces avantages les rendent particulièrement aptes à un services urbain dans toutes les localités où existe une station de force électrique."
                                            },
                                            {
                                                "example_id": "447db8a2-a2fa-4013-b416-896c37a647fd",
                                                "sense_id": "f473a39e-35c6-37a2-9001-76de0722fae3",
                                                "text": "Une électromobile d’un nouveau genre, traversant depuis quelques semaines les rues de Berlin, a été beaucoup remarquée dernièrement, tant par le public qu’intriguait cet étrange véhicule, que par les ingénieurs, qui y voyaient un important progrès de l’hygiène municipale. C’est une arroseuse-balayeuse combinée."
                                            },
                                            {
                                                "example_id": "71ad8f53-f09e-44eb-812a-0e26927ee05a",
                                                "sense_id": "f473a39e-35c6-37a2-9001-76de0722fae3",
                                                "text": "Les avantages de l’électromobile. (Bulletin nᵒ 7 de l'Association suisse des électriciens d’après Electrical World.) — L’électromobile, est dans le cas de parcours réduits et de nombreux arrêts, le moyen de transport le plus approprié."
                                            },
                                            {
                                                "example_id": "fdfeb2b4-fe1d-40c7-a00e-fdbc2e9868e7",
                                                "sense_id": "f473a39e-35c6-37a2-9001-76de0722fae3",
                                                "text": "Dans un futur pas lointain, on sera passé d’une pétromobile à une électromobile."
                                            },
                                            {
                                                "example_id": "6b895e29-83db-4227-bbe8-3b0c368d92c8",
                                                "sense_id": "f473a39e-35c6-37a2-9001-76de0722fae3",
                                                "text": "Décidément ingénieux, il ne compte pas s’arrêter en si bon chemin et prépare maintenant la conversion d’une petite citadine classique et peu onéreuse. Son nouveau pari ? Sortir à 8 000 €, avec une prime verte, une électromobile genre Twingo dotée des mêmes performances qu’une thermique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90f1c4b-4315-3763-8a95-73267e51cc1b",
                                        "entry_id": "a4ac9c8d-d040-3b7c-bf01-7ebedd70917e",
                                        "glosses": [
                                            "Véhicule électrique",
                                            "Voiture électrique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
