                    {
                        "sense_id": "94643236-a195-36ee-a078-614331ae5a6a",
                        "entry_id": "f1b85c8e-e7c4-348b-aab3-316e31de71ef",
                        "glosses": [
                            "Propre aux Yéniches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8429a492-bd0b-480b-acdf-8054cc6ff118",
                                "sense_id": "94643236-a195-36ee-a078-614331ae5a6a",
                                "text": "Roland, l’antiquaire « au bout du rouleau », se changeait les idées en peignant les faux tableaux. Chineur yéniche, Léonard les revendait."
                            },
                            {
                                "example_id": "9cf4b767-7f92-42e8-b21e-4a1fbbff8859",
                                "sense_id": "94643236-a195-36ee-a078-614331ae5a6a",
                                "text": "Portrait d’une jeune femme de la communauté yéniche d’Alsace. Jadis placée en foyer, puis séparée de sa sœur, Belinda, mère à 15 ans, se bat pour ses rêves de famille réunie : faire baptiser son fiston, se marier… malgré la prison."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75107bed-7f35-431b-9929-4001d9ac1cd9",
                        "source_entry_id": "f1b85c8e-e7c4-348b-aab3-316e31de71ef",
                        "source_sense_id": "94643236-a195-36ee-a078-614331ae5a6a",
