                ],
                "senses": [
                    {
                        "sense_id": "9d7eac7f-b4c1-3e15-a7d6-880e588ea70c",
                        "entry_id": "4d956eea-c6e8-3f5b-b5db-7dd475159ff8",
                        "glosses": [
                            "aus größeren Formationen harter Mineralien (Gestein) herausgebrochener Brocken, nicht bearbeitet, daher mehr oder weniger unregelmäßig und scharfkantig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "222d6d38-ac5a-4fc4-b17c-d897bbace101",
                                "sense_id": "9d7eac7f-b4c1-3e15-a7d6-880e588ea70c",
                                "text": "„[…] die Maurer legen fast alle Bruchsteine unbehauen auf ihre winklige Seiten, und füllen die Zwischenräume mit Mörtel aus.“"
                            },
                            {
                                "example_id": "a738cd99-ff7b-49cd-87bc-2f73b4e4d15e",
                                "sense_id": "9d7eac7f-b4c1-3e15-a7d6-880e588ea70c",
                                "text": "„Ich habe […] in einer Rundung dicke Bruchsteine setzen lassen und dahinter Steingartengewächse […] gepflanzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1353e68-c21c-39d3-951a-c3a8f61e6e9c",
                        "entry_id": "4d956eea-c6e8-3f5b-b5db-7dd475159ff8",
                        "glosses": [
                            "[1] als Material/Grundstoff; sehr kleine Brocken →Splitt/Schotter"
                        ],
                        "tags": [
                            "collective",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "37d42f92-de34-44bf-8beb-d90a5a985838",
                                "sense_id": "e1353e68-c21c-39d3-951a-c3a8f61e6e9c",
                                "text": "„Aus der Bruchstein-Zementmörtel-Bauweise wurde in den 1860er Jahren rasch die Stampfbetonbauweise, also das Bauen mit Bruchstein oder Kies und Zementmörtel, […]“"
                            },
                            {
                                "example_id": "65f33a2b-05bd-475a-b6de-31c677548d1b",
                                "sense_id": "e1353e68-c21c-39d3-951a-c3a8f61e6e9c",
                                "text": "„Vom Feigenbaume verdeckt, […] wird der Eingang in diese Höhle durch ein niedriges […] aus Bruchstein und reichlichem Mörtel gebildetes Mauerwerk verschlossen.“"
                            },
                            {
                                "example_id": "1d5998ea-b5fb-455a-8b96-85f1d46f05da",
                                "sense_id": "e1353e68-c21c-39d3-951a-c3a8f61e6e9c",
                                "text": "„Sämmtliche Pfeiler sind […] bis zum Sockel aus Quadern und Hausteinen, von da aber aus mit Bruchstein gemischtem Ziegelmauerwerk […] hergestellt.“"
                            },
                            {
                                "example_id": "a44c5f39-8efd-4694-9623-c7a0b31ef347",
                                "sense_id": "e1353e68-c21c-39d3-951a-c3a8f61e6e9c",
                                "text": "„Der reine Kalk ist sowohl als Bruchstein, als auch in Form von Quadern als vorzüglicher Baustein geschätzt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ced3497-4791-4aad-ab8f-efe9866f111b",
                        "source_entry_id": "4d956eea-c6e8-3f5b-b5db-7dd475159ff8",
                        "source_sense_id": "e1353e68-c21c-39d3-951a-c3a8f61e6e9c",
                        "source_sense_description": "Baumaterial aus unbearbeiteten Steinen",
                        "target_lang_word": "rubble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rubble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "The broken remains of an object, usually rock or masonry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8fac65a-71ab-4493-920d-e1809b8bd185",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "The main East Coast line from Edinburgh to Berwick was blocked at Cockburnspath and Grantshouse by flood water, which washed away part of an embankment, and by the collapse of about 300 tons of rubble on to the track."
                                            },
                                            {
                                                "example_id": "4c06c861-e286-49e7-8d70-d44c8fabe967",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "The old boulevard now was a sagging ruin, waiting for the wreckers. … You'd have to loathe yourself vividly to be indifferent to such destruction or, worse, rejoice at the crushing of the locus of these middle-class settlements, glad that history had made rubble of them."
                                            },
                                            {
                                                "example_id": "cda0aea3-0c8e-4382-9e8b-6cc71cbe7883",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale.[…]Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ee50b7-6235-3c4a-9077-3646c34eb1ec",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "A mass or stratum of fragments of rock lying under the alluvium and derived from the neighbouring rock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ba0d85-a578-439f-b97f-e4baed25a644",
                                                "sense_id": "55ee50b7-6235-3c4a-9077-3646c34eb1ec",
                                                "text": "The overlying beds are composed of such calcareous rubble and flints, rudely stratified"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c9de155-140c-34bb-bf85-a98a64033ebd",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "The whole of the bran of wheat before it is sorted into pollard, bran, etc."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rubble",
