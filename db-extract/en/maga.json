                        ],
                        "examples": [
                            {
                                "example_id": "65469b17-3058-47ed-8155-56c4c6fb80b7",
                                "sense_id": "5ca5855f-96ab-3ee4-a6f6-5b7a4a2e67a2",
                                "text": "In America today this takes at least two forms: tight-fitting clothes that display the shoulders, biceps and thighs (see the straining suit seams of Jeff Bezos and the younger Magas) […]."
                            }
                        ]
                    }
                ],
                "translations": [],
