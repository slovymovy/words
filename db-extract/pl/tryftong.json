                "senses": [
                    {
                        "sense_id": "0d394024-00c7-3b4d-b27f-386fe5deb6e8",
                        "entry_id": "40ddcf55-2b67-3f08-a1f5-7f052c37eb51",
                        "glosses": [
                            "dźwięk samogłoskowy o zmiennym przebiegu artykulacji, będący złożeniem samogłoski i dwóch półsamogłosek; przez użytkowników języka postrzegany jako złożenie trzech samogłosek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4c9e5b-5223-4284-9b9f-9f706728d14a",
                                "sense_id": "0d394024-00c7-3b4d-b27f-386fe5deb6e8",
                                "text": "Nazwę chińskiej sztuki geomancji, \"feng shui\", Polacy wymawiają jak \"feng szuj\", a tymczasem w chińskim \"shui\" zawiera tryftong [uei], a nie dyftong [ui] i tę sylabę powinno wymawiać się jak \"szłej\"."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ab2bfac-a9f6-4293-901b-b7c0614ba10d",
                        "source_entry_id": "40ddcf55-2b67-3f08-a1f5-7f052c37eb51",
                        "source_sense_id": "0d394024-00c7-3b4d-b27f-386fe5deb6e8",
                        "target_lang_word": "triphthong",
                        "target_lang_code": "en",
