                                        "sense_id": "78bbdc2c-31db-3e65-bb53-4290e2362f1a",
                                        "entry_id": "ef814716-e7df-3ae6-a44a-25ba74d1606e",
                                        "glosses": [
                                            "Any medicine, such as aspirin, that reduces pain, especially without inducing a loss of other sensation. (Contrast anesthetic.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e471ed2b-5ecc-431b-af0c-e1355d4382c5",
                                                "sense_id": "78bbdc2c-31db-3e65-bb53-4290e2362f1a",
                                                "text": "I am taking an analgesic. Is it safe to drink alcoholic beverages?"
                                            },
                                            {
                                                "example_id": "3ed524a2-dd2e-4820-9466-11d362aececc",
                                                "sense_id": "78bbdc2c-31db-3e65-bb53-4290e2362f1a",
                                                "text": "2010, Associated Press staff, Cadence signs option to buy Incline (original copy), Bloomberg Businessweek"
                                            }
                                        ]
                                    }
                                ]
                            },
