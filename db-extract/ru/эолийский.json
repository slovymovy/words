                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "äolisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b424a23-2c1b-3e07-8da8-894f35a76212",
                                        "entry_id": "a71730cd-0c64-3e6d-b6c0-e44192eb92f6",
                                        "glosses": [
                                            "durch den Wind bedingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cec899c-3327-48c9-9a50-e599f6df2ffe",
                                                "sense_id": "9b424a23-2c1b-3e07-8da8-894f35a76212",
                                                "text": "Der Lößboden in der Soester Börde entstand wegen äolischer Ablagerungen."
                                            },
                                            {
                                                "example_id": "76c27293-6ec6-443b-b1d0-378bba388756",
                                                "sense_id": "9b424a23-2c1b-3e07-8da8-894f35a76212",
                                                "text": "Da der Name Tuff ganz allgemein äolisch verfrachtete vulkanitische Sedimente bezeichnet, gibt es in Abhängigkeit des Ursprungsortes Unterschiede des Materials, die sich auch in den Namen niederschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f57bfd82-7463-32a3-a84a-820338c758f6",
                                        "entry_id": "a71730cd-0c64-3e6d-b6c0-e44192eb92f6",
                                        "glosses": [
                                            "eine alte Kirchentonart"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddfe4bc6-325d-4755-9479-6107da68767e",
                                                "sense_id": "f57bfd82-7463-32a3-a84a-820338c758f6",
                                                "text": "Die Kirchentonart äolisch kommt der Skala des modernen Tongeschlechts Moll sehr nahe."
                                            },
                                            {
                                                "example_id": "252d2b71-a1ec-4c1e-85c1-360695f944b1",
                                                "sense_id": "f57bfd82-7463-32a3-a84a-820338c758f6",
                                                "text": "Die Kirchentonarten äolisch (sowie hypoäolisch, ionisch, hypoionisch) wurden durch H. Glarean 1547 dem System der acht klassischen Kirchentonarten angegliedert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fda1d9b3-50e6-3111-9f8e-a15eecd589aa",
                                        "entry_id": "a71730cd-0c64-3e6d-b6c0-e44192eb92f6",
                                        "glosses": [
                                            "die altgriechische Landschaft Äolien betreffend, zu Äolien gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e2776d-809d-4664-b35f-e44640b60587",
                                                "sense_id": "fda1d9b3-50e6-3111-9f8e-a15eecd589aa",
                                                "text": "Sie wohnten im äolisch ionischen Grenzgebiet um Smyrna."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "db53a52b-6fc1-3eb6-b596-d171eb0c60e5",
                                        "entry_id": "a71730cd-0c64-3e6d-b6c0-e44192eb92f6",
                                        "glosses": [
                                            "metrisch, mit fester Silbenanzahl"
                                        ],
                                        "tags": [
                                            "antike Versform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1ddac2-01b2-4e55-b234-90235858d327",
                                                "sense_id": "db53a52b-6fc1-3eb6-b596-d171eb0c60e5",
                                                "text": "Ein metrischer Unterschied tritt zwischen den äolisch und lydisch gesetzten logaödischen Epioikien nicht hervor."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
