                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "01ba9ca0-a473-3d08-a1c4-41a2b8df6d5f",
                        "entry_id": "f64ef8eb-86ec-385a-9702-1ad4503b1a4c",
                        "glosses": [
                            "To eat hastily or in a slovenly manner, as liquid food."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d8d4ac4b-40a5-35e8-9a18-7c04205cf328",
                        "entry_id": "f64ef8eb-86ec-385a-9702-1ad4503b1a4c",
                        "glosses": [
                            "To wet and befoul by liquids falling carelessly from the mouth; slaver; slobber."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "668dec95-4233-4c3e-a5e3-2dcb67f0e25f",
                                "sense_id": "d8d4ac4b-40a5-35e8-9a18-7c04205cf328",
                                "text": "At the ſame time he clap'd me on the Back, and ſlabber'd me all over from Cheek to Cheek, vvith his great Tongue."
                            }
                        ]
                    },
                    {
                        "sense_id": "0105ecd1-d162-3a45-840f-e755644c6c7b",
                        "entry_id": "f64ef8eb-86ec-385a-9702-1ad4503b1a4c",
                        "glosses": [
                            "To cover, as with a liquid spill; soil; befoul."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cb8b650f-15c6-4014-b255-5a2d9c4d5813",
                                "sense_id": "0105ecd1-d162-3a45-840f-e755644c6c7b",
                                "text": "The milk pan and cream pot so slabbered and tost / That butter is wanting and cheese is half lost."
                            }
                        ]
                    }
