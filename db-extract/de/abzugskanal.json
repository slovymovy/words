                "senses": [
                    {
                        "sense_id": "81f26e52-13c7-3cdb-8ae0-0eab599dfbed",
                        "entry_id": "19d0647a-a4c5-32fa-bf5b-dcf02c9e6ce7",
                        "glosses": [
                            "(künstlich erbauter) Kanal oder Graben, durch den Flüssigkeiten (zum Beispiel Abwasser oder Regenwasser) oder andere Substanzen abgeführt oder abgeleitet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21331e0d-9a73-4088-9301-c0a0f356be35",
                                "sense_id": "81f26e52-13c7-3cdb-8ae0-0eab599dfbed",
                                "text": "„Nicht lange, da brach auch der unterirdische Abzugskanal zusammen, der das Mineralwasser aus dem unter dem Tempel befindlichen Brunnenschacht in die Aue leitete.“"
                            },
                            {
                                "example_id": "bea8107f-c6fe-4d8f-9675-78808430db63",
                                "sense_id": "81f26e52-13c7-3cdb-8ae0-0eab599dfbed",
                                "text": "„Der Abzugskanal oder Tobel, der zweite Abschnitt des Wildbaches, ist eine verhältnismäßig enge, oft sehr tief eingerissene Schlucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
