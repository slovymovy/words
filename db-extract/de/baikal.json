                "senses": [
                    {
                        "sense_id": "f1f93653-efd9-31d9-a57f-d7a48c750570",
                        "entry_id": "fc466d6c-8fbe-3cd1-85a9-712c120a9e01",
                        "glosses": [
                            "See in Sibirien (Russland), Kurzform von Baikalsee; tiefster See der Erde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e8ccb8-dba9-48a0-8629-e656a46f79d5",
                                "sense_id": "f1f93653-efd9-31d9-a57f-d7a48c750570",
                                "text": "„Der Baikal bildet zudem das größte Reservoir flüssigen Süßwassers der Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f44f4aa-aef5-473f-969c-b2b496668fb0",
                        "source_entry_id": "fc466d6c-8fbe-3cd1-85a9-712c120a9e01",
                        "source_sense_id": "f1f93653-efd9-31d9-a57f-d7a48c750570",
                        "source_sense_description": "See in Sibirien (Russland), Kurzform von Baikalsee; tiefster See der Erde",
                        "target_lang_word": "Βαϊκάλη",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Βαϊκάλη",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "3c3effe2-6cd9-31d3-b939-1d47ab6d3118",
                                        "entry_id": "911a250f-6208-3306-992e-8aaab9c81bfe",
                                        "glosses": [
                                            "λίμνη της Ρωσίας στην Ασία (νότια Σιβηρία)"
                                        ],
                                        "tags": [
                                            "υδρωνύμιο"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e61a2db-ff2f-4aca-9e1e-39db085fc23e",
                                                "sense_id": "3c3effe2-6cd9-31d3-b939-1d47ab6d3118",
                                                "text": "※ Η αλματώδης αύξηση ενός είδους φυκιών (spirogyra) στην λίμνη Βαϊκάλη είναι ένα ζήτημα που απασχολεί του ρώσους επιστήμονες, οι οποίοι προς το παρόν δεν μπορούν να αξιολογήσουν το μέγεθος της, αλλά την αποδίδουν στα λύματα που πέφτουν στην λίμνη, στους τουρίστες και στην υπερθέρμανση του πλανήτη.",
                                                "translation": "Σε βάλτο κινδυνεύει να μετατραπεί η λίμνη Βαϊκάλη, Το Βήμα, 13 Απριλίου 2018"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "763b2231-f34e-4db9-95e0-906632241a64",
                        "source_entry_id": "fc466d6c-8fbe-3cd1-85a9-712c120a9e01",
                        "source_sense_id": "f1f93653-efd9-31d9-a57f-d7a48c750570",
                        "source_sense_description": "See in Sibirien (Russland), Kurzform von Baikalsee; tiefster See der Erde",
                        "target_lang_word": "Байкал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Байкал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "44db3fb8-2b33-349e-8b37-db8117255d4d",
                                        "entry_id": "6e440ac9-30aa-32d0-88f9-a8ac51ac20d6",
                                        "glosses": [
                                            "геогр. озеро тектонического происхождения в южной части Восточной Сибири, самое глубокое озеро на Земле, крупнейший природный резервуар пресной воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725262b3-8f44-46e6-b96b-402cef8769f1",
                                                "sense_id": "44db3fb8-2b33-349e-8b37-db8117255d4d",
                                                "text": "На нажитые во время службы деньги он организовал перевозку пассажиров через Байкал."
                                            },
                                            {
                                                "example_id": "5600e22a-0ac1-408b-b96f-4c9664d5bd8f",
                                                "sense_id": "44db3fb8-2b33-349e-8b37-db8117255d4d",
                                                "text": "Миновав небольшое шестидесятивёрстное расстояние между Иркутском и Байкалом, я вскоре увидел перед собой громадную водную гладь этого озера, обставленного высокими горами, на вершине которых ещё виднелся, местами лежащий, снег. 〈…〉 Осенью, когда на Байкале свирепствуют сильные ветры, скорость и правильность сообщения зависела исключительно от состояния погоды."
                                            },
                                            {
                                                "example_id": "77f86afd-07dc-47ee-b18d-964fbf123742",
                                                "sense_id": "44db3fb8-2b33-349e-8b37-db8117255d4d",
                                                "text": "Помнится, когда я ехал по берегу Байкала, мне встретилась девушка бурятка, в рубахе и в штанах из синей дабы, верхом на лошади"
                                            },
                                            {
                                                "example_id": "3e7ef944-2078-46da-b3f1-bf917f1139f5",
                                                "sense_id": "44db3fb8-2b33-349e-8b37-db8117255d4d",
                                                "text": "Недаром Байкал своими частыми и сильными бурями и случающимися на берегах его землетрясениями вызывал у обитающих вокруг него бурят и тунгусов религиозный страх; они приносили Байкалу жертвы и молились ему, называя его святым."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
