                        "source_sense_id": "a76a7482-f7d4-3bd3-b880-b2decf067287",
                        "target_lang_word": "secret commercial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secret commercial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35414b8d-6925-3f1c-9c37-ca1847b3e8d2",
                                        "entry_id": "7653e0a3-317c-32c0-8964-67142deabd34",
                                        "glosses": [
                                            "Secret, information confidentielle d’une entreprise sur le plan commercial, dont la divulgation nuirait à ses affaires."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd6c4ae-2d6d-4046-86f2-d37a45bf6d16",
                                                "sense_id": "35414b8d-6925-3f1c-9c37-ca1847b3e8d2",
                                                "text": "L’objet du secret industriel et commercial, proprement indéfini par la loi, répond à des fins d’appropriation et de protection de biens matériels et immatériels contre l’usurpation ou la publication."
                                            },
                                            {
                                                "example_id": "7051e667-2b1d-4726-a577-772872c255a5",
                                                "sense_id": "35414b8d-6925-3f1c-9c37-ca1847b3e8d2",
                                                "text": "En droit français et européen, le secret des affaires ou le secret d’affaires se sont récemment substitués au secret commercial."
                                            },
                                            {
                                                "example_id": "54aa5861-19a7-4e0f-a113-ebcc34422cc3",
                                                "sense_id": "35414b8d-6925-3f1c-9c37-ca1847b3e8d2",
                                                "text": "Le quotidien Le Monde estime en novembre 2018 que « La non-transparence au nom du secret commercial a été l’un des principaux obstacles aux 1 500 demandes d’accès aux documents publics effectuées au cours de l’enquête internationale » portant sur les « Implant Files »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62531471-5025-42b2-995a-edd9382102a0",
                        "source_entry_id": "527ad84c-cbc8-3a8f-8399-60a335352b37",
                        "source_sense_id": "a76a7482-f7d4-3bd3-b880-b2decf067287",
                        "target_lang_word": "secret d’affaires",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secret d’affaires",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99fa99da-6153-3a66-ab07-cccad4377b7c",
                                        "entry_id": "d8d5d49e-a454-3ba4-9ecb-c9ccff60edee",
                                        "glosses": [
                                            "Secret, information confidentielle d’une entreprise sur le plan commercial, dont la divulgation nuirait à ses affaires."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "046d91ea-a7ac-4bdb-aad1-405280847dc4",
                                                "sense_id": "99fa99da-6153-3a66-ab07-cccad4377b7c",
                                                "text": "Le secret d’affaires n’est pas inconnu en droit français, mais il ne dispose ni d’une définition unifiée ni d’aucune protection légale, à l’exception – très limitée - de l’incrimination de la violation du secret de fabrique."
                                            },
                                            {
                                                "example_id": "207df456-ed97-4650-a124-33e8db4c23a1",
                                                "sense_id": "99fa99da-6153-3a66-ab07-cccad4377b7c",
                                                "text": "En droit français et européen, le secret des affaires ou le secret d’affaires se sont récemment substitués au secret commercial."
                                            },
                                            {
                                                "example_id": "729efb1e-a43b-4285-b38f-78e57bf1eff6",
                                                "sense_id": "99fa99da-6153-3a66-ab07-cccad4377b7c",
                                                "text": "Le principe de transparence comporte des exceptions en cas d’intérêts prépondérants au maintien du secret (par exemple sûreté de la Suisse, atteinte à la sphère privée, secret professionnel ou secret d’affaires)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60df6d8b-7261-42d4-b2c1-db8b2d6f52f4",
                        "source_entry_id": "527ad84c-cbc8-3a8f-8399-60a335352b37",
                        "source_sense_id": "a76a7482-f7d4-3bd3-b880-b2decf067287",
                        "target_lang_word": "secret des affaires",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secret des affaires",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc8a0464-5f61-3eaf-a221-93525a3f4f3d",
                                        "entry_id": "fdc69535-d46d-3e3a-9802-34250d86fdf9",
                                        "glosses": [
                                            "Secret, information confidentielle d’une entreprise sur le plan commercial, dont la divulgation nuirait à ses affaires."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11811484-c48a-41cb-8917-27b9f9ce708a",
                                                "sense_id": "dc8a0464-5f61-3eaf-a221-93525a3f4f3d",
                                                "text": "Mais c’est surtout le rapport parlementaire confié en 2003 au député du Tarn Bernard Carayon sur «Intelligence économique, compétitivité et cohésion sociale » qui reprit et développa la recommandation de « créer un droit du secret des affaires, à caractère civil et/ou pénal » : « La France ignore le secret des affaires. Il s’agit d’une grave lacune pour la protection du patrimoine des entreprises. Celles-ci sont dépositaires d’un nombre considérable d’informations dont l’addition représente le véritable patrimoine de l’entreprise. ... rien d’aussi cohérent et efficace, par exemple, que la législation américaine en la matière née du Cohen Act. »"
                                            },
                                            {
                                                "example_id": "8bf49e23-580d-4cba-8432-0316ff18b185",
                                                "sense_id": "dc8a0464-5f61-3eaf-a221-93525a3f4f3d",
                                                "text": "En droit français et européen, le secret des affaires ou le secret d’affaires se sont récemment substitués au secret commercial."
                                            },
                                            {
                                                "example_id": "94ff4bed-b647-447d-9f0e-68617accb42f",
                                                "sense_id": "dc8a0464-5f61-3eaf-a221-93525a3f4f3d",
                                                "text": "L’encadrement juridique du secret industriel et des affaires est l’actualité législative (II) … une récente proposition de loi réprimant l’atteinte au « secret des affaires » pourrait instaurer une classification « d’informations à caractère économique protégées », sur le modèle du régime du secret-défense."
                                            },
                                            {
                                                "example_id": "6a321695-b831-4b85-9cd8-fe5121bb37f5",
                                                "sense_id": "dc8a0464-5f61-3eaf-a221-93525a3f4f3d",
                                                "text": "Outre l’objet et les conditions de la protection des secrets des affaires, la loi du 30 juillet comporte deux volets, l’un relatif aux actions destinées à la prévention, la cessation ou la réparation d’une atteinte au secret des affaires (chapitre II), l’autre aux mesures générales de protection du secret des affaires devant les juridictions civiles ou commerciales (chapitre III)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
