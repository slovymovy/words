            "senses": [
                {
                    "sense_id": "56b91216-5ce7-37c7-ac4e-6553faba3384",
                    "sense_definition": "die Lippen zusammenziehen, kräuseln oder leicht vorschieben, meist als mimischer Ausdruck von Skepsis, Spott oder Geringschätzung",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mimik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als er die schlechte Nachricht hörte, begann er missbilligend die Lippen zu <w>schürzen</w>."
                        },
                        {
                            "text": "Sie sah ihn zweifelnd an und <w>schürzte</w> spöttisch die Lippen, bevor sie antwortete."
                        }
                    ],
                    "common_phrases": [
                        "die Lippen schürzen"
                    ]
                },
                {
                    "sense_id": "99efe7a7-cb59-350b-8c35-e129e9256b48",
                    "sense_definition": "ein langes Kleidungsstück, insbesondere einen Rock, am Körper hochnehmen oder nach oben zusammenraffen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kleidung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Um nicht im tiefen Schlamm zu versinken, <w>schürzte</w> die Bäuerin ihren langen Rock."
                        },
                        {
                            "text": "Vor dem Durchqueren des flachen Baches mussten alle Frauen ihre Röcke vorsichtig <w>schürzen</w>."
                        }
                    ],
                    "synonyms": [
                        "raffen"
                    ],
                    "common_phrases": [
                        "den Rock schürzen"
                    ]
                },
                {
                    "sense_id": "59641f6c-ef46-3d0e-9865-e21cfcfd086f",
                    "sense_definition": "etwas Längliches, wie Haar oder Schnüre, an seinem Ende zusammenfassen und zu einem Knoten binden",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "binden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der schweren Arbeit auf dem Feld <w>schürzte</w> sie ihr langes Haar zu einem festen Knoten."
                        },
                        {
                            "text": "Die Magd <w>schürzte</w> das Seil geschickt, damit die Ladung sicher auf dem Wagen hielt."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "heute selten und veraltend verwendet"
                        }
                    ]
                }
            ]
        }
