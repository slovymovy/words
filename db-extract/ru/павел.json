                ],
                "senses": [
                    {
                        "sense_id": "fbaa1da4-f4c0-3b80-8240-db0ea314209a",
                        "entry_id": "c6bfee60-c637-32bf-a37c-bb4abeb1f6e5",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c33e51-09e4-41a1-9baf-f9f240cc47bd",
                                "sense_id": "fbaa1da4-f4c0-3b80-8240-db0ea314209a",
                                "text": "Павел сделал всё, что надо молодому парню: купил гармонику, рубашку с накрахмаленной грудью, яркий галстух, галоши, трость и стал такой же, как все подростки его лет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c758b1c4-385f-4cbd-9624-bf0588204868",
                        "source_entry_id": "c6bfee60-c637-32bf-a37c-bb4abeb1f6e5",
                        "source_sense_id": "fbaa1da4-f4c0-3b80-8240-db0ea314209a",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Paul",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a015c0b-b607-332f-9b5b-ca4781ff74b0",
                                        "entry_id": "0f1c1de1-0102-374c-9fad-8bbf607c320b",
                                        "glosses": [
                                            "In the New Testament, Saul, Apostle to the Gentiles and author of fourteen epistles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70268359-c0b8-4106-9e4e-8f5eeddc1078",
                                                "sense_id": "5a015c0b-b607-332f-9b5b-ca4781ff74b0",
                                                "text": "Then Saul, (who also is called Paul,) filled with the Holy Ghost, set his eyes on him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f18d24b-6200-3104-8d66-2d4d7d490cba",
                                        "entry_id": "0f1c1de1-0102-374c-9fad-8bbf607c320b",
                                        "glosses": [
                                            "A male given name from Latin of biblical origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91afefb-ad05-49c8-97b6-5eda128b4502",
                                                "sense_id": "2f18d24b-6200-3104-8d66-2d4d7d490cba",
                                                "text": "'He will be christened Paul, my - Mrs Dombey - of course.'\nShe feebly echoed, 'Of course,' or rather expressed it by the motion of her lips, and closed her eyes again.\n'His father's name, Mrs Dombey, and his grandfather's! I wish his grandfather were alive this day! There is some inconvenience in the necessity of writing Junior,' said Mr Dombey, making a fictitious autograph on his knee; 'but it is merely of a private and personal complexion. It doesn't enter into the correspondence of the House. Its signature remains the same.'"
                                            },
                                            {
                                                "example_id": "2709a4b4-ff36-4721-83bc-0d627660d298",
                                                "sense_id": "2f18d24b-6200-3104-8d66-2d4d7d490cba",
                                                "text": "Primarily seen as a publicity vehicle for late-year releases, the awards show and its promoters have lately made pretensions to Oscar oracling: Jamie Foxx won the “breakthrough actor of the year” prize for “Ray” in 2004, after all, and Paul Haggis and his ensemble cast were honored for “Crash” four months before it won best picture."
                                            },
                                            {
                                                "example_id": "802eb440-bf66-401d-b8b5-5c051eb2cdee",
                                                "sense_id": "2f18d24b-6200-3104-8d66-2d4d7d490cba",
                                                "text": "Toyota spokesman Paul Hogard said the automaker wants speedometers to be easy to read, so there’s value in placing the typical operating speed of American cars, 45 mph to 70 mph, he said, at the top of the speedometer, which is the easiest place on the speedometer for the driver to read."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fad4a59-33b0-3b9b-8826-6aec80ae2113",
                                        "entry_id": "0f1c1de1-0102-374c-9fad-8bbf607c320b",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b9e5b56-4df1-423b-b14d-a18f63f0ee8e",
                                                "sense_id": "0fad4a59-33b0-3b9b-8826-6aec80ae2113",
                                                "text": "In a Fox Business interview on Tuesday, Sen. Rand Paul (R–Ky.) alluded to the distinction between private and government responses to offensive speech, but his comments were ambiguous enough that an uncharitable viewer could easily interpret them as approval of the latter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69458af9-044c-314d-a704-0f88464f8ffc",
                                        "entry_id": "0f1c1de1-0102-374c-9fad-8bbf607c320b",
                                        "glosses": [
                                            "A place name:",
                                            "An unincorporated community in Conecuh County, Alabama, United States, named after Paul the Apostle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edca645e-5e30-331c-b9c6-94193b694f62",
                                        "entry_id": "0f1c1de1-0102-374c-9fad-8bbf607c320b",
                                        "glosses": [
                                            "A place name:",
                                            "A city in Minidoka County, Idaho, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7722abd3-19ae-390a-a746-659ab07ec8db",
                                        "entry_id": "0f1c1de1-0102-374c-9fad-8bbf607c320b",
                                        "glosses": [
                                            "A place name:",
                                            "An unincorporated community in Otoe County, Nebraska, United States."
                                        ],
                                        "tags": [],
