                                                "example_id": "4721589f-cbd6-4398-9141-0c9d33a7b17f",
                                                "sense_id": "6037ee2a-e349-3863-aff3-be5ffbbaa41e",
                                                "text": "God send 'em good shipping."
                                            }
                                        ]
                                    }
                                ]
