{
    "word_family": [
        "éclat",
        "éclatant",
        "éclatement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b55fb75-e1bf-3637-a7f3-712fa1c1a108",
                    "sense_definition": "Se rompre, exploser ou se briser violemment en plusieurs fragments sous l'effet d'une pression interne ou d'un choc.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ballon trop gonflé a fini par <w>éclater</w> au milieu du salon."
                        },
                        {
                            "text": "La bouteille en verre a <w>éclaté</w> après avoir passé la nuit au congélateur."
                        }
                    ],
                    "synonyms": [
                        "exploser"
                    ],
                    "common_phrases": [
                        "faire éclater un ballon"
                    ]
                },
                {
                    "sense_id": "7396e96e-0831-392b-9b42-e58715a6322a",
                    "sense_definition": "S'amuser intensément et prendre beaucoup de plaisir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plaisir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants adorent ce parc aquatique et s'<w>éclatent</w> tout l'après-midi."
                        },
                        {
                            "text": "Nous nous sommes vraiment <w>éclatés</w> au concert de notre groupe préféré hier."
                        }
                    ],
                    "synonyms": [
                        "s'amuser"
                    ],
                    "antonyms": [
                        "s'ennuyer"
                    ],
                    "common_phrases": [
                        "s'éclater à une fête"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "49c5b8ea-3daa-37e7-95cb-3dbfad2d0b9b",
                    "sense_definition": "Se manifester ou commencer brutalement et soudainement, en parlant d'un conflit, d'une crise ou d'un phénomène.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La guerre a <w>éclaté</w> après des mois de vives tensions à la frontière."
                        },
                        {
                            "text": "Un incendie destructeur a <w>éclaté</w> en pleine nuit dans le centre de la ville."
                        }
                    ],
                    "synonyms": [
                        "débuter",
                        "survenir"
                    ],
                    "common_phrases": [
                        "éclater en pleine nuit",
                        "faire éclater la vérité"
                    ]
                },
                {
                    "sense_id": "07767d53-88fe-3eb2-a702-50ac18619afd",
                    "sense_definition": "Retentir avec force ou se manifester par une réaction sonore soudaine et vive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand le comédien a fait cette grimace, la salle a <w>éclaté</w> de rire."
                        },
                        {
                            "text": "Le tonnerre vient d'<w>éclater</w> avec fracas juste au-dessus du village."
                        }
                    ],
                    "common_phrases": [
                        "éclater de rire",
                        "éclater en sanglots"
                    ]
                },
                {
                    "sense_id": "892e9b70-59b0-3999-b8cb-2fc1d5e11a13",
                    "sense_definition": "Exprimer brusquement sa colère ou son mécontentement après s'être longtemps retenu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir écouté ses provocations sans rien dire, le directeur a fini par <w>éclater</w>."
                        },
                        {
                            "text": "Il essayait de garder son calme mais sa colère menaçait d'<w>éclater</w> à chaque instant."
                        }
                    ],
                    "synonyms": [
                        "s'emporter"
                    ],
                    "common_phrases": [
                        "finir par éclater",
                        "éclater de rage"
                    ]
                },
                {
                    "sense_id": "d55f3919-4bca-3b95-a8b7-12752b40a504",
                    "sense_definition": "Briller d'une lumière vive ou attirer vivement le regard par son éclat ou sa beauté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les dorures du palais royal <w>éclataient</w> sous le soleil de midi."
                        },
                        {
                            "text": "Ce nouveau maquillage fait <w>éclater</w> le bleu profond de ses yeux."
                        }
                    ],
                    "synonyms": [
                        "briller",
                        "rayonner"
                    ],
                    "common_phrases": [
                        "faire éclater sa beauté"
                    ]
                },
                {
                    "sense_id": "e84761c6-4744-39b1-93b2-cfe174cd1b6a",
                    "sense_definition": "Frapper violemment ou blesser brutalement quelqu'un ou une partie du corps.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me suis <w>éclaté</w> le genou sur le coin de cette table basse."
                        },
                        {
                            "text": "Le cycliste a glissé sur le sol mouillé et s'est <w>éclaté</w> contre le mur."
                        }
                    ],
                    "synonyms": [
                        "blesser"
                    ],
                    "common_phrases": [
                        "s'éclater contre le mur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "0c486f05-09bd-37ab-adae-e0d68b8fe291",
                    "sense_definition": "Se disloquer, se séparer ou cesser d'exister en tant qu'entité unie sous l'effet de fortes tensions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La coalition politique risque d'<w>éclater</w> à cause des désaccords budgétaires."
                        },
                        {
                            "text": "Après plusieurs années de disputes internes, le groupe de musique a fini par <w>éclater</w>."
                        }
                    ],
                    "synonyms": [
                        "se disloquer"
                    ],
                    "common_phrases": [
                        "menacer d'éclater"
                    ]
                }
            ]
        }
    ]
}