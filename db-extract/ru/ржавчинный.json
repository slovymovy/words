                        "glosses": [
                            "имеющий цвет ржавчины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17f640f-173e-4e7a-a733-26907a963060",
                                "sense_id": "372cd665-2cfa-3437-9157-09b53b7a0092",
                                "text": "Бражник липовый или Зубчатокрыльница липовая (Smerinthus tiliae), имеет от 63 до 75 мм в размахе крыльев. Передние крылья с зубчатыми краями; цвет их весьма изменчивый — оливково-зелёный или ржавчинный .."
                            }
                        ]
