                ],
                "senses": [
                    {
                        "sense_id": "29222b9b-7b00-37de-8f59-52983f647fee",
                        "entry_id": "6e7542db-9e89-3616-ab3e-00f6e98109ba",
                        "glosses": [
                            "großes zylinderartiges Trinkgefäß, meist mit Henkel, häufig mit aufklappbarem Deckel versehen, aus dem vorzugsweise Bier getrunken wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b5e61e-925d-4c47-88e5-3c65981fbb9e",
                                "sense_id": "29222b9b-7b00-37de-8f59-52983f647fee",
                                "text": "„Auf mich allein gestellt, ging ich im Wohnzimmer umher und nahm allerlei Gegenstände in die Hand: verstaubte Porzellanteller, einen alten Humpen aus dem Münchener Hofbräuhaus und eine abgegriffene Ausgabe der Maritimen Weltgeschichte.“"
                            },
                            {
                                "example_id": "79ea549e-007f-4f75-82a6-dd6505fc1fdf",
                                "sense_id": "29222b9b-7b00-37de-8f59-52983f647fee",
                                "text": "„Die übrig gebliebene Hälfte der Speisen stellte er auf den Ladentisch, ließ noch zwei Humpen Wein holen und bat dann den Geschäftsführer Fu, den vierten Fei, den Schwiegersohn Tschen, Lai-sing und Lai-an zum Schmause.“"
                            },
                            {
                                "example_id": "2fe85bb1-6948-483c-867d-2f4ef02e9831",
                                "sense_id": "29222b9b-7b00-37de-8f59-52983f647fee",
                                "text": "„So dunkel war mir die Eichentäfelung, die Holzgalerie mit Humpen und Jagdtrophäen noch nie vorgekommen.“"
                            },
                            {
                                "example_id": "511cd421-b554-4559-8297-d7b87a7d6745",
                                "sense_id": "29222b9b-7b00-37de-8f59-52983f647fee",
                                "text": "„Der Henker des Königs legte sich auf den Boden und küßte weinend Jón Hreggvidsson die Füße, dieweil der Bauer singend seinen Humpen schwang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
