                "senses": [
                    {
                        "sense_id": "40234afd-c41a-3335-975e-cc63b7711e4b",
                        "entry_id": "1f2c39a8-72aa-373c-beff-b0033da4c7f1",
                        "glosses": [
                            "More formal synonym of тако́й (takój) in the main determiner and pronoun senses. Mainly used in certain collocations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e1ec102-b26a-4d33-8a42-111bc533d865",
                                "sense_id": "40234afd-c41a-3335-975e-cc63b7711e4b",
                                "text": "как таково́й",
                                "translation": "per se",
                                "english": "per se"
                            },
                            {
                                "example_id": "146ed32a-7572-43ba-81a8-fc0b0e9b7c61",
                                "sense_id": "40234afd-c41a-3335-975e-cc63b7711e4b",
                                "text": "отсу́тствие таково́го",
                                "translation": "lack thereof",
                                "english": "lack thereof"
                            },
                            {
                                "example_id": "26dd8e21-b63b-4f16-b9bb-75113c1d8219",
                                "sense_id": "40234afd-c41a-3335-975e-cc63b7711e4b",
                                "text": "Они́ должны́ остава́ться таковы́ми.",
                                "translation": "They should remain that way / as such.",
                                "english": "They should remain that way / as such."
                            },
                            {
                                "example_id": "69165646-8d5f-4181-9de2-3d34ddb962ed",
                                "sense_id": "40234afd-c41a-3335-975e-cc63b7711e4b",
                                "text": "с согла́сия по́льзователя и́ли без таково́го",
                                "translation": "with or without the user's consent",
                                "english": "with or without the user's consent"
                            },
                            {
                                "example_id": "963ac20a-fbe8-4cab-8464-cf32949f568d",
                                "sense_id": "40234afd-c41a-3335-975e-cc63b7711e4b",
                                "text": "Таково́е бы́ло полу́чено 16-го с/м.",
                                "translation": "The same (the aforementioned item) was received on the 16th inst. (of this month)",
                                "english": "The same (the aforementioned item) was received on the 16th inst. (of this month)"
                            }
                        ]
                    }
