                "senses": [
                    {
                        "sense_id": "0986b926-22c3-318d-98fd-98c7ed01e27f",
                        "entry_id": "836b9b8e-6f9e-3e6e-8e86-ee0249a9affd",
                        "glosses": [
                            "stevig, met slijmvlies bedekt bindweefsel dat de tandkassen in het kaakbeen omhult en de tandhalzen omgeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98b493e2-c560-42b4-8ca1-6cafc2b479c4",
                                "sense_id": "0986b926-22c3-318d-98fd-98c7ed01e27f",
                                "text": "Deze indrukwekkende demonstratie van betrokkenheid van de kant van de majordomus had een onverwachte uitwerking op de gevleide dichteres. Ze begon te schateren, waarbij zichtbaar werd hoe haar tanden verankerd waren in de met roze tandvlees overtrokken mandibula van haar schedel. Het was bijna angstaanjagend hoe grappig zij de goedbedoelde declamatie van haar eigen meesterwerk achtte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f11332e-23bf-4dcc-ab86-9db56d227bb0",
                        "source_entry_id": "836b9b8e-6f9e-3e6e-8e86-ee0249a9affd",
                        "source_sense_id": "0986b926-22c3-318d-98fd-98c7ed01e27f",
                        "source_sense_description": "deel van het mondslijmvlies waarin de tanden vastzitten",
                        "target_lang_word": "Zahnfleisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnfleisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                        "entry_id": "a4ea2ccf-89cc-3d9c-a466-328da9ab95c8",
                                        "glosses": [
                                            "ein Teil der Mundschleimhaut, der an den Zähnen anliegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c02171-c43a-48e0-b213-79b004e7f710",
                                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                                "text": "Mein Arzt hat gestern zu mir gemeint, mein Zahnfleisch sehe nicht gut aus."
                                            },
                                            {
                                                "example_id": "e8237549-da78-4d59-9804-2118614632ac",
                                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                                "text": "„Gleichzeitig reinigte er das Zahnfleisch und den Gaumen mit dem starken Getränk.“"
                                            },
                                            {
                                                "example_id": "18831e99-f0e2-4c77-a271-9b2612412f2b",
                                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                                "text": "„Fast alle kauten auf irgendwelchen blassgrünen Zweigen herum, die die Zähne säuberten und das Zahnfleisch massierten.“"
                                            },
                                            {
                                                "example_id": "66a3efbe-5587-44ef-8741-716c95ddeb11",
                                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                                "text": "„Linksseitig kamen mir meine Zähne plötzlich locker vor, als würden sie sich durch das schnelle Aufeinanderschlagen aus dem Zahnfleisch lösen.“"
                                            },
                                            {
                                                "example_id": "3816237a-7d39-4de5-9f1d-acd58fe39180",
                                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                                "text": "„2010 wurde sein erster geruhsamer Sommer seit Langem dadurch getrübt, dass seine Zunge und sein Zahnfleisch wund waren, was ihm Schmerzen beim Essen bereitete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
