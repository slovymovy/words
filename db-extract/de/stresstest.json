                ],
                "senses": [
                    {
                        "sense_id": "f4a141bd-a727-39f5-8b98-8a06354c8f73",
                        "entry_id": "a019f160-ea8d-355c-a78b-58cd7a1a861e",
                        "glosses": [
                            "Testverfahren, um die (physischen oder psychischen) Reaktionen einer Person auf Stress (-bedingungen/ -situationen) zu untersuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe082f59-e9c8-414f-80d4-afbc0860d321",
                                "sense_id": "f4a141bd-a727-39f5-8b98-8a06354c8f73",
                                "text": "„8.4 Klinischer Stresstest. Der Stresstest dient zur objektiven Darstellung einer Belastungsinkontinenz und sollte bei gut gefüllter Blase vorgenommen werden. […] Eine Operationssimulation bedeutet eine Erweiterung des Stresstestes, die aber nicht wissenschaftlich untersucht wurde: Werden die Mitturethra oder der Blasenhals bilateral unterstützt bzw. angehoben und der Stresstest fällt dann negativ aus, werden die Operationen wahrscheinlich erfolgreich sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00d7c225-4afd-3bc8-a267-c45e7d22fd04",
                        "entry_id": "a019f160-ea8d-355c-a78b-58cd7a1a861e",
                        "glosses": [
                            "(anhand mathematischer Modelle rechnerische) Überprüfung, ob etwas in einer Extremsituation funktionsfähig bleibt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "404c398b-345d-4177-8e07-893c98f21e9d",
                                "sense_id": "00d7c225-4afd-3bc8-a267-c45e7d22fd04",
                                "text": "Das umstrittene Projekt Stuttgart21 hat den geforderten Stresstest bestanden."
                            },
                            {
                                "example_id": "6a51979f-ad70-4c69-ba9a-25abf8375079",
                                "sense_id": "00d7c225-4afd-3bc8-a267-c45e7d22fd04",
                                "text": "Auch bei Atomkraftwerken und Banken wurden im Jahr 2011 Stresstests durchgeführt."
                            },
                            {
                                "example_id": "52dba515-aa43-4732-914a-b41f3d4d447a",
                                "sense_id": "00d7c225-4afd-3bc8-a267-c45e7d22fd04",
                                "text": "„Denn der Alltag mit Kindern entpuppt sich als ultimativer Stresstest für eine Beziehung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
