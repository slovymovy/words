                ],
                "senses": [
                    {
                        "sense_id": "97106502-a729-3806-923c-bde88b8e16a6",
                        "entry_id": "6b171604-3ce6-36ef-b00e-7a8b10cc9f63",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "359e480c-6635-42a3-a625-3030d67de553",
                                "sense_id": "97106502-a729-3806-923c-bde88b8e16a6",
                                "text": "Frau Meinhold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "30180b23-abae-4543-8eda-ac5dfe6327c0",
                                "sense_id": "97106502-a729-3806-923c-bde88b8e16a6",
                                "text": "Herr Meinhold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8dc4a5bf-794f-4b97-a457-38d34b1ea2d0",
                                "sense_id": "97106502-a729-3806-923c-bde88b8e16a6",
                                "text": "Die Meinholds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e58dd7e4-5575-40e6-9118-caeb161f7749",
                                "sense_id": "97106502-a729-3806-923c-bde88b8e16a6",
                                "text": "Der Meinhold trägt nie die Schals, die die Meinhold ihm strickt."
                            },
                            {
                                "example_id": "7a07e9ab-fa27-4414-9952-360dd3a6ae0d",
                                "sense_id": "97106502-a729-3806-923c-bde88b8e16a6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meinhold kommt, geht der Herr Meinhold.“"
                            },
                            {
                                "example_id": "a8973279-ff92-40ca-800d-9e8f5413a5cd",
                                "sense_id": "97106502-a729-3806-923c-bde88b8e16a6",
                                "text": "Meinhold kommt und geht."
                            },
                            {
                                "example_id": "edbf02d6-5958-41cb-bfb9-6490de100450",
                                "sense_id": "97106502-a729-3806-923c-bde88b8e16a6",
                                "text": "Meinholds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
