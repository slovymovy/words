                                        "sense_id": "cbd6909e-9b95-3353-8672-1f551a270512",
                                        "entry_id": "46979fc5-39c8-374a-9b91-15106e47191d",
                                        "glosses": [
                                            "A thug; a usually muscular henchman with little intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d3a7f14-b98a-40e5-aa20-699ff4096796",
                                                "sense_id": "cbd6909e-9b95-3353-8672-1f551a270512",
                                                "text": "Efforts to unionize were routinely met with clubbings, shootings, jailings, blacklistings and executions, perpetrated not only by well-armed legions of company goons, but also by police officers, deputies, National Guardsmen and even regular soldiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54b2cd0d-e131-35e5-a1b1-a77ed1dccc0f",
                                        "entry_id": "46979fc5-39c8-374a-9b91-15106e47191d",
                                        "glosses": [
                                            "A hired and paid person who is assigned to terrorize and kill opponents."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e131e35-6f27-3416-b578-a5c2b7319ee5",
                                        "entry_id": "46979fc5-39c8-374a-9b91-15106e47191d",
                                        "glosses": [
                                            "A fool; someone who is silly, stupid, awkward, or outlandish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ee64df-b743-4094-98b9-ad289a44c9cd",
                                                "sense_id": "4e131e35-6f27-3416-b578-a5c2b7319ee5",
                                                "text": "Mr. Campion appeared suitably impressed and she warmed to him. He was very easy to talk to with those long clown lines in his pale face, a natural goon, born rather too early she suspected."
                                            },
                                            {
                                                "example_id": "f065372a-310d-4e0a-be44-2a0826d1cdab",
                                                "sense_id": "4e131e35-6f27-3416-b578-a5c2b7319ee5",
                                                "text": "Sending for the goon who sent for me / He's thinking he's hard, yeah, it's Little T"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0398302-7919-3f64-8533-1b73d6eb1cea",
                                        "entry_id": "46979fc5-39c8-374a-9b91-15106e47191d",
                                        "glosses": [
                                            "An enforcer or fighter."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c70dbae1-3d59-4eeb-b241-3f6c3180a8f7",
                                                "sense_id": "e0398302-7919-3f64-8533-1b73d6eb1cea",
                                                "text": "[…]a scout from the Flames came down from Saskatoon, said, \"There's always room on our team for a goon\""
