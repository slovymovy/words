                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d73b4286-76df-304d-9f11-082827d8c1b9",
                        "entry_id": "9fc0dadb-a552-3d1f-b858-dad379435993",
                        "glosses": [
                            "charakterystyczny dla autokraty (jako cecha)"
                        ],
                        "tags": [],
