                "senses": [
                    {
                        "sense_id": "e8367175-4b85-35c3-8d41-c2738ad0dfef",
                        "entry_id": "42c3dda3-c905-3fd9-8db4-2144842db0f3",
                        "glosses": [
                            "episch dichtstuk in een aantal korte strofen waarin tragische gebeurtenissen verteld worden"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d0285585-d061-301b-a1dc-5f2be86d2f25",
                        "entry_id": "42c3dda3-c905-3fd9-8db4-2144842db0f3",
                        "glosses": [
                            "zangstuk met een verhalend karakter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa7624e-54a0-4395-87b4-e932c79be0e1",
                                "sense_id": "d0285585-d061-301b-a1dc-5f2be86d2f25",
                                "text": "In Georgië is het nog steeds 1982. De tijd dat zangeressen nog zelf hun lange japon bij elkaar stikten en iedereen dacht dat een galmende ballade de juiste manier was om de luisteraar in het hart te raken. Eurovisienostalgie dus. Net als het begrip ‘roemloze uitschakeling’ Georgië bekend moet voor komen."
                            },
                            {
                                "example_id": "17d3427a-5f03-4107-8981-3959cab472c7",
                                "sense_id": "d0285585-d061-301b-a1dc-5f2be86d2f25",
                                "text": "Ze luisterden naar de ballade van talloze krekels en het ritme van de zee op de achtergrond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed31d966-e53b-463e-bac8-d4f8a9e6abb5",
                        "source_entry_id": "42c3dda3-c905-3fd9-8db4-2144842db0f3",
                        "target_lang_word": "ballad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e387ac6-b90a-35f4-a77d-8adfde98adae",
                                        "entry_id": "9cf9595a-4501-3edb-8132-3bf3de8e448e",
                                        "glosses": [
                                            "A kind of narrative poem, adapted for recitation or singing; especially, a sentimental or romantic poem in short stanzas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c667c964-6d16-4d21-b51c-ab8827e7a522",
                                                "sense_id": "3e387ac6-b90a-35f4-a77d-8adfde98adae",
                                                "text": "The poet composed a ballad praising the heroic exploits of the fallen commander."
                                            },
                                            {
                                                "example_id": "eb01b845-b709-4118-bf30-fdb060f5cd41",
                                                "sense_id": "3e387ac6-b90a-35f4-a77d-8adfde98adae",
                                                "text": "Of all varieties of poetry, the Ballad, in the form which it affects among us, in distinction to other countries, is, perhaps, one of the most attractive."
                                            },
                                            {
                                                "example_id": "229e19b5-64d0-4325-9d50-8627460ffcfa",
                                                "sense_id": "3e387ac6-b90a-35f4-a77d-8adfde98adae",
                                                "text": "A wandering minstrel I — / A thing of shreds and patches, / Of ballads, songs and snatches, / And dreamy lullaby!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c0a7e6-1984-3820-b865-1cf85f82da42",
                                        "entry_id": "9cf9595a-4501-3edb-8132-3bf3de8e448e",
                                        "glosses": [
                                            "A slow romantic song."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f819af05-3a08-4974-bb48-94a1cd2915d8",
                                                "sense_id": "f4c0a7e6-1984-3820-b865-1cf85f82da42",
                                                "text": "On Friday nights, the roller rink had a time-block called \"Lovers' Lap\" when they played nothing but ballads on the overhead speakers."
                                            },
                                            {
                                                "example_id": "ccf9d66a-dc36-4101-9108-595f4d4f62c8",
                                                "sense_id": "f4c0a7e6-1984-3820-b865-1cf85f82da42",
                                                "text": "He was playing the guitar and singing a ballad to his girlfriend while she was playing the drums."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ballad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "925329e3-db9f-31cf-b7db-cae8283dd0eb",
                                        "entry_id": "146592d8-b4ff-3040-be4b-04ac21b7c873",
                                        "glosses": [
                                            "To make mention of in ballads."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0dd1bfe3-37fd-3d3b-ac52-69c8d3c73687",
                                        "entry_id": "146592d8-b4ff-3040-be4b-04ac21b7c873",
                                        "glosses": [
                                            "To compose or sing ballads."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf43cacf-153e-4ab2-961a-f14550c99a4e",
                        "source_entry_id": "42c3dda3-c905-3fd9-8db4-2144842db0f3",
                        "target_lang_word": "ballade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d9b8cda-874f-3f50-828d-467a95602718",
                                        "entry_id": "aded4397-ab15-3e61-999c-e203da7862fb",
                                        "glosses": [
                                            "Any of various genres of single-movement musical pieces having lyrical and narrative elements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f625aa-c6b9-4907-9836-93cfb204d4cc",
                                                "sense_id": "8d9b8cda-874f-3f50-828d-467a95602718",
                                                "text": "Thus, when he drew up instructions in lawyer language […] his clerks […] understood him very well. If he had written a love letter, or a farce, or a ballade, or a story, no one, either clerks, or friends, or compositors, would have understood anything but a word here and a word there."
                                            },
                                            {
                                                "example_id": "e1ce7cc2-38ef-46b3-879c-38b7a50b5b8b",
                                                "sense_id": "8d9b8cda-874f-3f50-828d-467a95602718",
                                                "text": "\"Dead and gone!\" as Andrew Lang re-echoes in a sweetly mournful ballade[…"
                                            },
                                            {
                                                "example_id": "7ef77482-e6a3-455d-bd85-2b4e206f48e7",
                                                "sense_id": "8d9b8cda-874f-3f50-828d-467a95602718",
                                                "text": "Even a 10-minute Chopin ballade for piano, let alone Messiaen’s 75-minute “Turangalila Symphony,” tries to grapple with, activate and organize a relatively substantial span of time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "952c9bf3-b839-362f-ad97-f4daa77405e2",
                                        "entry_id": "aded4397-ab15-3e61-999c-e203da7862fb",
                                        "glosses": [
                                            "A poem of one or more triplets of seven- or eight-line stanzas, each ending with the same line as refrain, and usually an envoi; more generally, any poem in stanzas of equal length."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
