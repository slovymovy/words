                ],
                "senses": [
                    {
                        "sense_id": "8ca828df-d1dd-3335-8d59-6c95b70a2000",
                        "entry_id": "8579c696-c1e4-35b1-aa33-1e945e481a72",
                        "glosses": [
                            "Transbahuter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4104c8-9f6e-4685-bbcd-e526b7394e9a",
                                "sense_id": "8ca828df-d1dd-3335-8d59-6c95b70a2000",
                                "text": "Deux heures de temps j’ai connu ce plaisir rare,cette joie sans pareille, je peux dire ce pied, ce pied de voir mon comité, dont les femmes, me remonter, me retransbahuter sur quatre étages, et du lourd, du meuble de tradition, mes affaires."
                            },
                            {
                                "example_id": "740a41ab-bedb-4deb-9324-cc405c7153be",
                                "sense_id": "8ca828df-d1dd-3335-8d59-6c95b70a2000",
                                "text": "Nous devons retransbahuter nos bagages."
                            },
                            {
                                "example_id": "9682bfc4-ca93-4ed9-aa77-57ca8b91a54c",
                                "sense_id": "8ca828df-d1dd-3335-8d59-6c95b70a2000",
                                "text": "Sur ce, tu aurais rechargé en ayant oublié de retransbahuter tes objets car tu aurais gardé l'illusion de tes artefacts présents à la Couronne."
                            },
                            {
                                "example_id": "709f9e49-eafb-415a-b8c0-372d3cd463b5",
                                "sense_id": "8ca828df-d1dd-3335-8d59-6c95b70a2000",
                                "text": "Dimanche soir, on a retransbahuté les cartons déjà faits, les cartons pas encore faits, l'espèce d'étagère en osier et les plantes envahissantes du bureau vers le salon."
                            }
                        ]
                    }
                ],
