                                                "text": "literary fame"
                                            },
                                            {
                                                "example_id": "5da860b4-cea0-496a-ab91-9b83bc98e7c6",
                                                "sense_id": "99df58a0-5c7f-3ea1-bf4c-6ded893ecffa",
