                "senses": [
                    {
                        "sense_id": "14143ac8-c74f-3efc-9a19-323dc5405c4b",
                        "entry_id": "5031b324-bb0f-386f-8e64-335e47e78bb5",
                        "glosses": [
                            "A waterfall."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69cdc063-e9cb-49b7-ac02-3032214a73dd",
                                "sense_id": "14143ac8-c74f-3efc-9a19-323dc5405c4b",
                                "text": "Niagara Falls"
                            },
                            {
                                "example_id": "ecc8aabc-1239-4454-acaa-7fa72a0584bf",
                                "sense_id": "14143ac8-c74f-3efc-9a19-323dc5405c4b",
                                "text": "And climbed up through the woods, past the lake island where the white gazebo stood up to its knees in mist, up to where a falls fell melodiously into a deep dark pool."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82c7f84b-7dd1-49f8-a8ae-50a9a01a0c67",
                        "source_entry_id": "5031b324-bb0f-386f-8e64-335e47e78bb5",
                        "source_sense_id": "14143ac8-c74f-3efc-9a19-323dc5405c4b",
                        "source_sense_description": "waterfall",
                        "target_lang_word": "Wasserfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c5ef9ca-156b-347c-9d58-ef4b8750e29b",
                                        "entry_id": "098f8d13-f759-3173-8657-e32612be05ea",
                                        "glosses": [
                                            "senkrechte Überwindung einer Höhenstufe durch einen Fluss (von oben nach unten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1e6de1-dc27-4a69-bde1-39cea5c3f300",
                                                "sense_id": "8c5ef9ca-156b-347c-9d58-ef4b8750e29b",
                                                "text": "Der Rheinfall bei Schaffhausen ist ein bekannter Wasserfall."
                                            },
                                            {
                                                "example_id": "d51a7b90-b83a-4e48-bcfe-eb6c8b4d2166",
                                                "sense_id": "8c5ef9ca-156b-347c-9d58-ef4b8750e29b",
                                                "text": "Bakayoko Hamed wischt sich den Schweiß von der Stirn. Der Abstieg zum Wasserfall ist steil, die Steine glitschig."
                                            },
                                            {
                                                "example_id": "acfd7510-4391-4886-8aad-1d4c124ddafa",
                                                "sense_id": "8c5ef9ca-156b-347c-9d58-ef4b8750e29b",
                                                "text": "„Evoziert wird eine Situation des Höhenschwindels, die an Rousseaus Faszination für Wasserfälle und Abgründe erinnert.“"
                                            },
                                            {
                                                "example_id": "e22062e4-af80-4b73-828f-5b737f55b0be",
                                                "sense_id": "8c5ef9ca-156b-347c-9d58-ef4b8750e29b",
                                                "text": "„Wir gingen weiter, folgten einer Flußbiegung - und sahen nicht etwa den erwarteten Wasserfall vor uns.“"
                                            },
                                            {
                                                "example_id": "bc637af7-ab22-4b49-b7a6-65381c499837",
                                                "sense_id": "8c5ef9ca-156b-347c-9d58-ef4b8750e29b",
                                                "text": "„Dieser Wasserfall ist nämlich so imposant, dass die Meisten wieder aufwachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wasserfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10003392-d9b6-3dec-a1e7-3144b92ccc36",
                                        "entry_id": "0119ccd5-da4a-3a73-8069-2fc45e77d256",
                                        "glosses": [
                                            "Ort in NRW, Ortsteil von Bestwig, Gemeinde im Sauerland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4383976-7fdb-4dae-a292-8aec27bda888",
                                                "sense_id": "10003392-d9b6-3dec-a1e7-3144b92ccc36",
                                                "text": "„Der Ort Wasserfall verdankt seinen Namen dem einzigen natürlichen Wasserfall in Nordrhein-Westfalen, der allerdings je nach Niederschlagsmenge nur periodisch wasserführend ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wasserfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5959421e-f13a-3515-8a72-c725533fd8bf",
                                        "entry_id": "e708b13d-c61a-3198-8500-1332c3cdf00c",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e69e0e3-1368-4f4b-9738-de2593448eba",
                                                "sense_id": "5959421e-f13a-3515-8a72-c725533fd8bf",
                                                "text": "„Kurt Wasserfall (* 28. Mai 1952 in Göttingen) ist ein deutscher Kinder- und Jugendbuchautor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
