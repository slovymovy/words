{
    "word_family": [
        "condition",
        "conditioner",
        "conditioning"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aada50ed-ed82-349f-9748-90308ee03c20",
                    "sense_definition": "Determined or dependent on a specific condition or circumstance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dependent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The offer is <w>conditioned</w> on the buyer signing the contract today.",
                            "target_lang_translations": {
                                "nl": "Het aanbod is <w>afhankelijk van</w> het feit dat de koper vandaag het contract ondertekent."
                            }
                        },
                        {
                            "text": "Success is often <w>conditioned</w> by the amount of effort one puts in.",
                            "target_lang_translations": {
                                "nl": "Succes is vaak <w>afhankelijk van</w> de hoeveelheid inspanning die men levert."
                            }
                        }
                    ],
                    "synonyms": [
                        "dependent",
                        "contingent"
                    ],
                    "antonyms": [
                        "unconditioned"
                    ],
                    "common_phrases": [
                        "conditioned on"
                    ],
                    "target_lang_definitions": {
                        "nl": "Afhankelijk van een bepaalde voorwaarde of omstandigheid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afhankelijk",
                                "target_lang_sense_clarification": "gebaseerd op een voorwaarde"
                            },
                            {
                                "target_lang_word": "onderworpen aan",
                                "target_lang_sense_clarification": "gebonden aan een voorwaarde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b7b67cf-7c5f-3a86-bb46-fefa2f426091",
                    "sense_definition": "Physically fit or healthy, especially as a result of regular exercise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athletes were well <w>conditioned</w> for the long marathon race.",
                            "target_lang_translations": {
                                "nl": "De atleten waren goed <w>getraind</w> voor de lange marathon."
                            }
                        },
                        {
                            "text": "Regular training keeps the body <w>conditioned</w> for high-intensity sports.",
                            "target_lang_translations": {
                                "nl": "Regelmatige training houdt het lichaam <w>in conditie</w> voor sporten met hoge intensiteit."
                            }
                        }
                    ],
                    "synonyms": [
                        "fit",
                        "trained"
                    ],
                    "target_lang_definitions": {
                        "nl": "Fysiek fit of gezond, vooral als resultaat van regelmatige training."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "getraind",
                                "target_lang_sense_clarification": "fysiek voorbereid door training"
                            },
                            {
                                "target_lang_word": "in conditie",
                                "target_lang_sense_clarification": "fysiek fit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "296984fc-8de0-36fe-af76-f2746f75a054",
                    "sense_definition": "Prepared or treated for a specific use or environment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prepared",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wood must be properly <w>conditioned</w> before it is used for furniture.",
                            "target_lang_translations": {
                                "nl": "Het hout moet goed <w>behandeld</w> worden voordat het voor meubels wordt gebruikt."
                            }
                        },
                        {
                            "text": "The air in the room is <w>conditioned</w> to maintain a constant temperature.",
                            "target_lang_translations": {
                                "nl": "De lucht in de kamer wordt <w>geconditioneerd</w> om een constante temperatuur te behouden."
                            }
                        }
                    ],
                    "synonyms": [
                        "treated",
                        "prepared"
                    ],
                    "common_phrases": [
                        "air conditioned"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorbereid of behandeld voor een specifiek gebruik of omgeving."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "behandeld",
                                "target_lang_sense_clarification": "klaargemaakt voor gebruik"
                            },
                            {
                                "target_lang_word": "geconditioneerd",
                                "target_lang_sense_clarification": "technisch behandeld (zoals lucht)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aff2f53-ea29-3aa2-8227-63b0e1cd9e9d",
                    "sense_definition": "Exhibiting a learned behavioral response to a specific stimulus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavioral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>conditioned</w> to salivate at the sound of a bell.",
                            "target_lang_translations": {
                                "nl": "De hond was <w>geconditioneerd</w> om te kwijlen bij het horen van een bel."
                            }
                        },
                        {
                            "text": "Humans can be <w>conditioned</w> to react to certain social cues automatically.",
                            "target_lang_translations": {
                                "nl": "Mensen kunnen <w>geconditioneerd</w> worden om automatisch op bepaalde sociale signalen te reageren."
                            }
                        }
                    ],
                    "antonyms": [
                        "unconditioned"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het vertonen van een aangeleerde gedragsreactie op een specifieke prikkel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geconditioneerd",
                                "target_lang_sense_clarification": "aangeleerd gedrag door herhaling"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab56e5b4-f48c-3fb4-af1a-64baaba79f51",
                    "sense_definition": "Simple past and past participle of <w>condition</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach <w>conditioned</w> the team to play under pressure.",
                            "target_lang_translations": {
                                "nl": "De coach <w>conditioneerde</w> het team om onder druk te spelen."
                            }
                        },
                        {
                            "text": "She has <w>conditioned</w> her hair to be soft and shiny.",
                            "target_lang_translations": {
                                "nl": "Ze heeft haar haar <w>geconditioneerd</w> om het zacht en glanzend te maken."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb condition."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van het werkwoord 'conditioneren'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geconditioneerd",
                                "target_lang_sense_clarification": "voltooid deelwoord van conditioneren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}