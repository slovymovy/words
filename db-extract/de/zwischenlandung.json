                                "example_id": "1997364a-e795-4216-9894-e6385b49b50f",
                                "sense_id": "2b23d299-ae29-321f-9ed4-27af307f431b",
                                "text": "Auf unserem Flug von Warschau nach New York machten wir eine Zwischenlandung in London."
                            },
                            {
                                "example_id": "f44b4da0-e0d6-44c7-9eca-b6d87f3ac77a",
                                "sense_id": "2b23d299-ae29-321f-9ed4-27af307f431b",
                                "text": "Wir haben einen Flug ohne Zwischenlandung gebucht."
                            },
                            {
                                "example_id": "016ff0d9-08f2-4f4d-8f50-9b5aa9d3c828",
                                "sense_id": "2b23d299-ae29-321f-9ed4-27af307f431b",
                                "text": "„Allmählich wurde es Zeit für eine Zwischenlandung.“"
                            }
