                "senses": [
                    {
                        "sense_id": "f0fa9123-9c14-32e2-8754-5e7ec6eed2ef",
                        "entry_id": "69cedbfd-229c-3f94-a192-2c9d0e276e35",
                        "glosses": [
                            "Liste, auf der Objekte, Personen, Institutionen danach angeordnet sind, in welchem Ausmaß sie ein bestimmtes Kriterium erfüllen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e97df50-f084-4822-9e98-5169c2f2a98f",
                                "sense_id": "f0fa9123-9c14-32e2-8754-5e7ec6eed2ef",
                                "text": "„Für Korrespondenten wie mich ist das natürlich äußerst praktisch, denn auch deutsche Redaktionen vertrauen diesen Ranglisten blind.“"
                            },
                            {
                                "example_id": "e48fda18-9848-4467-ab96-e31238c446c2",
                                "sense_id": "f0fa9123-9c14-32e2-8754-5e7ec6eed2ef",
                                "text": "„Und die Maßlosigkeit steht in der Rangliste der deutschen Sündenfälle ganz obenan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
