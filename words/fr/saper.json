                    "frequency": "Middle",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour la fête de ce soir, Paul a décidé de se <w>saper</w> comme un prince."
                        },
                        {
                            "text": "Il est toujours bien <w>sapé</w> quand il se rend à un entretien d'embauche."
                        }
                    ],
                    "common_phrases": [
                        "bien sapé",
                        "se saper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "65d8732d-2685-356c-b76f-7b7fb94b15d3",
                    "sense_definition": "Détruire ou affaiblir progressivement les bases, l'autorité ou le moral de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces critiques constantes finissent par <w>saper</w> la confiance des jeunes recrues de l'équipe."
                        },
                        {
                            "text": "Les scandales politiques répétés ont contribué à <w>saper</w> les fondements de la démocratie."
                        }
                    ],
                    "common_phrases": [
                        "saper le moral",
                        "saper la confiance",
                        "saper les fondements"
                    ]
                },
                {
                    "sense_id": "8d2bf433-847d-3c52-8005-1bc27946d6b3",
                    "sense_definition": "Détruire par la base les fondations d'un mur ou d'un édifice pour provoquer son effondrement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont réussi à <w>saper</w> la muraille ennemie sous le couvert de la nuit."
                        },
                        {
                            "text": "Les vagues violentes continuent de <w>saper</w> la falaise qui menace de s'effondrer."
