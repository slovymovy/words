                                "target_senses": [
                                    {
                                        "sense_id": "3a529d01-13c9-3fe6-bad0-c0a4e3f29806",
                                        "entry_id": "b1b46df7-7688-31a6-bcc2-1f9cf05a0363",
                                        "glosses": [
                                            "Not one of two; not either; not one or the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1810723-97b1-46fb-b373-bb1042fb8588",
                                                "sense_id": "3a529d01-13c9-3fe6-bad0-c0a4e3f29806",
                                                "text": "Neither definition seems correct."
                                            },
                                            {
                                                "example_id": "97e6628f-1ac0-4a66-bd5c-4538ee6b49ac",
                                                "sense_id": "3a529d01-13c9-3fe6-bad0-c0a4e3f29806",
                                                "text": "She was neither learned nor intelligent, but she contrived to dress both herself and her daughter out of a meagre jointure, supplying with her clever fingers what her purse could not buy;[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8f5ea3-dbd2-3368-bbfc-ba482e78b690",
                                        "entry_id": "9d28c3e7-a47b-3b2e-8668-90ad5c2e8c54",
                                        "glosses": [
                                            "Not either (used with nor)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60e4732d-9a3e-4bcd-a51a-6f88e356e0ae",
                                                "sense_id": "7c8f5ea3-dbd2-3368-bbfc-ba482e78b690",
                                                "text": "Neither you nor I likes it."
                                            },
                                            {
                                                "example_id": "297de0be-a834-4c00-a852-7d840d513d56",
                                                "sense_id": "7c8f5ea3-dbd2-3368-bbfc-ba482e78b690",
                                                "text": "For most people, this sacrifice is made easily and instinctively. Not so for otroverts, who are neither willing nor able to passively adopt the social scripts that others do. To the otrovert, who is constantly engaged with the choices and consequences of their individual life, social norms follow a circular logic: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70472506-787f-3a80-991c-8e68d43d2b95",
                                        "entry_id": "32ee1389-d02b-3962-818c-b377acfa561d",
                                        "glosses": [
                                            "Not either one of two."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3126ed0-871a-4f5d-8a1b-0702cab94ed8",
                                                "sense_id": "70472506-787f-3a80-991c-8e68d43d2b95",
                                                "text": "I’ve tried on both shirts, but neither fits properly."
                                            },
                                            {
                                                "example_id": "469d4996-3ad8-4f89-8784-c374778aad05",
                                                "sense_id": "70472506-787f-3a80-991c-8e68d43d2b95",
                                                "text": "Her words of advice will help neither of us."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                        "entry_id": "e485c291-f42c-32ed-882a-abd0f479a722",
                                        "glosses": [
                                            "Similarly not."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ecdce9-12cd-4e35-a491-e99f5cd2013f",
                                                "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                                "text": "Just as you would not correct it, neither would I."
                                            },
                                            {
                                                "example_id": "72781cdd-8db3-4e92-957c-ab785c380f7f",
                                                "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                                "text": "Neither can she stop him, nor can he stop her."
                                            },
                                            {
                                                "example_id": "6061bcf8-3352-4c11-b9b3-c93813b533da",
                                                "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                                "text": "Neither now, nor ever will he forsake his mother."
                                            },
                                            {
                                                "example_id": "d9d21f09-7f0d-44c5-b4c1-92b076b4ba55",
                                                "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies. […] current tax rules make it easy for all sorts of firms to generate […] “stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "646a8ec3-e2d5-309d-89bf-2ffd234c5983",
                                        "entry_id": "ac08ad05-f0e3-3b64-98d2-70eaae3e0f73",
                                        "glosses": [
                                            "Nor."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3b3b50-17d6-4e6f-8a62-e45f3d7b6143",
                                                "sense_id": "646a8ec3-e2d5-309d-89bf-2ffd234c5983",
                                                "text": "But here thou canst not handle aught, neither make the folk ware of thee, not though thou shout thy throat hoarse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "701ce358-50b4-4978-b7d2-d62f57cb0381",
                        "source_entry_id": "ffa763f6-6837-3464-9c68-a26da7ba6712",
                        "source_sense_id": "9f331f22-f369-3419-87be-2777573123d8",
                        "source_sense_description": "ook niet",
                        "target_lang_word": "nor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c810959-3219-3a18-9216-b14d37f4d7c0",
                                        "entry_id": "c5b07924-d1c1-3b98-b3d7-9e85b5959756",
                                        "glosses": [
                                            "And... not (introducing a negative statement, without necessarily following one)."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4df4e1a-b268-4983-95cc-35a6962cf4fa",
                                                "sense_id": "0c810959-3219-3a18-9216-b14d37f4d7c0",
                                                "text": "They are happy, nor need we worry."
                                            },
                                            {
                                                "example_id": "0b11a72f-0226-471b-a4a9-718dd36c890a",
                                                "sense_id": "0c810959-3219-3a18-9216-b14d37f4d7c0",
                                                "text": "Water, water, every where, / Nor any drop to drink."
                                            },
                                            {
                                                "example_id": "76f0277b-0c1f-471e-bdcd-2baf97ef4608",
                                                "sense_id": "0c810959-3219-3a18-9216-b14d37f4d7c0",
                                                "text": "And, moreover, I had made my vow to preserve my rank unknown till the crusade should be accomplished; nor did I mention it […]"
                                            },
                                            {
                                                "example_id": "a6b2ee77-e68d-4a8a-99b6-9d17ea475f9c",
                                                "sense_id": "0c810959-3219-3a18-9216-b14d37f4d7c0",
                                                "text": "Nor did I stop to think, but ran."
                                            },
                                            {
                                                "example_id": "38490472-a236-4cb2-be14-590c5bb4b33d",
                                                "sense_id": "0c810959-3219-3a18-9216-b14d37f4d7c0",
                                                "text": "The cheeks drop in; the body bows;\nMan dies: nor is there hope in dust: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "574db076-1e1b-316b-a7da-779b43102df4",
                                        "entry_id": "c5b07924-d1c1-3b98-b3d7-9e85b5959756",
                                        "glosses": [
                                            "A function word introducing each except the first term of a series, indicating none of them is true."
                                        ],
                                        "tags": [
                                            "dated",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "412553b3-10cc-449e-85f9-30001b95cba4",
                                                "sense_id": "574db076-1e1b-316b-a7da-779b43102df4",
                                                "text": "I am neither hungry nor thirsty nor tired."
                                            },
                                            {
                                                "example_id": "7655b7a5-fde1-4a63-b631-0f1e2232cc51",
                                                "sense_id": "574db076-1e1b-316b-a7da-779b43102df4",
                                                "text": "I love your majesty / According to my bond, nor more nor less."
                                            },
                                            {
                                                "example_id": "b336c94a-25f6-45bf-88cb-66ccd278f622",
                                                "sense_id": "574db076-1e1b-316b-a7da-779b43102df4",
                                                "text": "But neither breath of Morn when she ascends / With charm of earliest birds; nor rising sun / On this delightful land, nor herb, fruit, flower, / Glistering with dew; nor fragrance after showers; / Nor grateful Evening mild; nor silent Night / With this her solemn bird; nor walk by moon, / Or glittering starlight, without thee is sweet."
                                            },
                                            {
                                                "example_id": "35077cc1-3cc3-41e3-a246-da42844ea03c",
                                                "sense_id": "574db076-1e1b-316b-a7da-779b43102df4",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies.[…]current tax rules make it easy for all sorts of firms to generate[…]“stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            },
                                            {
                                                "example_id": "9d350a9b-53e4-4867-8890-92531e1e66bd",
                                                "sense_id": "574db076-1e1b-316b-a7da-779b43102df4",
                                                "text": "For most people, this sacrifice is made easily and instinctively. Not so for otroverts, who are neither willing nor able to passively adopt the social scripts that others do. To the otrovert, who is constantly engaged with the choices and consequences of their individual life, social norms follow a circular logic: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a1d964f-8af8-3664-944f-e57e91c5bd62",
                                        "entry_id": "c5b07924-d1c1-3b98-b3d7-9e85b5959756",
                                        "glosses": [
                                            "Neither."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fece46bf-93d6-4752-aa9e-6b9aee4ff83c",
                                                "sense_id": "5a1d964f-8af8-3664-944f-e57e91c5bd62",
                                                "text": "I love your majesty / According to my bond, nor more nor less."
                                            },
                                            {
                                                "example_id": "433a889f-64c6-4d9b-a062-7bb0d8fe4545",
                                                "sense_id": "5a1d964f-8af8-3664-944f-e57e91c5bd62",
                                                "text": "Nor you nor your house were so much as spoken of before I disbased myself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ba54f0-3e6d-31b0-bac5-f1df549db3c8",
                                        "entry_id": "c5b07924-d1c1-3b98-b3d7-9e85b5959756",
                                        "glosses": [
                                            "Used to introduce a further negative statement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12dba8ff-99bc-4930-9a8f-d024f51b5d92",
                                                "sense_id": "f7ba54f0-3e6d-31b0-bac5-f1df549db3c8",
                                                "text": "The struggle didn't end, nor was it diminished."
                                            },
                                            {
                                                "example_id": "a4a4c1f0-69f8-4b30-9083-d4c94176770d",
                                                "sense_id": "f7ba54f0-3e6d-31b0-bac5-f1df549db3c8",
                                                "text": "I hardly spoke with nor listened to anybody else."
                                            },
                                            {
                                                "example_id": "dc1b3e72-f1fb-4af7-a620-3b5d51274885",
                                                "sense_id": "f7ba54f0-3e6d-31b0-bac5-f1df549db3c8",
                                                "text": "I was about to say that I had known the Celebrity from the time he wore kilts. But I see I will have to amend that, because he was not a celebrity then, nor, indeed, did he achieve fame until some time after I left New York for the West."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868561e1-0dd4-3c1d-84bf-0106c858157d",
                                        "entry_id": "c5b07924-d1c1-3b98-b3d7-9e85b5959756",
                                        "glosses": [
                                            "Than."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40d0d04f-e324-490b-9d01-8d5529320be0",
                                                "sense_id": "868561e1-0dd4-3c1d-84bf-0106c858157d",
                                                "text": "He's no better nor you."
                                            },
                                            {
                                                "example_id": "276e55a7-d878-4ebe-b615-b2684b763208",
                                                "sense_id": "868561e1-0dd4-3c1d-84bf-0106c858157d",
                                                "text": "'I used to think, when you first come into these parts, as you were no better nor you should be.'"
                                            },
                                            {
                                                "example_id": "efb8dab3-82f0-478c-b99a-4ee4c36c6b66",
                                                "sense_id": "868561e1-0dd4-3c1d-84bf-0106c858157d",
                                                "text": "I wouldn’t like to live here though, not after dark. Sooner you nor me."
                                            }
                                        ]
                                    }
                                ]
                            },
