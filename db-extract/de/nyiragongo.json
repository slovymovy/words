                "senses": [
                    {
                        "sense_id": "47feca65-203b-3c8a-9075-0f3aacff6f09",
                        "entry_id": "6d70d20f-e917-3d85-a63d-2081c83c1a34",
                        "glosses": [
                            "ein 3.470 m hoher, aktiver Stratovulkan in der Demokratischen Republik Kongo"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "482f9409-6a4e-4f59-9a35-8e15adb1ae37",
                                "sense_id": "47feca65-203b-3c8a-9075-0f3aacff6f09",
                                "text": "Nach dem Ausbruch des Vulkans Nyiragongo in der Demokratischen Republik Kongo sind Tausende Menschen aus der Millionenstadt Goma auf der Flucht."
                            },
                            {
                                "example_id": "3a0aef51-40aa-4425-8edb-27aeefa5238d",
                                "sense_id": "47feca65-203b-3c8a-9075-0f3aacff6f09",
                                "text": "Goma mit seinen rund zwei Millionen Einwohnern liegt nahe des Vulkans Nyiragongo. Die Behörden setzten einen Evakuierungsplan für die Stadt in Kraft."
                            },
                            {
                                "example_id": "bd7d952d-0a10-42ed-b414-dfccd28740c5",
                                "sense_id": "47feca65-203b-3c8a-9075-0f3aacff6f09",
                                "text": "Die bisher folgenschwerste Eruption des Nyiragongo ereignete sich 1977, damals starben mehr als 600 Menschen."
                            },
                            {
                                "example_id": "b4cf1971-8bfb-461a-a09b-722dbb5611b6",
                                "sense_id": "47feca65-203b-3c8a-9075-0f3aacff6f09",
                                "text": "Besteigen Sie den Vulkan Nyiragongo und bewundern Sie den größten Lavasee der Welt."
                            },
                            {
                                "example_id": "e95aff90-a441-4e29-b07e-2d67217f7db0",
                                "sense_id": "47feca65-203b-3c8a-9075-0f3aacff6f09",
                                "text": "Der Nyiragongo im Grenzgebiet vom Kongo zu Ruanda gefährdet seine Umgebung weniger durch heftige Explosionen als vielmehr durch seine besondere Lava: Sie ist extrem dünnflüssig, und wenn der Vulkan ausbricht, sprudelt sie rasch aus dem größten bekannten Lavasee im Krater über und ergießt sich sturzbachartig ins Umland."
                            },
                            {
                                "example_id": "bc80a0a5-07f2-4ceb-93b3-171766283f18",
                                "sense_id": "47feca65-203b-3c8a-9075-0f3aacff6f09",
                                "text": "Nyiragongo gilt als Typlokalität für das Mineral Andrémeyerit und der als Mount Saheru bezeichnete Südgipfel des Nyiragongo ist Typlokalität für die Minerale Combeit, Delhayelith, Götzenit und Kirschsteinit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
