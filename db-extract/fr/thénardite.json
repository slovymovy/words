                        "glosses": [
                            "Sulfate de sodium anhydre (Na₂SO₄)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e65cd8cc-7108-418e-83b6-5b8498b7077f",
                                "sense_id": "17883e00-b10f-31d0-b1d1-03e6d535585b",
                                "text": "Certaines eaux salines qui, dans l’hiver, suintent à travers le fond d’un bassin de cet établissement, et se concentrent dans l’été par l’évaporation, laissent déposer la thénardite, sous forme de cristaux plus ou moins réguliers."
                            },
                            {
                                "example_id": "6104f6ae-2868-43c9-8d02-c004f04492ca",
                                "sense_id": "17883e00-b10f-31d0-b1d1-03e6d535585b",
                                "text": "Les sulfates anhydres comportent des groupements (SO4)²⁻ maintenus par des ions métalliques qui, selon leur grosseur les écartent plus ou moins : les ions Na⁺ se contentent d’un site octaédrique dans la thénardite, mais s’entourent de sept ions oxygène dans la glaubérite […]"
                            }
                        ]
                    }
