                ],
                "senses": [
                    {
                        "sense_id": "d3e57ec9-3026-327d-99ce-c1820a30a751",
                        "entry_id": "0ce025a8-3009-3718-b372-90626ce6d9d2",
                        "glosses": [
                            "to pinch (to cause pain or discomfort by pressing strongly)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "607be1e6-b17d-3947-912b-2cb1039a554b",
                        "entry_id": "0ce025a8-3009-3718-b372-90626ce6d9d2",
                        "glosses": [
                            "to smart, to ache, to throb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a4663c-efdc-425b-bf16-27bb1d310181",
                                "sense_id": "607be1e6-b17d-3947-912b-2cb1039a554b",
                                "text": "Ма́ло того́, что я был наскво́зь вспоте́вший, так и волдыри́ у меня́ на ладо́нях поло́пались и оголённая ко́жа щеми́ла от мале́йшего соприкоснове́ния с лопа́той.",
                                "translation": "Not only was I drenched in sweat, the blisters on my palms had burst and the bare skin smarted from the slightest contact with the shovel.",
                                "english": "Not only was I drenched in sweat, the blisters on my palms had burst and the bare skin smarted from the slightest contact with the shovel."
                            },
                            {
                                "example_id": "78960916-073a-4763-b647-5770edfc6777",
                                "sense_id": "607be1e6-b17d-3947-912b-2cb1039a554b",
                                "text": "Лишь иногда́ но́чью возника́ла в па́мяти седа́я голова́ Алекса́ндры Влади́мировны, насме́шливые глаза́ тёти Же́ни, и начина́ло щеми́ть се́рдце, охва́ченное любо́вью.",
                                "translation": "Only sometimes at night Aleksandra Vladimirovna's gray head, Aunt Zhena's mocking eyes rose up in his memory, and his heart, in the grip of love, began to ache.",
                                "english": "Only sometimes at night Aleksandra Vladimirovna's gray head, Aunt Zhena's mocking eyes rose up in his memory, and his heart, in the grip of love, began to ache."
                            }
                        ]
                    }
                ],
