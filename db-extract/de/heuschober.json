                "senses": [
                    {
                        "sense_id": "de73b25f-7fea-3e5e-873b-c7e5b910083d",
                        "entry_id": "a3de86f6-1159-3d24-acf6-85863e040660",
                        "glosses": [
                            "ein auf Feldern zu begegnender aufgeschichteter Heuhaufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4986c1d8-d0ef-4a3d-8914-eaeefa1a4498",
                                "sense_id": "de73b25f-7fea-3e5e-873b-c7e5b910083d",
                                "text": "Auf dem Feld waren zahlreiche Heuschober zu sehen."
                            },
                            {
                                "example_id": "13e12813-4aa3-4725-977b-f2b36c679899",
                                "sense_id": "de73b25f-7fea-3e5e-873b-c7e5b910083d",
                                "text": "„Die Ernte war eben vorbei – und auf den Feldern ragten die Heuschober als schwarze Massen in die blaue, milde Nacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9a92213-b576-3b73-ba0c-e510db50f4ce",
                        "entry_id": "a3de86f6-1159-3d24-acf6-85863e040660",
                        "glosses": [
                            "ein auf dem Feld aufgerichtetes einfaches Gebäude zur Lagerung des Heus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d401fc71-a12f-480d-a14a-c7e07933600d",
                                "sense_id": "a9a92213-b576-3b73-ba0c-e510db50f4ce",
                                "text": "Er verbrachte die Nacht in einem Heuschober."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e4cc419-a8af-4e71-96af-afa01b5f3c2f",
                        "source_entry_id": "a3de86f6-1159-3d24-acf6-85863e040660",
                        "source_sense_id": "de73b25f-7fea-3e5e-873b-c7e5b910083d",
                        "source_sense_description": "ein auf Feldern zu begegnender aufgeschichteter Heuhaufen",
                        "target_lang_word": "hayrick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hayrick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0f52a78-61c5-32d3-af99-b04fb5cf27ea",
                                        "entry_id": "d524a4ac-69ef-3bcf-bb47-859f0fa83397",
                                        "glosses": [
                                            "A haystack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02cf01ae-0953-4148-9773-66e99bfff9c7",
                                                "sense_id": "c0f52a78-61c5-32d3-af99-b04fb5cf27ea",
                                                "text": "It was not far from the house; but the ground sank into a depression there, and the ridge of it behind shut out everything except just the roof of the tallest hayrick. As one sat on the sward behind the elm, with the back turned on the rick and nothing in front but the tall elms and the oaks in the other hedge, it was quite easy to fancy it the verge of the prairie with the backwoods close by."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f22ed18-e709-4d6e-b775-b315ebb081eb",
                        "source_entry_id": "a3de86f6-1159-3d24-acf6-85863e040660",
                        "source_sense_id": "de73b25f-7fea-3e5e-873b-c7e5b910083d",
                        "source_sense_description": "ein auf Feldern zu begegnender aufgeschichteter Heuhaufen",
                        "target_lang_word": "haystack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haystack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e421b803-eb18-3125-b1de-4193ed51bad1",
                                        "entry_id": "4282998d-bfe7-3707-a2f9-9b54cdeaa1f1",
                                        "glosses": [
                                            "A mound, pile, or stack of stored hay."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8987c039-e81a-3a04-adc7-53a425c408e5",
                                        "entry_id": "4282998d-bfe7-3707-a2f9-9b54cdeaa1f1",
                                        "glosses": [
                                            "A standing wave in a rapid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "786db820-7515-3f52-b4e5-b1df5551e17c",
                                        "entry_id": "4282998d-bfe7-3707-a2f9-9b54cdeaa1f1",
                                        "glosses": [
                                            "The text string within which another string is searched for. (see: needle in a haystack)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a688712f-5eb6-427b-a2c5-b315de7f68bb",
                                                "sense_id": "786db820-7515-3f52-b4e5-b1df5551e17c",
                                                "text": "Both of these functions will look through the haystack for the specified needle and, if they find it, will return the portion of the string from the beginning of the needle to the end of the haystack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b955f278-d189-3121-b3bd-91d4b3a96453",
                                        "entry_id": "4282998d-bfe7-3707-a2f9-9b54cdeaa1f1",
                                        "glosses": [
                                            "Any place or collection of items through which one searches for something that is rare and hard to find."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5743d8d9-c3aa-4c6d-b271-a26991162a33",
                                                "sense_id": "b955f278-d189-3121-b3bd-91d4b3a96453",
                                                "text": "But the point of confining the Kansas City gun experiment to the worst parts of the worst neighborhoods was to make the haystack just a little smaller, and to make the inevitable trade-off between fighting crime and harassing innocent people just a little more manageable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341aaa35-c733-36fc-8673-2b18064afdb6",
                                        "entry_id": "4282998d-bfe7-3707-a2f9-9b54cdeaa1f1",
                                        "glosses": [
                                            "A dish composed of a starchy food (rice, tortillas, crackers, etc.) topped by a protein (beans, cheese, meat, etc.) in combination with fresh vegetables, assembled on the plate by the diner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
