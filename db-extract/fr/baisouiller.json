                "senses": [
                    {
                        "sense_id": "2e3a5582-c589-39ca-9c91-de152760b903",
                        "entry_id": "248367c1-d3cc-37da-b44e-edcde7a88211",
                        "glosses": [
                            "Baiser."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d208903c-49cc-4aee-aaec-21b796961d60",
                                "sense_id": "2e3a5582-c589-39ca-9c91-de152760b903",
                                "text": "Ensuite, nous sommes bien allés tous les trois baisouiller sur le balcon."
                            },
                            {
                                "example_id": "a1be3029-c336-4d1d-a9fb-c0d0c8d508ef",
                                "sense_id": "2e3a5582-c589-39ca-9c91-de152760b903",
                                "text": "Pendant trois jours tout le monde est copain, ça s'embrasse, ça baisouille, ça boit des canons à tout va, ça chante et ça ripaille, l'intellectuel s'encanaille, le plouc rimaille, Bécassine rêvasse, et puis tout passe."
                            },
                            {
                                "example_id": "6536bd8f-31ff-42ee-ae3e-58f23169e4fa",
                                "sense_id": "2e3a5582-c589-39ca-9c91-de152760b903",
                                "text": "Ils allaient à la bibli ensemble, ils faisaient la teuf ensemble, ils baisouillaient un peu tous."
                            }
                        ]
                    }
