                                "target_senses": [
                                    {
                                        "sense_id": "2692ac0f-4fa8-360f-bb9c-f9578379dbff",
                                        "entry_id": "2695afa3-2698-397d-8302-b63b1eb831d7",
                                        "glosses": [
