                    {
                        "sense_id": "7cdd8f43-869d-37d1-8161-e51772c03973",
                        "entry_id": "7c5c06e9-bf95-362c-834f-294aa16ec3cf",
                        "glosses": [
                            "Psychologe oder Psychotherapeut"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2b06cfba-46ec-47bc-9315-14bfef9d65f1",
                                "sense_id": "7cdd8f43-869d-37d1-8161-e51772c03973",
                                "text": "Max braucht eine Psychotherapie, er geht deshalb zum Seelenklempner."
                            },
                            {
                                "example_id": "fdabcf5c-bd35-4298-b781-9b5ebf3b8b06",
                                "sense_id": "7cdd8f43-869d-37d1-8161-e51772c03973",
                                "text": "„Viele Japaner halten es für ein Zeichen von Schwäche, zu einem Seelenklempner zu gehen – für das Eingeständnis, ein psychisches Problem zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a50dce07-6d8b-4349-a73e-fdb1fc1f71fc",
                        "source_entry_id": "7c5c06e9-bf95-362c-834f-294aa16ec3cf",
                        "source_sense_id": "7cdd8f43-869d-37d1-8161-e51772c03973",
                        "source_sense_description": "umgangssprachlich: Psychologe oder Psychotherapeut",
                        "target_lang_word": "shrink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76f17db3-c0e0-35ee-b1c6-e10108f37e02",
                                        "entry_id": "aad7ca10-264c-3178-a0c8-b29402b34bd4",
                                        "glosses": [
                                            "To cause to become smaller."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f7c03f8-9fc7-4ad6-b4e1-a6ee795528e3",
                                                "sense_id": "76f17db3-c0e0-35ee-b1c6-e10108f37e02",
                                                "text": "The dryer shrank my sweater."
                                            },
                                            {
                                                "example_id": "7a1f0729-f3af-4cbb-9140-833dd1ce0596",
                                                "sense_id": "76f17db3-c0e0-35ee-b1c6-e10108f37e02",
                                                "text": "The bottom line is this: To shrink your gut, you need to start listening to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71dd5b87-e44a-32b9-9de5-6276a4fc5353",
                                        "entry_id": "aad7ca10-264c-3178-a0c8-b29402b34bd4",
                                        "glosses": [
                                            "To become smaller; to contract."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11ba98a8-0fb9-433a-9356-330547e3d58d",
                                                "sense_id": "71dd5b87-e44a-32b9-9de5-6276a4fc5353",
                                                "text": "This garment will shrink when wet."
                                            },
                                            {
                                                "example_id": "e1668fbd-f265-47fd-afa0-6325d06c88dd",
                                                "sense_id": "71dd5b87-e44a-32b9-9de5-6276a4fc5353",
                                                "text": "I have not found that water, by mixture of ashes, will shrink or draw into less room."
                                            },
                                            {
                                                "example_id": "13cd0f68-c81e-4435-8dc2-c66ed45d3568",
                                                "sense_id": "71dd5b87-e44a-32b9-9de5-6276a4fc5353",
                                                "text": "And shrink like parchment in consuming fire."
                                            },
                                            {
                                                "example_id": "a9f859dc-6833-4ca3-b93e-87ec2741ebcf",
                                                "sense_id": "71dd5b87-e44a-32b9-9de5-6276a4fc5353",
                                                "text": "Since 1982, it has shrunk by 250 meters."
                                            },
                                            {
                                                "example_id": "8797953f-e6ab-47c7-a58e-579d589dfb5b",
                                                "sense_id": "71dd5b87-e44a-32b9-9de5-6276a4fc5353",
                                                "text": "When they took over the 1000 'Flying Scotsman' from May 1979, the journey from London to Edinburgh shrank to just 4hrs 37mins - including a stop at Newcastle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65f9249a-2693-316c-88bb-db7a64d4c44d",
                                        "entry_id": "aad7ca10-264c-3178-a0c8-b29402b34bd4",
                                        "glosses": [
                                            "To cower or flinch."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f533ef82-86c7-45c7-89b7-a379af403446",
                                                "sense_id": "65f9249a-2693-316c-88bb-db7a64d4c44d",
                                                "text": "Molly shrank away from the blows of the whip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b4ba15a-0c4e-395b-9a76-f6933a49d866",
                                        "entry_id": "aad7ca10-264c-3178-a0c8-b29402b34bd4",
                                        "glosses": [
                                            "To draw back; to withdraw."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76f5a82-c743-4ecd-8896-33ead1a8f06b",
                                                "sense_id": "6b4ba15a-0c4e-395b-9a76-f6933a49d866",
                                                "text": "The Libyc Hammon ſhrinks his horn,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b39a8572-5c53-375e-8728-051c56c38f7d",
                                        "entry_id": "aad7ca10-264c-3178-a0c8-b29402b34bd4",
                                        "glosses": [
                                            "To withdraw or retire, as from danger."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c88aada9-eba5-44b7-9554-c89d8c1481b2",
                                                "sense_id": "b39a8572-5c53-375e-8728-051c56c38f7d",
                                                "text": "What happier natures shrink at with affright, / The hard inhabitant contends is right."
                                            },
                                            {
                                                "example_id": "0c75832e-c62f-4deb-9c7f-d24aaa96f47e",
                                                "sense_id": "b39a8572-5c53-375e-8728-051c56c38f7d",
                                                "text": "They assisted us against the Thebans when you shrank from the task."
                                            },
                                            {
                                                "example_id": "2dc9d4a4-5b83-4842-babe-f5b7d7e4dd00",
                                                "sense_id": "b39a8572-5c53-375e-8728-051c56c38f7d",
                                                "text": "The other patients in the ward, all but the Texan, shrank from him with a tenderhearted aversion from the moment they set eyes on him the morning after the night he had been sneaked in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89db7412-7efd-30fc-8336-080e8403110a",
                                        "entry_id": "aad7ca10-264c-3178-a0c8-b29402b34bd4",
                                        "glosses": [
                                            "To move back or away, especially because of fear or disgust."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shrink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe66246-f8f2-3bcb-8726-c6218cce13e4",
                                        "entry_id": "d89763d9-f9cf-35f6-82a3-0de19c01efc3",
                                        "glosses": [
                                            "Shrinkage; contraction; recoil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93561694-4a94-4d7e-98b4-6e1be6fcb425",
                                                "sense_id": "bfe66246-f8f2-3bcb-8726-c6218cce13e4",
                                                "text": "Yet almost with, with sudden shrink, That I had less to praise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5fbd219-39e5-3fe7-98ae-f87ec1147722",
                                        "entry_id": "d89763d9-f9cf-35f6-82a3-0de19c01efc3",
                                        "glosses": [
                                            "A psychiatrist or psychotherapist."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e56ea624-6018-42dc-94c1-d94fd4671882",
                                                "sense_id": "e5fbd219-39e5-3fe7-98ae-f87ec1147722",
                                                "text": "You need to see a shrink, you crazy fool."
                                            },
                                            {
                                                "example_id": "fd4cdc39-ca8b-4dda-85ea-51c32dd4f540",
                                                "sense_id": "e5fbd219-39e5-3fe7-98ae-f87ec1147722",
                                                "text": "My shrink said that he was an enabler, bad for me."
                                            },
                                            {
                                                "example_id": "c82b6348-bbe5-4403-99f2-a6c5453adb73",
                                                "sense_id": "e5fbd219-39e5-3fe7-98ae-f87ec1147722",
                                                "text": "I went to a shrink to analyze my dreams / She says it's lack of sex that's bringing me down"
                                            },
                                            {
                                                "example_id": "afa990dd-0556-4d83-b395-7207fa50f3bc",
                                                "sense_id": "e5fbd219-39e5-3fe7-98ae-f87ec1147722",
                                                "text": "\"From behind the counter of this provincial train station coffee shop, Joanna was barista and unofficial shrink to wildly varied London-bound travellers,\" writes author Laline Paull. Confessions of a Barista on Platform 1 was published on February 9 by The Firle Press [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69dc9866-80e9-3bb0-8f20-866d3ca3c11d",
                                        "entry_id": "d89763d9-f9cf-35f6-82a3-0de19c01efc3",
                                        "glosses": [
                                            "Loss of inventory, for example due to shoplifting or not selling items before their expiration date."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4281eea-7a46-452c-97dd-f1645fd8b804",
                                                "sense_id": "69dc9866-80e9-3bb0-8f20-866d3ca3c11d",
                                                "text": "Assuming the retailer's shrink is average or below, and the owner is comfortable with the level of shrink, perhaps nothing more need be done except to maintain vigilance and to monitor the shrink for signs of emerging problems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
