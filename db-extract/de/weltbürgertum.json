                                                "example_id": "c6d0f79e-081b-41f6-a4b1-17c4a57731d2",
                                                "sense_id": "978cf4d0-8104-339a-9a69-fa2eadb40549",
                                                "text": "Por ejemplo, no es lo mismo ir de Triflis a Krasnodar, que de París a Niza. —Se hecha a reír, visiblemente orgulloso de su cosmopolitismo turístico."
                                            }
