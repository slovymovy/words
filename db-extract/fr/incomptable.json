            {
                "entry_id": "72a44ef0-3116-363e-9418-aa9bce208297",
                "word": "incomptable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "11b84a36-64a9-4232-942e-f4c434fd03ba",
                        "entry_id": "72a44ef0-3116-363e-9418-aa9bce208297",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "incomptables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d24502d-9f93-36f3-928c-01240455e634",
                        "entry_id": "72a44ef0-3116-363e-9418-aa9bce208297",
                        "glosses": [
                            "Que l’on ne peut pas compter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d62bff-9729-4df8-bd5d-9768a9032a34",
                                "sense_id": "4d24502d-9f93-36f3-928c-01240455e634",
                                "text": "Ce que j’appelle plus tost petites et imparfaites recordations de ses benefices, qui nous sont aussi incomptables que les pierres d’une cité."
                            },
                            {
                                "example_id": "ebd581a9-6f3d-4bcc-9ed6-d1466ab21567",
                                "sense_id": "4d24502d-9f93-36f3-928c-01240455e634",
                                "text": "Mille fois, en regagnant la Butte, vous l'avez contemplée, trônant à son comptoir, dans l'or incomptable de ses pains, sous l'azur de son plafond, où s'éperdent les hirondelles."
                            },
                            {
                                "example_id": "3514c4cf-0552-4b3c-abf8-27526da10640",
                                "sense_id": "4d24502d-9f93-36f3-928c-01240455e634",
                                "text": "Le rythme cardiaque s’accélère, le pouls devient filant, incomptable."
                            },
                            {
                                "example_id": "ee480027-a35b-4eb8-a578-4a77b2a7b769",
                                "sense_id": "4d24502d-9f93-36f3-928c-01240455e634",
                                "text": "Des exemples comme ceux-là sont incomptables et il y a moyen de vivre dans ce climat de Paix, si chacun accepte de taire ses ambitions personnelles et pense à l’intérêt collectif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f46a68d-7464-4d33-8545-e0aa505f2038",
                        "source_entry_id": "72a44ef0-3116-363e-9418-aa9bce208297",
                        "source_sense_id": "4d24502d-9f93-36f3-928c-01240455e634",
                        "target_lang_word": "uncountable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncountable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae86e28-9a22-3fef-aa49-c544419aa433",
                                        "entry_id": "5be367c8-0ad3-3675-8a2e-5e6940f9c865",
                                        "glosses": [
                                            "So many as to be incapable of being counted."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b18d17a6-12bb-4ec7-92ae-35f25ddfe431",
                                                "sense_id": "9ae86e28-9a22-3fef-aa49-c544419aa433",
                                                "text": "The reasons for our failure were as uncountable as the grains of sand on a beach."
                                            },
                                            {
                                                "example_id": "fa7b5ab9-7462-4b88-a96f-24f8f9dfbf52",
                                                "sense_id": "9ae86e28-9a22-3fef-aa49-c544419aa433",
                                                "text": "Mr. Chambre has since spent uncountable hours and even more uncountable dollars buying upward of 23,000 documents, and he figures to be just hitting speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083a691d-d5e7-3e1a-a0e3-5a6c30c21c29",
                                        "entry_id": "5be367c8-0ad3-3675-8a2e-5e6940f9c865",
                                        "glosses": [
                                            "Incapable of being put into one-to-one correspondence with the natural numbers or any subset thereof."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7857ef3-f4d8-4539-8084-7f09dfe158b6",
                                                "sense_id": "083a691d-d5e7-3e1a-a0e3-5a6c30c21c29",
                                                "text": "Cantor’s “diagonal proof” shows that the set of real numbers is uncountable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c53825-4a71-3a4f-ba33-3e38916a2542",
                                        "entry_id": "5be367c8-0ad3-3675-8a2e-5e6940f9c865",
                                        "glosses": [
                                            "That cannot be used freely with numbers or the indefinite article, and therefore usually takes no plural form. Example: information."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a373449b-8213-4a4b-80e4-fc78994c8de9",
                                                "sense_id": "c0c53825-4a71-3a4f-ba33-3e38916a2542",
                                                "text": "Many languages do not distinguish countable nouns from uncountable nouns."
                                            },
                                            {
                                                "example_id": "b416b57e-2b1d-4ac5-8f7a-bad3c246e358",
                                                "sense_id": "c0c53825-4a71-3a4f-ba33-3e38916a2542",
                                                "text": "One meaning in law of the usually uncountable noun \"information\" is used in the plural and is countable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uncountable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9909559-8809-3739-992d-eb8cf649f06e",
                                        "entry_id": "2f805b91-dc74-3d23-85fc-a61a23380da8",
                                        "glosses": [
                                            "A noun that is uncountable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf1f198-7911-47ec-a1f2-48443558ee53",
                                                "sense_id": "c9909559-8809-3739-992d-eb8cf649f06e",
                                                "text": "But inherent uncountables such as 'stuffs' can be conceptualized in two different ways, depending on whether they are viewed in terms of quantity or in terms of quality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
