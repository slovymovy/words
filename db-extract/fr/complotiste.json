                                "target_senses": [
                                    {
                                        "sense_id": "54fe0f22-e70f-3371-9291-340a9a991f94",
                                        "entry_id": "03aec2d0-9b57-35a1-99e9-8f7f2f0a4314",
                                        "glosses": [
                                            "A person who puts forward a conspiracy theory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac2537c-1139-4093-a1bb-b15e7e27076b",
                                                "sense_id": "54fe0f22-e70f-3371-9291-340a9a991f94",
                                                "text": "[Kevin] Phillips's method is pretty conventional for conspiracists – he takes a single issue or set of data points and constructs an all-explaining story line to show how hidden cabals are controlling America."
                                            },
                                            {
                                                "example_id": "51163aca-110a-41ef-b2fb-028f0f7e68f6",
                                                "sense_id": "54fe0f22-e70f-3371-9291-340a9a991f94",
                                                "text": "As this business model developed, InfoWars’ shows, hosted by an array of conspiracists alongside [Alex] Jones, such as British conspiracist Paul Joseph Watson, became increasingly punctuated by ad breaks and product placement, in a way that one journalist described as like “the QVC for racist uncles” (Lamoureux, 2017)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conspiracist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "553a0b2f-b593-3ae2-84f6-f9ff8cf19d18",
                                        "entry_id": "f1c503b2-c0a0-3907-a33d-d83c935c539c",
                                        "glosses": [
                                            "Related to conspiracy theories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa966ae-2401-41a4-97d3-8d5137bd0c05",
                                                "sense_id": "553a0b2f-b593-3ae2-84f6-f9ff8cf19d18",
                                                "text": "The conspiracist worldview that presumes a wholly designed universe is similar, and with a conspiracy theory, the holder of the belief in some ways imagines themselves as the detective or investigator, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37fcd0cd-a78f-434b-b804-416aec05d8a5",
                        "source_entry_id": "d1ef7cde-6ae6-3d22-b0f7-9f26cf701e2e",
