                        "form": "den Gesichtsausdruck"
                    },
                    {
                        "form_id": "0d39fe90-c996-472f-8a6d-3ca164940c13",
                        "entry_id": "df5b14b2-440d-3186-affe-a3392cd6fb58",
                        "tags": [
                            "accusative",
