                        "glosses": [
                            "Celui qui finalise l’orchestration d’une musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ab649a1-2939-4beb-b765-05ce237a1078",
                                "sense_id": "55affe40-fe41-31ee-8e7e-c4b6c81ef3ad",
                                "text": "L’orchestrateur n’est pas à confondre avec l’arrangeur."
                            },
                            {
                                "example_id": "7bf1cc86-6ea3-4bb9-bc5d-b024492d2911",
                                "sense_id": "55affe40-fe41-31ee-8e7e-c4b6c81ef3ad",
                                "text": "Il invente des tempos qui n’existent dans aucun traité musical et l’orchestrateur doit faire des miracles pour retomber en mesure."
                            }
                        ]
                    }
                ],
