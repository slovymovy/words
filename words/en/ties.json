                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>ties</w> her shoelaces tightly before running.",
                            "target_lang_translations": {
                                "ru": "Она туго <w>завязывает</w> шнурки перед бегом.",
                                "tr": "Koşmadan önce ayakkabı bağcıklarını sıkıca <w>bağlar</w>.",
                                "zh": "跑步前，她把鞋带<w>系</w>得很紧。"
                            }
