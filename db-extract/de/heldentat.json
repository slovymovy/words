                    },
                    {
                        "translation_id": "c8d71ab9-e71e-4869-8f18-6e7324e0ee70",
                        "source_entry_id": "36d38266-8e07-348d-9555-227733fe12d8",
                        "source_sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
                        "source_sense_description": "Handlung, die viel Mut erforderte und zur Lösung eines Problems/einer Notsituation führte",
                        "target_lang_word": "exploit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exploit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f7cee2-c028-34de-8cf9-227b366b8ae8",
                                        "entry_id": "e2e9e9a5-8345-3c85-9960-ea4808afd363",
                                        "glosses": [
                                            "Action de guerre éclatante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cc6d2a-a14b-453d-bd27-63fab925af72",
                                                "sense_id": "c7f7cee2-c028-34de-8cf9-227b366b8ae8",
                                                "text": "Exploit militaire. Glorieux exploit."
                                            },
                                            {
                                                "example_id": "128cf65e-29f1-41f8-8551-3d8d033b2193",
                                                "sense_id": "c7f7cee2-c028-34de-8cf9-227b366b8ae8",
                                                "text": "Il s’est signalé par ses exploits.",
                                                "translation": "Il s’est rendu fameux par de brillants 'exploits'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5546e7-5788-3993-b424-35c9fcc11b9a",
                                        "entry_id": "e2e9e9a5-8345-3c85-9960-ea4808afd363",
                                        "glosses": [
                                            "Acte qui n’est pas un acte de guerre, mais qui demande de la vaillance, de l’audace et qui aboutit à un résultat surprenant ou nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99845886-7f01-4218-979d-2b41bff6604a",
                                                "sense_id": "0c5546e7-5788-3993-b424-35c9fcc11b9a",
                                                "text": "Loin du danger, il ne rêve qu’exploits héroïques, entreprises surhumaines et gigantesques ; mais, quand vient le péril, son imagination trop vive lui représente la douleur des blessures, le visage camard de la mort, et le cœur lui manque."
                                            },
                                            {
                                                "example_id": "06feb635-0759-4484-ba55-2c46887b66d1",
                                                "sense_id": "0c5546e7-5788-3993-b424-35c9fcc11b9a",
                                                "text": "La star de cinéma ultra-séduisante se leva aussi à 6 heures, ce qui était pour lui un exploit."
                                            },
                                            {
                                                "example_id": "d715910e-11ef-4d83-94c8-80c8c2e9527c",
                                                "sense_id": "0c5546e7-5788-3993-b424-35c9fcc11b9a",
                                                "text": "Vous avez fait là un bel exploit : Se dit à une personne qui a fait quelque chose mal à propos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42ec8182-2f2c-33ae-a1bf-404823e4e8f5",
                                        "entry_id": "e2e9e9a5-8345-3c85-9960-ea4808afd363",
                                        "glosses": [
                                            "Acte que fait un huissier pour assigner, ajourner, saisir, etc."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7cf64e8-a398-4744-b53e-c582194bb19f",
                                                "sense_id": "42ec8182-2f2c-33ae-a1bf-404823e4e8f5",
                                                "text": "Le ménage Fagerolle se débattit parmi les exploits d’huissiers, les menaces de saisie. Il grêlait des papiers bleus, verts, jaunes."
                                            },
                                            {
                                                "example_id": "e8d6eea5-597f-4770-ae41-cc1a054295ad",
                                                "sense_id": "42ec8182-2f2c-33ae-a1bf-404823e4e8f5",
                                                "text": "Exploit de saisie."
                                            },
                                            {
                                                "example_id": "ec43df10-0d8d-4c4d-b062-9c57624d5626",
                                                "sense_id": "42ec8182-2f2c-33ae-a1bf-404823e4e8f5",
                                                "text": "Donner, envoyer, signifier un exploit."
                                            },
                                            {
                                                "example_id": "2b09af16-07f0-4e4c-8de1-e47682cb7313",
                                                "sense_id": "42ec8182-2f2c-33ae-a1bf-404823e4e8f5",
                                                "text": "Enregistrer, dresser un exploit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ace11f-97e4-383f-aab8-ea325499ce9f",
                                        "entry_id": "e2e9e9a5-8345-3c85-9960-ea4808afd363",
                                        "glosses": [
                                            "Acte difficile à reproduire par le commun des mortels, et qui suscite l’admiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4c2101-bb57-4dbb-a0c8-069fbcf76a37",
                                                "sense_id": "94ace11f-97e4-383f-aab8-ea325499ce9f",
                                                "text": "La traversée de cet océan à la nage est un véritable exploit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exploit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c19ac77-b242-327c-b889-aa08798cc473",
                                        "entry_id": "e3f0b334-45ab-3152-a9a0-7fdd0ab708bf",
                                        "glosses": [
                                            "Élément de programme permettant d'exploiter une faille de sécurité informatique."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87d39d3b-e9ba-4164-8877-880c514a69ff",
                                                "sense_id": "7c19ac77-b242-327c-b889-aa08798cc473",
                                                "text": "Ce nouvel exploit pourrait s’avérer encore plus dangereux, car Log4j a été largement adopté dans la plupart des écosystèmes Java."
                                            },
                                            {
                                                "example_id": "07306aff-8f11-4b7e-bbd7-6b60eb7eef50",
                                                "sense_id": "7c19ac77-b242-327c-b889-aa08798cc473",
                                                "text": "Selon un nouvel article de blog de Sonatype, la nouvelle de l’exploit Log4j a éclaté lorsqu’une preuve de concept de vulnérabilité (PoC) a été publiée dans un référentiel GitHub et rendue publique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3774d96-a80a-442d-85dc-7ed62caf0bad",
                        "source_entry_id": "36d38266-8e07-348d-9555-227733fe12d8",
                        "source_sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
                        "source_sense_description": "Handlung, die viel Mut erforderte und zur Lösung eines Problems/einer Notsituation führte",
                        "target_lang_word": "prouesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prouesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4624ae52-0a2d-38b4-bdb8-f4981a3ea21d",
                                        "entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                                        "glosses": [
                                            "Action de preux, vaillance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a03f8e-805d-44e2-983f-2466ec27fec8",
                                                "sense_id": "4624ae52-0a2d-38b4-bdb8-f4981a3ea21d",
                                                "text": "Or combien que Basle fut délivrée de l’assaut de l’armée Françoise, par la prouesse des Suisses, toutesfois parmi ces tumultes les ambassadeurs des Rois & Princes deslogèrent les uns après les autres."
                                            },
                                            {
                                                "example_id": "a49287dc-ce68-4622-8d73-6d7f3f951988",
                                                "sense_id": "4624ae52-0a2d-38b4-bdb8-f4981a3ea21d",
                                                "text": "Le Lion, terreur des forêts,\nChargé d’ans et pleurant son antique prouesse,\nFut enfin attaqué par ses propres sujets,\nDevenus forts pas sa faiblesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3033a29-1343-3902-8587-9fab62382a8f",
                                        "entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                                        "glosses": [
                                            "Action admirable, tour de force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "925b1306-d068-4ffc-9175-c28a2a2d4aa3",
                                                "sense_id": "c3033a29-1343-3902-8587-9fab62382a8f",
                                                "text": "- Il est certain, madame, que le furtif accouplement auquel nous venons de nous abandonner, ne peut être considéré comme une prouesse amoureuse."
                                            },
                                            {
                                                "example_id": "f8ff7cf3-e4ba-4634-bf3c-62f99785f522",
                                                "sense_id": "c3033a29-1343-3902-8587-9fab62382a8f",
                                                "text": "Parallèlement, je me faisande dans mon box, le doigt dans le nez, peu attentif aux prouesses d’un cancrelat aux prises avec les lacets de ma chaussure."
                                            },
                                            {
                                                "example_id": "a97544e1-bf7d-44a3-99a6-7ca160081e65",
                                                "sense_id": "c3033a29-1343-3902-8587-9fab62382a8f",
                                                "text": "Si la construction des obélisques représente une prouesse technique indéniable, elle n’est que le point d’aboutissement d’une maîtrise technique acquise au fil d’une expérience multiséculaire […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
