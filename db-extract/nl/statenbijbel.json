                "word": "Statenbijbel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "673d3e52-3ae7-315a-8632-a3c2c944260b",
                        "entry_id": "d4ee3884-0c91-3215-983e-7a5ceea5b100",
                        "glosses": [
                            "de bijbelvertaling in het Nederlands die in opdracht van de Staten-Generaal in 1637 voor het eerst verscheen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a62e3d3-c85b-4561-a1f2-8470a822e8b3",
                                "sense_id": "673d3e52-3ae7-315a-8632-a3c2c944260b",
                                "text": "Hoewel er eerder vertalingen in de landstaal verschenen waren, heeft de Statenbijbel een uitzonderlijk grote invloed op de ontwikkeling van de Nederlandse standaardtaal gehad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41ccf51d-0b4e-4966-b9bf-208172a889fc",
                        "source_entry_id": "d4ee3884-0c91-3215-983e-7a5ceea5b100",
                        "source_sense_id": "673d3e52-3ae7-315a-8632-a3c2c944260b",
                        "source_sense_description": "de bijbelvertaling in het Nederlands die in opdracht van de Staten-Generaal in 1637 voor het eerst verscheen",
                        "target_lang_word": "Bibel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bibel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80f0b705-7a8a-38a5-b8a4-1799c0098096",
                                        "entry_id": "dede3826-b4f5-3b2d-8c0a-174d0bbb3b92",
                                        "glosses": [
                                            "Titel des Buches (ursprünglich Sammlung von Büchern beziehungsweise Schriften), welches nach christlicher Auffassung Gottes Wort ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b34e63ba-b986-4af7-a0dd-76f1418b64ee",
                                                "sense_id": "80f0b705-7a8a-38a5-b8a4-1799c0098096",
                                                "text": "Das erste gedruckte Buch (von Johannes Gutenberg) ist die Bibel."
                                            },
                                            {
                                                "example_id": "a7aafb5e-dd20-421c-a6da-d0848daf6bdc",
                                                "sense_id": "80f0b705-7a8a-38a5-b8a4-1799c0098096",
                                                "text": "„Besonders fasziniert war ich von der Bibel.“"
                                            },
                                            {
                                                "example_id": "806c3057-3368-4ab1-a417-9cfe93580886",
                                                "sense_id": "80f0b705-7a8a-38a5-b8a4-1799c0098096",
                                                "text": "„Dass Martin Luther nicht als Erster die Bibel ins Deutsche übertrug und seine Bibelübersetzung nicht die Erste war, die gedruckt Verbreitung fand, ist eine seinen Zeitgenossen bestens bekannte, jedoch in der Erinnerung des 21. Jahrhunderts oft vergessene oder auch gern übergangene Tatsache.“"
                                            },
                                            {
                                                "example_id": "bd2f32ba-7674-4cff-abde-cddbac36df42",
                                                "sense_id": "80f0b705-7a8a-38a5-b8a4-1799c0098096",
                                                "text": "„Nicht einmal die Bibel beginnt der sonst den Büchern verfallene Junge zu lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2509781f-691f-33a2-a8da-37e8bb1a269e",
                                        "entry_id": "dede3826-b4f5-3b2d-8c0a-174d0bbb3b92",
                                        "glosses": [
                                            "eine Ausgabe von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f606cb-6218-410f-8bbe-a327d78dea12",
                                                "sense_id": "2509781f-691f-33a2-a8da-37e8bb1a269e",
                                                "text": "Der Konfirmand bekam eine Bibel von seinem Patenonkel geschenkt."
                                            },
                                            {
                                                "example_id": "d943b022-115d-4862-a622-94371fe20167",
                                                "sense_id": "2509781f-691f-33a2-a8da-37e8bb1a269e",
                                                "text": "„Aber dann kam eine Reihe von Jahren, daß sie Bibel und Gesangbuch weglegte, nicht mehr zur Kirche finden konnte und ihre Ohren verschloß, wenn der Pastor, bald mit Milde, bald mit Strenge, auf sie einredete.“"
                                            },
                                            {
                                                "example_id": "2d7e9574-6948-4d85-8d87-81f7394af1f3",
                                                "sense_id": "2509781f-691f-33a2-a8da-37e8bb1a269e",
                                                "text": "„Sie ließen sich zuerst in Maryland, später dann in Pennsylvanien nieder, wo man damals am meisten in der Bibel las und vor den Beilen und Pfeilen der Wildnis nichts mehr zu befürchten hatte.“"
                                            },
                                            {
                                                "example_id": "f2773b63-0567-4f02-8eba-a5803a849b23",
                                                "sense_id": "2509781f-691f-33a2-a8da-37e8bb1a269e",
                                                "text": "„Fast jeder deutsche Haushalt besitzt neben Bibel und Kochbuch auch eine Ausgabe der Werke Wilhelm Buschs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5d9e3d7f-3cf4-3477-b603-3638ade3609e",
                                        "entry_id": "dede3826-b4f5-3b2d-8c0a-174d0bbb3b92",
                                        "glosses": [
                                            "ein bedeutendes Standardwerk in einem bestimmten Gebiet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46239b1f-3ede-410d-87cc-878370b829db",
                                                "sense_id": "5d9e3d7f-3cf4-3477-b603-3638ade3609e",
                                                "text": "„»Candide« ist, wenn es das gibt, die Bibel der Aufklärung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
