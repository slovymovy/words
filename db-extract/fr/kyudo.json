                        "sense_id": "349bbea8-89d1-32cf-90d4-647fdd8bc05e",
                        "entry_id": "8971be7e-f8a6-366b-a7c4-c76b4816d10d",
                        "glosses": [
                            "Tir à l’arc japonais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "184b70de-441d-457a-b10c-b02fff68512d",
                                "sense_id": "349bbea8-89d1-32cf-90d4-647fdd8bc05e",
                                "text": "Le Kyudo va beaucoup plus loin qu’une simple pratique sportive. C’est une technique, une gestuelle, mais c’est aussi une philosophie."
                            },
                            {
                                "example_id": "1da69481-2dc0-43e3-8334-6d5a4a0be940",
                                "sense_id": "349bbea8-89d1-32cf-90d4-647fdd8bc05e",
                                "text": "C’est tout l’enjeu exprimé par les maitres du kyudo, qui est l’art de tirer à l'arc."
                            }
                        ]
                    }
                ],
