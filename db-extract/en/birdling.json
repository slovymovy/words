                                            {
                                                "example_id": "207c7e37-3f18-4a72-9ba4-921194e3724a",
                                                "sense_id": "4cceb489-e5f9-3357-b982-286096e7f25e",
                                                "text": "Alle Leute, die das Vögelein sahen, waren wie verzaubert."
                                            },
                                            {
                                                "example_id": "bb9bfec7-46d5-4afa-bf80-7ca6654850da",
                                                "sense_id": "4cceb489-e5f9-3357-b982-286096e7f25e",
                                                "text": "Das hat mir ein Vögelein gezwitschert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
