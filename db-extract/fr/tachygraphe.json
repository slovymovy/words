                "translations": [
                    {
                        "translation_id": "eddfe164-e5ca-4661-bb08-6dcc129fb8ad",
                        "source_entry_id": "dba1c72a-8c84-3054-a440-e3da8e2b3540",
                        "source_sense_id": "09d64203-0c19-3fee-84cd-f7be3adce468",
                        "source_sense_description": "Appareil enregistreur de vitesse",
                        "target_lang_word": "speedometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speedometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5a3584-de0c-3db7-84e4-a28d4c608f25",
                                        "entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                                        "glosses": [
                                            "An instrument located within the dashboard of a vehicle that measures and indicates the current speed of the vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e6bd47-1cbf-427b-9632-5a7f0364dcb1",
                                                "sense_id": "9f5a3584-de0c-3db7-84e4-a28d4c608f25",
                                                "text": "Although it might be thought that drivers would naturally refer constantly to the speedometer, older drivers who come to diesel driving after years of steam experience without the help of speedometers, as well as those on steam engines which have been equipped with speedometers in recent years, have not accustomed themselves to the constant use of this instrument."
                                            },
                                            {
                                                "example_id": "7ae52438-4fb6-4487-b66d-dda38a3b2259",
                                                "sense_id": "9f5a3584-de0c-3db7-84e4-a28d4c608f25",
                                                "text": "But even Apple, the company that cast aside tradition when it reinvented phones, music players and headphones, bows to convention when it comes to speedometers. It displayed a classically-styled speedometer that reached 160 mph, an auto industry norm.\nThat’s nearly twice the highest posted speed limit in the United States, 85 mph, on a stretch of highway in Texas. Why do our speedometers stretch to a speed that’s illegal, and only race-car drivers will ever reach?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8326f22c-97cd-3959-8414-f33ef943ee7b",
                                        "entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                                        "glosses": [
                                            "Such a device incorporating an odometer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
