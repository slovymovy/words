        "fr-extract.jsonl": [
            {
                "entry_id": "189313f9-f542-33e2-a76c-efd638b35c36",
                "word": "incendiaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4fe65251-dd12-4e98-b172-a34d43731100",
                        "entry_id": "189313f9-f542-33e2-a76c-efd638b35c36",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "incendiaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5076969-2bcd-3087-b816-f030cf1cad0d",
                        "entry_id": "189313f9-f542-33e2-a76c-efd638b35c36",
                        "glosses": [
                            "Qui cause, qui peut causer un incendie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04bc254-8ce0-412f-b831-ad999451caa7",
                                "sense_id": "a5076969-2bcd-3087-b816-f030cf1cad0d",
                                "text": "La fabrique de la Régie des Tabacs est entièrement brûlée par des obus incendiaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5e91416-2605-3767-a8a8-26f7ccc4d838",
                        "entry_id": "189313f9-f542-33e2-a76c-efd638b35c36",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "7cc58e10-7dd2-4016-8814-fa52264259a2",
                                "sense_id": "b5e91416-2605-3767-a8a8-26f7ccc4d838",
                                "text": "Ainsi, alors que je me trouvais confrontée à un plat incendiaire dans un restaurant lors d'un voyage au Mexique, je demandais à quel âge on commençait à donner à manger aussi épicé aux enfants... Mon interlocuteur me répondit en souriant qu’on ne donnait pas de nourriture particulière aux bébés."
                            }
                        ]
                    },
                    {
                        "sense_id": "113a34de-99c6-3578-86d9-f70727f7ceeb",
                        "entry_id": "189313f9-f542-33e2-a76c-efd638b35c36",
                        "glosses": [
                            "Qui est véhément et caustique, en parlant de paroles ou d'écrits."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b878801c-b29e-4a20-be64-5166ef2db657",
                                "sense_id": "113a34de-99c6-3578-86d9-f70727f7ceeb",
                                "text": "Mordu bientôt par le désir de jouer un rôle, il détermina un libraire, un rival de Vuillet, à fonder un journal démocratique, dont il devint un des rédacteurs les plus âpres. L’Indépendant fit, sous son impulsion, une guerre sans merci aux réactionnaires. Mais le courant l’entraîna peu à peu, malgré lui, plus loin qu’il ne voulait aller ; il en arriva à écrire des articles incendiaires qui lui donnaient des frissons lorsqu’il les relisait."
                            },
                            {
                                "example_id": "f9a5d7a7-f8ca-484f-8283-615c43e5d097",
                                "sense_id": "113a34de-99c6-3578-86d9-f70727f7ceeb",
                                "text": "Henri eut un petit rire. Il se souvint tout à coup d'une vieille chronique où il avait, pour flétrir, stigmatiser, juvénaliser les comportements bourgeois, accumulé des bataillons d'imprécations pétaradantes, de prosopopées incendiaires, d'antithèses fulgurantes, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c13db4be-d295-438e-a315-1b6440e8b7cd",
                        "source_entry_id": "189313f9-f542-33e2-a76c-efd638b35c36",
                        "target_lang_word": "incendiary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incendiary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da9349f5-b52d-335f-a6e9-ab80e4074a2d",
                                        "entry_id": "9410e7e5-eadc-3849-bc4c-7b85adcddef4",
                                        "glosses": [
                                            "Capable of, or used for, or actually causing fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a61912-b8fe-4c39-9895-5585fe07e596",
                                                "sense_id": "da9349f5-b52d-335f-a6e9-ab80e4074a2d",
                                                "text": "Driving 2-6-2 locomotive No. 4771 Green Arrow, Blunt suddenly noticed that the tunnel mouth was silhouetted in a dazzling white glare and that incendiary bombs were showering down in their hundreds, he slammed on all his brakes and brought his train to a stop just inside the tunnel."
                                            },
                                            {
                                                "example_id": "e7031afe-1f25-4639-ba44-d520bc50bffa",
                                                "sense_id": "da9349f5-b52d-335f-a6e9-ab80e4074a2d",
                                                "text": "We saw photographs of bodies riddled with pellets from fragmentation bombs or charred by incendiary weapons (besides napalm, the Americans also drop white phosphorus, Thermit, and magnesium on the Vietnamese)."
                                            },
                                            {
                                                "example_id": "37e05d10-54db-4e48-83be-8eaa344c7b9e",
                                                "sense_id": "da9349f5-b52d-335f-a6e9-ab80e4074a2d",
                                                "text": "Blast after blast, fiery outbreak after fiery outbreak, like a flaming barrage from within,[…]most of Edison's grounds soon became an inferno. As though on an incendiary rampage, the fires systematically devoured the contents of Edison's headquarters and facilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d75f9b1b-02b9-343f-a57e-b58c7b6d65e2",
                                        "entry_id": "9410e7e5-eadc-3849-bc4c-7b85adcddef4",
                                        "glosses": [
                                            "Of a damaging fire, intentionally caused rather than accidental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b064d9f4-fdb1-48d3-bfec-3a069038f279",
                                                "sense_id": "d75f9b1b-02b9-343f-a57e-b58c7b6d65e2",
                                                "text": "The Crown must prove beyond a reasonable doubt that the fire was incendiary in origin; that is, it was not accidental and that it was either intentionally or recklessly set by the accused."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd91016c-bc80-308b-a0ee-061bafcbaa8c",
                                        "entry_id": "9410e7e5-eadc-3849-bc4c-7b85adcddef4",
                                        "glosses": [
                                            "Intentionally stirring up strife, riot, rebellion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97fb65b9-311b-4705-acdc-d3dc6bc970e3",
                                                "sense_id": "cd91016c-bc80-308b-a0ee-061bafcbaa8c",
                                                "text": "Earlier that year Italian Jews had come under serious attack when an incendiary publication, Gli ebrei in Italia (The Jews in Italy), had flooded the bookshops. The author, Paolo Orano, was a Fascist publicist whose book helped to harden Italian public sensibility against the Jews and pave the way for their eventual persecution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57e851e-2c99-3810-82c7-bf85b4ee00f3",
                                        "entry_id": "9410e7e5-eadc-3849-bc4c-7b85adcddef4",
                                        "glosses": [
                                            "Inflammatory, emotionally charged."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49ca6889-fa38-4ae3-83aa-e9e69473de6c",
                                                "sense_id": "f57e851e-2c99-3810-82c7-bf85b4ee00f3",
                                                "text": "Politics is an incendiary topic; it tends to cause fights to break out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incendiary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10159c3e-fe59-349f-a2ea-56e6d103e583",
                                        "entry_id": "b41e970e-53b5-3d67-b468-5fad858043ed",
                                        "glosses": [
                                            "Something capable of causing fire, particularly a weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9b147d-0233-40b8-9a11-9beae958ee87",
                                                "sense_id": "10159c3e-fe59-349f-a2ea-56e6d103e583",
                                                "text": "The military used incendiaries to destroy the building. Fortunately, the fire didn't spread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f253c59c-c303-31f5-a300-f4f33ffb886c",
                                        "entry_id": "b41e970e-53b5-3d67-b468-5fad858043ed",
                                        "glosses": [
                                            "One who maliciously sets fires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3d9caf2-d587-315c-b4e2-2876a3efa97c",
                                        "entry_id": "b41e970e-53b5-3d67-b468-5fad858043ed",
                                        "glosses": [
                                            "One who excites or inflames factions into quarrels."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9141e2e6-9b0f-4a67-930e-96b5b994be36",
                                                "sense_id": "b3d9caf2-d587-315c-b4e2-2876a3efa97c",
                                                "text": "March 7, 1692, Richard Bentley, The Folly of Atheism\nSeveral cities […] drove them out as incendiaries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
