                "senses": [
                    {
                        "sense_id": "3ae52436-1d5d-307e-997f-d486d5aa13c4",
                        "entry_id": "ec1d3422-4ac3-3c32-b486-ed143979da3f",
                        "glosses": [
                            "книжн. краткое и меткое наставительное изречение, нравоучительная сентенция"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "665c4f81-abc0-406c-8d4c-69bdb363c41c",
                                "sense_id": "3ae52436-1d5d-307e-997f-d486d5aa13c4",
                                "text": "Сборники апофегм попали в Россию через польское культурное посредничество."
                            },
                            {
                                "example_id": "5b484a8b-991d-49cd-8606-c25009136d9e",
                                "sense_id": "3ae52436-1d5d-307e-997f-d486d5aa13c4",
                                "text": "Я уже устал повторять вам, что ваш вызов не есть заманка, закрывающая враждебные намерения против вас, а скорее наоборот, но повторяю еще раз эту апофегму."
                            },
                            {
                                "example_id": "67e6b8d7-4c48-41dd-a7c4-633b609272fc",
                                "sense_id": "3ae52436-1d5d-307e-997f-d486d5aa13c4",
                                "text": "Его отчаяние излилось в нескончаемых апофегмах, изречениях, пословицах, ярко рисовавших и злую жену, и собственную его беду."
                            }
                        ]
                    }
                ],
