                "senses": [
                    {
                        "sense_id": "7c259a7c-7b1f-3f62-ac9a-308e9dc43b77",
                        "entry_id": "d56c0480-4477-34da-9858-88595e7c9dd1",
                        "glosses": [
                            "Remettre la tête de quelqu'un sur ses épaules (après décapitation)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475f52c1-9fba-413d-9e4f-3bf7744f3199",
                                "sense_id": "7c259a7c-7b1f-3f62-ac9a-308e9dc43b77",
                                "text": "La Terreur aurait quand même pu recapiter quelques malheureux !"
                            },
                            {
                                "example_id": "13f5db93-04b1-440e-b6dc-7d5b95ae30c8",
                                "sense_id": "7c259a7c-7b1f-3f62-ac9a-308e9dc43b77",
                                "text": "Si le Seigneur Dieu me permet de vous recapiter, selon mon bon vouloir, Parce que vous avez été débonnaire et secourable à vos sujets;"
                            },
                            {
                                "example_id": "f00553cf-485c-428d-a2eb-e2aed8999ea1",
                                "sense_id": "7c259a7c-7b1f-3f62-ac9a-308e9dc43b77",
                                "text": "Attention, dit-il, la tête va sauter au ciel, le corps va courir partout pour la chercher à fin de se recapiter."
                            },
                            {
                                "example_id": "9b18a241-4cdf-4b1c-82bc-4ea628c181a4",
                                "sense_id": "7c259a7c-7b1f-3f62-ac9a-308e9dc43b77",
                                "text": "Thèse, antithèse et prothèse: il faut recapiter Louis XVI."
                            }
                        ]
                    }
