                                        "entry_id": "e7684664-de4f-3cc9-84b6-7537172a8946",
                                        "glosses": [
                                            "eintönig, uninteressant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88185da8-99e1-4b18-ba4e-fbb49444eae6",
                                                "sense_id": "e2f5e82b-5cb1-3888-90c6-64396be984c4",
                                                "text": "Das ist ein langweiliges Buch."
                                            },
                                            {
                                                "example_id": "882612fe-c382-4108-8077-8f4b2eeca6af",
                                                "sense_id": "e2f5e82b-5cb1-3888-90c6-64396be984c4",
                                                "text": "Diesen Film finde ich langweilig."
                                            },
                                            {
                                                "example_id": "9d198410-e14f-4150-9570-00b80ed0247c",
                                                "sense_id": "e2f5e82b-5cb1-3888-90c6-64396be984c4",
                                                "text": "„Sie hatte in Berlin Schauspielerin werden wollen und war in Jerusalem die Frau eines langweiligen Juristen geworden.“"
                                            },
                                            {
                                                "example_id": "1118ffa1-3ec8-4043-85fb-81a176bb5240",
                                                "sense_id": "e2f5e82b-5cb1-3888-90c6-64396be984c4",
                                                "text": "„Es klingt nicht weltbewegend, eher langweilig und nach klassischem Graswurzelkampf.“"
                                            },
                                            {
                                                "example_id": "021c8dea-e994-4f9d-b11d-6572205c0ba3",
                                                "sense_id": "e2f5e82b-5cb1-3888-90c6-64396be984c4",
                                                "text": "„Damit es nicht zu langweilig wird, müssen die Probanden regelmäßig Matches und Challenges über sich ergehen lassen, Wettkämpfe und Herausforderungen also.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3260af2e-4847-346e-81cd-a5cca5f5268a",
                                        "entry_id": "e7684664-de4f-3cc9-84b6-7537172a8946",
                                        "glosses": [
                                            "sich über eine lange Zeitspanne erstreckend"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
