                "senses": [
                    {
                        "sense_id": "58cd5ca9-9fd8-3293-adc8-96c6847c1ab2",
                        "entry_id": "a19982ba-9383-33ae-9d5f-72062ed8230c",
                        "glosses": [
                            "Trick, mit dem man Steuern sparen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e087c876-522a-4447-82ff-172cb3ffbc3c",
                                "sense_id": "58cd5ca9-9fd8-3293-adc8-96c6847c1ab2",
                                "text": "„Allein der EU sollen wegen Steuertricks Einnahmen von bis zu einer Billion Euro fehlen.“"
                            },
                            {
                                "example_id": "b700e551-6e6a-4e1d-a22e-e66a5c90c09e",
                                "sense_id": "58cd5ca9-9fd8-3293-adc8-96c6847c1ab2",
                                "text": "Eigentlich wollen Europas Regierungen gemeinsam gegen die Steuertricks der Konzerne vorgehen. Doch nun fallen einige Staaten den anderen in den Rücken – und führen sogar neue Schlupflöcher ein."
                            },
                            {
                                "example_id": "50d80bd2-6c66-43d9-b59f-b44737cce112",
                                "sense_id": "58cd5ca9-9fd8-3293-adc8-96c6847c1ab2",
                                "text": "„[Großvermögen] nutzen einen Steuertrick über sogenannte Lebensversicherungsmäntel, das können sie [in Luxemburg] heute nach wie vor machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
