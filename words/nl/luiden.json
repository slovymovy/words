                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mensen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten spreekt men vaak over deze <w>luiden</w>.",
