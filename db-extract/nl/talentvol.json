                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begabt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73321843-ff31-3166-80d3-106e75a96cee",
                                        "entry_id": "745dc088-7ce0-3c01-847d-8489b4b79309",
                                        "glosses": [
                                            "Talent besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb2262d-3fe7-4e7f-88bd-7dde68b9fb14",
                                                "sense_id": "73321843-ff31-3166-80d3-106e75a96cee",
                                                "text": "Pablo Escobar ist begabt, er hat wirklich Talent."
                                            },
                                            {
                                                "example_id": "1b84cb19-acf4-454b-8efe-0483aec12ddc",
                                                "sense_id": "73321843-ff31-3166-80d3-106e75a96cee",
                                                "text": "„Wie John feststellte, waren seine beiden Schüler ungefähr gleich begabt, nur besaß Jako eine etwas bessere Auffassungsgabe als sein Mitschüler."
                                            },
                                            {
                                                "example_id": "f7ccc436-9f76-4f72-a85a-d7e02f67f938",
                                                "sense_id": "73321843-ff31-3166-80d3-106e75a96cee",
                                                "text": "„Begabt aber lahm ist der Deutsche, - begabt genug, sich an seiner Lahmheit zu ärgern und sie auf Teufel komm raus durch Illumination zu überkommen.“"
                                            },
                                            {
                                                "example_id": "322b9570-7e99-4e53-9ce4-b9b2137e1ad9",
                                                "sense_id": "73321843-ff31-3166-80d3-106e75a96cee",
                                                "text": "„Er liebt Rätsel, Wortspiele, Hieroglyphen und entwickelt bei ihrer Lösung oft einen Scharfsinn, der den mit dem Durchschnittsverstand begabten Menschenkindern unnatürlich erscheint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
