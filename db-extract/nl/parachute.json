                        "sense_id": "8528bdc3-d292-3181-aab3-67caba4e932e",
                        "entry_id": "7bc79567-e50f-3f4f-b58e-3484bfa0f03b",
                        "glosses": [
                            "een openvouwend scherm dat de valsnelheid dusdanig vertraagt dat iemand veilig uit een vliegtuig kan springen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497ad871-9dc0-488f-a301-3c4f7f0a260f",
                                "sense_id": "8528bdc3-d292-3181-aab3-67caba4e932e",
                                "text": "Het vuurwerk was voorzien van kleine parachuutjes waardoor het langer in de lucht zichtbaar kon blijven."
                            },
                            {
                                "example_id": "90e0c234-6664-4f33-a23a-e7d1f697560d",
                                "sense_id": "8528bdc3-d292-3181-aab3-67caba4e932e",
                                "text": "„Als je zo midden in de nacht naar beneden springt met een parachute, ja ik weet er niets van, maar ik neem aan dat het midden in de nacht moet zijn, dan ben je toch enorm bang?” Hij verzekerde haar dat hij niet bang zou zijn."
                            }
                        ]
                    }
                ],
