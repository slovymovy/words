                        "examples": [
                            {
                                "example_id": "7ca1d60a-2243-4de2-893d-59cdbaa392ba",
                                "sense_id": "ac015f87-73d6-3b76-8ef5-ecd3d7d63779",
                                "text": "Islamizacja na Bałkanach jest skutkiem różnych czynników. Najważniejszymi są przemoc ze strony władz osmańskich, szantaż ekonomiczny, wybór koniunkturalny oraz propaganda religijna"
                            },
                            {
                                "example_id": "4fa436a5-5f7e-4b11-9687-a7a8b1d6e1de",
                                "sense_id": "ac015f87-73d6-3b76-8ef5-ecd3d7d63779",
                                "text": "(…) islamizacja Arabów trwała ponad 300 lat"
                            }
                        ],
