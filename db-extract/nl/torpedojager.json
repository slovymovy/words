                "senses": [
                    {
                        "sense_id": "c34aac45-3c80-3ea0-bc47-65cab0e95099",
                        "entry_id": "6f048104-1f01-35d1-98ef-d90abff1558b",
                        "glosses": [
                            "snel en wendbaar oorlogsschip, dat bedoeld is voor het escorteren van grotere schepen in een vloot of gevechtseenheid en daarbij weerstand moet leveren tegen kleinere, maar krachtige aanvallers met korte-afstandsgeschut (oorspronkelijk torpedoboten, maar later ook onderzeeboten en vliegtuigen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a100462f-2586-49b1-b35c-bd7961ed681e",
                                "sense_id": "c34aac45-3c80-3ea0-bc47-65cab0e95099",
                                "text": "De zoekactie waaraan schepen en vliegtuigen uit 9 landen deelnemen, leverde vandaag voor het eerst iets op. De bemanning van een van de vliegtuigen had gisteravond een leeg reddingsvlot zien dobberen op de golven in het zoekgebied van ruim 482.000 vierkante kilometer (bijna net zo groot als Spanje, red.). ,,De bemanning van een korvet en torpedojager is er ondanks de vijf tot zes meter hoge golven vandaag in geslaagd het vlot aan boord te hijsen."
                            },
                            {
                                "example_id": "f02bb113-bad9-4575-8de0-38b894826b9a",
                                "sense_id": "c34aac45-3c80-3ea0-bc47-65cab0e95099",
                                "text": "Ook Groot-Brittannië is twee wrakken van marineschepen in de Javazee grotendeels kwijt. Onderzoek heeft uitgewezen dat de overblijfselen van de zware kruiser Exeter en de torpedojager Encounter grotendeels van de bodem van de zee zijn verdwenen."
                            },
                            {
                                "example_id": "e63d7c3e-f283-4b34-8cb8-97353ba482af",
                                "sense_id": "c34aac45-3c80-3ea0-bc47-65cab0e95099",
                                "text": "Zes dagen later werd de UB-29 door de Britten als ‘vernietigd’ aangegeven. De torpedojager HMS Landrail merkte de boot op en ramde hem. Toen de Duitsers probeerden te ontsnappen, werden nog twee dieptebommen op de UB-29 gedropt."
                            },
                            {
                                "example_id": "483822b1-8d37-49d8-8ff5-19ee7471719b",
                                "sense_id": "c34aac45-3c80-3ea0-bc47-65cab0e95099",
                                "text": "Gedurende het dappere maar zinloze verzet brachten ze drie Duitse kruisers en meerdere torpedojagers tot zinken, vooral in het noorden leden de Duitsers zware verliezen."
                            }
                        ]
                    }
                ],
