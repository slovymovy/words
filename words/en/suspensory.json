    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3da69abd-1f1e-3e8e-a63b-13380ddd4ef5",
                    "sense_definition": "Serving to suspend or hold something up, especially an organ or body part.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the <w>suspensory</w> ligament in the patient's ankle to check for damage.",
                            "target_lang_translations": {
                                "tr": "Doktor, hasar olup olmadığını kontrol etmek için hastanın ayak bileğindeki <w>asıcı</w> bağı muayene etti."
                            }
                        },
                        {
                            "text": "A strong <w>suspensory</w> ligament helps keep the joint stable during heavy exercise.",
                            "target_lang_translations": {
                                "tr": "Güçlü bir <w>asıcı</w> bağ, ağır egzersiz sırasında eklemin stabil kalmasına yardımcı olur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suspensory ligament",
                        "suspensory muscle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily medical/anatomy context"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle bir organı veya vücut bölümünü asmaya, askıda tutmaya veya desteklemeye yarayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "asıcı",
                                "target_lang_sense_clarification": "anatomi/tıbbi"
                            },
                            {
                                "target_lang_word": "destekleyici",
                                "target_lang_sense_clarification": "genel/anatomik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b69c2a59-35d6-3589-a861-33acd4c1a4c3",
                    "sense_definition": "Held or maintained in a state of suspension.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fine particles remained in a <w>suspensory</w> state within the dense fluid.",
                            "target_lang_translations": {
                                "tr": "İnce parçacıklar yoğun sıvının içinde <w>askıda</w> bir halde kaldı."
                            }
                        },
                        {
                            "text": "The mixture maintained its <w>suspensory</w> condition for several hours before settling.",
                            "target_lang_translations": {
                                "tr": "Karışım, çökelmeden önce birkaç saat boyunca <w>askıdaki</w> durumunu korudu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Süspansiyon (askıda kalma) durumunda tutulan veya sürdürülen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "askıda",
                                "target_lang_sense_clarification": "süspansiyon halinde olan"
                            },
                            {
                                "target_lang_word": "süspansiyonel",
                                "target_lang_sense_clarification": "fiziksel/kimyasal durum"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "480066da-ae12-3b55-9925-0ef2c42d2c41",
                    "sense_definition": "A suspensory ligament or supporting anatomical structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The racehorse suffered a severe injury to its <w>suspensory</w> during the final stretch of the competition.",
                            "target_lang_translations": {
                                "tr": "Yarış atı, yarışmanın son düzlüğünde <w>asıcı bağı</w> üzerinde ciddi bir yaralanma yaşadı."
                            }
                        },
                        {
                            "text": "The vet carefully treated the damaged <w>suspensory</w> to help the horse recover fully.",
                            "target_lang_translations": {
                                "tr": "Veteriner, atın tamamen iyileşmesine yardımcı olmak için hasarlı <w>asıcı bağı</w> dikkatle tedavi etti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Asıcı bağ (süspansör bağ) veya destekleyici anatomik yapı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "asıcı bağ",
                                "target_lang_sense_clarification": "anatomi"
                            },
                            {
                                "target_lang_word": "süspansör",
                                "target_lang_sense_clarification": "bağ/dokusu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a461b8e-38e4-30e1-ac86-81f140de2c8b",
                    "sense_definition": "A supportive bandage, strap, or athletic supporter (jockstrap).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was advised to wear a <w>suspensory</w> to prevent further injury during training.",
                            "target_lang_translations": {
                                "tr": "Antrenman sırasında daha fazla yaralanmayı önlemek için sporcuya <w>suspenuar</w> takması tavsiye edildi."
                            }
                        },
                        {
                            "text": "He bought a new <w>suspensory</w> at the medical supply store.",
                            "target_lang_translations": {
                                "tr": "Tıbbi malzeme mağazasından yeni bir <w>suspenuar</w> satın aldı."
                            }
