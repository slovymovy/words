                "senses": [
                    {
                        "sense_id": "88691eaa-1399-33fa-9bfb-4dcccec0ae5a",
                        "entry_id": "f4650080-6248-317f-94bd-57314f2846c4",
                        "glosses": [
                            "Person, die freiwillig und in der Regel für einen begrenzten Zeitraum in einem Entwicklungsland an dessen Aufbau mitwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9258d640-61ec-4be3-8931-6cf0b03b64c7",
                                "sense_id": "88691eaa-1399-33fa-9bfb-4dcccec0ae5a",
                                "text": "„Ich war zum Essen bei einem französischen Entwicklungshelfer in Bobo-Dioulasso eingeladen.“"
                            },
                            {
                                "example_id": "5e826ab5-b7be-47a4-97fb-b3612b330f15",
                                "sense_id": "88691eaa-1399-33fa-9bfb-4dcccec0ae5a",
                                "text": "„Aber wir durften uns bei der Ankunft auf etwas freuen: Angel hatte auf ihrer legendären LKW-Reise in Mali einige Entwicklungshelfer kennengelernt, und über einen davon hatte sie vage Kontakte in den Niger aufbauen können.“"
                            },
                            {
                                "example_id": "26d77202-216d-42ba-bb2f-d3cffcc75252",
                                "sense_id": "88691eaa-1399-33fa-9bfb-4dcccec0ae5a",
                                "text": "„Ein älterer Typ will mir ein Foto von irgendeinem Entwicklungshelfer zeigen, den er vor zwanzig Jahren gekannt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
