                },
                {
                    "sense_id": "5cf4471b-7646-31b5-997b-54c331e0ad4c",
                    "sense_definition": "D'une manière extraordinaire, hors du commun ou à un degré très élevé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune pianiste est <w>exceptionnellement</w> douée et impressionne tous ses professeurs de musique."
                        },
                        {
                            "text": "Il fait une température <w>exceptionnellement</w> douce pour cette période de l'année."
