                        "glosses": [
                            "Qui est sans art, non artificiel, évident."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0abf74a4-0677-4e90-b089-8667e39dea4c",
                                "sense_id": "2245ed26-8438-3d36-960a-c69775a163cf",
                                "text": "Aristote distingue les preuves en artificielles et inartificielles ; cette distinction est adoptée par Cicéron, Quintilien et tous les rhéteurs : les premières sont celles qu'on tire du raisonnement ; les secondes sont celles que l'on trouve toutes faites, comme les lois, les actes, les dépositions des témoins, et que l'on ne fait que mettre en usage."
                            }
                        ]
                    }
