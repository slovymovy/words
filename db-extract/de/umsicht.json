                "senses": [
                    {
                        "sense_id": "fb1fa5fa-5f8b-3713-9860-032b5e1afb9e",
                        "entry_id": "b2ec47d4-fe1f-3408-8120-c9440c5e8dae",
                        "glosses": [
                            "Qualité d’une personne qui agit avec attention, de manière réfléchie, avec circonspection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df07ab03-ee4d-4bc3-aee9-8f57f5645e6f",
                                "sense_id": "fb1fa5fa-5f8b-3713-9860-032b5e1afb9e",
                                "text": "Wir mussten mit großer Umsicht vorgehen, da die Situation nicht ungefährlich war."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7a700ed-1ee9-3299-b1f8-5513696878e2",
                        "entry_id": "b2ec47d4-fe1f-3408-8120-c9440c5e8dae",
                        "glosses": [
                            "Qualité d’une personne attentionnée, prévenante ; prévenance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0429708a-a7b9-4291-ad76-6f633575b695",
                                "sense_id": "d7a700ed-1ee9-3299-b1f8-5513696878e2",
                                "text": "Mit ihrer Umsicht und Freundlichkeit hat unsere Gastgeberin zum Erfolg des Aufenthalts beigetragen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
