                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "00117e77-8bd4-49cc-aa66-1bd3789fb2f1",
                        "entry_id": "61b6dde0-964f-3270-ad5e-6cca3fd10509",
                        "tags": [
                            "plural",
