                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a <w>assuré</w> à ses employés que l'entreprise était solide.",
                            "target_lang_translations": {
                                "en": "The director <w>assured</w> his employees that the company was sound.",
                                "ru": "Директор <w>заверил</w> сотрудников, что компания финансово устойчива.",
                                "de": "Der Direktor <w>versicherte</w> seinen Mitarbeitern, dass das Unternehmen finanziell solide war.",
                                "es": "El director <w>aseguró</w> a sus empleados que la empresa era sólida.",
                                "zh": "经理向员工<w>保证</w>，公司的状况很稳健。"
                            }
                        },
                        {
                            "text": "Grâce à cette victoire, l'équipe a <w>assuré</w> sa qualification pour la finale.",
                            "target_lang_translations": {
                                "en": "Thanks to that victory, the team <w>secured</w> its place in the final.",
                                "ru": "Благодаря этой победе команда <w>обеспечила</w> себе выход в финал.",
                                "de": "Dank dieses Sieges hat sich das Team den Einzug ins Finale <w>gesichert</w>.",
                                "es": "Gracias a esa victoria, el equipo <w>aseguró</w> su pase a la final.",
                                "zh": "凭借这场胜利，球队<w>取得</w>了决赛资格。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past participle of the verb assurer, meaning to assure or to secure.",
