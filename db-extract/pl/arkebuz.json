                    },
                    {
                        "translation_id": "5eae9e83-cbba-462c-aba0-347fdb7730c3",
                        "source_entry_id": "f3d22d89-ca93-3414-9046-90e7b7a35615",
                        "source_sense_id": "f102141f-6f32-3043-990d-7590f1b7278b",
                        "target_lang_word": "arquebuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arquebuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b570d16-6b4d-3c85-8cde-e4c98f7f5e6a",
                                        "entry_id": "31f96e67-d210-3523-a35f-13863a4d45ad",
                                        "glosses": [
                                            "Ancienne arme à feu qu’on faisait partir au moyen d’une mèche."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "573242b0-c888-47bb-a030-af10208af257",
                                                "sense_id": "5b570d16-6b4d-3c85-8cde-e4c98f7f5e6a",
                                                "text": "Come je les veis esbranler pour tirer sur nous, je couchay mon arquebuse en jouë, visay droit à un des trois chefs, & de ce coup il en tomba deux par terre, & un de leurs compagnons qui fut blessé, qui quelque temps apres en mourut."
                                            },
                                            {
                                                "example_id": "9dce1102-f499-4c31-96d4-3475cd12f6d5",
                                                "sense_id": "5b570d16-6b4d-3c85-8cde-e4c98f7f5e6a",
                                                "text": "Ce qu’il voit encore, ce sont des soudards qui, […], criblent de coups d’arquebuse un oiseau de bois fiché à la pointe d’un mai."
                                            },
                                            {
                                                "example_id": "b2e56d85-d7db-4e34-a16f-6f4e04df8da2",
                                                "sense_id": "5b570d16-6b4d-3c85-8cde-e4c98f7f5e6a",
                                                "text": "J’ai dix arquebuses dans cette chambre, reprit Charles IX, avec lesquelles je touche un écu d’or à cent cinquante pas. Voulez-vous en essayer une ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ab9753-4659-3738-ad91-16c7cb689508",
                                        "entry_id": "31f96e67-d210-3523-a35f-13863a4d45ad",
                                        "glosses": [
                                            "Boisson alcoolisée préparée par macération et distillation de plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2e35518-2a09-4b0f-b0fb-ac819324608c",
                                                "sense_id": "d0ab9753-4659-3738-ad91-16c7cb689508",
                                                "text": "Marie Martin : Oh oh ! vous n’êtes pas bien mon père…\nLe moine : Non pas tellement, j’ai les jambes tout mollettes.\nMarie Martin : Attendez, vous allez boire un verre d’arquebuse.\nLe moine : Merci, ça me les rendra pour me remettre en route."
                                            },
                                            {
                                                "example_id": "c66ff01b-7bf5-44fb-b935-066d409a3db0",
                                                "sense_id": "d0ab9753-4659-3738-ad91-16c7cb689508",
                                                "text": "Selon certaines sources l’arquebuse ne serait plus commercialisée."
                                            }
                                        ]
                                    }
                                ]
                            },
