                            }
                        ]
                    },
                    {
                        "translation_id": "11802212-f1ef-4a5d-85e2-247272497f2b",
                        "source_entry_id": "37dc42b8-2fdf-372b-98b0-1b1d09894e2c",
                        "source_sense_id": "ab8a5cb6-13af-3fe5-a67a-bdaf3ecd4dfa",
                        "target_lang_word": "cosmologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "128fa177-0c37-3416-917e-5ebca8031c9f",
                                        "entry_id": "aef2b4c0-c295-3a72-bbd4-035a18e2464c",
                                        "glosses": [
                                            "Qui appartient, qui a rapport à la cosmologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bf650ad-ee4d-4519-9c0d-384f76dd54f1",
                                                "sense_id": "128fa177-0c37-3416-917e-5ebca8031c9f",
                                                "text": "Ces idéologies cosmologiques n’ont aucune efficience en soi, mais seulement par l’intermédiaire des structures sociales qui les réalisent et qu’elles légitiment. Cette histoire de succès ou d’échec est une histoire de systèmes sociaux, pas de religions."
                                            },
                                            {
                                                "example_id": "74159d87-96be-4b92-88d2-ed2e1ee74e85",
                                                "sense_id": "128fa177-0c37-3416-917e-5ebca8031c9f",
                                                "text": "\"Cette découverte réconcilie notre connaissance actuelle de la formation et de l'évolution des galaxies avec le modèle cosmologique le plus courant\", a dit la Dre Mireia Montes, astronome à l'Université australienne de Nouvelle-Galles du Sud, principale auteure de l'étude (...)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f65e39a-18c7-3280-a833-6914d057ac16",
                                        "entry_id": "aef2b4c0-c295-3a72-bbd4-035a18e2464c",
                                        "glosses": [
                                            "Qui a des dimensions de l’ordre de celles de l’univers."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecce6dc9-a065-4619-98bd-fafb239ca224",
                                                "sense_id": "4f65e39a-18c7-3280-a833-6914d057ac16",
                                                "text": "Pour confirmer le scénario que nous avons décrit, il est nécessaire d’observer des étoiles noires. Or ces astres sont à des distances cosmologiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a469942a-87e3-43f1-9f48-6ecafebbb7af",
                        "source_entry_id": "37dc42b8-2fdf-372b-98b0-1b1d09894e2c",
                        "source_sense_id": "ab8a5cb6-13af-3fe5-a67a-bdaf3ecd4dfa",
                        "target_lang_word": "kosmologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kosmologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de539436-b069-3cae-ad1b-a24469908fb4",
                                        "entry_id": "1092d07d-f7cc-30e9-98c6-757b319dab1f",
                                        "glosses": [
                                            "die Kosmologie betreffend; zur Kosmologie gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559174aa-ac59-4ab1-baa4-c9664291d46d",
                                                "sense_id": "de539436-b069-3cae-ad1b-a24469908fb4",
                                                "text": "„Als Einstein erkannte, dass die Feldgleichungen kein kosmologisches Modell eines statischen Universums ermöglichen, führte er 1917 die kosmologische Konstante ein.“"
                                            },
                                            {
                                                "example_id": "bc1a6e84-2e8f-4cf4-9d58-af3194092ad7",
                                                "sense_id": "de539436-b069-3cae-ad1b-a24469908fb4",
                                                "text": "„Als kosmologische Inflation wird eine Phase extrem rascher Expansion des Universums bezeichnet, von der man annimmt, dass sie unmittelbar nach dem Urknall stattgefunden hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
