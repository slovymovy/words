                        "source_sense_id": "337cc8c5-a850-3cfd-8b27-fafffa35bc01",
                        "target_lang_word": "wanly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wanly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee1fcdb-338c-32f3-a917-ebf2c15caa8e",
                                        "entry_id": "68025efb-45bc-3de7-856c-9f967044faf8",
                                        "glosses": [
                                            "In a wan or pale manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "697441cc-014b-42dd-92dd-0a547c089fd5",
                                                "sense_id": "8ee1fcdb-338c-32f3-a917-ebf2c15caa8e",
                                                "text": "She has the faded look of a St. James's Street illumination, as it may be seen of an early morning, when half the lamps are out, and the others are blinking wanly, as if they were about to vanish like ghosts before the dawn."
                                            },
                                            {
                                                "example_id": "a9d23c65-273c-41a8-895a-31290c0a2b88",
                                                "sense_id": "8ee1fcdb-338c-32f3-a917-ebf2c15caa8e",
                                                "text": "Having turned about, he kept his horse to a walk, and at this gait the sleighbells tinkled but intermittently. Gleaming wanly through the whitish vapour that kept rising from the trotter’s body and flanks, they were like tiny fog-bells, and made the only sounds in a great winter silence."
                                            },
                                            {
                                                "example_id": "8301c3aa-4724-4844-9297-e1edeac080c7",
                                                "sense_id": "8ee1fcdb-338c-32f3-a917-ebf2c15caa8e",
                                                "text": "[…] [he] spent a lot of time wanly imagining how warm and secure marriage must make men feel […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a80104-41c2-4357-b73d-47600c528ab3",
                        "source_entry_id": "5814a01b-8c9b-3df2-92e2-e4acf8b022b9",
                        "source_sense_id": "372200bd-0c4f-3488-91c7-68e2aa078f4d",
                        "target_lang_word": "weedily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weedily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62034e74-6fb7-3f6e-a724-7bbe946fed4c",
                                        "entry_id": "14309172-1238-368b-847b-98a48cdea264",
                                        "glosses": [
                                            "In a weedy manner; feebly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f01b57-d3d6-4c13-bbeb-9a7f44196c20",
                                                "sense_id": "62034e74-6fb7-3f6e-a724-7bbe946fed4c",
                                                "text": "Or to put it another way: could a song end your life? Could just one number, performed weedily by Keira Knightley at the beginning of this romcom, cause your body to self-combust at the prospect of enduring 90-odd minutes of a movie obsessed with authenticity but as phoney as a Miley Cyrus dance routine?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5e720e5-d2a2-3da5-ba4d-0d24a249ef49",
                                        "entry_id": "14309172-1238-368b-847b-98a48cdea264",
                                        "glosses": [
                                            "In a weedy state; full of weeds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04a39394-1320-41db-8dc4-c71535cf9cfa",
                                                "sense_id": "e5e720e5-d2a2-3da5-ba4d-0d24a249ef49",
                                                "text": "The old-fashioned stoop, with its suggestive benches on either side, lay solitary and silent in the moonlight; the garden path, weedily overgrown since father's death, and sentineled here and there with ragged hollyhock, lay quiet and dew-laden […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
