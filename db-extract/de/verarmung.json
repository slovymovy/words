                ],
                "senses": [
                    {
                        "sense_id": "07b5c221-0e2b-359d-bc53-2a109839eca7",
                        "entry_id": "fb17e7a1-c989-3f39-88ee-5be3219d2f4c",
                        "glosses": [
                            "Vorgang, bei dem ein Verlust an finanziellen und anderen Mitteln eintritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81fbfbe0-22cd-457c-b198-9f16b6e824bc",
                                "sense_id": "07b5c221-0e2b-359d-bc53-2a109839eca7",
                                "text": "„Die massive Geldentwertung der Reichsmark seit Beginn des Ersten Weltkrieges führte in diesen Jahren zu einer Verarmung großer Teile der deutschen Mittelschicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60ed3f95-3316-4078-a353-3a7fed4db003",
                        "source_entry_id": "fb17e7a1-c989-3f39-88ee-5be3219d2f4c",
                        "source_sense_id": "07b5c221-0e2b-359d-bc53-2a109839eca7",
                        "source_sense_description": "Vorgang, bei dem ein Verlust an finanziellen und anderen Mitteln eintritt",
                        "target_lang_word": "appauvrissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appauvrissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59481db9-4b25-3291-b1a8-784b11897c0b",
                                        "entry_id": "85f6521c-cb67-3c44-9a64-416b783c942e",
                                        "glosses": [
                                            "Action d’appauvrir ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a3e8c59-7edd-4841-b50d-d2a8cbac583d",
                                                "sense_id": "59481db9-4b25-3291-b1a8-784b11897c0b",
                                                "text": "Les projets de remplacement font la gloire de l’appauvrissement formel dans le neuf et de la course à la façade épaisse en réhabilitation, aidés en cela par des règles, des normes et des labels qui justifient la démarche."
                                            },
                                            {
                                                "example_id": "0397290b-c450-4229-a632-f10580bda01b",
                                                "sense_id": "59481db9-4b25-3291-b1a8-784b11897c0b",
                                                "text": "« L’appauvrissement des stocks comporte des incidences pour la sécurité alimentaire et le développement économique, réduit la qualité de la vie dans les pays du monde entier et nuit au bien-être des écosystèmes sous-marins », a déclaré Ichiro Nomura, Sous-Directeur général de la FAO pour les pêches."
                                            },
                                            {
                                                "example_id": "4eac7658-e4a7-4f77-9dce-13503011f08c",
                                                "sense_id": "59481db9-4b25-3291-b1a8-784b11897c0b",
                                                "text": "Utilisées principalement par les activités industrielles, les substances en cause sont les suivantes : […] -les halons utilisés dans les matériels d’extinction des incendies ; ils ont un potentiel d’appauvrissement de la couche d’ozone très élevé […]"
                                            },
                                            {
                                                "example_id": "abab65b5-2747-4247-93f2-4cde414706a2",
                                                "sense_id": "59481db9-4b25-3291-b1a8-784b11897c0b",
                                                "text": "En considérant l’appauvrissement des ménages et non pas du seul travailleur, les résultats de l’enquête élargissent le champ des personnes en difficulté, et des réponses à apporter : à quoi sert un salaire ? Doit-il couvrir les besoins vitaux de la personne elle-même ou assurer l’existence de toute une famille ? Présumer que le salaire d’un emploi à plein temps devrait suffire pour une famille entre en contradiction avec la réalité actuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cba64caa-5866-4abd-a4af-636c501eabb8",
                        "source_entry_id": "fb17e7a1-c989-3f39-88ee-5be3219d2f4c",
                        "source_sense_id": "07b5c221-0e2b-359d-bc53-2a109839eca7",
                        "source_sense_description": "Vorgang, bei dem ein Verlust an finanziellen und anderen Mitteln eintritt",
                        "target_lang_word": "verpaupering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verpaupering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc72dbf-9249-3d29-bd25-f264cfff490f",
                                        "entry_id": "bf9839eb-a0fd-34dc-bdce-7bfcf59365ec",
                                        "glosses": [
                                            "het armoediger worden van iets of iemand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "249de2ea-8c71-49f6-ae6f-45db1b341fde",
                                                "sense_id": "5dc72dbf-9249-3d29-bd25-f264cfff490f",
                                                "text": "In plaats van een moreel zuiver wezen, dat de verdorven stadsbewoner tot voorbeeld kon dienen, bleek de boer bij Tsjechov grof en beestachtig te zijn, als gevolg van de armoede en verpaupering waarin hij leefde."
                                            },
                                            {
                                                "example_id": "340b326a-675d-4aa7-be67-16906a7b9557",
                                                "sense_id": "5dc72dbf-9249-3d29-bd25-f264cfff490f",
                                                "text": "Maar ook in Deventer komen steeds meer boerenerven leeg te staan. Grijsen, verantwoordelijk voor ruimtelijke ordening en plattelandsbeleid, verwacht dat de komende jaren ook een deel van de 250 boeren in Deventer stopt. Om verpaupering van het platteland te voorkomen, zet Deventer als een van de weinige gemeenten juist wel in op de realisatie van woningen op boerenerven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbe34a14-941c-4b85-9c60-4bec2d6f96f1",
                        "source_entry_id": "fb17e7a1-c989-3f39-88ee-5be3219d2f4c",
                        "source_sense_id": "07b5c221-0e2b-359d-bc53-2a109839eca7",
                        "source_sense_description": "Vorgang, bei dem ein Verlust an finanziellen und anderen Mitteln eintritt",
                        "target_lang_word": "обеднение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обеднение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5fd349b8-b108-3d61-a958-0e1a7bb71440",
                                        "entry_id": "4e5e8367-f2a2-3165-8e35-373c85267158",
                                        "glosses": [
                                            "действие по значению гл. беднеть, обеднеть, обеднять, обеднить; снижение уровня благосостояния"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97cb8025-3119-405b-bc06-59e7d5304cf9",
                                                "sense_id": "5fd349b8-b108-3d61-a958-0e1a7bb71440",
                                                "text": "С тех пор обеднение шло с такою поразительною быстротою, что через несколько лет у него уже не осталось ровно ничего."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d8309f9-4cf3-316b-ba63-baf2bbfdf420",
                                        "entry_id": "4e5e8367-f2a2-3165-8e35-373c85267158",
                                        "glosses": [
                                            "результат такого действия; бедность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a860fe2e-7c17-4315-817e-f93e0066fc79",
                                                "sense_id": "8d8309f9-4cf3-316b-ba63-baf2bbfdf420",
                                                "text": "Впрочем при нынешнем обеднении города, лавки эти содержат только предметы весьма малоценные: грубый холст, табак, фрукты и т. п."
                                            }
                                        ]
                                    },
