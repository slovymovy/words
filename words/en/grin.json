{
    "word_family": [
        "grinner",
        "grinningly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c5093b9-054f-3ee5-891a-008c7d0c3aa0",
                    "sense_definition": "To smile broadly, often parting the lips to show the teeth, typically expressing amusement or pleasure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "smiling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little boy began to <w>grin</w> from ear to ear when he saw the giant ice cream cone.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик начал <w>улыбаться до ушей</w>, когда увидел гигантский рожок мороженого."
                            }
                        },
                        {
                            "text": "Why do you <w>grin</w> like that every time I mention his name?",
                            "target_lang_translations": {
                                "ru": "Почему ты так <w>ухмыляешься</w> каждый раз, когда я упоминаю его имя?"
                            }
                        }
                    ],
                    "synonyms": [
                        "beam",
                        "smile"
                    ],
                    "antonyms": [
                        "frown",
                        "scowl"
                    ],
                    "common_phrases": [
                        "grin from ear to ear",
                        "grin and bear it",
                        "grin sheepishly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко улыбаться, часто обнажая зубы, обычно выражая веселье или удовольствие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбаться во весь рот",
                                "target_lang_sense_clarification": "широко и радостно"
                            },
                            {
                                "target_lang_word": "расплыться в улыбке",
                                "target_lang_sense_clarification": "внезапно широко улыбнуться"
                            },
                            {
                                "target_lang_word": "осклабиться",
                                "target_lang_sense_clarification": "широко улыбнуться, обнажив зубы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e6ec1b2-5772-3673-bb1f-1788ea815c44",
                    "sense_definition": "To express a specific feeling or reaction by smiling in a particular way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smiling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>grinned</w> her approval as the team finally finished the difficult project.",
                            "target_lang_translations": {
                                "ru": "Она <w>выразила улыбкой</w> свое одобрение, когда команда наконец закончила сложный проект."
                            }
                        },
                        {
                            "text": "He <w>grinned</w> a broad smile when I told him the final result of the race.",
                            "target_lang_translations": {
                                "ru": "Он <w>расплылся в широкой улыбке</w>, когда я сообщил ему окончательный результат гонки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grin a broad smile",
                        "grin a cruel sneer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать определенное чувство или реакцию, улыбаясь особым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усмехаться",
                                "target_lang_sense_clarification": "выражать отношение через улыбку"
                            },
                            {
                                "target_lang_word": "ухмыляться",
                                "target_lang_sense_clarification": "выражать самодовольство или иронию"
                            },
                            {
                                "target_lang_word": "выражать улыбкой",
                                "target_lang_sense_clarification": "показывать реакцию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0668f0ca-c970-33c8-999c-a2bde894b932",
                    "sense_definition": "To show the teeth in a way that resembles a snarling animal, often due to pain or anger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dying soldier began to <w>grin</w> in agony as the pain became unbearable.",
                            "target_lang_translations": {
                                "ru": "Умирающий солдат начал <w>скалиться</w> в агонии, когда боль стала невыносимой."
                            }
                        },
                        {
                            "text": "The stuffed fox in the corner <w>grinned</w> fiercely at the children from its glass case.",
                            "target_lang_translations": {
                                "ru": "Чучело лисы в углу свирепо <w>оскалилось</w> на детей из своей стеклянной витрины."
                            }
                        }
                    ],
                    "synonyms": [
                        "snarl",
                        "grimace"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскаливать зубы подобно рычащему животному, часто из-за боли или гнева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скалиться",
                                "target_lang_sense_clarification": "показывать зубы от боли или злости"
                            },
                            {
                                "target_lang_word": "оскаливаться",
                                "target_lang_sense_clarification": "принимать вид оскала"
                            },
                            {
                                "target_lang_word": "гримасничать",
                                "target_lang_sense_clarification": "искажать лицо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58976188-ffe0-342d-bc4c-a21deb565949",
                    "sense_definition": "A wide smile that shows the teeth.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "smiling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the ceremony was finished, a wide <w>grin</w> broke across his face.",
                            "target_lang_translations": {
                                "ru": "Когда церемония закончилась, на его лице появилась широкая <w>улыбка</w>."
                            }
                        },
                        {
                            "text": "She had a mischievous <w>grin</w> that suggested she was up to no good.",
                            "target_lang_translations": {
                                "ru": "У нее была озорная <w>ухмылка</w>, намекавшая на то, что она что-то замышляет."
                            }
                        }
                    ],
                    "synonyms": [
                        "smile",
                        "beam"
                    ],
                    "antonyms": [
                        "frown",
                        "scowl"
                    ],
                    "common_phrases": [
                        "wide grin",
                        "mischievous grin",
                        "toothy grin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкая улыбка, при которой видны зубы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбка до ушей",
                                "target_lang_sense_clarification": "очень широкая улыбка"
                            },
                            {
                                "target_lang_word": "ухмылка",
                                "target_lang_sense_clarification": "самодовольная или ироничная улыбка"
                            },
                            {
                                "target_lang_word": "оскал",
                                "target_lang_sense_clarification": "широкая улыбка с обнажением зубов"
                            },
                            {
                                "target_lang_word": "усмешка",
                                "target_lang_sense_clarification": "краткая улыбка, выражающая эмоцию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efacd85a-f8e0-3ab7-b039-ac704307ff64",
                    "sense_definition": "A trap or snare used for catching animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "traps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter set a <w>grin</w> in the woods to catch the rabbit.",
                            "target_lang_translations": {
                                "ru": "Охотник поставил <w>силок</w> в лесу, чтобы поймать кролика."
                            }
                        },
                        {
                            "text": "The old text described how to build a <w>grin</w> from simple wire and wood.",
                            "target_lang_translations": {
                                "ru": "В старом тексте описывалось, как сделать <w>ловушку</w> из обычной проволоки и дерева."
                            }
                        }
                    ],
                    "synonyms": [
                        "snare",
                        "gin",
                        "trap"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловушка или силок, используемые для ловли животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "силок",
                                "target_lang_sense_clarification": "петля для ловли птиц и зверей"
                            },
                            {
                                "target_lang_word": "западня",
                                "target_lang_sense_clarification": "ловушка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}