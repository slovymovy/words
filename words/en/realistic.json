{
    "word_family": [
        "realism",
        "realist",
        "reality",
        "realize",
        "realistically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "560a0ae5-2113-3b25-acbc-87249f205df4",
                    "sense_definition": "Accepting or representing things as they really are and being practical rather than idealistic.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "practicality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to have a <w>realistic</w> expectation of what we can achieve this month.",
                            "target_lang_translations": {
                                "ru": "Нам нужно иметь <w>реалистичные</w> ожидания относительно того, чего мы можем достичь в этом месяце.",
                                "zh": "对于这个月能取得的成就，我们需要有<w>现实的</w>预期。"
                            }
                        },
                        {
                            "text": "It is important to provide a <w>realistic</w> appraisal of the situation before making a decision.",
                            "target_lang_translations": {
                                "ru": "Важно дать <w>трезвую</w> оценку ситуации перед принятием решения.",
                                "zh": "在做决定之前，对局势做出<w>务实的</w>评估非常重要。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unrealistic",
                        "utopian"
                    ],
                    "common_phrases": [
                        "realistic expectation",
                        "realistic appraisal",
                        "realistic goal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принятие или представление вещей такими, какие они есть на самом деле; практичность вместо идеализма.",
                        "zh": "接受或呈现事物的真实面貌，讲求实际而非理想化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реалистичный",
                                "target_lang_sense_clarification": "основанный на фактах и реальности"
                            },
                            {
                                "target_lang_word": "трезвый",
                                "target_lang_sense_clarification": "о взгляде на вещи или оценке"
                            },
                            {
                                "target_lang_word": "прагматичный",
                                "target_lang_sense_clarification": "практичный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现实的",
                                "target_lang_sense_clarification": "基于事实和实际情况的"
                            },
                            {
                                "target_lang_word": "务实的",
                                "target_lang_sense_clarification": "讲求实际、不空谈的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeab5e9e-b700-30a9-be1b-d4d293a8b287",
                    "sense_definition": "Representing objects, actions, or conditions in a way that is accurate and true to life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist created a <w>realistic</w> portrait that looked exactly like the subject.",
                            "target_lang_translations": {
                                "ru": "Художник создал <w>реалистичный</w> портрет, который выглядел в точности как натурщик.",
                                "zh": "这位艺术家创作了一幅<w>逼真的</w>肖像画，看起来和本人一模一样。"
                            }
                        },
                        {
                            "text": "The author wrote a <w>realistic</w> novel about the daily lives of the Victorian poor.",
                            "target_lang_translations": {
                                "ru": "Автор написал <w>реалистический</w> роман о повседневной жизни бедняков викторианской эпохи.",
                                "zh": "作者写了一部关于维多利亚时代穷人日常生活的<w>写实</w>小说。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unrealistic"
                    ],
                    "common_phrases": [
                        "realistic portrait",
                        "realistic novel",
                        "realistic depiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение объектов, действий или условий способом, который является точным и правдоподобным.",
                        "zh": "以准确且符合生活真实性的方式描绘物体、动作或状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реалистичный",
                                "target_lang_sense_clarification": "правдоподобный"
                            },
                            {
                                "target_lang_word": "реалистический",
                                "target_lang_sense_clarification": "относящийся к направлению в искусстве"
                            },
                            {
                                "target_lang_word": "жизненный",
                                "target_lang_sense_clarification": "соответствующий действительности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逼真的",
                                "target_lang_sense_clarification": "外观或描述非常接近真实的"
                            },
                            {
                                "target_lang_word": "写实的",
                                "target_lang_sense_clarification": "艺术或文学作品中忠实于现实的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}