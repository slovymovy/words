                {
                    "sense_id": "da3a79c8-f440-3d7f-8bcb-a2c6a34d7439",
                    "sense_definition": "Een kleinste zelfstandig gebruikte eenheid van taal die een betekenis heeft.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "taaleenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het woordenboek kun je de betekenis van een <w>woord</w> opzoeken.",
                            "target_lang_translations": {
                                "en": "You can look up the meaning of a <w>word</w> in the dictionary."
                            }
                        },
                        {
                            "text": "Zij begreep geen enkel <w>woord</w> van wat de leraar zei.",
                            "target_lang_translations": {
                                "en": "She didn't understand a single <w>word</w> of what the teacher said."
                            }
                        }
                    ],
                    "synonyms": [
                        "term",
                        "uitdrukking"
                    ],
                    "common_phrases": [
                        "geen woord zeggen",
                        "een moeilijk woord"
                    ],
                    "target_lang_definitions": {
                        "en": "The smallest independent unit of language that carries meaning."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "word",
                                "target_lang_sense_clarification": "a unit of language"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ae2f25d-a04f-3655-a1d4-4e81cd9c9942",
                    "sense_definition": "Een plechtige toezegging of belofte die men doet aan iemand anders.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "belofte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning hield <w>woord</w> en gaf het volk meer vrijheid.",
                            "target_lang_translations": {
                                "en": "The king kept his <w>word</w> and gave the people more freedom."
                            }
                        },
                        {
                            "text": "Je moet iemand altijd op zijn <w>woord</w> kunnen geloven.",
                            "target_lang_translations": {
                                "en": "You should always be able to take someone at their <w>word</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "belofte",
                        "erewoord",
                        "gelofte",
                        "toezegging"
                    ],
                    "common_phrases": [
                        "woord houden",
                        "iemand op zijn woord geloven"
                    ],
                    "target_lang_definitions": {
                        "en": "A solemn pledge or promise made to someone else."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "word",
                                "target_lang_sense_clarification": "a promise or oath"
                            },
                            {
                                "target_lang_word": "promise",
                                "target_lang_sense_clarification": "a declaration to do something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5faee11f-fdc8-3b69-b279-b72a39fbeb54",
                    "sense_definition": "Iets wat door iemand gezegd of geuit wordt; een uitspraak of betoog.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taaluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na deze geruststellende <w>woorden</w> voelde iedereen zich een stuk veiliger.",
                            "target_lang_translations": {
                                "en": "After these reassuring <w>words</w>, everyone felt a lot safer."
                            }
                        },
                        {
                            "text": "De voorzitter vroeg om het <w>woord</w> tijdens de drukke vergadering.",
                            "target_lang_translations": {
                                "en": "The chairman asked for the <w>floor</w> during the busy meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "formulering",
                        "uitdrukking"
                    ],
                    "antonyms": [
                        "zwijgen"
                    ],
                    "common_phrases": [
                        "het woord voeren",
                        "iemand het woord geven"
                    ],
                    "target_lang_definitions": {
                        "en": "Something said or expressed by someone; an utterance or speech."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "word",
                                "target_lang_sense_clarification": "something spoken"
                            },
                            {
                                "target_lang_word": "remark",
                                "target_lang_sense_clarification": "a comment"
                            },
                            {
                                "target_lang_word": "statement",
                                "target_lang_sense_clarification": "a formal expression"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db96e2b0-9cf8-3229-bc6e-b20d5c7ac5b2",
                    "sense_definition": "Taal in geschreven of gedrukte vorm, in tegenstelling tot gesproken taal of beelden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "taalvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij vindt het geschreven <w>woord</w> een fijne manier om de wereld te begrijpen.",
                            "target_lang_translations": {
                                "en": "She finds the written <w>word</w> a nice way to understand the world."
                            }
                        },
                        {
                            "text": "In deze krant staat het gedrukte <w>woord</w> nog altijd centraal.",
                            "target_lang_translations": {
                                "en": "In this newspaper, the printed <w>word</w> is still central."
                            }
                        }
                    ],
                    "antonyms": [
                        "beeld"
                    ],
                    "common_phrases": [
                        "het geschreven woord"
                    ],
                    "target_lang_definitions": {
                        "en": "Language in written or printed form, as opposed to spoken language or images."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "word",
                                "target_lang_sense_clarification": "written or printed text"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "687c81c0-27bd-3a90-a1c7-fadd80cdd437",
                    "sense_definition": "De goddelijke openbaring, vaak verwijzend naar de Bijbel of Jezus Christus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de kerk luisterden de gelovigen aandachtig naar het <w>Woord</w> van God.",
                            "target_lang_translations": {
                                "en": "In the church, the believers listened attentively to the <w>Word</w> of God."
                            }
                        },
                        {
                            "text": "Het evangelie verspreidt het <w>Woord</w> over de hele wereld.",
                            "target_lang_translations": {
                                "en": "The gospel spreads the <w>Word</w> across the whole world."
                            }
                        }
                    ],
                    "synonyms": [
                        "logos"
                    ],
                    "common_phrases": [
                        "het Woord Gods"
                    ],
                    "traits": [
