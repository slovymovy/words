                        "cross_references": [
                            {
                                "target_word": "sledgehammer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa4ab719-4e29-3ebe-8f8c-1ea7ee294cd1",
                                        "entry_id": "323eb1ae-26fa-36a6-826f-73f4b3ccc423",
                                        "glosses": [
                                            "A hammer that consists of a large, heavy, broad and flat block of metal (the head) attached to a handle typically 0.5 meter to 1 meter long. The sledgehammer's design is meant to allow it to be swung powerfully, and to distribute force over a wide area upon impact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1878be-85e1-43c2-8814-8c54fbbf37ec",
                                                "sense_id": "fa4ab719-4e29-3ebe-8f8c-1ea7ee294cd1",
                                                "text": "These were succeeded by anchor and chain-cable forges, where sledgehammers were dinging upon iron all day long."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sledgehammer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "203d8029-facc-349f-879c-c9cb055ed476",
                                        "entry_id": "d844fcec-bfde-397d-b39c-5e53043e851e",
                                        "glosses": [
                                            "To strike (something) with a sledgehammer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fffe2f1-2d8d-4890-abb1-632c2bd4f8aa",
                                                "sense_id": "203d8029-facc-349f-879c-c9cb055ed476",
                                                "text": "Some lawmakers were so incensed that they even invited the news media to watch the sledgehammering of the Japanese company's products on the Capitol's steps."
                                            },
                                            {
                                                "example_id": "ee329180-b6f0-46b1-9023-1b250d00ecb0",
                                                "sense_id": "203d8029-facc-349f-879c-c9cb055ed476",
                                                "text": "She’s trying to piece together shards of precious pottery gleefully sledgehammered by a delegation led by the Taliban’s minister of culture, who deemed the world’s greatest collection of Central Asian artifacts un-Islamic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sledgehammer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c6bbfe3-b7e2-3e43-83ec-8b452d98e0b4",
                                        "entry_id": "4d420515-c809-3a1e-a4a7-94e3b837b270",
                                        "glosses": [
                                            "Completely lacking grace and dexterity."
                                        ],
