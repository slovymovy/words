    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f4b85ca1-6835-3289-9c62-b1c657cc4f23",
                    "sense_definition": "Met een ruim en indrukwekkend uitzicht; groots en weids van opzet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruimtelijk_uitzicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit was verreweg het <w>weidste</w> landschap dat we te zien kregen op deze reis.",
                            "target_lang_translations": {
                                "en": "This was by far the <w>most panoramic</w> landscape we got to see on this trip."
                            }
                        },
                        {
                            "text": "Vanaf de heuvel genoten we van een <w>weids</w> uitzicht over de groene vallei.",
                            "target_lang_translations": {
                                "en": "From the hill, we enjoyed a <w>sweeping</w> view over the green valley."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruim",
                        "groots",
                        "panoramisch",
                        "onmetelijk"
                    ],
                    "antonyms": [
                        "nauw",
                        "beperkt",
                        "bekrompen"
                    ],
                    "common_phrases": [
                        "weids uitzicht",
                        "weids landschap"
                    ],
                    "target_lang_definitions": {
                        "en": "With a spacious and impressive view; grand and vast in design."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "panoramic",
                                "target_lang_sense_clarification": "referring to an unobstructed, wide view of an area"
                            },
                            {
                                "target_lang_word": "grand",
                                "target_lang_sense_clarification": "magnificent and imposing in appearance or size"
                            },
                            {
                                "target_lang_word": "sweeping",
                                "target_lang_sense_clarification": "wide-ranging or extending over a wide area, especially of a view"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a1ca18e-c8cc-3f82-b883-58f613c4081a",
                    "sense_definition": "Breed uitgestrekt of wijd verspreid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruimtelijk_uitzicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rivier stroomt hier door een <w>weidse</w> vlakte richting de zee.",
                            "target_lang_translations": {
                                "en": "The river flows here through a <w>vast</w> plain towards the sea."
                            }
                        },
                        {
                            "text": "Zij hielden van de rust en de <w>weidse</w> natuur in het noorden van het land.",
                            "target_lang_translations": {
                                "en": "They loved the peace and the <w>expansive</w> nature in the north of the country."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitgestrekt",
                        "wijd"
                    ],
                    "antonyms": [
                        "smal",
                        "begrensd"
                    ],
                    "common_phrases": [
                        "weidse vlakte",
                        "weidse natuur"
                    ],
                    "target_lang_definitions": {
                        "en": "Broadly stretched out or widely extended."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vast",
                                "target_lang_sense_clarification": "of very great extent or quantity; immense"
                            },
                            {
                                "target_lang_word": "expansive",
                                "target_lang_sense_clarification": "covering a wide area in space"
                            },
                            {
                                "target_lang_word": "wide-open",
                                "target_lang_sense_clarification": "fully open or spread out, especially of landscapes"
                            }
                        ]
                    }
                }
            ]
        }
    ]
