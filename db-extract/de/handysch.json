                "senses": [
                    {
                        "sense_id": "3f328333-7be8-3d2b-9fba-c6f8755c7a18",
                        "entry_id": "dae6b549-ddbc-38c4-b140-69327becdf72",
                        "glosses": [
                            "mittels Handy"
                        ],
                        "tags": [
                            "Austrian German",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "bd76b0d8-91e4-4fb1-b8f7-4e375e53563a",
                                "sense_id": "3f328333-7be8-3d2b-9fba-c6f8755c7a18",
                                "text": "„90 Prozent der Bevölkerung werden dann ‚handysch‘ erreichbar sein.“"
                            },
                            {
                                "example_id": "1cd781f8-0cb5-4aca-a5e2-9d2cb32e7a26",
                                "sense_id": "3f328333-7be8-3d2b-9fba-c6f8755c7a18",
                                "text": "„Es kann dieser selektive Mitschnitt eines handyschen Tagesauswurfes nicht abgeschlossen werden, ohne einen Mangel anzukreiden, der jeden aufrechten Demokraten tief betroffen machen muß:[…].“"
                            },
                            {
                                "example_id": "d841bc28-25fd-4b57-9fdf-4a46e8476f82",
                                "sense_id": "3f328333-7be8-3d2b-9fba-c6f8755c7a18",
                                "text": "„Kaum können wir handysch elektronisch um die ganze Welt surfen und was weiß ich was noch alles, schon zeigen sich die Salzburger Parkgaragen innovativ:[…].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
