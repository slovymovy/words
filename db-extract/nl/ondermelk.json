                        "sense_id": "efbd28b4-6865-3e35-b03f-f850f1f128b7",
                        "entry_id": "2f9b5f64-7078-385f-85b3-b0e7416056e6",
                        "glosses": [
                            "melk waarvan de room is afgehaald, magere melk, afgeroomde melk, koemelk waarvan het merendeel van het melkvet verwijderd is, tot maximaal 0,3% vet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3a985f-5ff2-47a7-b1fb-882d061102c4",
                                "sense_id": "efbd28b4-6865-3e35-b03f-f850f1f128b7",
                                "text": "Die term bekt niet zo lekker, aangezuurde ondermelk, dus staat op een pak gewoon karnemelk."
                            },
                            {
                                "example_id": "e08a6489-4032-4da7-907a-2b51e911d158",
                                "sense_id": "efbd28b4-6865-3e35-b03f-f850f1f128b7",
                                "text": "De boerin kwam 's ochtends een emmer rauwe, romige melk aan huis brengen. Daarvan maakte de keukenmeid alle zuivelproducten waar we nu tevergeefs om vragen bij de supermarkt. Je liet de melk een dagje staan, en dikke verse roomvlokken kwamen vanzelf boven drijven. Precies het soort room dat Giuseppe nodig heeft voor zijn pastasaus. Dunnere room, te gebruiken als slagroom, dreef ook boven in de emmer. Dieper in de emmer zat ondermelk, met weinig vet."
                            }
                        ]
                    }
