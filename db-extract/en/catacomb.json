                                "target_senses": [
                                    {
                                        "sense_id": "a0e33ebe-2561-36d8-bd4a-d7ab5c5c1824",
                                        "entry_id": "689968e2-0220-3244-af3a-9e6147462030",
                                        "glosses": [
                                            "unterirdische Beisetzungsstätte"
                                        ],
                                        "tags": [
                                            "(meist Plural) in frühchristlicher Zeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b97b9cd-3aa6-49e8-9029-90ae267da481",
                                                "sense_id": "a0e33ebe-2561-36d8-bd4a-d7ab5c5c1824",
                                                "text": "Katakomben wurden auch als Zufluchtsstätte genutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                        "entry_id": "689968e2-0220-3244-af3a-9e6147462030",
                                        "glosses": [
                                            "unterirdische, unübersichtliche Räumlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd274a1d-a647-407f-8fa2-2b994a1e19f8",
                                                "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                                "text": "„Als sie auf der nachtstillen Straße stehen, ist ihnen zumute, als tauchten sie aus dem schaurigen Dunkel einer Katakombe wieder an das Tageslicht zurück.“"
                                            },
                                            {
                                                "example_id": "aaf206f5-b0f5-4364-89f1-b413690a1217",
                                                "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                                "text": "„Dann fand ich in den Katakomben mein Auto nicht wieder.“"
                                            },
                                            {
                                                "example_id": "6ee0a45f-36f5-4298-8817-b1e051bd01e9",
                                                "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                                "text": "„Aber allzu tief trauten sie sich doch nicht in die Katakomben vorzudringen.“"
                                            },
                                            {
                                                "example_id": "e18f53e0-3519-4d73-9b8b-abfa09e79ad4",
                                                "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                                "text": "„Von den unterirdischen Räumen aus, die leer standen, gab es eine Verbindung zu den Schächten der Katakomben, die sich unter den Häusern der Stadtanlage überall hinzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
