                                        "entry_id": "1d99375d-fb2a-337d-be24-a066e2434c9a",
                                        "glosses": [
                                            "To compare in relative force, importance, value, etc.; to estimate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b131851-8bf8-4af0-8e2c-55053a185164",
                                                "sense_id": "7759ca57-d736-36d3-8f97-47251b2b4c83",
                                                "text": "Ballance the Good and Evil of Things."
                                            },
                                            {
                                                "example_id": "083f2cea-0206-4609-9d7c-24a2957afbaf",
                                                "sense_id": "7759ca57-d736-36d3-8f97-47251b2b4c83",
                                                "text": "Mr. Morrison's ruling to reopen the station as a shelter was given after he had balanced the relative dangers of flooding and bombing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "944dd35c-a59a-33b9-9355-1d13e3c67115",
                                        "entry_id": "1d99375d-fb2a-337d-be24-a066e2434c9a",
                                        "glosses": [
                                            "To move toward, and then back from, reciprocally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0ff7f18-8280-4f17-85bc-4582f9d81e4b",
                                                "sense_id": "944dd35c-a59a-33b9-9355-1d13e3c67115",
                                                "text": "to balance partners"
