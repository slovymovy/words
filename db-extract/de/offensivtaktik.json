                "senses": [
                    {
                        "sense_id": "e23da3f6-d99b-3f66-b0ea-fd0186659eef",
                        "entry_id": "f2e7348d-329b-373b-a4c8-87374ac18a12",
                        "glosses": [
                            "Strategie, die auf einen Angriff abzielt"
