        "fr-extract.jsonl": [
            {
                "entry_id": "31114728-50ef-355d-b9fe-502c250a9061",
                "word": "mazette",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5e442d6-a96a-30ea-b801-f5da01f21906",
                        "entry_id": "31114728-50ef-355d-b9fe-502c250a9061",
                        "glosses": [
                            "Exprime l’étonnement ou l’admiration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57320bf2-1bae-4cb8-92f7-c828b6a990ca",
                                "sense_id": "e5e442d6-a96a-30ea-b801-f5da01f21906",
                                "text": "Mazette ! Ma sœur est une mangeuse d’hommes ! Et de femmes ! Jamais j’aurais cru ça ! Et dire que c’est moi qu’on prend pour le queutard de la famille ! Tu cachais bien ton jeu !"
                            },
                            {
                                "example_id": "3e99abb4-8d8c-4bac-889a-70cce69a030d",
                                "sense_id": "e5e442d6-a96a-30ea-b801-f5da01f21906",
                                "text": "Mazette, construire soi-même sa bécane, c’est quand même quelque chose !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ccc05a83-ad00-3428-9e2d-d3f3e846e82e",
                        "entry_id": "31114728-50ef-355d-b9fe-502c250a9061",
                        "glosses": [
                            "Exprime la surprise suite à une annonce le plus souvent défavorable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5cacc8b-8309-4420-a3f4-95fe43defd5c",
                                "sense_id": "ccc05a83-ad00-3428-9e2d-d3f3e846e82e",
                                "text": "Vous m’avez trahi ? Mazette !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "37dc7173-aa69-37a8-b451-f76170b0ebc3",
                "word": "mazette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "95bdd660-bbf3-43f4-8375-1d82fd6ebbaf",
                        "entry_id": "37dc7173-aa69-37a8-b451-f76170b0ebc3",
                        "tags": [
                            "plural"
                        ],
                        "form": "mazettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b1f92ae-9408-3760-a008-d5382fd3c827",
                        "entry_id": "37dc7173-aa69-37a8-b451-f76170b0ebc3",
                        "glosses": [
                            "Mauvais petit cheval."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "896fd192-61d8-41ed-aa35-9cea6fd5a69f",
                                "sense_id": "0b1f92ae-9408-3760-a008-d5382fd3c827",
                                "text": "Il était monté sur une mazette."
                            },
                            {
                                "example_id": "f9626abc-d3d0-48e2-953c-4f7b1eb0ab54",
                                "sense_id": "0b1f92ae-9408-3760-a008-d5382fd3c827",
                                "text": "Une petite, une vieille mazette."
                            }
                        ]
                    },
                    {
                        "sense_id": "1da9a627-aeb5-3ee4-9e66-072eaa581126",
                        "entry_id": "37dc7173-aa69-37a8-b451-f76170b0ebc3",
                        "glosses": [
                            "Celui qui manque de force ou d’ardeur, soit en marchant, soit en portant des fardeaux."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9a7f81ec-404d-4ba0-a86f-b8abb7b45a45",
                                "sense_id": "1da9a627-aeb5-3ee4-9e66-072eaa581126",
                                "text": "Vous n’avancez pas, vous êtes une mazette."
                            },
                            {
                                "example_id": "ad53e51b-8e77-4cde-a317-a3ee5c0ee9e8",
                                "sense_id": "1da9a627-aeb5-3ee4-9e66-072eaa581126",
                                "text": "Parce que pour faire un coup pareil, en plein quartier des Halles, c'est sûrement pas une mazette !"
                            }
                        ]
                    },
                    {
                        "sense_id": "7a976ca7-4498-3520-8903-d442a73adb24",
                        "entry_id": "37dc7173-aa69-37a8-b451-f76170b0ebc3",
                        "glosses": [
                            "Personne inhabile à quelque jeu qui demande de la combinaison ou de l’adresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5498763-e700-41ec-ad8b-07b133c21172",
                                "sense_id": "7a976ca7-4498-3520-8903-d442a73adb24",
                                "text": "Il ne sait pas jouer, c’est une mazette."
                            },
                            {
                                "example_id": "b454d4da-7388-42ed-b25f-227682e2ea6f",
                                "sense_id": "7a976ca7-4498-3520-8903-d442a73adb24",
                                "text": "« Tireur » de l'autre camp, Madame Suzanne se classait à peu près au même niveau que moi qui « pointais » dans le camp Daste. Je pointe parfois très bien, parfois en mazette."
                            }
                        ]
                    },
                    {
                        "sense_id": "83efb5a3-32ea-307b-9f62-7e09cf947191",
                        "entry_id": "37dc7173-aa69-37a8-b451-f76170b0ebc3",
                        "glosses": [
                            "Personne ou chose de mauvaise qualité ; insuffisante dans son emploi."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7f00c8bd-fabd-4aba-ad95-ff84fe8e0323",
                                "sense_id": "83efb5a3-32ea-307b-9f62-7e09cf947191",
                                "text": "Ah ! ces sacrées femmes, ça ne peut pas perdre un milliard sans tourner de l’œil. Quelles mazettes !"
                            },
                            {
                                "example_id": "45dbc2c2-dc6e-4ff0-b76f-21c4f73f23a2",
                                "sense_id": "83efb5a3-32ea-307b-9f62-7e09cf947191",
                                "text": "Le docteur Bonfant est mort, c’est bien, nous avons le devoir de nous taire, mais le moins qu’on pourrait dire, si le silence au-dessus d’une tombe n’était pas sacré, c’est qu’il était une mazette et un criminel."
                            },
                            {
                                "example_id": "1e6dc524-7c76-469e-adbe-0a37c58e5be7",
                                "sense_id": "83efb5a3-32ea-307b-9f62-7e09cf947191",
                                "text": "Décidément, les types de l’autre rive tiraient comme des mazettes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99e6cf0d-26d4-4f3b-9c93-b0cd6e60fa13",
                        "source_entry_id": "37dc7173-aa69-37a8-b451-f76170b0ebc3",
                        "source_sense_id": "7a976ca7-4498-3520-8903-d442a73adb24",
                        "source_sense_description": "Faible joueur",
                        "target_lang_word": "Stümper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stümper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                        "entry_id": "fa3e8aa6-e9c9-3b8b-9334-e60574ca4ed6",
                                        "glosses": [
                                            "Person, die auf einem Gebiet, auf dem sie tätig ist, nur wenige oder gar keine Kenntnisse hat"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc2daff2-473c-498f-8815-be91cebe33fb",
                                                "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                                "text": "„Gute Musiker wollen sie dulden oder sogar fördern; Stümper an der Klampfe oder Fiedler mit Einliedrepertoire sollen aus U-Bahnen und Fußgängerzonen verschwinden.“"
                                            },
                                            {
                                                "example_id": "a1ca4af6-83ee-4cd0-8c34-d452e3265c67",
                                                "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                                "text": "„Allerdings wird aus den Prozessunterlagen jetzt deutlich, daß die Terrorkumpane des al-Sarkawi im Ruhrgebiet eher eine Bande von Stümpern als Profis waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71ce1497-3b63-3bca-b4f6-f69b6357a558",
                                        "entry_id": "fa3e8aa6-e9c9-3b8b-9334-e60574ca4ed6",
                                        "glosses": [
                                            "Person, die sich bei etwas keine Mühe gibt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18881293-ddaa-47e8-b34e-b42d6d4a196b",
                                                "sense_id": "71ce1497-3b63-3bca-b4f6-f69b6357a558",
                                                "text": "„Mein lieber Barbaro hielt die Karten wie ein Stümper; das gefiel mir von Anfang an nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
