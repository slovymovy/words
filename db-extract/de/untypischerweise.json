                    {
                        "sense_id": "22b52532-788a-31c9-ba7e-cfff4d079a94",
                        "entry_id": "2220363b-1392-3f19-81b3-72ddd32a9b64",
                        "glosses": [
                            "auf eine Art, die für jemanden oder etwas nicht typisch, charakteristisch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70059426-89e6-4b6a-ae7d-141b1ae369d3",
                                "sense_id": "22b52532-788a-31c9-ba7e-cfff4d079a94",
                                "text": "„Am Ende der Straße hinter dem Deich hatten wir untypischerweise einen geparkten Bus entdeckt.“"
                            },
                            {
                                "example_id": "40f052f7-a69c-44b1-8f2c-cd2d27da2d2f",
                                "sense_id": "22b52532-788a-31c9-ba7e-cfff4d079a94",
                                "text": "„Als wir ungefähr neunzehn waren und studierten, ließ Jock die Haare wieder wachsen und fing plötzlich erschreckender- und völlig untypischerweise an, sittsame Blümchenkleider zu tragen.“"
                            },
                            {
                                "example_id": "29fb45f2-1ba0-411d-a406-b6f349016199",
                                "sense_id": "22b52532-788a-31c9-ba7e-cfff4d079a94",
                                "text": "„Sie klopfte an die niedrige, untypischerweise blau statt wie meist grün oder grün-weiß gestrichene Tür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
