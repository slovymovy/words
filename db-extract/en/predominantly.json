                                                "sense_id": "bf8f9439-9a86-3713-8208-d10a40b5c3c3",
                                                "text": "„Umweltorganisation ist ein Verein oder eine Stiftung, 1. der/die als vorrangigen Zweck gemäß Vereinsstatuten oder Stiftungserklärung den Schutz der Umwelt hat, …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b5aeb923-22ba-379d-9720-fcfc402931b1",
                                        "entry_id": "915ccf9b-74e6-37b8-badd-08043b3078cb",
                                        "glosses": [
                                            "als erstes zu behandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d64327d-b05a-4ac7-9ead-d11bae997fcb",
                                                "sense_id": "b5aeb923-22ba-379d-9720-fcfc402931b1",
                                                "text": "„Die Banken seien gebeten worden, Rentner und Menschen mit Behinderungen vorrangig zu bedienen.“"
                                            }
                                        ],
