    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eda5c4b3-63a2-30e8-9a75-e9a1d64b767f",
                    "sense_definition": "The recreational activity or extreme sport of flying using a paraglider.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aviation_activity",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "Many adventurous tourists try <w>paragliding</w> over the mountains during the summer months.",
                            "target_lang_translations": {
                                "es": "Muchos turistas aventureros prueban el <w>parapente</w> sobre las montañas durante los meses de verano."
                            }
                        },
                        {
                            "text": "He decided to go <w>paragliding</w> along the coast to enjoy the stunning ocean views.",
                            "target_lang_translations": {
                                "es": "Decidió <w>hacer parapente</w> por la costa para disfrutar de las impresionantes vistas del océano."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go paragliding",
                        "tandem paragliding"
                    ],
                    "target_lang_definitions": {
                        "es": "Actividad recreativa o deporte extremo consistente en volar utilizando un parapente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "parapente",
                                "target_lang_sense_clarification": "deporte o actividad de vuelo"
                            },
                            {
                                "target_lang_word": "parapentismo",
                                "target_lang_sense_clarification": "práctica deportiva"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46151996-433c-318a-b2b2-0f0c7a42000d",
                    "sense_definition": "The practical operation of a paraglider for non-sporting purposes, such as surveillance or military transport.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The border patrol evaluated tactical <w>paragliding</w> for conducting silent nighttime reconnaissance missions.",
                            "target_lang_translations": {
                                "es": "La patrulla fronteriza evaluó el <w>vuelo en parapente</w> táctico para llevar a cabo misiones nocturnas y silenciosas de reconocimiento."
                            }
                        },
                        {
                            "text": "Special forces units practiced stealth <w>paragliding</w> to access remote mountainous terrain undetected.",
                            "target_lang_translations": {
                                "es": "Las unidades de fuerzas especiales practicaron el <w>vuelo sigiloso en parapente</w> para acceder a terrenos montañosos remotos sin ser detectadas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "military paragliding",
                        "tactical paragliding"
                    ],
                    "target_lang_definitions": {
                        "es": "Uso u operación práctica de un parapente con fines no deportivos, como la vigilancia o el transporte militar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vuelo en parapente",
                                "target_lang_sense_clarification": "operación o uso funcional"
                            },
                            {
                                "target_lang_word": "parapente",
                                "target_lang_sense_clarification": "modalidad operativa"
                            }
                        ]
                    }
                }
            ]
        },
