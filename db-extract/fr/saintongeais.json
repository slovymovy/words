                "senses": [
                    {
                        "sense_id": "76401b3a-aee8-395a-8350-363195979dd6",
                        "entry_id": "1b3430fe-d355-39d5-9513-610696d3e41e",
                        "glosses": [
                            "Relatif à la Saintonge, à ses habitants ou à sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c19e3bd7-9cc1-438e-9b38-69d5925521bd",
                                "sense_id": "76401b3a-aee8-395a-8350-363195979dd6",
                                "text": "J'étais arrivé le soir, avec mes parents, dans un village de la côte saintongeaise, dans une maison de pêcheurs louée pour la saison des bains."
                            },
                            {
                                "example_id": "03c11751-302d-4462-a8ad-5685c6494311",
                                "sense_id": "76401b3a-aee8-395a-8350-363195979dd6",
                                "text": "Les voyageurs de commerce, les touristes faisaient un détour pour en goûter l'excellente cuisine saintongeaise, pour y déguster les bons crus du Blayais et l'incomparable eau-de-vie des Charentes."
                            },
                            {
                                "example_id": "e85e6f67-74a6-4d30-a68b-77460a56e5cc",
                                "sense_id": "76401b3a-aee8-395a-8350-363195979dd6",
                                "text": "Parmi les capitaines prêts à servir le roi contre Philippe II, il convient de réserver une place de choix à Dominique de Gourgues qui est bien connu et à ses auxiliaires saintongeais qui ne le sont pas."
                            },
                            {
                                "example_id": "32137601-7e54-49b6-9c77-032f424dd268",
                                "sense_id": "76401b3a-aee8-395a-8350-363195979dd6",
                                "text": "Mais, au fond de son cœur, il restait saintongeais."
                            }
                        ]
                    },
