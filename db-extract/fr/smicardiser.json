                "senses": [
                    {
                        "sense_id": "506d9d76-e103-3b05-b7d4-645b5cb7f4ee",
                        "entry_id": "27911dc6-0765-3303-8fb4-e48353d5353b",
                        "glosses": [
                            "Amener (faire descendre) au niveau du SMIC."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "71c91052-fd9e-4c7f-807b-df3fdc70c91e",
                                "sense_id": "506d9d76-e103-3b05-b7d4-645b5cb7f4ee",
                                "text": "La France se « smicardise »."
                            },
                            {
                                "example_id": "e770fdba-3175-4a0f-95a2-6d2e73f07659",
                                "sense_id": "506d9d76-e103-3b05-b7d4-645b5cb7f4ee",
                                "text": "Mais je ne veux pas « smicardiser » la société française."
                            },
                            {
                                "example_id": "7cf71a30-e5b8-4fa3-8ea9-bc4e4f7877e7",
                                "sense_id": "506d9d76-e103-3b05-b7d4-645b5cb7f4ee",
                                "text": "Ça ne veut pas dire qu’on a « smicardisé » la société française et que des salariés ont dégringolé dans une catégorie inférieure !"
                            }
                        ]
                    }
