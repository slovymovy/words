                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea8a4ef6-a4c9-4ed6-b75f-d3c474e0c7e8",
                        "source_entry_id": "29044964-bb66-3532-aa2f-451034062b8e",
                        "source_sense_id": "4811a1c3-431d-3535-9f91-5d215ea759dc",
                        "target_lang_word": "Messe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Messe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e21a5df-c7f8-3f44-b347-ec052b350ee9",
                                        "entry_id": "52379998-e96b-31c8-b854-3c9c1b6f2531",
                                        "glosses": [
                                            "katholische Gottesdienstform, die aus Wortgottesdienst und Eucharistiefeier besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b9c1108-6bfe-4f9e-b820-21b3d2ddfe22",
                                                "sense_id": "9e21a5df-c7f8-3f44-b347-ec052b350ee9",
                                                "text": "Die Messe beginnt um 10:00 Uhr."
                                            },
                                            {
                                                "example_id": "65e1df00-2520-47f2-8b24-6738f4d8292b",
                                                "sense_id": "9e21a5df-c7f8-3f44-b347-ec052b350ee9",
                                                "text": "„Doro aber gab sich heute als erklärte Atheistin und wollte von einer Messe nichts wissen.“"
                                            },
                                            {
                                                "example_id": "f4aaebbf-e14a-49aa-977e-0d38ad00e10c",
                                                "sense_id": "9e21a5df-c7f8-3f44-b347-ec052b350ee9",
                                                "text": "„Ich hatte nur mehr eine einzige Stunde vor mir, und ich durfte den Tagesanbruch nicht abwarten, denn Signora Orio wäre lieber gestorben, als es auf eine versäumte Messe ankommen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9dfdb746-6d6a-38c2-a42b-428767dc5b2d",
                                        "entry_id": "52379998-e96b-31c8-b854-3c9c1b6f2531",
                                        "glosses": [
                                            "Musikgattung, in der Texte der Messe ^([1]) vertont werden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9a1b92-658f-4359-af0e-cf401f11411a",
                                                "sense_id": "9dfdb746-6d6a-38c2-a42b-428767dc5b2d",
                                                "text": "Dies ist eine h-Moll-Messe von Johann Sebastian Bach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8babe423-b79b-36fc-a396-f5fa074d10bf",
                                        "entry_id": "52379998-e96b-31c8-b854-3c9c1b6f2531",
                                        "glosses": [
                                            "Volksfeste, die zum/am Jahrestag eines Kirchenpatrons abgehalten werden"
                                        ],
                                        "tags": [
                                            "Unterhaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ad6a4d7-d967-4c14-ae99-b9ac1d37de93",
                                                "sense_id": "8babe423-b79b-36fc-a396-f5fa074d10bf",
                                                "text": "Wir waren auf der Pforzheimer Messe, eine tolle Kirmes!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "59829c42-eb3e-372f-9404-e397f78af657",
                                        "entry_id": "52379998-e96b-31c8-b854-3c9c1b6f2531",
                                        "glosses": [
                                            "Ereignis, bei dem Unternehmen ihre Waren zeigen und verkaufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8866add0-e974-4be3-8313-fa818a60981b",
                                                "sense_id": "59829c42-eb3e-372f-9404-e397f78af657",
                                                "text": "Die CeBIT ist eine Messe in Hannover."
                                            },
                                            {
                                                "example_id": "1fb47c9e-d3c4-4217-94e9-d3b6639296d8",
                                                "sense_id": "59829c42-eb3e-372f-9404-e397f78af657",
                                                "text": "„Und als wir am nächsten Tag auf die Messe kommen, ist fast alles gut.“"
                                            },
                                            {
                                                "example_id": "b505ee8d-fe9c-4a55-8c21-d91c4863d545",
                                                "sense_id": "59829c42-eb3e-372f-9404-e397f78af657",
                                                "text": "„In Städten, wo es keine Wechselbanken gab, spielte noch im 17. Jahrhundert die Messe als Zentrum des Zahlungsverkehrs eine wichtige Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "52a41691-f808-3b36-9e57-89019b0987b3",
                                        "entry_id": "52379998-e96b-31c8-b854-3c9c1b6f2531",
                                        "glosses": [
                                            "gemeinsamer Wohn- und Speiseraum der Schiffsoffiziere"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a44d28-928d-426b-8aea-cbb617a63619",
                                                "sense_id": "52a41691-f808-3b36-9e57-89019b0987b3",
                                                "text": "Das Essen findet in der Offiziersmesse statt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
