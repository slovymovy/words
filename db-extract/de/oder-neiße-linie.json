                "senses": [
                    {
                        "sense_id": "779deb71-3d12-3a2b-9eeb-12d227786e31",
                        "entry_id": "e32154f4-f3db-3136-9b66-d910b78674aa",
                        "glosses": [
                            "Grenzlinie zwischen Polen und Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b44e970-88fe-412a-818f-021ef232a661",
                                "sense_id": "779deb71-3d12-3a2b-9eeb-12d227786e31",
                                "text": "„Die ebenfalls 1949 gegründete Bundesrepublik Deutschland erkannte erst am 7. Dezember 1970 im Warschauer Vertrag die Oder-Neiße-Linie unter dem Vorbehalt einer Änderung im Rahmen einer Friedensregelung als faktisch „unverletzliche“ Westgrenze der damaligen Volksrepublik Polen an.“"
                            },
                            {
                                "example_id": "33f14a16-966e-4821-9ab5-05af94694f66",
                                "sense_id": "779deb71-3d12-3a2b-9eeb-12d227786e31",
                                "text": "„Als polnische Westgrenze wurde die Oder-Neiße-Linie festgelegt, Königsberg und Teile Ostpreußens kamen unter sowjetische Verwaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
