                "senses": [
                    {
                        "sense_id": "ad85dabe-cdef-39c5-8ffa-4135f6ffd222",
                        "entry_id": "ab434e82-495e-35d4-be90-75253b70214b",
                        "glosses": [
                            "One employed to collect ash."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "98d1b52d-f944-4fc7-ba5f-ac093a3851a4",
                                "sense_id": "ad85dabe-cdef-39c5-8ffa-4135f6ffd222",
                                "text": "Theoretically, occupants are expected to bring out their boxes and pans at the time the ashman's bell gives notice that his cart is passing through the street."
                            },
                            {
                                "example_id": "48ca82e4-f650-493f-99e7-d77aa9712a84",
                                "sense_id": "ad85dabe-cdef-39c5-8ffa-4135f6ffd222",
                                "text": "Through the kindness of Mrs. Francis P. Kinnicutt, Mrs. Richard Irvin and other ladies, who have made a careful canvas of the district between 8th and 80th streets in the center of the city, we learn that not less than 2852 families in that district employ private ashmen at an average expense of $2 per month or a total of $68,448 per year."
                            },
                            {
                                "example_id": "255a8dd0-198c-4702-8a66-eb044f71cfe0",
                                "sense_id": "ad85dabe-cdef-39c5-8ffa-4135f6ffd222",
                                "text": "\"Oh!\" said Jack to himself. \"The young lady of the house doing amateur kitchen housework. I might have known it. And she thinks me the ashman,\" and he sighed."
                            }
                        ]
                    }
                ],
