        "fr-extract.jsonl": [
            {
                "entry_id": "5b3f4d4d-fc44-3c9f-b010-a5b84af35f7c",
                "word": "décidément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7edc25ff-ed64-3c69-b154-a0504c24fa9a",
                        "entry_id": "5b3f4d4d-fc44-3c9f-b010-a5b84af35f7c",
                        "glosses": [
                            "D’une manière décidée, ferme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a28af1e-7c68-4369-ae2f-c1b5bc0f3e3e",
                                "sense_id": "7edc25ff-ed64-3c69-b154-a0504c24fa9a",
                                "text": "Prendre décidément son parti."
                            }
                        ]
                    },
                    {
                        "sense_id": "65e94386-7daa-3623-8d9e-f769aa628339",
                        "entry_id": "5b3f4d4d-fc44-3c9f-b010-a5b84af35f7c",
                        "glosses": [
                            "D’une manière décisive, évidente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67094939-71d0-43f8-9f2c-8e1f3fe85db6",
                                "sense_id": "65e94386-7daa-3623-8d9e-f769aa628339",
                                "text": "Il est décidément le meilleur nageur du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9755e68-315b-360f-b078-3c3a394146a6",
                        "entry_id": "5b3f4d4d-fc44-3c9f-b010-a5b84af35f7c",
                        "glosses": [
                            "En définitive, tout bien considéré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f56f658-dcb0-4058-83c3-32c9aa341c25",
                                "sense_id": "a9755e68-315b-360f-b078-3c3a394146a6",
                                "text": "Il y avait longtemps que j'avais envie de savoir si, décidément, le Docteur Rémy était socialiste, comme d'aucuns le disent."
                            },
                            {
                                "example_id": "d4bb8979-f4fc-4e82-9ac6-aaf304d6dae3",
                                "sense_id": "a9755e68-315b-360f-b078-3c3a394146a6",
                                "text": "À la fin, voyant qu'il n'y avait décidément plus rien à gagner, il se retira."
                            },
                            {
                                "example_id": "2c74f416-eb2f-49ab-b702-ab0b6b5a54cb",
                                "sense_id": "a9755e68-315b-360f-b078-3c3a394146a6",
                                "text": "Vincent avait éclaté de rire. Le rire s'était transformé en fou rire. Partagé avec ce nouvel ami. Décidément, ce mec pigeait bien. Il pigeait tout. Et à la vitesse « grand V » en plus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ba73f94-e8ae-49eb-b3d1-73deec9f76fc",
                        "source_entry_id": "5b3f4d4d-fc44-3c9f-b010-a5b84af35f7c",
                        "source_sense_id": "7edc25ff-ed64-3c69-b154-a0504c24fa9a",
                        "source_sense_description": "D’une manière décidée",
                        "target_lang_word": "firmly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firmly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "In a firm or definite or strong manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e91e9d-304a-4fbf-88fe-0acefd77e1cf",
                                                "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                                "text": "She corrected him firmly but gently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Securely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46849664-bfc4-4be4-af8f-602b744cba26",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Tie the rope firmly to the post."
                                            },
                                            {
                                                "example_id": "b40f2ecb-4ba9-4b6d-9282-c0a0ae1b9d40",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "9b1f9270-ea84-438c-987f-e614989333a1",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Definitively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929ac0a1-6140-4b1c-b26b-a42debd1d9c4",
                                                "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                                "text": "This was widely interpreted to mean that slavery was once more firmly illegal in England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09ab3689-a8a2-4cd8-9861-145d48c296b8",
                        "source_entry_id": "5b3f4d4d-fc44-3c9f-b010-a5b84af35f7c",
                        "source_sense_id": "65e94386-7daa-3623-8d9e-f769aa628339",
                        "source_sense_description": "D’une manière décisive",
                        "target_lang_word": "decidedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decidedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                        "entry_id": "4a287309-6347-35e7-9558-8f444f464e92",
                                        "glosses": [
                                            "In a manner which leaves little question; definitely, clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa9b56a-8824-45e4-8937-379d57c57ddb",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "In a decidedly petulant manner she sat with crossed arms and a frown."
                                            },
                                            {
                                                "example_id": "e806cb21-fff5-4345-8290-e64c0e669af1",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "\"We progress,\" said he. \"Decidedly we progress.\""
                                            },
                                            {
                                                "example_id": "a4eab9f1-ac74-4cdd-aeed-87fc153e68e1",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "'I understand it was the big American man with a decidedly unpleasant face.'"
                                            },
                                            {
                                                "example_id": "c700bb16-0106-432d-9774-cfcf83fa51a1",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "The long-closed G.W.R. station alongside has a decidedly derelict-looking frontage, with eight gargoyles or figureheads still clinging to the portico."
                                            },
                                            {
                                                "example_id": "8a6074b5-f522-4cc2-9227-c71e2697b3ce",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "In time The Simpsons would, indeed, resort to spoofing such decidedly non-spooktacular fare like E.T and Mr. And Mrs. Smith (both in “Treehouse Of Horror XVIII”) but in 1992 the field was wide-open and the show could cherry-pick the most iconic and beloved fright fare of all time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51d3e8cf-901a-3d7f-a44b-eaf4fe159623",
                                        "entry_id": "4a287309-6347-35e7-9558-8f444f464e92",
                                        "glosses": [
                                            "In a decided or final manner; resolutely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c52442d-9f36-4422-9ad8-40f5eae63e10",
                                                "sense_id": "51d3e8cf-901a-3d7f-a44b-eaf4fe159623",
                                                "text": "‘We can't,’ said Vera decidedly, ‘we haven't any boats and we're cut off by a raging torrent from any human habitation.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69f80857-150e-40e7-8ea7-40f0edb1bbfc",
                        "source_entry_id": "5b3f4d4d-fc44-3c9f-b010-a5b84af35f7c",
                        "source_sense_id": "a9755e68-315b-360f-b078-3c3a394146a6",
                        "source_sense_description": "En définitive",
                        "target_lang_word": "truly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af5d81d9-34dc-35d8-b49c-058e04ba84bf",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "In accordance with the facts; truthfully, accurately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc5354c-d4ed-4096-ba05-4f3495fb3ba0",
                                                "sense_id": "af5d81d9-34dc-35d8-b49c-058e04ba84bf",
                                                "text": "He adds, very truly, that what was fatal to such philosophies as his was not Christianity but the Copernican theory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "Honestly, genuinely, in fact, really."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27b21dcd-a0e7-4e0a-b486-12ef8e9041f7",
                                                "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                                "text": "That is truly all I know."
                                            },
                                            {
                                                "example_id": "0a3366fe-aec5-4d4c-a483-2e1e3882bcc0",
                                                "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                                "text": "Truly, that is all I know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca53d8b-438e-4811-8f30-6313344a18ba",
                                                "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                                "text": "You are truly silly."
                                            },
                                            {
                                                "example_id": "7ad9062e-7f14-4f5b-8635-642cde38cd75",
                                                "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                                "text": "I’m distantly related to the truly great writer, Chaim Potok, which for a magazine editor seems like a good thing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7987bcc-d0cf-4f16-bfd2-50763bce8079",
                        "source_entry_id": "5b3f4d4d-fc44-3c9f-b010-a5b84af35f7c",
                        "source_sense_id": "a9755e68-315b-360f-b078-3c3a394146a6",
                        "source_sense_description": "En définitive",
                        "target_lang_word": "really",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "In a way or manner that is real, not unreal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852a8e63-d433-4df4-a07c-de3a4fbebb19",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "We are to believe that by an extraordinary Conception by Means of the holy Ghost he in an extraordinary MANNER, (unknown to us) really assumed Flesh, and was by her nourished in the Womb and in due Time born in a natural Manner, and that whilst on Earth he was really hungry, and dry, and eat and drank as really as other Men, without, any Deception of Sight in us or Delusion whatsoever."
                                            },
                                            {
                                                "example_id": "fa0b85b9-aad1-434e-97e7-65878e996862",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "If we take the phenomenal world as it strikes our senses, in all its varied and wonderful powers and aspects; as the mere symbol of the Divine Presence and power, that is, according to Christ, ever in, through, and over all, as really as are causal light, heat and gravity, or as really as our own life and souls pervade every atom of our bodies, [...]"
                                            },
                                            {
                                                "example_id": "0dfb3646-05b9-46a6-9777-5a4253706e6d",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "Thus Brahman must be described as ‘really real’, while a rope, or a person, or God Himself, is ‘unreally real’. And it is only the Vedantin who can distinguish the real from the unreal, for to others all seems real."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a26b45-1676-3caa-be56-f70e062d2cc1",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "Actually; in fact; in reality."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f698d2fb-ec01-41af-be15-ab2d936c3910",
                                                "sense_id": "11a26b45-1676-3caa-be56-f70e062d2cc1",
                                                "text": "\"He really is a true friend.\" / \"Really? What makes you so sure?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "Very (modifying an adjective); very much (modifying a verb)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d557a52-0785-43dd-b374-4de4a1b158cf",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "But ma, I really, really want to go to the show!"
                                            },
                                            {
                                                "example_id": "61416a01-e612-4565-864e-21766212f3ea",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            },
                                            {
                                                "example_id": "9c904749-08ca-41ce-8dbc-8a0f46de71bd",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "There was also hairdressing: hairdressing, too, really was hairdressing in those times — no running a comb through it and that was that. It was curled, frizzed, waved, put in curlers overnight, waved with hot tongs;[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating surprise at, or requesting confirmation of, some new information; to express skepticism."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27dc7852-d518-4a8f-933d-341df701f6b9",
                                                "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                                "text": "A: He won the Nobel Prize yesterday."
                                            },
                                            {
                                                "example_id": "cd4159f2-67b5-4246-b76b-a74030122215",
                                                "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                                "text": "B: Really?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating surprise at, or requesting confirmation of, some new information; to express skepticism.",
                                            "A phatic confirmation by a listener, to signal active listening; mostly devoid of literal meaning, with the phatically contrived incredulity being merely formulaic."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589720c6-b17e-4343-8b69-fcc8e76698d4",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "A: You know, I saw Oliver the other day."
                                            },
                                            {
                                                "example_id": "caa44746-8434-44f8-91aa-e16650ee6933",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "B: Really? What's he been up to?"
                                            },
                                            {
                                                "example_id": "68c7ad7c-b748-4256-98a2-9804592d98f3",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "\"Literally\" is not the only word that has lost touch with reality: look at \"really.\" That word also was meant to describe a state of reality, or literalness. Even as a substitute for \"Is that so?,\" the word asked, \"Is that true, or real?\" Nowadays, one guy goes, \"I literally flew off the handle,\" and the other guy goes \"Really.\" It's a grunt, meaning, \"I'm still here.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating that what was just said was obvious and unnecessary; contrived incredulity"
                                        ],
                                        "tags": [
                                            "informal",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "815b625c-e932-440c-b2cc-9d439ef49ef9",
                                                "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                                "text": "A: I've just been reading Shakespeare - he's one of the best authors like, ever!"
                                            },
                                            {
                                                "example_id": "671c3f5e-a06e-4013-a1f1-438d0d0a8a65",
                                                "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                                "text": "B: Really."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating affirmation, agreement."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb27bef-c7c4-43f2-abe3-7a562e84913b",
                                                "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                                "text": "A: That girl talks about herself way too much."
                                            },
                                            {
                                                "example_id": "216152de-eaef-44ab-85ec-fa682d7c5d19",
                                                "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                                "text": "B: Really. She's a nightmare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f802388c-adfa-39f5-bd1d-e9da67f06087",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating displeasure at another person's behaviour or statement."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887fb587-bf8b-4d56-a0b1-9a32fb658e15",
                                                "sense_id": "f802388c-adfa-39f5-bd1d-e9da67f06087",
                                                "text": "Well, really! How rude."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                        "entry_id": "14bd7a7d-e7bd-3ac3-96f2-497367f55566",
                                        "glosses": [
                                            "Alternative form of re-ally."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5568d978-e346-421a-9359-efa3752f9b23",
                                                "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                                "text": "She wished since long to die and to be reallied with her children in heaven."
                                            },
                                            {
                                                "example_id": "87d4e24d-eb20-42eb-97c7-37dd5b43cef6",
                                                "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                                "text": "Following the election, those who had publicly opposed Harding hastened to really themselves with Republicans who had remained in the party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
