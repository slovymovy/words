                        "examples": [
                            {
                                "example_id": "58877edd-9fd7-4c6c-917c-e9ccf7962bfa",
                                "sense_id": "812e9abf-e76a-3785-a2e1-6088af9b6683",
                                "text": "Een prachtige witte lange lakjas sierde jouw etalage. Van zo’n jas daar droomde ik al jaren."
                            },
                            {
                                "example_id": "4cff7eb3-e4d5-460b-a5cf-ccad532debcb",
                                "sense_id": "812e9abf-e76a-3785-a2e1-6088af9b6683",
                                "text": "Ondanks mijn met wansmaak behangen jeugdjaren gaat ook mijn hart sneller kloppen van de jaren negentig en alles wat daarbij hoort, dus ook donkerbruine lipliner en Ray Slijngaard in een lange zwarte lakjas."
                            }
                        ]
