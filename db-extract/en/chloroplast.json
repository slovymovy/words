                                    {
                                        "sense_id": "051186f7-adf1-38d5-a0bb-6f45b4fe8c7b",
                                        "entry_id": "58a7146c-9d77-35b8-a5d4-493f02777143",
                                        "glosses": [
                                            "een organel dat in planten en algen lichtenergie vastlegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8933be2e-c471-487a-8abb-a5723026adfc",
                                                "sense_id": "051186f7-adf1-38d5-a0bb-6f45b4fe8c7b",
                                                "text": "Bladgroenkorrels leggen de energie vast waar uiteindelijk ook de dieren van leven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acb6bf03-ba1d-4de2-ad20-48dd72d95673",
                        "source_entry_id": "a8ed7bcc-11ce-3c2c-9c53-0c2c515a86bc",
                        "source_sense_id": "fc99ec6d-f4d4-317f-ac31-a0e7f6f64512",
                        "source_sense_description": "photosynthetic organelle",
                        "target_lang_word": "chloroplaste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chloroplaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b4a1cb1-c96a-3ecb-b8c3-e954575df85a",
                                        "entry_id": "cfce3b1c-98e3-3ee5-884b-5249b477798e",
                                        "glosses": [
                                            "Organite des cellules eucaryotes photosynthétiques (comme celles des plantes et des algues), contenant de la chlorophylle et d’autres pigments, où se déroule la photosynthèse ainsi que diverses synthèses métaboliques (sucres, lipides, acides aminés)."
                                        ],
                                        "tags": [
                                            "Biologie végétale",
                                            "Biologie cellulaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd669cd9-8f7b-4447-a485-6049cd2f0ba7",
                                                "sense_id": "3b4a1cb1-c96a-3ecb-b8c3-e954575df85a",
                                                "text": "Le mode vie autotrophique des plantes repose entièrement sur l'intégrité du chloroplaste et notamment l'étape de la biogénèse"
                                            },
                                            {
                                                "example_id": "11218e2d-8364-4666-96fd-49f07316bbc8",
                                                "sense_id": "3b4a1cb1-c96a-3ecb-b8c3-e954575df85a",
                                                "text": "Au sein des cellules vertes de la feuille, la photosynthèse se déroule à l'intérieur de nombreux petits grains qui concentrent ce vert, les chloroplastes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca64634b-de51-476f-9aee-46908b594582",
                        "source_entry_id": "a8ed7bcc-11ce-3c2c-9c53-0c2c515a86bc",
                        "source_sense_id": "fc99ec6d-f4d4-317f-ac31-a0e7f6f64512",
