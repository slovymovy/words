                "senses": [
                    {
                        "sense_id": "5cbbc850-a761-3f3b-a087-6a8190efe139",
                        "entry_id": "57869549-f090-3e28-b0e1-7e9f6b0c7aef",
                        "glosses": [
                            "To lumber; to plod."
                        ],
                        "tags": [
                            "archaic",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5a904965-4bad-4e66-8266-63ddb293754d",
                                "sense_id": "5cbbc850-a761-3f3b-a087-6a8190efe139",
                                "text": "Lord, what's the good o' my lumpering all the way to church and back again, when I'm as deaf as a plock?"
                            },
                            {
                                "example_id": "90732eab-eb93-4336-a142-e29dc3d5c7fb",
                                "sense_id": "5cbbc850-a761-3f3b-a087-6a8190efe139",
                                "text": "Over piggeries, and mixens, and apples, and hay, / They lumpered straight into the night; / And finding bylong where a halter-path lay, / At dawn reached Tim's house […]"
                            },
                            {
                                "example_id": "eda31819-9129-47b5-8f0a-761f5dd03e5b",
                                "sense_id": "5cbbc850-a761-3f3b-a087-6a8190efe139",
                                "text": "But, my dear woman, why ever have ye come lumpering up to Rainbarrows at this time o' night?"
                            }
                        ]
                    }
                ],
