                                "example_id": "76b97bf0-b397-45e4-bce3-55191c507c83",
                                "sense_id": "72a6476b-efae-3a56-bb04-92773ab198d1",
                                "text": "Het regelsysteem zorgt ervoor dat de toestand van het systeem bijgestuurd wordt als de gemeten waarde van een \"uitgang\" van dat systeem afwijkt van de gewenste waarde."
                            }
                        ]
