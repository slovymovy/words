                                        "entry_id": "9639d9d8-21f3-3d89-9853-9e92c757ed91",
                                        "glosses": [
                                            "An island or its town in the province of Nampula, Mozambique, from which its name was transferred to the country."
                                        ],
                                        "tags": [],
                                        "examples": []
