                        "sense_id": "3e9542db-771f-31fb-9dc9-19582841f6d4",
                        "entry_id": "891ec458-0941-3d02-97fe-1f5b4b0e7f9d",
                        "glosses": [
                            "Personne qui est chargée d’une cogestion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f90f314-f4f3-42fb-a34a-6324b49f099c",
                                "sense_id": "3e9542db-771f-31fb-9dc9-19582841f6d4",
                                "text": "En Yougoslavie, au contraire, depuis l’application aux coopératives agricoles du principe général de l’autogestion ouvrière, ils sont non seulement co-gestionnaires de ia coopérative, mais gestionnaires privilégiés."
                            },
                            {
                                "example_id": "e9deffe0-14f9-446c-be9f-5121b9f7469d",
                                "sense_id": "3e9542db-771f-31fb-9dc9-19582841f6d4",
                                "text": "Dans les dernières versions de ces programmes, les habitants-propriétaires regroupés en consortii sont institués dans le rôle de co-planificateurs et de co-gestionnaires des projets sur les différents quartiers."
                            },
                            {
                                "example_id": "cf34c727-912e-4995-aa53-c407be80ba81",
                                "sense_id": "3e9542db-771f-31fb-9dc9-19582841f6d4",
                                "text": "Le Syndicat des Maisons de Cognac (SMC) est co-gestionnaire de la filière Cognac avec l’UGVC, au sein du BNIC."
                            }
                        ]
                    }
