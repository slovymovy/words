                                    },
                                    {
                                        "sense_id": "65e27d84-bd25-3e06-ad2d-2a9dea9752f1",
                                        "entry_id": "b33e46b8-7502-3ef6-90ae-40192f9102f9",
                                        "glosses": [
                                            "употребляется как порицающее или бранное слово"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277b6530-9b60-415d-94c9-efe47936a9be",
                                                "sense_id": "65e27d84-bd25-3e06-ad2d-2a9dea9752f1",
                                                "text": "― Тише ты, чума, ― крикнул кто-то около него, ― ногу отдавил!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2634896f-273a-39c2-99ce-66d599bdfb53",
                                        "entry_id": "b33e46b8-7502-3ef6-90ae-40192f9102f9",
                                        "glosses": [
                                            "жарг. наркотик"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2683a10f-55ee-30c8-bd31-fd0c6ca491c5",
                                        "entry_id": "b33e46b8-7502-3ef6-90ae-40192f9102f9",
                                        "glosses": [
                                            "жарг. нечто удивительное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ac242b-1d49-416c-a1d3-5fdec53bd8b8",
                                                "sense_id": "2683a10f-55ee-30c8-bd31-fd0c6ca491c5",
                                                "text": "Вы бы знали, какие шутки они иногда устраивают первого апреля… это вообще чума."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af1635e4-affc-317b-a4a4-f8e1132f050c",
                                        "entry_id": "b33e46b8-7502-3ef6-90ae-40192f9102f9",
                                        "glosses": [
                                            "нечто неясное, неопределённое"
                                        ],
                                        "tags": [],
                                        "examples": [
