                        "cross_references": [
                            {
                                "target_word": "bidule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e463b3a-d062-3f49-8f63-b427effadc55",
                                        "entry_id": "5c14d702-afa6-3357-8c26-c56596ac1c85",
                                        "glosses": [
                                            "Petit objet, machin, truc."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b21bf75e-4aab-4bf9-8ec9-d9287099edfc",
                                                "sense_id": "5e463b3a-d062-3f49-8f63-b427effadc55",
                                                "text": "Emmanuel Macron avait dit à un demandeur d'emploi venu le voir dans le cadre des Journées du patrimoine qu'il suffisait de \"traverser la rue\" pour trouver du travail. \"J'ai fait un raccourci avec ce bidule\", reconnaît alors le chef de l'État."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ea28187-c3d7-3405-8c27-5dd64f568f08",
                                        "entry_id": "5c14d702-afa6-3357-8c26-c56596ac1c85",
                                        "glosses": [
                                            "Petit objet, machin, truc.",
                                            "Tout petit objet dans un ensemble, tel qu’une note de bas de page dans un document."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b31d4e3-6510-3582-a1b9-6a94dd81a795",
                                        "entry_id": "5c14d702-afa6-3357-8c26-c56596ac1c85",
                                        "glosses": [
                                            "Petit récipient cylindrique introduit dans les bouteilles de vin effervescent en méthode traditionnelle sous la capsule couronne au moment de la mise en bouteille du vin de base, auquel viennent d’être ajoutées les levures pour la phase de prise de mousse. C’est cette partie qui est enlevée, avec le dépôt de levures mortes lors du dégorgement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6730ad72-ec24-41f6-a7bf-5299545e68d4",
                                                "sense_id": "7b31d4e3-6510-3582-a1b9-6a94dd81a795",
                                                "text": "Un bouchon de glace se forme dans le bidule, emprisonnant le dépôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e5e439-5874-37d7-99b9-bec572de42eb",
                                        "entry_id": "5c14d702-afa6-3357-8c26-c56596ac1c85",
                                        "glosses": [
                                            "Répétiteur lumineux situé sur le toit des taxis en France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90b344aa-c54f-393b-84a7-3184ba3c5da4",
                                        "entry_id": "5c14d702-afa6-3357-8c26-c56596ac1c85",
                                        "glosses": [
                                            "Système mobile sans fil permettant l’interprétation simultanée sans cabines, notamment lors de visites ou d’entretiens hors des salles équipées."
                                        ],
                                        "tags": [
                                            "Jargon des interprètes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "636c4dc2-0fbd-411c-9ca6-db50a8295a88",
                                                "sense_id": "90b344aa-c54f-393b-84a7-3184ba3c5da4",
                                                "text": "Le bidule, jugé parfois chose du passé, a bien évolué et est tout à fait d’actualité au FMI (au siège) ainsi qu’à l’ONUG et l’ONUNY (dans certaines missions)."
                                            },
                                            {
                                                "example_id": "4e3d7675-7550-4da7-ae3a-cd1b263ef94d",
                                                "sense_id": "90b344aa-c54f-393b-84a7-3184ba3c5da4",
                                                "text": "Quand le nombre d’auditeurs est réduit, au lieu d’utiliser les cabines, on peut utiliser un petit équipement portable, à savoir le bidule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430a0c05-57a3-30bc-8025-4e1b9d55d67b",
                                        "entry_id": "5c14d702-afa6-3357-8c26-c56596ac1c85",
                                        "glosses": [
                                            "Longue matraque en bois."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64445fb2-93cd-4a1a-8715-a0d423900efa",
                                                "sense_id": "430a0c05-57a3-30bc-8025-4e1b9d55d67b",
                                                "text": "Sous autorité du préfet Maurice Papon, la manifestation pacifique fut violemment réprimée par la police, armée à l'époque de « bidules », ces matraques en bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31395f2d-fb46-3696-8820-17497bae287d",
                                        "entry_id": "5c14d702-afa6-3357-8c26-c56596ac1c85",
                                        "glosses": [
                                            "Matraque, tonfa."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b571ae5b-3d2c-46fd-ab18-e581e2b271a5",
                                                "sense_id": "31395f2d-fb46-3696-8820-17497bae287d",
                                                "text": "(Les policiers motocyclistes) ont commencé à nous rouer de coups. Ils renvoyaient mon copain de moto en moto à coup de matraque pendant que je me faisais démolir à coups de bidule."
                                            },
                                            {
                                                "example_id": "c091daca-78e9-4266-80fd-09a8bd991396",
                                                "sense_id": "31395f2d-fb46-3696-8820-17497bae287d",
                                                "text": "Ce sont des unités de police particulièrement agressives, montées sur moto et armées de bidules, grandes matraques permettant à un policier de frapper pendant que l’autre conduit."
                                            }
                                        ]
                                    }
                                ]
