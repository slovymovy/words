{
    "word_family": [
        "błogosławić",
        "błogosławiony",
        "błogosławienie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d32581fc-1bf1-3efc-82d0-b190e00f192e",
                    "sense_definition": "obrzęd, modlitwa lub gest powierzenia kogoś albo czegoś opiece Boga",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ksiądz zakończył niedzielną mszę uroczystym <w>błogosławieństwem</w> dla wszystkich wiernych.",
                            "target_lang_translations": {
                                "en": "The priest concluded the Sunday Mass with a solemn <w>blessing</w> for all the faithful."
                            }
                        },
                        {
                            "text": "Wierni uklęknęli w kościele, aby otrzymać kapłańskie <w>błogosławieństwo</w> na dalszą drogę życia.",
                            "target_lang_translations": {
                                "en": "The faithful knelt in the church to receive a priestly <w>blessing</w> for their future journey in life."
                            }
                        }
                    ],
                    "synonyms": [
                        "benedykcja",
                        "błogosławienie"
                    ],
                    "antonyms": [
                        "klątwa",
                        "przekleństwo"
                    ],
                    "common_phrases": [
                        "udzielić błogosławieństwa",
                        "otrzymać błogosławieństwo",
                        "papieskie błogosławieństwo"
                    ],
                    "target_lang_definitions": {
                        "en": "a religious rite, prayer, or gesture invoking divine protection upon someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blessing",
                                "target_lang_sense_clarification": "religious invocation of divine favor"
                            },
                            {
                                "target_lang_word": "benediction",
                                "target_lang_sense_clarification": "formal liturgical blessing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebfb9009-b56b-39a5-bd40-4c1189f276d5",
                    "sense_definition": "zgoda, aprobata lub życzenie pomyślności wyrażone przez kogoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aprobata",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młoda para poprosiła rodziców o <w>błogosławieństwo</w> przed podjęciem decyzji o ślubie.",
                            "target_lang_translations": {
                                "en": "The young couple asked their parents for their <w>blessing</w> before deciding to get married."
                            }
                        },
                        {
                            "text": "Dyrektor dał swoje <w>błogosławieństwo</w> nowemu projektowi i obiecał wsparcie finansowe.",
                            "target_lang_translations": {
                                "en": "The director gave his <w>blessing</w> to the new project and promised financial support."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rodzicielskie błogosławieństwo",
                        "dać błogosławieństwo"
                    ],
                    "target_lang_definitions": {
                        "en": "consent, approval, or good wishes granted by someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blessing",
                                "target_lang_sense_clarification": "approval or consent"
                            },
                            {
                                "target_lang_word": "approval",
                                "target_lang_sense_clarification": "official or parental agreement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80951919-eaa3-3cd7-98d8-475744afd3b9",
                    "sense_definition": "źródło wielkiego szczęścia, pomyślności lub dar od losu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "szczescie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deszcz po wielu tygodniach suszy okazał się prawdziwym <w>błogosławieństwem</w> dla rolników.",
                            "target_lang_translations": {
                                "en": "The rain after many weeks of drought turned out to be a real <w>blessing</w> for the farmers."
                            }
                        },
                        {
                            "text": "Jej powrót do zdrowia był dla całej rodziny niezwykłym <w>błogosławieństwem</w>.",
                            "target_lang_translations": {
                                "en": "Her recovery was an extraordinary <w>blessing</w> for the whole family."
                            }
                        }
                    ],
                    "antonyms": [
                        "przekleństwo"
                    ],
                    "common_phrases": [
                        "prawdziwe błogosławieństwo"
                    ],
                    "target_lang_definitions": {
                        "en": "a source of great happiness, good fortune, or a stroke of luck"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blessing",
                                "target_lang_sense_clarification": "a beneficial thing or source of happiness"
                            },
                            {
                                "target_lang_word": "godsend",
                                "target_lang_sense_clarification": "unexpected good fortune"
                            },
                            {
                                "target_lang_word": "boon",
                                "target_lang_sense_clarification": "helpful benefit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}