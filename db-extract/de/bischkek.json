                                            {
                                                "example_id": "2ba55b45-f7de-4b9e-80e5-4974b1bdbac2",
                                                "sense_id": "013c5b84-4889-3be9-ab3a-3a692b33dc7d",
                                                "text": "C’est à Bichkek, au Kirghizistan, qu’aura lieu, le 15 septembre, la cérémonie de remise du prix de l’architecture de l’Aga Khan, un prix collectif partagé entre sept projets issus du monde musulman ou pensés pour la communauté musulmane."
                                            },
                                            {
                                                "example_id": "66c2be5f-cd05-4b95-acdf-b9940cfac847",
                                                "sense_id": "013c5b84-4889-3be9-ab3a-3a692b33dc7d",
                                                "text": "30/08 : Trois personnes ont été blessées après l’explosion d’une voiture positionnée devant l’ambassade de Chine à Bichkek."
                                            }
                                        ]
                                    },
