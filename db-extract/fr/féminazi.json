                    {
                        "translation_id": "b18d8425-865e-4e46-a0ae-181f97045dd8",
                        "source_entry_id": "1a1c2231-58ca-3421-a2f4-383f47128490",
                        "source_sense_id": "44698383-951c-36fb-badb-49cd771e555e",
