                                        "glosses": [
                                            "any of a range of compounds, being hydrates of silica; they form silicates having complex polymeric structures"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f358d777-a7cb-424d-9b33-c84b7227728d",
                                                "sense_id": "d4f57f76-2723-34a6-8330-bf720ce77122",
