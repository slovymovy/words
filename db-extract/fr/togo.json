        "fr-extract.jsonl": [
            {
                "entry_id": "6062e654-283d-3751-b2a7-a890ea546728",
                "word": "Togo",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b4d8322b-0154-3ea3-af07-f21886719882",
                        "entry_id": "6062e654-283d-3751-b2a7-a890ea546728",
                        "glosses": [
                            "Pays d’Afrique de l’Ouest ayant des frontières communes avec le Bénin à l’est, le Burkina Faso au nord, et le Ghana à l’ouest. Sa capitale est Lomé."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "63a471b3-5648-4373-878f-d20ced3565f5",
                                "sense_id": "b4d8322b-0154-3ea3-af07-f21886719882",
                                "text": "Entre 2011 et 2022, le Togo a ainsi patiemment éliminé la maladie du sommeil, deux maladies parasitaires – celle du ver de Guinée et la filariose lymphatique –, ainsi que le trachome, une maladie infectieuse de l’œil due à une bactérie."
                            },
                            {
                                "example_id": "fdbee661-cb3c-4356-84f8-79a70795df2c",
                                "sense_id": "b4d8322b-0154-3ea3-af07-f21886719882",
                                "text": "Sa sœur, me répondit-il, venait de se fiancer ; son frère aîné — depuis longtemps marié, dont il ne parlait jamais — allait partir pour le Togo ; en annonçant à sa mère que lui aussi il préméditait de la quitter, il lui porterait un coup fatal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1db24c02-3128-4932-a840-b75f043f91b1",
                        "source_entry_id": "6062e654-283d-3751-b2a7-a890ea546728",
                        "source_sense_id": "b4d8322b-0154-3ea3-af07-f21886719882",
                        "target_lang_word": "Togo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Togo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                        "entry_id": "1d54469f-bf93-3098-a52f-9e0a14208ab7",
                                        "glosses": [
                                            "Land in Westafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5044d84c-bcb8-4ac0-b6ac-5c261f5c940c",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "Im Vergleich mit anderen Ländern Afrikas ist Togo ein Kleinstaat."
                                            },
                                            {
                                                "example_id": "e2c0fc40-94f1-432b-bb15-bd3493309091",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "Mein Onkel hat eine Farm in Togo und baut dort Hirse an."
                                            },
                                            {
                                                "example_id": "aee41cce-def3-4e75-b674-f3f68d12c9a7",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "Lomé ist die Hauptstadt von Togo."
                                            },
                                            {
                                                "example_id": "59da2ecc-9827-429b-8361-0307bcf32295",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "„Wie ich Togo überhaupt erreichen sollte, war mir schleierhaft.“"
                                            },
                                            {
                                                "example_id": "ba17150f-8d86-409f-84e9-d3416f3037f2",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "„Togo wurde ab 5.7.1884 deutsche Kolonie, die deutsche Post wurde am 1.3.1888 eröffnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
