                        "translation_id": "a4e561a6-7aa2-404e-854c-5b70df969405",
                        "source_entry_id": "9f1ba030-ca0c-3342-a981-a208d32f95b9",
                        "source_sense_id": "7dd9800d-7de6-309f-85c0-5b9971885252",
                        "target_lang_word": "Sozialdemokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sozialdemokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                                        "entry_id": "3cd8defe-5c12-3815-b1ee-cbdbc49952ce",
                                        "glosses": [
                                            "politische Ideologie, entstanden aus der Arbeiterbewegung, welche demokratische und sozialistische Grundsätze in sich vereint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7bece4-e80a-4230-9b57-ef749dd7656c",
                                                "sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                                                "text": "„Als Folge der Industrialisierung wurde Thüringen zur Wiege der Sozialdemokratie.“"
                                            },
                                            {
                                                "example_id": "f93f08aa-fcf7-4475-b583-2dfa1f89f8fa",
                                                "sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                                                "text": "„Ein paar Jahre später war Schönerer der Führer einer deutschnationalen und antisemitischen Partei, Adler der Vorsitzende der gesamtösterreichischen Sozialdemokratie und Masaryk ein Prager Politiker und Professor, der viel später zur größten Integrationsfigur seines Volkes werden sollte.“"
                                            },
                                            {
                                                "example_id": "4dda9881-5094-4bcd-9b36-7cdc9b5878ac",
                                                "sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                                                "text": "„Eine Parteifreundin will einen alten Mann mit Krückstock von den Vorzügen der Sozialdemokratie überzeugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
