                    {
                        "sense_id": "c1908010-e644-313b-8acc-f6212124ec95",
                        "entry_id": "7f9dba3c-342f-3e76-b354-a3f3581fa293",
                        "glosses": [
                            "ein Notizbuch in klassischer Buchform, früher mit einem Einband aus Moleskin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073c90f6-93e3-42a4-a93f-d92382493d5b",
                                "sense_id": "c1908010-e644-313b-8acc-f6212124ec95",
                                "text": "„In einem Hafen am Meer irgendwo im Süden, auf einem Weinfass sitzend, mache ich mir Notizen in einem echten Moleskine, einem Museumsstück, das Bruce (–> Chatwin) mir extra für diese Reise geschenkt hat. (Luis Sepúlveda)“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
