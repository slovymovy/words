                        ],
                        "form": "tyfoontjes"
                    },
                    {
                        "form_id": "a62f71f8-5242-4083-90cc-e911f0e79a57",
                        "entry_id": "db0f8fd8-e208-39c3-af25-614ba773d18c",
                        "tags": [],
                        "form": "alternatieve spelling: taifoen."
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35e10817-5431-3e86-a3ad-3a06bc7c3cd6",
                        "entry_id": "db0f8fd8-e208-39c3-af25-614ba773d18c",
                        "glosses": [
                            "een hevige wervelstorm in de Chinese Zee en de Stille Oceaan die ontstaat uit een tropische depressie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e9e96e1-383f-48d2-a483-beefb43c9bad",
                                "sense_id": "35e10817-5431-3e86-a3ad-3a06bc7c3cd6",
                                "text": "Op 20 oktober 2004 werd Japan getroffen door één van de zwaarste tyfoons uit de laatste decennia."
                            },
                            {
                                "example_id": "53ee7029-1e65-4126-827d-4b02be984561",
                                "sense_id": "35e10817-5431-3e86-a3ad-3a06bc7c3cd6",
                                "text": "Max Verstappen start om 07.10 uur vanaf de derde startrij in de Grand Prix van Japan. De Nederlander van Red Bull kon zich op het circuit van Suzuka, waar de kwalificatie een dag was uitgesteld wegens de tyfoon Hagibis, niet mengen in de strijd om polepositie. Verstappen noteerde slechts de vijfde tijd (1.27,851)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25810292-4abc-4219-9483-caa731a8c0f0",
                        "source_entry_id": "db0f8fd8-e208-39c3-af25-614ba773d18c",
                        "source_sense_id": "35e10817-5431-3e86-a3ad-3a06bc7c3cd6",
                        "source_sense_description": "een hevige wervelstorm in de Chinese Zee en de Stille Oceaan die ontstaat uit een tropische depressie.",
                        "target_lang_word": "Taifun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taifun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                        "entry_id": "10aea82e-d3bb-3d96-befe-f7ef43bb86ff",
                                        "glosses": [
                                            "tropischer Wirbelsturm im nordwestlichen Teil des Pazifischen Ozeans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb70f7b2-ef57-4011-b2a6-030fc2c4eef1",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "Der Taifun Nabi verwüstete am 6. September 2005 die japanische Insel Kyūshū."
                                            },
                                            {
                                                "example_id": "8ae67aa1-b395-4122-9ccd-a68fd1f9e9ac",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "„Einer der bislang mächtigsten Taifune ist mit verheerender Zerstörungskraft über die Philippinen hereingebrochen.“"
                                            },
                                            {
                                                "example_id": "847e010b-27a8-4e44-8f72-f99fc937fff1",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "„Am nächsten Tag schon hätten sie losfliegen können, doch hielt sie ein Taifun, der über Japan hinwegzog, davon ab.“"
                                            },
                                            {
                                                "example_id": "0537ed13-dcef-4b93-971c-9b5b1c8e706f",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "„Nach seinem Tod betrachteten es die Deckoffiziere als oberste Pflicht, die Anweisung, nach der der Alte das Flaggschiff durch Flauten und Taifune gesteuert hatte, als Vermächtnis zu beherzigen.“"
                                            },
                                            {
                                                "example_id": "a0f06244-3fa7-452f-98da-fe20544e8d5d",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "„Und wie ein näherkreisender Taifun kehrte der Donner der Schlacht zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6d7848e-b692-4400-ac1f-c256d94d3fb1",
                        "source_entry_id": "db0f8fd8-e208-39c3-af25-614ba773d18c",
                        "source_sense_id": "35e10817-5431-3e86-a3ad-3a06bc7c3cd6",
