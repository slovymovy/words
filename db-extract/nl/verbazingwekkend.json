                        "translation_id": "7df4023e-07ac-4c5c-ac2d-ba0d4bda72ad",
                        "source_entry_id": "f9432b9b-9f1d-3f72-af6e-3e494fe9eba5",
                        "source_sense_id": "029185be-dd4d-374b-8c3d-e190632a2b66",
                        "source_sense_description": "wat verbazing opwekt, wat buitengewoon is",
                        "target_lang_word": "étonnant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étonnant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32cf52da-d0f9-3624-8384-b85938a59e3f",
                                        "entry_id": "4c7907ac-5d47-34c1-877f-839956f10914",
                                        "glosses": [
                                            "Qui étonne, qui surprend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77c5880-2c0f-48e8-993e-a29b1dd8bfaf",
                                                "sense_id": "32cf52da-d0f9-3624-8384-b85938a59e3f",
                                                "text": "Ce qui m’émerveillait le plus dans les premiers temps, c'était l’étonnante habileté de nos poneys à se tirer d'affaire au milieu d'un chaos de débris volcaniques où un piéton aurait pu difficilement trouver son chemin."
                                            },
                                            {
                                                "example_id": "68dace42-5bbe-4af2-b4ef-b31e2736f1ab",
                                                "sense_id": "32cf52da-d0f9-3624-8384-b85938a59e3f",
                                                "text": "[…], je vis tragiquement émerger de la nuit une étonnante masure en ruines à un étage, aux persiennes vermoulues et closes."
                                            },
                                            {
                                                "example_id": "51619c1d-2bf1-49da-b2fd-67a6e062df27",
                                                "sense_id": "32cf52da-d0f9-3624-8384-b85938a59e3f",
                                                "text": "Ce qui est plus grave, c'est que, d’auteur en auteur, les hypothèses sont devenues des certitudes et l'on peut lire dans des ouvrages de vulgarisation les plus étonnantes affirmations, jamais vérifiées, jamais critiquées, prises un jour à la source du possible et entraînées depuis dans le flot de l’indiscutable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fc97762-d10d-345b-869b-622a6029ab38",
                                        "entry_id": "4c7907ac-5d47-34c1-877f-839956f10914",
                                        "glosses": [
                                            "Qualifie quelqu’un qui est extraordinaire, soit en bien, soit en mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b7c690f-e2a2-48fc-a8ca-60df7b40973e",
                                                "sense_id": "3fc97762-d10d-345b-869b-622a6029ab38",
                                                "text": "C’est un homme étonnant."
                                            }
                                        ]
                                    }
                                ]
