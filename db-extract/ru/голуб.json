                                            {
                                                "example_id": "d99539d4-ba0f-4e69-9a15-f823d936701e",
                                                "sense_id": "165cff04-4d30-3723-8423-1189b27de13a",
                                                "text": "Nejznámějším a nejúspěšnějším českým cestovatelem devatenáctého století byl jistě lékař a etnograf Emil Holub. Někteří o něm mluví jako o českém Livingstonovi. Radil mu ostatně sám Jára Cimrman."
                                            },
                                            {
                                                "example_id": "41cbe72e-b8c9-4f34-b0ba-9995a534f1ba",
                                                "sense_id": "165cff04-4d30-3723-8423-1189b27de13a",
                                                "text": "Někdejšího vojenského kaplana v Bosně, později sekretáře České biskupské konference a nyní plzeňského biskupa, monsignora Tomáše Holuba prý současná česká média již jen těžko něčím překvapí."
                                            }
                                        ]
