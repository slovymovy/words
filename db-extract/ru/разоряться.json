                                "target_senses": [
                                    {
                                        "sense_id": "854bcfcf-8a2c-3d57-ad02-f501ce680ba8",
                                        "entry_id": "329c9528-1c15-39be-ac73-944411dec710",
                                        "glosses": [
                                            "Tomber en faillite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f016d7ef-d96d-488b-a8e3-2148a7f66148",
                                                "sense_id": "854bcfcf-8a2c-3d57-ad02-f501ce680ba8",
                                                "text": "Faire faillite, reprit le père, c’est commettre l’action la plus déshonorante entre toutes celles qui peuvent déshonorer l’homme."
                                            },
                                            {
                                                "example_id": "9211e43e-00db-4234-b422-458a10e34f06",
                                                "sense_id": "854bcfcf-8a2c-3d57-ad02-f501ce680ba8",
                                                "text": "Deux nouvelles banques régionales ont fait faillite aux USA cette semaine."
                                            }
                                        ]
                                    }
