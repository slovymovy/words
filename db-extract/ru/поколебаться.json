                ],
                "senses": [
                    {
                        "sense_id": "f4b94e99-ebbb-3f32-83ff-4a75dfac7511",
                        "entry_id": "4853bf32-a4e9-3ef1-9feb-b34db8991747",
                        "glosses": [
                            "в течение некоторого времени совершить колебание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb30a54-a4f5-439e-ac50-facc8752e192",
                                "sense_id": "f4b94e99-ebbb-3f32-83ff-4a75dfac7511",
                                "text": "Поколебались все стоявшие запорожцы."
                            }
                        ]
                    },
                    {
                        "sense_id": "d892666e-902c-3f25-97e3-9b7af3a4b435",
                        "entry_id": "4853bf32-a4e9-3ef1-9feb-b34db8991747",
                        "glosses": [
                            "перен. пошатнуться, утратить устойчивость, надёжность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d9d05e2-6dc2-4442-985d-8b4eab71ed99",
                                "sense_id": "d892666e-902c-3f25-97e3-9b7af3a4b435",
                                "text": "На лице его было мнимое равнодушие, но твёрдость характера, конечно, поколебалась."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6bf2e96-84ff-39c0-8767-ab06c48e8975",
                        "entry_id": "4853bf32-a4e9-3ef1-9feb-b34db8991747",
                        "glosses": [
                            "перен. почувствовать нерешительность, неуверенность, сомнение в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed79426-97fa-43c6-a35a-25fad71b619b",
                                "sense_id": "b6bf2e96-84ff-39c0-8767-ab06c48e8975",
                                "text": "Из первого подъезда выбежал швейцар, поглядел вверх, немного поколебался, очевидно, не сообразив сразу, что ему предпринять, всунул в рот свисток и бешено засвистел."
                            }
                        ]
                    }
                ],
