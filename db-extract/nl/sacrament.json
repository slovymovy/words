                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c9f2ae4f-9a9a-4dcb-9010-99871f9563c1",
                        "entry_id": "c57f11a9-51af-3c5a-84f9-92247af9d2b0",
                        "tags": [
                            "plural"
                        ],
