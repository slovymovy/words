{
    "word_family": [
        "husker",
        "husking",
        "husky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d339771a-0e64-3522-9752-791c75324b68",
                    "sense_definition": "The dry, leafy or stringy exterior of certain vegetables or fruits, which must be removed before eating the meat inside.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outer_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A coconut has a very thick <w>husk</w> that is difficult to break open.",
                            "target_lang_translations": {
                                "ru": "У кокоса очень толстая <w>скорлупа</w>, которую трудно расколоть."
                            }
                        },
                        {
                            "text": "We peeled away the green <w>husk</w> of the corn before boiling it.",
                            "target_lang_translations": {
                                "ru": "Мы сняли зеленую <w>шелуху</w> с кукурузы перед тем, как сварить ее."
                            }
                        }
                    ],
                    "synonyms": [
                        "hull",
                        "shell",
                        "peel",
                        "rind"
                    ],
                    "common_phrases": [
                        "corn husk",
                        "coconut husk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сухая, волокнистая или листовая внешняя оболочка некоторых овощей или плодов, которую необходимо удалить перед употреблением в пищу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шелуха",
                                "target_lang_sense_clarification": "сухая внешняя оболочка семян или початков"
                            },
                            {
                                "target_lang_word": "кожура",
                                "target_lang_sense_clarification": "внешний слой плодов"
                            },
                            {
                                "target_lang_word": "скорлупа",
                                "target_lang_sense_clarification": "твердая внешняя оболочка орехов или кокосов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18d0ad0a-8ddb-3000-af9a-6d110073a4b0",
                    "sense_definition": "Any form of useless, dried up, and subsequently worthless exterior of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "outer_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old factory was now just an empty <w>husk</w> of concrete and rusted steel.",
                            "target_lang_translations": {
                                "ru": "Старый завод теперь представлял собой лишь пустую бетонную <w>оболочку</w> и ржавую сталь."
                            }
                        },
                        {
                            "text": "After years of exhausting work, he felt like a dried-up <w>husk</w> of a man.",
                            "target_lang_translations": {
                                "ru": "После многих лет изнурительной работы он чувствовал себя как высохшая <w>тень</w> человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "shell",
                        "skeleton"
                    ],
                    "common_phrases": [
                        "empty husk",
                        "husk of a man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая бесполезная, высохшая и потерявшая ценность внешняя оболочка чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оболочка",
                                "target_lang_sense_clarification": "внешний пустой каркас"
                            },
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "в переносном смысле о человеке, потерявшем силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdd3ae70-db44-3614-a620-cb071123df44",
                    "sense_definition": "The supporting frame of a run of millstones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miller inspected the wooden <w>husk</w> to ensure the heavy stones were properly aligned.",
                            "target_lang_translations": {
                                "ru": "Мельник осмотрел деревянный <w>кожух</w>, чтобы убедиться, что тяжелые камни выровнены правильно."
                            }
                        },
                        {
                            "text": "Vibrations from the grinding process had slightly cracked the ancient <w>husk</w>.",
                            "target_lang_translations": {
                                "ru": "Вибрации от процесса помола слегка повредили старинную <w>раму</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical milling term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опорная рама или каркас для жерновов на мельнице."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кожух",
                                "target_lang_sense_clarification": "защитный каркас жерновов"
                            },
                            {
                                "target_lang_word": "рама",
                                "target_lang_sense_clarification": "опорная конструкция мельничного поста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3457d2e-a21e-3f92-8d68-466792771b53",
                    "sense_definition": "An infection in cattle caused by a species of lungworm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several calves in the herd were diagnosed with <w>husk</w> after showing signs of a persistent cough.",
                            "target_lang_translations": {
                                "ru": "У нескольких телят в стаде диагностировали <w>диктиокаулёз</w> после появления признаков постоянного кашля."
                            }
                        },
                        {
                            "text": "Wet pastures can increase the risk of cattle contracting <w>husk</w> during the summer.",
                            "target_lang_translations": {
                                "ru": "Влажные пастбища могут увеличить риск заражения скота <w>легочными глистами</w> в летний период."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoose"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "veterinary term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инфекционное заболевание крупного рогатого скота, вызываемое легочными гельминтами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диктиокаулёз",
                                "target_lang_sense_clarification": "ветеринарное название легочноглистной болезни скота"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44c520ed-c93f-3fff-aede-b9f5522c52ac",
                    "sense_definition": "To remove husks from.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat on the porch to <w>husk</w> corn for the evening barbecue.",
                            "target_lang_translations": {
                                "ru": "Они сидели на веранде, чтобы <w>очистить</w> кукурузу для вечернего барбекю."
                            }
                        },
                        {
                            "text": "It takes a lot of manual labor to <w>husk</w> coconuts by hand.",
                            "target_lang_translations": {
                                "ru": "Требуется много ручного труда, чтобы вручную <w>очищать</w> кокосы."
                            }
                        }
                    ],
                    "synonyms": [
                        "shuck",
                        "peel",
                        "shell"
                    ],
                    "common_phrases": [
                        "husk corn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать от шелухи, кожуры или внешней оболочки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "удалять внешнюю оболочку"
                            },
                            {
                                "target_lang_word": "лущить",
                                "target_lang_sense_clarification": "очищать початки кукурузы или горох"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51bd7ea8-93b1-3768-aa33-0281f292c54c",
                    "sense_definition": "To say huskily, or to utter in a hoarse, dry voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vocal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a dry throat, he managed to <w>husk</w> out a brief apology.",
                            "target_lang_translations": {
                                "ru": "С пересохшим горлом ему удалось <w>прохрипеть</w> короткое извинение."
                            }
                        },
                        {
                            "text": "She could only <w>husk</w> a few words before her voice failed completely.",
                            "target_lang_translations": {
                                "ru": "Она смогла лишь <w>прошептать</w> несколько слов, прежде чем голос окончательно пропал."
                            }
                        }
                    ],
                    "synonyms": [
                        "croak",
                        "whisper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить хрипло или произносить слова сухим, севшим голосом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрипеть",
                                "target_lang_sense_clarification": "говорить сиплым голосом"
                            },
                            {
                                "target_lang_word": "прохрипеть",
                                "target_lang_sense_clarification": "произнести хриплым голосом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6481078a-7369-35d4-91f1-26fa120efec4",
                    "sense_definition": "To cough dryly or clear one's throat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vocal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>husked</w> quietly to get the attention of the speaker at the podium.",
                            "target_lang_translations": {
                                "ru": "Он тихо <w>покашлял</w>, чтобы привлечь внимание выступающего на трибуне."
                            }
                        },
                        {
                            "text": "The old man <w>husked</w> and spat into the fireplace before continuing his story.",
                            "target_lang_translations": {
                                "ru": "Старик <w>прочистил горло</w> и сплюнул в камин, прежде чем продолжить свой рассказ."
                            }
                        }
                    ],
                    "synonyms": [
                        "hawk",
                        "cough"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "dialectal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сухо кашлять или прочищать горло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покашливать",
                                "target_lang_sense_clarification": "издавать сухой кашель"
                            },
                            {
                                "target_lang_word": "прочищать горло",
                                "target_lang_sense_clarification": "избавляться от хрипоты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7f74f5d2-e81a-3b53-9b0a-b8f9cdab73f3",
                    "sense_definition": "A English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Husk</w> to join our local historical society.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Хаска</w> вступить в наше местное историческое общество."
                            }
                        },
                        {
                            "text": "The old library was named in honor of the generous <w>Husk</w> family.",
                            "target_lang_translations": {
                                "ru": "Старая библиотека была названа в честь щедрой семьи <w>Хаск</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хаск",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}