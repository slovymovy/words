                ],
                "senses": [
                    {
                        "sense_id": "5a4cb0a6-456a-312d-a6d7-3210e58a19ee",
                        "entry_id": "ef6351d3-03d7-3e83-b189-315bfddb1839",
                        "glosses": [
                            "jüngstes Kind unter Geschwistern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97d49d0d-c013-4774-b9a7-e352ef504751",
                                "sense_id": "5a4cb0a6-456a-312d-a6d7-3210e58a19ee",
                                "text": "Das Nesthäkchen genießt oft Freiheiten, für die seine Geschwister hart kämpfen mussten."
                            },
                            {
                                "example_id": "d0ab8c86-747d-4b2b-9597-8f11478f02c6",
                                "sense_id": "5a4cb0a6-456a-312d-a6d7-3210e58a19ee",
                                "text": "„Als Nesthäkchen stand Tanja oft zwischen ihnen und wusste nicht, wem sie nun zuerst ihre Zuwendung schenken sollte.“"
                            },
                            {
                                "example_id": "5dc5c1a2-c490-4400-a714-bb655718a952",
                                "sense_id": "5a4cb0a6-456a-312d-a6d7-3210e58a19ee",
                                "text": "„Ihr Sohn aber, ihr Augenstern und Nesthäkchen, der lang ersehnte Sohn, von dem Gísli geträumt hatte und mit dem er zum Fischen hinausrudern wollte, der hatte quer vor der Haustür gelegen, als Skúli im Morgengrauen zum Plumpsklo wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
