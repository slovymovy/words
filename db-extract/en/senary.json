        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "418fd86d-d04e-3250-83cb-a0da7c1d5f17",
                "word": "senary",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e22b2ab6-22bd-3ba8-a1fd-3940b2f66cc3",
                        "entry_id": "418fd86d-d04e-3250-83cb-a0da7c1d5f17",
                        "glosses": [
                            "Of sixth rank or order."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bfd47456-eaf1-4655-88f2-220a3525ffc7",
                                "sense_id": "e22b2ab6-22bd-3ba8-a1fd-3940b2f66cc3",
                                "text": "In particular, one can construct mixed binary/ternary codes via senary codes by applying the Chinese Gray map (see Example 1)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b9d051c-e871-36fa-a1a1-9d4d2179d3c8",
                        "entry_id": "418fd86d-d04e-3250-83cb-a0da7c1d5f17",
                        "glosses": [
                            "Of, pertaining to, or based on six."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "48894a2b-d02e-45ad-b122-45b8de4f5355",
                                "sense_id": "7b9d051c-e871-36fa-a1a1-9d4d2179d3c8",
                                "text": "The senary fraction 0.2 is one-third, i.e. two-sixths."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6eacdde-2261-467e-b712-8b0e302b0e03",
                        "source_entry_id": "418fd86d-d04e-3250-83cb-a0da7c1d5f17",
                        "source_sense_description": "of sixth rank or order",
                        "target_lang_word": "sénaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sénaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c839bce3-709d-3337-be57-87ac376ffdc8",
                                        "entry_id": "3053bd7b-e5de-301b-a1e0-f37f2c87446a",
                                        "glosses": [
                                            "Qui comporte six parties, qui se divise par six."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76509c87-2207-4039-9f4b-49fb45449d92",
                                                "sense_id": "c839bce3-709d-3337-be57-87ac376ffdc8",
                                                "text": "Rythme sénaire."
                                            },
                                            {
                                                "example_id": "44e505e1-38f6-46dd-80b6-13b84f894ca1",
                                                "sense_id": "c839bce3-709d-3337-be57-87ac376ffdc8",
                                                "text": "Axe sénaire. Axe de symétrie autour duquel un cristal reprend six fois la même position dans l’espace au cours d’une rotation de 360°. Dans les plans normaux à l’axe sénaire, l’atome est entouré de 3 voisins immédiats, aux distances […] moindres que la distance des atomes voisins dans le diamant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sénaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "902c59d4-8616-3f83-acde-89b5f088b121",
                                        "entry_id": "715c889b-dde9-30ef-8b82-ceea3ced7ff6",
                                        "glosses": [
                                            "Vers latin de six pieds, correspondant au trimètre iambique grec, employé surtout dans la comédie et la tragédie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba8b741-1441-4e76-9b7a-18dcf1330ac3",
                                                "sense_id": "902c59d4-8616-3f83-acde-89b5f088b121",
                                                "text": "Le sénaire est dit trimètre quand les pieds composants sont traités comme constituant des groupes de deux (pair et impair) appelés mètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1f7a92-1488-3030-b815-e11005864f89",
                                        "entry_id": "715c889b-dde9-30ef-8b82-ceea3ced7ff6",
                                        "glosses": [
                                            "Vers français qui reçoit six accents et qui, par conséquent, est divisible en six mesures rythmiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d64adf4-1c57-42e9-857c-d3059133e4c7",
                                                "sense_id": "3a1f7a92-1488-3030-b815-e11005864f89",
                                                "text": "Le sénaire employé en français surtout comme vers final de strophe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbf37d4a-3e5e-4bd5-bb41-9c178e514ed2",
                        "source_entry_id": "418fd86d-d04e-3250-83cb-a0da7c1d5f17",
                        "source_sense_description": "of sixth rank or order",
                        "target_lang_word": "шестеричный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шестеричный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "60ee2f75-a6a8-3d13-9127-a27ac58888c5",
                                        "entry_id": "cc5dff50-d7bc-3b17-9dd7-b58350c9942b",
                                        "glosses": [
                                            "состоящий из шести однородных единиц, частей, предметов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c89375-04a1-4bc7-9faf-c7708a8fe32a",
                                                "sense_id": "60ee2f75-a6a8-3d13-9127-a27ac58888c5",
                                                "text": "В восточных Учениях эти три основных нача́ла расширяются для специальных целей, и мы уже́ встречаемся с четверичным, пятеричным, шестеричным и семеричным подразделением; последнее подразделение было принято Махатмами в «Тайной Доктрине»."
                                            },
                                            {
                                                "example_id": "f491b696-1a64-403e-b7f8-4c1e23dd1579",
                                                "sense_id": "60ee2f75-a6a8-3d13-9127-a27ac58888c5",
                                                "text": "Но если случится память святого, имеющего службу шестеричную или полиелейную, то стихиры поются так: воскресные три, праздника три и святого Минеи на четыре."
                                            },
                                            {
                                                "example_id": "b08ab26f-d5c1-4477-a60f-71ef6e9a427a",
                                                "sense_id": "60ee2f75-a6a8-3d13-9127-a27ac58888c5",
                                                "text": "Однако с шестеричной системой счисления Древняя Русь познакомилась в XI–XIII веках в северном Причерноморье через так называемый византийский счёт, в котором число «шесть» почему-то являлось ключевым."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
