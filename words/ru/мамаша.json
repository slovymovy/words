    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe90ad22-a7b5-30bf-8e31-b702b2a9ccfa",
                    "sense_definition": "Разговорное обозначение матери.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mother",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Получил письмо ваше, дорогая <w>мамаша</w>, из Красноярска.",
                            "target_lang_translations": {
                                "en": "I received your letter, dear <w>mom</w>, from Krasnoyarsk."
                            }
                        },
                        {
                            "text": "Ежели <w>мамаша</w> даёт мало денег — добывайте сами!",
                            "target_lang_translations": {
                                "en": "If <w>mom</w> doesn't give you enough money, go earn it yourself!"
                            }
                        }
                    ],
                    "synonyms": [
                        "мама",
                        "маманя"
                    ],
                    "common_phrases": [
                        "дорогая мамаша"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A colloquial term for mother."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mom",
                                "target_lang_sense_clarification": "Informal, affectionate term for mother."
                            },
                            {
                                "target_lang_word": "ma",
                                "target_lang_sense_clarification": "Informal, sometimes dialectal or old-fashioned term for mother."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5f8f940-bef8-39f8-ad85-1d50d51bae90",
                    "sense_definition": "Просторечное или фамильярное обращение к пожилой женщине.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нищий, так же глядя в пол, сказал: — Я не пью, <w>мамаша</w>.",
                            "target_lang_translations": {
                                "en": "The beggar, still looking at the floor, said: 'I don't drink, <w>ma'am</w>.'"
                            }
                        },
                        {
                            "text": "Никакая я тебе не <w>мамаша</w>, — обрезала невестку Виталия Гордеевна.",
                            "target_lang_translations": {
                                "en": "'I am not your <w>mother</w>,' Vitalia Gordeevna snapped at her daughter-in-law."
                            }
                        }
                    ],
                    "synonyms": [
                        "бабуся"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное, фамильярное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A colloquial or familiar way of addressing an older woman."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ma'am",
                                "target_lang_sense_clarification": "A respectful, though sometimes distant, way to address an older woman."
                            },
                            {
                                "target_lang_word": "mother",
                                "target_lang_sense_clarification": "Used in some dialects or contexts to address an older woman, though it can sound condescending or overly familiar."
                            }
                        ]
                    }
                }
            ]
        }
    ]
