                "senses": [
                    {
                        "sense_id": "bb8c56ca-a988-3c27-8d16-85b3c2cf8895",
                        "entry_id": "efb20653-8748-3a42-afcc-9adb31694df8",
                        "glosses": [
                            "Zustand des Nichtbeachtens des äußeren Geschehens und der daraus folgenden inneren Ruhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be4ce5e3-1f62-4a2a-a4a5-6ae806ec96d6",
                                "sense_id": "bb8c56ca-a988-3c27-8d16-85b3c2cf8895",
                                "text": "„Das berühmte Wurstigkeitsgefühl macht sich bemerkbar: Die Mäuse zeigen keine Präferenz mehr für das Zuckerwasser.“"
                            },
                            {
                                "example_id": "202db2c2-4808-49a2-a031-9b48eac45cbe",
                                "sense_id": "bb8c56ca-a988-3c27-8d16-85b3c2cf8895",
                                "text": "„Als ‚Optimist mit einem gesunden Wurstigkeitsgefühl‘, wie er sich selber beschreibt, war ihm das anscheinend problemlos möglich.“"
                            },
                            {
                                "example_id": "9ffd8bce-e6ff-4004-ae91-d922c2cff96b",
                                "sense_id": "bb8c56ca-a988-3c27-8d16-85b3c2cf8895",
                                "text": "„Er döste dann in dem großen Fauteuil dahin, das Wurstigkeitsgefühl verstärkte sich, allmählich verflogen Simons Theaterträume, niemand nahm Notiz von ihm.“"
                            },
                            {
                                "example_id": "d5408615-71ee-4d6f-8639-d95a9e06b05e",
                                "sense_id": "bb8c56ca-a988-3c27-8d16-85b3c2cf8895",
                                "text": "„Das Wurstigkeitsgefühl wird wohl erst noch kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
