                ],
                "senses": [
                    {
                        "sense_id": "873fcd6b-14e2-336d-bb74-bbfd1a5236a2",
                        "entry_id": "401fc528-665a-3cb5-9e8c-38dd7b04dc70",
                        "glosses": [
                            "Gasthof in einem Dorf oder auf dem Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e58ddb9-e8e8-4270-8d83-52bdfd109653",
                                "sense_id": "873fcd6b-14e2-336d-bb74-bbfd1a5236a2",
                                "text": "Gestern haben wir in einem Landgasthof auf der Schwäbischen Alb zu Mittag gegessen."
                            },
                            {
                                "example_id": "11c0b067-9feb-4455-93da-2eb354b52a4d",
                                "sense_id": "873fcd6b-14e2-336d-bb74-bbfd1a5236a2",
                                "text": "Ich liebe Landgasthöfe mit Metzgerei."
                            },
                            {
                                "example_id": "b6aa54f4-7633-4333-a4b0-6496a93e0916",
                                "sense_id": "873fcd6b-14e2-336d-bb74-bbfd1a5236a2",
                                "text": "„Es war ein gediegener Landgasthof, der nichts mit seinem Namen zu tun hatte.“"
                            },
                            {
                                "example_id": "67034af6-e5f2-4684-a392-8e6c3e516635",
                                "sense_id": "873fcd6b-14e2-336d-bb74-bbfd1a5236a2",
                                "text": "„Da gab's dann bald mehr Diskos als Kühe in den Dörfern, in den Landgasthöfen sprudelten die Whirlpools, und die Sennerinnen wurden mit dem Paragleiter auf die Alm geflogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
