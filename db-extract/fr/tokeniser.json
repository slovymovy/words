                ],
                "senses": [
                    {
                        "sense_id": "69ceff48-5a19-3b54-a9e1-ab4b91eeb5a2",
                        "entry_id": "d5c60081-e18d-334a-b73b-1e319b09d1e1",
                        "glosses": [
                            "Découper automatiquement un texte en unités lexicales grâce à une analyse lexicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96eb0c44-80a6-4d1e-af66-d453afb8252b",
                                "sense_id": "69ceff48-5a19-3b54-a9e1-ab4b91eeb5a2",
                                "text": "Dans une première phase d’observation, nous avons donc comparé les données du fichier Input sur un même texte qui est tokenisé de deux manières."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9d0b699-b7e4-3a3c-98b8-d648c25ffebc",
                        "entry_id": "d5c60081-e18d-334a-b73b-1e319b09d1e1",
                        "glosses": [
                            "Associer un jeton NFT dans une blockchain à un bien réel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40983c18-6dd7-441b-b623-e367e6c5f68d",
                                "sense_id": "a9d0b699-b7e4-3a3c-98b8-d648c25ffebc",
                                "text": "La perspective de « tokeniser des biens », c’est-à-dire de les mettre sur la blockchain, émerge, notamment dans le monde de l’immobilier."
                            },
                            {
                                "example_id": "61efb618-ab2c-4c26-b361-3b1f50c3d381",
                                "sense_id": "a9d0b699-b7e4-3a3c-98b8-d648c25ffebc",
                                "text": "Lorsqu’un émetteur de jetons souhaite tokeniser un actif financier, celui-ci devra connaître la qualification juridique du token émis."
                            },
                            {
                                "example_id": "642a15e5-a775-4a88-ac86-bf924cd07b82",
                                "sense_id": "a9d0b699-b7e4-3a3c-98b8-d648c25ffebc",
                                "text": "Tokeniser un actif immobilier suppose d’associer un jeton numérique inscrit sur une blockchain à un bien immobilier."
                            }
                        ]
                    },
                    {
                        "sense_id": "e84ded2f-6cbd-3f5c-a14f-c34ef107084a",
                        "entry_id": "d5c60081-e18d-334a-b73b-1e319b09d1e1",
                        "glosses": [
                            "En IA générative, remplacer une séquence de motifs par une séquence de tokens."
                        ],
