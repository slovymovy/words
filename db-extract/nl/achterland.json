                "senses": [
                    {
                        "sense_id": "36422a7b-fefa-330c-b30f-238946049a81",
                        "entry_id": "e228e147-3669-3a7e-a71f-b110b0e49117",
                        "glosses": [
                            "hinter einem zentralen Ort gelegenes Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91775caf-2eb8-4320-8cf7-00022a373e4c",
                                "sense_id": "36422a7b-fefa-330c-b30f-238946049a81",
                                "text": "Het achterland van de grote zeehavens toont een ander beeld.",
                                "translation": "Das Hinterland der großen Seehäfen zeigt ein anderes Bild."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a324da55-9390-4b6e-b0c8-e95f2fd796bc",
                        "source_entry_id": "e228e147-3669-3a7e-a71f-b110b0e49117",
                        "source_sense_id": "36422a7b-fefa-330c-b30f-238946049a81",
                        "source_sense_description": "hinter einem zentralen Ort gelegenes Gebiet",
                        "target_lang_word": "Hinterland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinterland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbffce4-6938-323d-8a86-b50d007e061f",
                                        "entry_id": "fb168d44-ea21-3d18-8944-d91de339f5b9",
                                        "glosses": [
                                            "das hinter der Front liegende Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "822b7fda-d188-4ee5-9221-e72b0eff0d1c",
                                                "sense_id": "cbbffce4-6938-323d-8a86-b50d007e061f",
                                                "text": "„Auch der nächste große Angriff kommt aus dem schwarzen Nichts heraus. Urplötzlich zuckt es aus allen Rohren. […] Diesmal hält der Damm nicht stand. Diesmal bricht die Flut eine Bresche und ergießt sich weit ins Hinterland.“"
                                            },
                                            {
                                                "example_id": "5295e580-a354-4e2f-9586-2e1e88890ff1",
                                                "sense_id": "cbbffce4-6938-323d-8a86-b50d007e061f",
                                                "text": "„Sie lehnte es rundweg ab, sich ins Hinterland bringen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50915c2b-0485-3de1-a6b1-214a1bd7b614",
                                        "entry_id": "fb168d44-ea21-3d18-8944-d91de339f5b9",
                                        "glosses": [
                                            "um ein wirtschaftliches, politisches, kulturelles Zentrum gelegenes Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64c8a666-39e9-47f2-9942-488329248a80",
                                                "sense_id": "50915c2b-0485-3de1-a6b1-214a1bd7b614",
                                                "text": "„Sie [die Orte] sind ein Teil jener öden, lombardischen Weite, welche die Mailänder »Hinterland« nennen. Das Hinterland versorgt die Stadt mit Arbeitern, mit Waren, mit Konsumenten.“"
                                            },
                                            {
                                                "example_id": "b00f315d-1c11-47a0-a044-04d1eb5d689a",
                                                "sense_id": "50915c2b-0485-3de1-a6b1-214a1bd7b614",
                                                "text": "„Die Verstorbenen endeten in jenen gewaltigen Hochmooren, die sich vor 2000 Jahren im germanischen Hinterland an der Nordseeküste erstreckten.“"
                                            },
                                            {
                                                "example_id": "e941af08-b53b-4067-9cbb-37085ed54fab",
                                                "sense_id": "50915c2b-0485-3de1-a6b1-214a1bd7b614",
                                                "text": "„Der Theologe Bernhard Schwarz ist der Forschungsreisende, der 1885 von der Küste aus die erste Forschungsreise in das Hinterland von Kamerun unternommen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9866b4c7-a469-40ee-b0c9-79c37d19db13",
                        "source_entry_id": "e228e147-3669-3a7e-a71f-b110b0e49117",
                        "source_sense_id": "36422a7b-fefa-330c-b30f-238946049a81",
