                        "glosses": [
                            "Variante de djihad."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bc27f553-7673-4afe-90d6-f3ab916276c1",
                                "sense_id": "0979b29e-cf7f-325c-8a41-fcac69d77e1c",
                                "text": "Le véritable et profond caractère du Djehad fut, à son origine, d’être une guerre de propagande et d’envahissement."
                            },
                            {
                                "example_id": "c04122e0-2cd5-4e1b-a3e6-8cbe3fb3a420",
                                "sense_id": "0979b29e-cf7f-325c-8a41-fcac69d77e1c",
                                "text": "Le khalife almohade fit prêcher le djehad en Espagne et en Afrique, tandis que le grand pape Innocent III, fidèle aux traditions du saint-siége ^([sic]), pacifiait les princes chrétiens et annonçait de son côté la croisade […]"
                            },
                            {
                                "example_id": "5f8eb234-65bf-4cbb-a940-d90354d1682b",
                                "sense_id": "0979b29e-cf7f-325c-8a41-fcac69d77e1c",
                                "text": "La vaste péninsule des Indes fut d’un bout à l’autre livrée à l’insurrection et à la guerre civile, et, du désert de Gobi au Maroc, se levèrent les étendards de la Guerre Sainte, du Djehad."
                            },
                            {
                                "example_id": "95eeb373-c122-4eaf-adcc-b5d1ae3b1edf",
                                "sense_id": "0979b29e-cf7f-325c-8a41-fcac69d77e1c",
                                "text": "Une guerre au service d’une grande idée est la seule susceptible d’être comprise par un Berbère, c’est la guerre sainte, celle qui, sous le nom de djehad, permit aux Arabes d’enrôler les indigènes nord-africains sous les bannières de l’Islam […]"
                            }
                        ]
                    }
