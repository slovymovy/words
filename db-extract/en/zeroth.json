                                        "glosses": [
                                            "Zérotième."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c921324-3512-4110-b9fe-cfe13e2ad433",
                                                "sense_id": "42376025-f3f2-3f20-a663-e8e2db8dd98f",
                                                "text": "Logiquement , si Newcomb créait un « nullième jour », il aurait dû créer aussi un « nullième mois », ce qui eût reculé l'origine jusqu'au 30 novembre 1899."
                                            }
                                        ]
