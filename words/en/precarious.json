                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bdf6813-4d72-3170-b12c-149ed6ee2353",
                    "sense_definition": "Depending on the will, decision, or intention of another person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dependent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tenant's stay in the apartment was <w>precarious</w>, relying entirely on the landlord's daily goodwill.",
                            "target_lang_translations": {
                                "ru": "Пребывание жильца в квартире было <w>ненадёжным</w> и полностью зависело от ежедневной доброй воли арендодателя.",
                                "tr": "Kiracının dairedeki konaklaması tamamen ev sahibinin günlük iyi niyetine dayalı, <w>güvencesiz</w> bir durumdaydı."
                            }
                        },
                        {
                            "text": "He held a <w>precarious</w> tenure at the firm, subject to the sudden whims of the board.",
                            "target_lang_translations": {
                                "ru": "Его пребывание в должности в фирме было крайне <w>шатком</w> и зависело от внезапных прихотей совета директоров.",
                                "tr": "Yönetim kurulunun ani isteklerine bağlı olarak şirkette <w>eğreti</w> bir görev sürdürüyordu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависящий от воли, решения или намерений другого человека.",
                        "tr": "Başka birinin iradesine, kararına veya niyetine bağlı olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависимый",
                                "target_lang_sense_clarification": "полностью зависящий от чужой воли"
                            },
                            {
                                "target_lang_word": "ненадёжный",
                                "target_lang_sense_clarification": "не гарантированный, зависящий от обстоятельств"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bağımlı",
                                "target_lang_sense_clarification": "başkalarının kararlarına bağlı olan"
                            },
                            {
                                "target_lang_word": "güvencesiz",
                                "target_lang_sense_clarification": "garantisi olmayan konum veya şartlar için"
                            }
                        ]
