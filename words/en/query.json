{
    "word_family": [
        "querist",
        "queryable",
        "querying"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8392dd85-d0f5-38ea-8d09-f58e9fce1494",
                    "sense_definition": "A question or an inquiry, often expressing doubt or requesting information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "questioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher answered the student’s <w>query</w> concerning the complex process of photosynthesis.",
                            "target_lang_translations": {
                                "ru": "Учитель ответил на <w>вопрос</w> ученика, касающийся сложного процесса фотосинтеза."
                            }
                        },
                        {
                            "text": "If you have a customer <w>query</w> about your order, please contact our support team.",
                            "target_lang_translations": {
                                "ru": "Если у вас есть клиентский <w>запрос</w> по поводу вашего заказа, пожалуйста, свяжитесь с нашей службой поддержки."
                            }
                        }
                    ],
                    "synonyms": [
                        "question",
                        "inquiry",
                        "enquiry"
                    ],
                    "antonyms": [
                        "answer",
                        "reply",
                        "response"
                    ],
                    "common_phrases": [
                        "customer query",
                        "raise a query",
                        "respond to a query"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопрос или запрос, часто выражающий сомнение или запрашивающий информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрос",
                                "target_lang_sense_clarification": "официальная просьба или требование сведений"
                            },
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "обращение для получения информации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e2c485a-da05-3d79-9532-5d25399121b7",
                    "sense_definition": "A specific set of instructions or a request for information passed to a database.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The database administrator switched on <w>query</w> logging for debugging purposes.",
                            "target_lang_translations": {
                                "ru": "Администратор базы данных включил логирование <w>запросов</w> в целях отладки."
                            }
                        },
                        {
                            "text": "It took several seconds for the database <w>query</w> to return the requested results.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько секунд, чтобы <w>запрос</w> к базе данных вернул запрашиваемые результаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "request",
                        "search"
                    ],
                    "common_phrases": [
                        "database query",
                        "search query",
                        "run a query"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический набор инструкций или запрос информации, передаваемый базе данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрос",
                                "target_lang_sense_clarification": "техническая команда для извлечения данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3378a188-baf3-34c1-b521-3e1e881d5c2c",
                    "sense_definition": "A symbol used in writing to indicate a question; a question mark.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punctuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had written in her diary with the <w>queries</w> growing larger until they covered the page.",
                            "target_lang_translations": {
                                "ru": "Она писала в своем дневнике, и <w>вопросительные знаки</w> становились всё больше, пока не заполнили всю страницу."
                            }
                        },
                        {
                            "text": "The editor placed a <w>query</w> in the margin where the sentence was unclear.",
                            "target_lang_translations": {
                                "ru": "Редактор поставил <w>вопрос</w> на полях там, где предложение было неясным."
                            }
                        }
                    ],
                    "synonyms": [
                        "question mark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ, используемый на письме для обозначения вопроса; вопросительный знак."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопросительный знак",
                                "target_lang_sense_clarification": "знак препинания"
                            },
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "разговорное обозначение знака вопроса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc820b8d-558f-34a0-95ff-9152dda3a36a",
                    "sense_definition": "A formal letter sent by an author to an agent or publisher to pitch a book idea.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although many agents accept email <w>queries</w>, check to see if they prefer mailed letters.",
                            "target_lang_translations": {
                                "ru": "Хотя многие агенты принимают <w>запросы</w> по электронной почте, проверьте, не предпочитают ли они обычные письма."
                            }
                        },
                        {
                            "text": "She spent weeks perfecting her <w>query</w> before sending it to the literary agent.",
                            "target_lang_translations": {
                                "ru": "Она потратила недели на доработку своей <w>заявки</w>, прежде чем отправить её литературному агенту."
                            }
                        }
                    ],
                    "synonyms": [
                        "query letter"
                    ],
                    "common_phrases": [
                        "email query"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное письмо автора агенту или издателю с предложением идеи книги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрос",
                                "target_lang_sense_clarification": "предложение рукописи издателю"
                            },
                            {
                                "target_lang_word": "заявка",
                                "target_lang_sense_clarification": "предварительное письмо литературному агенту"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c952d4ab-3013-3201-9e5b-eb1c7f65498e",
                    "sense_definition": "To express doubt about something or to challenge its validity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "questioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer <w>queried</w> the witness's account of the accident because it seemed inconsistent.",
                            "target_lang_translations": {
                                "ru": "Полицейский <w>подверг сомнению</w> показания свидетеля об аварии, так как они казались противоречивыми."
                            }
                        },
                        {
                            "text": "Many people <w>query</w> the decision to build a new highway through the forest.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>оспаривают</w> решение о строительстве нового шоссе через лес."
                            }
                        }
                    ],
                    "synonyms": [
                        "question",
                        "dispute",
                        "challenge",
                        "doubt"
                    ],
                    "antonyms": [
                        "accept",
                        "believe",
                        "confirm"
                    ],
                    "common_phrases": [
                        "query the decision",
                        "query the validity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать сомнение в чем-либо или оспаривать обоснованность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвергать сомнению",
                                "target_lang_sense_clarification": "оспаривать правильность или истинность"
                            },
                            {
                                "target_lang_word": "оспаривать",
                                "target_lang_sense_clarification": "выражать несогласие с решением или фактом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d27b1601-1997-3495-8346-f8744537dd4d",
                    "sense_definition": "To ask a question or make an inquiry about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "questioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>queried</w> the waiter about the ingredients in the soup due to my allergies.",
                            "target_lang_translations": {
                                "ru": "Я <w>расспросил</w> официанта об ингредиентах в супе из-за моей аллергии."
                            }
                        },
                        {
                            "text": "The journalist <w>queried</w> the spokesperson regarding the company's new environmental policy.",
                            "target_lang_translations": {
                                "ru": "Журналист <w>осведомился</w> у представителя компании о новой экологической политике фирмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "ask",
                        "inquire",
                        "enquire"
                    ],
                    "antonyms": [
                        "answer",
                        "respond"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задавать вопрос или наводить справки о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрашивать",
                                "target_lang_sense_clarification": "обращаться с вопросом"
                            },
                            {
                                "target_lang_word": "осведомляться",
                                "target_lang_sense_clarification": "узнавать информацию, наводить справки"
                            },
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "запрашивать сведения о чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "716d3a56-dfe9-3b4d-8972-6b4247d4c0c6",
                    "sense_definition": "To use a set of instructions to retrieve specific data from a database.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linked tables can be <w>queried</w> and combined much more flexibly than flat files.",
                            "target_lang_translations": {
                                "ru": "Связанные таблицы можно <w>запрашивать</w> и объединять гораздо более гибко, чем плоские файлы."
                            }
                        },
                        {
                            "text": "The software allows users to <w>query</w> a database without knowing complex programming languages.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет пользователям <w>делать запросы</w> к базе данных без знания сложных языков программирования."
                            }
                        }
                    ],
                    "common_phrases": [
                        "query a database"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать набор инструкций для извлечения определенных данных из базы данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрашивать",
                                "target_lang_sense_clarification": "выполнять поиск в базе данных"
                            },
                            {
                                "target_lang_word": "делать запрос",
                                "target_lang_sense_clarification": "обращаться к программному интерфейсу за данными"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2d397d2-690f-3acc-8548-b92708a820e9",
                    "sense_definition": "To send a private message to another user, particularly on IRC (Internet Relay Chat).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you know someone who is in the channel, you can <w>query</w> them and ask for the key.",
                            "target_lang_translations": {
                                "ru": "Если вы знаете кого-то, кто находится на канале, вы можете <w>написать ему в личку</w> и попросить ключ."
                            }
                        },
                        {
                            "text": "He parted the channel, so I <w>queried</w> him privately to see if he was okay.",
                            "target_lang_translations": {
                                "ru": "Он покинул канал, поэтому я <w>написал ему приватно</w>, чтобы узнать, всё ли у него в порядке."
                            }
                        }
                    ],
                    "synonyms": [
                        "message",
                        "PM"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Internet/IRC"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить личное сообщение другому пользователю, особенно в IRC."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писать в личку",
                                "target_lang_sense_clarification": "отправлять приватное сообщение"
                            },
                            {
                                "target_lang_word": "открывать приват",
                                "target_lang_sense_clarification": "начинать личный диалог в чате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee4318b5-1cdc-340e-acfd-52424cc112f9",
                    "sense_definition": "To send out a pitch or a formal letter to an agent or publisher.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aspiring novelist began to <w>query</w> agents after finishing her third draft.",
                            "target_lang_translations": {
                                "ru": "Начинающая писательница начала <w>рассылать запросы</w> агентам после завершения третьего черновика."
                            }
                        },
                        {
                            "text": "It is common practice to <w>query</w> multiple publishers at the same time.",
                            "target_lang_translations": {
                                "ru": "Обычная практика — <w>подавать заявки</w> нескольким издателям одновременно."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассылать предложения или официальные письма агентам или издателям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассылать запросы",
                                "target_lang_sense_clarification": "предлагать свою работу издательствам"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0599f079-731d-3e1c-8c04-68c43c15bb6a",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named Arthur <w>Query</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Артур <w>Квери</w>."
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Query</w> family for dinner this evening.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы встречаемся за ужином с семьей <w>Квери</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Квери",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}