                ],
                "senses": [
                    {
                        "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                        "entry_id": "f519ee8a-5cc7-35ca-9d86-cc5779dd110c",
                        "glosses": [
                            "Art und Weise, wie ein Bauer seine Felder bestellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "505118a1-4b84-44dc-8225-91adaab7ae2d",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "[Vertikale Landwirtschaft:] „Die Vorteile der neuen Anbaumethode liegen auf der Hand: Es wird wenig Fläche benötigt.“"
                            },
                            {
                                "example_id": "ecfba66d-091a-41a5-9056-235842d978e3",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "„Die Landwirtschaft stößt weltweit viele Treibhausgase aus. Doch bessere Anbaumethoden können den CO₂-Ausstoß vermindern,“ […]."
                            },
                            {
                                "example_id": "46bc35ea-6b26-4eb8-af42-53211ab2e013",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "[…] „industrielle Anbaumethoden laugen die Böden aus und verhinden die Neubildung von Humus.“"
                            },
                            {
                                "example_id": "7f9c2927-f1d3-41c3-809c-1dffaf042d33",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "[Schlagzeile:] „SVP-Bauer bekämpft Klimaerwärmung mit neuer Anbaumethode“"
                            },
                            {
                                "example_id": "daa8305c-507b-46d6-93c3-490d4bdd9be3",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "„Durch diese Anbaumethode lassen sich Hitzeperioden leichter überstehen.“"
                            },
                            {
                                "example_id": "e13f8c89-168e-4c9c-a11b-e05909d080e5",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "[Klimawandel:] „In der Landwirtschaft muss in Zukunft mehr Geld für Bewässerung, neue Anbaumethoden und die Suche nach widerstandsfähigeren Nutzpflanzensorten ausgegeben werden.“"
                            },
                            {
                                "example_id": "2969e1ec-9b7f-462b-8f8e-8d146bd641c5",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "[Direktsaat:] „Mögliche Ernteeinbußen in der Übergangsphase und Investitionen in spezielle Maschinen und Biodünger schrecken viele Bauern aber immer noch von dieser Anbaumethode ab.“"
                            },
                            {
                                "example_id": "52f54ac6-5119-408c-bac1-a188803b8ae7",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "[Trockenfeldbau:] „Ziel der Anbaumethode ist die Speicherung des Niederschlagswassers über zwei oder mehr Jahre (sog. Trockenbrache), da es relativ wenig und selten/unregelmäßig regnet, aber trotzdem Wasser für das ganze Jahr gebraucht wird.“"
                            },
                            {
                                "example_id": "61b38f2c-0337-4117-8656-68faea986782",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "„Das Ecofarming ist eine Anbaumethode, welche das Ziel verfolgt, mit möglichst wenig Fremdmitteleinsatz einen möglichst hohen Ernteertrag zu erreichen.“"
                            },
                            {
                                "example_id": "82a44271-da39-4800-b529-33d1a1a11258",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "[Regenfeldbau:] „Diese Anbaumethode wurde bereits von den Römern praktiziert und im gesamten Mittelmeerraum verbreitet.“"
                            },
                            {
                                "example_id": "5ae1acaa-700c-4fe8-b802-4a1e2445c8aa",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "„Für grünen Tee gibt es in Japan verschiedene Anbaumethoden.“"
                            },
                            {
                                "example_id": "e5f0fe76-5800-41da-9c18-94b14bf254de",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "„Eine insbesondere von der indigenen Bevölkerung Mexikos und der USA genutzte Anbaumethode, bei der die drei Feldfrüchte Kürbis, Mais und Bohnen zusammen angebaut werden, wird als Drei Schwestern bezeichnet.“"
                            },
                            {
                                "example_id": "3a8611c8-23f4-47b1-99f9-3d6027b7f52f",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "[China, 906:] „Im Süden etablieren sich zehn Kleinstaaten, in denen durch Ausweitung des Kulturlandes und neuer Anbaumethoden ein Wirtschaftsaufschwung einsetzt.“"
                            },
                            {
                                "example_id": "3d4f816b-e895-4a6d-be27-4ee4494ff0ee",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "„Vertikale Landwirtschaft benötigt deutlich weniger Wasser als konventionelle Anbaumethoden“"
                            },
                            {
                                "example_id": "afaa5967-55bd-4b1f-9b38-dbb93b7ee3d7",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "„In Marokko wollen Forscherinnen mit einer eigens entwickelten Anbaumethode Bestäuber retten. Dafür arbeiten sie mit Bauern zusammen. Sie sind es, die mit ihren Anbaumethoden einen wichtigen Beitrag zum Schutz der bedrohten Insekten leisten können.“"
                            },
                            {
                                "example_id": "2b954ff6-62af-4612-a97c-1d5983b08ea7",
                                "sense_id": "96070a20-e359-3844-a6f9-409f2cb9696e",
                                "text": "„In der Schweiz wurde nördlich der Alpen 2017 erstmals mit Nassreis experimentiert. Dieser wächst im Gegensatz zu Trockenreis in gefluteten Feldern und ist global gesehen die gängigste Anbaumethode.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
