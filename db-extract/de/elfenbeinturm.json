                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torre de marfim",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "9a6eb03a-8e62-3028-bf65-cad74d4ecd61",
                                        "entry_id": "b5919c7c-330b-3787-8892-e52f6e6d99d6",
                                        "glosses": [
                                            "designação das ações e ideias apartadas das coisas cotidianas e práticas, mormente aplicada ao meio acadêmico; afastamento da realidade com preocupação voltada somente ao plano intelectual"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd37d1c5-cbee-4259-b164-6e7f1468b09f",
                                                "sense_id": "9a6eb03a-8e62-3028-bf65-cad74d4ecd61",
                                                "text": "Esses três pequenos textos vão contra a imagem construída de Adorno como o filósofo da torre de marfim indiferente a toda conjuntura política e social."
                                            },
                                            {
                                                "example_id": "9a9a76da-d0e8-43ce-a772-2679704085b2",
                                                "sense_id": "9a6eb03a-8e62-3028-bf65-cad74d4ecd61",
                                                "text": "Esquerda está presa em torre de marfim, diz cientista político Yascha Mounk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59687c23-649c-3ee2-8db5-f9f4f9e0b1f4",
                                        "entry_id": "b5919c7c-330b-3787-8892-e52f6e6d99d6",
                                        "glosses": [
                                            "postura de distanciamento ou isolamento arrogante"
                                        ],
                                        "tags": [
                                            "Por extensão"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dea7911a-1542-42f5-a6d5-2c96460ba0a8",
                                                "sense_id": "59687c23-649c-3ee2-8db5-f9f4f9e0b1f4",
                                                "text": "A dignidade natural que havia em toda a sua pessoa servia-lhe, além disso, como de uma torre de marfim, onde ela se acastelava e mantinha em respeito o pretendente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd5595d1-edf6-3a39-9964-8a789afaac66",
                                        "entry_id": "b5919c7c-330b-3787-8892-e52f6e6d99d6",
                                        "glosses": [
                                            "lugar intocado e afastado das coisas mundanas, momentâneas e supérfluas"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f507a28f-d952-47f7-b95e-eb55f7ecd225",
                                                "sense_id": "cd5595d1-edf6-3a39-9964-8a789afaac66",
                                                "text": "Nascida entre graves cuidados de ordem pública, a Academia Brasileira de Letras tem de ser o que são as associações análogas: uma torre de marfim, onde se acolham espíritos literários, com a única preocupação literária, e de onde, estendendo os olhos para todos os lados, vejam claro e quieto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "179d1f8e-c22d-339b-94e9-5c2a8fa20fba",
                                        "entry_id": "b5919c7c-330b-3787-8892-e52f6e6d99d6",
                                        "glosses": [
                                            "um dos epítetos de Maria, mãe de Jesus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd2fc04-ead6-4505-ae6b-6e069ca2c64a",
                                                "sense_id": "179d1f8e-c22d-339b-94e9-5c2a8fa20fba",
                                                "text": "Vós, torre de marfim, santa Senhora / Alma que em pranto astral vos diluístes!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
