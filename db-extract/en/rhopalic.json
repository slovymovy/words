                                        "examples": [
                                            {
                                                "example_id": "2f3ad75a-eeea-4117-a718-6c05d77500ba",
                                                "sense_id": "365a22b5-f4a6-33a2-84ac-0a73431d418c",
                                                "text": "Vers rhopalique, vers grec ou latin, formé d’une suite de mots dont chacun a une syllabe de plus que le précédent : le premier est toujours un monosyllabe."
                                            },
                                            {
                                                "example_id": "168191eb-5163-486b-9a38-790870ca1039",
                                                "sense_id": "365a22b5-f4a6-33a2-84ac-0a73431d418c",
                                                "text": "Période rhopalique, celle où les incises des membres de la période deviennent de plus en plus longues, ou de plus en plus courtes, comme fait une massue."
                                            }
                                        ]
                                    }
                                ]
