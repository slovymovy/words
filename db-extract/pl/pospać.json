                "translations": [
                    {
                        "translation_id": "6ccf2f57-e7a5-4b06-a05b-9cd6fbadc09e",
                        "source_entry_id": "d6baf72d-8fda-3785-8ebf-8489fd8e4712",
                        "source_sense_id": "2c1af4bc-e715-3112-b989-1a2b639b8244",
                        "target_lang_word": "поспать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поспать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ee1b61d-00eb-3732-8f05-47e2d8100a5d",
                                        "entry_id": "f1a67227-c9af-32f4-bcbe-547068f8060d",
                                        "glosses": [
                                            "провести некоторое время, находясь в состоянии сна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0d25dc4-f676-4706-9b3f-487ad4c1a77b",
                                                "sense_id": "3ee1b61d-00eb-3732-8f05-47e2d8100a5d",
                                                "text": "Дали ему с час поспать, а Карп Лукич опять на козлы, а Недошивин за дугу…"
                                            },
                                            {
                                                "example_id": "3dec6fe2-7e79-4189-9c1d-e7f1da58df52",
                                                "sense_id": "3ee1b61d-00eb-3732-8f05-47e2d8100a5d",
                                                "text": "Вместо того чтобы использовать её для отдыха — поспать, почитать книжку, заключённые исступлённо обсуждали следующие темы: // а) Возможные смены и перестановки в высшей лагерной администрации. // б) Что завезут завтра в лагерный магазинчик, что удалось украсть из лагерного склада, что едят эсэсовцы. // в) Международное положение."
                                            },
                                            {
                                                "example_id": "c80af68a-e2fd-458c-b5d3-bcde2f99560a",
                                                "sense_id": "3ee1b61d-00eb-3732-8f05-47e2d8100a5d",
                                                "text": "Четыре часа поспишь и будешь к положенному времени как свеженький огурчик."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
