                "senses": [
                    {
                        "sense_id": "b31dc81d-ebb1-3a8a-b54e-c5062a51cab9",
                        "entry_id": "2bc60e70-5dfc-317e-95f3-29cf0d4e79a7",
                        "glosses": [
                            "Vertrag zwischen einem Menschen und dem Teufel, bei dem der Mensch sich meist Vergünstigungen im Leben erwirbt und dafür seine Seele dem Teufel verschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e3c069-352a-4bbb-8b76-55f41b2c2c24",
                                "sense_id": "b31dc81d-ebb1-3a8a-b54e-c5062a51cab9",
                                "text": "Faust schloss einen Teufelspakt, den er allerdings unfairerweise nicht erfüllen musste."
                            },
                            {
                                "example_id": "4d136b02-02ca-418d-bc19-76c9f30942ec",
                                "sense_id": "b31dc81d-ebb1-3a8a-b54e-c5062a51cab9",
                                "text": "„Wahrscheinlich würde der Mann, der seinen Teufelspakt mit der Feder unterschrieb, zu Tode erschrecken beim Anblick unserer Bild- und Textmaschinen, die so oft Elefanten kreißen und Mäuse gebären lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
