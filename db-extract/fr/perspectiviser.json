                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d0fc93-922b-4c11-b632-289de214d70a",
                                "sense_id": "427df9fc-6cdd-343d-bf34-d5b53b09a615",
                                "text": "Islamiste revivifie un interdiscours moins lointain, donc moins historicisé, plus difficile à perspectiviser, ce qui accentue encore la dimension agonale de l'apostrophe."
                            },
                            {
                                "example_id": "ef7ee654-0c74-4de7-88b6-bd876001e178",
                                "sense_id": "427df9fc-6cdd-343d-bf34-d5b53b09a615",
                                "text": "L’empereur préférerait perspectiviser l’existence selon la triple dimension temporelle du passé, du présent et de l’avenir."
                            }
                        ]
                    }
