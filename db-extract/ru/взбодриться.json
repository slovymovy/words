                "senses": [
                    {
                        "sense_id": "ccdb9e6a-6570-39a7-855b-d4e2a3dc8d4b",
                        "entry_id": "ff062e0c-5132-3fd0-9a61-878fb1d7b0bb",
                        "glosses": [
                            "разг. прийти в бодрое состояние, настроение; придать себе бодрости чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f620bc51-be61-4a45-bba8-ca7e5ee22fad",
                                "sense_id": "ccdb9e6a-6570-39a7-855b-d4e2a3dc8d4b",
                                "text": "Нынче генерал раным-рано поднялся: к девяти часам взбодрился уж, кофею налакался и в кабинете сидел."
                            },
                            {
                                "example_id": "bc740829-4035-4b5f-9679-2ebb3ec8599e",
                                "sense_id": "ccdb9e6a-6570-39a7-855b-d4e2a3dc8d4b",
                                "text": "Шибанул в горенку морозный воздух, гости враз взбодрились, жадно задышали полной грудью."
                            }
                        ]
                    }
