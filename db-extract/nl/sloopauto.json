                                "target_senses": [
                                    {
                                        "sense_id": "ca96a106-0b48-3802-a4bc-5d6e21894efa",
                                        "entry_id": "20ac1d81-6740-32d3-bd18-c3dc16289144",
                                        "glosses": [
