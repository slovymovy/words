                ],
                "senses": [
                    {
                        "sense_id": "7ef61457-b2b0-3210-a1d2-d91f0c5f14d2",
                        "entry_id": "c2660b36-a92b-3bf9-a6f2-cdbc9ac24fe5",
                        "glosses": [
                            "Asserter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d42c9a5-3dea-4957-8961-da772333db6e",
                                "sense_id": "7ef61457-b2b0-3210-a1d2-d91f0c5f14d2",
                                "text": "Car la reconnaissance d'une vérité générique bloque en principe la possibilité de la réasserter de manière contingente à propos d'un particulier."
                            },
                            {
                                "example_id": "3a710c5d-25ff-42f9-a708-9c7412cde3e7",
                                "sense_id": "7ef61457-b2b0-3210-a1d2-d91f0c5f14d2",
                                "text": "Mieux vaut, comme l'avait noté Wittgenstein, se débarrasser de la tentation d'attaquer le sens commun que de réasserter, comme le fait Moore, les vues du sens commun."
                            }
                        ]
                    }
