                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "516915e6-a324-4271-878b-b306388e8c7c",
                                                "sense_id": "a51a7d89-bd29-3229-858a-f7038aa7ccd5",
                                                "text": "The PM's visit to the school was entirely apolitical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5aef08f-a970-3236-809c-353c93ff3216",
                                        "entry_id": "2a2a90e7-2134-3993-8787-6eb6ab7e70b5",
                                        "glosses": [
                                            "Politically neutral, unbiased, non-aligned, free from party politics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4a0651-f33f-44e0-85be-2540b42aaa03",
                                                "sense_id": "e5aef08f-a970-3236-809c-353c93ff3216",
                                                "text": "My colleagues and I come to this task with open minds, we are apolitical and independent of any political party."
                                            },
                                            {
                                                "example_id": "a5c71672-a8be-4ea9-8e6b-42c67ec47dfa",
                                                "sense_id": "e5aef08f-a970-3236-809c-353c93ff3216",
                                                "text": "What, exactly, the criteria for this designation will be remains unclear but the ultimate aim, some analysts suspect, is to purge officers deemed insufficiently loyal to Mr. Trump – a litmus test, they warn, that’s incompatible with an apolitical military."
                                            },
                                            {
                                                "example_id": "36d46942-af9e-4334-a4d9-d442ce89b00a",
                                                "sense_id": "e5aef08f-a970-3236-809c-353c93ff3216",
                                                "text": "But like so much in the Trump administration, what was once considered apolitical is now labeled political."
                                            }
                                        ]
                                    }
                                ]
                            },
