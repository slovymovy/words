                    }
                ],
                "translations": [
                    {
                        "translation_id": "6683b471-b4af-41b9-8050-17c67478d600",
                        "source_entry_id": "2ac81148-c30d-3d60-8472-1f3c8e335e07",
                        "source_sense_id": "40e406bf-0a9b-342b-893c-8eef199a5197",
                        "target_lang_word": "financier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "financier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c52cf739-5190-3d23-8bf5-d8af0584e317",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "A person who, as a profession, profits from large financial transactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fbc9331-61a5-4d24-979a-186a012eed76",
                                                "sense_id": "c52cf739-5190-3d23-8bf5-d8af0584e317",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d5245e1-7892-3a47-adcc-b1f41d6fd063",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "A company that does the same."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f05c0ac0-33e2-36b9-b016-e430aa5a25c8",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "One charged with the administration of finance; an officer who administers the public revenue; a treasurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53dc5e1b-f538-45ce-a621-df0ed4efbfaa",
                                                "sense_id": "f05c0ac0-33e2-36b9-b016-e430aa5a25c8",
                                                "text": "The English financier was obliged to raise new taxes to pay the interest of this immense sum ; the financier of France did no such thing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23ea586b-df73-3404-9e77-50598f50bf14",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "A light, spongy teacake, usually based on almond flour or flavoring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2420e008-a143-4698-89eb-1f34639cba25",
                                                "sense_id": "23ea586b-df73-3404-9e77-50598f50bf14",
                                                "text": "‘Excuse me, can we order some fresh financiers? I know we haven’t finished our mains yet but we’re in rather a hurry.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768c8767-7a33-39c4-9dc4-1e8200e366be",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "A traditional French (Ragoût à la Financière) or Piemontese (Finanziera alla piemontese) rich sauce or ragout, made with coxcomb, wattles, cock's testicles, chicken livers and a variety of other ingredients."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "financier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a5cd56-d0fd-3166-9981-db3407a1de02",
                                        "entry_id": "3d7d57d1-4c6b-3a71-84c5-3d0bc1c6426e",
                                        "glosses": [
                                            "To carry out financial transactions; to finance something."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "678c4ce2-033e-4ff8-9c90-448adb130cf1",
                                                "sense_id": "d1a5cd56-d0fd-3166-9981-db3407a1de02",
                                                "text": "So time crept on, and the day arrived when Sturk must pay his rent, or take the ugly consequences. The day before he spent in Dublin financiering. It was galling and barren work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac9a3e0b-425d-4b9f-b743-2f2c36c49eae",
                        "source_entry_id": "2ac81148-c30d-3d60-8472-1f3c8e335e07",
                        "source_sense_id": "40e406bf-0a9b-342b-893c-8eef199a5197",
                        "target_lang_word": "финанси́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "финанси́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ec535597-7d5c-3793-ad4a-10fecbeaff0a",
                                        "entry_id": "858ff16c-6e9a-3498-98be-7290e0c24b09",
                                        "glosses": [
                                            "фин. специалист по ведению финансовых операций, а также учёный — специалист в области финансовых наук"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c22bfb0-2b76-402e-8fa3-35ddfc01d4a3",
                                                "sense_id": "ec535597-7d5c-3793-ad4a-10fecbeaff0a",
                                                "text": "Вот завтра же рапортую по команде: так, мол, и так, обязанность русского патриота обнаруживать на пользу государства гениев; так, мол, и так, открыл я удивительного финансиста…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6725af2-b474-3a46-b3f5-89283f51095d",
                                        "entry_id": "858ff16c-6e9a-3498-98be-7290e0c24b09",
                                        "glosses": [
                                            "экон. предприниматель, ведущий крупные денежные операции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "073009f5-def5-495a-9e86-2abb6a67ab15",
                                                "sense_id": "d6725af2-b474-3a46-b3f5-89283f51095d",
                                                "text": "Автором и главным миссионером теории ПЭ является Жак Аттали, известный французский интеллектуал, финансист и общественный деятель, основатель Европейского банка реконструкции и развития."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
