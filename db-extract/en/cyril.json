                                                "example_id": "c6e87f5a-c5df-4fa1-a60f-5ff5a6851b88",
                                                "sense_id": "945f4c01-162a-368c-b1f0-5ebef30c1e18",
                                                "text": "14 lutego, 18 marca i 27 czerwca przypadają imieniny Cyryla."
                                            },
