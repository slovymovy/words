                                "example_id": "0b4699a6-4525-4c18-9bce-562fffb1fbba",
                                "sense_id": "43a5b63f-defc-3b27-935b-59ef8ac35f3a",
                                "text": "„Sophie sprach ohne die geringste Hemmung von ihrem einzigen Liebeserlebnis, ohne jedoch zu erwähnen, daß es unfreiwillig gewesen war.“"
                            },
                            {
                                "example_id": "2e5be6ad-74d8-4af2-92c4-504c454d3bc6",
                                "sense_id": "43a5b63f-defc-3b27-935b-59ef8ac35f3a",
                                "text": "„Doch das Liebeserlebnis lag genau in jener Zeit, in der aus Alfred Henschke Klabund wurde.“"
                            }
                        ],
