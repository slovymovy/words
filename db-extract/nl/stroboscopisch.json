                ],
                "senses": [
                    {
                        "sense_id": "ba4fe84f-5c1e-387f-8698-f7fff9bb20ac",
                        "entry_id": "b3a65499-ae94-3d94-a57f-bc5fa07fae1d",
                        "glosses": [
                            "flitsend met een hoge frequentie"
                        ],
                        "tags": [
                            "van licht"
                        ],
                        "examples": [
                            {
                                "example_id": "5146ccd7-0b0e-44c9-b08d-90726c079f5e",
                                "sense_id": "ba4fe84f-5c1e-387f-8698-f7fff9bb20ac",
                                "text": "En zo zit de productie vol verwijzingen: beschermengelen, doodsfaunen, veren als zinnelijkheidssymbolen, gifbekers die, stroboscopisch oplichtend, aan de dood herinneren."
                            },
                            {
                                "example_id": "f39bea2c-4ce9-4988-ad54-d2142d70387a",
                                "sense_id": "ba4fe84f-5c1e-387f-8698-f7fff9bb20ac",
                                "text": "In die twintig jaar zagen we de voetbalwereld veranderen. Natuurlijk, er kwam wifi in het stadion en overal zie je negentig minuten lang schermpjes oplichten. (…) Er kwam een stroboscopische lichtshow voor de wedstrijd, en dit seizoen ook na ieder doelpunt."
                            }
                        ]
                    },
                    {
                        "sense_id": "e92a62db-5026-389b-8b0f-a4b3fa9248e3",
                        "entry_id": "b3a65499-ae94-3d94-a57f-bc5fa07fae1d",
                        "glosses": [
                            "partitief van de stellende trap van stroboscopisch"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "efb3dc1b-515c-4e27-aef8-d841301aed15",
                                "sense_id": "e92a62db-5026-389b-8b0f-a4b3fa9248e3",
                                "text": "Het licht dat door de bomen scheen, kreeg iets stroboscopisch door de snelheid van de trein."
                            }
                        ]
                    }
