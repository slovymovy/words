{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "176a1df3-790f-3f08-a507-03681bcf4732",
                    "sense_definition": "Away from the correct or expected course; amiss or wrong.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigators quickly realized that something was seriously <w>awry</w> with the official financial records.",
                            "target_lang_translations": {
                                "de": "Die Ermittler erkannten schnell, dass mit den offiziellen Finanzunterlagen etwas gewaltig <w>nicht stimmte</w>."
                            }
                        },
                        {
                            "text": "Despite careful planning, everything seemed slightly <w>awry</w> from the very beginning of the trip.",
                            "target_lang_translations": {
                                "de": "Trotz sorgfältiger Planung schien von Beginn der Reise an alles etwas <w>verkehrt</w> zu laufen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht wie vorgesehen oder erwartet; nicht in Ordnung oder fehlerhaft."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verkehrt",
                                "target_lang_sense_clarification": "nicht in Ordnung, fehlerhaft"
                            },
                            {
                                "target_lang_word": "nicht in Ordnung",
                                "target_lang_sense_clarification": "nicht stimmig oder fehlerhaft"
                            },
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "im übertragenen Sinne: fehlgelaufen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfa3cf15-46ef-3135-b814-91847fadda47",
                    "sense_definition": "Crooked, distorted, or turned toward one side; not straight or level.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He noticed that the picture frame hanging above the fireplace was noticeably <w>awry</w>.",
                            "target_lang_translations": {
                                "de": "Er bemerkte, dass der Bilderrahmen über dem Kamin auffallend <w>schief</w> war."
                            }
                        },
                        {
                            "text": "She straightened her necktie after realizing it had been blown <w>awry</w> by the strong wind.",
                            "target_lang_translations": {
                                "de": "Sie richtete ihre Krawatte, nachdem sie gemerkt hatte, dass der starke Wind sie <w>schief</w> geweht hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonky"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht gerade oder waagerecht ausgerichtet; verdreht oder zur Seite geneigt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "nicht gerade oder waagerecht"
                            },
                            {
                                "target_lang_word": "krumm",
                                "target_lang_sense_clarification": "nicht gerade, verbogen"
                            },
                            {
                                "target_lang_word": "verzogen",
                                "target_lang_sense_clarification": "in der Form verdreht"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "93ebca73-093e-37d9-977e-1213b0cb4c0b",
                    "sense_definition": "In an incorrect, unanticipated, or disastrous manner; wrong.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our vacation plans started to go <w>awry</w> when the airline canceled our connecting flight.",
                            "target_lang_translations": {
                                "de": "Unsere Urlaubspläne begannen <w>schiefzugehen</w>, als die Fluggesellschaft unseren Anschlussflug strich."
                            }
                        },
                        {
                            "text": "When their initial strategy went <w>awry</w>, the team had to quickly adapt to the new situation.",
                            "target_lang_translations": {
                                "de": "Als ihre ursprüngliche Strategie <w>schiefging</w>, musste sich das Team schnell an die neue Situation anpassen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go awry",
                        "went awry"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf fehlerhafte, unerwartete oder unheilvolle Weise; nicht nach Plan verlaufend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "besonders in der Wendung »schiefgehen«"
                            },
                            {
                                "target_lang_word": "daneben",
                                "target_lang_sense_clarification": "im übertragenen Sinne: missglückt"
                            },
                            {
                                "target_lang_word": "verkehrt",
                                "target_lang_sense_clarification": "in falscher Weise ablaufend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71362415-39d1-3a87-abd3-258274347cc9",
                    "sense_definition": "In an oblique, uneven, or crooked position; askew.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His hat was perched <w>awry</w> on his head after running through the storm.",
                            "target_lang_translations": {
                                "de": "Nachdem er durch den Sturm gerannt war, saß sein Hut <w>schief</w> auf seinem Kopf."
                            }
                        },
                        {
                            "text": "The sign hung <w>awry</w> from a single rusty nail on the old barn door.",
                            "target_lang_translations": {
                                "de": "Das Schild hing <w>schief</w> an einem einzigen rostigen Nagel an der alten Scheunentür."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "In einer schrägen, unebenen oder schiefen Lage."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "in schräger oder ungerader Position"
                            },
                            {
                                "target_lang_word": "verquer",
                                "target_lang_sense_clarification": "schräg oder unpassend angeordnet"
                            },
                            {
                                "target_lang_word": "krumm",
                                "target_lang_sense_clarification": "in ungerader Lage"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}