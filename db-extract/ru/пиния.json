                "senses": [
                    {
                        "sense_id": "982add75-9760-3090-8fde-c3db0b4b49b4",
                        "entry_id": "ed09fe80-e8bb-3c58-a41f-0a15323526ed",
                        "glosses": [
                            "ботан. (лат. Pinus pinea) дерево семейства сосновых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b68a9c-f5f7-42a3-aaf9-0639378ac658",
                                "sense_id": "982add75-9760-3090-8fde-c3db0b4b49b4",
                                "text": "А над ними высились жёлто-коричневые вершины с зелёными пятнами садов и пиний."
                            },
                            {
                                "example_id": "e66d4c99-7a64-48e0-8225-ccb94a76fda7",
                                "sense_id": "982add75-9760-3090-8fde-c3db0b4b49b4",
                                "text": "У входа в неё, защищая от морских ветров, ощетинился пиниями крутоярый остров Катабоко."
                            },
                            {
                                "example_id": "20fd1304-21a6-4734-a612-6c120cb53819",
                                "sense_id": "982add75-9760-3090-8fde-c3db0b4b49b4",
                                "text": "Тёмные свечи кипарисов и пламевидные кроны пиний означали места жилищ."
                            }
                        ]
                    }
                ],
