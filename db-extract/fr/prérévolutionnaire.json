                        "sense_id": "2e149850-0d8f-3b91-911c-0bc1ed73520a",
                        "entry_id": "3c49a683-9165-393a-b5d1-d62230dd3ffa",
                        "glosses": [
                            "Qui précède, qui vient avant la révolution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c07a355-39e0-431d-8023-eb031f3000ce",
                                "sense_id": "2e149850-0d8f-3b91-911c-0bc1ed73520a",
                                "text": "Ils s’inquiètent de ce qui se passe et établissent un parallèle avec l’immoralité des années prérévolutionnaires, le chaos et la destruction du pays dans les années 1990 », a renchéri le patriarche début février."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04637d1a-09b6-4736-8e06-7238e68ee8c1",
                        "source_entry_id": "3c49a683-9165-393a-b5d1-d62230dd3ffa",
                        "source_sense_id": "2e149850-0d8f-3b91-911c-0bc1ed73520a",
                        "target_lang_word": "prerevolutionary",
                        "target_lang_code": "en",
