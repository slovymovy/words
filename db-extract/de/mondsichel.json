                ],
                "senses": [
                    {
                        "sense_id": "900b7d6e-2a9b-339e-95f5-4e7a9bef630d",
                        "entry_id": "d1d3c492-8e6c-3169-874f-5532474a8e0c",
                        "glosses": [
                            "der Mond, der oft am Abendhimmel eine sichelförmige Gestalt zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dcd226c-d151-4eec-9270-b7d7ad4d80b8",
                                "sense_id": "900b7d6e-2a9b-339e-95f5-4e7a9bef630d",
                                "text": "Die bleiche Mondsichel stand am Himmel."
                            },
                            {
                                "example_id": "0166a923-8543-487d-82e8-bad94f967919",
                                "sense_id": "900b7d6e-2a9b-339e-95f5-4e7a9bef630d",
                                "text": "„Im Licht der schmalen Mondsichel sah Brian deutlich den buschigen Schweif, den der Skunk zierlich in die Luft reckte, und die weißen Streifen an seinem Rücken.“"
                            },
                            {
                                "example_id": "5effa1fc-2718-46c7-af14-4b00cb580a57",
                                "sense_id": "900b7d6e-2a9b-339e-95f5-4e7a9bef630d",
                                "text": "„Links stand die Mondsichel über dem Walde.“"
                            },
                            {
                                "example_id": "94cf0eee-a406-47aa-ade6-049b0e4756d4",
                                "sense_id": "900b7d6e-2a9b-339e-95f5-4e7a9bef630d",
                                "text": "„Einige Jahre waren sie Liebende unter einer dünnen Mondsichel gewesen, wie sie sich ausdrückte, und als sie nun den ganzen Mond und die Sonne dazubekamen, schienen die starken Lichtwellen geheim gehaltene Schatten aufzudecken.“"
                            },
                            {
                                "example_id": "fc37644a-0f84-4d85-b84a-95c977304ca4",
                                "sense_id": "900b7d6e-2a9b-339e-95f5-4e7a9bef630d",
                                "text": "„Es dämmerte schon, als wir am Ende unserer Dorferkundung waren und die Mondsichel am Himmel auftauchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
