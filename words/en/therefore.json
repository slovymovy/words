                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have labored in the fields all day and shall receive their wages <w>therefore</w>.",
                            "target_lang_translations": {
                                "ru": "Они трудились в полях весь день и получат <w>за это</w> плату.",
                                "tr": "Bütün gün tarlalarda çalıştılar ve <w>bunun karşılığında</w> ücretlerini alacaklar.",
                                "zh": "他们在田里劳作了一整天，并将<w>为此</w>获得报酬。",
                                "pl": "Pracowali cały dzień w polu i <w>w tym celu</w> otrzymają swoje wynagrodzenie.",
                                "nl": "Ze hebben de hele dag op het land gewerkt en zullen <w>daarvoor</w> hun loon ontvangen.",
                                "es": "Han trabajado en el campo todo el día y recibirán su salario <w>por ello</w>.",
                                "de": "Sie haben den ganzen Tag auf den Feldern gearbeitet und sollen <w>dafür</w> ihren Lohn erhalten.",
                                "fr": "Ils ont travaillé aux champs toute la journée et recevront leur salaire <w>pour cela</w>.",
                                "it": "Hanno lavorato nei campi tutto il giorno e riceveranno la loro paga <w>per questo</w>.",
                                "cs": "Pracovali celý den na poli a obdrží <w>za to</w> svou mzdu.",
                                "ja": "彼らは一日中畑で働きました。賃金は<w>そのために</w>支払われることになっています。",
                                "pt": "Trabalharam nos campos o dia inteiro e receberão o salário <w>em troca disso</w>."
                            }
                        },
                        {
                            "text": "He sought to build a house and gathered the wood <w>therefore</w>.",
