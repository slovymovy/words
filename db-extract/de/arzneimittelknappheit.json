                "senses": [
                    {
                        "sense_id": "efa8e87a-3987-3f1b-bc79-a3ff70f18e03",
                        "entry_id": "a5d1983f-b425-3749-b803-d2dfc49087d9",
                        "glosses": [
                            "Knappheit an Arzneimittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "552b29c1-c550-401a-a6da-20743e72472f",
                                "sense_id": "efa8e87a-3987-3f1b-bc79-a3ff70f18e03",
                                "text": "„Die Arzneimittelknappheit könnte sich laut Kinderärzteverbandspräsident Thomas Fischbach im Herbst und Winter erneut verschärfen.“"
                            },
                            {
                                "example_id": "00f14104-714c-4781-b344-34413c0432f9",
                                "sense_id": "efa8e87a-3987-3f1b-bc79-a3ff70f18e03",
                                "text": "„Das Thema der Arzneimittelknappheit ist in den USA inzwischen dauerpräsent – überall und für nahezu jedermann.“"
                            },
                            {
                                "example_id": "ba94f89b-b96f-4279-b986-edfc36ca3220",
                                "sense_id": "efa8e87a-3987-3f1b-bc79-a3ff70f18e03",
                                "text": "„In der Orientierungsaussprache auf Basis eines Hintergrundpapiers beschäftigte sich der Rat mit den Fragen, ob die von der Kommission vorgeschlagenen bzw. bereits ergriffenen Maßnahmen mit Blick auf Arzneimittelknappheiten kurzfristig erhebliche Wirkung zeigen werden und ob weitere Maßnahmen oder ein spezifischer Umsetzungsplan notwendig sind.“"
                            }
                        ],
