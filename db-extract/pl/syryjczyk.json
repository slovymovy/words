                                "target_senses": [
                                    {
                                        "sense_id": "88a80518-c690-39ce-a293-c564110bebf2",
                                        "entry_id": "0fdda0e1-ae0c-30d7-8c5b-25fa0787c6de",
                                        "glosses": [
                                            "Staatsbürger der Arabischen Republik Syrien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5edb4688-c2f3-46f1-b183-fd50cfc0a60b",
                                                "sense_id": "88a80518-c690-39ce-a293-c564110bebf2",
                                                "text": "„Aber ihren Dialekten zufolge war der erste ein Ägypter, der zweite ein Iraker und der dritte ein Syrer.“"
                                            },
                                            {
                                                "example_id": "f47bb17a-2c13-4697-a133-dc3f081dc8ed",
                                                "sense_id": "88a80518-c690-39ce-a293-c564110bebf2",
                                                "text": "„Die Syrer waren in der Stadt in einem verlassenen Kloster einquartiert worden, dicke Mauern, saubere Böden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d11199c-c1ff-3d50-ab13-9977e4dd2297",
                                        "entry_id": "0fdda0e1-ae0c-30d7-8c5b-25fa0787c6de",
                                        "glosses": [
                                            "nur Plural: Volksgruppe aus dem geographischen Gebiet Syriens, die bereits früh christianisiert wurde und heute größtenteils in der Diaspora lebt"
                                        ],
