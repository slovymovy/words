                        ],
                        "examples": [
                            {
                                "example_id": "4885180b-0c4e-4c3b-90c6-a3d7d1e867a9",
                                "sense_id": "e50601b3-4719-338f-8308-312b9c540b47",
                                "text": "„Ein anfangs vermuteter Schwarm aus dem Klotzbeutenvolk entpuppte sich als Irrtum; das Klotzbeutenvolk hat 2013 nicht geschwärmt.“"
                            },
                            {
                                "example_id": "ca897702-8999-4fae-b9c3-03fe0041cbda",
                                "sense_id": "e50601b3-4719-338f-8308-312b9c540b47",
                                "text": "„Das Klotzbeutenvolk \"verhungerte\", da es im Januar schon anfing zu brüten.“"
                            },
                            {
                                "example_id": "b6f46098-f819-491e-84db-5af17c7a7ab0",
                                "sense_id": "e50601b3-4719-338f-8308-312b9c540b47",
                                "text": "Mein Klotzbeutenvolk besiedelt jetzt schon seit 2 Jahren den hohlen Eichenstamm, und tatsächlich vermissen sie die Rähmchen nicht."
                            },
                            {
                                "example_id": "de680318-3238-4257-bee4-eeb7982e1709",
                                "sense_id": "e50601b3-4719-338f-8308-312b9c540b47",
                                "text": "Ein Klotzbeutenvolk ist leider tot."
                            }
                        ],
