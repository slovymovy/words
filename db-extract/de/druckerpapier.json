                "senses": [
                    {
                        "sense_id": "5e31103d-d871-37c5-84db-2af47df1b047",
                        "entry_id": "9258e6a7-e013-3566-8c2b-6eae37686edf",
                        "glosses": [
                            "eine Art von Papier, die aufgrund ihrer spezifischen Struktur speziell zur Verwendung in Druckern vorgesehen ist"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "78875c59-f055-46dc-8b25-6fa911cfc3f3",
                                "sense_id": "5e31103d-d871-37c5-84db-2af47df1b047",
                                "text": "„In einem ersten Schritt haben die Forschenden herkömmliches Druckerpapier im DIN-A4-Format einseitig mit einer gängigen Druckertinte - bestehend aus Wasser und dem Lösungsmittel Glycerin - besprüht.“"
                            },
                            {
                                "example_id": "108209e5-6f46-4f3a-b831-d63ea69b9368",
                                "sense_id": "5e31103d-d871-37c5-84db-2af47df1b047",
                                "text": "„Im Büro fühlt man sich sicher – was soll schon passieren? Gut: man kann seinen kleinen Zeh mit dem Bürostuhl überfahren oder sich mit dem Druckerpapier in den Finger schneiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
