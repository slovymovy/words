                    }
                ],
                "translations": [
                    {
                        "translation_id": "addde79c-4f9d-4dd2-af76-b57a2cb9a4de",
                        "source_entry_id": "f7aae5af-17c2-378b-a38f-fbbd49268f4b",
                        "source_sense_id": "23246d81-6f10-31c8-a3cb-cbf47587ceb3",
                        "target_lang_word": "Kremlin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kremlin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea2e0a2d-d0b3-3439-b9ae-6afc451fb389",
                                        "entry_id": "86460f69-f7a0-3763-8cf2-76fe5678f7ac",
                                        "glosses": [
                                            "The Moscow Kremlin; a fortified complex in Moscow, Russia that serves as the official residence of the President of the Russian Federation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4977973-17c1-3846-b188-483c1c031fc6",
                                        "entry_id": "86460f69-f7a0-3763-8cf2-76fe5678f7ac",
                                        "glosses": [
                                            "The Russian or Soviet government."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c464053a-f33d-4534-a4c3-5af63660829d",
                                                "sense_id": "e4977973-17c1-3846-b188-483c1c031fc6",
                                                "text": "The Kremlin announced plans to increase funding for museums and the arts."
                                            },
                                            {
                                                "example_id": "e1db6a46-b4c2-40e2-a811-dd82380b7de4",
                                                "sense_id": "e4977973-17c1-3846-b188-483c1c031fc6",
                                                "text": "Over the course of the war in Ukraine, the Kremlin has drawn several “red lines” – with ostentatious references to Russia’s huge strategic nuclear arsenal – only to seemingly do nothing when these lines are crossed by Ukraine or its Western backers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "159ac633-ee9c-4d5a-a087-2806f50ff96e",
                        "source_entry_id": "f7aae5af-17c2-378b-a38f-fbbd49268f4b",
                        "source_sense_id": "23246d81-6f10-31c8-a3cb-cbf47587ceb3",
                        "target_lang_word": "Кремль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Кремль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "33ef71b7-9f04-333e-ae45-79be2f91de14",
                                        "entry_id": "bd22b89a-715d-3154-a1f8-51aa664e1b63",
                                        "glosses": [
                                            "Московский Кремль как место пребывания главы государства и размещения аппарата президента"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62c8f216-bb61-4c68-8c73-ce8ec54bec30",
                                                "sense_id": "33ef71b7-9f04-333e-ae45-79be2f91de14",
                                                "text": "Мы жили в самом центре, и я помню, как бомбы падали в нашем районе — фашистские лётчики метили в Кремль."
                                            },
                                            {
                                                "example_id": "02c60ab9-41f5-4e74-a0f1-ba3d53229084",
                                                "sense_id": "33ef71b7-9f04-333e-ae45-79be2f91de14",
                                                "text": "Вход в Кремль был по пропускам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b52934-c3d5-3101-9630-31681a9bf4ba",
                                        "entry_id": "bd22b89a-715d-3154-a1f8-51aa664e1b63",
                                        "glosses": [
                                            "метоним. употребляется как символ высших органов власти Российской Федерации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c812f809-8551-4e96-b603-07f63e8d7bf2",
                                                "sense_id": "78b52934-c3d5-3101-9630-31681a9bf4ba",
                                                "text": "«ЕР» не лезет поперёк батьки в пекло — Кремль молчит, и она воды в рот набрала."
                                            },
                                            {
                                                "example_id": "fefd1df5-ce37-47fa-8a0b-3327dab80191",
                                                "sense_id": "78b52934-c3d5-3101-9630-31681a9bf4ba",
                                                "text": "Идите в Кремль и добивайтесь изменения политического и экономического курса."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
