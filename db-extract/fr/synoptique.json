        "fr-extract.jsonl": [
            {
                "entry_id": "7ea4e9bf-92de-3a12-b1a3-48ea01d4eac8",
                "word": "synoptique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ac7a0596-547b-4686-aed0-20b18ef94bea",
                        "entry_id": "7ea4e9bf-92de-3a12-b1a3-48ea01d4eac8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "synoptiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a91f01c-6609-3281-9fc2-2a7db83291bc",
                        "entry_id": "7ea4e9bf-92de-3a12-b1a3-48ea01d4eac8",
                        "glosses": [
                            "Qui permet d’embrasser, de saisir d’un même coup d’œil les diverses parties d’un ensemble, qui en offre une vue générale."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b9afc7c6-9520-4582-9ac4-8ae81238984f",
                                "sense_id": "3a91f01c-6609-3281-9fc2-2a7db83291bc",
                                "text": "Tableau synoptique d’une science, d’un système, d’une méthode."
                            },
                            {
                                "example_id": "b47204e9-ceb1-415f-b17e-09b7b1944cce",
                                "sense_id": "3a91f01c-6609-3281-9fc2-2a7db83291bc",
                                "text": "M. Duport m’avait fait faire par un de ses amis professeur à la Sorbonne un tableau synoptique de toutes les impossibilités que Dieu soit."
                            },
                            {
                                "example_id": "aba7a04d-320e-4281-919a-2c5844062c0b",
                                "sense_id": "3a91f01c-6609-3281-9fc2-2a7db83291bc",
                                "text": "Avant chaque départ, elle poussait la prévenance à mon endroit jusqu’à rédiger de véritables chartes ou tableaux synoptiques, qui listaient les étapes, leur durée, les hôtels, les relais institutionnels tels consulats et ambassades, à appeler le cas échéant."
                            }
                        ]
                    },
                    {
                        "sense_id": "539e6487-ea5d-3cf8-97d5-ead678e170d4",
                        "entry_id": "7ea4e9bf-92de-3a12-b1a3-48ea01d4eac8",
                        "glosses": [
                            "À grande échelle, relativement au cadre d’étude."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ce138821-c357-4b51-bb3e-11ecfdef9482",
                                "sense_id": "539e6487-ea5d-3cf8-97d5-ead678e170d4",
                                "text": "Le vent synoptique est donné par les cartes météo ; il est localement modifié par des phénomènes de relief ou de la brise thermique."
                            }
                        ]
                    },
                    {
                        "sense_id": "5190c73b-8b9e-30d2-aa7b-fe2e641998d7",
                        "entry_id": "7ea4e9bf-92de-3a12-b1a3-48ea01d4eac8",
                        "glosses": [
                            "Qualifie l’évangile de saint Matthieu, celui de saint Marc et celui de saint Luc car leur plan offre une concordance permettant d’en saisir les dispositions comme d’un coup d’œil."
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "50fecf09-d578-4dec-8c88-16e22e19be7c",
                                "sense_id": "5190c73b-8b9e-30d2-aa7b-fe2e641998d7",
                                "text": "Les Évangiles synoptiques sont les trois premiers textes du Nouveau Testament."
                            },
                            {
                                "example_id": "ad0e833c-5e39-4cec-be1f-282ffeebf950",
                                "sense_id": "5190c73b-8b9e-30d2-aa7b-fe2e641998d7",
                                "text": "les prises de données altimétriques synoptiques pour déduire les informations physiques et chimiques"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9feca9a0-8b50-4e44-9c2b-bc1d4c5ca0cb",
                        "source_entry_id": "7ea4e9bf-92de-3a12-b1a3-48ea01d4eac8",
