                                    {
                                        "sense_id": "1f1e6619-606a-30e4-b4b0-ae6ec3ed568d",
                                        "entry_id": "14754077-664a-379f-925d-27f57f7622d6",
                                        "glosses": [
                                            "One affected with or exhibiting megalomania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5bc74b2-a972-43e1-a4b9-9104ea3207d0",
                                                "sense_id": "1f1e6619-606a-30e4-b4b0-ae6ec3ed568d",
                                                "text": "'Well, I don't know him well enough yet to say, but I will admit that if he is not a mere bullying megalomaniac, and if what he says is true, then he certainly is in a class by himself.'"
                                            }
                                        ]
                                    }
