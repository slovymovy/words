                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "сильно мучить, не давать покоя"
                            },
                            {
                                "target_lang_word": "тревожить",
                                "target_lang_sense_clarification": "вызывать сильное беспокойство или горе"
                            }
