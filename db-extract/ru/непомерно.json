                                        "glosses": [
                                            "über das übliche Maß hinaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c6f489-78b1-4b6e-9893-50a5b5dba6bd",
                                                "sense_id": "2f1fcbc0-7cbb-37e1-8bba-9216cdcbc53c",
                                                "text": "Übermäßiger Alkoholkonsum schädigt die Gesundheit."
                                            },
                                            {
                                                "example_id": "0435b33a-9d5b-4419-a2c1-eb089972e089",
                                                "sense_id": "2f1fcbc0-7cbb-37e1-8bba-9216cdcbc53c",
                                                "text": "„Die Umleitungen der DB InfraGo seien übermäßig lang, böten keine ausreichende Kapazität und seien selbst störungsanfällig.“"
                                            },
                                            {
                                                "example_id": "c5e41746-7e01-47de-adbc-c4bb7e80da88",
                                                "sense_id": "2f1fcbc0-7cbb-37e1-8bba-9216cdcbc53c",
                                                "text": "„Eine chinesische Studie hat herausgefunden, dass der übermäßige Konsum von Energy-Drinks sowie anderer stark zucker- und koffeinhaltiger Getränke vorzeitigen Haarausfall begünstigen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "328da4ed-fc3d-42c4-b8b1-4f9923600c4f",
                        "source_entry_id": "d45bb48e-e464-3336-88c4-76b1f89787cc",
