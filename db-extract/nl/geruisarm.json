                                    {
                                        "sense_id": "238870a6-abe7-325f-999c-7f680f07cc24",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "With little or no sound; free of disturbing noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700153ea-437b-413a-a3ec-dd454e8f7a82",
                                                "sense_id": "238870a6-abe7-325f-999c-7f680f07cc24",
                                                "text": "I can't hear the music; it is too quiet."
                                            },
                                            {
                                                "example_id": "58e377eb-327d-46c9-8466-b855fe69d442",
                                                "sense_id": "238870a6-abe7-325f-999c-7f680f07cc24",
                                                "text": "On the light streets, better streetcleaners, more trees, more police, and quieter buses were the most popular improvements, followed by cutting down the number of cars and improving children's play space."
                                            },
                                            {
                                                "example_id": "2ab0e4c1-fbcd-4951-ba88-6c7269a18e60",
                                                "sense_id": "238870a6-abe7-325f-999c-7f680f07cc24",
                                                "text": "Before long, the unsuspecting salesman was earnestly pitching him \"the quietest noisemaker on the market.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236e2f88-4d02-3152-901e-3379b3544b6d",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Having little motion or activity; calm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9618ffa7-2c47-4227-b50b-f0b64a626c49",
                                                "sense_id": "236e2f88-4d02-3152-901e-3379b3544b6d",
                                                "text": "the sea was quiet"
                                            },
                                            {
                                                "example_id": "3bb5d4bd-6fa4-4b57-a5c4-7d6f293ac62b",
                                                "sense_id": "236e2f88-4d02-3152-901e-3379b3544b6d",
                                                "text": "a quiet night at home"
                                            },
                                            {
                                                "example_id": "799893e0-b26f-49c1-a07d-0bc8b05095a9",
                                                "sense_id": "236e2f88-4d02-3152-901e-3379b3544b6d",
                                                "text": "all quiet on the Western front"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fac32dc9-3125-33b9-bb0c-1758d7151d6e",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Not busy, of low quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa6a745d-180f-4f63-a354-cd3b3478d758",
                                                "sense_id": "fac32dc9-3125-33b9-bb0c-1758d7151d6e",
                                                "text": "The traffic was quiet for a Monday morning."
                                            },
                                            {
                                                "example_id": "bd9b2a3e-1dbd-40a6-8bb0-0765303606be",
                                                "sense_id": "fac32dc9-3125-33b9-bb0c-1758d7151d6e",
                                                "text": "Business was quiet for the season."
                                            },
                                            {
                                                "example_id": "5a045a00-d36a-4bc3-9669-538e9e3b9c64",
                                                "sense_id": "fac32dc9-3125-33b9-bb0c-1758d7151d6e",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2de6eb5-cedc-3d11-a34a-097b7b2fff03",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Not talking much or not talking loudly; reserved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "328676c2-238d-48ad-b78b-95383d319906",
                                                "sense_id": "a2de6eb5-cedc-3d11-a34a-097b7b2fff03",
                                                "text": "He's a very quiet man usually, but is very chatty after a few beers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62902a5f-89c6-3445-9ce7-ed353a036dfc",
                                        "entry_id": "f3439a23-9811-3f50-afad-ee3fc798c09c",
                                        "glosses": [
                                            "Not showy; undemonstrative."
                                        ],
                                        "tags": [],
