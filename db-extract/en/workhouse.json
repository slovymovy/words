                                    {
                                        "sense_id": "d4a38b60-c016-3244-b04e-8931d8ce8a5b",
                                        "entry_id": "9a9d39f8-8397-3824-8985-fc594bc91a6d",
                                        "glosses": [
                                            "veraltend: Gefängnis für Häftlinge mit einem verschärften Strafvollzug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef8d185-4d74-4bde-b51f-5226f0f67105",
                                                "sense_id": "d4a38b60-c016-3244-b04e-8931d8ce8a5b",
                                                "text": "Er musste mehrere Jahre im Zuchthaus absitzen."
                                            },
                                            {
                                                "example_id": "39559c2c-ffdb-41f8-9672-9273a0b8e9c2",
                                                "sense_id": "d4a38b60-c016-3244-b04e-8931d8ce8a5b",
                                                "text": "„Das Gefängnis ist mit Deserteuren überfüllt, um Platz für neue Gefangene zu schaffen, stellt man die Soldaten vor die Wahl, sich für die Front oder fürs Zuchthaus zu entscheiden.“"
                                            },
                                            {
                                                "example_id": "c2f937f1-d515-4e63-a43e-797835877be2",
                                                "sense_id": "d4a38b60-c016-3244-b04e-8931d8ce8a5b",
                                                "text": "„Zu DDR-Zeiten war Bautzen das wohl schrecklichste Zuchthaus für politische Gefangene.“"
                                            },
                                            {
                                                "example_id": "4962ff7b-143b-4dcf-8b35-983f53a90f7f",
                                                "sense_id": "d4a38b60-c016-3244-b04e-8931d8ce8a5b",
                                                "text": "„Sie spionierte um das Zuchthaus herum und fand heraus, wohin die Gefangenen zur Arbeit gebracht wurden.“"
                                            },
                                            {
                                                "example_id": "3c2805db-74d2-490f-8813-2aea339ea80a",
                                                "sense_id": "d4a38b60-c016-3244-b04e-8931d8ce8a5b",
                                                "text": "„Das Standgericht verurteilt Toller zu fünf Jahren Festungshaft und schickt ihn ins Zuchthaus Niederschönenfeld.“"
                                            },
                                            {
                                                "example_id": "68357c22-f2d7-4fb4-af8b-b88880a75b6f",
                                                "sense_id": "d4a38b60-c016-3244-b04e-8931d8ce8a5b",
                                                "text": "„Tilak, der Führer der «Extremisten», der 1908 zu sechs Jahren Zuchthaus verurteilt worden war, kehrte 1914 in die indische Politik zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f85a16d-056b-42ce-8420-7c1f64e43af6",
                        "source_entry_id": "d11a8022-958a-3510-a56c-f4b2f079e364",
                        "source_sense_id": "7ef90534-4fa9-351a-9f20-b8abbbf7052b",
                        "source_sense_description": "veraltet: Werkstatt",
                        "target_lang_word": "Werkstatt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werkstatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                        "entry_id": "014af371-b1d0-330e-8db7-fdd1146187a7",
                                        "glosses": [
                                            "Arbeitsraum eines Handwerkers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19d621b-590f-4178-8a85-9b3ea9f651eb",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "In unserer Werkstatt sind auch Schraubenzieher aller Größen."
                                            },
                                            {
                                                "example_id": "2e6d2113-13e8-48d8-9ec0-bca9c10201e6",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "„Für andere Geschäfte bediente er sich der Rotunde, die ihm auf dem Wege vom Mittagessen zur Werkstatt am nächsten lag.“"
                                            },
                                            {
                                                "example_id": "1e1e6477-0b63-497f-aa19-c3897e2becf0",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "„Kunst ist in Benin stets Teil des Ritus, die Bronzegießer vollziehen in ihren Werkstätten sakrale Handlungen.“"
                                            },
                                            {
                                                "example_id": "ba9e98c8-9257-43d9-b09e-dc75fc0bcb35",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "„Gestern hat er einen Anruf bekommen: Seiner Werkstatt fehle die Baugenehmigung.“"
                                            },
                                            {
                                                "example_id": "83d47b5a-a5e8-46b3-8668-193e029f618e",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "„Der Ingenieur führte mich in den vielen Höfen, Werkstätten und Geschäftszimmern des gewaltigen Betriebes umher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
