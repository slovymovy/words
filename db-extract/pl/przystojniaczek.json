                        "target_lang_word": "красавчик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "красавчик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7e2d99-bc3d-32fb-8f8c-88f2a65f206e",
                                        "entry_id": "d72b0acc-d061-3060-b094-94d401ddc565",
                                        "glosses": [
                                            "ирон., пренебр. уменьш. к красавец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff6b551e-a936-4644-87db-1b72a7ea01ed",
                                                "sense_id": "2e7e2d99-bc3d-32fb-8f8c-88f2a65f206e",
                                                "text": "А вот карточка моего отца: голубоглазый блондин, изящный, нежный и застенчивый красавчик, мамин и папин любимчик."
                                            },
                                            {
                                                "example_id": "e1fc48c0-1c3a-4212-a4f3-32474a8c0c8a",
                                                "sense_id": "2e7e2d99-bc3d-32fb-8f8c-88f2a65f206e",
                                                "text": "Многим девчонкам нравятся смазливые красавчики типа Алена Делона и Жерара Филиппа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "580af748-d87f-3417-af31-4a6f36772813",
                                        "entry_id": "d72b0acc-d061-3060-b094-94d401ddc565",
                                        "glosses": [
                                            "мол. для выражения одобрения, похвалы за какой-нибудь ловкий, отличный поступок, удачное действие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811c2a97-0818-44b7-92db-dd59e6610f80",
                                                "sense_id": "580af748-d87f-3417-af31-4a6f36772813",
                                                "text": "Где находятся камеры, знаю. ― Молодец, Серж, красавчик, ― похвалил друга Герман. ― Зачем оттягивать?"
                                            }
                                        ]
                                    }
                                ]
