    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b8124f1-9c0d-3bd9-8322-884b86d5086d",
                    "sense_definition": "A thin white layer of ice crystals that forms on surfaces when the temperature is below freezing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ice_weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grass was covered in white <w>frost</w> early this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня рано утром трава была покрыта белым <w>инеем</w>.",
                                "zh": "今天清晨，草地上覆盖着一层白色的<w>霜</w>。"
                            }
                        },
                        {
                            "text": "You will need to scrape the <w>frost</w> off the car windshield before driving.",
                            "target_lang_translations": {
                                "ru": "Тебе придется соскрести <w>иней</w> с лобового стекла машины перед поездкой.",
                                "zh": "开车前，你需要把挡风玻璃上的<w>霜</w>刮掉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hoarfrost",
                        "rime",
                        "ice crystals"
                    ],
                    "common_phrases": [
                        "morning frost",
                        "ground frost",
                        "heavy frost",
                        "white frost"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий слой ледяных кристаллов, образующийся на поверхностях при температуре ниже нуля.",
                        "zh": "当温度低于冰点时，在物体表面形成的一层薄薄的白色冰晶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "и́ней",
                                "target_lang_sense_clarification": "кристаллы льда на поверхностях"
                            },
                            {
                                "target_lang_word": "и́зморозь",
                                "target_lang_sense_clarification": "снежный налет в туманную погоду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霜",
                                "target_lang_sense_clarification": "物体表面凝结的冰晶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd772162-2fd6-37c9-8017-99964e5e1902",
                    "sense_definition": "A period of cold weather when the temperature falls below freezing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ice_weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers are worried that a late <w>frost</w> might damage the crops.",
                            "target_lang_translations": {
                                "ru": "Фермеры беспокоятся, что поздние <w>заморозки</w> могут повредить посевы.",
                                "zh": "农民们担心晚来的<w>霜冻</w>会损坏庄稼。"
                            }
                        },
                        {
                            "text": "We are expecting a sharp <w>frost</w> tonight, so bring the plants inside.",
                            "target_lang_translations": {
                                "ru": "Мы ожидаем сильный <w>мороз</w> сегодня ночью, так что занеси растения внутрь.",
                                "zh": "今晚预计会有<w>严寒</w>，所以把植物搬进屋里吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "freeze",
                        "cold snap",
                        "cold spell"
                    ],
                    "antonyms": [
                        "thaw",
                        "heatwave"
                    ],
                    "common_phrases": [
                        "hard frost",
                        "sharp frost",
                        "severe frost",
                        "first frost"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период холодной погоды, когда температура опускается ниже нуля.",
                        "zh": "气温降至冰点以下的寒冷天气时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моро́з",
                                "target_lang_sense_clarification": "сильный холод, низкая температура"
                            },
                            {
                                "target_lang_word": "за́морозки",
                                "target_lang_sense_clarification": "легкий мороз (обычно весной или осенью)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霜冻",
                                "target_lang_sense_clarification": "气温骤降导致农作物受损的天气"
                            },
                            {
                                "target_lang_word": "严寒",
                                "target_lang_sense_clarification": "极度寒冷的天气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4b810d-39d7-3b41-a1a5-c10d5acb2e5d",
                    "sense_definition": "A lack of warmth, friendliness, or emotion in someone's manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion_coldness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a distinct <w>frost</w> in her tone when she spoke to him.",
                            "target_lang_translations": {
                                "ru": "В её тоне чувствовался явный <w>холод</w>, когда она говорила с ним.",
                                "zh": "她对他说话时，语气中透着明显的<w>冷淡</w>。"
                            }
                        },
                        {
                            "text": "He tried to smile, but the <w>frost</w> in his eyes remained.",
                            "target_lang_translations": {
                                "ru": "Он попытался улыбнуться, но <w>холод</w> в его глазах остался.",
                                "zh": "他试图微笑，但眼神中的<w>冰冷</w>依然存在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coldness",
                        "iciness",
                        "frigidity"
                    ],
                    "antonyms": [
                        "warmth",
                        "friendliness"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "metaphorical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие теплоты, дружелюбия или эмоций в чьем-либо поведении.",
                        "zh": "某人态度中缺乏温暖、友好或情感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хо́лод",
                                "target_lang_sense_clarification": "эмоциональная отстраненность"
                            },
                            {
                                "target_lang_word": "холо́дность",
                                "target_lang_sense_clarification": "свойство характера или манеры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷淡",
                                "target_lang_sense_clarification": "态度上的疏远或不热情"
                            },
                            {
                                "target_lang_word": "冰冷",
                                "target_lang_sense_clarification": "形容情感或眼神的冷漠"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "383619ce-0ee0-3bc9-8366-baa1180cd63d",
                    "sense_definition": "A translucent material or filter used to diffuse light, often in photography or theater.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lighting technician placed a <w>frost</w> over the spotlight to soften the beam.",
                            "target_lang_translations": {
                                "ru": "Осветитель поместил <w>матовый фильтр</w> на прожектор, чтобы смягчить луч.",
                                "zh": "灯光师在聚光灯上加了一层<w>柔光纸</w>以柔化光束。"
                            }
                        },
                        {
                            "text": "Using a <w>frost</w> helps to reduce harsh shadows on the subject's face.",
                            "target_lang_translations": {
                                "ru": "Использование <w>фрост-фильтра</w> помогает уменьшить резкие тени на лице объекта.",
                                "zh": "使用<w>柔光镜</w>有助于减少拍摄对象脸部生硬的阴影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diffuser"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical jargon in photography/lighting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полупрозрачный материал или фильтр, используемый для рассеивания света, часто в фотографии или театре.",
                        "zh": "一种用于漫射光线的半透明材料或滤镜，常用于摄影或戏剧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ма́товый фи́льтр",
                                "target_lang_sense_clarification": "для рассеивания света"
                            },
                            {
                                "target_lang_word": "фрост",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "柔光镜",
                                "target_lang_sense_clarification": "摄影中用于柔化光线的滤镜"
                            },
                            {
                                "target_lang_word": "柔光纸",
                                "target_lang_sense_clarification": "灯光照明中用于散射光线的材料"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea20d2de-355a-3dbe-82e7-9fb9414b301f",
                    "sense_definition": "To cover a cake, cookie, or cupcake with a sweet, creamy mixture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_prep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>frost</w> the birthday cake with chocolate buttercream.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>покрыть глазурью</w> именинный торт шоколадным масляным кремом.",
                                "zh": "她决定给生日蛋糕<w>涂上巧克力奶油糖霜</w>。"
                            }
                        },
                        {
                            "text": "Wait for the cookies to cool down before you <w>frost</w> them.",
                            "target_lang_translations": {
                                "ru": "Подождите, пока печенье остынет, прежде чем <w>глазировать</w> его.",
                                "zh": "等饼干冷却后再给它们<w>涂糖霜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ice"
                    ],
                    "common_phrases": [
                        "frost a cake",
                        "frost cupcakes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать торт, печенье или кекс сладкой кремовой смесью.",
                        "zh": "在蛋糕、饼干或纸杯蛋糕上涂抹一层甜美的奶油混合物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрыва́ть глазу́рью",
                                "target_lang_sense_clarification": "наносить сладкое покрытие"
                            },
                            {
                                "target_lang_word": "глазирова́ть",
                                "target_lang_sense_clarification": "кулинарный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涂糖霜",
                                "target_lang_sense_clarification": "在糕点表面涂抹糖霜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ddddedb-4582-3296-957c-39f5ea3b64d6",
                    "sense_definition": "To become covered with a thin layer of ice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ice_weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car windows began to <w>frost</w> over as the temperature dropped.",
                            "target_lang_translations": {
                                "ru": "Окна машины начали <w>покрываться инеем</w>, когда температура упала.",
                                "zh": "随着气温下降，车窗开始<w>结霜</w>。"
                            }
                        },
                        {
                            "text": "During the blizzard, the entire landscape seemed to <w>frost</w> instantly.",
                            "target_lang_translations": {
                                "ru": "Во время метели весь пейзаж, казалось, мгновенно <w>обледенел</w>.",
                                "zh": "暴风雪期间，整个大地仿佛瞬间<w>结霜</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "freeze over",
                        "ice over"
                    ],
                    "antonyms": [
                        "defrost",
                        "thaw"
                    ],
                    "common_phrases": [
                        "frost over",
                        "frost up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрываться тонким слоем льда.",
                        "zh": "表面覆盖上一层薄冰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрыва́ться и́неем",
                                "target_lang_sense_clarification": "обрастать кристаллами льда"
                            },
                            {
                                "target_lang_word": "обледенева́ть",
                                "target_lang_sense_clarification": "покрываться коркой льда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结霜",
                                "target_lang_sense_clarification": "物体表面形成霜层"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48d3b019-de15-343e-ab12-beaea14d8ad5",
                    "sense_definition": "To bleach specific strands of hair to make them lighter than the rest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hair_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the salon to <w>frost</w> her hair for a summer look.",
                            "target_lang_translations": {
                                "ru": "Она пошла в салон, чтобы <w>мелировать</w> волосы для летнего образа.",
                                "zh": "她去沙龙为头发做了<w>挑染</w>，以打造夏日造型。"
                            }
                        },
                        {
                            "text": "It was popular in the nineties for men to <w>frost</w> the tips of their hair.",
                            "target_lang_translations": {
                                "ru": "В девяностые у мужчин было популярно <w>мелировать</w> кончики волос.",
                                "zh": "在九十年代，男性流行给发梢做<w>挑染</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "highlight"
                    ],
                    "common_phrases": [
                        "frost hair",
                        "frosted tips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обесцвечивать отдельные пряди волос, чтобы сделать их светлее остальных.",
                        "zh": "将头发的特定发束漂白，使其比其余部分颜色更浅。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мели́ровать",
                                "target_lang_sense_clarification": "осветлять пряди"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑染",
                                "target_lang_sense_clarification": "对部分头发进行染色或漂白"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d2a7cdb-60ee-3868-83fe-29a072271bed",
                    "sense_definition": "To make someone angry or annoyed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion_coldness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It really <w>frosts</w> me when people cut in line at the store.",
                            "target_lang_translations": {
                                "ru": "Меня реально <w>вымораживает</w>, когда люди лезут без очереди в магазине.",
                                "zh": "当有人在商店插队时，真的让我很<w>惹恼</w>。"
                            }
                        },
                        {
                            "text": "His arrogant attitude tends to <w>frost</w> his coworkers.",
                            "target_lang_translations": {
                                "ru": "Его высокомерное отношение имеет тенденцию <w>бесить</w> коллег.",
                                "zh": "他傲慢的态度往往会把同事们<w>气坏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "irritate",
                        "bug"
                    ],
                    "antonyms": [
                        "please",
                        "soothe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злить или раздражать кого-либо.",
                        "zh": "使某人生气或恼火。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымора́живать",
                                "target_lang_sense_clarification": "сленг: сильно раздражать"
                            },
                            {
                                "target_lang_word": "беси́ть",
                                "target_lang_sense_clarification": "разг: выводить из себя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惹恼",
                                "target_lang_sense_clarification": "使人感到烦躁"
                            },
                            {
                                "target_lang_word": "气坏",
                                "target_lang_sense_clarification": "使人非常生气"
                            }
                        ]
                    }
                }
            ]
        },
        {
