                                        ]
                                    },
                                    {
                                        "sense_id": "06556aa3-ceb4-39fd-9565-8e2db6eda0ca",
                                        "entry_id": "acb625a9-f615-3065-a512-9bb0cf4c4795",
                                        "glosses": [
                                            "An amount of something supplied."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e0c367-f3ed-49e6-8454-2695d930e804",
                                                "sense_id": "06556aa3-ceb4-39fd-9565-8e2db6eda0ca",
                                                "text": "A supply of good drinking water is essential."
                                            },
                                            {
                                                "example_id": "347d8d3d-6c9f-4a92-bab7-7721e8316abe",
                                                "sense_id": "06556aa3-ceb4-39fd-9565-8e2db6eda0ca",
                                                "text": "She said, \"China has always had a freshwater supply problem with 20 percent of the world’s population but only 7 percent of its freshwater\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faf427a3-9eda-3546-89d6-2d76e9b25bd6",
                                        "entry_id": "acb625a9-f615-3065-a512-9bb0cf4c4795",
                                        "glosses": [
                                            "Provisions."
                                        ],
