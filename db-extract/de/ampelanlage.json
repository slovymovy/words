                                    {
                                        "sense_id": "1b561a0b-ec36-3322-ae94-906e23b7a7c6",
                                        "entry_id": "1fbf50d2-3f61-3b97-9ebf-70b3c19ba644",
                                        "glosses": [
                                            "Synonyme de feu tricolore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05ff6fd9-f0a6-4559-8fd5-6c919b39ae54",
                                                "sense_id": "1b561a0b-ec36-3322-ae94-906e23b7a7c6",
                                                "text": "Tout conducteur doit marquer l'arrêt absolu devant un feu de signalisation rouge, fixe ou clignotant."
                                            },
                                            {
                                                "example_id": "e563884e-41b7-4966-bd13-fb0e86dcdce2",
                                                "sense_id": "1b561a0b-ec36-3322-ae94-906e23b7a7c6",
                                                "text": "La hauteur des feux de circulation est un facteur important pour assurer leur visibilité aux conducteurs à une distance raisonnable. Avec leurs couleurs distinctes et leurs positions standardisées, ces feux de signalisation guident les usagers de la route, minimisant les risques d'accidents et rationalisant la circulation."
                                            }
                                        ]
                                    }
