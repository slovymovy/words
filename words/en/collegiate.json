{
    "word_family": [
        "college",
        "collegial",
        "collegiality",
        "collegian"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ef9eb8c8-9816-3c38-8943-c818fdda5a79",
                    "sense_definition": "Of, belonging to, or characteristic of a college or its students.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "college_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She earned a prestigious scholarship to play <w>collegiate</w> basketball in California.",
                            "target_lang_translations": {
                                "es": "Obtuvo una prestigiosa beca para jugar al baloncesto <w>universitario</w> en California."
                            }
                        },
                        {
                            "text": "He adopted a traditional <w>collegiate</w> style, wearing tweed jackets and penny loafers.",
                            "target_lang_translations": {
                                "es": "Adoptó un estilo tradicional <w>universitario</w>, vistiendo chaquetas de tweed y mocasines."
                            }
                        }
                    ],
                    "common_phrases": [
                        "collegiate sports",
                        "collegiate athletics"
                    ],
                    "target_lang_definitions": {
                        "es": "Perteneciente o relativo a una universidad o a sus estudiantes."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "universitario",
                                "target_lang_sense_clarification": "relativo a la universidad o a sus estudiantes"
                            },
                            {
                                "target_lang_word": "colegial",
                                "target_lang_sense_clarification": "relativo a un colegio universitario o escuela"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "068d382e-65e4-3437-82d2-052cc56cf6e4",
                    "sense_definition": "Characterized by the shared responsibility and authority among colleagues; collegial.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooperative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The department thrived because of its warm and highly <w>collegiate</w> atmosphere.",
                            "target_lang_translations": {
                                "es": "El departamento prosperó gracias a su ambiente cálido y sumamente <w>colegial</w>."
                            }
                        },
                        {
                            "text": "The committee made decisions through a <w>collegiate</w> approach to leadership.",
                            "target_lang_translations": {
                                "es": "El comité tomó decisiones mediante un enfoque <w>colegiado</w> de liderazgo."
                            }
                        }
                    ],
                    "synonyms": [
                        "collegial"
                    ],
                    "common_phrases": [
                        "collegiate atmosphere"
                    ],
                    "target_lang_definitions": {
                        "es": "Caracterizado por la responsabilidad y autoridad compartida entre colegas; colegial o colaborativo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "colegial",
                                "target_lang_sense_clarification": "de toma de decisiones compartida o colaborativa"
                            },
                            {
                                "target_lang_word": "colegiado",
                                "target_lang_sense_clarification": "constituido en órgano o grupo común"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3304b96-087f-3590-8403-727f6a496305",
                    "sense_definition": "Of or relating to a collegium or board.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Imperial Russia, an official could hold the civil rank of <w>collegiate</w> assessor.",
                            "target_lang_translations": {
                                "es": "En la Rusia imperial, un funcionario podía ostentar el rango civil de asesor <w>colegiado</w>."
                            }
                        },
                        {
                            "text": "The novel describes the life of a minor <w>collegiate</w> secretary in the capital.",
                            "target_lang_translations": {
                                "es": "La novela describe la vida de un secretario <w>colegiado</w> de menor rango en la capital."
                            }
                        }
                    ],
                    "common_phrases": [
                        "collegiate assessor"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Primarily used in historical contexts regarding administrative collegia"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Perteneciente o relativo a un colegio o junta administrativa en contextos históricos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "colegiado",
                                "target_lang_sense_clarification": "rango o cargo civil histórico"
                            },
                            {
                                "target_lang_word": "de colegio",
                                "target_lang_sense_clarification": "perteneciente a un colegio administrativo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19e279fd-e050-3979-9364-c2bc1beef261",
                    "sense_definition": "A secondary school or high school.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "school",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several local students graduated from the nearby <w>collegiate</w> last spring.",
                            "target_lang_translations": {
                                "es": "Varios estudiantes locales se graduaron del <w>instituto</w> cercano la primavera pasada."
                            }
                        },
                        {
                            "text": "Her parents decided to enroll her in the town's oldest <w>collegiate</w>.",
                            "target_lang_translations": {
                                "es": "Sus padres decidieron matricularla en la <w>escuela secundaria</w> más antigua del pueblo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "collegiate institute"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly Canadian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Escuela secundaria o instituto de enseñanza media (principalmente en Canadá)."
                    },
                    "translations": {
