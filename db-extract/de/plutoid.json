                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cba40fe7-6e9c-46ac-b6b5-dd1cdb552afa",
                                "sense_id": "0d677602-9321-381b-8bb0-ff5ac21c570d",
                                "text": "„Eris zählt zu den Plutoiden, einer Unterklasse von Zwergplaneten, die jenseits der Neptunbahn die Sonne umrunden.“"
                            },
                            {
                                "example_id": "8c237871-4ba0-4bd2-957b-a0e1d6589700",
                                "sense_id": "0d677602-9321-381b-8bb0-ff5ac21c570d",
                                "text": "„Zugleich wurde Haumea als der fünfte Zwergplanet des Sonnensystems anerkannt und somit auch als der vierte Plutoid.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
