                                    }
                                ]
                            },
                            {
                                "target_word": "six",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6745cf32-8787-333a-a1bd-a1af73c60f5f",
                                        "entry_id": "80d51038-14e3-395f-8e35-a0798dd4c8ac",
                                        "glosses": [
                                            "A group or set with six elements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322c6686-b0ce-47e8-8ee1-39b7d1681e24",
                                                "sense_id": "6745cf32-8787-333a-a1bd-a1af73c60f5f",
                                                "text": "Gunshots rang out in the capital Abuja and also in the neighboring Niger state as police lobbed tear gas to disperse defiant protesters. In Niger, at least six people are now feared dead, local media reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84bc976-b659-3846-9d64-aa6bc45ea9e0",
                                        "entry_id": "80d51038-14e3-395f-8e35-a0798dd4c8ac",
                                        "glosses": [
                                            "The digit or figure 6."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dacf21ca-73a1-4316-b7bb-697da139b0cc",
                                                "sense_id": "e84bc976-b659-3846-9d64-aa6bc45ea9e0",
                                                "text": "how about 100 then? for 100, I wanted to pay homage to the people who have been using seximal this entire time. specifically, I used the word for six sixes found in the Ndom language, \"nif\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad92a075-1877-31da-9b6e-31941a395d56",
                                        "entry_id": "80d51038-14e3-395f-8e35-a0798dd4c8ac",
                                        "glosses": [
                                            "A playing card featuring six pips."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54e08b03-3e7c-3df5-af71-210aa62d71a0",
                                        "entry_id": "80d51038-14e3-395f-8e35-a0798dd4c8ac",
                                        "glosses": [
                                            "Six o'clock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4bea664-6302-405d-bf94-bc94bca5b68c",
                                                "sense_id": "54e08b03-3e7c-3df5-af71-210aa62d71a0",
                                                "text": "In Austria the prisoners rise at five, [...]. There are morning prayers at a quarter to six, after which the prisoners are conducted to work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5129408e-7866-35dc-b4e0-c787281841fa",
                                        "entry_id": "80d51038-14e3-395f-8e35-a0798dd4c8ac",
                                        "glosses": [
                                            "Rear, behind (rear side of something)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e7f642d-5ecb-46a6-a95b-6a3df46e1804",
                                                "sense_id": "5129408e-7866-35dc-b4e0-c787281841fa",
                                                "text": "cover my six"
                                            },
                                            {
                                                "example_id": "8357e238-9338-4f31-b0cf-2a5a6895a32d",
                                                "sense_id": "5129408e-7866-35dc-b4e0-c787281841fa",
                                                "text": "Just as having an enemy on your “six” is the hardest situation to escape, being on an enemy at six o'clock is the surest kill. Fighter pilots are always practicing maneuvers to get out from having another aircraft on their six."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "003a4381-52dd-3b78-881d-3fd0745f4d71",
                                        "entry_id": "80d51038-14e3-395f-8e35-a0798dd4c8ac",
                                        "glosses": [
                                            "An event whereby a batsman hits a ball which does not bounce before passing over a boundary in the air, resulting in an award of 6 runs for the batting team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed327506-a20f-4135-8a7d-417c4819c4a2",
                                                "sense_id": "003a4381-52dd-3b78-881d-3fd0745f4d71",
                                                "text": "His century featured 12 sixes."
                                            },
                                            {
                                                "example_id": "9749823c-1d0d-4fc9-8ed7-4d4a9efa75c8",
                                                "sense_id": "003a4381-52dd-3b78-881d-3fd0745f4d71",
                                                "text": "England required 15 from the last over of the regular match. Ben Stokes hit a six and benefited when a throw from the deep hit him and went for four overthrows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d02715-fb1b-390a-ae84-783dbc3b61e3",
                                        "entry_id": "80d51038-14e3-395f-8e35-a0798dd4c8ac",
                                        "glosses": [
                                            "A touchdown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
