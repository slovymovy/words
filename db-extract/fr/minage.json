                                    {
                                        "sense_id": "46a5b40a-b8ec-3574-b7d8-0aedc8997178",
                                        "entry_id": "2c77a697-6877-32d5-b663-0f075a2f9089",
                                        "glosses": [
                                            "The activity of removing solid valuables from the earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c99fc87-0a49-4e15-bfd5-b54f4d19676f",
                                                "sense_id": "46a5b40a-b8ec-3574-b7d8-0aedc8997178",
                                                "text": "gold mining"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "192db038-821c-3cbc-a8d7-f9bd65c34688",
                                        "entry_id": "2c77a697-6877-32d5-b663-0f075a2f9089",
                                        "glosses": [
                                            "Any activity that extracts or undermines."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c94a82-7a9e-46e4-9859-fc3f852117f3",
                                                "sense_id": "192db038-821c-3cbc-a8d7-f9bd65c34688",
                                                "text": "His extensive mining for apparently statistically significant results made any of his results questionable."
                                            },
                                            {
                                                "example_id": "2feeac37-5309-420f-ad1a-e3407ee5cfbc",
                                                "sense_id": "192db038-821c-3cbc-a8d7-f9bd65c34688",
                                                "text": "[…] the fabrick, however weak by the delicacy of its composition, would not have fallen so soon, if the foundation had not been injured by the slow minings of regret and vexation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "033e8075-53e5-3050-9bff-aba597b5f967",
                                        "entry_id": "2c77a697-6877-32d5-b663-0f075a2f9089",
                                        "glosses": [
                                            "The activity of placing mines (the explosive devices)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "830ffbbd-90d4-3c51-a753-23806176ee55",
                                        "entry_id": "2c77a697-6877-32d5-b663-0f075a2f9089",
                                        "glosses": [
                                            "Creation of new units of cryptocurrency by validating transactions and demonstrating proof of work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e0541d-345d-4f30-8056-d1b012521166",
                                                "sense_id": "830ffbbd-90d4-3c51-a753-23806176ee55",
                                                "text": "Kazakhstan became last year the world’s second-largest centre for bitcoin mining after the United States, according to the Cambridge Centre for Alternative Finance, after China clamped down on crypto mining activity."
                                            }
                                        ]
                                    }
                                ]
