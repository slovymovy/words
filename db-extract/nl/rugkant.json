                "senses": [
                    {
                        "sense_id": "313a7d3d-d8d2-30c8-9dd8-303f775d54ef",
                        "entry_id": "146ed89e-5876-3d72-95bc-63f5dfa1098d",
                        "glosses": [
                            "de zijde van de rug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d453e1-45b4-45ec-8bbd-e15ebb84035d",
                                "sense_id": "313a7d3d-d8d2-30c8-9dd8-303f775d54ef",
                                "text": "Bedek de rugkant van de beertjes met behulp van een spatel met een laagje chocolade."
                            },
                            {
                                "example_id": "1e5604f9-37b6-4577-9b70-c7d78e1464f7",
                                "sense_id": "313a7d3d-d8d2-30c8-9dd8-303f775d54ef",
                                "text": "Let er ook altijd op dat de schouderbandjes niet in je huid snijden en dat de onderkant van je bh niet omhoog kruipt. Dat lijkt een open deur, maar lang niet iedereen let erop. Kijk als laatste nog even naar de zijkant van je bh: zit de rugkant even hoog als de cups aan de voorkant? Dan is het zo goed als zeker dat je de juiste maat hebt."
                            },
                            {
                                "example_id": "7f098029-d7ca-4fe0-a0ae-30a659b6e088",
                                "sense_id": "313a7d3d-d8d2-30c8-9dd8-303f775d54ef",
                                "text": "Anatomisch gezien is het baardhaar van mensen buikhaar en hoofdhaar rughaar. Zet een mens op vier poten, en het baardhaar zit aan de buikzijde, terwijl hoofdhaar aan de rugkant zit."
                            }
                        ]
                    },
