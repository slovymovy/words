                ],
                "senses": [
                    {
                        "sense_id": "e02c1264-ad53-319a-9460-e39eef6d5124",
                        "entry_id": "f165474b-1124-3482-9430-a8dacf4d00a9",
                        "glosses": [
                            "Ragoût répandu en Afrique de l’Ouest (Mali, Sénégal, Gambie, Mauritanie etc.) composé de riz et d’une sauce onctueuse à la pâte d’arachide et à la tomate, avec souvent de la chair animale et des légumes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5f68f5-9cf2-456a-bc3c-65e0318cc06c",
                                "sense_id": "e02c1264-ad53-319a-9460-e39eef6d5124",
                                "text": "Un mafé de bœuf."
                            },
                            {
                                "example_id": "e621c496-a047-4246-8d61-4a044f09101b",
                                "sense_id": "e02c1264-ad53-319a-9460-e39eef6d5124",
                                "text": "Un mafé de poulet ou poulet aux arachides."
                            },
                            {
                                "example_id": "ab67ddf9-7558-4cbd-81e0-4f377c77a302",
                                "sense_id": "e02c1264-ad53-319a-9460-e39eef6d5124",
                                "text": "Un mafé du Sénégal."
                            },
                            {
                                "example_id": "c60eff12-0feb-4205-9d87-fe5ce35a8bda",
                                "sense_id": "e02c1264-ad53-319a-9460-e39eef6d5124",
                                "text": "Samba aime le bon mafé"
                            },
                            {
                                "example_id": "69d36994-335d-4e28-aa62-f584dc5d0739",
                                "sense_id": "e02c1264-ad53-319a-9460-e39eef6d5124",
                                "text": "Pour les femmes, la consommation du mafé est due au fait que c’est un plat très facile et moins long à préparer que d’autres plats comme le riz au poisson."
                            }
                        ]
                    }
                ],
