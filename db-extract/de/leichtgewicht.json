                                "target_senses": [
                                    {
                                        "sense_id": "a26fcbf9-2c6f-3f0f-8f5e-d9280306e65d",
                                        "entry_id": "ccacfe85-18ed-3cba-b8fd-d7a5f0c9d312",
                                        "glosses": [
                                            "A particular weight class, or member of such, as prescribed by the rules, between that of the heavier welterweight and the lighter featherweight. See Wikipedia for the specifics of each sport."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56f33c8f-2e2a-31cc-844d-776f126888ec",
                                        "entry_id": "ccacfe85-18ed-3cba-b8fd-d7a5f0c9d312",
                                        "glosses": [
                                            "A particular weight category as prescribed by the rules, separate from an open or heavyweight class."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ccd6673-f2bb-3703-8bd2-c7b92f802155",
                                        "entry_id": "ccacfe85-18ed-3cba-b8fd-d7a5f0c9d312",
                                        "glosses": [
                                            "A competitive weight division as prescribed by the rules, between the heavier middleweight and the lighter featherweight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ccf1076-c77b-3c73-875f-5e7f9ca4c4de",
                                        "entry_id": "ccacfe85-18ed-3cba-b8fd-d7a5f0c9d312",
                                        "glosses": [
                                            "One of little consequence or ability."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b65ba3ee-c328-3541-9031-4a48b73ebaf1",
                                        "entry_id": "ccacfe85-18ed-3cba-b8fd-d7a5f0c9d312",
                                        "glosses": [
                                            "A person who cannot handle their drink; one who gets drunk on very little alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bad2581-a8d4-45dd-a55b-f4440ab6315b",
                                                "sense_id": "b65ba3ee-c328-3541-9031-4a48b73ebaf1",
                                                "text": "\"Wait, is this about the other night when you two lightweights totally went on that bender?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82db76ff-215c-3e94-b616-26e0f3c47967",
                                        "entry_id": "ccacfe85-18ed-3cba-b8fd-d7a5f0c9d312",
                                        "glosses": [
                                            "A person with low endurance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f35d584a-9b41-3185-8da9-3bb4ca2b6757",
                                        "entry_id": "ccacfe85-18ed-3cba-b8fd-d7a5f0c9d312",
                                        "glosses": [
                                            "A political candidate with little chance of winning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lightweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a0dfcaa-2dfc-3b68-bd3c-cec37353ebe8",
                                        "entry_id": "4ccb8a5c-d82c-312f-afdb-395691f7ca73",
                                        "glosses": [
                                            "Lacking in earnestness, ability, or profundity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f8e3166-b337-378b-a841-8152f1de3dc0",
                                        "entry_id": "4ccb8a5c-d82c-312f-afdb-395691f7ca73",
                                        "glosses": [
                                            "Having less than average weight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09a920e4-ed55-4925-8f62-1b4cfdf6ecf9",
                                                "sense_id": "7f8e3166-b337-378b-a841-8152f1de3dc0",
                                                "text": "[…] the Plan incorporates in proper combination every available modern technique, including extensive electrification on the new standard high-voltage a.c. system at a frequency of 50 cycles; main-line diesel traction as a half-way house to electrification; lightweight diesel trains for secondary and branch services; and a smaller wagon fleet doing more work by the use of continuous brakes in conjunction with modernised terminals and marshalling yards."
                                            },
                                            {
                                                "example_id": "57009757-923b-4f84-8799-0236e610b151",
                                                "sense_id": "7f8e3166-b337-378b-a841-8152f1de3dc0",
                                                "text": "For example, lightweight construction and Jacobs bogies save weight, and a lighter train uses less power."
                                            },
                                            {
                                                "example_id": "e5206d0c-7a54-450e-9681-3f11f52f7d14",
                                                "sense_id": "7f8e3166-b337-378b-a841-8152f1de3dc0",
                                                "text": "Speaking of round sunglasses, these lightweight polarized ones and come in two shades of tortoiseshell as well as black and bronze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1598749b-3e3e-3b3d-ab30-2ac23cfaaad4",
                                        "entry_id": "4ccb8a5c-d82c-312f-afdb-395691f7ca73",
                                        "glosses": [
                                            "Lacking in strength."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e0d120-2c30-41e2-857b-98317e88dad0",
                                                "sense_id": "1598749b-3e3e-3b3d-ab30-2ac23cfaaad4",
                                                "text": "With the Gunners far too lightweight in midfield, Mikel Arteta dropped back into a deeper-lying role. This freed Yossi Benayoun to go further forward, a move that helped forge a rare Arsenal chance on 30 minutes when the Israeli released Van Persie, only for the Dutchman's snap-shot to be tipped around the post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc5efb1-2732-3b5e-ba21-83bdd8f7ec4e",
                                        "entry_id": "4ccb8a5c-d82c-312f-afdb-395691f7ca73",
                                        "glosses": [
                                            "Having a small footprint or performance impact."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lightweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f426be5c-47d2-3a29-b688-f8a66fb9cc3f",
                                        "entry_id": "f9b4d0a5-3b30-3980-a885-55bb7bbd0809",
                                        "glosses": [
                                            "To reduce the amount or weight of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fffc0414-d3ab-4491-9629-a0e93304e9ec",
                                                "sense_id": "f426be5c-47d2-3a29-b688-f8a66fb9cc3f",
                                                "text": "By extending the producer’s responsibility to the product’s disposal (its post-consumer life), issues previously outside the business calculus become of paramount importance. Because a producer knows it will have to bear the cost of collecting and valorizing the product, it must manage a new set of business matters. Can the packaging be lightweighted? Are the materials all recyclable?"
                                            },
                                            {
                                                "example_id": "63ac8b25-c27b-4460-8c97-aeb4e4cdedf1",
                                                "sense_id": "f426be5c-47d2-3a29-b688-f8a66fb9cc3f",
                                                "text": "The solar photovoltaic array, GPS antennae and telephony antenna all would be lightweighted and integrated into the balloon structure, and the sensor-module would be ruggedized and miniaturized."
                                            },
                                            {
                                                "example_id": "56c6e6a8-68b1-43cd-aee5-f36ffd511d15",
                                                "sense_id": "f426be5c-47d2-3a29-b688-f8a66fb9cc3f",
                                                "text": "According to Klausner, “lightweighting” all cars and planes in the US would save 121 billion litres of fuel a year and cut carbon emissions by about 5 per cent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
