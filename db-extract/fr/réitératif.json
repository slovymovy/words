                "senses": [
                    {
                        "sense_id": "261af24e-77c9-3a74-967b-50c753567a1a",
                        "entry_id": "29f35314-579a-3c4e-b75f-9f4a6c7ebf39",
                        "glosses": [
                            "Qui est propre à réitérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8a84f97-0a63-4b96-abfc-2159bef0aefd",
                                "sense_id": "261af24e-77c9-3a74-967b-50c753567a1a",
                                "text": "Il ne trouva bon, sans reiteratif commandement du roy, de mettre les galleres entre les mains des imperiaux,"
                            },
                            {
                                "example_id": "45418156-8282-4399-b58a-adba939619cd",
                                "sense_id": "261af24e-77c9-3a74-967b-50c753567a1a",
                                "text": "L’activité de l’esprit/cerveau chamanique est stimulée par un breuvage comme l’ayahuasca en Amazonie ou le peyotl, champignon hallucinogène au Mexique, par le tambour monotone, le chant réitératif, et elle se manifeste dans et par l’état de transe."
                            },
                            {
                                "example_id": "d319f66b-2db3-43fc-86ea-127e750ff8e7",
                                "sense_id": "261af24e-77c9-3a74-967b-50c753567a1a",
                                "text": "Le pronom mesme, reiteratif de la mesme personne, soit nom ou pronom."
                            }
                        ]
                    }
