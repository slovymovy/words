{
    "word_family": [
        "конец",
        "конечный",
        "наконечник",
        "бесконечный",
        "концовка",
        "окончательный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "03e32552-2954-3867-80f9-71a00e09a6ab",
                    "sense_definition": "После всего, спустя продолжительное время; в результате, в итоге.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы долго ждали автобус на остановке, и он <w>наконец</w> приехал.",
                            "target_lang_translations": {
                                "en": "We waited for the bus at the stop for a long time, and it <w>finally</w> arrived.",
                                "zh": "我们在车站等了很久，公交车<w>终于</w>来了。"
                            }
                        },
                        {
                            "text": "После долгих и трудных переговоров стороны <w>наконец</w> подписали важный договор.",
                            "target_lang_translations": {
                                "en": "After long and difficult negotiations, the parties <w>finally</w> signed an important treaty.",
                                "zh": "经过漫长而艰难的谈判，双方<w>最终</w>签署了一份重要协议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в конце концов",
                        "в конечном итоге",
                        "в итоге"
                    ],
                    "common_phrases": [
                        "наконец-то дома",
                        "наконец мы встретились",
                        "наконец наступило лето",
                        "наконец понять суть"
                    ],
                    "target_lang_definitions": {
                        "en": "After everything, after a long time; as a result, in the end.",
                        "zh": "经过长时间的等待或努力后，最终发生某事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finally",
                                "target_lang_sense_clarification": "happening after a long time"
                            },
                            {
                                "target_lang_word": "at last",
                                "target_lang_sense_clarification": "implying relief after a wait"
                            },
                            {
                                "target_lang_word": "eventually",
                                "target_lang_sense_clarification": "occurring in the end"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终于",
                                "target_lang_sense_clarification": "表示经过长时间等待后发生"
                            },
                            {
                                "target_lang_word": "最终",
                                "target_lang_sense_clarification": "表示事情的结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e84e1f4-4b6d-3be4-9e23-acf7928db7f3",
                    "sense_definition": "Употребляется как вводное слово для присоединения последнего, заключительного члена перечисления или вывода; и ещё, кроме всего.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот метод лечения дешёвый, быстрый и, <w>наконец</w>, совершенно безопасный для пациента.",
                            "target_lang_translations": {
                                "en": "This treatment method is cheap, fast, and, <w>finally</w>, completely safe for the patient.",
                                "zh": "这种治疗方法既便宜又快捷，而且<w>最后</w>，它对患者完全安全。"
                            }
                        },
                        {
                            "text": "Я не хочу туда идти, да и, <w>наконец</w>, у меня совсем нет свободного времени.",
                            "target_lang_translations": {
                                "en": "I don't want to go there, and, <w>finally</w>, I have absolutely no free time.",
                                "zh": "我不想去那里，而且<w>最后</w>，我根本没有空闲时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в заключение"
                    ],
                    "common_phrases": [
                        "и наконец последнее",
                        "ну и наконец"
                    ],
                    "target_lang_definitions": {
                        "en": "Used as an introductory word to add the last, concluding member of a list or conclusion.",
                        "zh": "用于列举事项时，引出最后一点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finally",
                                "target_lang_sense_clarification": "introducing the last point"
                            },
                            {
                                "target_lang_word": "lastly",
                                "target_lang_sense_clarification": "in the last place"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后",
                                "target_lang_sense_clarification": "用于列举的末尾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3ed33bf-8f80-32cf-b86f-6cf92a1c8150",
                    "sense_definition": "Употребляется для выражения нетерпения, досады, недовольства или при усилении просьбы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Да перестаньте вы <w>наконец</w> шуметь, я пытаюсь сосредоточиться!",
                            "target_lang_translations": {
                                "en": "Stop making noise <w>at last</w>, I am trying to concentrate!",
                                "zh": "你们<w>到底</w>能不能别吵了，我正试着集中注意力呢！"
                            }
                        },
                        {
                            "text": "Ты ответишь мне <w>наконец</w> на вопрос или будешь продолжать молчать?",
                            "target_lang_translations": {
                                "en": "Will you <w>finally</w> answer my question or will you continue to be silent?",
                                "zh": "你<w>到底</w>要不要回答我的问题，还是打算继续沉默？"
                            }
                        }
                    ],
                    "synonyms": [
                        "в конце концов"
                    ],
                    "common_phrases": [
                        "да замолчи наконец",
                        "прекрати наконец",
                        "скажи наконец правду"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express impatience, annoyance, dissatisfaction, or to emphasize a request.",
                        "zh": "用于表达不耐烦、恼火或加强语气。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finally",
                                "target_lang_sense_clarification": "expressing impatience"
                            },
                            {
                                "target_lang_word": "at last",
                                "target_lang_sense_clarification": "expressing annoyance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到底",
                                "target_lang_sense_clarification": "用于疑问句或祈使句中加强语气"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}