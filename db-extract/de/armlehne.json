                    },
                    {
                        "translation_id": "90fe6f16-ea29-4a24-9eac-73a598a96b1c",
                        "source_entry_id": "f535a232-31c0-31dc-8b42-445dc2afb2b0",
                        "source_sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                        "source_sense_description": "Ablagefläche am Rand eines Stuhles, Sessels oder Ähnlichem, die zum Abstützen der Arme dient",
                        "target_lang_word": "accoudoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accoudoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26d65242-a875-3b82-96d5-e66271ed5a1c",
                                        "entry_id": "970b1d46-721b-3d6a-9d89-b600a761743c",
                                        "glosses": [
                                            "Ce qui est fait pour qu’on s’y accoude ; partie horizontale sur le haut du dossier d’un siège où on s’accoude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5da01b7-4f2b-4b04-a022-ba9294dc87a6",
                                                "sense_id": "26d65242-a875-3b82-96d5-e66271ed5a1c",
                                                "text": "Avoir un accoudoir sous le bras."
                                            },
                                            {
                                                "example_id": "a6109ea4-ebc5-44de-9871-b537363be1a4",
                                                "sense_id": "26d65242-a875-3b82-96d5-e66271ed5a1c",
                                                "text": "L’accoudoir d’un prie-Dieu."
                                            },
                                            {
                                                "example_id": "4cbdb86f-9562-4728-91ae-e4b46cd7e006",
                                                "sense_id": "26d65242-a875-3b82-96d5-e66271ed5a1c",
                                                "text": "Avoir les bras sur un accoudoir."
                                            },
                                            {
                                                "example_id": "95dd7367-7332-459f-8c49-1b9b73def687",
                                                "sense_id": "26d65242-a875-3b82-96d5-e66271ed5a1c",
                                                "text": "L’accoudoir de son prie-Dieu était usé par ses prières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af21f0a8-312a-3970-8502-0b3169f7c631",
                                        "entry_id": "970b1d46-721b-3d6a-9d89-b600a761743c",
                                        "glosses": [
                                            "Accotoir, bras d'un siège, sur lequel on repose les bras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d0630da-fee0-4b3a-8b63-f5198f7fff32",
                                                "sense_id": "af21f0a8-312a-3970-8502-0b3169f7c631",
                                                "text": "Puis, s'appuyant sur les accoudoirs de cuir usé, Gérard sortit sa grande carcasse du confortable fauteuil et se redressa."
                                            },
                                            {
                                                "example_id": "2a0883f4-eb46-40ff-8cd9-05bc15aec103",
                                                "sense_id": "af21f0a8-312a-3970-8502-0b3169f7c631",
                                                "text": "Je l’ai vu en photo, sur un canapé en velours, tapotant de la main sur l’accoudoir, avec ses cheveux invariablement blancs et son air de pythie grecque assise sur les fumerolles de l’île de Ré."
                                            },
                                            {
                                                "example_id": "fe083086-e9d7-4675-ba58-1bc67af17b77",
                                                "sense_id": "af21f0a8-312a-3970-8502-0b3169f7c631",
                                                "text": "C’était en fait des sortes de fauteuils larges et profonds, recouverts de tissu à motifs floraux façon tapisserie, avec des accoudoirs rembourrés et des appuis-tête à oreillettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8ca5fe4-4b87-3679-8873-f686594c7788",
                                        "entry_id": "970b1d46-721b-3d6a-9d89-b600a761743c",
                                        "glosses": [
                                            "Couronnement d’une balustrade ou de tout autre appui à la hauteur du coude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d30c3eb-f6a4-47e8-b3dd-5b16143d017b",
                        "source_entry_id": "f535a232-31c0-31dc-8b42-445dc2afb2b0",
                        "source_sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                        "source_sense_description": "Ablagefläche am Rand eines Stuhles, Sessels oder Ähnlichem, die zum Abstützen der Arme dient",
                        "target_lang_word": "accotoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accotoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                        "entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
                                        "glosses": [
                                            "ou Ce qui sert à s’accoter, appuis pour les bras disposés sur les côtés d'un siège, communément appelés accoudoirs."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da74146-81e0-4afe-abd7-71780d2d46ad",
                                                "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                                "text": "Les accotoirs d’un fauteuil, d’un confessionnal."
                                            },
                                            {
                                                "example_id": "2de0599c-9556-4109-bad3-65c9cfcebfb5",
                                                "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                                "text": "Cela vous servira d’accotoir."
                                            },
                                            {
                                                "example_id": "9b979aa9-f00b-4164-9e8c-f8930dbea88f",
                                                "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                                "text": "Le dossier du fauteuil se redresse, sur lequel se rattache perpendiculairement l'accotoir."
                                            },
                                            {
                                                "example_id": "257562b4-1e23-4bdc-8f89-3cc3f3be2805",
                                                "sense_id": "a56353f1-488e-3282-9b5c-b16381eb1990",
                                                "text": "L’Américaine se couchait sur le tapis, démolissant les coussins, les attirant sous elle, en calant son dos et ses bras, cherchant longuement et presque voluptueusement un paresseux allongement appuyé à de mollets accotoirs ; puis la Tompkins allumait une cigarette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9579733c-9d50-35bf-999b-17a3af6cb392",
                                        "entry_id": "eebe1c9a-04b4-3133-b2e8-724371be9059",
                                        "glosses": [
                                            "Tout objet qui sert à s'accoter ou à accoter quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76b0bc0f-6b6c-3cd2-a057-673848b7d857",
