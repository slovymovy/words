                ],
                "senses": [
                    {
                        "sense_id": "698c4f9a-f8bb-347c-b3d2-b96a47534fc0",
                        "entry_id": "58550121-a544-3cc0-9a6c-3f1f61e5eaef",
                        "glosses": [
                            "Bewegung durch die Luft mit einem Segelflugzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5359730-3a9d-4a36-a70d-229d8768a087",
                                "sense_id": "698c4f9a-f8bb-347c-b3d2-b96a47534fc0",
                                "text": "„In Auslegung der LuftVO und in Anlehnung an den Segelflug enthält die Hängegleiterbetriebsordnung besondere Regeln für Hang- und Thermikflug, um die Flugbewegungen zu koordinieren, […].“"
                            },
                            {
                                "example_id": "eb1b03e7-3f7f-4fdb-992c-6f09bb57dc04",
                                "sense_id": "698c4f9a-f8bb-347c-b3d2-b96a47534fc0",
                                "text": "„Nicht nur im Motorflug, sondern auch im Segelflug finden sich überzogene Flugzustände oder gar Trudeln regelmäßig als Ursache von Unfällen in den Statistiken der BfU."
                            },
                            {
                                "example_id": "2078e642-b043-4d18-a8ce-e20e59855f03",
                                "sense_id": "698c4f9a-f8bb-347c-b3d2-b96a47534fc0",
                                "text": "„Seine aerodynamischen Erkenntnisse aus dem Studium des Windes und der Vogelflügel waren die Grundlage für den modernen Segelflug.“"
                            },
                            {
                                "example_id": "41fa4c5d-3e9e-4c8f-93b4-2aaa3c185bdd",
                                "sense_id": "698c4f9a-f8bb-347c-b3d2-b96a47534fc0",
                                "text": "„Sand und Heide erwärmen sich bei Sonneneinstrahlung schnell und geben die Wärme in Form der für den Segelflug erforderlichen Thermik wieder ab.“"
                            },
                            {
                                "example_id": "4d92a5af-c2c2-40d8-a6dc-163f1ce83df2",
                                "sense_id": "698c4f9a-f8bb-347c-b3d2-b96a47534fc0",
                                "text": "„Trotz des scharfen Windes – da weht noch etwas anderes: Sie nennen es hier den Rhöngeist, und sie meinen damit den nie zu Ende geträumten Traum vom Fliegen, die Zähigkeit, die Leidenschaft und die Erinnerung an die Pionierzeit des Segelflugs.“"
                            },
                            {
                                "example_id": "6fb11efc-dff7-4dc6-b019-07e73df3321b",
                                "sense_id": "698c4f9a-f8bb-347c-b3d2-b96a47534fc0",
                                "text": "„Mit Flair 30, einem superleichten Gleiter (36 Kilogramm), schlug der Erfinder schließlich eine Brücke zwischen Segelflug und Drachenflug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
