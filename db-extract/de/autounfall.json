                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "769e0f0b-16ff-4eed-8983-1e8c8a87feab",
                        "source_entry_id": "06e556f3-700b-337d-96d2-acb2d1554146",
                        "source_sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
                        "source_sense_description": "ein Unfall mit, durch, in einem Auto; ein Verkehrsunfall mit einem beteiligten Kraftfahrzeug",
                        "target_lang_word": "car crash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "car crash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "824b2b7a-8f33-3579-b5ce-6c26dfd244e3",
                                        "entry_id": "7803e83f-041d-3cf5-bc6f-3a5dd3e8bf20",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see car, crash."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2219eafb-1685-30c3-a523-f3002e932a0c",
                                        "entry_id": "7803e83f-041d-3cf5-bc6f-3a5dd3e8bf20",
                                        "glosses": [
                                            "A mess or disaster, especially one that attracts a lot of attention."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a95d83d-8a2b-4c6b-b593-7e661062c240",
                                                "sense_id": "2219eafb-1685-30c3-a523-f3002e932a0c",
                                                "text": "In this instance the departure is radical: this is a real car crash of a ballad, impacted (the beginning and end have crushed together) and distorted, yet still recognizable."
                                            },
                                            {
                                                "example_id": "1c7ce73c-1cbc-4811-83a3-c3631697595b",
                                                "sense_id": "2219eafb-1685-30c3-a523-f3002e932a0c",
                                                "text": "Some presenters are very good at thinking on their feet, and some presenters can't even think whether they're on their feet or sitting down. That can lead to car crash TV, and sometimes the viewers quite like it."
                                            },
                                            {
                                                "example_id": "66b5ce92-eb5d-4c1e-b0b7-ddb984e9b65d",
                                                "sense_id": "2219eafb-1685-30c3-a523-f3002e932a0c",
                                                "text": "He's probably forgotten about that part of our exchange already. I mean, the rest of it wasn't a total car crash ... was it?"
                                            },
                                            {
                                                "example_id": "56ed583e-30e5-4cf5-b07d-9f0c4fd29f55",
                                                "sense_id": "2219eafb-1685-30c3-a523-f3002e932a0c",
                                                "text": "'I'm glad one of us has a life that isn't a total car crash,' Jules said with a sad smile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bf3933e-0c83-451d-b456-d5bb53f385bc",
                        "source_entry_id": "06e556f3-700b-337d-96d2-acb2d1554146",
                        "source_sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
