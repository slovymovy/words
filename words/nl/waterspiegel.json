{
    "word_family": [
        "water",
        "spiegel",
        "spiegelen",
        "waterpeil"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e1769d0-9297-3593-bd63-036d0a5e5271",
                    "sense_definition": "Het vlakke, spiegelende oppervlak van een watermassa.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wateroppervlak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bomen weerspiegelden prachtig in de rimpelloze <w>waterspiegel</w> van het meer.",
                            "target_lang_translations": {
                                "en": "The trees reflected beautifully in the ripple-free <w>water surface</w> of the lake."
                            }
                        },
                        {
                            "text": "Een gladde <w>waterspiegel</w> kan als een natuurlijke spiegel dienen.",
                            "target_lang_translations": {
                                "en": "A smooth <w>water surface</w> can serve as a natural mirror."
                            }
                        }
                    ],
                    "synonyms": [
                        "wateroppervlak",
                        "watervlak"
                    ],
                    "common_phrases": [
                        "gladde waterspiegel",
                        "rimpelloze waterspiegel"
                    ],
                    "target_lang_definitions": {
                        "en": "The flat, reflective surface of a body of water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "water surface",
                                "target_lang_sense_clarification": "the physical surface of water"
                            },
                            {
                                "target_lang_word": "surface of the water",
                                "target_lang_sense_clarification": "the top layer of a body of water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "214a9498-c7a6-3069-8db4-11de9dd83409",
                    "sense_definition": "De hoogte of het niveau van het wateroppervlak; de waterstand.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "waterniveau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de aanhoudende droogte is de <w>waterspiegel</w> in de rivier drastisch gedaald.",
                            "target_lang_translations": {
                                "en": "Due to the persistent drought, the <w>water level</w> in the river has dropped drastically."
                            }
                        },
                        {
                            "text": "De daling van de <w>waterspiegel</w> zorgt voor problemen bij de scheepvaart.",
                            "target_lang_translations": {
                                "en": "The drop in the <w>water level</w> is causing problems for shipping."
                            }
                        }
                    ],
                    "common_phrases": [
                        "daling van de waterspiegel",
                        "stijging van de waterspiegel"
                    ],
                    "target_lang_definitions": {
                        "en": "The height or level of the water surface; the water level."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "water level",
                                "target_lang_sense_clarification": "the height of water in a river, lake, or reservoir"
                            },
                            {
                                "target_lang_word": "water table",
                                "target_lang_sense_clarification": "the level below which the ground is saturated with water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}