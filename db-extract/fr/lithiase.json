                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98ef13ff-5f6e-47ed-af4b-a85c98687c7a",
                                                "sense_id": "2ad6079c-c660-3a6f-b0c8-19e8fd048825",
                                                "text": "Am Pranger hängt ein Stein, der Lästerstein, als Zeichen der Gerichtsbarkeit auf dem Markt."
                                            },
                                            {
                                                "example_id": "44229c0a-1ac4-40b7-a528-24f90df31174",
                                                "sense_id": "2ad6079c-c660-3a6f-b0c8-19e8fd048825",
                                                "text": "„Als er den Stein zurechtrückte, zerschrammte er sich die Schulter und riß sie auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "7a898e87-6895-382d-80a4-7d9d97ea5826",
