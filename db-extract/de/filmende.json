                    {
                        "sense_id": "f8b066af-335f-3efe-8629-5c795463fd14",
                        "entry_id": "e5987326-f193-3750-a553-7eb967d0fa22",
                        "glosses": [
                            "weibliche Person, die einen Film dreht/aufnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32cd808e-6900-4eb1-b4e2-4f1c95d8020d",
                                "sense_id": "f8b066af-335f-3efe-8629-5c795463fd14",
                                "text": "„Anhand von im Bild sichtbaren Bauten und Verkehrsschildern lässt sich verifizieren, wo der oder die Filmende gestanden haben muss […].“"
                            },
                            {
                                "example_id": "964c8b19-e9c1-417f-b0c9-bc7016214021",
                                "sense_id": "f8b066af-335f-3efe-8629-5c795463fd14",
                                "text": "„Der/Die Filmende steht oben auf einer Treppe und filmt nach unten mit Blick auf den Darsteller, der sich an der unteren Stufe befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
