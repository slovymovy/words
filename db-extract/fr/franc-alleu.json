                "entry_id": "ef2b6fe5-1ae1-3bd0-9be6-b0c154c97904",
                "word": "franc-alleu",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "679318fe-34d5-40cf-b914-e556b36aa009",
                        "entry_id": "ef2b6fe5-1ae1-3bd0-9be6-b0c154c97904",
                        "tags": [
                            "plural"
                        ],
                        "form": "francs-alleux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bb06502-5973-316a-81f6-518255153634",
                        "entry_id": "ef2b6fe5-1ae1-3bd0-9be6-b0c154c97904",
                        "glosses": [
                            "Fonds de terre, soit noble, soit roturier, exempt de tous les droits et devoirs féodaux."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": [
                            {
                                "example_id": "e5c7d7af-c504-4d68-a504-94068b9086c6",
                                "sense_id": "0bb06502-5973-316a-81f6-518255153634",
                                "text": "Toutefois, les cultivateurs conservaient libres les terres qui leur avaient été concédées et qu'on appelait terres de franc-alleu."
                            },
                            {
                                "example_id": "f694af98-de2d-4cbe-b78f-6eef63d43a6d",
                                "sense_id": "0bb06502-5973-316a-81f6-518255153634",
                                "text": "Le 24 mars 1287, Baudouin d'Orchimont reprit en fief de Jeanne, comtesse de Rethel, sa terre de Romery qu'il tenait auparavant en franc-alleu, et tout ce qu'il pouvait avoir au village de Feuchères."
                            },
                            {
                                "example_id": "16ab36ab-91cb-4bed-9f37-f8c2a73270fe",
                                "sense_id": "0bb06502-5973-316a-81f6-518255153634",
                                "text": "Jusqu'en 1692, les seigneurs souverains, ou rois, d'Yvetot tenaient leur terre en franc-alleu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cb14082-57d4-45dd-b058-0381ca825423",
                        "source_entry_id": "ef2b6fe5-1ae1-3bd0-9be6-b0c154c97904",
                        "source_sense_id": "0bb06502-5973-316a-81f6-518255153634",
                        "target_lang_word": "Allod",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allod",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                        "entry_id": "e9923e2b-566c-3272-b175-ddd4dd52a2e0",
                                        "glosses": [
                                            "Grundbesitz, der einem Adeligen, der Kirche oder einem Bauern gehörte ohne Abhängigkeiten von einem Obereigentümer"
                                        ],
                                        "tags": [
                                            "Mittelalter",
                                            "frühe Neuzeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a027b2e-0b55-44ef-9273-a106e0d4f492",
                                                "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                                "text": "„Mit seiner Zustimmung erfolgte im November 1196 seitens Otto’s II. die Lehnsauftragung der markgräflichen Allode in der Alt- und Mittelmark an das Erzstift Magdeburg.“"
                                            },
                                            {
                                                "example_id": "3b12fa0b-dcb8-4f23-928b-4c375b60511c",
                                                "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                                "text": "„Da stellte es sich heraus, daß der Junker an den Schwiegersohn des Amtmanns, Jón von Vatn, sein Allod und väterliches Erbe Braedratunga samt dazugehörender beweglicher Habe verkauft hatte; und der neue Besitzer war mit dem Amtmann auf dem Wege zum Thing zusammen mit zwei Abschätzern gekommen, um den Viehbestand und die Gebäude, über die man beim Kauf noch keine endgültige Absprache getroffen, zu taxieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
