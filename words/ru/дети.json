                    "sense_definition": "Мальчики и девочки в раннем возрасте",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "young_humans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На детской площадке весело играют <w>дети</w>.",
                            "target_lang_translations": {
