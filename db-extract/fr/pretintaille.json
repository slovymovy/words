                    },
                    {
                        "sense_id": "bba32ede-b874-388d-9704-5c47ee5b0376",
                        "entry_id": "5c16e4ac-dd3e-377b-a89d-7c65bced757e",
                        "glosses": [
                            "Les légers accessoires qui accompagnent une chose, qui en dépendent."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c6d605e1-1db9-4525-94ea-0b893c156761",
                                "sense_id": "bba32ede-b874-388d-9704-5c47ee5b0376",
                                "text": "Nos peintres les surpassèrent en se servant d’eux, comme nos jardins de France font oublier les jardins d’Italie dont ils sortirent, et dont ils évitèrent la verbosité et les prétintailles."
                            },
                            {
                                "example_id": "f9d06f92-e394-4f83-91d5-7ced5526121d",
                                "sense_id": "bba32ede-b874-388d-9704-5c47ee5b0376",
                                "text": "Cette charge coûte telle somme, sans compter les pretintailles."
                            },
                            {
                                "example_id": "a2bcffd0-929a-42c1-9e40-bbc12a65b41d",
                                "sense_id": "bba32ede-b874-388d-9704-5c47ee5b0376",
                                "text": "Il a gagné son procès avec les pretintailles."
                            },
                            {
                                "example_id": "c7d66f93-caa4-48a6-ab65-89a69112a9fc",
                                "sense_id": "bba32ede-b874-388d-9704-5c47ee5b0376",
                                "text": "Une noce entre amis! Noce de paysans! Pas de cérémonies et pas de prétintailles! On boira tout à l'heure à même les futailles!"
                            }
                        ]
                    },
                    {
                        "sense_id": "f86f24f0-59d8-303b-8b32-4efa1d8eeaff",
                        "entry_id": "5c16e4ac-dd3e-377b-a89d-7c65bced757e",
                        "glosses": [
                            "Au jeu de l'hombre, nom de chacune des 14 combinaisons qui compliquent ce jeu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca20156a-5035-457a-a8fa-38227ad25000",
                                "sense_id": "f86f24f0-59d8-303b-8b32-4efa1d8eeaff",
                                "text": "Les pretintailles , qui d'abord se sont introduites dans les jupes et dans les écharpes, sont passées de là dans le jeu de l'Hombre."
                            }
                        ]
