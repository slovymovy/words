                        "glosses": [
                            "Faire devenir multinational."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2994f097-2831-4908-b8a3-052b0712dfbe",
                                "sense_id": "cdb26168-675b-3286-9fd8-31c401c38626",
                                "text": "L'ouvrage s'achève par une typologie des multinationales publiques (ch. 7), les regroupant en neuf classes en croisant deux critères : la propension de l'entreprise à multinationaliser ses activités et la propension de l'État à intervenir dans la gestion de l'entreprise."
                            },
                            {
                                "example_id": "ccd1b4e8-2f8b-4a8e-aafd-39efadbff006",
                                "sense_id": "cdb26168-675b-3286-9fd8-31c401c38626",
                                "text": "Elles peuvent aussi se multinationaliser dans le cadre de la sous-traitance avec de grandes firmes devenues multinationales."
                            }
                        ]
                    }
