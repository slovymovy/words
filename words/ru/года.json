                    "sense_definition": "Форма родительного падежа единственного числа существительного <w>год</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моему младшему брату исполнилось четыре <w>года</w>.",
                            "target_lang_translations": {
                                "en": "My younger brother turned four <w>years</w> old.",
                                "de": "Mein jüngerer Bruder ist vier <w>Jahre</w> alt geworden.",
                                "pl": "Mój młodszy brat skończył cztery <w>lata</w>."
                            }
                        },
                        {
                            "text": "В конце <w>года</w> мы планируем поехать в отпуск.",
                            "target_lang_translations": {
                                "en": "At the end of the <w>year</w> we plan to go on vacation.",
                                "de": "Am Ende des <w>Jahres</w> planen wir in den Urlaub zu fahren.",
                                "pl": "Pod koniec <w>roku</w> planujemy wyjechać na urlop."
                            }
                        }
                    ],
                    "common_phrases": [
