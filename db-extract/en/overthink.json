                    {
                        "translation_id": "4e0e22d9-45a6-4c94-9edc-e9581585367e",
                        "source_entry_id": "0f759a30-c3ff-3cc1-8760-dcc30136ac02",
                        "source_sense_description": "to think or analyze too much",
                        "target_lang_word": "zerdenken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerdenken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23eb3861-8a09-3d54-85ee-f85184c4c317",
                                        "entry_id": "2484ed0b-c098-3645-8865-b048f97c699f",
                                        "glosses": [
                                            "sehr lange grübeln/analysieren (denken); zum Beispiel, um etwas hinter sich zu lassen oder die Brisanz abzumildern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea8e5a7-78c6-477b-ad4e-44f02b66faff",
                                                "sense_id": "23eb3861-8a09-3d54-85ee-f85184c4c317",
                                                "text": "„Etwas zu zerdenken hat mich persönlich zumindest noch nie zum Ziel geführt. Auch wenn du denkst und denkst und sich plötzlich negative Emotionen auftun, bist du auf dem besten Weg dazu, dein Problem zu zerdenken.“"
                                            },
                                            {
                                                "example_id": "f05e3bd7-56fd-4ef8-9555-581e59a57a06",
                                                "sense_id": "23eb3861-8a09-3d54-85ee-f85184c4c317",
                                                "text": "„Das meint Handke auch selbst in der kryptischen Darstellung seiner Formenstrategie: Die naturalistischen Formen zerdenken, bis sich die didaktischen, zeigenden ergeben, die didaktischen Formen zerdenken, bis sich mythische ergeben.“"
                                            },
                                            {
                                                "example_id": "8cae6459-0d6f-4fba-adf2-2851678af5e3",
                                                "sense_id": "23eb3861-8a09-3d54-85ee-f85184c4c317",
                                                "text": "„Ich, die alles zerdachte, die bereits Zerdachtes hin- und herwendete, um es von allen Seiten zu betrachten und anschließend zerlegte, um es, nun ja, zu zerdenken, traf auf einer paradiesischen Insel jemanden, der die nötige Portion Klarheit in mein Leben brachte.“"
                                            },
                                            {
                                                "example_id": "4a7ffd8a-5070-4e7d-998f-762c7d46f87c",
                                                "sense_id": "23eb3861-8a09-3d54-85ee-f85184c4c317",
                                                "text": "„[…] ja verwegene Denker zerdachten zuletzt sogar Schöpfer und Geschöpf […]“ (1851)"
                                            },
                                            {
                                                "example_id": "81b075a9-02b0-4a4c-83cf-74b9b73b357e",
                                                "sense_id": "23eb3861-8a09-3d54-85ee-f85184c4c317",
                                                "text": "„Dem Satz vom Grunde oder etwa dem Syllogismus gegenüber bin ich imstande, ihn ganz zu zerdenken. Dagegen kann es unmöglich zu einem Zerdenken des Wollens oder der Körperbewegungen oder der Herbartschen Realen kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
