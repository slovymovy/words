            {
                "entry_id": "714c847f-cf98-34c6-a5dc-8dee6da79740",
                "word": "jambière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "61f20606-bf1a-4e13-863f-328938f65f18",
                        "entry_id": "714c847f-cf98-34c6-a5dc-8dee6da79740",
                        "tags": [
                            "plural"
                        ],
                        "form": "jambières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33da7d09-6558-3606-8f9d-c93a1661df30",
                        "entry_id": "714c847f-cf98-34c6-a5dc-8dee6da79740",
                        "glosses": [
                            "Pièce d’étoffe ou de cuir, voire de métal, guêtre haute qui protège la jambe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d69a99-79fc-4517-9994-cadb7dd8bfbe",
                                "sense_id": "33da7d09-6558-3606-8f9d-c93a1661df30",
                                "text": "Francine, qui se trouvait à Château-Gallé, avait ciré ses souliers et ses jambières ; il la remercia sans beaucoup la regarder et lui tendit une bonne pièce qu’elle n’osa refuser."
                            },
                            {
                                "example_id": "d83a4d27-2e4d-4159-93b7-8ae30e70c9b1",
                                "sense_id": "33da7d09-6558-3606-8f9d-c93a1661df30",
                                "text": "Papa avait acheté une casquette bleue, qui me parut du plus bel effet, des jambières en cuir marron, et des souliers montants à semelle de corde."
                            },
                            {
                                "example_id": "78551b64-d8dd-4dd5-9acc-1f6145b0090d",
                                "sense_id": "33da7d09-6558-3606-8f9d-c93a1661df30",
                                "text": "Le légionnaire tenta de déséquilibrer Kratos pour récupérer son épée toujours prise dans la jambière de ce dernier, mais sans y parvenir."
                            }
                        ]
                    },
                    {
                        "sense_id": "90ec71ac-f02d-318e-9ac3-96a6ae19ad98",
                        "entry_id": "714c847f-cf98-34c6-a5dc-8dee6da79740",
                        "glosses": [
                            "Meuble représentant la pièce d’armure du même nom dans les armoiries. À rapprocher de chaussure, houseau, jambière, poulaine, sabot et soulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e802fd66-2c2b-4dcf-96ca-f9971701c782",
                                "sense_id": "90ec71ac-f02d-318e-9ac3-96a6ae19ad98",
                                "text": "Écartelé, en 1 et 4 d’argent au lion de gueules couronné d’or ; en 2 et 3 d’azur à la jambière d’argent, qui est de la commune de Linter en Belgique → voir illustration « armoiries avec 2 jambières »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "822656ac-4fea-489c-976a-aac42730325a",
                        "source_entry_id": "714c847f-cf98-34c6-a5dc-8dee6da79740",
                        "target_lang_word": "Beinling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beinling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fb018ee-38da-32e4-8319-39f2a84e2c9f",
                                        "entry_id": "c50ce31b-c228-3595-841b-120542691311",
                                        "glosses": [
                                            "Kleidungsstück, das ein Bein oder einen Teil desselben bedeckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "006dc1b5-ef71-49f9-ae0c-353fc2be3ca4",
                                                "sense_id": "8fb018ee-38da-32e4-8319-39f2a84e2c9f",
                                                "text": "„Das Kleid rutschte hoch und ließ den hellgrünen Schlüpfer sehen, am Beinling ausgefranste Stopfstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c61b55e7-739c-4998-aae3-4da50f2dc6b7",
                        "source_entry_id": "714c847f-cf98-34c6-a5dc-8dee6da79740",
                        "target_lang_word": "Gamasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gamasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10e6ddcf-b1bb-3d08-8422-fbc4739c130c",
                                        "entry_id": "6da0a79c-8dcc-3ce1-9dad-079372662442",
                                        "glosses": [
                                            "als oberstes getragenes Kleidungsstück (ohne Sohle und Hacke) zur Bedeckung des Fußes und oft auch des Unterschenkels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1130c8a6-9a86-47ed-b596-41c47f666cc1",
                                                "sense_id": "10e6ddcf-b1bb-3d08-8422-fbc4739c130c",
                                                "text": "„Er begann seine Gamaschen zu wickeln.“"
                                            },
                                            {
                                                "example_id": "6ddfba7d-e5f8-4096-ac1f-418755a147c0",
                                                "sense_id": "10e6ddcf-b1bb-3d08-8422-fbc4739c130c",
                                                "text": "„Allein Ardan gab sich locker und gelöst, führte den Begleitern seine ledernen Gamaschen mit einem von ihm erdachten Schnellknöpfmechanismus vor, suchte sich eine Zigarre aus der Innentasche seines weiten Cordanzugs und steckte sie sich an, ohne daß ihm die Hand dabei zitterte.“"
                                            },
                                            {
                                                "example_id": "473d52a3-2799-4075-84d4-92b2fbeea29b",
                                                "sense_id": "10e6ddcf-b1bb-3d08-8422-fbc4739c130c",
                                                "text": "„Jetzt sitzt er zwischen uns in einem piekfeinen Kammgarnanzug, eine Perle im Schlips und Gamaschen an den Füßen, ein wohlhabender Mann, der das große Wort führt.“"
                                            },
                                            {
                                                "example_id": "e3aaa919-3ee0-40ec-8d0d-506f71d5a7e5",
                                                "sense_id": "10e6ddcf-b1bb-3d08-8422-fbc4739c130c",
                                                "text": "„Er sah die sauberen und wohlgenährten Etappenoffiziere vorbeigehen mit ihren blanken Gamaschen und nachlässig und elegant die armseligen Verwundeten grüßen, die sich bescheiden an die Wand dückten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db8ea3c2-893d-4157-a2fe-c00a992b7979",
                        "source_entry_id": "714c847f-cf98-34c6-a5dc-8dee6da79740",
                        "target_lang_word": "Stulpe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stulpe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15652d77-f4a7-3d38-aabe-2036123265e7",
                                        "entry_id": "3849c10e-60a7-3f8b-86dd-f998740a5c96",
                                        "glosses": [
                                            "umgedrehter Streifen an Kleidungsstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde5bd93-4bb6-4453-a786-03282cdc5c5c",
                                                "sense_id": "15652d77-f4a7-3d38-aabe-2036123265e7",
                                                "text": "„Wer eingestünde, dass er in den 1980ern mit Jeans und Stulpen auf der Piste war, diskreditierte sich im Grunde als Betrachter des Buches ‚The Stylish Life Skiing‘.“"
                                            },
                                            {
                                                "example_id": "ba2c545b-444d-4480-a8a0-da42b95cd5f2",
                                                "sense_id": "15652d77-f4a7-3d38-aabe-2036123265e7",
                                                "text": "„Eine Kugel prallt auf dem Stulpen seines Stiefels auf, und der Dichter kommt noch ziemlich billig mit einer leichten Prellung davon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
