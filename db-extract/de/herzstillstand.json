                ],
                "senses": [
                    {
                        "sense_id": "7082a758-a929-3f59-b39d-342fde023e41",
                        "entry_id": "83759318-8846-37e3-8d25-520c68e415c0",
                        "glosses": [
                            "Ausfall der Herztätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62cfbc02-9fd5-4355-bbfa-8a7601ab2a8d",
                                "sense_id": "7082a758-a929-3f59-b39d-342fde023e41",
                                "text": "„Die vorsichtige Abkehr von der Mund-zu-Mund-Beatmung hänge auch damit zusammen, dass es inzwischen neuere Studien gibt, die zeigen, dass in den ersten Minuten nach einem Herzstillstand in aller Regel noch genug Sauerstoff im Blut vorhanden ist.“"
                            },
                            {
                                "example_id": "adfd4fbb-073b-4292-80cb-c0a346988bb3",
                                "sense_id": "7082a758-a929-3f59-b39d-342fde023e41",
                                "text": "„Es wird plötzlicher Herzstillstand konstatiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08f80094-975e-44bb-ad84-60c599a72cd1",
                        "source_entry_id": "83759318-8846-37e3-8d25-520c68e415c0",
                        "source_sense_id": "7082a758-a929-3f59-b39d-342fde023e41",
                        "source_sense_description": "Medizin: Ausfall der Herztätigkeit",
                        "target_lang_word": "cardiac arrest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardiac arrest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fed4971-31b4-375b-81d3-cbfd015050c8",
                                        "entry_id": "77c48ce2-1390-313e-b0a8-311c4720ab3e",
                                        "glosses": [
                                            "The sudden and complete cessation of the heartbeat resulting in the loss of effective circulation of the blood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d6fb06-e5fe-426d-b1c1-13c0170834f0",
                                                "sense_id": "3fed4971-31b4-375b-81d3-cbfd015050c8",
                                                "text": "She went a few months before Sukumar died, a cardiac arrest in the middle of an afternoon nap, her rickety heart beating one moment, and then no more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a82727bf-d3a1-45f5-b31a-e2f4e83f65c3",
                        "source_entry_id": "83759318-8846-37e3-8d25-520c68e415c0",
                        "source_sense_id": "7082a758-a929-3f59-b39d-342fde023e41",
                        "source_sense_description": "Medizin: Ausfall der Herztätigkeit",
                        "target_lang_word": "arrêt cardiaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrêt cardiaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a941650d-b960-3d37-8012-f441b70d0c9e",
                                        "entry_id": "ea36d4b9-f2dc-3978-b688-2f996f5a7b90",
                                        "glosses": [
                                            "Arrêt de la circulation du sang et de la respiration."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf1a3ea-3859-418b-8788-453765aec07a",
                                                "sense_id": "a941650d-b960-3d37-8012-f441b70d0c9e",
                                                "text": "Dès l’arrivée franchie, il a été terrassé par un arrêt cardiaque. Comme nous savons que c’est fréquent, il est tombé au pied d’une ravissante secouriste de la protection civile qui a commencé les gestes, et les médecins urgentistes du Samu ont été à ses côtés en moins de quatre minutes."
                                            },
                                            {
                                                "example_id": "11d46200-3716-4d45-aa8f-465d9bc8b38c",
                                                "sense_id": "a941650d-b960-3d37-8012-f441b70d0c9e",
                                                "text": "Mr Galen n’avait tout simplement pas eu de chance de faire son arrêt cardiaque juste au moment où elle-même vivait une petite mort, à califourchon sur Mr Deal dans les toilettes pour femmes, derrière un panneau qui disait — fort à propos — HORS SERVICE."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
