                "senses": [
                    {
                        "sense_id": "e75265da-bebc-3b47-91db-a3c817f0269b",
                        "entry_id": "1aa6961a-ce86-3e58-8ce5-bab7aa9cbb7e",
                        "glosses": [
                            "Fleck durch verspritzte Tinte"
