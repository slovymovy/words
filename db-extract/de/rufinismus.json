                "senses": [
                    {
                        "sense_id": "ee2dd9b2-5cfa-3b37-896e-271129775d37",
                        "entry_id": "fe6ad589-0c84-3c82-9e88-ddcd148fd08d",
                        "glosses": [
                            "das Auftreten von rötlicher Haar-, Haut- oder Federfärbung bei dunkelgefärbten Tieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f956f52a-83c1-4ee6-b46e-c7a6eb97c670",
                                "sense_id": "ee2dd9b2-5cfa-3b37-896e-271129775d37",
                                "text": "„Der Rufinismus ist hier wie bei anderen alpinen Coleopteren sicher als klimatisch bedingte Modifikation zu beurteilen.“"
                            },
                            {
                                "example_id": "3c60f886-d3f4-4ccf-98d9-c5bb9793fc0e",
                                "sense_id": "ee2dd9b2-5cfa-3b37-896e-271129775d37",
                                "text": "„Die ebenfalls beobachtete rote Pigmentierung, der Rufinismus, ist nach Somme (1989) vor allem bei Käfern bekannt; […].“"
                            },
                            {
                                "example_id": "35da069c-97d4-47e7-ad34-1c76102442f0",
                                "sense_id": "ee2dd9b2-5cfa-3b37-896e-271129775d37",
                                "text": "„Wir haben also einen ähnlichen Fall von Rufinismus vor Augen wie bei Phosphuga atrata L., deren permanent rotbraune Form als f. brunnea HRBST. bekannt ist.“"
                            },
                            {
                                "example_id": "de7912a5-978a-4c6a-833b-299a3fd3fd0a",
                                "sense_id": "ee2dd9b2-5cfa-3b37-896e-271129775d37",
                                "text": "Rufinismus kann durch das Wegfallen von dunklen Farbpigmenten zustande kommen und wird demgemäß als ein unvollkommener Albinismus aufgefasst."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
