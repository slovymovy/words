                    {
                        "form_id": "7e811051-c13b-4e5d-9065-9b48e9174cb8",
                        "entry_id": "79e780c1-a45e-3028-a7ee-88eddb6f68ab",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "глауко́мах"
