                                        "sense_id": "bbc10b39-5dd1-3bd1-8d58-6bbeccd316d3",
                                        "entry_id": "76af5d92-8db9-3cd6-8210-ea91c42417ac",
                                        "glosses": [
                                            "Vertreter der Familie Alligatoridae innerhalb der Krokodile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aad21d2-7010-45d6-a490-6e7096d4e6fd",
                                                "sense_id": "bbc10b39-5dd1-3bd1-8d58-6bbeccd316d3",
                                                "text": "„Was den Alligator anbelangt, so habe man ihn im November des Jahres 1825 unter den Klippen von Les Hachettes zu Saint-Honorine bei Port-en-Bessin im Arrondissement Bayeux entdeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4022d9e0-c4f0-3798-82ff-9187921a4451",
                                        "entry_id": "76af5d92-8db9-3cd6-8210-ea91c42417ac",
                                        "glosses": [
                                            "Vertreter der Gattung Alligator innerhalb von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15212f3-b95e-426a-a08f-cc14d896f433",
                                                "sense_id": "4022d9e0-c4f0-3798-82ff-9187921a4451",
                                                "text": "Die Alligatoren sind am engsten mit den Kaimanen verwandt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
