                            "target_lang_translations": {
                                "en": "With a <w>raging</w> storm approaching, all fishing boats stayed in the harbor.",
                                "ru": "Из-за приближающегося <w>бушующего</w> шторма все рыбацкие лодки остались в гавани."
                            }
