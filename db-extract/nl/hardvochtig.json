                "senses": [
                    {
                        "sense_id": "f74cae57-c348-3357-a31c-45b29465909e",
                        "entry_id": "dbd3ed91-f971-302d-acb1-550a17f37632",
                        "glosses": [
                            "zonder medelijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37243ad0-e695-422b-9c21-0bbfab4d2e2a",
                                "sense_id": "f74cae57-c348-3357-a31c-45b29465909e",
                                "text": "Het hardvochtige optreden van de huurlingen leidde tot het ontstaan van een verzetsbeweging."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3a65bdd-265f-42b7-9c3c-40401304ee51",
                        "source_entry_id": "dbd3ed91-f971-302d-acb1-550a17f37632",
                        "source_sense_id": "f74cae57-c348-3357-a31c-45b29465909e",
                        "source_sense_description": "zonder medelijden",
                        "target_lang_word": "hartherzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hartherzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                        "entry_id": "8e3fddb8-ef68-30c0-abcf-ab4c0f98c8fc",
                                        "glosses": [
                                            "sich nicht auf das Leid/Unglück anderer einlassend: ohne Mitgefühl/Mitleid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07be5a1b-747c-453a-bff9-bfb5624d20e4",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "Es ist schlicht mitleidlos und hartherzig, Flüchtlinge im Mittelmeer einfach ersaufen zu lassen."
                                            },
                                            {
                                                "example_id": "ac4a3f6c-6ad6-4a86-9f0c-8aaeda464867",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "„Der Mammon ist der ‚Gott‘ des Jedermann. Der reiche Mann führt ein verschwenderisches Leben und ist hartherzig gegenüber den Armen.“"
                                            },
                                            {
                                                "example_id": "3fc77190-47b4-4353-b3a3-b24314ac632a",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "„‚Im Herzen eines Menschen, der jemanden hört, der den Koran singt – der ihn gut singt – kommen Zartgefühl und Reue zum Vorschein, gleich wie lasterhaft und hartherzig dieser Mensch ist.‘ (Mostamli Bohari, persischer Gelehrter des 11. Jahrhunderts)“"
                                            },
                                            {
                                                "example_id": "eb2df2e3-fc8b-40a5-8325-851830463c54",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "[…] nach seinem Tod steckt Mr. Reeds hartherzige Frau die kleine Jane ins düstere Lowood-Stift."
                                            },
                                            {
                                                "example_id": "be45bb70-c8cb-4b3f-b8bc-c848639eb501",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "„Über die Geste und das Schicksal Reems war unter dem Hashtag #merkelstreichelt heftig diskutiert worden. Die Kanzlerin wurde teils als hartherzige oder abgezockte Frau beschimpft.“"
                                            },
                                            {
                                                "example_id": "97433055-b1ca-4d2e-a387-b68300dc3c08",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "„Die Schauspielerin Dana Vavrova als Flüchtlingsfrau Lilli fleht bei einer hartherzigen Chefin […] um Hilfe.“"
                                            },
                                            {
                                                "example_id": "f091369c-94cd-4b83-8c41-e803edc5955c",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "„Der geniale Entenzeichner Carl Barks ließ sich zu [dem] Griesgram [Dagobert, der im Original ‚Uncle Scrooge‘ heißt,] von dem hartherzigen ‚Ebenezer Scrooge‘ in Charles Dickens[’] Weihnachtsgeschichte inspirieren.“"
                                            },
                                            {
                                                "example_id": "434404db-a372-46b8-a2f9-8be87f9e0617",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "„Während des Zweiten Weltkrieges gewährte die Schweiz Flüchtlingen nur sehr beschränkt Zuflucht. Tausende wurden an der Grenze abgewiesen. Gerade für Juden kam dies oft einem Todesurteil gleich. Doch nicht alle Schweizer befolgten diese hartherzige Flüchtlingspolitik.“"
                                            },
                                            {
                                                "example_id": "d516505b-03c9-4c90-aa12-7327f76911a9",
                                                "sense_id": "d4e8b935-1231-3eef-854c-3288c58cf3e5",
                                                "text": "„In einem rechtsstaatlichen Strafverfahren ist formal betrachtet kein Platz für Emotionen. Das klingt hartherzig, ist es aber nicht. Nur mit kühlem Kopf kann es gelingen, bei der […] Suche nach der Wahrheit am Ende erfolgreich zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93f1f9c4-1409-4dd0-8bef-e2fdd7b3feef",
                        "source_entry_id": "dbd3ed91-f971-302d-acb1-550a17f37632",
                        "source_sense_id": "f74cae57-c348-3357-a31c-45b29465909e",
                        "source_sense_description": "zonder medelijden",
                        "target_lang_word": "herzlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herzlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "191457ac-631a-33a6-9356-61701c45f5e5",
                                        "entry_id": "30804383-2715-314c-9194-284768d36058",
                                        "glosses": [
                                            "ohne Mitgefühl; ohne Erbarmen; grausam; unmenschlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3ec681e-d042-4fb9-ae28-cb095ce73a83",
                                                "sense_id": "191457ac-631a-33a6-9356-61701c45f5e5",
                                                "text": "Ihr Vorgesetzter war ein herzloser Mensch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3be18d36-a44f-4540-8c2f-3c9beccec666",
                        "source_entry_id": "dbd3ed91-f971-302d-acb1-550a17f37632",
                        "source_sense_id": "f74cae57-c348-3357-a31c-45b29465909e",
                        "source_sense_description": "zonder medelijden",
                        "target_lang_word": "heartless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heartless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without feeling, emotion, or concern for others; uncaring; cruel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04470f3c-416e-47bb-9f47-fc67a76c8956",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "His heartless actions and cold manner left her saddened and feeling alone."
                                            },
                                            {
                                                "example_id": "c9474884-b764-4116-9122-1762d8a83e97",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "The world is a dangerous, violent place […] and the only true refuge from this heartless world is the family."
                                            },
                                            {
                                                "example_id": "e2d6331d-9c7d-478a-b21f-796eeca4ffbb",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "It's safer to be heartless than mindless. The history of the world is the history of the triumph of the heartless over the mindless."
                                            },
                                            {
                                                "example_id": "7df848d9-85ca-4b57-99f8-998f487af970",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "Mr. Burns is similarly perfectly cast as a heartless capitalist willing to do anything for a quick buck, even if it means endangering the lives of those around him and Marge elegantly rounds out the main cast as a good, pure-hearted and overly indulgent woman who sees the big, good heart (literally and metaphorically) of a monstrous man-brute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6d48e3-f62c-3d6c-9ffc-ca14ac20aabd",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without a physical heart."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a48b5566-1834-3ab8-a951-c1bf57455921",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Listless, unenthusiastic."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014e7ada-b24f-4251-9545-0300018964fa",
                                                "sense_id": "a48b5566-1834-3ab8-a951-c1bf57455921",
                                                "text": "Near-synonyms: spiritless, unhearty"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ff8ba9-9164-37c5-b120-41e88a25d002",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without courage; fearful, cowardly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cccba9a-8f1f-449e-a0a7-2886124832e6",
                                                "sense_id": "36ff8ba9-9164-37c5-b120-41e88a25d002",
                                                "text": "Cecilia then, though almost heartless, resolved upon talking with Mr. Harrel himself […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
