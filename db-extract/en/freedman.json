                        "source_entry_id": "cec3f6f7-dfec-3db8-a13d-6bfc3a5a2430",
                        "source_sense_id": "cf856c18-daad-3fa7-af82-cbbfbb1ec4d9",
                        "source_sense_description": "man who has been released from slavery",
                        "target_lang_word": "vrijgelatene",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vrijgelatene",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "87e522d7-9612-34c2-85eb-f9db8d18a9ba",
                                        "entry_id": "88dc3855-027a-31f6-a243-817051e1f137",
                                        "glosses": [
                                            "vrouwelijke gevangene die is vrijgelaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54810a15-e0ad-4aef-84da-32fe2e073db6",
                                                "sense_id": "87e522d7-9612-34c2-85eb-f9db8d18a9ba",
                                                "text": "Als je vervroegde vrijlating aanvraagt moet je een plan indienen. Hierin moet de huisvesting van de vrijgelatene een rol spelen, vertelt de advocaat van Laetitia Delhez, een van de slachtoffers van Dutroux en Martin. Advocaat Jan Fermont vervolgt: \"Die huisvesting moet controle toelaten en je mag absoluut geen contact met het slachtoffer hebben.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93ba7094-1c4e-4fe9-aa99-24993a6e505e",
                        "source_entry_id": "cec3f6f7-dfec-3db8-a13d-6bfc3a5a2430",
