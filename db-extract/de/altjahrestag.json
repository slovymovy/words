                        "examples": [
                            {
                                "example_id": "d7180da1-1837-48da-8b79-472eafa1e222",
                                "sense_id": "a7664c7a-988f-3e50-a881-cb08e3fc94b3",
                                "text": "„Am Altjahrestag habe ich mit meiner Freundin eine wunderschöne Schitour gemacht.“"
                            },
                            {
                                "example_id": "281d20a5-bfef-4e6d-8e1e-661cb6ef33d8",
                                "sense_id": "a7664c7a-988f-3e50-a881-cb08e3fc94b3",
                                "text": "„Am Weihnachts-Heiligenabend und am Altjahrestag konnten wir wieder Lichterkirche halten.“"
                            },
                            {
                                "example_id": "e19bbb7b-7399-4c6f-8ef5-cb90c05dd7ba",
                                "sense_id": "a7664c7a-988f-3e50-a881-cb08e3fc94b3",
                                "text": "„Ihre Kinder hatten Carole und Harry bereits am frühen Abend des Altjahrestages verabschiedet, da diese direkt von Davos nach Zürich fuhren, um von dort zurück in die Heimat zu fliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
