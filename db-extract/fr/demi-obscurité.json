        "fr-extract.jsonl": [
            {
                "entry_id": "d3c7835b-3b68-3cf4-832a-d4d975e650ea",
                "word": "demi-obscurité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d2452e3-1b61-49d0-a2c7-6f04364b4ec5",
                        "entry_id": "d3c7835b-3b68-3cf4-832a-d4d975e650ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "demi-obscurités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                        "entry_id": "d3c7835b-3b68-3cf4-832a-d4d975e650ea",
                        "glosses": [
                            "Ténèbres incomplètes, demi-jour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82746756-6c3d-49c8-96c4-6c6978e17ee3",
                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                "text": "Quand le soleil est trop vif, des stores de sparterie qu’on abat sur les fenêtres entretiennent cette demi-obscurité pleine de fraîcheur, qui fait des églises d’Espagne des lieux si favorables au recueillement et à la prière."
                            },
                            {
                                "example_id": "6b9c215c-25d3-44a0-a521-4773a711e591",
                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                "text": "Il ne répondait à personne, et continuait de regarder devant lui sans dire un mot, avec cet air d’inquiétude qui lui-même était un attrait, et cet étrange regard qui flottait dans la demi-obscurité du salon comme une étincelle impossible à fixer."
                            },
                            {
                                "example_id": "c52ebfdd-3af2-49a2-a121-f8937efd199e",
                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                "text": "La nuit tombait, silencieuse ; et cet immense champ de neige prenait dans la demi-obscurité du crépuscule je ne sais quel aspect de profonde mélancolie."
                            },
                            {
                                "example_id": "c371a073-43cd-487c-8bac-ca28a7d74032",
                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                "text": "Puis, comme ses yeux s’accoutumaient à la demi-obscurité, elle finit par apercevoir l’oncle."
                            },
                            {
                                "example_id": "f70d63ef-01f4-4d0c-8486-8970ace0a29a",
                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                "text": "Elle entre dans une chambre noire. On a fait la demi-obscurité, car la lumière est, paraît-il, fatigante."
                            },
                            {
                                "example_id": "ba12f832-7e48-4a97-a9cc-498366184031",
                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                "text": "Il régnait dans la chambre une demi-obscurité."
                            },
                            {
                                "example_id": "82c39a8d-a7dd-4be5-8448-b8ec9c87468f",
                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                "text": "Aussitôt, en effet, il avisa dans la demi-obscurité, car les rideaux de la fenêtre étaient presque fermés, un homme à genoux, et, gisant sur le tapis, une femme que cet homme tenait à la gorge des deux mains."
                            },
                            {
                                "example_id": "7af3777c-a411-49f2-a528-212593246215",
                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                "text": "La demi-obscurité était trouée, au fond, à gauche, par la zone laiteuse de l'estrade où s'agitait un groupe de musiciens de rock'n'roll."
                            }
                        ]
                    }
                ],
