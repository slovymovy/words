                ],
                "senses": [
                    {
                        "sense_id": "169fcc20-7b92-3672-af33-7a479a8a3cc0",
                        "entry_id": "42e0c8c9-3a35-3b88-a464-edb57531ea42",
                        "glosses": [
                            "Leiter eines Landwirtschaftsministeriums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d0533e-10a4-4418-a0cb-da1c5c685aff",
                                "sense_id": "169fcc20-7b92-3672-af33-7a479a8a3cc0",
                                "text": "Der Landwirtschaftsminister plant eine Reform der Agrarmarktverordnung."
                            },
                            {
                                "example_id": "6a7e9bc1-9cdb-4313-beda-d51b7b8b26a9",
                                "sense_id": "169fcc20-7b92-3672-af33-7a479a8a3cc0",
                                "text": "„Von Praktiken wie der Gatterjagd und der Jagd auf gezüchtete und ausgesetzte Tiere hält auch Landwirtschaftsminister Andrä Rupprechter (ÖVP) persönlich nichts, heißt es aus seinem Ministerbüro.“"
                            },
                            {
                                "example_id": "651da0f8-cf97-478f-848d-6b5a39b099df",
                                "sense_id": "169fcc20-7b92-3672-af33-7a479a8a3cc0",
                                "text": "„Im Zeichen des verheerenden Krieges erfanden Preußens Landwirtschaftsminister Clemens von Schorlemer und sein für Inneres zuständiger Kabinettskollege Wilhelm von Loebell das Recycling.“"
                            },
                            {
                                "example_id": "8b9d8cbf-3d3b-4780-baec-5cbbdea6d643",
                                "sense_id": "169fcc20-7b92-3672-af33-7a479a8a3cc0",
                                "text": "„Mugabe ernannte 1980 ihren früheren Präsidenten Dennis Norman, einen Weißen, zum Landwirtschaftsminister.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
