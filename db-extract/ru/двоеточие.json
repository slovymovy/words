                    },
                    {
                        "translation_id": "fe259711-abfb-4aba-871c-29b91bdddec4",
                        "source_entry_id": "4a8224ef-eda1-3b43-8dc8-18a2c7ed905e",
                        "source_sense_id": "419bd694-98dc-3a65-8ba4-fd00e2f2ad97",
                        "target_lang_word": "Doppelpunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doppelpunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7e8c00e-bd95-3ec9-8f3e-a751fe7f6918",
                                        "entry_id": "008c505f-4f54-3cca-9b79-1e6b34162a4d",
                                        "glosses": [
                                            "Name des Satzzeichens (Interpunktionszeichens) \\\":\\\", das eine kataphorische Funktion hat; es weist auf das Folgende hin: ein Zitat, einen Begriff; etwas, das besonders hervorgehoben werden soll."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a25a49ed-7bf5-4a92-8738-afa2802645d8",
                                                "sense_id": "a7e8c00e-bd95-3ec9-8f3e-a751fe7f6918",
                                                "text": "Der Doppelpunkt wirkt wie eine Katapher, indem er auf das Folgende hinweist."
                                            },
                                            {
                                                "example_id": "4a1022c6-fd56-462e-a02e-3d57923011ba",
                                                "sense_id": "a7e8c00e-bd95-3ec9-8f3e-a751fe7f6918",
                                                "text": "Dem Doppelpunkt folgt in vielen Fällen eine direkte Rede oder eine Aufzählung."
                                            },
                                            {
                                                "example_id": "69bf50f9-ca17-4e0d-9e56-86ef1c7d4c62",
                                                "sense_id": "a7e8c00e-bd95-3ec9-8f3e-a751fe7f6918",
                                                "text": "„Es gibt ein ausgezeichnetes Mittel, um logische Bindewörter zu ersparen und überhaupt den Satzbau zu entfetten: den Doppelpunkt.“"
                                            },
                                            {
                                                "example_id": "ecca4f48-1eda-4ce1-88f1-58f4c0d8707d",
                                                "sense_id": "a7e8c00e-bd95-3ec9-8f3e-a751fe7f6918",
                                                "text": "„Man schreibt nach einem Doppelpunkt klein, wenn der folgende Text nicht als selbstständiger Satz aufgefasst wird.“"
                                            },
                                            {
                                                "example_id": "bdecd579-8181-461f-ac74-1d82605d640f",
                                                "sense_id": "a7e8c00e-bd95-3ec9-8f3e-a751fe7f6918",
                                                "text": "„Erste Fassungen von Komma, Punkt und Doppelpunkt (plus Leerzeichen zwischen den Wörtern zur besseren Übersicht) wurden zu Krücken des Lesens und Schreibens, und sie erfüllten ein knappes Jahrtausend lang ihren Zweck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65593ad9-2a34-37e2-a2c7-b86518a9fbb4",
                                        "entry_id": "008c505f-4f54-3cca-9b79-1e6b34162a4d",
                                        "glosses": [
                                            "Zeichen, das in der Lautschrift die Länge des vorhergehenden Vokals anzeigt"
                                        ],
                                        "tags": [
                                            "Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ced729-8869-4e2e-8fc0-9bc41ea82b0f",
                                                "sense_id": "65593ad9-2a34-37e2-a2c7-b86518a9fbb4",
                                                "text": "In der Lautschrift des Wortes Bodensee [ˈboːdn̩ˌzeː] wird durch die beiden Doppelpunkte angezeigt, dass die beiden Vokale des Wortes lang sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8001077c-eccf-391d-803d-6ad36d6836d8",
                                        "entry_id": "008c505f-4f54-3cca-9b79-1e6b34162a4d",
                                        "glosses": [
                                            "Zeichen für die mathematische Operation der Division oder eines Verhältnisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112e56d5-8334-45d0-abb7-877494739a05",
                                                "sense_id": "8001077c-eccf-391d-803d-6ad36d6836d8",
                                                "text": "In der Gleichung 10 : 2 = 5 zeigt der Doppelpunkt an, dass 10 durch 2 geteilt, und nicht etwa mit 2 multipliziert werden soll."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "376ebe48-2fad-39db-ad7b-d97acc3947cb",
                                        "entry_id": "008c505f-4f54-3cca-9b79-1e6b34162a4d",
                                        "glosses": [
