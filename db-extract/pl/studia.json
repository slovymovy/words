                    {
                        "translation_id": "5ad0485c-0a67-4703-911a-95e17a632377",
                        "source_entry_id": "0b137634-52d7-3739-818f-ef49e918e844",
                        "source_sense_id": "709468d2-aa83-3c4d-8778-ae9334f23f83",
                        "target_lang_word": "Studium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Studium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74959ad4-e444-344c-b6bf-3cbc7c401b30",
                                        "entry_id": "8166d377-9212-3267-bd19-61818fa68788",
                                        "glosses": [
                                            "intensive (meist wissenschaftliche) Auseinandersetzung mit einer Sache, einem Sachverhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f26a4f08-206e-49df-817b-6d1a4359dc5f",
                                                "sense_id": "74959ad4-e444-344c-b6bf-3cbc7c401b30",
                                                "text": "In seiner Freizeit betrieb Niko ornithologische Studien."
                                            },
                                            {
                                                "example_id": "d3a97007-5d39-4065-b7fb-319ff6e2615c",
                                                "sense_id": "74959ad4-e444-344c-b6bf-3cbc7c401b30",
                                                "text": "„Seine aerodynamischen Erkenntnisse aus dem Studium des Windes und der Vogelflügel waren die Grundlage für den modernen Segelflug.“"
                                            },
                                            {
                                                "example_id": "a2aa8268-ffc9-4b70-8c20-0a7d59d287b2",
                                                "sense_id": "74959ad4-e444-344c-b6bf-3cbc7c401b30",
                                                "text": "„Wieder andere hielten lange am Gebrauch des Jiddischen fest, insbesondere im religiösen Studium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7d75686-993e-31ee-9048-5828eadea17b",
                                        "entry_id": "8166d377-9212-3267-bd19-61818fa68788",
                                        "glosses": [
                                            "wissenschaftliche Ausbildung an einer Hochschule (Universität, Kunsthochschule, Fachhochschule)"
                                        ],
                                        "tags": [
                                            "Bildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f0e9f3-535c-4b13-931a-6ec10f666423",
                                                "sense_id": "c7d75686-993e-31ee-9048-5828eadea17b",
                                                "text": "Sie zieht zum Studium nach Freiberg."
                                            },
                                            {
                                                "example_id": "2a62ea06-bb75-48f4-9b5d-3ae3f105b98d",
                                                "sense_id": "c7d75686-993e-31ee-9048-5828eadea17b",
                                                "text": "Das Studium der Mathematik dauert 9 Semester."
                                            },
                                            {
                                                "example_id": "65a2c327-68b3-4bba-9a1b-87681d1b8a2d",
                                                "sense_id": "c7d75686-993e-31ee-9048-5828eadea17b",
                                                "text": "„Oft handelt es sich um kontrastive Darstellungen, die zur Erhöhung der kommunikativen Kompetenz der Deutschlehrer und -studenten in der Lehre, im Studium und im Alltag beitragen.“"
                                            },
                                            {
                                                "example_id": "def65a77-b12c-4d39-8150-864eca7affb8",
                                                "sense_id": "c7d75686-993e-31ee-9048-5828eadea17b",
                                                "text": "„Auch für Hans Meyer wurde nach dem Studium der Volkswirtschaft eine Weltreise zum Initialerlebnis.“"
                                            },
                                            {
                                                "example_id": "b21687c6-b9d4-4f65-8ef0-bf023685e410",
                                                "sense_id": "c7d75686-993e-31ee-9048-5828eadea17b",
                                                "text": "„Dann ging er zurück und machte noch ein Jahr, aber schließlich brach er das Studium ganz ab.“"
                                            },
                                            {
                                                "example_id": "eed96a0d-a494-4384-870d-f4f25ca5b79f",
                                                "sense_id": "c7d75686-993e-31ee-9048-5828eadea17b",
                                                "text": "„Zu Beginn meines Studiums gab es in Deutschland wunderschöne Studienabschlüsse: Magister und Diplom.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d07c91b-84d7-4f3a-a865-b395bb9a934d",
                        "source_entry_id": "0b137634-52d7-3739-818f-ef49e918e844",
                        "source_sense_id": "709468d2-aa83-3c4d-8778-ae9334f23f83",
