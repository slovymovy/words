                "senses": [
                    {
                        "sense_id": "c049a587-635e-35fc-a04f-d1389c3e60bd",
                        "entry_id": "590f0dbc-8082-3ef9-9fee-9f6b5eac359b",
                        "glosses": [
                            "Humour noir qui souligne avec cruauté, amertume et parfois désespoir l'absurdité du monde, face à laquelle il constitue une forme de défense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440f5f36-039d-4bed-9950-3049a7d81af6",
                                "sense_id": "c049a587-635e-35fc-a04f-d1389c3e60bd",
                                "text": "Humor als Ventil in schlechten Zeiten hat es schon immer gegeben. (...) Der Begriff Galgenhumor kommt nicht von ungefähr.",
                                "translation": "L'humour comme soupape dans les mauvais moments a toujours existé. (...) Le terme d'humour noir n'est pas dû au hasard."
                            }
                        ]
                    }
                ],
