                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c9e9be-343f-4274-bf5e-b6b26f8b5843",
                                                "sense_id": "bae18a73-653a-326e-ab2e-505ac8dc6464",
                                                "text": "Das Gouvernement hat im Auftrag vom Mutterland neue Gesetze durchgeführt."
                                            }
