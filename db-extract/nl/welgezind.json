                        ]
                    },
                    {
                        "translation_id": "4a2463d6-bd13-49d1-95c5-5dc63d3766cb",
                        "source_entry_id": "4b622923-a807-3a5c-be47-19d45670b4ec",
                        "source_sense_id": "3cc84cc1-4a70-39d3-b30f-73bf23d7c5f7",
                        "target_lang_word": "well-meaning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "well-meaning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "389b4d1a-c009-3489-b171-ff9318850e99",
                                        "entry_id": "602b500b-02d2-31c2-9ee4-2ba2051c7032",
                                        "glosses": [
                                            "With good intentions, often used to reflect positively on a negative outcome or situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0808ea25-2174-48d1-8c00-1c1db7f607fe",
                                                "sense_id": "389b4d1a-c009-3489-b171-ff9318850e99",
                                                "text": "The professor is well-meaning enough, but he usually ruins things one way or another."
                                            },
                                            {
                                                "example_id": "f3ed06cf-b523-4c93-9215-cca927a4e49c",
                                                "sense_id": "389b4d1a-c009-3489-b171-ff9318850e99",
                                                "text": "In the first scene, he bites the arm of a well-meaning counselor at the group home and dashes out of the building, all in a vain attempt to locate the father who abandoned him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "624ca5f8-f38e-4499-935d-2490256bbd8b",
                        "source_entry_id": "4b622923-a807-3a5c-be47-19d45670b4ec",
                        "source_sense_id": "3cc84cc1-4a70-39d3-b30f-73bf23d7c5f7",
                        "target_lang_word": "positively-minded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f16d9150-8929-4201-9e00-36d8de4f800a",
                        "source_entry_id": "4b622923-a807-3a5c-be47-19d45670b4ec",
                        "source_sense_id": "3cc84cc1-4a70-39d3-b30f-73bf23d7c5f7",
                        "target_lang_word": "good-natured",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "good-natured",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a15f1e2f-aa47-3188-841e-6b47575744c0",
                                        "entry_id": "f835f60f-2b8f-3627-8ab8-80ce822e9151",
                                        "glosses": [
                                            "Having or showing an amicable, kindly disposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f6abb7-887e-40fd-bfb1-bddb0bfc37bd",
                                                "sense_id": "a15f1e2f-aa47-3188-841e-6b47575744c0",
                                                "text": "“It is singular,” said the Lady, addressing Warden; “the animal is not only so good-natured to all, but so particularly fond of children.[…]”"
                                            },
                                            {
                                                "example_id": "3edaae72-8253-4c6d-8790-19a996cb45f1",
                                                "sense_id": "a15f1e2f-aa47-3188-841e-6b47575744c0",
                                                "text": "For the people who were shovelling away on the house-tops were jovial and full of glee; calling out to one another from the parapets, and now and then exchanging a facetious snowball—better-natured missile far than many a wordy jest—laughing heartily if it went right, and not less heartily if it went wrong."
                                            },
                                            {
                                                "example_id": "c068a455-d0aa-400d-95bb-3003f50c4026",
                                                "sense_id": "a15f1e2f-aa47-3188-841e-6b47575744c0",
                                                "text": "There are a good many of these girls whom it is quite enough to spoil the temper of the best-natured woman in the world to have in the house with them."
                                            },
                                            {
                                                "example_id": "94e05742-ccc2-4708-b3c5-31633280544f",
                                                "sense_id": "a15f1e2f-aa47-3188-841e-6b47575744c0",
                                                "text": "Rasmus was a tall, powerful man, with a weather-beaten, furrowed face of a good-natured expression."
                                            },
                                            {
                                                "example_id": "a55032ff-beb2-4eaa-9343-387b886ce1b8",
                                                "sense_id": "a15f1e2f-aa47-3188-841e-6b47575744c0",
                                                "text": "However, the immediate howls of outrage from the industry were in many cases less than good-natured."
                                            },
                                            {
                                                "example_id": "359ed1ae-de8a-4614-8e73-31b85f9edfd9",
                                                "sense_id": "a15f1e2f-aa47-3188-841e-6b47575744c0",
                                                "text": "I had a rival for Marcel’s affections, a boy who later became the king of recorded classical music and confrère of Herbert von Karajan. I was vile to this poor chap who, like a cheerful Papageno, was much better-natured than I was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9de77569-ced7-41bd-90bb-4712855d4ff3",
                        "source_entry_id": "4b622923-a807-3a5c-be47-19d45670b4ec",
                        "source_sense_id": "3cc84cc1-4a70-39d3-b30f-73bf23d7c5f7",
                        "target_lang_word": "favourable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favourable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec5b6353-e785-3526-a855-90994ee04c0e",
                                        "entry_id": "7c14f992-2189-3f00-a8c6-bad3ca8d5535",
                                        "glosses": [
                                            "Apt to win favour; pleasing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d020a81f-238f-4adf-bf5c-17081ead4edd",
                                                "sense_id": "ec5b6353-e785-3526-a855-90994ee04c0e",
                                                "text": "The candidate wearing the business suit made a favourable impression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e2b753-53c5-316b-920a-4e35dad8ee61",
                                        "entry_id": "7c14f992-2189-3f00-a8c6-bad3ca8d5535",
                                        "glosses": [
                                            "Expressing or indicating favour or goodwill; approving, encouraging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054943c6-a3f5-4692-bdef-230c3bf390aa",
                                                "sense_id": "73e2b753-53c5-316b-920a-4e35dad8ee61",
                                                "text": "The proposal has received many favourable comments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dde701a-8956-3193-8c38-113d3d71cc65",
                                        "entry_id": "7c14f992-2189-3f00-a8c6-bad3ca8d5535",
                                        "glosses": [
                                            "Useful or helpful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89edea1a-1aeb-4217-8bde-101fd1ab01a4",
                                                "sense_id": "1dde701a-8956-3193-8c38-113d3d71cc65",
                                                "text": "We made quick progress, due to favourable winds."
                                            },
                                            {
                                                "example_id": "6241f8e1-c303-491b-80da-9ec5abef01db",
                                                "sense_id": "1dde701a-8956-3193-8c38-113d3d71cc65",
                                                "text": "So draw him home to those that mourn\n⁠In vain; a favourable speed\n⁠Ruffle thy mirror’d mast, and lead\nThro’ prosperous floods his holy urn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9b6e75c-befd-3456-9dc1-6f34ae5e99d3",
                                        "entry_id": "7c14f992-2189-3f00-a8c6-bad3ca8d5535",
                                        "glosses": [
                                            "Convenient or at a suitable time; opportune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9defb3ae-454c-4a01-b4da-54044156ccb7",
                                                "sense_id": "b9b6e75c-befd-3456-9dc1-6f34ae5e99d3",
                                                "text": "The rain stopped at a favourable time for our tennis match."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a627c5f4-11e3-3387-ad46-765ea6fb0b74",
                                        "entry_id": "7c14f992-2189-3f00-a8c6-bad3ca8d5535",
                                        "glosses": [
                                            "Auspicious or lucky."
