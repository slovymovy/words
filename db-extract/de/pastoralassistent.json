                        "source_sense_id": "536cf2bc-2461-384e-b169-076ce6b395f4",
                        "source_sense_description": "Schweiz, Katholizismus: Laien-Seelsorger mit Hochschul-Ausbildung",
                        "target_lang_word": "assistant pastoral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assistant pastoral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3fd9e82-ccf4-35c1-9cab-91fcf41c184f",
                                        "entry_id": "c7d6389a-da83-3c65-b4a2-16a075de5a67",
                                        "glosses": [
                                            "Théologien laïc de formation universitaire servant d’agent pastoral dans l’Église catholique romaine."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca7da8f-ebf9-4841-b18f-89c9d1754437",
                                                "sense_id": "e3fd9e82-ccf4-35c1-9cab-91fcf41c184f",
                                                "text": "L’assistant pastoral ou l’assistante pastorale sont chargés d'annoncer le message de Jésus Christ, de former à la foi, d'animer les communautés chrétiennes catholiques et de contribuer à leur unité."
                                            },
                                            {
                                                "example_id": "58d8d681-8fc6-4ca5-a1d7-39181b027964",
                                                "sense_id": "e3fd9e82-ccf4-35c1-9cab-91fcf41c184f",
                                                "text": "L’Unité pastorale St-Germain était en fête samedi soir 25 septembre pour accueillir officiellement son nouvel assistant pastoral, Noël Pedreira, au cours d’une messe célébrée à l’église de Corban."
                                            },
                                            {
                                                "example_id": "c4a064f1-0b6b-47aa-999b-fff008de0acf",
                                                "sense_id": "e3fd9e82-ccf4-35c1-9cab-91fcf41c184f",
                                                "text": "Selon la formation de l’agent pastoral et la région où il est employé, la terminologie désignant sa fonction est variable (assistant pastoral, animateur pastoral, etc.)."
                                            }
                                        ]
                                    }
                                ]
                            }
