                ],
                "senses": [
                    {
                        "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                        "entry_id": "272b19e4-0d40-3b03-95b4-e4a10db52bb3",
                        "glosses": [
                            "verlorenes Blut, das Rückschlüsse auf ein zurückliegendes Ereignis erlaubt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d20aa8b9-a921-418c-815f-8221a9088c38",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "Das Opfer hat eine Blutspur hinterlassen, die die Polizisten bis zum eigentlichen Tatort führte."
                            },
                            {
                                "example_id": "105daeeb-95fc-40b2-bb69-45a77bd935c6",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "Durch die DNA-Analyse einer Blutspur, die der Täter hinterlassen hatte, konnte er identifiziert werden."
                            },
                            {
                                "example_id": "c7e91e1d-a12c-4b27-b16c-b7fe1adffc87",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "„Er nahm die Kompresse mit den Blutspuren vom Gesicht, hielt sie unter den Wasserhahn, wrang sie aus und legte sie wieder auf.“"
                            },
                            {
                                "example_id": "47e65753-bdaa-4a65-867c-97de9b93e69a",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "„Auf dem Asphalt sind dunkle Blutspuren.“"
                            },
                            {
                                "example_id": "cba4cf1c-c471-4055-a8a7-9703acab1ae7",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "„Die Blutspur, die Adolf Hitler bis September 1938 schon hinterlassen hatte, hätte man auch in der Downing Street riechen müssen.“"
                            },
                            {
                                "example_id": "63a5a4d4-402e-4dc1-af62-f0e14d9d929f",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "„Das riss er an sich, wischte die Blutspuren im Gras ab und steckte es ein.“"
                            },
                            {
                                "example_id": "2301103c-2830-483e-8ff4-0ebdc0fe7bde",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "„Geh die Adams ungefähr einen halben Häuserblock weit rauf, und du stößt auf eine Blutspur.“"
                            },
                            {
                                "example_id": "9a097f14-b4bd-424c-95a1-07485684854c",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "„Was besagt die Blutspur, die von der Leiche wegführt?“"
                            },
                            {
                                "example_id": "b22341fa-dba8-40d5-aa01-ae403f9ab04f",
                                "sense_id": "9d3777f1-fe4d-3b98-8eab-9ae067e7ad6d",
                                "text": "„Blutspuren deuteten darauf hin, dass das Opfer ins Wohnzimmer geschleppt worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
