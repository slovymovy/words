{
    "word_family": [
        "cancerous",
        "cancerously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6666b4c1-ef15-3fc3-9b0d-31e9ab3ca09f",
                    "sense_definition": "A serious disease caused by cells growing uncontrollably in the body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disease_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoking significantly increases the risk of developing lung <w>cancer</w>.",
                            "target_lang_translations": {
                                "ru": "Курение значительно повышает риск развития <w>рака</w> легких.",
                                "zh": "吸烟会显著增加患肺<w>癌</w>的风险。"
                            }
                        },
                        {
                            "text": "Doctors are working hard to find a permanent cure for <w>cancer</w>.",
                            "target_lang_translations": {
                                "ru": "Врачи усердно работают над поиском окончательного лекарства от <w>рака</w>.",
                                "zh": "医生们正在努力寻找彻底治愈<w>癌症</w>的方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "malignancy",
                        "tumor"
                    ],
                    "common_phrases": [
                        "lung cancer",
                        "breast cancer",
                        "fight cancer",
                        "cure for cancer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезное заболевание, вызванное неконтролируемым ростом клеток в организме.",
                        "zh": "一种由体内细胞不受控制地生长而引起的严重疾病。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рак",
                                "target_lang_sense_clarification": "болезнь"
                            },
                            {
                                "target_lang_word": "злокачественная опухоль",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "癌症",
                                "target_lang_sense_clarification": "医学疾病"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba51aea5-f64a-32c3-9dfc-32f7d76e5690",
                    "sense_definition": "Something evil or destructive that spreads and is difficult to stop.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disease_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Corruption is a <w>cancer</w> that destroys the economy from within.",
                            "target_lang_translations": {
                                "ru": "Коррупция — это <w>рак</w>, который разрушает экономику изнутри.",
                                "zh": "腐败就像一个从内部摧毁经济的<w>毒瘤</w>。"
                            }
                        },
                        {
                            "text": "Violence has become a <w>cancer</w> in our once peaceful community.",
                            "target_lang_translations": {
                                "ru": "Насилие стало <w>раковой опухолью</w> в нашем некогда мирном обществе.",
                                "zh": "暴力已成为我们曾经宁静社区中的一个<w>毒瘤</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cancer on society",
                        "cancer of corruption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто злое или разрушительное, что распространяется и трудно поддается остановке.",
                        "zh": "指某种蔓延开来且难以遏制的邪恶或破坏性事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рак",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "раковая опухоль",
                                "target_lang_sense_clarification": "метафора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒瘤",
                                "target_lang_sense_clarification": "比喻破坏性事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e50804ba-7028-363d-b406-924fbea7c027",
                    "sense_definition": "A person born under the zodiac sign of Cancer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zodiac_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My sister is a <w>Cancer</w>, so she is very emotional and caring.",
                            "target_lang_translations": {
                                "ru": "Моя сестра — <w>Рак</w>, поэтому она очень эмоциональная и заботливая.",
                                "zh": "我妹妹是<w>巨蟹座</w>的，所以她非常感性且善解人意。"
                            }
                        },
                        {
                            "text": "He reads his horoscope every day because he is a <w>Cancer</w>.",
                            "target_lang_translations": {
                                "ru": "Он читает свой гороскоп каждый день, потому что он <w>Рак</w>.",
                                "zh": "因为他是<w>巨蟹座</w>，所以他每天都看星座运势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Cancerian"
                    ],
                    "common_phrases": [
                        "is a Cancer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, родившийся под знаком зодиака Рак.",
                        "zh": "出生于巨蟹座的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рак",
                                "target_lang_sense_clarification": "человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨蟹座",
                                "target_lang_sense_clarification": "星座所属的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "134c7aab-e7f5-3026-bcb1-4d8a4a5a40a8",
                    "sense_definition": "The fourth sign of the zodiac, represented by a crab.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zodiac_group",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "People born in early July fall under the sign of <w>Cancer</w>.",
                            "target_lang_translations": {
                                "ru": "Люди, родившиеся в начале июля, относятся к знаку <w>Рака</w>.",
                                "zh": "七月初出生的人属于<w>巨蟹座</w>。"
                            }
                        },
                        {
                            "text": "The sun enters <w>Cancer</w> during the summer solstice in the northern hemisphere.",
                            "target_lang_translations": {
                                "ru": "Солнце входит в созвездие <w>Рака</w> во время летнего солнцестояния в северном полушарии.",
                                "zh": "北半球夏至时，太阳进入<w>巨蟹座</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Crab"
                    ],
                    "antonyms": [
                        "Capricornus"
                    ],
                    "common_phrases": [
                        "Tropic of Cancer",
                        "sign of Cancer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Четвертый знак зодиака, изображаемый в виде краба.",
                        "zh": "黄道十二宫的第四个星座，以螃蟹为标志。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рак",
                                "target_lang_sense_clarification": "знак зодиака"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨蟹座",
                                "target_lang_sense_clarification": "星座名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9547b060-1bfe-38df-a3af-8b903ad9a5ea",
                    "sense_definition": "Extremely unpleasant, toxic, or annoying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comments section on that video is absolute <w>cancer</w>.",
                            "target_lang_translations": {
                                "ru": "Раздел комментариев под этим видео — полный <w>рак</w>.",
                                "zh": "那个视频的评论区简直就是<w>垃圾</w>。"
                            }
                        },
                        {
                            "text": "Playing with that cheater was <w>cancer</w> and ruined the game.",
                            "target_lang_translations": {
                                "ru": "Играть с этим читером было <w>полным отстоем</w>, и это испортило игру.",
                                "zh": "和那个作弊者一起玩简直太<w>垃圾</w>了，毁了整场游戏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cancerous"
                    ],
                    "common_phrases": [
                        "pure cancer",
                        "straight up cancer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне неприятный, токсичный или раздражающий.",
                        "zh": "形容极其令人不快、有毒或烦人的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рак",
                                "target_lang_sense_clarification": "сленг, о плохом игроке или явлении"
                            },
                            {
                                "target_lang_word": "отстой",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾",
                                "target_lang_sense_clarification": "网络俚语，形容极差"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}