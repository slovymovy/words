                ],
                "senses": [
                    {
                        "sense_id": "4c949ed3-c740-3ba6-8ac9-a54556f1a98b",
                        "entry_id": "d947ff8d-4401-3783-8b59-b1e7105ee6b8",
                        "glosses": [
                            "Person, die an Epilepsie leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760a6d90-87d6-447a-80e5-4b9372f0d5ba",
                                "sense_id": "4c949ed3-c740-3ba6-8ac9-a54556f1a98b",
                                "text": "„Es gibt Epileptiker in allen Positionen in der privaten Wirtschaft, in öffentlichen Funktionen und im Sport (denken Sie an den Weltfußballer Ronaldo aus Brasilien), auch mit aktiven Epilepsien.“"
                            },
                            {
                                "example_id": "faf0c206-f2e8-4d44-8357-e40eb8e93786",
                                "sense_id": "4c949ed3-c740-3ba6-8ac9-a54556f1a98b",
                                "text": "„Bei den höchsten Exemplaren des [[|Thatendranges]] möchte der Satz sich beweisen lassen: man erwäge doch, mit dem Wissen und den Erfahrungen eines Irrenarztes, wie billig, – dass Vier von den Thatendurstigsten aller Zeiten Epileptiker gewesen sind (nämlich Alexander, Cäsar, Muhammed und Napoleon)- so wie auch Byron diesem Leiden unterworfen war.“"
                            },
                            {
                                "example_id": "7ef44e93-0c85-4c64-bb66-1d01d084a6d0",
                                "sense_id": "4c949ed3-c740-3ba6-8ac9-a54556f1a98b",
                                "text": "„Sie überlegte, ob sie vielleicht zu dem Epileptiker hinübergehen und ihm anbieten sollte, etwas für ihn zu holen.“"
                            },
                            {
                                "example_id": "4953f317-4023-4a7b-b40e-0fe6dc047a39",
                                "sense_id": "4c949ed3-c740-3ba6-8ac9-a54556f1a98b",
                                "text": "„Die bekannten Hypothesen, daß zur linken Gehirnhälfte das hauptsächliche Sprachzentrum, zur rechten die Vorstellung des Raumes gehört, sind bei Experimenten mit Epileptikern, denen zur Linderung ihres Anfallsleidens die beiden Gehirnhälften getrennt worden sind, bestätigt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f80f4688-4c60-4dcf-9324-f4dcd3d7c396",
                        "source_entry_id": "d947ff8d-4401-3783-8b59-b1e7105ee6b8",
                        "source_sense_id": "4c949ed3-c740-3ba6-8ac9-a54556f1a98b",
