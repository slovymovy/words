                "senses": [
                    {
                        "sense_id": "74343164-4bf0-3146-9d26-21a54c283d4c",
                        "entry_id": "3649b873-18a9-3bef-8bb8-5865fc0c94eb",
                        "glosses": [
                            "langlebige Haiart, die vor allem in den arktischen Gewässern des Nordatlantiks vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5056749-ea3d-48cb-b140-aa94453ea1f8",
                                "sense_id": "74343164-4bf0-3146-9d26-21a54c283d4c",
                                "text": "„Nach aktuellen Forschungen werden Grönlandhaie ab einer Länge von vier Metern geschlechtsreif.“"
                            },
                            {
                                "example_id": "9670917a-9b0b-4caf-8eb1-d9a10f1d94fe",
                                "sense_id": "74343164-4bf0-3146-9d26-21a54c283d4c",
                                "text": "„Lahm, uralt und kaum genießbar – der Grönlandhai ist das hässliche Entlein.“"
                            },
                            {
                                "example_id": "c3a89018-c028-4d95-8154-19ca776fde6f",
                                "sense_id": "74343164-4bf0-3146-9d26-21a54c283d4c",
                                "text": "„Der Grönlandhai ist das langlebigste Wirbeltier der Welt. Etwa 400 Jahre alt können die […] Fische werden, womöglich noch deutlich älter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
