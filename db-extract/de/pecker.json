                "senses": [
                    {
                        "sense_id": "2e5955d8-2773-3644-839d-a6020c3349be",
                        "entry_id": "5b963c4c-7eff-3acf-ba0a-3f459effc0cd",
                        "glosses": [
                            "durch einen Schlag oder Stoß verursachte kleine Beschädigung"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4b62afac-9278-4800-9dc6-64803ac86463",
                                "sense_id": "2e5955d8-2773-3644-839d-a6020c3349be",
                                "text": "„Besonders im Frühjahr verursachen fliegender Rollsplitt und Steinschlag Schäden in vielen Windschutzscheiben . Ein kleiner \"Pecker\" in der Scheibe ist zwar ärgerlich, aber nicht zwangsläufig mit hohen Kosten verbunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "05cefb85-c1dc-3c78-9124-ce493f18e6f9",
                        "entry_id": "5b963c4c-7eff-3acf-ba0a-3f459effc0cd",
                        "glosses": [
                            "Ausdruck in Verbindung mit haben für spinnen, verrückt sein"
                        ],
                        "tags": [
                            "Austrian German",
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7fca5ca4-7179-4aed-a498-3fd602525c13",
                                "sense_id": "05cefb85-c1dc-3c78-9124-ce493f18e6f9",
                                "text": "„Manchmal, wenn mir die Finger beim Aufbauen fast abfrieren und mir alles wehtut, denk ich mir schon: 'Eigentlich bist du schön blöd!' Aber ein bissl einen Pecker muss jeder haben!\"“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
