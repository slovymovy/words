                        "entry_id": "002738a8-9550-3a4e-98be-ce727222b4ca",
                        "glosses": [
                            "Volonté contraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afebccfc-38e2-4b92-b1d8-13987a144bf8",
                                "sense_id": "9fb8c7ae-9670-3f0f-b443-5620e33435e0",
                                "text": "Car la non-volonté (ou nolonté), la simple suspension de la volonté renforce le nihilisme, plus qu’elle ne l’abolit en redoublant le rien de la (dé)valorisation par l’impuissance de la volonté."
                            },
                            {
                                "example_id": "193dff33-2896-4607-ae8b-91909768e9bb",
                                "sense_id": "9fb8c7ae-9670-3f0f-b443-5620e33435e0",
                                "text": "Ce qui retient unis entre eux tous les membres de cette respectable famille, ce sont de communes antipathies et, selon l’expression de Mirabeau, de communes nolontés."
                            }
                        ]
                    }
