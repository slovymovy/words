{
    "word_family": [
        "culpable",
        "culpability"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                    "sense_definition": "The person or thing responsible for a problem, mistake, or crime.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tightened the loose bolt that was the <w>culprit</w>; it should work now.",
                            "target_lang_translations": {
                                "cs": "Dotáhl jsem ten uvolněný šroub, který byl <w>viníkem</w>; teď by to mělo fungovat."
                            }
                        },
                        {
                            "text": "The main <w>culprit</w> behind the system failure was a faulty power cable.",
                            "target_lang_translations": {
                                "cs": "Hlavním <w>viníkem</w> selhání systému byl vadný napájecí kabel."
                            }
                        }
                    ],
                    "synonyms": [
                        "offender",
                        "wrongdoer",
                        "cause"
                    ],
                    "common_phrases": [
                        "main culprit",
                        "identify the culprit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba nebo věc, která je zodpovědná za problém, chybu nebo trestný čin."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "viník",
                                "target_lang_sense_clarification": "osoba odpovědná za provinění"
                            },
                            {
                                "target_lang_word": "příčina",
                                "target_lang_sense_clarification": "věc nebo jev způsobující problém"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38891665-25b2-345f-aef3-e08e1191b0c8",
                    "sense_definition": "A person who has been accused of a crime but has not yet been tried in court.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>culprit</w> was held in custody while waiting for his trial to begin.",
                            "target_lang_translations": {
                                "cs": "<w>Obviněný</w> byl držen ve vazbě, zatímco čekal na zahájení soudního procesu."
                            }
                        },
                        {
                            "text": "Lawyers argued that the <w>culprit</w> should be released on bail until the court date.",
                            "target_lang_translations": {
                                "cs": "Právníci argumentovali, že by měl být <w>obviněný</w> propuštěn na kauci až do termínu soudu."
                            }
                        }
                    ],
                    "synonyms": [
                        "defendant",
                        "accused"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely historical or legalistic."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba obviněná ze spáchání trestného činu, která ještě nebyla odsouzena soudem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obviněný",
                                "target_lang_sense_clarification": "osoba, proti které bylo zahájeno trestní stíhání"
                            },
                            {
                                "target_lang_word": "podezřelý",
                                "target_lang_sense_clarification": "osoba, u které existuje důvodné podezření ze spáchání činu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}