        "fr-extract.jsonl": [
            {
                "entry_id": "34097904-86d2-34bc-9d1d-e747fbffaf6a",
                "word": "saccade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "67224bf1-90af-4c90-9b67-50b2842fcfbc",
                        "entry_id": "34097904-86d2-34bc-9d1d-e747fbffaf6a",
                        "tags": [
                            "plural"
                        ],
                        "form": "saccades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "725d8a6d-e644-3a7a-bed7-42b1813da40d",
                        "entry_id": "34097904-86d2-34bc-9d1d-e747fbffaf6a",
                        "glosses": [
                            "Mouvement brusque et irrégulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "943ad462-fe41-42b5-8b33-ba78b8a748ee",
                                "sense_id": "725d8a6d-e644-3a7a-bed7-42b1813da40d",
                                "text": "Elle avait allumé une cigarette, et laissait la fumée monter vers le plafond, par petites saccades bleues."
                            },
                            {
                                "example_id": "757fb77d-c862-4fe4-b51f-2dc57f2a47dc",
                                "sense_id": "725d8a6d-e644-3a7a-bed7-42b1813da40d",
                                "text": "Mes yeux, sous les paupières crispées, étaient traversées d'images de feu, de dessins géométriques lumineux, et je croyais les sentir s'arracher par saccades de leurs orbites, comme poussés de l'intérieur."
                            },
                            {
                                "example_id": "7758dee5-dfe3-4394-9367-de284b121a03",
                                "sense_id": "725d8a6d-e644-3a7a-bed7-42b1813da40d",
                                "text": "J’ai donc repris la file des passants qui s’engageaient dans une des rues aboutissantes et nous avançâmes par saccades à cause des boutiques dont chaque étalage fragmentait la foule."
                            },
                            {
                                "example_id": "9d71ab83-5586-4e68-8a68-1501ff774988",
                                "sense_id": "725d8a6d-e644-3a7a-bed7-42b1813da40d",
                                "text": "Sylvebarbe se leva de sa couche d'une saccade, se mit debout et frappa du poing sur la table."
                            }
                        ]
                    },
                    {
                        "sense_id": "b15be44e-ce19-3ca1-af04-8f73c9207439",
                        "entry_id": "34097904-86d2-34bc-9d1d-e747fbffaf6a",
                        "glosses": [
                            "Brusque et rude secousse qu’on donne à un cheval en lui tirant la bride."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1397f9a2-8854-4895-a8fe-bc32254ce43b",
                                "sense_id": "b15be44e-ce19-3ca1-af04-8f73c9207439",
                                "text": "Les saccades gâtent la bouche d’un cheval."
                            },
                            {
                                "example_id": "d33abafc-838c-4543-81ef-c70352d450ea",
                                "sense_id": "b15be44e-ce19-3ca1-af04-8f73c9207439",
                                "text": "Donner des saccades à un cheval."
                            }
                        ]
                    },
                    {
                        "sense_id": "86a1a62c-b6a8-3243-81a6-7e001c686b55",
                        "entry_id": "34097904-86d2-34bc-9d1d-e747fbffaf6a",
                        "glosses": [
                            "Secousse violente qu’on donne à quelqu’un en le tirant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bbc7b500-f77d-4057-b8e1-3b4ecc0c5bc2",
                                "sense_id": "86a1a62c-b6a8-3243-81a6-7e001c686b55",
                                "text": "Il le prit au collet et lui donna deux ou trois saccades."
                            }
                        ]
                    },
                    {
                        "sense_id": "c333434b-48b5-3037-8eb0-b81ae325b574",
                        "entry_id": "34097904-86d2-34bc-9d1d-e747fbffaf6a",
                        "glosses": [
                            "Petits mouvements oculaires rapides qui permettent à un sujet d’analyser rapidement son environnement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9ddfe12c-c03f-4405-b929-b534115be0bd",
                                "sense_id": "c333434b-48b5-3037-8eb0-b81ae325b574",
                                "text": "Il ne faut pas confondre les saccades oculaires lorsqu’on est éveillé des REM (Rapide Eye Movement) qui eux ont lieu lors du sommeil et ne sont pas contrôlables."
                            }
                        ]
                    }
                ],
