{
    "word_family": [
        "engineering",
        "engine",
        "engine-maker",
        "engineman",
        "re-engineer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "503bb208-1a20-3651-ae85-dde656add06a",
                    "sense_definition": "A person qualified or professionally engaged in any branch of engineering, such as designing, constructing, or maintaining machinery and systems.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>engineer</w> spent the afternoon reviewing the blueprints for the new bridge.",
                            "target_lang_translations": {
                                "ru": "<w>Инженер</w> провел вторую половину дня, изучая чертежи нового моста."
                            }
                        },
                        {
                            "text": "She is a software <w>engineer</w> who specializes in developing mobile applications.",
                            "target_lang_translations": {
                                "ru": "Она — <w>инженер</w>-программист, специализирующийся на разработке мобильных приложений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "software engineer",
                        "civil engineer",
                        "mechanical engineer",
                        "electrical engineer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специалист с высшим техническим образованием, занимающийся проектированием, конструированием или эксплуатацией машин и систем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инженер",
                                "target_lang_sense_clarification": "специалист"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "113fd1a5-ed85-3521-bc3c-a46929656c6f",
                    "sense_definition": "A person who drives or operates a locomotive; a train driver.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "operator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The locomotive <w>engineer</w> blew the whistle as the train approached the station.",
                            "target_lang_translations": {
                                "ru": "<w>Машинист</w> локомотива дал свисток, когда поезд приблизился к станции."
                            }
                        },
                        {
                            "text": "After years of training, he finally became a lead <w>engineer</w> for the national railway.",
                            "target_lang_translations": {
                                "ru": "После многих лет обучения он наконец стал ведущим <w>машинистом</w> национальной железной дороги."
                            }
                        }
                    ],
                    "synonyms": [
                        "engineman"
                    ],
                    "common_phrases": [
                        "locomotive engineer",
                        "train engineer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работник железнодорожного транспорта, управляющий локомотивом; водитель поезда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "машинист",
                                "target_lang_sense_clarification": "локомотива"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cf97957-ea37-3862-86a2-bfa394e181b2",
                    "sense_definition": "A person employed to operate and maintain a steam engine, especially in the engine room of a ship.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "operator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship's <w>engineer</w> worked tirelessly to repair the boiler during the storm.",
                            "target_lang_translations": {
                                "ru": "Судовой <w>механик</w> без устали работал над ремонтом котла во время шторма."
                            }
                        },
                        {
                            "text": "A marine <w>engineer</w> must have extensive knowledge of propulsion systems.",
                            "target_lang_translations": {
                                "ru": "Морской <w>инженер</w> должен обладать обширными знаниями о двигательных установках."
                            }
                        }
                    ],
                    "synonyms": [
                        "engineman"
                    ],
                    "common_phrases": [
                        "marine engineer",
                        "ship engineer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специалист, отвечающий за работу и обслуживание двигателей, особенно в машинном отделении судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "механик",
                                "target_lang_sense_clarification": "судовой"
                            },
                            {
                                "target_lang_word": "машинист",
                                "target_lang_sense_clarification": "флотский"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa95169b-a065-3657-b103-e0242c3a0089",
                    "sense_definition": "A soldier engaged in designing or constructing military works, such as fortifications, bridges, or mines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military <w>engineer</w> was tasked with building a temporary bridge across the river.",
                            "target_lang_translations": {
                                "ru": "Военному <w>инженеру</w> было поручено построить временный мост через реку."
                            }
                        },
                        {
                            "text": "Combat <w>engineers</w> are responsible for clearing minefields and obstacles for the infantry.",
                            "target_lang_translations": {
                                "ru": "Боевые <w>инженеры</w> отвечают за расчистку минных полей и препятствий для пехоты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "military engineer",
                        "combat engineer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военнослужащий, занимающийся строительством укреплений, мостов или разминированием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сапёр",
                                "target_lang_sense_clarification": "военный строитель"
                            },
                            {
                                "target_lang_word": "военный инженер",
                                "target_lang_sense_clarification": "специалист"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "534d94c7-6ebd-3f68-8829-e7829497ac31",
                    "sense_definition": "A person who formulates plots or schemes; a plotter or schemer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a political <w>engineer</w> who could manipulate any election result.",
                            "target_lang_translations": {
                                "ru": "Он был известен как политический <w>комбинатор</w>, способный подтасовать результаты любых выборов."
                            }
                        },
                        {
                            "text": "The <w>engineer</w> of the coup remained in the shadows while others took the blame.",
                            "target_lang_translations": {
                                "ru": "<w>Организатор</w> переворота оставался в тени, пока другие принимали вину на себя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "political engineer",
                        "social engineer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который искусно планирует или организует тайные схемы и интриги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организатор",
                                "target_lang_sense_clarification": "схем"
                            },
                            {
                                "target_lang_word": "архитектор",
                                "target_lang_sense_clarification": "переносное, о планах"
                            },
                            {
                                "target_lang_word": "комбинатор",
                                "target_lang_sense_clarification": "интриган"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e36b4e4d-016a-37d9-a61f-924541ceafec",
                    "sense_definition": "To design, build, or maintain something using scientific and technical principles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>engineer</w> a more fuel-efficient engine for its next car model.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>разработать</w> более экономичный двигатель для своей следующей модели автомобиля."
                            }
                        },
                        {
                            "text": "They had to <w>engineer</w> a solution to the structural weakness found in the tower.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>спроектировать</w> решение проблемы структурной слабости, обнаруженной в башне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "carefully engineer",
                        "engineer a solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проектировать, конструировать или создавать что-либо, используя технические знания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проектировать",
                                "target_lang_sense_clarification": "создавать проект"
                            },
                            {
                                "target_lang_word": "конструировать",
                                "target_lang_sense_clarification": "разрабатывать устройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a200d5b7-af62-3e03-a55f-58b5f771faad",
                    "sense_definition": "To skillfully arrange or bring about a situation, often through clever planning or manipulation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manipulation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>engineer</w> a meeting with the CEO to discuss her proposal.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>подстроить</w> встречу с генеральным директором, чтобы обсудить свое предложение."
                            }
                        },
                        {
                            "text": "The manager tried to <w>engineer</w> a comeback for the failing brand.",
                            "target_lang_translations": {
                                "ru": "Менеджер пытался <w>организовать</w> возвращение на рынок для угасающего бренда."
                            }
                        }
                    ],
                    "synonyms": [
                        "machinate"
                    ],
                    "common_phrases": [
                        "engineer a meeting",
                        "engineer a takeover"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умело организовать или подстроить ситуацию путем тщательного планирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстроить",
                                "target_lang_sense_clarification": "ситуацию"
                            },
                            {
                                "target_lang_word": "организовать",
                                "target_lang_sense_clarification": "спланировать"
                            },
                            {
                                "target_lang_word": "спровоцировать",
                                "target_lang_sense_clarification": "вызвать событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e64af7d2-4942-32be-8a15-8e21c9463942",
                    "sense_definition": "To use genetic techniques to alter the DNA or characteristics of an organism.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists can now <w>engineer</w> crops that are resistant to common pests.",
                            "target_lang_translations": {
                                "ru": "Теперь ученые могут <w>выводить</w> сельскохозяйственные культуры, устойчивые к распространенным вредителям."
                            }
                        },
                        {
                            "text": "The lab was able to <w>engineer</w> bacteria to produce insulin for medical use.",
                            "target_lang_translations": {
                                "ru": "Лаборатория смогла <w>модифицировать</w> бактерии для производства инсулина в медицинских целях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "genetically engineer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять генетический код или характеристики организма с помощью технологий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "модифицировать",
                                "target_lang_sense_clarification": "генетически"
                            },
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "путем инженерии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}