                {
                    "sense_id": "260e6b18-6bd8-30fa-b748-32e75d7ccb96",
                    "sense_definition": "Wstrzymać lub zakończyć trwającą czynność, proces lub stan przed ich naturalnym końcem",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musieliśmy nagle <przerwać> nasze spotkanie z powodu alarmu.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось внезапно <прервать> нашу встречу из-за тревоги.",
                                "en": "We had to suddenly <cut short> our meeting because of the alarm.",
                                "zh": "因为警报，我们不得不突然<中断>会议。"
                            }
                        },
                        {
                            "text": "Postanowił <przerwać> studia i poszukać stałej pracy.",
                            "target_lang_translations": {
                                "ru": "Он решил <прервать> учебу и найти постоянную работу.",
                                "en": "He decided to <drop out of> his studies and look for a steady job.",
                                "zh": "他决定<中断>学业，去找一份全职工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wstrzymać",
                        "zatrzymać",
                        "zaprzestać",
                        "zakończyć",
                        "zaniechać"
                    ],
                    "antonyms": [
                        "kontynuować",
                        "wznowić"
                    ],
                    "common_phrases": [
                        "przerwać pracę",
                        "przerwać milczenie",
                        "przerwać naukę",
                        "przerwać podróż"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приостановить или прекратить действие, процесс или состояние до их естественного завершения",
                        "en": "To suspend, pause, or end an ongoing activity, process, or state before its natural completion",
                        "zh": "在活动、过程或状态自然结束之前将其暂停或终止"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прервать",
                                "target_lang_sense_clarification": "действие, работу, молчание"
                            },
                            {
                                "target_lang_word": "прекратить",
                                "target_lang_sense_clarification": "перестать делать что-либо"
                            },
                            {
