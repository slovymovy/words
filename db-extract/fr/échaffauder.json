                ],
                "senses": [
                    {
                        "sense_id": "deebf575-1d75-313d-8ad4-d897d543eb9b",
                        "entry_id": "f20960a9-4190-3eed-934c-9aea6aa81581",
                        "glosses": [
                            "Orthographe ancienne, parfois encore rencontrée, de échafauder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482cc54e-4b41-4cc6-aa94-4bbdab408b9b",
                                "sense_id": "deebf575-1d75-313d-8ad4-d897d543eb9b",
                                "text": "Je veux bien vous prendre avec moi, mon enfant, dit-il, mais je ne veux pas vous entendre échaffauder vos hypothèses durant tout le trajet!"
                            },
                            {
                                "example_id": "a938c438-3dfb-4199-aa67-b5b0f3703d83",
                                "sense_id": "deebf575-1d75-313d-8ad4-d897d543eb9b",
                                "text": "A la mort du roi, il n’était nullement destiné à jouer un rôle prépondérant dans le monde des diadoques : en particulier, son rôle discret pendant l’expédition orientale du Conquérant lui interdit d’échaffauder des plans grandioses."
                            }
                        ]
                    }
                ],
