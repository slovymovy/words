                "senses": [
                    {
                        "sense_id": "2bd01fa6-336e-35e4-96f2-4d25b8be45b6",
                        "entry_id": "466ce8aa-f317-3cae-b4eb-06f259583503",
                        "glosses": [
                            "Gerät zur Messung der atmosphärischen Wärmestrahlung, die in Richtung der Erde abgestrahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8ae6a9a-266c-4497-a1d2-1cc7d015ce9b",
                                "sense_id": "2bd01fa6-336e-35e4-96f2-4d25b8be45b6",
                                "text": "„Pyrgeometer sollten generell belüftet werden, um eine einheitliche Gehäusetemperatur zu gewährleisten.“"
                            },
                            {
                                "example_id": "fe99357c-dcde-490c-ae92-4fd5b38fb9fa",
                                "sense_id": "2bd01fa6-336e-35e4-96f2-4d25b8be45b6",
                                "text": "„Nach unseren Messungen mit dem Pyrgeometer beträgt die effektive Ausstrahlung Sₑ aber nie mehr als 0,2. Ein in klaren Nächten häufig vorkommender Höchstwert ist 0,15.“"
                            },
                            {
                                "example_id": "77a37c4e-6344-41a9-9b9b-c83798cb2007",
                                "sense_id": "2bd01fa6-336e-35e4-96f2-4d25b8be45b6",
                                "text": "„Die Befürchtung Falkenbergs, daß durch den nächtlichen Temperaturfall Temperaturdifferenzen zwischen dem Pyrgeometer und der umgebenden Luft entstehen könnten, die die Ergebnisse fälschen könnten, ist durch direkte Messungen der Temperaturdifferenz zwischen Apparat und Luft nicht bestätigt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
