{
    "word_family": [
        "соответствие",
        "соответствовать",
        "соответственный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1d010615-5ad2-3255-a2e0-045adba05a60",
                    "sense_definition": "Соразмерно, в зависимости от чего-либо; таким образом, который соответствует обстоятельствам.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "correspondence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Цены на бензин выросли, и стоимость проезда <w>соответственно</w> увеличилась.",
                            "target_lang_translations": {
                                "en": "Gas prices rose, and the fare increased <w>accordingly</w>.",
                                "zh": "汽油价格上涨，车费也<w>相应地</w>增加了。"
                            }
                        },
                        {
                            "text": "Если изменятся условия контракта, нам придётся действовать <w>соответственно</w>.",
                            "target_lang_translations": {
                                "en": "If the contract terms change, we will have to act <w>accordingly</w>.",
                                "zh": "如果合同条款有变，我们必须<w>相应地</w>采取行动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "соразмерно",
                        "пропорционально",
                        "адекватно"
                    ],
                    "antonyms": [
                        "несоответственно"
                    ],
                    "common_phrases": [
                        "измениться соответственно",
                        "поступить соответственно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is appropriate to the particular circumstances or as a result of something.",
                        "zh": "根据某种情况或结果，以相应的方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accordingly",
                                "target_lang_sense_clarification": "as a result; therefore"
                            },
                            {
                                "target_lang_word": "correspondingly",
                                "target_lang_sense_clarification": "in an analogous or equivalent way"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相应地",
                                "target_lang_sense_clarification": "作为结果或与某事相符"
                            },
                            {
                                "target_lang_word": "因此",
                                "target_lang_sense_clarification": "表示结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4c564f3-51a1-3746-a859-36392dad96e3",
                    "sense_definition": "В том же порядке, в каком были названы перечисляемые предметы или лица (употребляется при соотнесении двух рядов перечисления).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ordering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Золотую и серебряную медали получили <w>соответственно</w> российский и китайский спортсмены.",
                            "target_lang_translations": {
                                "en": "The gold and silver medals were awarded to the Russian and Chinese athletes <w>respectively</w>.",
                                "zh": "俄罗斯和中国运动员<w>分别</w>获得了金牌和银牌。"
                            }
                        },
                        {
                            "text": "Анне и Борису сейчас <w>соответственно</w> двадцать и двадцать пять лет.",
                            "target_lang_translations": {
                                "en": "Anna and Boris are twenty and twenty-five years old <w>respectively</w>.",
                                "zh": "安娜和鲍里斯现在<w>分别</w>二十岁和二十五岁。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In the same order as the people or things already mentioned.",
                        "zh": "按照前面提到的顺序。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "respectively",
                                "target_lang_sense_clarification": "in the order given"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分别",
                                "target_lang_sense_clarification": "按照给定的顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c6ef72b-9c19-3528-ba72-06ffa18ed6ec",
                    "sense_definition": "Так, как подобает; должным, подходящим образом.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "correspondence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На официальный приём гости должны быть одеты <w>соответственно</w>.",
                            "target_lang_translations": {
                                "en": "Guests must be dressed <w>appropriately</w> for the official reception.",
                                "zh": "参加正式招待会，客人的着装应当<w>得体</w>。"
                            }
                        },
                        {
                            "text": "Ты уже взрослый человек и должен вести себя <w>соответственно</w>.",
                            "target_lang_translations": {
                                "en": "You are an adult now and should behave <w>appropriately</w>.",
                                "zh": "你已经是成年人了，应该<w>得体地</w>行事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "подобающе",
                        "правильно",
                        "должным образом"
                    ],
                    "antonyms": [
                        "неподобающе"
                    ],
                    "common_phrases": [
                        "одеться соответственно",
                        "выглядеть соответственно",
                        "вести себя соответственно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is suitable, right, or correct for a particular situation.",
                        "zh": "以适合、正确或得体的方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appropriately",
                                "target_lang_sense_clarification": "suitably"
                            },
                            {
                                "target_lang_word": "suitably",
                                "target_lang_sense_clarification": "fittingly"
                            },
                            {
                                "target_lang_word": "properly",
                                "target_lang_sense_clarification": "correctly"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "得体地",
                                "target_lang_sense_clarification": "合适地"
                            },
                            {
                                "target_lang_word": "适当地",
                                "target_lang_sense_clarification": "恰当地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "ac46aca9-6272-36c6-9996-012704444804",
                    "sense_definition": "На основании чего-либо, в согласии с чем-либо (употребляется с дательным падежом).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "correspondence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы всё сделали <w>соответственно</w> вашим указаниям и инструкциям.",
                            "target_lang_translations": {
                                "en": "We did everything <w>according to</w> your directions and instructions.",
                                "zh": "我们一切都<w>按照</w>您的指示和说明做了。"
                            }
                        },
                        {
                            "text": "Наказание было назначено судом <w>соответственно</w> тяжести совершённого преступления.",
                            "target_lang_translations": {
                                "en": "The punishment was assigned by the court <w>in accordance with</w> the severity of the crime committed.",
                                "zh": "法院<w>根据</w>犯罪的严重程度判处了刑罚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "согласно",
                        "сообразно"
                    ],
                    "antonyms": [
                        "вопреки"
                    ],
                    "common_phrases": [
                        "соответственно закону",
                        "соответственно плану",
                        "соответственно желанию"
                    ],
                    "target_lang_definitions": {
                        "en": "In agreement with or as stated by something.",
                        "zh": "与某事一致或根据某事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "according to",
                                "target_lang_sense_clarification": "preposition"
                            },
                            {
                                "target_lang_word": "in accordance with",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按照",
                                "target_lang_sense_clarification": "介词，表示依据"
                            },
                            {
                                "target_lang_word": "根据",
                                "target_lang_sense_clarification": "介词，表示依据"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}