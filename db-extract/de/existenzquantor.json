                    }
                ],
                "senses": [
                    {
                        "sense_id": "04c00d7f-437b-3a83-8d7a-dc53ab2f93b9",
                        "entry_id": "3cc2cf0a-978e-35b4-a592-4129250a680e",
                        "glosses": [
                            "Operator, der ausdrückt, dass es mindestens ein Objekt gibt, welches bestimmte Bedingungen erfüllt"
                        ],
                        "tags": [
                            "Prädikatenlogik"
                        ],
                        "examples": [
                            {
                                "example_id": "0c939ac9-ebaf-425a-acb4-ca700b9618e0",
                                "sense_id": "04c00d7f-437b-3a83-8d7a-dc53ab2f93b9",
                                "text": "„Die Ausdrücke ‚für alle…‘ und ‚es gibt…‘ heißen Quantoren. Dabei heißt ‚für alle…‘ Allquantor und ‚es gibt…‘ Existenzquantor.“"
                            },
                            {
                                "example_id": "274f4526-c7b2-4439-b61f-1b80c3e6d2fa",
                                "sense_id": "04c00d7f-437b-3a83-8d7a-dc53ab2f93b9",
                                "text": "„Quantifiziert wird ein Satz, indem ihm ein All- oder Existenzquantor mit einer Variablen voranstellt wird, die anzeigt, auf welche Stellen im Satz sich dieser Quantor bezieht, und dieser Satz eingeklammert wird, um den Bereich des Quantors anzuzeigen.“"
                            },
                            {
                                "example_id": "c3688f42-99f7-418e-a966-1224374fb573",
                                "sense_id": "04c00d7f-437b-3a83-8d7a-dc53ab2f93b9",
                                "text": "„Eine Existenzaussage ist nur dann falsch, wenn die hinter dem Existenzquantor stehende Aussageform unerfüllbar ist, sonst ist sie wahr oder anders ausgedrückt, sie ist wahr, wenn die Aussageform erfüllbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
