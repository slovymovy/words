                ],
                "translations": [
                    {
                        "translation_id": "13c61aa4-1b32-4f1a-8aa4-f9aff5bbd358",
                        "source_entry_id": "c62feeb6-caff-3a56-b8a7-04034f879fa2",
                        "target_lang_word": "informell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "informell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2575d5-298d-3cef-8c71-1e3755a9bb3f",
                                        "entry_id": "8afe0bdd-155b-3bb8-b12e-06e006d6e766",
                                        "glosses": [
                                            "ohne eine bestimmte Form einzuhalten, nicht förmlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d997feb3-d90a-473b-b81f-c53e7aa9b88f",
                                                "sense_id": "8f2575d5-298d-3cef-8c71-1e3755a9bb3f",
                                                "text": "Der Vertrag kann informell abgeschlossen werden."
                                            },
                                            {
                                                "example_id": "210561cd-0634-4edc-83d9-197bfdcc47ab",
                                                "sense_id": "8f2575d5-298d-3cef-8c71-1e3755a9bb3f",
                                                "text": "„Weil Sorgearbeit informell, in freiwilligem Einsatz und prädisziplinär von Hilfskräften […] geleistet wird und dieser Einsatz effektiv sein soll, ist zu ihm ebenso eine begleitende Anleitung und Weiterbildung nötig wie die Hauptberuflichen für die Zusammenarbeit qualifiziert sein wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "93de244c-9a18-3ea4-80d1-1dd24cadab9e",
                                        "entry_id": "8afe0bdd-155b-3bb8-b12e-06e006d6e766",
                                        "glosses": [
                                            "mitteilend, informierend"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f723dbb9-0d85-454d-bbb9-dfd782761e25",
                                                "sense_id": "93de244c-9a18-3ea4-80d1-1dd24cadab9e",
                                                "text": "Dieser Hinweis besitzt informellen Charakter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95f70f47-15dc-46d2-aef5-767cbb66fcdc",
                        "source_entry_id": "c62feeb6-caff-3a56-b8a7-04034f879fa2",
                        "target_lang_word": "informal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "informal",
