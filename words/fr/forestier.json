            "senses": [
                {
                    "sense_id": "f7b630ef-0f91-3926-a492-375f5b8baa96",
                    "sense_definition": "Personne dont le métier consiste à gérer, surveiller ou exploiter une forêt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>forestier</w> inspecte les jeunes arbres pour surveiller leur croissance et leur santé."
                        },
                        {
                            "text": "Chaque matin, ce <w>forestier</w> passionné parcourt les sous-bois pour entretenir les sentiers."
