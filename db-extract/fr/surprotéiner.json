                ],
                "senses": [
                    {
                        "sense_id": "33311265-9ad4-3e3c-96d5-afa370c17c4a",
                        "entry_id": "fa2d0a24-05f5-3624-b098-2cd3fb23b4f1",
                        "glosses": [
                            "Protéiner plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f40be88-6762-465a-a440-361619db3838",
                                "sense_id": "33311265-9ad4-3e3c-96d5-afa370c17c4a",
                                "text": "(...) ajouté pour surprotéiner cette farine, est connu pour être très peu allergénique puisqu'il est utilisé comme aliment de remplacement dans l'allergie au lait de vache."
                            },
                            {
                                "example_id": "f34f16ff-8662-4d50-ad42-cff2a74b3f7a",
                                "sense_id": "33311265-9ad4-3e3c-96d5-afa370c17c4a",
                                "text": "Par contre, je ne suis pas certaine que ça t'aiderait beaucoup de surprotéiner ton alimentation avec des suppléments"
                            },
                            {
                                "example_id": "06ba543d-382f-4e27-9b1b-9acc29f4a466",
                                "sense_id": "33311265-9ad4-3e3c-96d5-afa370c17c4a",
                                "text": "Éradiquer le problème en remplaçant la viande par du soja, c'est continuer à surprotéiner la machine vache qui n'en a pas besoin, et la traire à mort."
                            }
                        ]
                    }
