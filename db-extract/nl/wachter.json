                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b65c034f-1f03-3e73-9eaf-e8d0205d2994",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A person who, or thing that, protects or watches over something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3e50fc-e601-456d-8c86-e33d52956ff6",
                                                "sense_id": "b65c034f-1f03-3e73-9eaf-e8d0205d2994",
                                                "text": "The prison guard unlocked the door of the cell. After completing the repairs, he replaced the sump guard."
                                            },
                                            {
                                                "example_id": "0359c61e-6ca4-4076-b061-505e3bf1ffc2",
                                                "sense_id": "b65c034f-1f03-3e73-9eaf-e8d0205d2994",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9a60cac-32c7-3ee4-93a4-e403a554d537",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A garda; a police officer."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8965f02a-f295-4327-8aaa-f81d1750588a",
                                                "sense_id": "a9a60cac-32c7-3ee4-93a4-e403a554d537",
                                                "text": "The Garda Regulations 1924 required a candidate for appointment as a guard to be able to produce satisfactory references as to his character"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f24be898-5b39-3056-8972-d4e5c9b8aa76",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A squad responsible for protecting something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a362b8b4-86b4-4857-97be-ca26ac3be2e7",
                                                "sense_id": "f24be898-5b39-3056-8972-d4e5c9b8aa76",
                                                "text": "The president inspected the guard of honour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "789087f8-0f21-3628-8a89-85c89e78f582",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A squad responsible for protecting something.",
                                            "An elite military unit in Russia, the former Soviet Union and several post-Soviet countries."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "768fedfd-9fa5-385f-a674-25a0c40d432b",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "The part of a sword that protects the wielder's hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef8c02c-301c-4470-bb94-af2287939f08",
                                                "sense_id": "768fedfd-9fa5-385f-a674-25a0c40d432b",
                                                "text": "Holonym: hilt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f701235-1c14-39f5-8b53-6f0e7453efaa",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A part of a machine which blocks access to dangerous parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c80b89e-f08c-4325-97ab-e07bc16986b1",
                                                "sense_id": "8f701235-1c14-39f5-8b53-6f0e7453efaa",
                                                "text": "The motorcycle mechanic removed the damaged chain guard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6e79dee-11f8-3d24-8fa9-26f3bfaadaac",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A watchchain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2962320a-7347-3962-b7ac-a840ae2929f8",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A panel of a car that encloses the wheel area, especially the front wheels."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18c35123-f641-4714-8ec7-428506db45eb",
                                                "sense_id": "2962320a-7347-3962-b7ac-a840ae2929f8",
                                                "text": "Another possible way is to go for a lower profile tyre (50 series). This effectively lowers the distance of the tyre wall away from the guard (not by much though and generally, the lower the profile, the wider the tyre so the tyre may stick out more as well)."
                                            },
                                            {
                                                "example_id": "e6eb2d8b-daf2-4f02-b492-e414478bc491",
                                                "sense_id": "2962320a-7347-3962-b7ac-a840ae2929f8",
                                                "text": "The reason I'm asking - Whenever I put some weight in the back of the car (say - a passenger or two) the rear tyres can sometimes hit the guards."
                                            },
                                            {
                                                "example_id": "2fc8d5b1-2f98-41a3-8dc4-a17f5c5c7ab3",
                                                "sense_id": "2962320a-7347-3962-b7ac-a840ae2929f8",
                                                "text": "I had just bought myself broken headlights, a f**ked up grill, a front guard bent into my front tyre, a leaky radiator and one *SLIGHTLY* bent chassis rail end. I turned the key on my stalled motor and she kicked over first go - if it weren't for the guard bent into the tyre, I could've driven home later if I wanted to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ced73cb-0aab-3cf0-bf4f-fb7e368f3fda",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A state of caution; posture of defence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5cef6f2-9ae4-3b9d-bcf7-6a8e8cf6c66d",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "Something worn to protect part of the body, e.g. the shins in cricket."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe6052b3-a9d0-3d49-a5aa-82d57b09f28b",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A relatively short player, playing farther from the basket than a forward or centre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ebff8e5-3233-394c-8688-a85d011c196d",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "The position on the popping crease where a batsman makes a mark to align himself with the wicket; see take guard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12a816c0-914d-3c89-bca1-883551d5a477",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "Either of two offensive positions between the centre and each of the offensive tackles, whose main responsibilities are to protect the quarterback, and open up \\\"holes\\\" through which offensive players can run."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba85dd10-6781-30a1-8ff7-147558c99ebb",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A ground grappling position in which one combatant has their back to the ground while attempting to control the other combatant using their legs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "888bc996-94cc-3001-a5bb-1829d7a0d0c8",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A player playing a position named guard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92c039cb-380b-393b-a4d5-6021cf7bdd01",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "An employee, normally travelling in the last vehicle of a train, responsible for the safety of the train."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12c25d0-bcfd-4203-8d84-97e821b7244d",
                                                "sense_id": "92c039cb-380b-393b-a4d5-6021cf7bdd01",
                                                "text": "When an engineer wished to stop a swiftly moving train he had first to whistle to the guard requesting him to apply the hand-brake of the van, and then apply the hand-brake of the engine. Guards did not always hear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256eacd3-75f6-36bd-b188-aae1435c4287",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A Boolean expression that must evaluate to true for a branch of program execution to continue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "404c4860-eaa6-324b-9c60-7b4d80909460",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "The aircraft emergency frequency, a radio frequency reserved for emergency communications, typically 121.5MHz for civilian use."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "guard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edc72730-3ab2-3f15-a04f-e32a8a7fb802",
                                        "entry_id": "1acc8b59-cef2-3ae6-8ed3-a97b78cde97f",
                                        "glosses": [
                                            "To protect from danger; to secure against surprise, attack, or injury; to keep in safety; to defend."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a9d680-f38a-4c5e-bcd4-66043cc05e6f",
                                                "sense_id": "edc72730-3ab2-3f15-a04f-e32a8a7fb802",
                                                "text": "For Heaven still guards the right."
                                            },
                                            {
                                                "example_id": "c77b1cd8-4cfb-4b83-b4d6-4e0d5ccffdbe",
                                                "sense_id": "edc72730-3ab2-3f15-a04f-e32a8a7fb802",
                                                "text": "Henceforth, wherever thou may’st roam,\n⁠My blessing, like a line of light,\n⁠Is on the waters day and night,\nAnd like a beacon guards thee home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d835d8-2ca7-3dec-aa6b-0b9d9d85ed17",
                                        "entry_id": "1acc8b59-cef2-3ae6-8ed3-a97b78cde97f",
                                        "glosses": [
                                            "To keep watch over, in order to prevent escape or restrain from acts of violence, or the like."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4ad092b-feea-45be-84bd-9d1f9d9c387d",
                                                "sense_id": "14d835d8-2ca7-3dec-aa6b-0b9d9d85ed17",
                                                "text": "Guard the prisoner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94a47b8f-96a0-3370-8e07-f01e8c6d64f2",
                                        "entry_id": "1acc8b59-cef2-3ae6-8ed3-a97b78cde97f",
                                        "glosses": [
                                            "To watch by way of caution or defense; to be cautious; to be in a state or position of defense or safety."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6f1bfaf-a7e0-487a-955c-84b7c3952c58",
                                                "sense_id": "94a47b8f-96a0-3370-8e07-f01e8c6d64f2",
                                                "text": "Careful people guard against mistakes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e29a04-a60d-3b7f-a643-d475b23b5b31",
                                        "entry_id": "1acc8b59-cef2-3ae6-8ed3-a97b78cde97f",
                                        "glosses": [
                                            "To protect the edge of, especially with an ornamental border; hence, to face or ornament with lists, laces, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e588624e-218e-4312-a30f-9f3d408a44f9",
                                                "sense_id": "a1e29a04-a60d-3b7f-a643-d475b23b5b31",
                                                "text": "The body of your discourse is sometime guarded with fragments, and the guards are but slightly basted on neither."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aebe350d-3483-3990-86c8-bdad9253d977",
                                        "entry_id": "1acc8b59-cef2-3ae6-8ed3-a97b78cde97f",
                                        "glosses": [
                                            "To fasten by binding; to gird."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
