                                "target_lang_sense_clarification": "evolutionary origin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0682a86-b5c2-3b43-a3c5-c8dc09e02093",
                    "sense_definition": "De historische ontwikkeling of voorgeschiedenis van een niet-biologische entiteit, zoals een taal of symbool.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "herkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De taalkundige onderzocht de historische <w>afstamming</w> van dit dialectwoord.",
                            "target_lang_translations": {
