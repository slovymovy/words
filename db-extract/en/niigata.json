                                        "examples": [
                                            {
                                                "example_id": "4518a149-3bf5-47ef-91c2-03748fe07496",
                                                "sense_id": "5140ecc1-6900-3a8d-8b20-b01d033ac201",
                                                "text": "L’objectif fixé par la 3ᵉ Stratégie pour la biodiversité est de faire nicher 60 ibis dans la préfecture de Niigata d’ici à 2015."
                                            }
                                        ]
