            {
                "entry_id": "989a45e4-6714-3f4f-adcf-7b1c5f310a94",
                "word": "eep",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d520ebda-76e7-429c-b161-52eecae0daf3",
                        "entry_id": "989a45e4-6714-3f4f-adcf-7b1c5f310a94",
                        "tags": [
