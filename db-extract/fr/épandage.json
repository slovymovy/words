                        "entry_id": "d51f4115-75a2-3f5d-b3cc-7db22684bc9f",
                        "glosses": [
                            "Action d’épandre sur les terrains mis en culture des eaux d’égout amenées par canalisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04225977-1100-4dd4-a3ab-244e94ceec2b",
                                "sense_id": "e354d742-99e9-3832-9a6a-f339e3b509f2",
                                "text": "Terrain d’épandage. — Cette plaine est un terrain d’épandage."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4936f4e-c998-3506-b854-9f12d199cd2c",
                        "entry_id": "d51f4115-75a2-3f5d-b3cc-7db22684bc9f",
                        "glosses": [
                            "Action d’épandre toute matière fertilisante sur les champs et les prés."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "9b21cabc-7ccf-4523-abd7-cbf0b5e01226",
                                "sense_id": "f4936f4e-c998-3506-b854-9f12d199cd2c",
                                "text": "Ces diverses opérations pourraient être complétées par l’épandage de scories pulvérulentes à faible dose qui continueraient l’action de la chaux […]"
                            },
                            {
                                "example_id": "6a968495-cd2c-4912-9663-affd9f34fa5c",
                                "sense_id": "f4936f4e-c998-3506-b854-9f12d199cd2c",
                                "text": "Ces escarmouches n’étaient rien auprès des batailles qui se jouaient aux champs d’épandage de Saint-Denis, de Bicêtren ou d’Aubervilliers."
                            }
                        ]
                    },
                    {
                        "sense_id": "02fde0db-4752-360e-8822-ce5d36308b1f",
                        "entry_id": "d51f4115-75a2-3f5d-b3cc-7db22684bc9f",
                        "glosses": [
                            "Action d'épandre tout autre produit agricole comme les herbicides."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "1f8b0804-5b6a-4394-b4a3-e8d780099ad2",
                                "sense_id": "02fde0db-4752-360e-8822-ce5d36308b1f",
                                "text": "Voter contre l'interdiction d'épandage des produits phytosanitaires à proximité des habitations, contre l'indemnisation des victimes de ces produits, ou encore contre la suppression de l'avantage fiscal pour l'importation d'huile de palme ... et devenir ministre de l'écologie !"
                            }
                        ]
                    },
                    {
                        "sense_id": "88120347-4218-3cb6-b34a-dcc70b82b9d9",
                        "entry_id": "d51f4115-75a2-3f5d-b3cc-7db22684bc9f",
                        "glosses": [
                            "Action d'épandre un produit pour diminuer les risques inhérents à la conduite sur la glace ou la neige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d467eae-b249-44ce-ae74-13836b07bfd3",
                                "sense_id": "88120347-4218-3cb6-b34a-dcc70b82b9d9",
                                "text": "Des opérations d’épandage d’abrasif et le déblaiement des voies et trottoirs sont déjà en cours."
                            }
                        ]
                    }
