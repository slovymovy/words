                                        "entry_id": "d80e0832-98f9-3a10-9d77-cdb90487731f",
                                        "glosses": [
                                            "A four-dimensional object analogous to a dodecahedron, constructed out of one hundred and twenty dodecahedra, arranged 4 to a vertex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b42a82f-bafa-41d7-ad18-a04baa5cc578",
                                                "sense_id": "0f76122a-570e-3cc6-89ec-af9a927f5e77",
                                                "text": "The pentachoron, the hecatonicosachoron, and the hexacosichoron all have dichoral angles which are not divisors of 2π, and consequently, they are not space-filling."
                                            },
                                            {
                                                "example_id": "b410276e-6e3f-4281-a21a-ce9ffec8ee76",
                                                "sense_id": "0f76122a-570e-3cc6-89ec-af9a927f5e77",
                                                "text": "The hecatonicosachoron (dodecaplex or 120-cell) and the hexacosichoron (tet- raplex or 600-cell) are also unique polychora, which have no analogs in higher dimensions."
                                            },
                                            {
                                                "example_id": "cb8ff10f-df37-4536-9a2b-b6ed55b92dff",
                                                "sense_id": "0f76122a-570e-3cc6-89ec-af9a927f5e77",
                                                "text": "The pentachoron, hypercube, orthoplex, hecatonicosachoron, and hexacosichoron are analogues of the ordinary Platonic solids."
                                            }
                                        ]
                                    }
                                ]
