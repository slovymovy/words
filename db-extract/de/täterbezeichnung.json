                                        "entry_id": "4a5fb945-b94d-3592-9e13-790f4f5b1ce7",
                                        "glosses": [
                                            "A noun that denotes an agent (human or nonhuman) that performs the action denoted by the verb from which the noun is derived, such as \\\"rider\\\" derived from \\\"to ride\\\", or \\\"cutter\\\" derived from \\\"to cut\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "670e5338-7291-446b-bb7d-ecbe028d9f63",
                                                "sense_id": "fc07ea8b-bfbb-3404-aec1-7f286d2da269",
                                                "text": "The agent noun \"cutter\" means a person who cuts, or a thing that is made to or is able to cut something."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
