                    },
                    {
                        "translation_id": "04b063c3-ac52-4ab4-bc91-7a9c2a508414",
                        "source_entry_id": "de220178-2e5c-36ef-ad84-49a19f4f237b",
                        "source_sense_id": "e6cc824c-88b0-3287-a07b-2033815d5cf0",
                        "source_sense_description": "ungesäuertes Brot",
                        "target_lang_word": "pain azyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pain azyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4617886-1fe5-34a7-b2e4-f92a15ecd457",
                                        "entry_id": "06ca8c86-f8a1-3e09-9e50-444601010408",
                                        "glosses": [
                                            "Sorte de pain sans levain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd1737d-5e40-4750-90c5-eb3f4bffb3db",
                                                "sense_id": "c4617886-1fe5-34a7-b2e4-f92a15ecd457",
                                                "text": "Le levain est donc une chose essentielle pour que le pain soit de bon goût, bien nourrissant et sain, trois qualités principales dans un aliment, qualités que n'a pas le pain sans levain, qu'on nomme pain azyme. Le pain sans levain se digère plus difficilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c044a20-d11d-374a-8021-2580bf8bd4a6",
                                        "entry_id": "06ca8c86-f8a1-3e09-9e50-444601010408",
                                        "glosses": [
                                            "Genre de papier comestible généralement à base de fécule de pomme de terre, utilisé par exemple dans la fabrication du nougat."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d108fd5c-378c-4b40-ba4d-6aba714a1965",
                                                "sense_id": "7c044a20-d11d-374a-8021-2580bf8bd4a6",
                                                "text": "Tous les nougats blancs doivent être recouverts dessus et dessous de pain azyme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "590de5d0-61a0-4bc3-ad0c-a1c32e78b894",
                        "source_entry_id": "de220178-2e5c-36ef-ad84-49a19f4f237b",
                        "source_sense_id": "e6cc824c-88b0-3287-a07b-2033815d5cf0",
                        "source_sense_description": "ungesäuertes Brot",
                        "target_lang_word": "azyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "azyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52343859-641d-3953-9f1d-ca6497c1906a",
                                        "entry_id": "491b44a1-3b6e-3fee-9989-efdf1b716ee6",
                                        "glosses": [
                                            "Qui est sans levain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10feb760-89d1-43eb-8947-ef2eb1b063d5",
                                                "sense_id": "52343859-641d-3953-9f1d-ca6497c1906a",
                                                "text": "Pain azyme, pain sans levain que les Juifs mangent lors de la Pâque. Il se dit aussi du pain en feuilles minces dont on fait les hosties et de l’enveloppe de certaines préparations pharmaceutiques."
                                            },
                                            {
                                                "example_id": "d95a0245-eb5e-4096-b8d5-915e42859175",
                                                "sense_id": "52343859-641d-3953-9f1d-ca6497c1906a",
                                                "text": "Ici comme ailleurs, les bouchers s’appellent Simon Klotz, les drapiers Hirschfeld, le pain azyme de la rue des Écouffes est le meilleur du Continent, le seul véritable puisqu’il est fabriqué sous la surveillance du Grand Rabbin, lequel se fait assister pour ce rite d’un autre rabbin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
