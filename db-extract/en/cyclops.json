                                    {
                                        "sense_id": "61131631-71ee-3cca-8e26-b8133019836f",
                                        "entry_id": "6781ec4f-d6de-3a76-b95b-825946098b70",
                                        "glosses": [
                                            "Sorte de géant monstrueux qui n’a qu’un œil, de forme ronde, au milieu du front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72b78ae0-d5ad-48b5-a9da-254cb498bfd6",
                                                "sense_id": "61131631-71ee-3cca-8e26-b8133019836f",
                                                "text": "Quelques récits mythologiques donnent les cyclopes pour forgerons à Vulcain."
                                            },
                                            {
                                                "example_id": "b1b44603-accc-49af-8d4d-9c290d14915d",
                                                "sense_id": "61131631-71ee-3cca-8e26-b8133019836f",
                                                "text": "L’antre des cyclopes."
                                            },
                                            {
                                                "example_id": "e7e58935-1d03-4878-b93c-1ba3571aef99",
                                                "sense_id": "61131631-71ee-3cca-8e26-b8133019836f",
                                                "text": "L'œil du cyclope est sans paupière. Il ne s'éteint jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4db8e5-20bd-34b3-8e12-67b2d9f7fba9",
                                        "entry_id": "6781ec4f-d6de-3a76-b95b-825946098b70",
                                        "glosses": [
                                            "Quelqu’un qui n’a qu’un seul œil."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c48ecc72-0c19-3704-baad-39476f0572eb",
                                        "entry_id": "6781ec4f-d6de-3a76-b95b-825946098b70",
                                        "glosses": [
                                            "Feu de freinage central surélevé (FFCS), généralement situé à la base ou au sommet de la vitre arrière des automobiles."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89122876-0984-4313-bc1e-cb62c5d68a7d",
                                                "sense_id": "c48ecc72-0c19-3704-baad-39476f0572eb",
                                                "text": "Les cyclopes sont d’abord apparus aux États-Unis en 1986, au Québec le 01/01/1987 et atteignirent l’Europe en 1998."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
