                "senses": [
                    {
                        "sense_id": "49a7463d-beb5-3c52-a414-1b5e5aee7e79",
                        "entry_id": "1ced9407-400a-3f4e-8f9e-4221b74bfd1d",
                        "glosses": [
                            "een zeilwedstrijd of zeiltocht tot het einde toe voltooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed697f0-c555-411b-9946-3950b7234d81",
                                "sense_id": "49a7463d-beb5-3c52-a414-1b5e5aee7e79",
                                "text": "De 30-jarige Fries lag op het moment van de tegenslag in de kopgroep. Met de nodige improvisatie en reparatie kon Postma de race nog wel uitzeilen. Hij kwam als 20ste binnen, op bijna 10 minuten van de Deense winnaar Jonas Högh-Christensen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6100ce64-5557-3014-9177-e666270f8beb",
                        "entry_id": "1ced9407-400a-3f4e-8f9e-4221b74bfd1d",
                        "glosses": [
                            "iets zeilend verlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba6b3bb7-d60c-41ab-b577-f5d8954e9ae7",
                                "sense_id": "6100ce64-5557-3014-9177-e666270f8beb",
                                "text": "Vanaf de sluis kunnen de deelnemers worden uitgezwaaid voordat ze de Westerschelde uitzeilen en aan de Noordzee oversteek beginnen."
                            },
                            {
                                "example_id": "8396b9c7-93c6-4dea-98ec-2ad56f40ac2d",
                                "sense_id": "6100ce64-5557-3014-9177-e666270f8beb",
                                "text": "Maar de race om wie als eerste de doldrums kon uitzeilen, was nog niet gelopen. Een dag later schoof de hele vloot weer in elkaar, waarmee deze etappe eigenlijk een herstart kende."
                            }
                        ]
                    }
                ],
