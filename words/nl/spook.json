{
    "word_family": [
        "spoken",
        "spookachtig",
        "spookhuis",
        "spookrijder",
        "spookstad"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "870ba408-86de-38cb-853c-fed0caf22a44",
                    "sense_definition": "een geestverschijning van een overleden persoon die vaak in een bepaald gebouw rondwaart",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bovennatuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geloof jij echt dat er een <w>spook</w> in dit oude kasteel woont?",
                            "target_lang_translations": {
                                "en": "Do you really believe that a <w>ghost</w> lives in this old castle?"
                            }
                        },
                        {
                            "text": "Het kleine kind was bang voor een <w>spook</w> onder zijn bed.",
                            "target_lang_translations": {
                                "en": "The small child was afraid of a <w>ghost</w> under his bed."
                            }
                        }
                    ],
                    "synonyms": [
                        "geest",
                        "fantoom"
                    ],
                    "common_phrases": [
                        "een wit spook"
                    ],
                    "target_lang_definitions": {
                        "en": "a ghostly apparition of a deceased person that often haunts a specific building"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ghost",
                                "target_lang_sense_clarification": "spirit of a dead person"
                            },
                            {
                                "target_lang_word": "phantom",
                                "target_lang_sense_clarification": "a ghostly figure"
                            },
                            {
                                "target_lang_word": "specter",
                                "target_lang_sense_clarification": "a visible spirit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f738e292-c84b-3451-8e84-b75cdc20c005",
                    "sense_definition": "iets waar men erg bang voor is of een dreigend gevaar voor de toekomst",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conceptueel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>spook</w> van de oorlog hangt al maanden boven het land.",
                            "target_lang_translations": {
                                "en": "The <w>specter</w> of war has been hanging over the country for months."
                            }
                        },
                        {
                            "text": "Veel economen waarschuwen voor het <w>spook</w> van een nieuwe recessie.",
                            "target_lang_translations": {
                                "en": "Many economists warn of the <w>specter</w> of a new recession."
                            }
                        }
                    ],
                    "synonyms": [
                        "fantoom"
                    ],
                    "common_phrases": [
                        "het spook van"
                    ],
                    "target_lang_definitions": {
                        "en": "something that one is very afraid of or a looming danger for the future"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "specter",
                                "target_lang_sense_clarification": "a haunting fear of future trouble"
                            },
                            {
                                "target_lang_word": "ghost",
                                "target_lang_sense_clarification": "a lingering or looming threat"
                            },
                            {
                                "target_lang_word": "phantom",
                                "target_lang_sense_clarification": "an illusory or looming danger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dd07a29-45d8-3ce5-a363-20d64e5f8b9b",
                    "sense_definition": "een vervelend, lastig of ondeugend persoon, vaak een kind of een vrouw",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een verwend <w>spook</w> is dat meisje toch altijd.",
                            "target_lang_translations": {
                                "en": "What a spoiled <w>brat</w> that girl always is."
                            }
                        },
                        {
                            "text": "Dat kleine <w>spook</w> heeft alweer al het snoep opgegeten.",
                            "target_lang_translations": {
                                "en": "That little <w>rascal</w> has eaten all the candy again."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verwend spook"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor kinderen of vrouwen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an annoying, troublesome, or mischievous person, often a child or a woman"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brat",
                                "target_lang_sense_clarification": "a mischievous or annoying child"
                            },
                            {
                                "target_lang_word": "rascal",
                                "target_lang_sense_clarification": "a mischievous person"
                            },
                            {
                                "target_lang_word": "imp",
                                "target_lang_sense_clarification": "a small, mischievous child"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0061e6b7-8765-3a9f-baa3-0b29e3482e62",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>spoken</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>spook</w> 's nachts vaak door het huis als ik niet kan slapen.",
                            "target_lang_translations": {
                                "en": "I often <w>wander</w> through the house at night when I can't sleep."
                            }
                        },
                        {
                            "text": "Soms <w>spook</w> ik wat rond in de tuin om de planten water te geven.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>potter</w> around in the garden to water the plants."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'to haunt' or 'to wander like a ghost'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "haunt",
                                "target_lang_sense_clarification": "to move about like a ghost"
                            },
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "to move around aimlessly at night"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "359497a6-0380-30ff-976f-3039048d351f",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>spoken</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>spook</w> je hier zo laat nog in de keuken?",
                            "target_lang_translations": {
                                "en": "Why are you <w>haunting</w> the kitchen so late?"
                            }
                        },
                        {
                            "text": "Als je zo doorgaat, <w>spook</w> je iedereen in dit huis nog angst aan.",
                            "target_lang_translations": {
                                "en": "If you keep this up, you will <w>frighten</w> everyone in this house."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tweede persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second person singular present tense of 'to haunt' or 'to wander like a ghost'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "haunt",
                                "target_lang_sense_clarification": "to move about like a ghost"
                            },
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "to move around aimlessly at night"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ecbded5-aef2-3d4b-b7bb-f94681789c56",
                    "sense_definition": "gebiedende wijs van <w>spoken</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Spook</w> niet zo in de gang, je maakt de kinderen wakker!",
                            "target_lang_translations": {
                                "en": "Don't <w>wander</w> around the hallway like that, you're waking the children!"
                            }
                        },
                        {
                            "text": "Ga naar je kamer en <w>spook</w> daar maar wat rond.",
                            "target_lang_translations": {
                                "en": "Go to your room and <w>mess</w> around there."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
