                                    {
                                        "sense_id": "05cb2721-e185-3108-a366-09db0caa2e65",
                                        "entry_id": "3c644223-7446-3f4f-9271-d9b3a0e520df",
                                        "glosses": [
                                            "Renonculacée dont la fleur inodore est remarquable par l’éclat et la variété de ses couleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034f7113-fa6a-45f1-9f3a-2fd68c6f3ba7",
                                                "sense_id": "05cb2721-e185-3108-a366-09db0caa2e65",
                                                "text": "L’Inde autrefois nous donna l’anémone,\nDe nos jardins ornement printanier."
                                            },
                                            {
                                                "example_id": "3cae46c4-9c2c-4e64-8062-2e7d8158aa4d",
                                                "sense_id": "05cb2721-e185-3108-a366-09db0caa2e65",
                                                "text": "La production de l’anémone, pour les fleurs coupées ou pour le jardin, est importante en Europe de l’Ouest (Pays-Bas, France, Grande-Bretagne), en Italie, en Israël et aux États-Unis."
                                            },
                                            {
                                                "example_id": "84caf5a9-fdce-448a-a922-71d079546b77",
                                                "sense_id": "05cb2721-e185-3108-a366-09db0caa2e65",
                                                "text": "Sur les conseils de Bébé, j’achetai un genre d’anémones, des Monna-Lisa, je crois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ed19b57-7db4-352b-8192-c22e13467c38",
                                        "entry_id": "3c644223-7446-3f4f-9271-d9b3a0e520df",
                                        "glosses": [
                                            "Anémone de mer ; actinie."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b1c7e48-d7b5-41cb-b0f4-618042a135e7",
                                                "sense_id": "2ed19b57-7db4-352b-8192-c22e13467c38",
                                                "text": "Les canyons hébergent ainsi de nombreux coraux (soixante espèces dans le seul golfe de Gascogne), des anémones, des oursins ou des concombres de mer."
                                            }
                                        ]
                                    }
