                                        "glosses": [
                                            "A palm tree of species Hyphaene thebaica, with edible oval fruit, native to northern Africa and some countries of the Levant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36800838-35ca-4173-8216-61650324a722",
                                                "sense_id": "727e5ba0-1019-39b3-a1f5-aa0041a9546b",
                                                "text": "The country to the east of Derudeb [Sudan] was bleached and sere, and there were long grey cliffs and dom palms growing in the wadis."
                                            }
                                        ]
