                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c0a60237-8eac-4daa-b46c-d628de27e456",
                                "sense_id": "da740f1e-a5f0-3a3b-b551-ec6c8eab5bad",
                                "text": "The third branch of God's authoritative or potestative power consisteth in the use of all things in his possession, by virtue of his absolute dominion."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ee56dfb-1b48-3b03-b36c-edcde9cef06f",
                        "entry_id": "827edbcd-d463-3852-9bfa-f8372b99c620",
                        "glosses": [
                            "of a condition in a legal contract: being completely controlled by exactly one of the parties to the contract"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4accec32-7a76-4f60-948c-cc38dc661ad3",
                                "sense_id": "9ee56dfb-1b48-3b03-b36c-edcde9cef06f",
                                "text": "A potestative condition is that which is in the power of the person in whose favor it is contracted; as, if I engage to give my neighbor a sum of money, in case he cuts down a tree which obstructs my prospect."
                            },
                            {
                                "example_id": "26bd87b8-cdfd-4f6b-a59f-2c5f2c50de68",
                                "sense_id": "9ee56dfb-1b48-3b03-b36c-edcde9cef06f",
                                "text": "Articles 1170 and 1174 of the French Civil Code deal with potestative conditions. The former defines as potestative a contractual condition the fulfillment of which is within the power of one of the contracting parties to bring about or hinder. The latter article provides that every obligation contracted on a potestative condition on the part of him who purports to bind himself is null."
                            }
                        ]
                    }
