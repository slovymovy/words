                                "target_senses": [
                                    {
                                        "sense_id": "6ee282e8-17ca-3b5d-b721-b6fae31d0535",
                                        "entry_id": "6ea33996-5a27-337d-9994-89ae08e6eb2a",
                                        "glosses": [
                                            "To react, using fermentation; especially to produce alcohol by aging or by allowing yeast to act on sugars; to brew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e23de011-5e2e-4b08-a43a-d5fa18f6df93",
                                                "sense_id": "6ee282e8-17ca-3b5d-b721-b6fae31d0535",
                                                "text": "The cleanup job would turn out to be possibly second only to body-recovery duty in terms of being a job that nobody wanted to get assigned to. Imagine, for a moment, a thick soup of oil, paper, ink, clothing, raw meat and other fresh provisions, and worse, that had all been left to collect together in semi-warm water, all enclosed in a large metal container that had then been subjected to heating by first fire and then repeated warm Hawaiian days, and then left to ferment for over a month, and then with most of the water drained away and all the remaining solid and semi-liquid mass collecting together in pools and heaps across multiple decks, still in a relatively-enclosed environment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f4de54a-26d6-3502-9ad7-fa716cde2828",
                                        "entry_id": "6ea33996-5a27-337d-9994-89ae08e6eb2a",
                                        "glosses": [
                                            "To stir up, agitate, cause unrest or excitement in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f57f0638-a098-4c01-b719-ac304a73136f",
                                                "sense_id": "2f4de54a-26d6-3502-9ad7-fa716cde2828",
                                                "text": "Ye vigorous swains! while youth ferments your blood."
                                            },
                                            {
                                                "example_id": "0ea6db84-d71a-47c2-951f-ef9e8cdfcaa4",
                                                "sense_id": "2f4de54a-26d6-3502-9ad7-fa716cde2828",
                                                "text": "Pleas'd have I wander'd thro' your rough domain; / Trod the pure virgin-ſnows, myſelf as pure; / Heard the winds roar, and the big torrent burſt; / Or ſeen the deep fermenting tempeſt brew'd, / In the grim evening ſky."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ferment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f72275f5-2522-37e8-bea6-afd86a16290d",
                                        "entry_id": "3c264613-ec4e-3644-86d8-9f46558c675b",
                                        "glosses": [
                                            "Something, such as a yeast or barm, that causes fermentation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e24e2b2-9e59-3989-833d-085fe45fc08a",
                                        "entry_id": "3c264613-ec4e-3644-86d8-9f46558c675b",
                                        "glosses": [
                                            "A state of agitation or of turbulent change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e815ce-7c80-4420-961d-43c6567488ba",
                                                "sense_id": "0e24e2b2-9e59-3989-833d-085fe45fc08a",
                                                "text": "Subdue and cool the ferment of desire."
                                            },
                                            {
                                                "example_id": "618aff56-55f1-4e4e-a677-997dbf8d4013",
                                                "sense_id": "0e24e2b2-9e59-3989-833d-085fe45fc08a",
                                                "text": "14 November, 1770, Junius, letter to the Right Honourable Lord Mansfield\nThe nation is in a ferment."
                                            },
                                            {
                                                "example_id": "0b68aaea-0ab2-4304-9227-8a359ab10514",
                                                "sense_id": "0e24e2b2-9e59-3989-833d-085fe45fc08a",
                                                "text": "Clad in a Persian-Renaissance gown and a widow's tiara of white batiste, Mrs Thoroughfare, in all the ferment of a Marriage-Christening, left her chamber on vapoury autumn day and descending a few stairs, and climbing a few others, knocked a trifle brusquely at her son's wife's door."
                                            },
                                            {
                                                "example_id": "ad2650da-5bb7-4c64-bc2e-4dd84baf6072",
                                                "sense_id": "0e24e2b2-9e59-3989-833d-085fe45fc08a",
                                                "text": "Proponents of the broken windows theory assume that [disorder] means a neighborhood has lost control and doesn't care about crime. But surely there are other plausible meanings. It could signal artistic ferment, a youth hangout, rebellion, or an alternative lifestyle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fba55375-6a4f-3bf3-a546-9fb5ea3ffbc5",
                                        "entry_id": "3c264613-ec4e-3644-86d8-9f46558c675b",
                                        "glosses": [
                                            "A gentle internal motion of the constituent parts of a fluid; fermentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a648af9a-80fe-4b00-a5ab-3a3bffa1e25d",
                                                "sense_id": "fba55375-6a4f-3bf3-a546-9fb5ea3ffbc5",
                                                "text": "A Rage of Pleaſure madden'd every Breaſt, / Down to the loweſt Lees the Ferment ran: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0c7433-155a-397e-994d-4fc9e7109a90",
                                        "entry_id": "3c264613-ec4e-3644-86d8-9f46558c675b",
                                        "glosses": [
                                            "A catalyst."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
