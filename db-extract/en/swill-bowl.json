                    {
                        "sense_id": "2a0ef02f-fb0f-3cd7-b2bb-69b139be9fe2",
                        "entry_id": "54699dd4-c06f-3656-bd9a-047efd9da08b",
                        "glosses": [
                            "A drunkard."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ec5dd569-5c0e-4dab-bbe7-13bc21a22876",
                                "sense_id": "2a0ef02f-fb0f-3cd7-b2bb-69b139be9fe2",
                                "text": "But nothing like to that hath been shewed since in the English church by the spiritual tyrant of Rome and his mitred termagants, at the provocation of their oiled swill-bowls and blind Balaamites. For they most cruelly brent those innocents which did but only read the testament of God in their mother-tongue; and do not yet repent them of that mischief, but continue therein."
                            },
                            {
                                "example_id": "5f63a5bc-71a4-4a52-a85d-622b7d75ab1c",
                                "sense_id": "2a0ef02f-fb0f-3cd7-b2bb-69b139be9fe2",
                                "text": "Wantonness was never such a swill-bowl of ribaldry; nor Idleness ever such a carouser of knavery."
                            }
                        ]
                    }
                ],
