                                                "sense_id": "72724865-2cce-36da-ab27-7f4f8574fea1",
                                                "text": "This chapter in the great volume of superstition was indeed cultivated with unusual solicitude amongst the Pagans - ornithomancy (or the derivation of omens from the motions of birds) grew into an elaborate science."
                                            },
                                            {
                                                "example_id": "b7424f65-cb53-4ccb-9a05-8eee5aed864f",
                                                "sense_id": "72724865-2cce-36da-ab27-7f4f8574fea1",
                                                "text": "Ornithomancy was a popular way of searching into futurity."
                                            }
                                        ]
