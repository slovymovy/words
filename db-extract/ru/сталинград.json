                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d18af1b-21c4-41e3-8bf4-c2022e9c2166",
                                                "sense_id": "2f250df9-8c9f-3744-ba73-03bb10690a2a",
                                                "text": "Im Zweiten Weltkrieg versuchten die Deutschen Stalingrad einzunehmen, wurden dann jedoch später von den Russen eingekesselt."
                                            },
                                            {
                                                "example_id": "460ed0e4-70d3-41fc-a24e-333f2da374ef",
                                                "sense_id": "2f250df9-8c9f-3744-ba73-03bb10690a2a",
                                                "text": "„Seit Stalingrad hatte sich das Blatt gewendet, und die Sowjetarmee kam immer näher in den Westen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "837cad9d-0582-496c-9ce6-b971647bf9f2",
                        "source_entry_id": "eed06e78-37cf-378f-a0a2-063d4bb15190",
