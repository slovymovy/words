{
    "word_family": [
        "snerp",
        "snerpend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c073be0b-df81-3165-9af4-d16d08a3db9d",
                    "sense_definition": "een erge, scherpe pijn veroorzaken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koude wind begon pijnlijk te <w>snerpen</w> op haar blote gezicht. ",
                            "target_lang_translations": {
                                "en": "The cold wind began to <w>bite</w> painfully on her bare face."
                            }
                        },
                        {
                            "text": "De wond bleef nog urenlang <w>snerpen</w> in de kou. ",
                            "target_lang_translations": {
                                "en": "The wound kept <w>stinging</w> in the cold for hours."
                            }
                        }
                    ],
                    "synonyms": [
                        "steken",
                        "snijden"
                    ],
                    "common_phrases": [
                        "snerpende pijn",
                        "snerpende kou"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause a severe, sharp pain"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sting",
                                "target_lang_sense_clarification": "to produce a sharp, smarting pain"
                            },
                            {
                                "target_lang_word": "bite",
                                "target_lang_sense_clarification": "to cause a sharp, painful or smarting sensation"
                            },
                            {
                                "target_lang_word": "smart",
                                "target_lang_sense_clarification": "to cause sharp, stinging pain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "137d4938-248a-3217-8d7a-05603b72b799",
                    "sense_definition": "een luid, snijdend, schril, scherp en onaangenaam geluid maken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een harde fluittoon begon ineens door de zaal te <w>snerpen</w>. ",
                            "target_lang_translations": {
                                "en": "A loud whistle suddenly began to <w>pierce</w> through the hall."
                            }
                        },
                        {
                            "text": "In het oude huis bleef een schreeuwende stem bitter <w>snerpen</w>. ",
                            "target_lang_translations": {
                                "en": "In the old house, a screaming voice continued to <w>shriek</w> bitterly."
                            }
                        }
                    ],
                    "synonyms": [
                        "krijsen"
                    ],
                    "common_phrases": [
                        "snerpend geluid",
                        "snerpende stem"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a loud, cutting, shrill, sharp, and unpleasant sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pierce",
                                "target_lang_sense_clarification": "to sound sharp or shrill through the air"
                            },
                            {
                                "target_lang_word": "shriek",
                                "target_lang_sense_clarification": "to make a high-pitched, piercing sound"
                            },
                            {
                                "target_lang_word": "cut",
                                "target_lang_sense_clarification": "to make a sharp, penetrating noise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
