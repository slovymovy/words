                    {
                        "translation_id": "52d6b6a2-69fa-44bc-89bc-7a2db10fe8e0",
                        "source_entry_id": "fc2788ac-3824-3a65-a67d-f52188657fcb",
                        "source_sense_id": "955701bf-498d-3d13-8f57-4373a151c520",
