                    {
                        "translation_id": "29e70760-138b-478b-aad3-b7726288383d",
                        "source_entry_id": "a1e2871f-f615-3c90-be8e-f1c33e6f26b9",
                        "source_sense_id": "abf85f24-c26a-34b4-a925-9a2be711459e",
                        "target_lang_word": "disadvantage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disadvantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "A weakness or undesirable characteristic; con; drawback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171e49af-66f9-4007-aeb8-db815217f4d8",
                                                "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                                "text": "The disadvantage to owning a food processor is that you have to store it somewhere."
                                            },
                                            {
                                                "example_id": "eebef41c-d113-4c2d-b2e5-09afb7799834",
                                                "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                                "text": "One of the disadvantages of increasing intermediate stops is that, as we have pointed out already, certain prestige trains have to suffer, notably the \"Cornish Riviera Express\", slowed 15min to Plymouth by stops at Taunton and Exeter; the \"Torbay Express\", decelerated 18min by stops at Reading, Westbury, Taunton and Newton Abbot; and the \"Bristolian\", which adds 14min in order to allow for a Bath stop and an increased load."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "A setback or handicap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80eaba6-79c3-48bd-af4f-0628699f5abd",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "My height is a disadvantage for reaching high shelves."
                                            },
                                            {
                                                "example_id": "255f5862-20f3-48ab-b649-4c60190babe6",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "I was brought hither under the disadvantage of being unknown, even by sight, to any of you."
                                            },
                                            {
                                                "example_id": "4791ad39-9313-4b2a-9134-5ec9f7196d70",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "1859-1890, John G. Palfrey, History of New England to the Revolutionary War\nAbandoned by their great patron, the faction henceforward acted at disadvantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474ab26a-4db3-3573-8b7b-7ece30c9e7e1",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "Loss; detriment; hindrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fabbf53-3c78-404a-abcd-399d5e41e0cd",
                                                "sense_id": "474ab26a-4db3-3573-8b7b-7ece30c9e7e1",
                                                "text": "They would throw a construction on his conduct, to his disadvantage before the public."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disadvantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                        "entry_id": "c2d49292-1d65-3a95-ab29-e8252a746359",
                                        "glosses": [
                                            "To place at a disadvantage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338fa432-fad7-438e-aafa-40f7007c4420",
                                                "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                                "text": "They fear it might disadvantage honest participants to allow automated entries."
                                            },
                                            {
                                                "example_id": "d5053aeb-1a50-4186-8e81-e831caa3049b",
                                                "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                                "text": "For London to have its own exclusive immigration policy would exacerbate the sense that immigration benefits only certain groups and disadvantages the rest. It would entrench the gap between London and the rest of the nation. And it would widen the breach between the public and the elite that has helped fuel anti-immigrant hostility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "255d5a64-457e-440d-9b63-82aa904dad7a",
                        "source_entry_id": "a1e2871f-f615-3c90-be8e-f1c33e6f26b9",
                        "source_sense_id": "abf85f24-c26a-34b4-a925-9a2be711459e",
                        "target_lang_word": "élément négatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e4d9c239-c58c-4155-983e-bc0e92c9c6bf",
                        "source_entry_id": "a1e2871f-f615-3c90-be8e-f1c33e6f26b9",
                        "source_sense_id": "abf85f24-c26a-34b4-a925-9a2be711459e",
                        "target_lang_word": "bémol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bémol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fbfe115-dda8-3685-aa0d-980cea103781",
                                        "entry_id": "ee39acef-b773-3f12-9b68-5126ecb7200b",
                                        "glosses": [
                                            "Symbole graphique (♭) appartenant à la famille des altérations. Placé à la clef ou devant une note sur une partition de musique, il indique que la hauteur naturelle de la note associée à ce bémol doit être abaissée d’un demi-ton chromatique."
                                        ],
                                        "tags": [
                                            "Solfège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30dbdc3a-220f-4933-8467-e973eeba9c6c",
                                                "sense_id": "9fbfe115-dda8-3685-aa0d-980cea103781",
                                                "text": "Mettre un bémol à une note, devant une note, un bémol, deux bémols à la clef."
                                            },
                                            {
                                                "example_id": "636a8758-9b66-409d-b43f-5d6fe8c893a9",
                                                "sense_id": "9fbfe115-dda8-3685-aa0d-980cea103781",
                                                "text": "Si j’avais le bonheur de savoir comme quoi un bémol de plus à la clef peut rendre un quatuor de flûtes et de bassons plus partisan du Directoire que du Consulat et de l’Empire, je ne parlerais plus, je chanterais éternellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2ded68b-c741-3b17-bded-d2ed428c30ea",
                                        "entry_id": "ee39acef-b773-3f12-9b68-5126ecb7200b",
                                        "glosses": [
                                            "Modérateur de satisfaction, d’enthousiasme."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e1efa8-6941-42d1-bd0f-8791e8b55438",
                                                "sense_id": "e2ded68b-c741-3b17-bded-d2ed428c30ea",
                                                "text": "Un bémol d’autant plus regrettable qu’au-delà du thème de la résilience, ce sport occupe une vraie place dans le film."
                                            },
                                            {
                                                "example_id": "ad8b039a-f3d6-4310-9fc4-cd9bd1fc2a2f",
                                                "sense_id": "e2ded68b-c741-3b17-bded-d2ed428c30ea",
                                                "text": "Petit bémol : ces écouteurs ne sont pas multipoints."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bémol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34ef5772-53e4-3778-98cb-c4f2b29a59a0",
                                        "entry_id": "1be60277-3c87-39ce-8b36-aa0480be4a82",
                                        "glosses": [
                                            "Qui est abaissé d’un demi-ton chromatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d89deb5-ddac-4abd-ad34-5a72f1b42c0c",
                                                "sense_id": "34ef5772-53e4-3778-98cb-c4f2b29a59a0",
                                                "text": "Un si bémol."
                                            },
                                            {
                                                "example_id": "b32db336-9a4f-4777-bac0-dbcc1f86e4cd",
                                                "sense_id": "34ef5772-53e4-3778-98cb-c4f2b29a59a0",
                                                "text": "Une note bémol."
                                            },
                                            {
                                                "example_id": "f167afe0-6516-4a3c-8891-571194888ec9",
                                                "sense_id": "34ef5772-53e4-3778-98cb-c4f2b29a59a0",
                                                "text": "Si bien qu’à la fin du déjeuner il a appelé le garçon sur un beau si bémol dont les vitres tremblaient et il a passé son bras sous le mien."
                                            },
                                            {
                                                "example_id": "e519b75a-e849-4add-b0ca-5263df85e1a3",
                                                "sense_id": "34ef5772-53e4-3778-98cb-c4f2b29a59a0",
                                                "text": "Quand le mi bémol fit son entrée dans le salon, le do et le sol le considérèrent comme une tierce personne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
