                "senses": [
                    {
                        "sense_id": "a7a252d3-7433-3696-8176-528d41fbe911",
                        "entry_id": "6f61ba9c-63ee-33f2-97f3-b4d757e72a61",
                        "glosses": [
                            "Fachmann, der sich in einem Tiergarten mit den äußeren Merkmalen von Vogeleiern beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f86ae6-60cd-41fc-abec-fcd5aeba1e82",
                                "sense_id": "a7a252d3-7433-3696-8176-528d41fbe911",
                                "text": "„Gut gefiel mir die Donauauaufforstung wegen dieses auauau, auch der Zoooologe, das ist ein Eierkundler (Oologe), der im Zoo arbeitet.“"
                            },
                            {
                                "example_id": "5e4620fd-3e2a-4bd9-b7d4-d46b3cc15b64",
                                "sense_id": "a7a252d3-7433-3696-8176-528d41fbe911",
                                "text": "„Arbeitet ein Oologe in einem Zoo, so ist er ein Zoooologe.“"
                            },
                            {
                                "example_id": "30730804-bb88-4f03-ac64-64aa90539645",
                                "sense_id": "a7a252d3-7433-3696-8176-528d41fbe911",
                                "text": "„Das kleine o findet sich im Zoooologen, dem Eierkundler im Tierpark, vier mal nacheinander wieder, ‚Rekord – und alles streng nach Duden, unser aller Mutter. Weltklasse!‘“"
                            }
                        ],
