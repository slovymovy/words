            {
                "entry_id": "91b3e7ac-d05c-359a-a2cc-dc33f1180b73",
                "word": "térébrant",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bec96cdc-ca52-4d8e-8b4d-da1c856e647f",
                        "entry_id": "91b3e7ac-d05c-359a-a2cc-dc33f1180b73",
                        "tags": [
