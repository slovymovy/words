                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7bd4373-f5b7-4b57-9674-1a90d70509e2",
                                "sense_id": "a078c9d9-870c-381c-b55d-a92dd1af0164",
                                "text": "Der Adler kehrte zu seinem Adlerhorst zurück."
                            },
                            {
                                "example_id": "2b1ff05a-4a8c-4fa7-8da8-e360ab357845",
                                "sense_id": "a078c9d9-870c-381c-b55d-a92dd1af0164",
                                "text": "„Das Kloster in Phugtal, in dem sie jetzt arbeiteten, war wie ein Adlerhorst in die Berge gebaut, ein Häufchen weiß getünchter Häuser, die an der nackten Felswand klebten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
