                        "examples": [
                            {
                                "example_id": "f4717c35-8cd1-43a8-8a8d-110a2a1f90ef",
                                "sense_id": "76cf1782-d8d5-3f83-b70d-bf279ea7624a",
                                "text": "Ook is het leuk zelf te oordelen over wat architectonisch blad De Opmerker in 1867 schreef: 'Een huis, welks benedenverdieping zeer laag en gedrukt is, zoo laag en gedrukt, dat de voordeur aanmerkelijk is verhoogd moeten worden.' Huis Caramelli is alleen zondag geopend."
                            },
                            {
                                "example_id": "c79dd824-b488-4a2a-9bf7-0357e533a348",
                                "sense_id": "76cf1782-d8d5-3f83-b70d-bf279ea7624a",
                                "text": "Moet een scherp opmerker niet vaststellen dat ook het reformatorische leven de invloed van de secularisatie ondergaat? Kunnen we het volhouden om Reformatie en secularisatie zo van elkaar te scheiden als ik hierboven heb gedaan?"
                            }
                        ]
                    }
