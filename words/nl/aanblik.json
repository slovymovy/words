    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac2ab4ea-47dc-388f-a6ca-a0e712488ccd",
                    "sense_definition": "het waarnemen of zien van iets of iemand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij genoot van de <w>aanblik</w> van al de mooie schilderijen in het museum.",
                            "target_lang_translations": {
                                "en": "He enjoyed the <w>sight</w> of all the beautiful paintings in the museum."
                            }
                        },
                        {
                            "text": "Bij de eerste <w>aanblik</w> van zijn verwoeste huis moest hij huilen.",
                            "target_lang_translations": {
                                "en": "At first <w>sight</w> of his destroyed house, he had to cry."
                            }
                        }
                    ],
                    "synonyms": [
                        "gezicht",
                        "schouwspel"
                    ],
                    "common_phrases": [
                        "bij de eerste aanblik",
                        "de aanblik verdragen"
                    ],
                    "target_lang_definitions": {
                        "en": "the act of perceiving or seeing something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sight",
                                "target_lang_sense_clarification": "the act of seeing something"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "the act of looking at something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2c92f62-ff2f-32b3-b82d-a241f115c00f",
                    "sense_definition": "de uiterlijke verschijning of het aanzien van iets of iemand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hoge muren gaven het gebouw een strenge <w>aanblik</w>.",
                            "target_lang_translations": {
                                "en": "The high walls gave the building a stern <w>appearance</w>."
                            }
                        },
                        {
                            "text": "Ze droeg een blouse die haar een zeer strenge <w>aanblik</w> gaf.",
                            "target_lang_translations": {
                                "en": "She wore a blouse that gave her a very <w>stern</w> <w>look</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uiterlijk",
                        "aanzien",
                        "aspect",
                        "verschijning"
                    ],
                    "common_phrases": [
                        "een strenge aanblik",
                        "een treurige aanblik"
                    ],
                    "target_lang_definitions": {
                        "en": "the outward appearance or look of something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appearance",
                                "target_lang_sense_clarification": "the way something looks"
                            },
                            {
                                "target_lang_word": "sight",
                                "target_lang_sense_clarification": "the visual impression of something"
                            },
                            {
                                "target_lang_word": "aspect",
                                "target_lang_sense_clarification": "a particular appearance or quality"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50db92a2-a5e8-3779-b45a-13bf28a658c6",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>aanblikken</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik weet niet wat ik zie als ik dit schilderij <w>aanblik</w>.",
                            "target_lang_translations": {
                                "en": "I don't know what I'm seeing when I <w>behold</w> this painting."
                            }
                        },
                        {
                            "text": "Het is een prachtig moment dat ik nu <w>aanblik</w>.",
                            "target_lang_translations": {
                                "en": "It is a beautiful moment that I am <w>gazing at</w> now."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'aanblikken' (to gaze at/behold)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "behold",
                                "target_lang_sense_clarification": "to gaze upon or look at"
                            },
                            {
                                "target_lang_word": "gaze at",
                                "target_lang_sense_clarification": "to look steadily at something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
