                "senses": [
                    {
                        "sense_id": "fcde0c0c-db5f-38f2-b3f1-abb60f938141",
                        "entry_id": "2c47a0ab-4e4c-3b58-a473-a2c8d9e6d1f5",
                        "glosses": [
                            "A man who serves in the armed forces."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "53cd6b9e-24ba-378b-8c27-133ca83494fb",
                        "entry_id": "2c47a0ab-4e4c-3b58-a473-a2c8d9e6d1f5",
                        "glosses": [
                            "A person, especially a man, employed in service and maintenance of equipment."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e055717-28e2-4e06-9c7e-4378866b0664",
                        "source_entry_id": "2c47a0ab-4e4c-3b58-a473-a2c8d9e6d1f5",
                        "source_sense_description": "man who serves in the armed forces",
                        "target_lang_word": "militaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "militaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd18b8f-5d5e-31dc-beff-1798ef6fd18a",
                                        "entry_id": "77906fb8-6241-3ced-8986-35ce06187b40",
                                        "glosses": [
                                            "Qui concerne la guerre ou les armées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "217b495c-de37-4df0-805f-68439f575680",
                                                "sense_id": "ddd18b8f-5d5e-31dc-beff-1798ef6fd18a",
                                                "text": "La dernière grande guerre qu’avait soutenue l’Angleterre, la guerre contre les Boers, était oubliée, et le public avait perdu l’habitude de la critique militaire experte."
                                            },
                                            {
                                                "example_id": "f8c847d7-7788-4b3d-ae19-a90ef4b9b6cf",
                                                "sense_id": "ddd18b8f-5d5e-31dc-beff-1798ef6fd18a",
                                                "text": "Acceptons que le courage militaire demeure l’apanage d’une caste enfantine et bruyante, et ne se répande pas, comme l’a fait la Légion d’honneur, son insigne, parmi les professeurs, les contrôleurs, les peintres..."
                                            },
                                            {
                                                "example_id": "0b1b84d3-8040-4d41-8a31-0c6d15f2d7f5",
                                                "sense_id": "ddd18b8f-5d5e-31dc-beff-1798ef6fd18a",
                                                "text": "Un adolescent est retiré de la file. Juste avant qu’une forte détonation venue d’une tour militaire l’envoie bouler sur l’asphalte, la tête broyée par une balle de mitrailleuse."
                                            },
                                            {
                                                "example_id": "bcc7ac9b-ce04-475b-a864-c7c040679790",
                                                "sense_id": "ddd18b8f-5d5e-31dc-beff-1798ef6fd18a",
                                                "text": "La supériorité militaire écrasante de l’hyperpuissance américaine lui permet certes d’organiser ses expéditions sans l’aide de personne. Mais ces opérations punitives ne peuvent fonder un nouvel ordre du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de8b04ac-b9d2-3648-bdea-3ffd3322dfe3",
                                        "entry_id": "77906fb8-6241-3ced-8986-35ce06187b40",
                                        "glosses": [
                                            "Destiné à l’usage des troupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a105daab-3fa2-4aca-92ca-029e8ef8bcc9",
                                                "sense_id": "de8b04ac-b9d2-3648-bdea-3ffd3322dfe3",
                                                "text": "Cette voie est une route militaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ba19dc-95a5-359d-90fe-51db3b5f02bf",
                                        "entry_id": "77906fb8-6241-3ced-8986-35ce06187b40",
                                        "glosses": [
                                            "Autoritaire ; discipliné."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ad5f627-34c3-4ed7-9b4f-b27e8ff93b00",
                                                "sense_id": "29ba19dc-95a5-359d-90fe-51db3b5f02bf",
                                                "text": "Cependant il est un agent de la Compagnie, qui ne doit pas quitter son poste, c’est Popof, – Popof, notre chef de train, un vrai Russe, l’air militaire avec sa houppelande plissée et sa casquette moscovite, très chevelu et très barbu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "militaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23a9b399-d036-32f8-a3f4-1647684eca18",
                                        "entry_id": "14d5a2c3-58df-3dd8-aedc-8709af66c00c",
                                        "glosses": [
                                            "Personne membre d’une armée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52338a8a-7351-4389-b57b-92d724fac9a7",
                                                "sense_id": "23a9b399-d036-32f8-a3f4-1647684eca18",
                                                "text": "Je connais les militaires, ma Julie ; j’ai vécu aux armées. Il est rare que le cœur de ces gens-là puisse triompher des habitudes produites ou par les malheurs au sein desquels ils vivent, ou par les hasards de leur vie aventurière."
                                            },
                                            {
                                                "example_id": "a023d42c-d292-4134-ba5e-8a43d3a6c679",
                                                "sense_id": "23a9b399-d036-32f8-a3f4-1647684eca18",
                                                "text": "Après l’armée des incendiaires, l’armée des voleurs ! Il n’y a pas ici de corps spéciaux. Tout le monde, par le fait qu’il est militaire, fait partie de la grande organisation de pillage."
                                            },
                                            {
                                                "example_id": "dc82a9a8-4d22-40e1-bb74-8d6cfd830c1a",
                                                "sense_id": "23a9b399-d036-32f8-a3f4-1647684eca18",
                                                "text": "Les charmes quelque peu fanés de la descendante des Pignon-Mouillet n’étaient plus tels qu’ils attirassent encore irrésistiblement le mâle impétueux qu’était resté le vieux militaire."
                                            },
                                            {
                                                "example_id": "6ff92601-3ab4-4ef7-b2f5-6df291cfefc4",
                                                "sense_id": "23a9b399-d036-32f8-a3f4-1647684eca18",
                                                "text": "Tant qu’il y aura des militaires\nSoit ton fils, soit le mien,\nOn ne verra, par toute la terre\nJamais rien de bien !\nOn te tuera pour te faire taire,\nPar derrière, comme un chien :\nEt tout ça pour rien ! Et tout ça pour rien !"
                                            },
                                            {
                                                "example_id": "90ca8614-5ab0-4067-bb60-74622c8a0936",
                                                "sense_id": "23a9b399-d036-32f8-a3f4-1647684eca18",
                                                "text": "Un edelweiss séché glissa d’une des enveloppes de rhodoïd et M. Abel le replaça avec des gestes précautionneux sur la photo aux vilaines couleurs qui lui servait de support : sur un vague fond de mosquée, trois militaires en calot et treillis se tenaient par l’épaule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53840fa4-76fc-4650-a51d-f6d73dc726c5",
                        "source_entry_id": "2c47a0ab-4e4c-3b58-a473-a2c8d9e6d1f5",
