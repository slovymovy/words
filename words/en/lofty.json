{
    "word_family": [
        "loft"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1439d85-744e-3d1e-8db9-8f73f362508f",
                    "sense_definition": "High or tall in physical stature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lofty</w> mountains were covered in snow throughout the entire year.",
                            "target_lang_translations": {
                                "pl": "<w>Wysokie</w> góry były pokryte śniegiem przez cały rok."
                            }
                        },
                        {
                            "text": "We looked up at the <w>lofty</w> trees that shaded the entire park.",
                            "target_lang_translations": {
                                "pl": "Patrzyliśmy w górę na <w>wysokie</w> drzewa, które zacieniały cały park."
                            }
                        }
                    ],
                    "synonyms": [
                        "noble"
                    ],
                    "antonyms": [
                        "mean"
                    ],
                    "common_phrases": [
                        "lofty mountains",
                        "lofty trees"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wysoki lub duży pod względem fizycznym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wysoki",
                                "target_lang_sense_clarification": "odnoszące się do dużego wymiaru pionowego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d9baa99-85a1-31d2-8529-2ea8ceac0aa1",
                    "sense_definition": "Having high or idealistic standards or goals.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ideals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She set <w>lofty</w> goals for her career and worked hard to achieve them.",
                            "target_lang_translations": {
                                "pl": "Wyznaczyła sobie <w>szczytne</w> cele zawodowe i ciężko pracowała, by je osiągnąć."
                            }
                        },
                        {
                            "text": "The organization maintains <w>lofty</w> standards for all of its new members.",
                            "target_lang_translations": {
                                "pl": "Organizacja utrzymuje <w>wzniosłe</w> standardy dla wszystkich swoich nowych członków."
                            }
                        }
                    ],
                    "synonyms": [
                        "honorable"
                    ],
                    "antonyms": [
                        "ignoble"
                    ],
                    "common_phrases": [
                        "lofty goals",
                        "lofty standards"
                    ],
                    "target_lang_definitions": {
                        "pl": "Posiadający wysokie lub idealistyczne standardy bądź cele."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szczytny",
                                "target_lang_sense_clarification": "odnoszące się do szlachetnych dążeń i celów"
                            },
                            {
                                "target_lang_word": "wzniosły",
                                "target_lang_sense_clarification": "odnoszące się do szlachetności i podniosłego charakteru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0db56f8d-8445-3190-9c01-2d7f582241a1",
                    "sense_definition": "Showing an arrogant or haughty attitude.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with a <w>lofty</w> tone that made everyone feel uncomfortable.",
                            "target_lang_translations": {
                                "pl": "Mówił <w>wyniosłym</w> tonem, który sprawiał, że wszyscy czuli się nieswojo."
                            }
                        },
                        {
                            "text": "Her <w>lofty</w> behavior prevented her from making many close friends.",
                            "target_lang_translations": {
                                "pl": "Jej <w>wyniosłe</w> zachowanie uniemożliwiło jej zdobycie wielu bliskich przyjaciół."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przejawiający arogancką lub wyniosłą postawę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyniosły",
                                "target_lang_sense_clarification": "odnoszące się do postawy pełnej wyższości i arogancji"
                            },
                            {
                                "target_lang_word": "arogancki",
                                "target_lang_sense_clarification": "odnoszące się do zachowania lekceważącego innych"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a7117ac0-638a-3139-b20f-7027260b5205",
                    "sense_definition": "A nickname for a tall person.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nickname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the basketball team calls him <w>Lofty</w> because of his height.",
                            "target_lang_translations": {
                                "pl": "Wszyscy w drużynie koszykówki nazywają go <w>Wysoki</w> ze względu na jego wzrost."
                            }
                        },
                        {
                            "text": "I have known <w>Lofty</w> since we were children in primary school.",
                            "target_lang_translations": {
                                "pl": "Znam <w>Wysokiego</w> od czasów, gdy byliśmy dziećmi w szkole podstawowej."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a nickname."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przydomek dla wysokiej osoby."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Wysoki",
                                "target_lang_sense_clarification": "jako przydomek dla osoby o dużym wzroście"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}