                        "glosses": [
                            "Faire perdre son caractère aigri à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf82ba8a-2587-4797-914a-8ca36f56968c",
                                "sense_id": "ba27b3f4-3bc4-3c3f-b6bd-2d685188e100",
                                "text": "Lady, quand je vois à quel point tu es aigrie, ça me désaigrise."
                            },
                            {
                                "example_id": "6c2df6af-9bac-4fe5-a74c-4c39a4831481",
                                "sense_id": "ba27b3f4-3bc4-3c3f-b6bd-2d685188e100",
                                "text": "Rosita elle est trop aigrie. Je la désaigrise quand elle veut."
                            },
                            {
                                "example_id": "c6796a9c-469e-4e44-b059-7c2e1f494041",
                                "sense_id": "ba27b3f4-3bc4-3c3f-b6bd-2d685188e100",
                                "text": "Je dirais même que ça désaigrise."
                            }
                        ]
                    }
