                "senses": [
                    {
                        "sense_id": "d5b3ada3-1290-3646-918d-7c31c2a11abc",
                        "entry_id": "64f13af5-00e0-3434-8c3e-7f49d290ba82",
                        "glosses": [
                            "Entfernung, die das Licht in einem Monat im Vakuum zurücklegt; ungefähr ein Zwölftel eines Lichtjahres"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "39ed82b0-ce79-4954-8531-0e2ad9a86511",
                                "sense_id": "d5b3ada3-1290-3646-918d-7c31c2a11abc",
                                "text": "„Entsprechend verrät uns der Umstand, dass Quasare ihre Helligkeit auf Zeitskalen von einem Monat verändern, dass sie nicht viel größer als ein Lichtmonat sein können. Das ist erstaunlich wenig […].“"
                            },
                            {
                                "example_id": "9996cacd-1191-487b-88e4-79549e0f9c13",
                                "sense_id": "d5b3ada3-1290-3646-918d-7c31c2a11abc",
                                "text": "„Noch vor kurzer Zeit hatte die Länge zehn Lichtjahre betragen, die Dicke einen Lichtmonat. Das allein waren unglaubliche Werte.“"
                            },
                            {
                                "example_id": "d087eefd-5056-495f-b8f7-96e6a7e9a406",
                                "sense_id": "d5b3ada3-1290-3646-918d-7c31c2a11abc",
                                "text": "„Der andere Teil des riesigen Raumschiffs der Solaner stand unverändert in etwa einem Lichtmonat Entfernung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "87c261cf-dd0b-3fb5-8873-bc6c255b8220",
                        "entry_id": "64f13af5-00e0-3434-8c3e-7f49d290ba82",
                        "glosses": [
                            "29 Tage und 12 Stunden, nach denen der Mond wieder an der 'gleichen' Stelle steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f073efb1-247a-43e3-96fb-066fa9baba7d",
                                "sense_id": "87c261cf-dd0b-3fb5-8873-bc6c255b8220",
                                "text": "„Schliesslich ist noch der sogenannte Lichtmonat zu erwähnen, also die Zeitdauer, während der man den Mond tatsächlich am Himmel sehen kann, nämlich die 27 Tage vom ersten Erscheinen der Neusichel bis zum Verschwinden der letzten Mondsichel […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f1514fcf-2fa2-3f6b-a707-cf79332b5925",
                        "entry_id": "64f13af5-00e0-3434-8c3e-7f49d290ba82",
                        "glosses": [
                            "der Monat Februar"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c7178c05-c11c-4167-95c7-8087a00768d5",
                                "sense_id": "f1514fcf-2fa2-3f6b-a707-cf79332b5925",
                                "text": "„Für das Tauwetter im Lichtmonat (Februar) haftet der Fastenmonat (März) - 2 ( 21 ) Var . 5207. Wie der Lichtmonat (Februar) voran, der Fastenmonat (März) auch hinterdrein.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
