                "forms": [],
                "senses": [
                    {
                        "sense_id": "9cb57480-149a-3d05-80d5-c514e98f33fd",
                        "entry_id": "546b545d-98ce-354a-addc-d76084578463",
                        "glosses": [
                            "liefde en zorg voor de naaste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a737255e-961f-450e-a10d-d2f1b3f66d88",
                                "sense_id": "9cb57480-149a-3d05-80d5-c514e98f33fd",
                                "text": "Burgemeester Virginia Raggi vindt dat de opbrengst gebruikt moet worden om de slechte infrastructuur in de stad te verbeteren. Traditioneel gaan de munten naar een katholieke hulporganisatie die arme mensen bijstaat. Priester Benoni Ambarus van het katholieke Caritas zegt dat het besluit de arme Romeinen diep zal raken."
                            },
                            {
                                "example_id": "a850c95a-35f1-4119-9bf6-9f9c94e513d2",
                                "sense_id": "9cb57480-149a-3d05-80d5-c514e98f33fd",
                                "text": "Tillemans is al jaren secretaris van het seniorenpastoraat, is betrokken bij de plaatselijke Caritas en de Katholieke Bond voor Ouderen. Ook is hij al 25 jaar actief als kerkgids en verzorgt hij maandelijks een koffie-ochtend voor kerkgangers."
                            },
                            {
                                "example_id": "702d7934-4203-47a3-b0c2-60e6e68e24ed",
                                "sense_id": "9cb57480-149a-3d05-80d5-c514e98f33fd",
                                "text": "De vrouwen zijn al 35 jaar vrijwilliger bij de geloofsgemeenschap in Rossum. Beiden werden begin jaren 80 lid van de toenmalige Parochieraad. An Griep was jarenlang actief voor het Diensthuis (KeSa, Caritas en MOV) en de Pastoraatsgroep en bezoekt parochianen in verzorgingstehuizen."
                            }
                        ]
                    }
