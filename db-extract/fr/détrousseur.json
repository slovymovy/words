                "senses": [
                    {
                        "sense_id": "e934c90b-d7d8-3016-acd1-7696811bc874",
                        "entry_id": "4b763b1a-c630-346f-ab40-08193aa65e84",
                        "glosses": [
                            "Celui qui détrousse les passants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81ddb5f-b18c-47b6-91b4-f60c2abf85ca",
                                "sense_id": "e934c90b-d7d8-3016-acd1-7696811bc874",
                                "text": "Ils sont rares, parmi les détrousseurs effrontés de la spéculation, ceux à qui véritablement profite le bien d'autrui."
                            },
                            {
                                "example_id": "ad2b8f67-e757-4d60-bf7f-382c9175490b",
                                "sense_id": "e934c90b-d7d8-3016-acd1-7696811bc874",
                                "text": "Vétérans chevronnés de la guerre des boutons, grands maraudeurs de pommes et abatteurs de noix, tous, garnements de dix à douze ans, nous avions ce printemps-là reformé notre association de bandits grimpeurs, pillards aériens et détrousseurs de nids."
                            },
                            {
                                "example_id": "e485c6ce-78f6-4da5-be43-a4eaa633d403",
                                "sense_id": "e934c90b-d7d8-3016-acd1-7696811bc874",
                                "text": "J’ai agi comme un détrousseur de cadavres. J’ai violé le sépulcre."
                            },
                            {
                                "example_id": "55ca4a7c-25dd-4f4c-bb68-fecb51b99781",
                                "sense_id": "e934c90b-d7d8-3016-acd1-7696811bc874",
                                "text": "Des détrousseurs de grand chemin."
                            }
                        ]
                    }
                ],
