                "senses": [
                    {
                        "sense_id": "937565c6-3228-3f8a-9c22-0aecca7b9377",
                        "entry_id": "7e5ef83d-a1a0-3870-b0e2-cc985666be87",
                        "glosses": [
                            "etwas, was vier Pfund wiegt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "a783eafd-a17c-45f9-a94d-83da0fe4b792",
                                "sense_id": "937565c6-3228-3f8a-9c22-0aecca7b9377",
                                "text": "Vom Angelausflug brachte sie einen Vierpfünder mit nach Hause."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "509ecefc-eb5a-388c-82cb-62416e7ed21e",
                        "entry_id": "7e5ef83d-a1a0-3870-b0e2-cc985666be87",
                        "glosses": [
                            "vier Pfund schweres Brot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca94d226-afe9-471c-9522-f3ccdfe8eb05",
                                "sense_id": "509ecefc-eb5a-388c-82cb-62416e7ed21e",
                                "text": "„Im Vergleich zu dem Vierpfünder war es federleicht und wurde von mir auf beiden Unterarmen liegend vor der Brust getragen. Der frische Backduft gemischt mit dem der süßen verführerischen Rosinen zog in meine Nase.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "062bf193-f0fb-32b7-847d-a490ba293522",
                        "entry_id": "7e5ef83d-a1a0-3870-b0e2-cc985666be87",
                        "glosses": [
                            "Vierpfünderkanone, eine Kanone, die Kugel zu 4 Pfund abschießen kann"
                        ],
                        "tags": [
                            "historical",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "8e70a969-f648-4837-a85b-4df3ced177c4",
                                "sense_id": "062bf193-f0fb-32b7-847d-a490ba293522",
                                "text": "„Dritte Nacht. Ist der zweiten Nacht gleich, doch feuern nur 6 Vierpfünder; der Pulververbrauch beträgt daher mit dem folgenden Tage zusammen, weil ausserdem noch 1o sechspfündige Schüsse geschehen, - 33o1 Pf..“"
                            },
                            {
                                "example_id": "010d412f-e0d0-43f1-ab16-ad2d98d8e782",
                                "sense_id": "062bf193-f0fb-32b7-847d-a490ba293522",
                                "text": "„Das Korn ist bei dem Vierpfünder auf dem rechten Schildzapfen angebracht, der Aufsatz mit Visir befindet sich in einer Hülfe an der rechten Seite des Vierkantes.“"
                            },
                            {
                                "example_id": "e8609c48-ad6c-4ef1-9252-f67a1a695ebe",
                                "sense_id": "062bf193-f0fb-32b7-847d-a490ba293522",
                                "text": "„Ich sollte auch erwähnen, dass wir uns in York zwei Messingkanonen – ich glaube, es waren Vierpfünder – besorgt hatten, die Mr. Osgood vorn an unseren zwei leeren Geschützpforten anschlug.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
