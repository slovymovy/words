                                        "glosses": [
                                            "A poisonous cardiac glycoside, g-strophanthin, found in the seeds of certain lianas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ed5a59-aa14-4def-9270-5d8388e40a78",
                                                "sense_id": "9810d496-1fbe-3fe1-a71a-5edc380b2471",
                                                "text": "In moderate dosage ouabain is used today to treat emergency heart failure; in excessive doses it makes the heart go crazy, pumping wildly until it collapses."
                                            }
                                        ]
                                    }
                                ]
