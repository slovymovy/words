                ],
                "senses": [
                    {
                        "sense_id": "1ebcd5d5-98e1-3d9b-b24c-2a204ee24a61",
                        "entry_id": "35118adc-19c7-3c9e-919e-d964c86b77a5",
                        "glosses": [
                            "Action de démythifier ; le résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e3af49-5ebd-4512-b844-18305d46a95e",
                                "sense_id": "1ebcd5d5-98e1-3d9b-b24c-2a204ee24a61",
                                "text": "La démythification d'un dogme, d'une tradition ancrée, d'une idée tout faite."
                            },
                            {
                                "example_id": "e669cee1-4a90-4d34-8bd6-0986bb9ad9a3",
                                "sense_id": "1ebcd5d5-98e1-3d9b-b24c-2a204ee24a61",
                                "text": "La démythification des origines bibliques du savoir humain."
                            },
                            {
                                "example_id": "2beaa04b-0c65-4519-8a5f-24f77f13e0fc",
                                "sense_id": "1ebcd5d5-98e1-3d9b-b24c-2a204ee24a61",
                                "text": "La démythification d'Internet comme source de savoir sûre."
                            },
                            {
                                "example_id": "6bba186a-1d28-427b-9bcb-4cda2605cb83",
                                "sense_id": "1ebcd5d5-98e1-3d9b-b24c-2a204ee24a61",
                                "text": "La démythification repose avant tout sur l'exercice de l'esprit critique."
                            },
                            {
                                "example_id": "51546954-0a94-4802-b161-4a173f8a9d83",
                                "sense_id": "1ebcd5d5-98e1-3d9b-b24c-2a204ee24a61",
                                "text": "Si nous tenons donc à souligner l’efficacité de notre recherche, nous ne devons pas dissimuler que notre entreprise de démythification a été d’une inefficacité totale. Il est bien entendu qu’une étude comme la nôtre ne peut modifier en rien le dispositif mythologique qu’elle dévoile, et ne pouvait nullement prévenir la rumeur d’Amiens."
                            }
                        ]
                    }
                ],
