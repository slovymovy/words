                ],
                "senses": [
                    {
                        "sense_id": "86703d7e-c588-33aa-80d6-9a3b8db0d0a3",
                        "entry_id": "46afc2c8-1e43-33f5-92f3-863fdd8a662e",
                        "glosses": [
                            "уменьш.-ласк. к башмак; лёгкая кожаная низкая обувь с каблуками и пряжками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c6175e2-27a0-4d41-ba2e-8653d1043b3a",
                                "sense_id": "86703d7e-c588-33aa-80d6-9a3b8db0d0a3",
                                "text": "Одета она была в белое платьице с пёстрыми разводами и красные башмачки с каблучками〈…〉"
                            },
                            {
                                "example_id": "be7b415b-050e-4447-8bcc-b17c6bd26977",
                                "sense_id": "86703d7e-c588-33aa-80d6-9a3b8db0d0a3",
                                "text": "Какие большие пряжки // На крохотных башмачках!"
                            },
                            {
                                "example_id": "be961820-6b93-49ee-b2d3-3b01e48b12f8",
                                "sense_id": "86703d7e-c588-33aa-80d6-9a3b8db0d0a3",
                                "text": "И падали два башмачка // Со стуком на пол. // И воск слезами с ночника // На платье капал."
                            },
                            {
                                "example_id": "facbc490-9372-4a95-a988-b311e778f20f",
                                "sense_id": "86703d7e-c588-33aa-80d6-9a3b8db0d0a3",
                                "text": "Но хрустальный башмачок пришёлся ей впору, государь!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3992c8c8-028b-49a3-9935-13c2e54238b3",
                        "source_entry_id": "46afc2c8-1e43-33f5-92f3-863fdd8a662e",
                        "source_sense_id": "86703d7e-c588-33aa-80d6-9a3b8db0d0a3",
                        "target_lang_word": "bootee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bootee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "A soft, woolen shoe, usually knitted, for a baby or small pet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4702c0-cf3d-4a6d-8d6d-840bdaff92a2",
                                                "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                                "text": "Take off the baby's bootees before you put her in the crib."
                                            },
                                            {
                                                "example_id": "96aab636-639c-4ac6-8922-826f9ba5b0ba",
                                                "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                                "text": "‘No,’ said Luke, grinning at her. ‘You're not dull enough! […] What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything? A bootee or a bit of embroidery or anything at all?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e6b775-45c4-3fc8-b9b1-f426a7e34115",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "A thick sock worn under a wetsuit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "An overshoe or sock worn to cover dirty shoes or feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd434756-f757-4e98-b3fb-f682f09d36ce",
                                                "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                                "text": "Surgeons often slip on bootees before entering the operating room."
                                            },
                                            {
                                                "example_id": "0740b9b5-0b9b-4ab9-a66b-c7b6cabc8a7b",
                                                "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                                "text": "Just above the Sunset Strip, construction workers in white bootees were putting the final touches on another home — a 14,000-square-foot house that Mr. Niami is building for himself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e577bc-1e5a-4298-a089-e7abbc979d9f",
                        "source_entry_id": "46afc2c8-1e43-33f5-92f3-863fdd8a662e",
                        "source_sense_id": "86703d7e-c588-33aa-80d6-9a3b8db0d0a3",
                        "target_lang_word": "slipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8823d95-235e-32ca-8a97-a7f55b755c62",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A low soft shoe that can be slipped on and off easily."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4cc70889-a19c-332a-93e2-ba8b65c7d286",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A low soft shoe intended for indoor use; a bedroom slipper or house slipper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7602ab18-72c8-4072-9d76-354d766d25d0",
                                                "sense_id": "4cc70889-a19c-332a-93e2-ba8b65c7d286",
                                                "text": "Get out of bed, put on your slippers, and come downstairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df21294f-5624-361a-9e3f-f03e9ca1666b",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A flip-flop (type of rubber sandal)."
                                        ],
                                        "tags": [
                                            "Hawaii",
                                            "India",
                                            "Malaysia",
                                            "Philippines",
                                            "Singapore",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A person or creature that slips."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d167d8-2f13-4c0a-bd0d-7543e7bcc344",
                                                "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                                "text": "He is a frequent “slipper,” but doesn’t seem to have sufficient intelligence upon which to ever build permanent sobriety and happiness."
                                            },
                                            {
                                                "example_id": "9a707a36-518c-476a-adb4-91b7c5401039",
                                                "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                                "text": "Virtually all human action is liable to opposing interpretations, depending mainly upon distance: to take the familiar case of the banana peel, the fall is painful to the slipper, hilarious to the spectator across the street."
                                            },
                                            {
                                                "example_id": "3f76d882-e3d0-4aa6-9799-a5a22864fe3f",
                                                "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                                "text": "Slipping on a banana peel does not mean big bucks for the “slipper” if the “slippee” has a good law firm representing it."
                                            },
                                            {
                                                "example_id": "7fa08170-9346-4c67-ae91-694fc39dc39e",
                                                "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                                "text": "He was grey and had eight legs, and could travel anywhere and slip into any corner of 9 worlds. For this reason he was called Sleipnir (\"the slipper) and was given to Oðinn as his steed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e4a133-663f-3062-9b49-95469adfb4d1",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A kind of apron or pinafore for children."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da94d1b3-3b1d-3d38-875e-7b1be0fcfee2",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A kind of brake or shoe for a wagon wheel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab295d90-960c-3bf3-89f0-a57f90484e3d",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A piece, usually a plate, applied to a sliding piece, to receive wear and permit adjustment; a gib."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b705594f-ebef-3373-9ca5-4e22069f3668",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A form of corporal punishment where the buttocks are repeatedly struck with a plimsoll; \\\"the slipper\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13521ce1-4c74-4adb-b017-e8475acee96f",
                                                "sense_id": "b705594f-ebef-3373-9ca5-4e22069f3668",
                                                "text": "1981, Andrew Loudon, Staffroom mole leaks secret of his school's beatings book, Daily Mail and General Trust, World Corporal Punishment Research\n\"Mrs Marlene Foster […] , an opponent of the slipper, said her son Gary had a bottom \"as red as a beetroot\" after he was punished for writing on desks. \""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aed22a3c-6346-33c2-bfee-62eb27f7deba",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "The plimsoll or gym shoe used in this form of punishment."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ecba5ab-d33f-4389-876d-c86f7022ece1",
                                                "sense_id": "aed22a3c-6346-33c2-bfee-62eb27f7deba",
                                                "text": "\"All teachers had what was referred to as a 'slipper', but in reality was a cut down gym shoe designed for smacking our bottoms.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a293982-2b91-362b-aa92-0e9ef6ee18b8",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A kind of bedpan urinal shaped somewhat like a slipper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
