    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "584b0bb4-215a-3931-90b4-fdd572449314",
                    "sense_definition": "A forceful blow or impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received a painful <w>bash</w> on the head during the game.",
                            "target_lang_translations": {
                                "cs": "Během hry dostal bolestivou <w>ránu</w> do hlavy.",
                                "es": "Recibió un doloroso <w>golpe</w> en la cabeza durante el partido."
                            }
                        },
                        {
                            "text": "The door took a heavy <w>bash</w> from the falling tree branch.",
                            "target_lang_translations": {
                                "cs": "Dveře dostaly silnou <w>ránu</w> od padající větve stromu.",
                                "es": "La puerta se llevó un fuerte <w>porrazo</w> por la caída de la rama del árbol."
                            }
                        }
                    ],
                    "synonyms": [
                        "lash"
                    ],
                    "target_lang_definitions": {
                        "cs": "Silný úder nebo náraz.",
                        "es": "Un golpe fuerte o impacto."
                    },
                    "translations": {
