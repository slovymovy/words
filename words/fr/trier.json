    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1241af77-5536-3724-b01d-dc9d7e9f5bd4",
                    "sense_definition": "Séparer ce que l'on souhaite garder de ce que l'on souhaite éliminer ou jeter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la maison, nous prenons toujours le temps de <w>trier</w> nos déchets recyclables."
                        },
                        {
                            "text": "Elle passe la matinée à <w>trier</w> les vieux vêtements pour donner ceux qu'elle ne met plus."
                        }
                    ],
                    "common_phrases": [
                        "trier les déchets",
                        "trier le linge"
                    ]
                },
                {
                    "sense_id": "aee5dd40-d299-3261-91a5-24ccec48a108",
                    "sense_definition": "Classer ou ranger des éléments selon un ordre précis, tel que l'ordre alphabétique ou numérique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "classement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez <w>trier</w> les résultats de votre recherche par date ou par pertinence."
                        },
                        {
                            "text": "Elle <w>trie</w> ses dossiers administratifs par ordre alphabétique pour gagner du temps."
                        }
                    ],
                    "synonyms": [
                        "classer",
                        "ordonner",
                        "ranger"
                    ],
                    "common_phrases": [
                        "trier par ordre alphabétique",
                        "trier par date"
                    ]
                },
                {
                    "sense_id": "ff129496-016a-36ff-83c1-b5e4057739f0",
                    "sense_definition": "Choisir avec soin dans un ensemble ou répartir selon des critères qualitatifs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jury commence à <w>trier</w> les candidatures pour retenir les meilleurs profils."
                        },
                        {
                            "text": "Le chef cuisinier <w>trie</w> les fruits mûrs pour préparer un dessert de qualité."
                        }
                    ],
                    "synonyms": [
