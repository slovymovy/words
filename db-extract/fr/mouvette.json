                        "examples": [
                            {
                                "example_id": "cd06c26c-001d-4f50-9458-ebeed41d2bcf",
                                "sense_id": "cb5f97e8-f419-381c-bbb3-06ae7e5aa4a4",
                                "text": "Maman Coupeau et Gervaise, un tablier blanc noué devant elles, emplissaient la pièce de leur hâte à éplucher du persil, à courir après le poivre et le sel, à tourner la viande avec la mouvette de bois."
                            },
                            {
                                "example_id": "5e3ffe4e-45b4-4e9d-a7e3-248c3b385c3b",
                                "sense_id": "cb5f97e8-f419-381c-bbb3-06ae7e5aa4a4",
                                "text": "Je tournais les lardons avec une mouvette, je secouais la poêle pour les faire sauter, je les retournais avec une fourchette, je leur donnais beaucoup de soins."
                            }
                        ]
                    }
