                "senses": [
                    {
                        "sense_id": "0fc95a70-141e-3898-9bce-e403a01198a4",
                        "entry_id": "67c82a70-98f5-36a3-ba5c-8948820e6aa1",
                        "glosses": [
                            "für die alltägliche Benutzung im Freien geeigneter Schuh"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "a7da9ebf-dd31-4997-81dd-6b7e95dfe2b7",
                                "sense_id": "0fc95a70-141e-3898-9bce-e403a01198a4",
                                "text": "Pass auf, bei den Müllers darfst du nicht mit Straßenschuhen die Wohnung betreten!"
                            },
                            {
                                "example_id": "b5d6ad4a-802b-47b7-bdae-547db4d7d10e",
                                "sense_id": "0fc95a70-141e-3898-9bce-e403a01198a4",
                                "text": "„Sie zieht den guten Mantel und Straßenschuhe an, nimmt ihre Handtasche und heute auch den Schirm.“"
                            },
                            {
                                "example_id": "511ba15a-e6de-49bb-82c9-b7ffb82ba344",
                                "sense_id": "0fc95a70-141e-3898-9bce-e403a01198a4",
                                "text": "„Sie wohnen in einem geleckten Neubau, der nicht mit Straßenschuhen betreten werden darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
