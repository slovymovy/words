                                    {
                                        "sense_id": "ebf103da-d564-3c87-ae00-a23e38713406",
                                        "entry_id": "9b05c0ce-2800-37fe-b9a3-1fd87b4445a3",
                                        "glosses": [
                                            "The power to attract, entice; the quality causing attraction."
                                        ],
