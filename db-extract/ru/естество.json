                "senses": [
                    {
                        "sense_id": "57e9fe62-811e-3e6c-ab97-d9b5598965d7",
                        "entry_id": "063e00c3-cca2-35cb-8316-3f527c093537",
                        "glosses": [
                            "книжн. природное свойство, основная сущность"
                        ],
                        "tags": [
                            "мн. нет"
                        ],
                        "examples": [
                            {
                                "example_id": "d1e149a1-2068-44c9-9e4b-a6d50be12328",
                                "sense_id": "57e9fe62-811e-3e6c-ab97-d9b5598965d7",
                                "text": "Это явствует из самого естества вопроса."
                            },
                            {
                                "example_id": "079db6dd-3194-4fe7-bf4b-90752042a642",
                                "sense_id": "57e9fe62-811e-3e6c-ab97-d9b5598965d7",
                                "text": "На вселенском соборе 451 г. в Халкидоне была принята парадоксальная формула: Христос, вполне бог, но и вполне человек, единосущный Отцу по божеству, но и людям по человечеству, пребывает в двух своих естествах «неслиянно» и «нераздельно»."
                            }
                        ]
                    },
                    {
                        "sense_id": "809c9fc6-eab6-3494-9e57-c3d5ed532bfd",
                        "entry_id": "063e00c3-cca2-35cb-8316-3f527c093537",
                        "glosses": [
                            "устар. природа, всё живое"
                        ],
                        "tags": [
                            "мн. нет"
                        ],
                        "examples": [
                            {
                                "example_id": "be319c35-86f2-453c-a23d-8a2fd9d22126",
                                "sense_id": "809c9fc6-eab6-3494-9e57-c3d5ed532bfd",
                                "text": "Смерть, трепет естества и страх!"
                            }
                        ]
                    }
