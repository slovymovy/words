                        "glosses": [
                            "A person employed to transport goods in a van or wagon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8973df7e-4c85-4e78-977d-08fd69d7e6d2",
                                "sense_id": "63441590-4870-3b62-8d74-be7efe970229",
                                "text": "Willie. Agreed unanimously. But how are we going to do it? Do you propose to send for Williamson’s furniture van, to pack them in? […] I’ll drive. Who’ll be the vanmen to lift and carry?"
                            },
                            {
                                "example_id": "70a49286-65a5-49d9-8ca8-18ea64d09411",
                                "sense_id": "63441590-4870-3b62-8d74-be7efe970229",
                                "text": "Packers and sorters, invariably women and girls, had most in common with the staff of receiving offices, who, indeed, sometimes performed a portion of the same work because some laundries had the marking of linen done by receiving office staff while the sorters marked only those items collected by the vanmen."
                            }
                        ]
