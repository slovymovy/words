                        ],
                        "form": "die Loren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f54fb213-cbdd-3856-9ba2-bc8b6d7c2e27",
                        "entry_id": "a08efc37-de39-367a-9781-837bf3271dea",
                        "glosses": [
                            "Schienenfahrzeug, das seitlich ausgekippt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8274f7d8-f2b0-49a7-8e1a-9253b650f40c",
                                "sense_id": "f54fb213-cbdd-3856-9ba2-bc8b6d7c2e27",
                                "text": "Loren werden zum Beispiel zum Transport von Schüttgut verwendet."
                            },
                            {
                                "example_id": "8ecf404f-11ca-44af-943f-76d10841d5cc",
                                "sense_id": "f54fb213-cbdd-3856-9ba2-bc8b6d7c2e27",
                                "text": "„Dorthin kamen die Küchenbullen gefahren mit zwei Fässern, die sie auf eine Lore montiert hatten.“"
                            },
                            {
                                "example_id": "c18971e6-2b47-488b-ae6e-38ecfdd7d432",
                                "sense_id": "f54fb213-cbdd-3856-9ba2-bc8b6d7c2e27",
                                "text": "„Sie schippen Geröll in Loren und wuchten sie zu den Förderschächten, in denen der Schutt in Eimern nach oben gezogen wird.“"
                            },
                            {
                                "example_id": "78459f32-7a6d-4e6c-98cb-ac0e16a68d3f",
                                "sense_id": "f54fb213-cbdd-3856-9ba2-bc8b6d7c2e27",
                                "text": "„Die Notstandsarbeiter schaufelten bei einem Stundenlohn von fünfundsiebzig Pfennigen den Sand in Loren, die dann zu den Baggern geschoben wurden, welche die Lastwagen beluden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
