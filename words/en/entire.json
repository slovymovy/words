    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "021b4526-b57e-383d-aad8-dddfe19771ab",
                    "sense_definition": "Including every part of something; with nothing left out.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_whole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She read the <w>entire</w> book in just one afternoon.",
                            "target_lang_translations": {
                                "ru": "Она прочитала <w>всю</w> книгу всего за один день.",
                                "zh": "她只用了一个下午就读完了<w>整本</w>书。"
                            }
                        },
                        {
                            "text": "The <w>entire</w> village was covered in a thick layer of snow.",
                            "target_lang_translations": {
                                "ru": "<w>Вся</w> деревня была покрыта толстым слоем снега.",
                                "zh": "<w>整个</w>村庄都被厚厚的积雪覆盖了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whole",
                        "complete",
                        "total",
                        "full"
                    ],
                    "antonyms": [
                        "partial",
                        "incomplete"
                    ],
                    "common_phrases": [
                        "entire world",
                        "entire life",
                        "entire time",
                        "entire family"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включающий все части чего-либо; полный, без изъятий.",
                        "zh": "包含某事物的全部部分；没有遗漏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весь",
                                "target_lang_sense_clarification": "полный охват, всё количество"
                            },
                            {
                                "target_lang_word": "целый",
                                "target_lang_sense_clarification": "неповрежденный, полный"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "завершенный, абсолютный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整个",
                                "target_lang_sense_clarification": "强调事物的全部"
                            },
                            {
                                "target_lang_word": "全部",
                                "target_lang_sense_clarification": "指代所有部分"
                            },
                            {
                                "target_lang_word": "完整",
                                "target_lang_sense_clarification": "指事物没有残缺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38459cf0-92ba-37d6-bc1d-b10867b789f8",
                    "sense_definition": "Having a smooth edge with no indentations or teeth (used to describe leaves).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plant can be identified by its simple leaves with <w>entire</w> margins.",
                            "target_lang_translations": {
                                "ru": "Растение можно определить по простым листьям с <w>цельными</w> краями.",
                                "zh": "这种植物可以通过其具有<w>全缘</w>叶片的单叶来识别。"
                            }
                        },
                        {
                            "text": "Unlike the serrated variety, this species has an <w>entire</w> leaf structure.",
                            "target_lang_translations": {
                                "ru": "В отличие от зубчатой разновидности, этот вид имеет <w>цельную</w> структуру листа.",
                                "zh": "与锯齿状的品种不同，该物种具有<w>全缘</w>的叶片结构。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "entire margin",
                        "entire leaf"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий гладкий край без выемок или зубцов (используется для описания листьев).",
                        "zh": "指叶片边缘平滑，没有缺口或锯齿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цельный",
                                "target_lang_sense_clarification": "ботанический термин, о краях листа"
                            },
                            {
                                "target_lang_word": "цельнокрайний",
                                "target_lang_sense_clarification": "специфический ботанический термин"
                            }
