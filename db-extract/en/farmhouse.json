                ],
                "senses": [
                    {
                        "sense_id": "d98f48bb-fb0e-3a7c-b390-b32cfeed1ec5",
                        "entry_id": "14fa7b70-916c-3fa4-8ed8-2bd5babc01c2",
                        "glosses": [
                            "A house (usually the main house) on a farm; thus:",
                            "A farmer's residence."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2ae66d37-2ebc-3a5c-a04a-60e6f7cc2397",
                        "entry_id": "14fa7b70-916c-3fa4-8ed8-2bd5babc01c2",
                        "glosses": [
                            "A house (usually the main house) on a farm; thus:",
                            "A house that was once a farmer's residence albeit today lived in by residents whose occupation is not farming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38ff80ca-259e-4089-bde1-9174dd77d315",
                                "sense_id": "2ae66d37-2ebc-3a5c-a04a-60e6f7cc2397",
                                "text": "Since the farm's redevelopment into mixed commercial and residential space, the farmhouse has served as a community center."
                            },
                            {
                                "example_id": "cca610a7-aad7-4a23-8934-723689bfce96",
                                "sense_id": "2ae66d37-2ebc-3a5c-a04a-60e6f7cc2397",
                                "text": "The couple live in a renovated farmhouse that was once the hub of a 300-acre farm."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "890409af-4cab-44eb-ab20-546996ae3a51",
                        "source_entry_id": "14fa7b70-916c-3fa4-8ed8-2bd5babc01c2",
                        "source_sense_description": "farmer's residence",
                        "target_lang_word": "fermette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fermette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f94ae1b2-4fb9-3ffe-816a-0f5d043a37d6",
                                        "entry_id": "89d55bd6-e4d1-35f1-9d4c-306ec1e70157",
                                        "glosses": [
                                            "Petite ferme, maison de campagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56471ab-db9f-4bc0-8795-b8efd6fb813d",
                                                "sense_id": "f94ae1b2-4fb9-3ffe-816a-0f5d043a37d6",
                                                "text": "Autour des grandes villes, les maisons rurales abandonnées et les fermettes se feront résidences secondaires."
                                            },
                                            {
                                                "example_id": "3e7f461a-38ee-4fdc-9cf6-8b1884a8c3f4",
                                                "sense_id": "f94ae1b2-4fb9-3ffe-816a-0f5d043a37d6",
                                                "text": "Trop confiant, Georges loue donc sa fermette sans demander de garantie locative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c603c37-ea6e-39b8-8a58-ab970d7037c4",
                                        "entry_id": "89d55bd6-e4d1-35f1-9d4c-306ec1e70157",
                                        "glosses": [
                                            "Bâtiments d'une petite ferme souvent utilisés comme résidence secondaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08838af4-03b3-46a4-ba19-1600938365a1",
                        "source_entry_id": "14fa7b70-916c-3fa4-8ed8-2bd5babc01c2",
                        "source_sense_description": "farmer's residence",
                        "target_lang_word": "Bauernhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauernhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8df9f019-29b8-3bc1-92b6-9710ac3bc48e",
                                        "entry_id": "ec89b789-c145-33c9-b745-f5304f7d83ab",
                                        "glosses": [
                                            "ursprünglich von Bauern bewohntes und zu landwirtschaftlichen Zwecke genutztes Haus"
                                        ],
                                        "tags": [
                                            "Gebäude"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c1a3504-5da3-426f-b701-cee0383975b5",
                                                "sense_id": "8df9f019-29b8-3bc1-92b6-9710ac3bc48e",
                                                "text": "„Bei Gudenaa, im Walde von Silkeborg, erhebt sich wie ein großer Wall ein Landrücken und am Fuße dieses Landrückens nach Westen zu, lag und liegt noch heute ein kleines Bauernhaus mit einigen mageren Feldern; der Sand schimmerte allerorten unter dem dünnen Roggen- und Gerstenboden hervor.“"
                                            },
                                            {
                                                "example_id": "eeb3c1fa-085c-4858-a85b-9d507a154d6a",
                                                "sense_id": "8df9f019-29b8-3bc1-92b6-9710ac3bc48e",
                                                "text": "„Das große Bauernhaus und seine Bewohner lagen in tiefem Schlaf.“"
                                            },
                                            {
                                                "example_id": "d74d1af5-d109-448c-aac5-c6749c05ee7b",
                                                "sense_id": "8df9f019-29b8-3bc1-92b6-9710ac3bc48e",
                                                "text": "„Wir kamen an einem weißen Bauernhaus vorbei.“"
                                            },
                                            {
                                                "example_id": "6fc47343-186b-4a4f-b635-b33698471820",
                                                "sense_id": "8df9f019-29b8-3bc1-92b6-9710ac3bc48e",
                                                "text": "„In dem alten Bauernhaus mit seinem begrünten Dach, das vom Anfang des 19. Jahrhunderts bis 1950 bewohnt war, sind Gebrauchsgegenstände und Werkzeuge der Fischer und Bauern aus dem 19. und 20. Jahrhundert ausgestellt.“"
                                            },
                                            {
                                                "example_id": "ec238b51-af1e-4cb1-bff2-8370a887e22d",
                                                "sense_id": "8df9f019-29b8-3bc1-92b6-9710ac3bc48e",
                                                "text": "„Wir waren in einer vorgeschobenen Position und haben Funksignale abgehört, und wir hatten uns in einem Bauernhaus verkrochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9a62227-2c60-4ab4-9d34-2324d1c65712",
                        "source_entry_id": "14fa7b70-916c-3fa4-8ed8-2bd5babc01c2",
                        "source_sense_description": "farmer's residence",
                        "target_lang_word": "Farmhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Farmhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c568d164-6312-36ba-9a46-8a516c7bf748",
                                        "entry_id": "8fd99c8c-f0b2-3b00-b04f-97e3d6c4f067",
                                        "glosses": [
                                            "Haus, das zu einer Farm gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a238e2-8ae0-43b5-9c50-d68b2bea9c10",
                                                "sense_id": "c568d164-6312-36ba-9a46-8a516c7bf748",
                                                "text": "„Offensichtlich lag das Farmhaus sehr viel näher an der See, als ich gedacht hatte.“"
                                            },
                                            {
                                                "example_id": "9edb233b-e868-4302-943e-a90fe5957de3",
                                                "sense_id": "c568d164-6312-36ba-9a46-8a516c7bf748",
                                                "text": "„Vor und in dem Farmhause des alten Roberts herrschte indessen ein reges, freudiges Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
