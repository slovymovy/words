                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5df33a55-daeb-41e6-a882-4c205d04cfe3",
                                                "sense_id": "b5300b47-fd46-3b8e-aa5e-a36fc65a20ec",
                                                "text": "Er sprach mit einer merkwürdigen Kadenz."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "8ec9cd56-ce34-3f5e-8731-8def35c41fd0",
                                        "entry_id": "78912d92-a418-3e4c-aa3b-7fb6421e802a",
                                        "glosses": [
                                            "Art des Vers-Ausgangs"
                                        ],
                                        "tags": [
                                            "Sprache",
                                            "Lyrik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8b624f8-dc20-4112-be16-5d20eb11fc91",
                                                "sense_id": "8ec9cd56-ce34-3f5e-8731-8def35c41fd0",
                                                "text": "Die Kadenzen korrespondieren mit dem Reimschema."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "a6525a02-439a-3c83-9e31-544ba06af549",
                                        "entry_id": "78912d92-a418-3e4c-aa3b-7fb6421e802a",
                                        "glosses": [
                                            "Abfolge von Harmonien in einem Musikstück"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c9e0565-a0ff-4c6d-b27d-9a8845465727",
                                                "sense_id": "a6525a02-439a-3c83-9e31-544ba06af549",
                                                "text": "Die Kadenz klang wunderschön."
                                            },
                                            {
                                                "example_id": "b8760a42-1b68-4bb4-a2f1-2e2a3b456e25",
                                                "sense_id": "a6525a02-439a-3c83-9e31-544ba06af549",
                                                "text": "„Es ist ein ergreifend melancholischer Gesang, wie er in seinen tiefen Baßtönen und dem klagenden Tenor in langen Kadenzen an das Ohr schlägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b84382e7-18fd-36ee-a762-1f647f680f9c",
                                        "entry_id": "78912d92-a418-3e4c-aa3b-7fb6421e802a",
                                        "glosses": [
                                            "Schussfrequenz oder Feuerrate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "338340c8-d9e8-4d4c-a0ba-f8d07beb68aa",
                                                "sense_id": "b84382e7-18fd-36ee-a762-1f647f680f9c",
                                                "text": "Seine Waffe hat eine hohe Kadenz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
