                                        "glosses": [
                                            "založený na domněnce; představovaný"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e56df329-ce59-4c48-a64a-931c225eb26b",
                                                "sense_id": "9853a23c-7910-392b-bad8-3390c89a41c4",
                                                "text": "Představme si situace, jaké by měl dnes hypotetický policista podstupovat. Ráno začíná v ulicích měst namátkou zastavovat lidi a vymáhat nasazení masky, protože jsou od dalších osob méně než dva metry. Snad by to přežil ve zdraví."
