    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                    "sense_definition": "At once; without delay.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver stopped the car <w>instantly</w> when he saw the red light.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>мгновенно</w> остановил машину, когда увидел красный свет.",
                                "zh": "司机看到红灯时<w>立刻</w>停下了车。"
                            }
                        },
                        {
                            "text": "Her talent was <w>instantly</w> recognizable to everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Её талант был <w>сразу</w> заметен всем в комнате.",
                                "zh": "房间里的每个人都<w>立刻</w>看出了她的才华。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immediately",
                        "instantaneously",
                        "straight away",
                        "at once"
                    ],
                    "antonyms": [
                        "later",
                        "eventually",
                        "gradually"
                    ],
                    "common_phrases": [
                        "instantly recognizable",
                        "instantly available",
                        "die instantly",
                        "reply instantly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сразу же, без промедления; в тот же миг.",
                        "zh": "立刻；马上；不加迟延地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мгновенно",
                                "target_lang_sense_clarification": "очень быстро, в один миг"
                            },
                            {
                                "target_lang_word": "сразу",
                                "target_lang_sense_clarification": "без паузы, тотчас"
                            },
                            {
                                "target_lang_word": "немедленно",
                                "target_lang_sense_clarification": "безотлагательно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立刻",
