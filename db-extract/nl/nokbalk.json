                        "glosses": [
                            "horizontaal geplaatste balk in de top van de kapconstructie, waar sporen en/ of dakbeschot op zijn bevestigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7adbe7af-689d-4802-bd08-dcfada383654",
                                "sense_id": "247faf0c-49d1-3ba5-9cef-b43e7b7753af",
                                "text": "De blonde jongen kondigde toen aan met de jaarwisseling een stunt uit te halen. 'We wachtten op een grap, maar het spektakel wilde dat hij zich verhing aan de nokbalk bij zijn ouders op zolder.'"
                            },
                            {
                                "example_id": "7e678d3c-5a16-49c2-bbdf-1e6be55abf3b",
                                "sense_id": "247faf0c-49d1-3ba5-9cef-b43e7b7753af",
                                "text": "De spijkers in de handen en voeten bijvoorbeeld. Dat zijn eigenlijk je reinste bouten waarmee men doorgaans een nokbalk aan een dakgebint vastnagelt."
                            },
                            {
                                "example_id": "9bc28a8f-8359-47d1-bc9a-70531f1d6fa6",
                                "sense_id": "247faf0c-49d1-3ba5-9cef-b43e7b7753af",
                                "text": "Tussen de tuin en de straat staat nog de oude poort; de versieringen op de nokbalk weliswaar beschadigd, maar nog intact."
                            }
                        ]
                    }
