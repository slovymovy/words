{
    "word_family": [
        "Gothic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c6f237d-05b0-3812-9f0d-32a88348e2c7",
                    "sense_definition": "A person who belongs to the goth subculture, typically dressing in black and listening to gothic rock.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "subculture_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a solitary <w>goth</w> waiting by the train station.",
                            "target_lang_translations": {
                                "ru": "Мы увидели одинокого <w>гота</w>, ожидающего у вокзала.",
                                "zh": "我们看到一个孤独的<w>哥特人</w>在火车站旁等车。"
                            }
                        },
                        {
                            "text": "As a teenager, she was a <w>goth</w> who dyed her hair black.",
                            "target_lang_translations": {
                                "ru": "В подростковом возрасте она была <w>готкой</w> и красила волосы в черный цвет.",
                                "zh": "青少年时期，她是个会把头发染黑的<w>哥特人</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "goth kid",
                        "goth girl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, принадлежащий к готической субкультуре, обычно одевающийся в черное и слушающий готический рок.",
                        "zh": "属于哥特亚文化的人，通常穿着黑色服装并听哥特摇滚乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гот",
                                "target_lang_sense_clarification": "представитель субкультуры (мужчина)"
                            },
                            {
                                "target_lang_word": "готка",
                                "target_lang_sense_clarification": "представительница субкультуры (женщина)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哥特人",
                                "target_lang_sense_clarification": "哥特亚文化成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "643184c9-531f-3b91-8f49-04355f2b9529",
                    "sense_definition": "A subculture characterized by dark fashion, mournful music, and macabre aesthetics.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "subculture_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philip has been into <w>goth</w> for many years.",
                            "target_lang_translations": {
                                "ru": "Филипп увлекается <w>готикой</w> уже много лет.",
                                "zh": "菲利普多年来一直很迷<w>哥特文化</w>。"
                            }
                        },
                        {
                            "text": "The documentary explored the origins of <w>goth</w> in the 1980s.",
                            "target_lang_translations": {
                                "ru": "В документальном фильме исследовались истоки <w>готики</w> в 1980-х годах.",
                                "zh": "这部纪录片探讨了20世纪80年代<w>哥特文化</w>的起源。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "into goth",
                        "goth subculture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Субкультура, характеризующаяся мрачной модой, меланхоличной музыкой и макабрической эстетикой.",
                        "zh": "一种以暗黑时尚、忧郁音乐和阴郁美学为特征的亚文化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готика",
                                "target_lang_sense_clarification": "название субкультуры"
                            },
                            {
                                "target_lang_word": "субкультура готов",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哥特文化",
                                "target_lang_sense_clarification": "亚文化名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7832a2a-0d7a-3297-8101-25f6e061297e",
                    "sense_definition": "A style of rock music influenced by glam rock and punk, known for its dark atmosphere; gothic rock.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "subculture_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band plays a mix of industrial and <w>goth</w>.",
                            "target_lang_translations": {
                                "ru": "Группа играет смесь индастриала и <w>готик-рока</w>.",
                                "zh": "这支乐队演奏的是工业音乐和<w>哥特摇滚</w>的混合体。"
                            }
                        },
                        {
                            "text": "Many people do not realize that <w>goth</w> evolved from punk.",
                            "target_lang_translations": {
                                "ru": "Многие не осознают, что <w>готик-рок</w> произошел от панка.",
                                "zh": "许多人没有意识到<w>哥特摇滚</w>是从朋克演变而来的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "goth rock",
                        "goth band"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль рок-музыки, возникший под влиянием глэм-рока и панка, известный своей мрачной атмосферой; готический рок.",
                        "zh": "一种受华丽摇滚和朋克影响的摇滚乐风格，以其阴暗的氛围而闻名；即哥特摇滚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готик-рок",
                                "target_lang_sense_clarification": "музыкальный жанр"
                            },
                            {
                                "target_lang_word": "готика",
                                "target_lang_sense_clarification": "разговорное название жанра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哥特摇滚",
                                "target_lang_sense_clarification": "音乐流派"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "827d884c-82ef-3ebe-a436-1005f3fbff88",
                    "sense_definition": "A member of the East Germanic people known for invading the Roman Empire and founding successor states in Europe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Goths</w> played a significant role in the fall of Rome.",
                            "target_lang_translations": {
                                "ru": "<w>Готы</w> сыграли значительную роль в падении Рима.",
                                "zh": "<w>哥特人</w>在罗马帝国的衰落中扮演了重要角色。"
                            }
                        },
                        {
                            "text": "Historians study the migration patterns of the <w>Goths</w>.",
                            "target_lang_translations": {
                                "ru": "Историки изучают пути миграции <w>готов</w>.",
                                "zh": "历史学家研究<w>哥特人</w>的迁徙模式。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель восточногерманского народа, известного вторжением в Римскую империю и основанием государств-преемников в Европе.",
                        "zh": "东日耳曼民族的一员，以入侵罗马帝国并在欧洲建立继任国家而闻名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гот",
                                "target_lang_sense_clarification": "исторический этнос"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哥特人",
                                "target_lang_sense_clarification": "历史民族"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc3b3cfd-e6ec-3ad4-9354-491d9fac1543",
                    "sense_definition": "An uncivilized, uncultured, or destructive person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He behaved like a total <w>goth</w> at the dinner table.",
                            "target_lang_translations": {
                                "ru": "За обеденным столом он вел себя как настоящий <w>варвар</w>.",
                                "zh": "他在餐桌上的行为简直像个<w>野蛮人</w>。"
                            }
                        },
                        {
                            "text": "Only a <w>goth</w> would destroy such a beautiful painting.",
                            "target_lang_translations": {
                                "ru": "Только <w>вандал</w> мог уничтожить такую прекрасную картину.",
                                "zh": "只有<w>破坏者</w>才会毁掉这么美丽的画作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "barbarian",
                        "vandal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нецивилизованный, бескультурный или склонный к разрушению человек.",
                        "zh": "指未开化、缺乏教养或具有破坏性的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варвар",
                                "target_lang_sense_clarification": "грубый человек"
                            },
                            {
                                "target_lang_word": "вандал",
                                "target_lang_sense_clarification": "разрушитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "野蛮人",
                                "target_lang_sense_clarification": "粗鲁无礼的人"
                            },
                            {
                                "target_lang_word": "破坏者",
                                "target_lang_sense_clarification": "蓄意毁坏财物的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c980f0b3-b92b-3222-a4f2-102dda87bf90",
                    "sense_definition": "Relating to the goth subculture, its music, or its fashion style.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "subculture_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Melanie looked very <w>goth</w> compared to her classmates.",
                            "target_lang_translations": {
                                "ru": "Мелани выглядела очень <w>готично</w> по сравнению со своими одноклассниками.",
                                "zh": "和同学们相比，梅兰妮看起来非常<w>哥特式</w>。"
                            }
                        },
                        {
                            "text": "She wore heavy <w>goth</w> makeup to the concert.",
                            "target_lang_translations": {
                                "ru": "На концерт она нанесла тяжелый <w>готический</w> макияж.",
                                "zh": "她化着浓重的<w>哥特式</w>妆容去参加了演唱会。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "goth style",
                        "goth look",
                        "goth fashion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к субкультуре готов, её музыке или стилю одежды.",
                        "zh": "与哥特亚文化、其音乐或时尚风格相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готический",
                                "target_lang_sense_clarification": "прилагательное"
                            },
                            {
                                "target_lang_word": "в стиле гот",
                                "target_lang_sense_clarification": "описание стиля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哥特式的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2a4e95e2-df2b-3b70-ac67-1d582d0f8806",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Goth</w> was the first to arrive at the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Гот</w> первым прибыл на собрание.",
                                "zh": "<w>戈斯</w>先生是第一个到达会议现场的。"
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Goth</w>.",
                            "target_lang_translations": {
                                "ru": "Я никогда не встречал никого с фамилией <w>Гот</w>.",
                                "zh": "我从未见过姓<w>戈斯</w>的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гот",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戈斯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}