                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plagioklas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b471d59-42f4-308e-a1a9-d9d6d830e704",
                                        "entry_id": "e8c11314-cef1-3e7b-93ef-33de13db4a6d",
                                        "glosses": [
                                            "zu den Feldspaten gehörendes Mineral"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f88fbdb3-7a39-4dbc-a25a-cdbad3ad6a8c",
                                                "sense_id": "1b471d59-42f4-308e-a1a9-d9d6d830e704",
                                                "text": "Plagioklase haben einen hohen Gehalt an Calcium und Natrium."
                                            },
                                            {
                                                "example_id": "264011da-7572-4fc6-9b15-4c597997c8ed",
                                                "sense_id": "1b471d59-42f4-308e-a1a9-d9d6d830e704",
                                                "text": "Die Farbe von Plagioklas ist abwechslungsreich und variiert zwischen farblos, weiß, rot, grün und grau."
                                            },
                                            {
                                                "example_id": "f7d10a9e-4c30-4dbf-ba5a-6cbce7b0f695",
                                                "sense_id": "1b471d59-42f4-308e-a1a9-d9d6d830e704",
                                                "text": "Plagioklas kristallisiert dem triklinen Kristallsystem folgend und bildet tafelförmige Kristalle, die oft zu Zwillingen miteinander verwachsen."
                                            },
                                            {
                                                "example_id": "be5f74bd-3b5d-4df2-8d2e-6a246c3dc2c5",
                                                "sense_id": "1b471d59-42f4-308e-a1a9-d9d6d830e704",
                                                "text": "Plagioklas-Feldspate sind insbesondere als Rohstoff für die Herstellung von Porzellan von hoher Bedeutung."
                                            },
                                            {
                                                "example_id": "b0e7f6f2-43e2-4770-82dc-7189fd506af1",
                                                "sense_id": "1b471d59-42f4-308e-a1a9-d9d6d830e704",
                                                "text": "Die Reihenfolge der Minerale entlang der Basis des Dreiecks stellt die Mischkristallreihe von Plagioklas zwischen Albit und Anorthit dar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff39755f-5054-4d8a-b0f4-e5cd1182dc33",
