                                                "sense_id": "88839dd5-90ef-345a-bae2-97937b6b62cf",
                                                "text": "„Im Labor wird mit Kochplatte, Backofen und Kühlschrank die Digitalisierung der alten Tondokumente vorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
