                "senses": [
                    {
                        "sense_id": "7a89566a-dd43-36a4-9d19-9d2075f5c358",
                        "entry_id": "d2256b20-3563-36da-8669-09172448b90b",
                        "glosses": [
                            "Qui établit une préférence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760a353b-72e5-48da-8ee5-a2028a958a50",
                                "sense_id": "7a89566a-dd43-36a4-9d19-9d2075f5c358",
                                "text": "Il avait établi le catalogue des champignons de toute la région, par aires géologiques préférentielles."
                            },
                            {
                                "example_id": "00c7e05f-07bf-4ff0-9ec5-bc282c4cdbe1",
                                "sense_id": "7a89566a-dd43-36a4-9d19-9d2075f5c358",
                                "text": "Il existe comme un régime préférentiel pour certaines religions qui sont mieux tolérées dans les lieux publics et dont les moments de célébration sont consacrés."
                            },
                            {
                                "example_id": "fdc9ff69-64e6-4cb9-b6fc-e938a127d74c",
                                "sense_id": "7a89566a-dd43-36a4-9d19-9d2075f5c358",
                                "text": "Exportateur enregistré sur le système REX et pouvant auto-certifier l’origine préférentielle d’une marchandise en recourant à la mention « Attestation d’origine » sur les documents commerciaux pour l’identification des marchandises."
                            }
                        ]
                    }
