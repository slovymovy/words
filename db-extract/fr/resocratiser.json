                "senses": [
                    {
                        "sense_id": "369ca74b-9a4f-3cb2-950f-163a16fc4786",
                        "entry_id": "66c7a1d6-5d72-3604-9638-d167949ce5d5",
                        "glosses": [
                            "Socratiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6ea0b6-db37-4145-a831-92ebf9edb59d",
                                "sense_id": "369ca74b-9a4f-3cb2-950f-163a16fc4786",
                                "text": "Que dire, en effet, s'il arrive à Platon de se « resocratiser » lui-même?"
                            },
                            {
                                "example_id": "14792f08-04db-481f-b52a-6a091d3a0146",
                                "sense_id": "369ca74b-9a4f-3cb2-950f-163a16fc4786",
                                "text": "Gadamer en revanche rend mérite à Aristote d'être resté dialecticien, et l'on a pu dire à juste titre que sa lecture de Platon tendait à le « resocratiser » en conférant à ses dialogues le caractère d'une quête de sens foncièrement ouverte refusant de se clore dans une vue saturante."
                            }
                        ]
                    }
