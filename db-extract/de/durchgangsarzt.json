                "senses": [
                    {
                        "sense_id": "933e5086-f7bd-3f56-9439-1a8c18a1942c",
                        "entry_id": "29f14733-2d07-3e3f-8b1f-d33db2cb02c7",
                        "glosses": [
                            "Arzt, der seitens der gesetzlichen Unfallversicherung eine besondere Zulassung für die Behandlung von Arbeits- und Wegeunfällen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a979f64e-ab75-4658-b76e-020a597529bc",
                                "sense_id": "933e5086-f7bd-3f56-9439-1a8c18a1942c",
                                "text": "„Bei der Rehabilität geht es dabei konkret um den sogenannten Durchgangsarzt, dem beispielsweise von der Unfallversicherung alle Unfallverletzten zugeführt werden.“"
                            },
                            {
                                "example_id": "b2dea679-9204-42bc-affb-b9c9d4a3b799",
                                "sense_id": "933e5086-f7bd-3f56-9439-1a8c18a1942c",
                                "text": "„Wer auf dem Weg zur oder von der Arbeit einen Glätteunfall hat, sollte einen sogenannten Durchgangsarzt aufsuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
