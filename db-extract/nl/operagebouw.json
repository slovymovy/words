                        "glosses": [
                            "theater waar opera's kunnen worden opgevoerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2689080e-11a5-436c-ace0-74bd16b8241c",
                                "sense_id": "56fbb1d4-e14e-3b53-93f6-c3a7010f8f93",
                                "text": "Ik bleef in het hotel, lag op bed toeristische folders te lezen die ik bij de receptie had opgehaald of ik liep door de stad, naar de haven waar te midden van hijskranen het nieuwe operagebouw verrees."
                            },
                            {
                                "example_id": "e13e56a9-b4e1-4d09-8e31-5ab5978fbe9e",
                                "sense_id": "56fbb1d4-e14e-3b53-93f6-c3a7010f8f93",
                                "text": "Andreu ontwierp ook veel opera- en theatergebouwen, zoals in China de operagebouwen van Peking en Jinan. Hij tekende verder het maritiem museum in Osaka en het centrum voor oriëntaalse kunst in Shanghai."
                            }
                        ]
