                "translations": [
                    {
                        "translation_id": "feb2b887-08be-4d8c-9982-b5ff9482b6ba",
                        "source_entry_id": "12830f2d-07a6-33da-be82-73c03e6749fa",
                        "source_sense_id": "3d4f7f24-e6f6-39e2-8c82-89a5c6c52fb7",
                        "source_sense_description": "Handlung/Vorgang, dass etwas gedämpft/gekocht und damit essbar wird",
                        "target_lang_word": "cuisson",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuisson",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5cd815b-11cb-3d78-b174-c595c3127496",
                                        "entry_id": "83e8d71c-b38d-3319-8651-9b080949b08a",
                                        "glosses": [
                                            "Action de cuire ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e6e1eb-91f4-4983-b8f0-b7e3467c03dc",
                                                "sense_id": "e5cd815b-11cb-3d78-b174-c595c3127496",
                                                "text": "La cuisson peut être intermittente ou continue : dans le premier cas on défourne la chaux produite après chaque opération ; dans le second on continue indéfiniment la calcination en retirant la chaux à mesure qu’elle est cuite […]."
                                            },
                                            {
                                                "example_id": "f33b0821-bb81-4eaf-b6e8-08dd6d017f81",
                                                "sense_id": "e5cd815b-11cb-3d78-b174-c595c3127496",
                                                "text": "Elle ne salait les mets qu’après la cuisson, bien qu’elle sût à quel point la fadeur lui en était désagréable."
                                            },
                                            {
                                                "example_id": "e3317c35-f866-4228-aa6d-f2b3f3b660e3",
                                                "sense_id": "e5cd815b-11cb-3d78-b174-c595c3127496",
                                                "text": "Dans Mythologiques, Claude Lévi-Strauss écrit que cuire un aliment, c’est couper court au processus naturel qui fait qu’à terme un aliment cru (un légume, un fruit, un morceau de viande) devient une chose pourrie. La cuisson stoppe ce que la nature a commencé."
                                            },
                                            {
                                                "example_id": "71a55793-5a30-413e-8ab3-f0a197e570e7",
                                                "sense_id": "e5cd815b-11cb-3d78-b174-c595c3127496",
                                                "text": "Pour s'en sortir sans remplacer cet élément, on peut diminuer cette pression s'il existe un réglage de pression (2 vis sur ressort), sans trop si on ne veut pas de problème de cuisson du toner."
                                            },
                                            {
                                                "example_id": "e98ed723-a10c-43f3-8738-62e0ebca1798",
                                                "sense_id": "e5cd815b-11cb-3d78-b174-c595c3127496",
                                                "text": "La cuisson est le plus souvent un « traitement thermique en phase aqueuse » : traitement thermique, parce que l’on chauffe ; en phase aqueuse, parce que les tissus animaux et végétaux, qui font l’essentiel de nos aliments, sont principalement faits d’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5715e564-b91b-3d1b-a327-a178fcc98b1d",
                                        "entry_id": "83e8d71c-b38d-3319-8651-9b080949b08a",
                                        "glosses": [
                                            "Liquide présent dans le récipient de cuisson à la fin de la cuisson d’un plat."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67d98860-0c1f-4e25-af7c-1afb24fb3782",
                                                "sense_id": "5715e564-b91b-3d1b-a327-a178fcc98b1d",
                                                "text": "Couper la selle d’agneau en tranches fines, les dresser sur un plat chaud et napper avec la cuisson montée au beurre."
                                            },
                                            {
                                                "example_id": "9767a9ab-549c-4ce4-b335-3298268aa953",
                                                "sense_id": "5715e564-b91b-3d1b-a327-a178fcc98b1d",
                                                "text": "D’autre part, faire cuire un homard comme pour l’américaine; une fois cuit le décarapacer ; laisser réduire la cuisson ; la monter au beurre d’écrevisse et la passer à l’étamine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f539aa91-dca3-319a-9072-7f9b0f745146",
                                        "entry_id": "83e8d71c-b38d-3319-8651-9b080949b08a",
                                        "glosses": [
                                            "Douleur que l’on ressent d’un mal qui est cuisant."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "535064fb-3720-4480-878a-145e08b7dce8",
                                                "sense_id": "f539aa91-dca3-319a-9072-7f9b0f745146",
                                                "text": "Je sens une horrible cuisson dans ma plaie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
