                                    {
                                        "sense_id": "3a81eb5f-a9be-3267-95b0-3a7c33879a4f",
                                        "entry_id": "5d4787bc-8a65-34d2-aa7e-c714c37626e1",
                                        "glosses": [
                                            "Manière d’employer régulièrement tout ce qui est nécessaire pour conserver la vie, soit dans la santé soit dans la maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e080192-148d-45d1-9d43-52517e3fcaca",
                                                "sense_id": "3a81eb5f-a9be-3267-95b0-3a7c33879a4f",
                                                "text": "La diète est une partie essentielle de la médecine."
                                            },
                                            {
                                                "example_id": "295e8cb6-8768-439d-9b81-db404ea5d612",
                                                "sense_id": "3a81eb5f-a9be-3267-95b0-3a7c33879a4f",
                                                "text": "Je ne laisse pourtant pas d’aller et venir, et les médecins m’assurent que tout ira bien, pourvu que je sois exact à la diète qu’ils m’ont ordonnée, et je l’observe avec une attention incroyable."
                                            },
                                            {
                                                "example_id": "ba3477c4-46c3-4c32-84c5-1ced576fdff8",
                                                "sense_id": "3a81eb5f-a9be-3267-95b0-3a7c33879a4f",
                                                "text": "Il [Théodose] entretenait sa santé par un exercice modéré et par la diète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "390cdeb3-555f-320a-aaa2-6d16560b03b6",
                                        "entry_id": "5d4787bc-8a65-34d2-aa7e-c714c37626e1",
                                        "glosses": [
                                            "Régime nutritionnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d0394a-a73c-4351-9dda-a324366dd8d9",
                                                "sense_id": "390cdeb3-555f-320a-aaa2-6d16560b03b6",
                                                "text": "Diète lactée."
                                            },
                                            {
                                                "example_id": "fea3c9cd-1c08-481e-a0c4-33902c0091be",
                                                "sense_id": "390cdeb3-555f-320a-aaa2-6d16560b03b6",
                                                "text": "Diète hydrique."
                                            },
                                            {
                                                "example_id": "49f79c8e-1ac0-4326-a6fe-7b0c356c023d",
                                                "sense_id": "390cdeb3-555f-320a-aaa2-6d16560b03b6",
                                                "text": "Diète végétale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45d0392-bb7a-327c-a252-5ad677de9b08",
                                        "entry_id": "5d4787bc-8a65-34d2-aa7e-c714c37626e1",
                                        "glosses": [
                                            "Privation de nourriture qui s’applique particulièrement aux malades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d70fec-2112-4edd-bb49-aae0717d0cb4",
                                                "sense_id": "f45d0392-bb7a-327c-a252-5ad677de9b08",
                                                "text": "Il fut mis à la diète. Une diète rigoureuse. Il ne faut pas prolonger la diète au delà de ce qui est nécessaire."
                                            },
                                            {
                                                "example_id": "2b77ca87-ec59-4856-9c39-6f86e36b253f",
                                                "sense_id": "f45d0392-bb7a-327c-a252-5ad677de9b08",
                                                "text": "Quoique voraces, les loups supportent aisément la diète."
                                            }
                                        ]
                                    }
                                ]
                            },
