    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7d87247b-d146-3c0c-87ea-b11b4e499c85",
                "word": "dacoit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "37894d75-bf7c-4932-8a6c-ae8c4dbe1665",
                        "entry_id": "7d87247b-d146-3c0c-87ea-b11b4e499c85",
                        "tags": [
                            "plural"
                        ],
                        "form": "dacoits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c25788ff-7f7a-3d17-a5fd-6b9f494ffdc9",
                        "entry_id": "7d87247b-d146-3c0c-87ea-b11b4e499c85",
                        "glosses": [
                            "A bandit or armed robber, especially in former parts of British India."
                        ],
                        "tags": [
                            "India",
                            "Myanmar",
                            "Pakistan"
                        ],
                        "examples": [
                            {
                                "example_id": "ec8af05b-566a-49c9-8cef-371497c688ac",
                                "sense_id": "c25788ff-7f7a-3d17-a5fd-6b9f494ffdc9",
                                "text": "1893, Bithia Mary Croker, \"The Dâk Bungalow at Dakor\" in \"To Let\" etc., Philadelphia: J.B. Lippincott, 1906, p. 118, https://archive.org/details/toletcroker00crok\n[…] she had harangued us on the subject of fever and cholera and bad water, had warned us solemnly against dacoits, and now she was hinting at ghosts."
                            },
                            {
                                "example_id": "0859b4df-a68e-4d1d-aa6d-212d8881a838",
                                "sense_id": "c25788ff-7f7a-3d17-a5fd-6b9f494ffdc9",
                                "text": "If any village failed in its tribute U Po Kyin took punitive measures—gangs of dacoits attacked the village, leading villagers were arrested on false charges, and so forth—and it was never long before the amount was paid up."
                            },
                            {
                                "example_id": "1076a1fe-4c0e-445c-b8f4-7937a4b4f175",
                                "sense_id": "c25788ff-7f7a-3d17-a5fd-6b9f494ffdc9",
                                "text": "The history of northern India is studded with the names of notorious outlaw dacoits who roam the hills in the name of Kali, robbing the rich, comforting the poor, and in general spreading terror and rough justice."
                            },
                            {
                                "example_id": "d20f17bc-372d-4833-9d24-4bf6251ca90e",
                                "sense_id": "c25788ff-7f7a-3d17-a5fd-6b9f494ffdc9",
                                "text": "On the way back Boyles led him down a lampless lane, and sure enough, a pair of dacoits pounced on them."
                            },
                            {
                                "example_id": "adc8111c-94dd-41ad-900b-4da616997ce9",
                                "sense_id": "c25788ff-7f7a-3d17-a5fd-6b9f494ffdc9",
                                "text": "“The notorious forest brigand, bandit, murderer and dacoit, Veerappan, along with his entire gang, has been shot dead,” Jayaram Jayalalithaa, the Chief Minister of Tamil Nadu State, announced."
                            },
                            {
                                "example_id": "2d6a296d-f82a-4953-a96d-aac3bad59b8e",
                                "sense_id": "c25788ff-7f7a-3d17-a5fd-6b9f494ffdc9",
                                "text": "A very athletic female dacoit was arrested in North Nazimabad in Karachi after she vaulted over a nine-foot wall, following her unsuccessful attempt at armed robbery in the house of a retired banker."
                            }
                        ]
                    }
                ],
