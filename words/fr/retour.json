                    "frequency": "Middle",
                    "semantic_group_id": "retour_information_renvoyee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'attends vos <w>retours</w> sur ce document avant la fin de la semaine."
                        },
                        {
                            "text": "Les clients ont fait un excellent <w>retour</w> sur ce nouveau produit."
