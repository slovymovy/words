                                "target_senses": [
                                    {
                                        "sense_id": "e4443733-a922-34fc-bd2d-c7b921491028",
                                        "entry_id": "55b6090c-7ce3-393a-bb86-5d47eec32e0d",
                                        "glosses": [
                                            "To take vengeance (for); to exact satisfaction for by punishing the injuring party; to vindicate by inflicting pain or evil on a wrongdoer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3feef270-faa5-4c55-b949-bb1e691f0534",
                                                "sense_id": "e4443733-a922-34fc-bd2d-c7b921491028",
                                                "text": "to avenge the murder of his brother"
                                            },
                                            {
                                                "example_id": "dc3ee498-1a3a-4f34-ab38-8f34dab31059",
                                                "sense_id": "e4443733-a922-34fc-bd2d-c7b921491028",
                                                "text": "Avenge O Lord thy ſlaughter'd Saints, whoſe bones / Lie ſcatter'd on the Alpine mountains cold,"
                                            },
                                            {
                                                "example_id": "9aa432b2-887e-4638-961e-ca5286c8184f",
                                                "sense_id": "e4443733-a922-34fc-bd2d-c7b921491028",
                                                "text": "Father, today I will avenge your death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eaa118b-11b3-30f5-929a-ba5590d6a65e",
                                        "entry_id": "55b6090c-7ce3-393a-bb86-5d47eec32e0d",
                                        "glosses": [
                                            "To revenge oneself (on or upon someone)."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0372cb2-0fb4-31d6-9e36-325b24c3b174",
                                        "entry_id": "55b6090c-7ce3-393a-bb86-5d47eec32e0d",
                                        "glosses": [
                                            "To take vengeance."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ad7bc41-b5b5-4a2d-9aa8-fbc6b522bf1b",
                                                "sense_id": "e0372cb2-0fb4-31d6-9e36-325b24c3b174",
                                                "text": "Thou shalt not auenge nor beare any grudge against the children of thy people, but thou shalt loue thy neighbor as thy selfe: I am the Lord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc47edf8-98c1-3e63-a81a-1e619484d6b2",
                                        "entry_id": "55b6090c-7ce3-393a-bb86-5d47eec32e0d",
                                        "glosses": [
                                            "To treat revengefully; to wreak vengeance on."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f12cc10-2ed8-42aa-937b-d8a3850d88b0",
                                                "sense_id": "cc47edf8-98c1-3e63-a81a-1e619484d6b2",
                                                "text": "thy judgment in avenging thine enemies"
                                            }
                                        ]
                                    }
                                ]
                            },
