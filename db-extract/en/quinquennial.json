        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bde63850-3b90-3b1b-a971-bdd7e661306b",
                "word": "quinquennial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f234940-6a88-3e54-b8fa-a38eed024e54",
                        "entry_id": "bde63850-3b90-3b1b-a971-bdd7e661306b",
                        "glosses": [
                            "Of or related to a five-year period."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff2adf66-f6ff-469d-8b24-2aa511695af5",
                                "sense_id": "4f234940-6a88-3e54-b8fa-a38eed024e54",
                                "text": "By a singular coincidence, the great master of the Dorian lyre was born during the celebration of the Pythia, the quinquennial festival of Apollo[…]"
                            },
                            {
                                "example_id": "4a8af41e-6814-466c-81b7-15e08aadbb5b",
                                "sense_id": "4f234940-6a88-3e54-b8fa-a38eed024e54",
                                "text": "The best data that BEA have come from the quinquennial censuses of business; these are used to “benchmark” the national accounts every five years and to compute new input-output tables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "113cb7c5-b492-407c-9865-d046de22614a",
                        "source_entry_id": "bde63850-3b90-3b1b-a971-bdd7e661306b",
                        "source_sense_id": "4f234940-6a88-3e54-b8fa-a38eed024e54",
                        "source_sense_description": "related to a 5 year period",
                        "target_lang_word": "quinquennal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
