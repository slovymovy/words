                ],
                "senses": [
                    {
                        "sense_id": "989663fe-1886-3e72-96a8-60036929858e",
                        "entry_id": "c4660771-1db1-3751-9fb3-bacc8599eee9",
                        "glosses": [
                            "künstliche Wand zum Klettern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37057d6a-ddcb-4726-a9bb-a6818c723c17",
                                "sense_id": "989663fe-1886-3e72-96a8-60036929858e",
                                "text": "„Die Kletterwand des Westfalenbades ragt über das Wasser und verfügt über drei farbig gekennzeichnete Kletterrouten.“"
                            },
                            {
                                "example_id": "1509aacb-fdc3-4847-9db4-f0d6415d0562",
                                "sense_id": "989663fe-1886-3e72-96a8-60036929858e",
                                "text": "„Die Kletterwand – viele mögen sie und wollen hoch hinaus. Da die Kletterwand aber spezielles Personal benötigt und wir dieses nur am Wochenende vor Ort haben, können wir während der Woche die Kletterwand nicht betreiben.“"
                            },
                            {
                                "example_id": "e05a923f-f62a-4449-96c4-c379085439d6",
                                "sense_id": "989663fe-1886-3e72-96a8-60036929858e",
                                "text": "„Die mobile, freistehende, verstellbare Kletterwand wurde gemeinsam mit PhysiotherapeutInnen [sic] und KlettertrainerInnen [sic] entwickelt und ist zum Patent angemeldet.“"
                            },
                            {
                                "example_id": "3dc8e229-f536-43b8-aefb-aa956401c38a",
                                "sense_id": "989663fe-1886-3e72-96a8-60036929858e",
                                "text": "„An unserer sechs Meter hohen Kletterwand können Sie Ihre Teamfähigkeit fördern, die Koordination trainieren und Ihre Rückenmuskulatur stärken.“"
                            },
                            {
                                "example_id": "92b627bf-c962-4458-8bce-e5c94de567e2",
                                "sense_id": "989663fe-1886-3e72-96a8-60036929858e",
                                "text": "„Ab sofort könnt ihr im Konzertsaal des AJZ die neue Kletterwand nach Herzenslust klettern und euer Können allein, zu zweit oder in der Gruppe unter Beweis stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
