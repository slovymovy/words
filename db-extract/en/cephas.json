                "forms": [],
                "senses": [
                    {
                        "sense_id": "c6b1e815-db64-39b4-92d0-527094326a70",
                        "entry_id": "390e9718-3192-39df-8ca4-26e38631adc8",
                        "glosses": [
                            "The apostle Peter, using the name given to him by Jesus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b4f53d-fcab-41bd-8e19-b3694ad81e59",
                                "sense_id": "c6b1e815-db64-39b4-92d0-527094326a70",
                                "text": "And when Jesus beheld him, he said, Thou art Simon the son of Jona: thou shalt be called Cephas, which is by interpretation, A stone."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9997540-4a3a-337f-b743-ff23ea6b2113",
                        "entry_id": "390e9718-3192-39df-8ca4-26e38631adc8",
                        "glosses": [
                            "A male given name from Aramaic of biblical origin."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
