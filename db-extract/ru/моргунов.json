        "ru-extract.jsonl": [
            {
                "entry_id": "8530792c-5dda-3d3a-8787-c22b20c3317f",
                "word": "Моргунов",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c933a00-3ff5-3dae-b736-f3fe7c6ad06b",
                        "entry_id": "8530792c-5dda-3d3a-8787-c22b20c3317f",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c96d1f-ceb8-47ce-ae25-7684eaba1351",
                                "sense_id": "8c933a00-3ff5-3dae-b736-f3fe7c6ad06b",
                                "text": "Семён Семёныч Моргунов ¶ ❬…❭ Между прочим, был он своим, можно сказать, человеком у адвоката Семёна Семёныча Моргунова. Так и называл его Моргунов: — Мой придворный портной. ❬…❭ Моргунов — это, впрочем, не настоящая его фамилия, а так — прозвание вроде, дразнили его так по-уличному."
                            },
                            {
                                "example_id": "c02623f7-f73f-429c-8ff3-4ca6bfe8f60d",
                                "sense_id": "8c933a00-3ff5-3dae-b736-f3fe7c6ad06b",
                                "text": "— Здравствуйте, я Моргунова из шестого подъезда, — сказала дама, с треском складывая зонтик и входя в коридор."
                            },
                            {
                                "example_id": "ba56f5db-05c3-4d55-87ba-09edfa0cd75f",
                                "sense_id": "8c933a00-3ff5-3dae-b736-f3fe7c6ad06b",
                                "text": "Моргунов и Фищук подали к ведомству иск о защите чести и достоинства: им лишь заочно предъявили обвинение, и ни один суд виновными их ещё не признал."
                            }
                        ]
                    }
                ],
