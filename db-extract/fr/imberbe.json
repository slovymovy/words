                    {
                        "form_id": "150332f5-0fd3-4f02-b4a7-8561373e700a",
                        "entry_id": "b6633a51-8cb9-3aa0-9ec9-7252e2d70df3",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "imberbes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2b6a209-c105-3072-b0df-f1f15da6f7f9",
                        "entry_id": "b6633a51-8cb9-3aa0-9ec9-7252e2d70df3",
                        "glosses": [
                            "Qui n'a pas de barbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ee146e-e999-4424-bd01-a5994e7027de",
                                "sense_id": "a2b6a209-c105-3072-b0df-f1f15da6f7f9",
                                "text": "Ted Neuville est un « crâne d'œuf » typique, chauve, imberbe et affublé de lunettes, du genre qui, en d'autres temps, aurait servi de modèle à une pub pour un antivirus. Il hausse son absence de sourcils avec une moue désabusée."
                            },
                            {
                                "example_id": "1d8ff551-785e-4e14-b1f5-84925ef55e55",
                                "sense_id": "a2b6a209-c105-3072-b0df-f1f15da6f7f9",
                                "text": "Charlemagne était grand et fort, mais c’est parce qu’il était imberbe et avait une voix claire qu’on l’a représenté portant une barbe afin de lui donner plus de virilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "81d4d564-127c-3d53-9360-269cc0707614",
                        "entry_id": "b6633a51-8cb9-3aa0-9ec9-7252e2d70df3",
                        "glosses": [
                            "Trop jeune, inexpérimenté."
                        ],
                        "tags": [
                            "broadly",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a4135dc8-c972-4acb-92b1-06a5dbfa0ae2",
                                "sense_id": "81d4d564-127c-3d53-9360-269cc0707614",
                                "text": "Ces critiques imberbes veulent tout régenter."
                            }
                        ]
                    },
                    {
                        "sense_id": "445026de-7190-3bad-ac22-09e8bd530a7b",
                        "entry_id": "b6633a51-8cb9-3aa0-9ec9-7252e2d70df3",
                        "glosses": [
                            "Glabre, dépourvu de poils."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "65f41f97-a571-4587-8064-1ab45e846ff6",
                                "sense_id": "445026de-7190-3bad-ac22-09e8bd530a7b",
                                "text": "Vulve imberbe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0121550e-2b9a-4f12-8dcf-3e05d0157a24",
                        "source_entry_id": "b6633a51-8cb9-3aa0-9ec9-7252e2d70df3",
                        "target_lang_word": "bartlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bartlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2adb28c8-a0fd-35aa-930b-0d4f4c32ef8e",
                                        "entry_id": "e9581171-0302-3cb1-b8b6-31f4e81cf27e",
                                        "glosses": [
                                            "keinen Bart habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15435b4f-6d2e-422d-8a31-d2e847de1dd4",
                                                "sense_id": "2adb28c8-a0fd-35aa-930b-0d4f4c32ef8e",
                                                "text": "„Sein Gesicht war glatt, bartlos.“"
                                            },
                                            {
                                                "example_id": "c91a2d0b-07a2-47bf-9bd9-aee6c38c2c2b",
                                                "sense_id": "2adb28c8-a0fd-35aa-930b-0d4f4c32ef8e",
                                                "text": "„Sein bartloses Gesicht wurde düster und verdrießlich.“"
                                            },
                                            {
                                                "example_id": "54c6c7ec-fe6c-4729-80d1-e1a9e58b3a76",
                                                "sense_id": "2adb28c8-a0fd-35aa-930b-0d4f4c32ef8e",
                                                "text": "„Ich sehe die vom tägliche Umgang verwischten körperlichen Unterschiede: Mein Kopf ist nicht so rund, meine Lippen sind markanter, ich benutze andere Muskelgruppen im Gesicht, wenn ich mich ärgere, er ist bartlos, ich rasiere mich ein Mal pro Woche.“"
                                            },
                                            {
                                                "example_id": "e2480c8d-6930-4389-be61-636a645b9447",
                                                "sense_id": "2adb28c8-a0fd-35aa-930b-0d4f4c32ef8e",
                                                "text": "„War dieser bartlose Weihnachtsmann zu entwaffnend gewesen?“"
                                            },
                                            {
                                                "example_id": "49f5ce8f-3293-4897-9821-03670e3ed51a",
                                                "sense_id": "2adb28c8-a0fd-35aa-930b-0d4f4c32ef8e",
                                                "text": "„Trotz seiner schmächtigen Brust und seines bartlosen Gesichts war seine Stimme tief und ernst, er klang, als spräche er vom Boden eines Fasses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72e6eaf3-70af-461f-8f1a-e16b34ee85a1",
                        "source_entry_id": "b6633a51-8cb9-3aa0-9ec9-7252e2d70df3",
                        "target_lang_word": "twink",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4e0a90fd-7b6f-40c4-bd54-37176d61f674",
