                                    {
                                        "sense_id": "ce7d5951-74e8-3355-9948-e8055d558bbf",
                                        "entry_id": "7488e709-56c3-3280-aa67-c16c0ea3e772",
                                        "glosses": [
                                            "Fear, dislike, or hatred of gay men."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0375e3f2-1608-481b-a4f6-af4c899d051b",
                                                "sense_id": "ce7d5951-74e8-3355-9948-e8055d558bbf",
                                                "text": "Homophobia concerns lesbians (lesbophobia), gay men (gayphobia), bisexual people (biphobia), and transgender people (transphobia)."
                                            },
                                            {
                                                "example_id": "bf8f32da-a4ab-4f64-aef6-9d76216d6eae",
                                                "sense_id": "ce7d5951-74e8-3355-9948-e8055d558bbf",
                                                "text": "In fact, gayphobia occupied more media space than lesbophobia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "744977b0-930a-373e-acaa-94fe0915357a",
                                        "entry_id": "7488e709-56c3-3280-aa67-c16c0ea3e772",
                                        "glosses": [
                                            "Fear, dislike, or hatred of gay people in general."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9a55137-51e6-43e4-8d2c-e944bcf64b53",
                                                "sense_id": "744977b0-930a-373e-acaa-94fe0915357a",
                                                "text": "A major problem LGBTQ people face is gayphobia or homophobia, the irrational “fear and hatred” of gay, lesbian, bisexual, and transgender people (Morrow, 2008, p. 79)."
                                            }
                                        ]
