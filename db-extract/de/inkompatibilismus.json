                        "glosses": [
                            "Denkschule, die von einer Unvereinbarkeit des freien Willens und dem Determinismus ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d91a9739-48cd-4db3-8c43-02fdf5e65d1b",
                                "sense_id": "ac99ded9-11dd-3b7d-a1a5-b45d249ba602",
                                "text": "„Inkompatibilismus ist eine Position zum Vereinbarkeitsproblem, die sich hinsichtlich der Frage, welche dder ebiden unvereinbaren Optionen in unserer Welt realisiert ist, neutral verhält.“"
                            }
                        ],
