                        "glosses": [
                            "Défaire ce qui est fermé d’un sceau, d’un cachet, décacheter."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3532c676-9e13-379f-9f14-57292d056e39",
                        "entry_id": "174b0d99-ffbd-36e0-8e4f-93623dcce3da",
                        "glosses": [
                            "Détacher ce qui est scellé en plâtre, en plomb, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f7836a-0cd7-4036-9635-55c8f04bb4b2",
                                "sense_id": "3532c676-9e13-379f-9f14-57292d056e39",
                                "text": "Une jeune fille, à l’imagination vive, enfermée dans une tourelle, se meurt d’envie de courir dans le parc où ses yeux seulement pénètrent ; elle invente un moyen de désceller sa grille, elle saute par la croisée, escalade le mur du parc, et va folâtrer chez le voisin."
                            }
                        ]
                    }
