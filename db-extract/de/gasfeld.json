                        "glosses": [
                            "Gebiet, in dem Erdgas im Boden lagert und wirtschaftlich genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba5526b-88b7-4c11-91fe-144f7167a28c",
                                "sense_id": "23b7b470-abf9-38c6-9a72-fd014cac47ab",
                                "text": "„Trotz Warnungen vor den Klimafolgen will Großbritannien neue Öl- und Gasfelder in der Nordsee nutzbar machen.“"
                            },
                            {
                                "example_id": "98cd8bf5-a93e-4d94-a55c-f0ceae200920",
                                "sense_id": "23b7b470-abf9-38c6-9a72-fd014cac47ab",
                                "text": "„Das größte Gasfeld Pakistans im belutschischen Sui wurde Anfang der 1950er Jahre erschlossen und versorgt seitdem den Punjab großflächig mit Gas; Quetta hingegen wurde erst in den 1980er Jahren auf Druck eines einflusreichen lokalen Politikers an die Gasleitung angeschlossen.“"
                            }
                        ],
