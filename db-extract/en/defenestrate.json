                                    {
                                        "sense_id": "64af9890-d509-3593-a710-c18e1d6d9f1b",
                                        "entry_id": "f1218072-5bcb-3b1f-8c4e-56159129214a",
                                        "glosses": [
                                            "Jeter quelqu’un par une fenêtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11e1053-78a1-4cae-8239-98da38254c1f",
                                                "sense_id": "64af9890-d509-3593-a710-c18e1d6d9f1b",
                                                "text": "Ils paniquent… Hier, c’est le vice-président d’une société pétro-chimique qui a été défenestré."
                                            },
                                            {
                                                "example_id": "415c47b1-e379-4d4e-8bfe-47b7612b5651",
                                                "sense_id": "64af9890-d509-3593-a710-c18e1d6d9f1b",
                                                "text": "Les insurgés en ont profité pour défenestrer l'aristocrate honni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da04390b-b8c0-35ba-a71c-2b8d95b389ae",
                                        "entry_id": "f1218072-5bcb-3b1f-8c4e-56159129214a",
                                        "glosses": [
                                            "Jeter quelque chose par une fenêtre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b13eba-231f-4846-bc4a-8286acb60757",
                                                "sense_id": "da04390b-b8c0-35ba-a71c-2b8d95b389ae",
                                                "text": "Elle l'a plaqué et s'est empressée de défenestrer toutes les affaires personnelles qui traînaient chez elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0253e342-c281-404e-b76e-e8a7d2924423",
                        "source_entry_id": "aed058fb-7192-36c7-aebe-d427dd2d14ba",
                        "source_sense_description": "eject from a window",
                        "target_lang_word": "aus dem Fenster werfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a80b7452-190d-4c00-b5bb-687e0ca5ca5f",
                        "source_entry_id": "aed058fb-7192-36c7-aebe-d427dd2d14ba",
                        "source_sense_description": "eject from a window",
                        "target_lang_word": "defenestrieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defenestrieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3567e202-fa49-34d1-a263-a47f4ba1dc1c",
                                        "entry_id": "a02ef335-c20c-3465-8df7-c212b76a3a96",
                                        "glosses": [
                                            "eine Person (zur Hinrichtung) aus einem Fenster werfen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36bc6f32-dae8-42ba-9d64-956f94a5e834",
                                                "sense_id": "3567e202-fa49-34d1-a263-a47f4ba1dc1c",
                                                "text": "„Der Mann mit dem Gänseknochen springt auf. Defenestrieren! Wir werfen sie aus dem Fenster! Die Runde lacht und klatscht Beifall.“"
                                            },
                                            {
                                                "example_id": "5de2152f-aa7a-418d-892e-ee42b54d685a",
                                                "sense_id": "3567e202-fa49-34d1-a263-a47f4ba1dc1c",
                                                "text": "„Auf die Drohung, den Rat als eine Obrigkeit, deren Verhalten nicht gebilligt werde, zu ‚defenestrieren‘, von oben aus dem Fenster zu werfen, eilte Bürgermeister Nikolaus Sturm zu den Versammelten und erklärte die Zustimmung der Ratmannen.“"
                                            },
                                            {
                                                "example_id": "18b322b3-ede5-4d1b-a353-3bba53498830",
                                                "sense_id": "3567e202-fa49-34d1-a263-a47f4ba1dc1c",
                                                "text": "„Vielleicht schreckt Boris Johnson angesichts dieses Tory-Albtraums trotz aller Karrierelust doch noch davor zurück, die glücklose Amtsinhaberin zu defenestrieren.“"
                                            },
                                            {
                                                "example_id": "f8a17fed-81dd-4ec6-b9b1-8dd8b9d4d1ee",
                                                "sense_id": "3567e202-fa49-34d1-a263-a47f4ba1dc1c",
                                                "text": "„Den Prahlhansen müsse einmal gründlich das Maul gestopft werden. Einzelne Stimmen wurden laut, man müsse sie defenestrieren, sie hätten es vollauf verdient, Langmut mache sie nur dreister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
