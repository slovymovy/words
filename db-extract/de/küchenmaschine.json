                        "sense_id": "c85eaf28-f4f2-3ec6-a7a5-43b8bb117417",
                        "entry_id": "0bcbae7e-f7d1-3b62-8797-8a0aa7939694",
                        "glosses": [
                            "elektrisch (oder mechanisch) betriebenes Gerät, das in der Küche eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9aa23ae-20b8-409d-8fd1-f4933e15e34a",
                                "sense_id": "c85eaf28-f4f2-3ec6-a7a5-43b8bb117417",
                                "text": "In einigen Küchen stehen viele unnötige Küchenmaschinen."
                            },
                            {
                                "example_id": "f2338cf0-d4ed-440c-829d-2d759d3d864d",
                                "sense_id": "c85eaf28-f4f2-3ec6-a7a5-43b8bb117417",
                                "text": "Der Mixer ist eine sinnvolle Küchenmaschine."
                            },
                            {
                                "example_id": "464cf156-bdb6-467e-9fc0-60d3a6caa417",
                                "sense_id": "c85eaf28-f4f2-3ec6-a7a5-43b8bb117417",
                                "text": "„Auf der Anrichte stand eine Küchenmaschine, deren Existenz ich total vergessen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
