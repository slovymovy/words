{
    "word_family": [
        "abbreviate",
        "abbreviation",
        "abbreviator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0f0129d5-2beb-32b6-a3e0-289df93699df",
                    "sense_definition": "Shortened or made briefer in length or duration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shortened",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>abbreviated</w> meeting finished much earlier than we had originally planned.",
                            "target_lang_translations": {
                                "zh": "这次<w>简短的</w>会议比我们原计划结束得早得多。"
                            }
                        },
                        {
                            "text": "She gave an <w>abbreviated</w> version of the story to save time.",
                            "target_lang_translations": {
                                "zh": "为了节省时间，她讲了一个<w>简化的</w>故事版本。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shortened",
                        "curtailed",
                        "condensed"
                    ],
                    "antonyms": [
                        "extended",
                        "lengthened"
                    ],
                    "common_phrases": [
                        "abbreviated version",
                        "abbreviated form"
                    ],
                    "target_lang_definitions": {
                        "zh": "指长度或持续时间被缩短的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "简短的",
                                "target_lang_sense_clarification": "指篇幅或时间较短的"
                            },
                            {
                                "target_lang_word": "缩略的",
                                "target_lang_sense_clarification": "指经过删减或压缩的"
                            },
                            {
                                "target_lang_word": "简化的",
                                "target_lang_sense_clarification": "内容经过精简的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9b1693f-baa5-345b-801f-2d311c6b5cec",
                    "sense_definition": "Relatively short or smaller than the standard size.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shortened",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team played an <w>abbreviated</w> season due to the unexpected weather conditions.",
                            "target_lang_translations": {
                                "zh": "由于突发的天气状况，球队进行了一个<w>缩短的</w>赛季。"
                            }
                        },
                        {
                            "text": "He kept an <w>abbreviated</w> record of his daily expenses in a small notebook.",
                            "target_lang_translations": {
                                "zh": "他在一个小笔记本上记录了<w>精简的</w>日常开销。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brief",
                        "compact"
                    ],
                    "target_lang_definitions": {
                        "zh": "指规模或篇幅比标准更小或更短的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "简化的",
                                "target_lang_sense_clarification": "指规模或内容被精简的"
                            },
                            {
                                "target_lang_word": "精简的",
                                "target_lang_sense_clarification": "指去除了冗余部分的"
                            },
                            {
                                "target_lang_word": "缩短的",
                                "target_lang_sense_clarification": "时间或长度被缩短的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ca4a549-6cdf-3db0-a83e-f63c77f2f2d3",
                    "sense_definition": "Very short or revealing, especially regarding clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shortened",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete wore an <w>abbreviated</w> outfit that was designed for maximum speed.",
                            "target_lang_translations": {
                                "zh": "这位运动员穿了一套为了追求极致速度而设计的<w>短小的</w>运动服。"
                            }
                        },
                        {
                            "text": "She felt uncomfortable in the <w>abbreviated</w> dress at the formal event.",
                            "target_lang_translations": {
                                "zh": "她在正式场合穿着那件<w>暴露的</w>裙子感到很不自在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skimpy",
                        "revealing"
                    ],
                    "target_lang_definitions": {
                        "zh": "指衣物非常短或暴露的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "短小的",
                                "target_lang_sense_clarification": "指衣物尺寸短小"
                            },
                            {
                                "target_lang_word": "暴露的",
                                "target_lang_sense_clarification": "指衣物遮盖较少"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90986a8c-de7d-3c5c-9698-44c1af880bf0",
                    "sense_definition": "Simple past and past participle of <w>abbreviate</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>abbreviated</w> the long title to make it easier to remember.",
                            "target_lang_translations": {
                                "zh": "作者把长标题<w>缩短</w>了，以便更容易记住。"
                            }
                        },
                        {
                            "text": "The report has been <w>abbreviated</w> for the board of directors.",
                            "target_lang_translations": {
                                "zh": "这份报告已经为董事会进行了<w>简化</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 abbreviate 的过去式或过去分词，意为缩短或简化。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缩短",
                                "target_lang_sense_clarification": "使长度变短"
                            },
                            {
                                "target_lang_word": "简化",
                                "target_lang_sense_clarification": "使内容变简练"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}