                ],
                "senses": [
                    {
                        "sense_id": "77582085-6a6d-3674-96f0-33d07a150871",
                        "entry_id": "e7fe12f9-1c9a-3fc9-9102-ac11e023e300",
                        "glosses": [
                            "sehr sparsam, geizig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91911fba-6eb8-4acd-9ee0-b2eaa384987f",
                                "sense_id": "77582085-6a6d-3674-96f0-33d07a150871",
                                "text": "„Aber das mußten wir zu Hause auch – und trotzdem bin ich nicht geizig oder schrappig.“"
                            },
                            {
                                "example_id": "f29afa6e-9671-462f-b8b6-a10693defedc",
                                "sense_id": "77582085-6a6d-3674-96f0-33d07a150871",
                                "text": "„Als ob sie sich das Geld in die eigene Tasche steckte, gierte sie schrappig danach.“"
                            },
                            {
                                "example_id": "4f775c4f-fcd4-4f84-8668-3c09f01530fe",
                                "sense_id": "77582085-6a6d-3674-96f0-33d07a150871",
                                "text": "„Besorgt waren beide höchstens wegen einer äußerst schrappigen Schwester, die gerne um Minimalwerte prozessierte und deren Habgier auch der eigentliche Grund für die Erholungsreise in den Harz war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
