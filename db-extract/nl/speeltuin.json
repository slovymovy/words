                "senses": [
                    {
                        "sense_id": "21a555e1-b2ad-3c53-be38-d98ea508fc99",
                        "entry_id": "c89b1855-3e2b-3300-a1b9-7abfbb8a883a",
                        "glosses": [
                            "een omheinde plek grond met speelobjecten voor kinderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25b2aa7-f84d-4025-a0a2-2ef1c72e2cae",
                                "sense_id": "21a555e1-b2ad-3c53-be38-d98ea508fc99",
                                "text": "De nieuwe speeltuin werd feestelijk geopend."
                            },
                            {
                                "example_id": "a1cb5ab8-b0ec-41ae-903f-0b9a9b33f340",
                                "sense_id": "21a555e1-b2ad-3c53-be38-d98ea508fc99",
                                "text": "Tussen de weg en de speeltuin loopt een sloot."
                            },
                            {
                                "example_id": "46af53d6-a77b-4be2-84c3-dec3c19a39a3",
                                "sense_id": "21a555e1-b2ad-3c53-be38-d98ea508fc99",
                                "text": "Onderzoek naar speeltuin in Voorburg waar 23 kinderen ziek werden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f7c76b5-0245-41f8-9e73-990d17ee0b0d",
                        "source_entry_id": "c89b1855-3e2b-3300-a1b9-7abfbb8a883a",
                        "source_sense_id": "21a555e1-b2ad-3c53-be38-d98ea508fc99",
                        "source_sense_description": "een omheinde plek grond met speelobjecten voor kinderen",
                        "target_lang_word": "Spielplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abd2c0f7-0898-3e8c-b772-c676962f91f9",
                                        "entry_id": "1eaf7469-c7d9-3480-980d-18472fd26ba0",
                                        "glosses": [
                                            "in der Regel gekennzeichneter Platz zum Spielen für Kinder, der mit verschiedenen Einrichtungen bzw. Geräten ausgestattet sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0fee8b-9fd0-46db-ab10-ad6e1cc2107d",
                                                "sense_id": "abd2c0f7-0898-3e8c-b772-c676962f91f9",
                                                "text": "Auf dem Spielplatz herrschte ein munteres Treiben."
                                            },
                                            {
                                                "example_id": "b520f82a-7802-4d49-b16b-287286c0fec5",
                                                "sense_id": "abd2c0f7-0898-3e8c-b772-c676962f91f9",
                                                "text": "„Zukünftig wollte ich einen großen Bogen um den Spielplatz machen und Karussells wie das da meiden wie die Pest .“"
                                            },
                                            {
                                                "example_id": "441bfac2-4aae-4fe4-a727-0d6b383cdd63",
                                                "sense_id": "abd2c0f7-0898-3e8c-b772-c676962f91f9",
                                                "text": "„An Samstagvormittagen kann man auf gut besuchten Spielplätzen erleben, wie das neue Rollenverständnis in Zeiten der Emanzipation aussieht.“"
                                            },
                                            {
                                                "example_id": "bf7f0cc6-d99f-45b8-9395-de60c8bc9808",
                                                "sense_id": "abd2c0f7-0898-3e8c-b772-c676962f91f9",
                                                "text": "„Die Spielplätze waren nur staubige und steinige Rechtecke, und über der gesamten ausgedehnten Siedlung hing der eisige Hauch von Trostlosigkeit.“"
                                            },
                                            {
                                                "example_id": "6ca39009-ed0b-42b4-aac1-236628f845b8",
                                                "sense_id": "abd2c0f7-0898-3e8c-b772-c676962f91f9",
                                                "text": "„Sie wollten nicht auf den Spielplatz.“"
                                            },
                                            {
                                                "example_id": "084d9f2b-c82c-4f21-8668-3308b78ebb33",
                                                "sense_id": "abd2c0f7-0898-3e8c-b772-c676962f91f9",
                                                "text": "„Auf einem Spielplatz mit obligatorischem Sandkasten und TÜV-geprüften Rutschen, Schaukeln, Klettergerüsten und Wipptieren kann man wohl spielen, aber die Möglichkeiten, etwas spielerisch zu erkunden, zu entdecken und zu erproben, sind gering.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "acd1bea4-3a98-34ab-8012-cf1e2da67cfa",
                                        "entry_id": "1eaf7469-c7d9-3480-980d-18472fd26ba0",
                                        "glosses": [
                                            "Ort, an dem mit Würfeln oder Karten gespielt wird"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ce733f-fb4d-452f-bef1-d69a44667dca",
                                                "sense_id": "acd1bea4-3a98-34ab-8012-cf1e2da67cfa",
                                                "text": "„so bald der sontag herbey kommen, unnd die mittags mahlzeit geschehen ist, finden sich die jungen gesellen auff dem spielplatz, was sie die gantze wochen erworben oder zusammen gestoppelt haben, das musz alles zum spiel gedeyen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c647c6c7-10e2-3a9d-823d-e870c89f3813",
                                        "entry_id": "1eaf7469-c7d9-3480-980d-18472fd26ba0",
                                        "glosses": [
                                            "Ort im Freien, an dem Theaterstücke aufgeführt werden"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cd77798-78b4-43e4-bd82-8d5e99effaa9",
                                                "sense_id": "c647c6c7-10e2-3a9d-823d-e870c89f3813",
                                                "text": "Was gibt es heute auf dem Spielplatz zu sehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72c23ad5-aeaf-41be-9682-6b3a12bfbc5d",
                        "source_entry_id": "c89b1855-3e2b-3300-a1b9-7abfbb8a883a",
                        "source_sense_id": "21a555e1-b2ad-3c53-be38-d98ea508fc99",
                        "source_sense_description": "een omheinde plek grond met speelobjecten voor kinderen",
                        "target_lang_word": "playground",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playground",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "A large open space for children to play in, usually having dedicated play equipment (such as swings and slides)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89c6887-7417-4180-b43b-1840ffb6711c",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "The kids have to go to the playground during recess, no matter the weather."
                                            },
                                            {
                                                "example_id": "81f8f73c-9c8b-458b-9b0a-c315e4067230",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "The local council have set up a new playground, equipped with slides, swings, and a climbing wall."
                                            },
                                            {
                                                "example_id": "9296211f-5b27-42b7-9f0a-0b28bf2f263d",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "Any physical or metaphysical space in which a person or organization has free rein to do as they please."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bf7cf8e-9a25-470f-9187-ac1beff6a217",
                                                "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                                "text": "The exclusive tropical island was a millionaire's playground."
                                            },
                                            {
                                                "example_id": "8271b7cf-89c4-4a19-9571-e910c334a078",
                                                "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                                "text": "Kjelsås (six miles) marks the end of the suburbs, and the line immediately plunges into Nordmarka. This vast untamed area of forest and mountain (much of it over 2,000 ft. above sea level), interspersed with innumerable lakes, large and small, is known as Oslo's playground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37c8473-d51b-3c12-aa38-3dc2ed5145b9",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "A sandbox for testing calls to an application programming interface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
