                    {
                        "translation_id": "3d7a21d6-57d5-4754-be5a-1bdbea13e48c",
                        "source_entry_id": "dcf3d652-0347-3e03-9611-cc0ea52e981b",
                        "source_sense_description": "martial arts instructor",
                        "target_lang_word": "선생님",
                        "target_lang_code": "ko",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "선생님",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "80e0fcc2-5c4e-3789-905f-9517cbf5e6d8",
                                        "entry_id": "9dc9ed1c-0fc1-3c1d-a2bd-58458ec34d0d",
                                        "glosses": [
                                            "학생을 가르치는 사람인 '선생'을 높여 이르는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db801ed-4e3d-48c5-b1c3-9ef5ad43282e",
                                                "sense_id": "80e0fcc2-5c4e-3789-905f-9517cbf5e6d8",
                                                "text": "저 분이 새로 오신 국어 선생님이다."
                                            },
                                            {
                                                "example_id": "a7c88561-1c10-4c71-9d39-bf68d914e293",
                                                "sense_id": "80e0fcc2-5c4e-3789-905f-9517cbf5e6d8",
                                                "text": "교장 선생님께서 강연을 하셨다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d0d9e42-bf79-3057-911d-f5552cc9976f",
                                        "entry_id": "9dc9ed1c-0fc1-3c1d-a2bd-58458ec34d0d",
                                        "glosses": [
                                            "남의 성이나 직업이나 직책 뒤에 붙여 그 사람을 높여 이르는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bde4085f-750b-43d2-bed3-ff87c5907049",
                                                "sense_id": "3d0d9e42-bf79-3057-911d-f5552cc9976f",
                                                "text": "간호사 선생님은 매우 친절하시다."
                                            },
                                            {
                                                "example_id": "7d7893a4-c496-4610-ab0b-f41360b0c22c",
                                                "sense_id": "3d0d9e42-bf79-3057-911d-f5552cc9976f",
                                                "text": "변호사 선생님, 이 사건에서 승소할 수 있을까요?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9a9c025-801a-4fca-8382-728b2ba7fbaf",
                        "source_entry_id": "dcf3d652-0347-3e03-9611-cc0ea52e981b",
