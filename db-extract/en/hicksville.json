            {
                "entry_id": "67bd7f35-6887-3cf6-95c2-5c412f9fb42e",
                "word": "hicksville",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4391bd6d-433e-35ed-b688-7ca68c4561ab",
                        "entry_id": "67bd7f35-6887-3cf6-95c2-5c412f9fb42e",
                        "glosses": [
                            "kleiner, unbedeutender Ort, Kaff, Provinznest, Nest"
                        ],
                        "tags": [],
