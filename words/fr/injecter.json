                    "sense_id": "5701db7f-4ce1-3e20-b531-b98a5fb208c5",
                    "sense_definition": "Introduire un liquide ou une substance médicamenteuse dans l'organisme à l'aide d'une seringue ou d'un dispositif similaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière va lui <w>injecter</w> une dose de vaccin dans le bras."
                        },
                        {
                            "text": "Le médecin a décidé d'<w>injecter</w> un calmant pour soulager rapidement la douleur du patient."
                        }
                    ],
                    "common_phrases": [
