                "senses": [
                    {
                        "sense_id": "f05ad28f-f570-3472-8912-79c231497718",
                        "entry_id": "927c34ef-d931-3957-ae06-50eca6f9ecc8",
                        "glosses": [
                            "Pièce de bois qui arrête l’eau en fermant le bief d’un moulin, et qu’on lève au contraire pour lancer la machine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "61213317-284e-4c61-a6a1-ab03a1944abb",
                                "sense_id": "f05ad28f-f570-3472-8912-79c231497718",
                                "text": "Lorsque le lançoir est abaissé, le moulin s’arrête."
                            },
                            {
                                "example_id": "9be05e60-d8c1-4753-87b0-f113280d265e",
                                "sense_id": "f05ad28f-f570-3472-8912-79c231497718",
                                "text": "… ses lançoirs ne permettent pas le passage des eaux en période de crue."
                            }
                        ]
                    },
                    {
                        "sense_id": "030b3cda-7385-3fa7-85cc-18a9f53315bb",
                        "entry_id": "927c34ef-d931-3957-ae06-50eca6f9ecc8",
                        "glosses": [
                            "Piste utilisée pour lancer des bois."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e46979b3-f0c4-46c5-9204-a8c1b82dad0a",
                                "sense_id": "030b3cda-7385-3fa7-85cc-18a9f53315bb",
                                "text": "La scierie du Lançoir, dans le défilé de Straiture (88), tire son nom de la pente où l’on faisait glisser les grumes pour l’approvisionner."
                            },
                            {
                                "example_id": "fe6f2ce0-ad4d-4486-b3a6-22da506d4f73",
                                "sense_id": "030b3cda-7385-3fa7-85cc-18a9f53315bb",
                                "text": "Afin de descendre les billes de bois de la Montagne de Véran jusqu’à la vallée, un passage fut taillé au début du 20e siècle dans la falaise dominant la gorge vertigineuse en haut de la cascade d’Arpenaz. Appelé \"Le Lançoir\" il fut vite abandonné car les troncs arrivaient très abîmés."
                            }
                        ]
                    },
                    {
                        "sense_id": "8db9536a-dc47-3bd9-a70f-dad20fa60a13",
                        "entry_id": "927c34ef-d931-3957-ae06-50eca6f9ecc8",
                        "glosses": [
                            "Plate-forme et rampe d’élancement pour le départ dans les sports de glisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6a8311-2de7-478d-bf60-1c591f80729c",
                                "sense_id": "8db9536a-dc47-3bd9-a70f-dad20fa60a13",
                                "text": "J'ai eu du mal à appréhender cette neige humide. Le lançoir n'était pas évident, il fallait bien négocier le S de Kernen et j'ai été un peu gourmand."
                            }
                        ]
                    }
