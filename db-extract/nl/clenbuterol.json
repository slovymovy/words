                        "examples": [
                            {
                                "example_id": "a0f0d85d-52f4-4ec9-a635-94e1fb3bb71b",
                                "sense_id": "7dd91f9d-e2b7-3267-916d-256b8347aebb",
                                "text": "In 2011 werden vijf spelers uit de CONCACAF Gold Cup-ploeg van Mexico genomen, nadat die positief hadden getest op clenbuterol, een verboden middel dat in de veeteelt illegaal gebruikt wordt om runderen versneld te laten groeien."
                            },
                            {
                                "example_id": "3c269055-557f-4d59-af28-1bfa56a63e11",
                                "sense_id": "7dd91f9d-e2b7-3267-916d-256b8347aebb",
                                "text": "De Australische renner Michael Rogers mag weer aan wedstrijden deelnemen. De 34-jarige Tinkoff-Saxo-renner testte in oktober positief op clenbuterol, maar heeft de UCI en het WADA ervan kunnen overtuigen dat hem geen blaam treft."
                            },
                            {
                                "example_id": "eac5dab5-1836-4f5f-8d6b-af4f02eee2b4",
                                "sense_id": "7dd91f9d-e2b7-3267-916d-256b8347aebb",
                                "text": "Colo testte in het voorjaar positief op clenbuterol in de Ronde van Mexico. Voor een eerste dopingvergrijp staat normaal twee jaar schorsing."
                            }
                        ]
                    }
