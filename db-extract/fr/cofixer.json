                                        "glosses": [
                                            "An affix consisting of a prefix and suffix attached simultaneously to the root."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56256b99-67e8-4cc2-b671-2e99d3cd1913",
                                                "sense_id": "9f2f671e-1fb8-39fc-ae0c-2b1f08909d96",
                                                "text": "As is demonstrated by m-as-ku, tens are derived from the confix m- ... -hu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a9bf16-5a71-36a4-9af3-4067c8d0b260",
                                        "entry_id": "aa7606d3-9342-3ed2-b79f-d7b8e12859bb",
                                        "glosses": [
                                            "An affix which is not divided, and which does not divide a root: thus, a prefix, suffix, or interfix."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
