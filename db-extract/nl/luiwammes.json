                ],
                "senses": [
                    {
                        "sense_id": "2cd5c098-16ef-3f65-be18-b4d9419dfef5",
                        "entry_id": "fe75b2cb-5803-3500-961d-e3e1ecb7b1f2",
                        "glosses": [
                            "iemand die erg lui is"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ddde15a9-152a-46f3-901d-a96b33d6c62f",
                                "sense_id": "2cd5c098-16ef-3f65-be18-b4d9419dfef5",
                                "text": "Wat een luiwammes ben ik vandaag, zeg."
                            },
                            {
                                "example_id": "8a84917c-3388-4946-a691-277724d6fad1",
                                "sense_id": "2cd5c098-16ef-3f65-be18-b4d9419dfef5",
                                "text": "Een luieraar en een luiwammes ook wel diran genoemd verschillen evenveel van elkaar als een lekkerbek en een veelvraat. Keek naar het verheven genot van parende libellen. Hoorde zelfs hun vleugels, een extatisch geluid, als flapperend papier tussen de spaken van een fiets. Tuurde naar een hazelworm die rond de wortels waar ik lag een miniatuur-Amazone verkende. Stilte? Niet helemaal, nee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e4fb705-8a78-44b2-ab2b-5fbb0ba047a4",
                        "source_entry_id": "fe75b2cb-5803-3500-961d-e3e1ecb7b1f2",
                        "source_sense_id": "2cd5c098-16ef-3f65-be18-b4d9419dfef5",
                        "source_sense_description": "iemand die erg lui is",
                        "target_lang_word": "Faulpelz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faulpelz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                        "entry_id": "e4b9f6a3-daaf-350b-9687-26414efe40e9",
                                        "glosses": [
                                            "Person, die träge / faul ist und keine Lust hat, zu arbeiten / sich anzustrengen"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc89fdc6-3e7b-4f7c-a2aa-14a43d18b963",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "Unser Sohn ist ein kleiner Faulpelz."
                                            },
                                            {
                                                "example_id": "4df2924b-e556-4746-888b-a0b2cc56fda8",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "„Wenn du weiter so ein Faulpelz bist wirst du die Schule nie schaffen!“"
                                            },
                                            {
                                                "example_id": "1c59cd71-1b4c-4afd-9c74-3cde9294b3ff",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "[André Rauch:] „Als Gymnasiast war ich ein Faulpelz.“"
                                            },
                                            {
                                                "example_id": "031a54ac-ba7c-475e-8651-ee1fd4837b30",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "[André Rauch:] „Wenn Sie mir heute sagen, du bist faul, Sie sind faul, dann sage ich mir, er behandelt mich als Faulpelz, weil ich nicht tue, was er von mir will. Jemand der faul ist, nimmt sich seine Freiheit.“"
                                            },
                                            {
                                                "example_id": "47f31c3f-7c80-4013-97da-bee8321055fb",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "„Ich war nie ein Nationalist“, versicherte er mir glaubhaft, „doch ich lasse es mir nicht gefallen, dass ich als Andalusier zum Faulpelz abgestempelt werde, der sich angeblich den ganzen Tag sonnt und das katalanische Geld versäuft.“"
                                            },
                                            {
                                                "example_id": "88f65ee7-973a-438f-be07-d6462eacbc62",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "Wer als Salafist auf sich hält, trägt Rauschebart. Wer zu faul zum Rasieren ist, auch. Nur verbinden die meisten mit Rauschebartträgern derzeit eher Islamisten als Faulpelze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
