                ],
                "senses": [
                    {
                        "sense_id": "9b04969b-e607-30bb-a04b-8e5311a4efc4",
                        "entry_id": "0b91233f-68b0-34da-a12f-9329a928b85d",
                        "glosses": [
                            "persönliche schriftliche Mitteilung, die von Hand (und nicht mithilfe einer Maschine) verfasst wurde"
                        ],
                        "tags": [
                            "Nomen acti"
                        ],
                        "examples": [
                            {
                                "example_id": "64a866dd-d4e0-479c-8658-c7ad068dece1",
                                "sense_id": "9b04969b-e607-30bb-a04b-8e5311a4efc4",
                                "text": "„In einem Handschreiben mahnte daraufhin Maximilian seine Tochter, sie möge dafür Sorge tragen, dass diese Rückstände ausgeglichen würden.“"
                            },
                            {
                                "example_id": "8bdd20ed-4315-4ddf-ba1f-b501a06f8534",
                                "sense_id": "9b04969b-e607-30bb-a04b-8e5311a4efc4",
                                "text": "„Nachdem beide Männer sich gesetzt hatten, übergab Opitz das Handschreiben des Königs. Zierenberg brach das Siegel auf, überflog den in deutscher Sprache geschriebenen Brief und blickte erstaunt sein Gegenüber an.“"
                            },
                            {
                                "example_id": "d7759010-3d36-45ec-a7ff-bf95b5e6a70a",
                                "sense_id": "9b04969b-e607-30bb-a04b-8e5311a4efc4",
                                "text": "„Er versicherte sowohl den Oratoren wie den spanischen Bischöfen, die ihn besuchten, daß die Kirchenreform dem Papst wirklich am Herzen liege, wie der Papst in seinem Handschreiben an Philipp II. beteuerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "baef0bfe-0b1c-3109-8eb9-4710b279ab6b",
                        "entry_id": "0b91233f-68b0-34da-a12f-9329a928b85d",
                        "glosses": [
                            "Verfassen eines Textes mit der Hand (und nicht mithilfe einer Maschine)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "4ec66f54-5bb5-4508-b873-8a2adecff722",
                                "sense_id": "baef0bfe-0b1c-3109-8eb9-4710b279ab6b",
                                "text": "„Beim Handschreiben werden Spuren im Gehirn entwickelt, die abgerufen werden können, wenn es um die Wiedererkennung von Buchstaben geht.“"
                            },
                            {
                                "example_id": "e9b5b706-927a-4e7e-82f1-b15339afbc86",
                                "sense_id": "baef0bfe-0b1c-3109-8eb9-4710b279ab6b",
                                "text": "„20 Prozent der Lehrpersonen beobachten, dass Probleme mit dem Handschreiben Rechtschreibschwierigkeiten auslösen können. Die Schule muss also dringend auf die zunehmenden Probleme mit der Handschrift reagieren.“"
                            },
                            {
                                "example_id": "5c86feab-ee68-4f85-a087-ca8d0181d4bd",
                                "sense_id": "baef0bfe-0b1c-3109-8eb9-4710b279ab6b",
                                "text": "„Lehrkräfte, insbesondere diejenigen an Grundschulen, die hier von Interesse sind, sehen die Ursachen für Probleme beim Handschreiben in erster Linie in fehlenden feinmotorischen Fähigkeiten der Kinder, verbunden mit beziehungsweise verursacht durch zu wenig Übung zu Hause und zu hohen Medienkonsum[.]“"
                            },
                            {
                                "example_id": "ffb9fc5a-3557-4418-b1a1-330b7ed72cc4",
                                "sense_id": "baef0bfe-0b1c-3109-8eb9-4710b279ab6b",
                                "text": "„Beim Handschreiben sind zwölf Hirnareale aktiv […], und es arbeiten mehr als dreißig Muskeln und siebzehn Gelenke zusammen […].“"
                            },
                            {
                                "example_id": "b7c3d0b6-e4b9-4183-9824-872fb4061751",
                                "sense_id": "baef0bfe-0b1c-3109-8eb9-4710b279ab6b",
                                "text": "„Sie gestatten auch Dinge per Computer zu schreiben, wenn der Schüler mit dem Handschreiben Probleme hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
