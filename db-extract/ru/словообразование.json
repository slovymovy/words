                        ]
                    },
                    {
                        "translation_id": "c5c063ac-9195-432a-90de-ad0faa51629b",
                        "source_entry_id": "5591f31f-fb7e-3ecd-817d-0bb00f6b9949",
                        "source_sense_description": "система образования слов",
                        "target_lang_word": "Wortbildung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortbildung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "754cde12-870e-3764-a8e4-7667bd372cee",
                                        "entry_id": "885b5f7e-e090-3b14-ba10-11b6d396af0b",
                                        "glosses": [
                                            "Lehre vom Aufbau oder der Bildung der Wörter aus lexikalischen Morphemen und Wortbildungsmorphemen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e790e5ef-9a90-425d-8efd-32f7713f2863",
                                                "sense_id": "754cde12-870e-3764-a8e4-7667bd372cee",
                                                "text": "Die Wortbildung als Teilbereich der Morphologie, Morphemik untersucht die morphologische Struktur der Wörter."
                                            },
                                            {
                                                "example_id": "6d1f953c-9159-4c4c-b285-0f0526d5b132",
                                                "sense_id": "754cde12-870e-3764-a8e4-7667bd372cee",
                                                "text": "„Eine gewisse Zwischenstellung zwischen Lexik und Grammatik nimmt die Wortbildung ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20b5df89-4993-34ce-a7b4-77060811f441",
                                        "entry_id": "885b5f7e-e090-3b14-ba10-11b6d396af0b",
                                        "glosses": [
                                            "Bildung neuer Wörter auf der Grundlage von lexikalischen Morphemen und Wortbildungsmorphemen"
                                        ],
                                        "tags": [
                                            "mit Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae847a1-5fec-4424-b323-3ba47b2747b2",
                                                "sense_id": "20b5df89-4993-34ce-a7b4-77060811f441",
                                                "text": "Die Wortbildung ist ein Verfahren zur Bildung neuer Wörter."
                                            },
                                            {
                                                "example_id": "c550bfb9-1511-43eb-b377-817a2ed7b023",
                                                "sense_id": "20b5df89-4993-34ce-a7b4-77060811f441",
                                                "text": "„Von der Wortschöpfung ist die Wortbildung zu unterscheiden; denn sie benutzt vorhandene sprachliche Mittel.“"
                                            },
                                            {
                                                "example_id": "7d1092b2-7300-40d9-b2b4-444a84c8283c",
                                                "sense_id": "20b5df89-4993-34ce-a7b4-77060811f441",
                                                "text": "„Quantitative Erweiterung und qualitativer Ausbau der Gegenwartssprache vollziehen sich weitgehend mit Hilfe von Wortbildung und Wortbildungsmitteln.“"
                                            },
                                            {
                                                "example_id": "06c605d7-169c-4cca-9099-88a910039fb5",
                                                "sense_id": "20b5df89-4993-34ce-a7b4-77060811f441",
                                                "text": "„Da gibt es dann auch viele Wortbildungen.“"
                                            },
                                            {
                                                "example_id": "3b31ac9e-6646-4626-bafd-9b378632d94b",
                                                "sense_id": "20b5df89-4993-34ce-a7b4-77060811f441",
                                                "text": "„Der weitaus größte Teil des Zuwachses entfällt auf Wortbildungen aus bestehenden Wörtern - also auf Ableitungen und Komposita.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "37773c23-bfe4-3d5f-ac18-745b1071fd73",
                                        "entry_id": "885b5f7e-e090-3b14-ba10-11b6d396af0b",
                                        "glosses": [
                                            "morphologische Struktur der Wörter aus lexikalischen Morphemen und Wortbildungsmorphemen"
                                        ],
                                        "tags": [
                                            "mit Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8420823-360f-4e67-a692-2fba730f98b0",
                                                "sense_id": "37773c23-bfe4-3d5f-ac18-745b1071fd73",
                                                "text": "Dem Wort \"Sprachbuch\" liegt eine Komposition als Wortbildung zugrunde."
                                            },
                                            {
                                                "example_id": "ba8056f2-c7f9-40dd-aa93-040ef23ebc29",
                                                "sense_id": "37773c23-bfe4-3d5f-ac18-745b1071fd73",
                                                "text": "„Bei manchen von ihnen gilt eben auch, dass sie wegen ihrer durchsichtigen Wortbildung Hinweise auf ihre Bedeutung enthalten und deswegen eigentlich nicht unverstanden bleiben oder missverstanden werden müssten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
