{
    "word_family": [
        "companionship",
        "companionable",
        "companionway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a80693dd-f362-377b-b41a-40c3c79a2992",
                    "sense_definition": "A person or animal with whom one spends a lot of time or with whom one travels.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_partner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His dog has been his <w>companion</w> for the last five years.",
                            "target_lang_translations": {
                                "ru": "Его пес был его верным <w>спутником</w> последние пять лет."
                            }
                        },
                        {
                            "text": "She was a constant <w>companion</w> to her elderly grandmother during the long winter months.",
                            "target_lang_translations": {
                                "ru": "Она была постоянным <w>компаньоном</w> своей пожилой бабушки в долгие зимние месяцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "associate",
                        "comrade",
                        "friend"
                    ],
                    "antonyms": [
                        "stranger",
                        "enemy"
                    ],
                    "common_phrases": [
                        "constant companion",
                        "traveling companion",
                        "faithful companion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, с которым проводят много времени или путешествуют."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компаньон",
                                "target_lang_sense_clarification": "тот, кто составляет компанию"
                            },
                            {
                                "target_lang_word": "спутник",
                                "target_lang_sense_clarification": "человек, сопровождающий в пути или по жизни"
                            },
                            {
                                "target_lang_word": "товарищ",
                                "target_lang_sense_clarification": "друг или партнер по деятельности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b83ec22-6e0b-3638-acb1-81483d268f58",
                    "sense_definition": "A book, guide, or other item designed to be used with and provide extra information about another thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "associated_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>companion</w> guide gives an in-depth analysis of this particular translation.",
                            "target_lang_translations": {
                                "ru": "Вспомогательный <w>справочник</w> дает глубокий анализ этого конкретного перевода."
                            }
                        },
                        {
                            "text": "This textbook comes with a digital <w>companion</w> that includes interactive quizzes and videos.",
                            "target_lang_translations": {
                                "ru": "К этому учебнику прилагается цифровое <w>дополнение</w>, включающее интерактивные тесты и видео."
                            }
                        }
                    ],
                    "synonyms": [
                        "supplement",
                        "handbook",
                        "guide"
                    ],
                    "common_phrases": [
                        "companion guide",
                        "companion volume",
                        "companion website"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга, руководство или другой предмет, предназначенный для использования вместе с чем-то другим и предоставляющий дополнительную информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справочник",
                                "target_lang_sense_clarification": "вспомогательное руководство"
                            },
                            {
                                "target_lang_word": "сопутствующее издание",
                                "target_lang_sense_clarification": "дополнение к основной книге"
                            },
                            {
                                "target_lang_word": "приложение",
                                "target_lang_sense_clarification": "дополнительный материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "038b3911-3cc4-367d-a831-25d656c68b92",
                    "sense_definition": "A person employed to live with or travel with another person, often providing assistance or company.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_partner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a job as a paid <w>companion</w> for a wealthy woman living in the countryside.",
                            "target_lang_translations": {
                                "ru": "Она устроилась на работу в качестве платной <w>компаньонки</w> к богатой женщине, живущей в сельской местности."
                            }
                        },
                        {
                            "text": "In the nineteenth century, many young women worked as a lady's <w>companion</w>.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке многие молодые женщины работали в качестве <w>компаньонок</w> при знатных дамах."
                            }
                        }
                    ],
                    "synonyms": [
                        "attendant",
                        "chaperone"
                    ],
                    "common_phrases": [
                        "paid companion",
                        "lady's companion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нанятый для проживания или путешествия с другим лицом, часто для оказания помощи или общения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компаньонка",
                                "target_lang_sense_clarification": "женщина, нанятая для сопровождения (истор.)"
                            },
                            {
                                "target_lang_word": "сопровождающее лицо",
                                "target_lang_sense_clarification": "человек, оказывающий помощь в поездке"
                            },
                            {
                                "target_lang_word": "сиделка",
                                "target_lang_sense_clarification": "если основной целью является уход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6be386d-258e-325a-9ad7-7c28ca4ad8f3",
                    "sense_definition": "One of a pair of things that are intended to be used together or that match each other.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "associated_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found one earring, but I cannot find its <w>companion</w> anywhere in the jewelry box.",
                            "target_lang_translations": {
                                "ru": "Я нашла одну сережку, но нигде в шкатулке не могу найти вторую из <w>пары</w>."
                            }
                        },
                        {
                            "text": "This armchair has a matching <w>companion</w> that completes the set for the living room.",
                            "target_lang_translations": {
                                "ru": "У этого кресла есть подходящая <w>пара</w>, которая завершает гарнитур для гостиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "mate",
                        "counterpart",
                        "match"
                    ],
                    "common_phrases": [
                        "matching companion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из пары предметов, которые предназначены для совместного использования или подходят друг к другу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пара",
                                "target_lang_sense_clarification": "второй предмет из комплекта"
                            },
                            {
                                "target_lang_word": "парная вещь",
                                "target_lang_sense_clarification": "соответствующий предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b0d0e2-caaf-3e90-aa60-51734b8958b1",
                    "sense_definition": "A star or other celestial body that orbits or is associated with another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright star has a faint <w>companion</w> star that can only be seen with a powerful telescope.",
                            "target_lang_translations": {
                                "ru": "У яркой звезды есть тусклая звезда-<w>спутник</w>, которую можно увидеть только в мощный телескоп."
                            }
                        },
                        {
                            "text": "Astronomers observed the gravitational pull of the <w>companion</w> on the primary star.",
                            "target_lang_translations": {
                                "ru": "Астрономы наблюдали гравитационное притяжение <w>спутника</w> к главной звезде."
                            }
                        }
                    ],
                    "synonyms": [
                        "satellite"
                    ],
                    "common_phrases": [
                        "companion star",
                        "binary companion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звезда или другое небесное тело, которое вращается вокруг другого или связано с ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спутник",
                                "target_lang_sense_clarification": "небесное тело на орбите"
                            },
                            {
                                "target_lang_word": "компонент",
                                "target_lang_sense_clarification": "составляющая двойной звездной системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44297167-bd4c-33e1-8487-b42e3217d2cb",
                    "sense_definition": "A cover or structure over a hatchway on a ship's deck, or the stairs leading below.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor hurried down the <w>companion</w> to reach the cabins before the storm hit.",
                            "target_lang_translations": {
                                "ru": "Матрос поспешил вниз по <w>трапу</w>, чтобы добраться до кают до начала шторма."
                            }
                        },
                        {
                            "text": "Rainwater leaked through the wooden <w>companion</w> during the heavy gale.",
                            "target_lang_translations": {
                                "ru": "Во время сильного шторма дождевая вода просочилась через деревянный <w>люк</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крышка или конструкция над люком на палубе корабля, или лестница, ведущая вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "камбузный люк",
                                "target_lang_sense_clarification": "вход в помещения"
                            },
                            {
                                "target_lang_word": "сходный тамбур",
                                "target_lang_sense_clarification": "защитное сооружение над люком"
                            },
                            {
                                "target_lang_word": "трап",
                                "target_lang_sense_clarification": "лестница на судне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a05cf8df-87ca-3166-9dcc-c37156e4a7de",
                    "sense_definition": "A member of the lowest rank of certain orders of knighthood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "honorific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was appointed a <w>companion</w> of the Order of the Bath for his military service.",
                            "target_lang_translations": {
                                "ru": "За военную службу он был назначен <w>кавалером</w> ордена Бани."
                            }
                        },
                        {
                            "text": "The title of <w>companion</w> is a prestigious honor bestowed by the monarch.",
                            "target_lang_translations": {
                                "ru": "Титул <w>компаньона</w> — это престижная награда, даруемая монархом."
                            }
                        }
                    ],
                    "synonyms": [
                        "member"
                    ],
                    "common_phrases": [
                        "companion of the bath"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член низшего ранга определенных рыцарских орденов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кавалер",
                                "target_lang_sense_clarification": "младшая степень ордена"
                            },
                            {
                                "target_lang_word": "компаньон",
                                "target_lang_sense_clarification": "официальное название ранга"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cca185a-a16e-336c-886b-a81e9bcf0378",
                    "sense_definition": "To go somewhere with someone as a companion; to accompany.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accompanying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly man was <w>companioned</w> by his faithful dog on every walk.",
                            "target_lang_translations": {
                                "ru": "Пожилого мужчину на каждой прогулке <w>сопровождал</w> его верный пес."
                            }
                        },
                        {
                            "text": "She felt safer when she was <w>companioned</w> through the dark woods by her brother.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя в большей безопасности, когда брат <w>сопровождал</w> ее через темный лес."
                            }
                        }
                    ],
                    "synonyms": [
                        "accompany",
                        "escort",
                        "attend"
                    ],
                    "antonyms": [
                        "abandon",
                        "leave"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправляться куда-либо с кем-то в качестве спутника; сопровождать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопровождать",
                                "target_lang_sense_clarification": "идти вместе с кем-то"
                            },
                            {
                                "target_lang_word": "сопутствовать",
                                "target_lang_sense_clarification": "быть рядом (книжн.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}