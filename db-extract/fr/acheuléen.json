                ],
                "senses": [
                    {
                        "sense_id": "20563a12-7d31-3375-9f8f-7b7e86cc8438",
                        "entry_id": "727190a3-960c-3bbc-a245-82831b3e94be",
                        "glosses": [
                            "Relatif à l’Acheuléen, période du Paléolithique inférieur et à l’industrie lithique caractéristique de cette période."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741c2d6c-f527-476e-963d-faac123218d3",
                                "sense_id": "20563a12-7d31-3375-9f8f-7b7e86cc8438",
                                "text": "Des silex taillés datant de l'époque acheuléenne."
                            },
                            {
                                "example_id": "32309ac5-ccda-4061-98db-41ef4d59f930",
                                "sense_id": "20563a12-7d31-3375-9f8f-7b7e86cc8438",
                                "text": "C'est un autre témoignage de la pénétration de l'acheuléen récent vers l'intérieur du pays."
                            },
                            {
                                "example_id": "b3a30cdb-919d-4aba-bd05-3beed2fe81c8",
                                "sense_id": "20563a12-7d31-3375-9f8f-7b7e86cc8438",
                                "text": "Les premiers hominidés - vraisemblablement des Homo erectus - ayant migré hors d'Afrique maîtrisaient-ils la technique acheuléenne ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "340ac883-f6a0-4fe4-8efc-a4ec56953d09",
                        "source_entry_id": "727190a3-960c-3bbc-a245-82831b3e94be",
                        "source_sense_id": "20563a12-7d31-3375-9f8f-7b7e86cc8438",
                        "target_lang_word": "Acheulean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Acheulean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "443dddec-b1dc-36ab-97c9-c70b4c74ac76",
                                        "entry_id": "988812f3-6b0c-3fc6-9d9c-28f2f42b1407",
                                        "glosses": [
                                            "Of or pertaining to a lower Paleolithic period characterized by the presence of flaked bifacial hand axes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f61c54-f86f-47ac-a00a-ce211d48a381",
                                                "sense_id": "443dddec-b1dc-36ab-97c9-c70b4c74ac76",
                                                "text": "Assuming that language ability extends back to the hominids, we see a slow process of cultural development over millions of years, and then in the Acheulean period of Homo erectus, about three hundred thousand years ago, we find the first engraved tool."
                                            },
                                            {
                                                "example_id": "edc8ca2d-f917-4923-957c-ec1ab506cd3c",
                                                "sense_id": "443dddec-b1dc-36ab-97c9-c70b4c74ac76",
                                                "text": "When early modern humans – the ones who would eventually become us – started to move out of Africa something over a hundred thousand years ago, Acheulean tools were the technology of choice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Acheulean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf3a184-326e-3392-bf2d-fb6942cf5f8c",
                                        "entry_id": "7b613a73-312f-3124-af31-700f2ff1cf84",
                                        "glosses": [
                                            "A lower Paleolithic period characterized by the presence of flaked bifacial hand axes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "aa1bfeda-c9d0-311b-8106-056f54f56063",
                "word": "Acheuléen",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "99ccb254-92d5-35dc-8cd7-ed5d35f07cea",
                        "entry_id": "aa1bfeda-c9d0-311b-8106-056f54f56063",
                        "glosses": [
                            "Période du Paléolithique inférieur, industrie lithique caractéristique de cette période."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b151394-d264-48e3-ad14-78585d056867",
                                "sense_id": "99ccb254-92d5-35dc-8cd7-ed5d35f07cea",
                                "text": "En Europe, l’Acheuléen succède au Chelléen (ou Abbevillien) et dure environ de 500 000 à 300 000 ans avant le présent."
                            },
                            {
                                "example_id": "d5609320-13a7-465a-a4ca-7c9d01884a9c",
                                "sense_id": "99ccb254-92d5-35dc-8cd7-ed5d35f07cea",
                                "text": "Les temps immenses de l'Acheuléen sont très inégalement représentés et presque uniquement par des outils et les faunes animales fossilisées. Les restes humains, en effet, n'apparaissent qu'avec l'\" homme de Galilée \", qui a vécu il y a environ 140000 ans et qui a été trouvé en 1925 par F. Turville-Petre, dans la grotte de Zuttiyeh (sur la rive ouest du lac de Tibériade)."
                            }
                        ]
                    }
                ],
