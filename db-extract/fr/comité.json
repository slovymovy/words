        "fr-extract.jsonl": [
            {
                "entry_id": "548f7a74-5322-3862-942e-98bafc0e04d4",
                "word": "comité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fcb6cdfc-46f0-4ba6-ab60-d6fa8b1af28a",
                        "entry_id": "548f7a74-5322-3862-942e-98bafc0e04d4",
                        "tags": [
                            "plural"
                        ],
                        "form": "comités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "390b05b4-0f39-38d6-96ac-716a099bd8dd",
                        "entry_id": "548f7a74-5322-3862-942e-98bafc0e04d4",
                        "glosses": [
                            "Réunion de personnes commises par un groupement (assemblée, société, syndicat, etc.) pour l’examen et la préparation de certaines affaires ou pour assurer la marche de toutes les affaires concernant ce groupement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c29c661-0d44-452e-b9c1-cde73ef02a65",
                                "sense_id": "390b05b4-0f39-38d6-96ac-716a099bd8dd",
                                "text": "La loi de Lynch était fréquemment appliquée ; un homme convaincu de meurtre ou de vol pouvait se voir arrêter, juger, et... pendre, en moins d’un quart d’heure, pour peu qu’un comité de vigilance énergique s’emparât de lui."
                            },
                            {
                                "example_id": "424b3714-3220-40d2-b1a6-1c4fd6ec5a02",
                                "sense_id": "390b05b4-0f39-38d6-96ac-716a099bd8dd",
                                "text": "Les plébiscitaires n'avaient pas d'influence électorale comparable à celle des impérialistes, mais ils possédaient à Paris une organisation assez forte comportant des comités d'arrondissement et de quartier."
                            },
                            {
                                "example_id": "db7a5c97-c0d8-4048-afa6-fe1d7361e24a",
                                "sense_id": "390b05b4-0f39-38d6-96ac-716a099bd8dd",
                                "text": "Il s'agissait de conférences et de parlottes défaitistes, au cours desquelles il était donné lecture de fragments de séances parlementaires en comité secret, considérés comme aptes à démoraliser les auditeurs, et aussi de tracts et de brochures progermaniques."
                            },
                            {
                                "example_id": "664e3f33-b0f4-4897-99f4-bab53a9b1f3c",
                                "sense_id": "390b05b4-0f39-38d6-96ac-716a099bd8dd",
                                "text": "comité électoral, réunion d’électeurs qui s’organisent pour discuter les candidatures et soutenir la lutte des élections."
                            },
                            {
                                "example_id": "56cae059-ec53-48ac-b7d3-25e2f7394382",
                                "sense_id": "390b05b4-0f39-38d6-96ac-716a099bd8dd",
                                "text": "comité de lecture, se dit, en termes de théâtre, d’un comité devant lequel on lit les pièces présentées et qui juge si elles doivent être jouées."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbcfce13-bd61-30ae-a21b-e21f4268bbf3",
                        "entry_id": "548f7a74-5322-3862-942e-98bafc0e04d4",
                        "glosses": [
                            "Organisation sportive de niveau intermédiaire entre les ski-clubs et la Fédération française de ski."
                        ],
                        "tags": [
                            "Ski"
                        ],
                        "examples": [
                            {
                                "example_id": "7c909cc1-5172-4396-bedb-1c8f98ab46d8",
                                "sense_id": "cbcfce13-bd61-30ae-a21b-e21f4268bbf3",
                                "text": "Mais les présences ne sont pas plus nombreuses si bien que sept membres du comité présentent alors leur démission. Après discussion, seuls deux partiront et le ski-club est momentanément sauvé."
                            }
                        ]
                    },
                    {
                        "sense_id": "396ca4a4-35fd-309b-8d91-629f04ba8f1c",
                        "entry_id": "548f7a74-5322-3862-942e-98bafc0e04d4",
                        "glosses": [
                            "Groupe restreint à un petit nombre de personnes entre lesquelles règne ordinairement une certaine familiarité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9fd33010-a556-4619-b178-50ac27208091",
                                "sense_id": "396ca4a4-35fd-309b-8d91-629f04ba8f1c",
                                "text": "[…], le roi Charles IX avait invité à goûter avec lui, en petit comité, Henri de Navarre et le duc de Guise. Puis, la collation terminée, il avait passé avec eux dans sa chambre, […]."
                            },
                            {
                                "example_id": "8641052d-52f8-439b-a2c2-52e89bff8439",
                                "sense_id": "396ca4a4-35fd-309b-8d91-629f04ba8f1c",
                                "text": "Les rouges étaient aux cent coups. Ils s'étaient réunis en comité restreint dans la cuisine du cafetier. Autour de la toile cirée, le bureau de la Libre-Pensée cogitait ferme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e738ca77-8a78-4927-8526-30d09a5f69ba",
                        "source_entry_id": "548f7a74-5322-3862-942e-98bafc0e04d4",
                        "source_sense_description": "réunion, commission",
                        "target_lang_word": "Komitee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Komitee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                        "entry_id": "191274d4-3864-3abd-91e7-673787ad9ff8",
                                        "glosses": [
                                            "leitender Ausschuss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c657fdec-70aa-41b8-a3d1-d5a6911df5b2",
                                                "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                                "text": "Die Untersuchung der Frage wurde dem zuständigen Komitee übertragen."
                                            },
                                            {
                                                "example_id": "79203e24-533f-442a-9896-68d9163b07c2",
                                                "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                                "text": "Wir haben jetzt ein Komitee für die Vorbereitung der 100-Jahr-Feier gebildet."
                                            },
                                            {
                                                "example_id": "0a6491f7-2764-4a51-b49a-7ea33dba19fd",
                                                "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                                "text": "„Das Komitee hielt jedoch nur eine Sitzung ab und verschwand danach von der Bildfläche.“"
                                            },
                                            {
                                                "example_id": "0609d0c7-2dda-4aa7-a5a1-41b45c1d8c13",
                                                "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                                "text": "„Am 8. August aber wurde aus dem Generalfeldmarschall Saltykow, Araktschejew, Wjasmitinow, Lopuchin und Kotschubej ein Komitee gebildet, das sich über die militärische Lage gutachtlich äussern sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e86466e-93f1-4819-a235-25b4dd2d2f3f",
                        "source_entry_id": "548f7a74-5322-3862-942e-98bafc0e04d4",
