                "entry_id": "c8df01af-a6c1-3532-be21-fb85ee08039e",
                "word": "Nebraska",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7a00b507-6728-3fc0-b423-82c50884f486",
                        "entry_id": "c8df01af-a6c1-3532-be21-fb85ee08039e",
                        "glosses": [
                            "A state in the Midwestern region of the United States. Capital: Lincoln. Largest city: Omaha."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69448207-11a7-4fbd-9502-ba8131b7b114",
                                "sense_id": "7a00b507-6728-3fc0-b423-82c50884f486",
                                "text": "Let’s move on to Nebraska, a state you think about so little, you didn’t even realize that’s not Nebraska, this is Nebraska. Come on, it’s your country! That’s not okay!"
                            },
                            {
                                "example_id": "5d52f6e6-0c7f-4215-9252-2b8e47646249",
                                "sense_id": "7a00b507-6728-3fc0-b423-82c50884f486",
                                "text": "The bill, which lawmakers approved in a 211-206 vote, now moves to the Republican-led Senate for consideration. One Republican, Rep. Don Bacon of Nebraska, voted with Democrats Thursday against the measure."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1366810-ba2b-3694-b592-06369de6f448",
                        "entry_id": "c8df01af-a6c1-3532-be21-fb85ee08039e",
                        "glosses": [
                            "A former territory (1854–1867) of the United States, encompassing areas of what is today Nebraska, Wyoming, the Dakotas, Colorado, and Montana. Capital: Omaha."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
