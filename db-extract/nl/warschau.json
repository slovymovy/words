                    {
                        "translation_id": "10492e2f-8ad7-4396-a401-66096afbebbc",
                        "source_entry_id": "fb0bf965-e7b8-3787-af3d-c9a41e5027a3",
                        "source_sense_id": "7395315c-58d0-30b7-822f-954f98119d48",
