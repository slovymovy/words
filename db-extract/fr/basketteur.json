                                        "glosses": [
                                            "Sportler, der das Basketballspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0790497-89b4-4b2a-9e7b-8f35dcd0e875",
                                                "sense_id": "da5ef256-c44e-3b62-8adb-d61a26a87298",
                                                "text": "Nach einer schnellen Drehung konnte der Basketballer den Ball im Korb versenken."
                                            },
                                            {
                                                "example_id": "c2326087-90f8-4f95-9f69-369eae401f39",
                                                "sense_id": "da5ef256-c44e-3b62-8adb-d61a26a87298",
                                                "text": "„Der US-amerikanische Basketballer Zeke Upshaw ist nach einem Zusammenbruch in einer NBA-G-Partie gestorben.“"
                                            },
                                            {
                                                "example_id": "49601ff3-3dbe-4ff4-a231-2d27f001c083",
                                                "sense_id": "da5ef256-c44e-3b62-8adb-d61a26a87298",
                                                "text": "„Trump betonte außerdem, dass er Mike möge – wohl eine Anspielung auf die ewige Diskussion, ob nun LeBron James oder doch Michael Jordan der beste Basketballer der NBA-Geschichte sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
