                ],
                "senses": [
                    {
                        "sense_id": "dc4acccb-89e9-3f06-86ab-62340001564d",
                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                        "glosses": [
                            "A natural philosopher; a scientist."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "20930853-6da9-47e1-811d-19d044b77144",
                                "sense_id": "dc4acccb-89e9-3f06-86ab-62340001564d",
                                "text": "It has also been asserted, by some naturalists, that men do not attain their full growth and strength till thirty; but that women arrive at maturity by twenty."
                            }
                        ]
                    },
                    {
                        "sense_id": "619d5a92-42d9-34cc-8ba2-4094716a172d",
                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                        "glosses": [
                            "A person who believes in or advocates the tenets of philosophical or methodological naturalism."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "accede3c-58a7-383c-a11a-8bdd34ce480a",
                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                        "glosses": [
                            "An expert in natural history or the study of plants and animals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48a0402e-9fbe-472e-a4fe-6f9ddb78568c",
                                "sense_id": "accede3c-58a7-383c-a11a-8bdd34ce480a",
                                "text": "I will leave off all my childish fooleries and diversions, and set about studying with such a rage, that when you come back next year, you may find the tongue I have now in my mouth more forky than that of some serpents mentioned by Pliny the naturalist."
                            }
                        ]
                    },
                    {
                        "sense_id": "b06c82d9-2dac-36cd-a9a2-5fbafb3590e9",
                        "entry_id": "46319659-a053-3f2a-ac7b-5afeb9274c1f",
                        "glosses": [
                            "A creative artist who attempts to faithfully represent nature; an adherent of artistic naturalism."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
