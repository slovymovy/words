                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3abd008-7bf5-49e1-b805-54c3853de2dd",
                                "sense_id": "bcf7a846-4175-3c4b-b640-72da1320d7a1",
                                "text": "„Eine Sekunde später konzentrierte er sich auf die Bauteile der Glock-Pistole - nicht, weil es die beste Waffe war, um sich gegen vier Männer mit Gewehren zu verteidigen, sondern weil sie aus weniger Teilen bestand und sich schneller zusammensetzen ließ.“"
                            },
                            {
                                "example_id": "f1437e8b-4e69-486d-a27b-e5f911abfe1f",
                                "sense_id": "bcf7a846-4175-3c4b-b640-72da1320d7a1",
                                "text": "„Mit zusammengebissenen Zähnen zog CJ die Glock-Pistole, zielte kurz und ...“"
                            },
                            {
                                "example_id": "1e413d76-5483-44c4-935d-338fa7f1e51b",
                                "sense_id": "bcf7a846-4175-3c4b-b640-72da1320d7a1",
                                "text": "„Zwei schnell nacheinander abgegebene Schüsse aus einer Glock-Pistole krachten rechts von Raynor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
