                "senses": [
                    {
                        "sense_id": "80bb1ca1-2ce8-3b1f-9b2f-3c1717973f0b",
                        "entry_id": "fa81f046-e6af-3b50-b308-31b1e05dd469",
                        "glosses": [
                            "Variante orthographique de volatil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "104d4344-84bf-42de-9346-b6bb18b97b53",
                                "sense_id": "80bb1ca1-2ce8-3b1f-9b2f-3c1717973f0b",
                                "text": "Le monde volatile offrait des échantillons très-variés."
                            },
                            {
                                "example_id": "17eb296a-7f3d-4252-bc9c-e731ed895a2f",
                                "sense_id": "80bb1ca1-2ce8-3b1f-9b2f-3c1717973f0b",
                                "text": "Le milieu de la crypto a beaucoup de potentiel, mais il est aussi extrêmement volatile, prévient Florian Sarrano, son cofondateur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
