                        "entry_id": "c7d9d769-5068-33e2-8bfa-00ef1cd76543",
                        "glosses": [
                            "Whining and complaining, often contrived to evoke pity or shirk responsibility."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fc334a9d-bb6e-4ed4-bf41-fe65b0395de4",
                                "sense_id": "79ba8fb7-0046-3155-a157-72f289470474",
                                "text": "Quit your bellyaching and get back to work!"
                            },
                            {
                                "example_id": "86f22959-fda3-456d-abff-ceef145a29b2",
                                "sense_id": "79ba8fb7-0046-3155-a157-72f289470474",
                                "text": "Blessed are the poor, the sick, the crossed in love, for at least other people know what is the matter with them and will listen to their belly-achings with sympathy."
                            }
                        ]
                    }
