                        "entry_id": "b2f88edf-8c11-3958-927b-cf2fea2eea6a",
                        "glosses": [
                            "Characterized by shuddering motions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09d5a8a-0e32-4d2c-b91e-56ef12a40de5",
                                "sense_id": "40cd2f78-e910-321e-ae41-aa70a333e8fc",
                                "text": "Four women dance together, shuffling their feet, arching over one another's bodies and running across the stage before stopping dead with shuddery little recoils of the chest."
                            },
                            {
                                "example_id": "5e4e7b28-7eec-4bcb-ace9-6bf66cda70a6",
                                "sense_id": "40cd2f78-e910-321e-ae41-aa70a333e8fc",
                                "text": "The baby breathes in sharply and then lets out a long, shuddery sigh. I've been holding her for nearly half an hour and suddenly she feels unbearably heavy."
                            }
                        ]
                    },
                    {
                        "sense_id": "17a3642a-1d01-3fd3-98a5-f924eb70d588",
                        "entry_id": "b2f88edf-8c11-3958-927b-cf2fea2eea6a",
                        "glosses": [
                            "Causing one to shudder; horrifying."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47701168-6aae-4dc0-b531-e3d34c353ef2",
                                "sense_id": "17a3642a-1d01-3fd3-98a5-f924eb70d588",
                                "text": "It is rather shuddery, however, to speculate on the terrible assortment of cutting, gouging, jabbing and slashing weapons with which the mutineers are able to equip themselves from the carpenter's shop."
                            }
                        ]
                    }
