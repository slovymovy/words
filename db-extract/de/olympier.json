                        "examples": [
                            {
                                "example_id": "c0ee7ec1-9247-43bf-b961-25837f9ea1d6",
                                "sense_id": "abda7b9e-d10b-34da-9dd5-5be4048b549d",
                                "text": "Hörest du nicht, was sie saget, die lilienarmige Here,\n Die nun eben von Zeus, dem Olympier, wieder zurükkam?",
                                "translation": "Don't you hear, what she says, the lily-armed Here,\n Who just now came back from Zeus, the Olympian?",
                                "english": "Don't you hear, what she says, the lily-armed Here,\n Who just now came back from Zeus, the Olympian?"
                            },
                            {
                                "example_id": "21942ab7-8e4f-42a5-9e26-390a37e3afc5",
                                "sense_id": "abda7b9e-d10b-34da-9dd5-5be4048b549d",
                                "text": "Hörtest du nicht die Rede der lilienarmigen Here,\n Die nun eben von Zeus dem Olympier wieder zurückkam?",
                                "translation": "Didn't you hear the speech of the lily-armed Here,\n Who just now came back from Zeus the Olympian?",
                                "english": "Didn't you hear the speech of the lily-armed Here,\n Who just now came back from Zeus the Olympian?"
                            }
                        ]
                    }
