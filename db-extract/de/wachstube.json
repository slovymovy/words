                "senses": [
                    {
                        "sense_id": "26edf23d-3c6c-3e5d-8256-b80a26cd2c98",
                        "entry_id": "db75f40b-5eb9-3aed-afcc-56cb6ac247fa",
                        "glosses": [
                            "Aufenthaltsraum einer wachhabenden Mannschaft, typischerweise bei Polizei und Militär"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a0beaec-6dd1-4c4c-88f1-6446fa24bd5b",
                                "sense_id": "26edf23d-3c6c-3e5d-8256-b80a26cd2c98",
                                "text": "Die Einrichtung der Wachstube ist sehr dürftig."
                            },
                            {
                                "example_id": "fbb791ac-a019-4929-8630-f0073a8cf369",
                                "sense_id": "26edf23d-3c6c-3e5d-8256-b80a26cd2c98",
                                "text": "„Im Vorraum der Wachstube hatte ein eindrucksvoller Haufen von Knütteln, Äxten und Gewehren gelegen; die Gewehre sorgsam zur Seite geschoben, sie sollten untersucht werden.“"
                            },
                            {
                                "example_id": "0bf61039-5c74-4263-99dc-a7b07abbb982",
                                "sense_id": "26edf23d-3c6c-3e5d-8256-b80a26cd2c98",
                                "text": "„Obwohl bei der geforderten Lohnerhöhung Habba und Sámal die Sprecher der Arbeiter gewesen waren, hatte man nicht sie gegen zehn Uhr abends zum Verhör in die Wachstube gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
