                        "source_entry_id": "61415afa-604f-3ed6-be80-fc6432de5ad7",
                        "source_sense_id": "b969390b-3b47-3140-9995-32c310aea259",
                        "source_sense_description": "Namenkunde, Onomastik, Namenforschung",
                        "target_lang_word": "Namenkunde",
