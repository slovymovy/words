                    },
                    {
                        "translation_id": "1b0552c7-e3ab-4d7c-82f3-5151ca569f14",
                        "source_entry_id": "8acdc79e-cd0f-3196-8fd6-0e0a0e1a2b0b",
                        "source_sense_description": "человек, занимающийся перепродажей",
                        "target_lang_word": "scalper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scalper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93528792-235d-307d-b499-e55ccb8b3874",
                                        "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                                        "glosses": [
                                            "One who scalps, or removes the scalp of another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa61270b-76e8-4b48-bae7-457c44453648",
                                                "sense_id": "93528792-235d-307d-b499-e55ccb8b3874",
                                                "text": "Denouncing representations of hostile Indians as vicious scalpers of innocent settlers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d59827-77cf-3fff-acf1-b418bb608ddf",
                                        "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                                        "glosses": [
                                            "One who scalps tickets to popular entertainment events: buying them in advance and then selling them (e.g. online or just outside the venue of the event), often at inflated prices."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63dc6e78-578b-4be6-96fd-518909f0049f",
                                                "sense_id": "c3d59827-77cf-3fff-acf1-b418bb608ddf",
                                                "text": "We could see three different scalpers moving through the crowd outside the arena, each muttering the characteristic refrain: “Need any tickets?”"
                                            },
                                            {
                                                "example_id": "4d6918d8-1945-4f09-ab52-d9faaf5675ac",
                                                "sense_id": "c3d59827-77cf-3fff-acf1-b418bb608ddf",
                                                "text": "Although 4.1 million tickets were sold for the 2023 shows—including over 2 million on the first day, a new record—scalpers jacked up prices on the secondary market to more than $22,000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d3531e4-40a5-3927-a106-817474fc608d",
                                        "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                                        "glosses": [
                                            "One who scalps any other item with limited availability."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e04c62e8-9490-302d-ae02-fee699801c00",
                                        "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                                        "glosses": [
                                            "A gambler who scalps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb8820b0-9108-47a1-aefa-99a68f5e4e46",
                                                "sense_id": "e04c62e8-9490-302d-ae02-fee699801c00",
                                                "text": "The only sure thing about scalping the Series today is that the scalper is paying the bookie a greater profit because he is making a greater number of bets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb2a386d-616b-39ce-87e5-4417123de720",
                                        "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                                        "glosses": [
                                            "A person on an open outcry exchange trading floor who buys and sells rapidly for his or her own account, aiming to buy from a seller and a little later sell to a buyer, making a small profit from the difference (roughly the amount of the bid/offer spread, or less)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03744f79-e0a4-3f12-885c-ce8f71fff100",
                                        "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                                        "glosses": [
                                            "A machine for removing the ends of grain, such as wheat or rye, or for separating the different grades of broken wheat, semolina, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c4cae50-813e-3e00-b085-4dd410834c7d",
                                        "entry_id": "63fbca98-9add-323c-900a-f16f6075f865",
                                        "glosses": [
                                            "A surgical instrument for scraping carious bones."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e255499e-9a23-4656-863c-7de04e955f91",
                        "source_entry_id": "8acdc79e-cd0f-3196-8fd6-0e0a0e1a2b0b",
                        "source_sense_description": "человек, занимающийся перепродажей",
                        "target_lang_word": "Spekulant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spekulant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                        "entry_id": "93efb60e-a7b0-3247-9c9b-e78fceea46a9",
                                        "glosses": [
                                            "jemand, der spekuliert; jemand, der preiswert einkauft und auf steigende Preise hofft, um zu einem höheren Preis zu verkaufen, er geht dabei das Risiko ein, dass der Preis fällt und er ein Verlustgeschäft macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387d23a7-a858-4e7a-b31b-1d8096a380b8",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "„Glücksritter und Spekulanten nehmen unter dem Schutz des Militärs nun verlassene Landgüter, Geschäfte und Häuser in Besitz.“"
                                            },
                                            {
                                                "example_id": "9670a178-570e-43ea-ada5-9104295a9046",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "Der Spekulant verlor sein gesamtes Vermögen durch den rapide fallenden Goldpreis."
                                            },
                                            {
                                                "example_id": "7a50ec33-934d-4db0-a3a4-c2f48c5f6dcb",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "Die Spekulanten treiben die Preise für Baugrund in die Höhe."
                                            },
                                            {
                                                "example_id": "5fad9d3c-8c52-4e89-8260-f52af6511d5c",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "„Er hat entweder seine zwei Webstühle ganz und gar gekauft oder auf Kredit genommen und zahlt soundso viel wöchentlich für sie; oder er hat sie gepachtet, wahrscheinlich von seinem Hausbesitzer, der ein Bauherr und Spekulant ist.“"
                                            },
                                            {
                                                "example_id": "719c243c-3949-44f6-82fa-6d186a0d903b",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "„Tewjes zweite Geschichte erscheint 1899, und zu diesem Zeitpunkt ist der Spekulant schon ein alter Bekannter des Publikums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b35590cd-9f70-4066-bce4-f430da55a95d",
                        "source_entry_id": "8acdc79e-cd0f-3196-8fd6-0e0a0e1a2b0b",
                        "source_sense_description": "человек, занимающийся перепродажей",
