                "senses": [
                    {
                        "sense_id": "4a157468-f30f-3550-a91c-9e402e87b0cf",
                        "entry_id": "3deac545-3b80-31cb-9dee-543e403c117e",
                        "glosses": [
                            "Austausch eines Spielers zur Halbzeitpause"
                        ],
                        "tags": [
                            "Mannschaftssport"
                        ],
                        "examples": [
                            {
                                "example_id": "03cec533-582c-4761-883e-ebd350e8ca42",
                                "sense_id": "4a157468-f30f-3550-a91c-9e402e87b0cf",
                                "text": "„Mit dem Halbzeitwechsel von Scherrer für Daniel Schütz bewies Hütter dann ein gutes Händchen.“"
                            },
                            {
                                "example_id": "3d7436e0-89f4-4a03-8b3f-114b7b575a20",
                                "sense_id": "4a157468-f30f-3550-a91c-9e402e87b0cf",
                                "text": "„Die Mängel in der Chancenverwertung, die Defizite in der Abwehr nach dem Halbzeitwechsel, der Umstand, dass ‚wir die beiden Tore leichtfertig hergeschenkt haben‘, wie Wagner es nannte – all dies wollte Löw nicht zu hoch hängen.“"
                            },
                            {
                                "example_id": "7e059ffe-7bf4-472c-af7a-c462b2dc8dd0",
                                "sense_id": "4a157468-f30f-3550-a91c-9e402e87b0cf",
                                "text": "„Die beiden Halbzeitwechsel von Erfeld/Gerichtstetten begannen sich nach etwa einer Stunde allmählich auszuwirken und der Rückstand wurde nun ernsthaft angegriffen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4ed2310c-5628-32ff-8aad-2109d9e63363",
                        "entry_id": "3deac545-3b80-31cb-9dee-543e403c117e",
                        "glosses": [
                            "das Tauschen der Spielfeldseite zur Halbzeitpause"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ecc3fcd-ccb5-44e8-8d68-7b1ffdeae660",
                                "sense_id": "4ed2310c-5628-32ff-8aad-2109d9e63363",
                                "text": "„Eine Minute vor dem Halbzeitwechsel brachte Kai Michalke die Zebras 1:0 in Front.“"
                            },
                            {
                                "example_id": "1fa6f58d-26f4-4d28-a9ab-7fdff95d71a6",
                                "sense_id": "4ed2310c-5628-32ff-8aad-2109d9e63363",
                                "text": "„Nach dem Halbzeitwechsel fand der SSC zunächst nicht wieder zurück ins Spiel.“"
                            },
                            {
                                "example_id": "60831dfb-654a-4ec8-a4b7-eb1834651062",
                                "sense_id": "4ed2310c-5628-32ff-8aad-2109d9e63363",
                                "text": "„Einziger Kritikpunkt des Trainers war die Chancenverwertung vor dem Halbzeitwechsel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
