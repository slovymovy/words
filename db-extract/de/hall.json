                        "target_lang_word": "эхо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эхо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5921af72-f7ee-30d3-847b-f4d6bc73523c",
                                        "entry_id": "81738f0f-19f2-364a-bcae-fba8b3c66ac1",
                                        "glosses": [
                                            "отражённая звуковая волна, создающая эффект повторения звуков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f061749-7e07-4a92-b41e-f1253168f969",
                                                "sense_id": "5921af72-f7ee-30d3-847b-f4d6bc73523c",
                                                "text": "На взморье было до десятка пароходов, их гуды отдавались многими эхами."
                                            },
                                            {
                                                "example_id": "67076a6f-61a0-4b3a-a3b2-229cccc4fdd0",
                                                "sense_id": "5921af72-f7ee-30d3-847b-f4d6bc73523c",
                                                "text": "Ему вторило эхо, словно кто перекликался в лесу, повторяя на разные голоса последний слог ― «ай»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f13134ed-749e-3a63-a1c4-ff664181702d",
                                        "entry_id": "81738f0f-19f2-364a-bcae-fba8b3c66ac1",
                                        "glosses": [
                                            "перен. отзвук, отклик чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61d278e3-867d-4d0b-adf9-4b75e01ddb38",
                                                "sense_id": "f13134ed-749e-3a63-a1c4-ff664181702d",
                                                "text": "Давно отгремели взрывы, восстановлены разрушения, но нет-нет да и подаст свой голос эхо войны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd59d3d6-7329-3753-af3d-ae14b24e3089",
                                        "entry_id": "81738f0f-19f2-364a-bcae-fba8b3c66ac1",
                                        "glosses": [
                                            "техн. отражение волн любой природы, в том числе электромагнитных, в среде их распространения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "664bfb39-b2cc-416f-b303-8f2848b72c84",
                                                "sense_id": "dd59d3d6-7329-3753-af3d-ae14b24e3089",
                                                "text": "Но кроме того, после некоторых сигналов можно было различить своеобразное «эхо» ― повторение сигнала через некоторый промежуток времени после основного сигнала."
                                            }
                                        ]
                                    }
                                ]
                            }
