                "senses": [
                    {
                        "sense_id": "bd7ee8d1-d14d-3abb-a9b5-495e079213ae",
                        "entry_id": "6edafb3d-17be-322f-ae7a-9c8246b577c0",
                        "glosses": [
                            "Mastiquer."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "7f6747f6-7cfb-4c4f-b4fa-14558c9f2dc4",
                                "sense_id": "bd7ee8d1-d14d-3abb-a9b5-495e079213ae",
                                "text": "Venez au cabanon pour «mastéguer»\nEt surtout faire les «barjacaîres»"
                            },
                            {
                                "example_id": "361bd267-2465-49f0-a94c-9738d9241399",
                                "sense_id": "bd7ee8d1-d14d-3abb-a9b5-495e079213ae",
                                "text": "Mâchouiller, mâchonner, mâcher avec effort ou agacement, par exemple un chewing-gum (prov. mastega). Au sens figuré, mastéguer peut signifier saliver d’abondance en portant son regard sur une agréable créature, avoir un regard concupiscent."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fb3c08e-ed8f-3a21-a0b5-f693b6f2da9b",
                        "entry_id": "6edafb3d-17be-322f-ae7a-9c8246b577c0",
                        "glosses": [
                            "Manger, bouffer, mastiquer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "39aa0dcf-3f8e-4b81-8e3b-1378a2170b0d",
                                "sense_id": "6fb3c08e-ed8f-3a21-a0b5-f693b6f2da9b",
                                "text": "– […] Mais commence à mastéguer sans moi, je t’en prie…"
                            },
                            {
                                "example_id": "5be5a284-b888-4c89-bf75-1fdd541f3e85",
                                "sense_id": "6fb3c08e-ed8f-3a21-a0b5-f693b6f2da9b",
                                "text": "A la salle, un couple de gagne-petit masteguait des choucroutes […]."
                            },
                            {
                                "example_id": "e7cd53c6-78ee-4e4e-a8c4-8ebc36f15b2b",
                                "sense_id": "6fb3c08e-ed8f-3a21-a0b5-f693b6f2da9b",
                                "text": "Elle a posé sur la table une grosse soupière qui fumait. Ça sentait bon !… Les hommes ont tiré leurs lames et on s’est mis à mastéguer."
                            }
                        ]
                    }
                ],
