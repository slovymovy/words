                "senses": [
                    {
                        "sense_id": "d4698f05-eab5-318b-85b0-fddf47442d0c",
                        "entry_id": "ddb5277c-e06c-3722-8de6-98e95455c7ce",
                        "glosses": [
                            "een serie toedieningen van een antibacterieel middel die als geheel een infectieziekte kan genezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61116222-b1d1-4301-897b-b4314ab70c62",
                                "sense_id": "d4698f05-eab5-318b-85b0-fddf47442d0c",
                                "text": "Terug in Nederland constateerde topsportarts Peter Vergouwen bij Vos een zware voorhoofdsholte- en keelonsteking. Die is zo hardnekkig, dat hij direct met een zwaardere antibioticakuur is begonnen."
                            },
                            {
                                "example_id": "679ac4af-c969-4ac4-a1f4-ae678f2037f3",
                                "sense_id": "d4698f05-eab5-318b-85b0-fddf47442d0c",
                                "text": "De bacterie waar het om gaat, Clostridium difficile, kan aandoeningen veroorzaken van milde diarree tot levensbedreigende darmontstekingen. Vooral oudere mensen die een antibioticakuur hebben gehad, zijn er vatbaar voor. Dat komt doordat antibiotica de natuurlijke balans van darmbacteriën verstoren."
                            }
                        ]
                    }
