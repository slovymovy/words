                        "examples": [
                            {
                                "example_id": "05bff627-7869-4092-adee-d251334a1c8f",
                                "sense_id": "d697922b-bf0e-334d-be35-99d8d39fab8b",
                                "text": "La présence du groupe b dans les lieux qui n’ont pas connu la charrue évoque une lointaine ascendance forestière, peut-être la tétraclinaie."
                            },
                            {
                                "example_id": "bfa73afc-fe14-4ec0-8d02-82d61643d186",
                                "sense_id": "d697922b-bf0e-334d-be35-99d8d39fab8b",
                                "text": "On rencontre au niveau de ce site une très belle tétraclinaie sur tout le massif se mélangeant à l’arganier au piémont, et au chêne vert vers la crête du versant ."
                            },
                            {
                                "example_id": "0fa54aa8-97e9-481c-bdc7-d691c9289331",
                                "sense_id": "d697922b-bf0e-334d-be35-99d8d39fab8b",
                                "text": "La forêt de thuya de Berbérie ou tétraclinaie, parfois associée à l’oléolentisque et au genévrier de Phénicie, constitue des structures préforestières centrées sur le Maghreb"
                            }
                        ]
