                    {
                        "translation_id": "2bbd62d4-76b0-47a3-adeb-9d9ee0155f07",
                        "source_entry_id": "c602a067-b557-33ef-a098-6f89dfd142c9",
                        "source_sense_id": "3fa7d108-a4a5-3454-9a90-7330de2aaf7f",
                        "source_sense_description": "made by hand",
