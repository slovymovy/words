                "senses": [
                    {
                        "sense_id": "da0aec1d-ea47-3b18-aeb0-0c5e51b68d08",
                        "entry_id": "6dc26ef3-2348-3be3-98cd-92970ce176e1",
                        "glosses": [
                            "Remettre dans l’état voulu les bords de la route et nettoyer ses fossés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8322d420-cecc-4ccf-8f7b-90633d08ca61",
                                "sense_id": "da0aec1d-ea47-3b18-aeb0-0c5e51b68d08",
                                "text": "Monsieur Le Maire répond qu’il faut en premier lieu déberner, pour permettre à l’eau de s’écouler dans les fossés."
                            },
                            {
                                "example_id": "3cb5bc57-f75e-4ad7-b841-505fac9b98bf",
                                "sense_id": "da0aec1d-ea47-3b18-aeb0-0c5e51b68d08",
                                "text": "Avec l’acquisition de la mini-pelle, en deux années, nos agents ont pu déberner 12km de routes soit 24km de bernes, la moitié de notre linéaire de routes communales. Le débernage sécurise nos routes par l’évacuation des flaques ou retenues d’eau sur les bernes mais aussi il évite les dégradations précoces de la chaussée."
                            },
                            {
                                "example_id": "e8281497-93ec-42f1-a735-15ae7f65e1ce",
                                "sense_id": "da0aec1d-ea47-3b18-aeb0-0c5e51b68d08",
                                "text": "Chemin carrière : à rempierrer et déberner"
                            }
                        ]
                    }
