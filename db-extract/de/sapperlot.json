                "senses": [
                    {
                        "sense_id": "a1ed7690-5acd-3da8-8a04-70efaa4c6930",
                        "entry_id": "bbc87c76-876d-32fc-aad8-1bd3c3122707",
                        "glosses": [
                            "Ausdruck der Überraschung, Begeisterung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eeb48c2-f1fd-4bb6-b43b-e8c47e9365e5",
                                "sense_id": "a1ed7690-5acd-3da8-8a04-70efaa4c6930",
                                "text": "Sapperlot, da habt ihr aber groß für uns aufgetischt!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ac87c332-1a90-3cef-a63a-de924163919d",
                        "entry_id": "bbc87c76-876d-32fc-aad8-1bd3c3122707",
                        "glosses": [
                            "Ausruf der Verwünschung, Entrüstung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a89bee5-ff29-4128-a1d0-2239dfc47ae6",
                                "sense_id": "ac87c332-1a90-3cef-a63a-de924163919d",
                                "text": "Ja, sapperlot, hast du was an den Ohren? Du sollst sofort damit aufhören, habe ich gesagt!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61a89339-c3f7-4b9a-ae46-cafe04164d51",
                        "source_entry_id": "bbc87c76-876d-32fc-aad8-1bd3c3122707",
                        "source_sense_id": "a1ed7690-5acd-3da8-8a04-70efaa4c6930",
                        "source_sense_description": "Ausdruck der Überraschung, Begeisterung",
                        "target_lang_word": "saperlotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saperlotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4417b197-283a-36ca-98e8-5dc04e940a00",
                                        "entry_id": "46f3e9e6-09e2-344a-9fcf-78a992d2b495",
                                        "glosses": [
                                            "Marque l’étonnement, juron."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d48480b5-d1b9-4d85-8adf-fc23f22ce697",
                                                "sense_id": "4417b197-283a-36ca-98e8-5dc04e940a00",
                                                "text": "Non ! saperlotte, il n’y a que les femmes du monde pour savoir aimer ainsi ! se disait Crevel."
                                            },
                                            {
                                                "example_id": "fd7af71f-425e-45c3-8d53-164003146a5a",
                                                "sense_id": "4417b197-283a-36ca-98e8-5dc04e940a00",
                                                "text": "Saperlotte ! pensa le meunier, que l'on faisait passer de surprise en merveille. Me voilà bien embarrassé de choisir entre Pierre et Jean !"
                                            },
                                            {
                                                "example_id": "31eac3e1-1dd0-4c83-95e7-17273adf92b9",
                                                "sense_id": "4417b197-283a-36ca-98e8-5dc04e940a00",
                                                "text": "Gargaret.– Saperlotte ! vous auriez dû me dire ça plus tôt !"
                                            },
                                            {
                                                "example_id": "ac96277e-4652-4c33-9cb2-388822e456e0",
                                                "sense_id": "4417b197-283a-36ca-98e8-5dc04e940a00",
                                                "text": "Mais, saperlotte ! tâchons donc que tout ça se passe tranquillement; ça vaudrait beaucoup mieux. Puisque nous avons le suffrage universel, il n'y a plus besoin de coups de fusil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50336ffc-9e3f-420f-bbcc-99b7cac5d4dc",
                        "source_entry_id": "bbc87c76-876d-32fc-aad8-1bd3c3122707",
                        "source_sense_id": "a1ed7690-5acd-3da8-8a04-70efaa4c6930",
                        "source_sense_description": "Ausdruck der Überraschung, Begeisterung",
                        "target_lang_word": "sapristi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sapristi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "906a19bc-6681-3161-8b19-0a26f4a601c5",
                                        "entry_id": "a46bf7e9-c478-39ba-b891-a68ab9d56f3c",
                                        "glosses": [
                                            "Pour marquer l’étonnement ou l'énervement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "euphemism",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9108a667-7400-43a0-a492-bb30adb97b97",
                                                "sense_id": "906a19bc-6681-3161-8b19-0a26f4a601c5",
                                                "text": "Sapristi ! nous nous abrutissons à la fin !"
                                            },
                                            {
                                                "example_id": "748f6277-5bbd-4426-b71c-72be9c5291f0",
                                                "sense_id": "906a19bc-6681-3161-8b19-0a26f4a601c5",
                                                "text": "Mais sapristi vous ne vous doutez donc pas du nombre de crimes qui vous sont reprochés ?"
                                            },
                                            {
                                                "example_id": "83f1a44c-98f7-4ac6-bb73-471078ecf7b2",
                                                "sense_id": "906a19bc-6681-3161-8b19-0a26f4a601c5",
                                                "text": "Sapristi ! … Sapristi ! … gémissait le pauvre homme qui ne cessait de chasser, avec sa main, quelque chose d’invisible et qui bourdonnait autour de lui, comme une mouche. Sapristi ! On ne dit pas ces choses-là à d’honnêtes gens !"
                                            },
                                            {
                                                "example_id": "4560847a-a0c5-4b36-b39f-c4590beebd3e",
                                                "sense_id": "906a19bc-6681-3161-8b19-0a26f4a601c5",
                                                "text": "Sapristi ! s’exclama Stiple comme mentionné au début de ce récit, au comble de son délire, à la fois fascinée et mortifiée par toute la décadence mentale qui était là à l’œuvre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
