                    "frequency": "Middle",
                    "semantic_group_id": "faculte_intellectuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette situation difficile, elle a fait preuve d'un <w>jugement</w> remarquable."
