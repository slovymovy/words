                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bac7e2f7-79a7-44f5-b0d7-224afafdbdf4",
                                                "sense_id": "49db283f-1e90-3791-a6ed-3969e18a6cba",
                                                "text": "Whenever the locomotive was working hard there was unmistakable evidence of its higher power than its predecessors in the brilliant and explosive arcing between conductor shoes and the third rail; this was particularly vivid in Quarry Tunnel in the down direction, where the display equalled anything we have seen on the frostiest of nights in an electrified third-rail area."
                                            },
                                            {
                                                "example_id": "641c985e-2e13-407c-a3a0-725cdcd92bec",
                                                "sense_id": "49db283f-1e90-3791-a6ed-3969e18a6cba",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ac0073-2657-381c-a27e-b8e832d07181",
                                        "entry_id": "951e5b85-8903-39f4-8c6e-7611eb397d40",
                                        "glosses": [
                                            "Full of life; strikingly alive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "744c9854-9957-4bab-911e-dbb783489c0c",
                                                "sense_id": "72ac0073-2657-381c-a27e-b8e832d07181",
                                                "text": "The vivid, untrammeled life appealed to him, and for a time he had found delight in it; but he was wise and knew that once peace was established there would be no room in Cuba for the Sin Verguenza."
                                            }
