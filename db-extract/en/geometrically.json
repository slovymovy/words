                                "target_senses": [
                                    {
                                        "sense_id": "239349e7-db94-3b71-85a7-af2f80444ac2",
                                        "entry_id": "d6b9c4f7-98ea-3f4d-8c36-c4a18fefc56a",
                                        "glosses": [
                                            "D’une manière géométrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92cb5722-3d2a-4517-9498-bcf1eea09eb6",
                                                "sense_id": "239349e7-db94-3b71-85a7-af2f80444ac2",
                                                "text": "Il est rare que les géomètres soient fins, et que les fins soient géo mètres, à cause que les géomètres veulent traiter géométriquement les choses fines."
                                            },
                                            {
                                                "example_id": "0c2f559b-77fb-49f9-9d28-d5cee985c285",
                                                "sense_id": "239349e7-db94-3b71-85a7-af2f80444ac2",
                                                "text": "M. Montanari fit un petit ouvrage où, par les observations qu’il avait eues de différents endroits, il recherchait géométriquement quelle était la ligne du mouvement de cette flamme [météore], sa distance à la terre et sa grandeur."
                                            },
                                            {
                                                "example_id": "95ca4d2f-2500-46e7-b85b-1ddce0ee4a8d",
                                                "sense_id": "239349e7-db94-3b71-85a7-af2f80444ac2",
                                                "text": "Clarke et Leibnitz ont prouvé presque géométriquement l’existence du souverain être."
                                            },
                                            {
                                                "example_id": "baa0499a-f015-4e49-a487-ad8cb4e3f5c8",
                                                "sense_id": "239349e7-db94-3b71-85a7-af2f80444ac2",
                                                "text": "Comment se font géométriquement la multiplication, la division et l'extraction de la racine carrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8084ed3b-ac8d-3ddd-b74b-89bf05acae33",
