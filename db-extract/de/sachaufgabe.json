                        "glosses": [
                            "mathematische Aufgabe, die in einen Sachkontext eingekleidet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37b0ce8-e4ca-4b5b-b461-b853cc2a8cb8",
                                "sense_id": "84972c82-f07b-3468-983f-5d9d2f58f6d6",
                                "text": "„Die Schülerin kann eine Sachaufgabe in eine Rechenaufgabe übersetzen und ihr Ergebnis als Näherungslösung interpretieren und mit anderen Näherungslösungen, die auf anderen Wegen gefunden wurden, vergleichen.“"
                            },
                            {
                                "example_id": "08cec51e-9372-4ee2-bf16-e826d1b2693a",
                                "sense_id": "84972c82-f07b-3468-983f-5d9d2f58f6d6",
                                "text": "„In Mathe komme Atatürk in jeder zweiten Sachaufgabe vor, etwa mit Anekdoten aus seinem Leben.“"
                            }
                        ],
