                    {
                        "translation_id": "3c62fd0c-c87e-4444-bbf8-3ca2f34c88bd",
                        "source_entry_id": "78fb9915-98b5-3f9b-8373-cfc84d6af4ca",
                        "source_sense_id": "c6c7817e-dea7-3d46-8468-461a65b33506",
                        "source_sense_description": "lijdend aan lepra",
                        "target_lang_word": "leprous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leprous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d301a1c-3ae2-34ff-b50f-3e5d728c09ec",
                                        "entry_id": "e79fde70-26d6-3ce5-aee6-34541f7e7756",
                                        "glosses": [
                                            "Of or relating to one of the diseases known as leprosy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5582cde5-1e89-44dd-ba2f-7995f49bdf14",
                                                "sense_id": "9d301a1c-3ae2-34ff-b50f-3e5d728c09ec",
                                                "text": "1748, Philip Luckombe, A Tour Through Ireland, London: T. Lowndes & Son, 1783, Journey the Fourth, p. 324,\n[…] a dissenting minister […] came to this well, over-run with leprous eruptions on the skin, which had rendered his joints so rigid, that he could neither hold his bridle, nor feed himself […]"
                                            },
                                            {
                                                "example_id": "c0cf27d4-865f-42f7-8c49-ea73f4fe015f",
                                                "sense_id": "9d301a1c-3ae2-34ff-b50f-3e5d728c09ec",
                                                "text": "Nor shall the art which you and I need be merely a purple robe woven by a slave and thrown over the whitened body of some leprous king to adorn or to conceal the sin of his luxury, but rather shall it be the noble and beautiful expression of a people’s noble and beautiful life."
                                            },
                                            {
                                                "example_id": "a82e9034-9f86-44ef-99b7-7af6f87a6c90",
                                                "sense_id": "9d301a1c-3ae2-34ff-b50f-3e5d728c09ec",
                                                "text": "‘If they die,’ he said, ‘the cell shall be their tomb. They were put there to die, and be lost. The cell is leprous. Do you understand?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623cc45d-b4cd-3347-ab27-9a2337ac4e23",
                                        "entry_id": "e79fde70-26d6-3ce5-aee6-34541f7e7756",
                                        "glosses": [
                                            "Infected with one of the diseases known as leprosy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccdcfd63-29ed-487a-8a6d-d210d3ab6d1f",
                                                "sense_id": "623cc45d-b4cd-3347-ab27-9a2337ac4e23",
                                                "text": "And the Lord said furthermore unto him, Put now thine hand into thy bosom. And he put his hand into his bosom: and when he took it out, behold, his hand was leprous as snow."
                                            },
                                            {
                                                "example_id": "4005d1bd-05e6-4734-87a1-f3f06f520e62",
                                                "sense_id": "623cc45d-b4cd-3347-ab27-9a2337ac4e23",
                                                "text": "And the cloud departed from off the tabernacle; and, behold, Miriam became leprous, white as snow: and Aaron looked upon Miriam, and, behold, she was leprous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "424f987a-1323-36f0-b562-fbbcf76d34d5",
                                        "entry_id": "e79fde70-26d6-3ce5-aee6-34541f7e7756",
                                        "glosses": [
                                            "Similar to leprosy or its symptoms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eafadbc-0488-3d7a-905b-62773a8a2deb",
                                        "entry_id": "e79fde70-26d6-3ce5-aee6-34541f7e7756",
                                        "glosses": [
                                            "Having the appearance of the skin of one infected with leprosy; flaking, peeling, scabby, scurfy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a8374ba-4a56-44ea-96fb-ac78fd2fbb50",
                                                "sense_id": "6eafadbc-0488-3d7a-905b-62773a8a2deb",
                                                "text": "And why, except that it had moved everywhere with them and they regarded it as one of their possessions, had they kept the hatrack, its glass now leprous, most of its hooks broken, its woodwork ugly with painting-over?"
                                            },
                                            {
                                                "example_id": "459a823c-7f3a-4323-9981-640a66ab47ea",
                                                "sense_id": "6eafadbc-0488-3d7a-905b-62773a8a2deb",
                                                "text": "With little room to maneuver or park private cars, New Yorkers are more desperately dependent on taxis than any other city dwellers in the world. And the thousands of cabs that they ride are among the world's sleaziest: cigarette butts and paper coffee cups on the floor, dirty windows, leprous upholstery, chewed gum and sticky candy wrappers on ripped seats, and jagged metal protrusions on the doors waiting to savage the clothing of entering or departing passengers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ab41f5-9887-3e76-ac8f-daab27aa30ff",
                                        "entry_id": "e79fde70-26d6-3ce5-aee6-34541f7e7756",
                                        "glosses": [
                                            "Immoral, or corrupted or tainted in some manner; also, ostracized, shunned."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "835dd3ae-0697-4387-864f-21d30926f22e",
                                                "sense_id": "00ab41f5-9887-3e76-ac8f-daab27aa30ff",
                                                "text": "My whole Life is so leprous, it infects\nAll my Repentance: I wou’d buy your Pardon\nThough at the highest Set, even with my Life:"
                                            },
                                            {
                                                "example_id": "0830a525-498b-4445-a60e-e0e3e865a1d5",
                                                "sense_id": "00ab41f5-9887-3e76-ac8f-daab27aa30ff",
                                                "text": "And ſpeckl'd Vanity / Will ſicken ſoon and die, / And leprous ſin will melt from earthly mould, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4c92b79-a0bf-3b72-b58c-e3b6c29ff8c8",
                                        "entry_id": "e79fde70-26d6-3ce5-aee6-34541f7e7756",
                                        "glosses": [
                                            "Of gold or other metals: contaminated with other substances; impure."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41851681-dd6a-340e-965c-c54c5243b183",
                                        "entry_id": "e79fde70-26d6-3ce5-aee6-34541f7e7756",
                                        "glosses": [
                                            "Synonym of leprose (“covered with thin scurfy scales, scaly-looking”)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9c8a710-42b2-38a4-8232-a3c638cc2cf7",
                                        "entry_id": "e79fde70-26d6-3ce5-aee6-34541f7e7756",
                                        "glosses": [
                                            "Causing leprosy or a disease resembling it."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f74f4df6-d4ed-4fac-b6d0-a236b9cb9595",
                                                "sense_id": "b9c8a710-42b2-38a4-8232-a3c638cc2cf7",
                                                "text": "Thy vncle came, with iuyce of Hebona, / In a viall, and through the porches of my eares / Did powre the leaprous diſtilment, whoſe effect / Hold ſuch an enmitie with blood of man, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
