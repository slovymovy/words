                "senses": [
                    {
                        "sense_id": "eb295437-ce7e-3de8-a49c-91e549f10552",
                        "entry_id": "e5d33609-ec11-3c0d-99a5-dfba4f9cb4de",
                        "glosses": [
                            "действ. прич. наст. вр. от гибнуть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "3473c8a4-fac6-4727-ac9a-116377286501",
                                "sense_id": "eb295437-ce7e-3de8-a49c-91e549f10552",
                                "text": "Должно перетянуть гибнущего на сторону спасения, а не самому перетянуться на сторону гибели."
                            },
                            {
                                "example_id": "cddf0237-208f-4c0a-8d3e-10d6fb556e3e",
                                "sense_id": "eb295437-ce7e-3de8-a49c-91e549f10552",
                                "text": "Где та сирена, которая нас, гибнущих плавателей, соблазнила сладкогласным своим пением?"
                            }
                        ]
                    }
