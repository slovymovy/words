{
    "word_family": [
        "gefoeter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc180001-559f-3746-bbd9-fb506bfe51c3",
                    "sense_definition": "op een boze of ontevreden manier mopperen of klagen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mopperen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man zat de hele middag te <w>foeteren</w> op het slechte weer.",
                            "target_lang_translations": {
                                "en": "The old man sat <w>grumbling</w> about the bad weather all afternoon."
                            }
                        },
                        {
                            "text": "Hij begon luid te <w>foeteren</w> tegen de scheidsrechter na de onterechte beslissing.",
                            "target_lang_translations": {
                                "en": "He started <w>ranting</w> loudly at the referee after the unfair decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "mopperen",
                        "brommen"
                    ],
                    "common_phrases": [
                        "zitten te foeteren",
                        "foeteren op iemand"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to grumble or complain in an angry or dissatisfied manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to grumble",
                                "target_lang_sense_clarification": "complaining in a low, angry voice"
                            },
                            {
                                "target_lang_word": "to mutter",
                                "target_lang_sense_clarification": "speaking quietly and angrily to oneself"
                            },
                            {
                                "target_lang_word": "to grouse",
                                "target_lang_sense_clarification": "complaining about something trivial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6e28195-f5f1-3d03-9eec-dc2b8292eeab",
                    "sense_definition": "iemand met luide protesten en scheldwoorden overladen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mopperen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bestuurder van de andere auto <w>foeterde</w> hevig, hoewel hij geen voorrang verleend had.",
                            "target_lang_translations": {
                                "en": "The driver of the other car <w>railed</w> heavily, even though he hadn't given right of way."
                            }
                        },
                        {
                            "text": "Die volksmuziek is niet om aan te horen, <w>foetert</w> een boze tegenstander in de krant.",
                            "target_lang_translations": {
                                "en": "'That folk music is unbearable,' <w>fumes</w> an angry opponent in the newspaper."
                            }
                        }
                    ],
                    "synonyms": [
                        "mopperen"
                    ],
                    "common_phrases": [
                        "foeterde hevig"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt bij uitingen van woede"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to berate or scold someone with loud protests and harsh words"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to rant",
                                "target_lang_sense_clarification": "speaking or shouting at length in an angry way"
                            },
                            {
                                "target_lang_word": "to rail",
                                "target_lang_sense_clarification": "complaining or protesting strongly and persistently"
                            },
                            {
                                "target_lang_word": "to scold",
                                "target_lang_sense_clarification": "rebuking someone angrily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}