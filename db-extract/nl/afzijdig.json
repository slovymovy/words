                "senses": [
                    {
                        "sense_id": "95fa4f6c-a758-3943-b6f8-7dea0725089d",
                        "entry_id": "fabc5f3c-8255-35ec-9264-205d302d31fe",
                        "glosses": [
                            "zich ~ houden: zich er niet mee bemoeien, ervoor kiezen niet mee te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad9a1c2-1ba5-482b-91de-8d9574786569",
                                "sense_id": "95fa4f6c-a758-3943-b6f8-7dea0725089d",
                                "text": "De kerken hebben zich tot nu toe in het conflict grotendeels afzijdig gehouden."
                            },
                            {
                                "example_id": "4669450f-3d4f-4366-b7e2-531c8dec06d0",
                                "sense_id": "95fa4f6c-a758-3943-b6f8-7dea0725089d",
                                "text": "Zijn wandelingen hebben hem geïntroduceerd in de kringen van de talrijke daklozen, half-daklozen en semi-daklozen maar hij houdt zich desondanks afzijdig uit een hardnekkige besmettingsangst."
                            }
                        ]
                    },
                    {
                        "sense_id": "80e471b7-127b-3f11-b782-d510e1f1034e",
                        "entry_id": "fabc5f3c-8255-35ec-9264-205d302d31fe",
                        "glosses": [
                            "neutraal, niet betrokken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b994fa9f-0e89-40c6-9f91-613c18adcba9",
                                "sense_id": "80e471b7-127b-3f11-b782-d510e1f1034e",
                                "text": "Het land kan zich geen afwachtende en afzijdige houding veroorloven."
                            },
                            {
                                "example_id": "6a9a941b-804e-45dc-8b3e-f85848b0627f",
                                "sense_id": "80e471b7-127b-3f11-b782-d510e1f1034e",
                                "text": "Hij koos voor een afzijdige koers in zijn buitenlands beleid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8de63787-6b41-40ba-92c2-44fe3ca1afda",
                        "source_entry_id": "fabc5f3c-8255-35ec-9264-205d302d31fe",
                        "target_lang_word": "impartial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impartial",
