                    {
                        "sense_id": "dc3432a4-3a59-3226-adff-d99e47b73e8b",
                        "entry_id": "93665a09-576d-39b1-a8e5-2abc9acc27cd",
                        "glosses": [
                            "Qui cause un supplice ; qui supplicie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346488b0-d5e7-48e8-b5cd-09546a250c48",
                                "sense_id": "dc3432a4-3a59-3226-adff-d99e47b73e8b",
                                "text": "[…] et les bergers conduisant les troupeaux, et les bœufs couchés dans la prairie, redisaient la chanson, l’épouvantable, la suppliciante chanson de Carmen."
                            },
                            {
                                "example_id": "8ccd964a-cbcd-4637-bf47-3b21be418713",
                                "sense_id": "dc3432a4-3a59-3226-adff-d99e47b73e8b",
                                "text": "Moi, je perdais Juliette, je la perdais, chaque jour, chaque heure, chaque minute, et à ces morts successives, à ces morts impénitentes, je ne pouvais rattacher que des souvenirs suppliciants et des souillures…"
                            },
                            {
                                "example_id": "d350a8e4-5ea8-4bba-b436-c76d31f20249",
                                "sense_id": "dc3432a4-3a59-3226-adff-d99e47b73e8b",
                                "text": "À défaut de brancard, Solange courut chercher un drap qui parut encore plus suppliciant, plus infernal que les maladroites mains de son frère."
                            },
                            {
                                "example_id": "89013951-8d96-4c3f-850e-d75c9a9eac15",
                                "sense_id": "dc3432a4-3a59-3226-adff-d99e47b73e8b",
                                "text": "Ces heures inaccessibles et suppliciantes où elle allait goûter des plaisirs inconnus, voici que par une brèche inespérée nous y pénétrons ; …."
                            }
                        ]
                    }
                ],
