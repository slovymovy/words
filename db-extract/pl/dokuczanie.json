                            {
                                "target_word": "teasing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d64ef308-aab7-3902-bc11-91c90424db80",
                                        "entry_id": "8a7a4b7e-03ec-39b8-b69c-fd4b0b6982be",
                                        "glosses": [
                                            "The act of harassing someone playfully or maliciously, especially by ridicule; provoking someone with persistent annoyances; making fun of, making light of someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1bd4c93-ee3c-47bf-863c-f9e54e08db68",
                                                "sense_id": "d64ef308-aab7-3902-bc11-91c90424db80",
                                                "text": "Teasing can be seen as a kind of workplace abuse."
                                            },
                                            {
                                                "example_id": "148aeedd-d36d-4636-be4c-76759ae199cd",
                                                "sense_id": "d64ef308-aab7-3902-bc11-91c90424db80",
                                                "text": "The gentle teasing between siblings filled the house with laughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd8931dc-8dc3-3a3d-87d9-18b9f26fbe3e",
                                        "entry_id": "8a7a4b7e-03ec-39b8-b69c-fd4b0b6982be",
                                        "glosses": [
                                            "The act of removing tangles from one's hair with a comb."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d20e2dd5-91fb-4e4f-92af-ec1a54b2a31e",
                                                "sense_id": "cd8931dc-8dc3-3a3d-87d9-18b9f26fbe3e",
                                                "text": "The teasing of her curls took nearly an hour with the fine-tooth comb."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "teasing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0505f9b8-cda9-3f41-984b-450c34a197dd",
                                        "entry_id": "ed4f8cde-8982-3b57-8830-522a627db0ab",
                                        "glosses": [
                                            "Playfully vexing, especially by ridicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813b775e-5817-4977-840d-330fef46b024",
                                                "sense_id": "0505f9b8-cda9-3f41-984b-450c34a197dd",
                                                "text": "The children exchanged teasing remarks during recess."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ee1c4c-a6de-3e3c-8a45-3d7573bf5586",
                                        "entry_id": "ed4f8cde-8982-3b57-8830-522a627db0ab",
                                        "glosses": [
                                            "Arousing sexual desire without intending to satisfy it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c4d098-d504-43b6-96a6-284f492d974d",
                                                "sense_id": "28ee1c4c-a6de-3e3c-8a45-3d7573bf5586",
                                                "text": "The actress gave him a teasing glance before walking away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38001d5b-4f12-3d39-b0ed-a255ede763ac",
                                        "entry_id": "ed4f8cde-8982-3b57-8830-522a627db0ab",
                                        "glosses": [
                                            "Causing irritation or annoyance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce866e51-6bc1-46d4-8118-c7f923235322",
                                                "sense_id": "38001d5b-4f12-3d39-b0ed-a255ede763ac",
                                                "text": "The teasing itch from the mosquito bite drove her crazy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85df2948-9ff2-4192-9269-101dde8d6b9c",
                        "source_entry_id": "a8032c21-a839-385c-baca-cc2a478ba8ac",
                        "source_sense_id": "4b842b5a-cbb8-3a9f-bb5e-18d3a205f2ec",
                        "target_lang_word": "vexation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vexation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8479347b-df10-32b5-a634-0fa60386b82e",
                                        "entry_id": "9e90ecbd-457a-3844-ab49-022372496e4c",
                                        "glosses": [
                                            "The action of vexing, annoying, or irritating someone or something; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec231b4-f003-459f-8182-c1c626de5ab9",
                                                "sense_id": "8479347b-df10-32b5-a634-0fa60386b82e",
                                                "text": "[…] I mourne in my prayer, and make a noiſe, / For the voyce of the enemie, & for the vexation of the vvicked, becauſe they haue broght iniquitie vpon me, & furiouſly hate me."
                                            },
                                            {
                                                "example_id": "385c54ba-767b-476e-8181-d5ab3ea2f2b6",
                                                "sense_id": "8479347b-df10-32b5-a634-0fa60386b82e",
                                                "text": "I ſtill had hopes, my long vexations paſt, / Here to return—and die at home at laſt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf0d851f-b0b9-300c-8116-f7350b0f6cfb",
                                        "entry_id": "9e90ecbd-457a-3844-ab49-022372496e4c",
                                        "glosses": [
                                            "The action of vexing, annoying, or irritating someone or something; (countable) an instance of this.",
                                            "The action of physically annoying or irritating a person or an animal; (countable) an instance of this; also, a physical discomfort or disorder."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392cd06e-95d3-445d-a41d-6b9f41eac881",
                                                "sense_id": "cf0d851f-b0b9-300c-8116-f7350b0f6cfb",
                                                "text": "And, gentle Puck, take this transformed ſcalpe, / From the heade of this Athenian ſvvaine [Nick Bottom]; / That hee, avvaking vvhen the other do, / May all to Athens backe againe repaire, / And thinke no more of this nights accidents, / But as the fearce vexation of a dreame."
                                            },
                                            {
                                                "example_id": "31573afa-19b4-4aa0-a88f-68db3705a532",
                                                "sense_id": "cf0d851f-b0b9-300c-8116-f7350b0f6cfb",
                                                "text": "O Rome, in vvhat a ſickneſſe art thou fall'n! / Hovv dangerous, and deadly! vvhen thy head / Is drovvn'd in ſleepe, and all thy body feu'ry! / No noiſe, no pulling, no vexation vvakes thee, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1a787c9-4aec-3252-aa19-9399cf02fcce",
                                        "entry_id": "9e90ecbd-457a-3844-ab49-022372496e4c",
                                        "glosses": [
                                            "The action of vexing, annoying, or irritating someone or something; (countable) an instance of this.",
                                            "The action of vexing or annoying someone by bringing unjustified legal proceedings against them; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1848f7d2-ed8d-3547-b91d-c0ad42f377c0",
                                        "entry_id": "9e90ecbd-457a-3844-ab49-022372496e4c",
                                        "glosses": [
                                            "The state of being vexed, annoyed, or irritated; annoyance, irritation; also, disappointment, discontentment, unhappiness; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27edc53d-a0ad-4c18-9bd6-033a269b0e90",
                                                "sense_id": "1848f7d2-ed8d-3547-b91d-c0ad42f377c0",
                                                "text": "\"Indeed you perplex me intolerably;\" cried Cecilia, vvith ſome vexation, \"VVhy, Sir, vvill you not be more explicit?\""
                                            },
                                            {
                                                "example_id": "e97e226a-1974-4121-9264-64623e4aadd9",
                                                "sense_id": "1848f7d2-ed8d-3547-b91d-c0ad42f377c0",
                                                "text": "All was safe and prosperous; and as the removal of one solicitude generally makes way for another, Emma, being now certain of her ball, began to adopt as the next vexation Mr. Knightley's provoking indifference about it."
                                            },
                                            {
                                                "example_id": "4a2d1adf-408a-4bc3-bc8c-a947ffe7ffca",
                                                "sense_id": "1848f7d2-ed8d-3547-b91d-c0ad42f377c0",
                                                "text": "[…] I spoke of the constant vexation I suffered because I could not draw better."
                                            },
                                            {
                                                "example_id": "9ea90008-116a-4fe6-b1d5-bb6204c3622c",
                                                "sense_id": "1848f7d2-ed8d-3547-b91d-c0ad42f377c0",
                                                "text": "He clenched his fists in vexation and looked up at her impetuously."
                                            },
                                            {
                                                "example_id": "a0ea094c-dd91-439a-a8ff-1cd069dff407",
                                                "sense_id": "1848f7d2-ed8d-3547-b91d-c0ad42f377c0",
                                                "text": "He gave the doctor a look of vexation. He was surprised to see him, and resented the intrusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10bc419d-754d-31b7-a761-84e107d428cd",
                                        "entry_id": "9e90ecbd-457a-3844-ab49-022372496e4c",
                                        "glosses": [
                                            "The state of being vexed, annoyed, or irritated; annoyance, irritation; also, disappointment, discontentment, unhappiness; (countable) an instance of this.",
                                            "The state of being mentally distressed or troubled."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d4ff1e1-8471-4a66-95c3-591954026c41",
                                                "sense_id": "10bc419d-754d-31b7-a761-84e107d428cd",
                                                "text": "[M]en lyued ſimplye and innocentlye without inforcement of lawes, without quarellinge Judges and libelles, contente onely to ſatiſfie nature, without further vexation for knowledge of thinges to come."
                                            },
                                            {
                                                "example_id": "4d2494bb-62c2-465a-a817-83e515189ba8",
                                                "sense_id": "10bc419d-754d-31b7-a761-84e107d428cd",
                                                "text": "Thus I haue conſidered all the thinges that come to paſſe vnder the Sõne, ⁊ lo, they are all but vanitie ⁊ vexacion of mynde."
                                            },
                                            {
                                                "example_id": "0cdac594-a330-4b3e-b7ed-36f3ea7928ef",
                                                "sense_id": "10bc419d-754d-31b7-a761-84e107d428cd",
                                                "text": "Full of vexation, come I, vvith complaint / Againſt my childe, my daughter Hermia."
                                            },
                                            {
                                                "example_id": "5eea90c8-969c-4a26-926e-bc5ad131dcbb",
                                                "sense_id": "10bc419d-754d-31b7-a761-84e107d428cd",
                                                "text": "So ſome, ſaith Fracaſtorius [Girolamo Fracastoro], in fury, but moſt in despaire, ſorrovv, feare, and out of the anguiſh and vexation of their ſoules, offer violence to themſelues: for their life is vnhappy and miſerable."
                                            },
                                            {
                                                "example_id": "73408417-265d-4cbe-bfb2-d3cbd8f662cf",
                                                "sense_id": "10bc419d-754d-31b7-a761-84e107d428cd",
                                                "text": "And vvhether Poverty or Riches produce the Vexation, the Impreſſion it makes upon the Heart, is alike from both."
                                            },
                                            {
                                                "example_id": "480917ad-1da3-4839-accc-18446cebead3",
                                                "sense_id": "10bc419d-754d-31b7-a761-84e107d428cd",
                                                "text": "Truly, I think thou hast, and if anything could add to my grief and vexation at this moment, it is, that when I am so deep in the mire, an ass like thee should place his clumsy hoof on my head, to sink me entirely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d77e76f4-247a-3a81-8868-ec1ccf024742",
                                        "entry_id": "9e90ecbd-457a-3844-ab49-022372496e4c",
                                        "glosses": [
                                            "The state of being vexed, annoyed, or irritated; annoyance, irritation; also, disappointment, discontentment, unhappiness; (countable) an instance of this.",
                                            "The state of being physically annoyed or irritated."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dd99ceb-58a3-3051-98c0-1f8c36749cbd",
                                        "entry_id": "9e90ecbd-457a-3844-ab49-022372496e4c",
                                        "glosses": [
                                            "A source of mental distress or trouble; an affliction, a woe; also, a source of annoyance or irritation; an annoyance, an irritant."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "053b0d19-811f-4dab-a3bb-abdda66a4b64",
                                                "sense_id": "3dd99ceb-58a3-3051-98c0-1f8c36749cbd",
                                                "text": "[S]hould ſhe thus be ſtolne avvay from you, / It vvould be much vexation to your age."
                                            },
                                            {
                                                "example_id": "51856284-74ca-404a-9092-c9003e2b0aec",
                                                "sense_id": "3dd99ceb-58a3-3051-98c0-1f8c36749cbd",
                                                "text": "She did harass Helen to give me up; but, after all, poor woman, I believe I have been a great vexation to her, and I cannot help being sorry for her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c4bb9a3-70fd-3319-ae9f-00eeb21d6394",
                                        "entry_id": "9e90ecbd-457a-3844-ab49-022372496e4c",
                                        "glosses": [
                                            "The action of using force or violence on someone or something; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf55de2f-e5c8-4bdc-b6e0-5eed2c4af465",
                                                "sense_id": "7c4bb9a3-70fd-3319-ae9f-00eeb21d6394",
                                                "text": "'Tis Princely, vvhen a Tyranne doth oppoſe; / And is a fortune ſent to exerciſe / Your vertue, as the vvind doth try ſtrong trees: / VVho by vexation grovv more ſound, and firme."
                                            },
                                            {
                                                "example_id": "8233e727-3824-4e00-ac60-67501af267c0",
                                                "sense_id": "7c4bb9a3-70fd-3319-ae9f-00eeb21d6394",
                                                "text": "Name the vexations, and the Martyrizations / Of Metalls, in the VVorke."
                                            },
                                            {
                                                "example_id": "96c4778e-fd1b-4fbc-94d9-ce2848dba620",
                                                "sense_id": "7c4bb9a3-70fd-3319-ae9f-00eeb21d6394",
                                                "text": "Let No Ground be ſovved that is Planted vvith Vines; for the Earth hath enough to do to Attend the Services of That Plant, vvithout the Superfluous Vexations of the Plovv over and above."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
