                    {
                        "sense_id": "11f79d8e-a59e-30d8-bd2e-6ccf2135bc1a",
                        "entry_id": "484ffebf-79a2-35a7-92bb-7e6cd1b713ba",
                        "glosses": [
                            "A world beyond death; an afterlife."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fd85bfd5-3a99-30fa-857f-215ed28c1bc8",
                        "entry_id": "484ffebf-79a2-35a7-92bb-7e6cd1b713ba",
                        "glosses": [
                            "A world other than the everyday world."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b08b4fc-979a-4142-8484-90f46a0dcc57",
                                "sense_id": "fd85bfd5-3a99-30fa-857f-215ed28c1bc8",
                                "text": "We do not want, of course, to return to all the crudities and barbarities of the past; but also we do not want to become attenuated and spiritualized out of all mundane sense and recognition, and to live in an otherworld Paradise void of application to earthly affairs."
                            }
                        ]
                    },
                    {
                        "sense_id": "27173b66-4b40-3df0-b56e-c243eab75c21",
                        "entry_id": "484ffebf-79a2-35a7-92bb-7e6cd1b713ba",
                        "glosses": [
                            "A world other than the everyday world.",
                            "A mythical abode of otherworldly beings."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5792e4e3-51b8-43d4-9aa3-5305f88dca32",
                        "source_entry_id": "484ffebf-79a2-35a7-92bb-7e6cd1b713ba",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Anderswelt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anderswelt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d618e2a-2358-311c-afaf-c51f3daa4847",
                                        "entry_id": "cd5958b2-6cdd-3868-aa4c-fa92a3b34e8b",
                                        "glosses": [
                                            "Welt der keltischen Mythologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223c52b3-025c-4ac6-8dcb-a8564df88e04",
                                                "sense_id": "0d618e2a-2358-311c-afaf-c51f3daa4847",
                                                "text": "„Ob in den Aufzeichnungen altgriechischer und römischer Historiker in mittelalterlichen Legenden oder in den wabernden Fantasy-Nebeln zeitgenössischer Anderswelten von Arda bis Avalon: Sowohl die historischen Kriegerinnen wie die sagenhaften Feen, Zauberinnen und Göttinnen der keltischen Wandervölker umweht der Mythos, für ein frühes Feminat zu stehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a0feccc-7fab-431f-8b5b-ceefa254fbfc",
