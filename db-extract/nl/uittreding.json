                                            {
                                                "example_id": "53a2e228-6275-4260-a5e5-7e5036dbf6e9",
                                                "sense_id": "f149dd6c-c0a2-38ee-8c1d-de3c2a45810c",
                                                "text": "At the retire, the cavalry fell back."
                                            }
