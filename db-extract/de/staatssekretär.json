                ],
                "senses": [
                    {
                        "sense_id": "03bcdfdf-3f4e-38a3-9978-3ddd40e65067",
                        "entry_id": "4e409426-4ff8-36e7-97f1-3640551a8e92",
                        "glosses": [
                            "der höchste Beamte in einem Ministerium"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "ef0cfc67-92a7-44ea-8e10-1865042f4add",
                                "sense_id": "03bcdfdf-3f4e-38a3-9978-3ddd40e65067",
                                "text": "„Der beamtete Staatssekretär unterliegt den Vorschriften der Beamtengesetze, ist also unkündbar.“"
                            },
                            {
                                "example_id": "bdaaf510-0413-42c1-a2a7-78ed48a05d59",
                                "sense_id": "03bcdfdf-3f4e-38a3-9978-3ddd40e65067",
                                "text": "„Natürlich kannte sie einen Staatssekretär im Postministerium, bei dem sie sich sofort über den ›geldgierigen, impertinenten Menschen‹ beschwerte.“"
                            },
                            {
                                "example_id": "db2c6d43-1e27-4f56-8683-727bde89ee84",
                                "sense_id": "03bcdfdf-3f4e-38a3-9978-3ddd40e65067",
                                "text": "„Ganz in der Nähe arbeitete Gunnar, er war Staatssekretär im Außenministerium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "905b2f68-20c3-3844-b7bc-f14fe175a037",
                        "entry_id": "4e409426-4ff8-36e7-97f1-3640551a8e92",
                        "glosses": [
                            "Bundestagsmitglied, das den Minister bei seiner Arbeit unterstützt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "0cd99358-00b9-4ca8-9867-aa04e62542b5",
                                "sense_id": "905b2f68-20c3-3844-b7bc-f14fe175a037",
                                "text": "Seit dem 29. Oktober 2009 ist Steffen Kampeter parlamentarischer Staatssekretär beim Bundesminister der Finanzen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6a428e36-3229-39fc-9839-f18683c1f9d0",
                        "entry_id": "4e409426-4ff8-36e7-97f1-3640551a8e92",
                        "glosses": [
                            "Vom Bundespräsidenten ernannte Person, die den Minister bei seiner Arbeit unterstützt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "3269eecf-50f2-4f71-ac7e-0d64845fe0f8",
                                "sense_id": "6a428e36-3229-39fc-9839-f18683c1f9d0",
                                "text": "„Das Kabinett Gusenbauer umfasst 14 Minister und sechs Staatssekretäre, jeweils sieben bzw. drei von SPÖ bzw. ÖVP.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
