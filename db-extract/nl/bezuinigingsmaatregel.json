                "senses": [
                    {
                        "sense_id": "b36e5deb-fab0-3249-b2f7-7bdb313bd0ae",
                        "entry_id": "a5a387b9-3cc7-3927-8ae8-ab74eb314862",
                        "glosses": [
                            "een beslissing die erop gericht is om minder geld uit te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf82c83c-72ab-44d2-9bec-efadeebb18b8",
                                "sense_id": "b36e5deb-fab0-3249-b2f7-7bdb313bd0ae",
                                "text": "FNV protesteert daarmee tegen het besluit van KLM, ruim een jaar geleden, om op een deel van de verre vluchten met een steward of stewardess minder te vliegen. Die bezuinigingsmaatregel heeft volgens de bond geleid tot een verhoging van de werkdruk."
                            },
                            {
                                "example_id": "2972f9a5-ab59-4d15-9e3d-8d43df7ad299",
                                "sense_id": "b36e5deb-fab0-3249-b2f7-7bdb313bd0ae",
                                "text": "Uiteindelijk bevestigde de wethouder dat de versobering van het groenonderhoud een bezuinigingsmaatregel was. Als de bewoners het onderhoudsniveau wilden opkrikken, dan kon dat. Met een burgerinitiatief kan 750 euro worden binnengehaald. Bij lange na niet genoeg om de kosten te dekken. Dus legde Olde Dubbelink ook de vraag bij de gemeente neer of de buurt het onderhoudsgeld kon krijgen dat de gemeente nu heeft kunnen besparen."
                            },
                            {
                                "example_id": "49394841-461f-4b98-90a1-052991c3b66d",
                                "sense_id": "b36e5deb-fab0-3249-b2f7-7bdb313bd0ae",
                                "text": "De SP in de Tweede Kamer reageert bezorgd. ,,Veiligheid van het gevangenispersoneel moet vooropstaan. Menselijk contact is cruciaal, dat vervang je niet door camera's, zegt Kamerlid Michiel van Nispen. ,,Dit lijkt een bezuinigingsmaatregel en dient niet de veiligheid."
                            }
                        ]
                    }
