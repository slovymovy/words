                "senses": [
                    {
                        "sense_id": "ce0b4369-6d7e-3cd5-9ab7-fea33e5d20ce",
                        "entry_id": "eb7e4e8b-c587-3b44-92cb-14133fe4c44a",
                        "glosses": [
                            "Industriel de la sidérurgie."
                        ],
                        "tags": [
                            "Sidérurgie"
                        ],
                        "examples": [
                            {
                                "example_id": "5a2e362d-3c0e-4ca8-852a-4d8a2bb382db",
                                "sense_id": "ce0b4369-6d7e-3cd5-9ab7-fea33e5d20ce",
                                "text": "Le phosphore, ce vieil ennemi du sidérurgiste, devient un ami et un allié dans le procédé Bessemer-Thomas."
                            },
                            {
                                "example_id": "2c9101e9-4fbe-4e78-9e5e-53ce831704eb",
                                "sense_id": "ce0b4369-6d7e-3cd5-9ab7-fea33e5d20ce",
                                "text": "Les sidérurgistes européens redoutent un dérèglement du marché avec un afflux de matière, ne trouvant plus de débouchés aux États-Unis."
                            },
                            {
                                "example_id": "d2cf53d7-19e3-4180-8f95-cca48eea6057",
                                "sense_id": "ce0b4369-6d7e-3cd5-9ab7-fea33e5d20ce",
                                "text": "\"À l'heure où le monde se décarbonise, BHP se concentre davantage sur la production de charbon métallurgique de qualité supérieure, recherché par les sidérurgistes mondiaux, afin d'améliorer l'efficacité et de réduire les émissions\", a déclaré Edgar Basto, responsable de l'exploitation minière australienne à BHP, dans un communiqué."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8e313fe-db44-3fc8-99f2-76be4725d9ab",
                        "entry_id": "eb7e4e8b-c587-3b44-92cb-14133fe4c44a",
                        "glosses": [
                            "Employé de la sidérurgie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de0d5bc1-0fbe-4212-a006-8f8c91eaa108",
                                "sense_id": "a8e313fe-db44-3fc8-99f2-76be4725d9ab",
                                "text": "Vingt-mille sidérurgistes défileront demain à l’appel des syndicats pour la défense de l’emploi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffeb577f-886c-4cfb-8c02-ccd1920dcbc4",
                        "source_entry_id": "eb7e4e8b-c587-3b44-92cb-14133fe4c44a",
                        "target_lang_word": "steelworker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
