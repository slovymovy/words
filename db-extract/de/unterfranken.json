                "senses": [
                    {
                        "sense_id": "b8935c04-01e6-3256-a664-a682fe00836e",
                        "entry_id": "3674c37e-4d34-3458-a78d-3e26116dfa3b",
                        "glosses": [
                            "Bezirk (kommunale Gebietskörperschaft oberhalb der Landkreise) im Norden des Bundeslands Bayern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6bf609-3ee7-442c-aa63-7fe5bcb5fa6a",
                                "sense_id": "b8935c04-01e6-3256-a664-a682fe00836e",
                                "text": "„Fast 27,3 Millionen Euro wird der Bezirk Unterfranken im kommenden Jahr für Baumaßnahmen ausgeben.“"
                            },
                            {
                                "example_id": "44b1714a-320a-4663-86a3-7ecfce847a7f",
                                "sense_id": "b8935c04-01e6-3256-a664-a682fe00836e",
                                "text": "„Allein in Unterfranken sind 296 Burg- und Wehranlagen bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b4a9e517-a7f0-3b4a-9619-596649f24049",
                        "entry_id": "3674c37e-4d34-3458-a78d-3e26116dfa3b",
                        "glosses": [
                            "Regierungsbezirk im Norden des Bundeslands Bayern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720d0e28-02ab-44fa-8d54-f7f85ce89012",
                                "sense_id": "b4a9e517-a7f0-3b4a-9619-596649f24049",
                                "text": "„Die Regierung von Unterfranken hat im Jahr 2013 im Regierungsbezirk Unterfranken zur Förderung von Insolvenzberatungsstellen Ausgabemittel in Höhe von insgesamt 248.430 € bewilligt.“"
                            },
                            {
                                "example_id": "c563c375-be2b-44dd-baf2-b8980901deac",
                                "sense_id": "b4a9e517-a7f0-3b4a-9619-596649f24049",
                                "text": "„Gestern morgen scheint es dann jemand gemerkt zu haben, am Vormittag wurde aus Niederfranken doch noch Unterfranken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
