                        "sense_id": "913adab9-2fc4-3760-8a8f-88967b7862ed",
                        "entry_id": "1e135f58-c188-3d06-a838-266551790ae6",
                        "glosses": [
                            "etwas, das nicht mehr zu übertreffen ist, das Allerbeste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745fb468-6f56-4db2-a440-525e1ba88f67",
                                "sense_id": "913adab9-2fc4-3760-8a8f-88967b7862ed",
                                "text": "Mein neuer Driver ist das Nonplusultra auf dem Golfschlägermarkt."
                            },
                            {
                                "example_id": "d880e270-4a01-4b8a-89ec-de0738a2e7b6",
                                "sense_id": "913adab9-2fc4-3760-8a8f-88967b7862ed",
                                "text": "„Ich wollte so gut werden wie Elly Ney, die für den Vogel das Nonplusultra war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8288bc3e-dc86-4771-9c78-80592cb83ac4",
                        "source_entry_id": "1e135f58-c188-3d06-a838-266551790ae6",
                        "source_sense_id": "913adab9-2fc4-3760-8a8f-88967b7862ed",
                        "source_sense_description": "etwas, das nicht mehr zu übertreffen ist, das Allerbeste",
                        "target_lang_word": "ultimate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultimate",
