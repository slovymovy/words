                "senses": [
                    {
                        "sense_id": "44b0dabe-9a09-3c6f-8348-326dc3061b3e",
                        "entry_id": "5b133a75-d041-3a22-8492-b08b843efcce",
                        "glosses": [
                            "Arrêté par le sable dans un cours d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf7e282f-3fd3-4fc2-8173-a97ccdb30f80",
                                "sense_id": "44b0dabe-9a09-3c6f-8348-326dc3061b3e",
                                "text": "– Ils jurent comme… comme…\nComme des mariniers engravés, n’osait souffler Frédéric."
                            },
                            {
                                "example_id": "5b2a1580-73fb-46be-9d23-ae532684f819",
                                "sense_id": "44b0dabe-9a09-3c6f-8348-326dc3061b3e",
                                "text": "Les eaux [de la Loire] sont si basses, et je suis si souvent engravée que je regrette mon équipage qui ne s’arrête point et qui va son train."
                            },
                            {
                                "example_id": "b3339cce-dda4-4c04-9e8e-3c98c979b4c2",
                                "sense_id": "44b0dabe-9a09-3c6f-8348-326dc3061b3e",
                                "text": "Une vestale met à flot un gros vaisseau engravé en le tirant avec sa ceinture."
                            }
                        ]
                    },
                    {
                        "sense_id": "92d48fa1-21b7-32e8-8d80-3c4e25d92b58",
                        "entry_id": "5b133a75-d041-3a22-8492-b08b843efcce",
                        "glosses": [
                            "Couvert de gravier et de sable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8386e522-ada2-4eec-b7eb-f3b00174b90e",
                                "sense_id": "92d48fa1-21b7-32e8-8d80-3c4e25d92b58",
                                "text": "Sur la plaine ensablée, engravée par les inondations du Rhône, les jardins et les oseraies essayent de s’étendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "48bbd434-5cc1-37fd-b8eb-dcc065ca7d06",
                        "entry_id": "5b133a75-d041-3a22-8492-b08b843efcce",
                        "glosses": [
                            "Dont les ongles sont blessés par le sable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82eef7de-d921-41b4-8bc9-c3c6ca77d43c",
                                "sense_id": "48bbd434-5cc1-37fd-b8eb-dcc065ca7d06",
                                "text": "Chien engravé."
                            }
                        ]
                    }
