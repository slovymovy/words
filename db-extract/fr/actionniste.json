                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktieninhaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40b354a4-bc2a-3131-89a6-248946582808",
                                        "entry_id": "7627e04a-0b61-350f-a848-b478e06c1d55",
                                        "glosses": [
                                            "jemand, der Aktien besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4be6d05-84c6-430d-b947-98016b922082",
                                                "sense_id": "40b354a4-bc2a-3131-89a6-248946582808",
                                                "text": "Alle Aktieninhaber sind zur Teilnahme an der Hauptversammlung berechtigt."
                                            },
                                            {
                                                "example_id": "37c9af31-9daf-4278-b9fd-bd4736823b61",
                                                "sense_id": "40b354a4-bc2a-3131-89a6-248946582808",
                                                "text": "„Als größter Aktieninhaber von PayPal profitierte Musk aber sehr davon, dass das Unternehmen für 1,5 Milliarden an eBay verkauft wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7a521be-e681-4576-bafb-0a659d8e785c",
                        "source_entry_id": "359f8117-1cb7-3632-b52e-66514eaba34e",
                        "source_sense_id": "3e7846c8-30ed-384c-b2a7-dd8c7da377b9",
                        "source_sense_description": "Propriétaire d’actions",
                        "target_lang_word": "Aktionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                        "entry_id": "93f4c9ec-36e5-3a48-aac9-f81c0835f31b",
                                        "glosses": [
                                            "Inhaber von Aktien, und damit Miteigentümer einer Aktiengesellschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04fb28b9-e8d0-4780-80e8-d4008897511b",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "Nach § 53a des deutschen Aktiengesetzes sind Aktionäre unter gleichen Voraussetzungen gleich zu behandeln."
                                            },
                                            {
                                                "example_id": "a3850fcb-aed5-4882-a1c1-eadadffd5216",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Der Aktionär hat zweierlei wichtige Rechte: er ist der, wo das Geld gibt, und er darf bei der Generalversammlung in die Opposition gehen und etwas zu Protokoll geben, woraus sich der Vorstand einen sog. Sonnabend macht.“"
                                            },
                                            {
                                                "example_id": "5e3ad21c-7608-4f03-829e-603136c9a592",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Als sie in See stach, waren alle vierzehn Aktionäre mit an Bord.“"
                                            },
                                            {
                                                "example_id": "9f38ff11-0759-4875-9169-4c6619940a48",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Francis Baring, dessen 1762 in London gegründete Bank im Jahr 1995 spektakulär pleiteging, fungierte bereits um 1750 als Aktionär der Company of Merchants Trading to Africa und profitierte vom Sklavenhandel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a516e2c2-e627-423a-806d-3cb1cf367557",
                        "source_entry_id": "359f8117-1cb7-3632-b52e-66514eaba34e",
                        "source_sense_id": "3e7846c8-30ed-384c-b2a7-dd8c7da377b9",
                        "source_sense_description": "Propriétaire d’actions",
                        "target_lang_word": "Anteilseigner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anteilseigner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02f86b59-7ba5-369f-81a8-b711af1435e3",
                                        "entry_id": "26a7a673-faa7-3acb-96b4-8f9a148841b6",
                                        "glosses": [
                                            "jemand, der einen Anteil von etwas besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26142858-ffd5-4ec3-a443-c027ef4038af",
                                                "sense_id": "02f86b59-7ba5-369f-81a8-b711af1435e3",
                                                "text": "„Doch ohne die Unterstützung anderer großer Anteilseigner wird die Beratungsgesellschaft, die nur 0,5 Prozent des Aktienkapitals der Bank vertritt, lediglich ein Signal setzen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd05d054-dd4f-40a5-b332-d1edf14e36b7",
                        "source_entry_id": "359f8117-1cb7-3632-b52e-66514eaba34e",
                        "source_sense_id": "3e7846c8-30ed-384c-b2a7-dd8c7da377b9",
                        "source_sense_description": "Propriétaire d’actions",
                        "target_lang_word": "shareholder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shareholder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                        "entry_id": "e7e609b5-47f9-3b07-9bb6-5fec0207f9bd",
                                        "glosses": [
                                            "One who owns shares of stock in a corporation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a785e93b-d483-42e2-b441-5cb8fbee6710",
                                                "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                                "text": "Shareholders are the real owners of a publicly traded business, but management runs it."
                                            },
                                            {
                                                "example_id": "b033b9f1-2d60-4206-8c6b-6f2281ab1442",
                                                "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                                "text": "Hudson personally would not face the music at that meeting and the business could hardly proceed for groans and hisses and cries of \"Hudson! Hudson! Why is Hudson not here?\" and so the ungrateful shareholders to whom Hudson had generously paid dividends out of their own capital cast out Hudson bag and baggage, including therein the agreement with the Newmarket Railway."
                                            },
                                            {
                                                "example_id": "f9423df7-8591-4e4c-b3c4-e961284f7cfc",
                                                "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                                "text": "High prices have swelled profits for energy companies, leaving them flush with cash. And their shareholders are certainly feeling that windfall. Exxon Mobil made a record $59 billion profit in 2022, up 157% from the year prior, and the company plans to spend up to $50 billion buying back shares."
                                            },
                                            {
                                                "example_id": "7eed34cd-b2c2-4bd7-96ff-9d516919ac9e",
                                                "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                                "text": "As of March 2022, the Qatar Holding LLC, the investment arm of Qatar Investment Authority (QIA) was the single largest shareholder of QIB, owning 16.7% of the bank, while Nasser Al-Khelaifi, president of PSG, is a board member at QIA."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
