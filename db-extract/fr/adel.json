                    {
                        "sense_id": "3038aa00-2e33-347a-9082-3da242007cec",
                        "entry_id": "6a7810da-4383-34a4-a31f-091f20177c3f",
                        "glosses": [
                            "Greffier dans la justice musulmane."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "08a462e6-3586-486d-a709-d1690daaab09",
                                "sense_id": "3038aa00-2e33-347a-9082-3da242007cec",
                                "text": "Dans les couloirs de la prison, j’ai reconnu en entrant Mohamed Sefta, adel de la Mahakma d’Alger (la justice musulmane)."
                            },
                            {
                                "example_id": "4de3b049-6d06-43d5-8147-b16ccb8dc1ca",
                                "sense_id": "3038aa00-2e33-347a-9082-3da242007cec",
                                "text": "Cette activité dans le monde judiciaire n’est pas nouvelle : Mohammed Lakhdar a d’abord été adel, c’est-à-dire greffier, à la Mahakma de Tébessa en 1937, avant de devenir interprète judiciaire à la Justice de Paix de la même ville."
                            }
                        ]
                    }
                ],
