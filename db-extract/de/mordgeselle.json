                "senses": [
                    {
                        "sense_id": "280b63e3-9dcb-3bf2-8799-90a67779aae6",
                        "entry_id": "527cc410-ceb8-3b2a-9ee0-e0c929339255",
                        "glosses": [
                            "Person, die mordet/gemordet hat"
                        ],
                        "tags": [
                            "veraltet, abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "1b2ee37b-284d-4e12-8d7c-1414bca17410",
                                "sense_id": "280b63e3-9dcb-3bf2-8799-90a67779aae6",
                                "text": "„Wenn ich ganz sicher gewesen wäre, daß dieser Mordgeselle mir nicht eine Falle stellte, hätte ich ihm ganz gewiß das verlangte Versprechen gegeben; aber ich hatte Angst vor einer Erpressung.“"
                            },
                            {
                                "example_id": "eaebbd8a-52c8-4749-990f-d35072c29bd2",
                                "sense_id": "280b63e3-9dcb-3bf2-8799-90a67779aae6",
                                "text": "„Eine Weile hielten die drei Mordgesellen noch an, brüllten dann ein ›Buen viaje a los infiernos!‹ herüber und sprangen in ihr Boot, in das sie ihren Genossen halfen und in Nacht und Nebel verschwanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18faf796-9128-36d6-84b9-aa1bb50774b0",
                        "entry_id": "527cc410-ceb8-3b2a-9ee0-e0c929339255",
                        "glosses": [
                            "Person, die bereit ist/war, an einem Mord mitzuwirken"
                        ],
