                "senses": [
                    {
                        "sense_id": "22da33b9-dd06-3510-af3d-072db0af1b13",
                        "entry_id": "7f654919-4587-373b-98af-05680ff2c971",
                        "glosses": [
                            "Ausdauer; Fähigkeit, gegen geistige oder körperliche Ermüdung weiter Leistung zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe60f264-3f35-4e5d-a7dc-e287dd6b5f5c",
                                "sense_id": "22da33b9-dd06-3510-af3d-072db0af1b13",
                                "text": "[…] der Mecklenburger [Jens Voigt] steht wie kaum ein anderer Radprofi für unbändigen Kampfgeist und ungeheures Stehvermögen."
                            },
                            {
                                "example_id": "f19a27c5-4fb8-49ef-8dcf-e5d4bcc85f8d",
                                "sense_id": "22da33b9-dd06-3510-af3d-072db0af1b13",
                                "text": "Enormes Stehvermögen und unbedingter Wille sind die Qualitäten, die [Jürgen] Blin auszeichnen."
                            },
                            {
                                "example_id": "1756da90-2bb3-4699-af86-89a55b3a2412",
                                "sense_id": "22da33b9-dd06-3510-af3d-072db0af1b13",
                                "text": "[Der SPD-Generalsekretär Klaus-Uwe Benneter] sagte, der Neuigkeitswert des Gespanns Lafontaine/Gysi werde sich schnell erschöpfen. Beide Politiker hätten kein Stehvermögen. Sie seien Schönwetterpolitiker."
                            },
                            {
                                "example_id": "33262161-91f2-4f14-ae8d-99a869809fa5",
                                "sense_id": "22da33b9-dd06-3510-af3d-072db0af1b13",
                                "text": "Ihr Ansehen hat sich Elizabeth II. durch unerschütterliches Pflichtgefühl und Stehvermögen hart erarbeitet […]"
                            },
                            {
                                "example_id": "093bc5da-09ce-4800-8b73-0767d43366c4",
                                "sense_id": "22da33b9-dd06-3510-af3d-072db0af1b13",
                                "text": "[Kurt Jaeger vom Chaos Computer Club] ist beeindruckt davon, welches Stehvermögen Wikileaks gegen Scientology gezeigt hat […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5939fbf0-96aa-3d2e-be42-4b65215c985c",
                        "entry_id": "7f654919-4587-373b-98af-05680ff2c971",
                        "glosses": [
                            "die Eigenschaft von Holz, sich unter Temperatur- und Luftfeuchteschwankungen nicht oder wenig zu verziehen"
                        ],
                        "tags": [
                            "Werkstoffkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "0834115e-186d-4899-9718-a8cb026a6d17",
                                "sense_id": "5939fbf0-96aa-3d2e-be42-4b65215c985c",
                                "text": "Holzarten mit einer guten Dimensionsstabilität haben ein gutes Stehvermögen, ändern ihre Dimensionen also relativ wenig und verformen sich nur wenig."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddc71621-2805-49c4-a905-08b6406c8b2c",
                        "source_entry_id": "7f654919-4587-373b-98af-05680ff2c971",
                        "source_sense_id": "22da33b9-dd06-3510-af3d-072db0af1b13",
                        "source_sense_description": "Fähigkeit, gegen die Ermüdung weiter Leistung zu bringen",
                        "target_lang_word": "stamina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stamina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                                        "entry_id": "c90f4859-5bc9-3073-a438-a79c8b6bedab",
                                        "glosses": [
                                            "The energy and strength for continuing to do something over a long period of time; power of sustained exertion, or resistance to hardship, illness etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98451ee-c4a4-4950-b40d-654acce79843",
                                                "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                                                "text": "He has a lot of stamina. I suppose that's why he can run for a long time."
                                            },
                                            {
                                                "example_id": "dc1a710e-7982-44c1-adb0-2bb8c3404aa7",
                                                "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                                                "text": "In the first five minutes muscles which he had not been aware that he possessed had started to ache like neglected teeth. His respect for the toughness and durability of artists' models was now solid. How they acquired the stamina to go through this sort of thing all day and then bound off to Bohemian revels at night was more than he could understand."
                                            },
                                            {
                                                "example_id": "f002f031-20b7-4471-9894-1f8eb4479301",
                                                "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                                                "text": "Yes, gas, price of energy, food, even interest rates are rising, so that means tough times for households. It's often thought that Europeans or we Western people are used to, let's say, to a life which goes always to better and better and thus that we are very weak to face difficulties. But I would say that Ukrainians gave an excellent example that there is stamina amongst people when difficulties come. And difficulties which we are facing are minor if compared to those Ukrainians are meeting. So, I believe that we European people can take it and have resilience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7205072-e209-322a-a481-569e527b61d5",
                                        "entry_id": "c90f4859-5bc9-3073-a438-a79c8b6bedab",
                                        "glosses": [
                                            "The basic elements of a thing; rudimentary structures or qualities."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "plural",
                                            "plural-only",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stamina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab2735f-800c-38fc-8924-893cf796256a",
                                        "entry_id": "9f99843c-0281-3950-9ad3-3def51fbeeda",
                                        "glosses": [
                                            "plural of stamen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aaf4c2d-8bce-4e4e-bd47-f2e7ec1c5acd",
                                                "sense_id": "0ab2735f-800c-38fc-8924-893cf796256a",
                                                "text": "1790, William Curtis, The Botanical Magazine, Or, Flower-Garden Displayed, Volume 3, 2006 Gutenberg eBook edition,\nIn the specimens we have examined, and which perhaps have been rendered luxuriant by culture, the number of stamina has been from twelve to sixteen; of styles, from six to eight; of flowers on the same stalk, from one to eight."
                                            },
                                            {
                                                "example_id": "caa15535-1b5f-4ba9-945d-8984a90a3d07",
                                                "sense_id": "0ab2735f-800c-38fc-8924-893cf796256a",
                                                "text": "1832 December 8, Spirit of Discovery, in The Mirror of Literature, Amusement, and Instruction, Number 579, 2005 Gutenberg eBook edition,\nThe gay flowers of the hibiscus tiliaceus, as well as the splendid huth or Barringtonia speciosa, covered with its beautiful flowers, the petals of which are white, and the edges of the stamina delicately tinged with pink, give to the trees when in full bloom a magnificent appearance; the hibiscus rosa-chinensis, or kowa of the natives also grows in luxuriance and beauty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cb3d1f7-dc2a-40ca-84ca-bfedfe740f7c",
                        "source_entry_id": "7f654919-4587-373b-98af-05680ff2c971",
                        "source_sense_id": "22da33b9-dd06-3510-af3d-072db0af1b13",
                        "source_sense_description": "Fähigkeit, gegen die Ermüdung weiter Leistung zu bringen",
                        "target_lang_word": "ténacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ténacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "126a63bf-094c-3f04-b4bd-79ef06b0130c",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Caractère de ce qui est tenace, de ce qui tient fortement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467242ab-5ab8-4d01-8e3c-d4db739a47d3",
                                                "sense_id": "126a63bf-094c-3f04-b4bd-79ef06b0130c",
                                                "text": "La ténacité de la poix, de la glu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66cb595e-fc1c-3085-a638-bc36f939d505",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Propriété qu’ont certains corps de soutenir une traction, une pression considérable sans s’allonger, sans se rompre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bccbbd19-e0cd-42fe-8fd2-e9e55c8a9100",
                                                "sense_id": "66cb595e-fc1c-3085-a638-bc36f939d505",
                                                "text": "Deux fils de même ténacité, mais de numéros différents, qui doivent être tendus conséquemment avec la même traction, ne peuvent donc pas, au dévidoir, prendre le même dispositif de tension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef40306-aeb6-3a62-bf51-e3c70331b294",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Capacité d'un matériau à encaisser l'énergie d'un choc, d'une contrainte, en résistant à la fissuration.(L'inverse se nomme douceur ou faiblesse.)"
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db26380b-69a2-45d9-bdd3-b8014e56cce4",
                                                "sense_id": "fef40306-aeb6-3a62-bf51-e3c70331b294",
                                                "text": "Il apparaît ainsi que les applications nécessitant une très grande ténacité tireront avantage de l'utilisation des aciers rapides, à condition que le niveau des températures locales reste bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f6fb2c-0a47-3e6d-b6a2-49dce1ee2907",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Attachement invariable à une idée, à un projet, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0376de44-d287-4a17-ab2f-64a1dc9a2815",
                                                "sense_id": "98f6fb2c-0a47-3e6d-b6a2-49dce1ee2907",
                                                "text": "Cet homme a beaucoup de ténacité."
                                            },
                                            {
                                                "example_id": "240d2c6b-ccce-4b8a-85d0-f16d9e8e9dbc",
                                                "sense_id": "98f6fb2c-0a47-3e6d-b6a2-49dce1ee2907",
                                                "text": "Il montre bien de la ténacité pour une chose qui n’en vaut pas la peine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6243a9b-2564-3c81-a1fc-bbdf8d795eae",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Faculté de retenir toujours ou longtemps ce qu’elle a appris, en parlant de la mémoire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7df761-24a2-431c-afc5-c22ac8111f2b",
                                                "sense_id": "b6243a9b-2564-3c81-a1fc-bbdf8d795eae",
                                                "text": "Sa mémoire est d’une grande ténacité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
