                                    {
                                        "sense_id": "172a4cb0-a910-3412-a4dd-c75872979437",
                                        "entry_id": "8d9115e5-b1dd-3935-9890-60a1d7b85125",
                                        "glosses": [
                                            "ein Objekt als Ganzes betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7efd1a-2181-4a50-809f-76fcd919b887",
                                                "sense_id": "172a4cb0-a910-3412-a4dd-c75872979437",
                                                "text": "Ein ganzheitlich therapeutischer Ansatz geht weit über eine symptombeseitigende Therapie hinaus."
                                            },
                                            {
                                                "example_id": "6a93f43c-9e24-4438-a608-585fa07562e9",
                                                "sense_id": "172a4cb0-a910-3412-a4dd-c75872979437",
                                                "text": "Es ist oft angebracht, ein System/ einen Organismus nicht nur in seinen Einzelteilen, sondern vielmehr ganzheitlich zu betrachten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
