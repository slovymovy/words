                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daf2ca91-b05e-46e4-b310-50cb57889ed9",
                                "sense_id": "b79daeea-581b-34a2-bd99-f9652a7ff77f",
                                "text": "Е́сли пассажи́р уже распеча́тал проездно́й докуме́нт в ка́ссе и́ли термина́ле самообслу́живания, возвраща́ть его́ придется по станда́ртной процеду́ре, то есть через ка́ссу.",
                                "translation": "If a passenger already printed out their travel document at a ticket window or a self-service terminal then returning the document will have to be done in the standard way, that is, at a ticket window.",
                                "english": "If a passenger already printed out their travel document at a ticket window or a self-service terminal then returning the document will have to be done in the standard way, that is, at a ticket window."
                            }
                        ]
                    }
