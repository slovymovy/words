                ],
                "senses": [
                    {
                        "sense_id": "9ead35af-524d-3111-802e-4c328b665754",
                        "entry_id": "b3db28ee-b591-3e36-9b1f-6ca23d52efd1",
                        "glosses": [
                            "Moyen thérapeutique qui consiste à verser en nappe une certaine quantité d'eau sur une partie du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06d9fbbd-d654-4212-9aa4-8cec694955c3",
                                "sense_id": "9ead35af-524d-3111-802e-4c328b665754",
                                "text": "Modelage sous affusion: Massage effectué à 2 ou 4 mains sous une fine pluie d’eau de mer chaude, pour une véritable détente et relaxation musculaire."
                            },
                            {
                                "example_id": "9bd9e90e-072d-4b07-aa13-f501b0d33c10",
                                "sense_id": "9ead35af-524d-3111-802e-4c328b665754",
                                "text": "Catherine avait assis à dessein sa victime sur un tertre d’une faible élévation, auprès de la source où elle lui fit reprendre ses sens avec une affusion d’eau froide."
                            },
                            {
                                "example_id": "d41f793b-823a-4dfd-b0e5-157ebcc65c3a",
                                "sense_id": "9ead35af-524d-3111-802e-4c328b665754",
                                "text": "Cette restauration de la perméabilité rénale n'est pas due autant a la cure de boisson qu'à l'affusion lombaire."
                            },
                            {
                                "example_id": "00a84e7c-7869-48fe-ad1e-1bb7479f3590",
                                "sense_id": "9ead35af-524d-3111-802e-4c328b665754",
                                "text": "On réchauffa du mieux qu’on put à l’aide de couvertures et d’affusions brûlantes ce corps qui se glaçait."
                            }
                        ]
                    }
                ],
