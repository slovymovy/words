                    "frequency": "Middle",
                    "semantic_group_id": "periode_historique",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "De nombreux monuments construits pendant l'<w>Antiquité</w> sont encore visibles en Italie et en Grèce."
