            {
                "entry_id": "94d9ce1d-f7c8-3633-a7b7-2f1c1e59db09",
                "word": "moil",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "91ade7d7-0867-4a84-9de1-8c573f32f0bc",
                        "entry_id": "94d9ce1d-f7c8-3633-a7b7-2f1c1e59db09",
                        "tags": [
                            "plural"
                        ],
                        "form": "moils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de81aa2a-3258-3915-bdf4-9833619e23fe",
                        "entry_id": "94d9ce1d-f7c8-3633-a7b7-2f1c1e59db09",
                        "glosses": [
                            "Hard work."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8c135694-96a8-483e-92a2-ec0e84c85e51",
                                "sense_id": "de81aa2a-3258-3915-bdf4-9833619e23fe",
                                "text": "I finally decided, my heart was really in my singing rather than in the drab, hardy soul- searing toil and moil of a collier's existence."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0b27b5f-7792-3a8d-bbed-a31cd9f43c2f",
                        "entry_id": "94d9ce1d-f7c8-3633-a7b7-2f1c1e59db09",
                        "glosses": [
                            "Confusion, turmoil."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cfe91ace-e498-4045-803e-2b492c624299",
                                "sense_id": "e0b27b5f-7792-3a8d-bbed-a31cd9f43c2f",
                                "text": "Croft no longer saw anything clearly; he could not have said at that moment where his hands ended and the machine gun began; he was lost in a vast moil of noise out of which individual screams and shouts etched in his mind for an instant."
                            }
                        ]
                    },
                    {
                        "sense_id": "7af7e69f-7f95-36c8-b1f2-91e85711cf17",
                        "entry_id": "94d9ce1d-f7c8-3633-a7b7-2f1c1e59db09",
                        "glosses": [
                            "A spot; a defilement."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4a7a179a-4b90-477c-ac85-a89a5f14cd85",
                                "sense_id": "7af7e69f-7f95-36c8-b1f2-91e85711cf17",
                                "text": "You'd suppose\nA finished generation, dead of plague,\nSwept outward from their graves into the sun,\nThe moil of death upon them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34ee34a7-08f5-4627-875d-0fc51dbd81f8",
                        "source_entry_id": "94d9ce1d-f7c8-3633-a7b7-2f1c1e59db09",
                        "source_sense_description": "hard work",
                        "target_lang_word": "dřina",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dřina",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1d36cf0e-8f10-3886-bd0d-a8db8bf10246",
