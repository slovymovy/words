                        "glosses": [
                            "grappig lied dat heel populair is tijdens carnaval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8fb8856-8942-4d2a-8040-d8dbaca2a71f",
                                "sense_id": "71b0ac13-3f3d-3834-8337-41440f059f1c",
                                "text": "In 1972 scoorde ze ook met de door drs. P. geschreven carnavalshit Wat heb je gedaan Daan."
                            },
                            {
                                "example_id": "a56d262d-0cbd-46df-a679-43b654b0c373",
                                "sense_id": "71b0ac13-3f3d-3834-8337-41440f059f1c",
                                "text": "'Geef ze de banaan'. Zo heet de carnavalshit die Haïti's president Michel Martelly uitbracht in de laatste week van zijn bewogen presidentschap. Het nummer roept veel weerstand op en verhevigt het burgerprotest dat tegen hem gaande is."
                            },
                            {
                                "example_id": "f85614e3-a03d-48a2-9868-2edd1398e596",
                                "sense_id": "71b0ac13-3f3d-3834-8337-41440f059f1c",
                                "text": "Het lied is gratis te downloaden op de site van André van Duin. Hij hoopt op een carnavalshit. De komiek zegt niets met carnaval te hebben, maar heeft het nummer wel snel uitgebracht vanwege het feest."
                            }
                        ]
                    }
