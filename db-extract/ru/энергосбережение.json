                    },
                    {
                        "translation_id": "7c2b9b9b-762c-4ff7-b4f8-3d28347b0c37",
                        "source_entry_id": "c0f66605-bf14-3960-99ad-b4f11f739ab1",
                        "source_sense_id": "b33fc725-e56a-394c-8aa3-79b2ef46d01d",
                        "target_lang_word": "Energieeinsparung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Energieeinsparung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f626d3a-2a35-30c3-a436-5216cc1b936a",
                                        "entry_id": "b0fdbc8a-42c3-342f-a798-6927ca9dbe7e",
                                        "glosses": [
                                            "Verringerung des Verbrauchs von Energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acdd92db-42ea-4cf3-87c7-45d3294edead",
                                                "sense_id": "5f626d3a-2a35-30c3-a436-5216cc1b936a",
                                                "text": "Die Menschheit verbraucht Jahr für Jahr mehr Energie und wäre, im Interesse des Arterhalt, mit Energieeinsparung gut bedient, denn die Erde liefert diese nur begrenzt und einen Plan B hat der Mensch bisher nicht gefunden."
                                            },
                                            {
                                                "example_id": "125ef549-8ed7-4019-b71a-5e6704218ce8",
                                                "sense_id": "5f626d3a-2a35-30c3-a436-5216cc1b936a",
                                                "text": "„Der Wärmeschutz der Gebäudehülle, der so genannte bauliche Wärmeschutz, ist hinsichtlich Investitionskosten und Lebensdauer die langfristig betrachtet wirksamste Maßnahme zur Energieeinsparung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
