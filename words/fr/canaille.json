            "senses": [
                {
                    "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                    "sense_definition": "Qui a un caractère gouailleur, polisson ou légèrement insolent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "allure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il avait un petit air <w>canaille</w> qui amusait beaucoup ses camarades de classe."
                        },
                        {
                            "text": "Elle lui adressa un sourire <w>canaille</w> avant de s'enfuir en courant."
                        }
                    ],
                    "common_phrases": [
