                ],
                "senses": [
                    {
                        "sense_id": "cd8c9545-7adc-3264-9035-f063643862a5",
                        "entry_id": "bd22841e-46e4-3fef-abbe-b273d0c59cc2",
                        "glosses": [
                            "gut genährte Person mit normaler Konstitution und ohne Mangelerscheinungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "875c992f-1d23-416f-b51e-a6362c2ca9ba",
                                "sense_id": "cd8c9545-7adc-3264-9035-f063643862a5",
                                "text": "„Der Eutrophiker wird mit dem Infekt schnell fertig und der Status quo ante bezüglich des Ernährungszustandes ist schnell wieder hergestellt.“"
                            },
                            {
                                "example_id": "6c5d8ab8-77d6-4c18-88d0-b527d33e1985",
                                "sense_id": "cd8c9545-7adc-3264-9035-f063643862a5",
                                "text": "„Der Atrophiker muß — um seine Körpertemperatur zu wahren — einen wesentlich größeren Anteil der Nahrung in Wärme umwandeln als der Eutrophiker.“"
                            },
                            {
                                "example_id": "c6b7716d-86b1-41c7-ac7b-ea59aa4147e4",
                                "sense_id": "cd8c9545-7adc-3264-9035-f063643862a5",
                                "text": "„Will man sich eines Vergleiches aus der Pflanzenwelt bedienen, so könnte man sagen: der Eutrophiker gleicht einer blühenden, der Dystrophiker einer kümmernden und der Atrophiker einer welken Pflanze.“"
                            },
                            {
                                "example_id": "80f0a2db-622f-4104-947b-2e2b31b9a7bb",
                                "sense_id": "cd8c9545-7adc-3264-9035-f063643862a5",
                                "text": "„Wäre mit diesen vorübergehenden krankhaften Erscheinungen der verschiedene Einfluß der Impfung auf den Organismus des Eutrophikers und Dystrophikers erledigt, so könnte eine wesentliche Bedeutung dem Zustand des Kindes für den Ablauf der Impfung kaum zugesprochen werden.“"
                            },
                            {
                                "example_id": "a458848d-e1ff-4d56-93f0-8d2aaec8dbed",
                                "sense_id": "cd8c9545-7adc-3264-9035-f063643862a5",
                                "text": "„Nach ihrem Ernährungszustande waren 10 der Kinder Eutrophiker oder diesen nahestehend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
