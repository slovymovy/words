        "fr-extract.jsonl": [
            {
                "entry_id": "2e45f2dd-6868-311e-8571-ba1ba7563200",
                "word": "potion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2b85152f-a9b0-4295-b7da-430ee2e49c6f",
                        "entry_id": "2e45f2dd-6868-311e-8571-ba1ba7563200",
                        "tags": [
                            "plural"
                        ],
                        "form": "potions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d907a681-b3ad-3f93-886f-192fad1fff2d",
                        "entry_id": "2e45f2dd-6868-311e-8571-ba1ba7563200",
                        "glosses": [
                            "Remède liquide, que l’on administre généralement par cuillerées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dd8e2e3-b82e-4bb8-9af0-ba6d841c070a",
                                "sense_id": "d907a681-b3ad-3f93-886f-192fad1fff2d",
                                "text": "Je vais vous faire envoyer une potion calmante que vous donnerez à mademoiselle pour qu’elle dorme, elle a besoin de sommeil."
                            },
                            {
                                "example_id": "19a86a69-90d6-4dd3-8df3-8e606cdc7e04",
                                "sense_id": "d907a681-b3ad-3f93-886f-192fad1fff2d",
                                "text": "Prendre d’heure en heure une cuillerée de potion."
                            }
                        ]
                    },
                    {
                        "sense_id": "17c16aad-170e-3d1d-bec5-22e0bee48e18",
                        "entry_id": "2e45f2dd-6868-311e-8571-ba1ba7563200",
                        "glosses": [
                            "Moyen de résoudre un problème."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7c058928-c282-4927-b4ab-90c721774030",
                                "sense_id": "17c16aad-170e-3d1d-bec5-22e0bee48e18",
                                "text": "Mais il en est des dévaluations comme des paradis artificiels : les effets s’effacent vite et la potion douce se fait soudain très amère. Dans des économies ouvertes, où la majorité des produits et des ressources est importée, toute chute de la monnaie se transmet immédiatement aux prix."
                            },
                            {
                                "example_id": "7ace5423-b9dd-40e0-b2ad-5c4512babf09",
                                "sense_id": "17c16aad-170e-3d1d-bec5-22e0bee48e18",
                                "text": "Le gouvernement présente donc plusieurs potions amères – ici un impôt en plus, là une baisse de dépenses – à partir d’un scénario bien choisi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9547b817-1c6a-48d6-b10b-85a75b206503",
                        "source_entry_id": "2e45f2dd-6868-311e-8571-ba1ba7563200",
                        "target_lang_word": "Trank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2954350d-5bc7-3565-acd0-5d2fc7836c77",
                                        "entry_id": "fbd12e61-a766-35a3-b8b4-d7e2cb473c73",
                                        "glosses": [
                                            "flüssiges Nahrungsmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d8f16c-a9ad-4abe-9d60-f27793d3b494",
                                                "sense_id": "2954350d-5bc7-3565-acd0-5d2fc7836c77",
                                                "text": "Der Trank ist gesund und aufbauend."
                                            },
                                            {
                                                "example_id": "c193b507-dd3e-4b2f-ab79-8336c49a08c0",
                                                "sense_id": "2954350d-5bc7-3565-acd0-5d2fc7836c77",
                                                "text": "„Einerseits verwunderlich, andererseits schon wieder logisch ist dann die Tatsache, dass durch das vermehrte Auftauchen von hübsch anzuschauenden, schaumgekrönten Kaffeespezialitäten à la Cappuccino, Latte Macchiato oder Milchkaffee auch die Damenwelt ungetrübte Freude an dem schwarzen Trank bekommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e66e272e-38bf-4782-b300-48172dcfd60f",
                        "source_entry_id": "2e45f2dd-6868-311e-8571-ba1ba7563200",
