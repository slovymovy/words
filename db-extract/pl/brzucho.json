                ],
                "senses": [
                    {
                        "sense_id": "bf2cad0e-3b6c-3b83-a93b-cf3f642f7108",
                        "entry_id": "e6e5e5e3-c9ab-37b5-bea5-8d92ca41fd52",
                        "glosses": [
                            "augmentative of brzuch (“belly”) (abdomen)"
                        ],
                        "tags": [
                            "augmentative",
                            "colloquial",
                            "form-of",
                            "humorous",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "0d95f4ed-4a94-4573-a533-a97766b1b6f8",
                                "sense_id": "bf2cad0e-3b6c-3b83-a93b-cf3f642f7108",
                                "text": "wielkie brzucho",
                                "translation": "big belly",
                                "english": "big belly"
                            },
                            {
                                "example_id": "a2430d29-2199-4c08-a342-c8f56888ab44",
                                "sense_id": "bf2cad0e-3b6c-3b83-a93b-cf3f642f7108",
                                "text": "brzucho boli",
                                "translation": "one's belly hurts",
                                "english": "one's belly hurts"
                            },
                            {
                                "example_id": "4a7aa8e6-f88e-477e-964b-b16d18298c56",
                                "sense_id": "bf2cad0e-3b6c-3b83-a93b-cf3f642f7108",
                                "text": "brzucho rośnie",
                                "translation": "one's belly grows/is growing",
                                "english": "one's belly grows/is growing"
                            },
                            {
                                "example_id": "f06a514c-30ef-4ac6-9c72-be27604a96c6",
                                "sense_id": "bf2cad0e-3b6c-3b83-a93b-cf3f642f7108",
                                "text": "Wszystko tam obżartuchy takie, jeno w to brzucho wierzą.",
                                "translation": "All there, they are such gluttons, they believe in this belly.",
                                "english": "All there, they are such gluttons, they believe in this belly."
                            },
                            {
                                "example_id": "c6490c44-e5ea-46a6-93db-b78e1df7abee",
                                "sense_id": "bf2cad0e-3b6c-3b83-a93b-cf3f642f7108",
                                "text": "Boli go brzucho, proszę panią — odpowiedział Paluch donośnie. — Kazał tego… wytłumaczyć, że idzie po te… proszki.",
                                "translation": "His belly hurts, madam — Paluch replied loudly. — He ordered this… explain, that he was going to get these… powders.",
                                "english": "His belly hurts, madam — Paluch replied loudly. — He ordered this… explain, that he was going to get these… powders."
                            },
                            {
                                "example_id": "7a4399f8-c7c8-4f62-bf12-3294bd564051",
                                "sense_id": "bf2cad0e-3b6c-3b83-a93b-cf3f642f7108",
                                "text": "Wolf-Dębczak chichrał się, choć jeszcze przed chwilą rzewnie płakał. Wielkie brzucho podrygiwało w takt chichotu.",
                                "translation": "Wolf-Dębczak giggled, although he had been crying lashingly only a moment ago. His big belly jiggled to the rhythm of his giggles.",
                                "english": "Wolf-Dębczak giggled, although he had been crying lashingly only a moment ago. His big belly jiggled to the rhythm of his giggles."
                            },
                            {
                                "example_id": "36b15198-7f85-46db-81c9-1500194c7833",
                                "sense_id": "bf2cad0e-3b6c-3b83-a93b-cf3f642f7108",
                                "text": "Prędki to on jest do golonki i piwa — krzyknęła chuda jejmość w staromodnej długiej sukience i w kapeluszu na głowie. — Zobacz pani, jakie ma brzucho.",
                                "translation": "He's fast for a pork knuckle and beer — shouted a skinny lady in an old-fashioned long dress and a hat on her head. — Madam, see how his belly looks like.",
                                "english": "He's fast for a pork knuckle and beer — shouted a skinny lady in an old-fashioned long dress and a hat on her head. — Madam, see how his belly looks like."
                            }
                        ]
                    }
