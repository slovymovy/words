            "senses": [
                {
                    "sense_id": "6bbc527b-98d1-337a-b44f-b9fce1f95b9c",
                    "sense_definition": "A practical approach to problems and affairs, focusing on realistic consequences and facts rather than emotions or ideals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "practicality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her natural <w>pragmatism</w> helped the company survive during the economic crisis."
                        },
                        {
                            "text": "He approached the project with sensible <w>pragmatism</w> rather than theoretical perfection."
                        }
                    ],
                    "synonyms": [
                        "practicality",
                        "realism",
                        "matter-of-factness"
                    ],
                    "antonyms": [
                        "idealism"
                    ],
                    "common_phrases": [
                        "political pragmatism",
                        "sheer pragmatism"
                    ]
                },
                {
                    "sense_id": "19232cba-962f-38ca-a2d9-5f99e46653af",
                    "sense_definition": "The political stance or practice of resolving problems through compromises and practical solutions rather than strict adherence to ideology.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "practicality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prime minister was praised for choosing <w>pragmatism</w> over rigid party dogma."
                        },
                        {
                            "text": "In international diplomacy, cautious <w>pragmatism</w> usually achieves more lasting results than heated rhetoric."
                        }
                    ],
                    "synonyms": [
                        "realpolitik"
                    ],
                    "antonyms": [
                        "idealism"
                    ],
                    "common_phrases": [
                        "economic pragmatism"
                    ]
                },
                {
                    "sense_id": "36c150da-26cf-33e6-929a-3b842fc90748",
                    "sense_definition": "A philosophical tradition holding that the meaning and truth of beliefs or concepts are evaluated by their practical effects and real-world success.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "ideology_or_movement_name",
                    "examples": [
                        {
                            "text": "American <w>pragmatism</w> was primarily developed by philosophers like William James and John Dewey."
                        },
                        {
                            "text": "The professor lectured on the fundamental principles of classical <w>pragmatism</w>."
                        }
                    ],
                    "antonyms": [
                        "contemplation"
                    ],
                    "common_phrases": [
                        "American pragmatism"
                    ]
                },
                {
                    "sense_id": "0b9dcf63-3bdb-373a-93ab-875fa491d9b8",
                    "sense_definition": "The tendency to interfere inappropriately in the affairs of others; officiousness or meddlesomeness.",
