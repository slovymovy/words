                        "source_sense_id": "81d042c0-6d49-3372-abbc-8376967c2c23",
                        "target_lang_word": "airtight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airtight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a74cecbd-1a61-3287-8ecf-350b86f3a0f8",
                                        "entry_id": "f92d3cec-1562-359a-a41f-87a6463126b7",
                                        "glosses": [
                                            "Impermeable to air or other gases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8102d0d-9b9b-4473-8fd5-800b79cc623c",
                                                "sense_id": "a74cecbd-1a61-3287-8ecf-350b86f3a0f8",
                                                "text": "Tupperware founder Earl Tupper in 1946 introduced its plastic products to the public, and subsequently patented their flexible airtight seal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61fb043d-f584-3fdc-94e1-65f04c2b255a",
                                        "entry_id": "f92d3cec-1562-359a-a41f-87a6463126b7",
                                        "glosses": [
                                            "Having no weak points or flaws."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55d9c33f-2a1a-4cfb-87a1-a3df93c0aa81",
                                                "sense_id": "61fb043d-f584-3fdc-94e1-65f04c2b255a",
                                                "text": "We have an airtight argument they won’t be able to punch holes in."
                                            },
                                            {
                                                "example_id": "c481e8c0-46ce-4709-ae61-7a182e4c7be9",
                                                "sense_id": "61fb043d-f584-3fdc-94e1-65f04c2b255a",
                                                "text": "She creates an airtight world of her imagining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6790ce76-3b90-308a-86b7-45283d35eb0b",
                                        "entry_id": "f92d3cec-1562-359a-a41f-87a6463126b7",
                                        "glosses": [
                                            "Highly reserved in some matter, particularly tight-lipped or tight-fisted."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d0808b0-37e1-4281-82c8-21524c7443d2",
                                                "sense_id": "6790ce76-3b90-308a-86b7-45283d35eb0b",
                                                "text": "when Roger asked for $100 to take the preliminary steps to establish his claim, Mike yelled like a Hebrew auctioneer, for he was air-tight and squeezed a dollar until the woman on it yelled."
                                            },
                                            {
                                                "example_id": "8b497c24-c41f-405c-91fe-df1a6000deff",
                                                "sense_id": "6790ce76-3b90-308a-86b7-45283d35eb0b",
                                                "text": "He was ‘air-tight,’ close-mouthed, and had but few confidants or intimate friends, but numerous acquaintances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e9d73a8-cb99-3def-8377-113335845b82",
                                        "entry_id": "f92d3cec-1562-359a-a41f-87a6463126b7",
                                        "glosses": [
                                            "Triply penetrated simultaneously in the vagina, anus and mouth."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
