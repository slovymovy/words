                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7f831b-b4ff-4fdb-8ddd-0f7b928c25bb",
                                                "sense_id": "c12ecd9d-76ed-3adb-9135-d5a4584237d9",
                                                "text": "Gdyby nie andzia, byłaby główka."
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "9cd85f3e-cede-3567-94d5-9e78b15995fc",
                                        "entry_id": "e3af6c09-c969-3d53-98d1-2aace7077850",
                                        "glosses": [
                                            "w piłce nożnej: odbicie piłki głową"
