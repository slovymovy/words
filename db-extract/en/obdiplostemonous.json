                "senses": [
                    {
                        "sense_id": "51d9491e-661e-3ce1-ab87-ce1581aeb4a9",
                        "entry_id": "d8f4ad03-93c7-3c61-9f1c-664a4fd59383",
                        "glosses": [
                            "Having two sets of stamens in alternating whorls, with the outer whorl opposite the petals."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a45580b2-ff74-4c2b-b7b6-617d121e588a",
                                "sense_id": "51d9491e-661e-3ce1-ab87-ce1581aeb4a9",
                                "text": "[…] the stamens, which are definite in number, normally obdiplostemonous (namely, the stamens are in two alternating whorls, those of the outer whorl opposite the petals – see Fig. 102) […]"
                            },
                            {
                                "example_id": "6bf1443d-49d8-4707-b518-65d5891a0932",
                                "sense_id": "51d9491e-661e-3ce1-ab87-ce1581aeb4a9",
                                "text": "This arrangement led van Steenis (1932) to hypothesize an obdiplostemonous ancestor for the family."
                            },
                            {
                                "example_id": "d34542d9-d769-4aad-88e4-baa487ebfc8e",
                                "sense_id": "51d9491e-661e-3ce1-ab87-ce1581aeb4a9",
                                "text": "Diplostemonous and obdiplostemonous flowers may also occur in the same family (e.g. Rutaceae); Zygophyllaceae are obdiplostemonous, Liliaceae are diplostemonous."
                            },
                            {
                                "example_id": "9d6495ea-bbfc-40c5-8be5-686fd332becd",
                                "sense_id": "51d9491e-661e-3ce1-ab87-ce1581aeb4a9",
                                "text": "In the genus Mitella the androecium can exceptionally be more variable, ranging from obdiplostemonous to (ob)haplostemonous arrangements."
                            }
                        ]
                    }
