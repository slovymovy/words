                "senses": [
                    {
                        "sense_id": "6f52c73f-87ea-3c7b-99b8-6c61df79320b",
                        "entry_id": "22e462a6-894f-3a44-af7f-32533a592cb9",
                        "glosses": [
                            "Maquis formé par des buissons et des arbustes que l’on trouve en Californie et au Mexique en climat méditerranéen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "556bf7ce-42cf-4ee7-9c2d-b124203677b0",
                                "sense_id": "6f52c73f-87ea-3c7b-99b8-6c61df79320b",
                                "text": "Lorsque le chaparral brûle, ce qui arrive souvent, on assiste à une brusque flambée de germinations, puis de floraisons d’herbes annuelles."
                            },
                            {
                                "example_id": "ced3073d-72bb-4da0-ab74-d6676e206e2f",
                                "sense_id": "6f52c73f-87ea-3c7b-99b8-6c61df79320b",
                                "text": "La plus grande partie de la journée - et de l’année - le soleil piégeait la ville dans un halo de poussière, tout au bout des champs de chaparral : un paradis pour serpents et crapauds-buffles, limaces et lézards, un enfer pour les porcs et les natifs du Tennessee..."
                            },
                            {
                                "example_id": "9da11d6b-f2df-4c67-a2e0-efc0492b85f6",
                                "sense_id": "6f52c73f-87ea-3c7b-99b8-6c61df79320b",
                                "text": "On ne voit rien au volant d'une voiture car la vitesse crée l'illusion d'un paysage intact - à perte de vue, un chaparral d'arbustes épineux couvrant plaines et collines ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdf43f8b-e84d-4346-980b-a4e45f026b39",
                        "source_entry_id": "22e462a6-894f-3a44-af7f-32533a592cb9",
                        "source_sense_id": "6f52c73f-87ea-3c7b-99b8-6c61df79320b",
