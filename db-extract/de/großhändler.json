                "senses": [
                    {
                        "sense_id": "1bbadffa-e42c-3a50-8c08-288c162aa131",
                        "entry_id": "4cc246f7-df9f-3533-a8c7-c25b9d2f5156",
                        "glosses": [
                            "Person oder Firma, die Großhandel betreibt, also Waren von Produzenten bezieht und weitervertreibt, zum Beispiel an Einzelhändler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2838d4ac-1f8c-4a2f-a2d5-1017d2286afc",
                                "sense_id": "1bbadffa-e42c-3a50-8c08-288c162aa131",
                                "text": "„Doch sicherheitshalber verkaufte er nicht an die Großhändler der unmittelbaren Umgebung, denn da war die Gefahr zu groß, dass mal einer hereinschneite und feststellte, dass auf Bosses Hof kein einziges Huhn seine Körner pickte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f60cbd2d-265e-4b29-80d3-0175e57a2943",
                        "source_entry_id": "4cc246f7-df9f-3533-a8c7-c25b9d2f5156",
                        "source_sense_id": "1bbadffa-e42c-3a50-8c08-288c162aa131",
                        "source_sense_description": "Person oder Firma, die Großhandel betreibt",
                        "target_lang_word": "grossiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grossiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af41949f-01c0-3269-bf58-224886c92a07",
                                        "entry_id": "81db20c4-a29b-3c7b-ac65-6db1fc863141",
                                        "glosses": [
                                            "Personne ou entreprise qui fait le commerce en gros, c’est-à-dire l’intermédiaire entre producteur et détaillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82203c3d-43d0-4821-b74a-4fe8d5e0d210",
                                                "sense_id": "af41949f-01c0-3269-bf58-224886c92a07",
                                                "text": "Le grossiste assume une fonction qui consiste à acheter la production ou à l’importation des marchandises d’une façon continue, en quantités importantes, à les stocker, à y incorporer éventuellement du service, et à assurer l’approvisionnement régulier des utilisateurs professionnels (détaillants, collectivités, artisans…)."
                                            }
                                        ]
                                    }
                                ]
                            }
