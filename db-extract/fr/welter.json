                        ],
                        "examples": [
                            {
                                "example_id": "34691f9e-501f-4b34-a5d5-d16c2741bf63",
                                "sense_id": "f0df0e11-6bed-3ae8-91c6-0827f5e1340b",
                                "text": "Le welter parisien Souleymane Cissokho (25 ans, -69 kg) a remporté avec brio son premier tour face au Hongrois Imre Bacskai (30-27)."
                            },
                            {
                                "example_id": "14c0ac0c-a1ad-48c8-b3ee-d4e488129e7a",
                                "sense_id": "f0df0e11-6bed-3ae8-91c6-0827f5e1340b",
                                "text": "Lésé à Pékin en demi-finales contre le Dominicain Felix Diaz (10-12), le welter (-69 kg) a été déclaré perdant d’un combat qu’il avait dominé de la tête et des épaules face au champion du monde ukrainien Tars Shelestyuk (18-18, décision préférentielle)."
                            },
                            {
                                "example_id": "d50bdcba-7779-4a14-bd56-c84ad89a7f93",
                                "sense_id": "f0df0e11-6bed-3ae8-91c6-0827f5e1340b",
                                "text": "Et, parmi eux, des poids lourds, des moyens et des welters, comme Borloo, Estrosi, NKM, Darmanin ou Solère."
                            }
                        ]
                    }
