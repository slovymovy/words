                    "frequency": "High",
                    "semantic_group_id": "activite_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, elle fait un quart d'heure de <w>gym</w> pour rester en forme.",
                            "target_lang_translations": {
                                "en": "Every morning she does fifteen minutes of <w>gym</w> to stay in shape.",
                                "ru": "Каждое утро она делает четверть часа <w>гимнастики</w>, чтобы оставаться в форме.",
                                "de": "Jeden Morgen macht sie eine Viertelstunde <w>Gymnastik</w>, um in Form zu bleiben.",
                                "es": "Cada mañana, ella hace un cuarto de hora de <w>gimnasia</w> para mantenerse en forma.",
                                "zh": "她每天早上都做一刻钟<w>健身操</w>，以保持身材。"
                            }
                        },
                        {
                            "text": "Je me suis inscrit à un cours de <w>gym</w> pour reprendre le sport en douceur.",
                            "target_lang_translations": {
                                "en": "I signed up for a <w>gym</w> class to ease back into exercise gently.",
                                "ru": "Я записался на занятия <w>гимнастикой</w>, чтобы постепенно вернуться к спорту.",
                                "de": "Ich habe mich für einen <w>Gymnastikkurs</w> angemeldet, um sanft wieder in den Sport einzusteigen.",
                                "es": "Me apunté a una clase de <w>gimnasia</w> para retomar el deporte poco a poco.",
                                "zh": "我报名参加了<w>健身操</w>课，想循序渐进地重新开始运动。"
                            }
                        }
