                "senses": [
                    {
                        "sense_id": "78430203-e6f1-3247-b405-f93c1fd8bcbb",
                        "entry_id": "34b93902-a08b-38a0-8b92-3b0333633067",
                        "glosses": [
                            "Partisan du Régime de Vichy et de Pétain pendant l’occupation allemande de la France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ac39b2-1b97-48c4-aadc-d34bc83a0db6",
                                "sense_id": "78430203-e6f1-3247-b405-f93c1fd8bcbb",
                                "text": "Philippe Henriot, vichyste notoire, fut exécuté par la résistance française en juin 1944."
                            },
                            {
                                "example_id": "893202e8-5d95-4e62-947b-b80a6a5689bd",
                                "sense_id": "78430203-e6f1-3247-b405-f93c1fd8bcbb",
                                "text": "Cette époque est difficile à évoquer et rares sont ceux qui en ont bien parlé : il y avait, parmi les externes, des vichystes, des proches de la milice et même des miliciens, qui nous avaient identifiés."
                            }
                        ]
                    }
