                        "entry_id": "54e0d43a-bd59-3f98-bb53-65ab76cce1f3",
                        "glosses": [
                            "Astonished; taken aback."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b901207f-dcf0-30c3-9b29-bd72f7abfbe2",
                        "entry_id": "54e0d43a-bd59-3f98-bb53-65ab76cce1f3",
                        "glosses": [
                            "Arranged in a way that is not uniform."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85265f23-71b8-4770-9d28-a93bb66f5ff4",
                                "sense_id": "b901207f-dcf0-30c3-9b29-bd72f7abfbe2",
                                "text": "The U.S. Senate holds staggered elections, with only one third of the seats being filled every two years."
                            }
                        ]
                    },
                    {
                        "sense_id": "43770ea9-07e0-3deb-8bf7-7409e6c57a09",
                        "entry_id": "54e0d43a-bd59-3f98-bb53-65ab76cce1f3",
                        "glosses": [
                            "Not directly opposite each other."
                        ],
                        "tags": [
                            "of platforms at a station"
                        ],
                        "examples": [
                            {
                                "example_id": "e6a3e0af-f9ee-4498-9b51-9bd1307f4d51",
                                "sense_id": "43770ea9-07e0-3deb-8bf7-7409e6c57a09",
                                "text": "Many of the wayside stations have staggered platforms, a common arrangement on the S.E.R."
                            },
                            {
                                "example_id": "e2b3c24c-f8c3-425a-9d1a-2ff76f74b158",
                                "sense_id": "43770ea9-07e0-3deb-8bf7-7409e6c57a09",
                                "text": "The line now veers slightly south through a wooded cutting before arriving at the staggered platforms of Stocksmoor station (6½ miles) and a further ¾-mile stretch of level track leads to Shepley & Shelley (7¼ miles)."
                            }
                        ]
                    }
                ],
