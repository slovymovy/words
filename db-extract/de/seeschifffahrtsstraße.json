                "senses": [
                    {
                        "sense_id": "b98eec20-cab9-3df5-934a-06f4c9ca609b",
                        "entry_id": "36cb6fac-40ad-33b7-b649-6f74257c7212",
                        "glosses": [
                            "Wasserstraße für die Seeschiffahrt, Wasserfläche, auf der die deutsche Seeschifffahrtsstraßen-Ordnung gilt, zum Beispiel das Gewässer der Drei-Meilen-Zone vor der deutschen Küste"
                        ],
                        "tags": [
                            "insbesondere"
                        ],
                        "examples": [
                            {
                                "example_id": "dcdb3015-7444-4b58-981e-455ff125f8a2",
                                "sense_id": "b98eec20-cab9-3df5-934a-06f4c9ca609b",
                                "text": "Unterhalb des Hamburger Hafens ist die Elbe eine Seeschifffahrtsstraße, oberhalb davon eine Binnenschifffahrtsstraße."
                            },
                            {
                                "example_id": "0f9b5b10-7686-49bd-b5cd-9db7b4f6ebf2",
                                "sense_id": "b98eec20-cab9-3df5-934a-06f4c9ca609b",
                                "text": "„Der Sportbootführerschein mit dem Geltungsbereich Seeschifffahrtsstraßen wird benötigt, wenn man ein Sportboot mit mehr als 15 PS Motorleistung (Stand 05/2017) auf den deutschen Seeschifffahrtsstraßen bewegen will.“"
                            },
                            {
                                "example_id": "b40cd6de-b863-405a-a28e-9b101fe1caa9",
                                "sense_id": "b98eec20-cab9-3df5-934a-06f4c9ca609b",
                                "text": "„Da dieser Kanal aber zu lang (80 km) und zu seicht (51/.2 m) war, entsprach er mit der Zeit den Anforderungen an eine Seeschifffahrtsstraße nicht mehr.“ (1899)"
                            },
                            {
                                "example_id": "e6992fc1-50d2-47d4-bd9a-71c032028bb1",
                                "sense_id": "b98eec20-cab9-3df5-934a-06f4c9ca609b",
                                "text": "Die Unterweser von Bremen bis Bremerhaven ist eine Seeschifffahrtsstraße und kann mit großen Seeschiffen befahren werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
