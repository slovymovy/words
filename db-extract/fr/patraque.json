                                        "examples": [
                                            {
                                                "example_id": "10bf2767-ad50-425e-a3b7-ff255e98d606",
                                                "sense_id": "8e819a09-a94d-3b78-a410-a070fe62704b",
                                                "text": "Her appetite did not improve, however, and she looked very thin and peaky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd475b07-57d5-355c-b144-80c22b294bc6",
                                        "entry_id": "4c9bfade-0920-3b93-96cd-4e3e772b8e5c",
                                        "glosses": [
                                            "Characterised by peaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30cb82ec-13cc-425c-bd13-a4e6ef231bc5",
                                                "sense_id": "dd475b07-57d5-355c-b144-80c22b294bc6",
                                                "text": "Or over hills with peaky tops engrail'd, / And many a tract of palm and rice, / The throne of Indian Cama slowly sail'd / A summer fann'd with spice."
                                            },
                                            {
                                                "example_id": "4aa536f4-3ec8-4c81-941d-ecef24ee759e",
                                                "sense_id": "dd475b07-57d5-355c-b144-80c22b294bc6",
                                                "text": "A wide spread of possible outcomes will give a relatively flat distribution and so indicate a risky project. A narrow spread of results will give a very peaky graph and indicate a low risk project."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
