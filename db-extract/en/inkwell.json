                                        "sense_id": "38a21cf0-f76f-348b-99b3-4030b2f806b9",
                                        "entry_id": "82bf16cb-e983-32d2-9420-f93e333b668d",
                                        "glosses": [
                                            "nádobka na inkoust používaná jako součást psacího náčiní"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885b6c1d-c8a9-4dde-970e-9063c84ba414",
                                                "sense_id": "38a21cf0-f76f-348b-99b3-4030b2f806b9",
                                                "text": "Chtěl císař ten patent podepsat a už namáčel pero do zlatého kalamáře. A jak si tak do toho zlatého kalamáře pero namáčí, tak se vám ten kalamář najednou z ničeho nic převrhl a milý patent se utopil v inkoustu."
                                            },
                                            {
                                                "example_id": "4520b087-d5ae-4bae-ac25-c9e237d811b5",
                                                "sense_id": "38a21cf0-f76f-348b-99b3-4030b2f806b9",
                                                "text": "Kousl jsem jednoho soudního lékaře při komisi do nohy, vypil jsem inkoust z kalamáře a vydělal jsem se, s odpuštěním, pánové, před celou komisí do kouta."
                                            },
                                            {
                                                "example_id": "7f1373db-b7b8-4ff5-9558-7331a107dd99",
                                                "sense_id": "38a21cf0-f76f-348b-99b3-4030b2f806b9",
                                                "text": "Potom přistoupil ku své malé skřínce, vyndal z ní arch papíru, skleněný kalamář a staré péro, dal to všecko na svou stolici a začal psáti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
