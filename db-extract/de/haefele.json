                ],
                "senses": [
                    {
                        "sense_id": "f747a68d-26e2-3f9f-a5db-4c752ac08fc6",
                        "entry_id": "f1262f5c-a11f-3729-8668-6d38dcdcac69",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd3d224-01f4-40a4-95f3-75d14e14184b",
                                "sense_id": "f747a68d-26e2-3f9f-a5db-4c752ac08fc6",
                                "text": "Frau Haefele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a0221c9b-da5e-4847-8ff7-6669f09e563c",
                                "sense_id": "f747a68d-26e2-3f9f-a5db-4c752ac08fc6",
                                "text": "Herr Haefele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dee6d853-f81d-45f9-a292-7109e2547c09",
                                "sense_id": "f747a68d-26e2-3f9f-a5db-4c752ac08fc6",
                                "text": "Die Haefeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5ebe8f75-5fa1-4981-b951-dc94db7585fb",
                                "sense_id": "f747a68d-26e2-3f9f-a5db-4c752ac08fc6",
                                "text": "Der Haefele trägt nie die Schals, die die Haefele ihm strickt."
                            },
                            {
                                "example_id": "b8ac03be-1b83-490a-8294-94841391bef8",
                                "sense_id": "f747a68d-26e2-3f9f-a5db-4c752ac08fc6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haefele kommt, geht der Herr Haefele.“"
                            },
                            {
                                "example_id": "7ada3b18-b357-4eca-8e9b-3046f0588aaa",
                                "sense_id": "f747a68d-26e2-3f9f-a5db-4c752ac08fc6",
                                "text": "Haefele kommt und geht."
                            },
                            {
                                "example_id": "7a51f942-42ff-4f44-aff6-228258e0b5e8",
                                "sense_id": "f747a68d-26e2-3f9f-a5db-4c752ac08fc6",
                                "text": "Haefeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
