                            {
                                "example_id": "f432ec8d-526b-4fe4-ab47-24a4d9b4ef76",
                                "sense_id": "99269d57-9a18-3946-9b0f-c1a06b0c1832",
                                "text": "„Gegen halb acht drehte er den Rekorder leiser, es gab immer ein grässliches Gemecker unter denen, die kamen und gingen.“"
                            },
                            {
                                "example_id": "31b0c4de-a364-4dbd-9272-c5babf032337",
                                "sense_id": "99269d57-9a18-3946-9b0f-c1a06b0c1832",
                                "text": "„Aber sie ließ sich von Hendriks Gemecker nicht abhalten.“"
                            }
                        ],
