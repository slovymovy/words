                            {
                                "target_lang_word": "rakker",
                                "target_lang_sense_clarification": "Een informele term voor een ondeugend kind."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddd09fb9-b08f-34cf-8c1d-26b828213a87",
                    "sense_definition": "A person or thing that dies or ceases to exist",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history of the world is filled with the stories of many <w>perishers</w> who could not adapt to change.",
                            "target_lang_translations": {
                                "nl": "De wereldgeschiedenis staat vol met verhalen van velen die <w>stierven</w> omdat ze zich niet konden aanpassen aan verandering."
                            }
                        },
                        {
                            "text": "He watched the insects on the wall, noting the <w>perishers</w> that succumbed to the cold.",
                            "target_lang_translations": {
                                "nl": "Hij keek naar de insecten op de muur en merkte de exemplaren op die <w>bezwijken</w> aan de kou."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand of iets dat sterft of ophoudt te bestaan."
                    },
                    "translations": {
                        "nl": []
                    }
                },
                {
                    "sense_id": "17546310-efe5-3723-bf5e-f0ca5e6c9ff9",
                    "sense_definition": "An extreme or reckless action taken without regard for consequences",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to go in a <w>perisher</w> and bet his entire savings on the final race.",
                            "target_lang_translations": {
                                "nl": "Hij besloot een <w>roekeloze gok</w> te wagen en zette al zijn spaargeld in op de laatste race."
                            }
                        },
                        {
                            "text": "After losing his job, he went in a <w>perisher</w> and spent the night drinking heavily.",
                            "target_lang_translations": {
                                "nl": "Nadat hij zijn baan verloor, deed hij een <w>roekeloze uitspatting</w> en bracht de nacht door met zwaar drinken."
                            }
                        }
                    ],
                    "synonyms": [
                        "gamble",
                        "binge"
                    ],
                    "common_phrases": [
                        "go in a perisher"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in older, informal contexts to describe reckless behavior."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een extreme of roekeloze actie ondernomen zonder rekening te houden met de gevolgen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "roekeloze gok",
                                "target_lang_sense_clarification": "onbezonnen waagstuk"
                            },
                            {
                                "target_lang_word": "roekeloze uitspatting",
                                "target_lang_sense_clarification": "onbezonnen uitbarsting"
                            }
                        ]
                    }
                }
            ]
        },
