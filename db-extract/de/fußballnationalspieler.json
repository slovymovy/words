                "senses": [
                    {
                        "sense_id": "a75f9f13-1051-3830-8319-451ae27ca268",
                        "entry_id": "1658af64-43d3-3796-8e11-fea38b796b8c",
                        "glosses": [
                            "Fußballspieler einer Mannschaft, die für ein Land spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3373768-1045-4b04-8346-3528c3a5c6f8",
                                "sense_id": "a75f9f13-1051-3830-8319-451ae27ca268",
                                "text": "„Wegen der Einreise mit einem falschen Pass nach Paraguay ist der frühere brasilianische Fußballnationalspieler Ronaldinho abermals festgenommen worden.“"
                            },
                            {
                                "example_id": "5b9f1883-bfa5-4845-9e7f-29014a6428ac",
                                "sense_id": "a75f9f13-1051-3830-8319-451ae27ca268",
                                "text": "„Der frühere Fußballnationalspieler Holger Badstuber beendet seine aktive Laufbahn.“"
                            },
                            {
                                "example_id": "7fbdee87-9444-4c0b-b323-d92888296c00",
                                "sense_id": "a75f9f13-1051-3830-8319-451ae27ca268",
                                "text": "[Über Paul Pogba] „Der 23 Jahre alte französische Fußballnationalspieler unterschrieb einen Fünfjahresvertrag mit Option auf eine weitere Saison beim englischen Rekordmeister.“"
                            },
                            {
                                "example_id": "ad687e53-4d82-428f-9941-c4051f270e42",
                                "sense_id": "a75f9f13-1051-3830-8319-451ae27ca268",
                                "text": "„Mexiko: Fußballer nach Entführung wieder frei“ […] „Seit Samstagnacht wurde der mexikanische Fußballnationalspieler Alan Pulido vermisst. Nun ist er wieder frei.“"
                            },
                            {
                                "example_id": "fe13cd82-de9f-4d70-905b-7e94ccb930a5",
                                "sense_id": "a75f9f13-1051-3830-8319-451ae27ca268",
                                "text": "„Der argentinische Fußballnationalspieler Javier Mascherano vom FC Barcelona ist wegen Steuerhinterziehung zu einer Haftstrafe von einem Jahr und einer Geldbuße von 815.000 Euro verurteilt worden.“"
                            },
                            {
                                "example_id": "a99839cc-2a44-4ba0-945d-bebf0c379126",
                                "sense_id": "a75f9f13-1051-3830-8319-451ae27ca268",
                                "text": "„Der zwölfmalige Fußballnationalspieler Mathias Normann wird vorerst nicht mehr für das norwegische Nationalteam nominiert. Das entschieden Verband und Nationaltrainer. Grund: sein anstehender Wechsel zu Dynamo Moskau.“"
                            },
                            {
                                "example_id": "af822e40-2c5d-43a5-959b-2d7ac02911f1",
                                "sense_id": "a75f9f13-1051-3830-8319-451ae27ca268",
                                "text": "[Schlagzeile:] „Corona-Fall beim DFB-Team: Fünf Fußballnationalspieler in Quarantäne“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
