        "fr-extract.jsonl": [
            {
                "entry_id": "a163c5e6-982f-33a4-b06c-6c2904231abb",
                "word": "castonguette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "331a2255-1fd8-4c49-9d65-0c70afb7266e",
                        "entry_id": "a163c5e6-982f-33a4-b06c-6c2904231abb",
                        "tags": [
                            "plural"
                        ],
                        "form": "castonguettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2cfce47e-65af-3dfa-b461-47250a2d9c34",
                        "entry_id": "a163c5e6-982f-33a4-b06c-6c2904231abb",
                        "glosses": [
                            "Carte d’assurance maladie au Québec."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "32e8f543-1076-46f3-86c8-669b0d263756",
                                "sense_id": "2cfce47e-65af-3dfa-b461-47250a2d9c34",
                                "text": "Nous nous plongeons alors dans un exposé racontant la passionnante odyssée de la castonguette ou, si vous préférez, la carte d’assurance-maladie du Québec."
                            },
                            {
                                "example_id": "06527756-5131-40d5-9d7e-5db856ef4bf2",
                                "sense_id": "2cfce47e-65af-3dfa-b461-47250a2d9c34",
                                "text": "Claude Castonguay, … a contribué à la conception et à la création d’institutions économique et sociales très importantes et des plus pertinentes pour tous les Québécois … ; il a vu son nom associé à la carte d’assurance-maladie québécoise qui est encore, à l’occasion, surnommée la « castonguette » plus de vingt ans après son implantation."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad8090ea-0752-3a17-a739-becb0d464c1a",
                        "entry_id": "a163c5e6-982f-33a4-b06c-6c2904231abb",
                        "glosses": [
                            "Assurance maladie."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7b802f8a-cbb8-4235-a2dc-d464e2b96053",
                                "sense_id": "ad8090ea-0752-3a17-a739-becb0d464c1a",
                                "text": "Malgré tout, il arrivait que les gens de cette époque tombent malades eux aussi. La consultation des médecins n’était pas encore gratuite, la « castonguette » était inconnue."
                            },
                            {
                                "example_id": "7f3d7d06-4f8c-4332-85ef-182cf0dd0b6f",
                                "sense_id": "ad8090ea-0752-3a17-a739-becb0d464c1a",
                                "text": "Bien plus âgés que les sénateurs et les juges, les médecins de chez nous font encore allègrement opérer la «castonguette» et je connais tel notaire de Rivière-du-Loup qui à 84 ans préparait toujours aussi minutieusement ses contrats."
                            }
                        ]
                    }
                ],
