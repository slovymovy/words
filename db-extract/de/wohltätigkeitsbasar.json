                ],
                "senses": [
                    {
                        "sense_id": "97d3b4bd-b863-3b83-97d9-1f71742aa04f",
                        "entry_id": "afd14056-a77a-3dd6-95e3-6290ee1108f7",
                        "glosses": [
                            "Basar, dessen Erlös zur Verbesserung der Situation von Bedürftigen oder Organisationen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ba5ac50-e105-4e5c-8ae3-9558411b85e9",
                                "sense_id": "97d3b4bd-b863-3b83-97d9-1f71742aa04f",
                                "text": "„Einige Haushalte an der Grove Street in Elmira (New York) haben für einen kleinen Wohltätigkeitsbasar ihre Habseligkeiten zusammengetragen.“"
                            },
                            {
                                "example_id": "74757d0d-9619-49b3-8b43-64e88d839db2",
                                "sense_id": "97d3b4bd-b863-3b83-97d9-1f71742aa04f",
                                "text": "„Auf dem Wohltätigkeitsbasar eines Weltpräsidenten: Bill Clinton bringt Leute, die Gutes tun wollen, mit Bedürftigen zusammen.“"
                            },
                            {
                                "example_id": "7fd32c5c-a32b-4ab6-95a2-d4490bb8b50b",
                                "sense_id": "97d3b4bd-b863-3b83-97d9-1f71742aa04f",
                                "text": "„Da echte Antiquitäten zu teuer waren, erstand sie bei Wohltätigkeitsbasaren und in diversen Trödelläden ein paar charmante, wenn auch etwas wackelige Tische und Stühle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
