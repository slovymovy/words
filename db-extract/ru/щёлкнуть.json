                    {
                        "form_id": "13c13443-3b08-4169-a80a-5d6087a99a19",
                        "entry_id": "7645cffb-270f-320d-9d78-a3ac35737053",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "щёлкнувши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc9216c1-1b06-34eb-9ba8-f5878da06620",
                        "entry_id": "7645cffb-270f-320d-9d78-a3ac35737053",
                        "glosses": [
                            "однокр. к щёлкать"
                        ],
                        "tags": [
                            "semelefactive"
                        ],
                        "examples": [
                            {
                                "example_id": "1c0b3ef8-a0ba-4834-8e63-a0798baab65c",
                                "sense_id": "cc9216c1-1b06-34eb-9ba8-f5878da06620",
                                "text": "Люблю по носу щёлкнуть — не задирайся выше ватерлинии! Скромней, дорогие товарищи…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e3c4258-72d3-4f22-9beb-d84d2b80d528",
                        "source_entry_id": "7645cffb-270f-320d-9d78-a3ac35737053",
                        "source_sense_id": "cc9216c1-1b06-34eb-9ba8-f5878da06620",
                        "target_lang_word": "claquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                        "entry_id": "feddb3a4-7779-3446-bbf6-4c44492d9498",
                                        "glosses": [
                                            "Faire un certain bruit aigu et éclatant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faef3928-2409-42ba-87e4-fcd1c020a3b6",
                                                "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                                "text": "Elle n’avait pas complètement perdu connaissance, mais elle était hors d'état de parler. Elle grelottait, et ses dents claquaient."
                                            },
                                            {
                                                "example_id": "162bdf90-27e6-4d1e-b6a5-12366055de37",
                                                "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                                "text": "Ils avaient une maison à eux. […] Oh ! une vraie cabane ! couverte de chaume, bâtie en pisé, fermée par des volets qui claquaient au vent."
                                            },
                                            {
                                                "example_id": "8aa29626-faac-41ed-86a6-fa46be6b13f9",
                                                "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                                "text": "Mimile faisait de temps à autre claquer vigoureusement son fouet pour, d’une façon précise et tangible, rappeler au sentiment de la discipline ses tributaires encornés se bousculant dans les ornières boueuses de l’étroit chemin."
                                            },
                                            {
                                                "example_id": "7a2628fd-f619-4338-9c02-4c814cf83ed9",
                                                "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                                "text": "Henri fit claquer ses phalanges contre ses paumes crispées."
                                            },
                                            {
                                                "example_id": "9612d4e0-2882-45c7-9cf9-ee847b153ed0",
                                                "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                                "text": "Nouveaux coups de feu : « Ça claque trop sec ! c'est du pistolet. On attaque quelqu'un je parie. On se bagarre »."
                                            },
                                            {
                                                "example_id": "f23eb859-a70e-4ce9-af54-3bd6976210f6",
                                                "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                                "text": "Sauf pour ces derniers arrangements, le décor était prêt. Et d’un tel faste que Toursène, pour habitué qu’il fût à ces rites, ne put s’empêcher de faire claquer sa langue à plusieurs reprises, d’approbation."
                                            },
                                            {
                                                "example_id": "c83081dd-cab0-4e26-895c-ce6563f24c21",
                                                "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                                "text": "Puis le soliste lui-même devient virulent, et la masse orchestrale claque d'explosions sporadiques."
                                            },
                                            {
                                                "example_id": "09549c18-8306-42de-ad4d-be3bfbbfb71d",
                                                "sense_id": "907d492e-3cc5-3ea4-9034-3c6b6d7c945b",
                                                "text": "Il rappelle, plus agacé encore. « Madame de Closette », ainsi qu’il l’appelle en faisant claquer la dernière syllabe, comprend vite qu’il ne s’agit pas d’un coup de fil de courtoisie mais d’une soufflante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f65f98c-57ed-333f-b877-a5b30998baa5",
                                        "entry_id": "feddb3a4-7779-3446-bbf6-4c44492d9498",
                                        "glosses": [
                                            "Aplaudir."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e591333c-f75a-4070-8fcd-9184a4f3ee16",
                                                "sense_id": "7f65f98c-57ed-333f-b877-a5b30998baa5",
                                                "text": "— C’est son triomphe. Elle y fut toujours claquée, et cela sans cabale ni applaudisseurs apostés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e459563f-24eb-3c9b-b9bd-ff0d9b1f28d5",
                                        "entry_id": "feddb3a4-7779-3446-bbf6-4c44492d9498",
                                        "glosses": [
                                            "Mourir."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b022a2e8-86bd-4527-9abe-ac91fcb0fb5f",
                                                "sense_id": "e459563f-24eb-3c9b-b9bd-ff0d9b1f28d5",
                                                "text": "La fille n’était pas malade. Un peu d’anémie seulement. Mais il fallait prendre garde : c’était de cette façon qu’on claquait."
                                            },
                                            {
                                                "example_id": "b84c03de-8408-4481-8cdc-ec1511757fe1",
                                                "sense_id": "e459563f-24eb-3c9b-b9bd-ff0d9b1f28d5",
                                                "text": "Elle a reçu tant de coups de pied au ventre qu’hier après-midi elle a été prise de douleurs et qu’elle en a fait une fausse-couche pendant la nuit ; même qu’elle a failli en claquer."
                                            },
                                            {
                                                "example_id": "0c6bab71-5d20-408f-a6a3-d1a2386a0673",
                                                "sense_id": "e459563f-24eb-3c9b-b9bd-ff0d9b1f28d5",
                                                "text": "– Et je regrette une chose c’est de n’être pas, comme je l’ai cru, tuberculeuse. J’aurais claqué dans deux ans."
                                            },
                                            {
                                                "example_id": "a2264444-08ef-4a3f-8c52-89b352cfcbc2",
                                                "sense_id": "e459563f-24eb-3c9b-b9bd-ff0d9b1f28d5",
                                                "text": "Et je voyais autour de moi les malades claquer comme ça (il fait claquer son index contre son pouce)."
                                            },
                                            {
                                                "example_id": "8d600a96-6e2d-4349-9f9b-3da4f592f514",
                                                "sense_id": "e459563f-24eb-3c9b-b9bd-ff0d9b1f28d5",
                                                "text": "— C’est cul qu’il y ait pas mèche de l’transporter ailleurs, dit Lemarle. Y va claquer…"
                                            },
                                            {
                                                "example_id": "1e68a87a-eaca-4a0c-9ccc-ff78c7ccc69e",
                                                "sense_id": "e459563f-24eb-3c9b-b9bd-ff0d9b1f28d5",
                                                "text": "Il faut retourner sur nos pas ou claquer de soif…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfcae840-4a64-351b-989e-2de9175b3c04",
                                        "entry_id": "feddb3a4-7779-3446-bbf6-4c44492d9498",
                                        "glosses": [
                                            "Dépenser avec excès."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d349ece1-5d71-4607-a36d-5a56d54d6ae5",
                                                "sense_id": "cfcae840-4a64-351b-989e-2de9175b3c04",
                                                "text": "Mme Napier m’a dit que son fils avait claqué 200 balles sur un carnet de chèques chipé à sa sœur."
                                            },
                                            {
                                                "example_id": "43445696-13cd-47d4-84a5-7c60f56a5130",
                                                "sense_id": "cfcae840-4a64-351b-989e-2de9175b3c04",
                                                "text": "Très vite, il avait « claqué » sa petite fortune entre le baccara, Montmartre et les boîtes du Quartier."
                                            },
                                            {
                                                "example_id": "d2bcb1a1-416b-4207-a0d4-e6795b264462",
                                                "sense_id": "cfcae840-4a64-351b-989e-2de9175b3c04",
                                                "text": "Rien pour payer les études des enfants, aucun investissement pour produire de la richesse, pas de filet de sécurité au cas où on perdrait son job. Nous savons que nous ne devrions pas tout claquer ainsi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d786e9-ac70-3d21-827e-e0d767d5653e",
                                        "entry_id": "feddb3a4-7779-3446-bbf6-4c44492d9498",
                                        "glosses": [
                                            "Faire."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9e26290-1c32-4f20-ae4b-15cb67a9a3c1",
                                                "sense_id": "39d786e9-ac70-3d21-827e-e0d767d5653e",
                                                "text": "Claquer un coup de pêche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f31c1294-50ad-31d2-8c33-bd87c163c0e9",
                                        "entry_id": "feddb3a4-7779-3446-bbf6-4c44492d9498",
                                        "glosses": [
                                            "S’offrir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73396139-8b37-4562-a509-436f37e257eb",
                                                "sense_id": "f31c1294-50ad-31d2-8c33-bd87c163c0e9",
                                                "text": "Se claquer une bière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ab8dcf-1a84-3829-90f6-60a36947bee7",
                                        "entry_id": "feddb3a4-7779-3446-bbf6-4c44492d9498",
                                        "glosses": [
                                            "Donner une claque, des claques."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a00a52d7-3075-4288-8645-83817b51681e",
                                                "sense_id": "83ab8dcf-1a84-3829-90f6-60a36947bee7",
                                                "text": "Je ne sais pas ce qui me retient de te claquer !"
                                            },
                                            {
                                                "example_id": "fdfb0d2d-ddf0-460b-bbce-c0905e175d88",
                                                "sense_id": "83ab8dcf-1a84-3829-90f6-60a36947bee7",
                                                "text": "Certains locataires détournaient la tête à ma rencontre et, lorsque j’avais affaire dans sa loge, la concierge me claquait l’épaule en souriant et en clignant de l’œil."
                                            },
                                            {
                                                "example_id": "d0ae7f95-36e3-4329-a045-1ae5bf0d5539",
                                                "sense_id": "83ab8dcf-1a84-3829-90f6-60a36947bee7",
                                                "text": "En rentrant, papa m’a claquée. J’ai même pleuré."
                                            },
                                            {
                                                "example_id": "88d05540-0091-42a5-ae0f-33f344449b89",
                                                "sense_id": "83ab8dcf-1a84-3829-90f6-60a36947bee7",
                                                "text": "Et les Américains riaient en embrassant les filles et en claquant le dos des hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0023b531-1c96-3017-a16d-da27cd2011b1",
                                        "entry_id": "feddb3a4-7779-3446-bbf6-4c44492d9498",
                                        "glosses": [
                                            "Impressionner."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2659f02-0cfa-43e7-8898-3d5950dfd468",
                                                "sense_id": "0023b531-1c96-3017-a16d-da27cd2011b1",
                                                "text": "Brancusi est de ces noms qui, avec Picasso ou Matisse, claquent sur le marché de l’art."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "claquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a606778-41ec-3950-8c71-4f49f3c602d3",
                                        "entry_id": "e7db3460-06fc-3d3c-a0fb-b68329f273c7",
                                        "glosses": [
                                            "Garnir de la pièce de cuir appelée claque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3c6c6db-a5be-4b30-a358-f873936b0662",
                                                "sense_id": "2a606778-41ec-3950-8c71-4f49f3c602d3",
                                                "text": "Claquer des bottines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af53c99e-b03c-41c3-b377-8ffbac859802",
                        "source_entry_id": "7645cffb-270f-320d-9d78-a3ac35737053",
                        "source_sense_id": "cc9216c1-1b06-34eb-9ba8-f5878da06620",
                        "target_lang_word": "cliquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cliquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b40af314-289d-37d7-8ebd-6741581a9d14",
                                        "entry_id": "cd2dc896-1aca-36d9-bb7f-c9a0bd4fd096",
                                        "glosses": [
                                            "Enfoncer et relâcher le bouton-poussoir (ou cliquet) d’une souris ou d’un dispositif similaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "677f442f-f2c7-48df-8f39-8fcf12e31e9c",
                                                "sense_id": "b40af314-289d-37d7-8ebd-6741581a9d14",
                                                "text": "Cliquer sur un bouton, une icône, un hyperlien."
                                            },
                                            {
                                                "example_id": "719f40df-f94b-4c4f-9193-1ca4ebb56e05",
                                                "sense_id": "b40af314-289d-37d7-8ebd-6741581a9d14",
                                                "text": "C’est un super-média pour vos super-vidéos de pubs car si elles sont cliquées et recliquées maintes fois, elles seront reprises à l’œil par les grands médias tels que la presse ou la télévision.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "846dd99e-522b-3829-88fe-3dd2ce58cb51",
                                        "entry_id": "cd2dc896-1aca-36d9-bb7f-c9a0bd4fd096",
                                        "glosses": [
                                            "Émettre un bruit retentissant, résonner."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15714b2f-8caf-4960-9fa3-e8c71f02ffdc",
                                                "sense_id": "846dd99e-522b-3829-88fe-3dd2ce58cb51",
                                                "text": "Et les cigales cliqueront sur les roses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79534cbf-c207-3f43-a2da-c5316db8fa53",
                                        "entry_id": "cd2dc896-1aca-36d9-bb7f-c9a0bd4fd096",
                                        "glosses": [
                                            "Comprendre."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
