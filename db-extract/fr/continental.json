                    {
                        "sense_id": "7317f8cd-2061-3f3c-b4e1-5bd8de423c73",
                        "entry_id": "972a6e18-74a9-3665-abf3-9d8f8e77e267",
                        "glosses": [
                            "Qui appartient à un continent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb8f3e4e-7620-4a50-ae4b-ec1f2db324c8",
                                "sense_id": "7317f8cd-2061-3f3c-b4e1-5bd8de423c73",
                                "text": "Les puissances continentales."
                            },
                            {
                                "example_id": "78a7f75a-c403-4ddb-bbe1-568518ea4331",
                                "sense_id": "7317f8cd-2061-3f3c-b4e1-5bd8de423c73",
                                "text": "La France continentale : Par opposition à la France coloniale."
                            }
                        ]
                    },
                    {
                        "sense_id": "5001771b-35e0-34ee-8d10-9f72e7f761bd",
                        "entry_id": "972a6e18-74a9-3665-abf3-9d8f8e77e267",
                        "glosses": [
                            "Qualifie le climat ou la végétation que l’on trouve à l’intérieur d’un continent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f9fc6f-0bdd-45af-8d65-b89657256842",
                                "sense_id": "5001771b-35e0-34ee-8d10-9f72e7f761bd",
                                "text": "[…] les variations de température qu’on constate en Champagne, surtout au printemps, donnent à cette région un caractère continental […]"
                            },
                            {
                                "example_id": "cab5602f-6ff8-42b2-90bc-170c56ce11ed",
                                "sense_id": "5001771b-35e0-34ee-8d10-9f72e7f761bd",
                                "text": "Or, il est essentiel de travailler vite dans ces pays de climat continental où la période végétative est brève, où il faut mettre la terre en culture très rapidement après la raspoutitsa pour que la récolte n'ait à souffrir ni de l’échaudage de l'été, ni des orages de fin de saison."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5d8e851-0e20-4374-a664-ef071e7a11aa",
                        "source_entry_id": "972a6e18-74a9-3665-abf3-9d8f8e77e267",
                        "target_lang_word": "continental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "840088a8-ea09-38a4-9f99-07514dc0193e",
                                        "entry_id": "ae14e824-4390-32cf-a1fd-9c0c59b0901f",
                                        "glosses": [
                                            "Of or relating to a continent or continents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626caf9d-ecdb-49e4-b73d-d56f58bc0484",
                                                "sense_id": "840088a8-ea09-38a4-9f99-07514dc0193e",
                                                "text": "continental drift"
                                            },
                                            {
                                                "example_id": "666aefbf-7eeb-4e07-8c75-6905710f17cf",
                                                "sense_id": "840088a8-ea09-38a4-9f99-07514dc0193e",
                                                "text": "Offshore to the west of the continental margin during the Early Triassic, the Sonoma highlands formed a volcanic island arc, separated from the mainland by a shallow sea that cut through western Nevada and northwestern Utah."
                                            },
                                            {
                                                "example_id": "15ac7dc7-844a-42a4-a7c8-e216943314bd",
                                                "sense_id": "840088a8-ea09-38a4-9f99-07514dc0193e",
                                                "text": "No former king had involved himself so frequently in the labyrinth of continental alliances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b4970c-f9d8-327f-9a5e-d50148283a51",
                                        "entry_id": "ae14e824-4390-32cf-a1fd-9c0c59b0901f",
                                        "glosses": [
                                            "Of the mainland, as opposed to an island offshore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "455abe62-908f-40c8-a28f-d40a05ddd151",
                                                "sense_id": "53b4970c-f9d8-327f-9a5e-d50148283a51",
                                                "text": "continental Europe"
                                            },
                                            {
                                                "example_id": "a715102e-5de4-48a6-9ae4-aad0cd57f0b2",
                                                "sense_id": "53b4970c-f9d8-327f-9a5e-d50148283a51",
                                                "text": "The outline of continental Ireland is proximately that of a rhomboid ; and, in a general view, is greatly more continuous or less indented and undulated by cuts and sweeps of the sea than the outline of continental Great Britain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "795fcb04-c5eb-33c9-9efd-f44489830531",
                                        "entry_id": "ae14e824-4390-32cf-a1fd-9c0c59b0901f",
                                        "glosses": [
                                            "Relating to, or characteristic of, continental Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93899993-8368-46df-a818-f34fb4fe0461",
                                                "sense_id": "795fcb04-c5eb-33c9-9efd-f44489830531",
                                                "text": "continental breakfast"
                                            },
                                            {
                                                "example_id": "3d9f06f8-e14b-49b1-a063-93fa309268e9",
                                                "sense_id": "795fcb04-c5eb-33c9-9efd-f44489830531",
                                                "text": "at Monte Carlo or some of the other Continental gambling-hells"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a87f5b-946b-326f-a6bc-834fbbae3b3b",
                                        "entry_id": "ae14e824-4390-32cf-a1fd-9c0c59b0901f",
                                        "glosses": [
                                            "Of or relating to the confederated colonies collectively, in the time of the Revolutionary War."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fb88160-d5fe-4692-ba0e-d3cc130ff680",
                                                "sense_id": "b5a87f5b-946b-326f-a6bc-834fbbae3b3b",
                                                "text": "continental money"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "continental",
