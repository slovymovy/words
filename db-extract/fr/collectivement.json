        "fr-extract.jsonl": [
            {
                "entry_id": "11f50373-88b1-3da0-9343-982d89d6f635",
                "word": "collectivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8f3838a0-2d19-37c8-b46f-e173239c6afd",
                        "entry_id": "11f50373-88b1-3da0-9343-982d89d6f635",
                        "glosses": [
                            "Dans un sens collectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a509f730-1c57-4f28-8419-6b5c937da0b3",
                                "sense_id": "8f3838a0-2d19-37c8-b46f-e173239c6afd",
                                "text": "Dans la phrase : « le tigre est féroce », tigre est pris collectivement."
                            },
                            {
                                "example_id": "b20ae2a0-94be-4b91-ae92-98fc03a567c8",
                                "sense_id": "8f3838a0-2d19-37c8-b46f-e173239c6afd",
                                "text": "L’homme, c’est-à-dire tous les hommes, pris collectivement."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4538be3-2e70-35dd-b932-a84dc3eda337",
                        "entry_id": "11f50373-88b1-3da0-9343-982d89d6f635",
                        "glosses": [
                            "De façon collective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccb5690-2cc1-4ce5-8c40-c964c2fca88f",
                                "sense_id": "d4538be3-2e70-35dd-b932-a84dc3eda337",
                                "text": "Et le parti, par la voix du député des Bouches-du-Rhône Manuel Bompard, a annoncé la semaine dernière : « Nous travaillons collectivement aux modalités et au calendrier du retour d’Adrien Quatennens »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf6d94f0-4ffd-416f-b534-0f25662ae615",
                        "source_entry_id": "11f50373-88b1-3da0-9343-982d89d6f635",
