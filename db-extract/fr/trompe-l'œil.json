        "fr-extract.jsonl": [
            {
                "entry_id": "c7590a81-10f0-3521-ab95-8a158aec98cb",
                "word": "trompe-l'œil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5a0ff26a-7972-4c98-b594-6572e5899503",
                        "entry_id": "c7590a81-10f0-3521-ab95-8a158aec98cb",
                        "tags": [],
                        "form": "trompe l’œil"
                    },
                    {
                        "form_id": "8177ecc5-396c-4699-b20f-6f7f38a95375",
                        "entry_id": "c7590a81-10f0-3521-ab95-8a158aec98cb",
                        "tags": [],
                        "form": "trompe-l’oeil"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57e894c9-9485-3f74-8f3f-a9b2993b8875",
                        "entry_id": "c7590a81-10f0-3521-ab95-8a158aec98cb",
                        "glosses": [
                            "Peinture qui donne à distance l’illusion de la réalité, en particulier l’illusion de la dimension de profondeur."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "aa061058-88d8-4b13-accd-1d5c16a80746",
                                "sense_id": "57e894c9-9485-3f74-8f3f-a9b2993b8875",
                                "text": "C’est un trompe-l’œil de Leandro Erlich, l’une des installations décapantes et immenses de la Foire foraine d’art contemporain, qui régalera petits et grands, au Centquatre (19ᵉ)."
                            },
                            {
                                "example_id": "c9b5f123-bc29-4b68-aa18-c6b767ba9660",
                                "sense_id": "57e894c9-9485-3f74-8f3f-a9b2993b8875",
                                "text": "Les lettres RF sont peintes en doré sur un fond tricolore ou parfois dorées, mais en relief ou en trompe-l’œil, sur un fond doré."
                            },
                            {
                                "example_id": "d06eb9b0-5811-4d03-b6bf-ad391d6393e9",
                                "sense_id": "57e894c9-9485-3f74-8f3f-a9b2993b8875",
                                "text": "Peut-être le texte est-il alors davantage l’image d’un trompe-l'œil qu’une image en trompe-l'œil."
                            }
                        ]
                    },
                    {
                        "sense_id": "617911d0-e784-3229-878b-a426d015676d",
                        "entry_id": "c7590a81-10f0-3521-ab95-8a158aec98cb",
                        "glosses": [
                            "Illusion d’être une autre chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d26b1257-b40f-4eeb-805e-f789ee0bfad2",
                                "sense_id": "617911d0-e784-3229-878b-a426d015676d",
                                "text": "J’ai eu des maîtresses que j’ai aimées huit jours, des blondes sentimentales et romanesques, des brunes farouches, impatientes du baiser, et l’amour ne m’a montré que le vide effroyable du cœur de l’homme, le trompe-l’œil des tendresses, le mensonge de l’idéal, le néant du plaisir…"
                            },
                            {
                                "example_id": "1adb7aab-d782-4796-abac-b2114850e72c",
                                "sense_id": "617911d0-e784-3229-878b-a426d015676d",
                                "text": "On ne crée pas des plats trompe-l’œil, mais des recettes gourmandes, gastronomiques et qui surprennent par les goûts et associations de saveurs."
                            },
                            {
                                "example_id": "2c8ca431-b286-4e03-8584-759e6c8e7c32",
                                "sense_id": "617911d0-e784-3229-878b-a426d015676d",
                                "text": "Dans ces deux cas, on force la fiction au trompe-l’œil, on la « défictionne » d’une certaine manière par excès de signes réels destinés à manipuler le regard et la réalité du même coup."
                            },
                            {
                                "example_id": "2459657c-5798-4ab6-9292-c612cbef5472",
                                "sense_id": "617911d0-e784-3229-878b-a426d015676d",
                                "text": "Le comité des régions […] considère qu’il nous faut […] assurer la protection et le respect des éléments de la vie politique qui s’appuient sur le pluralisme et créer dans l’information un véritable pluralisme, qui se démarque du trompe-l’œil constitué par la reprise ininterrompue des mêmes discours et d’une même sélection d’informations et d’images."
                            }
                        ]
                    }
                ],
