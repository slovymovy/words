                                        "entry_id": "945b099a-0c87-37f4-a2d7-286b059f8766",
                                        "glosses": [
                                            "A person who flies in balloons, especially in hot-air balloons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe1d617-22ba-41c8-8288-4ab2e69efa8d",
                                                "sense_id": "5d37977f-395f-38b9-9e6e-9991d01eeea1",
                                                "text": "But his greatest achievement, the balloonist said, was a flight he made in Australia in November 1984, using the prototype of the balloon in which he intends to circle the world."
                                            },
                                            {
                                                "example_id": "6daeac5b-278d-4670-9cf3-cce242da0057",
                                                "sense_id": "5d37977f-395f-38b9-9e6e-9991d01eeea1",
                                                "text": "Like surfers trying to catch a wave, balloonists try to ride jet streams."
                                            }
                                        ]
                                    }
                                ]
