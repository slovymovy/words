                    {
                        "sense_id": "c7b0cf49-d1ee-3310-9b91-c3e063d1891d",
                        "entry_id": "8783be95-da4a-3c1c-9904-9d3ea3ff8b2a",
                        "glosses": [
                            "Regroupement important d’oiseaux en vol, nuage d’oiseaux."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "d67aefbd-c308-4304-97f2-b4ba03c60eb7",
                                "sense_id": "c7b0cf49-d1ee-3310-9b91-c3e063d1891d",
                                "text": "Il s’agit de la murmuration des étourneaux."
                            },
                            {
                                "example_id": "2029f158-4bfc-42e2-b99e-04872d6b054e",
                                "sense_id": "c7b0cf49-d1ee-3310-9b91-c3e063d1891d",
                                "text": "Cette superbe vidéo montre les mouvements coordonnés de centaines d’oiseaux qui forment de magnifique [sic] murmurations dans le ciel des Pays-Bas."
                            },
                            {
                                "example_id": "f4f368f5-5a93-4e02-97be-80f5031a4896",
                                "sense_id": "c7b0cf49-d1ee-3310-9b91-c3e063d1891d",
                                "text": "Dans le même moment, le ciel se chargea d’un orage d'obus, comme une murmuration d’étourneaux, hauts dans le ciel avant de retomber sur la ligne Mannerheim."
                            }
                        ]
                    }
