                "forms": [
                    {
                        "form_id": "b37be29a-0804-4376-89b6-f99930b9f83d",
                        "entry_id": "f6f7fff3-6d54-3e3c-97cc-9f6f7b1ba9e1",
                        "tags": [
                            "plural"
                        ],
                        "form": "désaveux"
