{
    "word_family": [
        "cheater",
        "cheatgrass",
        "cheatingly",
        "uncheatable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "526d63ef-62d1-3dbd-9c10-b25b5ec3a46b",
                    "sense_definition": "To violate rules in order to gain, or attempt to gain, an unfair advantage in a situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother flunked biology because he <w>cheated</w> on his mid-term exam.",
                            "target_lang_translations": {
                                "ru": "Мой брат провалил биологию, потому что он <w>списывал</w> на промежуточном экзамене."
                            }
                        },
                        {
                            "text": "It is impossible to win fairly if you <w>cheat</w> at cards every single time.",
                            "target_lang_translations": {
                                "ru": "Невозможно выиграть честно, если ты каждый раз <w>мухлюешь</w> в картах."
                            }
                        }
                    ],
                    "synonyms": [
                        "break the rules"
                    ],
                    "common_phrases": [
                        "cheat at cards",
                        "cheat on a test"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушать правила, чтобы получить или попытаться получить несправедливое преимущество в какой-либо ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "списывать",
                                "target_lang_sense_clarification": "на экзамене или тесте"
                            },
                            {
                                "target_lang_word": "жульничать",
                                "target_lang_sense_clarification": "в игре или спорте"
                            },
                            {
                                "target_lang_word": "мухлевать",
                                "target_lang_sense_clarification": "в картах или играх"
                            },
                            {
                                "target_lang_word": "мошенничать",
                                "target_lang_sense_clarification": "действовать нечестно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e8208b9-760b-39d2-8015-daaf238a6173",
                    "sense_definition": "To be unfaithful to one's spouse or romantic partner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "infidelity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My husband <w>cheated</w> on me with his secretary for over a year.",
                            "target_lang_translations": {
                                "ru": "Мой муж <w>изменял</w> мне со своей секретаршей больше года."
                            }
                        },
                        {
                            "text": "She decided to leave him after she found out he was <w>cheating</w> on her.",
                            "target_lang_translations": {
                                "ru": "Она решила уйти от него после того, как узнала, что он ей <w>изменяет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "step out on"
                    ],
                    "common_phrases": [
                        "cheat on someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть неверным своему супругу или романтическому партнеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменять",
                                "target_lang_sense_clarification": "нарушать верность"
                            },
                            {
                                "target_lang_word": "ходить налево",
                                "target_lang_sense_clarification": "разговорное об измене"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cf3fcd4-a501-3c50-9cb5-af4082ef96f7",
                    "sense_definition": "To deceive, fool, or trick someone, often to take something from them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishonest businessman <w>cheated</w> me out of forty thousand dollars.",
                            "target_lang_translations": {
                                "ru": "Нечестный бизнесмен <w>выманил</w> у меня сорок тысяч долларов."
                            }
                        },
                        {
                            "text": "He managed to <w>cheat</w> his way into office by making false promises.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>пробраться</w> во власть обманным путем, раздавая ложные обещания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheat someone out of",
                        "cheat your way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать или вводить в заблуждение кого-либо, часто с целью что-то у него отобрать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "вводить в заблуждение"
                            },
                            {
                                "target_lang_word": "надувать",
                                "target_lang_sense_clarification": "просторечное: обманывать"
                            },
                            {
                                "target_lang_word": "обдуривать",
                                "target_lang_sense_clarification": "оставлять в дураках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b65bbe0-dfc2-3ca7-b0ff-1b4ecbaf9f53",
                    "sense_definition": "To avoid a seemingly inevitable or negative outcome through luck or skill.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stuntman <w>cheated</w> death when his car collided with a moving train.",
                            "target_lang_translations": {
                                "ru": "Каскадер <w>обманул</w> смерть, когда его машина столкнулась с движущимся поездом."
                            }
                        },
                        {
                            "text": "I feel as if I have <w>cheated</w> fate by surviving that terrible storm.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя так, будто <w>обманул</w> судьбу, выжив в тот ужасный шторм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheat death",
                        "cheat fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избежать казалось бы неизбежного или негативного исхода благодаря удаче или мастерству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обмануть",
                                "target_lang_sense_clarification": "судьбу или смерть"
                            },
                            {
                                "target_lang_word": "перехитрить",
                                "target_lang_sense_clarification": "избежать опасности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fc95f9d-3d98-30b0-a22a-8f6afe05a214",
                    "sense_definition": "To disregard self-imposed restrictions, such as a diet, in favor of indulging oneself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indulgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>cheat</w> on my diet and have a large piece of cake.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>нарушить</w> диету и съесть большой кусок торта."
                            }
                        },
                        {
                            "text": "Sometimes it is okay to <w>cheat</w> a little on your exercise routine.",
                            "target_lang_translations": {
                                "ru": "Иногда это нормально — немного <w>схалтурить</w> в программе тренировок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheat on a diet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the context of dieting or habits"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игнорировать установленные для себя ограничения, например диету, ради минутного удовольствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "диету или режим"
                            },
                            {
                                "target_lang_word": "давать слабину",
                                "target_lang_sense_clarification": "отступать от правил"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37579643-5f09-36f8-81eb-0a867f914398",
                    "sense_definition": "A person who acts dishonestly or deceives others to gain an advantage.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody wants to play with him because he is a known <w>cheat</w>.",
                            "target_lang_translations": {
                                "ru": "Никто не хочет с ним играть, потому что он известный <w>обманщик</w>."
                            }
                        },
                        {
                            "text": "The system is designed to catch welfare <w>cheats</w> who hide their income.",
                            "target_lang_translations": {
                                "ru": "Система разработана для поимки <w>мошенников</w> в сфере социального обеспечения, которые скрывают свои доходы."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheater"
                    ],
                    "common_phrases": [
                        "welfare cheat",
                        "liar and cheat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который действует нечестно или обманывает других ради получения выгоды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обманщик",
                                "target_lang_sense_clarification": "тот, кто лжет"
                            },
                            {
                                "target_lang_word": "мошенник",
                                "target_lang_sense_clarification": "жулик, плут"
                            },
                            {
                                "target_lang_word": "жулик",
                                "target_lang_sense_clarification": "мелкий обманщик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "403a99c3-41ed-3afe-87d4-402521ca5bc9",
                    "sense_definition": "A hidden method or code used to gain an unfair advantage in a video game.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a <w>cheat</w> for the first level that gives you infinite lives.",
                            "target_lang_translations": {
                                "ru": "Я нашел <w>чит</w> для первого уровня, который дает бесконечные жизни."
                            }
                        },
                        {
                            "text": "Entering a <w>cheat</w> code can make the game much easier to finish.",
                            "target_lang_translations": {
                                "ru": "Ввод <w>чит-кода</w> может значительно облегчить прохождение игры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheat code"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытый метод или код, используемый для получения несправедливого преимущества в видеоигре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чит",
                                "target_lang_sense_clarification": "игровой код"
                            },
                            {
                                "target_lang_word": "чит-код",
                                "target_lang_sense_clarification": "комбинация для преимущества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "351578c3-5be4-3a23-8a03-e49657d82c06",
                    "sense_definition": "An act of deception or fraud; something that serves as a means of trickery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When I consider the difficulties of life, it often feels like a <w>cheat</w>.",
                            "target_lang_translations": {
                                "ru": "Когда я думаю о жизненных трудностях, жизнь часто кажется <w>обманом</w>."
                            }
                        },
                        {
                            "text": "The entire business deal turned out to be a massive <w>cheat</w>.",
                            "target_lang_translations": {
                                "ru": "Вся эта деловая сделка оказалась масштабным <w>надувательством</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fraud",
                        "trick",
                        "imposture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт обмана или мошенничества; нечто, служащее средством уловки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обман",
                                "target_lang_sense_clarification": "факт лжи"
                            },
                            {
                                "target_lang_word": "надувательство",
                                "target_lang_sense_clarification": "грубый обман"
                            },
                            {
                                "target_lang_word": "подделка",
                                "target_lang_sense_clarification": "нечто ненастоящее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a835913-4fef-3ca6-87a3-9054b9ef68ae",
                    "sense_definition": "A specific card game where players try to get rid of their cards by lying about what they are playing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole evening playing <w>cheat</w> and laughing at our bad lies.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь вечер, играя в <w>«верю-не-верю»</w> и смеясь над нашей неумелой ложью."
                            }
                        },
                        {
                            "text": "In the game of <w>cheat</w>, you must be very convincing when you bluff.",
                            "target_lang_translations": {
                                "ru": "В игре <w>«верю-не-верю»</w> нужно быть очень убедительным, когда блефуешь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "play cheat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная карточная игра, в которой игроки пытаются избавиться от своих карт, лгав о том, что они выкладывают."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верю-не-верю",
                                "target_lang_sense_clarification": "название карточной игры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c103ccb3-46ce-33c8-94e6-6eb59766587d",
                    "sense_definition": "A type of low-quality or coarse wheaten bread.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical text describes how the poor would often eat <w>cheat</w> instead of pure white bread.",
                            "target_lang_translations": {
                                "ru": "В историческом тексте описывается, как бедняки часто ели <w>грубый хлеб</w> вместо чистого белого хлеба."
                            }
                        },
                        {
                            "text": "Loaves of coarse <w>cheat</w> required more leaven than the finer varieties.",
                            "target_lang_translations": {
                                "ru": "Буханки грубого <w>хлеба</w> требовали больше закваски, чем более изысканные сорта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to historical bread types"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип низкокачественного или грубого пшеничного хлеба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубый хлеб",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}