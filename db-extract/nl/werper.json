                                            {
                                                "example_id": "1eb18e0f-bc16-40bb-8823-411e5018a81a",
                                                "sense_id": "ae89fc2b-9e4d-3f87-94b1-a42d2a54ddff",
                                                "text": "A tent pitcher"
                                            },
                                            {
                                                "example_id": "817a97fa-d5b3-412e-b6cc-bc5376e25411",
                                                "sense_id": "ae89fc2b-9e4d-3f87-94b1-a42d2a54ddff",
                                                "text": "A pitcher of ideas"
                                            },
                                            {
                                                "example_id": "6d21a310-a148-4592-992e-ed98bb8e9827",
                                                "sense_id": "ae89fc2b-9e4d-3f87-94b1-a42d2a54ddff",
                                                "text": "A quoits pitcher"
