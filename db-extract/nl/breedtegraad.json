                        ]
                    },
                    {
                        "translation_id": "5451ca27-c730-4251-a530-fe0ea7d348c9",
                        "source_entry_id": "61ad9015-86aa-33eb-98f5-064ecd4c7ef6",
                        "source_sense_id": "9cfb3f08-f8cf-36d1-b902-b8cb7a2c13e3",
                        "source_sense_description": "cirkel van gelijke geografische breedten",
                        "target_lang_word": "latitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62e8276e-eb6d-3e91-8066-f735599f3d57",
                                        "entry_id": "e2310dab-458c-3218-9c36-eb770d9b07dd",
                                        "glosses": [
                                            "Étendue, extension, largeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5652c707-6b6d-482f-997c-f1fe9fefcd09",
                                                "sense_id": "62e8276e-eb6d-3e91-8066-f735599f3d57",
                                                "text": "Ce principe peut avoir une grande latitude."
                                            },
                                            {
                                                "example_id": "9d38a9be-2c03-4413-bc80-c078b5a38d50",
                                                "sense_id": "62e8276e-eb6d-3e91-8066-f735599f3d57",
                                                "text": "Donner trop de latitude à une proposition, à l’application d’un principe."
                                            },
                                            {
                                                "example_id": "6d73ed2a-3f4d-4c07-9faf-aa740774c9e3",
                                                "sense_id": "62e8276e-eb6d-3e91-8066-f735599f3d57",
                                                "text": "Laisser beaucoup de latitude aux agents chargés d’une mission."
                                            },
                                            {
                                                "example_id": "42ac49bd-0f5b-4b4a-893f-d156244c4556",
                                                "sense_id": "62e8276e-eb6d-3e91-8066-f735599f3d57",
                                                "text": "Avoir toute latitude pour : avoir toute liberté pour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873457af-984e-39b2-b433-86b494ae3905",
                                        "entry_id": "e2310dab-458c-3218-9c36-eb770d9b07dd",
                                        "glosses": [
                                            "Distance d’un lieu à l’équateur mesurée en degrés sur le méridien → voir parallèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29b62b3d-09ca-43a7-8535-60ba70bee7f2",
                                                "sense_id": "873457af-984e-39b2-b433-86b494ae3905",
                                                "text": "La latitude d'un lieu correspond à l'angle fait par la normale à l'ellipsoïde de référence en ce lieu avec le plan équatorial."
                                            },
                                            {
                                                "example_id": "a4a89760-e2fc-4cf2-a7d9-bdf741aa9cf5",
                                                "sense_id": "873457af-984e-39b2-b433-86b494ae3905",
                                                "text": "C’est ici que ça se passe, 30°50’ de latitude nord, 30°50’ de longitude ouest… à une journée de distance pour nous, et ils filent sud-sud-ouest à toute vapeur. À ce train-là nous ne verrons rien, […]."
                                            },
                                            {
                                                "example_id": "fc93de80-47d3-4fc6-bb07-f22ac830ab59",
                                                "sense_id": "873457af-984e-39b2-b433-86b494ae3905",
                                                "text": "Le Scoresby Sund est le plus vaste fjord du monde entier. Il est découpé dans la côte Orientale ^([sic : orientale]) du Groenland entre 70° et 72° de latitude Nord et 22° et 30° de longitude Ouest de Greenwich."
                                            },
                                            {
                                                "example_id": "d58c1a16-f27b-4fb1-b213-d8fa299f418b",
                                                "sense_id": "873457af-984e-39b2-b433-86b494ae3905",
                                                "text": "[…] le 12 mars, par 20 degrés de latitude Nord, je rencontrai les vents alizés, je pouvais compter dorénavant sur un plus faible et agréable navigation dans les mers tropicales."
                                            },
                                            {
                                                "example_id": "bef336a7-c172-4b10-92af-d3ecacdd99fa",
                                                "sense_id": "873457af-984e-39b2-b433-86b494ae3905",
                                                "text": "L’ancre tombe, une fumée de sable s’épanouit dans la mer : 12°45’ de latitude Nord, 45°4’ de longitude Est : c’est Aden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f5b17be-5a10-3077-bf84-2fa142bb7b4c",
                                        "entry_id": "e2310dab-458c-3218-9c36-eb770d9b07dd",
                                        "glosses": [
                                            "Différentes régions soumises à telle ou telle température par suite de leur éloignement plus ou moins grand de l’équateur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a389f1c-27cc-41ef-bcec-0466b7e01e61",
                                                "sense_id": "8f5b17be-5a10-3077-bf84-2fa142bb7b4c",
                                                "text": "Aux latitudes tempérées de l’hémisphère nord, les milieux alluviaux sont significativement plus riches en lianes arborescentes que dans les forêts non alluviales, à dynamisme sylvigénétique plus lent."
                                            },
                                            {
                                                "example_id": "7b82d2dc-2574-4ef9-8f1f-b19eadc4c5c6",
                                                "sense_id": "8f5b17be-5a10-3077-bf84-2fa142bb7b4c",
                                                "text": "Pascal nous dit qu’au point de vue des faits, le Bien et le Mal sont une question de « latitude ». En effet, tel acte humain s’appelle crime, ici, bonne action, là-bas, et réciproquement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea55913-25b8-3d77-abff-347207f35a7a",
                                        "entry_id": "e2310dab-458c-3218-9c36-eb770d9b07dd",
                                        "glosses": [
                                            "Angle que fait, avec un plan parallèle à l’écliptique, la ligne droite qui passe par un astre et par un centre donné sur ce plan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7627d366-caac-49d7-b189-37c15920c373",
                                                "sense_id": "cea55913-25b8-3d77-abff-347207f35a7a",
                                                "text": "Latitude australe ou boréale. — Latitude héliocentrique, géocentrique, etc. — Latitude de Sirius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a8289a-545e-37b3-bdec-8221f94a8bd8",
                                        "entry_id": "e2310dab-458c-3218-9c36-eb770d9b07dd",
                                        "glosses": [
                                            "Liberté d’agir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "556b51d1-e26e-46aa-8e49-4f2a653d86e6",
                                                "sense_id": "f9a8289a-545e-37b3-bdec-8221f94a8bd8",
                                                "text": "Et, au matin, nous vous laisserons toute latitude pour accomplir la prophétie de Donegal."
                                            },
                                            {
                                                "example_id": "567ff64c-c872-4099-9d84-0288b244f0e3",
                                                "sense_id": "f9a8289a-545e-37b3-bdec-8221f94a8bd8",
                                                "text": "Le professeur Miller enseigne à Princeton, la professeure Brewster-Wang est consultante pour la Nasa et Google Corp. Ils auront toute latitude pour l'application du protocole 42, et je serai le coordinateur de cette opération."
                                            },
                                            {
                                                "example_id": "768675a2-bc5e-4bb7-998d-fe8dcbfa5643",
                                                "sense_id": "f9a8289a-545e-37b3-bdec-8221f94a8bd8",
                                                "text": "Une forêt de hêtres rayonne en moi\n(Longitude : le sentier\nLatitude : contemplative)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
