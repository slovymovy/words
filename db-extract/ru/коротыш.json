                    },
                    {
                        "translation_id": "57c59d74-1f8b-481d-ac28-bf8814a56047",
                        "source_entry_id": "4913441c-75c7-3299-b376-b85a751a8489",
                        "source_sense_id": "d8efbe97-d5be-3725-baff-5e34708c0b0a",
                        "target_lang_word": "shorty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shorty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd20f51d-eba1-3bba-bb80-912723822350",
                                        "entry_id": "ff8f73c2-f21f-3c8e-83b7-9bb1f6da3760",
                                        "glosses": [
                                            "A short person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a3310a0-29f5-36e1-8925-a8521162d600",
                                        "entry_id": "ff8f73c2-f21f-3c8e-83b7-9bb1f6da3760",
                                        "glosses": [
                                            "A term of endearment for a child, younger sibling, shorter person, etc."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c77aa9bc-caf6-3da6-8682-c376ebf2039c",
                                        "entry_id": "ff8f73c2-f21f-3c8e-83b7-9bb1f6da3760",
                                        "glosses": [
                                            "A child."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "601ce3c0-59cf-469f-a043-4c62b5c819d6",
                                                "sense_id": "c77aa9bc-caf6-3da6-8682-c376ebf2039c",
                                                "text": "\"I think we loved 'The Bridge Is Over' more than anybody else,\" says Nas, who was just a shorty when he first heard the opening shot."
                                            },
                                            {
                                                "example_id": "7708f8b0-c6e2-4839-a7e4-29bb3762bd9e",
                                                "sense_id": "c77aa9bc-caf6-3da6-8682-c376ebf2039c",
                                                "text": "Like one day when I was just a shorty my mother was drinking a beer and a policeman told her to pour it out. He was way too little to be saying that to my mother. No way I was going to let him put handcuffs on her."
                                            },
                                            {
                                                "example_id": "45e50668-46bf-498f-b67b-f22c70ca38ec",
                                                "sense_id": "c77aa9bc-caf6-3da6-8682-c376ebf2039c",
                                                "text": "Ever since they introduced the world to Patrick Ewing and Michael Graham, Georgetown has been the Black school of choice for every shorty …"
                                            },
                                            {
                                                "example_id": "f524af8c-cfea-4d71-8008-479eab0f6f73",
                                                "sense_id": "c77aa9bc-caf6-3da6-8682-c376ebf2039c",
                                                "text": "“Girl when I was just a shorty, some cats from New York came through putting down there work and muscling anybody too weak for the streets, but anyway they shot my oldest brother, who was alright with Ju and them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afbe78a2-0230-3c51-81a4-ac475b9c67b7",
                                        "entry_id": "ff8f73c2-f21f-3c8e-83b7-9bb1f6da3760",
                                        "glosses": [
                                            "An attractive young female, especially one who is sexually available."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4065692-f7b3-4570-928d-9ab90314d9e6",
                                                "sense_id": "afbe78a2-0230-3c51-81a4-ac475b9c67b7",
                                                "text": "I guarantee, shorty, it's real, baby, stick it out / [...] / You talk a good one, shorty, now you're makin' me sweat"
                                            },
                                            {
                                                "example_id": "ac1e3be1-c94d-40f6-9459-6f157599ee34",
                                                "sense_id": "afbe78a2-0230-3c51-81a4-ac475b9c67b7",
                                                "text": "But seeing my boy on the cover of your magazine with three fine shorties made me think twice about the assumptions I've made."
                                            },
                                            {
                                                "example_id": "f91d41cc-e467-41c0-864c-c6d9814f3fad",
                                                "sense_id": "afbe78a2-0230-3c51-81a4-ac475b9c67b7",
                                                "text": "“Yo, man,” Vincent looked up at Sharif. “How is it that you always have the fine shorties hanging out at your crib?”"
                                            },
                                            {
                                                "example_id": "3a3db261-b000-4067-8bf1-dfdd323e809e",
                                                "sense_id": "afbe78a2-0230-3c51-81a4-ac475b9c67b7",
                                                "text": "Shawty I can see that you got so much energy, / The way you twirling up them hips round and round"
                                            },
                                            {
                                                "example_id": "de269061-2ec5-49a9-83d1-b03a9464087d",
                                                "sense_id": "afbe78a2-0230-3c51-81a4-ac475b9c67b7",
                                                "text": "\"It wasn't that fine ass shorty I saw in the car earlier?\" Travis inquired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6994997f-bb93-3003-8c0d-0fc3965edb68",
                                        "entry_id": "ff8f73c2-f21f-3c8e-83b7-9bb1f6da3760",
                                        "glosses": [
                                            "A girlfriend."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68b7ae1a-9ab4-4229-b9d8-6c78dfdd86ca",
                                                "sense_id": "6994997f-bb93-3003-8c0d-0fc3965edb68",
                                                "text": "I should be playin' in the winter snow, but I'ma be under the mistletoe / With you, shawty with you"
                                            },
                                            {
                                                "example_id": "35ee18d3-0b9c-458e-a321-b5bcb19295cb",
                                                "sense_id": "6994997f-bb93-3003-8c0d-0fc3965edb68",
                                                "text": "These are the things that separate a date from a fiancee, a shorty from a wife, a one-night stand from a lifetime commitment."
                                            },
                                            {
                                                "example_id": "d3594a13-6485-4bd0-a125-048f902058bd",
                                                "sense_id": "6994997f-bb93-3003-8c0d-0fc3965edb68",
                                                "text": "Demarco said pulling down his cap “Yeah, that's what I be hearing, my shorty told me how Shelly be bragging about the time ya'll had.”"
                                            },
                                            {
                                                "example_id": "9701e364-c77a-4492-abdd-bc29bf1c3422",
                                                "sense_id": "6994997f-bb93-3003-8c0d-0fc3965edb68",
                                                "text": "My shorty called my baby moms, I'm in some shit, and all my real gear at shorty crib."
                                            },
                                            {
                                                "example_id": "c4e5db78-3320-4450-be81-e78dcce6c650",
                                                "sense_id": "6994997f-bb93-3003-8c0d-0fc3965edb68",
                                                "text": "It was my birthday weekend, and one of my shorties decided she wanted to take a playa to Amsterdam to celebrate, we took a sightseeing tour bus and we saw everything there was to see."
                                            },
                                            {
                                                "example_id": "4fd8eb54-7f51-46dd-8540-38a94630cf29",
                                                "sense_id": "6994997f-bb93-3003-8c0d-0fc3965edb68",
                                                "text": "I don't give a fuck, what he wants from me, I'll give him anything to get my shorty back, I swear, he better not have hurt or touched my shorty, or I'm a kill 'em when I see'em."
                                            }
                                        ]
