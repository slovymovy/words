                        "glosses": [
                            "stimmhafter Laut der Sprache, der den Silbengipfel bilden, also silbentragend/silbisch sein kann."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6243401-a4e9-4da8-85db-9c8b02ec010d",
                                "sense_id": "9fdf4da6-915c-37e1-ac09-99783564a4a4",
                                "text": "In dem Plural \"die Tanten\" [ˈtantn̩] ist [n̩] ein Sonorlaut."
                            },
                            {
                                "example_id": "fc5df7f8-d18b-4f6e-90ac-11bdce69650f",
                                "sense_id": "9fdf4da6-915c-37e1-ac09-99783564a4a4",
                                "text": "Über die Schallfülleskala: „…; innerhalb der Dauerlaute gehen die stimmhaften den stimmlosen vor; unter den stimmhaften Dauerlauten stehen die Vokoide, Liquide und Nasale (die Sonorlaute) höher als die stimmhaften Geräuschlaute (Frikative)…“"
                            }
                        ],
