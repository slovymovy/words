                ],
                "senses": [
                    {
                        "sense_id": "1ae87689-e271-3579-8062-915c435b6bda",
                        "entry_id": "4d0a9759-10b8-3c67-bd27-ad3dccf4e9dd",
                        "glosses": [
                            "weibliche Person, die auf einem bestimmten Gebiet keine Fachkenntnisse oder keine abgeschlossene Fachausbildung hat"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "44693641-3438-403d-9499-2726122ee341",
                                "sense_id": "1ae87689-e271-3579-8062-915c435b6bda",
                                "text": "„Dass erst eine sachkundige Laiin, die Staatsanwältin, Fragen stellte, die Fachleuten wesentlich besser angestanden hätten, ist für die Gutachter eine enorme Niederlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "57205aa3-8a31-3012-99dd-0dc4ae789bde",
                        "entry_id": "4d0a9759-10b8-3c67-bd27-ad3dccf4e9dd",
                        "glosses": [
                            "Gläubige, die nicht Geistliche ist"
                        ],
                        "tags": [
                            "Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "30b29fe1-6bc2-4396-b998-a93708429701",
                                "sense_id": "57205aa3-8a31-3012-99dd-0dc4ae789bde",
                                "text": "„Die 29-Jährige ist als erste Laiin vom Erzbistum Paderborn mit dem Begräbnisdienst im pastoralen Raum Gütersloh beauftragt worden, obgleich sie erst im Juni ihren runden Geburtstag feiert. Das Mindestalter für diese Tätigkeit beträgt nämlich eigentlich 30 Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8eea3d33-a964-390d-8734-f0fe1535c841",
                        "entry_id": "4d0a9759-10b8-3c67-bd27-ad3dccf4e9dd",
                        "glosses": [
                            "eine nicht rechtskundige Frau, die in einem Gerichtsverfahren als Entscheidungsorgan auftritt"
                        ],
                        "tags": [
                            "Rechtspflege"
                        ],
                        "examples": [
                            {
                                "example_id": "fe1341be-df40-4fe0-93d0-a5d4ad3603e7",
                                "sense_id": "8eea3d33-a964-390d-8734-f0fe1535c841",
                                "text": "„‚Was denken die Schöffen?‘ Frau Bruck, als Laiin stärker befangen vom zeremoniellen Ablauf aller Dinge vor Gericht, löste sich schwerfälliger, sagte aber jetzt doch auch ein wenig verwundert: ‚Ich kann nur sagen – ein solcher junger Mensch wie dieser, also… so etwas habe ich noch nie erlebt. […]‘“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
