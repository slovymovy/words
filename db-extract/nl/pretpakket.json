                "senses": [
                    {
                        "sense_id": "4849f7d1-9604-386d-9688-e9aa532df0e4",
                        "entry_id": "8c776670-4aa2-3e93-9660-0b8d5582448f",
                        "glosses": [
                            "vakkenpakket op de middelbare school zonder natuurwetenschappelijke vakken, het profiel Cultuur & Maatschappij komt het meest overeen met het pretpakket"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6b1560-ab22-4d14-8567-131cca9beec1",
                                "sense_id": "4849f7d1-9604-386d-9688-e9aa532df0e4",
                                "text": "Toen we ons bij de rector beklaagden over de ranzige lesmethodes van S. had hij een bijzonder katholieke oplossing: “Dan kies je toch geen natuurkunde?” En zo geschiedde. De meeste meisjes deden eindexamen in het pretpakket."
                            },
                            {
                                "example_id": "0ff81a40-9664-4e52-8c71-695056c0bbae",
                                "sense_id": "4849f7d1-9604-386d-9688-e9aa532df0e4",
                                "text": "Leerlingen kiezen massaal voor Natuur en Gezondheid en Natuur en Techniek, omdat ze dan de meeste opties voor een vervolgstudie openhouden. De imago's van de twee andere profielen spreken voor zich. Wie rijk wil worden, kiest voor Maatschappij en Economie, terwijl Cultuur en Maatschappij als een pretpakket wordt gezien. Deze beeldvorming is onterecht, maar hardnekkig. Op een bijeenkomst over profielkeuze (KNAW, 7 april) gaven de tweehonderd aanwezige schooldecanen aan dat zij de profielen het liefste wilden afschaffen."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ac5af68-1571-37a4-9d23-a1d88cfdf374",
                        "entry_id": "8c776670-4aa2-3e93-9660-0b8d5582448f",
                        "glosses": [
                            "verzameling zaken die geen enkel praktisch nut hebben maar wel leuk zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "156ec493-fd8f-4bee-a9e4-86086c61590e",
                                "sense_id": "4ac5af68-1571-37a4-9d23-a1d88cfdf374",
                                "text": "Een pretpakket met ouwe grappige rotzooi die ik een week eerder in een tweedehandswinkel had gekocht voor mijn vrienden die drie dagen achter me liepen."
                            }
                        ]
                    }
