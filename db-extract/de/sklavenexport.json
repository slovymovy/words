                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdd4c666-48f4-4f56-91d2-f052cf79c755",
                                "sense_id": "b59eb909-c716-3bd9-8e2b-9a63d8b853e2",
                                "text": "„Es waren Sklavenkarawanen wie die erwähnte, die zu einem großen Teil für den Anstieg der holländischen Sklavenexporte in den Zwanzigerjahren des 18. Jahrhunderts verantwortlich waren.“"
                            },
                            {
                                "example_id": "72d1bbef-ceee-4298-bb23-05e969c399a3",
                                "sense_id": "b59eb909-c716-3bd9-8e2b-9a63d8b853e2",
                                "text": "„Die Palmölexporte gewannen so immer mehr an Gewicht, erreichten schon etwa 1845 das (nunmehr stagnierende) Niveau der Einkommen aus Sklavenexporten und überflügelten dieses in der Folgezeit.“"
                            },
                            {
                                "example_id": "6d0c4892-c084-4cbd-a8b5-6296811a3cf3",
                                "sense_id": "b59eb909-c716-3bd9-8e2b-9a63d8b853e2",
                                "text": "„Mit dem Vertrag zwischen Omani und Briten werden Sklavenexporte verboten und alle Sklavenmärkte geschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
