                    {
                        "sense_id": "780bf9fe-d47d-347d-b748-f87761cd774d",
                        "entry_id": "3223c99f-de5a-3021-a8a2-341517c4105a",
                        "glosses": [
                            "de eerste afdruk van een drukwerk dat nog gecontroleerd kan worden voordat het definitieve drukproces begint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a322b65b-f65b-4f31-b56a-ce507eebc3e4",
                                "sense_id": "780bf9fe-d47d-347d-b748-f87761cd774d",
                                "text": "De proefdruk van Memoires van een componist ligt op zijn bureau. Per draaistoel zwiert Loevendie af en toe naar de Bechstein-piano die erachter staat, om wat voor te spelen of te pingelen als een vraag hem niet bovenmatig boeit. Het bureau is een schatkist van informatie. Aan de kast hangt een fluwelen colbert voor de concerten die hij bezoekt of geeft: alleen nog op piano want op zijn hoofdinstrumenten (sopraansax en klarinet) zou hij zijn door glaucoom geplaagde ogen blind blazen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb7ad4ee-3653-44b9-88df-271065dfb707",
                        "source_entry_id": "3223c99f-de5a-3021-a8a2-341517c4105a",
                        "source_sense_id": "780bf9fe-d47d-347d-b748-f87761cd774d",
                        "source_sense_description": "de eerste afdruk van een drukwerk dat nog gecorrigeerd kan worden voordat het definitieve drukproces begint",
                        "target_lang_word": "proof",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a08b984f-6010-3090-9b0e-83c6cf6d4a92",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "An effort, process, or operation designed to establish or discover a fact or truth; an act of testing; a test; a trial."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0111db07-5735-4207-be54-5e7846b4554d",
                                                "sense_id": "a08b984f-6010-3090-9b0e-83c6cf6d4a92",
                                                "text": "I need proof of your unconditional love. Lend me some dough."
                                            },
                                            {
                                                "example_id": "332c6eb7-6ce8-439a-a849-77b6412135cc",
                                                "sense_id": "a08b984f-6010-3090-9b0e-83c6cf6d4a92",
                                                "text": "1591, Edmund Spenser, Prosopopoia: or, Mother Hubbard's Tale, later also published in William Michael Rossetti, Humorous Poems,\nBut the false Fox most kindly played his part,\nFor whatsoever mother-wit or art\nCould work he put in proof. No practice sly,\nNo counterpoint of cunning policy,\nNo reach, no breach, that might him profit bring.\nBut he the same did to his purpose wring."
                                            },
                                            {
                                                "example_id": "3feccd1c-5223-4bad-b1c8-dfd92b82bd2a",
                                                "sense_id": "a08b984f-6010-3090-9b0e-83c6cf6d4a92",
                                                "text": "France I more praise and love; you are, my lord,\nYourself for horsemanship much famed; and there\nYou shall have many proofs to shew your skill."
                                            },
                                            {
                                                "example_id": "6ba02e56-39cc-43f0-ab4e-f01c84841ba5",
                                                "sense_id": "a08b984f-6010-3090-9b0e-83c6cf6d4a92",
                                                "text": "A given quantity of the spirits was poured upon a quantity of gunpowder in a dish and set on fire. If at the end of the combustion, the gunpowder continued dry enough, it took fire and exploded; but if it had been wetted by the water in the spirits, the flame of the alcohol went out without setting the powder on fire. This was called the proof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93415d97-9c2d-3c79-b4f9-5a310356471c",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "The degree of evidence which convinces the mind of any truth or fact, and produces belief; a test by facts or arguments which induce, or tend to induce, certainty of the judgment; conclusive evidence; demonstration."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dbe1063-f3cd-449e-b6f4-c473b96a1b00",
                                                "sense_id": "93415d97-9c2d-3c79-b4f9-5a310356471c",
                                                "text": "I'll have some proof."
                                            },
                                            {
                                                "example_id": "eda345b7-c454-4872-9536-34d73192a5ce",
                                                "sense_id": "93415d97-9c2d-3c79-b4f9-5a310356471c",
                                                "text": "It was a grand sentence of Emanuel Swedenborg, which would alone indicate the greatness of that man's perception, — \"It is no proof of a man's understanding to be able to confirm whatever he pleases; but to be able to discern that what is true is true, and that what is false is false, this is the mark and character of intelligence.\""
                                            },
                                            {
                                                "example_id": "57cfbada-dd88-48ef-99c0-d07ca2139722",
                                                "sense_id": "93415d97-9c2d-3c79-b4f9-5a310356471c",
                                                "text": "Faith, faith is an island in the setting sun\nBut proof, yes\nProof is the bottom line for everyone"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dfd0f44-027c-3b7b-8d3a-2c0af15f3af8",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "The quality or state of having been proved or tried; firmness or hardness which resists impression, or does not yield to force; impenetrability of physical bodies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a5ed460-02a6-316e-b0a0-d1da48ab0b51",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "Experience of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "275c6dc7-9329-4fbc-958c-dcbe4c344945",
                                                "sense_id": "8a5ed460-02a6-316e-b0a0-d1da48ab0b51",
                                                "text": "But the chaste damzell, that had never priefe / Of such malengine and fine forgerye, / Did easely beleeve her strong extremitye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "116a6cb8-3983-3c77-8cbf-cb86df4176bd",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "Firmness of mind; stability not to be shaken."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6f01026-3d88-3bd0-8610-d71e211c1db8",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "A proof sheet; a trial impression, as from type, taken for correction or examination."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3cb3e55-d8d9-4a7e-86dd-ee1c9421c5dd",
                                                "sense_id": "c6f01026-3d88-3bd0-8610-d71e211c1db8",
                                                "text": "And these men scour the printed proof for error, blunder, and misspelling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdabef87-55ff-30a7-985c-ab78b317c0d8",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "A limited-run high-quality strike of a particular coin, originally as a test run, although nowadays mostly for collectors' sets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "403561ff-77a3-3af4-8fec-e2a6d88cc69e",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "A sequence of statements consisting of axioms, assumptions, statements already demonstrated in another proof, and statements that logically follow from previous statements in the sequence, and which concludes with a statement that is the object of the proof."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0d71ce7-d37f-3a6b-bc3f-dd614a949999",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "A process for testing the accuracy of an operation performed. Compare prove, transitive verb, 5."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e16c336-00e9-3b4f-8f48-fbb1a76e288d",
                                        "entry_id": "f6738f74-ceff-30cb-aa1a-c1052b452593",
                                        "glosses": [
                                            "Armour of excellent or tried quality, and deemed impenetrable; properly, armour of proof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
