                "senses": [
                    {
                        "sense_id": "6ae9cf62-5f11-367e-9aa9-bc0ccbaf49ab",
                        "entry_id": "b05820ae-1dc9-3574-bd2c-0508a245dca9",
                        "glosses": [
                            "von selbst leuchten (ohne eine gleichzeitige Temperaturerhöhung); Licht emittieren"
