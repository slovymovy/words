                ],
                "senses": [
                    {
                        "sense_id": "733d4884-06cd-34c8-8cb3-93b1647b2031",
                        "entry_id": "2a79670d-d9d1-3128-b5ad-a953a8d83368",
                        "glosses": [
                            "Spielzeug, das sich nach einer entsprechenden Aktivierung auf seiner Spitze um die Hochachse dreht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07613577-5393-42e1-b21c-0ec95e73cc77",
                                "sense_id": "733d4884-06cd-34c8-8cb3-93b1647b2031",
                                "text": "„Wenn ein Spielkreisel langsamer wird, kann man eine taumelnde Bewegung beobachten.“"
                            },
                            {
                                "example_id": "fb907374-a592-40d5-93b9-dedda7bd2af7",
                                "sense_id": "733d4884-06cd-34c8-8cb3-93b1647b2031",
                                "text": "„Dem widerspricht auch nicht die Tatsache, daß Dämpfungseinflüsse beim Spielkreisel zum Aufrichten und damit zu einem Abklingen von Präzessionsbewegungen führen.“"
                            },
                            {
                                "example_id": "ff462ad8-c9c8-47fb-9e49-06d7827aea44",
                                "sense_id": "733d4884-06cd-34c8-8cb3-93b1647b2031",
                                "text": "„Bringt man nun Atome so zwischen die Pole eines Magneten, daß die Spin-Achse der Kerne mit den magnetischen Feldlinien einen Winkel bilden, dann tritt eine Präzession ein: die Rotationsachse führt eine zusätzliche Drehbewegung um die Richtung der Feldlinien aus, wie ein Spielkreisel, der um die vertikale Achse taumelt.“"
                            },
                            {
                                "example_id": "5d716b65-751d-423b-87ac-19caecf6c602",
                                "sense_id": "733d4884-06cd-34c8-8cb3-93b1647b2031",
                                "text": "„Die Reibung am Boden bewirkt, daß dieses Taumeln des Spielkreisels immer kleiner wird und schließlich ganz aufhört.“"
                            },
                            {
                                "example_id": "656c42e0-f16c-43fd-b297-abcef6eb37e4",
                                "sense_id": "733d4884-06cd-34c8-8cb3-93b1647b2031",
                                "text": "„Der Doppelkopf ist ein Spielkreisel der nicht angedreht, sondern angeschnippt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
