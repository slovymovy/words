                ],
                "senses": [
                    {
                        "sense_id": "d3a5ac08-8490-3a0a-912b-d79b7f858e01",
                        "entry_id": "959fe85f-34e5-3c55-adcd-68e271979b5a",
                        "glosses": [
                            "разг., сниж. мошенническая сделка или торговля, ловкая плутовская операция, умышленный обман; афера"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caee4691-08e1-4068-b31f-30506f5ebb30",
                                "sense_id": "d3a5ac08-8490-3a0a-912b-d79b7f858e01",
                                "text": "Потому что тут, знаете, шахер-махер, рука руку моет…"
                            },
                            {
                                "example_id": "9eba07f7-f381-4561-a365-7cd8057c823b",
                                "sense_id": "d3a5ac08-8490-3a0a-912b-d79b7f858e01",
                                "text": "А Иосиф был холостой, был делец, сапожное дело бросил, пошёл по торговой части, я думаю, спекулировал, делал всякий шахер-махер, особенно при нэпе, вёл разгульную жизнь и был большой ходок по женщинам."
                            }
                        ]
                    }
                ],
