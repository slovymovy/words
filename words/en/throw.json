    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c3e1aeb-e827-36a5-9df8-c1108bea67e2",
                    "sense_definition": "To send something through the air with force, usually by a movement of the arm and hand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>throw</w> the ball to the dog.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>брось</w> мяч собаке.",
                                "zh": "请把球<w>扔</w>给那只狗。"
                            }
                        },
                        {
                            "text": "He <w>threw</w> the empty bottle into the recycling bin.",
                            "target_lang_translations": {
                                "ru": "Он <w>выбросил</w> пустую бутылку в мусорную корзину.",
                                "zh": "他把空瓶子<w>扔</w>进了回收箱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hurl",
                        "toss",
                        "fling",
                        "pitch",
                        "cast",
                        "chuck",
                        "lob"
                    ],
                    "antonyms": [
                        "catch"
                    ],
                    "common_phrases": [
                        "throw a ball",
                        "throw away",
                        "throw something out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Посылать что-либо по воздуху с силой, обычно движением руки.",
                        "zh": "用手臂和手的动作将某物用力投掷到空中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "наиболее общее и нейтральное слово"
                            },
                            {
                                "target_lang_word": "кидать",
                                "target_lang_sense_clarification": "разговорный вариант"
                            },
                            {
                                "target_lang_word": "швырять",
                                "target_lang_sense_clarification": "бросать с силой или злостью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "最常用、最通俗的词"
                            },
                            {
                                "target_lang_word": "投掷",
                                "target_lang_sense_clarification": "较正式的表达"
                            },
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "向上或向远处投"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f8900fe-e799-3074-99f6-606dc2b19102",
                    "sense_definition": "To organize and host a social event, such as a party.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>throw</w> a surprise party for her birthday.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>устроить</w> вечеринку-сюрприз на её день рождения.",
                                "zh": "他们决定为她的生日<w>举办</w>一场惊喜派对。"
                            }
                        },
                        {
                            "text": "We should <w>throw</w> a celebration when you graduate.",
                            "target_lang_translations": {
                                "ru": "Нам стоит <w>организовать</w> празднование, когда ты выпустишься.",
                                "zh": "你毕业时我们应该<w>举办</w>一场庆祝活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "host",
                        "organize",
                        "hold",
                        "put on",
                        "arrange"
                    ],
                    "common_phrases": [
                        "throw a party",
                        "throw a bash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать и проводить общественное мероприятие, например, вечеринку.",
                        "zh": "组织并举办社交活动，如派对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устраивать",
                                "target_lang_sense_clarification": "организовывать (вечеринку, праздник)"
                            },
                            {
                                "target_lang_word": "организовывать",
                                "target_lang_sense_clarification": "официальный или нейтральный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "举办",
                                "target_lang_sense_clarification": "组织活动"
                            },
                            {
                                "target_lang_word": "举行",
                                "target_lang_sense_clarification": "正式举办"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37e0eb33-d9c5-3159-aefb-aea28555a926",
                    "sense_definition": "To confuse, surprise, or disconcert someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult question completely <w>threw</w> me during the interview.",
                            "target_lang_translations": {
                                "ru": "Трудный вопрос совершенно <w>сбил</w> меня с толку во время собеседования.",
                                "zh": "面试时那个难题完全把我<w>难住</w>了。"
                            }
                        },
                        {
                            "text": "Her sudden change of plans <w>threw</w> him for a moment.",
                            "target_lang_translations": {
                                "ru": "Её внезапная смена планов на мгновение <w>озадачила</w> его.",
                                "zh": "她突然改变计划让他一时感到<w>困惑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confuse",
                        "baffle",
                        "disconcert",
                        "unsettle"
                    ],
                    "common_phrases": [
                        "throw someone off",
                        "completely thrown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбивать с толку, удивлять или приводить в замешательство.",
                        "zh": "使某人困惑、惊讶或不知所措。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "запутывать"
                            },
                            {
                                "target_lang_word": "озадачивать",
                                "target_lang_sense_clarification": "вызывать недоумение"
                            },
                            {
                                "target_lang_word": "приводить в замешательство",
                                "target_lang_sense_clarification": "смущать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使困惑",
                                "target_lang_sense_clarification": "让人感到迷茫"
                            },
                            {
                                "target_lang_word": "使不知所措",
                                "target_lang_sense_clarification": "让人感到慌乱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "749ae747-9a5a-3a04-8bd3-8cf5549688ff",
                    "sense_definition": "To put someone or something into a particular place or condition roughly, quickly, or forcefully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "forceful_placement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer threatened to <w>throw</w> the thief in jail.",
                            "target_lang_translations": {
                                "ru": "Полицейский пригрозил <w>бросить</w> вора в тюрьму.",
                                "zh": "警察威胁要把小偷<w>关进</w>监狱。"
                            }
                        },
                        {
                            "text": "The unexpected news <w>threw</w> the entire office into chaos.",
                            "target_lang_translations": {
                                "ru": "Неожиданная новость <w>ввергла</w> весь офис в хаос.",
                                "zh": "突如其来的消息让整个办公室<w>陷入</w>了混乱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "force",
                        "thrust",
                        "plunge"
                    ],
                    "common_phrases": [
                        "throw in jail",
                        "throw into confusion",
                        "throw into panic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать кого-либо или что-либо в определенное место или состояние грубо, быстро или с силой.",
                        "zh": "粗暴、快速或用力地将某人或某物置于特定地点或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "помещать куда-либо (напр. в тюрьму)"
                            },
                            {
                                "target_lang_word": "ввергать",
                                "target_lang_sense_clarification": "приводить в состояние (напр. в хаос)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扔进",
                                "target_lang_sense_clarification": "将某物置于某处"
                            },
                            {
                                "target_lang_word": "使陷入",
                                "target_lang_sense_clarification": "使进入某种状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f01f533-9409-3734-a5f6-b171eafc9a9f",
                    "sense_definition": "To deliver a punch with the fist.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He learned how to <w>throw</w> a punch in his boxing class.",
                            "target_lang_translations": {
                                "ru": "Он научился <w>наносить</w> удар кулаком на занятиях по боксу.",
                                "zh": "他在拳击课上学会了如何<w>出拳</w>。"
                            }
                        },
                        {
                            "text": "The actor had to <w>throw</w> a fake punch for the movie scene.",
                            "target_lang_translations": {
                                "ru": "Актёру пришлось <w>изобразить</w> фальшивый удар для сцены в фильме.",
                                "zh": "演员为了电影场景必须<w>挥</w>出一记假拳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deliver"
                    ],
                    "common_phrases": [
                        "throw a punch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить удар кулаком.",
                        "zh": "挥拳击打。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносить",
                                "target_lang_sense_clarification": "делать удар (в сочетании с 'удар')"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出拳",
                                "target_lang_sense_clarification": "挥动拳头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "314a499b-8388-36fa-8d6f-ff7be8968c03",
                    "sense_definition": "To roll dice in a game.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is your turn to <w>throw</w> the dice.",
                            "target_lang_translations": {
                                "ru": "Твоя очередь <w>бросать</w> кости.",
                                "zh": "轮到你<w>掷</w>骰子了。"
                            }
                        },
                        {
                            "text": "She <w>threw</w> a six and moved her piece to the finish line.",
                            "target_lang_translations": {
                                "ru": "Она <w>выбросила</w> шестёрку и передвинула свою фишку к финишу.",
                                "zh": "她<w>掷</w>出了六点，把棋子移到了终点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roll",
                        "cast"
                    ],
                    "common_phrases": [
                        "throw the dice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать игральные кости в игре.",
                        "zh": "在游戏中掷骰子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "кидать кубики"
                            },
                            {
                                "target_lang_word": "кидать",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掷",
                                "target_lang_sense_clarification": "投掷骰子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b25b7634-945c-3e76-b636-0d732c386c66",
                    "sense_definition": "To express sudden and intense emotion, especially anger or frustration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler <w>threw</w> a tantrum in the middle of the supermarket.",
                            "target_lang_translations": {
                                "ru": "Малыш <w>закатил</w> истерику посреди супермаркета.",
                                "zh": "那个幼儿在超市中间<w>大发雷霆</w>。"
                            }
                        },
                        {
                            "text": "There is no need to <w>throw</w> a fit just because you lost the game.",
                            "target_lang_translations": {
                                "ru": "Нет нужды <w>устраивать</w> сцену только из-за того, что ты проиграл игру.",
                                "zh": "没必要因为输了比赛就<w>闹情绪</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "throw a tantrum",
                        "throw a fit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in phrases like 'throw a fit'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать внезапные и сильные эмоции, особенно гнев или разочарование.",
                        "zh": "表达突然且强烈的情绪，尤其是愤怒或沮丧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закатывать",
                                "target_lang_sense_clarification": "устраивать (истерику, скандал)"
                            },
                            {
                                "target_lang_word": "устраивать",
                                "target_lang_sense_clarification": "делать сцену"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大发雷霆",
                                "target_lang_sense_clarification": "发脾气"
                            },
                            {
                                "target_lang_word": "闹情绪",
                                "target_lang_sense_clarification": "耍性子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75a320e2-12a3-37e7-a75c-c7b320eb6d26",
                    "sense_definition": "To generate an error or exception in computer programming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application will <w>throw</w> an error if the input is invalid.",
                            "target_lang_translations": {
                                "ru": "Приложение <w>выдаст</w> ошибку, если ввод неверный.",
                                "zh": "如果输入无效，应用程序将<w>抛出</w>错误。"
                            }
                        },
                        {
                            "text": "This method <w>throws</w> an exception when the file cannot be found.",
                            "target_lang_translations": {
                                "ru": "Этот метод <w>выбрасывает</w> исключение, когда файл не может быть найден.",
                                "zh": "当找不到文件时，此方法会<w>抛出</w>异常。"
                            }
                        }
                    ],
                    "synonyms": [
                        "raise"
                    ],
                    "antonyms": [
                        "catch"
                    ],
                    "common_phrases": [
                        "throw an exception",
                        "throw an error"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical context (programming)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Генерировать ошибку или исключение в компьютерном программировании.",
                        "zh": "在计算机编程中生成错误或异常。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "сообщать об ошибке"
                            },
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "технический термин (калька с англ.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抛出",
                                "target_lang_sense_clarification": "编程术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b596db0-7c75-384b-bf57-1a527a140741",
                    "sense_definition": "To intentionally lose a game or contest, often for dishonest reasons.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gaming_dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer was accused of taking a bribe to <w>throw</w> the fight.",
                            "target_lang_translations": {
                                "ru": "Боксёра обвинили в получении взятки за то, чтобы <w>сдать</w> бой.",
                                "zh": "这名拳击手被指控收受贿赂以<w>打假球</w>。"
                            }
                        },
                        {
                            "text": "He refused to <w>throw</w> the match despite the pressure from gamblers.",
                            "target_lang_translations": {
                                "ru": "Он отказался <w>проиграть</w> матч, несмотря на давление со стороны игроков.",
                                "zh": "尽管受到赌徒的压力，他还是拒绝<w>打假球</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "throw a game",
                        "throw a match",
                        "throw the fight"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно проиграть игру или состязание, часто по нечестным причинам.",
                        "zh": "故意输掉比赛或竞赛，通常出于不诚实的原因。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "намеренно проигрывать"
                            },
                            {
                                "target_lang_word": "сливать",
                                "target_lang_sense_clarification": "жаргонное выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打假球",
                                "target_lang_sense_clarification": "故意输掉比赛"
                            }
                        ]
                    }
                },
                {
