                "senses": [
                    {
                        "sense_id": "65b0296f-1706-317c-bc5e-ead3221b4d7f",
                        "entry_id": "2a524584-9486-31c8-bc76-3920eaab40e7",
                        "glosses": [
                            "een houten blaasinstrument met een rechte conische boring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c31501-16c9-43b8-baba-87674fa71365",
                                "sense_id": "65b0296f-1706-317c-bc5e-ead3221b4d7f",
                                "text": "Aan de oevers flaneren klassendames (koeien) die de groene grassprietjes uittrekken, vaak hoor je de herdersfluit."
                            },
                            {
                                "example_id": "225fead6-3e97-4983-9960-7fee2a416e04",
                                "sense_id": "65b0296f-1706-317c-bc5e-ead3221b4d7f",
                                "text": "Speciale gast is de Bulgaar Theodosii Spassov, bespeler van de kaval (herdersfluit), die hij introduceerde in de jazz. Denk bij de aanwezigheid van een herdersfluit nu vooral niet aan het ijl pastoraal gefiedel, dat misschien op schapen een kalmerende werking heeft, maar niet op de stadsmensen die het Bimhuis bezoeken."
                            }
                        ]
                    }
