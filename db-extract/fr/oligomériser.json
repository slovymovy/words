                "senses": [
                    {
                        "sense_id": "5e22d978-9995-3742-aa77-a37e7a1b07ea",
                        "entry_id": "ce43c2b9-9512-30b5-856f-338f435a2254",
                        "glosses": [
                            "Provoquer la transformation de monomères en oligomères dans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c8db3db-4bd3-4f1e-9de7-859fa3c45175",
                                "sense_id": "5e22d978-9995-3742-aa77-a37e7a1b07ea",
                                "text": "Dans un premier temps, nous avons démontré, pour la première fois, que la tyrosine-kinase Wzc est capable de s'oligomériser in vivo."
                            },
                            {
                                "example_id": "1be29682-7a28-4432-8e7f-f43659f3cd0a",
                                "sense_id": "5e22d978-9995-3742-aa77-a37e7a1b07ea",
                                "text": "Une propriété commune des ligands capables de stimuler des cellules est celle d'oligomériser, au minimum de dimériser, souvent de multimériser, d'une façon générale d'agréger les récepteurs à la surface des cellules [1, 2]."
                            }
                        ]
                    }
