    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8de247d3-a339-3b55-9ab4-4e781f65739d",
                    "sense_definition": "To draw attention away from others, especially on-stage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "theatrical_performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She only wore that bright dress to <w>upstage</w> everyone at the party."
                        },
                        {
                            "text": "The lead actor felt <w>upstaged</w> by the talented newcomer during the final scene."
                        }
                    ],
                    "synonyms": [
                        "eclipse",
                        "overshadow"
                    ]
                },
                {
                    "sense_id": "7ebd491a-6745-3c05-9997-cc5685bcf2c4",
                    "sense_definition": "To force other actors to face away from the audience by staying upstage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatrical_performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director warned the actor not to <w>upstage</w> his partner during the dialogue."
                        },
                        {
                            "text": "By moving to the back, he effectively <w>upstaged</w> the rest of the cast."
                        }
                    ],
                    "antonyms": [
