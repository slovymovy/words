                    {
                        "sense_id": "3116b138-5967-3999-b336-c6f5c0219db9",
                        "entry_id": "d7ff9050-8f0a-361f-a146-a47a41f0e1f1",
                        "glosses": [
                            "Fließgewässer, das sich mit einem anderen, etwa gleich starken Fluss zu einem größeren Strom vereinigt, wobei am Zusammenfluss ein Namenswechsel stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2ef637-b19d-44a0-8477-7f0594a7b4ad",
                                "sense_id": "3116b138-5967-3999-b336-c6f5c0219db9",
                                "text": "Brigach und Breg sind die Quellflüsse der Donau."
                            },
                            {
                                "example_id": "0d1cfb68-34de-4166-9617-1165aa2210bb",
                                "sense_id": "3116b138-5967-3999-b336-c6f5c0219db9",
                                "text": "„Die Stadt lag an den Reiserouten der Jesuiten zu ihren Missionsgebieten in den Anden und an den Quellflüssen des Amazonas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
