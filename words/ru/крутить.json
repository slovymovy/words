                {
                    "sense_id": "ce976c14-ee0f-382b-a7c1-cf0991ef024e",
                    "sense_definition": "Вращать что-либо, приводить в круговое движение.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель начал резко <крутить> руль влево, чтобы избежать аварии.",
                            "target_lang_translations": {
                                "en": "The driver started to sharply <turn> the steering wheel to the left to avoid an accident.",
                                "es": "El conductor empezó a <girar> bruscamente el volante hacia la izquierda para evitar un accidente.",
                                "fr": "Le conducteur a commencé à <tourner> brusquement le volant vers la gauche pour éviter un accident."
                            }
                        },
                        {
                            "text": "Дети любят <крутить> глобус и искать на нём разные страны.",
                            "target_lang_translations": {
                                "en": "Children love to <spin> the globe and look for different countries on it.",
                                "es": "A los niños les encanta <hacer girar> el globo terráqueo y buscar diferentes países en él.",
                                "fr": "Les enfants adorent <faire tourner> le globe pour chercher différents pays dessus."
                            }
                        }
                    ],
                    "synonyms": [
                        "вращать",
                        "вертеть",
                        "поворачивать"
                    ],
                    "common_phrases": [
                        "крутить руль",
                        "крутить педали",
                        "крутить головой",
                        "крутить колесо"
