                        "source_sense_id": "bd2b31a2-b80f-3710-bc32-946934b0bd6f",
                        "target_lang_word": "réformatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réformatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a0084c-0f95-39c3-a42c-b1749363f317",
                                        "entry_id": "188b5056-afa2-3d46-b9b4-80deebf85211",
                                        "glosses": [
                                            "Celle qui réforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa18d38e-da23-42c0-aa95-ff1d4b795b93",
                                                "sense_id": "f1a0084c-0f95-39c3-a42c-b1749363f317",
                                                "text": "La suffragette Elizabeth Cady Stanton, la réformatrice Fanny Wright, la femme d’affaires Sheryl Sandberg et la militante politique Wangari Maathai figurent parmi ce nombre."
                                            },
                                            {
                                                "example_id": "33c1b247-25c2-4f1b-9de9-c008953478dd",
                                                "sense_id": "f1a0084c-0f95-39c3-a42c-b1749363f317",
                                                "text": "Ce mardi soir, la Première Ministre du Gouvernement fédéral, Sophie Wilmés, a annoncé de nouvelles mesures contre la propagation du Covid-19 sur le territoire belge. Quelques jours après avoir appelé à la fermeture de tous les lieux et activités de divertissements, la réformatrice a décrété le confinement à partir de ce mercredi 12h et jusqu'au dimanche 5 avril."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bc9b93-ba91-337b-884b-0f3a2c93cbf9",
                                        "entry_id": "188b5056-afa2-3d46-b9b4-80deebf85211",
                                        "glosses": [
                                            "Celle qui est impliquée dans la réforme du christianisme ou dans le christianisme réformé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
