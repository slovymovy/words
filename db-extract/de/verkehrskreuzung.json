                ],
                "senses": [
                    {
                        "sense_id": "cb25ed25-09e8-380c-b7df-ec772a136ad3",
                        "entry_id": "751a5d2f-6368-3474-a1d5-2d5684ed4435",
                        "glosses": [
                            "Punkt, an dem sich der Verlauf zweier oder mehrerer Verkehrswege überschneidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb823a4d-dd5c-4c3c-9925-9c83590772c5",
                                "sense_id": "cb25ed25-09e8-380c-b7df-ec772a136ad3",
                                "text": "„In den wohlhabenderen Städten der Industrieländer wird anscheinend jeder Parkplatz, jede unbebaute Parzelle, jede Abstellfläche, Verkehrskreuzung, verlassene Industrieanlage und jedes Hafengebiet in einen neuen Ort verwandelt.“"
                            },
                            {
                                "example_id": "4fd9f63b-6886-47c8-985a-c6efcf96ec17",
                                "sense_id": "cb25ed25-09e8-380c-b7df-ec772a136ad3",
                                "text": "„Die Verkehrskreuzung ist eine sehr komplexe Verkehrssituation, die dem Verkehrsverständnis und Verkehrskönnen der Kinder viel abverlangt.“"
                            },
                            {
                                "example_id": "2da0a068-f883-4cbb-982d-e9dfa5727eb2",
                                "sense_id": "cb25ed25-09e8-380c-b7df-ec772a136ad3",
                                "text": "„Als Plattform für einen entsprechenden Versuchsaufbau wurde eine innerstädtische öffentliche Verkehrskreuzung ausgewählt, die sowohl verkehrstechnisch einen neuralgischen Punkt darstellt, als auch die Untersuchung einer großen Zahl möglicher Szenarien unter Beteiligung verschiedenster Verkehrsteilnehmer ermöglicht.“"
                            },
                            {
                                "example_id": "4eac7ba5-6bee-407a-917b-7be86593bd25",
                                "sense_id": "cb25ed25-09e8-380c-b7df-ec772a136ad3",
                                "text": "„Tausende Menschen standen schweigend auf den Plätzen und großen Verkehrskreuzungen der polnischen Hauptstadt sowie vor den Gräbern und Denkmälern der Aufständischen.“"
                            },
                            {
                                "example_id": "bb22458c-5884-437b-905c-15de4d007ce0",
                                "sense_id": "cb25ed25-09e8-380c-b7df-ec772a136ad3",
                                "text": "„An belebten Verkehrskreuzungen ruinieren Feuerschlucker ihre Gesundheit für Pfennigbeträge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
