                    },
                    {
                        "translation_id": "48f0f65e-dc7a-4e69-a122-e4765fb6d5db",
                        "source_entry_id": "f3df11d9-9d47-3dc5-b919-4ea78e60e81f",
                        "source_sense_description": "наречие",
                        "target_lang_word": "too much",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "too much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e9a74e-fe9a-3a34-b2da-b66c7b52fe00",
                                        "entry_id": "4c9725f4-7c84-3dac-b808-47e683aed17b",
                                        "glosses": [
                                            "To a greater extent than is wanted or required; excessively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f1b28c8-4918-478d-9cfe-6adabdc60042",
                                                "sense_id": "a1e9a74e-fe9a-3a34-b2da-b66c7b52fe00",
                                                "text": "You talk (much/far/rather) too much."
                                            },
                                            {
                                                "example_id": "8e90b42f-64ec-49be-9f4a-7210495e04d8",
                                                "sense_id": "a1e9a74e-fe9a-3a34-b2da-b66c7b52fe00",
                                                "text": "I was too much affected by their criticisms."
                                            },
                                            {
                                                "example_id": "281256f6-bffb-4779-a916-139265958e93",
                                                "sense_id": "a1e9a74e-fe9a-3a34-b2da-b66c7b52fe00",
                                                "text": "You've given me back one dollar too much."
                                            },
                                            {
                                                "example_id": "51040058-96dc-42ce-88e2-39027af72882",
                                                "sense_id": "a1e9a74e-fe9a-3a34-b2da-b66c7b52fe00",
                                                "text": "Nothing too much out of the ordinary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68375a7e-184c-3b8f-b4b8-07f1494ee041",
                                        "entry_id": "4c9725f4-7c84-3dac-b808-47e683aed17b",
                                        "glosses": [
                                            "To a sufficiently strong degree to prevent some other action from happening."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af442a7f-5fdb-44cc-b9b0-b239ad075ac2",
                                                "sense_id": "68375a7e-184c-3b8f-b4b8-07f1494ee041",
                                                "text": "I'm not leaving now ... I'm enjoying myself too much!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "too much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f005e41-254d-3b80-9462-8bcda2abfca9",
                                        "entry_id": "16169afe-7774-38c2-8230-4106e01a36c6",
                                        "glosses": [
                                            "More (of something) than is desirable or required."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee52cd9b-a8bf-4482-8002-d03acc47de66",
                                                "sense_id": "8f005e41-254d-3b80-9462-8bcda2abfca9",
                                                "text": "You ate too much cake at the party, and that's why you feel sick."
                                            },
                                            {
                                                "example_id": "aa82871c-4367-429c-b516-976657380250",
                                                "sense_id": "8f005e41-254d-3b80-9462-8bcda2abfca9",
                                                "text": "There's far too much attention being paid to it."
                                            },
                                            {
                                                "example_id": "2d4b232e-d776-4ef8-b73e-30814724b12b",
                                                "sense_id": "8f005e41-254d-3b80-9462-8bcda2abfca9",
                                                "text": "Patient: ...too much is bad for you.\nDoctor: Well of course too much is bad for you, that's what \"too much\" means, you blithering twat. If you had too much water, it would be bad for you, wouldn't it? \"Too much\" precisely means that quantity which is excessive, that's what it means. Could you ever say \"too much water is good for you\"? I mean if it's too much it's too much. Too much of anything is too much. Obviously. Jesus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3daf80c-1e77-3454-9002-72db86f860ce",
                                        "entry_id": "16169afe-7774-38c2-8230-4106e01a36c6",
                                        "glosses": [
                                            "Much; even a moderate amount."
                                        ],
                                        "tags": [
                                            "in negative constructions"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824855d3-d767-4a7a-a81e-b9a66dcefafc",
                                                "sense_id": "a3daf80c-1e77-3454-9002-72db86f860ce",
                                                "text": "They call it a beach, but there isn't too much sand there."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "too much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ab13494-4485-308e-be3d-1e5738867b0c",
                                        "entry_id": "78cf231d-72d0-3cf0-a9b8-b5ab2a712af2",
                                        "glosses": [
                                            "Amusing; entertaining."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05c65798-7de6-4d8e-b894-7d6bd075dbdf",
                                                "sense_id": "7ab13494-4485-308e-be3d-1e5738867b0c",
                                                "text": "Oh, my dear, you really are too much."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "too much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d78672d-a868-33a5-a0f9-813051c01968",
                                        "entry_id": "d7e63bb2-bc13-3717-9fe7-d05a8d826f87",
                                        "glosses": [
                                            "A quantity which is excessive to the point of being inappropriate, harmful, or overwhelming."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52817a7b-aaad-4b69-a783-4482b2e036b7",
                                                "sense_id": "2d78672d-a868-33a5-a0f9-813051c01968",
                                                "text": "You expect too much from your employees."
                                            },
                                            {
                                                "example_id": "15906c3a-2236-4ee0-ad99-33a302e6a18c",
                                                "sense_id": "2d78672d-a868-33a5-a0f9-813051c01968",
                                                "text": "Patient: ...too much is bad for you.\nDoctor: Well of course too much is bad for you, that's what \"too much\" means, you blithering twat. If you had too much water, it would be bad for you, wouldn't it? \"Too much\" precisely means that quantity which is excessive, that's what it means. Could you ever say \"too much water is good for you\"? I mean if it's too much it's too much. Too much of anything is too much. Obviously. Jesus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c09506d-3774-394f-bc62-b7c4cd1d71c2",
                                        "entry_id": "d7e63bb2-bc13-3717-9fe7-d05a8d826f87",
                                        "glosses": [
                                            "Something that is absurdly funny or inappropriate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea3717a7-2043-458b-8756-de6fc6f5d320",
                                                "sense_id": "7c09506d-3774-394f-bc62-b7c4cd1d71c2",
                                                "text": "You really are too much!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "too much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc19cfb-1275-3805-af4d-c48a200497ba",
                                        "entry_id": "21cce642-33ac-3975-af99-6d88414d82f8",
                                        "glosses": [
