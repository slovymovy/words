                        "form_id": "bf94a8d6-6fb8-4e44-9aec-369fe7316981",
                        "entry_id": "a73ae1b3-4abb-3a7d-b086-aff7bf01f2e6",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "unigenres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "421ea7ee-d414-3600-b512-1c9ce4dfc6a2",
                        "entry_id": "a73ae1b3-4abb-3a7d-b086-aff7bf01f2e6",
                        "glosses": [
                            "Qui est d’un seul genre (soit masculin, soit féminin)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3368098-ef1f-4241-ba94-395b9d3cb1f8",
                                "sense_id": "421ea7ee-d414-3600-b512-1c9ce4dfc6a2",
                                "text": "Dans les dyades unigenres les femmes se regarderaient davantage que les hommes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca92256b-d360-3839-9fd3-629a7b25a96b",
                        "entry_id": "a73ae1b3-4abb-3a7d-b086-aff7bf01f2e6",
                        "glosses": [
                            "Qui ne différencie pas le genre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30ce2c6-d3c7-4043-946e-dc0fd457a2fd",
                                "sense_id": "ca92256b-d360-3839-9fd3-629a7b25a96b",
                                "text": "(...) l’anglais they, forme plurielle unigenre, opposée aux singuliers différenciés: he, she, it."
                            },
                            {
                                "example_id": "6f2af62c-8072-457f-b5e8-15c29267ffcc",
                                "sense_id": "ca92256b-d360-3839-9fd3-629a7b25a96b",
                                "text": "Eh oui, on va construire des toilettes unigenres sur tous les campus du pays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a720413-8953-4a2a-bda5-b384eb26ee61",
                        "source_entry_id": "a73ae1b3-4abb-3a7d-b086-aff7bf01f2e6",
                        "target_lang_word": "gender-neutral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gender-neutral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29fe6ad5-a8ce-3be7-b349-30c7f0967520",
                                        "entry_id": "2db813e0-42ce-3cce-9ed3-70a9183b7c87",
                                        "glosses": [
                                            "Not having, indicating, or being restricted on the basis of, gender.",
                                            "Used by or intended for people of any gender; not restricted to (only one) gender; available to all genders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a4d2d2-fac4-4ccd-a1e5-057e4d337f2a",
                                                "sense_id": "29fe6ad5-a8ce-3be7-b349-30c7f0967520",
                                                "text": "The women's sleeping quarters are on the left side of the dormitory, the men's are on the right; gender-neutral restrooms are located in the middle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "899336e3-df8a-3f6c-aa6f-a3bbde91b1d4",
                                        "entry_id": "2db813e0-42ce-3cce-9ed3-70a9183b7c87",
                                        "glosses": [
                                            "Not having, indicating, or being restricted on the basis of, gender.",
                                            "Of words, phrasing, etc.: not indicating or referring to (only one) gender."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f960046-5846-4d8f-8935-1e02af21dcd5",
                                                "sense_id": "899336e3-df8a-3f6c-aa6f-a3bbde91b1d4",
                                                "text": "Many modern laws use gender-neutral constructions like \"they\" in place of the old, supposedly unmarked \"he\"."
                                            },
                                            {
                                                "example_id": "4c6be13e-a249-44f3-87ae-3271d7516361",
                                                "sense_id": "899336e3-df8a-3f6c-aa6f-a3bbde91b1d4",
                                                "text": "Gender-neutral pronouns like \"ey\" and \"ze\" are used by many genderqueer, intersex, and neutrois individuals."
                                            },
                                            {
                                                "example_id": "f249bfe4-d248-448c-90d9-005709c67c1d",
                                                "sense_id": "899336e3-df8a-3f6c-aa6f-a3bbde91b1d4",
                                                "text": "“[…] Tes name was Iptim Op’tarmk and te was nineteen years old.[…]” / Ramant’s brain had to switch gears. Of course he knew that the Vonarians used a gender-neutral pronoun set when referring to themselves, and he’d even practiced it, but when it rolled off Boë’s sweet and mellow tongue it sounded like an alien language."
                                            },
                                            {
                                                "example_id": "d102906f-994f-4ba1-808f-a90ef4f47bf6",
                                                "sense_id": "899336e3-df8a-3f6c-aa6f-a3bbde91b1d4",
                                                "text": "Alongside its vital role of maintaining and reviewing each of the rail industry's 294 technical and safety standards, the Rail Safety and Standards Board (RSSB) is about to turn its attention to how to make the term 'pilotman' gender-neutral."
                                            },
                                            {
                                                "example_id": "c2e7c90c-c1ae-4da9-b4a3-b42a4810322e",
                                                "sense_id": "899336e3-df8a-3f6c-aa6f-a3bbde91b1d4",
                                                "text": "Berlin’s recently appointed conservative mayor has said he will refuse to use gender-neutral language in office, insisting he wanted to use a language “that everyone understands”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e8fff5c-b7a7-366f-beab-714578f8819a",
                                        "entry_id": "2db813e0-42ce-3cce-9ed3-70a9183b7c87",
                                        "glosses": [
                                            "Not having, indicating, or being restricted on the basis of, gender.",
                                            "In particular, in languages where words are assigned to one grammatical gender or another: lacking such an assignment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
