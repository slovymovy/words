                "senses": [
                    {
                        "sense_id": "526d4fa3-3917-35d0-8796-c6ddcebd47c4",
                        "entry_id": "b3494f7f-fc37-3a7e-84ec-d7a782113728",
                        "glosses": [
                            "Entreprise américaine « The Coca-Cola Company »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ed2774-a5b4-4f39-b877-584347938925",
                                "sense_id": "526d4fa3-3917-35d0-8796-c6ddcebd47c4",
                                "text": "Le message est parfaitement calibré pour détourner l’attention des Sprite, Fanta et autres Minute Maid, propriétés de Coca-Cola, leader mondial du secteur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "df6ed5c9-bdd3-3d69-ac98-ccab74f0aa6b",
                "word": "Coca-Cola",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "252e5ca3-609f-485b-bbe9-885e05e2cb29",
                        "entry_id": "df6ed5c9-bdd3-3d69-ac98-ccab74f0aa6b",
                        "tags": [],
                        "form": "coca-cola"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af42c9c8-8aa0-3fae-a831-e94319b9ca85",
                        "entry_id": "df6ed5c9-bdd3-3d69-ac98-ccab74f0aa6b",
                        "glosses": [
                            "Boisson gazeuse sucrée, à base de noix de cola et d’extrait de feuilles de coca ; marque de soda de l'entreprise « The Coca-Cola Company »."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "48ae0fe3-6c33-4d1c-b672-bd259fc6d22f",
                                "sense_id": "af42c9c8-8aa0-3fae-a831-e94319b9ca85",
                                "text": "Il y a plusieurs années, certaines personnes croyaient que les salles de cinéma manipulaient les consommateurs en leur présentant des messages subliminaux, comme « Mangez un maïs éclaté » ou « Buvez un Coca-Cola »."
                            },
                            {
                                "example_id": "d86c3969-bb94-4f75-a869-c83df6f26135",
                                "sense_id": "af42c9c8-8aa0-3fae-a831-e94319b9ca85",
                                "text": "Ils trinquèrent, lui avec son verre de champigny et elle avec sa cannette de Coca-Cola."
                            },
                            {
                                "example_id": "19242771-4c18-4b61-859e-14f6a4268591",
                                "sense_id": "af42c9c8-8aa0-3fae-a831-e94319b9ca85",
                                "text": "Chez moi, je me décapsulai un Coca-Cola et regardai une nouvelle fois Le Mépris."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa4be4f9-83ec-4768-89d1-99becd6791f9",
                        "source_entry_id": "df6ed5c9-bdd3-3d69-ac98-ccab74f0aa6b",
                        "source_sense_id": "af42c9c8-8aa0-3fae-a831-e94319b9ca85",
                        "target_lang_word": "Coca-Cola",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Coca-Cola",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca61d444-6696-38ce-8a89-a644a874069b",
                                        "entry_id": "60b291d5-7a84-39cf-b637-88aa555472ee",
                                        "glosses": [
                                            "koffeinhaltiges Erfrischungsgetränk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "708065ff-c8b1-40b9-aeb6-94eaac907d82",
                                                "sense_id": "ca61d444-6696-38ce-8a89-a644a874069b",
                                                "text": "„Sie bestellten Coca-Cola und machten es sich bequem.“"
                                            },
                                            {
                                                "example_id": "e43a0e29-4760-40cc-99fd-91af9d7e024b",
                                                "sense_id": "ca61d444-6696-38ce-8a89-a644a874069b",
                                                "text": "„Es war vor dem Abendessen, ich saß zu einem Aperitif an der Bar, meine Frau war noch mit der kosmetischen Vorbereitung oben auf dem Zimmer beschäftigt, die beiden Kinder tranken Coca-Cola und ich ein Glas Sekt.“"
                                            },
                                            {
                                                "example_id": "1269e7a8-df50-40b6-b90c-a79ef0535ce7",
                                                "sense_id": "ca61d444-6696-38ce-8a89-a644a874069b",
                                                "text": "„Jessie kam mit seiner Coca-Cola aus dem Laden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
