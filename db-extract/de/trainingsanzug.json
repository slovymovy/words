                                "sense_id": "5646e241-8123-3c98-bb9c-08966d43f9cf",
                                "text": "„Dr. Mortier kam im Trainingsanzug, umweht von einem herben sportlichen Hauch.“"
                            },
                            {
                                "example_id": "83912a75-4a71-4b30-834a-4c91d0046cfa",
                                "sense_id": "5646e241-8123-3c98-bb9c-08966d43f9cf",
                                "text": "„In meinen betagten, von Flicken verzierten Trainingsanzug werden zweitausend Reichsmark eingenäht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
