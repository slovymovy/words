                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slumbering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "049acb0e-c2b0-3738-80df-e1dc03c5fd40",
                                        "entry_id": "dae5afd7-aa62-3ef2-928d-51237db0d976",
                                        "glosses": [
                                            "Temporarily inactive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d5f64a-bb98-417c-89a2-2a26ba3ec5e0",
                                                "sense_id": "049acb0e-c2b0-3738-80df-e1dc03c5fd40",
                                                "text": "The slumbering giant that was China has finally awoken."
                                            },
                                            {
                                                "example_id": "e366dee0-6aaf-44ba-964f-dda5f7920b4b",
                                                "sense_id": "049acb0e-c2b0-3738-80df-e1dc03c5fd40",
                                                "text": "Strangely light and delicate was his frame and seeming, yet with a sense of slumbering power beneath, as the delicate peak of a snow mountain seen afar in the low red rays of morning."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slumbering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3db14bd-4e37-3097-a33d-741c062ddcda",
                                        "entry_id": "07519a0a-c842-3b04-9999-0ab6df88aae4",
                                        "glosses": [
                                            "sleep"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11fbf13-e861-4726-8fb2-6cf29fbc2021",
                                                "sense_id": "b3db14bd-4e37-3097-a33d-741c062ddcda",
                                                "text": "In a dream, in a vision of the night, when deep sleep falleth upon men, in slumberings upon the bed[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d02d305f-b9bb-47b9-b758-d464e5d8b5c3",
                        "source_entry_id": "9b97a8e6-2323-3fd6-af64-93826f683549",
                        "source_sense_id": "05cdaab4-ee05-39de-952b-8756ca1324d9",
                        "source_sense_description": "het in een lichte slaap verkeren",
                        "target_lang_word": "slumber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slumber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                                        "entry_id": "6c60f998-45dd-3a88-8989-789008d30613",
                                        "glosses": [
                                            "A very light state of sleep, almost awake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138d9e03-09c8-4967-94f0-a4a4c6ba4ff9",
                                                "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                                                "text": "Fast asleep? It is no matter; / Enjoy the honey-heavy dew of slumber."
                                            },
                                            {
                                                "example_id": "a2c145f8-e58f-4cba-84da-e6322d926a70",
                                                "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                                                "text": "Ev’n Luſt and Envy ſleep, yet Love denies / Reſt to my Soul, and ſlumber to my Eyes."
                                            },
                                            {
                                                "example_id": "8a67120b-e437-4160-b6ba-044c2a9299ec",
                                                "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                                                "text": "He at last fell into a slumber, and thence into a fast sleep, which detained him in that place until it was almost night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10a2fd7-f4e3-313d-988f-09eb704d9fb9",
                                        "entry_id": "6c60f998-45dd-3a88-8989-789008d30613",
                                        "glosses": [
                                            "A state of ignorance or inaction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b64a8a30-724d-4eb6-a21f-630d55f0a141",
                                                "sense_id": "a10a2fd7-f4e3-313d-988f-09eb704d9fb9",
                                                "text": "Marcel Duchamp's urinal and readymades seemed in the beginning to be insider jokes or jokelike paradoxes meant to awaken people from their aesthetic slumbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1924eb-5661-3f3e-b6b8-3f7ddd1197d4",
                                        "entry_id": "6c60f998-45dd-3a88-8989-789008d30613",
                                        "glosses": [
                                            "The snooze button on an alarm clock."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slumber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "566231f5-6595-3104-83d7-9753798ba987",
                                        "entry_id": "66e6483d-0db9-3879-a4ae-8dc222dbc6df",
                                        "glosses": [
                                            "To be in a very light state of sleep, almost awake."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "302b52da-a39e-47c3-8652-304903847659",
                                                "sense_id": "566231f5-6595-3104-83d7-9753798ba987",
                                                "text": "He that keepeth Israel shall neither slumber nor sleep."
                                            },
                                            {
                                                "example_id": "e16e3920-139c-4653-a32b-b564232a975e",
                                                "sense_id": "566231f5-6595-3104-83d7-9753798ba987",
                                                "text": "If Sleep and Death be truly one,\n⁠And every spirit’s folded bloom\n⁠Thro’ all its intervital gloom\nIn some long trance should slumber on; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fce2b80-b174-3ef3-b0bd-634d89532b6a",
                                        "entry_id": "66e6483d-0db9-3879-a4ae-8dc222dbc6df",
                                        "glosses": [
                                            "To be inactive or negligent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25390df3-8c39-3493-bca3-2e6e340ef8d9",
                                        "entry_id": "66e6483d-0db9-3879-a4ae-8dc222dbc6df",
                                        "glosses": [
                                            "To lay to sleep."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb51ac4-b451-40e6-994e-ba09d04b190a",
                                                "sense_id": "25390df3-8c39-3493-bca3-2e6e340ef8d9",
                                                "text": "slumber his conscience"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79dfcede-20dc-307d-992c-6712c8ec6ba0",
                                        "entry_id": "66e6483d-0db9-3879-a4ae-8dc222dbc6df",
                                        "glosses": [
                                            "To stun; to stupefy."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49b29ed7-8d67-4c30-982d-f9780a50cc8a",
                                                "sense_id": "79dfcede-20dc-307d-992c-6712c8ec6ba0",
                                                "text": "Then vp he tooke the slombred sencelesse corse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
