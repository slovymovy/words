                        "glosses": [
                            "Relatif aux Petchénègues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "813d2416-9b1d-47e7-93c0-578df273c3ce",
                                "sense_id": "9b40c6ce-4298-3d7d-bf13-629cfe9109d7",
                                "text": "En cette extrémité, un courageux adolescent, parlant à merveille la langue petchénègue, s’offre à rejoindre Prétitch pour l’informer de la détresse des Kioviens."
                            },
                            {
                                "example_id": "da4d702a-922b-43bb-8ffb-5fb773677e8e",
                                "sense_id": "9b40c6ce-4298-3d7d-bf13-629cfe9109d7",
                                "text": "Une origine petchénègue serait certes envisageable pour le barbare de Psellos qui se vantait d’avoir su battre les \"Romains\", mais le châtiment infligé à cette homme ne semble pas convenir pour Kégénès."
                            },
                            {
                                "example_id": "582cddf1-69d3-429e-9f59-dedf483e98bc",
                                "sense_id": "9b40c6ce-4298-3d7d-bf13-629cfe9109d7",
                                "text": "Le prince petchénègue donna à Pretitch un cheval, un sabre et des flèches ; Pretitch lui donna une armure, un bouclier et une épée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
