{
    "word_family": [
        "sącz",
        "sączek",
        "sączydło",
        "sączność",
        "wysączać",
        "odsączać",
        "przesączać",
        "wsączać",
        "nasączać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "742b1d53-471f-3e54-8c91-5073b91e0dde",
                    "sense_definition": "pić powoli, małymi łykami",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "picie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Goście <w>sączyli</w> wino, rozmawiając o dawnych czasach.",
                            "target_lang_translations": {
                                "ru": "Гости <w>потягивали</w> вино, беседуя о былых временах."
                            }
                        },
                        {
                            "text": "Wampir powoli <w>sączył</w> krew ze srebrnej czaszy.",
                            "target_lang_translations": {
                                "ru": "Вампир медленно <w>цедил</w> кровь из серебряной чаши."
                            }
                        }
                    ],
                    "synonyms": [
                        "popijać"
                    ],
                    "common_phrases": [
                        "sączyć wino",
                        "sączyć drinka"
                    ],
                    "target_lang_definitions": {
                        "ru": "пить медленно, маленькими глотками"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потягивать",
                                "target_lang_sense_clarification": "пить что-либо медленно, смакуя"
                            },
                            {
                                "target_lang_word": "цедить",
                                "target_lang_sense_clarification": "пить медленно, понемногу (часто о напитках)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48d07e29-1aba-3d45-814b-e6c3363485a9",
                    "sense_definition": "powoli wyciekać, kapać lub przedostawać się przez małe otwory",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wyciekanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Woda <w>sączyła</w> się przez nieszczelny dach podczas ulewnego deszczu.",
                            "target_lang_translations": {
                                "ru": "Во время ливня вода <w>просачивалась</w> сквозь негерметичную крышу."
                            }
                        },
                        {
                            "text": "Z rany <w>sączyła</w> się krew, więc opatrunek wymagał natychmiastowej zmiany.",
                            "target_lang_translations": {
                                "ru": "Из раны <w>сочилась</w> кровь, поэтому повязку нужно было немедленно сменить."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyciekać",
                        "przeciekać"
                    ],
                    "common_phrases": [
                        "sączyć się powoli"
                    ],
                    "target_lang_definitions": {
                        "ru": "медленно вытекать, капать или просачиваться через небольшие отверстия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просачиваться",
                                "target_lang_sense_clarification": "медленно проникать сквозь что-либо"
                            },
                            {
                                "target_lang_word": "сочиться",
                                "target_lang_sense_clarification": "медленно вытекать по капле или тонкой струйкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5f20bdf-6800-3ec3-852a-d5300577a8b4",
                    "sense_definition": "oddzielać ciecz od osadu za pomocą filtra",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "filtrowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chemik musiał dokładnie <w>sączyć</w> roztwór, aby usunąć wszystkie zanieczyszczenia.",
                            "target_lang_translations": {
                                "ru": "Химику пришлось тщательно <w>отфильтровать</w> раствор, чтобы удалить все загрязнения."
                            }
                        },
                        {
                            "text": "Po zakończeniu reakcji należy <w>sączyć</w> mieszaninę przez bibułę filtracyjną.",
                            "target_lang_translations": {
                                "ru": "После завершения реакции смесь следует <w>процедить</w> через фильтровальную бумагу."
                            }
                        }
                    ],
                    "synonyms": [
                        "filtrować",
                        "odsączać"
                    ],
                    "common_phrases": [
                        "sączyć roztwór"
                    ],
                    "target_lang_definitions": {
                        "ru": "отделять жидкость от осадка с помощью фильтра"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фильтровать",
                                "target_lang_sense_clarification": "очищать жидкость от примесей"
                            },
                            {
                                "target_lang_word": "процеживать",
                                "target_lang_sense_clarification": "отделять жидкость от твердых частиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00b89ea1-2923-369c-b9cb-d3af5da576b8",
                    "sense_definition": "nalewać coś powoli, cienkim strumieniem",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nalewanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharz zaczął <w>sączyć</w> oliwę do miski, cały czas mieszając sos.",
                            "target_lang_translations": {
                                "ru": "Повар начал <w>вливать</w> оливковое масло в миску, постоянно помешивая соус."
                            }
                        },
                        {
                            "text": "Należy <w>sączyć</w> płyn bardzo ostrożnie, aby nie rozlać go poza naczynie.",
                            "target_lang_translations": {
                                "ru": "Жидкость следует <w>вливать</w> очень осторожно, чтобы не пролить её мимо сосуда."
                            }
                        }
                    ],
                    "synonyms": [
                        "wlewać"
                    ],
                    "common_phrases": [
                        "sączyć powoli"
                    ],
                    "target_lang_definitions": {
                        "ru": "наливать что-либо медленно, тонкой струйкой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вливать тонкой струйкой",
                                "target_lang_sense_clarification": "добавлять жидкость медленно и аккуратно"
                            },
                            {
                                "target_lang_word": "цедить",
                                "target_lang_sense_clarification": "лить медленно, понемногу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}