        "fr-extract.jsonl": [
            {
                "entry_id": "fd5c8bb7-5545-3c9f-a85a-76bcad3d9678",
                "word": "dérision",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f618332b-b830-4b76-82c4-c655c52fda7d",
                        "entry_id": "fd5c8bb7-5545-3c9f-a85a-76bcad3d9678",
                        "tags": [
                            "plural"
                        ],
                        "form": "dérisions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                        "entry_id": "fd5c8bb7-5545-3c9f-a85a-76bcad3d9678",
                        "glosses": [
                            "Moquerie souvent accompagnée de mépris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26891008-9f6f-4cf3-acd6-b961af2c9afb",
                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                "text": "Et quand en 1840, notre vin de Moselle ne fut qu'un âpre verjus, nos vignerons, par dérision et par haine du Prussien, donnèrent sarcastiquement à ce vin imbuvable le sobriquet de : Hassenpflug."
                            },
                            {
                                "example_id": "bc2fb4cb-ad44-46cd-a85e-9d582feae729",
                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                "text": "C’est un homme qui tourne tout en dérision."
                            },
                            {
                                "example_id": "d1ccaa15-aa4c-4c8e-8119-6dd48aa32e81",
                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                "text": "C’est une dérision, une dérision amère que de prêcher l’abstinence aux gens dépourvus de tout."
                            },
                            {
                                "example_id": "5db6d818-9f5b-4268-a828-227fdd3334e9",
                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                "text": "C’est une dérision que d’offrir cent francs pour un pareil travail."
                            },
                            {
                                "example_id": "9dcf98c1-7b67-4124-b019-641eded2f67a",
                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                "text": "La dérision en toutes choses est l’ultime défi au malheur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0e640a8-2329-483a-8351-e527cf0dc69b",
                        "source_entry_id": "fd5c8bb7-5545-3c9f-a85a-76bcad3d9678",
                        "source_sense_id": "266c1173-353e-3204-b095-9e613310be74",
                        "target_lang_word": "derision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a94e39c7-c524-385f-96ef-5911ddcf4af5",
                                        "entry_id": "d9108606-0e15-3221-ab87-8058295261de",
                                        "glosses": [
                                            "Act of treating with disdain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90301bda-8470-4bca-99a4-4a043b46f3bb",
                                                "sense_id": "a94e39c7-c524-385f-96ef-5911ddcf4af5",
                                                "text": "There was just a touch of derision in the Don's voice and Hagen flushed."
                                            },
                                            {
                                                "example_id": "54718b57-f0a0-4776-b9a3-d564a46741a5",
                                                "sense_id": "a94e39c7-c524-385f-96ef-5911ddcf4af5",
                                                "text": "One of the darlings of the early vegetarian movement (particularly in its even sadder form, the cutlet), it was on the menu at John Harvey Kellogg's Battle Creek Sanitarium [sic], and has since become the default Sunday option for vegetarians – and a default source of derision for everyone else."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "becb2348-5e3c-30da-98ed-cfad29d78907",
                                        "entry_id": "d9108606-0e15-3221-ab87-8058295261de",
                                        "glosses": [
                                            "Something to be derided; a laughing stock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e010c9c4-5911-4407-9f2f-f567c39ee052",
                                                "sense_id": "becb2348-5e3c-30da-98ed-cfad29d78907",
                                                "text": "Miss Briggs was not formally dismissed, but her place as companion was a sinecure and a derision […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e0501b4-5008-4d7a-af9f-eca79b308ad5",
                        "source_entry_id": "fd5c8bb7-5545-3c9f-a85a-76bcad3d9678",
