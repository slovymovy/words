                "forms": [
                    {
                        "form_id": "c207957c-419f-4236-a8e1-582795467d6a",
                        "entry_id": "f8c0fd1c-5919-3b6a-acbb-6810fe890405",
                        "tags": [
                            "plural"
                        ],
                        "form": "boutoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2319cfcb-bd16-3250-9845-d1098a6d4f4d",
                        "entry_id": "f8c0fd1c-5919-3b6a-acbb-6810fe890405",
                        "glosses": [
                            "Partie supérieure du groin avec laquelle le sanglier et le porc fouissent la terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a12d169-1a2d-436b-b7d0-8b9eb7e3aefe",
                                "sense_id": "2319cfcb-bd16-3250-9845-d1098a6d4f4d",
                                "text": "Le Sanglier a les défenses plus grandes, le boutoir plus fort et la hure plus longue que le cochon domestique ; il a aussi les pieds plus gros, les pinces plus séparées et le poil toujours noir."
                            },
                            {
                                "example_id": "300b0d53-f7cf-4322-b91b-db91eae15957",
                                "sense_id": "2319cfcb-bd16-3250-9845-d1098a6d4f4d",
                                "text": "Le solitaire fouilla de son boutoir le sol qu’il labourait avec le tranchant de sa redoutable défense."
                            }
                        ]
                    },
                    {
                        "sense_id": "aae4d0d7-b763-386c-8405-af7b2f5d0ddc",
                        "entry_id": "f8c0fd1c-5919-3b6a-acbb-6810fe890405",
                        "glosses": [
                            "Instrument avec lequel les maréchaux-ferrants enlèvent la corne superflue du pied d’un cheval avant de le ferrer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b533c0a4-eb09-369e-9d75-81f8a1d23fbf",
                        "entry_id": "f8c0fd1c-5919-3b6a-acbb-6810fe890405",
                        "glosses": [
                            "Outil servant à creuser les sabots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f93a7696-f7d4-4b95-9da8-2e2686ca8cea",
                                "sense_id": "b533c0a4-eb09-369e-9d75-81f8a1d23fbf",
                                "text": "Boutoir de sabotier."
                            }
                        ]
                    },
                    {
                        "sense_id": "727ec5f3-4cd7-3492-b6bb-74dbf633a062",
                        "entry_id": "f8c0fd1c-5919-3b6a-acbb-6810fe890405",
                        "glosses": [
                            "Outil qui sert aux corroyeurs à racler le cuir lors d'une opération nommée butage. → voir butoir."
                        ],
                        "tags": [
                            "Travail du cuir"
                        ],
                        "examples": [
                            {
                                "example_id": "40fa5c56-e719-493a-bfae-11ef125d4771",
                                "sense_id": "727ec5f3-4cd7-3492-b6bb-74dbf633a062",
                                "text": "Boutoir de corroyeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "27e0dc33-eb7b-38c7-b8fb-f0cadc491329",
                        "entry_id": "f8c0fd1c-5919-3b6a-acbb-6810fe890405",
                        "glosses": [
                            "Nom donné à l’extrémité du groin du sanglier. On le précise dans le blasonnement quand il est d’un émail différent."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c5e51a28-559e-4793-8d8b-5bda0bacc20d",
                                "sense_id": "27e0dc33-eb7b-38c7-b8fb-f0cadc491329",
                                "text": "D’argent à un chêne de sinople englanté d’or, posé sur une terrasse aussi de sinople et traversé au pied d’un sanglier de sable armé d’argent, le boutoir de gueules, qui est de Sedan → voir illustration « boutoir de gueules »"
                            }
                        ]
                    },
                    {
                        "sense_id": "03f8f4ba-a706-3bac-bb1d-b549a01536ac",
                        "entry_id": "f8c0fd1c-5919-3b6a-acbb-6810fe890405",
                        "glosses": [
                            "Pénis."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4fa0bcb8-00c6-44f0-9fd2-3150b7673952",
                                "sense_id": "03f8f4ba-a706-3bac-bb1d-b549a01536ac",
                                "text": "Je n'arrive vraiment pas à comprendre comment elle peut garder la ligne qu'elle a, avec les quantités qu'elle bouffe. C'est N'Gustro qui doit l'émacier. Pénétration par grand boutoir doit valoir séance de sauna. Je ne sais pas. Ça donne à penser."
                            }
                        ]
                    }
                ],
