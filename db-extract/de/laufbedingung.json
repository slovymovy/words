                ],
                "senses": [
                    {
                        "sense_id": "e548a5c4-b8c4-3fef-824c-03263dbb0126",
                        "entry_id": "17aafe0b-8fde-3ac9-8412-fb57ad1da4bc",
                        "glosses": [
                            "äußere Gegebenheiten, unter denen ein Lauf stattfindet, insbesondere Wetter, Strecke und Untergrund"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d380a9b9-c609-4c8c-8558-43dd34c3e294",
                                "sense_id": "e548a5c4-b8c4-3fef-824c-03263dbb0126",
                                "text": "„Es herrschten ideale Laufbedingungen, ideale Bedingungen an der Strecke und ideale Bedingungen in Soest im Zieleinlauf.“"
                            },
                            {
                                "example_id": "ff5fc6a4-82d3-4ae2-974d-9bf0424fc724",
                                "sense_id": "e548a5c4-b8c4-3fef-824c-03263dbb0126",
                                "text": "„Bei bestem Wetter und idealen Laufbedingungen ging am Samstag der Nordkirchener Halbmarathon 2022 mit mehreren erstaunlichen sportlichen Leistungen über die Bühne.“"
                            },
                            {
                                "example_id": "2c5bc582-0b5d-433b-bc0e-cd4131ea1450",
                                "sense_id": "e548a5c4-b8c4-3fef-824c-03263dbb0126",
                                "text": "„Die Bürgerinnen und Bürger der Stadt Bergkamen können stolz darauf sein, solch hervorragende Laufbedingungen in ihrer Stadt zu haben.“"
                            },
                            {
                                "example_id": "217db6b2-5a12-4259-bdcb-91f15d780510",
                                "sense_id": "e548a5c4-b8c4-3fef-824c-03263dbb0126",
                                "text": "„Einige Pfützen vom Regen in der Nacht sowie leicht matschige Wege im Englischen Garten trübten die ansonsten aber guten Laufbedingungen nicht.“"
                            },
                            {
                                "example_id": "f3337723-51a7-42cb-a285-8eacc1db5139",
                                "sense_id": "e548a5c4-b8c4-3fef-824c-03263dbb0126",
                                "text": "„Bei idealen Laufbedingungen bewältigten 51 Läufer und Läuferinnen die anstrengende Strecke vom Parkplatz beim Waldecker Hof auf den höchsten Punkt Stammheims, dem Doma.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
