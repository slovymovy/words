                    {
                        "translation_id": "432eba0d-83ab-4e20-8965-40f81ef6ace9",
                        "source_entry_id": "beeaccff-ccbb-3960-b872-30a2576356a5",
                        "source_sense_id": "32589f21-5d68-382d-9638-c0eb3f1b3a41",
