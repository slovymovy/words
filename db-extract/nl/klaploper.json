                    },
                    {
                        "translation_id": "62009c4f-2c70-4747-9bf6-5878eec12dfc",
                        "source_entry_id": "7444a631-9e56-3e78-9bf1-a149d8400052",
                        "source_sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
                        "target_lang_word": "mooch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mooch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da8ac136-48fd-3d6e-87a2-44de0a0db944",
                                        "entry_id": "c88ebe2c-1c28-3bc3-b0b8-78b3bbe6672a",
                                        "glosses": [
                                            "To wander around aimlessly, often causing irritation to others."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a91b75b0-3164-4c03-9205-b99515c78095",
                                                "sense_id": "da8ac136-48fd-3d6e-87a2-44de0a0db944",
                                                "text": "Near-synonyms: loiter, roam"
                                            },
                                            {
                                                "example_id": "367b2efb-b7e1-41f4-9409-0c711d0f7746",
                                                "sense_id": "da8ac136-48fd-3d6e-87a2-44de0a0db944",
                                                "text": "These chaps that mooch about, as Hyde was doing, pick up all sorts of odds and ends. He may have pinched them from a chemist’s shop."
                                            },
                                            {
                                                "example_id": "59f1afa2-e655-4ec5-a034-da3b5861deaf",
                                                "sense_id": "da8ac136-48fd-3d6e-87a2-44de0a0db944",
                                                "text": "You have to be alone to mooch about properly. Other people will just get in the way and be all energetic about things. So wait until they've gone, make a cup of tea and then let the mooching commence."
                                            },
                                            {
                                                "example_id": "67200620-b374-46e5-9c07-78993c944468",
                                                "sense_id": "da8ac136-48fd-3d6e-87a2-44de0a0db944",
                                                "text": "With 79 minutes gone, the most celebrated team of the modern age had been reduced to bunch of mooching, stumbling yellow-shirted spectators."
                                            },
                                            {
                                                "example_id": "326e3b18-ccd8-4c1b-9282-3deda32f7f17",
                                                "sense_id": "da8ac136-48fd-3d6e-87a2-44de0a0db944",
                                                "text": "A handful of camera crews mooched around the entrance to the Giorgio Cini foundation, where a pair of tight-lipped but polite individuals sat before monitors under a gazebo and politely fended off requests for information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4803686-e477-3f22-bcf1-c3ecf4bb5789",
                                        "entry_id": "c88ebe2c-1c28-3bc3-b0b8-78b3bbe6672a",
                                        "glosses": [
                                            "To beg, cadge, or sponge; to exploit or take advantage of others for personal gain."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f47a3a-bc5c-4577-b910-ddfa31c16b74",
                                                "sense_id": "e4803686-e477-3f22-bcf1-c3ecf4bb5789",
                                                "text": "I managed to mooch my way up the journalistic ladder to the next, more impressive level of “Interviewer”."
                                            },
                                            {
                                                "example_id": "0e18d67c-a154-4ab9-9a71-67a20c42690b",
                                                "sense_id": "e4803686-e477-3f22-bcf1-c3ecf4bb5789",
                                                "text": "Mr. Prince responded on Twitter: “Phony fraud photographers keep mooching me. Why? I changed the game,” he wrote on Wednesday. His Instagram account, which previously had over 70,000 followers, is currently disabled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937b96dc-b161-3e5a-bb2c-9a1b5db7aeab",
                                        "entry_id": "c88ebe2c-1c28-3bc3-b0b8-78b3bbe6672a",
                                        "glosses": [
                                            "To steal or filch."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e293058-935c-4df7-b13c-cdf72aa661a6",
                                                "sense_id": "937b96dc-b161-3e5a-bb2c-9a1b5db7aeab",
                                                "text": "I'm tired of driving you all over and sick of you living in my house, mooching my food."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mooch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c39927a5-9165-3299-9eb6-a50c2989b5f9",
                                        "entry_id": "6204ea25-32a9-3c79-89de-632e82625eca",
                                        "glosses": [
                                            "An aimless stroll."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a8c24c-e7aa-437e-9560-9667d2929c58",
                                                "sense_id": "c39927a5-9165-3299-9eb6-a50c2989b5f9",
                                                "text": "Jack wouldn't be arriving for another ten minutes, so I had a mooch around the garden."
                                            },
                                            {
                                                "example_id": "f8cca182-2fd0-49a0-92bb-191e8c7d0611",
                                                "sense_id": "c39927a5-9165-3299-9eb6-a50c2989b5f9",
                                                "text": "At the secondary school where I normally work as a librarian, I take key workers’ and other children on a “nature mooch”. We undull our senses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff9940c-d949-3b4c-b432-83982d627603",
                                        "entry_id": "6204ea25-32a9-3c79-89de-632e82625eca",
                                        "glosses": [
                                            "One who mooches; a moocher."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b9386dd-c113-442b-ac0a-a6180f83ecd7",
                                                "sense_id": "1ff9940c-d949-3b4c-b432-83982d627603",
                                                "text": "\"No! I'm sick of you being a mooch, bumming off me all the time! I'm going to London for a few days.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mooch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f372ba03-81fe-3a80-8e21-c0579062781c",
                                        "entry_id": "0b8bc310-d45c-3d97-985e-dac40ee44ddc",
                                        "glosses": [
                                            "Synonym of Scaramucci (“unit of time”)."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "humorous",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d88d60e-d223-43cc-98d5-c78c1eb4da8d",
                                                "sense_id": "f372ba03-81fe-3a80-8e21-c0579062781c",
                                                "text": "If we take Scaramucci’s 10-day figure to be the standard of measurement — one “mooch” — then Pruitt survived an amazing 50.3 mooches, even while enduring more than a dozen scandals, any one of which would have doomed a lesser man."
                                            },
                                            {
                                                "example_id": "50b203cc-7481-4476-90e6-7081b9da688d",
                                                "sense_id": "f372ba03-81fe-3a80-8e21-c0579062781c",
                                                "text": "Scaramucci, who jokingly measures time in mooches, a unit equal to approximately 11 days, said he doesn’t necessarily like the version of himself he often sees on screen, but feels director Andrew J. Moscato was accurate."
                                            },
                                            {
                                                "example_id": "a148e569-9b9e-4b8d-86a3-45d57675ccd6",
                                                "sense_id": "f372ba03-81fe-3a80-8e21-c0579062781c",
                                                "text": "I understand it's her job. But I would point out to people that Stephanie has lasted way more “Mooches” than me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c1e440c-52de-4888-b484-c516ac2aa5fc",
                        "source_entry_id": "7444a631-9e56-3e78-9bf1-a149d8400052",
                        "source_sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
                        "target_lang_word": "pique-assiette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pique-assiette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaff193a-1e7b-3de9-b51d-b8eecf851655",
                                        "entry_id": "d6ddfb9b-a2a2-3fa6-9b7e-09aa67950988",
                                        "glosses": [
                                            "Personne qui vit en parasite, qui profite sans contribuer aux frais."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80bd697b-6905-4de2-9694-6fcc47b0826a",
                                                "sense_id": "eaff193a-1e7b-3de9-b51d-b8eecf851655",
                                                "text": "Ce petit hobereau débuta avec presque rien et s’acquit promptement la réputation de pique-assiette : mais à sa mort il possédait quelque cent mille roubles d’argent liquide."
                                            },
                                            {
                                                "example_id": "9f36990b-7bca-4a22-bcf2-1ffdab9b4e67",
                                                "sense_id": "eaff193a-1e7b-3de9-b51d-b8eecf851655",
                                                "text": "Un duc, celui-là, un duc porteur d’un grand nom de France !… Ah ! le joli duc ! Le roi des pique-assiettes !"
                                            },
                                            {
                                                "example_id": "8e20f786-431c-4f04-91dd-4a77dd71dfc4",
                                                "sense_id": "eaff193a-1e7b-3de9-b51d-b8eecf851655",
                                                "text": "Nous achetâmes en plus la traditionnelle bouteille de pisco pour les maîtres de maison, certificat d’honorabilité qui nous évitait de figurer sur la liste des pique-assiette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5955c8ee-0c5a-4cab-9a9b-ff1dadafab14",
