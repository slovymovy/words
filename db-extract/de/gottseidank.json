        "de-extract.jsonl": [
            {
                "entry_id": "b87dbb79-f377-37a7-b893-b3f3febd19f4",
                "word": "gottseidank",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dee3051a-e6d0-3667-813f-5c79c349a450",
                        "entry_id": "b87dbb79-f377-37a7-b893-b3f3febd19f4",
                        "glosses": [
                            "Ausdruck der Erleichterung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e75129-32b0-41aa-b95c-21d01fde61f2",
                                "sense_id": "dee3051a-e6d0-3667-813f-5c79c349a450",
                                "text": "„Gottseidank funktioniert seine Glotze.“"
                            },
                            {
                                "example_id": "78fa55e7-dbb9-459e-bc62-bf546d4c04a2",
                                "sense_id": "dee3051a-e6d0-3667-813f-5c79c349a450",
                                "text": "„Gottseidank sind die Kinder noch nicht so ausgefuchst, dass sie den Lehrer fragen, wie jemand Kanzler werden konnte, der so sprach wie Kohl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f07c0c3-6beb-4acf-afe3-11a6b781617f",
                        "source_entry_id": "b87dbb79-f377-37a7-b893-b3f3febd19f4",
                        "source_sense_id": "dee3051a-e6d0-3667-813f-5c79c349a450",
                        "source_sense_description": "Ausdruck der Erleichterung",
                        "target_lang_word": "Dieu merci",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dieu merci",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "787af1e9-2965-3aa5-a177-c8cee786aa20",
                                        "entry_id": "22a2bf5a-a93f-3a1f-8e24-7a32a45de5af",
                                        "glosses": [
                                            "Exprime le soulagement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d6a12a5-48b5-4a5c-afc5-24294d285dda",
                                                "sense_id": "787af1e9-2965-3aa5-a177-c8cee786aa20",
                                                "text": "Solange, Dieu merci! n'est ni une prude, ni une sotte, et elle vous saura gré de votre franchise."
                                            },
                                            {
                                                "example_id": "c15a82d1-93ab-404a-ab32-5e7f4e7a54c6",
                                                "sense_id": "787af1e9-2965-3aa5-a177-c8cee786aa20",
                                                "text": "« De toutes les aberrations sexuelles, la plus singulière est encore la chasteté », disait Remy de Gourmont.\nSes contemporains étaient de son avis. Dieu merci !"
                                            },
                                            {
                                                "example_id": "e94242bb-99e9-4fec-8283-deaa4409f682",
                                                "sense_id": "787af1e9-2965-3aa5-a177-c8cee786aa20",
                                                "text": "Car pour les van der Merwe, Abraham n’était et ne serait jamais qu’un bâtard parasitaire. Et Dieu merci, aucune goutte de leur sang ne coulait dans ses veines !"
                                            },
                                            {
                                                "example_id": "e6b47c36-648c-4327-8334-104415a7b174",
                                                "sense_id": "787af1e9-2965-3aa5-a177-c8cee786aa20",
                                                "text": "L'homme, horriblement amaigri, puait comme le Diable mais, Dieu merci, il était toujours vivant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Dieu merci",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56c0c505-93d2-35a4-b3fd-a653cde445bc",
                                        "entry_id": "29b3f01b-e030-3aa4-83bb-7f17bafa64c6",
                                        "glosses": [
                                            "De manière favorable, avantageuse, opportune, procurant satisfaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4903987d-b976-4ded-aea7-2f267b7f9d2c",
                                                "sense_id": "56c0c505-93d2-35a4-b3fd-a653cde445bc",
                                                "text": "Oh ! Dieu merci, non ; cela m’est bien égal. Je hais profondément la huguenoterie, mais je ne déteste pas les huguenots, et puis c’est la mode."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
