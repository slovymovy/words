                ],
                "senses": [
                    {
                        "sense_id": "efa9120f-6b27-372e-a56c-aa68a450b305",
                        "entry_id": "62985158-0a5d-3e4c-92d8-87427f8e2e13",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2396a44-d110-4e1c-b847-4a3c4fc29509",
                                "sense_id": "efa9120f-6b27-372e-a56c-aa68a450b305",
                                "text": "Frau Rockstroh ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7f41b8fc-50be-41dd-831d-228b3cd1d65f",
                                "sense_id": "efa9120f-6b27-372e-a56c-aa68a450b305",
                                "text": "Herr Rockstroh wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aef58f5c-c8ee-4a11-ad62-f84c97738a60",
                                "sense_id": "efa9120f-6b27-372e-a56c-aa68a450b305",
                                "text": "Die Rockstrohs kommen heute aus der Lüneburger Heide."
                            },
                            {
                                "example_id": "cbb73cc8-9a76-43ad-8476-9cdec688f30b",
                                "sense_id": "efa9120f-6b27-372e-a56c-aa68a450b305",
                                "text": "Der Rockstroh trägt nie die Schals, die die Rockstroh ihm strickt."
                            },
                            {
                                "example_id": "724ef21c-8157-442c-80d1-5a1e0af4d960",
                                "sense_id": "efa9120f-6b27-372e-a56c-aa68a450b305",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rockstroh kommt, geht der Herr Rockstroh.“"
                            },
                            {
                                "example_id": "d5103f45-a448-4fd2-b2c5-c15db166497c",
                                "sense_id": "efa9120f-6b27-372e-a56c-aa68a450b305",
                                "text": "Rockstroh kommt und geht."
                            },
                            {
                                "example_id": "cae6a42e-4554-47ae-b8cf-d539e8705921",
                                "sense_id": "efa9120f-6b27-372e-a56c-aa68a450b305",
                                "text": "Rockstrohs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
