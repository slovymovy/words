                                            {
                                                "example_id": "d9186386-3d72-4aa5-b76d-4153194ff885",
                                                "sense_id": "33a99804-fd1e-3a53-9b74-523145b39db2",
                                                "text": "Neue wissenschaftliche Studien belegen, dass die Hypothese zur Krankheitsentstehung in der bisherigen Form unhaltbar ist."
                                            },
                                            {
                                                "example_id": "6b197360-66ed-4d96-94f5-ad0179a40c0c",
                                                "sense_id": "33a99804-fd1e-3a53-9b74-523145b39db2",
                                                "text": "„Obwohl Galls Schädellehre ab der Mitte des 19. Jahrhunderts in der Medizingeschichtsschreibung gegenüber dem Siegeszug der naturwissenschaftlichen Medizin als unhaltbares Konstrukt kritisiert und ihr Urheber als Spintisierer belächelt wurde, war sie aus heutiger Sicht wegweisend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b37b15cf-1560-3b8d-baf7-033157159af4",
                                        "entry_id": "f0273c00-de9b-3239-9ab6-f751e5081f1a",
                                        "glosses": [
                                            "nicht haltbar; nicht davon abzuhalten, im Tor zu landen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69db93ae-e088-42ca-b7a3-175f1acf87d3",
                                                "sense_id": "b37b15cf-1560-3b8d-baf7-033157159af4",
                                                "text": "Dem Torwart kann man keinen Vorwurf machen, da der Schuss des Stürmers unhaltbar war."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
