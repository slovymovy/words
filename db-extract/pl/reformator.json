                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42de700d-2626-45ab-a996-4516c5eec1ce",
                        "source_entry_id": "25201b5e-0375-3102-b7df-b4a822e2196d",
                        "source_sense_id": "3194a69b-9b31-3ae8-810e-46e7fc59265a",
                        "target_lang_word": "reformer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reformer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dacb4e8e-d1f4-31b6-a424-a13df99c6248",
                                        "entry_id": "17b098ff-bdca-3e00-a163-2fb65c91b7f4",
                                        "glosses": [
                                            "One who reforms, or who works for reform."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28634c0-e2b5-4481-9eea-c4d1c3384513",
                                                "sense_id": "dacb4e8e-d1f4-31b6-a424-a13df99c6248",
                                                "text": "Among the frontrunners before the conclave began were Pietro Parolin, the Vatican’s secretary of state; Luis Antonio Tagle, a reformer from the Philippines; Péter Erdő, a traditionalist from Hungary; Robert Sarah, a cardinal from Guinea who criticised Francis’s papacy; and the moderate US cardinal Robert Prevost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69025532-3cdf-383b-afea-cc3e8f766865",
                                        "entry_id": "17b098ff-bdca-3e00-a163-2fb65c91b7f4",
                                        "glosses": [
                                            "One who was involved in the Reformation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd736381-6da3-4513-8783-1bc25c33e473",
                                                "sense_id": "69025532-3cdf-383b-afea-cc3e8f766865",
                                                "text": "[…] for I long to ſee a larke without a creaſt, and would travaile farre to diſcoover a reformer without a fault, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6a1e04-0c52-34d5-9c88-641a5dbbb00e",
                                        "entry_id": "17b098ff-bdca-3e00-a163-2fb65c91b7f4",
                                        "glosses": [
                                            "A device which converts hydrocarbons into a hydrogen-rich mixture of gases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4613ebb9-9082-4d59-b862-0b9a3a0b48fc",
                                                "sense_id": "fc6a1e04-0c52-34d5-9c88-641a5dbbb00e",
                                                "text": "The fuel reformer works somewhat like catalytic converters in cars. In the gasoline reformer, vaporized gasoline is mixed with steam and air before traveling through a cylinder packed with the new Argonne catalyst. The result is a hydrogen-rich gas that is further processed in subsequent chemical steps and is then fed to the fuel cell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "493355ea-8146-3eaa-a646-eb4a1f652b8b",
                                        "entry_id": "17b098ff-bdca-3e00-a163-2fb65c91b7f4",
                                        "glosses": [
                                            "A device used to convert petroleum refinery naphthas, typically having low octane ratings, into high-octane liquid products called reformates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3996a2a4-21e2-4441-9a54-e900c6e1480e",
                                                "sense_id": "493355ea-8146-3eaa-a646-eb4a1f652b8b",
                                                "text": "Deisohexanizer bottoms are routed to the continuous reformer, where the octane of the stream is upgraded chiefly by conversion of naphthenes and paraffins to high octane aromatic compounds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf3e5921-fef8-40fe-91f1-fd414b71e043",
                        "source_entry_id": "25201b5e-0375-3102-b7df-b4a822e2196d",
                        "source_sense_id": "3194a69b-9b31-3ae8-810e-46e7fc59265a",
                        "target_lang_word": "réformateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réformateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d43e809c-403e-3b73-8755-7e992d119d3d",
                                        "entry_id": "2e4e6529-6ba4-32f8-85cc-a9d1737fab5c",
                                        "glosses": [
                                            "Relatif à des réformes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c76d249-c160-4c47-9b07-7e9faa4bfa42",
                                                "sense_id": "d43e809c-403e-3b73-8755-7e992d119d3d",
                                                "text": "La révolution de Palais, qui se produisait le 13 décembre 1940 et dans laquelle Alibert s'était compromis, devait briser net l’élan réformateur du premier garde des sceaux de Vichy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "réformateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "507c5fe9-1a80-3a1c-b809-2abfea6fb99e",
                                        "entry_id": "770b48d3-8476-3208-a262-0b8ac9d9dd95",
                                        "glosses": [
                                            "Celui qui réforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ee4c97-ff22-4b3f-adcc-6e1dc0769ab9",
                                                "sense_id": "507c5fe9-1a80-3a1c-b809-2abfea6fb99e",
                                                "text": "Les sempiternels débats sur la norme orthographique sont aujourd’hui encore la cause de bien des réactions épidermiques. Il est de bon ton de faire passer les réformateurs pour de dangereux extrémistes et notamment pour des phonographistes convaincus."
                                            },
                                            {
                                                "example_id": "8dea8721-5fb4-4c08-8ebe-335a1d34847f",
                                                "sense_id": "507c5fe9-1a80-3a1c-b809-2abfea6fb99e",
                                                "text": "Il fut le réformateur de la philosophie, des mœurs de son siècle."
                                            },
                                            {
                                                "example_id": "0efa8971-5936-4e02-84fb-1ba351782170",
                                                "sense_id": "507c5fe9-1a80-3a1c-b809-2abfea6fb99e",
                                                "text": "Sévère réformateur."
                                            },
                                            {
                                                "example_id": "0807104d-9e16-40cf-8cda-95b1d3ebb696",
                                                "sense_id": "507c5fe9-1a80-3a1c-b809-2abfea6fb99e",
                                                "text": "L’abbé de Rancé fut le réformateur de la Trappe."
                                            },
                                            {
                                                "example_id": "68536ca4-eaa1-4a1b-88e6-c6871bd563f5",
                                                "sense_id": "507c5fe9-1a80-3a1c-b809-2abfea6fb99e",
                                                "text": "S’ériger en réformateur, faire le réformateur, Se mêler mal à propos de vouloir réformer les autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b30de33-e0d3-3465-b3c0-25155e153ecc",
                                        "entry_id": "770b48d3-8476-3208-a262-0b8ac9d9dd95",
                                        "glosses": [
                                            "Personne impliquée dans la réforme du christianisme ou dans le christianisme réformé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "961ad652-c166-420b-8345-b879baf33699",
                        "source_entry_id": "25201b5e-0375-3102-b7df-b4a822e2196d",
                        "source_sense_id": "3194a69b-9b31-3ae8-810e-46e7fc59265a",
