{
    "word_family": [
        "abidance",
        "abiding",
        "abode"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68783fce-1c44-3b3b-b700-80b9b53cff5c",
                    "sense_definition": "To accept and act in accordance with a rule, decision, or recommendation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "compliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new teacher was strict and the students did not want to <w>abide</w> by his rules.",
                            "target_lang_translations": {
                                "ru": "Новый учитель был строгим, и ученики не хотели <w>соблюдать</w> его правила.",
                                "zh": "新老师很严厉，学生们不想<w>遵守</w>他的规定。",
                                "es": "El nuevo profesor era estricto y los alumnos no querían <w>cumplir</w> sus reglas."
                            }
                        },
                        {
                            "text": "All members of the club must <w>abide</w> by the decision made by the committee.",
                            "target_lang_translations": {
                                "ru": "Все члены клуба должны <w>подчиняться</w> решению, принятому комитетом.",
                                "zh": "俱乐部所有成员都必须<w>遵循</w>委员会做出的决定。",
                                "es": "Todos los miembros del club deben <w>acatar</w> la decisión tomada por el comité."
                            }
                        }
                    ],
                    "synonyms": [
                        "comply",
                        "follow",
                        "obey",
                        "observe"
                    ],
                    "antonyms": [
                        "flout",
                        "disobey",
                        "reject"
                    ],
                    "common_phrases": [
                        "abide by the rules",
                        "abide by the law",
                        "abide by a decision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать и действовать в соответствии с правилом, решением или рекомендацией.",
                        "zh": "接受并按照规则、决定或建议行事。",
                        "es": "Aceptar y actuar de acuerdo con una regla, decisión o recomendación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблюда́ть",
                                "target_lang_sense_clarification": "правила, законы"
                            },
                            {
                                "target_lang_word": "приде́рживаться",
                                "target_lang_sense_clarification": "правил, решений"
                            },
                            {
                                "target_lang_word": "подчиня́ться",
                                "target_lang_sense_clarification": "решению, правилам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遵守",
                                "target_lang_sense_clarification": "指按照规则或法律行事"
                            },
                            {
                                "target_lang_word": "遵循",
                                "target_lang_sense_clarification": "指依照某种原则或决定"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cumplir",
                                "target_lang_sense_clarification": "con reglas o normas"
                            },
                            {
                                "target_lang_word": "acatar",
                                "target_lang_sense_clarification": "una orden o decisión"
                            },
                            {
                                "target_lang_word": "respetar",
                                "target_lang_sense_clarification": "normas o acuerdos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1c73176-e48a-3b65-a388-cf52349a75a0",
                    "sense_definition": "To tolerate or bear something patiently; usually used in negative constructions to express strong dislike.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I simply cannot <w>abide</w> people who are consistently late for meetings.",
                            "target_lang_translations": {
                                "ru": "Я просто не могу <w>терпеть</w> людей, которые постоянно опаздывают на встречи.",
                                "zh": "我实在无法<w>忍受</w>那些开会总是迟到的人。",
                                "es": "Simplemente no puedo <w>soportar</w> a las personas que llegan tarde constantemente a las reuniones."
                            }
                        },
                        {
                            "text": "She could not <w>abide</w> the smell of cigarette smoke in her house.",
                            "target_lang_translations": {
                                "ru": "Она не могла <w>выносить</w> запах сигаретного дыма в своем доме.",
                                "zh": "她无法<w>容忍</w>家里有香烟味。",
                                "es": "Ella no podía <w>aguantar</w> el olor a humo de cigarrillo en su casa."
                            }
                        }
                    ],
                    "synonyms": [
                        "bear",
                        "brook",
                        "put up with",
                        "stand",
                        "stomach",
                        "tolerate"
                    ],
                    "common_phrases": [
                        "cannot abide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Терпеливо выносить что-либо; обычно используется в отрицательных конструкциях для выражения сильной неприязни.",
                        "zh": "耐心地忍受某事；通常用于否定结构，表示强烈的厌恶。",
                        "es": "Tolerar o soportar algo con paciencia; se usa generalmente en construcciones negativas para expresar una fuerte aversión."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терпе́ть",
                                "target_lang_sense_clarification": "выносить что-то неприятное"
                            },
                            {
                                "target_lang_word": "выноси́ть",
                                "target_lang_sense_clarification": "стойко переносить"
                            },
                            {
                                "target_lang_word": "мири́ться",
                                "target_lang_sense_clarification": "с чем-либо нежелательным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忍受",
                                "target_lang_sense_clarification": "指对不愉快的事物保持耐心"
                            },
                            {
                                "target_lang_word": "容忍",
                                "target_lang_sense_clarification": "指对某人或某事的不满保持克制"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "soportar",
                                "target_lang_sense_clarification": "tolerar una situación molesta"
                            },
                            {
                                "target_lang_word": "aguantar",
                                "target_lang_sense_clarification": "tolerar algo desagradable"
                            },
                            {
                                "target_lang_word": "tolerar",
                                "target_lang_sense_clarification": "permitir o resistir algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "568002a5-a833-3622-a4bd-1a06b6fa3ea7",
                    "sense_definition": "To continue to exist; to endure or remain stable over a long period.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old traditions still <w>abide</w> in the remote mountain villages.",
                            "target_lang_translations": {
                                "ru": "Старые традиции все еще <w>сохраняются</w> в отдаленных горных деревнях.",
                                "zh": "古老的传统在偏远的山村里依然得以<w>保留</w>。",
                                "es": "Las viejas tradiciones aún <w>perduran</w> en los remotos pueblos de montaña."
                            }
                        },
                        {
                            "text": "Even after many years, the memory of that day <w>abides</w> in my mind.",
                            "target_lang_translations": {
                                "ru": "Даже спустя много лет память о том дне <w>живет</w> в моей голове.",
                                "zh": "即使多年过去，那一天的记忆依然在我的脑海中<w>持续</w>。",
                                "es": "Incluso después de muchos años, el recuerdo de aquel día <w>permanece</w> en mi mente."
                            }
                        }
                    ],
                    "synonyms": [
                        "continue",
                        "endure",
                        "last",
                        "persist",
                        "remain"
                    ],
                    "antonyms": [
                        "fade",
                        "perish",
                        "vanish"
                    ],
                    "common_phrases": [
                        "abide forever"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжать существовать; сохраняться или оставаться стабильным в течение длительного периода.",
                        "zh": "持续存在；在很长一段时间内保持稳定。",
                        "es": "Continuar existiendo; perdurar o permanecer estable durante un largo periodo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохраня́ться",
                                "target_lang_sense_clarification": "о традициях, памяти"
                            },
                            {
                                "target_lang_word": "пребыва́ть",
                                "target_lang_sense_clarification": "находиться в каком-либо состоянии"
                            },
                            {
                                "target_lang_word": "остава́ться",
                                "target_lang_sense_clarification": "продолжать существование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保留",
                                "target_lang_sense_clarification": "指传统或记忆的留存"
                            },
                            {
                                "target_lang_word": "持续",
                                "target_lang_sense_clarification": "指状态或存在延续"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "perdurar",
                                "target_lang_sense_clarification": "mantenerse en el tiempo"
                            },
                            {
                                "target_lang_word": "permanecer",
                                "target_lang_sense_clarification": "mantenerse sin cambios"
                            },
                            {
                                "target_lang_word": "subsistir",
                                "target_lang_sense_clarification": "continuar existiendo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57b9ecf4-efce-3a77-ac8f-6238a95bb633",
                    "sense_definition": "To live or dwell in a particular place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "residence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to <w>abide</w> in the quiet countryside far from the city noise.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>поселиться</w> в тихой сельской местности, вдали от городского шума.",
                                "zh": "他选择<w>居住</w>在远离城市喧嚣的宁静乡村。",
                                "es": "Él eligió <w>residir</w> en la tranquila campiña, lejos del ruido de la ciudad."
                            }
                        },
                        {
                            "text": "The spirit was said to <w>abide</w> within the ancient stone walls of the castle.",
                            "target_lang_translations": {
                                "ru": "Говорили, что дух <w>обитает</w> в древних каменных стенах замка.",
                                "zh": "据说那个灵魂<w>栖息</w>在城堡古老的石墙内。",
                                "es": "Se decía que el espíritu <w>habitaba</w> dentro de los antiguos muros de piedra del castillo."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwell",
                        "inhabit",
                        "live",
                        "reside",
                        "stay"
                    ],
                    "common_phrases": [
                        "abide with me"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense is mostly found in older literature or religious texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить или обитать в определенном месте.",
                        "zh": "居住或栖息在某个特定的地方。",
                        "es": "Vivir o habitar en un lugar determinado."
                    },
                    "translations": {
                        "ru": [
                            {
