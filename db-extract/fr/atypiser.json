                ],
                "senses": [
                    {
                        "sense_id": "7f31d33d-3c17-3ed2-bae0-fa2dcb509aac",
                        "entry_id": "40a5cca0-3f12-3216-838c-f8aa096ce103",
                        "glosses": [
                            "Donner un caractère atypique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc886c94-c20f-46ba-b83f-423f0d706dc1",
                                "sense_id": "7f31d33d-3c17-3ed2-bae0-fa2dcb509aac",
                                "text": "Ce sont des cellules-souches médullaires atypisées par le même mécanisme irritatif ou dysenzymatique qui détermine l’appariton des anomalies dans les cellules lymphoréticulaires et dans la série granulocytaire."
                            },
                            {
                                "example_id": "31120229-ac33-4d2e-9571-9fa4fcc1d435",
                                "sense_id": "7f31d33d-3c17-3ed2-bae0-fa2dcb509aac",
                                "text": "Les cellules carcinomateuses peuvent être simulées non seulement par des éléments réticulaires atypisés, mais aussi par des cellules blastiques autochtones qui, à leur tour, souffrent des modifications qui les rendent atypiques."
                            },
                            {
                                "example_id": "644c6fbe-2152-41a7-ba63-004022a3fc33",
                                "sense_id": "7f31d33d-3c17-3ed2-bae0-fa2dcb509aac",
                                "text": "Quant à Batatoubi Gomis, va falloir qu'il \"atypise\" encore un peu plus son jeu hein."
                            }
                        ]
                    }
                ],
