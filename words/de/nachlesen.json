                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der Veröffentlichung des Buches muss der Lektor das gesamte Manuskript aufmerksam <w>nachlesen</w>."
