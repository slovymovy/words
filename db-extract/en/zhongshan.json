                "senses": [
                    {
                        "sense_id": "686f7f13-19d3-31d4-b8ff-475247c0764d",
                        "entry_id": "a6062498-afd4-3217-bc7a-f07d034463a1",
                        "glosses": [
                            "A prefecture-level city of Guangdong, in southern China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e43464e4-5588-45a4-b4e7-b73b51f24464",
                                "sense_id": "686f7f13-19d3-31d4-b8ff-475247c0764d",
                                "text": "The chief town of Zhongshan, Shiqi (formerly spelt Shekkei) has been an important market centre and inland port for 800 years."
                            },
                            {
                                "example_id": "8e8fa48d-c186-41e8-860a-5f7e53a248ff",
                                "sense_id": "686f7f13-19d3-31d4-b8ff-475247c0764d",
                                "text": "A man was apprehended by the mainland police early yesterday morning in Zhongshan on suspected link with human body parts found in Taipa Grande on Saturday."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6855c9c-75b7-3e24-a3a2-28181145237a",
                        "entry_id": "a6062498-afd4-3217-bc7a-f07d034463a1",
                        "glosses": [
                            "A district of the city of Taipei, Taiwan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052a5703-b9f9-42c6-87da-9c0b49bac4d1",
                                "sense_id": "d6855c9c-75b7-3e24-a3a2-28181145237a",
                                "text": "Many trendy and expensive restaurants can be found in and around Taipei 101. The Jhongshan district is full of nightclubs and Karoake bars and has remnants of Japanese forms of entertainment."
                            },
                            {
                                "example_id": "76794ee0-5938-45df-adc4-53cb5c7e835d",
                                "sense_id": "d6855c9c-75b7-3e24-a3a2-28181145237a",
                                "text": "Speaking at her cafe in Taipei’s Zhongshan district, Annie Hsieh, unrelated to Mr. Hsieh, smiled when asked about the Tsai-Trump call.\n“I think it’s great,” Ms. Hsieh said."
                            },
                            {
                                "example_id": "1767f8f1-d746-432f-ad55-279ee543c759",
                                "sense_id": "d6855c9c-75b7-3e24-a3a2-28181145237a",
                                "text": "The Leofoo Residences is situated in the vibrant center of the Jhongshan District, in the heart of downtown Taipei.",
                                "translation": "Leofoo Residences",
                                "english": "Leofoo Residences"
                            },
                            {
                                "example_id": "ea85b4b0-0bdd-405d-8819-377deb612ee5",
                                "sense_id": "d6855c9c-75b7-3e24-a3a2-28181145237a",
                                "text": "Arrangements are being made, including a public appearance with a visit to the Legislative Yuan tomorrow, they said, adding she would also meet with President Tsai Ing-wen (蔡英文).\nHowever, given the sensitivity involved, plans would change according to situations, they added.\nMeanwhile, local media quoted other sources as saying that Pelosi could possibly stay at the Grand Hyatt Taipei in Xinyi District (信義) or the Marriott Taipei in Zhongshan District (中山)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6b50193-6c72-39f3-86a2-a30c483dc6c9",
