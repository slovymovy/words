                    {
                        "translation_id": "71265fe6-5bd0-4950-b7c5-8583a07cced2",
                        "source_entry_id": "c209a6c3-581a-39ea-ac5c-82e461b3c8d8",
                        "source_sense_description": "scarcely, hardly",
                        "target_lang_word": "annähernd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annähernd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                        "entry_id": "1cc5f8f7-4bbe-3aa3-972d-916bc851e2d9",
                                        "glosses": [
                                            "fast, nur einen kleinen Unterschied habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef474e82-75ed-425b-aa4e-2d64c4d1ecba",
                                                "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                                "text": "[Schüler:] „Er ist in Englisch nicht annähernd so gut wie ich. Warum kriegt er die gleiche Note?“"
                                            },
                                            {
                                                "example_id": "fdbf289b-72d3-4cbd-a713-da2b3e1a1f41",
                                                "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                                "text": "„Ich bin 11 Jahre, mein Bruder ist zehn, aber er ist annähernd gleich groß.“"
                                            },
                                            {
                                                "example_id": "22aa96d4-62e0-4e27-9e66-b6f4c0485223",
                                                "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                                "text": "„Den Wert dieser alten Kommode kann ich ihnen nur annähernd nennen.“"
                                            },
                                            {
                                                "example_id": "5a306ef5-5277-4c58-b095-ddab62fdbaa8",
                                                "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                                "text": "„Unsere Zugfahrt hat annähernd fünf Stunden gedauert.“"
                                            },
                                            {
                                                "example_id": "89d2c9b7-2498-4565-954f-799c9ba54071",
                                                "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                                "text": "Es scheint annähernd jeder, der sich länger als für die Dauer eines Urlaubs in Istanbul aufhält, darüber ein Buch zu verfassen."
                                            },
                                            {
                                                "example_id": "89d7700e-5d4d-4a59-8dbe-790b5fbc54ed",
                                                "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                                "text": "Annähernd eine Million Menschen, vor allem Zivilisten, wurden Opfer dieser „militärischen Operation“ [der Blockade Leningrads, heute Sankt Petersburg, durch die deutsche Wehrmacht]."
                                            },
                                            {
                                                "example_id": "0dc85cbf-627a-439e-b7c4-2f014fdf6b30",
                                                "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                                "text": "„[…] Das Drama in den USA mit den Opioiden, das haben wir in Deutschland ja nicht annähernd so.“"
                                            },
                                            {
                                                "example_id": "062bad7f-b935-41c7-b2ab-19b082eadd82",
                                                "sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                                                "text": "Derzeit ist Russland im Ranking der Volkswirtschaften auf Platz 12. Um auf Platz fünf zu kommen, müsste Russland sein Bruttoinlandsprodukt annähernd verdoppeln und Frankreich einholen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
