                ],
                "senses": [
                    {
                        "sense_id": "9f9a68e2-1c2a-3ea3-af88-a0fc333d3a47",
                        "entry_id": "5f4ad8c5-f605-3213-9d67-36c064d6b9f7",
                        "glosses": [
                            "kleine Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab7705a-5c6c-4e93-abbf-ae82f8b6a1e4",
                                "sense_id": "9f9a68e2-1c2a-3ea3-af88-a0fc333d3a47",
                                "text": "„Die Kirchlein stehen in ihrem bäuerlichen Barock ziemlich dürftig da.“"
                            },
                            {
                                "example_id": "7fa97f5a-ceeb-49c8-801a-96df547f2d70",
                                "sense_id": "9f9a68e2-1c2a-3ea3-af88-a0fc333d3a47",
                                "text": "„Die unzähligen Kirchlein sollten ein tröstliches Zeichen für die Überlebenden sein, dass Gott sie nicht verlassen hat.“"
                            },
                            {
                                "example_id": "9cc0d89c-5f4a-45c2-b3cf-17edb8181574",
                                "sense_id": "9f9a68e2-1c2a-3ea3-af88-a0fc333d3a47",
                                "text": "„In dem Kirchlein nahmen sie auch ihre Mahlzeit ein, garten das Fleisch an offenem Feuer, achteten aber darauf, dass es nicht das Gestühl in Brand setzte.“"
                            },
                            {
                                "example_id": "3ee06ae9-f80a-4670-b78b-719042196aad",
                                "sense_id": "9f9a68e2-1c2a-3ea3-af88-a0fc333d3a47",
                                "text": "„Aber Katrin behauptete, in diesem weißen, reinen Kirchlein könne man besser beten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
