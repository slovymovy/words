    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25435cb2-8737-3447-bf8d-2a364d179600",
                    "sense_definition": "Série de questions formelles posées par un juge ou la police à une personne soupçonnée ou témoin d'une affaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect a finalement avoué son délit après plusieurs heures d'<w>interrogatoire</w> au commissariat."
                        },
                        {
                            "text": "L'avocat a exigé d'assister à l'<w>interrogatoire</w> de son client dès le début de la garde à vue."
                        }
                    ],
                    "synonyms": [
                        "audition"
                    ],
                    "common_phrases": [
                        "salle d'interrogatoire",
                        "mener un interrogatoire"
                    ]
                },
                {
                    "sense_id": "854525aa-ba2e-3676-9caa-c3e10f911a26",
                    "sense_definition": "Ensemble pressant ou insistant de questions posées à quelqu'un dans la vie quotidienne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "questions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'il rentrait tard, ses parents lui faisaient subir un véritable <w>interrogatoire</w>."
                        },
                        {
                            "text": "Je ne voulais pas donner l'impression de lui faire passer un <w>interrogatoire</w> lors de notre premier rendez-vous."
                        }
                    ],
                    "synonyms": [
                        "questionnement"
                    ],
                    "common_phrases": [
                        "subir un interrogatoire",
                        "passer un interrogatoire"
                    ]
                },
                {
                    "sense_id": "56094fbb-f36c-3a08-88cd-d31ebc62b135",
                    "sense_definition": "Document ou procès-verbal consignant par écrit les questions posées par un magistrat et les réponses de la personne interrogée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le greffier relut soigneusement l'<w>interrogatoire</w> avant de le faire signer au prévenu."
                        },
                        {
                            "text": "Les enquêteurs ont versé l'<w>interrogatoire</w> au dossier d'instruction pour éclairer le tribunal."
                        }
                    ],
                    "synonyms": [
                        "procès-verbal"
                    ],
                    "common_phrases": [
                        "signer l'interrogatoire",
                        "lecture de l'interrogatoire"
                    ]
                }
            ]
        }
    ]
