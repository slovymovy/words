                            "comment": "historical nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище Бенджамина Дизраэли (1804–1881), британского премьер-министра.",
                        "fr": "Surnom historique de Benjamin Disraeli, homme d'État britannique."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Диззи",
                                "target_lang_sense_clarification": "историческое прозвище"
                            }
                        ],
                        "fr": [
