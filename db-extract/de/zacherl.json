                ],
                "senses": [
                    {
                        "sense_id": "0ed5f725-639e-3e3c-b4ee-0a79fca3c6b1",
                        "entry_id": "155b670a-b522-3bc9-b7d7-e7570148386c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d03640ed-06c6-4bf9-88c8-f158c11b354f",
                                "sense_id": "0ed5f725-639e-3e3c-b4ee-0a79fca3c6b1",
                                "text": "Frau Zacherl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "200871f6-b1da-47e8-9ef8-9789306bd136",
                                "sense_id": "0ed5f725-639e-3e3c-b4ee-0a79fca3c6b1",
                                "text": "Herr Zacherl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3f85ce11-3aab-4e9a-b9ea-e719d93fa561",
                                "sense_id": "0ed5f725-639e-3e3c-b4ee-0a79fca3c6b1",
                                "text": "Die Zacherls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7125402a-d904-4220-a169-c54877835a01",
                                "sense_id": "0ed5f725-639e-3e3c-b4ee-0a79fca3c6b1",
                                "text": "Der Zacherl trägt nie die Schals, die die Zacherl ihm strickt."
                            },
                            {
                                "example_id": "859cde41-adbe-463b-b94e-b81e5e66d78d",
                                "sense_id": "0ed5f725-639e-3e3c-b4ee-0a79fca3c6b1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zacherl kommt, geht der Herr Zacherl.“"
                            },
                            {
                                "example_id": "30a03758-124f-4db7-aae7-73a8e4790ed4",
                                "sense_id": "0ed5f725-639e-3e3c-b4ee-0a79fca3c6b1",
                                "text": "Zacherl kommt und geht."
                            },
                            {
                                "example_id": "6d917820-545a-42cc-9c1d-f3928f4f8f4b",
                                "sense_id": "0ed5f725-639e-3e3c-b4ee-0a79fca3c6b1",
                                "text": "Zacherls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
