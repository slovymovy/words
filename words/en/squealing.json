                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were <w>squealing</w> with excitement when the puppy entered the room.",
                            "target_lang_translations": {
                                "nl": "De kinderen waren van opwinding aan het <w>gillen</w> toen de puppy de kamer binnenkwam."
                            }
                        },
                        {
                            "text": "The car suddenly braked, its tires loudly <w>squealing</w> on the pavement.",
                            "target_lang_translations": {
                                "nl": "De auto remde plotseling, terwijl de banden luid op het asfalt <w>piepten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "screeching",
                        "shrieking"
                    ],
                    "common_phrases": [
                        "squealing tires",
                        "squealing with delight",
                        "squealing with excitement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
