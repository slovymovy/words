                        "entry_id": "f574d887-9eea-3c96-8978-324bcddc6d18",
                        "glosses": [
                            "Rendre japonais, ou plus japonais."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "18921b3b-304a-43aa-8034-c6ce3d89aa52",
                                "sense_id": "415f10cf-3b01-3afb-b13e-59a42770b7ed",
                                "text": "La maison dans laquelle je vais peu à peu me japonifier."
                            },
                            {
                                "example_id": "d94ae549-1b79-40e4-ba98-718c042d77b0",
                                "sense_id": "415f10cf-3b01-3afb-b13e-59a42770b7ed",
                                "text": "Seraient-ils en train de se japonifier ?"
                            },
                            {
                                "example_id": "3b4e1cc7-cb64-44b7-a5cc-71ef698090f1",
                                "sense_id": "415f10cf-3b01-3afb-b13e-59a42770b7ed",
                                "text": "Tiens, au passage, je jette un premier merci, à ceux qui m'ont prêté des bouquins, qui vont me permettre de me japonifier..."
                            }
                        ]
                    }
