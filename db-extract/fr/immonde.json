                "forms": [],
                "senses": [
                    {
                        "sense_id": "110fc22c-b188-3a34-81f1-0abca2e9f8ff",
                        "entry_id": "68aaf3ee-393c-32e3-b328-e2ac47140104",
                        "glosses": [
                            "onrein, onzuiver"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b20b2ddd-d4fc-4266-853d-0c6876df8257",
                                "sense_id": "110fc22c-b188-3a34-81f1-0abca2e9f8ff",
                                "text": "Le pourceau était déclaré immonde par la loi des juifs.",
                                "translation": "Het varken werd door de Joodse wet onrein verklaard."
                            }
                        ]
                    },
                    {
                        "sense_id": "0044e96f-a232-3a86-817e-418ce9ab3f3d",
                        "entry_id": "68aaf3ee-393c-32e3-b328-e2ac47140104",
                        "glosses": [
                            "walgelijk, schunnig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d4ca56-8ebf-4858-921b-5d3e3f907ff4",
                                "sense_id": "0044e96f-a232-3a86-817e-418ce9ab3f3d",
                                "text": "— Comment trouvez-vous mon invité ? Et lui, s’apercevant pour la première fois que Forcheville qu’il connaissait depuis longtemps pouvait plaire à une femme et était assez bel homme, avait répondu : « Immonde ! »",
                                "translation": "- Hoe vindt U mijn gast?. En hij, die voor het eerst opmerkte dat Forcheville die hij al lang kende, zowel een vrouw alsook een best wel knappe man kon behagen, had toen geantwoord: „Walgelijk !”"
                            }
                        ]
                    }
                ],
