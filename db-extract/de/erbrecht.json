                "senses": [
                    {
                        "sense_id": "d449e595-828c-3b0c-a9d6-1e84e259899c",
                        "entry_id": "10fe903e-59cd-30f8-834b-05f32d33fffd",
                        "glosses": [
                            "Gesamtheit der rechtlichen Regelungen eines Staates für das Erben und Vererben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e26321-6b7f-4e9a-bfd6-fe53f11f96b1",
                                "sense_id": "d449e595-828c-3b0c-a9d6-1e84e259899c",
                                "text": "Das Erbrecht kann von Staat zu Staat sehr verschieden sein."
                            },
                            {
                                "example_id": "a9257494-492c-4d0e-81a8-0927c1e88730",
                                "sense_id": "d449e595-828c-3b0c-a9d6-1e84e259899c",
                                "text": "In Deutschland heißen die Spezialisten für das Erbrecht „Fachanwälte für Erb- und Familienrecht“."
                            },
                            {
                                "example_id": "ce29c6b0-538d-4bc9-b084-01abb63a594d",
                                "sense_id": "d449e595-828c-3b0c-a9d6-1e84e259899c",
                                "text": "„Mit nicht nachlassender Geschwätzigkeit predigt Mittelmann auf verschlungenen Wegen sein Unwissen über das Schuldrecht, das Zwangsvollstreckungsrecht, das Erbrecht, zur Schadenfreude und zum Überdruß der anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93171a2c-2fec-3fb6-aab6-ed79ef01d1a5",
                        "entry_id": "10fe903e-59cd-30f8-834b-05f32d33fffd",
                        "glosses": [
                            "nach dem Tod einer Person bestehender Anspruch auf eine Erbschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae9ef9e3-4f48-43fc-8b8f-88fdae650d6d",
                                "sense_id": "93171a2c-2fec-3fb6-aab6-ed79ef01d1a5",
                                "text": "Weil mein Großvater auf sein Erbrecht verzichtet hatte, erlangte sein Bruder das Alleineigentum an der Fabrik ihres verstorbenen Vaters."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
