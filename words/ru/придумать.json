                {
                    "sense_id": "064d78c2-1480-36b1-bf27-3019dd5fb582",
                    "sense_definition": "Найти решение проблемы, создать что-то новое мысленно или изобрести.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Никто ещё не <придумал> машину времени, чтобы путешествовать в прошлое.",
                            "target_lang_translations": {
                                "en": "No one has <invented> a time machine to travel to the past yet.",
                                "es": "Nadie ha <inventado> todavía una máquina del tiempo para viajar al pasado.",
                                "fr": "Personne n'a encore <inventé> de machine à remonter le temps pour voyager dans le passé."
                            }
                        },
                        {
                            "text": "Нам нужно срочно <придумать> план, как выбраться из этой ситуации.",
                            "target_lang_translations": {
                                "en": "We urgently need to <come up with> a plan on how to get out of this situation.",
                                "es": "Necesitamos urgente <idear> un plan para salir de esta situación.",
                                "fr": "Nous devons d'urgence <trouver> un plan pour nous sortir de cette situation."
                            }
                        }
                    ],
                    "synonyms": [
                        "изобрести",
                        "сообразить",
                        "решить",
                        "выдумать"
                    ],
                    "common_phrases": [
                        "придумать план",
                        "придумать способ",
                        "придумать название",
                        "придумать решение"
                    ],
                    "target_lang_definitions": {
                        "en": "To find a solution to a problem, mentally create something new, or invent.",
                        "es": "Encontrar una solución a un problema, crear algo nuevo mentalmente o inventar.",
                        "fr": "Trouver une solution à un problème, créer mentalement quelque chose de nouveau ou inventer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come up with",
                                "target_lang_sense_clarification": "a plan, idea, or solution"
                            },
