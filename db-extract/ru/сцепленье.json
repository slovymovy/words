                "senses": [
                    {
                        "sense_id": "4fa0f5ce-ddfd-3574-acd8-bd60c1823a25",
                        "entry_id": "c44204a2-bec2-374b-ac2d-c9f17aa3388a",
                        "glosses": [
                            "устар., разг. и поэт. то же, что сцепление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "244ad8fe-a312-4eed-bc25-9a6d4d98e9ea",
                                "sense_id": "4fa0f5ce-ddfd-3574-acd8-bd60c1823a25",
                                "text": "В тюрьмах дум своих, в сцепленьи зданий-склепов, слов-могил // Позабыли о теченьи Чисел, Вечности, Светил."
                            },
                            {
                                "example_id": "4aae0346-c5e2-4bed-80c6-7f0fa05873b2",
                                "sense_id": "4fa0f5ce-ddfd-3574-acd8-bd60c1823a25",
                                "text": "Пусть эти ветреные существа, // Рождённые от вожделений душных, // Кричали бы, что жизнь моя мертва, // Что я ― сцепленье атомов бездушных .."
                            },
                            {
                                "example_id": "7e0eca18-469e-41e2-8b87-e660d373df35",
                                "sense_id": "4fa0f5ce-ddfd-3574-acd8-bd60c1823a25",
                                "text": "Что первым таким откровеньем // Остался в сцепленьи судеб // Прапращуром в дар поколеньям // Взращённый столетьями хлеб."
                            }
                        ]
                    }
                ],
