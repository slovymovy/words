                "senses": [
                    {
                        "sense_id": "9ccea795-ccfd-3578-80f7-004856838a0a",
                        "entry_id": "587122e1-d85c-30a6-8d00-9c3fae8d90bb",
                        "glosses": [
                            "Praticienne qui pratique la chirurgie."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "fad2fadb-e7a1-4674-be0c-b4dc319139b2",
                                "sense_id": "9ccea795-ccfd-3578-80f7-004856838a0a",
                                "text": "Plaie douloureuse et non mortelle, Acerrimum humeri vulnus, non autem lethale, murmura la belle et savante chirurgienne ; passe-moi du baume et prépare de la charpie, Gillonne."
                            },
                            {
                                "example_id": "bd678c42-51a3-449c-a3d2-da38a3daf84d",
                                "sense_id": "9ccea795-ccfd-3578-80f7-004856838a0a",
                                "text": "Dame Trotula y enseignait les balbutiements de la gynéco-obstétrique, alors que sous le règne de Louis XI, Dame Hersent sera la chirurgienne personnelle du roi."
                            },
                            {
                                "example_id": "86f1329b-c44d-42ed-bbb7-754e2f9b7519",
                                "sense_id": "9ccea795-ccfd-3578-80f7-004856838a0a",
                                "text": "Angela Kogan, une chirurgienne esthétique, a affirmé, photo à l’appui, dans un article écrit pour Shade Room, et supprimé depuis, que 50 Cent a fait partie de ses clients ayant sollicité ses services pour augmenter la taille de leur pénis."
                            }
                        ]
                    },
