                "senses": [
                    {
                        "sense_id": "592f79a2-7496-3248-acd8-60609d040e41",
                        "entry_id": "2868a3af-a0d9-379f-b3ae-08caba57e821",
                        "glosses": [
                            "Laut, bei dem der Luftstrom bei seiner Aussprache unbehindert ausströmen kann"
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "997bb0cd-cbae-4f77-82c8-2fe06b3d6aef",
                                "sense_id": "592f79a2-7496-3248-acd8-60609d040e41",
                                "text": "„Der unlokalisierbare Öffnungslaut wird entwicklungsmäßig in der Kindersprache offensichtlich sehr früh erworben.“"
                            },
                            {
                                "example_id": "ca62154b-a02d-46e7-b9e8-c5a5949fe13a",
                                "sense_id": "592f79a2-7496-3248-acd8-60609d040e41",
                                "text": "„Vokale sind stimmhafte, geräuschlose Öffnungslaute.“"
                            }
                        ],
