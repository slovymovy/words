                    {
                        "translation_id": "648b527b-94d9-4a91-909a-69bee0eed882",
                        "source_entry_id": "75c55f04-ffae-3a85-b9a3-5f03f77dbc00",
                        "source_sense_id": "dc14c9e2-7c3c-36db-b401-b784890365d6",
