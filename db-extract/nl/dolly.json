                                        "sense_id": "70601b5a-d2c9-3f71-b4d4-703fed06c582",
                                        "entry_id": "5ac1a680-e330-3eff-b277-5f0a04f1e7df",
                                        "glosses": [
                                            "A contrivance for stirring:",
                                            "A disc with downward legs and a vertical handle, used for agitating laundry."
