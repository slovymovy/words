                ],
                "senses": [
                    {
                        "sense_id": "f8166214-2a37-395a-8da0-74aabbd2c7ef",
                        "entry_id": "6724ce7a-2bbe-3d3c-8c91-4b72bcb08ee1",
                        "glosses": [
                            "so, dass es beziffert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb0fd1c0-b239-4e22-ac9c-3f95ad50d92a",
                                "sense_id": "f8166214-2a37-395a-8da0-74aabbd2c7ef",
                                "text": "„Die Mode wollte kostspielig sein. Nunmehr hatte die bürgerliche Frau in ihrer äußeren Erscheinung augenfällig, bezifferbar darzutun, was sich der Bürger leisten konnte.“"
                            },
                            {
                                "example_id": "04cb027c-1899-4a93-b297-cc9f58a0544e",
                                "sense_id": "f8166214-2a37-395a-8da0-74aabbd2c7ef",
                                "text": "„Ist die Schadenersatzforderung bereits bezifferbar, dann muss deren Höhe auch schon in der Anschlusserklärung angegeben sein, um die Unterbrechungswirkung für die gesamte Forderung entfalten zu können.“"
                            }
