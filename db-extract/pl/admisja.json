                        ],
                        "form": "admisjo"
                    },
                    {
                        "form_id": "e80dd054-19d3-4bfb-873c-8e0a94f7baf8",
                        "entry_id": "85da97bd-0a36-3285-999e-3344b4f3db07",
                        "tags": [
                            "vocative",
                            "plural"
                        ],
                        "form": "admisje"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20f63c2e-2fd8-3470-af13-f5c18d86a4b2",
                        "entry_id": "85da97bd-0a36-3285-999e-3344b4f3db07",
                        "glosses": [
                            "Gunst, Sympathie"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4de0643c-793e-49e9-abfd-348b5bc9cc2e",
                        "source_entry_id": "85da97bd-0a36-3285-999e-3344b4f3db07",
                        "source_sense_id": "20f63c2e-2fd8-3470-af13-f5c18d86a4b2",
                        "source_sense_description": "veraltet: Gunst, Sympathie",
                        "target_lang_word": "Gunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2533d6d9-6412-36a4-8395-7bd5b1aa4c18",
                                        "entry_id": "d1d86034-1c63-3668-a324-0b208c077ab8",
                                        "glosses": [
                                            "die Bevorzugung, das Wohlwollen, die Gewogenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffdc8ee-df37-4b9b-8aec-82d5a7ca3b95",
                                                "sense_id": "2533d6d9-6412-36a4-8395-7bd5b1aa4c18",
                                                "text": "1864 errang er die Gunst des bayrischen Königs Ludwig II., der seine Schulden bezahlte und ihn auch weiterhin unterstützte."
                                            },
                                            {
                                                "example_id": "dc4ce818-2d67-4b24-a4fd-438825f1d98e",
                                                "sense_id": "2533d6d9-6412-36a4-8395-7bd5b1aa4c18",
                                                "text": "Nicht Aureliens Tod, sondern nur die als gräßlich und entsetzlich erscheinende Art desselben hatte mich in den ersten Augenblicken so tief erschüttert; aber wie bald erkannte ich, daß die Gunst der ewigen Macht sie das Höchste bestehen ließ!"
                                            },
                                            {
                                                "example_id": "17577d47-9743-4f2b-9a4f-641c3b98d8e2",
                                                "sense_id": "2533d6d9-6412-36a4-8395-7bd5b1aa4c18",
                                                "text": "Damit führen sie immer noch deutlich in der Gunst der Wähler, allerdings schwindet die Unterstützung momentan wöchentlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9112329a-0b3d-353d-839c-242f7f0e656e",
                                        "entry_id": "d1d86034-1c63-3668-a324-0b208c077ab8",
                                        "glosses": [
                                            "die Erfüllung eines Wunsches, einer Bitte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9645cde1-f791-4b81-8ab2-df1565b81aa4",
                                                "sense_id": "9112329a-0b3d-353d-839c-242f7f0e656e",
                                                "text": "Als Johnny diesem Befehl Folge geleistet hatte und wieder zu seinem Stuhl zurückgekehrt und wieder in Demut versunken war, da erbat sich Mr. Adolphus Tetterby jun., der inzwischen seine obere Hälfte aus einem endlosen regenbogenfarbigen Schal herausgewickelt hatte, dieselbe Gunst."
                                            },
                                            {
                                                "example_id": "66826340-4e5e-4a6e-86c3-1b7b0411a32a",
                                                "sense_id": "9112329a-0b3d-353d-839c-242f7f0e656e",
                                                "text": "Er erbat eine Gunst: sieben Tage Westen. Die Gunst wurde gewährt, wegen Beherrschung der Textform konstruktives Miteinander von Kirche und Staat."
                                            },
                                            {
                                                "example_id": "c62f71fa-6b4e-4553-b57e-120fdc8920be",
                                                "sense_id": "9112329a-0b3d-353d-839c-242f7f0e656e",
                                                "text": "„So verteilte sie ihre Gunst an die verschiedenen Verehrer je nach deren Noblesse und Großzügigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5b51a594-bacd-3080-8966-bd0325c6c6ec",
                                        "entry_id": "d1d86034-1c63-3668-a324-0b208c077ab8",
                                        "glosses": [
                                            "eine gute Gelegenheit, ein glücklicher Umstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d236d86-66e3-423e-ad9a-9df7de68ad63",
                                                "sense_id": "5b51a594-bacd-3080-8966-bd0325c6c6ec",
                                                "text": "Der könnte jetzt die Gunst der Stunde dazu nutzen, um gleich auch noch ein wenig davon auf den Weg zu bringen, was ihn einst am meisten umtrieb: die Modernisierung der Ökonomie, zu der schließlich auch die Landwirtschaft gehört."
                                            },
                                            {
                                                "example_id": "5a157e54-8cef-4bd4-829b-092e931f9b49",
                                                "sense_id": "5b51a594-bacd-3080-8966-bd0325c6c6ec",
                                                "text": "Auch der Tischler und frühere Antiquitätensammler Klaus Bauer und seine Frau Ingrid haben die Gunst der Wende genutzt, zunächst in den Handel, dann ins Auktionsgeschäft einzusteigen."
                                            },
                                            {
                                                "example_id": "c7e803f5-705e-4db6-b1c9-58e3cd103b8d",
                                                "sense_id": "5b51a594-bacd-3080-8966-bd0325c6c6ec",
                                                "text": "Mit dem Clavichord, einem frühen Vorgänger des Klaviers, tourte er durch Deutschland und genoss die Gunst des Augenblicks, wenn auch hin und wieder nur vor drei Zuhörern."
                                            },
                                            {
                                                "example_id": "635c36ce-ccad-414f-81d6-d0feed2abd49",
                                                "sense_id": "5b51a594-bacd-3080-8966-bd0325c6c6ec",
                                                "text": "„Wahrscheinlich hatte sie es sich eingebildet, aber sie nutzte trotzdem die Gunst des Augenblicks und löste sich aus Reynirs Griff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba9fe9b3-e046-4d8e-8d4d-55bad065ce7d",
                        "source_entry_id": "85da97bd-0a36-3285-999e-3344b4f3db07",
                        "source_sense_id": "20f63c2e-2fd8-3470-af13-f5c18d86a4b2",
                        "source_sense_description": "veraltet: Gunst, Sympathie",
                        "target_lang_word": "Sympathie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sympathie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e19b174-6fe8-30cf-8f68-8800dd92df1b",
                                        "entry_id": "7c9831d7-d87e-3904-939c-332a237d9868",
                                        "glosses": [
                                            "positive Einstellung zu einer Sache oder Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45577cf5-8f54-4eb0-b935-4095f2fd2be8",
                                                "sense_id": "4e19b174-6fe8-30cf-8f68-8800dd92df1b",
                                                "text": "Meine Sympathie gilt den kämpferischen Eltern."
                                            },
                                            {
                                                "example_id": "40a9edbd-fc06-42a2-ad85-5ebdf36e52ce",
                                                "sense_id": "4e19b174-6fe8-30cf-8f68-8800dd92df1b",
                                                "text": "„Wenn es also Sympathien für die Streiter von Greenpeace geben sollte, dann werden sie nicht geäußert.“"
                                            },
                                            {
                                                "example_id": "9ee9a995-d809-433e-b82c-5957ea1a78c6",
                                                "sense_id": "4e19b174-6fe8-30cf-8f68-8800dd92df1b",
                                                "text": "„Nach Ansicht der Eltern und einiger befragter Nachbarn machte die Demonstrationsperson vor der Schulzeit den Eindruck eines bescheidenen, still-vergnügten und unauffälligen Kindes, das sich allgemeiner Sympathien erfreute.“"
                                            },
                                            {
                                                "example_id": "0279e6bf-408e-4ea2-88c3-bfd6346f042d",
                                                "sense_id": "4e19b174-6fe8-30cf-8f68-8800dd92df1b",
                                                "text": "„Oft entscheidet der Klang einer Stimme über Sympathie oder Antipathie.“"
                                            },
                                            {
                                                "example_id": "517561a1-59e0-4708-ae11-992f67790743",
                                                "sense_id": "4e19b174-6fe8-30cf-8f68-8800dd92df1b",
                                                "text": "„Durch die abenteuerliche Geschichte und sein Lachen hatte er meine Sympathie gewonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
