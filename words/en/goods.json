                    "target_lang_definitions": {
                        "ru": "Достоверная информация, особенно улики против кого-либо, или ожидаемые результаты.",
                        "cs": "Důvěryhodné informace, zejména kompromitující důkazy o někom, nebo očekávané výsledky.",
                        "tr": "Bir kimse hakkında suçlayıcı kanıtlar, güvenilir bilgi veya beklenen sonuçlar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компромат",
                                "target_lang_sense_clarification": "улики, компрометирующие факты"
                            },
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "выполнение обещанного (в идиомах)"
                            }
