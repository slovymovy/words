{
    "word_family": [
        "elicitation",
        "elicitor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b4bc35c-08fa-310b-a64b-0a210655b6b5",
                    "sense_definition": "To draw out or obtain information, facts, or a specific response from someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obtain information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective tried to <w>elicit</w> the truth from the witness during the long interview.",
                            "target_lang_translations": {
                                "ru": "Детектив пытался <w>вытянуть</w> правду у свидетеля во время долгого допроса."
                            }
                        },
                        {
                            "text": "The teacher used clever questions to <w>elicit</w> a response from the quiet students.",
                            "target_lang_translations": {
                                "ru": "Учитель использовал хитрые вопросы, чтобы <w>добиться</w> ответа от тихих учеников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "elicit a response",
                        "elicit information",
                        "elicit the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать информацию, факты или конкретный ответ от кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "получать информацию или сведения"
                            },
                            {
                                "target_lang_word": "добиваться",
                                "target_lang_sense_clarification": "получать ответ или правду"
                            },
                            {
                                "target_lang_word": "выпытывать",
                                "target_lang_sense_clarification": "стараться узнать скрытую информацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54431719-fe7c-3c12-9a8e-e32b690ed91e",
                    "sense_definition": "To provoke or cause a particular reaction, emotion, or feeling in people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "provoke reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian's jokes failed to <w>elicit</w> laughter from the bored audience.",
                            "target_lang_translations": {
                                "ru": "Шуткам комика не удалось <w>вызвать</w> смех у скучающей аудитории."
                            }
                        },
                        {
                            "text": "The new government policy is likely to <w>elicit</w> strong criticism from the public.",
                            "target_lang_translations": {
                                "ru": "Новая политика правительства, скорее всего, <w>вызовет</w> резкую критику со стороны общественности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "elicit laughter",
                        "elicit a reaction",
                        "elicit criticism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать определенную реакцию, эмоцию или чувство у людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "становиться причиной реакции или чувства"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "побуждать к определенному действию или ответу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91d70678-f9b1-3638-ac34-1bb9393d22a9",
                    "sense_definition": "To use logic or reasoning to arrive at a conclusion or truth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logical reasoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher attempted to <w>elicit</w> a universal truth from these basic observations.",
                            "target_lang_translations": {
                                "ru": "Философ пытался <w>вывести</w> универсальную истину из этих базовых наблюдений."
                            }
                        },
                        {
                            "text": "By analyzing the data carefully, we can <w>elicit</w> the underlying cause of the problem.",
                            "target_lang_translations": {
                                "ru": "Тщательно проанализировав данные, мы сможем <w>выявить</w> основную причину проблемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "deduce",
                        "construe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать логику или рассуждения для того, чтобы прийти к выводу или истине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выявлять",
                                "target_lang_sense_clarification": "обнаруживать скрытую суть или причину"
                            },
                            {
                                "target_lang_word": "делать вывод",
                                "target_lang_sense_clarification": "приходить к заключению на основе данных"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "выяснять истину путем анализа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03544814-5af3-3078-8dbc-faff4d616dd6",
                    "sense_definition": "Brought out into the open; made real or evident.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "evident",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued that it was an <w>elicit</w> act of equity that favored his client.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что это был <w>явный</w> акт справедливости, который пошел на пользу его клиенту."
                            }
                        },
                        {
                            "text": "The hidden feelings became <w>elicit</w> once the secret was finally revealed to the family.",
                            "target_lang_translations": {
                                "ru": "Скрытые чувства стали <w>очевидными</w>, как только секрет был наконец раскрыт семье."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выявленный, ставший очевидным или реальным (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "явный",
                                "target_lang_sense_clarification": "сделанный очевидным"
                            },
                            {
                                "target_lang_word": "проявленный",
                                "target_lang_sense_clarification": "выведенный наружу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}