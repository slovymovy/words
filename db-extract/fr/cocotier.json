                        "target_lang_word": "Kokospalme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kokospalme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6cd1da5-f8d4-36e6-8147-c911772a8f71",
                                        "entry_id": "512a02d2-cbf1-331f-9c1a-1a2fc9d2c026",
                                        "glosses": [
                                            "Palmenart tropischer Küsten mit essbaren Fruchtkernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9630b10-a9cf-4e97-8029-12bffbe17de9",
                                                "sense_id": "c6cd1da5-f8d4-36e6-8147-c911772a8f71",
                                                "text": "Fast alle Teile der Kokospalme werden verwertet."
                                            },
                                            {
                                                "example_id": "8d02c28e-cc6c-4d6a-abc3-2610b69c3e32",
                                                "sense_id": "c6cd1da5-f8d4-36e6-8147-c911772a8f71",
                                                "text": "„Die Samoaner mussten sich verpflichten, eine gewisse Anzahl von Kokospalmen pro Jahr zu pflanzen und Kopfsteuer zu zahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5742512c-90ae-46fa-8eef-363c8be166e9",
                        "source_entry_id": "6687cc7c-1f76-3a2b-8060-2325396f7a95",
