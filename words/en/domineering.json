    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "21d78fd7-fe54-3d0f-ae13-fd33574f6191",
                    "sense_definition": "Overbearing, dictatorial, or inclined to rule arbitrarily and control others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "No one liked working under the <w>domineering</w> manager because he never listened to anyone else's ideas.",
                            "target_lang_translations": {
                                "pl": "Nikt nie lubił pracować pod okiem <w>apodyktycznego</w> menedżera, ponieważ nigdy nie słuchał pomysłów innych osób."
                            }
                        },
                        {
                            "text": "She struggled to make her own decisions due to her <w>domineering</w> personality.",
                            "target_lang_translations": {
                                "pl": "Miała trudności z podejmowaniem własnych decyzji ze względu na swoją <w>despotyczną</w> osobowość."
                            }
                        }
                    ],
                    "synonyms": [
                        "bossy",
                        "dominant",
                        "forceful",
                        "pushy",
                        "oppressive"
                    ],
                    "antonyms": [
                        "submissive"
                    ],
                    "common_phrases": [
                        "domineering personality",
                        "domineering behavior"
                    ],
                    "target_lang_definitions": {
                        "pl": "Apodyktyczny, despotyczny lub mający tendencję do arbitralnego rządzenia i kontrolowania innych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "apodyktyczny",
                                "target_lang_sense_clarification": "narzucający swoją wolę i nieznoszący sprzeciwu"
                            },
                            {
                                "target_lang_word": "despotyczny",
                                "target_lang_sense_clarification": "wymagający bezwzględnego posłuszeństwa"
                            },
                            {
                                "target_lang_word": "władczy",
                                "target_lang_sense_clarification": "mający ton lub postawę wymagającą posłuchu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af5e4224-2cdd-3887-aaf8-38adea9bd3fb",
                    "sense_definition": "The act of one who domineers; behavior that is overbearing or dictatorial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>domineerings</w> of the captain made the crew feel completely powerless.",
                            "target_lang_translations": {
                                "pl": "Ciągłe <w>tyranizowanie</w> ze strony kapitana sprawiało, że załoga czuła się całkowicie bezsilna."
                            }
                        },
                        {
                            "text": "She could no longer tolerate the subtle <w>domineerings</w> that defined their daily interactions.",
                            "target_lang_translations": {
                                "pl": "Nie mogła już dłużej tolerować subtelnych przejawów <w>dominacji</w>, które definiowały ich codzienne relacje."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zachowanie apodyktyczne, despotyczne lub dominujące nad innymi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "apodyktyczność",
                                "target_lang_sense_clarification": "cecha kogoś, kto narzuca swoją wolę"
                            },
                            {
                                "target_lang_word": "despotyzm",
                                "target_lang_sense_clarification": "narzucanie swojej woli i kontrolowanie innych"
                            },
                            {
                                "target_lang_word": "dominacja",
                                "target_lang_sense_clarification": "przewaga i kontrolowanie innych osób"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e90c0a6d-cb8d-36cb-b669-fdcda24c94db",
                    "sense_definition": "present participle and gerund of <w>domineer</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was accused of <w>domineering</w> over his younger siblings throughout their childhood.",
                            "target_lang_translations": {
                                "pl": "Został oskarżony o <w>tyranizowanie</w> swojego młodszego rodzeństwa przez całe dzieciństwo."
                            }
                        },
                        {
                            "text": "Instead of collaborating, she ended up <w>domineering</w> the entire group discussion.",
                            "target_lang_translations": {
                                "pl": "Zamiast współpracować, skończyło się na tym, że <w>zdominowała</w> całą dyskusję grupową."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund form"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma imiesłowu i gerundium od czasownika 'domineer' (dominować, tyranizować)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dominowanie",
                                "target_lang_sense_clarification": "narzucanie swojej woli lub kontrolowanie sytuacji"
                            },
                            {
                                "target_lang_word": "tyranizowanie",
                                "target_lang_sense_clarification": "despotyczne traktowanie innych"
                            }
                        ]
                    }
                }
            ]
        }
    ]
