{
    "word_family": [
        "kwijtraken",
        "kwijtschelden",
        "kwijting",
        "kwijtspelen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55b12376-a8b7-3e2e-9870-6a2abf5bf00e",
                    "sense_definition": "niet meer weten waar iets of iemand is; verloren hebben",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verlies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben mijn sleutels <w>kwijt</w> en kan de deur niet openen.",
                            "target_lang_translations": {
                                "en": "I have <w>lost</w> my keys and cannot open the door."
                            }
                        },
                        {
                            "text": "Hij is zijn horloge <w>kwijt</w> geraakt tijdens het zwemmen in de zee.",
                            "target_lang_translations": {
                                "en": "He <w>lost</w> his watch while swimming in the sea."
                            }
                        }
                    ],
                    "synonyms": [
                        "verloren"
                    ],
                    "antonyms": [
                        "terecht"
                    ],
                    "common_phrases": [
                        "de weg kwijt",
                        "iets kwijt zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "no longer knowing where something or someone is; having lost something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "unable to be found or having wandered off"
                            },
                            {
                                "target_lang_word": "missing",
                                "target_lang_sense_clarification": "not present where it should be"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "799a4763-44c2-3414-b19c-8c4e4ec269a1",
                    "sense_definition": "bevrijd van iets dat als een last of ongewenst wordt ervaren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bevrijding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben blij dat ik die zorgen eindelijk <w>kwijt</w> ben.",
                            "target_lang_translations": {
                                "en": "I am glad that I am finally <w>rid of</w> those worries."
                            }
                        },
                        {
                            "text": "Na het gesprek was hij zijn angst voor het examen helemaal <w>kwijt</w>.",
                            "target_lang_translations": {
                                "en": "After the conversation, he was completely <w>free from</w> his fear of the exam."
                            }
                        }
                    ],
                    "common_phrases": [
                        "je ei kwijt kunnen",
                        "iets kwijt willen"
                    ],
                    "target_lang_definitions": {
                        "en": "freed from something that is experienced as a burden or unwanted"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rid of",
                                "target_lang_sense_clarification": "to no longer have something unpleasant"
                            },
                            {
                                "target_lang_word": "free from",
                                "target_lang_sense_clarification": "no longer burdened by something"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31e58a12-a509-3613-be6e-8a1edf834d16",
                    "sense_definition": "enkelvoud tegenwoordige tijd van <w>kwijten</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>kwijt</w> zich uitstekend van zijn moeilijke taak als voorzitter.",
                            "target_lang_translations": {
                                "en": "He <w>acquits</w> himself excellently of his difficult task as chairman."
                            }
                        },
                        {
                            "text": "Ik <w>kwijt</w> mij van mijn plicht om de waarheid te vertellen.",
                            "target_lang_translations": {
                                "en": "I <w>discharge</w> my duty to tell the truth."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich kwijten van"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inflection of kwijten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "singular present tense of 'kwijten' (to acquit/discharge oneself of a task)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "acquits",
                                "target_lang_sense_clarification": "performs a duty or task"
                            },
                            {
                                "target_lang_word": "discharges",
                                "target_lang_sense_clarification": "fulfills an obligation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbd68058-eb11-3af0-9cf4-68e7a67d2761",
                    "sense_definition": "gebiedende wijs van <w>kwijten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kwijt</w> u van uw taak en laat ons niet in de steek.",
                            "target_lang_translations": {
                                "en": "<w>Acquit</w> yourself of your task and do not let us down."
                            }
                        },
                        {
                            "text": "<w>Kwijt</w> je van je plicht voordat je gaat rusten.",
                            "target_lang_translations": {
                                "en": "<w>Fulfill</w> your duty before you go to rest."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative of kwijten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative mood of 'kwijten' (to acquit/discharge oneself of a task)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "acquit",
                                "target_lang_sense_clarification": "command to perform a duty"
                            },
                            {
                                "target_lang_word": "fulfill",
                                "target_lang_sense_clarification": "command to carry out an obligation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}