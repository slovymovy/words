                        "glosses": [
                            "Un des principaux constituants des météorites ferrugineuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "172f63a3-a4d1-4bbe-a39a-4a44383bbdd5",
                                "sense_id": "7d8ab5f7-0a4e-3141-b610-60086a6f4dca",
                                "text": "Les unes sont constituées par de la tænite, alliage de fer et de nickel qui renferme de 15 à 48 % du second métal ; les autres sont en camasite, alliage où le nickel ne dépasse pas 7 %. La tænite résiste mieux que la camasite à l’acide azotique et reste légèrement en relief."
                            },
                            {
                                "example_id": "db4ed044-bef5-4b03-bf97-6124e5a687f6",
                                "sense_id": "7d8ab5f7-0a4e-3141-b610-60086a6f4dca",
                                "text": "La camasite contient moins de 7% de nickel."
                            }
