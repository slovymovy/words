                "senses": [
                    {
                        "sense_id": "eecc22ab-60ae-3701-b2ba-7d361eb011ed",
                        "entry_id": "9f7498d6-4586-35c9-89fd-9cc91349692a",
                        "glosses": [
                            "Devenir un cochon, ou quelque chose rappelant un cochon."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c44c2067-93d5-4813-a73e-7c334adaae60",
                                "sense_id": "eecc22ab-60ae-3701-b2ba-7d361eb011ed",
                                "text": "Je n'aimerais pas me porciniser ou cochoniser"
                            }
                        ]
                    },
                    {
                        "sense_id": "ad8686a2-0f61-30a7-a63f-a86ea7c472df",
                        "entry_id": "9f7498d6-4586-35c9-89fd-9cc91349692a",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b136f3-500a-4f96-8f9d-9d70f162454b",
                                "sense_id": "ad8686a2-0f61-30a7-a63f-a86ea7c472df",
                                "text": "Cette nuit, j'ai rêvé que les jumeaux d'on ne demande qu'à en rire tentaient de me cochoniser dans la chambre de mes parents."
                            },
                            {
                                "example_id": "f776e5c6-93b2-4de9-99ae-206940d80351",
                                "sense_id": "ad8686a2-0f61-30a7-a63f-a86ea7c472df",
                                "text": "Je cochonise des hurluberlus avec ambition et je vomis partout sur des dromadaires trapus !"
                            },
                            {
                                "example_id": "79f8e069-1719-4330-be94-3b92f312233a",
                                "sense_id": "ad8686a2-0f61-30a7-a63f-a86ea7c472df",
                                "text": "Qui c'est qui cochonise à tout va ?"
                            }
                        ]
                    }
