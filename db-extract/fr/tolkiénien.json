                "senses": [
                    {
                        "sense_id": "ca89a8a5-0d3b-3fab-87ab-74afc401c795",
                        "entry_id": "07d00b23-567d-32d9-84fd-5e881f19e7b1",
                        "glosses": [
                            "Relatif à l'écrivain J. R. R. Tolkien, à son œuvre et à son univers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c6c2cf0-d371-41cb-acad-ac10e08dd2f8",
                                "sense_id": "ca89a8a5-0d3b-3fab-87ab-74afc401c795",
                                "text": "Une tendance nouvelle se dessine dans la littérature de fantasy, qui est de substituer au Moyen Âge du modèle tolkiénien et de la plupart des ouvrages du genre, d'autres époques historiques, et aux mythologies et sagas sur lesquelles ils s'appuient, des genres romanesques d'une autre nature."
                            },
                            {
                                "example_id": "1860c5c9-b260-4f34-881d-8dacc714089d",
                                "sense_id": "ca89a8a5-0d3b-3fab-87ab-74afc401c795",
                                "text": "Les guerres sont omniprésentes dans l’univers tolkiénien, l’impossibilité d’éradiquer définitivement le mal du monde rendant inévitables ces conflits incessants."
                            }
                        ]
                    }
                ],
