                "senses": [
                    {
                        "sense_id": "e099e436-c341-3bde-9b54-d6b5a4e14c49",
                        "entry_id": "9dc330dc-d054-3ec2-b3e4-d7d4d78e7a84",
                        "glosses": [
                            "facial expression"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "18ce20a0-c74d-4d5b-b85f-f2c12fcf85b4",
                                "sense_id": "e099e436-c341-3bde-9b54-d6b5a4e14c49",
                                "text": "Der Maler hat seinen Gesichtsausdruck genau getroffen.",
                                "translation": "The painter captured his facial expression perfectly.",
                                "english": "The painter captured his facial expression perfectly."
                            },
                            {
                                "example_id": "cc487def-625f-4363-aa9c-2a09c5b99e80",
                                "sense_id": "e099e436-c341-3bde-9b54-d6b5a4e14c49",
                                "text": "Alle waren vernachlässigt angezogen, trotzdem die meisten nach dem Gesichtsausdruck, der Haltung, der Barttracht und vielen kaum sicherzustellenden kleinen Einzelheiten den höheren Klassen angehörten.",
                                "translation": "All were dressed neglectedly, even though most of them belonged to the upper classes according to facial expression, posture, man's beard and many small details that were hard to pinpoint.",
                                "english": "All were dressed neglectedly, even though most of them belonged to the upper classes according to facial expression, posture, man's beard and many small details that were hard to pinpoint."
                            }
                        ]
                    }
                ],
