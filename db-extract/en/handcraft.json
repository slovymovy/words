                        "glosses": [
                            "The class of subjects for study that rely upon experimentation and observation."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c2719903-7cfe-4fe0-abc9-44f78f3f099f",
                                "sense_id": "35b04737-c568-34ba-bee0-0f6d53bc6f6a",
                                "text": "These are, in redecraft, the English language and literature, mathematics, psychology; in handcraft, the physical sciences, physics, chemistry, biology; with regular and ample laboratory work in each."
                            },
                            {
                                "example_id": "aa59fcd1-9227-4c48-9f62-b090e7eb3de5",
                                "sense_id": "35b04737-c568-34ba-bee0-0f6d53bc6f6a",
                                "text": "Accordingly, that institution or school is best which enforces habits of order, attention, obedience, discrimination, memory ; which then secures skill in handcraft and redecraft, and likewise shows how these habits and this skill may be applied in useful avocations."
                            }
                        ]
                    }
