                                                "sense_id": "845b6d53-2dcf-33cc-b793-b1a85e4ae622",
                                                "text": "Une orthodromie est une portion de grand cercle."
                                            },
                                            {
                                                "example_id": "aeda1558-cba4-4b5e-b52f-9f415a7e14e4",
                                                "sense_id": "845b6d53-2dcf-33cc-b793-b1a85e4ae622",
                                                "text": "Seul un grand cercle peut être perpendiculaire à un autre grand cercle."
                                            }
