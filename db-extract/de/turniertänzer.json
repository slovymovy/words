                "senses": [
                    {
                        "sense_id": "8b898bda-744a-317c-8b98-198dbbd0e1aa",
                        "entry_id": "28f5cceb-205a-3658-b606-25d19f72ac06",
                        "glosses": [
                            "Tänzer, der an einem Turnier teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24461d06-2d45-416b-9edf-a4b885e3ae42",
                                "sense_id": "8b898bda-744a-317c-8b98-198dbbd0e1aa",
                                "text": "„Doch das war lange, nachdem ihr Mann Julius Kummer, ein Turniertänzer, 1947 die renommierte Tanzschule am Grazer Hilmteich im sogenannten Schweizerhaus eröffnet hatte.“"
                            },
                            {
                                "example_id": "272e06e9-f9aa-4178-b304-37d6e8c632ca",
                                "sense_id": "8b898bda-744a-317c-8b98-198dbbd0e1aa",
                                "text": "„Vermutlich ist für Gabriel politisch alles verloren. Der einstige Turniertänzer tänzelt am Abgrund, in den letzten Sonnenstrahlen.“"
                            },
                            {
                                "example_id": "0772164c-46be-4f8e-b901-a785a0a66028",
                                "sense_id": "8b898bda-744a-317c-8b98-198dbbd0e1aa",
                                "text": "„Als Turniertänzer schafften sie es bis in die zweithöchste deutsche Leistungsklasse und gewannen zahlreiche bayerische Meistertitel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
