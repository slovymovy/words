                        "entry_id": "485b4def-4188-3aa7-b7b7-e781e70c5ebb",
                        "glosses": [
                            "eine krankhafte Ansammlung von Wasser im Körper"
                        ],
                        "tags": [
                            "Pathologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d957af18-9536-40e6-8089-2ffe8e93d6fb",
                                "sense_id": "0f8d6988-cd73-3e5b-a0d4-1f85d5224fba",
                                "text": "Der Patient leidet an Wassersucht."
                            },
                            {
                                "example_id": "13fc1284-3d5c-4aff-8d88-46c2d00f9853",
                                "sense_id": "0f8d6988-cd73-3e5b-a0d4-1f85d5224fba",
                                "text": "Generalisierte Ödeme werden auch als Wassersucht bezeichnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5e9b28c-9faf-4ae2-8dca-da99b53624dd",
                        "source_entry_id": "485b4def-4188-3aa7-b7b7-e781e70c5ebb",
                        "source_sense_id": "0f8d6988-cd73-3e5b-a0d4-1f85d5224fba",
                        "source_sense_description": "Medizin, Pathologie: eine krankhafte Ansammlung von Wasser im Körper",
                        "target_lang_word": "dropsy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dropsy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb0da3d2-a3b9-3270-abc0-536bad2bb1bd",
                                        "entry_id": "4b16bbec-c235-39c7-a1f6-a96e9773900a",
                                        "glosses": [
                                            "Edema, swelling."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bdb8138-e4d1-4b9b-a4dd-d4168239039e",
                                                "sense_id": "bb0da3d2-a3b9-3270-abc0-536bad2bb1bd",
                                                "text": "Caliban: The dropſie drowne this foole,[…]"
                                            },
                                            {
                                                "example_id": "2bb154cc-8828-4cec-9f61-a30e94b199b7",
                                                "sense_id": "bb0da3d2-a3b9-3270-abc0-536bad2bb1bd",
                                                "text": "Your sacred Majesty, he has the dropsy;—\nWe shall find pints of hydatids in’s liver,\nHe has not half an inch of wholesome fat\nUpon his carious ribs—"
                                            },
                                            {
                                                "example_id": "a27e9c4d-7704-4cea-9d93-5c4a032887e5",
                                                "sense_id": "bb0da3d2-a3b9-3270-abc0-536bad2bb1bd",
                                                "text": "The disease under which Addison laboured appears to have been asthma. It became more violent after his retirement from office, and was now accompanied by dropsy."
                                            },
                                            {
                                                "example_id": "8439c937-2749-443c-80d1-0aa7e4996e8a",
                                                "sense_id": "bb0da3d2-a3b9-3270-abc0-536bad2bb1bd",
                                                "text": "Like someone moving back in space until the earth appears as a tiny mote of light, he managed to distance himself from the immediate discomfort of pipes with dropsy, defiant plumbing tools, and the overly familiar fiberglass, by musing aloud on the evolutionary history of humans that allowed the two of us to communicate verbally, creating a word picture of the problem and how to fix it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a0fcda8-f6b3-4241-83c5-05a813f4bf1d",
                        "source_entry_id": "485b4def-4188-3aa7-b7b7-e781e70c5ebb",
                        "source_sense_id": "0f8d6988-cd73-3e5b-a0d4-1f85d5224fba",
                        "source_sense_description": "Medizin, Pathologie: eine krankhafte Ansammlung von Wasser im Körper",
                        "target_lang_word": "hydropisie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydropisie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                        "entry_id": "57249e6e-9d0b-3b7a-84d7-bce4048b4739",
                                        "glosses": [
                                            "Accumulation de sérosité dans une cavité quelconque du corps ou dans le tissu cellulaire."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "122874d2-41fe-4224-9599-f644b5eabc64",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Hydropisie générale."
                                            },
                                            {
                                                "example_id": "c0359a84-7448-4f4f-a567-da023cb40877",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Hydropisie de poitrine."
                                            },
                                            {
                                                "example_id": "70da8422-6c6c-4bdf-b333-cf24f554fa9c",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Hydropisie de la tête, des yeux, etc."
                                            },
                                            {
                                                "example_id": "fe1efcbb-46a9-4cca-b574-badec343e503",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Monsieur Purgon. – De la dyssenterie dans l’hydropisie.\nArgan. – Monsieur Purgon !\nMonsieur Purgon. – Et de l’hydropisie dans la privation de la vie, où vous aura conduit votre folie."
                                            },
                                            {
                                                "example_id": "6e70f5ea-ee29-4d54-82b1-5af23dac8d49",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Je perdis mon père, qui succomba assez subitement à une hydropisie de poitrine."
                                            },
                                            {
                                                "example_id": "9e5be5e5-6f52-4d9e-9def-482e1ad70aca",
                                                "sense_id": "b089ad0d-90f7-35f9-b26b-111bab5f2c1b",
                                                "text": "Maigret, qui regarda machinalement les chevilles d’Anna Gorskine, constata que, comme sa mère le craignait, elle était atteinte d’hydropisie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "205fc48e-f53a-34bf-8e7e-d7fce6cb843d",
                                        "entry_id": "57249e6e-9d0b-3b7a-84d7-bce4048b4739",
                                        "glosses": [
                                            "Dans le langage ordinaire, enflure plus ou moins considérable du bas-ventre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52eec1f3-2998-4992-974b-df34c917f2d6",
                                                "sense_id": "205fc48e-f53a-34bf-8e7e-d7fce6cb843d",
                                                "text": "Dans l’hydropisie, on est toujours altéré."
                                            },
                                            {
                                                "example_id": "d156e0c7-0fe4-4a3a-b88c-6077bc6043b7",
                                                "sense_id": "205fc48e-f53a-34bf-8e7e-d7fce6cb843d",
                                                "text": "Mourir d’hydropisie."
                                            },
                                            {
                                                "example_id": "8bf687e1-cfe0-4400-bd16-1ba29a609750",
                                                "sense_id": "205fc48e-f53a-34bf-8e7e-d7fce6cb843d",
                                                "text": "On soulage l’hydropisie par la ponction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b730c5c0-2b3b-3997-8e3e-4f5bfc317e35",
                                        "entry_id": "57249e6e-9d0b-3b7a-84d7-bce4048b4739",
                                        "glosses": [
                                            "Maladie des poissons caractérisée par un décollement des écailles et un gonflement du corps consécutif à un empoisonnement ou à un virus ayant entraîné une nécrose des viscères de l'animal."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
