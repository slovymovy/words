                "translations": [
                    {
                        "translation_id": "0daa47fc-47e9-4abe-baf0-7585f1562e1a",
                        "source_entry_id": "debe424d-698f-3e99-8ca0-c6bcb02e9060",
                        "source_sense_id": "28a64adb-e4ee-30e3-9847-1ea57c226bf0",
                        "source_sense_description": "de winnaar van een kampioenschap",
                        "target_lang_word": "Meister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "edda5a2f-ac6a-31f6-a2a2-ea3415e83907",
                                        "entry_id": "35059542-feda-3786-90cb-1c9e538d54a1",
                                        "glosses": [
                                            "gewerblich-technische Meister seines Fachs, der seinerseits einen angehenden Gesellen oder Facharbeiter ausbilden darf"
                                        ],
                                        "tags": [
                                            "Berufe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e5431a-2294-43fb-905e-b4264df044ac",
                                                "sense_id": "edda5a2f-ac6a-31f6-a2a2-ea3415e83907",
                                                "text": "Man sieht die Hand des Meisters."
                                            },
                                            {
                                                "example_id": "d0341234-6ed5-43e9-b60e-57c5f6b34076",
                                                "sense_id": "edda5a2f-ac6a-31f6-a2a2-ea3415e83907",
                                                "text": "Er ist ein Meister seiner Zunft."
                                            },
                                            {
                                                "example_id": "6cd1e16f-1ff4-4697-b3a5-29e99803d8dc",
                                                "sense_id": "edda5a2f-ac6a-31f6-a2a2-ea3415e83907",
                                                "text": "„Der Meister und sein Lehrling verlegen Teppichboden.“"
                                            },
                                            {
                                                "example_id": "a17299b6-498c-4c4a-9b0c-db1e4d72c3f1",
                                                "sense_id": "edda5a2f-ac6a-31f6-a2a2-ea3415e83907",
                                                "text": "„Der Meister ging mühselig, etwas hinkend.“"
                                            },
                                            {
                                                "example_id": "a29e5c9b-702e-493a-8e86-1a86193e7724",
                                                "sense_id": "edda5a2f-ac6a-31f6-a2a2-ea3415e83907",
                                                "text": "Wer ist Lehrling? Jedermann. Wer ist Geselle? Der was kann. Wer ist Meister? Der was ersann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e7b1df7-8b6d-36df-9d53-804667cb1a8a",
                                        "entry_id": "35059542-feda-3786-90cb-1c9e538d54a1",
                                        "glosses": [
                                            "gewerblich-technische Meister seines Fachs, der seinerseits einen angehenden Gesellen oder Facharbeiter ausbilden darf",
                                            "solche Person männlichen Geschlechts"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "56dd2a5f-4164-3f64-8c42-d5e1ec5888b1",
                                        "entry_id": "35059542-feda-3786-90cb-1c9e538d54a1",
                                        "glosses": [
                                            "Bezeichnung und Anrede für eine Person mit besonderen Fähigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d99450b8-2aff-4e2e-b4cd-1d7b54ef08c3",
                                                "sense_id": "56dd2a5f-4164-3f64-8c42-d5e1ec5888b1",
                                                "text": "„In der Beschränkung zeigt sich erst der Meister.“ (Goethe, Sonett in „Was wir bringen“)"
                                            },
                                            {
                                                "example_id": "460b94b0-7c8c-460b-bb85-d8a6549cd7b7",
                                                "sense_id": "56dd2a5f-4164-3f64-8c42-d5e1ec5888b1",
                                                "text": "(ironisch) Ein bestimmter deutscher Bundeskanzler war ein wahrer Meister der Stilblüte."
                                            },
                                            {
                                                "example_id": "965c2e52-1e6c-4a3c-8dd8-cc87305f292e",
                                                "sense_id": "56dd2a5f-4164-3f64-8c42-d5e1ec5888b1",
                                                "text": "Wer ist Lehrling? Jedermann. Wer ist Geselle? Der was kann. Wer ist Meister? Der was ersann."
                                            },
                                            {
                                                "example_id": "36a69b85-ece7-4036-a977-d9c9f90eb3b8",
                                                "sense_id": "56dd2a5f-4164-3f64-8c42-d5e1ec5888b1",
                                                "text": "Das Chamäleon ist ein Meister der Tarnung."
                                            },
                                            {
                                                "example_id": "0872f528-b839-493b-8109-3f8d8eb6b4c1",
                                                "sense_id": "56dd2a5f-4164-3f64-8c42-d5e1ec5888b1",
                                                "text": "„Die alten Ägypter waren Meister in der Organisation der Arbeit.“"
                                            },
                                            {
                                                "example_id": "3094f536-2f49-4c4d-912d-749ba6fc0708",
                                                "sense_id": "56dd2a5f-4164-3f64-8c42-d5e1ec5888b1",
                                                "text": "„Niemand wird den großen Meistern der Wortkunst in Vergangenheit und Gegenwart die ihnen zukommende Bewunderung versagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0426f29-4d0a-3da4-8f35-a9e3a40139b0",
                                        "entry_id": "35059542-feda-3786-90cb-1c9e538d54a1",
                                        "glosses": [
                                            "Bezeichnung und Anrede für eine Person mit besonderen Fähigkeiten",
                                            "wenn diese Schüler ausbildet; ehrende Anrede eines Schülers derselben"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b0509e-01de-4922-a8c7-0ce7d791529e",
                                                "sense_id": "c0426f29-4d0a-3da4-8f35-a9e3a40139b0",
                                                "text": "Brecht war ein Adept von Meister Laotse."
                                            },
                                            {
                                                "example_id": "0836a20c-30d3-4254-a33a-7745c12272da",
                                                "sense_id": "c0426f29-4d0a-3da4-8f35-a9e3a40139b0",
                                                "text": "Tampopo fragte ehrerbietig: „Meister, fängt man beim Essen mit der Suppe an, oder fängt man besser mit den Nudeln an?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "623c47be-86f7-3617-a10b-f66662f70a7b",
                                        "entry_id": "35059542-feda-3786-90cb-1c9e538d54a1",
                                        "glosses": [
                                            "Gewinner einer Meisterschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8134493a-e83f-4450-8145-3b40cf008d14",
                                                "sense_id": "623c47be-86f7-3617-a10b-f66662f70a7b",
                                                "text": "Er ist amtierender Meister im Orientierungslauf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d3e60e5c-1594-369b-83ff-a3227bfdddaa",
                                        "entry_id": "35059542-feda-3786-90cb-1c9e538d54a1",
                                        "glosses": [
                                            "Herr über einen Untergebenen, Besitzer eines Leibeigenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd8d29a-cad7-4a7a-8550-bfc551a355b7",
                                                "sense_id": "d3e60e5c-1594-369b-83ff-a3227bfdddaa",
                                                "text": "Er ist mein Herr und Meister."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6a299a4e-c71f-3b31-8344-1aa5bd379962",
                                        "entry_id": "35059542-feda-3786-90cb-1c9e538d54a1",
                                        "glosses": [
                                            "Spielleiter beim Rollenspiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9820fb7-6bdb-4f3e-afed-18683adae2df",
                                                "sense_id": "6a299a4e-c71f-3b31-8344-1aa5bd379962",
                                                "text": "Tipps für Spielleiter: hilfreiche Hinweise für Meister, denn das Meisterhandwerk will erst erlernt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Meister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5127685-e357-300f-99d8-0b7e01c5af40",
                                        "entry_id": "f3ca30c6-d99a-3400-8f86-b7dcf16ac81a",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7b3d76-97b3-4d3e-b25f-1a7b13fd3595",
                                                "sense_id": "e5127685-e357-300f-99d8-0b7e01c5af40",
                                                "text": "Frau Meister ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "2f8a6bdc-a68c-47ad-92bc-3a389724a787",
                                                "sense_id": "e5127685-e357-300f-99d8-0b7e01c5af40",
                                                "text": "Herr Meister wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "a9b33996-f8a7-4a67-8ccd-ec0b2d56729f",
                                                "sense_id": "e5127685-e357-300f-99d8-0b7e01c5af40",
                                                "text": "Die Meisters fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "ceb81609-ac87-44dd-9e85-26dda2306248",
                                                "sense_id": "e5127685-e357-300f-99d8-0b7e01c5af40",
                                                "text": "Der Meister trägt nie die Schals, die die Meister ihm strickt."
                                            },
                                            {
                                                "example_id": "89a116af-4e3e-4e0d-b6a9-d7e115761d8d",
                                                "sense_id": "e5127685-e357-300f-99d8-0b7e01c5af40",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meister kommt, geht der Herr Meister.“"
                                            },
                                            {
                                                "example_id": "a9d4aeea-d454-45de-8055-6dff2f339418",
                                                "sense_id": "e5127685-e357-300f-99d8-0b7e01c5af40",
                                                "text": "Meister kommt und geht."
                                            },
                                            {
                                                "example_id": "885996c0-7e2a-4443-8e84-94fe2de91f45",
                                                "sense_id": "e5127685-e357-300f-99d8-0b7e01c5af40",
                                                "text": "Meisters kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ecc6de8-9063-4d1c-b4fe-33fdb9109da0",
                        "source_entry_id": "debe424d-698f-3e99-8ca0-c6bcb02e9060",
                        "source_sense_id": "28a64adb-e4ee-30e3-9847-1ea57c226bf0",
                        "source_sense_description": "de winnaar van een kampioenschap",
                        "target_lang_word": "champion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "champion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fe1a4aa-afb9-37a0-beb3-ff4c199c3173",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "An ongoing winner in a game or contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339cdd4d-9112-4630-9de5-d0416e0c8f0e",
                                                "sense_id": "6fe1a4aa-afb9-37a0-beb3-ff4c199c3173",
                                                "text": "The defending champion is expected to defeat his challenger."
                                            },
                                            {
                                                "example_id": "360557a7-6333-4790-8839-648d350cacc6",
                                                "sense_id": "6fe1a4aa-afb9-37a0-beb3-ff4c199c3173",
                                                "text": "Curry, a four-time NBA champion with the Warriors, played for the Wildcats for three seasons between 2006 and 2009, where he was twice named conference player of the year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd910e8d-c596-3dce-b78c-27b0c7df7e25",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "Someone who is chosen to represent a group of people in a contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14dc61a-e59d-4166-8faf-00a7e2b9e04c",
                                                "sense_id": "fd910e8d-c596-3dce-b78c-27b0c7df7e25",
                                                "text": "Barcelona is eligible to play in FIFA Club World Cup as the champion of Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1797cd37-0fb5-3ab9-9f23-400019dfc100",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "Someone who fights for a cause or status."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "023624be-c106-4bb8-b813-4cef7a0a26ef",
                                                "sense_id": "1797cd37-0fb5-3ab9-9f23-400019dfc100",
                                                "text": "Emmeline Pankhurst was a champion of women's suffrage."
                                            },
                                            {
                                                "example_id": "8e606f8d-e797-4c9d-976b-822115772ac9",
                                                "sense_id": "1797cd37-0fb5-3ab9-9f23-400019dfc100",
                                                "text": "Specific outcomes from this policy included the appointment of a Digital Champion to drive forward the efforts to get more of the excluded to be included."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92f53516-6734-3544-927d-41156db17647",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "Someone who fights on another's behalf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d3850d-0801-4e37-a70c-46cb03b113a3",
                                                "sense_id": "92f53516-6734-3544-927d-41156db17647",
                                                "text": "champion of the poor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                                        "entry_id": "55514f58-9159-3f3f-aaed-484c0e87f2f1",
                                        "glosses": [
                                            "A particularly notable member of a plant species, such as one of great size."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c8b876-e974-4005-9117-02fcf9035956",
                                                "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                                                "text": "Pictured above is an actual photograph of a Regal Lily that famed all over the world. It's a champion plant—because in one season it produced a total of 89 blooms from one bulb, an amazing record among lilies."
                                            },
                                            {
                                                "example_id": "60b78624-4f1e-4d2b-a1df-f74624bf95ad",
                                                "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                                                "text": "There was a news clipping there with a photo of a magnificent American elm, which had just been named the champion for its species, the largest of its kind."
                                            },
                                            {
                                                "example_id": "606346c1-788c-46f4-8e0f-d1934bee6f9c",
                                                "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                                                "text": "He [Matthew Olson] was searching for red maple trees to be tapped for syrup as part of the Stockton Maple Project when he came across the new champion tree."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "champion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a00f6d5-e145-3b74-89d5-bc45b01d9b48",
                                        "entry_id": "ca17cf93-65cd-33c2-912b-9714a1a06e7a",
                                        "glosses": [
                                            "Acting as a champion; having defeated all one's competitors."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fc0502f-607b-4f91-bf96-0ed4764c06ee",
                                                "sense_id": "0a00f6d5-e145-3b74-89d5-bc45b01d9b48",
                                                "text": "a champion bodybuilder"
                                            }
                                        ]
                                    },
