                        "examples": [
                            {
                                "example_id": "cac18fa7-c893-462e-8da7-8ef18cf2cacc",
                                "sense_id": "24137fc3-85d0-3d0c-8016-b3889fb65fc7",
                                "text": "„Nach dem Rassismus-Eklat um das Partyvideo auf Sylt werden immer mehr Fälle publik – so sollen auch auf dem Hamburger Schlagermove Feiernde rassistische Parolen gesungen haben.“"
                            },
                            {
                                "example_id": "76260f7a-8cac-4dd2-8e6f-448ca7453e84",
                                "sense_id": "24137fc3-85d0-3d0c-8016-b3889fb65fc7",
                                "text": "„Ein Partyvideo, sogar wenn dort erheblicher Alkoholkonsum zu sehen sei, darf daher keine arbeitsrechtlichen Konsequenzen haben, erklärt Anwalt Fuhlrott.“"
                            },
                            {
                                "example_id": "25cd1b5d-dfed-42ea-95d6-1dbb296f3473",
                                "sense_id": "24137fc3-85d0-3d0c-8016-b3889fb65fc7",
                                "text": "„Nacktbilder, Gerüchte, peinliche Partyvideos: Zunehmend nutzen Jugendliche das Internet, um anderen das Leben zur Hölle zu machen.“"
                            },
                            {
                                "example_id": "ff082f74-3fcf-4f25-85c6-5b656441dd7e",
                                "sense_id": "24137fc3-85d0-3d0c-8016-b3889fb65fc7",
                                "text": "„Nach dem Auftauchen eines privaten Partyvideos steht Finnlands sozialdemokratische Regierungschefin Sanna Marin (36) in ihrer Heimat in der Kritik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
