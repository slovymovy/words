                "senses": [
                    {
                        "sense_id": "a08b3216-5b03-3b69-a570-482e44459864",
                        "entry_id": "9d1ebd11-8093-3ffe-84ca-6322de0d171b",
                        "glosses": [
                            "in twee stappen een volledige verandering doormakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7a7d39-4de4-4dad-a473-00f3ff85d739",
                                "sense_id": "a08b3216-5b03-3b69-a570-482e44459864",
                                "text": "Het tweetallige stelsel omvat slechts twee elementen: 0 en 1."
                            },
                            {
                                "example_id": "a9311240-f7f9-4056-b6d8-1d1aaa83c65e",
                                "sense_id": "a08b3216-5b03-3b69-a570-482e44459864",
                                "text": "Een tweetallige as draait een voorwerp over 180°, zodat het na twee operaties terugkeert op zijn oude positie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00b2a911-6361-4481-94d3-10006a48dc72",
                        "source_entry_id": "9d1ebd11-8093-3ffe-84ca-6322de0d171b",
                        "source_sense_id": "a08b3216-5b03-3b69-a570-482e44459864",
                        "source_sense_description": "in twee stappen een volledige verandering doormakend",
                        "target_lang_word": "binary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "binary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4400fedf-eae9-3e25-85bf-bddd0ec01620",
                                        "entry_id": "b972f35e-6360-3ea2-87fe-31dc26ffb949",
                                        "glosses": [
                                            "Being in one of two mutually exclusive states."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d33a93f-5852-421e-a8a9-87759e94c9a3",
                                                "sense_id": "4400fedf-eae9-3e25-85bf-bddd0ec01620",
                                                "text": "Binary states are often represented as 1 and 0 in computer science."
                                            },
                                            {
                                                "example_id": "83bc95e8-7910-4562-a0ed-69548e6d1926",
                                                "sense_id": "4400fedf-eae9-3e25-85bf-bddd0ec01620",
                                                "text": "Of all the transitions brought about on the Earth’s surface by temperature change, the melting of ice into water is the starkest. It is binary. And for the land beneath, the air above and the life around, it changes everything."
                                            },
                                            {
                                                "example_id": "7f7e69ac-6354-47f6-be35-419210d5bd18",
                                                "sense_id": "4400fedf-eae9-3e25-85bf-bddd0ec01620",
                                                "text": "It's not binary. You can be decent and gifted at the same time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "878c5022-b419-3263-bf55-678262479532",
                                        "entry_id": "b972f35e-6360-3ea2-87fe-31dc26ffb949",
                                        "glosses": [
                                            "Concerning logic whose subject matter concerns such states."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60672e08-3e19-4536-90b4-0cdecc23ff70",
                                                "sense_id": "878c5022-b419-3263-bf55-678262479532",
                                                "text": "Near-synonym: Boolean"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5475a856-61e4-3c05-9c3f-514817de598b",
                                        "entry_id": "b972f35e-6360-3ea2-87fe-31dc26ffb949",
                                        "glosses": [
                                            "Concerning numbers and calculations using the binary number system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "654494cf-2e02-3f5c-b85a-19a35673d676",
                                        "entry_id": "b972f35e-6360-3ea2-87fe-31dc26ffb949",
                                        "glosses": [
                                            "Having two equally important parts; related to something with two parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e02e6f3-e348-4289-9402-9e7990ff7f3b",
                                                "sense_id": "654494cf-2e02-3f5c-b85a-19a35673d676",
                                                "text": "binary star"
                                            },
                                            {
                                                "example_id": "588a9d0f-53ea-4969-9e6f-193cc55e2271",
                                                "sense_id": "654494cf-2e02-3f5c-b85a-19a35673d676",
                                                "text": "Two ingredients are combined in a binary poison."
                                            },
                                            {
                                                "example_id": "8346b4c4-18a8-4300-a40b-919ac236fbd6",
                                                "sense_id": "654494cf-2e02-3f5c-b85a-19a35673d676",
                                                "text": "A binary statistical distribution has only two categories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "687736c1-4b90-3bd7-a03b-1f6ee6d3d079",
                                        "entry_id": "b972f35e-6360-3ea2-87fe-31dc26ffb949",
                                        "glosses": [
                                            "Of an operation, function, procedure, or logic gate, taking exactly two operands, arguments, parameters, or inputs; having domain of dimension 2."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f6d6d20-75bd-4bbf-91c5-d8ae4e60f05c",
                                                "sense_id": "687736c1-4b90-3bd7-a03b-1f6ee6d3d079",
                                                "text": "Division of reals is a binary operation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5f044b7-8b28-3637-8e8a-90b8668b3c10",
                                        "entry_id": "b972f35e-6360-3ea2-87fe-31dc26ffb949",
                                        "glosses": [
                                            "Of data, consisting coded values (e.g. machine code) not interpretable as plain or ASCII text (e.g. source code)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf26a9f-0c7a-49d5-b606-e00c2d82f98c",
                                                "sense_id": "b5f044b7-8b28-3637-8e8a-90b8668b3c10",
                                                "text": "He downloaded the binary distribution for Linux, then burned it to DVD."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42fe7867-94cb-3056-9ffb-34ae7d7d0fb1",
                                        "entry_id": "b972f35e-6360-3ea2-87fe-31dc26ffb949",
                                        "glosses": [
                                            "Focusing on two mutually exclusive conditions."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a5b59d6-558b-4c49-a099-e26d3748ee80",
                                                "sense_id": "42fe7867-94cb-3056-9ffb-34ae7d7d0fb1",
                                                "text": "He has a very binary understanding of gender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6caf2760-8f93-3e54-b236-c1d8333e5ae1",
                                        "entry_id": "b972f35e-6360-3ea2-87fe-31dc26ffb949",
                                        "glosses": [
                                            "Having or pertaining to a gender identity represented by the gender binary; either male or female."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39139b60-0618-42cd-b062-759a4288ec08",
                                                "sense_id": "6caf2760-8f93-3e54-b236-c1d8333e5ae1",
                                                "text": "To further unpack trans and gender-diverse embodiment, requires one to unpack the depth of the discourse as it relates to both binary and non-binary people (Hofman, 2012). It necessitates deeper engagement as to the politics of passing, not passing, societal assimilation and non-assimilation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "binary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359daf83-95a5-3979-b6c0-c29c74f30c13",
                                        "entry_id": "f26a0d7d-950e-3cac-8de1-214e48c874e0",
                                        "glosses": [
                                            "A state in which only two values are possible, in which something must have one value or the other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1872707b-cf2a-408c-b37c-198638af19ef",
                                                "sense_id": "359daf83-95a5-3979-b6c0-c29c74f30c13",
                                                "text": "The correlation between warmth and cold is an internal one where the existence of one depends on and is defined by the other. Hence, the yin-yang binary as a correlative binary of light-shade or warmth-cold [...]"
                                            },
                                            {
                                                "example_id": "3a012ed2-f992-42eb-b0d5-a8967927b01d",
                                                "sense_id": "359daf83-95a5-3979-b6c0-c29c74f30c13",
                                                "text": "The “in” versus “out” of this sociological model certainly carries to the admittedly simplistic binary of “good” versus “bad” of stereotypes in fictional works and the scholarly approaches to them."
                                            },
                                            {
                                                "example_id": "8b3c3d5e-b010-441c-92f9-69beca38a685",
                                                "sense_id": "359daf83-95a5-3979-b6c0-c29c74f30c13",
                                                "text": "As an “all-female” humanoid species not bound to the traditional forms of mating, in that they reproduce through a form of telepathic parthenogenesis, the design of the Asari collapses boundaries of sex and sexuality. The Asari are a species rendered as Other, even in comparison to the various beings populating the gameworld. Characters recognize and struggle against prejudice and limited understanding of Asari customs, culture, and practices. These gameworld features allow for a space where awareness and exploration of sexualities outside of the heterosexual binary can take place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00f07487-c9fb-3a77-a544-5e71afc7f730",
                                        "entry_id": "f26a0d7d-950e-3cac-8de1-214e48c874e0",
                                        "glosses": [
                                            "The bijective base-2 numeral system, which uses only the digits 0 and 1."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47311b19-7974-463f-97ed-2f88fcf83e9f",
                                                "sense_id": "00f07487-c9fb-3a77-a544-5e71afc7f730",
                                                "text": "As our initial exposure to the base 10 number system consisted of learning how to count, it also makes sense that we might begin by learning how to count in binary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4547970b-ed40-3a65-ab11-f0cf250904b3",
                                        "entry_id": "f26a0d7d-950e-3cac-8de1-214e48c874e0",
                                        "glosses": [
                                            "Synonym of binary file."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9e93e96-f164-4095-ad2a-1f478f28e63c",
                                                "sense_id": "4547970b-ed40-3a65-ab11-f0cf250904b3",
                                                "text": "Now that you have a high-level idea of what binaries look like and how they work, you're ready to dive into a real binary format."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9f0d9ad-dc1f-3116-bc15-309961d5d5b4",
                                        "entry_id": "f26a0d7d-950e-3cac-8de1-214e48c874e0",
                                        "glosses": [
                                            "Synonym of binary asteroid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bddf45c-3460-3ce5-a6c9-5256cfeaaa98",
                                        "entry_id": "f26a0d7d-950e-3cac-8de1-214e48c874e0",
                                        "glosses": [
                                            "Synonym of binary planet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04cabaea-1dc9-3b84-a890-5b0e2bc2d7ae",
                                        "entry_id": "f26a0d7d-950e-3cac-8de1-214e48c874e0",
                                        "glosses": [
                                            "Synonym of binary star."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54476503-44cd-4f6e-bd46-6e7d3f7a51cb",
                                                "sense_id": "04cabaea-1dc9-3b84-a890-5b0e2bc2d7ae",
                                                "text": "As discussed in Section 5.1, the study of the properties of planets in binaries and the search for differences between the characteristics of these objects and those of planets orbiting single stars, is crucial to the understanding of the role of binarity in planet formation and evolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78161e4d-1a6d-37c7-8bd8-bf55b67d0e84",
                                        "entry_id": "f26a0d7d-950e-3cac-8de1-214e48c874e0",
                                        "glosses": [
                                            "Synonym of binary option."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3b6772f-b9a5-4ed7-955d-8a4eb209b118",
                        "source_entry_id": "9d1ebd11-8093-3ffe-84ca-6322de0d171b",
