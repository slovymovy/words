                "senses": [
                    {
                        "sense_id": "5776d4ac-8760-34fc-8ec4-af727ea11305",
                        "entry_id": "cb9064c5-8fd8-393f-a47b-00f723d54f2b",
                        "glosses": [
                            "швейн. неизмен. прил. фасон пальто / платья, скроенного так, что рукава составляют с плечом одно целое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c18523e-f3a3-4d30-b37e-6bc3a28b1248",
                                "sense_id": "5776d4ac-8760-34fc-8ec4-af727ea11305",
                                "text": "Пальто реглан."
                            },
                            {
                                "example_id": "5d492774-ad55-4aa3-a5ad-7f6a0a0d55e4",
                                "sense_id": "5776d4ac-8760-34fc-8ec4-af727ea11305",
                                "text": "Платье реглан."
                            },
                            {
                                "example_id": "fc683e8a-bfba-4a68-92cd-ac5b2a6c1b64",
                                "sense_id": "5776d4ac-8760-34fc-8ec4-af727ea11305",
                                "text": "Он был не в шинели, а в сером демисезонном пальто-реглан."
                            }
                        ]
                    },
                    {
                        "sense_id": "e78e71f4-914d-3529-8781-711814546e58",
                        "entry_id": "cb9064c5-8fd8-393f-a47b-00f723d54f2b",
                        "glosses": [
                            "пальто, плащ, куртка такого покроя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e55d85f-a488-4e59-bd2a-ba7037d3be2d",
                                "sense_id": "e78e71f4-914d-3529-8781-711814546e58",
                                "text": "Я был одет в летний кожаный реглан."
                            },
                            {
                                "example_id": "1f7d5e70-989d-44f6-be32-0f67309b9656",
                                "sense_id": "e78e71f4-914d-3529-8781-711814546e58",
                                "text": "На нём был коричневый, великолепной кожи реглан, за плечами — рюкзак, на боку — «вальтер»."
                            }
                        ]
                    }
