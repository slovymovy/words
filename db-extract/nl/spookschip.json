                "senses": [
                    {
                        "sense_id": "2f79b6cf-1d4b-3386-a43c-6bbe5fe08f79",
                        "entry_id": "68cc019f-84b2-3bff-9b4f-fc864f2d43f9",
                        "glosses": [
                            "een legendarisch schip dat zonder bemanning eeuwig blijft rondvaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fdab52a-c8f9-4dec-8791-cbbf6fe6df08",
                                "sense_id": "2f79b6cf-1d4b-3386-a43c-6bbe5fe08f79",
                                "text": "De Vliegende Hollander is een spookschip dat in de buurt van Kaap de Goede Hoop rond zou varen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffc62373-3c64-38b4-8e99-a621dee70831",
                        "entry_id": "68cc019f-84b2-3bff-9b4f-fc864f2d43f9",
                        "glosses": [
                            "een daadwerkelijk schip dat is losgeslagen en zonder bemanning ronddrijft over zee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d8f5950-8471-46e2-857e-49448e316b5b",
                                "sense_id": "ffc62373-3c64-38b4-8e99-a621dee70831",
                                "text": "Op 6 april 2012 bracht de Amerikaanse kustwacht een Japans spookschip tot zinken dat tijdens de aardbeving van het jaar daarvoor uit een haven in het noorden van Japan losgeslagen was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "334f1f65-75d6-44ae-b5cb-a4b398f3740c",
                        "source_entry_id": "68cc019f-84b2-3bff-9b4f-fc864f2d43f9",
                        "source_sense_id": "2f79b6cf-1d4b-3386-a43c-6bbe5fe08f79",
                        "source_sense_description": "een legendarisch schip dat zonder bemanning eeuwig blijft rondvaren",
                        "target_lang_word": "Geisterschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geisterschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68177b16-0130-32c2-8665-2deeecc3002b",
                                        "entry_id": "2de09316-9df0-3fcc-9641-e2240e744346",
                                        "glosses": [
                                            "führungslos auf See treibendes Schiff, das von der Besatzung verlassen wurde oder dessen Besatzung tot ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f90dcc72-ef85-4f7b-acfa-ca131bf2ad3f",
                                                "sense_id": "68177b16-0130-32c2-8665-2deeecc3002b",
                                                "text": "Die Oper „Der fliegende Holländer“ von Wagner hat ein Geisterschiff zum Gegenstand."
                                            },
                                            {
                                                "example_id": "86469b0b-8e2c-4082-b56d-c047bb90a6e2",
                                                "sense_id": "68177b16-0130-32c2-8665-2deeecc3002b",
                                                "text": "„Da kamen sie Seeleuten dann als Geisterschiffe entgegen, die völlig in Ordnung waren, ihre Segel gesetzt hatten und auf denen sich trotzdem keine Menschenseele an Bord fand.“"
                                            },
                                            {
                                                "example_id": "e1a3ffa6-a682-4fa3-8cc4-a6634ad081a3",
                                                "sense_id": "68177b16-0130-32c2-8665-2deeecc3002b",
                                                "text": "„Das ist ein Geisterschiff.“"
                                            },
                                            {
                                                "example_id": "595ef80d-24d0-4e78-99c7-2350ea816c35",
                                                "sense_id": "68177b16-0130-32c2-8665-2deeecc3002b",
                                                "text": "Auch ein gesunken geglaubtes Schiff, das unter mysteriösen Umständen wieder mit neuer Besatzung auftaucht, könnte man Geisterschiff nennen, hat es doch seine ursprüngliche Besatzung und Führung verloren. Solch ein Geisterschiff ist vielleicht das Resultat moderner Piraterie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65998f7b-0afa-47da-961e-0d528f03bc92",
                        "source_entry_id": "68cc019f-84b2-3bff-9b4f-fc864f2d43f9",
                        "source_sense_id": "2f79b6cf-1d4b-3386-a43c-6bbe5fe08f79",
                        "source_sense_description": "een legendarisch schip dat zonder bemanning eeuwig blijft rondvaren",
                        "target_lang_word": "ghost ship",
