                    {
                        "sense_id": "a982c8ad-3374-31a9-81df-21261e1b8dc4",
                        "entry_id": "3346fb01-30ec-3edb-a66f-887ee756e2d5",
                        "glosses": [
                            "Ragout de bœuf au paprika, d’origine hongroise. La forme masculine du mot est plus usuelle (cf. dictionnaire de l’Académie Française, 9ème édition)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f72fc17-cc6c-438f-b6ad-51f5f52eb464",
                                "sense_id": "a982c8ad-3374-31a9-81df-21261e1b8dc4",
                                "text": "Certains mets n’ont rien d’insolite : le goulash hongrois, ragoût de bœuf aux oignons hachés et au paprika; la mamaliga roumaine, bouillie de farine de maïs; le sarma serbe, feuille de chou aigre garnie de farce; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "b100b5e0-f666-3d98-9ebb-eec8c20e786c",
                        "entry_id": "3346fb01-30ec-3edb-a66f-887ee756e2d5",
                        "glosses": [
                            "Variante du jeu de bridge."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bdd8aec-d655-4619-b47d-08eebceac26b",
                        "source_entry_id": "3346fb01-30ec-3edb-a66f-887ee756e2d5",
                        "source_sense_description": "plat de bœuf au paprika",
                        "target_lang_word": "Gulasch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gulasch",
