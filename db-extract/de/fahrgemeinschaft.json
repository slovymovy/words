                                        "examples": [
                                            {
                                                "example_id": "5ce69d9f-c878-4d79-9be1-3fa8149257d9",
                                                "sense_id": "c059d090-f097-30a0-9a29-6ca91ac3c6c5",
                                                "text": "The neighbors decided on a carpool to get their kids to school, so that they wouldn't each have to drive every day."
                                            }
