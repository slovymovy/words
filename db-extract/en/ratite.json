                        "entry_id": "52075058-fa47-3ae9-8b1e-373c92fd0664",
                        "glosses": [
                            "Pertaining to running, flightless birds with no keels on their sternums (as opposed to carinate)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e4536bbe-a11f-49a7-a323-bd82275bba7d",
                                "sense_id": "f64e4bab-8903-3758-8e78-a6341e2c24ac",
                                "text": "Against what was probably the general expectation, it became undeniable that New Zealand was indeed the home of huge ratite birds."
                            }
                        ]
                    }
                ],
