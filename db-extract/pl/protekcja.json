                "senses": [
                    {
                        "sense_id": "fff07d57-0c2e-3fba-ab1a-0e58e9b1b429",
                        "entry_id": "1bea0a3a-0960-3573-a0e2-ff49db97435c",
                        "glosses": [
                            "ochrona i pomoc płynąca od wpływowej osoby"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "992d44e9-f096-4a79-be78-2091ff81a5b8",
                        "source_entry_id": "1bea0a3a-0960-3573-a0e2-ff49db97435c",
                        "source_sense_id": "fff07d57-0c2e-3fba-ab1a-0e58e9b1b429",
                        "target_lang_word": "Protektion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Protektion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcc8213f-116b-32cf-bb1e-085c225bebe3",
                                        "entry_id": "538cef9d-43d8-30d6-9fcd-4a2a6a37dfaf",
                                        "glosses": [
                                            "Handlungsweise, um jemandem Vorteile zu verschaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e1162b9-6fb9-424e-b64e-132912169f9e",
                                                "sense_id": "fcc8213f-116b-32cf-bb1e-085c225bebe3",
                                                "text": "„Weil sie von der Landwirtschaft waren und weil sie noch dazu vermutlich irgendeine Protektion bei der Raumwirtschaft hatten, bekamen sie das Zimmer zugewiesen, und die anderen mussten innerhalb von vierundzwanzig Stunden ausziehen.“"
                                            },
                                            {
                                                "example_id": "456bd30c-761a-44e6-824b-55c3fc60e0a6",
                                                "sense_id": "fcc8213f-116b-32cf-bb1e-085c225bebe3",
                                                "text": "„Von nun an sollte Csoma für den Rest seines Lebens von der Protektion britischer Beamter abhängig sein, die in Asien die führende europäische Macht repräsentierten.“"
                                            },
                                            {
                                                "example_id": "5b54ea21-78db-4bdd-a0be-3c63e8a8f880",
                                                "sense_id": "fcc8213f-116b-32cf-bb1e-085c225bebe3",
                                                "text": "„In Petersburg hatte Hélène sich der besonderen Protektion eines der höchstgestellten Würdenträger des Staates zu erfreuen gehabt.“"
                                            },
                                            {
                                                "example_id": "2c42051e-75ee-44f4-babf-f9189a604e42",
                                                "sense_id": "fcc8213f-116b-32cf-bb1e-085c225bebe3",
                                                "text": "„Drei Tage später hielt eine Dame, die in Turin großen Einfluß besaß, gewissermaßen alle Theaterintrigen überwachte und von allen Künstlerinnen um Protektion gebeten wurde, es für richtig, mich zu sich zu entbieten, und schickte mir ihre Aufforderung durch einen Diener in Livree.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
