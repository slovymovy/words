                    "frequency": "Middle",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unauthorized <w>outing</w> of the politician caused a massive media scandal and ethical debate.",
                            "target_lang_translations": {
