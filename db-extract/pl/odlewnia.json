                "senses": [
                    {
                        "sense_id": "819bf4a7-fee3-3975-be31-e0f852a21d63",
                        "entry_id": "ffe982e3-bca7-3db0-ac57-156faefb3c61",
                        "glosses": [
                            "zakład przemysłowy lub jego dział, w którym wytwarzane są odlewy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eaf9b45-ff28-4c64-aa23-bef4c40ba718",
                                "sense_id": "819bf4a7-fee3-3975-be31-e0f852a21d63",
                                "text": "Pracownicy zakładów sąsiadujących z odlewnią żeliwa Spomel skarżą się na uciążliwości związane z wydobywającym się z komina zakładu dymem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77a75b46-043e-4947-87ac-bcbd88611e2b",
                        "source_entry_id": "ffe982e3-bca7-3db0-ac57-156faefb3c61",
                        "source_sense_id": "819bf4a7-fee3-3975-be31-e0f852a21d63",
                        "target_lang_word": "foundry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foundry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "215f6063-762e-37fb-b087-9202780bf09f",
                                        "entry_id": "3d38b35f-4fe2-341c-b2bc-b110318aadd5",
                                        "glosses": [
                                            "A facility that melts metals in special furnaces and pours the molten metal into molds to make products. Foundries are usually specified according to the type of metal dealt with: iron foundry, brass foundry, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ade818ea-2eb1-484d-91fc-ed6c20a26384",
                                                "sense_id": "215f6063-762e-37fb-b087-9202780bf09f",
                                                "text": "So after learning a great deal about iron founding and much more about pike fishing, one regretfully took leave of a shop full of kindly characters and proceeded to a worse lot of odours in the brass foundry. […] So after a short spell in the brass foundry the wisest course was to follow with a similar period in the steel foundry, where much important work was done, including the manufacture of centres for wheels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f4f9095-3bf4-346b-9c78-41028a2256b2",
                                        "entry_id": "3d38b35f-4fe2-341c-b2bc-b110318aadd5",
                                        "glosses": [
                                            "The act, process, or art of casting metals; founding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d67926a-da2c-34d8-b6fc-53f14148bcdc",
                                        "entry_id": "3d38b35f-4fe2-341c-b2bc-b110318aadd5",
                                        "glosses": [
                                            "A plant that produces chips out of semiconductors in the microelectronics industry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c061b5f-0ec2-411d-be6c-6eb0758cccad",
                                                "sense_id": "6d67926a-da2c-34d8-b6fc-53f14148bcdc",
                                                "text": "Chang gained trust by allaying fears that TSMC would steal designs, as pure-play foundries have no use of them; TSMC stealing from chip designers would be like a printing press stealing plots from novelists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffc6ee69-50e2-4aa4-9c31-6d48c965ab0a",
                        "source_entry_id": "ffe982e3-bca7-3db0-ac57-156faefb3c61",
                        "source_sense_id": "819bf4a7-fee3-3975-be31-e0f852a21d63",
