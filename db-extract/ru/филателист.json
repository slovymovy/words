                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f71e50dc-4038-4c80-8172-467fc9c7119d",
                        "source_entry_id": "4ee07a9b-5d96-3872-b4f8-72a35acb4be3",
                        "source_sense_id": "663d86ff-1db5-364c-a1fb-41f898a81d72",
                        "target_lang_word": "Philatelist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philatelist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2af9c395-25a1-366d-8922-c8aa6ecbf94c",
                                        "entry_id": "a9c4c47a-1951-3437-acbc-0017f5fa14fb",
                                        "glosses": [
                                            "Person, die sich beruflich oder als Hobby mit Briefmarken befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8f52dd-6354-4128-89c0-7c3b6c15560b",
                                                "sense_id": "2af9c395-25a1-366d-8922-c8aa6ecbf94c",
                                                "text": "Viele Philatelisten treffen sich regelmäßig an bestimmten Tauschtagen."
                                            },
                                            {
                                                "example_id": "7dbd7e7c-8685-4d5a-9450-d0f1d0e8db4b",
                                                "sense_id": "2af9c395-25a1-366d-8922-c8aa6ecbf94c",
                                                "text": "„Als Philatelist ist dieser nicht bekannt.“"
                                            },
                                            {
                                                "example_id": "ce97dd55-c247-4862-b5af-489f21e4ac87",
                                                "sense_id": "2af9c395-25a1-366d-8922-c8aa6ecbf94c",
                                                "text": "„Der renommierte Philatelist und Autor unzähliger Werke über die Philatelie, Fred Melville, hat einmal errechnet, dass Philipp von Ferrari bis zum Beginn des Ersten Weltkrieges pro Jahr durchschnittlich 10 000 Pfund für seine Briefmarkensammlung ausgegeben habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f08a1cd9-d477-427f-beaa-074b5893e6dd",
                        "source_entry_id": "4ee07a9b-5d96-3872-b4f8-72a35acb4be3",
                        "source_sense_id": "663d86ff-1db5-364c-a1fb-41f898a81d72",
                        "target_lang_word": "Briefmarkensammler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Briefmarkensammler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4358e8ef-3baa-3e34-a855-e1b79c12d8bb",
                                        "entry_id": "d6d197be-ef64-3643-b542-f90436dfa800",
                                        "glosses": [
                                            "Person, die Briefmarken sammelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ecde33-e1b3-4caa-80d7-f8b8b40fbb11",
                                                "sense_id": "4358e8ef-3baa-3e34-a855-e1b79c12d8bb",
                                                "text": "Briefmarkensammler sammeln Briefmarken und betrachten dies meist als Hobby; bisweilen haben sie aber auch kommerzielle Gründe dafür."
                                            },
                                            {
                                                "example_id": "dc7b51ae-b226-42f2-bcda-52a8ec49be18",
                                                "sense_id": "4358e8ef-3baa-3e34-a855-e1b79c12d8bb",
                                                "text": "„Links von mir saß in einem Bauwagen, der meiner Station äußerlich ähnelte, Arnas Grizkavichus, ein Lette, Briefmarkensammler und leidenschaftlicher Schachspieler.“"
                                            },
                                            {
                                                "example_id": "16a43092-8a6d-4de7-9153-04e874ae7a8d",
                                                "sense_id": "4358e8ef-3baa-3e34-a855-e1b79c12d8bb",
                                                "text": "„Briefe- und Briefmarkensammler sind Papier- und Altpapiersammler.“"
                                            },
                                            {
                                                "example_id": "ddae02c6-d4c1-4b59-9368-ced067942ef3",
                                                "sense_id": "4358e8ef-3baa-3e34-a855-e1b79c12d8bb",
                                                "text": "„Dabei sollte sich jeder Briefmarkensammler bewusst sein, dass Staaten mit ihren Briefmarken auch ihre Identität bekannt machen wollen - jedenfalls in den meisten Fällen.“"
                                            },
                                            {
                                                "example_id": "d8505411-7bef-45e3-bb75-a5fb5d03a057",
                                                "sense_id": "4358e8ef-3baa-3e34-a855-e1b79c12d8bb",
                                                "text": "„In den späten Achtziger- und frühen Neunzigerjahren des 19. Jahrhunderts beschlich wohl manchen Briefmarkensammler das Gefühl, in einer philatelistischen Sackgasse zu stecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2f8e9d3-bc5e-45cc-bc0b-25ef3fc50885",
                        "source_entry_id": "4ee07a9b-5d96-3872-b4f8-72a35acb4be3",
                        "source_sense_id": "663d86ff-1db5-364c-a1fb-41f898a81d72",
                        "target_lang_word": "filatelist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filatelist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d5084d98-236d-3dd3-ba1d-62653ac9df89",
                                        "entry_id": "874b61cf-5297-3c86-8e3b-c17d8185d76b",
                                        "glosses": [
                                            "iemand die postzegels verzamelt als liefhebberij"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1db878d-9813-4f56-9ee5-4869a56bc5ba",
                                                "sense_id": "d5084d98-236d-3dd3-ba1d-62653ac9df89",
                                                "text": "Het aantal verzamelaars neemt wel af. De Koninklijke Nederlandse Bond van Filatelistenverenigingen heeft nog 17.000 leden; begin jaren 80 waren het er 200.000. Clubs fuseren, bonden ook. De vergrijzing lijkt niet te keren. Fotograaf Jan Dirk van der Burg maakte een reportage over de krimpende wereld van de filatelie. Wij zochten twee verzamelaars op om te praten over hun passie."
                                            },
                                            {
                                                "example_id": "a0c010c7-7ffb-43e9-ad9b-2c963693dc64",
                                                "sense_id": "d5084d98-236d-3dd3-ba1d-62653ac9df89",
                                                "text": "‘De gedachte kwam op’, schrijft Van Toor, ‘om deze postzegels een plaats te geven in een verhaal over de geschiedenis van de scheikunde door de eeuwen heen.’ En zo is het gekomen: een boek dat Geschiedenis van de scheikunde heet.Is het een fijn boek voor de geïnteresseerde leek? Dr.ir. Leendert Maat, universitair hoofddocent organische chemie aan de TU Delft, filatelist én vriend van de auteur, sluit dat niet uit, blijkens zijn aanbeveling in een ‘Ten geleide’: ‘De niet-chemicus kan de tekst met postzegels gewoon volgen waarbij hij de overigens prachtige professionele formules voor lief neemt, of misschien ziet hij er toch iets meer in dan alleen maar de plaatjes, een kwestie van ‘education permanente’.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
