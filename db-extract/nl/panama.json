                ],
                "translations": [
                    {
                        "translation_id": "51346c8d-b3c7-49e7-9e24-de3d381fc677",
                        "source_entry_id": "5b2892e9-cb07-3487-aa65-762a1a740bfd",
                        "source_sense_id": "4992613e-cc7e-35ff-956b-708a04676b07",
                        "target_lang_word": "Panamahut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Panamahut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10991863-d703-3644-91cd-31536a00f161",
                                        "entry_id": "d46ff975-203f-371e-a5bf-7c185ee0bd0b",
                                        "glosses": [
                                            "handgeflochtener Strohhut aus Lateinamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fd2bc7a-ca69-4cc0-8f14-bbb052a5c9bf",
                                                "sense_id": "10991863-d703-3644-91cd-31536a00f161",
                                                "text": "„Seine Kleidung war ebenfalls noch die des Exils: Panamahut und graue oder weiße dreiteilige Anzüge.“"
                                            },
                                            {
                                                "example_id": "8ef5f4e2-c912-4641-b9e4-7f41af881e4d",
                                                "sense_id": "10991863-d703-3644-91cd-31536a00f161",
                                                "text": "„Der Mann war sonderbar: Er trug gerne Krawattenschals, Panamahüte und Westen mit goldenen Uhrketten und stammte aus einer berühmten CIA-Familie, aus der seit Generationen Cousins und Onkel für den Geheimdienst tätig gewesen waren.“"
                                            },
                                            {
                                                "example_id": "1c9d9997-50e8-4c6f-a887-0b76c58d40b0",
                                                "sense_id": "10991863-d703-3644-91cd-31536a00f161",
                                                "text": "„Seine Füße steckten in säuberlich gewichsten Stiefeln aus grauem Ziegenleder, in der Hand hielt er einen Panamahut, so sorgfältig aus zwei kleinen Hüten zusammengefügt, dass die Naht fast nicht zu sehen war.“"
                                            },
                                            {
                                                "example_id": "eff11d40-fd85-4c92-9b97-9eba69d979e3",
                                                "sense_id": "10991863-d703-3644-91cd-31536a00f161",
                                                "text": "„‚Verdammt, toll, wirklich toll, dass Sie endlich kommen‘, sagte der Zwerg, nahm seinen Panamahut ab und drückte ihn an die Brust.“"
                                            },
                                            {
                                                "example_id": "57c891e5-1371-466c-bf6b-9ff85294017c",
                                                "sense_id": "10991863-d703-3644-91cd-31536a00f161",
                                                "text": "„Daniel Darret ging zur Metrostation Saint-Michel-Notre-Dame, den weißen Panamahut auf dem Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
