                                        "sense_id": "626cd684-276e-3c7a-a0c9-2f1af49754ed",
                                        "entry_id": "73a8c3df-3892-3d34-b1d9-cf0e5220015a",
                                        "glosses": [
                                            "An appraisal or evaluation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02d079b-51a0-47bc-ab71-2548c1ab5377",
                                                "sense_id": "626cd684-276e-3c7a-a0c9-2f1af49754ed",
                                                "text": "For every item taken into consideration, the question of its status in terms of history has to be raised; if a word can safely be taken to have been borrowed, it will require an assessment different from that appropriate for a native lexeme."
                                            }
                                        ]
                                    }
                                ]
