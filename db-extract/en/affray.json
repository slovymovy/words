                "forms": [],
                "senses": [
                    {
                        "sense_id": "a722b0f7-d05c-3db6-b2f0-904cb933af39",
                        "entry_id": "cb384d7c-48ff-3111-b1f1-51e2281ac603",
                        "glosses": [
                            "Schlägerei, Krawall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda39b8c-52ae-4515-936c-eaaa09dff51f",
                                "sense_id": "a722b0f7-d05c-3db6-b2f0-904cb933af39",
                                "text": "\"It is said, that no quarrelsome or threatening words whatsoever can amount to an affray; and that no one can justify laying his hands on those who shall barely quarrel with angry words, without coming to blows: but it seems that a constable may, at the request of the party threatened, carry the person who threatens to beat him before a justice, in order to find sureties.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9d41697-dfdf-3de4-92ee-725259222d39",
                        "entry_id": "cb384d7c-48ff-3111-b1f1-51e2281ac603",
                        "glosses": [
                            "Raufhandel"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e5acc94-e830-431e-af36-3e8c5daa8ffd",
                        "source_entry_id": "cb384d7c-48ff-3111-b1f1-51e2281ac603",
                        "source_sense_id": "a722b0f7-d05c-3db6-b2f0-904cb933af39",
                        "source_sense_description": "Schlägerei, Krawall",
                        "target_lang_word": "Schlägerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlägerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89a1b5d9-1c3d-38c7-b6f3-65ca16a54d64",
                                        "entry_id": "b17728cc-a2a1-33e2-9548-016a4d06ca21",
                                        "glosses": [
                                            "handgreifliche Auseinandersetzung mindestens zweier Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41079230-c6fd-4037-a8e2-f76af63b1c59",
                                                "sense_id": "89a1b5d9-1c3d-38c7-b6f3-65ca16a54d64",
                                                "text": "Die Schlägerei zwischen den randalierenden Fans war schwierig zu stoppen."
                                            },
                                            {
                                                "example_id": "0722d9ed-416a-486e-93d6-fc02dc40ef57",
                                                "sense_id": "89a1b5d9-1c3d-38c7-b6f3-65ca16a54d64",
                                                "text": "„Seit einiger Zeit mehren sich die Schlägereien zwischen Jugendbanden aus den Vorstädten […].“"
                                            },
                                            {
                                                "example_id": "20c71b78-c0b5-4a76-a44c-0f33a0169631",
                                                "sense_id": "89a1b5d9-1c3d-38c7-b6f3-65ca16a54d64",
                                                "text": "„Nicht die Schlägereien als solche hätte er verurteilt, sondern, dass ich als Verlierer vom Platz ging.“"
                                            },
                                            {
                                                "example_id": "83792176-6c5e-4189-aff3-8c7616784fbe",
                                                "sense_id": "89a1b5d9-1c3d-38c7-b6f3-65ca16a54d64",
                                                "text": "„Ein englischer Literat hätte über die Schlägerei bestimmt anders, spannender geschrieben.“"
                                            },
                                            {
                                                "example_id": "f16dfba8-49e2-46cd-ba96-c104cdad10e4",
                                                "sense_id": "89a1b5d9-1c3d-38c7-b6f3-65ca16a54d64",
                                                "text": "„Grenfeld beeilte sich, der drohenden Schlägerei zu entkommen, und machte sich zu Fuß auf den Weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e003e762-8d51-4628-8679-8adbd312f69a",
                        "source_entry_id": "cb384d7c-48ff-3111-b1f1-51e2281ac603",
                        "source_sense_id": "a722b0f7-d05c-3db6-b2f0-904cb933af39",
                        "source_sense_description": "Schlägerei, Krawall",
                        "target_lang_word": "Krawall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krawall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4830d3a-e3e3-396d-b1f8-faff79b162ac",
                                        "entry_id": "bce6a224-66cc-3437-b78b-23e9fc4da694",
                                        "glosses": [
                                            "ein lärmender Volksauflauf oder Aufruhr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe8916b-a9d5-49c9-81aa-84bbddc47e89",
                                                "sense_id": "a4830d3a-e3e3-396d-b1f8-faff79b162ac",
                                                "text": "„Karl tat dies, zog aber, ehe er antwortete, noch den Vorhang der Tür fester zu, damit man im Inneren nichts merken konnte. ‚Verzeihen Sie’, sagte er dann im Flüsterton, daß ich so leise rede. Wenn mich die drinnen hören, habe ich wieder einen Krawall.“"
                                            },
                                            {
                                                "example_id": "e3b24127-37a5-47c5-a4b6-8b1a4d300c9b",
                                                "sense_id": "a4830d3a-e3e3-396d-b1f8-faff79b162ac",
                                                "text": "„Obwohl ich ihn zu meiden suchte, rannte er mir bei jedem Krawall wie eine Glucke ihren Küchlein nach, um mich zu bevormunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
