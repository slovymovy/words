                "senses": [
                    {
                        "sense_id": "3af76997-de6e-3ef2-b613-57afe0a99adb",
                        "entry_id": "a6775886-4ee9-3310-aced-9d52f7abb5e8",
                        "glosses": [
                            "Differenzdruckmessgerät, mit schräg stehendem Glasrohr, Skala und Anzeigeflüssigkeit darin"
                        ],
                        "tags": [
                            "Physik Messtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "9aa1da30-1797-40ec-915b-fc55e495bfd3",
                                "sense_id": "3af76997-de6e-3ef2-b613-57afe0a99adb",
                                "text": "„Das Differenzdruck-Schrägrohrmanometer dient zur Überwachung des Differenzdrucks von Luft oder anderen nichtbrennbaren und nichtaggressiven Gasen.“"
                            },
                            {
                                "example_id": "bc95914e-f179-485a-a425-057c1a466a3e",
                                "sense_id": "3af76997-de6e-3ef2-b613-57afe0a99adb",
                                "text": "„Das Schrägrohrmanometer ist eine spezielle Abwandlung eines U-Rohrmanometers.“"
                            },
                            {
                                "example_id": "423829e0-2f0f-4fa9-b44a-5304a6c669dc",
                                "sense_id": "3af76997-de6e-3ef2-b613-57afe0a99adb",
                                "text": "„Das Schrägrohrmanometer wird zur Messung kleiner Drücke oder kleiner Druckdifferenzen eingesetzt, so z. B. zur Messung der Druckdifferenz im Abgas- oder Rauchrohr eines Heizkessels.“"
                            },
                            {
                                "example_id": "3fbc7721-e81c-4fb5-b359-63af1c8db620",
                                "sense_id": "3af76997-de6e-3ef2-b613-57afe0a99adb",
                                "text": "„Schrägrohr-Manometer vorher mittels Stellschrauben waagerecht ausrichten, Anzeigewerte der Schrägrohrmanometer bei Volumenstrom Null, Druck und Temperatur im Raum aufschreiben.“"
                            },
                            {
                                "example_id": "b08ea8db-0dd1-4e71-a317-d944db7cfd12",
                                "sense_id": "3af76997-de6e-3ef2-b613-57afe0a99adb",
                                "text": "„ Hierzu muss am Filter z. B. ein U-Rohr-Manometer oder besser ein Schrägrohrmanometer installiert sein, das jederzeit ein Ablesen der Druckdifferenz vor und hinter dem Filter ermöglicht“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
