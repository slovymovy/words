                                "target_senses": [
                                    {
                                        "sense_id": "9edbfdf7-468e-3727-a64e-0aaaec5a8bf6",
                                        "entry_id": "2c113594-926c-3832-9790-d2e4d97fa7e2",
                                        "glosses": [
                                            "Se dit d'un agent chimique dont la présence à une interface entre deux fluides entraîne l'abaissement de la tension interfaciale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c97f75b4-9215-4381-99ff-6b46cdf39a64",
                                                "sense_id": "9edbfdf7-468e-3727-a64e-0aaaec5a8bf6",
                                                "text": "Les molécules tensioactives stabilisent les gouttelettes d'huile dans l'eau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tensioactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb5968e-292d-3e97-80e2-fc2ed4f10db2",
                                        "entry_id": "5c49d5c6-611d-3687-af8c-b127079455ea",
                                        "glosses": [
                                            "Composé chimique qui diminue la tension superficielle entre deux surfaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c77832-e2eb-4d05-9319-1d5e31dc9c9f",
                                                "sense_id": "dbb5968e-292d-3e97-80e2-fc2ed4f10db2",
                                                "text": "Des tensioactifs sont utilisés en décontamination et agissent comme de la lessive."
                                            }
                                        ]
                                    }
                                ]
                            }
