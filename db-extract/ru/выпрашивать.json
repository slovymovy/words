                "translations": [
                    {
                        "translation_id": "a207eaba-5003-4d92-b0fc-ab991abbd242",
                        "source_entry_id": "d8cce412-ac73-3411-84bb-ca11e1e13dd6",
                        "source_sense_id": "69914447-3f3e-3f30-baca-171cc3a97e2c",
                        "target_lang_word": "mendier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mendier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f3c711f-1f01-35fa-bdc4-da4b3f00a2d9",
                                        "entry_id": "b5b559cd-c937-3129-b10f-ae1aca1ced48",
                                        "glosses": [
                                            "Demander l’aumône."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b8a790-a0e7-4e20-ac6f-c41d816262b3",
                                                "sense_id": "4f3c711f-1f01-35fa-bdc4-da4b3f00a2d9",
                                                "text": "Pour sa part, la Ville de Trois-Rivières n'interdit pas de mendier dans sa réglementation, mais importuner des gens peut être passible d'une amende."
                                            },
                                            {
                                                "example_id": "677f9d6c-1b55-4163-83b3-b3c07561c70a",
                                                "sense_id": "4f3c711f-1f01-35fa-bdc4-da4b3f00a2d9",
                                                "text": "Il est défendu de mendier dans cette ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33ae6425-a9e1-322b-a05e-0738d4a1364a",
                                        "entry_id": "b5b559cd-c937-3129-b10f-ae1aca1ced48",
                                        "glosses": [
                                            "Solliciter à titre d’aumône."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9f1eb37-b8ce-43f8-86af-36b1aeb86eaf",
                                                "sense_id": "33ae6425-a9e1-322b-a05e-0738d4a1364a",
                                                "text": "Ce n’est pas pour mendier son pain au prix de son amour qu’Élisa Merton se traînait à tes pieds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f2a91b-1119-3cee-bcf7-4e90754b75c7",
                                        "entry_id": "b5b559cd-c937-3129-b10f-ae1aca1ced48",
                                        "glosses": [
                                            "Implorer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5920e710-297b-48c1-89bf-b0ac04a9c577",
                                                "sense_id": "98f2a91b-1119-3cee-bcf7-4e90754b75c7",
                                                "text": "On lui donne! Les gens qui vont se battre jettent les sous et mendient les cartouches."
                                            },
                                            {
                                                "example_id": "a63ef41c-8f4d-4105-bde1-62064ddf0079",
                                                "sense_id": "98f2a91b-1119-3cee-bcf7-4e90754b75c7",
                                                "text": "Mendier son pardon."
                                            },
                                            {
                                                "example_id": "2084b01a-5bcf-454e-a898-c83d9b652dca",
                                                "sense_id": "98f2a91b-1119-3cee-bcf7-4e90754b75c7",
                                                "text": "Mendier le secours, l’assistance, la protection de quelqu’un."
                                            },
                                            {
                                                "example_id": "65f3780e-77f5-455e-b98e-1c744d3898c2",
                                                "sense_id": "98f2a91b-1119-3cee-bcf7-4e90754b75c7",
                                                "text": "Il va mendier les suffrages des uns et des autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8fa8017-1108-4294-b14b-21cd780d4b0d",
                        "source_entry_id": "d8cce412-ac73-3411-84bb-ca11e1e13dd6",
                        "source_sense_id": "69914447-3f3e-3f30-baca-171cc3a97e2c",
                        "target_lang_word": "quémander",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quémander",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b4cba51-a8e8-3333-8789-209bbe13f25f",
                                        "entry_id": "8a338b1a-d8c5-33d5-b305-32df9daa4fb0",
                                        "glosses": [
                                            "Solliciter, mendier avec insistance et importunité."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6379da09-ea4a-4414-91b0-9a48830953d6",
                                                "sense_id": "4b4cba51-a8e8-3333-8789-209bbe13f25f",
                                                "text": "Au temps jadis, il y avait au village de Vicq, sur les bords de l’Escaut, une bonne femme nommée Misère qui allait quémander de porte en porte […]"
                                            },
                                            {
                                                "example_id": "6edec820-d02a-437e-a0d1-6171dfeb1df8",
                                                "sense_id": "4b4cba51-a8e8-3333-8789-209bbe13f25f",
                                                "text": "Ils se voyaient sans travail pendant des mois entiers, acceptant pour survivre des travaux dérisoires, empruntant, quémandant."
                                            },
                                            {
                                                "example_id": "9a375a69-0ebf-4b7a-8603-23f62196b7ef",
                                                "sense_id": "4b4cba51-a8e8-3333-8789-209bbe13f25f",
                                                "text": "«La population est peut-être moins tannée de se faire quémander, note-t-il. Mais moi, je dirais aux gens qu’un petit coup de main, ça va vous donner un petit peu de bonheur dans votre cœur et ça va nous aider, nous autres aussi. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b114024-273f-3770-9e55-1ac9e99ab641",
                                        "entry_id": "8a338b1a-d8c5-33d5-b305-32df9daa4fb0",
                                        "glosses": [
                                            "Demander, solliciter quelque chose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3f2149f-dbe4-4539-af19-4c2602d0998c",
                                                "sense_id": "1b114024-273f-3770-9e55-1ac9e99ab641",
                                                "text": "Et, vite, avec une joie avide, elle enfouissait dans sa poche l’argent quémandé, presque volé."
                                            },
                                            {
                                                "example_id": "0533fe92-edfc-4986-a1de-7e9bdaa7f218",
                                                "sense_id": "1b114024-273f-3770-9e55-1ac9e99ab641",
                                                "text": "Le garnement alla plus loin, quémandant à chaque table une consommation que tous lui refusaient."
                                            },
                                            {
                                                "example_id": "d2335d98-d285-492e-ad33-118591f914ba",
                                                "sense_id": "1b114024-273f-3770-9e55-1ac9e99ab641",
                                                "text": "Tous les jours, j’y vois des jeunes de 20 ans hurler, pleurer, quémander des sous, de la drogue et de l’amour, dormir à même le sol entre deux chiens galeux et chier dans les devantures des commerces barricadés et couverts de graffitis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
