                            {
                                "target_lang_word": "pokorny",
                                "target_lang_sense_clarification": "pełen pokory, bez pychy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "283167d8-0110-3138-948a-80be4e11d80a",
                    "sense_definition": "Простой, без излишеств и роскоши, неброский на вид (об одежде, образе жизни, обстановке).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance_lifestyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для вечеринки она выбрала <w>скромное</w> чёрное платье без украшений.",
                            "target_lang_translations": {
                                "en": "She chose a <w>modest</w> black dress without ornaments for the party.",
                                "pl": "Na przyjęcie wybrała <w>skromną</w> czarną sukienkę bez ozdób."
                            }
                        },
                        {
                            "text": "Мы накрыли <w>скромный</w> стол для гостей, так как денег было мало.",
                            "target_lang_translations": {
                                "en": "We set a <w>modest</w> table for the guests since we had little money.",
                                "pl": "Zastawiliśmy <w>skromny</w> stół dla gości, ponieważ było mało pieniędzy."
                            }
                        },
                        {
                            "text": "Семья жила в <w>скромном</w> доме на окраине деревни.",
                            "target_lang_translations": {
                                "en": "The family lived in a <w>modest</w> house on the edge of the village.",
                                "pl": "Rodzina mieszkała w <w>skromnym</w> domu na skraju wsi."
                            }
                        }
                    ],
                    "synonyms": [
                        "простой",
                        "неброский",
                        "беспритязательный",
                        "простецкий"
                    ],
                    "antonyms": [
                        "вычурный",
                        "броский",
                        "вызывающий",
                        "претенциозный"
                    ],
                    "common_phrases": [
