                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c3fc5b8-63dc-4b2b-8dcc-f8470d20d3ae",
                                                "sense_id": "3e097441-41c4-3289-9dc0-ed192ae1300f",
                                                "text": "„Schon zeigte sich das Berühmtsein als Freiheitsbeschränkung und Erweiterung von Pflichten, die mir noch mehr Entscheidungen und jede Menge Arbeiten auferlegte.“"
                                            }
                                        ],
