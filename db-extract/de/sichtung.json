                        "source_sense_id": "6fe6609d-cd37-3e82-a68f-034254770159",
                        "source_sense_description": "das Prüfen, um eine mögliche Entscheidung zu treffen",
                        "target_lang_word": "sighting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
