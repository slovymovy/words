                "senses": [
                    {
                        "sense_id": "239920f3-f8fa-3e36-938f-6199723cdf78",
                        "entry_id": "48bfc4be-5b3c-3dcb-af9b-bb54de9efda8",
                        "glosses": [
                            "Bildelement einer Anzeige, das als Blickfang dient, Aufmerksamkeit erregen und den Blick auf das eigentlich beworbene Produkt lenken soll"
                        ],
                        "tags": [
                            "Fachsprache der Werbung",
                            "auch in der Linguistik verwendet"
                        ],
                        "examples": [
                            {
                                "example_id": "068d539e-d26d-4aae-807f-20c63adaeee9",
                                "sense_id": "239920f3-f8fa-3e36-938f-6199723cdf78",
                                "text": "Catch-Visuals sind die Bildelemente von Werbeanzeigen, auf die der Blick des Betrachters zuerst fällt."
                            },
                            {
                                "example_id": "6591a53f-d088-42b1-9265-8205fe47864d",
                                "sense_id": "239920f3-f8fa-3e36-938f-6199723cdf78",
                                "text": "Als Catch-Visual diente in der Zigaretten-Werbung zum Beispiel eine Szene, die Freiheit und Abenteuer symbolisiert."
                            },
                            {
                                "example_id": "ec8ef7de-ece4-4505-9734-95613a392a1f",
                                "sense_id": "239920f3-f8fa-3e36-938f-6199723cdf78",
                                "text": "„Das Catch-Visual ist der künstlerische Bezugsrahmen, der das beworbene Produkt umgibt und dient als Blickfang, der den Blick des Rezipienten auf das Key-Visual lenkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
