                    "frequency": "Low",
                    "semantic_group_id": "time_of_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists observed the <w>daily</w> habits of the birds during the sunlit hours.",
                            "target_lang_translations": {
