                "senses": [
                    {
                        "sense_id": "ac2e70e0-0e1d-38a5-8d69-979019d7d4d9",
                        "entry_id": "f1eb1d58-e938-3096-8e9c-199b01c2dcef",
                        "glosses": [
                            "Rendre imparfait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1889ba3-8f1b-449c-a17f-9ca4602598d0",
                                "sense_id": "ac2e70e0-0e1d-38a5-8d69-979019d7d4d9",
                                "text": "Les pauses pouvaient imperfectionner les notes parfaites aussi bien que les notes dont elles avaient la valeur ;"
                            },
                            {
                                "example_id": "9699500b-8b04-431f-8a82-d16387c6b3fb",
                                "sense_id": "ac2e70e0-0e1d-38a5-8d69-979019d7d4d9",
                                "text": "Ne laissez pas dire aux ennemis de votre gloire qu'avant d'abandonner le poste où la confiance publique vous a placés, vous avez voulu imperfectionner votre ouvrage et marquer la fin de votre carrière par une injustice."
                            }
                        ]
                    }
