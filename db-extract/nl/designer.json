                    },
                    {
                        "translation_id": "8c43c3e3-6cf6-4ad6-9ba0-db19eefc5e09",
                        "source_entry_id": "0b9bd85b-fd20-3bbd-8bdc-709bf6123f7b",
                        "source_sense_id": "6158890a-092e-3272-86aa-2ec3a2afc7fb",
                        "target_lang_word": "créateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e9c0169-499d-3f39-9811-222e389b1f9a",
                                        "entry_id": "c94ca418-b3c7-36d8-9f97-423457ea61a5",
                                        "glosses": [
                                            "Celui qui crée, qui tire du néant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e3028e-85de-4adc-9145-cf2e63ac029a",
                                                "sense_id": "8e9c0169-499d-3f39-9811-222e389b1f9a",
                                                "text": "Le principe thomiste de la distinction réelle de l’essence et de l’existence chez la créature a pour corolaire celui de l’identité de l’essence et de l’existence chez le créateur[…]."
                                            },
                                            {
                                                "example_id": "1724dbef-c5a7-43c7-9779-a13e58ca8077",
                                                "sense_id": "8e9c0169-499d-3f39-9811-222e389b1f9a",
                                                "text": "[…], je dirais que j’ai pitié des pauvres orgueilleux qui ne veulent pas de Dieu pour créateur, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f66eb2b-a926-37ed-afc5-0abb2aeb6524",
                                        "entry_id": "c94ca418-b3c7-36d8-9f97-423457ea61a5",
                                        "glosses": [
                                            "Dieu."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "446c5968-dffe-48ed-9116-d1f88712122d",
                                                "sense_id": "3f66eb2b-a926-37ed-afc5-0abb2aeb6524",
                                                "text": "Grégoire affirme que le Créateur de l’univers a créé le monde sensible comme situé entre deux termes extrêmes contraires l’un à l’autre, je veux dire entre la pesanteur et l’impondérabilité, qui s’opposent absolument l’un à l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a23cc870-a101-34c7-9cd9-08f28dcf90cf",
                                        "entry_id": "c94ca418-b3c7-36d8-9f97-423457ea61a5",
                                        "glosses": [
                                            "Celui qui trouve quelque chose de nouveau, dans quelque genre que ce soit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de423cf1-5449-4a3c-84c7-c09d70bb4996",
                                                "sense_id": "a23cc870-a101-34c7-9cd9-08f28dcf90cf",
                                                "text": "Homère est regardé comme le créateur de l’épopée. — Un Molière, un Balzac sont de grands créateurs. — Minerve a été honorée comme étant la créatrice des arts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d16f0b36-800f-3c59-8702-dd10f13f31ac",
                                        "entry_id": "c94ca418-b3c7-36d8-9f97-423457ea61a5",
                                        "glosses": [
                                            "Entrepreneur de mode."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72ecf35a-78eb-448c-9757-3ebef843a2a5",
                                                "sense_id": "d16f0b36-800f-3c59-8702-dd10f13f31ac",
                                                "text": "Elle était dingue des fringues de créateur et ne kiffait pas trop mon style vestimentaire, tendance récupération. Mais elle ne désespérait pas qu’un jour je prenne exemple sur elle : […]."
                                            },
                                            {
                                                "example_id": "cca140da-4d36-48ce-b2ad-f29fb3c29cfc",
                                                "sense_id": "d16f0b36-800f-3c59-8702-dd10f13f31ac",
                                                "text": "Lorsqu'elle a donné à son public ce qu'il attendait d'elle, elle pivote impérieusement, lance un dédaigneux regard dans sa direction avant de regagner de façon tout aussi déterminée le monde à part dans lequel ne vivent que les tops, les créateurs et les millionnaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35eef893-03c0-337b-96b4-0adca5b10823",
                                        "entry_id": "c94ca418-b3c7-36d8-9f97-423457ea61a5",
                                        "glosses": [
                                            "Celui qui fonde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f60c97a3-6a0d-490f-825e-0dda60a97433",
                                                "sense_id": "35eef893-03c0-337b-96b4-0adca5b10823",
                                                "text": "Un créateur d’entreprise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "créateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9301b08d-bf6f-339c-a63e-b2f0223aaebb",
                                        "entry_id": "4947df96-bc89-303b-805b-30f3fda9cd6c",
                                        "glosses": [
                                            "Qui crée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65d550b-4712-426d-934a-a7c249cbab64",
                                                "sense_id": "9301b08d-bf6f-339c-a63e-b2f0223aaebb",
                                                "text": "La puissance d’un Dieu créateur."
                                            },
                                            {
                                                "example_id": "6866b0b4-e2cc-480c-8601-a026bdfd07b4",
                                                "sense_id": "9301b08d-bf6f-339c-a63e-b2f0223aaebb",
                                                "text": "La Divinité créatrice de tout ce qui existe."
                                            },
                                            {
                                                "example_id": "5a6c3fbc-ad9c-4483-aebe-d32e98a24c4d",
                                                "sense_id": "9301b08d-bf6f-339c-a63e-b2f0223aaebb",
                                                "text": "Génie créateur."
                                            },
                                            {
                                                "example_id": "62972220-9437-4179-a62d-baee6156922d",
                                                "sense_id": "9301b08d-bf6f-339c-a63e-b2f0223aaebb",
                                                "text": "Puissance créatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29041b04-2a9a-321f-a0fa-855482a53026",
                                        "entry_id": "4947df96-bc89-303b-805b-30f3fda9cd6c",
                                        "glosses": [
                                            "Qui génère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c61440be-d3d7-4edf-8daf-936f9ba3cdf4",
                                                "sense_id": "29041b04-2a9a-321f-a0fa-855482a53026",
                                                "text": "La théorie de destruction créatrice de Joseph Schumpeter"
                                            },
                                            {
                                                "example_id": "546a61a8-1386-4a08-ba03-83935e94f117",
                                                "sense_id": "29041b04-2a9a-321f-a0fa-855482a53026",
                                                "text": "L'Évolution créatrice est un ouvrage philosophique d'Henri Bergson. Il y développe l'idée d'une “création permanente de nouveauté” par la nature."
                                            },
                                            {
                                                "example_id": "f042e260-c733-46c3-a7e5-6f749f6a1a01",
                                                "sense_id": "29041b04-2a9a-321f-a0fa-855482a53026",
                                                "text": "L'innovation, créatrice d'emplois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
