                "senses": [
                    {
                        "sense_id": "e37c886c-9629-344c-a195-547f66c4f8db",
                        "entry_id": "68ce6267-4938-3f4e-ae28-d3fc41ec00b4",
                        "glosses": [
                            "Astronomie: der orbitale Begleiter der Erde, unser Mond"
                        ],
                        "tags": [
                            "Plural eher theoretischer Natur"
                        ],
                        "examples": [
                            {
                                "example_id": "98cd8f5b-5068-42d7-b481-c8f116ec7b02",
                                "sense_id": "e37c886c-9629-344c-a195-547f66c4f8db",
                                "text": "Der einzige natürliche Erdtrabant ist der Mond."
                            },
                            {
                                "example_id": "3972adca-1d0a-46bd-814d-fc197933e02c",
                                "sense_id": "e37c886c-9629-344c-a195-547f66c4f8db",
                                "text": "„Ziel war es, mögliche Landestellen für einen späteren Flug zu dem Erdtrabanten auszumachen.“"
                            },
                            {
                                "example_id": "0cf5fb17-7e32-42f0-a46e-bac0b1d239c5",
                                "sense_id": "e37c886c-9629-344c-a195-547f66c4f8db",
                                "text": "„So bat sie den Techniker, das Teleskop auf unseren Erdtrabanten auszurichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b39aae92-f01c-3e16-873f-567d4808200b",
                        "entry_id": "68ce6267-4938-3f4e-ae28-d3fc41ec00b4",
                        "glosses": [
                            "künstliche Begleiter der Erde (Satelliten)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9dc1126-5d2b-49af-a2ea-763c9c6771aa",
                        "source_entry_id": "68ce6267-4938-3f4e-ae28-d3fc41ec00b4",
                        "source_sense_id": "e37c886c-9629-344c-a195-547f66c4f8db",
                        "source_sense_description": "Astronomie: der orbitale Begleiter der Erde, unser Mond (Plural eher theoretischer Natur)",
                        "target_lang_word": "Moon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afe11e4-bf3d-33a6-a553-774b60fb9930",
                                        "entry_id": "aa30fb8c-ae8c-3727-b4f0-7cdbdfdd449e",
                                        "glosses": [
                                            "The Earth's moon; the sole natural satellite of the Earth, represented in astronomy and astrology by ☾."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eb16d4a-a336-4df0-81fd-51401587d066",
                                                "sense_id": "6afe11e4-bf3d-33a6-a553-774b60fb9930",
                                                "text": "I kind of have two Moons up there. I look at the Moon just like everybody else who's never been there. But every once in a while I do think of the second Moon, the one that I recall from up close and, yeah, it is kind of hard to believe that I was actually up there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                        "entry_id": "aa30fb8c-ae8c-3727-b4f0-7cdbdfdd449e",
                                        "glosses": [
                                            "A personification of the moon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a21f3b8-efc6-4e04-8fdd-f18e82c95dc2",
                                                "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                                "text": "Women's rhythm of life, her monthly renewal with her patroness the Moon, is the most important thing in her existence."
                                            },
                                            {
                                                "example_id": "867c81b8-e054-44c3-8227-acb2e777ab53",
                                                "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                                "text": "Moon, the companion of Night, waxes and wanes, and we call this time a month."
                                            },
                                            {
                                                "example_id": "b340f7f1-5972-4530-bfae-b535b1c64ec7",
                                                "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                                "text": "Moon's Day."
                                            },
                                            {
                                                "example_id": "77f75a08-63a6-41f2-b3bd-0f953ae0b78b",
                                                "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                                "text": "Sun come, Moon come, Seed time, dry time, fog and rain, Sowing, growing, reaping, resting, Sun come, Moon come, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c39737-09c8-317d-8264-598740c2cfd8",
                                        "entry_id": "aa30fb8c-ae8c-3727-b4f0-7cdbdfdd449e",
                                        "glosses": [
                                            "The 54th sura (chapter) of the Qur'an."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Moon",
                                "target_lang_code": "en",
                                "target_senses": [
