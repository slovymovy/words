                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c1f421b-7f39-3840-9772-730448346cec",
                        "entry_id": "e37be547-6516-3da5-8fa5-eac0d9a6d05d",
                        "glosses": [
                            "The outermost of the three tissue layers in the embryo of a metazoan animal, which produces through development, the epidermis (skin) and nervous system of the adult."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60249a39-31d3-4d6a-8905-81b40a64b0bc",
                        "source_entry_id": "e37be547-6516-3da5-8fa5-eac0d9a6d05d",
                        "source_sense_id": "7c1f421b-7f39-3840-9772-730448346cec",
                        "source_sense_description": "tissue layer in the embryo",
                        "target_lang_word": "ectoderme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ectoderme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e559cd81-de3e-3806-a62f-f6121603cefb",
                                        "entry_id": "f03c1f53-26c7-3b79-ab5c-e7c63341243d",
                                        "glosses": [
                                            "Feuillet embryonnaire externe de l'embryon des métazoaires qui se met en place au moment de la gastrulation. Il a généralement pour rôle de donner naissance aux organes externes, aux muqueuses, mais également au système nerveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32404626-a9ac-4b9d-a169-adfe67f17bd4",
                                                "sense_id": "e559cd81-de3e-3806-a62f-f6121603cefb",
                                                "text": "Chez les mammifères, l’ectoderme donne naissance à l'épiderme de la peau, à la cornée des yeux, à l'émail des dents, au rectum."
                                            },
                                            {
                                                "example_id": "7e6f657d-7a8f-4e70-8ec8-2bdd603785a1",
                                                "sense_id": "e559cd81-de3e-3806-a62f-f6121603cefb",
                                                "text": "L’ectoderme va former à la fois l’épiderme et le cerveau, donnant naissance aux cheveux ainsi qu’aux autres organes sensoriels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2ec84da-99cb-4f83-b74e-8e6631ac15a9",
