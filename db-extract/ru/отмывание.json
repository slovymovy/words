                                        "entry_id": "3293552d-c5dc-36ea-bbbd-e999d2a18c38",
                                        "glosses": [
                                            "Action de laver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35afbb28-f15a-46cf-a84b-cc9f6ef1e84b",
                                                "sense_id": "b32dbb83-0f6a-3ee5-a79a-d60f650b3010",
                                                "text": "Prélavez le textile, qui tend à rétrécir au lavage, et prenez en compte ce facteur au moment de votre achat : le retrait du denim peut être important."
                                            },
                                            {
                                                "example_id": "5f79732b-5b72-4bd9-abe0-9edde2a2ce68",
                                                "sense_id": "b32dbb83-0f6a-3ee5-a79a-d60f650b3010",
                                                "text": "Le lavage des vitres."
                                            },
                                            {
                                                "example_id": "f7934544-ef15-40cd-8db0-e2899320413e",
                                                "sense_id": "b32dbb83-0f6a-3ee5-a79a-d60f650b3010",
                                                "text": "Le lavage d’une forme d’imprimerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45647bfd-e31f-3481-a405-93b8a8133161",
                                        "entry_id": "3293552d-c5dc-36ea-bbbd-e999d2a18c38",
                                        "glosses": [
                                            "Action de nettoyer."
                                        ],
                                        "tags": [],
                                        "examples": [
