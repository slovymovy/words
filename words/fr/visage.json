    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2ec8741-9a50-3d98-8728-531b717a4dbd",
                    "sense_definition": "Partie antérieure de la tête humaine, comprenant le front, les yeux, le nez, les joues et la bouche.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle se lave le <w>visage</w> avec de l'eau fraîche tous les matins."
                        },
                        {
                            "text": "Un grand sourire illuminait son <w>visage</w> lorsqu'elle a vu ses enfants."
                        }
                    ],
                    "synonyms": [
                        "figure",
                        "face"
                    ],
                    "common_phrases": [
                        "laver le visage",
                        "tourner le visage",
                        "visage rond"
                    ]
                },
                {
                    "sense_id": "295b134b-ace8-3784-8dee-1879795ebdf9",
                    "sense_definition": "Expression ou émotion particulière manifestée par les traits de la tête.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>visage</w> exprimait une profonde tristesse lors de la cérémonie d'adieu."
                        },
                        {
                            "text": "En apprenant la mauvaise nouvelle, il a soudainement changé de <w>visage</w>."
                        }
                    ],
                    "common_phrases": [
                        "changer de visage",
                        "visage souriant"
                    ]
                },
                {
                    "sense_id": "fc82f6f6-ed16-3c6a-9d8e-572a769c9972",
                    "sense_definition": "Personne en tant qu'elle est identifiable par ses traits.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette grande foule, je n'ai reconnu aucun <w>visage</w> familier."
                        },
                        {
                            "text": "Il était rassuré d'apercevoir enfin des <w>visages</w> connus parmi les invités."
                        }
                    ],
                    "common_phrases": [
                        "visage connu",
                        "visage familier",
                        "visage nouveau"
                    ]
                },
                {
                    "sense_id": "6c43a999-c14f-335b-8788-15a1fe92a54b",
                    "sense_definition": "Apparence extérieure ou aspect caractéristique que prend une chose ou une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec ces travaux modernes, le quartier offre désormais un tout nouveau <w>visage</w>."
                        },
                        {
                            "text": "La crise économique a montré le véritable <w>visage</w> de certaines entreprises."
                        }
                    ],
                    "common_phrases": [
                        "nouveau visage",
                        "véritable visage",
                        "double visage"
                    ]
                },
                {
                    "sense_id": "6a4b95e5-814b-3bcd-bf2a-e4c69f9e41df",
                    "sense_definition": "Ensemble des traits moraux ou spirituels caractéristiques d'une personne, d'un groupe ou d'une époque.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet essai tente de dépeindre le <w>visage</w> moral de notre époque tourmentée."
                        },
                        {
                            "text": "L'historien a analysé le <w>visage</w> complexe de cette nation au fil des siècles."
                        }
                    ],
                    "common_phrases": [
                        "vrai visage"
                    ]
                }
            ]
        }
    ]
}