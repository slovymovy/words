                "senses": [
                    {
                        "sense_id": "1370a70c-8e11-38bc-b10c-112c278624c2",
                        "entry_id": "f912e46a-62ae-3f88-9de8-a677e63174af",
                        "glosses": [
                            "Unfall, bei dem ein Helikopter zu Boden oder ins Wasser stürzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f07e2c75-dba8-4e4a-8103-c09e24726136",
                                "sense_id": "1370a70c-8e11-38bc-b10c-112c278624c2",
                                "text": "Bei dem Helikopterabsturz am Sonntag sind alle Besatzungsmitglieder ums Leben gekommen."
                            },
                            {
                                "example_id": "f0c2229a-049a-43b9-89a5-21afa9ad74af",
                                "sense_id": "1370a70c-8e11-38bc-b10c-112c278624c2",
                                "text": "„Nach dem Tod von Präsident Ebrahim Raisi bei einem Helikopterabsturz haben in Iran die mehrtägigen Trauerfeierlichkeiten begonnen.“"
                            },
                            {
                                "example_id": "82bd2b05-3793-42a3-94a0-d530fae5f5de",
                                "sense_id": "1370a70c-8e11-38bc-b10c-112c278624c2",
                                "text": "„Im Januar 2020 starb Ex-NBA-Profi Kobe Bryant bei einem Helikopterabsturz.“"
                            },
                            {
                                "example_id": "12bbe874-5cc3-4bc5-b29e-e55d7871eb0f",
                                "sense_id": "1370a70c-8e11-38bc-b10c-112c278624c2",
                                "text": "„Der Eigentümer von Leicester City, Vichai Srivaddhanaprabha, ist bei einem Helikopterabsturz ums Leben gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
