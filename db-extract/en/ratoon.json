                "forms": [
                    {
                        "form_id": "b81f1b2b-080f-4610-b93e-fbd5883bc33b",
                        "entry_id": "35917275-195c-3d42-acb3-7df616263e48",
                        "tags": [
                            "plural"
                        ],
                        "form": "ratoons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db4193f3-8f85-3b36-bbe8-edd4a0bc75f7",
                        "entry_id": "35917275-195c-3d42-acb3-7df616263e48",
                        "glosses": [
                            "A shoot sprouting from the root of a cropped plant, especially sugar cane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d57e2d4-d62c-4514-8b75-e732b8c3f258",
                                "sense_id": "db4193f3-8f85-3b36-bbe8-edd4a0bc75f7",
                                "text": "1803, John Browne Cutting, “A Succinct History of Jamaica” in Robert Charles Dallas, The History of the Maroons, London: Longman and Rees, Volume 1, p. xci,\nRatoons, probably so named from a corruption of the Spanish word brotones, are suckers and sprouts, that spring from the roots of canes that have previously been cut down."
                            },
                            {
                                "example_id": "7b7e2959-4c96-4bc5-bc89-059134d14e31",
                                "sense_id": "db4193f3-8f85-3b36-bbe8-edd4a0bc75f7",
                                "text": "Their field tasks were somewhat easier than those of the great gang: cleaning and banking young canes, turning over trash or ratoon pieces (canes sprouting from old roots)."
                            },
                            {
                                "example_id": "eb183863-bf08-4db3-8381-6c31bd4ad87b",
                                "sense_id": "db4193f3-8f85-3b36-bbe8-edd4a0bc75f7",
                                "text": "A number of very small fruits from Cayenne ratoons were recently examined."
                            },
                            {
                                "example_id": "7ab33c99-9dcd-42e3-b438-1cabbffa0466",
                                "sense_id": "db4193f3-8f85-3b36-bbe8-edd4a0bc75f7",
                                "text": "Soon after harvest, new shoots emerge from axillary buds on the stubble and give rise to the ratoon crop. Initially the young shoots are dependent upon the roots of the previous crop (stool roots) but these are replaced by new shoot roots […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "927620ee-0d9b-3acb-9d8f-e9e39b28f5a8",
                        "entry_id": "35917275-195c-3d42-acb3-7df616263e48",
                        "glosses": [
                            "A rattan cane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e552de3-3898-4b8d-a29a-4e25c07388ae",
                                "sense_id": "927620ee-0d9b-3acb-9d8f-e9e39b28f5a8",
                                "text": "1660, Samuel Pepys, diary entry for 13 September, 1660, in Diary and Correspondence of Samuel Pepys, London: Henry Colburn, 1848, 3rd edition, Volume 1, p. 134,\nMr. Hawley did give me a little black rattoon, painted and gilt."
                            }
                        ]
                    }
                ],
