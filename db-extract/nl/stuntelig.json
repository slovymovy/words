                            {
                                "example_id": "c3fcddb1-c22b-42c8-b920-bb698aa0ba2a",
                                "sense_id": "6d3842ea-d337-352e-a7d7-ae551ef824df",
                                "text": "De stuntelige jongen versprak zich vele malen toen hij in het openbaar moest optreden."
                            },
                            {
                                "example_id": "e47f37dc-13d7-470b-a3c7-1b941ea58b54",
                                "sense_id": "6d3842ea-d337-352e-a7d7-ae551ef824df",
                                "text": "De stuntelige man brak veel kopjes tijdens het afwassen."
                            }
                        ]
