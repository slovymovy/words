                            }
                        },
                        {
                            "text": "The museum has an extensive collection of art from the <w>colonial</w> era.",
                            "target_lang_translations": {
                                "ru": "В музее собрана обширная коллекция произведений искусства <w>колониальной</w> эпохи.",
                                "zh": "博物馆收藏了大量<w>殖民时代</w>的艺术品。"
                            }
                        }
