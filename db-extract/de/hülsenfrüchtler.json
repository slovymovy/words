                "senses": [
                    {
                        "sense_id": "a536e171-c1ab-3b27-b6f2-253ec7b1b031",
                        "entry_id": "cb000254-7e43-3024-a8a8-64560994e464",
                        "glosses": [
                            "artenreiche Pflanzenfamilie, deren Vertreter Früchte mit Hülsen bildet (wissenschaftlicher Name: Fabaceae oder Leguminosae, beides ist gültig)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a3309ee-0837-4cb2-81a0-34b6adc1cc88",
                                "sense_id": "a536e171-c1ab-3b27-b6f2-253ec7b1b031",
                                "text": "„Auf 700.000 Jahre nach dem Einschlag datieren die ältesten Belege für die nährstoffreiche Pflanzenfamilie der Hülsenfrüchtler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84a83b16-7d61-37b9-8501-592bfb9a77ed",
                        "entry_id": "cb000254-7e43-3024-a8a8-64560994e464",
                        "glosses": [
                            "ein Vertreter von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d666ab-8a06-4562-b293-a74724d59ebd",
                                "sense_id": "84a83b16-7d61-37b9-8501-592bfb9a77ed",
                                "text": "Wie andere Hülsenfrüchtler hat die Luzerne die Fähigkeit, mit Hilfe von symbiotischen Bakterien Stickstoff aus der Luft aufzunehmen, und ist dadurch in der Lage, unabhängig vom vorhandenen Stickstoff im Boden Protein zu bilden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
