                ],
                "senses": [
                    {
                        "sense_id": "de9cf05b-6c6d-3367-8c63-8f6f701b601b",
                        "entry_id": "e4a3e4c9-caaf-3472-a4fa-7f716aef79a5",
                        "glosses": [
                            "Enlever son caractère symbiotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b9b96a-e86e-44a7-bdc9-1c96fdfd4e24",
                                "sense_id": "de9cf05b-6c6d-3367-8c63-8f6f701b601b",
                                "text": "Ce travail implique une blessure narcissique d’un autre type que celle infligée par le choc traumatique puisqu’il s’appuie sur le tiers pour désymbiotiser."
                            },
                            {
                                "example_id": "69190607-5bae-47a0-bc1b-c6a3fa28c605",
                                "sense_id": "de9cf05b-6c6d-3367-8c63-8f6f701b601b",
                                "text": "Quand la maman a pu se désymbiotiser — pour ainsi dire — de son bébé, ça l’a aidée, mais je ne dis pas que c’est cela qui a tout fait, non, sûrement pas."
                            }
                        ]
                    }
