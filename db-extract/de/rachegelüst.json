                "senses": [
                    {
                        "sense_id": "7f67dc62-8bf2-3808-bded-d5426b5ef411",
                        "entry_id": "e48976de-de8b-3e64-99a9-735df0ce81a0",
                        "glosses": [
                            "dringende, starke Lust darauf, sich für etwas zu rächen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f862c2d-0404-4145-9fbe-f9063f33f4c0",
                                "sense_id": "7f67dc62-8bf2-3808-bded-d5426b5ef411",
                                "text": "„Am wahrscheinlichsten dürfte freilich sein, daß Rachegelüste gegenüber dem vermeintlichen Besitzer sich mit der Siegestrunkenheit zu einem explosiven Gemisch verbanden.“"
                            },
                            {
                                "example_id": "7cb32872-1ba9-44cf-89c3-57cc503d9aaa",
                                "sense_id": "7f67dc62-8bf2-3808-bded-d5426b5ef411",
                                "text": "„Ich mußte der Vorsehung danken, daß die Contessa an Hexen glaubte, denn sonst hätte sie Mörder gedungen, die ihre Rachegelüste vollkommen befriedigt hätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
