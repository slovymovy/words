                                        "entry_id": "9b1d47c4-f1f5-3667-a8ba-36f9e743a5a1",
                                        "glosses": [
                                            "Impossibilité d’exprimer quelque chose par des paroles."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "172bd617-eecc-498a-88e9-588066770063",
                                                "sense_id": "2ebfd206-34f7-3fca-a984-c7f92dca889d",
                                                "text": "L’ineffabilité des grandeurs de Dieu."
                                            },
                                            {
                                                "example_id": "171f72e5-34e6-4606-874c-5158926829d6",
                                                "sense_id": "2ebfd206-34f7-3fca-a984-c7f92dca889d",
                                                "text": "Mais l’athée n'a aucune expérience de l’ineffabilité de la Réalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
