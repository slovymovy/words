                    {
                        "sense_id": "ecd96a9f-d4c9-3512-a981-27bcbded30ca",
                        "entry_id": "572339c8-2d61-3c5d-acfd-c79e976b6ca9",
                        "glosses": [
                            "simple past and past participle of slam"
                        ],
                        "tags": [
                            "form-of",
                            "participle",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "5f5f1f4a-d842-4833-88a8-d102969a7109",
                                "sense_id": "ecd96a9f-d4c9-3512-a981-27bcbded30ca",
                                "text": "He was only a little guy and he got absolutely slammed when I burst through the door like a human battering ram. I sent him flying down the hall, then he continued sliding on his back, already unconscious. 'Knock, knock,' I said[…]"
                            },
                            {
                                "example_id": "4043ae59-8390-4a4e-81f3-4d7183f4a3a1",
                                "sense_id": "ecd96a9f-d4c9-3512-a981-27bcbded30ca",
                                "text": "But those who were slammed, truly slammed, were those who had more on the stock side of their portfolios than they should have. It happens, and it happens especially after bull markets, as investors saw in the several years prior[…]"
                            }
                        ]
                    }
