                                        "entry_id": "d4459580-2a82-3ae1-963c-02fb7baad85b",
                                        "glosses": [
                                            "Technique d'imagerie employant des ultrasons utilisée en médecine, en exploration vétérinaire ou dans l’industrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "770d7c12-59b0-4121-bf91-1b828036b31d",
                                                "sense_id": "674d5610-b7a2-3faf-b9e0-b15fe0780092",
                                                "text": "On réalisera aussi une échographie qui pourra soit être normale soit retrouver un épanchement dans le Douglas, des ovaires dystrophiques, des images évocatrices d’hydrosalpinx."
                                            },
                                            {
                                                "example_id": "d0165ed7-1c47-4920-bb04-6b4e7b1c3dcc",
                                                "sense_id": "674d5610-b7a2-3faf-b9e0-b15fe0780092",
                                                "text": "L’échographie mammaire doit être intégrée dans la consultation sénologique."
                                            },
                                            {
                                                "example_id": "386ad493-f40d-4f36-a827-81a7071e83f1",
                                                "sense_id": "674d5610-b7a2-3faf-b9e0-b15fe0780092",
                                                "text": "L’échographie cardiaque transthoracique (présence de valves remaniées ou/et de végétations) et les hémocultures confirment le diagnostic évoqué par la clinique : streptococcémies, staphylococcémies, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "153f7d25-ba85-3eb4-aca6-55ec28a0e3e0",
                                        "entry_id": "d4459580-2a82-3ae1-963c-02fb7baad85b",
                                        "glosses": [
                                            "Image qui en découle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
