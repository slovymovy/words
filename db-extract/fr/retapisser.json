                ],
                "senses": [
                    {
                        "sense_id": "231a8d1f-31e8-3378-861b-ca54865d30a7",
                        "entry_id": "b5c1e03a-e66f-3bf8-980a-e72dea0aaa06",
                        "glosses": [
                            "Tapisser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "888681f6-6a00-4a79-90ca-9e3194f9a09c",
                                "sense_id": "231a8d1f-31e8-3378-861b-ca54865d30a7",
                                "text": "Vous direz ça à monsieur Dupuis qui a donné des sous pour redécorer, remoquetter, retapisser et remeubler le salon!"
                            },
                            {
                                "example_id": "d58790f7-def3-45da-9606-844fc79e6f6d",
                                "sense_id": "231a8d1f-31e8-3378-861b-ca54865d30a7",
                                "text": "Black Friday et fêtes de fin d'année, il n’y pas meilleures excuses pour retapisser son intérieur à l’effigie de la reine Beyoncé."
                            },
                            {
                                "example_id": "00910162-e947-48c0-96dc-c70ef7e2708f",
                                "sense_id": "231a8d1f-31e8-3378-861b-ca54865d30a7",
                                "text": "Les gens aisés ont peur. Ils patientent, avant de faire retapisser leurs appartements."
                            }
                        ]
                    },
                    {
                        "sense_id": "a991cfda-37bf-3c0f-9787-6884ccbc4f16",
                        "entry_id": "b5c1e03a-e66f-3bf8-980a-e72dea0aaa06",
                        "glosses": [
                            "Reconnaître, identifier."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b3385e36-25b6-45d2-9502-3d566d063f1e",
                                "sense_id": "a991cfda-37bf-3c0f-9787-6884ccbc4f16",
                                "text": "Je préfère pas entrer… Des fois qu’il me retapisse… après, pour prendre la roue, ça devient des fois dur…"
                            },
                            {
                                "example_id": "154c4a3d-e53f-4402-9b45-aff3e5334773",
                                "sense_id": "a991cfda-37bf-3c0f-9787-6884ccbc4f16",
                                "text": "On le retapissait même s’il avait pris la précaution de se lunetter de noir."
                            },
                            {
                                "example_id": "7ccc779c-b5c2-4651-8327-25d82f6b510f",
                                "sense_id": "a991cfda-37bf-3c0f-9787-6884ccbc4f16",
                                "text": "Est-ce qu'ils sont arrivés avec leurs gros sabots ou le gyro deux tons, je ne sais pas. Mais je ne comprends vraiment pas comment les policiers du Raid ont pu se faire retapisser de la sorte."
                            }
                        ]
                    }
                ],
