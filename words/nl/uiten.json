{
    "word_family": [
        "uiting",
        "geuit",
        "uitbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c28efa9c-2ab1-3054-9a0b-cc0a85b566b2",
                    "sense_definition": "het onder woorden brengen of kenbaar maken van gedachten, gevoelens of geluiden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "expressie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge man <w>uitte</w> een luide schreeuw van vreugde toen hij het goede nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "The young man <w>uttered</w> a loud shout of joy when he heard the good news.",
                                "ru": "Молодой человек <w>издал</w> громкий крик радости, когда услышал хорошие новости."
                            }
                        },
                        {
                            "text": "De oppositiepartij wilde haar <w>kritiek uiten</w> op het nieuwe beleid van de regering.",
                            "target_lang_translations": {
                                "en": "The opposition party wanted to <w>express</w> its criticism of the government's new policy.",
                                "ru": "Оппозиционная партия хотела <w>выразить</w> свою критику новой политики правительства."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeggen",
                        "uitbrengen",
                        "voortbrengen",
                        "produceren",
                        "uitspreken",
                        "verwoorden"
                    ],
                    "antonyms": [
                        "verzwijgen",
                        "onderdrukken"
                    ],
                    "common_phrases": [
                        "kritiek uiten",
                        "een wens uiten",
                        "zijn mening uiten"
                    ],
                    "target_lang_definitions": {
                        "en": "to put thoughts, feelings, or sounds into words or make them known",
                        "ru": "выражение или сообщение мыслей, чувств или звуков словами"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "express",
                                "target_lang_sense_clarification": "to make thoughts or feelings known"
                            },
                            {
                                "target_lang_word": "utter",
                                "target_lang_sense_clarification": "to produce a sound or cry with the voice"
                            },
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "to put an opinion or feeling into words"
                            },
                            {
                                "target_lang_word": "vent",
                                "target_lang_sense_clarification": "to give strong expression to an emotion"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "делать мысли или чувства известными"
                            },
                            {
                                "target_lang_word": "высказывать",
                                "target_lang_sense_clarification": "облекать мнение или чувство в слова"
                            },
                            {
                                "target_lang_word": "издавать",
                                "target_lang_sense_clarification": "производить звук или крик голосом"
                            },
                            {
                                "target_lang_word": "изъявлять",
                                "target_lang_sense_clarification": "официально выражать волю или желание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d8837b3-8675-3ac1-bab5-08e00377feba",
                    "sense_definition": "zich <w>uiten</w>: uiting geven aan je eigen innerlijke gevoelens of gedachten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expressie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vindt het vaak erg lastig om <w>zich te uiten</w> in een grote groep mensen.",
                            "target_lang_translations": {
                                "en": "He often finds it very difficult to <w>express himself</w> in a large group of people.",
                                "ru": "Ему часто бывает очень трудно <w>выразить себя</w> в большой группе людей."
                            }
                        },
                        {
                            "text": "Door middel van kunst kan zij <w>zich uiten</w> op een manier die met woorden niet lukt.",
                            "target_lang_translations": {
                                "en": "Through art, she can <w>express herself</w> in a way that is not possible with words.",
                                "ru": "С помощью искусства она может <w>самовыражаться</w> так, как это невозможно сделать словами."
                            }
                        }
                    ],
                    "antonyms": [
                        "binnenvetten"
                    ],
                    "common_phrases": [
                        "zich uiten",
                        "zich creatief uiten",
                        "zich verbaal uiten"
                    ],
                    "target_lang_definitions": {
                        "en": "to express one's own inner feelings or thoughts",
                        "ru": "выражение собственных внутренних чувств или мыслей"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "express oneself",
                                "target_lang_sense_clarification": "to communicate one's personality or feelings"
                            },
                            {
                                "target_lang_word": "speak out",
                                "target_lang_sense_clarification": "to state one's beliefs or feelings openly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выражать себя",
                                "target_lang_sense_clarification": "передавать свою индивидуальность или чувства"
                            },
                            {
                                "target_lang_word": "самовыражаться",
                                "target_lang_sense_clarification": "выражать свою личность через творчество или поведение"
                            },
                            {
                                "target_lang_word": "высказываться",
                                "target_lang_sense_clarification": "открыто заявлять о своих убеждениях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5d874da-af6b-3170-866d-a1d36318fb36",
                    "sense_definition": "volkomen of totaal; gebruikt om een extreme mate van iets aan te duiden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extreem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De situatie was een <w>uiten</w> voorbeeld van hoe bureaucratie volledig mis kan gaan.",
                            "target_lang_translations": {
                                "en": "The situation was an <w>utter</w> example of how bureaucracy can go completely wrong.",
                                "ru": "Ситуация была <w>крайним</w> примером того, как бюрократия может полностью пойти не так."
                            }
                        },
                        {
                            "text": "Zij toonde een <w>uiten</w> gebrek aan respect tijdens de officiële ceremonie.",
                            "target_lang_translations": {
                                "en": "She showed an <w>utter</w> lack of respect during the official ceremony.",
                                "ru": "Она проявила <w>полнейшее</w> отсутствие уважения во время официальной церемонии."
                            }
                        }
                    ],
                    "antonyms": [
                        "gedeeltelijk"
                    ],
                    "common_phrases": [
                        "uiten gebrek aan",
                        "uiten noodzaak"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in versteende uitdrukkingen of formele context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "complete or total; used to indicate an extreme degree of something",
                        "ru": "полный или тотальный; используется для обозначения крайней степени чего-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "utter",
                                "target_lang_sense_clarification": "absolute or complete"
                            },
                            {
                                "target_lang_word": "extreme",
                                "target_lang_sense_clarification": "to a very high degree"
                            },
                            {
                                "target_lang_word": "total",
                                "target_lang_sense_clarification": "complete and absolute"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "крайний",
                                "target_lang_sense_clarification": "в очень высокой степени"
                            },
                            {
                                "target_lang_word": "полнейший",
                                "target_lang_sense_clarification": "абсолютный и завершенный"
                            },
                            {
                                "target_lang_word": "совершенный",
                                "target_lang_sense_clarification": "абсолютный, в значении 'полный'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
