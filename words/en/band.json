    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8648d79-3899-356d-b716-d950f58f8c48",
                    "sense_definition": "A group of musicians who perform music together.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother plays the drums in a rock <w>band</w>.",
                            "target_lang_translations": {
                                "ru": "Мой брат играет на барабанах в рок-<w>группе</w>.",
                                "zh": "我哥哥在一个摇滚<w>乐队</w>里打鼓。"
                            }
                        },
                        {
                            "text": "The <w>band</w> played their most famous song at the end of the concert.",
                            "target_lang_translations": {
                                "ru": "<w>Группа</w> сыграла свою самую известную песню в конце концерта.",
                                "zh": "<w>乐队</w>在音乐会结束时演奏了他们最著名的歌曲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ensemble",
                        "group",
                        "orchestra"
                    ],
                    "common_phrases": [
                        "rock band",
                        "marching band",
                        "boy band",
                        "live band"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа музыкантов, которые исполняют музыку вместе.",
                        "zh": "一起演奏音乐的音乐家团体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гру́ппа",
                                "target_lang_sense_clarification": "музыкальный коллектив"
                            },
                            {
                                "target_lang_word": "анса́мбль",
                                "target_lang_sense_clarification": "коллектив артистов"
                            },
                            {
                                "target_lang_word": "орке́стр",
                                "target_lang_sense_clarification": "большой коллектив музыкантов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乐队",
                                "target_lang_sense_clarification": "音乐表演团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bf439ac-0304-3898-8739-e4e5dbffe8e3",
                    "sense_definition": "A thin, flat strip or loop of material used for fastening, holding things together, or decoration.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "strip_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a rubber <w>band</w> to keep the stack of papers organized.",
                            "target_lang_translations": {
                                "ru": "Она использовала <w>резинку</w>, чтобы держать стопку бумаг в порядке.",
                                "zh": "她用一根<w>橡皮筋</w>把那叠纸整理好。"
                            }
                        },
                        {
                            "text": "He wears a simple gold wedding <w>band</w> on his left hand.",
                            "target_lang_translations": {
                                "ru": "Он носит простое золотое обручальное <w>кольцо</w> на левой руке.",
                                "zh": "他左手上戴着一枚简单的金质结婚<w>戒指</w>。"
                            }
                        }
