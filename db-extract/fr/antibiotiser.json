                "senses": [
                    {
                        "sense_id": "83df4361-9313-3ad1-b42c-43bb4afad29b",
                        "entry_id": "baecb53c-841c-3d98-8064-6baf2420097b",
                        "glosses": [
                            "Soigner aux antibiotiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1952ddd8-c645-45b9-9d3c-c6e551719a3c",
                                "sense_id": "83df4361-9313-3ad1-b42c-43bb4afad29b",
                                "text": "E.B.E. a commencé à éternuer, il s'est donc fait antibiotiser direct..."
                            },
                            {
                                "example_id": "ac3deda1-4fbd-4550-bcce-8acba1c6767d",
                                "sense_id": "83df4361-9313-3ad1-b42c-43bb4afad29b",
                                "text": "Mais effectivement, libre à chacun de se laisser enfourner n'importe quoi dans la tête et dans le corps, vacciner, antibiotiser, aseptiser et lobotomiser comme des veaux en batterie ..."
                            },
                            {
                                "example_id": "45e97da3-b8ee-4449-9b23-8a345c58b53d",
                                "sense_id": "83df4361-9313-3ad1-b42c-43bb4afad29b",
                                "text": "2010 Année ou je m'abstiens d'antibiotiser sans raison médicale réelle le monde, alors que la bactérie est un composant de mon équilibre ..."
                            }
                        ]
                    }
