                "senses": [
                    {
                        "sense_id": "bdcc4404-2efe-3d1d-834d-4b2980fd9052",
                        "entry_id": "3423a94d-ee67-38bd-9837-d3fd9dfcd2dd",
                        "glosses": [
                            "Donner un caractère chiral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a12045af-dab3-49ce-9deb-36aa0be77b84",
                                "sense_id": "bdcc4404-2efe-3d1d-834d-4b2980fd9052",
                                "text": "Il faut un tel retour pour chiraliser les termes du dédoublement de la représentation métaphysique et distinguer entre des affirmations telles que «quelque pierre est dure» et «quelque dure est pierre»."
                            },
                            {
                                "example_id": "366addc6-6c80-4e3b-873d-ad3ccdbae8ff",
                                "sense_id": "bdcc4404-2efe-3d1d-834d-4b2980fd9052",
                                "text": "Celle-ci peut être un catalyseur chiral (comme les enzymes dans le monde du vivant) ou un rayonnement électromagnétique circulairement polarisé, qui peut chiraliser les produits d'une réaction photochimique en détruisant préférentiellement une forme L ou D."
                            },
                            {
                                "example_id": "e8b70680-340d-43bd-83f3-fb40d6d9da73",
                                "sense_id": "bdcc4404-2efe-3d1d-834d-4b2980fd9052",
                                "text": "Pour éviter cet inconvénient il suffit de chiraliser le nématique en le transformant en un cholestérique de long pas 2pm < P < 10pm."
                            }
                        ]
                    }
                ],
