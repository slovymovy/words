                                        "entry_id": "ae448476-7b5f-32f2-af14-c2e17eb1933e",
                                        "glosses": [
                                            "in genere in complicità con altre persone, apparentemente inconsapevoli della gravità del fatto in procinto di compiersi, è un grave scherzo contro qualcuno quindi appunto fatto con cattiveria e crudeltà tali da causare gravi danni, siano essi morali o effettivamente a cose e/o persone, pur credendo di \\\"metterla in ridere\\"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a80b7a0-a064-43e1-bcd2-7e885be4cf28",
                                                "sense_id": "32a413c4-6327-363e-9a92-cb3632f2eae0",
                                                "text": "Cosicché il compare, astutamente avveduto: \"Gliel'hai fatta la carognata, eh...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d9b8637-7504-3654-b3cb-d009a339057f",
                                        "entry_id": "ae448476-7b5f-32f2-af14-c2e17eb1933e",
                                        "glosses": [
                                            "cosa detta con maldicenza"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "667fdbb3-59e4-3cd3-a997-d4c091dad06d",
                                        "entry_id": "ae448476-7b5f-32f2-af14-c2e17eb1933e",
                                        "glosses": [
                                            "mettere in atto un'azione riprovevole contro una o più persone, talvolta per insensata rivalità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6687c73-fd04-47b4-a675-c4ea428b7390",
                                                "sense_id": "667fdbb3-59e4-3cd3-a997-d4c091dad06d",
                                                "text": "\"Mamma mia, gli ha fatto una carognata... Ti garantisco che non la dimentica più\""
                                            }
                                        ]
                                    }
                                ]
                            }
