                        "entry_id": "1a80b9bd-d68a-392d-b7f2-f4c43b29ed0b",
                        "glosses": [
                            "Chausson en matière synthétique porté par-dessus la chaussure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ae5965-6bf3-4103-bf06-e226aef23fd0",
                                "sense_id": "e0132042-1a0b-3b3a-bb39-cc832d7cfc79",
                                "text": "La présente invention concerne un dispositif, permettant de disposer un couvre-chaussure sur une chaussure, qui comprend une barre et un support d’extension pour couvre-chaussure disposé sur une extrémité de la barre."
                            },
                            {
                                "example_id": "3f2f271c-eff6-415b-82de-7b2711b4a59a",
                                "sense_id": "e0132042-1a0b-3b3a-bb39-cc832d7cfc79",
                                "text": "On évite tous ces maux par des couvres-chaussures ou une paire de chaussettes sacrifiée pour recouvrir la chaussure."
                            }
                        ]
                    }
                ],
