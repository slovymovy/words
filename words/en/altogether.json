{
    "word_family": [
        "together"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3712c30b-a660-3bf8-946a-7d139cb0bbd5",
                    "sense_definition": "With everything or everyone included in the final count or sum.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That will be twenty dollars <w>altogether</w>, please.",
                            "target_lang_translations": {
                                "ru": "С вас двадцать долларов <w>всего</w>, пожалуйста.",
                                "zh": "请付<w>总共</w>二十美元。"
                            }
                        },
                        {
                            "text": "There were about fifty people <w>altogether</w> at the wedding.",
                            "target_lang_translations": {
                                "ru": "На свадьбе было <w>всего</w> около пятидесяти человек.",
                                "zh": "婚礼上<w>总共</w>有大约五十人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "in total",
                        "all told",
                        "in all"
                    ],
                    "common_phrases": [
                        "how much altogether",
                        "cost altogether"
                    ],
                    "target_lang_definitions": {
                        "ru": "С учетом всего или всех в итоговом подсчете или сумме.",
                        "zh": "指在最终统计或总数中包含所有事物或人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всего",
                                "target_lang_sense_clarification": "общее количество"
                            },
                            {
                                "target_lang_word": "в общей сложности",
                                "target_lang_sense_clarification": "суммарно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总共",
                                "target_lang_sense_clarification": "用于统计总数"
                            },
                            {
                                "target_lang_word": "合计",
                                "target_lang_sense_clarification": "用于计算总和"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7003bd74-82ac-30f7-a767-f7c52870adfb",
                    "sense_definition": "Considering everything; looking at the situation as a whole.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Altogether</w>, it was a very enjoyable evening despite the rain.",
                            "target_lang_translations": {
                                "ru": "<w>В целом</w>, это был очень приятный вечер, несмотря на дождь.",
                                "zh": "<w>总的来说</w>，尽管下着雨，这仍是一个非常愉快的夜晚。"
                            }
                        },
                        {
                            "text": "The project was difficult, but <w>altogether</w> it was a success.",
                            "target_lang_translations": {
                                "ru": "Проект был трудным, но <w>в общем</w> он прошел успешно.",
                                "zh": "这个项目虽然困难，但<w>总体上</w>是成功的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "all in all",
                        "on the whole",
                        "overall",
                        "generally",
                        "by and large",
                        "in total",
                        "in all"
                    ],
                    "common_phrases": [
                        "taken altogether"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимая во внимание всё; рассматривая ситуацию в целом.",
                        "zh": "考虑到所有因素；从整体上看待情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в целом",
                                "target_lang_sense_clarification": "обобщая"
                            },
                            {
                                "target_lang_word": "в общем",
                                "target_lang_sense_clarification": "не касаясь частностей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总的来说",
                                "target_lang_sense_clarification": "概括性评价"
                            },
                            {
                                "target_lang_word": "总体上",
                                "target_lang_sense_clarification": "从整体角度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ef16dc4-e790-3e17-84e4-86cf2f4decc5",
                    "sense_definition": "Completely, entirely, or without exception.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not <w>altogether</w> sure that this is the right decision.",
                            "target_lang_translations": {
                                "ru": "Я не <w>совсем</w> уверен, что это правильное решение.",
                                "zh": "我并不<w>完全</w>确定这是正确的决定。"
                            }
                        },
                        {
                            "text": "The noise from the street stopped <w>altogether</w> after midnight.",
                            "target_lang_translations": {
                                "ru": "Шум с улицы прекратился <w>полностью</w> после полуночи.",
                                "zh": "午夜过后，街上的噪音<w>完全</w>消失了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "completely",
                        "entirely",
                        "totally",
                        "wholly",
                        "utterly",
                        "fully",
                        "quite"
                    ],
                    "antonyms": [
                        "partially",
                        "partly"
                    ],
                    "common_phrases": [
                        "not altogether",
                        "altogether different",
                        "altogether new",
                        "altogether too"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью, целиком или совершенно.",
                        "zh": "完全地、彻底地或毫无例外地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совсем",
                                "target_lang_sense_clarification": "часто при отрицании"
                            },
                            {
                                "target_lang_word": "полностью",
                                "target_lang_sense_clarification": "без остатка"
                            },
                            {
                                "target_lang_word": "совершенно",
                                "target_lang_sense_clarification": "абсолютно"
                            },
                            {
                                "target_lang_word": "всецело",
                                "target_lang_sense_clarification": "книжное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "程度彻底"
                            },
