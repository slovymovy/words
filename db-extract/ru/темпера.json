                    {
                        "translation_id": "38ed1081-788f-4a06-8930-70fce78a7db9",
                        "source_entry_id": "a7445184-a7ae-34fd-a62c-b43d566b0866",
                        "source_sense_description": "краски",
                        "target_lang_word": "détrempe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détrempe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a5f2f05-d7f1-31c3-9f5d-32ffe23c1648",
                                        "entry_id": "bb6e2daf-97db-3b67-8eb0-70ff8b90f3c4",
                                        "glosses": [
                                            "Couleur délayée avec de l’eau et de la colle et dont on se sert pour peindre."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35dad34b-a1fb-4834-8179-059c30a057a8",
                                                "sense_id": "0a5f2f05-d7f1-31c3-9f5d-32ffe23c1648",
                                                "text": "La détrempe s’efface, s’enlève aisément avec de l’eau."
                                            },
                                            {
                                                "example_id": "8aec0e5b-8687-486b-aaba-c7ec11716a31",
                                                "sense_id": "0a5f2f05-d7f1-31c3-9f5d-32ffe23c1648",
                                                "text": "Ce tableau n’est pas peint a l’huile, il n’est qu’en détrempe."
                                            },
                                            {
                                                "example_id": "93a89d84-040d-4bd2-86cb-fcef73ddfc25",
                                                "sense_id": "0a5f2f05-d7f1-31c3-9f5d-32ffe23c1648",
                                                "text": "Peindre à la détrempe."
                                            },
                                            {
                                                "example_id": "417e7ab8-c1bc-408e-a723-057a5e8d4e8e",
                                                "sense_id": "0a5f2f05-d7f1-31c3-9f5d-32ffe23c1648",
                                                "text": "Ces portraits, quoique peints à l’huile, ont un aspect de pastel et de détrempe qui vient de ce qu’on ne vernit pas les tableaux en Espagne, manque de précaution qui a laissé dévorer par l’humidité bien des chefs-d’œuvre regrettables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8063dfa9-36f7-3a9e-a23b-b3b5d6a9d038",
                                        "entry_id": "bb6e2daf-97db-3b67-8eb0-70ff8b90f3c4",
                                        "glosses": [
                                            "Pâte de farine mouillée d’un liquide aqueux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56934dd5-c5f6-4ef3-83ab-68f773afee34",
                                                "sense_id": "8063dfa9-36f7-3a9e-a23b-b3b5d6a9d038",
                                                "text": "On nomme détrempes les mélanges de farine, d’œufs, de beurre et d’eau entrant dans la confection des pâtes."
                                            },
                                            {
                                                "example_id": "4f485fdc-c6e8-4b98-a1af-878074e10c11",
                                                "sense_id": "8063dfa9-36f7-3a9e-a23b-b3b5d6a9d038",
                                                "text": "Retirez bien l’excédent de farine qui pourrait se former lorsque vous tourez la pâte. S'il y a trop de farine, les couches de détrempe ne se colleront pas entre elles et vous aurez du mal à réaliser le feuilletage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13fe5045-6bf1-3b7b-b410-bf9593db7af9",
                                        "entry_id": "bb6e2daf-97db-3b67-8eb0-70ff8b90f3c4",
                                        "glosses": [
                                            "Opération par laquelle on enlève la trempe de l’acier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfe2bbf2-027b-3014-a8d8-87b7aee77951",
                                        "entry_id": "bb6e2daf-97db-3b67-8eb0-70ff8b90f3c4",
                                        "glosses": [
                                            "N'ayant que l'apparence de la réalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e18b89-039f-40e9-97bb-4a18fd500749",
                                                "sense_id": "dfe2bbf2-027b-3014-a8d8-87b7aee77951",
                                                "text": "La brodeuse de madame est devenue bourgeoise, elle est mariée...\n— En détrempe ?.. demanda Josépha.\n— Non, madame, vraiment mariée."
                                            }
                                        ]
                                    }
                                ]
