{
    "word_family": [
        "collapsible",
        "collapsibility"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3908eb0-defa-3de6-a3b9-21de69c52706",
                    "sense_definition": "To break apart and fall down suddenly, often because of a lack of support or structural weakness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_structural_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden bridge <w>collapsed</w> into the river during the heavy storm.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный мост <w>рухнул</w> в реку во время сильного шторма.",
                                "zh": "暴风雨中，那座老木桥<w>倒塌</w>进了河里。",
                                "pl": "Stary drewniany most <w>runął</w> do rzeki podczas silnej burzy."
                            }
                        },
                        {
                            "text": "If you remove that supporting wall, the entire roof might <w>collapse</w>.",
                            "target_lang_translations": {
                                "ru": "Если убрать ту несущую стену, вся крыша может <w>обвалиться</w>.",
                                "zh": "如果你拆掉那堵承重墙，整个屋顶可能会<w>坍塌</w>。",
                                "pl": "Jeśli usuniesz tę ścianę nośną, cały dach może <w>się zawalić</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cave in",
                        "fall down",
                        "crumble",
                        "give way"
                    ],
                    "common_phrases": [
                        "roof collapsed",
                        "building collapsed",
                        "suddenly collapse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушиться и внезапно упасть, часто из-за отсутствия опоры или структурной слабости.",
                        "zh": "指建筑物或结构因缺乏支撑或结构脆弱而突然倒塌。",
                        "pl": "Zawalenie się lub nagłe upadnięcie konstrukcji, często z powodu braku wsparcia lub słabości strukturalnej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рухнуть",
                                "target_lang_sense_clarification": "внезапно упасть"
                            },
                            {
                                "target_lang_word": "обвалиться",
                                "target_lang_sense_clarification": "о стенах, потолках, грунте"
                            },
                            {
                                "target_lang_word": "разрушиться",
                                "target_lang_sense_clarification": "потерять целостность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒塌",
                                "target_lang_sense_clarification": "指建筑物或结构物坍塌"
                            },
                            {
                                "target_lang_word": "坍塌",
                                "target_lang_sense_clarification": "指土石或建筑物崩塌"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "runąć",
                                "target_lang_sense_clarification": "gwałtownie zawalić się"
                            },
                            {
                                "target_lang_word": "zapaść się",
                                "target_lang_sense_clarification": "o stropach, podłogach lub gruncie"
                            },
                            {
                                "target_lang_word": "zawalić się",
                                "target_lang_sense_clarification": "stracić stabilność i upaść"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65424de7-8797-327e-87e2-879fd328a92d",
                    "sense_definition": "To fail suddenly and completely, often referring to systems, organizations, economies, or negotiations.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_structural_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peace talks <w>collapsed</w> after both sides refused to compromise.",
                            "target_lang_translations": {
                                "ru": "Мирные переговоры <w>провалились</w> после того, как обе стороны отказались идти на компромисс.",
                                "zh": "由于双方都拒绝妥协，和平谈判<w>破裂</w>了。",
                                "pl": "Rozmowy pokojowe <w>się załamały</w>, gdy obie strony odmówiły kompromisu."
                            }
                        },
                        {
                            "text": "Many small businesses <w>collapsed</w> during the economic recession.",
                            "target_lang_translations": {
                                "ru": "Многие малые предприятия <w>потерпели крах</w> во время экономического спада.",
                                "zh": "经济衰退期间，许多小企业<w>崩溃</w>了。",
                                "pl": "Wiele małych firm <w>upadło</w> podczas recesji gospodarczej."
                            }
                        }
                    ],
                    "synonyms": [
                        "fail",
                        "break down",
                        "crash"
                    ],
                    "common_phrases": [
                        "economy collapsed",
                        "negotiations collapsed",
                        "government collapsed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно и полностью потерпеть неудачу (о системах, организациях, экономике или переговорах).",
                        "zh": "指系统、组织、经济或谈判等突然彻底失败。",
                        "pl": "Nagłe i całkowite niepowodzenie systemów, organizacji, gospodarek lub negocjacji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рухнуть",
                                "target_lang_sense_clarification": "об экономике, режиме"
                            },
                            {
                                "target_lang_word": "потерпеть крах",
                                "target_lang_sense_clarification": "о бизнесе, надеждах"
                            },
                            {
                                "target_lang_word": "провалиться",
                                "target_lang_sense_clarification": "о переговорах, планах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "崩溃",
                                "target_lang_sense_clarification": "指系统或经济彻底瓦解"
                            },
                            {
                                "target_lang_word": "破裂",
                                "target_lang_sense_clarification": "指谈判或关系中断"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "załamać się",
                                "target_lang_sense_clarification": "o systemach, negocjacjach lub gospodarce"
                            },
                            {
                                "target_lang_word": "upaść",
                                "target_lang_sense_clarification": "o firmach lub reżimach"
                            },
                            {
                                "target_lang_word": "ponieść klęskę",
                                "target_lang_sense_clarification": "o planach lub przedsięwzięciach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c4b4b57-78c6-3039-963c-7a3cf672543d",
                    "sense_definition": "To fall down and become unconscious or very weak, usually due to illness or exhaustion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marathon runner <w>collapsed</w> from exhaustion just after crossing the finish line.",
                            "target_lang_translations": {
                                "ru": "Марафонец <w>упал без сил</w> от истощения сразу после пересечения финишной черты.",
                                "zh": "马拉松选手刚冲过终点线就因精疲力竭而<w>虚脱</w>倒地。",
                                "pl": "Maratończyk <w>padł z wycieńczenia</w> tuż po przekroczeniu linii mety."
                            }
                        },
                        {
                            "text": "He almost <w>collapsed</w> on the floor when he heard the shocking news.",
                            "target_lang_translations": {
                                "ru": "Он чуть не <w>осел</w> на пол, когда услышал шокирующую новость.",
                                "zh": "听到那个震惊的消息时，他几乎<w>瘫倒</w>在地。",
                                "pl": "Prawie <w>osunął się</w> na podłogę, gdy usłyszał szokujące wieści."
                            }
                        }
                    ],
                    "synonyms": [
                        "faint",
                        "pass out"
                    ],
                    "common_phrases": [
                        "collapsed from exhaustion",
                        "collapsed on the floor",
                        "nearly collapsed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упасть и потерять сознание или сильно ослабеть, обычно из-за болезни или истощения.",
                        "zh": "指因疾病、极度疲劳或虚弱而突然倒下或失去知觉。",
                        "pl": "Upadek i utrata przytomności lub znaczne osłabienie, zazwyczaj z powodu choroby lub wyczerpania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свалиться",
                                "target_lang_sense_clarification": "разг. упасть от болезни или усталости"
                            },
                            {
                                "target_lang_word": "упасть без сил",
                                "target_lang_sense_clarification": "от изнеможения"
                            },
                            {
                                "target_lang_word": "осесть",
                                "target_lang_sense_clarification": "медленно опуститься на пол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚脱",
                                "target_lang_sense_clarification": "指因极度疲劳而倒下"
                            },
                            {
                                "target_lang_word": "晕倒",
                                "target_lang_sense_clarification": "指失去知觉"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zasłabnąć",
                                "target_lang_sense_clarification": "stracić siły lub przytomność"
                            },
                            {
                                "target_lang_word": "paść z wycieńczenia",
                                "target_lang_sense_clarification": "upaść z powodu skrajnego zmęczenia"
                            },
                            {
                                "target_lang_word": "zemdleć",
                                "target_lang_sense_clarification": "stracić przytomność"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fad384f-4b33-3d56-a5f4-d09b2a4ec7b4",
                    "sense_definition": "To fold something compactly into a smaller size for storage or transport.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_compression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>collapse</w> the table to make more room in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>сложить</w> стол, чтобы освободить место на кухне.",
                                "zh": "你可以把桌子<w>折叠</w>起来，以便在厨房腾出更多空间。",
                                "pl": "Możesz <w>złożyć</w> stół, aby zrobić więcej miejsca w kuchni."
                            }
                        },
                        {
                            "text": "Please <w>collapse</w> the stroller before you get on the bus.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>сложите</w> коляску перед тем, как войти в автобус.",
                                "zh": "上公交车前请把婴儿车<w>折叠</w>好。",
                                "pl": "Proszę <w>złożyć</w> wózek przed wejściem do autobusu."
                            }
                        }
                    ],
                    "synonyms": [
                        "fold",
                        "fold up"
                    ],
                    "antonyms": [
                        "expand"
                    ],
                    "common_phrases": [
                        "collapse the chair",
                        "collapse the box",
                        "easy to collapse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компактно сложить что-либо для хранения или транспортировки.",
                        "zh": "指将物品折叠成较小的尺寸以便于存放或运输。",
                        "pl": "Złożenie czegoś w sposób kompaktowy w celu przechowywania lub transportu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложить",
                                "target_lang_sense_clarification": "сделать компактным (мебель)"
                            },
                            {
                                "target_lang_word": "свернуть",
                                "target_lang_sense_clarification": "скатать (палатку, ковер)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折叠",
                                "target_lang_sense_clarification": "指将物品收拢变小"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "złożyć",
                                "target_lang_sense_clarification": "zmniejszyć rozmiar przedmiotu"
                            },
                            {
                                "target_lang_word": "zwinąć",
                                "target_lang_sense_clarification": "zwinąć w rulon lub złożyć"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab9c7a69-9338-3f59-b6cf-6d645c9c07d4",
                    "sense_definition": "To hide the details or sub-items of a list or menu in a computer interface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_compression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Click the minus sign to <w>collapse</w> the folder and hide its contents.",
                            "target_lang_translations": {
                                "ru": "Нажмите на знак минуса, чтобы <w>свернуть</w> папку и скрыть её содержимое.",
                                "zh": "点击减号图标即可<w>折叠</w>文件夹并隐藏其内容。",
                                "pl": "Kliknij znak minus, aby <w>zwinąć</w> folder i ukryć jego zawartość."
                            }
                        },
                        {
                            "text": "Users can expand or <w>collapse</w> the navigation menu on the website.",
                            "target_lang_translations": {
                                "ru": "Пользователи могут развернуть или <w>свернуть</w> навигационное меню на сайте.",
                                "zh": "用户可以在网站上展开或<w>折叠</w>导航菜单。",
                                "pl": "Użytkownicy mogą rozwijać lub <w>zwijać</w> menu nawigacyjne na stronie."
                            }
                        }
                    ],
                    "antonyms": [
                        "expand"
                    ],
                    "common_phrases": [
                        "collapse the menu",
                        "collapse all"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрыть детали или подпункты списка или меню в компьютерном интерфейсе.",
                        "zh": "在计算机界面中，隐藏列表或菜单的详细信息或子项。",
                        "pl": "Ukrycie szczegółów lub podpunktów listy lub menu w interfejsie komputerowym."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свернуть",
                                "target_lang_sense_clarification": "комп. скрыть содержимое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折叠",
                                "target_lang_sense_clarification": "指隐藏菜单或列表内容"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zwinąć",
                                "target_lang_sense_clarification": "ukryć zawartość menu lub listy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36ca7512-2bca-3da1-b185-b0870cff74e4",
                    "sense_definition": "The sudden failure, falling down, or breakdown of a structure, system, or person's health.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_structural_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>collapse</w> of the banking system caused panic across the country.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>крах</w> банковской системы вызвал панику по всей стране.",
                                "zh": "银行系统的突然<w>崩溃</w>在全国范围内引发了恐慌。",
                                "pl": "Nagła <w>zapaść</w> systemu bankowego wywołała panikę w całym kraju."
                            }
                        },
                        {
                            "text": "Engineers are investigating the cause of the bridge <w>collapse</w>.",
                            "target_lang_translations": {
                                "ru": "Инженеры расследуют причину <w>обрушения</w> моста.",
                                "zh": "工程师们正在调查这座桥梁<w>倒塌</w>的原因。",
                                "pl": "Inżynierowie badają przyczynę <w>zawalenia się</w> mostu."
                            }
                        }
                    ],
                    "synonyms": [
                        "breakdown",
                        "downfall",
                        "failure"
                    ],
                    "common_phrases": [
                        "economic collapse",
                        "sudden collapse",
                        "state of collapse",
                        "imminent collapse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный отказ, падение или разрушение структуры, системы или здоровья человека.",
                        "zh": "指结构、系统或个人健康的突然失败、倒塌或崩溃。",
                        "pl": "Nagłe niepowodzenie, zawalenie się lub załamanie struktury, systemu lub zdrowia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "финансовый, системный"
                            },
                            {
                                "target_lang_word": "обрушение",
                                "target_lang_sense_clarification": "зданий, конструкций"
                            },
                            {
                                "target_lang_word": "обвал",
                                "target_lang_sense_clarification": "цен, грунта"
                            },
                            {
                                "target_lang_word": "коллапс",
                                "target_lang_sense_clarification": "медицинский, транспортный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "崩溃",
                                "target_lang_sense_clarification": "指系统或经济的瓦解"
                            },
                            {
                                "target_lang_word": "倒塌",
                                "target_lang_sense_clarification": "指建筑物的坍塌"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zapaść",
                                "target_lang_sense_clarification": "stan załamania systemu lub zdrowia"
                            },
                            {
                                "target_lang_word": "założenie",
                                "target_lang_sense_clarification": "proces zawalenia się konstrukcji"
                            },
                            {
                                "target_lang_word": "upadek",
                                "target_lang_sense_clarification": "koniec istnienia systemu lub organizacji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}