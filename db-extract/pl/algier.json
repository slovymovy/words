                                            {
                                                "example_id": "6152bd79-5ebc-4523-84ae-c5e5ae427b0e",
                                                "sense_id": "52c22156-17ae-3d9d-9ae1-685c358eed05",
                                                "text": "Wir fahren nach Algier."
                                            },
                                            {
                                                "example_id": "2dfecd8a-70c4-4878-a94e-9d5897ef5d69",
                                                "sense_id": "52c22156-17ae-3d9d-9ae1-685c358eed05",
                                                "text": "„Auch nach Aufhebung des Ausnahmezustands im Jahr 2011 verboten die Behörden weiterhin Demonstrationen in Algier und beriefen sich dabei auf ein Dekret aus dem Jahr 2001.“"
                                            },
                                            {
                                                "example_id": "3826a311-9614-4a96-b3f8-b4c74ca5d823",
                                                "sense_id": "52c22156-17ae-3d9d-9ae1-685c358eed05",
                                                "text": "„Da er Großadmiral von Frankreich ist, besichtigt er die Flotte, die nach Algier in See sticht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
