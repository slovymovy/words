                "senses": [
                    {
                        "sense_id": "e188a942-defd-3769-b5f0-a88e6765c549",
                        "entry_id": "675f5767-6e84-3242-a671-a18daf889f26",
                        "glosses": [
                            "eine besondere Leistung, ein besonders gelungenes Exemplar (Stück)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df02a6fc-a273-4e72-b146-284938f30a95",
                                "sense_id": "e188a942-defd-3769-b5f0-a88e6765c549",
                                "text": "Die Glanzstücke der Ausstellung sind Miniaturen aus dem 17. Jahrhundert."
                            },
                            {
                                "example_id": "a3ce8598-c2b1-4ecc-968d-9baba58ec38b",
                                "sense_id": "e188a942-defd-3769-b5f0-a88e6765c549",
                                "text": "„Der erste Auftritt Immels auf der Bühne des Vordergrundes im Roman war als ein Glanzstück naturalistischer Darstellung bezeichnet worden.“"
                            },
                            {
                                "example_id": "f3cda31e-44cf-44b8-a4c8-84c7c18fe570",
                                "sense_id": "e188a942-defd-3769-b5f0-a88e6765c549",
                                "text": "„Der neuerbaute Konzertsaal soll eingeweiht werden, dessen Glanzstück die ebenfalls funkelnagelneue Konzertorgel darstellt.“"
                            },
                            {
                                "example_id": "6a876d49-2a7e-446c-be0c-68dad973d6b4",
                                "sense_id": "e188a942-defd-3769-b5f0-a88e6765c549",
                                "text": "„Das Glanzstück jedoch stand in der Fensternische: eine Statue des heiligen Petrus!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
