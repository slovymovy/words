                    {
                        "translation_id": "124d1873-1044-463f-960b-909623501e1b",
                        "source_entry_id": "e05a78e6-c449-3a7b-bf1c-80844bd88f18",
                        "source_sense_id": "4c1a0941-60a4-3437-9587-b84a4e54e42d",
