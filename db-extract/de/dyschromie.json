                "senses": [
                    {
                        "sense_id": "729c6cd7-2799-323f-a7ac-e9d2408b1ac1",
                        "entry_id": "15a2a3f8-ed04-3dc6-8975-b0133187726f",
                        "glosses": [
                            "Störung der Pigmentierung der Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c941d2c-f01e-4a3e-afb1-89f09c59416f",
                                "sense_id": "729c6cd7-2799-323f-a7ac-e9d2408b1ac1",
                                "text": "„Die Dyschromie der Gesichtshaut ist eine Hautveränderung durch Einlagerung von exogenen oder endogenen Nichtmelaninpigmenten bzw. Substanzen.“"
                            },
                            {
                                "example_id": "a0778a2b-6a34-4818-bc3a-aa5583629ab6",
                                "sense_id": "729c6cd7-2799-323f-a7ac-e9d2408b1ac1",
                                "text": "„Wenn einzelne Hautareale heller oder dunkler sind als ihre Umgebung oder die gesamte Haut heller oder dunkler als normales Hautkolorit ist, spricht man von einer Dyschromie.“"
                            },
                            {
                                "example_id": "9af36069-f00f-4a68-8ceb-be7f2ccc9179",
                                "sense_id": "729c6cd7-2799-323f-a7ac-e9d2408b1ac1",
                                "text": "„Die Vitiligo ist eine Dyschromie, die sich durch das Auftreten von weißen, farblosen oder sehr schwach gefärbten, scharf begrenzten Flecken auszeichnet, die manchmal von einer mehr oder weniger ausgedehnten, hyperpigmentierten Zone umgeben sind. Die Anomalie ist nicht kongenital.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
