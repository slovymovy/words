                "senses": [
                    {
                        "sense_id": "abebd48a-70c4-3fd2-b058-c1c7f76e828c",
                        "entry_id": "99a31bb2-ffbb-3ff8-9262-7168b642334a",
                        "glosses": [
                            "Gefühl der Angst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019e94f3-19f8-45a1-aab5-b0650f985371",
                                "sense_id": "abebd48a-70c4-3fd2-b058-c1c7f76e828c",
                                "text": "„Wenn man tief ein- und ausatmete, sollte jegliches Angstgefühl verschwinden.“"
                            },
                            {
                                "example_id": "6b79e6c8-3c25-4612-b6d0-6517b7da57f1",
                                "sense_id": "abebd48a-70c4-3fd2-b058-c1c7f76e828c",
                                "text": "„Ich wurde ein gewisses Angstgefühl der Inquisition gegenüber nicht los, und mir schien, als seien mir bereits einige Spitzel auf den Fersen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
