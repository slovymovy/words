                        "sense_id": "a72f54db-ab7f-3d21-8e43-34ab465c32a4",
                        "entry_id": "6f7f9da8-cd1c-3c3e-9632-f35848072f19",
                        "glosses": [
                            "A type of hood historically worn by those infected with whooping cough, to keep a warm head."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3253edb5-976e-49a8-ac20-868b52ed859c",
                                "sense_id": "a72f54db-ab7f-3d21-8e43-34ab465c32a4",
                                "text": "The coqueluchon or coqueluche was a kind of hood very generally worn at certain periods of the year, which seems to have given its name to the hooping-cough, because those who were attacked by that illness wore a coqueluche or monk's hood to keep their head warm."
                            },
                            {
                                "example_id": "e9d3d72f-503a-42b4-9a2e-709f6c901373",
                                "sense_id": "a72f54db-ab7f-3d21-8e43-34ab465c32a4",
                                "text": "[…] because the sick wore a coqueluche on their heads (as a part of the treatment prescribed) certainly owes its currency to Dr. Short, but he appears to have relied upon the authority of Schenkius […]"
                            }
                        ]
                    }
