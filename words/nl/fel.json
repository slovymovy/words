                    "sense_id": "c4324268-37aa-3acd-b965-3a9f3d054e71",
                    "sense_definition": "Hevig, scherp of gepassioneerd van aard (bijvoorbeeld bij pijn, kritiek of emoties).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was <w>felle</w> kritiek op de nieuwe plannen van de regering.",
                            "target_lang_translations": {
                                "en": "There was <w>fierce</w> criticism of the government's new plans.",
                                "ru": "В адрес новых планов правительства звучала <w>резкая</w> критика.",
                                "pl": "Pojawiła się <w>ostra</w> krytyka nowych planów rządu.",
                                "de": "Es gab <w>heftige</w> Kritik an den neuen Plänen der Regierung.",
                                "fr": "Il y a eu de <w>vives</w> critiques à l'encontre des nouveaux plans du gouvernement.",
                                "it": "Ci sono state <w>feroci</w> critiche ai nuovi piani del governo.",
                                "cs": "Na nové vládní plány se snesla <w>ostrá</w> kritika.",
                                "tr": "Hükümetin yeni planlarına yönelik <w>sert</w> eleştiriler vardı.",
                                "es": "Hubo una <w>feroz</w> crítica a los nuevos planes del gobierno."
                            }
                        },
                        {
                            "text": "Hij voelde plotseling een <w>felle</w> pijn in zijn linkerzij.",
                            "target_lang_translations": {
                                "en": "He suddenly felt a <w>sharp</w> pain in his left side.",
                                "ru": "Он внезапно почувствовал <w>острую</w> боль в левом боку.",
                                "pl": "Nagle poczuł <w>ostry</w> ból w lewym boku.",
                                "de": "Er spürte plötzlich einen <w>stechenden</w> Schmerz in seiner linken Seite.",
                                "fr": "Il a soudainement ressenti une douleur <w>aiguë</w> au flanc gauche.",
                                "it": "Ha sentito improvvisamente un dolore <w>acuto</w> al fianco sinistro.",
                                "cs": "Náhle ucítil <w>ostrou</w> bolest v levém boku.",
                                "tr": "Sol böğründe aniden <w>keskin</w> bir acı hissetti.",
                                "es": "De repente sintió un dolor <w>agudo</w> en el costado izquierdo."
                            }
                        }
