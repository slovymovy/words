{
    "word_family": [
        "roeren",
        "roering",
        "verroering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f9bab85-36bc-3d4d-a419-83ee5344307d",
                    "sense_definition": "zich <w>verroeren</w>: in beweging komen, vaak gebruikt in een ontkennende context",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het roofdier dat op de loer lag <w>verroerde</w> zich niet tot de prooi voldoende dicht genaderd was.",
                            "target_lang_translations": {
                                "en": "The predator lying in wait did not <w>move</w> until the prey had approached closely enough."
                            }
                        },
                        {
                            "text": "Je moet <w>geen vinger verroeren</w> terwijl de fotograaf deze belangrijke foto van ons maakt.",
                            "target_lang_translations": {
                                "en": "You must not <w>stir</w> a finger while the photographer takes this important photo of us."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewegen"
                    ],
                    "antonyms": [
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "geen vinger verroeren",
                        "zich niet verroeren",
                        "geen vin verroeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to move or stir, often used in a negative context (not moving at all)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to change position or posture"
                            },
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to make a slight physical movement"
                            },
                            {
                                "target_lang_word": "budge",
                                "target_lang_sense_clarification": "to move even a little bit, usually in the negative"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b376d9fe-203e-38a4-a103-b3de1f5329b4",
                    "sense_definition": "iets of iemand in beweging brengen of van plaats doen veranderen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zware kast was met geen mogelijkheid te <w>verroeren</w> door de smalle gang.",
                            "target_lang_translations": {
                                "en": "The heavy cabinet could not be <w>moved</w> through the narrow hallway by any means."
                            }
                        },
                        {
                            "text": "Hij probeerde de grote steen te <w>verroeren</w> om te zien wat eronder lag.",
                            "target_lang_translations": {
                                "en": "He tried to <w>budge</w> the large stone to see what lay beneath it."
                            }
                        }
                    ],
                    "synonyms": [
                        "verplaatsen",
                        "verschuiven"
                    ],
                    "common_phrases": [
                        "niet te verroeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to move something or someone, or to cause them to change position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to set something in motion or change its place"
                            },
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "to move something slightly from one place to another"
                            },
                            {
                                "target_lang_word": "budge",
                                "target_lang_sense_clarification": "to cause something heavy or stuck to move"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93b2c2d2-b349-3afd-86e7-ae727accac3f",
                    "sense_definition": "iemand emotioneel raken of ontroeren",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn droevige verhaal over het verleden wist de harten van het publiek diep te <w>verroeren</w>.",
                            "target_lang_translations": {
                                "en": "His sad story about the past managed to deeply <w>move</w> the hearts of the audience."
                            }
                        },
                        {
                            "text": "De prachtige muziek kon zelfs de meest ongevoelige persoon <w>verroeren</w>.",
                            "target_lang_translations": {
                                "en": "The beautiful music could <w>touch</w> even the most insensitive person."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontroeren",
                        "aangrijpen",
                        "raken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to touch someone emotionally or to move them to tears"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to arouse the feelings or compassion of"
                            },
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "to affect someone emotionally"
                            },
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to rouse or excite a particular emotion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
