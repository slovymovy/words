                                    {
                                        "sense_id": "51525743-59d8-3c0c-acc8-7463306acba2",
                                        "entry_id": "b4d1eabb-a7d0-3dfe-9d00-81d576e4ea2c",
                                        "glosses": [
                                            "Celui, celle qui fait des caricatures."
                                        ],
                                        "tags": [
                                            "Dessin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04f774bf-986b-4177-8272-c9a324f74417",
                                                "sense_id": "51525743-59d8-3c0c-acc8-7463306acba2",
                                                "text": "Honoré Daumier, peintre, sculpteur et caricaturiste, l’a dessiné aux côtés du ministre de l’Intérieur et de Soult, le chef du gouvernement, dans une caricature intitulée « Les blanchisseurs »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7c4a8e2-4f8b-4292-97a3-eeb1cbbf29f5",
                        "source_entry_id": "ea0104a1-5f69-3f12-a254-99970b9e89b8",
                        "source_sense_id": "3b497163-1424-3024-8bdf-4fe802cb3d89",
                        "target_lang_word": "Karikaturist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karikaturist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                        "entry_id": "d7ce6d78-5cfd-3527-b2b8-74c2ea4b3191",
                                        "glosses": [
                                            "jemand, der Karikaturen zeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b89be371-ed83-4448-a5db-012de3a0f07f",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "Der Karikaturist Jonathan Shapiro, bekannt als Zapiro, hatte die obige Karikatur zu verantworten."
                                            },
                                            {
                                                "example_id": "f7374c4a-c8e9-4811-af80-61e64dbbc2ad",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "„Der bekannte griechische Karikaturist steckt Angela Merkel in finster anmutende Uniformen, setzt sie in Panzer und lässt sie griechische Buben erschrecken.“"
                                            },
                                            {
                                                "example_id": "2824949e-809e-42e1-ba37-bd4d0f209cc3",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "„Vielmehr offenbart der Karikaturist meist den unbewußten Wunsch, seinen Gegner entstellt und häßlich zu sehen.“"
                                            },
                                            {
                                                "example_id": "ff6c1cc2-dca9-4819-bdec-6d6f17e3096b",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "„Die ersten materiellen Früchte seiner literarischen Arbeiten ergänzen nun etwas seine Honorare als Karikaturist und Musikkritiker.“"
                                            },
                                            {
                                                "example_id": "254afa0a-a3aa-4303-bdb8-189fb0a4833e",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "„In der Vorstellung auswärtiger Karikaturisten ißt der Deutsche nur Sauerkraut und nichts als Sauerkraut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
