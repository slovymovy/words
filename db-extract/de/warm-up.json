                "senses": [
                    {
                        "sense_id": "c19f890f-2bf6-3475-aab6-cd8dc9682f4d",
                        "entry_id": "88b8f9b6-8678-35cc-bc43-ceb23f39237d",
                        "glosses": [
                            "Aufwärmen der Muskulatur durch leichte Übungen, meist vor einem Wettkampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f93196-09b8-4a11-a59a-eb3b4e13c112",
                                "sense_id": "c19f890f-2bf6-3475-aab6-cd8dc9682f4d",
                                "text": "Beim Warm-up behält sie die dicken Socken und die Trainingsjacke an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "21c35085-3c1c-3116-8d49-15731b9b0ae9",
                        "entry_id": "88b8f9b6-8678-35cc-bc43-ceb23f39237d",
                        "glosses": [
                            "letzte Trainingseinheit vor einem Rennen, während der die Motoren noch einmal geprüft werden"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "673c2cec-9760-41ce-93ac-7460c918ab68",
                                "sense_id": "21c35085-3c1c-3116-8d49-15731b9b0ae9",
                                "text": "Das halbstündige Warm-up sind die sonntäglichen Vormittagsrunden vor dem Rennen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "73776cb0-c833-3c93-99ff-340254bc2239",
                        "entry_id": "88b8f9b6-8678-35cc-bc43-ceb23f39237d",
                        "glosses": [
                            "Phase, in der das Publikum auf die folgende Sendung eingestimmt werden soll"
                        ],
                        "tags": [
                            "Fernsehen"
                        ],
                        "examples": [
                            {
                                "example_id": "c0c3ca63-7bd2-4c47-ac2d-21528f5d55f6",
                                "sense_id": "73776cb0-c833-3c93-99ff-340254bc2239",
                                "text": "Mit von der Partie sind auch die beiden Jung-Moderatoren Karl und Jürgen, die vor der Aufnahme und in Aufnehmepausen für ein stimmungsvolles Warm-up sorgen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31a76a6a-4f98-4041-b650-f54dbaee41f8",
                        "source_entry_id": "88b8f9b6-8678-35cc-bc43-ceb23f39237d",
                        "source_sense_id": "c19f890f-2bf6-3475-aab6-cd8dc9682f4d",
                        "source_sense_description": "Sport: Aufwärmen der Muskulatur durch leichte Übungen, meist vor einem Wettkampf",
                        "target_lang_word": "warm-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warm-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76f74d19-7ac6-3709-ab90-ed8f57a02a56",
                                        "entry_id": "bd172449-1663-331e-b7d8-b8b47c329884",
                                        "glosses": [
                                            "The act of exercising or stretching in preparation for strenuous activity"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d361b2af-8194-4569-9394-9caeccfbfee4",
                                                "sense_id": "76f74d19-7ac6-3709-ab90-ed8f57a02a56",
                                                "text": "If you don't do your warm-ups properly you have a greater chance of injury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c7d570f-d50c-3a5b-bf7f-14a1c86a3141",
                                        "entry_id": "bd172449-1663-331e-b7d8-b8b47c329884",
                                        "glosses": [
                                            "Any act of preparation for a performance"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee392514-1cb3-49e4-a1ef-466e1497c8d9",
                                                "sense_id": "6c7d570f-d50c-3a5b-bf7f-14a1c86a3141",
                                                "text": "Drivers are allowed 5 minutes for warm-up before the race starts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae4bb5f3-ab4d-32ab-98ed-5f58d79aefc7",
                                        "entry_id": "bd172449-1663-331e-b7d8-b8b47c329884",
                                        "glosses": [
                                            "A period of time allocated for performing warm-ups."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce52a77-9c0a-471a-87dc-70f2b50f22ec",
                                                "sense_id": "ae4bb5f3-ab4d-32ab-98ed-5f58d79aefc7",
                                                "text": "Keep a sharp eye on the referee during warm-up to check out his mood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3991195e-a7c2-487b-8d17-b6f2d26204ac",
                        "source_entry_id": "88b8f9b6-8678-35cc-bc43-ceb23f39237d",
                        "source_sense_id": "c19f890f-2bf6-3475-aab6-cd8dc9682f4d",
                        "source_sense_description": "Sport: Aufwärmen der Muskulatur durch leichte Übungen, meist vor einem Wettkampf",
                        "target_lang_word": "échauffement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "échauffement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                                        "glosses": [
                                            "Action d’échauffer ou de s’échauffer ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba6a9e4-527d-4543-9c24-41ccbfd2791b",
                                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                                "text": "La centrale thermique de Vernou-sur-Seine est située approximativement au milieu du bief. D'une puissance totale de 750 MW, elle prélève lorsqu’elle fonctionne à pleine charge, un débit de 28 m³/s qu'elle réchauffe de 7°C, ce qui correspond à un échauffement théorique de la Seine d'environ 2°C pour le débit moyen annuel de 120 m³/s."
                                            },
                                            {
                                                "example_id": "8874d92e-08ba-4c02-b37b-e3df577f6552",
                                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                                "text": "Car tout bourgeois, dans l’échauffement de sa jeunesse, ne fût-ce qu’un jour, une minute, s’est cru capable d’immenses passions, de hautes entreprises."
                                            },
                                            {
                                                "example_id": "d2ebaddb-ddd3-4078-bd7e-2705b4dd5c52",
                                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                                "text": "Compte tenu de la durée de vie de certains radioéléments, le principal atout d’une pile nucléaire tient dans son incomparable durée d’utilisation… qu’on s’en serve ou pas ; et cela sans échauffement de la pile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742fce89-dcfd-3e9b-99f5-c320f5b85134",
                                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                                        "glosses": [
                                            "Course destinée à s’échauffer, et de manière général mouvements destinés à se préparer à un effort physique, permettant de diminuer le risque d’accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a4a7ec-96f4-480c-b9ce-e23886c37d59",
                                                "sense_id": "742fce89-dcfd-3e9b-99f5-c320f5b85134",
                                                "text": "Ainsi, un échauffement de 5,2 km est organisé par l’Unesco, baptisé \"course du petit-déjeuner\" dès 8 h 30."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fce114bb-3226-3f72-a4e8-92e2168ce8e0",
                                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                                        "glosses": [
                                            "Trouble intestinal qui se manifeste par la constipation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ac40c4c-e8d1-3999-8c9e-09db36df0f2b",
                                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                                        "glosses": [
                                            "Pourriture partielle d’un bois récemment abattu par des champignons lignivores, formant des taches noires et blanches typiques ; le bois doté d’échauffure est dit échauffé."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ca55c6-942d-4675-a38e-9ef678b436af",
                                                "sense_id": "9ac40c4c-e8d1-3999-8c9e-09db36df0f2b",
                                                "text": "L'échauffure est le résultat de lʼéchauffement du bois dû à la fermentation de la sève ou à une attaque par des champignons lignivores. Le bois échauffé est utilisé pour ses qualités décoratives. La cause de l'échauffement doit alors être neutralisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
