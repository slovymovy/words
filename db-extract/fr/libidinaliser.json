                "senses": [
                    {
                        "sense_id": "d23fcf81-1839-313b-83fc-c5db16e15be8",
                        "entry_id": "588db0c7-6b12-3e4b-be16-d49773432777",
                        "glosses": [
                            "Donner un caractère libidinal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "808b9c38-0ade-41e3-9eef-f5675ae1e957",
                                "sense_id": "d23fcf81-1839-313b-83fc-c5db16e15be8",
                                "text": "Tout comme c’est le cas de l’alimentation où c’est à la mère qu’il revient de libidinaliser le tractus digestif, c’est encore à la mère qu’il revient de libidinaliser le sommeil."
                            },
                            {
                                "example_id": "7a121bd8-c4f0-4ca8-96a6-b02a7a1000ed",
                                "sense_id": "d23fcf81-1839-313b-83fc-c5db16e15be8",
                                "text": "Est-ce que cela n’exprime pas le désir de situer la psychanalyste du côté du Sur-Moi, de supprimer en elle tout ce qui pourrait la libidinaliser à l’excès ?"
                            },
                            {
                                "example_id": "14d3774b-5e74-4399-b68d-66a867c12093",
                                "sense_id": "d23fcf81-1839-313b-83fc-c5db16e15be8",
                                "text": "Les représentations de relations sont a-conflictuelles, éventuellement – et c’est un élément précieux – libidinalisées (« Y sont en train d’s’embrasser »)."
                            }
                        ]
                    }
                ],
