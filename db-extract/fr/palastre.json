                    {
                        "sense_id": "2e8fc063-b6b0-3fc2-8aad-f969253ca4e0",
                        "entry_id": "b4b8ac9a-a9fb-33cf-baca-60523fe69ffc",
                        "glosses": [
                            "Boîtier extérieur d’une serrure. (Note : La partie non visible se nomme couverture.)"
                        ],
                        "tags": [
                            "Serrurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "177357f1-7bd5-45cd-bfb8-df25422ffadc",
                                "sense_id": "2e8fc063-b6b0-3fc2-8aad-f969253ca4e0",
                                "text": "Dispositif de verrouillage à palastres renforcés, qui confère à la porte une plus grande résistance."
                            },
                            {
                                "example_id": "067a7520-4e1f-4a55-afe7-5bfea9ceb269",
                                "sense_id": "2e8fc063-b6b0-3fc2-8aad-f969253ca4e0",
                                "text": "Les palastres étincelaient et les pènes grinçaient."
                            },
                            {
                                "example_id": "b3c055cd-d011-463d-a729-e3d201e0d612",
                                "sense_id": "2e8fc063-b6b0-3fc2-8aad-f969253ca4e0",
                                "text": "Son regard tomba sur le palastre luisant de la serrure."
                            },
                            {
                                "example_id": "196d644c-2acb-4ce5-84fc-d0be36bb142c",
                                "sense_id": "2e8fc063-b6b0-3fc2-8aad-f969253ca4e0",
                                "text": "Les obus commençaient à dégringoler autour du bureau de poste d’Eden Quay, toujours pas dessus, lorsque Dillon entra dans le petit bureau, après avoir tourné silencieusement la clé dans le trou du palastre et poussé la porte sur ses gonds, non moins silencieusement."
                            }
                        ]
                    }
