                        "examples": [
                            {
                                "example_id": "bdcb9f1d-55f2-447a-8fbc-b12999f55433",
                                "sense_id": "602506ff-e613-3ded-9cd0-311ee8b056ef",
                                "text": "De Dierenbescherming heeft dertig konijnen gered van een wisse dood op een jachtveld. Een man uit Nuth fokte de dieren tot ze oud genoeg waren en zette ze dan uit in een veld om de dieren af te kunnen schieten."
                            },
                            {
                                "example_id": "d6d0514f-4c5e-4368-ab85-9de3acea59ad",
                                "sense_id": "602506ff-e613-3ded-9cd0-311ee8b056ef",
                                "text": "De politie heeft een jager aangehouden voor vergiftiging van een aantal vogels, waaronder een blauwe kiekendief, meldt Omrop Fryslân. De dode vogels lagen in een jachtveld in Hallum. De politie vond de jager daar in de buurt."
                            }
                        ]
                    }
