                ],
                "senses": [
                    {
                        "sense_id": "8b902697-b1ce-39c0-83eb-5cc6887c76a6",
                        "entry_id": "8386db32-b3c5-309a-88f7-17c20a4643d0",
                        "glosses": [
                            "Planung, Projekt, Vorhaben, Vorstellungen, Ideen, welche kurzfristig nicht und eventuell erst in ferner Zukunft umgesetzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776ba5ba-4431-4e87-848a-78c14b5442c3",
                                "sense_id": "8b902697-b1ce-39c0-83eb-5cc6887c76a6",
                                "text": "Die Idee vom papierlosen Büro ist trotz allen EDV-technischen Fortschritts nach wie vor Zukunftsmusik."
                            },
                            {
                                "example_id": "219ce233-ae3e-42fc-8f0a-8f9da393d53d",
                                "sense_id": "8b902697-b1ce-39c0-83eb-5cc6887c76a6",
                                "text": "Eine CO₂-freie Gesellschaft ist Zukunftsmusik."
                            },
                            {
                                "example_id": "4f82cc01-42d6-4b38-985e-4475be862535",
                                "sense_id": "8b902697-b1ce-39c0-83eb-5cc6887c76a6",
                                "text": "„Im Westen der Stadt soll der künstlich angelegte 45-Kilometer-Kanal entstehen und wie der Bosporus das Schwarze Meer mit dem Marmarameer verbinden.“ […] Was viele Einwohner Istanbuls lange Zeit als reine Zukunftsmusik abgetan haben, wird nun in Angriff genommen."
                            },
                            {
                                "example_id": "6a17eef1-b65b-41f7-8fd6-0ac8457228c7",
                                "sense_id": "8b902697-b1ce-39c0-83eb-5cc6887c76a6",
                                "text": "„Reeder könnten mit Hilfe der Daten ihre Schiffsrouten optimieren, indem Mikroströmungen im Meer so genutzt werden, dass Schiffe energie- und kostensparender fahren. Noch aber ist alles Zukunftsmusik.“"
                            },
                            {
                                "example_id": "af95bfff-3b8e-47d4-b1df-3b08704562e6",
                                "sense_id": "8b902697-b1ce-39c0-83eb-5cc6887c76a6",
                                "text": "„Schiffe der Zukunft sollten daher bereits so gebaut sein, dass sie weniger Energie verbrauchen. Außerdem könnten sie schlichtweg langsamer fahren, um den Energieverbrauch zu reduzieren. Wichtig sind zudem alternative Treibstoffe wie Wasserstoff, Ammoniak oder Batteriestrom.“ […] „Im Augenblick ist das allerdings noch Zukunftsmusik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
