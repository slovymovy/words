                    "sense_id": "f60a2f89-d5cd-3649-8a1f-09571edd534b",
                    "sense_definition": "A person who throws something with great force.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "thrower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hurler</w> launched the heavy stone across the field with impressive strength.",
                            "target_lang_translations": {
                                "nl": "De <w>werper</w> lanceerde de zware steen met indrukwekkende kracht over het veld."
                            }
                        },
                        {
                            "text": "As a skilled <w>hurler</w>, he could throw the javelin further than anyone else.",
                            "target_lang_translations": {
                                "nl": "Als bekwame <w>werper</w> kon hij de speer verder werpen dan wie dan ook."
                            }
