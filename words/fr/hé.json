    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e23bb1d4-43fe-3a77-96b9-c02ec1b31692",
                    "sense_definition": "S'emploie pour appeler ou interpeller quelqu'un familièrement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "appel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hé</w>, viens voir ce qui se passe immédiatement par ici !"
                        },
                        {
                            "text": "<w>Hé</w>, attends-moi une minute s'il te plaît avant de partir !"
                        }
                    ],
                    "synonyms": [
                        "hep",
                        "eh"
                    ],
                    "common_phrases": [
                        "hé l'ami",
                        "hé bien"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "ea950076-9ab8-3883-ae3c-f640054df5e3",
                    "sense_definition": "Exprime la surprise, l'étonnement ou la réaction face à un événement inattendu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hé</w>, bonjour, je ne m'attendais pas à te voir si tôt ce matin !"
                        },
                        {
                            "text": "<w>Hé</w>, mais qu'est-ce que vous faites tous réunis dans cette pièce ?"
                        }
                    ],
                    "synonyms": [
                        "eh",
                        "oh"
                    ],
                    "common_phrases": [
                        "hé quoi"
                    ]
                },
                {
                    "sense_id": "cb7316cb-7fff-3fc8-9df6-7af392d1d18b",
                    "sense_definition": "S'emploie pour avertir, mettre en garde ou intimer l'ordre de prendre garde.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hé</w>, faites attention à ne pas faire tomber ce vase très fragile !"
                        },
                        {
                            "text": "<w>Hé</w>, qu'allez-vous faire avec cette échelle manifestement instable ?"
                        }
                    ],
                    "synonyms": [
                        "attention",
                        "holà"
                    ],
                    "common_phrases": [
                        "hé attention"
                    ]
                },
                {
                    "sense_id": "a8cb3f0a-6b85-3636-98c6-3e0f2e9c1003",
                    "sense_definition": "S'emploie en fin de phrase pour solliciter l'assentiment ou insister sur le propos.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce concert était absolument fantastique hier soir, <w>hé</w> ?"
                        },
                        {
                            "text": "Tu as bien préparé toutes tes affaires pour le voyage, <w>hé</w> ?"
                        }
                    ],
                    "synonyms": [
                        "hein"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Canada, Belgique"
                        }
                    ]
                },
                {
                    "sense_id": "2744ae63-7b23-36cf-999a-b554f9cc7d29",
                    "sense_definition": "Répété pour exprimer une approbation amusée, une demi-adhésion ou une réflexion malicieuse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "approbation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hé</w>, <w>hé</w>, cette proposition n'est pas si mauvaise après tout."
                        },
                        {
                            "text": "<w>Hé</w>, <w>hé</w>, je savais bien que tu finirais par accepter notre invitation."
                        }
                    ],
                    "common_phrases": [
                        "hé hé"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "04f0e3b1-39ec-3fae-b408-774c502568e4",
                    "sense_definition": "Sert à marquer la commisération, la compassion ou la pitié envers quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "compassion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hé</w>, pauvre homme, combien votre triste sort me touche au plus profond du cœur !"
                        },
                        {
                            "text": "<w>Hé</w>, mon Dieu, ayez pitié de ces malheureuses victimes innocentes !"
                        }
                    ],
                    "synonyms": [
                        "hélas"
                    ],
                    "common_phrases": [
                        "hé mon Dieu"
                    ]
                },
                {
                    "sense_id": "b0f5c811-fd3a-3377-8b12-777caacb99e9",
                    "sense_definition": "Sert à exprimer le regret amer, la déploration ou la douleur morale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hé</w>, que je regrette d'avoir prononcé de telles paroles blessantes hier !"
                        },
                        {
                            "text": "<w>Hé</w>, quel immense désespoir s'est soudain abattu sur notre pauvre maison !"
                        }
                    ],
                    "synonyms": [
                        "ah"
                    ]
                }
            ]
        },
