                    {
                        "sense_id": "ae041a33-96a5-3896-9f75-ce1d2787b6c8",
                        "entry_id": "e18de9e4-c638-38b9-a9a2-e2a5e92c7786",
                        "glosses": [
                            "to grant (to); to bestow, to confer (on); to reward, to award (stilted style)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c1897677-42db-36fb-8ba1-3bb0da34c76f",
                        "entry_id": "e18de9e4-c638-38b9-a9a2-e2a5e92c7786",
                        "glosses": [
                            "to visit, to come to see (stilted style or jocular)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9e241560-53fe-4045-a1c9-0437e3abc569",
                                "sense_id": "c1897677-42db-36fb-8ba1-3bb0da34c76f",
                                "text": "Кто к нам пожа́ловал! Каки́ми судьба́ми/су́дьбами?",
                                "translation": "Look who has come to visit! What brings you here?",
                                "english": "Look who has come to visit! What brings you here?"
                            },
                            {
                                "example_id": "234c0556-2d29-40ba-a0d8-d5d1f80a8573",
                                "sense_id": "c1897677-42db-36fb-8ba1-3bb0da34c76f",
                                "text": "добро́ пожа́ловать!",
                                "translation": "Welcome!",
                                "english": "Welcome!"
                            },
                            {
                                "example_id": "adc932aa-413b-430b-8798-5c728492b8ce",
                                "sense_id": "c1897677-42db-36fb-8ba1-3bb0da34c76f",
                                "text": "— Хоть и не во́время пожа́ловали, до́брые лю́ди, — отвеча́ла стару́ха, — не на у́лице же в моро́з стоя́ть вам: войди́те с бо́гом.",
                                "translation": "Ivan Lazhechnikov",
                                "english": "Ivan Lazhechnikov"
                            }
                        ]
                    },
                    {
                        "sense_id": "9146baf2-96a2-3b0a-99e1-241cd186a521",
