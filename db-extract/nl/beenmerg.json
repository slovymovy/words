                ],
                "translations": [
                    {
                        "translation_id": "fed410a8-6c7d-4830-ac72-3237e1f004a6",
                        "source_entry_id": "92360650-6297-33bd-a4b4-b42b28ce2420",
                        "source_sense_id": "207c7b77-6231-37a3-8fb7-3dde4e63fae0",
                        "source_sense_description": "een sponsachtige, rode substantie die zich in het binnenste van beenderen bevindt",
                        "target_lang_word": "Knochenmark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knochenmark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "057b3efc-36ca-3bdb-a457-625c6923d7fa",
                                        "entry_id": "bfc4a08e-c3a7-3eaf-bc7a-d56974df7cd7",
                                        "glosses": [
                                            "weiche Substanz im Kern von Knochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f1c9448-c6e8-4268-b88f-aaae2c241fa8",
                                                "sense_id": "057b3efc-36ca-3bdb-a457-625c6923d7fa",
                                                "text": "Das Knochenmark füllt das Knocheninnere."
                                            },
                                            {
                                                "example_id": "c3d58ae4-a8da-46ca-83ba-29e9dfe5a1d4",
                                                "sense_id": "057b3efc-36ca-3bdb-a457-625c6923d7fa",
                                                "text": "„Beim Eindringen artfremden Eiweißes (Antigene) in das Blut werden in Plasmazellen des Knochenmarks und im lymphatischen Gewebe hochspezifische Abwehrstoffe (Antitoxine, Antikörper) gebildet und in das Blut abgegeben.“"
                                            },
                                            {
                                                "example_id": "df6d3265-a224-4be2-adbf-7a20bdf87662",
                                                "sense_id": "057b3efc-36ca-3bdb-a457-625c6923d7fa",
                                                "text": "„Bevor der Arzt dem Patienten die gentherapeutisch veränderten Blutstammzellen verabreicht, muss er dessen defektes Knochenmark mit einer Chemotherapie zerstören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
