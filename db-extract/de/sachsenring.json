                    {
                        "sense_id": "d9ad3ae2-7aa1-3d8b-881b-804bdf288062",
                        "entry_id": "2c096b29-b872-3e7d-872e-1ae92d32cfec",
                        "glosses": [
                            "Automobil- und Motorradrennstrecke in der Stadt Hohenstein-Ernstthal in Sachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab14631-416c-44b8-9bc6-be1ca20a7f6a",
                                "sense_id": "d9ad3ae2-7aa1-3d8b-881b-804bdf288062",
                                "text": "„Der spanische Honda-Pilot verwies die zwei Ducati-Werkfahrer Danilo Petrucci (ITA) und Jorge Lorenzo (ESP) auf dem Sachsenring auf die Plätze.“"
                            },
                            {
                                "example_id": "897db192-ac07-4329-9ff1-59acaf13dd9f",
                                "sense_id": "d9ad3ae2-7aa1-3d8b-881b-804bdf288062",
                                "text": "„Morbidelli, der vor dem Rennen auf dem Sachsenring 12 Punkte vor Lüthi lag, konnte seinen Vorsprung weiter ausbauen.“"
                            },
                            {
                                "example_id": "466261ef-84c4-4363-a041-6daa10a4771a",
                                "sense_id": "d9ad3ae2-7aa1-3d8b-881b-804bdf288062",
                                "text": "„Nach dem aufgelösten Vertrag und den abgebrochenen Verhandlungen zwischen dem ADAC und der Sachsenring Rennstrecken-Management GmbH (SRM) steht das Kultevent in Hohenstein-Ernstthal vor dem Aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
