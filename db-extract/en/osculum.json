                    },
                    {
                        "sense_id": "dce8b7a6-3eb1-36e0-a986-29bc4d97ebf1",
                        "entry_id": "8860dc75-c4f8-3098-bcfb-04368ee285e5",
                        "glosses": [
                            "One of the suckers on the head of a tapeworm."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bbc2cb17-5433-3f98-9e22-dbee52997cd5",
                        "entry_id": "8860dc75-c4f8-3098-bcfb-04368ee285e5",
                        "glosses": [
                            "The main opening in a sponge from which water is expelled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef4769b6-8e8b-4f7a-919b-70c3418d32ef",
                                "sense_id": "bbc2cb17-5433-3f98-9e22-dbee52997cd5",
                                "text": "I left them in that condition, and at 7 o'clock examined them again, when I found them still quiescent; but one of the two large groups of oscula and the new one were entirely closed, while the other osculum at the largest end of the sponge had opened to the extent of about one-third of its diameter, and the membrane presented the appearance of a series of lines or corrugations radiating from the centre to the circumference."
                            },
                            {
                                "example_id": "b8e65465-1c0b-45e9-aee4-893a9da04344",
                                "sense_id": "bbc2cb17-5433-3f98-9e22-dbee52997cd5",
                                "text": "Waste water was expelled through a single osculum at about 8.5 cm per second – more than eight thousand times as fast as it circulated in the chambers and 85 times as fast as it entered the sponge in the first place."
                            },
                            {
                                "example_id": "2d32793e-48d1-409a-96d0-b7ef0156f6f7",
                                "sense_id": "bbc2cb17-5433-3f98-9e22-dbee52997cd5",
                                "text": "2012, Sally P. Lees, April Hill, The Physiology and Molecular Biology of Sponge Tissues, Mikel A. Becerro, Maria J. Uriz, Manuel Maldonado, Xavier Turon (editors), Michael Lesser (series editor), Advances in Marine Biology 62: Advances in Sponge Science, Elsevier (Academic Press), page 30,\nOscula are also thought to arise initially from a single porocyte (Weissenfels, 1980), but how they coordinate with other porocytes to form a larger osculum is still unclear."
                            }
                        ]
                    }
                ],
