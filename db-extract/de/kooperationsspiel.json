                "senses": [
                    {
                        "sense_id": "6d1430e5-ab90-3e5c-8deb-465bcaeefd25",
                        "entry_id": "06f104db-80cd-3945-8bfa-8bdd06227d34",
                        "glosses": [
                            "pädagogisch ausgerichtete Spielform, bei der Partnerschaft und Zusammenarbeit im Zentrum des Spielgeschehens stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2700c134-37c1-45b9-a06f-4a056f52d586",
                                "sense_id": "6d1430e5-ab90-3e5c-8deb-465bcaeefd25",
                                "text": "„Die Kooperationsspiele entsprechen dem sozialen Kontext, indem das Miteinander wichtiger geworden ist als das Gegeneinander.“"
                            },
                            {
                                "example_id": "fd10ffe8-4cd2-426b-b198-563ff5c7b965",
                                "sense_id": "6d1430e5-ab90-3e5c-8deb-465bcaeefd25",
                                "text": "„Es gibt in der Tat kaum echte Kooperationsspiele auf dem Markt.“"
                            },
                            {
                                "example_id": "d4caaaad-1bf7-4c9d-9ac8-8194082b06a3",
                                "sense_id": "6d1430e5-ab90-3e5c-8deb-465bcaeefd25",
                                "text": "„Diese traditionelle Form des Wettlaufs lässt sich leicht in Kooperationsspiele umwandeln, - ohne Kooperation geht es dabei nicht.“"
                            },
                            {
                                "example_id": "7f5d8666-7ac1-419b-8b7d-2e6baca9ea8c",
                                "sense_id": "6d1430e5-ab90-3e5c-8deb-465bcaeefd25",
                                "text": "„Die Deutung und Bewertung des Siegens und Verlierens ist bei den Kooperationsspielen eine völlig andere als bei den Konkurrenzspielen.“"
                            },
                            {
                                "example_id": "85c53dcb-16e4-4457-ae35-6e6b3586b85c",
                                "sense_id": "6d1430e5-ab90-3e5c-8deb-465bcaeefd25",
                                "text": "„Sie ließen Probanden paarweise ein Kooperationsspiel spielen und steckten jeweils einen in den Tomografen, um seine Hirnaktivität zu messen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
