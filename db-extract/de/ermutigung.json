                "senses": [
                    {
                        "sense_id": "b5c3513f-04a5-3aa8-a633-a4d025bc93c2",
                        "entry_id": "e81b01cb-4ada-3ed1-8f04-e45703d1ae9b",
                        "glosses": [
                            "Versuch, jemandem mehr Freude, Mut zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eb34a50-4a7d-422a-aa94-b3ba97a72496",
                                "sense_id": "b5c3513f-04a5-3aa8-a633-a4d025bc93c2",
                                "text": "„Alle Erziehung beginnt mit der Ermutigung des Menschen zu sich selbst.“"
                            },
                            {
                                "example_id": "d53c9a65-b75b-4e5b-b0a3-5d1f9ddcf8af",
                                "sense_id": "b5c3513f-04a5-3aa8-a633-a4d025bc93c2",
                                "text": "„Auch die ‚aktive Hilfe zur Problembewältigung‘ ist eng verbunden mit der Ermutigung des/der Patienten/Patientin, vorhandene (konkrete) Probleme neu zu betrachten/zu analysieren, nach neuen Lösungen zu suchen und diese zu erproben.“"
                            }
                        ],
