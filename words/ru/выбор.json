    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88410712-a333-346d-9088-5e502f3880d4",
                    "sense_definition": "Действие по значению глагола «выбирать»; принятие решения в пользу одного из вариантов.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты должен сам сделать этот <w>выбор</w>.",
                            "target_lang_translations": {
                                "en": "You must make this <w>choice</w> yourself.",
                                "zh": "你必须自己做出这个<w>选择</w>。"
                            }
                        },
                        {
                            "text": "У меня просто не было другого <w>выбора</w>.",
                            "target_lang_translations": {
                                "en": "I simply had no other <w>choice</w>.",
                                "zh": "我实在没有别的<w>选择</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "решение"
                    ],
                    "antonyms": [
                        "безальтернативность"
                    ],
                    "common_phrases": [
                        "сделать выбор",
                        "свобода выбора",
                        "трудный выбор",
                        "правильный выбор"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of choosing; making a decision in favor of one of the options.",
                        "zh": "从多种可能性中做出决定或选择的行为。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "choice",
                                "target_lang_sense_clarification": "decision or act of choosing"
                            },
                            {
                                "target_lang_word": "option",
                                "target_lang_sense_clarification": "alternative"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选择",
                                "target_lang_sense_clarification": "做出决定或挑选的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dc65e66-afe3-302c-8a97-c9b8628d60f5",
                    "sense_definition": "Наличие различных вариантов, из которых можно выбрать; ассортимент.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом магазине очень большой <w>выбор</w> обуви.",
                            "target_lang_translations": {
                                "en": "This store has a very large <w>selection</w> of shoes.",
                                "zh": "这家店鞋子的<w>选择</w>非常多。"
                            }
                        },
                        {
                            "text": "Мы предлагаем напитки на любой <w>выбор</w>.",
                            "target_lang_translations": {
                                "en": "We offer drinks for any <w>choice</w>.",
                                "zh": "我们提供各种<w>选择</w>的饮料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ассортимент",
                        "подбор",
                        "альтернатива"
                    ],
                    "common_phrases": [
                        "большой выбор",
                        "на выбор",
                        "богатый выбор"
                    ],
                    "target_lang_definitions": {
                        "en": "The availability of different options to choose from; assortment.",
                        "zh": "可供挑选的不同选项的范围；种类。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "selection",
                                "target_lang_sense_clarification": "range of items"
                            },
                            {
                                "target_lang_word": "choice",
                                "target_lang_sense_clarification": "variety available"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选择",
                                "target_lang_sense_clarification": "可供挑选的范围"
                            },
                            {
                                "target_lang_word": "品种",
                                "target_lang_sense_clarification": "商品或物品的种类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cc9f5c8-ebe0-31cb-b71c-3e883b23535d",
                    "sense_definition": "Демократическая процедура избрания кандидатов на должность путем голосования.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Граждане страны пришли на <w>выборы</w> президента.",
                            "target_lang_translations": {
                                "en": "The country's citizens came to the presidential <w>election</w>.",
                                "zh": "该国公民参加了总统<w>选举</w>。"
                            }
                        },
                        {
                            "text": "Мой отец всегда ходит на <w>выборы</w>.",
                            "target_lang_translations": {
                                "en": "My father always goes to the <w>elections</w>.",
                                "zh": "我父亲总是去参加<w>选举</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "голосование",
                        "избрание"
                    ],
                    "common_phrases": [
                        "президентские выборы",
                        "идти на выборы",
                        "участвовать в выборах"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "обычно во множественном числе"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A democratic procedure for electing candidates to office by voting.",
                        "zh": "通过投票选出公职人员的民主程序。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "election",
                                "target_lang_sense_clarification": "political voting"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选举",
                                "target_lang_sense_clarification": "政治投票活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}