    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4eb2c547-3688-3087-a850-3a600701b8bc",
                    "sense_definition": "zich ontevredenheid uiten of een klacht indienen over een situatie of persoon",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "klagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>beklaag</w> me al jaren over die slechte service in dit restaurant.",
                            "target_lang_translations": {
                                "en": "I have been <w>complaining</w> about the poor service in this restaurant for years."
                            }
                        },
                        {
                            "text": "Je moet niet altijd <w>beklagen</w> over het weer als de zon niet schijnt.",
                            "target_lang_translations": {
                                "en": "You shouldn't always <w>complain</w> about the weather when the sun isn't shining."
                            }
                        }
                    ],
                    "synonyms": [
                        "klagen",
                        "mopperen",
                        "reclameren"
                    ],
                    "antonyms": [
                        "prijzen",
                        "loven"
                    ],
                    "common_phrases": [
                        "zich beklagen over"
                    ],
                    "target_lang_definitions": {
                        "en": "To express dissatisfaction or file a formal complaint about a situation or person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "complain",
                                "target_lang_sense_clarification": "to express dissatisfaction"
                            },
                            {
                                "target_lang_word": "grumble",
                                "target_lang_sense_clarification": "to complain in a low voice or bad-tempered way"
                            },
                            {
                                "target_lang_word": "lodge a complaint",
                                "target_lang_sense_clarification": "to formally report a grievance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f796e04a-2954-3ba1-a5d7-ac335556b837",
                    "sense_definition": "medelijden hebben met iemand of iemands ongelukkige situatie betreuren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medelijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn lot werd door zijn gehele familie en vriendenkring diep <w>beklaagd</w>.",
                            "target_lang_translations": {
                                "en": "His fate was deeply <w>pitied</w> by his entire family and circle of friends."
                            }
                        },
                        {
                            "text": "Ik <w>beklaag</w> de mensen die in deze kou buiten moeten werken.",
                            "target_lang_translations": {
                                "en": "I <w>pity</w> the people who have to work outside in this cold."
                            }
                        }
                    ],
                    "synonyms": [
                        "bejammeren",
                        "betreuren",
                        "medelijden hebben"
                    ],
                    "antonyms": [
                        "benijden"
                    ],
                    "common_phrases": [
                        "iemands lot beklagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To feel pity for someone or to regret someone's unfortunate situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pity",
                                "target_lang_sense_clarification": "to feel sympathy for someone's misfortune"
                            },
                            {
                                "target_lang_word": "deplore",
                                "target_lang_sense_clarification": "to feel or express strong disapproval or grief over"
                            },
                            {
                                "target_lang_word": "commiserate",
                                "target_lang_sense_clarification": "to express or feel sympathy or pity"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a839b475-a272-3c83-9da2-2007611d371b",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>beklag</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verschillende <w>beklagen</w> werden door de commissie één voor één behandeld.",
                            "target_lang_translations": {
                                "en": "The various <w>complaints</w> were handled one by one by the committee."
                            }
                        },
                        {
                            "text": "Na de vele <w>beklagen</w> besloot de directie eindelijk actie te ondernemen.",
                            "target_lang_translations": {
                                "en": "After the many <w>grievances</w>, the management finally decided to take action."
                            }
                        }
                    ],
                    "synonyms": [
                        "klachten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of beklag"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'beklag', referring to multiple grievances or complaints"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "complaints",
                                "target_lang_sense_clarification": "plural of a statement that something is unsatisfactory"
                            },
                            {
                                "target_lang_word": "grievances",
                                "target_lang_sense_clarification": "plural of a real or imagined wrong or other cause for complaint"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}