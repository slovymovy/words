                "senses": [
                    {
                        "sense_id": "dff68a28-7cb2-36a6-a30c-8ba92cbbd56f",
                        "entry_id": "b357de34-83bf-3ecd-875f-aa0ab0de4227",
                        "glosses": [
                            "Abhängigkeit, Unselbstständigkeit, von außen her bezogene Gesetzgebung"
                        ],
                        "tags": [
                            "Politikwissenschaft"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9f7b343d-41a0-33fb-93af-5b2fa157f9e8",
                        "entry_id": "b357de34-83bf-3ecd-875f-aa0ab0de4227",
                        "glosses": [
                            "Abhängigkeit von anderer als der eigenen sittlichen Gesetzmäßigkeit, unfrei im Willen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "445cf1d9-b402-4853-9e78-5012c2602a4c",
                                "sense_id": "9f7b343d-41a0-33fb-93af-5b2fa157f9e8",
                                "text": "„Wenn der Wille irgend worin anders, als in der Tauglichkeit seiner Maximen zu seiner eigenen allgemeinen Gesetzgebung, mithin, wenn er, indem er über sich selbst hinausgeht, in der Beschaffenheit irgend eines seiner Objecte das Gesetz sucht, das ihn bestimmen soll, so kommt jederzeit Heteronomie heraus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
