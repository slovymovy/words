{
    "word_family": [
        "bieg",
        "biegać",
        "biegacz",
        "dobiegać",
        "nabiegać",
        "odbiegać",
        "podbiegać",
        "przebiegać",
        "rozbiegać",
        "ubiegać",
        "wybiegać",
        "zabiegać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da463688-e07f-30fd-8d7e-24a3cb2a4b8d",
                    "sense_definition": "biegnąc, osiągnąć jakiś cel lub miejsce",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przemieszczanie-sie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawodnik ostatkiem sił <w>dobiegł</w> do mety i upadł ze zmęczenia.",
                            "target_lang_translations": {
                                "en": "With the last of his strength, the competitor <w>reached</w> the finish line and collapsed from exhaustion."
                            }
                        },
                        {
                            "text": "Musimy szybko <w>dobiec</w> do schroniska, zanim zacznie się ulewa.",
                            "target_lang_translations": {
                                "en": "We must quickly <w>run to</w> the shelter before the downpour starts."
                            }
                        }
                    ],
                    "synonyms": [
                        "dobiegnąć"
                    ],
                    "common_phrases": [
                        "dobiec do mety",
                        "dobiec do celu"
                    ],
                    "target_lang_definitions": {
                        "en": "to reach a destination or place by running"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run to",
                                "target_lang_sense_clarification": "reach a place by running"
                            },
                            {
                                "target_lang_word": "reach",
                                "target_lang_sense_clarification": "arrive at a destination by running"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4579affe-3690-34d2-ad37-aec0329bbb45",
                    "sense_definition": "o głosie, dźwięku lub zapachu: dotrzeć do kogoś z pewnej odległości",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "percepcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z oddali <w>dobiegł</w> nas dźwięk dzwonów kościelnych.",
                            "target_lang_translations": {
                                "en": "The sound of church bells <w>reached</w> us from afar."
                            }
                        },
                        {
                            "text": "Nagle z kuchni <w>dobiegł</w> przyjemny zapach pieczonego ciasta.",
                            "target_lang_translations": {
                                "en": "Suddenly, a pleasant smell of baking cake <w>wafted</w> from the kitchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "dobiegnąć"
                    ],
                    "common_phrases": [
                        "dobiegł głos",
                        "dobiegł dźwięk"
                    ],
                    "target_lang_definitions": {
                        "en": "of a voice, sound, or smell: to reach someone from a distance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reach",
                                "target_lang_sense_clarification": "of sound or smell, to carry to someone"
                            },
                            {
                                "target_lang_word": "come from",
                                "target_lang_sense_clarification": "of sound or smell, to drift from a distance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b293d302-d6fd-3479-9920-47fd4cd64ffd",
                    "sense_definition": "osiągnąć jakiś moment, kres lub koniec w czasie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moje długie wakacje powoli <w>dobiegły</w> końca i czas wracać do pracy.",
                            "target_lang_translations": {
                                "en": "My long vacation has slowly <w>come</w> to an end, and it's time to go back to work."
                            }
                        },
                        {
                            "text": "Gdy spotkanie <w>dobiegło</w> kresu, wszyscy zaczęli bić brawo.",
                            "target_lang_translations": {
                                "en": "When the meeting <w>drew</w> to a close, everyone started to applaud."
                            }
                        }
                    ],
                    "synonyms": [
                        "dobiegnąć"
                    ],
                    "common_phrases": [
                        "dobiec końca",
                        "dobiec kresu"
                    ],
                    "target_lang_definitions": {
                        "en": "to reach a certain point, limit, or end in time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come to",
                                "target_lang_sense_clarification": "reach an end or conclusion"
                            },
                            {
                                "target_lang_word": "draw to",
                                "target_lang_sense_clarification": "approach an end, e.g., draw to a close"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d3988eb-de50-3242-9d99-1b21960d1e13",
                    "sense_definition": "o człowieku: osiągnąć określony wiek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek niedawno <w>dobiegł</w> osiemdziesiątki, ale wciąż ma mnóstwo energii.",
                            "target_lang_translations": {
                                "en": "My grandfather recently <w>reached</w> eighty, but he still has plenty of energy."
                            }
                        },
                        {
                            "text": "Zanim <w>dobiegł</w> trzydziestki, założył już własną, dobrze prosperującą firmę.",
                            "target_lang_translations": {
                                "en": "Before he <w>turned</w> thirty, he had already started his own prosperous company."
                            }
                        }
                    ],
                    "synonyms": [
                        "dobiegnąć"
                    ],
                    "common_phrases": [
                        "dobiec pięćdziesiątki",
                        "dobiec wieku"
                    ],
                    "target_lang_definitions": {
                        "en": "of a person: to reach a certain age"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reach",
                                "target_lang_sense_clarification": "attain a certain age"
                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "approach or reach a milestone age"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b6fc127-a4eb-3d0d-9cef-5d000af5d3c9",
                    "sense_definition": "o drodze, ścieżce lub granicy: prowadząc, dotrzeć do jakiegoś miejsca",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "przestrzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wąska ścieżka leśna <w>dobiegła</w> aż do samego brzegu jeziora.",
                            "target_lang_translations": {
                                "en": "The narrow forest path <w>ran</w> all the way to the very edge of the lake."
                            }
                        },
                        {
                            "text": "Główna ulica <w>dobiegła</w> do rzeki, gdzie zaczynał się stary most.",
                            "target_lang_translations": {
                                "en": "The main street <w>reached</w> the river, where the old bridge began."
                            }
                        }
                    ],
                    "synonyms": [
                        "dobiegnąć"
                    ],
                    "common_phrases": [
                        "droga dobiegła"
                    ],
                    "target_lang_definitions": {
                        "en": "of a road, path, or border: to lead to and reach a certain place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reach",
                                "target_lang_sense_clarification": "of a path or road, to extend to a point"
                            },
                            {
                                "target_lang_word": "run to",
                                "target_lang_sense_clarification": "of a path or road, to lead up to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "addf753e-010b-38da-8b02-35eb83bd3669",
                    "sense_definition": "o czasie lub terminie: nadejść, nastać",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wreszcie <w>dobiegł</w> dzień, na który wszyscy czekaliśmy z niecierpliwością.",
                            "target_lang_translations": {
                                "en": "Finally, the day we had all been eagerly waiting for <w>arrived</w>."
                            }
                        },
                        {
                            "text": "Termin oddania projektu nieubłaganie <w>dobiegł</w> i musieliśmy wysłać dokumenty.",
                            "target_lang_translations": {
                                "en": "The project deadline had inexorably <w>come</w>, and we had to send the documents."
                            }
                        }
                    ],
                    "synonyms": [
                        "dobiegnąć"
                    ],
                    "common_phrases": [
                        "dobiegł termin"
                    ],
                    "target_lang_definitions": {
                        "en": "of time or a deadline: to arrive or come to pass"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "of a day or deadline, to come"
                            },
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "of a specific time or day, to arrive"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}