                "translations": [
                    {
                        "translation_id": "2b475a60-271f-4269-be98-63d3b501389e",
                        "source_entry_id": "88e5cbc1-3c25-3126-bf4d-e218d3b9d267",
                        "source_sense_id": "8c0ce7ee-9a17-3f29-9d4a-beac5272d154",
                        "target_lang_word": "Decke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Decke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d988388a-75c4-3253-b07a-ba96e0e5f84d",
                                        "entry_id": "d5e38efd-8e2e-31be-b0aa-9d660236660e",
                                        "glosses": [
                                            "geschlossene Oberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa113b3d-5490-4321-8604-6f9f58517c62",
                                                "sense_id": "d988388a-75c4-3253-b07a-ba96e0e5f84d",
                                                "text": "Der See hat eine dicke Eisdecke."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1934b7c3-5f38-31db-872e-bf515b94f7d7",
                                        "entry_id": "d5e38efd-8e2e-31be-b0aa-9d660236660e",
                                        "glosses": [
                                            "großes, wärmendes Stück Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147b0237-84f0-4fd8-bd16-edf7d29866c1",
                                                "sense_id": "1934b7c3-5f38-31db-872e-bf515b94f7d7",
                                                "text": "Die Decke aus Wolle wärmt meine kalten Füße."
                                            },
                                            {
                                                "example_id": "c14a0902-8d83-4efd-b7d7-e98be61a6d26",
                                                "sense_id": "1934b7c3-5f38-31db-872e-bf515b94f7d7",
                                                "text": "„Sie schlafen bewegungslos, die Decke gegen die Kühle der Dämmerung über sich gezogen.“"
                                            },
                                            {
                                                "example_id": "781bb2ec-9f21-4031-b645-decea7c34614",
                                                "sense_id": "1934b7c3-5f38-31db-872e-bf515b94f7d7",
                                                "text": "„Wenige Schritt entfernt delirierte Wilson und zitterte unter der Decke.“"
                                            },
                                            {
                                                "example_id": "f08672c5-f87b-472d-acef-25f51d128b58",
                                                "sense_id": "1934b7c3-5f38-31db-872e-bf515b94f7d7",
                                                "text": "„Aber ein Bettvorleger sei ja da, eine Decke und ein Kissen könne sie ihm ebenfalls abtreten.“"
                                            },
                                            {
                                                "example_id": "058317b8-6391-4ece-802e-9d559ac1cc01",
                                                "sense_id": "1934b7c3-5f38-31db-872e-bf515b94f7d7",
                                                "text": "„Thomas schlug die Decke zurück und setzte sich auf den Bettrand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d30d2250-cb65-3e09-ae57-d2b21e24f575",
                                        "entry_id": "d5e38efd-8e2e-31be-b0aa-9d660236660e",
                                        "glosses": [
                                            "obere Begrenzung eines Zimmers beziehungsweise das die Basis für ein Stockwerk bildende tragende Bauelement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a575cf-d2e4-4316-985d-63464d08ae88",
                                                "sense_id": "d30d2250-cb65-3e09-ae57-d2b21e24f575",
                                                "text": "Es war an der Zeit die Decke neu zu streichen."
                                            },
                                            {
                                                "example_id": "da309e08-73e6-4d4f-bf12-6f415aee6d57",
                                                "sense_id": "d30d2250-cb65-3e09-ae57-d2b21e24f575",
                                                "text": "„Die Decke lief spitz zu und war offenbar die Innenseite des richtigen Hausdaches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "03cf7704-dd4a-3732-84d4-13546f94914f",
                                        "entry_id": "d5e38efd-8e2e-31be-b0aa-9d660236660e",
                                        "glosses": [
                                            "Fell von Wildtieren"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0077c8f-553b-4a11-9e33-096d67b3712f",
                                                "sense_id": "03cf7704-dd4a-3732-84d4-13546f94914f",
                                                "text": "„Die Wilddiebe haben die Tiere an Ort und Stelle enthäutet und die Decken liegen gelassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
