                                        "glosses": [
                                            "ein weitverbreiteter, weiß blühender Obstbaum, der Kirschen als Früchte trägt"
                                        ],
                                        "tags": [
                                            "Obstbaum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca71234-3c7c-496b-a53d-cc7a7aa00cf8",
                                                "sense_id": "396574e6-83f9-33af-87be-a3d0727fcb05",
                                                "text": "Die Kirschbäume blühen."
                                            },
                                            {
                                                "example_id": "2dd96f52-9f35-41fa-bc57-6482a733cca5",
                                                "sense_id": "396574e6-83f9-33af-87be-a3d0727fcb05",
                                                "text": "„Er kennt den Duft der Kirschbäume im Sommer und den feinen Staub des Sandsteins, der sich auf die Schuhe legt wie Schnee.“"
                                            },
                                            {
                                                "example_id": "4eddfe42-b005-4baa-8960-5d35ffd5aafd",
                                                "sense_id": "396574e6-83f9-33af-87be-a3d0727fcb05",
                                                "text": "„Kinder planschen im Schatten eines Kirschbaumes, sie spritzen mit Wasser, andere spielen im Sand.“"
                                            },
                                            {
                                                "example_id": "94d206de-cebc-4026-86a4-23c8d6d4d676",
                                                "sense_id": "396574e6-83f9-33af-87be-a3d0727fcb05",
                                                "text": "„Der Bauer erwischt zwei Knaben in seinem Kirschbaum.“"
                                            },
                                            {
                                                "example_id": "4117c03f-3229-491b-82c0-f60aa49e4a84",
                                                "sense_id": "396574e6-83f9-33af-87be-a3d0727fcb05",
                                                "text": "„Hier stehen ein Kirschbaum, Apfel-, Mandel- und Zwetschgenbäume, eine Himalaja-Kiefer, eine Hängebuche und eine weiße Magnolie, auf die Amalia immer sehr stolz war, obwohl der Baum geradezu entgegen ihren Bemühungen überleben musste; Amalia hatte das Gegenteil eines grünen Daumens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
