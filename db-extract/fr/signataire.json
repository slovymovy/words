            {
                "entry_id": "635ccffa-c581-3c44-9815-1f0e24f9af24",
                "word": "signataire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f18bd25-0877-4d14-9a0c-5b6a60e58b98",
                        "entry_id": "635ccffa-c581-3c44-9815-1f0e24f9af24",
                        "tags": [
                            "plural",
