                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b5b209d-51d4-44e5-86fd-4a8a5810c714",
                                                "sense_id": "25bae475-49f3-37d4-8da3-51d0cf9f86d2",
                                                "text": "Ton grand-père débloque complètement."
                                            },
                                            {
                                                "example_id": "1c4ec7dd-1c92-46d5-b7c2-db48683fc1f7",
                                                "sense_id": "25bae475-49f3-37d4-8da3-51d0cf9f86d2",
                                                "text": "– Mais, bon Dieu ! Foutez-moi la paix avec votre glycérophtalique ! Je ne vous ai jamais demandé de vous en servir ! Vous débloquez ou quoi ?"
                                            }
