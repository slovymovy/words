                "senses": [
                    {
                        "sense_id": "86d15613-257b-33e1-93aa-1d038c08698f",
                        "entry_id": "edd94bac-6307-37f8-acc2-29d6c5388c87",
                        "glosses": [
                            "Hund, der tagsüber meist an einer Kette angebunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73060de9-d367-4113-af81-9bd3c23772ac",
                                "sense_id": "86d15613-257b-33e1-93aa-1d038c08698f",
                                "text": "„Die nächste Nacht verbringen der Marchese und die Marquise mit einem Kettenhund an ihrer Seite in dem Zimmer.“"
                            },
                            {
                                "example_id": "49dbbf24-e757-4cbf-880f-4c121230529c",
                                "sense_id": "86d15613-257b-33e1-93aa-1d038c08698f",
                                "text": "„Bock trottete sehr steifbeinig und mit leichtem Schwanzwedeln voran, um den Kettenhund in ein Gespräch zu verwickeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7489bd24-2974-4bb4-8c57-6c819b3c066d",
                        "source_entry_id": "edd94bac-6307-37f8-acc2-29d6c5388c87",
                        "source_sense_id": "86d15613-257b-33e1-93aa-1d038c08698f",
                        "source_sense_description": "Hund, der tagsüber meist an einer Kette angebunden ist",
                        "target_lang_word": "bandog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5711fded-0621-3d49-a51d-07b489961c85",
                                        "entry_id": "57cdfa3b-d4bd-37c6-834b-6737ca261ae6",
                                        "glosses": [
                                            "A dog that has been tied up; a mastiff or other kind of guard dog."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41407de-9366-4a5e-bfba-36abdf879684",
                                                "sense_id": "5711fded-0621-3d49-a51d-07b489961c85",
                                                "text": "The horsemen spreading themselves along the side of the cover, waited untill the keeper entered, leading his ban-dog; a large blood-hound tied in a leam or band, from which he takes his name."
                                            },
                                            {
                                                "example_id": "39e1fed7-22ad-4fc7-b308-2deaf5282085",
                                                "sense_id": "5711fded-0621-3d49-a51d-07b489961c85",
                                                "text": "Patriots may smile; and, using him [ Jean-Paul Marat ] as bandog now to be muzzled, now to be let bark...."
                                            },
                                            {
                                                "example_id": "f3bbafd5-13e4-4479-ba70-eb86bf242dc5",
                                                "sense_id": "5711fded-0621-3d49-a51d-07b489961c85",
                                                "text": "The guns on the fortress responded, but the small calibre made them sound as if they were yapping like bandogs while the bombers bayed and gave tongue like hounds in cry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c88cbee2-866e-356f-bfe7-9aafebb49894",
                                        "entry_id": "57cdfa3b-d4bd-37c6-834b-6737ca261ae6",
                                        "glosses": [
                                            "A type of large, ferocious dog, bred by crossing American pit bull terriers with Neapolitan mastiffs."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78ac2d87-2ff2-3463-b6f2-97a002260bf8",
                                        "entry_id": "57cdfa3b-d4bd-37c6-834b-6737ca261ae6",
                                        "glosses": [
                                            "Something that or someone who pursues doggedly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17a1249-1fe0-4871-8e66-57c0a27d9029",
                                                "sense_id": "78ac2d87-2ff2-3463-b6f2-97a002260bf8",
                                                "text": "He escaped from that experience confounded, horrified, and conscious of degradation. Those infernal bandogs of the law had treated him as a piece of insensate property to their drivelling mumbo-jumbo, as if mere contact with it had robbed him of all rights to the dignity and integrity of his own ego."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8a8dc72-aaeb-3695-9660-c58b1f05e8b1",
                                        "entry_id": "57cdfa3b-d4bd-37c6-834b-6737ca261ae6",
                                        "glosses": [
                                            "A bailiff or prison guard."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "943e1ba3-6b2b-44b0-ac62-c7415a5763e2",
                        "source_entry_id": "edd94bac-6307-37f8-acc2-29d6c5388c87",
                        "source_sense_id": "86d15613-257b-33e1-93aa-1d038c08698f",
                        "source_sense_description": "Hund, der tagsüber meist an einer Kette angebunden ist",
                        "target_lang_word": "chien de garde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chien de garde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09c9e458-8d37-3a1d-8758-d62cf4ea46ca",
                                        "entry_id": "a9dc5e1f-ab8a-394f-85ab-c5f4a14f709c",
                                        "glosses": [
                                            "Chien dressé pour garder un lieu, dont le rôle est de veiller sur une maison, une propriété."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "532bd2f5-70fa-498b-ac5f-049081430f20",
                                                "sense_id": "09c9e458-8d37-3a1d-8758-d62cf4ea46ca",
                                                "text": "Quand il y a une vieille fille dans une maison, les chiens de garde sont inutiles : il ne s’y passe pas le moindre événement qu’elle ne voie, ne le commente et n’en tire toutes les conséquences possibles."
                                            },
                                            {
                                                "example_id": "3d6eb6eb-1cf2-4df2-975e-e63691187000",
                                                "sense_id": "09c9e458-8d37-3a1d-8758-d62cf4ea46ca",
                                                "text": "Le berger regagna paisiblement les bords de la Nied, s'assit à l'ombre d'un pommier, et se mit à raccommoder le collier à clous de son chien de garde."
                                            },
                                            {
                                                "example_id": "7fea1eee-f61c-4cae-bbab-dfe520b14594",
                                                "sense_id": "09c9e458-8d37-3a1d-8758-d62cf4ea46ca",
                                                "text": "Il suffit, suivant cette jurisprudence, qu’un chien ait la double destination de chien de garde et de chien d’agrément, pour qu’il doive nécessairement être rangé dans la première catégorie."
                                            },
                                            {
                                                "example_id": "efea8d6c-e3cd-47dc-a745-e4e70c518a1f",
                                                "sense_id": "09c9e458-8d37-3a1d-8758-d62cf4ea46ca",
                                                "text": "« On fait tout pour les replacer dans des endroits où ils seront bien, on n’a pas envie qu’ils finissent comme chiens de garde », souligne le major Peyretout, chef de l’unité cynophile de Rennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e6dad95-329b-3e20-ae10-499eb0636c36",
                                        "entry_id": "a9dc5e1f-ab8a-394f-85ab-c5f4a14f709c",
                                        "glosses": [
                                            "Personne ou entité qui veille sur quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4b61d07-3bb7-4cac-8465-f64d69a0c9e3",
                                                "sense_id": "9e6dad95-329b-3e20-ae10-499eb0636c36",
                                                "text": "[Sur l’affaire du Watergate] Bien des années plus tard, il fallut convenir que la révélation de ce scandale n’était pas le simple fait de deux journalistes courageux. Mais, sur le coup, cette version connut un tel triomphe que le journalisme d’investigation parut devenir le chien de garde de la politique."
                                            },
                                            {
                                                "example_id": "79aef84f-ebd4-41f9-9f82-48d41e438c9b",
                                                "sense_id": "9e6dad95-329b-3e20-ae10-499eb0636c36",
                                                "text": "Steve Castonguay vient d’être cité en déontologie par la Commission municipale du Québec (CMQ) un tribunal administratif qui agit comme chien de garde en matière d’éthique pour les élus."
                                            },
                                            {
                                                "example_id": "3988aa05-ddc6-452e-b3b0-2b71314b0194",
                                                "sense_id": "9e6dad95-329b-3e20-ae10-499eb0636c36",
                                                "text": "Il fallut plus d’un an de soins constants et dévoués pour qu'elle s’habituât à ces deux terribles créatures, que Carlos Herrera nommait les deux chiens de garde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c6a79c-23b6-366e-8bb2-83f3d49d7478",
                                        "entry_id": "a9dc5e1f-ab8a-394f-85ab-c5f4a14f709c",
                                        "glosses": [
                                            "Personnage médiatique (journaliste, éditorialiste…) mettant sa notoriété au service de l'ordre établi."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739e218d-9e25-473f-9b39-aa5779a4b07e",
                                                "sense_id": "f1c6a79c-23b6-366e-8bb2-83f3d49d7478",
                                                "text": "Ça fait partie du mandat que les journalistes ont de défendre en quelque sorte la justice sociale, pas de devenir des activistes militants, mais on s'entend, tout ce qui est racisme, injustice, pauvreté, c'est notre rôle comme chien de garde de faire surgir toutes les problématiques."
                                            },
                                            {
                                                "example_id": "d0b36377-cae4-4bb7-a821-0cbee2fcbcfd",
                                                "sense_id": "f1c6a79c-23b6-366e-8bb2-83f3d49d7478",
                                                "text": "Les journalistes sont ainsi les chiens de garde de la démocratie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e1daaf0-34e1-3c43-88d2-1d9f8e063248",
                                        "entry_id": "a9dc5e1f-ab8a-394f-85ab-c5f4a14f709c",
                                        "glosses": [
                                            "Horloge de surveillance, registre d’horloge qui surveille l’état d’un signal ou d’une unité fonctionnelle afin de déceler les périodes d’inactivité ou les temps de réponse qui dépassent une durée spécifiée. Termes et définition normalisés par l’ISO/CÉI 2382-14:1997."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c32ca1b1-ccaa-43ed-a1f6-478096dae753",
                                                "sense_id": "7e1daaf0-34e1-3c43-88d2-1d9f8e063248",
                                                "text": "Pour en sortir on utilise un chien de garde. Il s’agit d’un compteur qui, lorsqu’il arrive en fin de comptage, permet de redémarrer le programme. Il est lancé au début du programme. En fonctionnement normal, il est remis à zéro régulièrement dans une branche du programme qui s’exécute régulièrement. Si le programme est bloqué, il ne passe plus dans la branche de remise à zéro et le comptage va jusqu’au bout, déclenche le chien de garde qui relance le programme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
