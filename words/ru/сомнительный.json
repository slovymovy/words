                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verdächtig",
                                "target_lang_sense_clarification": "wenn jemand oder etwas Misstrauen erregt"
                            },
                            {
                                "target_lang_word": "zwielichtig",
                                "target_lang_sense_clarification": "speziell für Personen mit unklarem oder kriminellem Hintergrund"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf8b54ea-14a3-355a-8d91-d6a94bfced94",
                    "sense_definition": "Вызывающий сомнение в своей порядочности или благовидности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он часто участвует в <w>сомнительных</w> сделках.",
                            "target_lang_translations": {
                                "de": "Er ist oft an <w>dubiosen</w> Geschäften beteiligt."
                            }
                        },
                        {
                            "text": "Друзья втянули его в <w>сомнительное</w> предприятие.",
                            "target_lang_translations": {
                                "de": "Freunde haben ihn in ein <w>fragwürdiges</w> Unternehmen hineingezogen."
                            }
                        }
                    ],
                    "synonyms": [
                        "подозрительный"
                    ],
                    "common_phrases": [
                        "сомнительная сделка",
                        "сомнительное предприятие"
                    ],
                    "target_lang_definitions": {
