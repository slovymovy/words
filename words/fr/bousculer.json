    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b3e898d-791d-30e7-8468-1b7cbb47c4be",
                    "sense_definition": "Pousser une personne rudement ou la heurter au passage, souvent sans ménagement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "choc_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voyageur pressé a <w>bousculé</w> plusieurs personnes sur le quai du train."
                        },
                        {
                            "text": "Faites attention à ne pas me <w>bousculer</w> avec votre grand sac."
                        }
                    ],
                    "synonyms": [
                        "heurter",
                        "pousser",
                        "rudoyer"
                    ],
                    "antonyms": [
                        "ménager",
                        "épargner"
                    ],
                    "common_phrases": [
                        "se faire bousculer",
                        "bousculer quelqu'un"
                    ]
                },
                {
                    "sense_id": "0da94f16-bfb4-3d42-be2c-beb77fc4075f",
                    "sense_definition": "Se pousser les uns les autres dans un mouvement de foule ou d'impatience.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "choc_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spectateurs se <w>bousculent</w> devant l'entrée pour obtenir les meilleures places."
                        },
                        {
                            "text": "Ne vous <w>bousculez</w> pas, il reste assez de chaises pour tout le monde."
                        }
                    ],
                    "synonyms": [
                        "se presser",
                        "se ruer"
                    ],
                    "common_phrases": [
                        "se bousculer au portillon",
                        "se bousculer pour passer"
                    ]
                },
                {
                    "sense_id": "ac22190e-0995-3d89-8dc9-e0f5b01727bd",
                    "sense_definition": "Modifier brusquement ou désorganiser des habitudes, un ordre établi ou un programme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "changement_ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette annonce inattendue est venue <w>bousculer</w> tous les plans de notre entreprise."
                        },
                        {
                            "text": "Le nouveau directeur souhaite <w>bousculer</w> les habitudes de travail de son équipe."
                        }
                    ],
                    "synonyms": [
                        "bouleverser",
                        "perturber",
                        "chambouler"
                    ],
                    "antonyms": [
                        "maintenir",
                        "préserver"
                    ],
                    "common_phrases": [
                        "bousculer les habitudes",
                        "bousculer le calendrier",
                        "bousculer l'ordre établi"
                    ]
                },
                {
                    "sense_id": "1fa22dae-ff61-3fe3-9ea1-3a9203c2ac18",
                    "sense_definition": "Se présenter en foule ou se succéder avec rapidité et désordre dans l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "changement_ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trop d'idées se <w>bousculent</w> dans ma tête et je n'arrive pas à choisir."
                        },
                        {
                            "text": "En revoyant cette photo, des souvenirs d'enfance se <w>bousculent</w> dans sa mémoire."
                        }
                    ],
                    "synonyms": [
                        "s'entrechoquer",
                        "se succéder"
                    ],
                    "common_phrases": [
                        "idées qui se bousculent",
                        "souvenirs qui se bousculent"
                    ]
                },
                {
                    "sense_id": "ee0f6e2f-88e2-304c-940d-199a1576ec72",
                    "sense_definition": "Mettre des objets en désordre en les heurtant ou en les déplaçant sans précaution.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "changement_ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cherchant son passeport dans le tiroir, il a complètement <w>bousculé</w> ses papiers."
                        },
                        {
                            "text": "Le chiot a couru dans le salon et a <w>bousculé</w> la pile de magazines."
                        }
                    ],
                    "synonyms": [
                        "déranger",
                        "désordonner",
                        "renverser"
                    ],
                    "antonyms": [
                        "ranger",
                        "ordonner"
                    ],
                    "common_phrases": [
                        "bousculer des affaires"
                    ]
                }
            ]
        }
    ]
}