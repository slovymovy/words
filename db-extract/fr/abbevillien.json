            {
                "entry_id": "c2eff96f-e1a8-3da9-91ed-c5662067d3da",
                "word": "Abbevillien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7397560e-0dfd-46b6-af2d-5c7596f81078",
                        "entry_id": "c2eff96f-e1a8-3da9-91ed-c5662067d3da",
                        "tags": [
                            "plural"
                        ],
