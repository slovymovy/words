                "translations": [
                    {
                        "translation_id": "7e84f1f4-e1eb-4d2b-9904-b3178f7c427e",
                        "source_entry_id": "cc2f60cd-8558-3f30-9af6-1be18b0d9641",
                        "source_sense_id": "95d08655-6741-3c29-a8b8-201221ae42e0",
                        "target_lang_word": "musqué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01bacacb-be70-3d6b-966b-65ab48d6f6d8",
                                        "entry_id": "dbbef175-6b58-381e-a570-af920dd1faf4",
                                        "glosses": [
                                            "Qui rappelle l'odeur du musc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31977402-b2b9-40a5-a46e-a13525252329",
                                                "sense_id": "01bacacb-be70-3d6b-966b-65ab48d6f6d8",
                                                "text": "Moi aussi, les soirs trop chauds m'ont terrassée ; moi aussi, l'odeur musquée des foins, les roulades du rossignol m'ont livré à la folie, à la faute."
                                            },
                                            {
                                                "example_id": "cb8a3d9b-9fcb-4b49-be3e-5d1ec839219c",
                                                "sense_id": "01bacacb-be70-3d6b-966b-65ab48d6f6d8",
                                                "text": "Elles firent la gloire de leur région en répandant à travers la planète le goût musqué et puissant des calendos, mais les réduire à ce seul fromage eût été une erreur..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e31fee8-0fe1-3310-a659-6c150be6b13a",
                                        "entry_id": "dbbef175-6b58-381e-a570-af920dd1faf4",
                                        "glosses": [
                                            "Qui rappelle le goût du muscat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc11f3f3-e8ef-4edc-9ea4-f4f67846cf71",
                                                "sense_id": "7e31fee8-0fe1-3310-a659-6c150be6b13a",
                                                "text": "Des poires musquées."
                                            },
                                            {
                                                "example_id": "d63b6b70-fde5-4a5e-872b-f260e8c51e76",
                                                "sense_id": "7e31fee8-0fe1-3310-a659-6c150be6b13a",
                                                "text": "Il y avait plusieurs pruniers, d’où tombaient, trop mûres, sur la terre brûlante, ces mêmes délicieuses prunes qu’on mettait sécher sur les toits ; le long des vieilles allées couraient des vignes dont les raisins musqués étaient dévorés par des légions de mouches et d’abeilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82dd6c3c-488b-3ce9-b481-7bfa3bfca2a3",
                                        "entry_id": "dbbef175-6b58-381e-a570-af920dd1faf4",
                                        "glosses": [
                                            "Qui a trop d’apprêt, de recherche, qui affecte les ornements futiles."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b301579a-aa35-4e2f-8919-c8ed879e1d4d",
                                                "sense_id": "82dd6c3c-488b-3ce9-b481-7bfa3bfca2a3",
                                                "text": "Écrivain, orateur, poète musqué."
                                            },
                                            {
                                                "example_id": "bb297abc-d6f4-4872-9080-9c2178761ed8",
                                                "sense_id": "82dd6c3c-488b-3ce9-b481-7bfa3bfca2a3",
                                                "text": "Style musqué, phrases musquées."
                                            },
                                            {
                                                "example_id": "8d3b98bd-8a41-4179-ac71-e9334b8db23e",
                                                "sense_id": "82dd6c3c-488b-3ce9-b481-7bfa3bfca2a3",
                                                "text": "Il aimait les lieux éclairés, emplis d’airs sans importance, où des gens se promènent, nonchalants et fureteurs, parmi des femmes musquées et prêtes, aux toilettes un peu vives."
                                            },
                                            {
                                                "example_id": "f2737ceb-930c-4135-9945-483a17ea59ef",
                                                "sense_id": "82dd6c3c-488b-3ce9-b481-7bfa3bfca2a3",
                                                "text": "Il aurait fallu savoir jouer au tennis, monter à cheval (peut-être en amazone). Et Marylène n’avait pas la sorte de beauté pour ces situations. Il convenait d’être plutôt belle et grande, comme elle, mais moins musquée."
                                            }
                                        ]
                                    }
                                ]
                            },
