                                        "entry_id": "c5d88a7d-9bc7-3f4d-8a6a-7c6e15c08339",
                                        "glosses": [
                                            "An advocacy group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6299171c-379b-4869-8870-5a3b5daf9472",
                                                "sense_id": "513a6277-fef4-3ccf-8d28-30fbceaafb06",
                                                "text": "Various efforts by certain political pressure groups were still being made to stop the West Africa Squadron's activities, for a number of less-than-honourable reasons, but the government was able to resist them and the patrols would continue."
                                            },
                                            {
                                                "example_id": "4d28fb08-ef60-4578-8a21-2fb4c3017ba3",
                                                "sense_id": "513a6277-fef4-3ccf-8d28-30fbceaafb06",
                                                "text": "Passengers, pressure groups and local authorities have criticised the operator's plans for a permanent reduction in services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
