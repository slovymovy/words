                        "examples": [
                            {
                                "example_id": "4632fcf3-52e1-420d-92f7-23f699fd257c",
                                "sense_id": "3a58e288-adca-3244-8a72-92e43b58ac97",
                                "text": "Прошивка для мобильного телефона, прошивка для микроконтроллера."
                            },
                            {
                                "example_id": "1bffda5c-d45e-4c82-8b0e-deb15dd3f107",
                                "sense_id": "3a58e288-adca-3244-8a72-92e43b58ac97",
                                "text": "Независимо от того, какой это телефон, звонилка или смартфон, ты просто обязан знать какая у него версия прошивки, а какая самая последняя, какая безглючная, и когда выйдет следующая."
                            }
                        ]
                    }
