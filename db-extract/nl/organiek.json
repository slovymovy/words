                                        "sense_id": "a1f81378-d0c8-33c0-b08b-678750ef6729",
                                        "entry_id": "5fec3583-3bbf-3b8f-a714-38f7d4a1e8f9",
                                        "glosses": [
                                            "Of food or food products, grown in an environment free from artificial agrichemicals, and possibly certified by a regulatory body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "462aaf5a-4b3b-3ec1-8b44-174d1d355cb2",
                                        "entry_id": "5fec3583-3bbf-3b8f-a714-38f7d4a1e8f9",
                                        "glosses": [
                                            "Describing a form of social solidarity theorized by Emile Durkheim that is characterized by voluntary engagements in complex interdependencies for mutual benefit (such as business agreements), rather than mechanical solidarity, which depends on ascribed relations between people (as in a family or tribe)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a79b7b52-6baf-337d-9c64-1bdbefb40297",
                                        "entry_id": "5fec3583-3bbf-3b8f-a714-38f7d4a1e8f9",
                                        "glosses": [
                                            "Of a military unit or formation, or its elements, belonging to a permanent organization (in contrast to being temporarily attached)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e999a8-ebf8-406e-9eed-2ac9b6a0aa73",
                                                "sense_id": "a79b7b52-6baf-337d-9c64-1bdbefb40297",
                                                "text": "Socially, the term “organic” unit implies a military force characterized by relatively high cohesion, overlapping primary groups and a certain sense of shared past."
                                            },
                                            {
                                                "example_id": "75291a84-5ef7-4347-bbd2-6e6e68215fb4",
                                                "sense_id": "a79b7b52-6baf-337d-9c64-1bdbefb40297",
                                                "text": "Most types of German field divisions include an organic reconnaissance battalion, and the remainder have strong reconnaissance companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45cb8a5-f0ab-38d7-ad08-0d447299c4bf",
                                        "entry_id": "5fec3583-3bbf-3b8f-a714-38f7d4a1e8f9",
                                        "glosses": [
                                            "Instrumental; acting as instruments of nature or of art to a certain destined function or end."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c00ebd-3f0a-4402-a88e-405e0414a561",
                                                "sense_id": "e45cb8a5-f0ab-38d7-ad08-0d447299c4bf",
                                                "text": "those organic arts which enable men to discourse and write perspicuously"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94db0575-38af-3cea-b6b0-f205c3ea69b8",
                                        "entry_id": "5fec3583-3bbf-3b8f-a714-38f7d4a1e8f9",
                                        "glosses": [
                                            "Generated according to the ranking algorithms of a search engine, as opposed to deliberate promotional techniques e.g. by advertisers."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfa19aee-442f-43a6-8580-29cdbfe4cc23",
                                                "sense_id": "94db0575-38af-3cea-b6b0-f205c3ea69b8",
                                                "text": "According to a recent survey by Jupiter Research, 80 percent of Web users get information from organic search results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c407a38a-727e-37ad-8946-fce589176f93",
                                        "entry_id": "5fec3583-3bbf-3b8f-a714-38f7d4a1e8f9",
                                        "glosses": [
                                            "Developing in a gradual or natural fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df8c7edd-1903-4a3c-9a5c-e618d15b6e1b",
                                                "sense_id": "c407a38a-727e-37ad-8946-fce589176f93",
                                                "text": "The writing of the script was an organic process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95b5f7eb-f57c-3512-8c78-f21c68d53912",
                                        "entry_id": "5fec3583-3bbf-3b8f-a714-38f7d4a1e8f9",
                                        "glosses": [
                                            "Harmonious; coherent; structured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edded34c-faef-4e88-b774-8b2e65779f9c",
                                                "sense_id": "95b5f7eb-f57c-3512-8c78-f21c68d53912",
                                                "text": "The production came together in an organic whole."
                                            }
                                        ]
                                    }
                                ]
