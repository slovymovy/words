                ],
                "senses": [
                    {
                        "sense_id": "2885bbe8-d7bc-3111-8d30-3366b8e0d380",
                        "entry_id": "86310ad5-12c0-3abf-8a62-ea9eb6617fef",
                        "glosses": [
                            "Annuler l’exploration de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c5ad5ad-44d1-4c81-980c-3020880332a0",
                                "sense_id": "2885bbe8-d7bc-3111-8d30-3366b8e0d380",
                                "text": "Selon ses créateurs, le fils de l'intelligence irait jusqu’à le rendre capable de désexplorer des années d’émotion."
                            },
                            {
                                "example_id": "5f6585a1-6365-47f4-95b4-ff9a60cd2784",
                                "sense_id": "2885bbe8-d7bc-3111-8d30-3366b8e0d380",
                                "text": "En fait, dans ce paysage réexploré à rebours (« désexploré »), ne se présentaient que des confluents."
                            },
                            {
                                "example_id": "4fae6a05-d50a-4d12-b7ed-2d3cde6a1bac",
                                "sense_id": "2885bbe8-d7bc-3111-8d30-3366b8e0d380",
                                "text": "Mais tout est redite – les rapports humains ont été explorés, réexplorés, désexplorés, et pourtant nous réagissons toujours au grain de vérité que nous reconnaissons au cœur de ces situations lorsqu’elles nous sont présentées à l’écran."
                            }
                        ]
                    }
                ],
