                                "example_id": "4ce92110-dc85-4af6-bc99-0625c92ec51c",
                                "sense_id": "87ca59f9-ff7c-3630-a088-f52e18a765f3",
                                "text": "He deserves a swacking bonus for persuading me to make my letter into pipe-lights."
                            },
                            {
                                "example_id": "165a96e6-1639-4c62-a6f5-d703754a79d2",
                                "sense_id": "87ca59f9-ff7c-3630-a088-f52e18a765f3",
                                "text": "When Arthur first did rule the land, He made a large pudding a ding ding, Great swacking plums he did put in, etc., etc."
                            },
                            {
                                "example_id": "3651263b-fddb-4070-a390-a747c77a1284",
                                "sense_id": "87ca59f9-ff7c-3630-a088-f52e18a765f3",
                                "text": "[…] the human face, close up and cropped by the frame, a pearly or tanned mask of flat paint with schemantic shading, great swacking eyelashes and lipstick-colored lips."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9c15dd6-da59-33f3-8858-8f4f020f930b",
                        "entry_id": "ffc5228c-24a8-34fd-a94b-ecbc5b024313",
                        "glosses": [
                            "Characteristic of a swack."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "165ec079-828b-4f60-84fa-46371db703e8",
                                "sense_id": "e9c15dd6-da59-33f3-8858-8f4f020f930b",
                                "text": "There was a swacking sound of clubbed wood upon flesh;"
                            },
                            {
                                "example_id": "c619b7c8-a2d7-4e8e-924d-5155bcbe436f",
                                "sense_id": "e9c15dd6-da59-33f3-8858-8f4f020f930b",
                                "text": "If you are careless in your approach you will hear a great swacking sound echo through the trees and see a mighty spray of water — then all will be quiet."
                            },
                            {
                                "example_id": "84f066bc-1986-47e6-9e33-fb98b7d5007a",
                                "sense_id": "e9c15dd6-da59-33f3-8858-8f4f020f930b",
                                "text": "\"What went on? How come those two got killed?\" demanded the burlier of the pair, tapping a nightstick across his palm with loud swacking sounds."
                            }
                        ]
                    }
