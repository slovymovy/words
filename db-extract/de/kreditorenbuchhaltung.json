                "senses": [
                    {
                        "sense_id": "94e87b69-ae15-3880-9025-0320aca5cf86",
                        "entry_id": "5b72c101-3e4d-32db-b23a-8cb5e816c224",
                        "glosses": [
                            "Verarbeitung der Verbindlichkeiten, die ein Unternehmen infolge von Lieferungen und Leistungen von Lieferanten (=Kreditoren) eingegangen ist"
                        ],
                        "tags": [
                            "Rechnungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "b7a2d942-11a3-44c9-967f-221c3866a379",
                                "sense_id": "94e87b69-ae15-3880-9025-0320aca5cf86",
                                "text": "Mit der Kreditorenbuchhaltung hat man seine laufenden Zahlungsverpflichtungen im Blick."
                            },
                            {
                                "example_id": "cf49cdee-9a10-4de3-8778-5e919fed48fc",
                                "sense_id": "94e87b69-ae15-3880-9025-0320aca5cf86",
                                "text": "Dieser Kurs vermittelt ihnen die notwendigen Kenntnisse der Kreditorenbuchhaltung."
                            },
                            {
                                "example_id": "3519ff89-ab56-4b25-b733-4b9b395fcfe4",
                                "sense_id": "94e87b69-ae15-3880-9025-0320aca5cf86",
                                "text": "In der Kreditorenbuchhaltung werden eingehende Rechnungen laufend erfasst und kontiert. Bevor diese jedoch ausgeglichen („bezahlt“) werden, durchlaufen sie eine festgelegte innerbetriebliche Abarbeitung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48ab6d25-4d94-3597-b6e7-e99cb6d18602",
                        "entry_id": "5b72c101-3e4d-32db-b23a-8cb5e816c224",
                        "glosses": [
                            "Abteilung, die sich mit [1] befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc067df5-af2f-4e0f-97f5-daea91724e47",
                                "sense_id": "48ab6d25-4d94-3597-b6e7-e99cb6d18602",
                                "text": "In der Kreditorenbuchhaltung werden eingehende Rechnungen laufend erfasst und kontiert. Bevor diese jedoch ausgeglichen („bezahlt“) werden, durchlaufen sie eine festgelegte innerbetriebliche Abarbeitung."
                            },
                            {
                                "example_id": "3313f37e-55e4-47fb-ac0f-cd147a6d3ce7",
                                "sense_id": "48ab6d25-4d94-3597-b6e7-e99cb6d18602",
                                "text": "Herr Finck aus der Kreditorenbuchhaltung ist krank."
                            },
                            {
                                "example_id": "9cf6029c-457e-4ecf-853b-ff29c6feaa3d",
                                "sense_id": "48ab6d25-4d94-3597-b6e7-e99cb6d18602",
                                "text": "Die Kreditorenbuchhaltung ist heute komplett nicht erreichbar, die sind alle auf einem Seminar."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
