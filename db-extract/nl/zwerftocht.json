                                "target_senses": [
                                    {
                                        "sense_id": "01772600-229a-3f8d-a7bc-10093320d7b0",
                                        "entry_id": "5ec32b30-7fc8-3394-b97b-566f008f610e",
                                        "glosses": [
                                            "Bewegung zu Fuß oder mittels eines Fahrzeugs in einer bestimmten Umgebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191305c0-7497-4101-956b-a4456992baba",
                                                "sense_id": "01772600-229a-3f8d-a7bc-10093320d7b0",
                                                "text": "„Annette fühlte sich bei ihren Streifzügen mit Tante Betty ausnehmend wohl: Ihr Herz hüpfte.“"
                                            },
                                            {
                                                "example_id": "abffaabf-9ee2-4158-adca-b902bb373777",
                                                "sense_id": "01772600-229a-3f8d-a7bc-10093320d7b0",
                                                "text": "„Er träumt immerzu von neuen Abenteuern und Streifzügen durchs Land.“"
                                            },
                                            {
                                                "example_id": "c33f6d8b-75f1-4951-9b89-8e91da9efd20",
                                                "sense_id": "01772600-229a-3f8d-a7bc-10093320d7b0",
                                                "text": "„Wenn er von seinen Streifzügen zurückkehrte, erlag das ganze Mietshaus seinem Luftpiratencharme.“"
                                            },
                                            {
                                                "example_id": "63b1917b-f98f-44e5-9aaf-6d8c52cd2c57",
                                                "sense_id": "01772600-229a-3f8d-a7bc-10093320d7b0",
                                                "text": "„Und doch legte ich diese romantische Folie auf die Orte, die ich bei meinen Streifzügen durch die DDR entdeckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06858e1b-d33b-30bb-ba5c-464a463433bd",
                                        "entry_id": "5ec32b30-7fc8-3394-b97b-566f008f610e",
                                        "glosses": [
                                            "kursorische Behandlung eines Themengebiets"
                                        ],
