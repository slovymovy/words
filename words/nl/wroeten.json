{
    "word_family": [
        "gewroet",
        "wroeter",
        "omwroeten",
        "doorwroeten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38909bfb-ac80-3ff1-a8a6-7045ebd6f8ce",
                    "sense_definition": "in de grond of aarde woelen, vaak met de snuit of handen, om iets te zoeken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "graven_woelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De varkens <w>wroeten</w> vrolijk in de modder op zoek naar lekkere wortels.",
                            "target_lang_translations": {
                                "en": "The pigs are happily <w>rooting</w> in the mud searching for tasty roots."
                            }
                        },
                        {
                            "text": "Hij <w>wroette</w> urenlang in de aarde van de tuin om zijn verloren sleutel te vinden.",
                            "target_lang_translations": {
                                "en": "He <w>rooted around</w> for hours in the garden soil to find his lost key."
                            }
                        }
                    ],
                    "synonyms": [
                        "woelen",
                        "omwoelen"
                    ],
                    "common_phrases": [
                        "in de aarde wroeten",
                        "in de modder wroeten"
                    ],
                    "target_lang_definitions": {
                        "en": "to dig or turn over soil, earth, or mud, often using a snout or hands, searching for something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "root",
                                "target_lang_sense_clarification": "especially of animals digging with the snout"
                            },
                            {
                                "target_lang_word": "root around",
                                "target_lang_sense_clarification": "to search through soil, earth, or objects"
                            },
                            {
                                "target_lang_word": "rummage",
                                "target_lang_sense_clarification": "to dig around searching"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3332237f-8ae9-3853-a50b-424e795e5da6",
                    "sense_definition": "gangen of holen graven onder de grond",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "graven_woelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mollen <w>wroeten</w> diep onder het grasveld en laten overal hopen achter.",
                            "target_lang_translations": {
                                "en": "The moles <w>burrow</w> deep beneath the lawn and leave mounds everywhere."
                            }
                        },
                        {
                            "text": "Het kleine dier <w>wroette</w> zich snel een weg door het zachte zand.",
                            "target_lang_translations": {
                                "en": "The little animal quickly <w>burrowed</w> its way through the soft sand."
                            }
                        }
                    ],
                    "synonyms": [
                        "graven"
                    ],
                    "target_lang_definitions": {
                        "en": "to dig tunnels or burrows underground"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burrow",
                                "target_lang_sense_clarification": "digging tunnels underground"
                            },
                            {
                                "target_lang_word": "tunnel",
                                "target_lang_sense_clarification": "digging passage ways underground"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}