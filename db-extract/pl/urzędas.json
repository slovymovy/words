                                "example_id": "cf987f26-ea80-42ac-bbe8-96cbbfb0811b",
                                "sense_id": "b7ea32fa-97d9-3c08-8b93-3132284f9c5a",
                                "text": "Dziś wydanie pozwolenia na budowę urzędas może sobie wydłużać pod różnymi pretekstami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
