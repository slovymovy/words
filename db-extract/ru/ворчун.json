                                        "entry_id": "5b192def-bd50-3e93-b545-fef64d4c5955",
                                        "glosses": [
                                            "Qui est porté à protester de façon hargneuse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6e34dd-4a45-4dd0-ba4a-4110eb957417",
                                                "sense_id": "08499f15-670c-318f-a4cd-024de1f3cc29",
                                                "text": "Et on s’engueule dans le tramway déjà un bon coup pour se faire la bouche. Les femmes sont plus râleuses encore que les moutards."
                                            },
                                            {
                                                "example_id": "3627ece7-29e3-4d7e-a7c7-4a603b751f8d",
                                                "sense_id": "08499f15-670c-318f-a4cd-024de1f3cc29",
                                                "text": "On ne savait pas se parler entre nous autrement que d’une manière râleuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "râleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea8bc2be-ec74-3f3a-b429-7f9e171a4619",
                                        "entry_id": "72e535cd-8365-3f37-b539-6af8e09738de",
                                        "glosses": [
                                            "Personnage qui aime à protester de façon hargneuse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64539e8d-d658-403d-b920-1a669d3fc010",
                                                "sense_id": "ea8bc2be-ec74-3f3a-b429-7f9e171a4619",
                                                "text": "Bref, au bout de presque deux mois, sans doute en avait-il marre de voir ce râleur de français, l’artiste me remet une magnifique spatule triangulaire avec un manche courbé."
                                            }
                                        ]
