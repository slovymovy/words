                "senses": [
                    {
                        "sense_id": "b0021c23-0acf-3e48-a740-c1e3fb807dd8",
                        "entry_id": "c97573f9-a63f-3780-a877-cbe41bea04b0",
                        "glosses": [
                            "Donner un caractère marital à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6ab7b7b-9d73-4ad6-9f36-6c7cda28128b",
                                "sense_id": "b0021c23-0acf-3e48-a740-c1e3fb807dd8",
                                "text": "Il a été d'usage au 19ème siècle (relire \"Une Vie\" de Maupassant) de maritaliser le nom des femmes (nom et prénom parfois) mais aucune loi ne l'impose."
                            },
                            {
                                "example_id": "ad342191-b06e-4961-af57-83a1e0c699f1",
                                "sense_id": "b0021c23-0acf-3e48-a740-c1e3fb807dd8",
                                "text": "Cependant on peut la ranger dans cette catégorie puisque le narrateur dit qu’avec elle, il s’était « maritalisé »."
                            },
                            {
                                "example_id": "d53f4ad7-de9e-49eb-a4d3-9d4cf05ae5cc",
                                "sense_id": "b0021c23-0acf-3e48-a740-c1e3fb807dd8",
                                "text": "Etre foutues et mères : donc se maritaliser, rendre visite le samedi, songer à la seule vagination !"
                            }
                        ]
                    }
