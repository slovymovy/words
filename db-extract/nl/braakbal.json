                                        "entry_id": "b781d425-62d9-3279-a0d1-7958dbd67187",
                                        "glosses": [
                                            "Ballen von unverdaulichen Resten der Nahrung, den bestimmte Vogelarten herauswürgen"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
