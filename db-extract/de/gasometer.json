                "senses": [
                    {
                        "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                        "entry_id": "2ffc7197-12df-3be6-a091-5c38a604c2e6",
                        "glosses": [
                            "großer Behälter, der zur Lagerung großer Gasmengen bei Normtemperatur und -druck dient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ffd416-1f5b-4d5e-b697-c58b8fd063b6",
                                "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                "text": "Der Gasometer in Oberhausen ist Europas größter Scheibengasbehälter."
                            },
                            {
                                "example_id": "213494ce-0bcb-4aa5-9953-07025184990b",
                                "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                "text": "„Ich hatte das Gefühl, als wäre mein Knie so dick und rund wie ein Gasometer.“"
                            },
                            {
                                "example_id": "1586d788-6343-42b1-aac2-9a0b0f7d9579",
                                "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                "text": "„Drei Runden später in der Haarnadelkurve am Gasometer bekam er Anschluss an ihn und hängte sich wie ein Terrier an seine Hinterräder.“"
                            },
                            {
                                "example_id": "f15e8062-0f42-4b44-853d-bc53350d80e7",
                                "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                "text": "„Der graue Gasometer ist faltig zusammengesackt wie ein riesiger alter Bovist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f57e728-d528-447d-af14-f34fe84ae3a7",
                        "source_entry_id": "2ffc7197-12df-3be6-a091-5c38a604c2e6",
                        "source_sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                        "source_sense_description": "großer Gasbehälter",
                        "target_lang_word": "gasometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gasometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7a2fbc7-663c-35fe-ab7c-0ea56e9e3947",
                                        "entry_id": "5f7a1e0a-5baa-3fca-b33d-ecf3985d2ad1",
                                        "glosses": [
                                            "An apparatus used to store or measure gas or the flow of gas, particularly in a laboratory setting."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c15d4f3-e8e7-4fbf-a755-5dab9a863764",
                                                "sense_id": "c7a2fbc7-663c-35fe-ab7c-0ea56e9e3947",
                                                "text": "The collected air was metered through a gasometer, and the composition of every gas sample was analyzed in duplicate […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6379ca5-cc19-378b-b67c-21ef4bd6ee6c",
                                        "entry_id": "5f7a1e0a-5baa-3fca-b33d-ecf3985d2ad1",
                                        "glosses": [
                                            "A large tank or reservoir for storing gas; a gasholder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a22e783d-96a5-4235-adf2-2aaab32ca6dc",
                                                "sense_id": "b6379ca5-cc19-378b-b67c-21ef4bd6ee6c",
                                                "text": "The attack on the gasworks was probably the most risky, as none of the rebels had any idea of just what kind of blast an exploding gasometer might produce […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64465a15-9dbc-40da-9d5c-0efd2e544a77",
                        "source_entry_id": "2ffc7197-12df-3be6-a091-5c38a604c2e6",
                        "source_sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                        "source_sense_description": "großer Gasbehälter",
                        "target_lang_word": "gasholder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gasholder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc3cc9ff-c0ec-3cd1-ac2f-d3c3ca50f24e",
                                        "entry_id": "c2f66692-d4b2-3d15-b6e9-a25136178ba1",
                                        "glosses": [
                                            "A large cylindrical tank used for storing gas, especially town gas (1870s-1940s) or natural gas (1950s-present). Types include one with telescopic sections with wet seals in between and one with a nontelescoping tank and a dry seal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026dcca1-b959-40a5-9e88-b3b2cfb22332",
                                                "sense_id": "cc3cc9ff-c0ec-3cd1-ac2f-d3c3ca50f24e",
                                                "text": "Its first big task was in 1915, at a fire at the Southern Laundry, next to the Great Western Hotel; its last major action was in 1942, when, after an enemy air attack, it helped to save the big gasholder at Swindon Works."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04f88d50-147b-4401-9f21-3b828d8e1e5a",
                        "source_entry_id": "2ffc7197-12df-3be6-a091-5c38a604c2e6",
                        "source_sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                        "source_sense_description": "großer Gasbehälter",
                        "target_lang_word": "gazomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea126ce9-9555-3811-b135-5bea36e4d61b",
                                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                                        "glosses": [
                                            "Appareil servant à emmagasiner le gaz et à lui donner, pendant la consommation, une pression constante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff8afc5-ed10-4cb5-b054-76589e27b5a8",
                                                "sense_id": "ea126ce9-9555-3811-b135-5bea36e4d61b",
                                                "text": "Le gazomètre de cette usine à gaz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7faa2540-8c82-311d-86cc-df85cb7b0241",
                                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                                        "glosses": [
                                            "Ce même appareil qui donne aussi la mesure du gaz dépensé."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                                        "glosses": [
                                            "Grand réservoir contenant le gaz à distribuer."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42d3ac1-9d02-4c00-817a-b639ec765f67",
                                                "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                                                "text": "Ces tanks, situés contre la digue, au sud […] de la borne 15, sont deux immenses réservoirs à pétrole en forme de gazomètres, déjà troués comme des écumoires, […]."
                                            },
                                            {
                                                "example_id": "45e8d1fd-89c8-41a1-81c6-1caec06b7573",
                                                "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                                                "text": "Il contemplait la vaste usine à gaz de Bun Hill. Au-dessus des gazomètres pressés les uns contre les autres, trois formes étranges apparurent, […] des ballons que l’on gonflait pour les ascensions hebdomadaires de l’Aéro-Club."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
