                        "examples": [
                            {
                                "example_id": "def5ef19-ddd9-4a70-bb77-c4e4ccd0b44c",
                                "sense_id": "97bc0767-f27c-3391-b6cb-e8fc53cb0967",
                                "text": "Volgens Ronnie Sumiller van de Filipijnse dienst voor wild- en natuurbeheer is het logisch dat Lolong in de stress is geschoten. Er waren honderd mensen voor nodig om het dier met een touw van het water naar een open plek te trekken. Daar werd het met een kraan op een vrachtwagen gehesen, nadat zijn bek was dichtgebonden met nylondraad en een net."
                            },
                            {
                                "example_id": "b444ef77-23f6-45dd-9545-979dc5df0225",
                                "sense_id": "97bc0767-f27c-3391-b6cb-e8fc53cb0967",
                                "text": "Een 27-jarige fietser is in Diemen gewond geraakt aan zijn hals, toen hij tegen een nylondraad aanfietste die over het fietspad was gespannen."
                            }
                        ]
                    }
