                "senses": [
                    {
                        "sense_id": "713babb8-0dfd-3741-9c1f-c1bcdc372394",
                        "entry_id": "01c21cb0-36c3-3a58-8e87-8709a8aecbca",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c99c20-f12e-4f1a-8f52-a31849b74703",
                                "sense_id": "713babb8-0dfd-3741-9c1f-c1bcdc372394",
                                "text": "Frau Popper ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ae0789a1-e4a2-40d9-b421-ca2c9604c77b",
                                "sense_id": "713babb8-0dfd-3741-9c1f-c1bcdc372394",
                                "text": "Herr Popper wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "67e609bc-2c85-4066-ad48-60408826d4e2",
                                "sense_id": "713babb8-0dfd-3741-9c1f-c1bcdc372394",
                                "text": "Die Poppers kommen heute aus dem Spreewald."
                            },
                            {
                                "example_id": "ae68271b-9053-43cb-a78c-cb3fb97f740a",
                                "sense_id": "713babb8-0dfd-3741-9c1f-c1bcdc372394",
                                "text": "Der Popper trägt nie die Schals, die die Popper ihm strickt."
                            },
                            {
                                "example_id": "6547869a-46ed-487f-9fdb-09e5814eb825",
                                "sense_id": "713babb8-0dfd-3741-9c1f-c1bcdc372394",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Popper kommt, geht der Herr Popper.“"
                            },
                            {
                                "example_id": "4c4a7e2c-50e4-4b1b-86c4-69b0beedefc2",
                                "sense_id": "713babb8-0dfd-3741-9c1f-c1bcdc372394",
                                "text": "Popper kommt und geht."
                            },
                            {
                                "example_id": "e40c959a-f4c1-47e9-b3fe-b05523a82020",
                                "sense_id": "713babb8-0dfd-3741-9c1f-c1bcdc372394",
                                "text": "Poppers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
