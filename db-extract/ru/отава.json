                    },
                    {
                        "translation_id": "b020cf94-febf-4c88-8894-0cabcebcba0e",
                        "source_entry_id": "afa77201-3e0c-36d3-9a92-ab0436f900f8",
                        "source_sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
                        "target_lang_word": "regain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                        "entry_id": "7f1ff350-1db7-3578-9449-2eb438457889",
                                        "glosses": [
                                            "Herbe qui repousse dans les prés après qu’ils ont été fauchés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dadc363-b00f-4af4-9627-1666f375740e",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "L’avoine et le blé jaunirent avant d’avoir atteint leur croissance ; le soleil incessant brûla l’herbe et les regains de trèfle."
                                            },
                                            {
                                                "example_id": "308f4231-41af-46f9-8337-a2ff4872f6c1",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Il imaginait la nuit, ce ciel d’août, fourmillant, l’odeur du regain en meule qu’on ne verrait pas."
                                            },
                                            {
                                                "example_id": "2ec8a0fc-74b9-4733-a4c2-07f9e8f2a45c",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Faucher le regain."
                                            },
                                            {
                                                "example_id": "4bd6b8e8-5af5-4e04-8cc8-125aaca8482e",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Et Rodolphe et la Goualeuse de se prendre par la main et de courir à perdre haleine dans une vaste pièce de regain tardif, récemment fauché."
                                            },
                                            {
                                                "example_id": "49cc9901-5d79-43ec-ab5b-e5bd652887a7",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Étourdies par l’odeur du regain fraîchement coupé, par l’odeur des chèvrefeuilles, par l’odeur des blés noirs en fleurs."
                                            },
                                            {
                                                "example_id": "882a7c7c-ba3c-452c-8f8f-1cc26953fe69",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Les écoliers ont repris le tablier noir, plus que jamais halés d’air vif […] Ils ont gardé les vaches de la herde, fané les regains dans les combes lointaines."
                                            },
                                            {
                                                "example_id": "ba6cff3e-29d3-4f12-ae38-c5bd429096de",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "De sorte que le petit vallon herbu, autrefois pâturé et fauché (il y avait même le regain en août à cause de la fraîcheur du lieu), s’était enfriché au point de devenir difficile de pénétration et par endroit, inextricable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                        "entry_id": "7f1ff350-1db7-3578-9449-2eb438457889",
                                        "glosses": [
                                            "Reprise d’un avantage perdu, recrudescence inattendue, action de regagner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04493454-75c3-4b67-83ee-13b43e340610",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "Un regain d'activité."
                                            },
                                            {
                                                "example_id": "134e7c5d-8008-49a9-9a57-a1b80e6cb6ba",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "Il connut pendant quelque temps un regain de faveur."
                                            },
                                            {
                                                "example_id": "2dd35d79-22df-4c22-bbc4-d56ab4d87ff0",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "La tiède après-midi d’octobre qui, en donnant au Bois un regain de printemps, avait fait sortir les grandes mondaines en voiture découverte, menaçait de se terminer par une soirée d’une fraîcheur aiguë."
                                            },
                                            {
                                                "example_id": "f07799e3-df9a-407f-b1fd-12e9b6e96279",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "Mais cette souffrance et ce regain d’amour pour Gilberte ne furent pas plus longs que ceux qu’on a en rêve."
                                            },
                                            {
                                                "example_id": "5b501c64-6964-41c8-afd4-fb3e259ef555",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "Obtenir un regain de confiance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
