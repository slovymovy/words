                                "target_senses": [
                                    {
                                        "sense_id": "19dca327-c93c-381f-b746-a8222ba9361f",
                                        "entry_id": "45d950ca-1e28-3a8f-a71c-bf197f2f78d6",
                                        "glosses": [
                                            "The quality of being impudent, not showing due respect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc3cb01f-432b-3aee-95e3-05c32901c717",
                                        "entry_id": "45d950ca-1e28-3a8f-a71c-bf197f2f78d6",
                                        "glosses": [
                                            "Impudent language, conduct or behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f063f9f4-c4e0-453e-a1a1-73dd0a9f5015",
                                                "sense_id": "bc3cb01f-432b-3aee-95e3-05c32901c717",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired. And if the arts of humbleness failed him, he overcame you by sheer impudence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abeea727-fca1-4efc-9173-d721c43d71fa",
                        "source_entry_id": "d3d1021d-55ca-303c-9ca1-b2a55190351d",
                        "source_sense_id": "f83b7ca4-b262-3105-b6f6-8b09ead5bb3e",
                        "source_sense_description": "handeling die uiting geeft aan een gebrek aan achting of beleefdheid",
                        "target_lang_word": "rudeness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudeness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                                        "glosses": [
                                            "The property of being rude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42eb88f4-086a-4f56-b6fa-59ec8f692701",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "His rudeness was inexcusable."
                                            },
                                            {
                                                "example_id": "46cde39f-45b4-4e68-9e66-24bd843d8d29",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The rudeness of the cabin gave it a rustic charm but little comfort."
                                            },
                                            {
                                                "example_id": "e833ba91-26f7-4879-87c3-1d4c4a3e8e16",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The house was apparently very old; it had an almost prehistoric look about it, so rude and weatherbeaten was it, but the rudeness of the masonry and the lichening of the stones were no real indications of antiquity […]"
                                            },
                                            {
                                                "example_id": "e4afbf98-c900-4029-988c-7bdc0b17f05e",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The woman who deliberately yelled out in the second set, when Henin was about to serve at 5-3 for the championship, was the epitome of the absolute self-centered rudeness that was exhibited at the Open, as well as in our society today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                                        "glosses": [
                                            "A rude remark or behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0c48072-9ab4-4cfb-884d-38226ad61fea",
                                                "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                                "text": "I'm sick of his rudenesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6caf455-7447-4478-93d0-fd1e453a53d0",
