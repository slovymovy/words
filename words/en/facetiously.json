            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c8bc141c-b642-33c2-9342-9941eaf39833",
                    "sense_definition": "In a flippant manner, treating serious issues with deliberately inappropriate humor.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke <w>facetiously</w> about the crisis, which angered the people trying to resolve it."
                        },
                        {
                            "text": "She suggested <w>facetiously</w> that we should just print more money to pay off the national debt."
                        }
                    ],
                    "synonyms": [
                        "flippantly"
                    ],
                    "antonyms": [
                        "seriously"
                    ],
                    "common_phrases": [
                        "remark facetiously",
                        "suggest facetiously",
                        "comment facetiously"
                    ]
                },
                {
                    "sense_id": "0fe4d823-572f-3021-b74f-0f747ff8a085",
                    "sense_definition": "In a pleasantly humorous, lighthearted, or playful fashion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host smiled and <w>facetiously</w> blamed the rainy weather on the guest of honor."
                        },
                        {
                            "text": "She teased her brother <w>facetiously</w> about his terrible cooking skills during dinner."
                        }
                    ],
                    "synonyms": [
