                        "examples": [
                            {
                                "example_id": "66eebfe9-6e34-4962-a115-f2475604113d",
                                "sense_id": "2d223f62-325b-3cda-aed3-ec21d29f877e",
                                "text": "De Limburgers hadden in het zinderende competitieslot genoeg aan een 1-1 gelijkspel tegen concurrent Standard Luik."
                            },
                            {
                                "example_id": "de713eac-42b1-4278-9779-6130064da0b3",
                                "sense_id": "2d223f62-325b-3cda-aed3-ec21d29f877e",
                                "text": "Na een matig competitieslot is ADO in de play-offs helemaal opgeleefd. Met een aanstekelijke spelvreugde creëerde het flink wat kansen en na een schitterende pass van Aleksander Radosavljevic opende Jens Toornstra koeltjes de score. Na de rust maakte de middenvelder ook nog eens de 2-0."
                            },
                            {
                                "example_id": "7fe6c083-f5ba-4428-8490-44b2c158d043",
                                "sense_id": "2d223f62-325b-3cda-aed3-ec21d29f877e",
                                "text": "Het is afwachten of Feyenoord dit weekend in een counter-modus naar Eindhoven komt. De duels tussen PSV en Feyenoord staan doorgaans garant voor vermaak. Vorig seizoen boekte de thuisclub een late zege (3-2), wat volgens Dries Mertens \"de kampioensoverwinning\" was. Hij kwam bedrogen uit; het competitieslot kreeg voor PSV zoals bekend een compleet andere wending."
                            }
                        ]
