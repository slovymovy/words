    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3907ddc5-41ed-3e43-bd95-70efcb4fa7ec",
                "word": "ferule",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "69037207-acb8-4dfe-82c5-64a4a47c40cb",
                        "entry_id": "3907ddc5-41ed-3e43-bd95-70efcb4fa7ec",
                        "tags": [
