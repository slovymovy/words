                "translations": [
                    {
                        "translation_id": "db3beb3f-3530-42a3-9257-1a3278bd3b09",
                        "source_entry_id": "d722a04e-bdf7-3d79-947b-fca8d48db158",
                        "target_lang_word": "kanadisch",
