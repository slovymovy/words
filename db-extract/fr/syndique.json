                    {
                        "form_id": "059bbaec-e0e1-4f48-919e-7c3f10b36fed",
                        "entry_id": "bd4ba745-f6fd-33eb-94da-0611f2cb9e46",
                        "tags": [
                            "masculine"
                        ],
                        "form": "syndic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9884e37-9d44-312f-84c2-dc377d3b6907",
                        "entry_id": "bd4ba745-f6fd-33eb-94da-0611f2cb9e46",
                        "glosses": [
                            "Celle qui est élue ou désignée pour gérer les affaires d’une collectivité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "216d9c48-a4d9-4a61-b55d-5ab4c0ed1d89",
                                "sense_id": "d9884e37-9d44-312f-84c2-dc377d3b6907",
                                "text": "Les marchandes bouquetières, fleuristes, chapelières en fleurs en la personne de Madame Marlé syndique de la communauté rue du Mouton."
                            }
                        ]
                    },
                    {
                        "sense_id": "2420db89-8456-316d-ad2d-d0a2ff32afcc",
                        "entry_id": "bd4ba745-f6fd-33eb-94da-0611f2cb9e46",
                        "glosses": [
                            "Présidente de commune dans les cantons suisses de Fribourg et de Vaud, ainsi qu’en Val d’Aoste."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "351f5e1f-e681-4a66-87b5-bd6d7b08a699",
                                "sense_id": "2420db89-8456-316d-ad2d-d0a2ff32afcc",
                                "text": "À suivre, la messe, célébrée par le curé Alessandro Cavallo et animée par la maîtrise de la paroisse, et les allocutions des autorités : la syndique de Champdepraz, Monica Cretier, le président du Co.Fe.S.E.V. - Comité Fédéral des Sociétés d’Émigrés Valdôtains, Jean-Pierre Martin Perolino, et le président de la Région, Renzo Testolin, prononceront leurs discours officiels, qui seront suivis par l’intervention d’un jeune originaire de Pont-Saint-Martin ayant quitté sa terre d’origine pour construire son avenir à l’étranger, Andrea Lombardo."
                            }
                        ]
                    },
                    {
                        "sense_id": "07bad182-dac4-36fe-9d67-8b2cd31da6bc",
                        "entry_id": "bd4ba745-f6fd-33eb-94da-0611f2cb9e46",
                        "glosses": [
                            "Celle qui représente un syndicat de copropriété dans la gestion de leurs indivisions."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68541626-4f20-4857-b0dd-359fdf607d42",
                        "source_entry_id": "bd4ba745-f6fd-33eb-94da-0611f2cb9e46",
                        "target_lang_word": "Bürgermeisterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgermeisterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad3ff45-2182-31cf-b665-42081e7e58c0",
                                        "entry_id": "93cfbe11-300c-3129-8bd0-91c89e207f6f",
                                        "glosses": [
                                            "weibliches Oberhaupt einer Stadt, Gemeinde oder anderen Kommune"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8967794e-f99f-476c-a7c6-029e55602f77",
                                                "sense_id": "5ad3ff45-2182-31cf-b665-42081e7e58c0",
                                                "text": "Bürgermeisterin und Gemeinderat verabschieden den neuen Gemeindehaushalt."
                                            },
                                            {
                                                "example_id": "1c25cfcd-f102-42ea-bf61-f2a697e9dbd2",
                                                "sense_id": "5ad3ff45-2182-31cf-b665-42081e7e58c0",
                                                "text": "Athens Bürgermeisterin Dora Bakogianni rief all ihre europäischen Kollegen dazu auf, den Opfern der Flutwelle in Asien zu helfen."
                                            },
                                            {
                                                "example_id": "c5b6ae8f-fb2a-45cc-b2d7-4d0ecf495b61",
                                                "sense_id": "5ad3ff45-2182-31cf-b665-42081e7e58c0",
                                                "text": "„Ich habe bei einer öffentlichen Veranstaltung einmal die Bürgermeisterin dieses Bezirks kennengelernt, eine tapfere Frau, die vor ihrem Wirkungsgebiet überhaupt keine Angst zu haben schien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
