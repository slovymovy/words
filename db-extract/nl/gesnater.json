        "nl-extract.jsonl": [
            {
                "entry_id": "8485f137-4b1f-3ab9-9b1a-35765efc797f",
                "word": "gesnater",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af6a7982-e1a4-30fb-88ab-6388ac587002",
                        "entry_id": "8485f137-4b1f-3ab9-9b1a-35765efc797f",
                        "glosses": [
                            "aanhoudend maken van geluid dat lijkt op dat van ganzen, eenden en nadere vogels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d627ba-a007-4bf9-95ef-c6d547a694bb",
                                "sense_id": "af6a7982-e1a4-30fb-88ab-6388ac587002",
                                "text": "Gonda Schaap wordt met wild gesnater begroet als ze het flamingo-verblijf in Ouwehands Dierenpark nadert. De 25-jarige dierenverzorgster uit Zetten is verantwoordelijk voor alle vogels in de Gelderse dierentuin. „Flamingo’s zijn erg territoriaal”, legt ze uit. „Het liefst worden ze met rust gelaten.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9e0794ac-fded-3006-8cab-de019db22bd4",
                        "entry_id": "8485f137-4b1f-3ab9-9b1a-35765efc797f",
                        "glosses": [
                            "aanhoudend vrolijk en luid kindergeroep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9cea478-6c83-45fa-a52a-6510467b6a1b",
                                "sense_id": "9e0794ac-fded-3006-8cab-de019db22bd4",
                                "text": "\"Vroeger vond ik kinderen eigenlijk heel vervelend\", vertelt Jan in Weekeinde. \"Dat 'geschetter' zei mijn vader altijd over kinderen, dat gesnater en lawaai.\""
                            },
                            {
                                "example_id": "21434779-fa36-495f-983b-0ac87f615536",
                                "sense_id": "9e0794ac-fded-3006-8cab-de019db22bd4",
                                "text": "Ik wil zo graag naar zee / gesnater en geklater / van kinderen op het strand / zon en zout op huid / het vele licht, de hoge lucht / lopen langs de vloedlijn / blote voeten in het water / of in het rulle zand."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbfda48d-689c-395d-8beb-67b147d258f0",
                        "entry_id": "8485f137-4b1f-3ab9-9b1a-35765efc797f",
                        "glosses": [
                            "zinloos gepraat"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b32a052-2454-499f-bead-473e28fc2517",
