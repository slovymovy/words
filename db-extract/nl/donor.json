                                "target_senses": [
                                    {
                                        "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                                        "entry_id": "b6f28072-96ec-348f-9e2b-ee40493121a5",
                                        "glosses": [
                                            "One who makes a donation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f434fd6-ba5e-4aac-aa24-1bff8bd07436",
                                                "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                                                "text": "The charity raised $2,000 from various donors."
                                            },
                                            {
                                                "example_id": "6a5e987f-ce21-43b1-9237-aeda4f8f44d6",
                                                "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                                                "text": "The hospital is seeking an organ donor."
                                            },
                                            {
                                                "example_id": "4564271f-5e34-4c65-aab9-7bbef7a43aa1",
                                                "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                                                "text": "\"You prefer, then, having the money to the ornaments which I had intended for you?\"/\"Oh! the hundred pounds, certainly,\" exclaimed Isabella, colouring a little at the idea of trespassing on the donor's generosity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29e9ce5d-6703-32bb-8ed6-49a18801e789",
                                        "entry_id": "b6f28072-96ec-348f-9e2b-ee40493121a5",
                                        "glosses": [
                                            "An object, typically broken beyond repair, that is used for spare parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2dcd72d-53aa-4cfd-a777-01ca086ea180",
                                                "sense_id": "29e9ce5d-6703-32bb-8ed6-49a18801e789",
                                                "text": "You'll need to lengthen the plug for the fan switch and swap its connector for that of the donor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d28b723-3416-3a1a-a76e-ddbdb5853d73",
                                        "entry_id": "b6f28072-96ec-348f-9e2b-ee40493121a5",
                                        "glosses": [
                                            "A group or molecule that donates either a radical, electrons or a moiety in a chemical reaction. Compare acceptor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e459184-d4cf-4527-a23c-691daacb1302",
                                                "sense_id": "4d28b723-3416-3a1a-a76e-ddbdb5853d73",
                                                "text": "a carbonyl donor molecule"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a5c9a4c-13f1-4f37-ba2a-0e0907b81093",
                        "source_entry_id": "fdab032e-1a98-3f35-8dc5-9b2e9b85ded6",
                        "source_sense_id": "882cc0a9-0929-3eb1-96c6-458f3a5563f8",
                        "source_sense_description": "gever, bijv. orgaandonor: degene die zijn orgaan afstaat",
                        "target_lang_word": "donneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a378cd56-3827-332c-8045-2e67ab04428c",
                                        "entry_id": "fcd707d5-e076-34a3-904c-d335b0e95571",
                                        "glosses": [
                                            "Celui qui donne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f884468-de02-4abf-88cd-2a5202d6a449",
                                                "sense_id": "a378cd56-3827-332c-8045-2e67ab04428c",
                                                "text": "Deux nouvelles gifles lui ont fait ravaler le reste. Ça sentait le roussi. […].\nLuca est parti en claudiquant. Aucune émotion sur le visage du donneur de baffes."
                                            },
                                            {
                                                "example_id": "43b3eb1a-d16a-49c3-bd94-d85163ad8ebd",
                                                "sense_id": "a378cd56-3827-332c-8045-2e67ab04428c",
                                                "text": "Rancière s’en prendra en 1984 à la Leçon sur la leçon, titre de la « leçon inaugurale » de Pierre Bourdieu au Collège de France, en décortiquant de façon très caustique les paradoxes de la position de « donneur de leçon » du sociologue (ES 28)."
                                            },
                                            {
                                                "example_id": "3efa45dc-9759-4cf3-bcc2-3bf7d1dde154",
                                                "sense_id": "a378cd56-3827-332c-8045-2e67ab04428c",
                                                "text": "Ainsi, les individus qui répondent aux sondages par Internet sont une poignée (quelques milliers tout de même) de petits malins, sans autre qualité que de tenir pile-poil dans les cases des quotas, qui ont trouvé dans la représentation autoproclamée de leurs semblables un moyen de se faire des sous et sont devenus des donneurs d’avis professionnels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51d6bbd-d6ad-30c8-9a52-532d411aef4f",
                                        "entry_id": "fcd707d5-e076-34a3-904c-d335b0e95571",
                                        "glosses": [
                                            "Personne qui donne son sang en vue de transfusion ou un organe en vue de transplantation sur un receveur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcde01bf-d0b7-4dbf-825b-47edb703edb7",
                                                "sense_id": "d51d6bbd-d6ad-30c8-9a52-532d411aef4f",
                                                "text": "Une greffe rénale à donneur∙euse vivant∙e nécessite deux interventions (donneur et receveur) se déroulant en parallèle le même jour."
                                            },
                                            {
                                                "example_id": "2c1d4c5f-1cf8-494f-9e30-045d5fcbc6f8",
                                                "sense_id": "d51d6bbd-d6ad-30c8-9a52-532d411aef4f",
                                                "text": "Il est possible de donner son sang de ses 18 ans à ses 70 ans révolus. Il faut peser plus de 50 kg. Un entretien médical sera nécessaire pour être sûr que le don ne présente aucun risque, ni pour le donneur ni pour le receveur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41bb6e83-80d7-37e9-9eb8-ec1486ba3369",
                                        "entry_id": "fcd707d5-e076-34a3-904c-d335b0e95571",
                                        "glosses": [
                                            "Personne qui pratique la délation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6bcbde-150d-4da4-84a1-e3f4c329b638",
                                                "sense_id": "41bb6e83-80d7-37e9-9eb8-ec1486ba3369",
                                                "text": "Le « donneur » était pour lui, le rebut de l’espèce humaine, la trahison, la pire des abjections."
                                            },
                                            {
                                                "example_id": "e56b92ba-71f0-4f64-b529-941e5f76253f",
                                                "sense_id": "41bb6e83-80d7-37e9-9eb8-ec1486ba3369",
                                                "text": "Maintenant, c’est là que je suis, dans une pièce noire, enfermée avec Albert et Lucien, les deux de Montluc, et ce donneur de juifs et de résistants."
                                            },
                                            {
                                                "example_id": "b17a6e5d-44b3-4343-9d9e-d60f1134aa4b",
                                                "sense_id": "41bb6e83-80d7-37e9-9eb8-ec1486ba3369",
                                                "text": "Ce Lévy a plus d’honnêteté que les aryens habituels, laquais et donneurs par destination."
                                            },
                                            {
                                                "example_id": "a549e438-c3db-4b7d-8a4b-24cb898f0009",
                                                "sense_id": "41bb6e83-80d7-37e9-9eb8-ec1486ba3369",
                                                "text": "L’épuration commençait, et l’on avait parqué en ces lieux surréalistes toute une population d’hommes et de femmes. Ceux qui étaient vraiment mouillés ou ceux qui avaient été dénoncés. Car les donneurs faisaient la queue, il fallait prendre des tickets d’appel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96383d8e-bf8c-3745-8ab6-54ad9912bc2e",
                                        "entry_id": "fcd707d5-e076-34a3-904c-d335b0e95571",
                                        "glosses": [
                                            "Celui ou celle qui distribue les cartes ou les jetons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa88253-d054-4153-9dbd-0ba94428f14d",
                                                "sense_id": "96383d8e-bf8c-3745-8ab6-54ad9912bc2e",
                                                "text": "Le donneur distribue 7 cartes à chaque joueur et retourne la première carte de la pioche, qui constitue l’entame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df532acd-26a6-43e4-9890-3a0b71a05fd2",
                        "source_entry_id": "fdab032e-1a98-3f35-8dc5-9b2e9b85ded6",
                        "source_sense_id": "882cc0a9-0929-3eb1-96c6-458f3a5563f8",
                        "source_sense_description": "gever, bijv. orgaandonor: degene die zijn orgaan afstaat",
                        "target_lang_word": "donneuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donneuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed03f0f6-746b-326d-b176-09f96aea6b2d",
                                        "entry_id": "cc4fd9b4-39c0-360f-aa65-a0a234eb51e2",
                                        "glosses": [
                                            "Celle qui donne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88107c22-0046-4096-be2d-788268a923d6",
                                                "sense_id": "ed03f0f6-746b-326d-b176-09f96aea6b2d",
                                                "text": "Donneuse d’eau bénite. → voir bénir"
                                            },
                                            {
                                                "example_id": "e5af3296-3685-4317-aeb6-5c2c9afa0a0d",
                                                "sense_id": "ed03f0f6-746b-326d-b176-09f96aea6b2d",
                                                "text": "Pas question de me poser en donneuse de leçons, mais j’estime que chacun d’entre nous peut et doit assumer sa responsabilité citoyenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0bdca6d-744b-3183-ba6c-df38c088158e",
                                        "entry_id": "cc4fd9b4-39c0-360f-aa65-a0a234eb51e2",
                                        "glosses": [
                                            "Personne, homme ou femme, qui pratique la délation."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a32bbae-331c-4874-ae67-3229dae6139e",
                                                "sense_id": "c0bdca6d-744b-3183-ba6c-df38c088158e",
                                                "text": "Voyant les flics arriver, une vraie donneuse se mit à glapir en me désignant : « Le voilà ! Il est là, il est là. »"
                                            },
                                            {
                                                "example_id": "13a5d325-c90d-410d-9eca-4a4d2d91698a",
                                                "sense_id": "c0bdca6d-744b-3183-ba6c-df38c088158e",
                                                "text": "Il s’est fait poucave par une donneuse. La police est venue perkize chez lui, et il a téssau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7541f313-5d23-3762-98e0-8460791f00ea",
                                        "entry_id": "cc4fd9b4-39c0-360f-aa65-a0a234eb51e2",
                                        "glosses": [
                                            "Celle qui distribue les cartes ou les jetons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2952f75-2700-45eb-8f64-663466659d35",
                                                "sense_id": "7541f313-5d23-3762-98e0-8460791f00ea",
                                                "text": "« Mais je croyais qu’on devait jouer au poker », dis-je. « Cela mis à part, la partie se joue tout comme au poker ordinaire », dit la donneuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
