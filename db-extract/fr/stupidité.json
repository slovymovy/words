        "fr-extract.jsonl": [
            {
                "entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                "word": "stupidité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f4dd2b1b-c2d4-4b21-b649-6babeab6557e",
                        "entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                        "tags": [
                            "plural"
                        ],
                        "form": "stupidités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68c2ed07-87c8-36d5-b8ac-f4600e86980a",
                        "entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                        "glosses": [
                            "Pesanteur d’esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2eaf931-6878-4229-b64f-a9f5662dce18",
                                "sense_id": "68c2ed07-87c8-36d5-b8ac-f4600e86980a",
                                "text": "Ses petits cheveux gris, coupés ras, exprimaient l’indéfinissable stupidité des animaux à sang froid."
                            },
                            {
                                "example_id": "6f90cf17-7ede-4bdb-a395-1faad1dd157d",
                                "sense_id": "68c2ed07-87c8-36d5-b8ac-f4600e86980a",
                                "text": "De tout temps le public a été mal éduqué. Il demande inlassablement à l’art d’être populaire, de répondre à ses goûts, de flatter son absurde vanité, de lui dire ce qu’on lui a déjà dit auparavant, de lui montrer ce qu’il devrait être las de voir, de l’amuser quand il se sent lourd d’avoir trop mangé, et de distraire son esprit quand il est fatigué de sa propre stupidité. L’art ne doit jamais chercher à être populaire ; c’est au public de se faire artiste lui-même."
                            },
                            {
                                "example_id": "036d4aaa-78c8-4ad9-b8e8-2ff90fa4e4f3",
                                "sense_id": "68c2ed07-87c8-36d5-b8ac-f4600e86980a",
                                "text": "C'est contre sa bigoterie, sa stupidité, la stupidité mesquine des médiocres qui veulent briser les ailes du génie, que Thea Kronborg devra livrer la plus dure des luttes qui la mèneront finalement au succès."
                            }
                        ]
                    },
                    {
                        "sense_id": "18fa5feb-2d98-3eae-b29e-791b5f12efe2",
                        "entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                        "glosses": [
                            "Parole ou action stupide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e9545f5-79a2-4c1e-b616-c25833218e35",
                                "sense_id": "18fa5feb-2d98-3eae-b29e-791b5f12efe2",
                                "text": "On nous dit en vain que le grec s’est réfugié dans l’enseignement supérieur, qu'il demeure entier dans quelques chaires et dans quelques bibliothèques. C'est ici la plus grande stupidité que l'on ait dite dans les temps modernes, où pourtant on ne s'est pas privé de dire des stupidités. C'est comme si l'on disait que les anciens Égyptiens vivent et revivent dans les momies des sarcophages des salles basses du Louvre."
                            }
                        ]
                    },
                    {
                        "sense_id": "792361b6-edbf-3acc-90b9-99901a589075",
                        "entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                        "glosses": [
                            "Privation d’esprit et de jugement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9dc5cf4-116d-47eb-ab57-2ebbac1f51e4",
                                "sense_id": "792361b6-edbf-3acc-90b9-99901a589075",
                                "text": "Quand je pense à cette séparation, ce que je retrouve dans ma mémoire, c’est le sentiment de stupidité et d’anéantissement qui me prit tout entier quand je fus dans la rue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "204ad884-574d-43c6-b9fc-c7031d467d14",
                        "source_entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                        "target_lang_word": "Blödheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blödheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e551dcb-b648-3760-9a4d-cf2fcb4b4656",
                                        "entry_id": "ba0ad0ac-01cb-3aae-95f6-3dab17382c3b",
                                        "glosses": [
                                            "die Eigenschaft, blöd zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21935cc4-e991-492a-9c02-560554beff16",
                                                "sense_id": "9e551dcb-b648-3760-9a4d-cf2fcb4b4656",
                                                "text": "Unsere Lage ist nur der Blödheit einiger weniger Leute zu verdanken."
                                            },
                                            {
                                                "example_id": "285dacd1-7545-4c3f-884a-ba42762e4189",
                                                "sense_id": "9e551dcb-b648-3760-9a4d-cf2fcb4b4656",
                                                "text": "„Die Blödheit war für uns Jungs aber nicht das Schlimmste – zumindest für mich war sie später sogar Berufsvoraussetzung.“"
                                            },
                                            {
                                                "example_id": "4da8b2e2-1dc6-4a6d-b42a-255545fbdb0f",
                                                "sense_id": "9e551dcb-b648-3760-9a4d-cf2fcb4b4656",
                                                "text": "„Ich habe jedes einzelne bei den Hörnern genommen, ihm in die Augen geguckt und mich für die Blödheit der Welt entschuldigt und dafür, dass ich sie viel zu früh in den Tod schickte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e7307a3-8de2-3970-9629-dab8ed9c47c1",
                                        "entry_id": "ba0ad0ac-01cb-3aae-95f6-3dab17382c3b",
                                        "glosses": [
                                            "eine schlechte, blöde Handlung oder Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8705e083-24b5-4d26-8c2f-de90879b4ffd",
                                                "sense_id": "8e7307a3-8de2-3970-9629-dab8ed9c47c1",
                                                "text": "Mach keine Blödheiten, während wir weg sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "884a2f88-dc2f-4410-9b61-d075e49ea62c",
                        "source_entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                        "target_lang_word": "stupidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                        "entry_id": "44f4e45f-b2b2-33e4-b4e7-8b7235bccdf0",
                                        "glosses": [
                                            "The property of being stupid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1f608d-64aa-4ebe-a084-c4cc0a076684",
                                                "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                                "text": "I suppose you can put it down to gross stupidity, but that's not much of an excuse."
                                            },
                                            {
                                                "example_id": "7326125d-66d4-486b-beed-5a78d23abb45",
                                                "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them. Soft heartedness caused more harm than good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                        "entry_id": "44f4e45f-b2b2-33e4-b4e7-8b7235bccdf0",
                                        "glosses": [
                                            "An act that is stupid."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299ef560-36cd-4e25-8d1d-8b6d21083b4b",
                                                "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                                "text": "Jimmy's stupidity cost him his car."
                                            },
                                            {
                                                "example_id": "81d94253-4d45-4c29-a849-5474c3e9b753",
                                                "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                                "text": "8. They require that crass stupidities shall not be played upon the reader as “the craft of the woodsman, the delicate art of the forest,” by either the author or the people in the tale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "489c90d1-f7e1-4ae7-b9ab-19334e0ff029",
                        "source_entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
