                    {
                        "form_id": "fb973122-a35f-430d-a8ac-e3ac9f451be2",
                        "entry_id": "9fe35a98-7173-3bec-a07f-8edeea9253cf",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "mortifiantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                        "entry_id": "9fe35a98-7173-3bec-a07f-8edeea9253cf",
                        "glosses": [
                            "Qui mortifie, qui humilie l’amour-propre et cause de la confusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d73e73f-c356-4a13-815b-8793a1da27a6",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "— J’avoue que cette vérité est terrible pour moi, cruelle pour mon amour et mortifiante pour ma fierté."
                            },
                            {
                                "example_id": "21271150-5afc-478d-bb3a-e47b89ef2579",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "Y a-t-il rien de plus mortifiant ?"
                            },
                            {
                                "example_id": "5cc29209-1c51-43b5-af72-d71a43abe411",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "Des paroles mortifiantes."
                            },
                            {
                                "example_id": "076e19e0-3d9a-497b-a5c9-c43ca3685f64",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "Un refus mortifiant."
                            },
                            {
                                "example_id": "e90fb833-9a26-4355-b11f-8b63f109e68d",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "J'y trouvais assurément quantité de traits cruels et mortifiants pour moi, car le dessin de son infidélité était si clair qu'elle n'avait même pas eu le soin de me le déguiser."
                            },
                            {
                                "example_id": "62a7355f-006a-44ac-9368-34693c54f464",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "Claudine gronda fort du Bruel ; et quand nous roulâmes, car elle me reconduisit chez Florine, elle continua la querelle en lui disant les choses les plus mortifiantes."
                            },
                            {
                                "example_id": "6d1fa463-35aa-47dd-96e0-563962c4695b",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "Chose plus mortifiante peut-être, ils avaient un de leurs fils avocat, un autre médecin, le troisième employé, tandis que son Jean travaillait chez un menuisier, et sa Gervaise, chez une blanchisseuse."
                            },
                            {
                                "example_id": "c0f5a35b-d64c-456b-9637-9140fe8279a9",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "Une mortifiante déconvenue l’attendait chez les fournisseurs du marquis de Gesvres, son dernier oncle, lorsqu’il se présenta pour monter sa garde-robe."
                            },
                            {
                                "example_id": "69b11415-9104-4b5c-957b-dc3c61431c30",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "Il trouvait mortifiant qu’un homme comme lui n’eût pas d’enfant."
                            },
                            {
                                "example_id": "4c59d3d2-1f6a-48e8-bde5-c29576df472c",
                                "sense_id": "0028ff2b-19bb-371c-9409-f47d6f1c19ed",
                                "text": "Busard avait remâché des pensées mortifiantes. Il s’était persuadé que toute la ville se moquait de lui."
                            }
                        ]
                    }
