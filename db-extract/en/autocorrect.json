                        "entry_id": "86c519c9-f6f5-3dfe-aff3-3bc41211a9f5",
                        "glosses": [
                            "A software feature that attempts to correct presumed errors as soon as they are generated."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1dc5be89-00b9-4992-aefb-db54ca89b78a",
                                "sense_id": "9ef120e1-6f47-382e-9f05-3d29b1fcc30b",
                                "text": "Anthony Bourdain would have hated that autocorrect turns his name into Boursin, a bland cheese with zero culinary credibility."
                            }
                        ]
                    }
                ],
