                                    },
                                    {
                                        "sense_id": "168e90d1-ef16-32da-ab29-017d8f10b157",
                                        "entry_id": "262f7a1d-f483-32f8-895a-26bdd6e16172",
                                        "glosses": [
                                            "A filthy place."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f4ea412-9a5d-4b56-bad6-ebf709b69a06",
                                                "sense_id": "168e90d1-ef16-32da-ab29-017d8f10b157",
                                                "text": "Under such circumstances, I naturally gravitated to London, that great cesspool into which all the loungers and idlers of the Empire are irresistibly drained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa4e10df-35af-4ef3-969c-81dfa391a51e",
                        "source_entry_id": "35d4aab6-e633-309d-8b49-8d5b828b2606",
                        "source_sense_id": "0c3dd0bb-b4d4-3cce-9e9e-8f62fc3278e9",
                        "target_lang_word": "žumpa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "žumpa",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f20cbd91-43c1-370c-ab36-61cc168afe78",
                                        "entry_id": "3881fcf7-e8cb-325d-9553-3a02ad42e0c3",
                                        "glosses": [
                                            "jímka na tekutý či polotekutý domácí odpad (zejména fekálie), zapuštěná pod terén u venkovského domu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03ce9c8-1b84-4bbd-b751-2e9ba86facbe",
                                                "sense_id": "f20cbd91-43c1-370c-ab36-61cc168afe78",
                                                "text": "Latriny (lat.), žumpy záchodové sloužící ku shromáždění výkalů a moče i některých jiných odpadkových hmot a tekutin domácnosti."
                                            },
                                            {
                                                "example_id": "c7f6d6f4-0889-4768-a194-2e5aeeb28e19",
                                                "sense_id": "f20cbd91-43c1-370c-ab36-61cc168afe78",
                                                "text": "To byla, jářku, švanda, juchú, mít pumpu z huby, žumpu z břicha a po zločinu ani čuchu — Tak co? že měl jsem zůstat zticha?"
                                            },
                                            {
                                                "example_id": "92900445-46d6-4562-a16f-2cb79f13727a",
                                                "sense_id": "f20cbd91-43c1-370c-ab36-61cc168afe78",
                                                "text": "A ještě něco jsem si dovolil přinést, pane předsedo, hlásí Biegl zvýšeným hlasem a vybaluje cosi z kapesního šátku. Teprve včera to našel, když Manyové vyváželi hnojiště. Bylo to pohozeno v žumpě."
                                            },
                                            {
                                                "example_id": "6c0d4af9-5ca3-4ffb-82c4-d069807bdd9c",
                                                "sense_id": "f20cbd91-43c1-370c-ab36-61cc168afe78",
                                                "text": "A: „Jak bys to napsal ty sám?“ B: „Zde leží zmárněná figura Karla Balejového, ale já péro do ruky neberu, nepotřebuješ pořezat dřevo, odklidit rumovisko, vyvézt žumpu, zabít šandára, to všecko za stovku?“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec6d823-4b83-3ce2-a7b1-ec2c54fd54d2",
                                        "entry_id": "3881fcf7-e8cb-325d-9553-3a02ad42e0c3",
                                        "glosses": [
                                            "skupina lidí považovaná mluvčím za morálně podřadnou"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d5c9ad1-9ccd-43e8-bf50-24972590dc8b",
                                                "sense_id": "cec6d823-4b83-3ce2-a7b1-ec2c54fd54d2",
                                                "text": "Miloš Zeman soustavně hovoří o novinářích jako o novinářské žumpě."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd0bc9d-daf1-3c24-b91a-46c407cfd578",
                                        "entry_id": "3881fcf7-e8cb-325d-9553-3a02ad42e0c3",
                                        "glosses": [
                                            "vesnické vězení"
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6877290f-8265-4a90-9537-b7e5c2eccd79",
                                                "sense_id": "2cd0bc9d-daf1-3c24-b91a-46c407cfd578",
                                                "text": "„Dobře vám tak, kluci! Jen tam s nima, pane hučitel! A hlásné hať hjim dá řeťázke!“ Otevřela se temná díra „kačenca“. „Tam na slámu, marš! Já vám dám ptáčky!“ A v žumpě zmizel napřed Cyril, za ním Vašek. Zarachotila petlice. Rechtor postavil se mezi dveře radnice."
                                            }
                                        ]
                                    }
                                ]
                            }
