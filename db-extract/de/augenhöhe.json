                        "entry_id": "98e82ee8-e431-38e6-8c83-d4e40fad36a7",
                        "glosses": [
                            "Höhe der Augen von jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d8ac4f-4149-4b2e-8124-8c4498efd524",
                                "sense_id": "4af00e8e-e24b-3103-8e04-74d05330ed3e",
                                "text": "„Waiakh machte es ihm nach und legte mit ernster Miene einige Steinchen in eine Öffnung, die sich auf seiner Augenhöhe befand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42e33e9f-ea1c-3ca4-b4e5-19e595a7d17e",
