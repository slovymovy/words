                        "source_sense_id": "8f3aadbb-e1f9-3b90-9408-8745a5e2e938",
                        "source_sense_description": "so, dass es nicht festgestellt werden kann",
                        "target_lang_word": "unascertainable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unascertainable",
