                                        "entry_id": "28a2be46-80c5-3388-8cba-c7a3b2ec4bf5",
                                        "glosses": [
                                            "A Portuguese person."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
