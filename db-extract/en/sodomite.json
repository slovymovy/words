                    {
                        "translation_id": "e9f5e8c7-a59b-465d-b465-f3f4957a7128",
                        "source_entry_id": "9b13e705-3a5a-3056-9ec1-0f50f0e87659",
                        "source_sense_description": "one who practices sodomy",
                        "target_lang_word": "sodomite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
