                ],
                "senses": [
                    {
                        "sense_id": "e7a278d5-622c-36cc-81a7-bd305967ab92",
                        "entry_id": "1a9662e0-1344-3182-af66-1caf97b55b8a",
                        "glosses": [
                            "eine Person, die Jazz liebt und aktiv in der Szene mitspielt"
                        ],
                        "tags": [
                            "Jazzjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "ec46683c-d394-4fbb-8689-65cc70b0d09a",
                                "sense_id": "e7a278d5-622c-36cc-81a7-bd305967ab92",
                                "text": "Monika trifft sich im Jazzclub mit anderen Hipstern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77fa5902-d1a6-3074-9915-e085f07f9171",
                        "entry_id": "1a9662e0-1344-3182-af66-1caf97b55b8a",
                        "glosses": [
                            "jemand, der auf dem Laufenden ist und genau weiß, was gerade in oder eben hip ist"
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "b460c7a9-d161-4c7d-b588-6e0125d0dd86",
                                "sense_id": "77fa5902-d1a6-3074-9915-e085f07f9171",
                                "text": "Was seinen Kleidungsstil angeht, orientiert sich Thilo an den Hipstern in seiner Stadt."
                            },
                            {
                                "example_id": "1b6b2544-01b9-474e-acad-2c0f0f207461",
                                "sense_id": "77fa5902-d1a6-3074-9915-e085f07f9171",
                                "text": "„Weder in Berlin, Wien noch in Prag oder sonstwo sind mir auf den Straßen so viele Hipster aufgefallen.“"
                            },
                            {
                                "example_id": "d0f2ded7-50df-49cb-add7-812ecab3793c",
                                "sense_id": "77fa5902-d1a6-3074-9915-e085f07f9171",
                                "text": "„So merken die Hipster mal, dass in Berlin normale Menschen leben, anstatt sich zum Nabel der Welt zu machen.“"
                            },
                            {
                                "example_id": "e91c00bc-c56e-4ac9-8209-c5f883fc5aa0",
                                "sense_id": "77fa5902-d1a6-3074-9915-e085f07f9171",
                                "text": "„Mit seiner Hornbrille und seinem Bart unter der schwarzen Strickmütze wäre er in Berlin als Hipster durchgegangen.“"
                            },
                            {
                                "example_id": "979a29cd-43e0-4dc2-a502-34d379e176f1",
                                "sense_id": "77fa5902-d1a6-3074-9915-e085f07f9171",
                                "text": "„Er kann den Hipstern die Bärte schneiden, und diese neuartige Dienstleistung kommt in der Hipster-Hauptstadt Berlin gut an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
