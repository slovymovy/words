                "senses": [
                    {
                        "sense_id": "6d13363f-1bb7-3c48-9fde-57b778747bda",
                        "entry_id": "256038c4-0091-3def-9c8f-fa1e075ff7e9",
                        "glosses": [
                            "użytkownik forum (internetowego)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "333624b7-721f-48c1-80e6-7069297d7742",
                                "sense_id": "6d13363f-1bb7-3c48-9fde-57b778747bda",
                                "text": "Forumowicze, wraz z wydłużającym się stażem na forum, zaczynają coraz więcej pisać o swoim prywatnym życiu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d05ea7f-3ac1-47e5-9fc5-d272069cc974",
                        "source_entry_id": "256038c4-0091-3def-9c8f-fa1e075ff7e9",
                        "source_sense_id": "6d13363f-1bb7-3c48-9fde-57b778747bda",
                        "target_lang_word": "forumite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forumite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "181400f5-996d-31f8-91dc-a9fb1f46ec1f",
                                        "entry_id": "b46f50be-f31a-30b5-b9aa-4eec4f2620cf",
                                        "glosses": [
                                            "One who frequents an Internet forum."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d6e3d9-b7e2-4d1b-81cb-ef97f726e2ac",
                                                "sense_id": "181400f5-996d-31f8-91dc-a9fb1f46ec1f",
                                                "text": "In 2002, the 138 registered members were from a variety of geographical locations, age groups, and backgrounds. There were forumites from the USA, Canada, the UK, Italy, Turkey, Austria, Germany, and Australia. The ages ranged from late teens and college students to pensioners in their sixties."
                                            },
                                            {
                                                "example_id": "e11bff96-1a6a-4381-9736-d0a59e696c68",
                                                "sense_id": "181400f5-996d-31f8-91dc-a9fb1f46ec1f",
                                                "text": "In such a competitive environment, attracting forumites (contributors) and maintaining their numbers are essential for the existence and survival of a forum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36a76ce2-e179-4b9b-a859-5179fc8b599b",
                        "source_entry_id": "256038c4-0091-3def-9c8f-fa1e075ff7e9",
                        "source_sense_id": "6d13363f-1bb7-3c48-9fde-57b778747bda",
                        "target_lang_word": "forumer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forumer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57d25b9c-c9f7-30a6-9539-d859ee0592b1",
                                        "entry_id": "85b511c5-e2b5-3d3c-89fd-8cf88a6d8e36",
                                        "glosses": [
                                            "One who frequents an Internet forum."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9f6447b-cda9-4497-904b-4ba8759c76b5",
                                                "sense_id": "57d25b9c-c9f7-30a6-9539-d859ee0592b1",
                                                "text": "The behaviors we have mentioned are generally despised by our informants, not only because they have been personally shocked by these kinds of posts, but also because they feel empathy regarding other younger forumers who may be ..."
                                            },
                                            {
                                                "example_id": "bf6dd460-8e22-4c9d-8712-a0059d756a13",
                                                "sense_id": "57d25b9c-c9f7-30a6-9539-d859ee0592b1",
                                                "text": "Taking great pleasure in the relatively novel series format, forumers compare and contrast different episodes and actresses, displaying close and active knowledge of the show's varied run."
                                            },
                                            {
                                                "example_id": "659f6ec6-47cf-4a92-a275-a607c482bb1f",
                                                "sense_id": "57d25b9c-c9f7-30a6-9539-d859ee0592b1",
                                                "text": "At an offline gathering, one of the more popular 'forumers' (as they are called) nicknamed Orchi, asked John whether he felt that he was talking to himself on that thread. John had to agree with Orchi, as the thread had not attracted much ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
