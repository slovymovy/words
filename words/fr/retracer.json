    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d2104d0c-1f47-3c8e-aeab-3f42a6f83def",
                    "sense_definition": "Raconter ou exposer en détail une suite d'événements passés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a écrit un article complet pour <w>retracer</w> l'histoire de cette célèbre entreprise."
                        },
                        {
                            "text": "Ce nouveau documentaire télévisé s'attache à <w>retracer</w> le parcours difficile des réfugiés."
                        }
                    ],
                    "synonyms": [
                        "raconter"
                    ],
                    "common_phrases": [
                        "retracer l'histoire",
                        "retracer le parcours",
                        "retracer les faits"
                    ]
                },
                {
                    "sense_id": "5a8976cd-2563-3e2e-8b14-f4e234868cae",
                    "sense_definition": "Faire revivre dans son esprit un souvenir ou une image du passé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les années écoulées, il réussit sans peine à se <w>retracer</w> la scène de leur rencontre."
                        },
                        {
                            "text": "Elle ferma doucement les yeux pour se <w>retracer</w> les moindres détails de cette belle journée."
                        }
                    ],
                    "synonyms": [
                        "se rappeler"
                    ],
                    "common_phrases": [
                        "se retracer la scène",
                        "se retracer le passé"
                    ]
                },
                {
                    "sense_id": "a4c49fd0-f2b2-3be6-b369-7814dd4520c8",
                    "sense_definition": "Tracer à nouveau une ligne, un contour ou un dessin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dessin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte a dû <w>retracer</w> les contours du bâtiment pour corriger quelques erreurs de calcul."
                        },
                        {
                            "text": "Ce schéma au crayon est presque effacé, nous devons le <w>retracer</w> avec de l'encre noire."
                        }
                    ],
                    "common_phrases": [
                        "retracer les contours",
                        "retracer une ligne"
                    ]
                }
            ]
        }
    ]
