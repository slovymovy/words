                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer prepared a formal <w>replication</w> to address the claims made by the defense.",
