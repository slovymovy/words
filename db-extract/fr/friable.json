                    {
                        "translation_id": "6871a582-9865-48ce-9bf9-ed24c3ded98b",
                        "source_entry_id": "2c248db8-b146-3cf2-9651-19e65eed7eb1",
                        "source_sense_id": "90721ee4-fc26-3cf7-b026-788b2a9f013c",
                        "source_sense_description": "(Sens figuré) Qui paraît cassant ou fragile.",
                        "target_lang_word": "broos",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broos",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3acff9-a143-3428-a2d7-1802f958e109",
                                        "entry_id": "d1582ab2-4df7-3111-aca8-d99f71e820b7",
                                        "glosses": [
                                            "niet stevig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f87ce49-74ea-4dd7-818f-e33d8873a16f",
                                                "sense_id": "7c3acff9-a143-3428-a2d7-1802f958e109",
                                                "text": "De broze grond was onder haar voeten vandaan geslagen, waarna de onvermijdelijke val volgde."
                                            },
                                            {
                                                "example_id": "dcb76783-58f6-487f-b68a-9e363b402928",
                                                "sense_id": "7c3acff9-a143-3428-a2d7-1802f958e109",
                                                "text": "Omdat het allemaal nog zo broos was, maakte het nauwelijks uit dat sommige momenten wat gekunsteld overkwamen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95d64836-26fb-3f23-b1b8-916d0761b027",
                                        "entry_id": "d1582ab2-4df7-3111-aca8-d99f71e820b7",
                                        "glosses": [
                                            "met een zwakke gezondheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43af013e-04fc-4553-99dd-0de89d0df6e3",
                                                "sense_id": "95d64836-26fb-3f23-b1b8-916d0761b027",
                                                "text": "De hoogbejaarde monarch kampt sinds oktober, toen ze kort in het ziekenhuis werd opgenomen, met een broze gezondheid en mobiliteitsproblemen. Sindsdien heeft ze verschillende afspraken moeten afzeggen of digitaal vanuit huis bijgewoond. Vorige week liet ze nog verstek gaan bij haar troonrede."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
