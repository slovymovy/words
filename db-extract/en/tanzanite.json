                                        "sense_id": "4df4e048-a5e3-3d39-9ed5-7fcebb892f27",
                                        "entry_id": "7e05d1b8-f94d-3936-bb67-5fc269b806fb",
                                        "glosses": [
                                            "Variété bleu à violette de zoïsite. Elle se rencontre souvent sous forme de gemme transparente. Elle a la même formule chimique que la zoïsite Ca2(Al.OH)Al2(SiO4)3 mais avec des traces de vanadium plus franche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6a6956c-05e8-46ed-b00a-f698271c5328",
                                                "sense_id": "4df4e048-a5e3-3d39-9ed5-7fcebb892f27",
                                                "text": "Au pied du Kilimandjaro, se trouvent les principaux gisements de tanzanite, une pierre plus rare que le diamant."
                                            }
                                        ]
                                    }
                                ]
                            }
