                "forms": [],
                "senses": [
                    {
                        "sense_id": "223052d6-d59f-34d9-9036-7bd01043fb01",
                        "entry_id": "3aee72d6-4205-3975-8d0b-b8360015f60e",
                        "glosses": [
                            "A right tributary of the Seine, in eastern France, flowing 319 miles east and southeast of Paris through the departments of Haute-Marne, Marne, Aisne, Seine-et-Marne, Seine-Saint-Denis and Val-de-Marne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c2238a12-c4be-33dc-94c7-6cbd02103466",
                        "entry_id": "3aee72d6-4205-3975-8d0b-b8360015f60e",
                        "glosses": [
                            "A department of Grand Est, France. Capital: Châlons-en-Champagne (INSEE code 51)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1b38082e-add7-3fe7-9269-aab6d9431fcd",
                        "entry_id": "3aee72d6-4205-3975-8d0b-b8360015f60e",
                        "glosses": [
                            "A city in Iowa."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dcc1e7a9-0a65-3739-b74a-9a236b245a40",
                        "entry_id": "3aee72d6-4205-3975-8d0b-b8360015f60e",
