                    {
                        "translation_id": "7d7327fe-714a-45a4-8a93-e2337b486756",
                        "source_entry_id": "b258c715-db6b-3661-a2f6-5c767576cc0d",
                        "source_sense_id": "efd669fa-2c08-32c4-9ba3-d3ce899dee6d",
                        "source_sense_description": "in motion, in progress; being done or carried out",
                        "target_lang_word": "unterwegs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterwegs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                        "entry_id": "0010d0c4-df02-3d72-8c3c-1ffae180289e",
                                        "glosses": [
                                            "auf dem Weg, auf der Strecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26935371-5aba-4a93-baee-b6b218683eca",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "Er ist unterwegs, um die Landschaft zu fotografieren."
                                            },
                                            {
                                                "example_id": "355fece3-94ea-419c-a020-9e5ffd7a73a6",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "Sie bereitet ihm Proviant für unterwegs zu."
                                            },
                                            {
                                                "example_id": "4e090bd2-ab1f-4b04-b4c4-a68a9e808b90",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„Unterwegs durch die Gassen Krakaus fiel mir auf, was ich noch alles hätte erwähnen können.“"
                                            },
                                            {
                                                "example_id": "aa581593-201d-42c8-b02a-c30268402a90",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„Als Cäsar zugetragen wurde, dass Nachschub für die Germanen unterwegs sein sollte, ergriff er die Initiative und brach mit seinen Legionen auf.“"
                                            },
                                            {
                                                "example_id": "a6eba357-7a20-42e5-b1db-bd2a4ce75316",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„1000 Jahre lang wird es keiner anderen europäischen Kultur gelingen, Segler zu konstruieren, die schneller unterwegs sind als die Kriegsschiffe der Wikinger, die Drachenboote.“"
                                            },
                                            {
                                                "example_id": "855d6e65-9376-4445-bcf5-87b7df5c672b",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„Etwa 23 Millionen Menschen sind täglich in indischen Zügen unterwegs.“"
                                            },
                                            {
                                                "example_id": "6d0beac0-1217-4d8b-aa69-685b1dc116bb",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„Rund eine halbe“ [Million] „Fans sind jedes Bundesliga-Wochenende unterwegs, um Fußball im Stadion zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
