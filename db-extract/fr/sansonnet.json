        "fr-extract.jsonl": [
            {
                "entry_id": "f2f2f041-8279-3e18-8deb-5e621018b222",
                "word": "sansonnet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e0211ca1-4e13-4a93-890f-c33a6edff039",
                        "entry_id": "f2f2f041-8279-3e18-8deb-5e621018b222",
                        "tags": [
                            "plural"
                        ],
                        "form": "sansonnets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4c1e633-05e9-30c8-904f-219c8b6ddda1",
                        "entry_id": "f2f2f041-8279-3e18-8deb-5e621018b222",
                        "glosses": [
                            "Synonyme de étourneau sansonnet (oiseau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bce5e52b-15b1-4c6d-916a-0ada66d37d82",
                                "sense_id": "f4c1e633-05e9-30c8-904f-219c8b6ddda1",
                                "text": "Des millions de sansonnets, réunis en bataillons et ressemblant à des nuages, volaient au-dessus de ma tête."
                            },
                            {
                                "example_id": "3bc8be5d-bb08-4832-a545-73a07ad74e01",
                                "sense_id": "f4c1e633-05e9-30c8-904f-219c8b6ddda1",
                                "text": "Le coq pattu dont elle connaissait si bien le chant faisait cocorico à quelques pas d’elle et son propre sansonnet sifflait dans son oreille."
                            },
                            {
                                "example_id": "6cc684d1-cfa8-48f0-a101-0a65ceb07bec",
                                "sense_id": "f4c1e633-05e9-30c8-904f-219c8b6ddda1",
                                "text": "Il avait des gluaux perfectionnés pour les alouettes et les cailles, il tapait à coup de pierres dans les épaisses nuées de sansonnets, que semblent apporter les grands vents d’automne."
                            },
                            {
                                "example_id": "0a0f53e5-8d6a-43a9-82f6-d9a056f16471",
                                "sense_id": "f4c1e633-05e9-30c8-904f-219c8b6ddda1",
                                "text": "Un assez louche individu, un Français qui a écrit des poèmes condamnés pour outrage aux bonnes mœurs, a décrit avec horreur les sansonnets aux yeux crevés qui lancent un peu partout dans les cages des boutiques et des arrière-cours belges leurs trilles d’aveugles."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b5390ad-3cbf-33f8-95cc-d027d6f31531",
                        "entry_id": "f2f2f041-8279-3e18-8deb-5e621018b222",
                        "glosses": [
                            "Espèce de maquereau de petite taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45fb356c-6a5f-47a4-b9bd-1b7ad8920a25",
                                "sense_id": "8b5390ad-3cbf-33f8-95cc-d027d6f31531",
                                "text": "On trouve sur les marchés plusieurs variétés de maquereau peu différentes du maquereau commun, telles que le Sansonnet ou Roblot, qui n’est pas plus gros qu’un hareng."
                            }
                        ]
                    }
                ],
