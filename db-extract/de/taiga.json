                "senses": [
                    {
                        "sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                        "entry_id": "c32d2dc3-0359-3e3d-b69d-a9932772f826",
                        "glosses": [
                            "Bezeichnung für den Nadelwald in Nordamerika, Nordeuropa und Sibirien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a47c7cf3-c868-4699-850a-823c8347d9be",
                                "sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                                "text": "Die Taiga erstreckt sich im Norden Asiens bis zur Tundra und im Osten bis zum Pazifik."
                            },
                            {
                                "example_id": "96b00f75-5cc3-445c-a794-95953b63c776",
                                "sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                                "text": "„Weit erstreckt sich die Taiga unter dem Wolkenverhangenen Himmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75d56a5a-a61a-4e5b-8ce9-3470fc183965",
                        "source_entry_id": "c32d2dc3-0359-3e3d-b69d-a9932772f826",
                        "source_sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                        "source_sense_description": "Bezeichnung für den Nadelwald in Nordamerika, Nordeuropa und Sibirien",
                        "target_lang_word": "taiga",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taiga",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46d3c489-89f7-30c4-8c48-6747d74a0e00",
                                        "entry_id": "0ca4b1fc-7f78-3037-8ae3-7981507d040d",
                                        "glosses": [
                                            "A subarctic zone of evergreen coniferous forests situated south of the tundras and north of the steppes in the Northern Hemisphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2cf569-b5db-41b0-b1f6-cdf6e96d6a31",
                                                "sense_id": "46d3c489-89f7-30c4-8c48-6747d74a0e00",
                                                "text": "Like the taiga, he was everywhere, and mysterious—a heroic being with unearthly gifts."
                                            },
                                            {
                                                "example_id": "76e4c683-9e0e-4ed8-be67-d2e0916241ca",
                                                "sense_id": "46d3c489-89f7-30c4-8c48-6747d74a0e00",
                                                "text": "The mountains run from the Arctic Island of Novaya Zemlya southwards, dividing the endless wastes of the Siberian taiga and the steppes from the Russian platform in the west."
                                            },
                                            {
                                                "example_id": "35b849c9-50a8-4365-8f5c-78e5df195440",
                                                "sense_id": "46d3c489-89f7-30c4-8c48-6747d74a0e00",
                                                "text": "Reindeer are well suited to the taiga’s frigid winters. They can maintain a thermogradient between body core and the environment of up to 100 degrees, in part because of insulation provided by their fur, and in part because of counter-current vascular heat exchange systems in their legs and nasal passages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ebd45c9-29e4-4c53-bb20-693ae0e4b1a0",
                        "source_entry_id": "c32d2dc3-0359-3e3d-b69d-a9932772f826",
                        "source_sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                        "source_sense_description": "Bezeichnung für den Nadelwald in Nordamerika, Nordeuropa und Sibirien",
                        "target_lang_word": "taïga",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taïga",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                                        "entry_id": "f89deb6c-c13d-3223-b44e-714b1777b6f4",
                                        "glosses": [
                                            "Forêt de conifères de climat boréal, dans le nord de l’Europe, de l’Asie et de l’Amérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e100bfed-5fdb-4595-9e05-1b5ce5e06a5d",
                                                "sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                                                "text": "Mais il ne s’agit jamais de pergélisol continu. De fait, seule la taïga russe est affectée par ce phénomène."
                                            },
                                            {
                                                "example_id": "84fa781b-5ef8-4877-bef4-d854e644a32d",
                                                "sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                                                "text": "Regarder vers l’est était le pire. La Sibérie orientale et la taïga."
                                            },
                                            {
                                                "example_id": "b6b25d74-0ba3-4161-9eb6-688f32f59ed4",
                                                "sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                                                "text": "Bien caché sous mon affût, je contemple le paysage de taïga saupoudré de neige, qui se ternit sous l’étreinte de la nuit et se momifie progressivement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adc94fed-0726-4225-8f00-fff9748c71b3",
                        "source_entry_id": "c32d2dc3-0359-3e3d-b69d-a9932772f826",
                        "source_sense_id": "cba4b574-b5ba-3514-81de-651e32df3449",
                        "source_sense_description": "Bezeichnung für den Nadelwald in Nordamerika, Nordeuropa und Sibirien",
                        "target_lang_word": "тайга",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тайга",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "071762cf-13b9-393a-824e-9c0024b62c5d",
                                        "entry_id": "9235ec97-f089-316a-8a12-0c01dd9c136d",
                                        "glosses": [
                                            "геогр. дикие, труднопроходимые хвойные леса умеренного пояса, преимущественно состоящие из ели, пихты, лиственницы (иногда с примесью немногочисленных лиственных пород), занимающие большое пространство на севере Европы, Азии и Северной Америки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d99557a0-c630-43fb-94a3-cd3e64f19a3e",
                                                "sense_id": "071762cf-13b9-393a-824e-9c0024b62c5d",
                                                "text": "Тайги остаются вниз по Чулыму, сперва не широки, потом, около Сусловой, во 100 вёрст ширины, но выломаны погодой и выгорели, а ныне зверя совсем нет, а прежде были хорошие промыслы."
                                            },
                                            {
                                                "example_id": "5b27b04d-98b7-4c97-b443-d2c69250898f",
                                                "sense_id": "071762cf-13b9-393a-824e-9c0024b62c5d",
                                                "text": "Кругом стоят исполинские ильмы, лиственница, маньчжурский орех и, наконец, золото нашей тайги — ценнейшее дерево — ясень!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2057cd51-e2af-35d1-9fb8-a1a47f0c05d2",
                                        "entry_id": "9235ec97-f089-316a-8a12-0c01dd9c136d",
                                        "glosses": [
                                            "перен., разг. любой непроходимый лес"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cd91074-6be7-4abb-9c80-e8e9be26bebf",
                        "source_entry_id": "c32d2dc3-0359-3e3d-b69d-a9932772f826",
