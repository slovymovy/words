                "translations": [
                    {
                        "translation_id": "c01ce640-8b1e-4bc2-a015-a886797db7d3",
                        "source_entry_id": "a82bc908-f5fc-37e4-b0e3-0b2ec5703c1d",
                        "source_sense_id": "2703dfcb-e943-3877-9d9b-f4f8511ffc77",
                        "target_lang_word": "staysail",
