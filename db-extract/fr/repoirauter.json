                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91081a02-2680-4fc5-8787-0af61741c52d",
                                "sense_id": "516a9e11-9353-3135-b9e3-adbee285d53c",
                                "text": "Là, mon sang ne fait qu'un tour (enfin, c'est surtout que je n'ai pas envie de repoirauter 40 minutes), je prends mon plus bel accent chinois (très très difficile) pour demander à la fille à côté de moi : (...)"
                            },
                            {
                                "example_id": "d51108f7-c3d8-4cca-8631-3bd949806a74",
                                "sense_id": "516a9e11-9353-3135-b9e3-adbee285d53c",
                                "text": "Malheureusement il va partir soudainement le lendemain, nous faire repoirauter pendant deux semaines et ensuite revenir etc. etc."
                            },
                            {
                                "example_id": "c91102c8-c02c-46a4-9d61-0caa471359a3",
                                "sense_id": "516a9e11-9353-3135-b9e3-adbee285d53c",
                                "text": "Le gars la ramènera le lendemain et me fera repoirauter le soir pour l’avoir!"
                            }
                        ]
                    }
