                "senses": [
                    {
                        "sense_id": "b7b093cd-ca33-32d8-9459-38e2b45023c1",
                        "entry_id": "9d612a2f-1623-3c6b-9433-ba24935fe33e",
                        "glosses": [
                            "Non usuel de Lophophora williamsii petit cactus des déserts d’Amérique du Nord, contenant de la mescaline, utilisé rituellement par certaines tribus d’Indiens du Mexique et des États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ba62589-ed6e-4a82-a948-3b4e42962a91",
                                "sense_id": "b7b093cd-ca33-32d8-9459-38e2b45023c1",
                                "text": "L’activité de l’esprit/cerveau chamanique est stimulée par un breuvage comme l’ayahuasca en Amazonie ou le peyotl, champignon hallucinogène au Mexique, par le tambour monotone, le chant réitératif, et elle se manifeste dans et par l’état de transe."
                            },
                            {
                                "example_id": "9f817849-09c6-450b-8164-2d1c1ba883ac",
                                "sense_id": "b7b093cd-ca33-32d8-9459-38e2b45023c1",
                                "text": "Une drogue mexicaine que seuls les savants connaissaient il y a quelques années encore mais qui semble vouloir se populariser : le peyotl."
                            },
                            {
                                "example_id": "f25f4a52-d50b-4c59-9608-eb27b8305923",
                                "sense_id": "b7b093cd-ca33-32d8-9459-38e2b45023c1",
                                "text": "Je n’ai aucun souvenir de la descente et, pour ma part, la nuit suivante, des rêves prestigieux me visitèrent, tout à fait analogues, m’a-t-on dit, à ceux que procure le peyotl."
                            }
                        ]
                    }
                ],
