                "senses": [
                    {
                        "sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
                        "entry_id": "22d21f57-ba38-3dd7-9bd1-e21dfafa1f90",
                        "glosses": [
                            "im Freien auf einem Pfeiler oder Sockel angebrachtes Heiligenbild oder Heiligenfigur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee3e837-64e3-41a5-844d-62e95620f89c",
                                "sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
                                "text": "Religiöse Kleindenkmäler mit Devotionalien wie Bilder, Figuren und so weiter sind Bildstöcke, die im Freien aufgestellt werden und den Volksgeist symbolisieren."
                            },
                            {
                                "example_id": "cdb802f4-1e4e-49f5-846d-de59222960f9",
                                "sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
                                "text": "„Die Bildstöcke mit den Leidensstationen Jesu waren nach Kriegsende dem Vandalismus zum Opfer gefallen, aber in Hermine Tippelts Erzählungen lebten sie weiter.“"
                            },
                            {
                                "example_id": "cb2e680e-6249-44bb-9652-f09ad0176e6d",
                                "sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
                                "text": "„Ein großer Bildstock steht auf dem Platz nahe der Hauptstraße, seine Fresken stammen vom großen Michael Pacher, sie wurden leider bei einem Hochwasser 1882 fast völlig zerstört.“"
                            },
                            {
                                "example_id": "25f13958-591a-478a-a34d-4ae80f7c3ede",
                                "sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
                                "text": "„Der Bildstock, den man hier erblickt, liegt bereits knapp 100 Meter hinter der Gemeinde- und Landkreisgrenze.“"
                            },
                            {
                                "example_id": "b4883d2c-8cd0-4d66-a44d-f49515684d29",
                                "sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
                                "text": "„Unter der Feste Cyriaksburg nahe bei Erfurt, links an der alten Fahrstraße nach Gotha, steht ein großer steinerner Bildstock mit altgotischer Zier und erhabener Steinhauerarbeit, der wird das Sibyllentürmchen genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acfc8dcf-1474-47fb-9bb1-754d03400642",
                        "source_entry_id": "22d21f57-ba38-3dd7-9bd1-e21dfafa1f90",
                        "source_sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
