                                "example_id": "78d5a142-fc3c-49cf-8260-b6673379a375",
                                "sense_id": "a4a4a362-e6f5-3b16-b4c7-5dbcb2e21ba5",
                                "text": "„Irgendwo läuft mitten in der Nacht eine Reportage über den Internetriesen.“"
                            },
                            {
                                "example_id": "7d503d58-70ee-47b9-9887-a0be4765349c",
                                "sense_id": "a4a4a362-e6f5-3b16-b4c7-5dbcb2e21ba5",
                                "text": "„Als die Internetriesen Facebook, Google & Co begannen, zu Werbezwecken Kundendaten zu sammeln, liefen die Deutschen Sturm.“"
                            }
                        ],
