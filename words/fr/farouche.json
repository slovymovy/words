                },
                {
                    "sense_id": "a5e3d198-0a12-3933-8614-fcf8151d2d1a",
                    "sense_definition": "Qui manifeste une détermination ardente, intransigeante ou sans concession.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet de loi a rencontré une opposition <w>farouche</w> de la part des députés.",
                            "target_lang_translations": {
                                "en": "The bill met with <w>fierce</w> opposition from MPs.",
                                "ru": "Законопроект встретил <w>непримиримую</w> оппозицию со стороны депутатов.",
                                "de": "Der Gesetzentwurf stieß bei den Abgeordneten auf <w>erbitterte</w> Opposition.",
                                "es": "El proyecto de ley encontró una <w>feroz</w> oposición por parte de los diputados.",
                                "zh": "这项法案遭到了议员们的<w>激烈</w>反对。"
                            }
                        },
                        {
                            "text": "C'est un défenseur <w>farouche</w> de la liberté d'expression dans son pays.",
                            "target_lang_translations": {
                                "en": "He is a <w>staunch</w> defender of freedom of expression in his country.",
                                "ru": "Он <w>ярый</w> защитник свободы слова в своей стране.",
                                "de": "Er ist ein <w>glühender</w> Verfechter der Meinungsfreiheit in seinem Land.",
                                "es": "Es un <w>acérrimo</w> defensor de la libertad de expresión en su país.",
                                "zh": "他是自己国家言论自由的<w>坚定</w>捍卫者。"
                            }
                        }
