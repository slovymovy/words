                    "sense_definition": "roztropne przewidywanie przyszłych potrzeb i zapobieganie trudnościom",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "troska",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzięki życiowej <w>opatrzności</w> gospodarz zabezpieczył zapasy drewna na całą zimę.",
