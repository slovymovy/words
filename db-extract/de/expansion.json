                    {
                        "sense_id": "2ab8e9cc-c525-3ca3-ae8c-da2568d9f1f1",
                        "entry_id": "209c7866-486f-3360-af6a-f38075574821",
                        "glosses": [
                            "die Zunahme der räumlichen Ausdehnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05c59d72-5af4-47cc-a969-4bca7716fc5f",
                                "sense_id": "2ab8e9cc-c525-3ca3-ae8c-da2568d9f1f1",
                                "text": "Die Islamische Expansion begann Mitte der 20er Jahre."
                            },
                            {
                                "example_id": "41b8b3c6-b984-43f2-ad8a-dd00a59995b6",
                                "sense_id": "2ab8e9cc-c525-3ca3-ae8c-da2568d9f1f1",
                                "text": "„Die Expansion war kontinental, und die neuen Besitzungen wurden anfangs wie Kolonien behandelt.“"
                            },
                            {
                                "example_id": "35b7dadc-f8d2-4a7e-8db7-cbd6914dbda7",
                                "sense_id": "2ab8e9cc-c525-3ca3-ae8c-da2568d9f1f1",
                                "text": "„Damit beginnt das Zeitalter der europäischen Expansion in Afrika.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f75c211-d8f4-3511-98ec-b58555a1d949",
                        "entry_id": "209c7866-486f-3360-af6a-f38075574821",
                        "glosses": [
                            "Erweiterung eines Computerspiels oder einer Spielwelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef4481fd-1e98-4ae8-8328-98f340133291",
                                "sense_id": "3f75c211-d8f4-3511-98ec-b58555a1d949",
                                "text": "Die Expansion zu Worldwars kann man kostenlos auf games.de spielen."
                            },
                            {
                                "example_id": "fbc42cfa-de29-42d4-a21d-a70c6062a82a",
                                "sense_id": "3f75c211-d8f4-3511-98ec-b58555a1d949",
                                "text": "Auch beim Expansion- Pack muss man aufpassen und enorm schnell sein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3f3c3024-8289-3555-b005-f72e76ac25b3",
                        "entry_id": "209c7866-486f-3360-af6a-f38075574821",
                        "glosses": [
                            "operationales Verfahren in der Syntax: Ersetzung einer Wortgruppe durch eine größere Wortgruppe"
                        ],
                        "tags": [],
                        "examples": [
