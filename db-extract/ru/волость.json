                        "examples": [
                            {
                                "example_id": "55510216-dd50-4564-9403-40906c1494a1",
                                "sense_id": "3fb21ba8-cfdb-3ec0-94ee-1ec22b40081b",
                                "text": "Затре́буйте продово́льственный и́ли убо́рочный отря́д на ка́ждую во́лость. Не забыва́йте, что необходи́м ско́ро хлеб и необходи́мо очи́стить от всех изли́шков хле́ба хоть одну́ образцо́вую во́лость.",
                                "translation": "Demand a food or harvesting detachment for each volost. Do not forget we need grain quickly and all grain surpluses should be swept up from at least one exemplary volost.",
                                "english": "Demand a food or harvesting detachment for each volost. Do not forget we need grain quickly and all grain surpluses should be swept up from at least one exemplary volost."
                            }
                        ]
                    }
