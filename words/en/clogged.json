{
    "word_family": [
        "clog",
        "unclog"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "04817b96-29c1-3875-989b-2d0a6b7172a5",
                    "sense_definition": "Blocked or obstructed so that movement or flow is prevented or difficult.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber came to fix the <w>clogged</w> drain in the kitchen sink.",
                            "target_lang_translations": {
                                "de": "Der Klempner kam, um den <w>verstopften</w> Abfluss in der Küchenspüle zu reparieren."
                            }
                        },
                        {
                            "text": "Traffic was completely stuck because of the <w>clogged</w> highway.",
                            "target_lang_translations": {
                                "de": "Der Verkehr stand wegen der <w>verstopften</w> Autobahn völlig still."
                            }
                        }
                    ],
                    "synonyms": [
                        "blocked",
                        "congested",
                        "obstructed"
                    ],
                    "antonyms": [
                        "clear",
                        "unblocked",
                        "unclogged"
                    ],
                    "common_phrases": [
                        "clogged drain",
                        "clogged pores",
                        "clogged pipes"
                    ],
                    "target_lang_definitions": {
                        "de": "So blockiert oder verstopft, dass Bewegung oder Durchfluss verhindert oder erschwert wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verstopft",
                                "target_lang_sense_clarification": "für Rohre, Abflüsse, Poren oder Verkehr"
                            },
                            {
                                "target_lang_word": "blockiert",
                                "target_lang_sense_clarification": "durch Hindernisse versperrt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1c6de9a-aef6-3c57-a9cd-ea89f4ec208b",
                    "sense_definition": "Simple past tense and past participle of <w>clog</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fallen leaves <w>clogged</w> the gutters during the autumn storm.",
                            "target_lang_translations": {
                                "de": "Herabgefallenes Laub <w>verstopfte</w> während des Herbststurms die Dachrinnen."
                            }
                        },
                        {
                            "text": "Dirt and grease quickly <w>clogged</w> the engine filter.",
                            "target_lang_translations": {
                                "de": "Schmutz und Fett <w>verstopften</w> schnell den Motorfilter."
                            }
                        }
                    ],
                    "synonyms": [
                        "blocked",
                        "obstructed"
                    ],
                    "antonyms": [
                        "cleared",
                        "unclogged"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vergangenheitsform (Präteritum und Partizip Perfekt) von »to clog«; verstopfte, hat verstopft."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verstopfte",
                                "target_lang_sense_clarification": "Präteritum von verstopfen"
                            },
                            {
                                "target_lang_word": "verstopft",
                                "target_lang_sense_clarification": "Partizip Perfekt von verstopfen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}