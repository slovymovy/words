            {
                "entry_id": "62189943-4320-3fa3-9865-2c45f4daa78d",
                "word": "quadrat",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "42dcc3cd-7926-4aa2-9a61-9efac4a348ab",
                        "entry_id": "62189943-4320-3fa3-9865-2c45f4daa78d",
                        "tags": [
                            "plural"
                        ],
                        "form": "quadrats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c78c1d6f-2e77-39ce-ab56-89eb9254dc0f",
                        "entry_id": "62189943-4320-3fa3-9865-2c45f4daa78d",
                        "glosses": [
                            "A quad; a blank metal block used to fill space in lines of type."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4a5f03f5-26e7-4426-ac0d-fee2ebae600d",
                                "sense_id": "c78c1d6f-2e77-39ce-ab56-89eb9254dc0f",
                                "text": "If his Title be ſhort, he Sets it in the middle of the Line, by Setting Quadrats on both ſides: If his Title be long, he Sets the middle Line in the middle: If it make three or more Lines, he Indents the firſt with an m Quadrat, and the other with two m Quadrats."
                            },
                            {
                                "example_id": "eb01e77b-d853-48fa-a3ce-08b7e899b990",
                                "sense_id": "c78c1d6f-2e77-39ce-ab56-89eb9254dc0f",
                                "text": "The footsticks may be a trifle shorter than the width of two pages and the gutter; for as there should always be a line of quadrats, or a reglet cut to measure, at the foot of each page, the footstick may be a pica shorter without danger, on this account, of any thing falling out, when the form is lifted and it thus prevents the side and foot sticks from binding when locked up."
                            }
                        ]
                    },
                    {
                        "sense_id": "1663a4f9-fef2-3fa3-bbb0-3fc910f88aaa",
                        "entry_id": "62189943-4320-3fa3-9865-2c45f4daa78d",
                        "glosses": [
                            "A virtual rectangular subdivision of a line or column of hieroglyphs within which a group of hieroglyphs is arranged."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84f1903e-b53e-41b7-94f1-d448abbb8eeb",
                        "source_entry_id": "62189943-4320-3fa3-9865-2c45f4daa78d",
                        "source_sense_description": "blank metal block, quad",
                        "target_lang_word": "Geviert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geviert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9be7e21b-3b5c-399e-991b-d3a1d8f1680a",
                                        "entry_id": "0b549abd-31ea-3f05-87c4-701c34a8129c",
                                        "glosses": [
                                            "Quadrat, Viereck"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22221b89-c33c-4f19-9f33-8c1b6eaa3306",
                                                "sense_id": "9be7e21b-3b5c-399e-991b-d3a1d8f1680a",
                                                "text": "Das Anwesen maß eine halbe Meile im Geviert."
                                            },
                                            {
                                                "example_id": "edfab3e2-e670-4465-b0ed-e355b625ea47",
                                                "sense_id": "9be7e21b-3b5c-399e-991b-d3a1d8f1680a",
                                                "text": "Die Studenten saßen im Geviert des Hörsaales."
                                            },
                                            {
                                                "example_id": "131dd9f2-bbea-44f3-b968-2d68383be24b",
                                                "sense_id": "9be7e21b-3b5c-399e-991b-d3a1d8f1680a",
                                                "text": "„Auch wenn ich versuche, das Geviert mit den verstorbenen Kindern zu umgehen, stehe ich doch immer wieder mittendrin.“"
                                            },
                                            {
                                                "example_id": "7d8010f7-f13c-4d0b-b84a-08da39639ea2",
                                                "sense_id": "9be7e21b-3b5c-399e-991b-d3a1d8f1680a",
                                                "text": "„In dem kleinen Garten von sechs Klafter im Geviert gab es nur Salat und einen Feigenbaum.“"
                                            },
                                            {
                                                "example_id": "b356c371-6352-4073-8fd9-8cccbe9c0f2f",
                                                "sense_id": "9be7e21b-3b5c-399e-991b-d3a1d8f1680a",
                                                "text": "„Dieses Geviert von Unwörtern, das auf ihn zutraf, belastete ihn bleischwer und hatte ihn schrumpfen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7770e2e-5d40-3810-aa83-278664e3d360",
                                        "entry_id": "0b549abd-31ea-3f05-87c4-701c34a8129c",
                                        "glosses": [
                                            "typographische Maßeinheit, ein Einzug von der Breite, die der Schrifthöhe entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e40f90-bfc3-403d-8e74-fcc45732574b",
                                                "sense_id": "c7770e2e-5d40-3810-aa83-278664e3d360",
                                                "text": "Das Geviert ist eine auf die Schriftkegelgröße bezogene quadratische Fläche im traditionellen Schriftsatz."
                                            },
                                            {
                                                "example_id": "25d2f7ea-ccc6-4d1f-ad63-465a7841e753",
                                                "sense_id": "c7770e2e-5d40-3810-aa83-278664e3d360",
                                                "text": "Das Geviert ist das Quadrat mit der Seitenlänge der Schrifthöhe."
                                            },
                                            {
                                                "example_id": "ceb843f1-8d5c-4724-b23d-6b0f6a22a213",
                                                "sense_id": "c7770e2e-5d40-3810-aa83-278664e3d360",
                                                "text": "Man kann das Geviert benutzen, um einen bestimmten Abstand zwischen zwei Wörtern zu schaffen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "355be818-1fe2-34f6-976a-00cbc76bc47d",
                                        "entry_id": "0b549abd-31ea-3f05-87c4-701c34a8129c",
                                        "glosses": [
                                            "umbauter viereckiger, quadratischer Innenhof"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac2c28d-47bf-47df-ab3f-cafaca5417e7",
                                                "sense_id": "355be818-1fe2-34f6-976a-00cbc76bc47d",
                                                "text": "Das Geviert bedeckte eine Fläche von etwa dreißig mal dreißig Schritten und war hübsch gepflastert."
                                            },
                                            {
                                                "example_id": "ab177b97-5ec5-4770-8ff6-06fdf7ed4552",
                                                "sense_id": "355be818-1fe2-34f6-976a-00cbc76bc47d",
                                                "text": "„Mitten in einem Geviert, das die kahlen, nur von breiten Türöffnungen unterbrochenen Mauern bildeten, wogte ein scheues Kommen und Gehen, ein huschendes Verweilen von vielen Frauen, die in einer stummen, eindringlichen Haltung versunken waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a74e7e32-38ba-4099-9fd3-31ef4ad7605b",
                        "source_entry_id": "62189943-4320-3fa3-9865-2c45f4daa78d",
                        "source_sense_description": "blank metal block, quad",
                        "target_lang_word": "Quadrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quadrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "781fd3ca-289b-37eb-a148-484e318d6b99",
                                        "entry_id": "10f02fdf-8cc7-3f50-8045-cd6090f9a1a0",
                                        "glosses": [
                                            "Viereck mit einheitlicher Kantenlänge und rechten Winkeln; ein Parallelogramm mit vier rechten Winkeln und vier gleichlangen Seiten"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e146d49-b714-4dcd-a356-47509cf37bfe",
                                                "sense_id": "781fd3ca-289b-37eb-a148-484e318d6b99",
                                                "text": "Ein Quadrat hat vier rechte Winkel, ist achsen- und punktsymmetrisch."
                                            },
                                            {
                                                "example_id": "0e4cdecf-0a9b-48d3-8cfb-ce39c478a2d2",
                                                "sense_id": "781fd3ca-289b-37eb-a148-484e318d6b99",
                                                "text": "„Sie waren sternförmig in regelmäßigen Quadraten aufgeteilt, die verschiedene Muster zeigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a6499b5-bdcf-313e-86a9-e48724328dbc",
                                        "entry_id": "10f02fdf-8cc7-3f50-8045-cd6090f9a1a0",
                                        "glosses": [
                                            "die zweite Potenz (·²)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a83d09f2-37f5-470c-9d45-b65617ab11f0",
                                                "sense_id": "3a6499b5-bdcf-313e-86a9-e48724328dbc",
                                                "text": "Das Quadrat von drei ist neun."
                                            },
                                            {
                                                "example_id": "805cce6a-f7dd-4825-b337-bea168d83bfb",
                                                "sense_id": "3a6499b5-bdcf-313e-86a9-e48724328dbc",
                                                "text": "Drei zum Quadrat gleich neun."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Quadrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d2d3b48-494e-3c38-b6f9-4690817253b4",
                                        "entry_id": "9846c4b7-e961-3f8c-a618-22c33066e7eb",
