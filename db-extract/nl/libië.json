                    {
                        "translation_id": "cde30001-fac6-487b-b232-64c8b9bf5890",
                        "source_entry_id": "09b408c1-f020-3614-a837-f5079e672cfd",
                        "source_sense_id": "576930ec-6e85-37fc-969f-f7ce436907f8",
                        "source_sense_description": "een land in Noord-Afrika, officieel de Staat Libië",
                        "target_lang_word": "Libyen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
