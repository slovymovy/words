                                    {
                                        "sense_id": "01dfa975-69dd-33e7-9f94-40b9dc1fbbeb",
                                        "entry_id": "885d9dfd-a0a8-3d5e-a329-88f25a3b8eb4",
                                        "glosses": [
                                            "Having the power to allure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c053c7-0e8d-4bbc-b69d-fb52b31121cd",
                                                "sense_id": "01dfa975-69dd-33e7-9f94-40b9dc1fbbeb",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alluring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5127cb7a-acf0-30e9-863d-abff05c5bef7",
                                        "entry_id": "dfd8a92d-8071-344f-8875-2b3448653762",
                                        "glosses": [
                                            "The act or habit of enticing or attracting in order to seek a benefit or advantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6c67674-3cdd-4d6c-85be-26359041d8e5",
                                                "sense_id": "5127cb7a-acf0-30e9-863d-abff05c5bef7",
                                                "text": "Was this poor breast, from Love's allurings free, / Cruel to all, and gentle unto thee ?"
                                            },
                                            {
                                                "example_id": "e5862f8d-8daa-498a-ab1d-4291cfe80728",
                                                "sense_id": "5127cb7a-acf0-30e9-863d-abff05c5bef7",
                                                "text": "For, as when the red-cheeked, dancing girls, April and May, trip home to the wintry, misanthropic woods; even the barest, ruggedest, most thunder-cloven old oak will at least send forth some few green sprouts, to welcome such glad-hearted visitants; so Ahab did, in the end, a little respond to the playful allurings of that girlish air."
                                            },
                                            {
                                                "example_id": "9545c717-a6c3-40e9-9f5d-4c4d7d1c9a93",
                                                "sense_id": "5127cb7a-acf0-30e9-863d-abff05c5bef7",
                                                "text": "Lookout heights and Smoky Mountains have allurings all their own."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alluring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f97b27f5-e26f-3395-a053-476eacf69b45",
