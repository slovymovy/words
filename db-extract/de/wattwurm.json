                "senses": [
                    {
                        "sense_id": "ad2487cd-ac84-333b-a645-3ef53cb4123b",
                        "entry_id": "0d298c62-96aa-372c-bf20-533c3a50dd16",
                        "glosses": [
                            "Arenicola marina, eine Art der Ringelwürmer, die im Watt lebt"
