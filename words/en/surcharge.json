{
    "word_family": [
        "charge"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57565c57-2b14-30f8-9558-7373fcbdf03b",
                    "sense_definition": "An additional fee or cost added to the standard or basic price of a good or service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airline added a fuel <w>surcharge</w> to all international ticket bookings.",
                            "target_lang_translations": {
                                "zh": "航空公司对所有国际机票预订加收了燃油<w>附加费</w>。"
                            }
                        },
                        {
                            "text": "You will have to pay an extra <w>surcharge</w> if you use a credit card.",
                            "target_lang_translations": {
                                "zh": "如果使用信用卡，你必须支付一笔<w>额外费用</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extra fee",
                        "supplement"
                    ],
                    "antonyms": [
                        "discount"
                    ],
                    "common_phrases": [
                        "fuel surcharge",
                        "service surcharge"
                    ],
                    "target_lang_definitions": {
                        "zh": "在商品或服务的基本价格之上额外收取的费用或成本。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "附加费",
                                "target_lang_sense_clarification": "额外加收的费用"
                            },
                            {
                                "target_lang_word": "额外费用",
                                "target_lang_sense_clarification": "超出基本价格的费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95653fec-a252-3097-b88e-81c2e2e1c936",
                    "sense_definition": "The portion of a subsidized product's or service's cost that is not covered by the subsidy and must be paid by the consumer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Patients are required to pay a small <w>surcharge</w> for prescription medicines not fully covered by the government.",
                            "target_lang_translations": {
                                "zh": "对于未完全纳入政府补贴的处方药，患者须支付少额<w>自付差额</w>。"
                            }
                        },
                        {
                            "text": "Although the housing program is subsidized, residents must cover a maintenance <w>surcharge</w> each month.",
                            "target_lang_translations": {
                                "zh": "虽然该住房项目有补贴，但居民每月仍须承担一笔维修<w>自付差额</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "copayment"
                    ],
                    "target_lang_definitions": {
                        "zh": "享受补贴的产品或服务中未被补贴覆盖、须由消费者自行承担的部分费用。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自付差额",
                                "target_lang_sense_clarification": "补贴未覆盖需个人支付的部分"
                            },
                            {
                                "target_lang_word": "额外自付费用",
                                "target_lang_sense_clarification": "消费者承担的附加费"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b925a03d-ee7a-30fc-be53-2aab7c81975d",
                    "sense_definition": "An excessively high or unfair price charged to a customer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unsuspecting tourists often face a steep <w>surcharge</w> for basic transportation during peak season.",
                            "target_lang_translations": {
                                "zh": "毫无防备的游客在旺季常常会遇到基础交通服务的<w>过高收费</w>。"
                            }
                        },
                        {
                            "text": "Consumers complained that the sudden <w>surcharge</w> on bottled water was unjustified price gouging.",
                            "target_lang_translations": {
                                "zh": "消费者抱怨瓶装水突然出现的<w>过高收费</w>是不合理的哄抬物价。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overcharge"
                    ],
                    "target_lang_definitions": {
                        "zh": "向顾客收取的过高或不合理的费用或要价。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "过高收费",
                                "target_lang_sense_clarification": "不合理的高价或漫天要价"
                            },
                            {
                                "target_lang_word": "乱收费",
                                "target_lang_sense_clarification": "不合理的加价或收费"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adaae4d2-b90b-3799-9724-0388546c6cbf",
                    "sense_definition": "An overprint on a postage stamp that alters its face value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stamp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During hyperinflation, the postal service printed a new <w>surcharge</w> over existing stamps.",
                            "target_lang_translations": {
                                "zh": "在恶性通货膨胀期间，邮政部门在现有邮票上印上了新的<w>改值加字</w>。"
                            }
                        },
                        {
                            "text": "The rare stamp displays a distinct <w>surcharge</w> that doubled its original monetary value.",
                            "target_lang_translations": {
                                "zh": "这枚罕见的邮票上有一个醒目的<w>改值加字</w>，使其原本的面值翻了一倍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overprint"
                    ],
                    "target_lang_definitions": {
                        "zh": "在邮票上加盖以改变其面值的加贴戳记或加盖字样。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "改值加字",
                                "target_lang_sense_clarification": "邮票上改变面值的加盖字样"
                            },
                            {
                                "target_lang_word": "加盖改值",
                                "target_lang_sense_clarification": "邮票上的改值戳记"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3443a3b6-95a2-31ca-abbb-ef0d2178ed98",
                    "sense_definition": "A legal penalty imposed on a fiduciary for financial loss caused by negligence or misconduct.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ordered a substantial <w>surcharge</w> against the trustee for mismanaging the family estate.",
                            "target_lang_translations": {
                                "zh": "法院因受托人对家族财产管理不当而对其判处了高额<w>追偿金</w>。"
                            }
                        },
                        {
                            "text": "A fiduciary may face a personal <w>surcharge</w> if corporate assets are improperly handled.",
                            "target_lang_translations": {
                                "zh": "如果公司资产处理不当，受托人可能会面临个人的<w>追偿金</w>处分。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因疏忽或不当行为导致财产损失而对受托人处以的追偿赔偿金或惩罚性扣款。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "赔偿罚金",
                                "target_lang_sense_clarification": "法律上对失职受托人的追偿性罚款"
                            },
                            {
                                "target_lang_word": "追偿金",
                                "target_lang_sense_clarification": "要求受托人补足损失的款项"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b02e4bf-2276-3030-bc55-2bd776d32808",
                    "sense_definition": "An omission found in an account that must be added as a debit against the accounting party.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the formal audit, the accountant identified an unrecorded <w>surcharge</w> in the balance sheet.",
                            "target_lang_translations": {
                                "zh": "在正式审计过程中，会计师在资产负债表中发现了一处未入账的<w>漏列借项</w>。"
                            }
                        },
                        {
                            "text": "The plaintiff sought to establish a <w>surcharge</w> for revenue that the manager failed to collect.",
                            "target_lang_translations": {
                                "zh": "原告试图针对经理未能收取的营业收入追加确立一项<w>漏列借项</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "账目审计中发现的遗漏款项，作为借方追加计入会计责任人名下。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漏列借项",
                                "target_lang_sense_clarification": "账目中遗漏应补记入借方的款项"
                            },
                            {
                                "target_lang_word": "追记借项",
                                "target_lang_sense_clarification": "查账时追加确认的借记额"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6285abdd-419c-310a-88a1-6fcaf7e1e0ff",
                    "sense_definition": "An excessive load, weight, or burden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old carriage collapsed under a heavy <w>surcharge</w> of baggage.",
                            "target_lang_translations": {
                                "zh": "老旧的马车在行李沉重的<w>过量负荷</w>下散了架。"
                            }
                        },
                        {
                            "text": "Excessive administrative duties placed a damaging <w>surcharge</w> on the small clinic's resources.",
                            "target_lang_translations": {
                                "zh": "繁重的行政职责给这家小诊所的资源带来了破坏性的<w>超载</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overload"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to describe physical or metaphorical overloads"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "过量的负荷、过重的重量或沉重的负担。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "过量负荷",
                                "target_lang_sense_clarification": "过重的重量或压力"
                            },
                            {
                                "target_lang_word": "超载",
                                "target_lang_sense_clarification": "过重的负担或载荷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad1f73af-ce4c-314b-bdbf-3dae1b61dc38",
                    "sense_definition": "The unlawful act of placing more livestock on common land than one is entitled to pasture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commonage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village elders warned the farmer against the <w>surcharge</w> of his grazing rights.",
                            "target_lang_translations": {
                                "zh": "村里的长者警告该农户不要超出其放牧权进行<w>超额放牧</w>。"
                            }
                        },
                        {
                            "text": "Historical court records show frequent fines for the illegal <w>surcharge</w> of public commons.",
                            "target_lang_translations": {
                                "zh": "历史法庭记录显示，常有人因在公共草场非法进行<w>超额放牧</w>而被罚款。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Related to historical common land rights"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在公共土地上超出放牧权利限量放养过多牲畜的违法行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超额放牧",
                                "target_lang_sense_clarification": "在公地超许可数量放牧的行为"
                            },
                            {
                                "target_lang_word": "过度放牧",
                                "target_lang_sense_clarification": "超出规定放养牲口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f50da3f-3eef-32a2-b8e7-f95d7acb7661",
                    "sense_definition": "A layer of lighter enamel applied over a darker enamel ground.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan applied a delicate <w>surcharge</w> to create highlights on the vase.",
                            "target_lang_translations": {
                                "zh": "工匠涂上了一层精致的<w>表层釉</w>，在花瓶上营造出高光效果。"
                            }
                        },
                        {
                            "text": "A smooth <w>surcharge</w> of white enamel formed the detailed patterns on the medallion.",
                            "target_lang_translations": {
                                "zh": "一层光滑的白色<w>表层釉</w>构成了奖章上的精细图案。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在较暗的珐琅底色上涂敷的一层较浅色珐琅釉面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "表层釉",
                                "target_lang_sense_clarification": "底色之上覆盖的浅色珐琅层"
                            },
                            {
                                "target_lang_word": "罩面釉",
                                "target_lang_sense_clarification": "珐琅彩工艺中的上层覆盖釉"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f13b9c77-5587-3728-90b8-1d864aaea7cf",
                    "sense_definition": "To impose an additional fee or cost onto an existing price.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some restaurants will <w>surcharge</w> patrons who pay with certain premium credit cards.",
                            "target_lang_translations": {
                                "zh": "部分餐厅会对使用某些高端信用卡的顾客<w>加收费用</w>。"
                            }
                        },
                        {
                            "text": "The delivery company decided to <w>surcharge</w> orders placed outside standard working hours.",
                            "target_lang_translations": {
                                "zh": "快递公司决定对在正常工作时间之外下的订单<w>额外收费</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在原价格基础上加收额外费用。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加收费用",
                                "target_lang_sense_clarification": "额外收取费用"
                            },
                            {
                                "target_lang_word": "额外收费",
                                "target_lang_sense_clarification": "在基本费用外另外收钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "103e88f7-1e92-3ecc-9746-23aec9191216",
                    "sense_definition": "To overload or fill something to excess.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark storm clouds seemed to <w>surcharge</w> the evening air with heavy rain.",
                            "target_lang_translations": {
                                "zh": "乌云密布的风暴云似乎让傍晚的空气中<w>充斥</w>着大雨的气息。"
                            }
                        },
                        {
                            "text": "Workers were careful not to <w>surcharge</w> the pack animals before the steep climb.",
                            "target_lang_translations": {
                                "zh": "工人们在攀爬陡坡之前小心翼翼，尽量不<w>使超载</w>驮畜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overburden",
                        "overload"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or older contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使装载过量、超负荷或过度充斥。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使超载",
                                "target_lang_sense_clarification": "使承受过重负荷"
                            },
                            {
                                "target_lang_word": "充斥",
                                "target_lang_sense_clarification": "过度充满或布满"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc5d94e9-d735-32f2-82d9-467854a8d9c0",
                    "sense_definition": "To overstock land by putting more livestock on it than allowed or than the pasture can feed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commonage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Neighbors argued that bringing extra cattle would <w>surcharge</w> the shared grazing land.",
                            "target_lang_translations": {
                                "zh": "邻居们争辩说，带来额外的牛群会在这片共用牧场上造成<w>超额放牧</w>。"
                            }
                        },
                        {
                            "text": "The manor courts regulated tenants who attempted to <w>surcharge</w> pasture beyond their allowance.",
                            "target_lang_translations": {
                                "zh": "庄园法庭对那些试图超出配额在牧场上<w>超额放牧</w>的佃户进行监管。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overstock"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical property and grazing law"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在牧场上放养超过许可或牧草所能承受限额的牲畜。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超额放牧",
                                "target_lang_sense_clarification": "放养超过限定数量的牲口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceb53bcd-c976-3abd-9233-bd5e267d66b1",
                    "sense_definition": "To prove that an omission exists in an account that ought to be credited to the opposing party.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auditor attempted to <w>surcharge</w> the ledger by demonstrating missed revenue items.",
                            "target_lang_translations": {
                                "zh": "审计员通过指出遗漏的收入项目，试图在分类账中<w>追列漏额</w>。"
                            }
                        },
                        {
                            "text": "In equity law, a party may falsify or <w>surcharge</w> an account presented by a trustee.",
                            "target_lang_translations": {
                                "zh": "在衡平法中，当事人可以对受托人提交的账目提出异议或<w>主张漏记借项</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在查账或诉讼中证明账目存在应计入对方收益的遗漏款项。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "追列漏额",
                                "target_lang_sense_clarification": "举证并追加应记款项"
                            },
                            {
                                "target_lang_word": "主张漏记借项",
                                "target_lang_sense_clarification": "在衡平法中指控账目漏报"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}