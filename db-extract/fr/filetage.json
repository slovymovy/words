                "senses": [
                    {
                        "sense_id": "3ee5b8c2-e928-3e24-926d-86f5fe60c17f",
                        "entry_id": "553d9f4d-9df3-35dd-9470-46bf83bdba6f",
                        "glosses": [
                            "Action d'usiner un filet sur une tige ou un tube en utilisant une filière ou tout autre outil."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5873f5cd-8535-3e0a-92b1-ba8b8aac4cf7",
                        "entry_id": "553d9f4d-9df3-35dd-9470-46bf83bdba6f",
                        "glosses": [
                            "Usinage hélicoïdal réalisé sur une tige, un tube, un écrou ou dans l’alésage d'une pièce mécanique, afin de permettre sa fixation ou son étanchéité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1939b24f-c9e9-48bc-8342-75ab01e886d3",
                                "sense_id": "5873f5cd-8535-3e0a-92b1-ba8b8aac4cf7",
                                "text": "Il ne l’avait guère eue en main que quelques secondes lors d’une visite à Drouot, pourtant l’impression demeurait encore saisissante, effroyable à ses yeux : il se remémorait avec précision le totem, le collier de fer mat et, derrière, le filetage et son volant de fonte, larges et brillants comme une presse de notaire ; la pointe de fer peint, surtout, qui vient se ficher dans la nuque afin de disjoindre les vertèbres et d’écraser la moelle épinière."
                            }
                        ]
                    },
                    {
                        "sense_id": "149314ce-b184-3f07-a7cd-ebe947946d58",
                        "entry_id": "553d9f4d-9df3-35dd-9470-46bf83bdba6f",
                        "glosses": [
                            "Action de lever les filets des poissons."
                        ],
                        "tags": [
                            "Agro-alimentaire"
                        ],
                        "examples": [
                            {
                                "example_id": "e1044d25-205a-42a1-924b-1cee57a03cae",
                                "sense_id": "149314ce-b184-3f07-a7cd-ebe947946d58",
                                "text": "Les sous-produits de l’industrie de filetage du poisson sont d’appréciables matières premières pour la production de la farine de poisson et de l’huile de poisson employées dans les aliments composés, dont les aliments pour poissons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba2e2a20-70f8-4e1c-a5d9-36e170f44f21",
                        "source_entry_id": "553d9f4d-9df3-35dd-9470-46bf83bdba6f",
                        "source_sense_id": "3ee5b8c2-e928-3e24-926d-86f5fe60c17f",
