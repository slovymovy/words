                "senses": [
                    {
                        "sense_id": "227083f4-90d2-39e3-be45-13f6a5e2d77e",
                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                        "glosses": [
                            "A pleasure trip or excursion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a1ebb3c-86ab-4def-bfde-84c9d04cf34e",
                                "sense_id": "227083f4-90d2-39e3-be45-13f6a5e2d77e",
                                "text": "This was a fine day's outing for anybody who had been cooped up in the shops for a few months."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                        "glosses": [
                            "A performance in public, for example in a drama, film, on a musical album, as a sports contestant etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62a8e216-900d-4ebe-b721-50bf52211c23",
                                "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                                "text": "The role is the latest dramatic outing for Radcliffe since the end of the successful Potter franchise."
                            },
                            {
                                "example_id": "3c349553-2181-4623-a661-7fd8acd61663",
                                "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                                "text": "Other erstwhile stalwarts are also wavering. Southampton had two of the best full-backs in the league last season but Ryan Bertrand has been below par this season and Cédric Soares made an uncharacteristic lapse that led to Stoke’s winning goal in Southampton’s last outing."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d7d6a1c-525e-3631-8027-2366287cdc90",
                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                        "glosses": [
                            "The act of publicly revealing that a person is homosexual or transgender without that person's consent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e2121b-7f7c-4cb0-bdea-3c0345fe47ae",
                                "sense_id": "9d7d6a1c-525e-3631-8027-2366287cdc90",
                                "text": "Advocates for gay and lesbian issues suggest the increase in discharges reflects the hostility of the military towards homosexual soldiers and a growing number of \"forced outings\" of gay and lesbian troops."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fae3da9-551b-3a1d-814e-ee6f248d1878",
                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                        "glosses": [
                            "The act of revealing somebody as having a certain secret, such as a being a secret agent or undercover detective."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c5c32ee-f912-46e0-b8b5-86864527d2ca",
                        "source_entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                        "source_sense_description": "excursion",
                        "target_lang_word": "excursion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excursion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44f95996-cbe7-3a0f-a724-f8feb4b638d0",
                                        "entry_id": "c3c183ec-dac4-30f4-b9f7-1525a16ffd7a",
                                        "glosses": [
                                            "Course au dehors, promenade de recherche, de découverte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0584c9e-d696-4c03-85d0-e83b2edb47db",
                                                "sense_id": "44f95996-cbe7-3a0f-a724-f8feb4b638d0",
                                                "text": "Le docteur Barth se détache de ses compagnons, fait une excursion à la ville d'Agbadès, et rejoint l'expédition, qui se remet en marche le 12 décembre."
                                            },
                                            {
                                                "example_id": "89288da1-303f-4232-bb4a-51223f80ea1b",
                                                "sense_id": "44f95996-cbe7-3a0f-a724-f8feb4b638d0",
                                                "text": "Il alla faire une excursion au-dessus de l’Hudson et de l’East River ; il s’éleva à plusieurs reprises, comme pour voir par-delà les lointains bleus."
                                            },
                                            {
                                                "example_id": "66eb9998-3fac-487b-866d-8e8604adcd99",
                                                "sense_id": "44f95996-cbe7-3a0f-a724-f8feb4b638d0",
                                                "text": "Nous finîmes par arriver à un lac immense entouré de collines et de tori pittoresques. On venait y faire de petites excursions en bateau ou en pédalo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa08ff4-cfd7-30a4-a2ce-9b14683d62e6",
                                        "entry_id": "c3c183ec-dac4-30f4-b9f7-1525a16ffd7a",
                                        "glosses": [
                                            "Digression."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f00ffb5-777d-411b-93f3-57c599ec0a6a",
                                                "sense_id": "afa08ff4-cfd7-30a4-a2ce-9b14683d62e6",
                                                "text": "Faire une excursion, de fréquentes excursions hors de son sujet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef8dac5c-438d-3cf8-8b4c-5d235cacf265",
                                        "entry_id": "c3c183ec-dac4-30f4-b9f7-1525a16ffd7a",
                                        "glosses": [
                                            "Variation temporaire d’une grandeur en dehors de sa valeur habituelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08465073-737a-43a2-b01c-6b3c6c328c61",
                                                "sense_id": "ef8dac5c-438d-3cf8-8b4c-5d235cacf265",
                                                "text": "L’écran montre que l’excursion du diaphragme est nulle dans les inspirations profondes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "469569a1-d9e9-41a4-8173-3eaae703ba20",
                        "source_entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
