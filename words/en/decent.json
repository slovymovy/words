                        "zh": [
                            {
                                "target_lang_word": "穿戴整齐",
                                "target_lang_sense_clarification": "衣着得体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97b8b1e8-5c3f-3de0-ad32-766195579887",
                    "sense_definition": "Appropriate and suitable for the circumstances or social conventions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family wanted to ensure the victims received a <w>decent</w> burial.",
                            "target_lang_translations": {
                                "ru": "Семья хотела убедиться, что жертвы получат <w>досто́йные</w> похороны.",
                                "zh": "家属希望确保遇难者能得到<w>体面</w>的安葬。"
                            }
                        },
                        {
                            "text": "He did not even have the <w>decent</w> manners to say goodbye.",
                            "target_lang_translations": {
                                "ru": "У него не хватило даже <w>элемента́рных</w> манер, чтобы попрощаться.",
                                "zh": "他甚至连告别时应有的<w>得体</w>礼貌都没有。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "decent burial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уместный и подходящий для обстоятельств или социальных условностей.",
                        "zh": "符合特定情况或社会习俗，得体且合适。"
                    },
