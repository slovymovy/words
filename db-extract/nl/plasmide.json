                        "cross_references": []
                    },
                    {
                        "translation_id": "2210b712-bcad-4367-91b8-8e0a875a3bbb",
                        "source_entry_id": "310736bf-6058-3c4d-bfee-5b9d26a96c2e",
                        "source_sense_id": "671e5cec-8a06-3b4f-abd5-8bf2c871183f",
                        "source_sense_description": "een ringvormig DNA-molecuul dat voornamelijk voorkomt voor bij bacteriën",
                        "target_lang_word": "plasmid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plasmid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3680953f-693e-3dc6-b2e8-b2d8a53eb247",
                                        "entry_id": "733c3adb-bbb1-3c30-ac2f-519348669fe6",
                                        "glosses": [
                                            "A loop of double-stranded DNA that is separate from — and replicates independently of — the chromosomes; such loops are most commonly found in bacteria, but they are also sometimes found in archaeans and eukaryotic cells, and they are used in genetic engineering as a vector for gene transfer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d446620-5402-4d12-8b4f-1254c8c2932c",
                                                "sense_id": "3680953f-693e-3dc6-b2e8-b2d8a53eb247",
                                                "text": "These discussions have left a plethora of terms adrift: pangenes, bioblasts, plasmagenes, plastogenes, chondriogenes, cytogenes and proviruses, which have lost their original utility owing to the accretion of vague or contradictory connotations. At the risk of adding to this list, I propose plasmid as a generic term for any extrachromosomal hereditary determinant."
                                            },
                                            {
                                                "example_id": "1e2d168e-ba4a-4eda-9462-12573672f378",
                                                "sense_id": "3680953f-693e-3dc6-b2e8-b2d8a53eb247",
                                                "text": "This is how the F (for \"fertility\") plasmid, which forms the basis of a lot of classical E. coli genetics, is transferred from one cell to another."
                                            },
                                            {
                                                "example_id": "24177446-130e-468c-960f-4e526061814f",
                                                "sense_id": "3680953f-693e-3dc6-b2e8-b2d8a53eb247",
                                                "text": "Bacteria are happy to absorb little rings of DNA called plasmids and adopt them as their own."
                                            },
                                            {
                                                "example_id": "ec343496-be18-4e10-a247-4e048c664741",
                                                "sense_id": "3680953f-693e-3dc6-b2e8-b2d8a53eb247",
                                                "text": "Plasmids have an essential impact on productivity. Related factors are plasmid copy number, structural plasmid stability and segregational plasmid stability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ae91ef8-149f-42c7-9714-c2b075ce91c0",
                        "source_entry_id": "310736bf-6058-3c4d-bfee-5b9d26a96c2e",
                        "source_sense_id": "671e5cec-8a06-3b4f-abd5-8bf2c871183f",
                        "source_sense_description": "een ringvormig DNA-molecuul dat voornamelijk voorkomt voor bij bacteriën",
                        "target_lang_word": "plasmide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plasmide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "310fb6fa-0770-3bd8-bef2-decd512f6a1f",
                                        "entry_id": "e277423d-1fd7-32e1-856b-cc1ab93bad71",
                                        "glosses": [
                                            "Molécule d'ADN extrachromosomique capable de se répliquer indépendamment et portant des caractères génétiques non essentiels à la cellule hôte."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad4e16fb-bc72-4d8c-b75d-6e7953e86d63",
                                                "sense_id": "310fb6fa-0770-3bd8-bef2-decd512f6a1f",
                                                "text": "Le plasmide doit tout d’abord être linéarisé par digestion avec la même enzyme de restriction que celle qui a été utilisée pour préparer le fragment d’ADN."
                                            },
                                            {
                                                "example_id": "0f8950f1-b5df-4666-bc7a-f98a3d082c6e",
                                                "sense_id": "310fb6fa-0770-3bd8-bef2-decd512f6a1f",
                                                "text": "C'est là que de petites molécules d'ADN appelées plasmides sont fabriquées avec les débuts du code de la protéine de pointe SRAS-CoV-2."
                                            },
                                            {
                                                "example_id": "edd16295-aa72-434d-8b20-a7b2f6bc909c",
                                                "sense_id": "310fb6fa-0770-3bd8-bef2-decd512f6a1f",
                                                "text": "Les plasmides conjugatifs sont les premiers plasmides qui ont été découverts chez la bactérie Escherichia coli dans les années 1950."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
