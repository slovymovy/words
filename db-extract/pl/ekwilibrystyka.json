                        "entry_id": "58ca1578-b8e5-33bc-bc5a-5dc45eeeabee",
                        "glosses": [
                            "zachowywanie równowagi w trudnych warunkach, np. na linie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e68c4750-de9c-49ec-888f-a7dfdae48d4e",
                                "sense_id": "2abfd55b-1088-3f83-a516-621c97ebb52a",
                                "text": "Czytam kronikę sekcji ekwilibrystyki rowerowej na monocyklach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "62542c3f-4157-39f2-9cc3-b93bd17ee093",
                        "entry_id": "58ca1578-b8e5-33bc-bc5a-5dc45eeeabee",
                        "glosses": [
