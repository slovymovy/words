                "senses": [
                    {
                        "sense_id": "2a3dc58a-cf64-3127-8172-6d9786b37186",
                        "entry_id": "d1c53877-d808-3a63-8387-e516e4183204",
                        "glosses": [
                            "расположенный в Венесуэле, обитающий в Венесуэле, свойственный Венесуэлы, либо имеющий к этой стране иное непосредственное отношение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c038b90-01a6-4c79-a065-474a041c1868",
                                "sense_id": "2a3dc58a-cf64-3127-8172-6d9786b37186",
                                "text": "Маргарита — крупнейший венесуэльский остров в южной части Карибского моря."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d555dac-341e-4e70-a892-c4894378ee0e",
                        "source_entry_id": "d1c53877-d808-3a63-8387-e516e4183204",
                        "source_sense_id": "2a3dc58a-cf64-3127-8172-6d9786b37186",
                        "target_lang_word": "Venezuelan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Venezuelan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47c8e8c9-b000-3914-8449-4df3805e4e05",
                                        "entry_id": "9849b918-61e5-366a-8cc5-90654136b6ff",
                                        "glosses": [
                                            "A person from Venezuela or of Venezuelan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83a0e53-fe20-4379-b528-c6b19c68bd1f",
                                                "sense_id": "47c8e8c9-b000-3914-8449-4df3805e4e05",
                                                "text": "The march through the Darién Gap of Haitians, Venezuelans and Cubans fleeing economic collapse and political persecution has been well-documented."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Venezuelan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85a27fbc-587c-3789-a7f2-ea4959766a11",
                                        "entry_id": "5944302f-b987-301c-bf7f-4b30bf13f63a",
                                        "glosses": [
                                            "Of, from, or pertaining to Venezuela or the Venezuelan people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d9b090f-f466-48e7-89b9-2a16861fc10b",
                                                "sense_id": "85a27fbc-587c-3789-a7f2-ea4959766a11",
                                                "text": "But the first foray by Russian strategic bombers into the Western hemisphere since the Cold War is simply the curtain raiser for joint naval maneuvers that will bring Russian warships into Venezuelan waters in November."
                                            },
                                            {
                                                "example_id": "35d44a03-bd90-4228-88cc-68b6b376490f",
                                                "sense_id": "85a27fbc-587c-3789-a7f2-ea4959766a11",
                                                "text": "The Venezuelan gang, known as Tren de Aragua, or TDA, has a known presence in 15 states and a possible presence in eight others, according to the data."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
