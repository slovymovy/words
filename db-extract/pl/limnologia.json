                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e0319f9-d902-4eda-b428-f7d17dfb9570",
                        "source_entry_id": "f07cf654-3dc9-3958-89c9-6437a2132868",
                        "source_sense_id": "aa6fa3f5-918c-38f5-9a96-4700c2c0d219",
                        "target_lang_word": "limnology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limnology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4019b149-d068-34bd-904a-34e83391cfff",
                                        "entry_id": "3a1f4852-5021-3094-a082-725bd3d776ce",
                                        "glosses": [
                                            "The science concerning the biological, physical and geological properties of fresh water bodies, especially lakes and ponds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61daaf38-7584-47d4-9330-50c070a5a92e",
                                                "sense_id": "4019b149-d068-34bd-904a-34e83391cfff",
                                                "text": "Although limnology is a young discipline, it has, over the past century, experienced marked growth. Its early descriptive period was a long one, given the enormous diversity of biota and environments in freshwater ecosystems."
                                            },
                                            {
                                                "example_id": "8e5eefa4-7a7e-4dc5-b77c-61fb7f5d6a2b",
                                                "sense_id": "4019b149-d068-34bd-904a-34e83391cfff",
                                                "text": "The exercises in this book were set forth initially because of our frustrations in teaching such a complex, multifaceted discipline as limnology."
                                            },
                                            {
                                                "example_id": "a97d38d9-0ee6-4107-96b0-8abdb2d6aba3",
                                                "sense_id": "4019b149-d068-34bd-904a-34e83391cfff",
                                                "text": "Reservoir limnology and water quality management are associated with functions such as flood control, hydropower generation, irrigation, and fishery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c969eefe-9b0f-4c82-aa38-003087940cc8",
                        "source_entry_id": "f07cf654-3dc9-3958-89c9-6437a2132868",
                        "source_sense_id": "aa6fa3f5-918c-38f5-9a96-4700c2c0d219",
                        "target_lang_word": "limnologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limnologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7379acb0-8fc9-33be-8fe9-58a736cb2b3e",
                                        "entry_id": "9d0bcd0e-987f-3361-9acf-faa148ba14bc",
                                        "glosses": [
                                            "Science des eaux superficielles continentales ou intérieures (eau douce ou salée, stagnante ou mouvante, dans les lacs, rivières, marécages…)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212750bc-6599-417a-b631-324abb5c8969",
                                                "sense_id": "7379acb0-8fc9-33be-8fe9-58a736cb2b3e",
                                                "text": "La limnologie est la discipline qui étudie les phénomènes hydrologiques et biologiques se rapportant aux lacs en relation avec leur environnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d530ff77-5eb8-47d8-9535-0352d48aaeba",
                        "source_entry_id": "f07cf654-3dc9-3958-89c9-6437a2132868",
                        "source_sense_id": "aa6fa3f5-918c-38f5-9a96-4700c2c0d219",
                        "target_lang_word": "limnología",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limnología",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e490187d-a661-37f6-b6fd-9831826b40bd",
                                        "entry_id": "6046fb65-a260-3092-973b-3b4bdd33249d",
                                        "glosses": [
                                            "Estudio de características biológicas, físicas y químicas de cuerposs hídricos continentales: lagos, lagunas, ríos, presas, charcas, marismas y estuarios, así como de las interacciones de organismos acuáticos y su hábitat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2768b044-6195-460f-a319-0e27fdfe153b",
                                                "sense_id": "e490187d-a661-37f6-b6fd-9831826b40bd",
                                                "text": "Limnología es una asignatura optativa que permite que el alumno tenga conocimiento sobre los procesos hidrológicos, para que comprenda el funcionamiento y efecto de los diferentes sistemas acuáticos. Además se busca la integración de los conocimientos teóricos con la práctica, de manera que el alumno complemente su formación y tenga las herramientas que le permitan analizar y evaluar diferentes tipos de sistemas limnéticos"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
