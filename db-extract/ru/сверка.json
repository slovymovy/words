                                        "glosses": [
                                            "The process whereby others confirm the validity of one's emotions or perspective."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045e01a4-aa87-48aa-88d4-251e01906ca2",
                                                "sense_id": "bf75207d-4984-3bdf-8d8d-0c521984973e",
                                                "text": "Praise is a judgment. It says, “I like the way you look or perform.” Validation demonstrates acceptance. It says, “I accept who you are, independent of how you look or perform.” When people claim that we shouldn’t rely on “external validation,” they are confusing validation with praise."
                                            }
                                        ]
