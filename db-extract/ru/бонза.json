                    },
                    {
                        "translation_id": "294547fc-26c9-4387-aeb8-6e8466dfc863",
                        "source_entry_id": "c751436e-ced5-399e-916f-bf92bd06b70c",
                        "target_lang_word": "bonze",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonze",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e20fe69-2407-3564-afa1-770ff6c98773",
                                        "entry_id": "40aab398-031c-393e-b3fe-8212f5818991",
                                        "glosses": [
                                            "Enseignant religieux bouddhique, prêtre bouddhique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4550755-7305-40c9-9272-9e64feac27a2",
                                                "sense_id": "8e20fe69-2407-3564-afa1-770ff6c98773",
                                                "text": "Nous nous tordions dans les coins à blaguer tous ces vieux birbes qui exécutaient avec un sérieux de bonzes les choses les plus cocasses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3064bdbf-5660-3c05-a47d-6c8c8952d21a",
                                        "entry_id": "40aab398-031c-393e-b3fe-8212f5818991",
                                        "glosses": [
                                            "Dirigeant."
                                        ],
                                        "tags": [
                                            "ironic",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185da7ea-1aa7-4595-ab6c-607b6d62cb5f",
                                                "sense_id": "3064bdbf-5660-3c05-a47d-6c8c8952d21a",
                                                "text": "Il arrive même que certaine dame dont le mari est un bonze du régime, téléphone à Biermann, le suppliant de ne pas faire de chanson sur son mari…"
                                            },
                                            {
                                                "example_id": "c41dd0aa-8992-4ba9-ab2a-b8f380e951d0",
                                                "sense_id": "3064bdbf-5660-3c05-a47d-6c8c8952d21a",
                                                "text": "Et, comme l’affirmait monsieur Legault hier, les bonzes du milieu des affaires le respectaient."
                                            },
                                            {
                                                "example_id": "8e9184fd-4d5b-4601-8aeb-14e5fb803212",
                                                "sense_id": "3064bdbf-5660-3c05-a47d-6c8c8952d21a",
                                                "text": "Le daïmio parle bien, dit le prince de Satsouma, il est impossible que les bonzes d’Europe aient aucune influence sur la tranquillité du royaume."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
