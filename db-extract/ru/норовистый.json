                        ],
                        "form": "норови́стее"
                    },
                    {
                        "form_id": "2c0a2015-5ef0-4643-b749-563d40b14f4a",
                        "entry_id": "f039298c-742e-3a4f-9fcb-0b0e6d555d3e",
                        "tags": [
