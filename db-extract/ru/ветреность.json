                "senses": [
                    {
                        "sense_id": "ed12a3b6-7a97-3318-8b85-013c32d81e02",
                        "entry_id": "ea0f8114-8e28-3f5e-a2c6-7cae41380fb3",
                        "glosses": [
                            "свойство по значению прилагательного ветреный; легкомысленность, непостоянство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d60861a1-2ebc-40c9-80b2-e7617c1d58c1",
                                "sense_id": "ed12a3b6-7a97-3318-8b85-013c32d81e02",
                                "text": "Ну что ты? к чему? зачем? Что за ветреность такая! Вдруг вбежала, как угорелая кошка."
                            },
                            {
                                "example_id": "b2abbbf2-fbb5-44ec-b346-850df85294b2",
                                "sense_id": "ed12a3b6-7a97-3318-8b85-013c32d81e02",
                                "text": "Походка торопливая, с оглядками говорит о ветрености и легкомыслии."
                            }
                        ]
                    }
                ],
