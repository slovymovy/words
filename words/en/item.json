                        {
                            "text": "Critics discussed the relevance of the <w>item</w> in the film's plot.",
                            "target_lang_translations": {
                                "ru": "Критики обсуждали уместность этого <w>номера</w> в сюжете фильма.",
                                "tr": "Eleştirmenler bu müzikal <w>numaranın</w> filmin olay örgüsündeki yerini tartıştılar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "item number",
                        "item song"
                    ],
                    "traits": [
