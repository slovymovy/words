                    ],
                    "antonyms": [
                        "non-compliant",
                        "noncompliant"
                    ],
                    "common_phrases": [
                        "fully compliant",
                        "compliant with regulations",
                        "standards compliant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий определенным правилам, стандартам или юридическим требованиям."
                    },
                    "translations": {
