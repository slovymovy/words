                    {
                        "translation_id": "9b53d5d2-4e24-46d4-8244-5a6461e0c9d3",
                        "source_entry_id": "1d94aff8-497f-3cd4-a90b-e97e9d01e8e8",
                        "source_sense_id": "21d78fd7-fe54-3d0f-ae13-fd33574f6191",
                        "source_sense_description": "overbearing, dictatorial or authoritarian",
