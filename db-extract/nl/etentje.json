                    {
                        "sense_id": "d03488fa-177c-3a7f-b44d-506c6847ba0a",
                        "entry_id": "5bcef773-c905-3f0e-89d3-2e028e1c39ba",
                        "glosses": [
                            "vrij informele bijeenkomst waarbij men een gezamenlijke maaltijd nuttigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "029232de-4c22-46cf-b0e7-88f0f547f0a8",
                                "sense_id": "d03488fa-177c-3a7f-b44d-506c6847ba0a",
                                "text": "Wij hadden een etentje bij vrienden die het leuk vinden om te kokkerellen voor gasten."
                            },
                            {
                                "example_id": "f0cec5a1-49fa-4feb-ba40-e449218a7b86",
                                "sense_id": "d03488fa-177c-3a7f-b44d-506c6847ba0a",
                                "text": "Nee, over de situatie in Noorwegen wilde hij het niet met een buitenstaander hebben en zelfs thuis liever niet, tijdens de etentjes in het weekend in Saltsjôbaden."
                            },
                            {
                                "example_id": "b1662790-0e01-4a59-822d-fd603a20ee1f",
                                "sense_id": "d03488fa-177c-3a7f-b44d-506c6847ba0a",
                                "text": "Ze maakte ontbijt voor hem klaar en wilde de volgende nacht plannen, of de avond of allebei. Omdat ze geen grote uitgaven had gehad, had ze kunnen sparen van haar kleine loon van de winkel, ze wilde hem vanavond heel graag uitnodigen voor een etentje."
                            }
                        ]
                    }
                ],
