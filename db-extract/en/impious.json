                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pietätlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eaf64091-36bc-3aa7-aa15-c81add87a380",
                                        "entry_id": "acde3135-86c5-3c0a-b883-d83cb1027d98",
                                        "glosses": [
                                            "ohne Achtung/Respekt vor religiösen und/oder moralischen Grundsätzen und Normen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36fd69d4-69f6-4ff2-ac05-2774f9833f47",
                                                "sense_id": "eaf64091-36bc-3aa7-aa15-c81add87a380",
                                                "text": "Wie pietätlos von ihm!"
                                            },
                                            {
                                                "example_id": "c3fe1e2a-0063-4114-9fab-376aaf5c440d",
                                                "sense_id": "eaf64091-36bc-3aa7-aa15-c81add87a380",
                                                "text": "„Für die Geschädigten sind Metalldiebe, die Gräber plündern, pietätlose Verbrecher.“"
                                            },
                                            {
                                                "example_id": "dd657317-e623-4f4e-b60d-7ee53fd40e34",
                                                "sense_id": "eaf64091-36bc-3aa7-aa15-c81add87a380",
                                                "text": "„‚Neben dem pietätlosen und aufdringlichen Verhalten lösen diese Verkehrsteilnehmer auch oft größere Verkehrsbehinderungen aus, als ohnehin schon vorhanden sind‘, heißt es im Polizeibericht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
