                    {
                        "translation_id": "553acccd-04a5-4a4b-ae4f-8125c126a009",
                        "source_entry_id": "b660cb80-16e4-35cb-a02b-9dff89fb16f4",
                        "source_sense_id": "33336180-a64b-391e-a731-33b147d64f94",
                        "target_lang_word": "houwitser",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "houwitser",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ecfa734-9159-3974-a838-5d40b1782b5b",
                                        "entry_id": "c93c7f0c-36c7-3779-8ed3-7407a285ec28",
                                        "glosses": [
                                            "een soort krombaangeschut dat de projectielen in een kromme baan over hindernissen heen kan schieten en vaak een relatief korte loop heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ec715c-c446-4095-97c3-71a0bfafaa9c",
                                                "sense_id": "8ecfa734-9159-3974-a838-5d40b1782b5b",
                                                "text": "Vorst Andrej sprak niet met Toesjin. Ze waren allebei zo druk bezig dat het leek of ze elkaar niet zagen. Toen ze, nadat ze de twee stukken geschut van de vier die nog bruikbaar waren op de voorwagen hadden vastgemaakt (één kapotgeschoten kanon en een houwitser werden achtergelaten), reed vorst Andrej op Toesjin af."
                                            },
                                            {
                                                "example_id": "76823f5b-a147-4140-adad-e48ad63afa7e",
                                                "sense_id": "8ecfa734-9159-3974-a838-5d40b1782b5b",
                                                "text": "Oekraïne verklaarde eerder dat alle zware wapens van de frontlinie waren teruggetrokken. De video van Reuters in het zuidoosten van Oekraïne nabij de plaats Shirokine zou echter een ander beeld tonen. Volgens de Russen is daarop te zien dat het Oekraïense leger een houwitser D30 gebruikt. Dat zware wapen kan doelen op ruim 20 kilometer afstand raken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0a1791c-a9c2-404f-b87e-4873495801a4",
                        "source_entry_id": "b660cb80-16e4-35cb-a02b-9dff89fb16f4",
                        "source_sense_id": "33336180-a64b-391e-a731-33b147d64f94",
                        "target_lang_word": "Haubitze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haubitze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                                        "entry_id": "4b3a621f-2176-3f3b-ae16-4f6e4b320fd1",
                                        "glosses": [
                                            "Artilleriegeschütz zum indirekten sowie direkten Beschuss auf große Entfernung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee2dca4-9ba1-4320-bb67-f73c3fd4bd58",
                                                "sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                                                "text": "Das Rohr einer Haubitze ist kürzer als das einer Kanone, dafür kann es in einem steileren Winkel angestellt werden."
                                            },
                                            {
                                                "example_id": "0a145814-f1ba-47c1-b9ec-2bd3af368658",
                                                "sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                                                "text": "„Eine ovale Photographie erklärte, daß es einmal einen jungen Kanonier Jepsen gegeben hatte, der neben einer leichten Haubitze kniete wie vor einem Altar, derselbe Kanonier trug in Galizien einen Mantel und sang mit anderen Kanonieren einen Weihnachtsbaum an.“"
                                            },
                                            {
                                                "example_id": "8fd9cbb5-b6e7-432c-ac21-55e058e291c3",
                                                "sense_id": "041f8027-e9c0-3e87-91ae-6df333f71343",
                                                "text": "„Im selben Augenblick krachten die Haubitzen der Serben, und etwa hundert Schritte vor uns ging ein Sprühregen von Schrapnellkugeln nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b244f0a-68e7-46aa-931f-a321db492222",
                        "source_entry_id": "b660cb80-16e4-35cb-a02b-9dff89fb16f4",
