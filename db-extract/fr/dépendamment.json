                                "target_senses": [
                                    {
                                        "sense_id": "06e3af10-39d8-321b-aedf-8c5563f9d9d2",
                                        "entry_id": "3840aa5e-8aec-38e3-8ece-ba54e26a1b02",
                                        "glosses": [
                                            "Suspended or hanging from another element, such as a shield, helmet, crest, or a badge hanging from a chain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5392f22-88d5-4bdb-b974-f1a40fc2d61a",
                                                "sense_id": "06e3af10-39d8-321b-aedf-8c5563f9d9d2",
                                                "text": "Behind the shield are placed in saltire two batons representing that belonging to his office, and round the shield is placed a gold collar of SS, and a triple chain also of gold, and depending from it the proper badge of Lyon King of Arms."
                                            }
                                        ]
                                    }
