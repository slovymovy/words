                ],
                "senses": [
                    {
                        "sense_id": "780f47c9-41ae-385c-8a5a-779e5758b2bc",
                        "entry_id": "2be093cb-9c5f-303c-a59d-5366828c8fd0",
                        "glosses": [
                            "der Vormittag eines Sonntages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46e81ad1-f9ea-4a09-8a0d-208df9270f40",
                                "sense_id": "780f47c9-41ae-385c-8a5a-779e5758b2bc",
                                "text": "Sonntagvormittag geht Claudia ihre Sünden beichten."
                            },
                            {
                                "example_id": "13a09ec6-7f22-4d99-b979-1db745b506b3",
                                "sense_id": "780f47c9-41ae-385c-8a5a-779e5758b2bc",
                                "text": "An Sonntagvormittagen kann man in Ruhe im Bett frühstücken."
                            },
                            {
                                "example_id": "095bab4c-fd45-4801-a35d-f3ef3d6ebea6",
                                "sense_id": "780f47c9-41ae-385c-8a5a-779e5758b2bc",
                                "text": "„Für mich jedoch, der erst kürzlich seine medizinisch notwendigen Gehhilfen in die Ecke stellen konnte, ist der an diesem Sonntagvormittag erworbene Ebenholzstock mehr als nur ein modisches Accessoire, sondern eine elegante Zwischenlösung auf dem Weg zur vollständigen Bewegungsfreiheit.“"
                            },
                            {
                                "example_id": "810c8582-a05d-4341-89d4-99e7bf88e397",
                                "sense_id": "780f47c9-41ae-385c-8a5a-779e5758b2bc",
                                "text": "„Am Sonntagvormittag seien sie beide rundum erholt dort vorgefahren.“"
                            },
                            {
                                "example_id": "e5c8cf9a-673c-4754-80c0-9c61428a3042",
                                "sense_id": "780f47c9-41ae-385c-8a5a-779e5758b2bc",
                                "text": "„Rotwein an einem sonnigen Sonntagvormittag mit einem lange vermissten Freund, so soll man leben, sagte sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
