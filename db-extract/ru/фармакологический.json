                                                "example_id": "b26c0831-f70f-4742-b987-0fd62944cdaa",
                                                "sense_id": "6398fda8-47e3-3d0a-af0f-f3b423d555df",
                                                "text": "Le traitement hygiéno-diététique de l’ulcère gastroduodénal a été balayé par le traitement pharmacologique."
                                            },
