                ],
                "senses": [
                    {
                        "sense_id": "341e5df9-b05a-3529-bac7-02bbf2fb93a0",
                        "entry_id": "f3668987-935c-374a-a384-9a323a762d7c",
                        "glosses": [
                            "Qui contient des cailloux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a620057-969c-4f65-92fd-eb5e710929d4",
                                "sense_id": "341e5df9-b05a-3529-bac7-02bbf2fb93a0",
                                "text": "Cette rue, maintenant peu fréquentée, chaude en été, froide en hiver, obscure en quelques endroits, est remarquable par la sonorité de son petit pavé caillouteux."
                            },
                            {
                                "example_id": "282ee9ac-25c5-4a32-92e9-5971e5152c47",
                                "sense_id": "341e5df9-b05a-3529-bac7-02bbf2fb93a0",
                                "text": "Cette nappe caillouteuse à sa base, présente en couverture un dépôt limoneux brun, argileux, fortement oxydé […]."
                            },
                            {
                                "example_id": "9f138b34-a514-4216-98ee-d4548f11a6b7",
                                "sense_id": "341e5df9-b05a-3529-bac7-02bbf2fb93a0",
                                "text": "Seuls, dans un des versants caillouteux de la forêt, deux ou trois vieux hêtres accusaient, par quelques feuilles roussies prématurément, l’arrivée prochaine de l’automne et la mort de l’été."
                            }
                        ]
                    },
                    {
                        "sense_id": "16a92310-a052-3d83-9114-c35efd0fee42",
                        "entry_id": "f3668987-935c-374a-a384-9a323a762d7c",
                        "glosses": [
                            "Qualifie un style littéraire ou musical manquant d’harmonie, de fluidité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4fe16c65-fa4f-46e3-af93-36f2c5234d78",
                                "sense_id": "16a92310-a052-3d83-9114-c35efd0fee42",
                                "text": "Développer une prose caillouteuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e05af59-3174-3953-81cd-81bb58738b32",
                        "entry_id": "f3668987-935c-374a-a384-9a323a762d7c",
                        "glosses": [
                            "Qui est d'une rudesse désagréable"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "eb883fe4-276e-433a-ac96-9b73c0ccd384",
                                "sense_id": "7e05af59-3174-3953-81cd-81bb58738b32",
                                "text": "Figure-toi l’imagination la plus vagabonde, le cœur le plus amoureux, l’âme la plus tendre, l’esprit le plus poétique, sans cesse en présence de l’homme le plus caillouteux le plus atrabilaire."
                            },
                            {
                                "example_id": "ba7d0c46-d99f-4b29-9a0d-1cee182c068d",
                                "sense_id": "7e05af59-3174-3953-81cd-81bb58738b32",
                                "text": "Au moment où le docteur entrait, le malade, à demi dressé dans son lit, se renversait en arrière pour tenter de retrouver son souffle caillouteux de vieil asthmatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78fbab05-4871-42a9-8765-ed86d525ef70",
                        "source_entry_id": "f3668987-935c-374a-a384-9a323a762d7c",
                        "source_sense_description": "Qui contient des cailloux",
