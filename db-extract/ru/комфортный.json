                                "target_word": "pohodlný",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "871c4a9f-40ca-35e3-b60d-b00d78fa5b6b",
                                        "entry_id": "3b4239f9-e38b-3369-8da7-3851a5e4f346",
                                        "glosses": [
                                            "fyzicky příjemný k sezení, ležení či jinému delšímu pobytu; poskytující pohodlí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be61e9c-f9e8-4dec-9ed5-2143603f3c8e",
                                                "sense_id": "871c4a9f-40ca-35e3-b60d-b00d78fa5b6b",
                                                "text": "Tento gauč je velmi pohodlný, člověk by na něm hned usnul."
                                            },
                                            {
                                                "example_id": "da35e7fb-269c-493a-b3ad-c28d2c3a6cc1",
                                                "sense_id": "871c4a9f-40ca-35e3-b60d-b00d78fa5b6b",
                                                "text": "Stařičký lékař ovšem podivil se nemálo, spatřiv před sebou tak malou poslici, ale ještě více užasl, když na místě pohodlných saní uviděl státi venku před domem malé dětské sáňky a u nich na místě bujných vraníků mne — Miloše, k odjezdu již připraveného!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d717c290-45b7-386d-b7b6-e18b65f4faec",
                                        "entry_id": "3b4239f9-e38b-3369-8da7-3851a5e4f346",
                                        "glosses": [
                                            "takový, který neobnáší žádnou či jen minimální námahu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f041b898-0bf4-476f-9e77-3340073b7081",
                                                "sense_id": "d717c290-45b7-386d-b7b6-e18b65f4faec",
                                                "text": "Často by si byl arci zoufal, přirovnal-li tento svůj život ke mládí svému a pohodlnému živobytí ve vlast."
                                            },
                                            {
                                                "example_id": "14c04074-e3b0-4f3c-a2ef-2f1574bbf6b7",
                                                "sense_id": "d717c290-45b7-386d-b7b6-e18b65f4faec",
                                                "text": "Prostě tam nejít – no to jste uhodla, to by bylo příliš pohodlné řešení."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee86be24-2143-36e3-b775-5244fb43e39c",
                                        "entry_id": "3b4239f9-e38b-3369-8da7-3851a5e4f346",
                                        "glosses": [
                                            "takový, který se nerad namáhá či který se vyhýbá námaze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f882e0-e590-49b8-bfea-c353d96f5f7f",
                                                "sense_id": "ee86be24-2143-36e3-b775-5244fb43e39c",
                                                "text": "Dnes už se nikomu nechce opracovat pořádně kus pazourku, to je to! Pohodlní jsou! To se ví, takový koštěný hrot je udělán jedna dvě, ale taky se ti každou chvíli zlomí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
