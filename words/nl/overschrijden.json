    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2647dd7-5562-3bf4-9170-1599c2c9b7d6",
                    "sense_definition": "Voorbij een bepaalde limiet, hoeveelheid, norm of regel gaan.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "exceed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kosten voor de verbouwing zullen het budget waarschijnlijk <w>overschrijden</w>.",
                            "target_lang_translations": {
                                "en": "The renovation costs will probably <w>exceed</w> the budget.",
                                "ru": "Расходы на ремонт, вероятно, <w>превысят</w> бюджет.",
                                "fr": "Les coûts de la rénovation vont probablement <w>dépasser</w> le budget."
                            }
                        },
                        {
                            "text": "De automobilist werd beboet omdat hij de maximumsnelheid had <w>overschreden</w>.",
                            "target_lang_translations": {
                                "en": "The driver was fined because he had <w>exceeded</w> the speed limit.",
                                "ru": "Водителя оштрафовали, так как он <w>превысил</w> скорость.",
                                "fr": "L'automobiliste a été verbalisé parce qu'il avait <w>dépassé</w> la vitesse maximale autorisée."
                            }
                        }
                    ],
                    "synonyms": [
                        "overtreffen",
                        "te boven gaan"
                    ],
                    "antonyms": [
                        "onderschrijden"
                    ],
                    "common_phrases": [
                        "het budget overschrijden",
                        "de limiet overschrijden",
                        "zijn bevoegdheid overschrijden",
                        "de maximumsnelheid overschrijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To go beyond a certain limit, amount, standard, or rule.",
                        "ru": "Выходить за пределы определенного лимита, количества, нормы или правила.",
                        "fr": "Aller au-delà d'une certaine limite, quantité, norme ou règle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exceed",
                                "target_lang_sense_clarification": "a limit, number, or rule"
                            },
                            {
                                "target_lang_word": "go beyond",
                                "target_lang_sense_clarification": "a limit or authority"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "превышать",
                                "target_lang_sense_clarification": "лимит, скорость или полномочия"
                            },
                            {
                                "target_lang_word": "выходить за",
                                "target_lang_sense_clarification": "рамки или пределы"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "dépasser",
                                "target_lang_sense_clarification": "une limite, une quantité ou une vitesse"
                            },
                            {
                                "target_lang_word": "excéder",
                                "target_lang_sense_clarification": "une limite, un budget ou un pouvoir"
                            },
                            {
                                "target_lang_word": "outrepasser",
                                "target_lang_sense_clarification": "une règle, une autorité ou des droits"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84fd740c-d633-3aaa-9ba5-2e20213eabb9",
                    "sense_definition": "Fysiek over een lijn, grens of markering heen stappen of rijden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cross_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vluchtelingen <w>overschreden</w> gisternacht te voet de grens.",
                            "target_lang_translations": {
                                "en": "The refugees <w>crossed</w> the border on foot last night.",
                                "ru": "Прошлой ночью беженцы пешком <w>пересекли</w> границу.",
                                "fr": "Les réfugiés ont <w>franchi</w> la frontière à pied la nuit dernière."
                            }
                        },
                        {
                            "text": "Voor uw eigen veiligheid mag u de gele lijn op het perron niet <w>overschrijden</w>.",
                            "target_lang_translations": {
                                "en": "For your own safety, you must not <w>cross</w> the yellow line on the platform.",
                                "ru": "Ради вашей безопасности вы не должны <w>пересекать</w> желтую линию на платформе.",
                                "fr": "Pour votre propre sécurité, vous ne devez pas <w>franchir</w> la ligne jaune sur le quai."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de grens overschrijden",
                        "een lijn overschrijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically step or drive across a line, border, or marker.",
                        "ru": "Физически переступать или переезжать через линию, границу или разметку.",
                        "fr": "Franchir physiquement une ligne, une frontière ou un marquage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "a physical line or border"
                            },
                            {
                                "target_lang_word": "step over",
                                "target_lang_sense_clarification": "a line or marking"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пересекать",
                                "target_lang_sense_clarification": "границу или линию"
                            },
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "через линию или границу"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "franchir",
                                "target_lang_sense_clarification": "une ligne, une frontière ou un obstacle"
                            },
                            {
                                "target_lang_word": "traverser",
                                "target_lang_sense_clarification": "une frontière ou une zone délimitée"
                            }
                        ]
                    }
                }
