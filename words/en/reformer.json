{
    "word_family": [
        "reform",
        "reformation",
        "reformatory",
        "reformative",
        "reformism",
        "reformist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dacb4e8e-d1f4-31b6-a424-a13df99c6248",
                    "sense_definition": "A person who works to improve or change a system, law, or society.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reformer</w> campaigned tirelessly for better education laws in the country.",
                            "target_lang_translations": {
                                "zh": "这位<w>改革者</w>为国家能有更好的教育法而不懈奔走。"
                            }
                        },
                        {
                            "text": "Many people viewed the new leader as a bold <w>reformer</w> who would fix the economy.",
                            "target_lang_translations": {
                                "zh": "许多人认为这位新领导人是一位能重振经济的大胆<w>改革者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "activist",
                        "advocate",
                        "campaigner"
                    ],
                    "antonyms": [
                        "traditionalist"
                    ],
                    "common_phrases": [
                        "social reformer",
                        "political reformer"
                    ],
                    "target_lang_definitions": {
                        "zh": "致力于改善或改变制度、法律或社会的个人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "改革者",
                                "target_lang_sense_clarification": "指推动社会或政治变革的人。"
                            },
                            {
                                "target_lang_word": "改良者",
                                "target_lang_sense_clarification": "指主张通过渐进方式进行改革的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69025532-3cdf-383b-afea-cc3e8f766865",
                    "sense_definition": "A person who participated in the Protestant Reformation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Martin Luther was a prominent <w>reformer</w> who challenged the practices of the church.",
                            "target_lang_translations": {
                                "zh": "马丁·路德是一位挑战教会习俗的杰出<w>宗教改革家</w>。"
                            }
                        },
                        {
                            "text": "The writings of the early <w>reformer</w> changed the course of European history.",
                            "target_lang_translations": {
                                "zh": "早期<w>宗教改革家</w>的著作改变了欧洲历史的进程。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "参与宗教改革运动的个人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宗教改革家",
                                "target_lang_sense_clarification": "特指欧洲宗教改革时期的领袖或参与者。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc6a1e04-0c52-34d5-9c88-641a5dbbb00e",
                    "sense_definition": "A device that converts hydrocarbons into a gas mixture rich in hydrogen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fuel <w>reformer</w> is essential for the efficient operation of the hydrogen fuel cell.",
                            "target_lang_translations": {
                                "zh": "燃料<w>重整器</w>对于氢燃料电池的高效运行至关重要。"
                            }
                        },
                        {
                            "text": "Engineers tested the new <w>reformer</w> to see if it could increase hydrogen output.",
                            "target_lang_translations": {
                                "zh": "工程师们测试了新型<w>重整器</w>，以观察其能否提高产氢量。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fuel reformer"
                    ],
                    "target_lang_definitions": {
                        "zh": "将碳氢化合物转化为富氢气体混合物的装置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重整器",
                                "target_lang_sense_clarification": "化工领域中用于改变分子结构的设备。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "493355ea-8146-3eaa-a646-eb4a1f652b8b",
                    "sense_definition": "A piece of industrial equipment used to upgrade low-octane petroleum products.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refinery installed a new continuous <w>reformer</w> to improve gasoline quality.",
                            "target_lang_translations": {
                                "zh": "炼油厂安装了一台新的连续<w>重整装置</w>以提升汽油质量。"
                            }
                        },
                        {
                            "text": "Operators monitor the <w>reformer</w> to ensure the chemical reaction remains stable.",
                            "target_lang_translations": {
                                "zh": "操作员监控着<w>重整装置</w>，以确保化学反应保持稳定。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "continuous reformer"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于提升低辛烷值石油产品质量的工业设备。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重整装置",
                                "target_lang_sense_clarification": "炼油厂中用于提高汽油辛烷值的设备。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "924b9337-b9de-36fb-bf05-238be0106b93",
                    "sense_definition": "A person who participated in the Protestant Reformation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Reformers</w> sought to restore what they saw as the original Christian faith.",
                            "target_lang_translations": {
                                "zh": "<w>宗教改革派</w>试图恢复他们所认为的原始基督教信仰。"
                            }
                        },
                        {
                            "text": "Many <w>Reformers</w> faced significant persecution for their religious beliefs.",
                            "target_lang_translations": {
                                "zh": "许多<w>宗教改革派</w>因其宗教信仰而面临严重的迫害。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "参与宗教改革运动的群体成员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宗教改革派",
                                "target_lang_sense_clarification": "指宗教改革运动中的支持者或成员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f99d8a4-9017-3cbc-998d-270752a31508",
                    "sense_definition": "A member of the Reform movement in 19th-century Canada.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Reformers</w> pushed for responsible government in the Canadian colonies.",
                            "target_lang_translations": {
                                "zh": "<w>改革派成员</w>在加拿大各殖民地推动建立负责任的政府。"
                            }
                        },
                        {
                            "text": "William Lyon Mackenzie was a key leader among the Canadian <w>Reformers</w>.",
                            "target_lang_translations": {
                                "zh": "威廉·里昂·麦肯齐是加拿大<w>改革派成员</w>中的一位关键领袖。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "19世纪加拿大改革运动的成员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "改革派成员",
                                "target_lang_sense_clarification": "指加拿大历史上的改革运动参与者。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "931d7856-762e-3ef3-9cfc-7f65c956ac4a",
                    "sense_definition": "A member of the Reform Party of Canada, active from 1987 to 2000.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Reformers</w> gained significant support in Western Canada during the 1990s.",
                            "target_lang_translations": {
                                "zh": "20世纪90年代，<w>改革党人</w>在加拿大西部获得了广泛支持。"
                            }
                        },
                        {
                            "text": "Many former <w>Reformers</w> eventually joined the new Conservative Party.",
                            "target_lang_translations": {
                                "zh": "许多前<w>改革党人</w>最终加入了新的保守党。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "加拿大改革党的成员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "改革党人",
                                "target_lang_sense_clarification": "指加拿大改革党的党员或支持者。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c0e160c-2655-31a2-8882-dd44e935b0b1",
                    "sense_definition": "A supporter of the political party Reform UK.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "political",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Reformers</w> campaigned on a platform of significant changes to immigration policy.",
                            "target_lang_translations": {
                                "zh": "<w>改革党支持者</w>以大幅改变移民政策为纲领进行竞选。"
                            }
                        },
                        {
                            "text": "Political analysts are watching to see how many votes the <w>Reformers</w> will secure.",
                            "target_lang_translations": {
                                "zh": "政治分析人士正在观察<w>改革党支持者</w>最终能获得多少选票。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "英国改革党的支持者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "改革党支持者",
                                "target_lang_sense_clarification": "指英国现代政治中改革党的追随者。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}