                        "glosses": [
                            "Remettre sous l’influence de l’Otan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5298cf9a-7a83-49d0-8809-2aae569e2004",
                                "sense_id": "e18f10c3-c0b6-30e4-8866-98af563250c3",
                                "text": "Dissensions entre pays d’Europe de l’Est appartenant à l’ex-URSS, absence de traçabilité des fonds occidentaux versés aux Ukrainiens, corruption et trafics de l’armement offert à l’Ukraine dans le monde, Eric Denecé revient également sur les ambitions américaines dans une Europe réotanisée."
                            },
                            {
                                "example_id": "3afc57e0-5fe7-4710-8659-cdbb17ae9547",
                                "sense_id": "e18f10c3-c0b6-30e4-8866-98af563250c3",
                                "text": "Et puis cela nous conduirait fatalement, nous Français, à nous « réotaniser », ce qui serait détestable."
                            }
                        ]
                    }
