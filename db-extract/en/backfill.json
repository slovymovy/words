                        "entry_id": "4794fe06-a666-3656-a0ee-7bf5c8f23aa7",
                        "glosses": [
                            "To refill a hole with the material dug out of it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63073f0e-3edc-492b-becb-9f3c96c44728",
                                "sense_id": "34e46ff8-e9de-3474-85e2-783da29a5d4f",
                                "text": "Clay excavated for the new river channel has been used to backfill the old watercourse, while embankment vegetation was also moved from the old channel to the new in order to preserve a habitat for the rare Four Spotted Moths that live there."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2425db9-8dc3-31d0-b35b-db05394593a2",
                        "entry_id": "4794fe06-a666-3656-a0ee-7bf5c8f23aa7",
                        "glosses": [
                            "To refill an excavation unit to restore the former ground surface and/or to preserve the unit and make it recognizable as having been excavated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa199e9f-019c-4226-80f2-b60d23c978d2",
                                "sense_id": "d2425db9-8dc3-31d0-b35b-db05394593a2",
                                "text": "We backfilled the cistern with pea gravel to discourage its use as a refuse container."
                            }
                        ]
                    },
                    {
                        "sense_id": "6edcc758-d1a5-32af-a842-57e7e89bbbdc",
