                                                "example_id": "ded65d29-d820-4d5d-a379-e33207e32dcd",
                                                "sense_id": "a5c1f79f-5d62-3f1a-a059-299824c01b01",
                                                "text": "Das wilde Parken der Autos hatte Geldstrafen zur Folge."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "db5e7796-e821-3613-a978-8527377a3ff9",
                                        "entry_id": "a98bcbd3-e123-3650-9ea8-5c6ab31221bf",
                                        "glosses": [
                                            "mit wenig Selbstbeherrschung, ohne Selbstkontrolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debd80aa-f8ff-43f0-bd2e-aae4b4cdcd61",
                                                "sense_id": "db5e7796-e821-3613-a978-8527377a3ff9",
                                                "text": "Er fuhr sich wild durch die Haare."
                                            },
                                            {
                                                "example_id": "eba2a722-cb43-4e38-8c1c-042861c6755f",
                                                "sense_id": "db5e7796-e821-3613-a978-8527377a3ff9",
                                                "text": "Zwischen den beiden kam es zu einem wilden Kampf."
                                            },
                                            {
                                                "example_id": "0385f741-be82-46d4-93f4-abbe1f5b6a0c",
                                                "sense_id": "db5e7796-e821-3613-a978-8527377a3ff9",
                                                "text": "Der wilde Junge schlug um sich."
                                            },
                                            {
                                                "example_id": "f33fcd72-0133-4a84-bdc7-578b567d88a4",
                                                "sense_id": "db5e7796-e821-3613-a978-8527377a3ff9",
                                                "text": "Sein Herz klopft wild."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c8f0c7a6-d231-375f-9a67-96ab4933fe97",
                                        "entry_id": "a98bcbd3-e123-3650-9ea8-5c6ab31221bf",
                                        "glosses": [
                                            "voller Wut, Erregung oder Anspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
