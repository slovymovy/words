                        "sense_id": "4c62dc27-dc97-33e3-8f43-6a8bdf61d6a7",
                        "entry_id": "3d0bb7f5-4c54-3773-b792-766a522ead32",
                        "glosses": [
                            "Shocked, horrified by something unpleasant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77c9b5d2-f78e-499a-b7b8-c907cd268362",
                                "sense_id": "4c62dc27-dc97-33e3-8f43-6a8bdf61d6a7",
                                "text": "But the purported rise in violent videos online has led some MPs to campaign for courts to have more power to remove or block material on YouTube. The Labour MP Heidi Alexander said she was appalled after a constituent was robbed at knifepoint, and the attackers could be found brandishing weapons and rapping about gang violence online."
                            },
                            {
                                "example_id": "3b7c5a7f-684c-4457-81f1-b32bca95ec9b",
                                "sense_id": "4c62dc27-dc97-33e3-8f43-6a8bdf61d6a7",
                                "text": "West's friends were so appalled by the nature of his death that they arranged for a wooden memorial in the churchyard of St Laurence's, constructed aptly from a railway sleeper."
                            }
                        ]
                    }
                ],
