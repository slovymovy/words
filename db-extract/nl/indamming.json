                    {
                        "sense_id": "64ba8546-98d8-31dd-881b-bfc90674bfe4",
                        "entry_id": "be5a2aa6-6b77-3ab7-ae90-41d25a2da567",
                        "glosses": [
                            "van een water of een stuk land dat het door een dam is afgegrensd van een water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a91a29b1-bf0a-4d14-ab50-c6130bae2d31",
                                "sense_id": "64ba8546-98d8-31dd-881b-bfc90674bfe4",
                                "text": "Het Veerse Meer, onstaan door indamming voor de Deltawerken, is populair bij zeilers, sportvissers en sportduikers. Het meer is 22 kilometer lang. De breedte varieert van 150 tot 1500 meter."
                            }
                        ]
                    },
                    {
                        "sense_id": "52acb8a9-ce4a-3b20-a3f4-d42f27534010",
                        "entry_id": "be5a2aa6-6b77-3ab7-ae90-41d25a2da567",
                        "glosses": [
                            "het begrenzen van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc92914-975e-4ad6-9ded-ec26e2bd2e28",
                                "sense_id": "52acb8a9-ce4a-3b20-a3f4-d42f27534010",
                                "text": "Het kabinet heeft niet de intentie om te bezuinigen op de wijkverpleging tijdens het maken van afspraken met de zorgwereld over indamming van de stijgende kosten. Dat heeft premier Rutte gezegd."
                            },
                            {
                                "example_id": "ad440299-05cf-40c2-aeff-31d84f231071",
                                "sense_id": "52acb8a9-ce4a-3b20-a3f4-d42f27534010",
                                "text": "De leiders van de eurolanden komen op 2 maart in Brussel bijeen voor een speciale eurotop, waarbij de indamming van de schuldencrisis centraal staat. De top vindt plaats tijdens de lunch op de tweede dag van de gewone top van de leiders van de 27 EU-lidstaten."
                            },
                            {
                                "example_id": "0274b5d8-1a72-4d3b-a061-ecda3ba2052d",
                                "sense_id": "52acb8a9-ce4a-3b20-a3f4-d42f27534010",
                                "text": "Het Maasstad Ziekenhuis in Rotterdam heeft regels voor de indamming van infecties genegeerd. Daardoor kon de uitbraak van de resistente Klebsiella-bacterie voortwoekeren."
                            }
                        ]
                    }
                ],
