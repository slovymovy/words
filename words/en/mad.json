            "senses": [
                {
                    "sense_id": "d1fdfaed-35ef-3b4c-b216-0fd517912534",
                    "sense_definition": "To a large degree; extremely or very.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>mad</w> hot outside today.",
                            "target_lang_translations": {
                                "ru": "Сегодня на улице <w>дико</w> жарко.",
                                "zh": "今天外面<w>特别</w>热。"
                            }
                        },
                        {
                            "text": "That movie was <w>mad</w> funny.",
                            "target_lang_translations": {
                                "ru": "Тот фильм был <w>жутко</w> смешным.",
                                "zh": "那部电影<w>特别</w>好笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hella",
                        "wicked"
                    ],
                    "common_phrases": [
                        "mad cool",
                        "mad funny"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В значительной степени; чрезвычайно или очень.",
                        "zh": "在很大程度上；非常，特别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дико",
                                "target_lang_sense_clarification": "сленг: очень сильно"
                            },
                            {
                                "target_lang_word": "жутко",
                                "target_lang_sense_clarification": "разговорное: чрезвычайно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特别",
