                "senses": [
                    {
                        "sense_id": "f12ca30d-c3ab-361f-a972-e7e92c284acd",
                        "entry_id": "26a6e8aa-2d46-3ba7-b09f-439b80276b60",
                        "glosses": [
                            "berittener Hirte der südamerikanischen Pampas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3e579d-75ac-40da-a83d-b0d4741b71c6",
                                "sense_id": "f12ca30d-c3ab-361f-a972-e7e92c284acd",
                                "text": "Der aussterbende Gaucho ist ein Symbol der argentinischen Lebensweise."
                            },
                            {
                                "example_id": "f8323723-1736-4806-9f21-d84141f74b2a",
                                "sense_id": "f12ca30d-c3ab-361f-a972-e7e92c284acd",
                                "text": "Die Gauchos der Pampas sind ein wildes Volk."
                            },
                            {
                                "example_id": "76558d9c-0b19-41f2-9391-ea2126e943c0",
                                "sense_id": "f12ca30d-c3ab-361f-a972-e7e92c284acd",
                                "text": "„Gauchos ritten ein Stück mit, bogen ab und klatschten die Lassos durch die Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
