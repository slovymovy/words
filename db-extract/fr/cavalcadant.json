                "senses": [
                    {
                        "sense_id": "11e17c16-6613-355f-addd-d7b8f1d537ce",
                        "entry_id": "ae9b2d08-8351-3ae4-a392-b818f2dba831",
                        "glosses": [
                            "Qui cavalcade."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e4bc062f-2f5a-41a1-b1eb-27a7d158fef0",
                                "sense_id": "11e17c16-6613-355f-addd-d7b8f1d537ce",
                                "text": "Satan poussait dans les feux de la lubricité cavalcadante et dévorante ses troupeaux de nonnes charnues et de moines ityphalliques, gymnasiarques de l'amour et virtuoses des accouplements monstrueux."
                            },
                            {
                                "example_id": "469fd99d-32bb-4987-8362-8ce2ec81bb96",
                                "sense_id": "11e17c16-6613-355f-addd-d7b8f1d537ce",
                                "text": "Aussitôt le travail clos, et nulle Aline ne le pouvait plus retenir, il rentrait chez lui au galop, se muant, dans les couloirs du métro, en banlieusard cavalcadant."
                            },
                            {
                                "example_id": "5693e761-c6f1-4a4e-85d0-ed782392646e",
                                "sense_id": "11e17c16-6613-355f-addd-d7b8f1d537ce",
                                "text": "Une vision fugitive de fellation gothique dans un long-métrage de cape et d’épée, tapis au fond d’un cinéac de Nice, turlute médiévale pratiquée furtivement sur un souverain couronné par un jeune page poudré et contrefait, dans un film d’aventures cavalcadantes de heaumes et de boucliers, sans doute inspiré des épisodes d’“Ivanhoé” ou de “Quentin Durward”."
                            }
                        ]
                    }
