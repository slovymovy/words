{
    "word_family": [
        "conglomeration",
        "conglomerate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "237286ab-9f6f-31a9-ac93-adfd89ff8a64",
                    "sense_definition": "A large corporation formed by the merger of several smaller companies that operate in different, unrelated industries.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive <w>conglomerate</w> owns everything from television stations to food processing plants.",
                            "target_lang_translations": {
                                "zh": "这家庞大的<w>企业集团</w>拥有从电视台到食品加工厂的各种产业。"
                            }
                        },
                        {
                            "text": "Many investors prefer to buy shares in a diversified <w>conglomerate</w> to reduce their financial risk.",
                            "target_lang_translations": {
                                "zh": "许多投资者更愿意购买多元化<w>企业集团</w>的股票，以降低财务风险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "holding company"
                    ],
                    "common_phrases": [
                        "financial conglomerate",
                        "media conglomerate"
                    ],
                    "target_lang_definitions": {
                        "zh": "由多个在不同且互不相关的行业中经营的小公司合并而成的大型企业。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "企业集团",
                                "target_lang_sense_clarification": "指跨行业经营的大型综合性公司。"
                            },
                            {
                                "target_lang_word": "联合企业",
                                "target_lang_sense_clarification": "指通过合并形成的多元化大型公司。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cd034d0-4fbe-350b-b855-b26f874f8b32",
                    "sense_definition": "A type of sedimentary rock composed of rounded gravel or pebbles cemented together in a finer matrix.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cliff face was composed of a hard <w>conglomerate</w> that had formed over millions of years.",
                            "target_lang_translations": {
                                "zh": "悬崖表面由经过数百万年形成的坚硬<w>砾岩</w>组成。"
                            }
                        },
                        {
                            "text": "Geologists identified the <w>conglomerate</w> beds as evidence of an ancient river system.",
                            "target_lang_translations": {
                                "zh": "地质学家将这些<w>砾岩</w>层认定为古代河流系统的证据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pudding-stone"
                    ],
                    "common_phrases": [
                        "basal conglomerate"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由圆形砾石或卵石在较细的基质中胶结而成的沉积岩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砾岩",
                                "target_lang_sense_clarification": "地质学中指由砾石胶结而成的岩石。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "462e0874-98ef-3cd4-a16a-29a9158f8479",
                    "sense_definition": "A collection or cluster of various different things gathered together into a single mass.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is a strange <w>conglomerate</w> of modern skyscrapers and ancient stone ruins.",
                            "target_lang_translations": {
                                "zh": "这座城市是一个由现代摩天大楼和古老石制遗迹组成的奇特<w>混合体</w>。"
                            }
                        },
                        {
                            "text": "His speech was a messy <w>conglomerate</w> of half-formed ideas and borrowed quotes.",
                            "target_lang_translations": {
                                "zh": "他的演讲是一堆由不成熟的想法和引用的名言组成的混乱<w>混合体</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amalgam",
                        "mixture",
                        "collection"
                    ],
                    "target_lang_definitions": {
                        "zh": "将各种不同事物聚集在一起形成的集合体或混合物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "混合体",
                                "target_lang_sense_clarification": "指多种事物混杂在一起的集合。"
                            },
                            {
                                "target_lang_word": "聚集体",
                                "target_lang_sense_clarification": "指由不同部分汇聚而成的整体。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "262a1ec6-ff9d-3056-91c4-25281d2d366b",
                    "sense_definition": "To gather or combine various parts into a single, larger mass or body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark clouds began to <w>conglomerate</w> above the mountains, signaling an approaching storm.",
                            "target_lang_translations": {
                                "zh": "乌云开始在山顶上<w>聚集</w>，预示着暴风雨即将来临。"
                            }
                        },
                        {
                            "text": "The author managed to <w>conglomerate</w> several historical myths into one compelling narrative.",
                            "target_lang_translations": {
                                "zh": "作者成功地将几个历史神话<w>合并</w>成了一个引人入胜的故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amalgamate",
                        "cluster",
                        "aggregate"
                    ],
                    "antonyms": [
                        "disperse",
                        "separate"
                    ],
                    "target_lang_definitions": {
                        "zh": "将不同的部分聚集或结合成一个更大的整体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "聚集",
                                "target_lang_sense_clarification": "指事物汇集在一起。"
                            },
                            {
                                "target_lang_word": "合并",
                                "target_lang_sense_clarification": "指将多个部分结合成一个整体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7451c72e-7bfe-3c35-b7f5-2b5513ef0253",
                    "sense_definition": "To merge multiple companies into a single large corporation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "business_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tech giant continued to <w>conglomerate</w> smaller startups to expand its market reach.",
                            "target_lang_translations": {
                                "zh": "这家科技巨头继续<w>兼并</w>小型初创公司以扩大其市场份额。"
                            }
                        },
                        {
                            "text": "Industries often <w>conglomerate</w> during periods of rapid economic growth.",
                            "target_lang_translations": {
                                "zh": "在经济快速增长时期，各行业往往会发生<w>兼并</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "merge",
                        "consolidate"
                    ],
                    "target_lang_definitions": {
                        "zh": "将多家公司合并成一家大型企业。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兼并",
                                "target_lang_sense_clarification": "指企业间的合并与收购行为。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73326e19-9eb7-36a2-8740-a4aac0bbf4f4",
                    "sense_definition": "Consisting of various rock fragments or pebbles cemented together.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers walked across the rough <w>conglomerate</w> surface of the canyon floor.",
                            "target_lang_translations": {
                                "zh": "徒步旅行者走在峡谷底部粗糙的<w>砾岩</w>表面上。"
                            }
                        },
                        {
                            "text": "We found several <w>conglomerate</w> rocks along the riverbank after the heavy rain.",
                            "target_lang_translations": {
                                "zh": "大雨过后，我们在河岸边发现了好几块<w>砾岩</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "conglomerate rock"
                    ],
                    "target_lang_definitions": {
                        "zh": "由各种岩石碎片或卵石胶结而成的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砾岩的",
                                "target_lang_sense_clarification": "形容由砾岩构成的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb7fea73-f09b-391b-b7e1-28c58eb13cd7",
                    "sense_definition": "Gathered or clustered together into a dense mass.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conglomerate</w> mass of cells began to divide rapidly during the experiment.",
                            "target_lang_translations": {
                                "zh": "在实验过程中，那团<w>聚集的</w>细胞团开始迅速分裂。"
                            }
                        },
                        {
                            "text": "Small, <w>conglomerate</w> groups of protesters gathered in the main square.",
                            "target_lang_translations": {
                                "zh": "一小群一小群<w>聚集的</w>抗议者在广场上集合。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clustered",
                        "aggregated"
                    ],
                    "antonyms": [
                        "scattered"
                    ],
                    "target_lang_definitions": {
                        "zh": "聚集在一起形成致密的块状。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "聚集的",
                                "target_lang_sense_clarification": "形容事物成团或成块地汇集。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}