                "senses": [
                    {
                        "sense_id": "2f2d22e1-e0b2-3172-869c-76e73d0b904d",
                        "entry_id": "60280833-178d-3dc3-8a77-4dd88b98fcd8",
                        "glosses": [
                            "etwas, das offensichtlich oder möglicherweise die Unversehrtheit / Sicherheit von etwas gefährden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef706747-7ad5-4e0d-9134-68537106c858",
                                "sense_id": "2f2d22e1-e0b2-3172-869c-76e73d0b904d",
                                "text": "Ein nicht zu vernachlässigendes Sicherheitsrisiko ist die Bestechlichkeit der Mitarbeiter."
                            },
                            {
                                "example_id": "5dc3fa2f-696e-4b4c-ac2a-627ad34f8baf",
                                "sense_id": "2f2d22e1-e0b2-3172-869c-76e73d0b904d",
                                "text": "Der Einbau des falschen Ersatzteils kann ein Sicherheitsrisiko für das Leben des Kunden sein."
                            },
                            {
                                "example_id": "d905196f-89d8-42b8-9d79-074893763770",
                                "sense_id": "2f2d22e1-e0b2-3172-869c-76e73d0b904d",
                                "text": "„Er wurde als Sicherheitsrisiko eingestuft und sollte unehrenhaft aus der Bundeswehr entlassen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
