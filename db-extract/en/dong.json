                                        "entry_id": "d97245c1-d273-3784-b7fb-4dadbe5047a7",
                                        "glosses": [
                                            "в Испании и испаноязычных странах — почтительное обращение к мужчине или форма вежливого упоминания о нём"
                                        ],
                                        "tags": [],
