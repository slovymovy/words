{
    "word_family": [
        "fluiten",
        "fluiter",
        "fluit",
        "fluitje"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "09684410-d0c3-3d6e-a1a6-ee2a7a109853",
                    "sense_definition": "Een hoog, sissend of scherp geluid voortbrengend dat lijkt op een fluit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de hevige herfststorm hoorden we de <w>fluitende</w> wind door de kieren van de ramen razen.",
                            "target_lang_translations": {
                                "en": "During the violent autumn storm, we heard the <w>whistling</w> wind raging through the cracks of the windows."
                            }
                        },
                        {
                            "text": "De soldaten zochten snel dekking voor de <w>fluitende</w> kogels die over hun hoofden vlogen.",
                            "target_lang_translations": {
                                "en": "The soldiers quickly took cover from the <w>whizzing</w> bullets flying over their heads."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fluitende kogels",
                        "fluitende wind",
                        "fluitende ketel"
                    ],
                    "target_lang_definitions": {
                        "en": "Producing a high, hissing, or sharp sound resembling a whistle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whistling",
                                "target_lang_sense_clarification": "making a whistling sound (wind, bullets, kettle)"
                            },
                            {
                                "target_lang_word": "whizzing",
                                "target_lang_sense_clarification": "moving rapidly with a whistling or hissing sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3d831da-837f-359d-977c-850ea3c78715",
                    "sense_definition": "Zonder enige moeite of inspanning; heel gemakkelijk en zorgeloos.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gemak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft zich zo goed voorbereid dat ze <w>fluitend</w> voor haar eindexamen is geslaagd.",
                            "target_lang_translations": {
                                "en": "She prepared so well that she passed her final exam <w>with flying colours</w>."
                            }
                        },
                        {
                            "text": "Hij kan die torenhoge boete <w>fluitend</w> betalen met zijn riante salaris.",
                            "target_lang_translations": {
                                "en": "He can <w>easily</w> pay that exorbitant fine with his generous salary."
                            }
                        }
                    ],
                    "synonyms": [
                        "moeiteloos",
                        "gemakkelijk"
                    ],
                    "antonyms": [
                        "moeizaam"
                    ],
                    "common_phrases": [
                        "fluitend door het examen komen",
                        "fluitend naar huis gaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figuurlijk gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Without any difficulty or effort; very easily and breezily."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "with ease",
                                "target_lang_sense_clarification": "effortlessly"
                            },
                            {
                                "target_lang_word": "easily",
                                "target_lang_sense_clarification": "without difficulty"
                            },
                            {
                                "target_lang_word": "with flying colours",
                                "target_lang_sense_clarification": "passing easily and successfully"
                            },
                            {
                                "target_lang_word": "without breaking a sweat",
                                "target_lang_sense_clarification": "effortlessly"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3cbbdd0b-5037-308d-9030-449840ba5b64",
                    "sense_definition": "Onvoltooid deelwoord van <w>fluiten</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman liep <w>fluitend</w> door de werkplaats terwijl hij aan het meubelstuk werkte.",
                            "target_lang_translations": {
                                "en": "The carpenter walked through the workshop <w>whistling</w> while he worked on the piece of furniture."
                            }
                        },
                        {
                            "text": "Zij stond vrolijk <w>fluitend</w> in de keuken het avondeten klaar te maken.",
                            "target_lang_translations": {
                                "en": "She was standing in the kitchen, cheerfully <w>whistling</w> while making dinner."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fluitend op straat lopen",
                        "een liedje fluitend"
                    ],
                    "traits": [
                        {
