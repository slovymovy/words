{
    "word_family": [
        "nonplus",
        "plus-size",
        "surplus"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "45b1acd8-3136-3303-829d-1d3127a3f7a9",
                    "sense_definition": "And; the sum of the previous number and the following one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two <w>plus</w> two equals four.",
                            "target_lang_translations": {
                                "ru": "Два <w>плюс</w> два равно четыре."
                            }
                        },
                        {
                            "text": "A water molecule is made up of two hydrogen atoms <w>plus</w> one of oxygen.",
                            "target_lang_translations": {
                                "ru": "Молекула воды состоит из двух атомов водорода <w>плюс</w> один атом кислорода."
                            }
                        }
                    ],
                    "synonyms": [
                        "and"
                    ],
                    "antonyms": [
                        "minus"
                    ],
                    "common_phrases": [
                        "two plus two"
                    ],
                    "target_lang_definitions": {
                        "ru": "И; сумма предыдущего и последующего чисел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "математическое сложение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d243be61-31a0-3990-a437-4afdca07557e",
                    "sense_definition": "With; having in addition to something else.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I've won a holiday to France <w>plus</w> five hundred euros in spending money!",
                            "target_lang_translations": {
                                "ru": "Я выиграл отпуск во Франции <w>плюс</w> пятьсот евро на расходы!"
                            }
                        },
                        {
                            "text": "The price is fifty dollars <w>plus</w> tax.",
                            "target_lang_translations": {
                                "ru": "Цена составляет пятьдесят долларов <w>плюс</w> налог."
                            }
                        }
                    ],
                    "synonyms": [
                        "and"
                    ],
                    "common_phrases": [
                        "plus tax",
                        "plus shipping"
                    ],
                    "target_lang_definitions": {
                        "ru": "С; имеющий что-либо в дополнение к чему-то другому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "в дополнение к чему-либо"
                            },
                            {
                                "target_lang_word": "и",
                                "target_lang_sense_clarification": "в значении добавления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "80116854-c9e0-3da3-b368-9d2fd471b0f6",
                    "sense_definition": "Being positive rather than negative or zero.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mathematical_sign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The result of the calculation is a <w>plus</w> four.",
                            "target_lang_translations": {
                                "ru": "Результат вычисления — <w>плюс</w> четыре."
                            }
                        },
                        {
                            "text": "The temperature today is <w>plus</w> ten degrees Celsius.",
                            "target_lang_translations": {
                                "ru": "Температура сегодня <w>плюс</w> десять градусов по Цельсию."
                            }
                        }
                    ],
                    "synonyms": [
                        "positive"
                    ],
                    "antonyms": [
                        "minus",
                        "negative"
                    ],
                    "common_phrases": [
                        "plus four",
                        "plus ten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положительный, а не отрицательный или нулевой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "о температуре или числах"
                            },
                            {
                                "target_lang_word": "положительный",
                                "target_lang_sense_clarification": "о значении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "576e4341-7ea3-384e-8954-1bed85ac9e55",
                    "sense_definition": "Equal to or greater than a specific quantity; upwards.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bus can fit sixty <w>plus</w> kids, but we only get forty-eight.",
                            "target_lang_translations": {
                                "ru": "В автобус может поместиться шестьдесят <w>с лишним</w> детей, но у нас только сорок восемь."
                            }
                        },
                        {
                            "text": "He has been working there for twenty <w>plus</w> years.",
                            "target_lang_translations": {
                                "ru": "Он работает там уже двадцать <w>с лишним</w> лет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sixty plus",
                        "twenty plus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Равный или превышающий определенное количество; с лишним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с лишним",
                                "target_lang_sense_clarification": "о количестве"
                            },
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "после числа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a42a78e-d5a8-3bef-a1d6-e405b06a2dc0",
                    "sense_definition": "Positive, or involving an advantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His experience in marketing is a <w>plus</w> factor for this job.",
                            "target_lang_translations": {
                                "ru": "Его опыт в маркетинге является <w>положительным</w> фактором для этой работы."
                            }
                        },
                        {
                            "text": "Having a car is a <w>plus</w> point when living in the countryside.",
                            "target_lang_translations": {
                                "ru": "Наличие машины — это <w>плюс</w>, когда живешь в сельской местности."
                            }
                        }
                    ],
                    "synonyms": [
                        "advantageous",
                        "good",
                        "positive"
                    ],
                    "antonyms": [
                        "bad",
                        "disadvantageous",
                        "negative"
                    ],
                    "common_phrases": [
                        "plus factor",
                        "plus point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положительный или дающий преимущество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положительный",
                                "target_lang_sense_clarification": "дающий преимущество"
                            },
                            {
                                "target_lang_word": "дополнительный",
                                "target_lang_sense_clarification": "о факторе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07b8d581-d03e-3573-b1b9-d5844fbc4291",
                    "sense_definition": "Electrically positive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A battery has both a <w>plus</w> pole and a minus pole.",
                            "target_lang_translations": {
                                "ru": "У батарейки есть как <w>положительный</w> полюс, так и отрицательный."
                            }
                        },
                        {
                            "text": "Connect the red wire to the <w>plus</w> terminal of the device.",
                            "target_lang_translations": {
                                "ru": "Подключите красный провод к <w>плюсовой</w> клемме устройства."
                            }
                        }
                    ],
                    "synonyms": [
                        "positive"
                    ],
                    "antonyms": [
                        "negative"
                    ],
                    "common_phrases": [
                        "plus pole",
                        "plus terminal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрически положительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положительный",
                                "target_lang_sense_clarification": "об электрическом заряде"
                            },
                            {
                                "target_lang_word": "плюсовой",
                                "target_lang_sense_clarification": "о клемме или полюсе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "976c2fec-8368-36ac-929c-159f51e5690f",
                    "sense_definition": "An asset or useful addition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "advantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a real <w>plus</w> to the team because of his speed.",
                            "target_lang_translations": {
                                "ru": "Он настоящий <w>плюс</w> для команды благодаря своей скорости."
                            }
                        },
                        {
                            "text": "The new park is a big <w>plus</w> for the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Новый парк — большой <w>плюс</w> для района."
                            }
                        }
                    ],
                    "synonyms": [
                        "asset"
                    ],
                    "antonyms": [
                        "liability",
                        "minus"
                    ],
                    "common_phrases": [
                        "real plus",
                        "big plus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценное качество или полезное дополнение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "достоинство или преимущество"
                            },
                            {
                                "target_lang_word": "преимущество",
                                "target_lang_sense_clarification": "полезное качество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da7e5fcc-d00e-3491-a503-92c11a56a992",
                    "sense_definition": "The symbol used to represent addition or a positive value.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematical_sign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to write a <w>plus</w> between the two numbers.",
                            "target_lang_translations": {
                                "ru": "Вам нужно написать <w>плюс</w> между двумя числами."
                            }
                        },
                        {
                            "text": "The <w>plus</w> sign is missing from the equation.",
                            "target_lang_translations": {
                                "ru": "В уравнении отсутствует знак <w>плюс</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plus sign"
                    ],
                    "antonyms": [
                        "minus sign"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Символ, используемый для обозначения сложения или положительного значения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "математический знак"
                            },
                            {
                                "target_lang_word": "знак плюс",
                                "target_lang_sense_clarification": "символ +"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "83f910ca-11d5-3335-90d0-5c0cf232a0ee",
                    "sense_definition": "And also; in addition; besides.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's go home now; it's late, <w>plus</w> I'm not feeling too well.",
                            "target_lang_translations": {
                                "ru": "Пойдем домой; уже поздно, <w>плюс</w> я не очень хорошо себя чувствую."
                            }
                        },
                        {
                            "text": "The hotel was expensive, <w>plus</w> the service was quite poor.",
                            "target_lang_translations": {
                                "ru": "Отель был дорогим, <w>к тому же</w> сервис был довольно плохим."
                            }
                        }
                    ],
                    "synonyms": [
                        "and"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in speech to add a reason"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "А также; в дополнение; к тому же."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "разговорное добавление причины"
                            },
                            {
                                "target_lang_word": "к тому же",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "да еще и",
                                "target_lang_sense_clarification": "усилительное добавление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e66b2390-9260-3631-8a60-1cca44ca7fa7",
                    "sense_definition": "To improve or make something better.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a pioneer in <w>plussing</w> the artform of animated cartoons.",
                            "target_lang_translations": {
                                "ru": "Он был пионером в <w>совершенствовании</w> искусства мультипликации."
                            }
                        },
                        {
                            "text": "We should keep <w>plussing</w> the design until it is perfect.",
                            "target_lang_translations": {
                                "ru": "Нам следует продолжать <w>улучшать</w> дизайн, пока он не станет идеальным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in creative industries like animation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать или делать что-то качественнее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшать",
                                "target_lang_sense_clarification": "доводить до совершенства"
                            },
                            {
                                "target_lang_word": "совершенствовать",
                                "target_lang_sense_clarification": "делать лучше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e370e7-8f98-312f-84fa-b5021cf0fcfe",
                    "sense_definition": "To provide critical feedback by giving suggestions for improvement rather than criticisms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feedback",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strategic leaders use the <w>plussing</w> technique to build on ideas rather than critique them.",
                            "target_lang_translations": {
                                "ru": "Стратегические лидеры используют технику <w>конструктивного дополнения</w>, чтобы развивать идеи, а не критиковать их."
                            }
                        },
                        {
                            "text": "When they view early drafts, they always use <w>plussing</w> to come up with enhancements.",
                            "target_lang_translations": {
                                "ru": "Когда они просматривают первые черновики, они всегда используют <w>метод предложений</w>, чтобы придумать улучшения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plussing technique"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "specific to corporate or creative feedback culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять конструктивную обратную связь, предлагая улучшения вместо критики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развивать идеи",
                                "target_lang_sense_clarification": "через конструктивные предложения"
                            },
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "внося улучшения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}