                "senses": [
                    {
                        "sense_id": "2523bf5f-374c-3c70-9462-246d27dd5bb4",
                        "entry_id": "fdd95ad0-5b39-3a6f-9385-2c6d400b43f5",
                        "glosses": [
                            "autor reportaży"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd3977a-2bc8-453f-8614-843d35d23f25",
                                "sense_id": "2523bf5f-374c-3c70-9462-246d27dd5bb4",
                                "text": "Sławę przyniosły reportażyście teksty o mieszkańcach Afryki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98cc9517-62d7-42a5-ad17-938c18123877",
                        "source_entry_id": "fdd95ad0-5b39-3a6f-9385-2c6d400b43f5",
                        "source_sense_id": "2523bf5f-374c-3c70-9462-246d27dd5bb4",
                        "target_lang_word": "Reporter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reporter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc3233ac-f172-3790-b11e-5d729ff460b1",
                                        "entry_id": "4c68f75f-9429-3651-ab5b-3b549f38148c",
                                        "glosses": [
                                            "Journalist, der am Ort des Geschehens (oder zumindest in dessen Nähe) ist, über das er berichtet"
                                        ],
                                        "tags": [
                                            "Journalismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c6f70ce-3bd6-4079-8fc1-bb3662262e2f",
                                                "sense_id": "dc3233ac-f172-3790-b11e-5d729ff460b1",
                                                "text": "„So bezeichnet man zum Beispiel als Redakteur den hauptberuflich bei den Medien angestellten Journalisten, als Reporter den überwiegend im Außendienst tätigen Journalisten, als Korrespondent den Berichterstatter von anderen Standorten, als Pressesprecher, Pressereferent oder Medienreferent die in der Öffentlichkeitsarbeit von Wirtschaft, Verbänden und Verwaltung tätigen Personen.“"
                                            },
                                            {
                                                "example_id": "87d0482d-ca10-4351-aef1-0ac1ad770fe2",
                                                "sense_id": "dc3233ac-f172-3790-b11e-5d729ff460b1",
                                                "text": "„Reporter dürfen - nein sie müssen sogar neugierig sein… Als Reporter begegnet man interessanten Menschen in Situationen, in die man sich sonst nie begeben würde.“"
                                            },
                                            {
                                                "example_id": "e8edd5a0-e5a3-4dd7-b1af-36368c8b7f1b",
                                                "sense_id": "dc3233ac-f172-3790-b11e-5d729ff460b1",
                                                "text": "„Etwas mehr als eine Stunde verging, als die ersten Reporter im Tower erschienen, gefolgt von einem Fernsehteam des spanischen Rundfunks.“"
                                            },
                                            {
                                                "example_id": "974fa008-fe2d-41d7-9165-853cbf742e03",
                                                "sense_id": "dc3233ac-f172-3790-b11e-5d729ff460b1",
                                                "text": "„Inzwischen hatte der Staatsanwalt bestimmt schon irgendeinem Journalisten etwas zugeflüstert, und morgen würden die Reporter ihnen wieder die Bude einrennen.“"
                                            },
                                            {
                                                "example_id": "c48dca66-215b-405b-829c-af0d7cdf30e1",
                                                "sense_id": "dc3233ac-f172-3790-b11e-5d729ff460b1",
                                                "text": "„Es ist eine Gegend, in die sich allenfalls Extremkletterer verirren und auch Hilfsorganisationen und Reporter nur unter Mühen vordringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
