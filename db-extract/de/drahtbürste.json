                "senses": [
                    {
                        "sense_id": "18a0821a-2c4d-381e-812b-0b5a7dccb80b",
                        "entry_id": "e47ef9af-9b1f-34b1-ae9c-43a2e631b19d",
                        "glosses": [
                            "Bürste zum Reinigen von Metallteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "377adbae-99e3-484b-b6ea-9912a81d73ee",
                                "sense_id": "18a0821a-2c4d-381e-812b-0b5a7dccb80b",
                                "text": "Zündkerzen reinige ich mit einer Drahtbürste."
                            },
                            {
                                "example_id": "8f1a1a8d-f57b-4fe3-abec-689dcb4399e1",
                                "sense_id": "18a0821a-2c4d-381e-812b-0b5a7dccb80b",
                                "text": "„Gib mir mal bitte die Drahtbürste, dann säubere ich das Gitter vom Grill.“"
                            },
                            {
                                "example_id": "6362c6be-53d1-4006-9a4e-93052558d4a7",
                                "sense_id": "18a0821a-2c4d-381e-812b-0b5a7dccb80b",
                                "text": "„Ich brauche mal die Drahtbürste um die Restschlacke von dem geschweißten Profil zu bürsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
