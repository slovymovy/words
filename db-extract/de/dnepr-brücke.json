                "senses": [
                    {
                        "sense_id": "cb6b771d-e066-393e-a0fe-6d6338fa6246",
                        "entry_id": "81c63d4c-98cc-3b42-9aef-cd434aee6e7c",
                        "glosses": [
                            "Brücke über den Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d09b0e-0376-41d4-b722-2f895ed98c8f",
                                "sense_id": "cb6b771d-e066-393e-a0fe-6d6338fa6246",
                                "text": "„Wir bewegten uns in Richtung Slobodka, wo wir die Dnepr-Brücke bewachen sollten.“"
                            },
                            {
                                "example_id": "2771e9bc-ec17-437c-8830-e4ed1fe6ada4",
                                "sense_id": "cb6b771d-e066-393e-a0fe-6d6338fa6246",
                                "text": "„Wir rasten zwanzig Minuten durch die nächtliche Stadt, dann hatten wir den alten PAZ-Bus am Ende einer Dnepr-Brücke eingeholt.“"
                            },
                            {
                                "example_id": "d0e0637f-2d75-4702-8530-4d4a34197ecd",
                                "sense_id": "cb6b771d-e066-393e-a0fe-6d6338fa6246",
                                "text": "„Dann ging es über die Dnepr-Brücke, und wir fragten uns: ‚Wohin geht es nun?‘“"
                            },
                            {
                                "example_id": "e78ca8e3-d9be-4f80-9942-a8fa38859ae1",
                                "sense_id": "cb6b771d-e066-393e-a0fe-6d6338fa6246",
                                "text": "„Als Hauptobjekt hätte die Dnepr-Brücke von Kanev gewählt werden müssen.“"
                            },
                            {
                                "example_id": "17c6bea7-07c7-4245-bb90-d763f35d4440",
                                "sense_id": "cb6b771d-e066-393e-a0fe-6d6338fa6246",
                                "text": "„Von der Dnepr-Brücke aus verläuft die Straße ziemlich ansteigend und geradewegs in die Stadt Kiew.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
