                    },
                    {
                        "translation_id": "54877777-d812-4aed-8433-875b3df739fa",
                        "source_entry_id": "cb4bad59-a1f6-331d-9a93-bb6fa280b880",
                        "source_sense_description": "the process or act of making more liberal",
                        "target_lang_word": "libéralisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libéralisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21d07df1-341b-3fd6-af18-84b906da2137",
                                        "entry_id": "e9482ea7-2048-3007-b742-ef149fc321c0",
                                        "glosses": [
                                            "Action de libéraliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "808e35d1-4b27-4b9d-850c-2952c9fc8ed3",
                                                "sense_id": "21d07df1-341b-3fd6-af18-84b906da2137",
                                                "text": "La Hongrie et la Slovénie ont adopté également des méthodes progressives de libéralisation et de privatisation, alors que la Tchéquie a choisi la voie rapide."
                                            },
                                            {
                                                "example_id": "f208b958-0fe4-4e96-bf48-d11fb256c2b0",
                                                "sense_id": "21d07df1-341b-3fd6-af18-84b906da2137",
                                                "text": "— La libéralisation du marché de l'énergie défendue par Bruxelles divise les Européens."
                                            },
                                            {
                                                "example_id": "e81f1546-afae-4ab1-8cf3-b6608f715517",
                                                "sense_id": "21d07df1-341b-3fd6-af18-84b906da2137",
                                                "text": "Les principales politiques dont il s'agit, sont des réformes fiscales, les libéralisations du commerce extérieur ou encore les entrées en vigueur de zones de libre échange avec des groupements plus grands et plus compétitifs."
                                            },
                                            {
                                                "example_id": "d52bc6ff-1f30-4d26-a4cc-ad4ce12330a2",
                                                "sense_id": "21d07df1-341b-3fd6-af18-84b906da2137",
                                                "text": "— Une révolution de palais où toutes les voix tentées par une libéralisation contrôlée seraient remplacées par des purs et durs de la trempe d'un Mohammed Mesbah-Yazdy, le mentor religieux ultra-radical d' Ahmadinejad, qui s'est juré de «théocratiser» à l'extrême la révolution islamique?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f1b098d-0cee-415a-bd03-6050e7649a73",
                        "source_entry_id": "cb4bad59-a1f6-331d-9a93-bb6fa280b880",
                        "source_sense_description": "the process or act of making more liberal",
