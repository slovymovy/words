                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed a few families with the name <w>Scarce</w> living in the valley.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике было указано несколько семей с фамилией <w>Скарс</w>, живущих в долине."
                            }
                        },
                        {
                            "text": "Mr. <w>Scarce</w> was known throughout the county for his extensive collection of antique clocks.",
                            "target_lang_translations": {
