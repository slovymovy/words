                ],
                "senses": [
                    {
                        "sense_id": "ca47fc6d-5119-380c-8a6b-dc4ee3a45265",
                        "entry_id": "290337cd-187f-3d2b-85d9-a6c998c58f0e",
                        "glosses": [
                            "tragbare Harmonium, das einhändig (meist mit der rechten Hand) gespielt wird und dessen Blasebalg mit der anderen Hand betätigt wird; indisches Harmonium"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "15f1fc20-ca7b-46ec-a966-6750ca8bc202",
                                "sense_id": "ca47fc6d-5119-380c-8a6b-dc4ee3a45265",
                                "text": "„Meist begleiten noch Handharmonium und Trommeln die Gesänge der Gläubigen.“"
                            },
                            {
                                "example_id": "621c16f8-98ef-408a-9a22-05119ddf15b3",
                                "sense_id": "ca47fc6d-5119-380c-8a6b-dc4ee3a45265",
                                "text": "„Hans-Dieter Stieber aus dem Kalletal hatte sein Handharmonium mitgebracht und spielte stimmungsvolle Weihnachtslieder.“"
                            },
                            {
                                "example_id": "838c777b-1923-4d1a-8866-e8a5a8bad4a3",
                                "sense_id": "ca47fc6d-5119-380c-8a6b-dc4ee3a45265",
                                "text": "„Klangfarbenfrohe Akzente setzt der musizierende Schauspieler mit dem Einsatz eines hier zu Lande eher unüblichen Repertoires an Musikinstrumenten wie der so genannten \"Shruti-Box\", einem indischen Handharmonium oder der karibischen kleinen Steel-Drum, ebenso mit Kalimba, Xylophon, Schellen, dem afrikanischen Regenrohr und der für ihn obligatorischen Mundharmonika.“"
                            },
                            {
                                "example_id": "18ee6c34-6b19-430d-b616-7aa6cc4d29eb",
                                "sense_id": "ca47fc6d-5119-380c-8a6b-dc4ee3a45265",
                                "text": "„Bürgermeister Rolf Rösner ließ den Hammer fallen, und ein Handharmonium ging für 550 Mark an den neuen Besitzer über.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
