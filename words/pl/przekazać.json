                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>przekazać</w> środki na konto fundacji charytatywnej.",
                            "target_lang_translations": {
                                "ru": "Я должен <w>перевести</w> средства на счет благотворительного фонда."
                            }
                        },
                        {
                            "text": "Bank może <w>przekazać</w> pieniądze na wskazany rachunek.",
                            "target_lang_translations": {
                                "ru": "Банк может <w>перечислить</w> деньги на указанный счет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przekazać środki"
                    ],
                    "target_lang_definitions": {
                        "ru": "внести денежные средства на банковский или почтовый счет"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевести",
