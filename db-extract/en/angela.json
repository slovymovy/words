                                        "examples": [
                                            {
                                                "example_id": "d82a0fd9-73e7-4732-8e7c-1dfe71de2906",
                                                "sense_id": "f4a77388-be92-36ca-8171-a8d81ff59199",
                                                "text": "Il me dit qu’elle était la fille de la ferme “La Douloire” là, en face, cette grangette sous les peupliers, qu’elle s’appelait Angèle et Barbaroux."
                                            },
                                            {
                                                "example_id": "b42b1721-26c0-46b0-b1ae-a1b26cc5f8e2",
                                                "sense_id": "f4a77388-be92-36ca-8171-a8d81ff59199",
                                                "text": "C'est juste lundi Angèle\n C'est juste lundi ma belle\n T'as le reste de ta vie\n Pour courir après lui."
                                            },
                                            {
                                                "example_id": "6443b150-24ed-4fa5-a794-8cb4d9070319",
                                                "sense_id": "f4a77388-be92-36ca-8171-a8d81ff59199",
                                                "text": "Angèle a retourné la chènevière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
