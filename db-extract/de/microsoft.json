                ],
                "senses": [
                    {
                        "sense_id": "337b26a0-6c8a-3217-aaef-2b20e85d615d",
                        "entry_id": "b225f171-079b-3bb4-b864-f25599d3854e",
                        "glosses": [
                            "ein weltweit tätiges, sehr großes Softwareunternehmen"
                        ],
                        "tags": [
                            "EDV",
                            "ohne Artikel"
                        ],
                        "examples": [
                            {
                                "example_id": "9ab563f4-9d39-4e68-8371-7ad4d1fdb698",
                                "sense_id": "337b26a0-6c8a-3217-aaef-2b20e85d615d",
                                "text": "Die Windows-Betriebssysteme von Microsoft stehen in Konkurrenz zu freien, kostenlosen und quelloffenen Betriebssystemen."
                            },
                            {
                                "example_id": "7bf4e8ac-b77b-4dd2-931d-95c5cd618d71",
                                "sense_id": "337b26a0-6c8a-3217-aaef-2b20e85d615d",
                                "text": "„Es wird keinen Tag in meinem Leben geben, an dem ich nicht an Microsoft denken werde“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c509d771-6a80-3ebf-8bbf-8b80fb5d76e6",
                        "entry_id": "b225f171-079b-3bb4-b864-f25599d3854e",
                        "glosses": [
                            "ein Unternehmen mit ähnlich marktbeherrschender Stellung wie [1]"
                        ],
                        "tags": [
                            "metaphorisch"
                        ],
                        "examples": [
                            {
                                "example_id": "8ca4be5b-1c7f-48ed-a683-2413dbc58224",
                                "sense_id": "c509d771-6a80-3ebf-8bbf-8b80fb5d76e6",
                                "text": "„Wir sind gewissermaßen das \"Microsoft\" der Schuhbranche.“"
                            },
                            {
                                "example_id": "7e572431-18a8-45b1-960c-e108bab62c5e",
                                "sense_id": "c509d771-6a80-3ebf-8bbf-8b80fb5d76e6",
                                "text": "„\"Wir sehen uns gerne als das Microsoft der Energiewelt\", prahlte er.“"
                            },
                            {
                                "example_id": "a439e5c6-ef57-410f-8783-6b04619b37b8",
                                "sense_id": "c509d771-6a80-3ebf-8bbf-8b80fb5d76e6",
                                "text": "„Die Aktionstage werden das \"Microsoft der Gentechnik\" wohl nur wenig beeindrucken: Es geht ihnen auch jetzt schon richtig schlecht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d24b334b-6052-40a7-ae45-f7f5cbd1f557",
                        "source_entry_id": "b225f171-079b-3bb4-b864-f25599d3854e",
                        "source_sense_id": "337b26a0-6c8a-3217-aaef-2b20e85d615d",
                        "source_sense_description": "EDV, ohne Artikel: ein weltweit tätiges, sehr großes Softwareunternehmen",
