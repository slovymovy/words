                        "entry_id": "7b224c7c-cceb-358e-9d66-a25dfad424d3",
                        "glosses": [
                            "Relatif à la robotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa96e61-5041-4d2f-b23d-71f37e5400ea",
                                "sense_id": "b2275d19-195c-379b-b920-e4812bd44f08",
                                "text": "Application des technologies robotiques aux équipements industriels."
                            },
                            {
                                "example_id": "eb10d7f7-23f0-490b-b191-791ad95dc854",
                                "sense_id": "b2275d19-195c-379b-b920-e4812bd44f08",
                                "text": "Depuis un peu plus d’un siècle, les machines nous donnent vie, nous peignent l’existence, nous plongent dans la mort et font de nous des êtres non pas robotiques, non pas cyberorganiques, mais différents ; des êtres qui dépendent de réseaux, de techniques et d’outils."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d70747e9-2f68-495b-b1f4-c191fc4fee42",
                        "source_entry_id": "7b224c7c-cceb-358e-9d66-a25dfad424d3",
                        "source_sense_id": "b2275d19-195c-379b-b920-e4812bd44f08",
                        "target_lang_word": "robotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8a000c5-dd0e-3c61-9c37-f3e68d92bf82",
                                        "entry_id": "d3d5b98c-3181-3358-8b17-fd4a6b00a9a7",
                                        "glosses": [
                                            "Of, relating to, or resembling a robot; mechanical, lacking emotion or personality, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a930363-b34c-4c7e-9583-8b80d66c32cc",
                                                "sense_id": "b8a000c5-dd0e-3c61-9c37-f3e68d92bf82",
                                                "text": "You'd cut your own nose off before you'd let me get the credit for solving robotic telepathy."
                                            },
                                            {
                                                "example_id": "43931dc0-f422-4b88-8a5e-d413c66f752d",
                                                "sense_id": "b8a000c5-dd0e-3c61-9c37-f3e68d92bf82",
                                                "text": "In Vice President Al Gore's campaign to change his robotic image, nothing may have helped more than the big smooch."
                                            },
                                            {
                                                "example_id": "8a73f2d2-78f1-4386-a54c-872084abb6bd",
                                                "sense_id": "b8a000c5-dd0e-3c61-9c37-f3e68d92bf82",
                                                "text": "President Donald Trump’s presidential memorandum ordering an investigation of Joe Biden’s cognitive decline and his use of the autopen […] is also nonsensical fan service, amplifying addled MAGA conspiracy theories that contend, with a straight face, that Biden was really a robotic clone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
