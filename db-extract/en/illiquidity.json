                                    {
                                        "sense_id": "c6ec8da0-92f0-3add-8667-a52f86166c2d",
                                        "entry_id": "bc80690c-a171-3183-b6d3-2a7ec5ad7314",
                                        "glosses": [
                                            "Manque de liquidité empêchant l’achat ou la vente d’actifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a45c454-8e5e-49d9-a9da-481e5eb8f2d2",
                                                "sense_id": "c6ec8da0-92f0-3add-8667-a52f86166c2d",
                                                "text": "Dans les fonds de private equity, le risque d’illiquidité est exacerbé. Car les fonds y sont bloqués pour plusieurs années. Le risque d’illiquidité est celui de ne pas pouvoir rebalancer cette partie du portefeuille."
                                            },
                                            {
                                                "example_id": "1e420ad9-1e8f-4968-898d-23cd821630db",
                                                "sense_id": "c6ec8da0-92f0-3add-8667-a52f86166c2d",
                                                "text": "La réticence des investisseurs à accepter des risques ou une éventuelle illiquidité existe toujours dans la société occidentale."
                                            },
                                            {
                                                "example_id": "207ba9bc-416c-4112-a738-70a6b6aa7c4a",
                                                "sense_id": "c6ec8da0-92f0-3add-8667-a52f86166c2d",
                                                "text": "Calcul des rentabilités et des illiquidités pour chaque portefeuille à chaque mois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d87e3a3b-52a7-4489-9667-de0f0c965153",
                        "source_entry_id": "1de2c8dd-a98d-3de5-b8ab-7a9732a21625",
                        "source_sense_id": "1d4d2f9d-db46-3c10-8379-7ed7d227960c",
                        "source_sense_description": "lack of liquidity",
                        "target_lang_word": "Illiquidität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Illiquidität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f58094-cc88-3b1c-9e17-193fe7f8228d",
                                        "entry_id": "c3cd15c7-4ffc-3c44-8c07-4a2660952df9",
                                        "glosses": [
                                            "Tatsache, dass (zur Zeit) kein Geld (keine liquiden Mittel) zum Bedienen/Bezahlen von Forderungen/Rechnungen vorhanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cb71c6b-7761-4df9-b2e8-cb9ebbfd87c0",
                                                "sense_id": "f5f58094-cc88-3b1c-9e17-193fe7f8228d",
                                                "text": "„Als Gegenteil zur Liquidität bezeichnet Illiquidität den Zustand eines Unternehmens, seine Zahlungsverpflichtungen nicht mehr dauerhaft erfüllen zu können.“"
                                            },
                                            {
                                                "example_id": "c2ff6b67-7f91-4761-9796-9bc8259a1531",
                                                "sense_id": "f5f58094-cc88-3b1c-9e17-193fe7f8228d",
                                                "text": "„Bei einem illiquiden Unternehmen kommt es entscheidend darauf an, ob es sich um eine vorübergehende oder eine strukturelle Illiquidität handelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63068518-697f-415c-8bff-a2c98ae1651d",
