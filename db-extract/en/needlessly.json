                "senses": [
                    {
                        "sense_id": "4a7010f2-1eed-37bf-95e0-ea1e695458e0",
                        "entry_id": "3b3b691a-60e5-3b4f-82b7-1cc7316224f2",
                        "glosses": [
                            "In a needless manner."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "71e00ae5-307e-376a-bdef-8ce10e5d0573",
                        "entry_id": "3b3b691a-60e5-3b4f-82b7-1cc7316224f2",
                        "glosses": [
                            "To a degree or extent beyond what is needed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280fec06-0724-415b-9fcb-fbf782b336a1",
                                "sense_id": "71e00ae5-307e-376a-bdef-8ce10e5d0573",
                                "text": "He was always needlessly anxious about his dog."
                            },
                            {
                                "example_id": "e4ad2010-b367-48ac-8ad7-8cbc5e31378a",
                                "sense_id": "71e00ae5-307e-376a-bdef-8ce10e5d0573",
                                "text": "At present that convenience is still needlessly expensive in Great Britain, and a scandalously stupid business conflict between telephone company and post-office delays, complicates, and makes costly and exasperating all trunk communications; but even under these disadvantages the thing is becoming a factor in the life of ordinary villadom."
                            }
                        ]
                    },
                    {
                        "sense_id": "0586b952-eead-30c1-8293-4ccd6d4fac02",
                        "entry_id": "3b3b691a-60e5-3b4f-82b7-1cc7316224f2",
                        "glosses": [
                            "Without need."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e29aefc-8509-4201-9de9-c407f81990a4",
                                "sense_id": "0586b952-eead-30c1-8293-4ccd6d4fac02",
                                "text": "He worried needlessly about his dog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca461c3e-66de-47f2-95fc-c1aa68778849",
                        "source_entry_id": "3b3b691a-60e5-3b4f-82b7-1cc7316224f2",
                        "source_sense_description": "in a needless manner",
                        "target_lang_word": "niepotrzebnie",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niepotrzebnie",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                                        "entry_id": "dde0ea72-af66-30b1-b68c-161665f56eb8",
                                        "glosses": [
                                            "w sposób niepotrzebny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a731d6-1313-43e0-9a1a-d8b7277ccfc7",
                                                "sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                                                "text": "Stanisław nie pływa zbyt dobrze i zawsze niepotrzebnie wzbija wokół siebie fontanny wody."
                                            },
                                            {
                                                "example_id": "9f5e7026-7e89-4448-a942-2093ce690cbb",
                                                "sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                                                "text": "Znowu kran niezakręcony i woda leje się niepotrzebnie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55a55f9d-9a29-4934-9317-b041e381df06",
                        "source_entry_id": "3b3b691a-60e5-3b4f-82b7-1cc7316224f2",
                        "source_sense_description": "in a needless manner",
                        "target_lang_word": "напрасно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "напрасно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0061081b-ac10-3e95-8531-bcb4d0578e7f",
                                        "entry_id": "3f216e06-7b19-33e6-adf0-a038d03664c3",
                                        "glosses": [
                                            "наречие к напрасный; не достигая цели; без желаемого результата; безрезультатно"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6992f97a-9855-4fe2-ace5-11b3a687553f",
                                                "sense_id": "0061081b-ac10-3e95-8531-bcb4d0578e7f",
                                                "text": "И, поняв, в чём дело, Дугаев пожалел, что напрасно проработал, напрасно промучился этот последний сегодняшний день."
                                            },
                                            {
                                                "example_id": "36240a65-7260-4ca3-891c-357cccbd0e86",
                                                "sense_id": "0061081b-ac10-3e95-8531-bcb4d0578e7f",
                                                "text": "Ах, кричали они напрасно: не мог Михаил Александрович позвонить никуда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e3edda-dc3e-3abb-8467-2d65ef9d700a",
                                        "entry_id": "3f216e06-7b19-33e6-adf0-a038d03664c3",
                                        "glosses": [
                                            "во вред себе; зря, без достаточных оснований"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10af8071-dac4-4b12-b334-66b37575061a",
                                                "sense_id": "96e3edda-dc3e-3abb-8467-2d65ef9d700a",
                                                "text": "Старуха плакала потихоньку, чтобы напрасно не огорчать и без того несчастного сына…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4281c44c-a105-3628-8254-06f94db1235f",
                                        "entry_id": "3f216e06-7b19-33e6-adf0-a038d03664c3",
                                        "glosses": [
                                            "оценочная характеристика чего-либо как бесполезного, тщетного"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3c57869-faef-467f-b1aa-8e2490b6453b",
                                                "sense_id": "4281c44c-a105-3628-8254-06f94db1235f",
                                                "text": "Напрасно читатель станет искать название оригинала книги — указано только издательство, которому принадлежат права."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeab28ab-c998-3fd0-b20f-84afa5617ae7",
                                        "entry_id": "3f216e06-7b19-33e6-adf0-a038d03664c3",
                                        "glosses": [
                                            "оценочная характеристика чьих-либо действий как осуществлённых без достаточных оснований, во вред себе"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e53d2258-64c1-49c9-bb6c-29f1cd9a4efb",
                                                "sense_id": "aeab28ab-c998-3fd0-b20f-84afa5617ae7",
                                                "text": "Вы напрасно курите!"
                                            },
                                            {
                                                "example_id": "72cd5233-306d-4eab-9f58-f55c8dbd4148",
                                                "sense_id": "aeab28ab-c998-3fd0-b20f-84afa5617ae7",
                                                "text": "― А ещё он говорит, что вы напрасно связались с этим попом."
                                            },
                                            {
                                                "example_id": "6f2a668c-1943-47d9-849b-f656006e3c71",
                                                "sense_id": "aeab28ab-c998-3fd0-b20f-84afa5617ae7",
                                                "text": "Человек шевельнулся — и напрасно, потому что старшой тут же дал ему под рёбра."
                                            },
                                            {
                                                "example_id": "968f677e-5c70-4cde-8b0f-ef56f3bfff9e",
                                                "sense_id": "aeab28ab-c998-3fd0-b20f-84afa5617ae7",
                                                "text": "― Покорнейше… я не пью… — Напрасно! Так не прикажете ли партию в кости?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
