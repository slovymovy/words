                    {
                        "sense_id": "b13cacd2-2e06-367b-87ec-022920a64445",
                        "entry_id": "135bad0a-adc4-3161-8730-8e51e8e676c7",
                        "glosses": [
                            "Plante odorante, à racine ligneuse, ainsi nommée parce que ses feuilles ressemblent à celles du frêne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a29c4c-3c90-4c21-b6b2-9d88ad0ff3ec",
                                "sense_id": "b13cacd2-2e06-367b-87ec-022920a64445",
                                "text": "La racine de fraxinelle est employée en médecine comme stimulant."
                            },
                            {
                                "example_id": "eaae9925-7c6f-4649-a2b9-8894e5aabb7c",
                                "sense_id": "b13cacd2-2e06-367b-87ec-022920a64445",
                                "text": "A droite, montaient les fraxinelles légères, les centranthus retombant en neige immaculée, les cynoglosses grisâtres ayant une goutte de rosée dans chacune des coupes minuscules de leurs fleurs."
                            },
                            {
                                "example_id": "303c6415-4aba-43d1-aa90-61f7fe23f0f1",
                                "sense_id": "b13cacd2-2e06-367b-87ec-022920a64445",
                                "text": "Des buissons de fraxinelle, plante que l’on cultive beaucoup ici dans les jardins, et qui atteint de grandes proportions, exhalaient des parfums exquis."
                            }
                        ]
                    }
                ],
