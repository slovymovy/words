                                "example_id": "280d1c5c-7905-45e9-b39a-ecb153dc5bdf",
                                "sense_id": "a6b0f46c-0d80-3c11-b533-cc9572d7eaa7",
                                "text": "Reginas Lieblingsmaler ist Pieter Brueghel der Ältere."
                            }
