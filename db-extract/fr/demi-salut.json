                        "entry_id": "d913ada3-ab7e-38fe-851c-8464ee8029fd",
                        "glosses": [
                            "Salut de la tête ou de la main discret, à peine esquissé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b9f27a-f982-4b41-a13a-173ca1b15483",
                                "sense_id": "9f894023-4364-32d4-8762-195fd8a7dbbf",
                                "text": "Il se permit de faire un demi-salut fort grave à trois dames qui marchaient presque sur la même ligne que lui et qui parlaient fort haut."
                            },
                            {
                                "example_id": "60471222-4e7c-4ab0-bc01-5ff36d662dff",
                                "sense_id": "9f894023-4364-32d4-8762-195fd8a7dbbf",
                                "text": "Il regardait une magnifique pendule dorée, représentant un sujet très indécent selon lui, lorsqu’un monsieur fort élégant s’approcha d’un air riant. Julien fit un demi-salut."
                            },
                            {
                                "example_id": "348847a5-cb61-4195-b8f0-b350271ef2cd",
                                "sense_id": "9f894023-4364-32d4-8762-195fd8a7dbbf",
                                "text": "Il a d’excellentes manières, se plaît à passer, à table, avec un demi-salut, le sel ou la moutarde qu’on lui demande."
                            }
                        ]
                    }
