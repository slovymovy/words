                    {
                        "translation_id": "396ef1a0-a53b-45f9-b282-84f6c037367d",
                        "source_entry_id": "572869a8-c9fb-3d69-b895-0652f382846c",
                        "source_sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                        "target_lang_word": "gondolier",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gondolier",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "27a595ad-cdc8-34ce-ae79-d69047823e38",
                                        "entry_id": "97a1f48b-832f-382d-8357-435f84190274",
                                        "glosses": [
                                            "człowiek sterujący gondolą"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41318eb0-d901-4ef8-b764-f36f3aee5246",
                                                "sense_id": "27a595ad-cdc8-34ce-ae79-d69047823e38",
                                                "text": "Przed nami sterczał gmach komory celnej, kąpiący się w wodach kanału, pod nami szkliły się zielone fale, tu i ówdzie krajane wiosłami gondolierów […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73091d9e-7a3f-4e3e-9407-81ca7d4c3d6e",
                        "source_entry_id": "572869a8-c9fb-3d69-b895-0652f382846c",
                        "source_sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                        "target_lang_word": "гондольер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гондольер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "df29cafc-165f-3f45-b75e-8efc832dc299",
                                        "entry_id": "b6fa3a04-6c67-3db2-97a4-5286c517ec29",
                                        "glosses": [
                                            "гребец на гондоле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24a1fccd-76cf-4e42-94c6-bf848e4b2247",
                                                "sense_id": "df29cafc-165f-3f45-b75e-8efc832dc299",
                                                "text": "Гондольеры окружили нас со всех сторон, с чёрными своими лодочками, которые летают по воде так легко, как птицы."
                                            },
                                            {
                                                "example_id": "cd253e05-2b08-4258-a333-9e76ca1c2502",
                                                "sense_id": "df29cafc-165f-3f45-b75e-8efc832dc299",
                                                "text": "Я любил сидеть на солнышке, слушать гондольера, не понимать и по целым часам смотреть на домик, где, говорят, жила Дездемона, — наивный, грустный домик с девственным выражением, легкий, как кружево, до того легкий, что, кажется, его можно сдвинуть с места одною рукой."
                                            },
                                            {
                                                "example_id": "5f5e98ff-25f8-40c0-9790-ebd972424eec",
                                                "sense_id": "df29cafc-165f-3f45-b75e-8efc832dc299",
                                                "text": "Гондольер плавно, бережно и молча скользит в узких каналах, и вдруг, как крик совы, из тишины ночи вылетает окрик его, чтобы легче разъехаться на углах канала."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
