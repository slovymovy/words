                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "544df2ad-dd38-33ad-bbd7-6ad54bc2e8f2",
                                        "entry_id": "84442a21-299c-394c-a839-38bc63cca8b6",
                                        "glosses": [
                                            "A short, soft, high-pitched sound, as made by a baby bird."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbe3a4a4-3995-395c-9057-42daa79a8cef",
                                        "entry_id": "84442a21-299c-394c-a839-38bc63cca8b6",
                                        "glosses": [
                                            "A feeble utterance or complaint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e978bb-4c32-481e-a4e6-104e3d3fc2ac",
                                                "sense_id": "dbe3a4a4-3995-395c-9057-42daa79a8cef",
                                                "text": "I don't want to hear a peep out of you!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f47935d-8440-3478-b7d3-12a72be0a964",
                                        "entry_id": "84442a21-299c-394c-a839-38bc63cca8b6",
                                        "glosses": [
                                            "The sound of a steam engine's whistle; typically shrill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69d5138e-aa5e-494a-8526-dc71f6a121d3",
                                                "sense_id": "4f47935d-8440-3478-b7d3-12a72be0a964",
                                                "text": "With a \"peep\" from a high-pitched whistle, the train would leave by the crossover to the down line, […]."
                                            },
                                            {
                                                "example_id": "590b4295-52a6-4edb-90db-d9b90c172616",
                                                "sense_id": "4f47935d-8440-3478-b7d3-12a72be0a964",
                                                "text": "\"Peep, peep,\" said Edward, \"I'm ready.\"\n\"Peep, peep, peep,\" said Henry, \"so am I.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b802e9-8336-3f75-976d-14a1f545165e",
                                        "entry_id": "84442a21-299c-394c-a839-38bc63cca8b6",
                                        "glosses": [
                                            "A sandpiper or other small wader."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "peep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55f85e9e-0031-381d-a4dc-0d6eef432f67",
                                        "entry_id": "56ee12c9-6718-343a-a777-333d9becfba0",
