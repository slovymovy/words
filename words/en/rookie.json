{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4509726b-f632-37b2-a26e-06581c3a1ea5",
                    "sense_definition": "A person who is new to an activity, job, or organization and lacks experience.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "novice_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rookie</w> asked his supervisor for help with the difficult task.",
                            "target_lang_translations": {
                                "ru": "<w>Новичок</w> попросил своего руководителя о помощи с трудным заданием.",
                                "zh": "这个<w>新手</w>向他的主管寻求帮助以完成这项艰巨的任务。"
                            }
                        },
                        {
                            "text": "I am a total <w>rookie</w> at chess, so please go easy on me.",
                            "target_lang_translations": {
                                "ru": "Я полный <w>чайник</w> в шахматах, так что, пожалуйста, не суди строго.",
                                "zh": "我下国际象棋完全是个<w>菜鸟</w>，所以请手下留情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beginner",
                        "novice",
                        "newbie"
                    ],
                    "antonyms": [
                        "expert",
                        "veteran",
                        "professional"
                    ],
                    "common_phrases": [
                        "total rookie",
                        "green rookie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который является новичком в какой-либо деятельности, работе или организации и не имеет опыта.",
                        "zh": "指在某项活动、工作或组织中缺乏经验的新手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "неопытный работник",
                                "target_lang_sense_clarification": "о сотруднике"
                            },
                            {
                                "target_lang_word": "чайник",
                                "target_lang_sense_clarification": "разговорное, о неумелом человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新手",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "菜鸟",
                                "target_lang_sense_clarification": "口语，指缺乏经验的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4120578-01b2-3b8e-a2fb-68963e651ac9",
                    "sense_definition": "An athlete in their first year of playing for a professional team or in a specific league.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "novice_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played so well during his <w>rookie</w> season that he won an award.",
                            "target_lang_translations": {
                                "ru": "Он играл так хорошо в свой <w>дебютный</w> сезон, что выиграл награду.",
                                "zh": "他在<w>新秀</w>赛季表现出色，赢得了奖项。"
                            }
                        },
                        {
                            "text": "The coach decided to put the <w>rookie</w> in the starting lineup for the final game.",
                            "target_lang_translations": {
                                "ru": "Тренер решил поставить <w>новичка</w> в стартовый состав на финальную игру.",
                                "zh": "教练决定让这名<w>新秀</w>在决赛中首发出场。"
                            }
                        }
                    ],
                    "antonyms": [
                        "veteran"
                    ],
                    "common_phrases": [
                        "rookie season",
                        "rookie of the year"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортсмен, проводящий свой первый сезон в профессиональной команде или лиге.",
                        "zh": "指在职业球队或特定联赛中参加第一个赛季的运动员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "дебютант",
                                "target_lang_sense_clarification": "впервые выступающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新秀",
                                "target_lang_sense_clarification": "体育领域常用"
                            },
                            {
                                "target_lang_word": "新人",
                                "target_lang_sense_clarification": "指初次登场者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e3e4ccd-8af7-3e77-8c9f-5dc90df3600c",
                    "sense_definition": "A new recruit in the police force or armed services.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "novice_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sergeant was assigned to train the <w>rookie</w> on proper patrol procedures.",
                            "target_lang_translations": {
                                "ru": "Сержанту поручили обучить <w>новобранца</w> правильным процедурам патрулирования.",
                                "zh": "中士被指派去训练<w>新兵</w>掌握正确的巡逻程序。"
                            }
                        },
                        {
                            "text": "Every <w>rookie</w> must memorize the code of conduct before going on duty.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>стажёр</w> должен выучить кодекс поведения перед выходом на дежурство.",
                                "zh": "每个<w>新警</w>在执勤前都必须背诵行为准则。"
                            }
                        }
                    ],
                    "antonyms": [
                        "veteran"
                    ],
                    "common_phrases": [
                        "rookie cop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новый сотрудник в полиции или новобранец в вооруженных силах.",
                        "zh": "指警察部队或武装部队中的新入职人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новобранец",
                                "target_lang_sense_clarification": "военный термин"
                            },
                            {
                                "target_lang_word": "салага",
                                "target_lang_sense_clarification": "сленг, пренебрежительное"
                            },
                            {
                                "target_lang_word": "стажёр",
                                "target_lang_sense_clarification": "в полиции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新兵",
                                "target_lang_sense_clarification": "军事领域"
                            },
                            {
                                "target_lang_word": "新警",
                                "target_lang_sense_clarification": "警察领域"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a439cd58-4237-30c8-91a2-fed90ca69b85",
                    "sense_definition": "Relating to or characteristic of a beginner; inexperienced or amateurish.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I made a <w>rookie</w> mistake by forgetting to save the document before closing it.",
                            "target_lang_translations": {
                                "ru": "Я совершил ошибку <w>новичка</w>, забыв сохранить документ перед закрытием.",
                                "zh": "我犯了一个<w>新手</w>错误，在关闭文档前忘了保存。"
                            }
                        },
                        {
                            "text": "His <w>rookie</w> error cost the team the championship match.",
                            "target_lang_translations": {
                                "ru": "Его <w>дилетантская</w> ошибка стоила команде матча за чемпионство.",
                                "zh": "他那次<w>业余</w>的失误导致球队输掉了冠军赛。"
                            }
                        }
                    ],
                    "antonyms": [
                        "professional",
                        "expert"
                    ],
                    "common_phrases": [
                        "rookie mistake",
                        "rookie error"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к новичку или характерный для него; неопытный или дилетантский.",
                        "zh": "与新手相关的，或具有新手特征的；指缺乏经验或业余的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопытный",
                                "target_lang_sense_clarification": "прилагательное"
                            },
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "разговорное, о неопытности"
                            },
                            {
                                "target_lang_word": "новичковый",
                                "target_lang_sense_clarification": "относящийся к новичку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新手的",
                                "target_lang_sense_clarification": "形容词"
                            },
                            {
                                "target_lang_word": "业余的",
                                "target_lang_sense_clarification": "指水平不高"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a62a85ae-10ba-3c13-939e-f8ed026ac9d7",
                    "sense_definition": "To work as a novice or go through an initial learning period in a job or team.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>rookied</w> for the fire department back in the eighties.",
                            "target_lang_translations": {
                                "ru": "Он <w>ходил в новичках</w> в пожарной части ещё в восьмидесятых.",
                                "zh": "他在八十年代时曾在消防局<w>实习</w>过。"
                            }
                        },
                        {
                            "text": "She <w>rookied</w> alongside her brother before they both became full members.",
                            "target_lang_translations": {
                                "ru": "Она <w>стажировалась</w> вместе с братом, прежде чем они оба стали полноправными членами.",
                                "zh": "她和她哥哥一起<w>实习</w>，之后他们都成为了正式成员。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать в качестве новичка или проходить начальный период обучения в работе или команде.",
                        "zh": "指以新手身份工作或经历初期的学习阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть новичком",
                                "target_lang_sense_clarification": "о статусе"
                            },
                            {
                                "target_lang_word": "стажироваться",
                                "target_lang_sense_clarification": "проходить обучение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实习",
                                "target_lang_sense_clarification": "指在职学习"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "148b740a-8e33-352a-89e8-959c1b75cc95",
                    "sense_definition": "To haze or subject a new recruit to initiation rituals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The older players <w>rookied</w> him by making him carry all the equipment.",
                            "target_lang_translations": {
                                "ru": "Старшие игроки <w>издевались</w> над ним, заставляя носить всё снаряжение.",
                                "zh": "老队员们<w>欺负</w>他，让他搬运所有的装备。"
                            }
                        },
                        {
                            "text": "He was <w>rookied</w> during his first week at the training camp.",
                            "target_lang_translations": {
                                "ru": "Над ним <w>подшучивали</w> в первую неделю в тренировочном лагере.",
                                "zh": "他在训练营的第一周就遭到了<w>欺负</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать нового сотрудника ритуалам посвящения или дедовщине.",
                        "zh": "指对新入职者进行入职仪式或欺凌行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устраивать «дедовщину»",
                                "target_lang_sense_clarification": "неуставные отношения"
                            },
                            {
                                "target_lang_word": "гонять",
                                "target_lang_sense_clarification": "сленг, нагружать работой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欺负",
                                "target_lang_sense_clarification": "指针对新人的刁难"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}