{
    "word_family": [
        "swaggerer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f8a6807-3391-3e91-8270-4906188c66a2",
                    "sense_definition": "To walk or carry oneself in a pompous, superior, or arrogant manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_and_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor <w>swaggered</w> across the stage as if he owned the entire theater.",
                            "target_lang_translations": {
                                "nl": "De acteur <w>paradeerde</w> over het podium alsof het hele theater van hem was.",
                                "ru": "Актёр <w>шествовал с важным видом</w> по сцене, словно владел всем театром."
                            }
                        },
                        {
                            "text": "He <w>swaggered</w> into the room with an air of unearned importance.",
                            "target_lang_translations": {
                                "nl": "Hij <w>stapte</w> de kamer <w>binnen</w> met een air van onterechte belangrijkheid.",
                                "ru": "Он <w>вошёл вразвалку</w> в комнату с напускным видом собственной важности."
                            }
                        }
                    ],
                    "synonyms": [
                        "strut",
                        "prance"
                    ],
                    "common_phrases": [
                        "swagger into"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een arrogante, verwaande of zelfingenomen manier lopen.",
                        "ru": "Ходить или держаться высокомерно, самодовольно или с важным видом."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "paraderen",
                                "target_lang_sense_clarification": "zelfverzekerd of trots rondlopen"
                            },
                            {
                                "target_lang_word": "stappen",
                                "target_lang_sense_clarification": "met bravoure of zwier lopen"
                            },
                            {
                                "target_lang_word": "schrijden",
                                "target_lang_sense_clarification": "hooghartig of theatraal lopen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "важничать",
                                "target_lang_sense_clarification": "держаться напыщенно или высокомерно"
                            },
                            {
                                "target_lang_word": "ходить гоголем",
                                "target_lang_sense_clarification": "ходить с гордым, заносчивым видом"
                            },
                            {
                                "target_lang_word": "шествовать с важным видом",
                                "target_lang_sense_clarification": "идти величаво или надменно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b0c560f-07e4-364f-8107-1c530f5bd051",
                    "sense_definition": "To boast, brag, or act in a bullying and noisy manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician continued to <w>swagger</w> about his achievements despite the mounting evidence of failure.",
                            "target_lang_translations": {
                                "nl": "De politicus bleef maar <w>opscheppen</w> over zijn prestaties, ondanks het groeiende bewijs van falen.",
                                "ru": "Политик продолжал <w>хвастаться</w> своими достижениями, несмотря на растущее число свидетельств провала."
                            }
                        },
                        {
                            "text": "It is foolish to <w>swagger</w> and threaten others when you have no real power.",
                            "target_lang_translations": {
                                "nl": "Het is dwaas om te <w>snoeven</w> en anderen te bedreigen wanneer je geen echte macht hebt.",
                                "ru": "Глупо <w>задираться</w> и угрожать другим, когда у тебя нет реальной власти."
                            }
                        }
                    ],
                    "synonyms": [
                        "brag",
                        "boast",
                        "bluster"
                    ],
                    "target_lang_definitions": {
                        "nl": "Luidruchtig pochen, opscheppen of intimiderend gedrag vertonen.",
                        "ru": "Хвастаться, бахвалиться или вести себя задиристо и шумно."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opscheppen",
                                "target_lang_sense_clarification": "pochen of bluffen"
                            },
                            {
                                "target_lang_word": "snoeven",
                                "target_lang_sense_clarification": "hoog van de toren blazen"
                            },
                            {
                                "target_lang_word": "pralen",
                                "target_lang_sense_clarification": "pronken of pochen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хвастаться",
                                "target_lang_sense_clarification": "неумеренно хвалить себя или преувеличивать успехи"
                            },
                            {
                                "target_lang_word": "бахвалиться",
                                "target_lang_sense_clarification": "шумно хвастать или выставлять себя напоказ"
                            },
                            {
                                "target_lang_word": "задираться",
                                "target_lang_sense_clarification": "вести себя вызывающе и агрессивно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e61a0abb-4ae8-3a28-ad82-96b516d56084",
                    "sense_definition": "To walk with a swaying or unsteady motion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_and_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired traveler <w>swaggered</w> home after a long and difficult journey.",
                            "target_lang_translations": {
                                "nl": "De vermoeide reiziger <w>wankelde</w> naar huis na een lange en zware reis.",
                                "ru": "Уставший путник <w>плёлся вразвалку</w> домой после долгого и трудного пути."
                            }
                        },
                        {
                            "text": "He <w>swaggered</w> down the uneven path, struggling to keep his balance.",
                            "target_lang_translations": {
                                "nl": "Hij <w>strompelde</w> over het oneffen pad, terwijl hij moeite had zijn evenwicht te bewaren.",
                                "ru": "Он <w>шёл, покачиваясь</w>, по неровной дорожке, с трудом удерживая равновесие."
                            }
                        }
                    ],
                    "synonyms": [
                        "sway",
                        "lurch"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met een wiegende of wankele pas lopen.",
                        "ru": "Идти, покачиваясь или покачивая телом из стороны в сторону; идти неуверенной походкой."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wankelen",
                                "target_lang_sense_clarification": "onvast ter been lopen"
                            },
                            {
                                "target_lang_word": "wiegen",
                                "target_lang_sense_clarification": "heen en weer zwaaiend lopen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ходить вразвалку",
                                "target_lang_sense_clarification": "идти, покачиваясь из стороны в сторону"
                            },
                            {
                                "target_lang_word": "покачиваться при ходьбе",
                                "target_lang_sense_clarification": "идти с качающейся походкой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b802d6d1-d956-3d9b-b5d6-0e59356618e6",
                    "sense_definition": "A display of confidence or pride.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team played with a new <w>swagger</w> after their unexpected victory.",
                            "target_lang_translations": {
                                "nl": "Het team speelde met een nieuwe <w>branie</w> na hun onverwachte overwinning.",
                                "ru": "После неожиданной победы команда играла с новой <w>уверенностью в себе</w>."
                            }
                        },
                        {
                            "text": "He walked with a certain <w>swagger</w> that made everyone notice his presence.",
                            "target_lang_translations": {
                                "nl": "Hij liep met een zekere <w>bravoure</w> waardoor iedereen zijn aanwezigheid opmerkte.",
                                "ru": "Он шёл с такой <w>самоуверенностью</w>, что все вокруг обращали на него внимание."
                            }
                        }
                    ],
                    "synonyms": [
                        "confidence",
                        "bravado"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een zelfverzekerde, trotse of zwierige houding en uitstraling.",
                        "ru": "Проявление уверенности в себе, бравады или гордости."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "branie",
                                "target_lang_sense_clarification": "bluf, zelfverzekerdheid"
                            },
                            {
                                "target_lang_word": "bravoure",
                                "target_lang_sense_clarification": "durf en zwier"
                            },
                            {
                                "target_lang_word": "zelfverzekerdheid",
                                "target_lang_sense_clarification": "zekerheid van optreden"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "самоуверенность",
                                "target_lang_sense_clarification": "подчёркнутая вера в свои силы"
                            },
                            {
                                "target_lang_word": "уверенность в себе",
                                "target_lang_sense_clarification": "смелая и непринуждённая манера держаться"
                            },
                            {
                                "target_lang_word": "бравада",
                                "target_lang_sense_clarification": "показная смелость или удаль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9e76e42-64a1-373d-9ea9-88a133ac7501",
                    "sense_definition": "A bold, arrogant, or pompous way of walking.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_and_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>swagger</w> was intended to intimidate anyone who dared to challenge him.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>arrogante loopje</w> was bedoeld om iedereen te intimideren die hem durfde uit te dagen.",
                                "ru": "Его <w>самодовольная походка</w> должна была запугать любого, кто осмелился бы бросить ему вызов."
                            }
                        },
                        {
                            "text": "She adopted a confident <w>swagger</w> as she entered the boardroom.",
                            "target_lang_translations": {
                                "nl": "Ze nam een zelfverzekerde <w>gang</w> aan toen ze de directiekamer binnenliep.",
                                "ru": "Она вошла в зал заседаний <w>уверенной походкой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "strut"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een arrogante, trotse of opzichtige manier van lopen.",
                        "ru": "Самодовольная, развязная или напыщенная походка."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "arrogante pas",
                                "target_lang_sense_clarification": "verwaande manier van lopen"
                            },
                            {
                                "target_lang_word": "trotse gang",
                                "target_lang_sense_clarification": "zelfbewuste manier van lopen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "самодовольная походка",
                                "target_lang_sense_clarification": "походка человека, довольного собой"
                            },
                            {
                                "target_lang_word": "самоуверенная походка",
                                "target_lang_sense_clarification": "смелая и размашистая походка"
                            },
                            {
                                "target_lang_word": "походка вразвалку",
                                "target_lang_sense_clarification": "развязная походка с покачиванием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "328b3daf-76c5-3d6b-8615-d2723a84f3f7",
                    "sense_definition": "Prideful boasting or noisy bragging.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public grew tired of the constant <w>swagger</w> from the wealthy elite.",
                            "target_lang_translations": {
                                "nl": "Het publiek werd de constante <w>grootspraak</w> van de rijke elite beu.",
                                "ru": "Публика устала от постоянного <w>хвастовства</w> богатой элиты."
                            }
                        },
                        {
                            "text": "His empty <w>swagger</w> could not hide his lack of actual experience.",
                            "target_lang_translations": {
                                "nl": "Zijn lege <w>bluf</w> kon zijn gebrek aan echte ervaring niet verhullen.",
                                "ru": "Его пустое <w>бахвальство</w> не могло скрыть отсутствия реального опыта."
                            }
                        }
                    ],
                    "synonyms": [
                        "bragging",
                        "bluster"
                    ],
                    "target_lang_definitions": {
                        "nl": "Luidruchtige grootspraak of verwaand gepoch.",
                        "ru": "Высокомерное хвастовство или шумное бахвальство."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "grootspraak",
                                "target_lang_sense_clarification": "opschepperij"
                            },
                            {
                                "target_lang_word": "bluf",
                                "target_lang_sense_clarification": "opschepperig gedrag"
                            },
                            {
                                "target_lang_word": "gebral",
                                "target_lang_sense_clarification": "luidruchtige grootspraak"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хвастовство",
                                "target_lang_sense_clarification": "неумеренное восхваление собственных достоинств"
                            },
                            {
                                "target_lang_word": "бахвальство",
                                "target_lang_sense_clarification": "самонадеянная похвальба"
                            },
                            {
                                "target_lang_word": "фанфаронство",
                                "target_lang_sense_clarification": "показное и пустое хвастовство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3455181-9d7a-3678-88a7-de123e055d2b",
                    "sense_definition": "A person who carries a swag; a swagman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>swagger</w> stopped by the farm to ask for a drink of water.",
                            "target_lang_translations": {
                                "nl": "De <w>zwerver</w> stopte bij de boerderij om wat water te drinken te vragen.",
                                "ru": "<w>Бродяга</w> остановился у фермы, чтобы попросить воды напиться."
                            }
                        },
                        {
                            "text": "Many a <w>swagger</w> traveled the dusty roads looking for seasonal work.",
                            "target_lang_translations": {
                                "nl": "Menig <w>landloper</w> reisde over de stoffige wegen op zoek naar seizoensarbeid.",
                                "ru": "Немало <w>странствующих батраков</w> бродило по пыльным дорогам в поисках сезонной работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "swagman",
                        "tramp"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical term for a traveling laborer."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een rondtrekkende zwerver of arbeider met zijn have en goed in een bundel; een landloper.",
                        "ru": "Бродяга или странствующий сезонный рабочий со своим скарбом в узле."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zwerver",
                                "target_lang_sense_clarification": "rondtrekkend persoon"
                            },
                            {
                                "target_lang_word": "landloper",
                                "target_lang_sense_clarification": "dakloze rondtrekker"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "бродяга",
                                "target_lang_sense_clarification": "человек без постоянного места жительства"
                            },
                            {
                                "target_lang_word": "странствующий батрак",
                                "target_lang_sense_clarification": "сезонный рабочий, переходящий с места на место"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a5a05fb-863b-3db5-82cf-051ad337c0ae",
                    "sense_definition": "Fashionable or trendy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They attended a very <w>swagger</w> party hosted by the local aristocracy.",
                            "target_lang_translations": {
                                "nl": "Ze woonden een heel <w>chique</w> feest bij dat werd georganiseerd door de plaatselijke aristocratie.",
                                "ru": "Они посетили очень <w>шикарную</w> вечеринку, устроенную местной аристократией."
                            }
                        },
                        {
                            "text": "She wore a <w>swagger</w> outfit that was the talk of the evening.",
                            "target_lang_translations": {
                                "nl": "Ze droeg een <w>blitse</w> outfit die het gesprek van de avond was.",
                                "ru": "На ней был <w>щегольской</w> наряд, ставший главной темой разговоров в тот вечер."
                            }
                        }
                    ],
                    "synonyms": [
                        "fashionable",
                        "stylish"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in a 19th-century context."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Modieus, stijlvol of chic.",
                        "ru": "Модный, шикарный или щегольской (устаревшее значение)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "chic",
                                "target_lang_sense_clarification": "stijlvol en elegant"
                            },
                            {
                                "target_lang_word": "blits",
                                "target_lang_sense_clarification": "hip en opvallend"
                            },
                            {
                                "target_lang_word": "stijlvol",
                                "target_lang_sense_clarification": "modieus"
                            }
                        ],
                        "ru": [
                            {
