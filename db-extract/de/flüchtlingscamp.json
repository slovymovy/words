                        "examples": [
                            {
                                "example_id": "dc94d418-64f1-44ba-823b-4eebed780e20",
                                "sense_id": "6c97ccb7-28df-32be-9c62-4c32bba580d7",
                                "text": "„Das Flüchtlingscamp von al-Jaddah ist nur eines und gleichzeitig wie tausende.“"
                            },
                            {
                                "example_id": "7cbef00e-a915-426f-804c-61dbbb41865d",
                                "sense_id": "6c97ccb7-28df-32be-9c62-4c32bba580d7",
                                "text": "„Etwa 8000 Menschen wurden demnach in Gaza seit dem Beginn der Kämpfe am 8. Juli verletzt. Beim Beschuss eines Flüchtlingscamps und neuen israelischen Luftangriffen im Süden des Gazastreifens kamen nach palästinensischen Angaben vom Abend mindestens sechs Menschen ums Leben, darunter ein Kind und eine Frau.“"
                            }
                        ],
