                "senses": [
                    {
                        "sense_id": "95402078-5cd1-365b-a7fc-5756dd58ea74",
                        "entry_id": "cf632045-936d-3e6e-811d-d706d638cf0d",
                        "glosses": [
                            "Zeit, die bis zum Eintreffen eines bestimmten Ereignisses noch vergehen wird; die bis dahin noch zur Verfügung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a78ffb-3687-442f-833d-1616802b4f53",
                                "sense_id": "95402078-5cd1-365b-a7fc-5756dd58ea74",
                                "text": "„Der reiche Aussteiger überträgt, nachdem er kurz über die Ökonomie der Ausbeutung doziert hat, seine Restzeit, über ein Jahrhundert, in einer Mischung aus Blutsbrüdergriff und Handauflegen auf den Proleten Will, dazu schwelgt pastorale Musik.“"
                            },
                            {
                                "example_id": "b5ab6fba-9dca-4691-a778-bb34a83780ab",
                                "sense_id": "95402078-5cd1-365b-a7fc-5756dd58ea74",
                                "text": "„Was dazu führt, dass die Menschlinge sich ihrer Endlichkeit endlich bewusst werden, sich von Gott nicht länger manipulieren lassen und ihre Restzeit zum eigenen Vergnügen und Wohlbefinden zu nutzen wissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
