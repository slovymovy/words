                ],
                "senses": [
                    {
                        "sense_id": "cddbd864-7f91-3fcf-89b9-ebf6383b1080",
                        "entry_id": "563df41b-779e-3dc0-b352-774026098a60",
                        "glosses": [
                            "A member of the FBI."
                        ],
                        "tags": [
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "803bf055-a858-40c3-9b05-844ff3a7949d",
                                "sense_id": "cddbd864-7f91-3fcf-89b9-ebf6383b1080",
                                "text": "He's a Feeb, but he's not my buddy."
                            },
                            {
                                "example_id": "fd6568d3-cb77-48fa-902e-a40e6ab1a3ba",
                                "sense_id": "cddbd864-7f91-3fcf-89b9-ebf6383b1080",
                                "text": "Mark and the agents crowded into the MODIS room, the Feeb in charge looking very annoyed at both me and Mark."
                            },
                            {
                                "example_id": "9ed1dadd-be7a-4c02-8961-f275da1385f2",
                                "sense_id": "cddbd864-7f91-3fcf-89b9-ebf6383b1080",
                                "text": "Was she a Feeb, too ? Why were FBI agents interested in a local boy who had shot his foster father?"
                            }
                        ]
                    }
                ],
