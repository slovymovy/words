                                "target_lang_word": "系列",
                                "target_lang_sense_clarification": "一系列事物"
                            },
                            {
                                "target_lang_word": "多样性",
                                "target_lang_sense_clarification": "种类繁多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7611f919-eaa3-381b-ae3b-e503a2200ae5",
                    "sense_definition": "Any display of the spectrum of colors produced by the refraction of light.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colors_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crystal prism cast a small <w>rainbow</w> onto the white wall.",
                            "target_lang_translations": {
                                "ru": "Хрустальная призма отбросила на белую стену маленькую <w>радугу</w>.",
                                "zh": "水晶棱镜在白墙上投射出一道小小的<w>彩虹</w>。"
                            }
                        },
                        {
                            "text": "Oil on the wet pavement created a shimmering <w>rainbow</w>.",
                            "target_lang_translations": {
                                "ru": "Масло на мокром асфальте создало мерцающую <w>радугу</w>.",
                                "zh": "湿路面上的油渍形成了闪烁的<w>彩虹色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spectrum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое проявление цветового спектра, возникающее при преломлении света.",
                        "zh": "由光线折射产生的任何色彩光谱显示。"
                    },
