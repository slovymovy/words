                "senses": [
                    {
                        "sense_id": "821d44c4-2dee-34d1-bc6b-146b30fb556e",
                        "entry_id": "d52be825-1d03-3b35-bb98-d22dd7d7883c",
                        "glosses": [
                            "is een varken dat in Vietnam en China vaak voorkomt en veel gehouden wordt op kinderboerderijen"
                        ],
                        "tags": [
                            "evenhoevigen",
                            "Sus scrofa vittatus"
                        ],
                        "examples": [
                            {
                                "example_id": "f4365461-f8b1-4432-9ab5-94f0d00c6fbd",
                                "sense_id": "821d44c4-2dee-34d1-bc6b-146b30fb556e",
                                "text": "Ik las het boek Vet! van Inger Boxsem en Wout Jan Balhuizen die openhartige gesprekken voerden met aan obesitas lijdende kinderen, hun ouders en deskundigen. Het bevat hartbrekende verhalen van kinderen over hun onzekerheid, machteloosheid en de wrede reacties uit hun omgeving. Michelle, 11 jaar, vertelt: „In groep 3 werd ik steeds dikker. Toen begon het pesten en dat werd steeds meer. De kinderen zeggen ‘dikzak’ of ‘varken’. Of ze zingen: hangbuikzwijn, hangbuikzwijn, Michelle wil op vakantie, maar de auto is te klein.”"
                            },
                            {
                                "example_id": "08444305-fe5d-44fe-9e73-5bc2197cb772",
                                "sense_id": "821d44c4-2dee-34d1-bc6b-146b30fb556e",
                                "text": "In de Belgische plaats Tessenderlo heerst een hangbuikzwijnenplaag. Afgelopen week zijn er 18 gevangen, terwijl dat er normaal maar één per week is."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8a06762-6bd6-3a3f-bb9b-9fc24247d3a3",
                        "entry_id": "d52be825-1d03-3b35-bb98-d22dd7d7883c",
                        "glosses": [
                            "te dik persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d8d1f897-0e2c-4667-a8d3-a14a7fb13601",
                                "sense_id": "f8a06762-6bd6-3a3f-bb9b-9fc24247d3a3",
                                "text": "De selectiecommissie - Gerard Joling, Danny Rook en Jocye Humblet - zag een bonte stoet huwelijkskandidaten aan zich voorbij trekken die bestond uit aantrekkelijke hunks, doorsnee mannen, 'hangbuikzwijntjes' en zelfs een naar liefde verlangende vrouw."
                            }
                        ]
                    }
