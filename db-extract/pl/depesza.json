                "senses": [
                    {
                        "sense_id": "32e212e3-fd98-345e-a0d8-f85f24d5b515",
                        "entry_id": "e1905fef-4703-3412-b04d-9baa96bbe801",
                        "glosses": [
                            "tekst przesłany telegraficznie, blankiet z tym tekstem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89b0310-18b0-4aa9-8098-ba3d7372fb4f",
                                "sense_id": "32e212e3-fd98-345e-a0d8-f85f24d5b515",
                                "text": "Dostał depeszę, że jego matka ciężko zachorowała i musiał zaraz jechać"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "121d7706-389f-30f6-b448-5032b206fefe",
                        "entry_id": "e1905fef-4703-3412-b04d-9baa96bbe801",
                        "glosses": [
                            "prasowa wiadomość telegraficzna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aeef170-f475-4e41-a14a-89b6522581fc",
                                "sense_id": "121d7706-389f-30f6-b448-5032b206fefe",
                                "text": "W ulicach kupują się rzesze, w mig rozchwytują najświeższe depesze"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "de7aca81-edad-3381-8385-6adfec6a03e3",
                        "entry_id": "e1905fef-4703-3412-b04d-9baa96bbe801",
                        "glosses": [
                            "urzędowa wiadomość, list pilny, dotyczący spraw państwowych"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "08b65c18-41c9-4a4f-a80c-78a4c51535f5",
                                "sense_id": "de7aca81-edad-3381-8385-6adfec6a03e3",
                                "text": "Charakterystycznym (…) jest ustęp końcowy (…) depeszy, napomykający o obawach Repnina, by przez głośne oświadczenie się króla na sejmie na korzyść dysydentów nie narazić jego osoby na zamach ze strony fanatyków"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa3bd3ff-5da5-4027-90d9-45cf5c23749d",
                        "source_entry_id": "e1905fef-4703-3412-b04d-9baa96bbe801",
                        "source_sense_id": "32e212e3-fd98-345e-a0d8-f85f24d5b515",
                        "target_lang_word": "dépêche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépêche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db55120a-a580-383d-b596-4d80e6131464",
                                        "entry_id": "1100fcf3-a9e0-35b0-a8c6-55cdd7ea1e46",
                                        "glosses": [
                                            "Communication officielle ou privée transmise par voie plus ou moins rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ce8f51-5c8b-423f-bc02-0d6cd643d397",
                                                "sense_id": "db55120a-a580-383d-b596-4d80e6131464",
                                                "text": "Ce maquignon se trouve partout où il y a un mauvais cheval à vendre ; il opère de haut et de loin, file un cheval comme un agent filerait un malfaiteur ; il a ses dépêches, son contrôle, ses espions, […]."
                                            },
                                            {
                                                "example_id": "9d5748a8-fa09-486d-95a2-a7e2c21cff5a",
                                                "sense_id": "db55120a-a580-383d-b596-4d80e6131464",
                                                "text": "Le 26 octobre, une dépêche annonça que les Anglais avaient pris Bois-le-Duc après une attaque de nuit exécutée par des chars lance-flammes « au clair de lune artificiel »."
                                            },
                                            {
                                                "example_id": "4fcf4adb-bca6-4c39-9e0b-766dc48ea96a",
                                                "sense_id": "db55120a-a580-383d-b596-4d80e6131464",
                                                "text": "Elle avait fait l’objet d’une dépêche de Tass, article qui n’était plus trouvable sur le site de l’agence d’Etat russe au lendemain de l’attaque terroriste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21b3e125-3d80-38f8-9c74-05e550edc15c",
                                        "entry_id": "1100fcf3-a9e0-35b0-a8c6-55cdd7ea1e46",
                                        "glosses": [
                                            "Communication transmise par voie télégraphique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47ae2058-aa84-428d-9bf5-80b0a30e7197",
                                                "sense_id": "21b3e125-3d80-38f8-9c74-05e550edc15c",
                                                "text": "Pontagnac. — Mais envoyez une dépêche pour qu’on vous retienne une chambre pour ce soir.\nVatelin. — Merci, cher ami, merci !… Je vais télégraphier tout de suite… et à la personne également pour l’avertir et lui dire de demander la chambre à mon nom."
                                            },
                                            {
                                                "example_id": "d5e56018-1e9c-453c-b2aa-3ab5bb3bf1bb",
                                                "sense_id": "21b3e125-3d80-38f8-9c74-05e550edc15c",
                                                "text": "Les antennes de l'appareil étaient toutes secouées, dans la nuit, d'une vibration puissante, et le récepteur enregistrait à mesure les mots d'une dépêche en langue espagnole lancée par la station de Nauen […]."
                                            },
                                            {
                                                "example_id": "79402eaf-7fbe-425d-b6a1-f11cf8e60a86",
                                                "sense_id": "21b3e125-3d80-38f8-9c74-05e550edc15c",
                                                "text": "Un homme était debout sur le seuil. Je l’entrevis dans l’ombre, me tendant quelque chose que j’hésitais à prendre.\n— C’est une dépêche, dit-il.\n— Une dépêche, grand Dieu ! pour quoi faire ?\nJe la pris en frissonnant, et déjà je repoussais la porte ; mais l’homme la retint avec son pied et me dit froidement :\n— Il faut signer.\nIl fallait signer ! Je ne savais pas, c’était la première dépêche que je recevais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8239186e-265c-3abb-90b0-b3f58b3e41f1",
                                        "entry_id": "1100fcf3-a9e0-35b0-a8c6-55cdd7ea1e46",
                                        "glosses": [
                                            "Message."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77c5903e-3ebb-4876-8ea4-0a0d7f3fc417",
                                                "sense_id": "8239186e-265c-3abb-90b0-b3f58b3e41f1",
                                                "text": "Le comte Wilczek fit confectionner une quantité de petits ballons en caoutchouc qu'on distribua, munis de dépêches, aux baleiniers en partance pour les mers du nord, afin que ceux-ci les lâchassent dans diverses stations de ces parages ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e44c9b-386e-3f43-bf80-145605fea19f",
                                        "entry_id": "1100fcf3-a9e0-35b0-a8c6-55cdd7ea1e46",
                                        "glosses": [
                                            "Expédition, voyage, souvent dans un but scientifique."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
