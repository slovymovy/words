                ],
                "senses": [
                    {
                        "sense_id": "c540a937-5bcd-370d-bf3d-5f727ab19084",
                        "entry_id": "bc6d6732-0acd-3769-a3a5-a232908bbd18",
                        "glosses": [
                            "handliches Haushaltsgerät mit weichen, dünnen Borsten, Federn oder dergleichen zum Entfernen von Staub oder Schmutz, häufig an schwer erreichbaren Stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00e287ff-5eaa-4e2a-9e04-f67b083bbf4e",
                                "sense_id": "c540a937-5bcd-370d-bf3d-5f727ab19084",
                                "text": "„Mit dem Staubmagneten hat eines der beliebtesten Wegwerfprodukte im Bereich des Reinigens Einzug in unsere Wohnzimmer erhalten.“"
                            },
                            {
                                "example_id": "5f3c09f4-ee91-47cf-b017-c1bd6e70dca8",
                                "sense_id": "c540a937-5bcd-370d-bf3d-5f727ab19084",
                                "text": "„Meine Studentenbude sah dagegen porentief rein aus. Kannte sie keinen Staubsauger, Staubmagneten, Putzlappen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6cd28a7-ee82-3fbf-a592-818629ea8ea3",
                        "entry_id": "bc6d6732-0acd-3769-a3a5-a232908bbd18",
                        "glosses": [
                            "Stelle, wo sich besonders viel Staub schnell ansammelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "364b0f5f-0b39-472c-ab1e-4ea0571a49a3",
                                "sense_id": "e6cd28a7-ee82-3fbf-a592-818629ea8ea3",
                                "text": "„Der Raum war der reinste Staubmagnet – von den Mäusen, die es auf die Krümel zwischen den Sofakissen abgesehen hatten, ganz zu schweigen.“"
                            },
                            {
                                "example_id": "726acd7c-fafc-406e-ba60-0093adf1c60d",
                                "sense_id": "e6cd28a7-ee82-3fbf-a592-818629ea8ea3",
                                "text": "„Aber vielleicht gibt es ein paar Ecken, die übersehen werden – regelmäßig. Und Bücher sind Staubmagneten.“"
                            },
                            {
                                "example_id": "b2ed3ae9-2227-4c6d-b6b4-3148e44f6af6",
                                "sense_id": "e6cd28a7-ee82-3fbf-a592-818629ea8ea3",
                                "text": "„In trockenen Umgebungen werden Objektiv und Kamera zu Staubmagneten.“"
                            },
                            {
                                "example_id": "6013596a-9502-4948-9de8-2996d222e8b5",
                                "sense_id": "e6cd28a7-ee82-3fbf-a592-818629ea8ea3",
                                "text": "„Der Schuhkarton war wohl der Staubmagnet der Wohnung, aller Staub hatte sich darauf angesammelt.“"
                            },
                            {
                                "example_id": "c66e8715-1d5b-4048-a145-ee9b15df0f4b",
                                "sense_id": "e6cd28a7-ee82-3fbf-a592-818629ea8ea3",
                                "text": "„Die verschnörkelten Schnitzereien waren der reinste Staubmagnet, und egal wie sie ihn abwischte, er war nie staubfrei […].“"
                            },
                            {
                                "example_id": "6d2b3990-6b03-4e8d-b9e2-c76d439e48ff",
                                "sense_id": "e6cd28a7-ee82-3fbf-a592-818629ea8ea3",
                                "text": "„[…] [W]enn Ihr Büro nicht gerade mit einem ausgefeilten Luftreinigungssystem ausgestattet ist, dann ist Ihr Mac auch ein wunderbarer Staubmagnet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
