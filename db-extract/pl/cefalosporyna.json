                                    {
                                        "sense_id": "d9b705d4-173e-3440-be57-859f59221c28",
                                        "entry_id": "28d9bcc6-fec6-331e-9dab-ed43c52c4ead",
                                        "glosses": [
                                            "Any of a class of natural and synthetic antibiotics developed from Acremonium fungi, having a cepham structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7891220b-fed8-426e-b2ea-686ff744e4de",
                                                "sense_id": "d9b705d4-173e-3440-be57-859f59221c28",
                                                "text": "Another important group of antibiotics, the cephalosporins, a class that includes more than twenty-five different drugs, are chemically distinct from the penicillins but act in the same way as cell wall inhibitors, as do vancomycin and bacitracin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
