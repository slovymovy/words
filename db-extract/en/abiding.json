                    {
                        "translation_id": "b4d269e7-0010-4d5f-bd60-57962f8f80c4",
                        "source_entry_id": "b226ff67-e1eb-3c0d-b7a2-8209cea4edf5",
                        "source_sense_id": "6f392902-c97e-3915-9e34-7a1002d8c90b",
