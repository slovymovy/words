                ],
                "senses": [
                    {
                        "sense_id": "4a976110-94f2-39d5-a09f-5501ff921eda",
                        "entry_id": "ab115577-9337-36cb-81cc-1e8e91a4c3e8",
                        "glosses": [
                            "Barbouiller ; salir."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "ea6c4384-e3f2-49c9-8cea-60722e93d6eb",
                                "sense_id": "4a976110-94f2-39d5-a09f-5501ff921eda",
                                "text": "Arrivée dans la boutique, repérable à ses volets verts où, sur panneau émaillé, toute la famille Delespaul-Havez se délectait, se salissait, s’embarbouillait de coulées de chocolat fondu, Isabelle s’impatienta."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f5b47cf-c49a-32b4-85de-0b7765f30efc",
                        "entry_id": "ab115577-9337-36cb-81cc-1e8e91a4c3e8",
                        "glosses": [
                            "Devenir flou ou confus, embrouiller, brouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c6024b9-a26e-47bc-b7e3-801481b810ea",
                                "sense_id": "6f5b47cf-c49a-32b4-85de-0b7765f30efc",
                                "text": "Eh bian ! le vlà encore embarbouillé dans les épousailles."
                            },
                            {
                                "example_id": "3953bcc2-0de4-4317-9ca3-ee68c72868c7",
                                "sense_id": "6f5b47cf-c49a-32b4-85de-0b7765f30efc",
                                "text": "Le nom même de Dieu, ce diable de vieux mot qui embarbouille l’esprit et nuit à sa clarté suprême, M. Louis-Auguste Martin ne l’a pas même écrit, par distraction, une seule fois."
                            },
                            {
                                "example_id": "cb05d0e5-8323-47a4-b905-b9785cc32a22",
                                "sense_id": "6f5b47cf-c49a-32b4-85de-0b7765f30efc",
                                "text": "Tout l’après-midi, les crêpes sautent, elle en offre aux clients du café les plus fidèles, j’ai les mains perlées de sucre et l’estomac embarbouillé, ce soir on ne soupera pas."
                            },
                            {
                                "example_id": "c4d38e64-6449-4169-a66b-5df9c102042e",
                                "sense_id": "6f5b47cf-c49a-32b4-85de-0b7765f30efc",
                                "text": "J’ai besoin qu’un acteur soit d’une grande vivacité, qu’on ne soit pas obligé de tout expliquer, qu’on ne s’embarbouille pas dans de faux problèmes psychologiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c7c7f5e-34d8-4ac6-ab23-428dd28834fc",
                        "source_entry_id": "ab115577-9337-36cb-81cc-1e8e91a4c3e8",
                        "source_sense_description": "barbouiller, salir",
                        "target_lang_word": "lúng túng",
