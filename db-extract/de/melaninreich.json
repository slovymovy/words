                ],
                "senses": [
                    {
                        "sense_id": "076c6151-6252-37a8-9dce-9e7bfc941e3d",
                        "entry_id": "ab668239-4b3d-3211-958f-33460b782fa5",
                        "glosses": [
                            "viel Melanin enthaltend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81204bf-c266-454e-92a5-c2ec140be0ae",
                                "sense_id": "076c6151-6252-37a8-9dce-9e7bfc941e3d",
                                "text": "„Bei der histologischen Untersuchung fand sich ein ungewöhnlich melaninreiches Geschwulstgewebe vom Typ des Melanomalignoms.“"
                            },
                            {
                                "example_id": "c3e59e98-e67c-4927-83fa-9f6489425142",
                                "sense_id": "076c6151-6252-37a8-9dce-9e7bfc941e3d",
                                "text": "„Manchmal sind diese Zellen rundlich, aber melaninreich, dies ist der ‚zelluläre‘ blaue Naevus.“"
                            },
                            {
                                "example_id": "4f8608e4-94e4-4c01-835b-6f79874211da",
                                "sense_id": "076c6151-6252-37a8-9dce-9e7bfc941e3d",
                                "text": "„Die Melanophoren der Epidermis produzieren melaninreiche Granula (Melanosomen), und diese werden von den Keratinocyten phagozytiert.“"
                            },
                            {
                                "example_id": "b4c63ed3-c1d6-41a9-b9fb-b36aaf255ee7",
                                "sense_id": "076c6151-6252-37a8-9dce-9e7bfc941e3d",
                                "text": "„Äquatoriale Menschen entwickelten eine dunkle melaninreiche Haut, welche sie vor zuviel Sonne schützte, aber genügend für die Vitamin-D-Produktion durchliess.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
