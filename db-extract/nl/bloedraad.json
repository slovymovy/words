                    {
                        "sense_id": "d2f8dd1a-ef76-3e84-a10f-1009da196310",
                        "entry_id": "481bc832-478a-3c17-a014-54b9829efbfc",
                        "glosses": [
                            "groep mensen die zeer strenge oordelen velt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4d412836-e812-463b-98f7-cb0c129105b4",
                                "sense_id": "d2f8dd1a-ef76-3e84-a10f-1009da196310",
                                "text": "De roddelende buurvrouwen leken wel een bloedraad zo streng oordeelden ze over de de vrouw die haar ramen niet had gewassen."
                            },
                            {
                                "example_id": "269ce52d-874e-410c-af43-1c34ad1dcb9b",
                                "sense_id": "d2f8dd1a-ef76-3e84-a10f-1009da196310",
                                "text": "De lerarenvergadering van de school werd door de leerlingen de bloedraad genoemd omdat de leraren veel leerlingen niet lieten overgaan naar de volgende klas."
                            },
                            {
                                "example_id": "b724f75e-e9d1-4c7b-be48-6478b0c8c69e",
                                "sense_id": "d2f8dd1a-ef76-3e84-a10f-1009da196310",
                                "text": "Bijna begon ik medelijden te krijgen met Rik baron van Slingelandt, toen hij zat te zweten voor een bloedraad van illustere Kamerleden als daar zijn Teun van Dijck (PVV), Aukje de Vries (?), Henk (?) Nijboer (PvdA), (?) Merkies (SP) en het groentje Klaver."
                            }
                        ]
                    }
