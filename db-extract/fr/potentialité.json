                ],
                "senses": [
                    {
                        "sense_id": "18fce74f-0c41-30ab-a010-fc0e3d29875c",
                        "entry_id": "78005466-c6f4-3a9f-bd83-446470679155",
                        "glosses": [
                            "État de ce qui existe en puissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d635e0b-4e31-4158-8e5c-04a4d23ee041",
                                "sense_id": "18fce74f-0c41-30ab-a010-fc0e3d29875c",
                                "text": "A l’élément de la potentialité correspond un principe de détermination complète."
                            },
                            {
                                "example_id": "d938f137-0e82-43c9-9333-2f0ebb84ffe7",
                                "sense_id": "18fce74f-0c41-30ab-a010-fc0e3d29875c",
                                "text": "Avec la vogue du récréotourisme, la population locale prend conscience des autres potentialités du lac et des contraintes imposées par le mode d'exploitation industrielle de cette ressource naturelle."
                            },
                            {
                                "example_id": "8d453abf-472b-44bf-bf55-e1210af3b0eb",
                                "sense_id": "18fce74f-0c41-30ab-a010-fc0e3d29875c",
                                "text": "Le technicien s'oppose par là même aux utilisateurs lambda, qui, même s'ils manient une technique, n'ont souvent pas une idée bien nette de sa complexité ni de toutes ses potentialités."
                            },
                            {
                                "example_id": "f7a77f0a-daa9-43cd-9ce9-4b40328218b4",
                                "sense_id": "18fce74f-0c41-30ab-a010-fc0e3d29875c",
                                "text": "Le premier appel à propositions a permis d’expérimenter les potentialités de cette approche en l’appliquant à des bâtiments isolés ; la deuxième session a étendu la réflexion à des ensembles de bâtiments pour mutualiser les équipements et tenter de rendre viable l’économie des projets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4940601b-8b2c-49d5-9853-ac2d889c6cb1",
                        "source_entry_id": "78005466-c6f4-3a9f-bd83-446470679155",
                        "source_sense_id": "18fce74f-0c41-30ab-a010-fc0e3d29875c",
