                                        "examples": [
                                            {
                                                "example_id": "1ab08f09-3e63-4092-8de5-e6e2fead8a8b",
                                                "sense_id": "1ea6f4d5-9c11-3597-973c-dd5a04931e03",
                                                "text": "The deceased was interred in his local churchyard."
                                            },
                                            {
                                                "example_id": "8d786a54-0d69-420a-8233-a23122920dca",
                                                "sense_id": "1ea6f4d5-9c11-3597-973c-dd5a04931e03",
                                                "text": "a memorial to the deceased of two World Wars"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f86f54-fbca-3e66-a127-08191eac413b",
                                        "entry_id": "b683b23d-8bf8-361b-b7ec-df5f6053a285",
                                        "glosses": [
                                            "One who has died. In property law, the alternate term decedent is generally used in US English. In criminal law, “the deceased” refers to the victim of a homicide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a8eb54a-bc30-4242-8109-a5430678f6b8",
                                                "sense_id": "f9f86f54-fbca-3e66-a127-08191eac413b",
                                                "text": "Deceased had already made a will in his favour before her marriage, but—and Mr. Philips wagged an expressive forefinger—the prisoner was not aware of that. What had induced the deceased to make a fresh will, with the old one still extant, he could not say."
                                            }
                                        ]
                                    }
                                ]
                            }
