                        {
                            "text": "Le professeur parle lentement pour que tous les étudiants puissent bien <w>comprendre</w> la leçon.",
                            "target_lang_translations": {
                                "en": "The teacher speaks slowly so that all the students can properly <w>understand</w> the lesson.",
                                "ru": "Преподаватель говорит медленно, чтобы все студенты могли хорошо <w>понять</w> урок.",
                                "nl": "De docent spreekt langzaam zodat alle studenten de les goed kunnen <w>begrijpen</w>.",
                                "de": "Der Lehrer spricht langsam, damit alle Studierenden die Lektion gut <w>verstehen</w> können.",
                                "pl": "Nauczyciel mówi powoli, żeby wszyscy studenci mogli dobrze <w>zrozumieć</w> lekcję.",
                                "it": "Il professore parla lentamente affinché tutti gli studenti possano <w>capire</w> bene la lezione.",
                                "cs": "Učitel mluví pomalu, aby všichni studenti mohli lekci dobře <w>pochopit</w>.",
                                "tr": "Öğretmen, bütün öğrencilerin dersi iyi <w>anlayabilmesi</w> için yavaş konuşuyor.",
                                "es": "El profesor habla despacio para que todos los estudiantes puedan <w>entender</w> bien la lección.",
                                "zh": "老师讲得很慢，好让所有学生都能<w>理解</w>这节课的内容。"
                            }
                        },
                        {
                            "text": "Je ne <w>comprends</w> pas cette phrase parce qu'elle contient plusieurs mots inconnus.",
                            "target_lang_translations": {
                                "en": "I don't <w>understand</w> this sentence because it contains several unfamiliar words.",
                                "ru": "Я не <w>понимаю</w> это предложение, потому что в нём несколько незнакомых слов.",
                                "nl": "Ik <w>begrijp</w> deze zin niet omdat hij meerdere onbekende woorden bevat.",
                                "de": "Ich <w>verstehe</w> diesen Satz nicht, weil er mehrere unbekannte Wörter enthält.",
                                "pl": "Nie <w>rozumiem</w> tego zdania, ponieważ zawiera kilka nieznanych słów.",
                                "it": "Non <w>capisco</w> questa frase perché contiene parecchie parole sconosciute.",
                                "cs": "Této větě <w>nerozumím</w>, protože obsahuje několik neznámých slov.",
                                "tr": "Bu cümleyi <w>anlamıyorum</w>, çünkü içinde birkaç bilmediğim kelime var.",
                                "es": "No <w>entiendo</w> esta frase porque contiene varias palabras desconocidas.",
                                "zh": "这个句子里有好几个生词，我没法<w>理解</w>。"
                            }
