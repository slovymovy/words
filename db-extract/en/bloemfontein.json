                                        "sense_id": "93768a94-8629-3137-a584-b6b031665800",
                                        "entry_id": "a4c1d6ec-8af8-3be8-86c5-837a7862af11",
                                        "glosses": [
                                            "Hauptstadt der südafrikanischen Provinz Freistaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87388587-cf8b-4804-a9d6-4df51a608a25",
                                                "sense_id": "93768a94-8629-3137-a584-b6b031665800",
                                                "text": "„Grundlage dieser Untersuchung ist der umfangreiche Nachlass von Hendrik Verwoerd, der zum größten Teil im Archive for Contemporary Affairs an der University of the Free State in Bloemfontein aufbewahrt wird.“"
                                            },
                                            {
                                                "example_id": "99c036e8-d4c0-422c-bbf9-20279782b9ca",
                                                "sense_id": "93768a94-8629-3137-a584-b6b031665800",
                                                "text": "„Ihr Vater ließ sie alle im Hotelzimmer niederknien und betete für sie, ein langes, dramatisches Gebet, von dem ihm der Schweiß auf der gerunzelten Stirn ausbrach und das sich detailiert mit der Verderbtheit Bloemfonteins auseinandersetzte.“"
                                            },
                                            {
                                                "example_id": "ca21463f-e1f7-4850-9f44-61867beadf21",
                                                "sense_id": "93768a94-8629-3137-a584-b6b031665800",
                                                "text": "„Das Orange Hotel in Bloemfontein, Südafrika, steht an der High Street in Bahnhofsnähe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
