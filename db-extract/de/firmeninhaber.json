                "senses": [
                    {
                        "sense_id": "6f85d078-2051-3a5a-9add-36bbf2c2e236",
                        "entry_id": "ebd7f845-158a-35e2-967f-7986af49cb3c",
                        "glosses": [
                            "Person, die eine Firma besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0000adb-e2d6-41a5-ae3a-5bd8bf9105e2",
                                "sense_id": "6f85d078-2051-3a5a-9add-36bbf2c2e236",
                                "text": "„Wie kann das leitende Personal eines Unternehmens sowie auch Firmeninhaberinnen und Firmeninhaber den Lernprozess aus Unternehmenskrisen positiv beeinflussen?“"
                            },
                            {
                                "example_id": "d05508ae-a222-4a26-ac00-903dc12e6a89",
                                "sense_id": "6f85d078-2051-3a5a-9add-36bbf2c2e236",
                                "text": "„Über diese Maßnahme beschwerte sich der Firmeninhaber beim Ordnungsamt und beim Bürgermeister persönlich.“"
                            },
                            {
                                "example_id": "a270ac00-7212-4cbe-9f38-bfc0748c74f3",
                                "sense_id": "6f85d078-2051-3a5a-9add-36bbf2c2e236",
                                "text": "„In dieser Phase arbeiten der aktuelle Firmeninhaber und der potenzielle Nachfolger einige Zeit (ein paar Wochen) zusammen im Betrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
