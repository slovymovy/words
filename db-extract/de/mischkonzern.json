                        "form": "den Mischkonzern"
                    },
                    {
                        "form_id": "c7c99ce6-8edc-412d-adef-0c15a245f432",
                        "entry_id": "a07eb041-c5ac-3632-8888-0ae4c8f1cb4d",
                        "tags": [
                            "accusative",
