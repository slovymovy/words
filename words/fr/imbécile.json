                        "bande d'imbéciles"
                    ]
                },
                {
                    "sense_id": "0e4c8082-9581-33a6-9d4f-e79321253f3f",
                    "sense_definition": "Personne atteinte d'une déficience intellectuelle congénitale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medecine_ancienne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les traités de psychiatrie du dix-neuvième siècle, on désignait parfois ce patient comme un <w>imbécile</w>."
                        },
                        {
                            "text": "L'hospice accueillait plusieurs <w>imbéciles</w> que les familles ne pouvaient plus prendre en charge."
                        }
                    ],
                    "synonyms": [
                        "arriéré"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme médical désuet et péjoratif"
                        }
                    ]
                }
            ]
        },
