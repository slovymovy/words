                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0d7380-e466-3648-a0d5-f8b2a5d6c991",
                                        "entry_id": "b7aa2f8f-03ec-3633-a299-7431ae3c042f",
                                        "glosses": [
                                            "A female given name from Latin, masculine equivalent Claudius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9c5566-ffd9-4517-8346-4ffbf152e6df",
                                                "sense_id": "ea0d7380-e466-3648-a0d5-f8b2a5d6c991",
                                                "text": "Make ſpede to come befoꝛe winter. Eubolus gretith the / and Pudes / and Linus / and Claudia / and all the bꝛethꝛen."
                                            },
                                            {
                                                "example_id": "9b463e3d-5d73-42a1-92c9-85bb09624275",
                                                "sense_id": "ea0d7380-e466-3648-a0d5-f8b2a5d6c991",
                                                "text": "Claudia is really Mummy, but she does not like being Mummy so you have to say Claudia. […] Lisa is a better name. Claudia bangs, like the gong in the hall at Sotleigh. Bang – whoom! Lisa makes a nice silky noise, like streams or rain."
                                            },
                                            {
                                                "example_id": "50018fe4-8452-4335-9d7a-9852876ffbe8",
                                                "sense_id": "ea0d7380-e466-3648-a0d5-f8b2a5d6c991",
                                                "text": "Mexico’s presidential campaign is well underway and if the polls are to be believed, Claudia Sheinbaum, a physicist and candidate of the left-leaning ruling Morena party, could be the country’s next president."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
