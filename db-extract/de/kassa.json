                ],
                "senses": [
                    {
                        "sense_id": "4721e881-af70-3ef2-8ea3-2b4f63146b8f",
                        "entry_id": "b548485b-c77a-351e-88a5-aef8a36c9f31",
                        "glosses": [
                            "Kasse"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "02df2c87-8d26-4bb0-bd79-6a65ce9de485",
                                "sense_id": "4721e881-af70-3ef2-8ea3-2b4f63146b8f",
                                "text": "„Die Klägerin hat nur vorgebracht, daß sie die Waren an der Kassa zu bonieren, nach Maßgabe der Bons abzurechnen und für Fehlbeträge aufzukommen habe.“"
                            },
                            {
                                "example_id": "e612c1a1-590b-4578-844e-9e77e4ac20ff",
                                "sense_id": "4721e881-af70-3ef2-8ea3-2b4f63146b8f",
                                "text": "„Andere Banken heben Gebühren bei der Bareinzahlung an der Kassa ein.“"
                            },
                            {
                                "example_id": "c8cc4279-43e5-4295-9863-ebbad8df4f75",
                                "sense_id": "4721e881-af70-3ef2-8ea3-2b4f63146b8f",
                                "text": "„Sei es durch die Kassa selbst, sei es privat, wenn eine kräftige Beitragssenkung den Beitragszahlern wieder mehr Luft dafür gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
