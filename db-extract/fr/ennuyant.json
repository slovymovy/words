                "entry_id": "5836d1c6-e67c-3de8-959a-4a8dd1bce506",
                "word": "ennuyant",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "40b20b66-72a8-45a1-a10e-1d0227199f12",
                        "entry_id": "5836d1c6-e67c-3de8-959a-4a8dd1bce506",
                        "tags": [
