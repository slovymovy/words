                ],
                "senses": [
                    {
                        "sense_id": "10dff3c3-2203-3b66-baba-5afa1708f698",
                        "entry_id": "9dacdddb-bcfe-370a-9f23-80554ce1be04",
                        "glosses": [
                            "zonder enige waarde, onbeduidend, onbelangrijk, pet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202254ad-86aa-455a-bce4-f69856aef94f",
                                "sense_id": "10dff3c3-2203-3b66-baba-5afa1708f698",
                                "text": "\"Tussen stront en pis worden wij geboren,\" zei Augustinus, \"dus óf we zijn net zo nietswaardig als stront en pis, óf stront en pis zijn van hetzelfde gehalte als waar we ons zelf voor aanzien.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "2836330d-e5db-3478-ad48-c57694d46ae5",
                        "entry_id": "9dacdddb-bcfe-370a-9f23-80554ce1be04",
                        "glosses": [
                            "slecht, gemeen, zondig, onwaardig, miserabel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6365be9-3b1b-4d72-aa30-4c7adf0214cc",
                                "sense_id": "2836330d-e5db-3478-ad48-c57694d46ae5",
                                "text": "De hoofdpersoon uit de roman heeft een dubbele moord gepleegd, op een oude woekeraarster en op haar zuster. De slachtoffers zijn niet bepaald kroonjuwelen van de menselijke soort en niemand zal ze missen. Omdat niemand Raskolnikov heeft gezien bij het plegen van zijn daad zou hij gewoon kunnen doorleven, maar Raskolnikov wordt overmand door wroeging en geeft zichzelf aan. Hij beseft dat hij geen Übermensch is, maar even nietswaardig als alle andere mensen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f387e3a-e129-40a6-b9c8-67b3a596dbcf",
                        "source_entry_id": "9dacdddb-bcfe-370a-9f23-80554ce1be04",
