                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ebac7f0-ea71-3ed9-8480-efcab0cbfce4",
                        "entry_id": "28978c91-2992-3159-b8fa-f9741d71b765",
                        "glosses": [
                            "Hauptstadt der Ukraine sowie Hauptort und Verwaltungssitz der Oblast Kiew"
                        ],
                        "tags": [
                            "Austrian German",
                            "Germany",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "deb7c977-d2f3-43ed-b815-b8691bff38fa",
                                "sense_id": "6ebac7f0-ea71-3ed9-8480-efcab0cbfce4",
                                "text": "Kiew liegt am Dnepr."
                            },
                            {
                                "example_id": "96bca883-b9c8-4d95-a64d-6a4d43a2f7e1",
                                "sense_id": "6ebac7f0-ea71-3ed9-8480-efcab0cbfce4",
                                "text": "„Auf der Flucht vor dem Krieg kamen Hunderttausende Polen nach Kiew und machten Kiew für ein paar Jahre zu einer lebendigen polnischen Stadt.“"
                            },
                            {
                                "example_id": "2d774fed-0270-472b-a722-1d2d306b0c7e",
                                "sense_id": "6ebac7f0-ea71-3ed9-8480-efcab0cbfce4",
                                "text": "„Jetzt, da in Kiew kriegsähnliche Zustände herrschten, starb Olga tausend Tode, wenn ihr dreiundzwanzigjähriger Enkel das Haus verließ.“"
                            },
                            {
                                "example_id": "0e077081-bf13-4b7e-bcba-f1c705122aa2",
                                "sense_id": "6ebac7f0-ea71-3ed9-8480-efcab0cbfce4",
                                "text": "„Er hatte sich nach Kiew aufgemacht in der Hoffnung, etwas Essbares heimzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
