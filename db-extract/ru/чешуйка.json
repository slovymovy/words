                                    },
                                    {
                                        "sense_id": "018e1329-77a5-38d5-b7ed-1fed14d08f36",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Teinture rouge que les relieurs utilisent pour colorer la tranche des livres."
                                        ],
                                        "tags": [
                                            "Reliure"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e9d07ae-f755-390a-800b-65397217eda8",
