                                        "glosses": [
                                            "A province of Pakistan. Capital: Quetta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78cfe1a4-6aee-418a-a1ed-737a5aab7621",
                        "source_entry_id": "8141f2c8-ae7d-3dbc-bdea-c23746ddd9f5",
