                        "glosses": [
                            "door vorming (ook van karakter, geest, smaak etc.) ontstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ec28f6-824a-475c-aeab-2965042d4eaf",
                                "sense_id": "b4f970b9-f993-34fa-b5cb-a91b3efa4469",
                                "text": "Te koop is deze bijzonder fraai gevormde gekleurde glazen vaas."
                            },
                            {
                                "example_id": "6a1569be-a6cb-42bb-b6d2-44c355b4d182",
                                "sense_id": "b4f970b9-f993-34fa-b5cb-a91b3efa4469",
                                "text": "Een beeldschone jonge vrouw, elegante verschijning, gitzwarte haren en koolzwarte amandelvormige ogen, een slank figuur en mooi gevormde handen, een olijfkleurige huid."
                            }
                        ]
                    }
