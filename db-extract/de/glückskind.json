                            },
                            {
                                "target_word": "veinard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7fd5549-4897-3a8f-8a49-07ae1738d5b3",
                                        "entry_id": "b2b931b3-57b5-3b88-97ae-6d9dbc4e872a",
                                        "glosses": [
                                            "Personne qui a de la chance, de la veine."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5837537-da0f-47ef-a465-84a032e15930",
                                                "sense_id": "a7fd5549-4897-3a8f-8a49-07ae1738d5b3",
                                                "text": "C'est un fameux veinard"
                                            },
                                            {
                                                "example_id": "7938040e-034b-4037-8eed-f059a99f86b3",
                                                "sense_id": "a7fd5549-4897-3a8f-8a49-07ae1738d5b3",
                                                "text": "Et les autres s’exclamaient, les traitant de veinards, affectant d’envier leur bonheur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "veinard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "487a3cb7-5b44-3aa1-ac9c-17ce7e2b1dd9",
                                        "entry_id": "c2b18278-5cac-3a4b-9a3d-67015cca6550",
                                        "glosses": [
                                            "Relatif à Vennes, commune du Doubs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "363eac28-c331-472c-b148-d82af5718ac3",
                        "source_entry_id": "fcbcf8eb-7498-3283-bc53-5985a763717a",
                        "source_sense_id": "fd085e1c-7f08-3f5c-8dae-fb88faa02f1f",
                        "source_sense_description": "eine Person, die oft Glück hat",
                        "target_lang_word": "chanceux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanceux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0699b617-5006-3aa8-95fa-a965c7633f37",
                                        "entry_id": "43d8e187-020c-3a3a-9502-266852b61547",
                                        "glosses": [
                                            "Qui est favorisé par la chance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda0cb0d-b8ee-4336-9ea0-d0446842d19c",
                                                "sense_id": "0699b617-5006-3aa8-95fa-a965c7633f37",
                                                "text": "Dans cette lutte, naturellement, les plus forts et les plus chanceux devaient vaincre, et, de différentes manières, exploiter et opprimer les vaincus."
                                            },
                                            {
                                                "example_id": "f2fbf3ca-999c-4f6f-ba53-0e2d5a0e324e",
                                                "sense_id": "0699b617-5006-3aa8-95fa-a965c7633f37",
                                                "text": "« Mon pauvre Juste, vous n’avez pas eu une vie chanceuse. »"
                                            },
                                            {
                                                "example_id": "405cc29a-d451-490e-8b55-cacaf3ccff48",
                                                "sense_id": "0699b617-5006-3aa8-95fa-a965c7633f37",
                                                "text": "Paul Jean se considère particulièrement chanceux de pouvoir mettre à profit son expertise au quotidien, et ce, six mois par année."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2417244-049b-33e0-b81b-71e4faeda8f8",
                                        "entry_id": "43d8e187-020c-3a3a-9502-266852b61547",
                                        "glosses": [
                                            "Qui dépend de la chance, aléatoire."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "416ad0da-7d10-47f4-a3ff-fbbb202816f1",
                                                "sense_id": "b2417244-049b-33e0-b81b-71e4faeda8f8",
                                                "text": "La pêche au bord de la mer, quand on n’a ni barque ni filets et qu’on ne peut la faire qu’aux engins ou à la ligne, est un chanceux métier."
                                            },
                                            {
                                                "example_id": "0e2a86ed-41a0-4788-a4e4-7df7c1f352a9",
                                                "sense_id": "b2417244-049b-33e0-b81b-71e4faeda8f8",
                                                "text": "Il était donc quelqu’un, et sa fortune n’était point due uniquement à un heureux concours de circonstances et de combinaisons chanceuses."
                                            },
                                            {
                                                "example_id": "ca703b09-5106-440f-b9c7-e93c6b12a2c3",
                                                "sense_id": "b2417244-049b-33e0-b81b-71e4faeda8f8",
                                                "text": "Restait l’emploi de la dynamite, toujours bien chanceux, car il paraissait impossible que Herr Schultze eût disparu sans semer d’embûches le terrain qu’il abandonnait."
                                            },
                                            {
                                                "example_id": "9ab72e1c-45b2-4919-ab31-ddfaa801688d",
                                                "sense_id": "b2417244-049b-33e0-b81b-71e4faeda8f8",
                                                "text": "Le capitaine Burton lui-même, le célèbre explorateur du continent noir, y a échoué en 1872. « Les explorations en Islande sont, dit-il, aussi chanceuses que celles de l'Afrique centrale, et le voyageur doit s'attendre à y être le jouet de circonstances auxquelles il ne peut absolument rien. »"
                                            },
                                            {
                                                "example_id": "63ff59b0-fb3e-426d-8a0b-00a160a345fb",
                                                "sense_id": "b2417244-049b-33e0-b81b-71e4faeda8f8",
                                                "text": "Fonsègue causait diamants, disait que c’étaient là des valeurs bien chanceuses, depuis que la science, grâce au four électrique, touchait au jour où la fabrication pouvait en devenir courante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chanceux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "643a7e72-f5cd-35d5-b27c-d8bb5e06e734",
                                        "entry_id": "c92796b4-39ea-3d6d-bc52-28345ecb25f3",
                                        "glosses": [
                                            "Personne favorisée par la chance."
                                        ],
                                        "tags": [
                                            "Par substantivation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d16835b-a281-4c87-9ad5-2d35df03e7cf",
                                                "sense_id": "643a7e72-f5cd-35d5-b27c-d8bb5e06e734",
                                                "text": "Les chanceux sont du groupe A, car ils sont considérés comme ordonnés, perfectionnistes, ou du groupe O (donneur universel), dotés de qualités de leaders. (journal metro, édition Paris, nᵒ 928 du 7 avril 2006)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
