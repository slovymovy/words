                        "sense_id": "437b7abf-9ec7-3c94-9feb-a06d48652dcf",
                        "entry_id": "03779016-56ed-31cb-9f27-7c478040707e",
                        "glosses": [
                            "węgierska potrawa jednogarnkowa z pokrojonych na kawałki papryki, pomidorów i cebuli, często z dodatkiem boczku lub kiełbasy, duszonych z przyprawami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58fafeae-e725-4d19-8c5d-da5bacf437f5",
                                "sense_id": "437b7abf-9ec7-3c94-9feb-a06d48652dcf",
                                "text": "Leczo świetnie smakuje podane z chrupiącą bagietką lub ryżem."
                            },
                            {
                                "example_id": "d1301d9f-9574-4fcd-9e5c-f26fe88ef7d6",
                                "sense_id": "437b7abf-9ec7-3c94-9feb-a06d48652dcf",
                                "text": "Na Węgrzech często do leczo dodaje się pod koniec duszenia rozkłócone jajko."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
