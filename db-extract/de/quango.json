                        "glosses": [
                            "Organisation, die für die Regierung eigenständig tätig, aber nicht in die staatliche Verwaltung eingegliedert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a124f033-688e-41c1-959d-1ab127c88677",
                                "sense_id": "f001a377-088d-3388-bfb7-9e1263711cd4",
                                "text": "„Einem Bericht der britischen BBC zufolge wird zudem die Verabschiedung eines Gesetzes erwogen, das die gleichzeitige Abschaffung mehrerer Quangos erleichtern würde.“"
                            }
                        ],
