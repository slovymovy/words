                        "glosses": [
                            "Vertreter der Pflanzengattung Inula, die zu der Familie der Korbblütengewächse zählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93f2985-3c26-46f7-9c34-0e69514cb8e9",
                                "sense_id": "2346f925-bfc9-375a-92ed-30eef33fd5ca",
                                "text": "Alante sind meist gelb blühende Korbblütengewächse."
                            },
                            {
                                "example_id": "34bef960-4337-4d19-b6cb-ee6ed23952a1",
                                "sense_id": "2346f925-bfc9-375a-92ed-30eef33fd5ca",
                                "text": "Der Alant wurde schon in der Antike als Heil- und Würzpflanze geschätzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e82b791f-0800-3caf-bea9-b65ed553d55f",
