                                        "sense_id": "87055656-d803-319a-bf8c-ff9a15687b60",
                                        "entry_id": "19732f31-f236-3eaa-87d8-910bf3b9d242",
                                        "glosses": [
                                            "etwas mit einem Verbindungsteil (Flansch) versehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ae6fa7b-9f76-4896-87ba-82afd30f3fbd",
                                                "sense_id": "87055656-d803-319a-bf8c-ff9a15687b60",
                                                "text": "Je nach Höhe von Druck und Temperatur flanscht oder schweißt man die Anschlußleitungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b5a48b8-6f0a-3a3b-91fd-630c1e5837f4",
                                        "entry_id": "19732f31-f236-3eaa-87d8-910bf3b9d242",
                                        "glosses": [
                                            "etwas mittels eines Flansches an etwas anderem befestigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee60d87-06cc-42ba-b14c-53a64cb97211",
                                                "sense_id": "3b5a48b8-6f0a-3a3b-91fd-630c1e5837f4",
                                                "text": "In der mitgebrachten High-Tech-Werkstatt hatten die Mechaniker das Antriebsaggregat getauscht und einen neuen Achtzylindermotor an das titangehärtete Chassis seines C 14 geflanscht."
                                            },
                                            {
                                                "example_id": "98ba2920-8fcc-4e06-8bf5-a3d68d26b9d2",
                                                "sense_id": "3b5a48b8-6f0a-3a3b-91fd-630c1e5837f4",
                                                "text": "Verbrennungsmotor, Tank, Auspuff werden entfernt und der Elektromotor mittels Adapterplatte an das vorhandene Getriebe geflanscht."
                                            },
                                            {
                                                "example_id": "9ee3b656-8bcf-41be-90ca-c208000ba30f",
                                                "sense_id": "3b5a48b8-6f0a-3a3b-91fd-630c1e5837f4",
                                                "text": "Dort angekommen, ließ er die riesigen Spiegel in ihre stabile Verankerung sinken, flanschte tonnenschwere Spektrographen und Bildanalysatoren an die bewegliche Optik, schwenkte sie gen Nachthimmel und machte es sich dann selbst vor etlichen Monitoren in warmer Stube bequem."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
