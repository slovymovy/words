                                        "entry_id": "5db87885-b3a4-36c9-a987-addc570bcd93",
                                        "glosses": [
                                            "Eigenschaft, einen förmlichen oder herkömmlichen (konventionellen) Charakter zu haben, den üblichen Gepflogenheiten (Konventionen) zu entsprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c59f378e-be33-41aa-ac77-83427b5c2f61",
                                                "sense_id": "55329c5c-6cba-3afb-b8f4-ab1b04bd5e0c",
                                                "text": "„Lebendige — d. h. echte — Metaphern liegen auf einer Skala zwischen äußerster Originalität und äußerster Konventionalität.“"
                                            },
                                            {
                                                "example_id": "8208f573-8964-4271-9338-084a63c86342",
                                                "sense_id": "55329c5c-6cba-3afb-b8f4-ab1b04bd5e0c",
                                                "text": "„Israel ist voller Sorge, nicht nur wegen des jüngsten Einsatzes von chemischen Waffen, sondern auch wegen ihrer Konventionalität — dem fast routinemäßigen Gebrauch von Gas auf dem Schlachtfeld.“"
                                            }
                                        ],
