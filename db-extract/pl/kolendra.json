                            {
                                "example_id": "2b2eaacd-6fed-4adf-8cc9-1ef9705e172b",
                                "sense_id": "53c06b2e-69cf-3cef-ad44-8ae0f35f4584",
                                "text": "W potrawach gotowanych rozmaite rzeczy są podobne z postaci do pieprzu: rodzynki korynckie, jałowiec suszony, kolendra"
