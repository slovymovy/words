                        "entry_id": "c14529d3-c14f-36b1-9065-86b2b5806618",
                        "glosses": [
                            "Émetteur de radionavigation qui permet la localisation géographique, et en général son identification, par un système de détection spécifique terrestre ou satellitaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85fd2a7e-ae21-4d5c-a80f-92eecf8954a2",
                                "sense_id": "d5183e68-52b5-37bf-9630-2d32fe5753db",
                                "text": "Le système comprend enfin les radiobalises, qui peuvent être terrestres, aéronautiques ou maritimes."
                            },
                            {
                                "example_id": "bc77bbe0-fdfc-47e0-a197-1aac48418026",
                                "sense_id": "d5183e68-52b5-37bf-9630-2d32fe5753db",
                                "text": "Celui de Fort-Lamy dispose d'une radiobalise à chaque bout de la piste. c) Aide à rapproche finale et à l'atterrissage"
                            }
                        ]
                    }
                ],
