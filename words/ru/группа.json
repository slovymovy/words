                {
                    "sense_id": "c6155875-4bdd-3f47-b036-ea7cb1e9d24f",
                    "sense_definition": "Алгебраическая структура, состоящая из множества элементов и операции над ними.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Теория <w>групп</w> является важным разделом современной высшей математики.",
                            "target_lang_translations": {
                                "en": "<w>Group</w> theory is an important branch of modern higher mathematics.",
                                "zh": "<w>群</w>论是现代高等数学的一个重要分支。"
                            }
                        },
                        {
                            "text": "Студенты изучали свойства абелевой <w>группы</w> на лекции по алгебре.",
                            "target_lang_translations": {
                                "en": "Students studied the properties of an abelian <w>group</w> at the algebra lecture.",
                                "zh": "学生们在代数课上学习了阿贝尔<w>群</w>的性质。"
                            }
                        }
                    ],
                    "common_phrases": [
