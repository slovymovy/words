                        "glosses": [
                            "A kind of masonry in which the outer faces of the wall are ashlar, the space between being filled with broken stone and mortar. Cross layers of stone are interlaid as binders."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
