                                            {
                                                "example_id": "30a1f56a-95db-437d-b857-bb432d725a0e",
                                                "sense_id": "1fa9632c-7709-3c13-a495-3ca43148e4a5",
                                                "text": "„Die Ursache der Hygroskopizität ist zum Teil in dem Feingefüge der Kohle zu suchen.“"
                                            },
                                            {
                                                "example_id": "7580a1ea-ca46-4278-be93-a686fbb1ef50",
                                                "sense_id": "1fa9632c-7709-3c13-a495-3ca43148e4a5",
                                                "text": "„Sand gröber als 0,02 mm zeigt in Zimmerluft gar keine Hygroskopizität.“"
                                            },
                                            {
                                                "example_id": "949b170a-7751-4cd0-8c0f-6a31a73b8f5a",
                                                "sense_id": "1fa9632c-7709-3c13-a495-3ca43148e4a5",
                                                "text": "„Hygroskopizität ist das Vermögen eines Stoffes (z. B. Produkt, Verpackungsmaterial), auf den Feuchtigkeitsgehalt der Luft durch Wasserdampfaufnahme oder -abgabe zu reagieren.“"
                                            }
                                        ],
