                        "glosses": [
                            "Qualifie une moto dont l’échappement a été modifié ou changé pour rendre la moto plus bruyante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8a7195c-6dd2-4aae-81c5-04340711c2b2",
                                "sense_id": "848a1ffb-c0d0-3c7b-b95b-7da75dfe9b6c",
                                "text": "Ces deux-roues trafiqués sont dangereux […] mais également bruyants : d’après une modélisation de Bruitparif publiée en 2017, un deux-roues « rectifié » traversant Paris de nuit peut réveiller 11 000 personnes, contre 350 s’il est doté d’un pot d’échappement homologué."
                            }
                        ]
                    }
