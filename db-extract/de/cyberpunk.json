                ],
                "senses": [
                    {
                        "sense_id": "c35ef283-c1cf-3bdd-bb1e-63546087a0bb",
                        "entry_id": "09e92804-4ef3-3e24-888a-3379458ed90d",
                        "glosses": [
                            "Subgenre innerhalb der Science-Fiction, das sich durch urbane, dicht bevölkerte Umgebungen, sowie eine pessimistische Grundstimmung auszeichnet und in dem häufig Hochtechnologie verwendet wird, um Menschen unfrei zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93c4f27-2d1c-41e0-9b64-cc9fcdde2d47",
                                "sense_id": "c35ef283-c1cf-3bdd-bb1e-63546087a0bb",
                                "text": "Cyberpunk entstand in den 1980er Jahren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8caa27d1-1cdc-4645-bfb9-6dd939d103a6",
                        "source_entry_id": "09e92804-4ef3-3e24-888a-3379458ed90d",
                        "source_sense_id": "c35ef283-c1cf-3bdd-bb1e-63546087a0bb",
                        "source_sense_description": "Subgenre innerhalb der Science-Fiction",
                        "target_lang_word": "cyberpunk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyberpunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c0e99cf-2d37-3175-b5fa-059bcfad84e7",
                                        "entry_id": "05808c47-4ed8-3920-8c99-97acdcb1bab9",
                                        "glosses": [
                                            "A subgenre of science fiction which focuses on computer or information technology and virtual reality juxtaposed with a degree of breakdown or radical change in the social order."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5afcad5-d8a5-4ede-b802-5050482ee126",
                                                "sense_id": "8c0e99cf-2d37-3175-b5fa-059bcfad84e7",
                                                "text": "But by 1987, cyberpunk had become a cliche. Other writers had turned the form into formula: implant wetware (biological computer chips), government by multinational corporations, street-wise, leather-jacketed, amphetamine-loving protagonists and decayed orbital colonies."
                                            },
                                            {
                                                "example_id": "37eea289-18d2-4385-891e-ff1d5d16d7ca",
                                                "sense_id": "8c0e99cf-2d37-3175-b5fa-059bcfad84e7",
                                                "text": "Cyberpunk stories are set in a futuristic, dystopic environment—the opposite of utopian—in which computer technology plays an important role. […] The protagonists of cyberpunk stories are technologically proficient, lonely adventurers struggling with issues of identity and forced to use computer skills to fight menacing forces of domination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34bd8598-2910-31f1-90d9-17ec8de8e686",
                                        "entry_id": "05808c47-4ed8-3920-8c99-97acdcb1bab9",
                                        "glosses": [
                                            "A cyberpunk character, a hacker punk, a high-tech low life."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6d3f358-35a1-490d-ad49-2818c5106a1f",
                                                "sense_id": "34bd8598-2910-31f1-90d9-17ec8de8e686",
                                                "text": "The film The Matrix redefined what a cyberpunk looked like."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b6aa3c3-20db-31ea-90b8-11df6434fd29",
                                        "entry_id": "05808c47-4ed8-3920-8c99-97acdcb1bab9",
                                        "glosses": [
                                            "A writer of cyberpunk fiction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996d55f9-8a4f-41f6-9949-9816934150ae",
                                                "sense_id": "1b6aa3c3-20db-31ea-90b8-11df6434fd29",
                                                "text": "[…] cyberpunks like William Gibson, Lucious Sheperd^([sic]), Bruce Sterling […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c5e5300-63d1-35f8-9127-9f4fb79a0380",
                                        "entry_id": "05808c47-4ed8-3920-8c99-97acdcb1bab9",
                                        "glosses": [
                                            "A musical genre related to the punk movement that makes use of electronic sounds such as synthesizers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aba6c85-47e6-48c8-9581-913e34db9f53",
                                                "sense_id": "6c5e5300-63d1-35f8-9127-9f4fb79a0380",
                                                "text": "A more technologically elaborate current of microtonal music can be found at M.I.T and Berklee College of Music, where R. Boulanger works in exotic equal temperaments and non-octave scales (E₆₀ and the 13th root of 3, i.e. the Bohlen-Pierce scale) using the CSOUND acoustic compiler, the Mathews radio drum and various MIDI synthesizers; nearby, E. Mullen performs cyberpunk music in E₁₉ and the 13th root of 3."
                                            },
                                            {
                                                "example_id": "b01e6375-8950-48cb-85d2-202fe971fd81",
                                                "sense_id": "6c5e5300-63d1-35f8-9127-9f4fb79a0380",
                                                "text": "At Meredith we stayed up all night listening to doof doof cyberpunk music and I saw you cry for the first time, at four in the morning bottle of ice tea and vodka in hand I saw your real face and something changed."
                                            },
                                            {
                                                "example_id": "668ac798-c75d-4075-95fe-f73e177ba729",
                                                "sense_id": "6c5e5300-63d1-35f8-9127-9f4fb79a0380",
                                                "text": "Indeed, 'Mindphaser' (and Tactical Neural Implant more generally) represents a high point of cyberpunk in the industrial music scene."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc588f98-047a-4b0e-9c47-6f5cc57aeb49",
                        "source_entry_id": "09e92804-4ef3-3e24-888a-3379458ed90d",
                        "source_sense_id": "c35ef283-c1cf-3bdd-bb1e-63546087a0bb",
                        "source_sense_description": "Subgenre innerhalb der Science-Fiction",
                        "target_lang_word": "cyberpunk",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyberpunk",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6463a474-52f2-37a9-b3cc-7538a5e79050",
                                        "entry_id": "554ebb5e-6ba4-3e44-bd22-15f03387780b",
                                        "glosses": [
                                            "Sous-genre de la science-fiction dans un futur proche incorporant une esthétique et des thématiques centrés sur la technologie informatique, souvent dans un monde dystopique."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc12658c-e970-4efb-af95-33ef8f57926d",
                                                "sense_id": "6463a474-52f2-37a9-b3cc-7538a5e79050",
                                                "text": "Le cyberpunk est né avec le premier roman de William Gibson en 1984 : Neuromancien. […] L’informatique s’est particulièrement développée, le cyberespace est un lieu où les hackers osent tous les exploits."
                                            },
                                            {
                                                "example_id": "90b8e4dd-c44a-4162-b582-2aac208db591",
                                                "sense_id": "6463a474-52f2-37a9-b3cc-7538a5e79050",
                                                "text": "On trouve une version particulièrement sombre de ce registre dans le cyberpunk, sous-genre de la science-fiction qui en a renouvelé l’esthétique et certaines de ses thématiques dans les années 1980, en l’occurrence avec un mélange de haute technologie et de dislocation sociale sur fond de néoféodalisme économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
