                        "sense_id": "1d33a35e-a70a-3549-b453-0dc1f29db564",
                        "entry_id": "2c3e6780-d792-3dda-915f-d3378f246484",
                        "glosses": [
                            "de verzameling van alle organismen die zich niet kunnen voortbewegen en die fotosynthese vertonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ac7f53-88b9-4266-880e-d1a02cb383f3",
                                "sense_id": "1d33a35e-a70a-3549-b453-0dc1f29db564",
                                "text": "Weer kwam het bij hem op dat zijn perceptie van de geschiedenis, van dat wat men de loop der geschiedenis noemt, heel anders was dan de algemeen gebruikelijke, dat zij zich op dezelfde manier aan hem voordeed als het leven van het plantenrijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e815c92-e8c4-3155-90d7-c598b7f9a63d",
                        "entry_id": "2c3e6780-d792-3dda-915f-d3378f246484",
                        "glosses": [
                            "de wereld van de planten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ee1a7b-e608-4a2d-98db-0d3b1f392c02",
                                "sense_id": "0e815c92-e8c4-3155-90d7-c598b7f9a63d",
                                "text": "Jan Siebelink, schrijver van bestsellers als Nachtschade en Knielen op een bed violen, is vandaag 80 geworden. Als zoon van een kweker vervullen planten een belangrijke rol in zijn oeuvre. Daarom publiceert hij een ode aan 'zijn stille plantenrijk'. In NOS Met het Oog op Morgen blikte Siebelink uitgebreid terug op zijn leven."
                            }
                        ]
                    }
