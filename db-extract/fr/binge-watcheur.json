                                    {
                                        "sense_id": "fccbef76-9946-31d9-8228-f904d87ebc22",
                                        "entry_id": "394aa93f-2686-3c28-af36-2589bb8a3a70",
                                        "glosses": [
                                            "One who binge-watches a television programme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8994d460-deff-4215-ad8d-56d744598f03",
                                                "sense_id": "fccbef76-9946-31d9-8228-f904d87ebc22",
                                                "text": "The market is adjusting to binge-watchers. Family Video has seasons of \"24,\" \"Prison Break\" and \"Boston Legal\" available on DVD."
                                            },
                                            {
                                                "example_id": "726951b8-73b6-431f-a36a-0f8ce9deb792",
                                                "sense_id": "fccbef76-9946-31d9-8228-f904d87ebc22",
                                                "text": "But its in-house translators have raced to append Chinese subtitles, finishing Chinese captions for two new episodes a day since then. That hasn’t stopped some binge-watchers from racing ahead."
                                            },
                                            {
                                                "example_id": "9fecbe2f-f4d9-4166-9ab6-9f2adf4e30bc",
                                                "sense_id": "fccbef76-9946-31d9-8228-f904d87ebc22",
                                                "text": "The un-killable Counter Terrorist Unit agent Jack Bauer, who in the interim has remained hugely popular with DVD \"binge-watchers\", returns after a four-year hiatus to try to foil another terrorist plot that threatens to bring about the end of Western civilisation as we know it."
                                            }
                                        ]
                                    }
