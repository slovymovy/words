                "senses": [
                    {
                        "sense_id": "e5a232aa-6008-3522-a3d3-2bff9db16c8b",
                        "entry_id": "4f85663c-6277-300f-b76b-58ccced383fc",
                        "glosses": [
                            "Diffuser vers plusieurs destinataires ou de plusieurs façons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce29c206-f535-444e-9e0b-134593ecabc1",
                                "sense_id": "e5a232aa-6008-3522-a3d3-2bff9db16c8b",
                                "text": "La solution vous permet de personnaliser, de multi-diffuser et de mesurer la performance de vos campagnes marketing."
                            },
                            {
                                "example_id": "03a527f8-0cb7-4e43-a5fb-212af23b35bd",
                                "sense_id": "e5a232aa-6008-3522-a3d3-2bff9db16c8b",
                                "text": "Lorsque l'on veut louer sa résidence, l'idéal est bien évidemment de multi-diffuser son annonce."
                            },
                            {
                                "example_id": "48fca340-d22b-48d5-b25f-3b13897c2fe7",
                                "sense_id": "e5a232aa-6008-3522-a3d3-2bff9db16c8b",
                                "text": "Notre logiciel immo permet de multi-diffuser vos annonces immobilières sur les portails de votre choix."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3710262-6f3b-3e9c-920f-cb8372b1a724",
                        "entry_id": "4f85663c-6277-300f-b76b-58ccced383fc",
                        "glosses": [
                            "Diffuser à plusieurs reprises, en parlant d’un programme télévisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ec5391-e29e-4415-8ac9-51239a1de955",
                                "sense_id": "d3710262-6f3b-3e9c-920f-cb8372b1a724",
                                "text": "National Geographic Channel va en effet multi-diffuser celui-ci à partir de ce soir, 20h 30 et 23h 30."
                            }
                        ]
                    }
