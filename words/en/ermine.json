{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ab2a998-748e-3add-a713-a96e513905fe",
                    "sense_definition": "A small carnivorous mammal found in northern regions, known for its white winter coat with a black-tipped tail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ermine</w> is well adapted to the harsh winters of the Arctic.",
                            "target_lang_translations": {
                                "ru": "<w>Горностай</w> хорошо приспособлен к суровым зимам Арктики."
                            }
                        },
                        {
                            "text": "A quick <w>ermine</w> darted across the snow-covered field.",
                            "target_lang_translations": {
                                "ru": "Быстрый <w>горностай</w> метнулся через заснеженное поле."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoat",
                        "short-tailed weasel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой хищный млекопитающий зверёк, известный своим белым зимним мехом с чёрным кончиком хвоста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горноста́й",
                                "target_lang_sense_clarification": "название животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaccea78-b656-38d4-a90c-a895cf62452f",
                    "sense_definition": "The white fur of the ermine, historically used as a symbol of purity and for judicial robes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge wore a robe trimmed with <w>ermine</w> during the formal ceremony.",
                            "target_lang_translations": {
                                "ru": "Во время официальной церемонии судья был в мантии, отороченной <w>горностаем</w>."
                            }
                        },
                        {
                            "text": "The queen's cloak was lined with soft white <w>ermine</w>.",
                            "target_lang_translations": {
                                "ru": "Плащ королевы был подбит мягким белым <w>горностаем</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ermine robes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Белый мех горностая, исторически использовавшийся как символ чистоты и для отделки судейских мантий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горноста́й",
                                "target_lang_sense_clarification": "мех животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3317ff78-c478-3cec-b193-4214d7ce91ac",
                    "sense_definition": "A heraldic pattern consisting of a white background with stylized black spots.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family crest features a shield with an <w>ermine</w> pattern.",
                            "target_lang_translations": {
                                "ru": "На семейном гербе изображён щит с <w>горностаевым</w> узором."
                            }
                        },
                        {
                            "text": "The coat of arms was decorated with <w>ermine</w> on the left side.",
                            "target_lang_translations": {
                                "ru": "Герб был украшен <w>горностаевым</w> мехом с левой стороны."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Геральдический узор, состоящий из белого фона со стилизованными чёрными пятнами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горностаевый мех",
                                "target_lang_sense_clarification": "геральдический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd7b3711-c9c9-332f-9c99-6e6127841cd6",
                    "sense_definition": "The position or authority of a judge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was appointed to the <w>ermine</w> after years of distinguished legal service.",
                            "target_lang_translations": {
                                "ru": "Он был назначен на судейскую должность после многих лет выдающейся юридической службы."
                            }
                        },
                        {
                            "text": "The integrity of the <w>ermine</w> must be maintained at all costs.",
                            "target_lang_translations": {
                                "ru": "Честь судейского звания должна поддерживаться любой ценой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Должность или авторитет судьи (метафорическое использование)."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "47790074-07d7-3d6c-ab61-1088f521a51d",
                    "sense_definition": "A type of moth belonging to the family Yponomeutidae.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>ermine</w> moth is often found in gardens during the summer.",
                            "target_lang_translations": {
                                "ru": "Маленькую <w>горностаевую</w> моль часто можно встретить в садах летом."
                            }
                        },
                        {
                            "text": "Researchers identified the specimen as an <w>ermine</w>.",
                            "target_lang_translations": {
                                "ru": "Исследователи идентифицировали образец как <w>горностаевую</w> моль."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид моли из семейства горностаевых молей (Yponomeutidae)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горностаевая моль",
                                "target_lang_sense_clarification": "насекомое"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ea86f38d-f837-367d-8011-92e069f26166",
                    "sense_definition": "Describing a heraldic pattern of white with black spots.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ermine</w> field was bordered in gold.",
                            "target_lang_translations": {
                                "ru": "<w>Горностаевое</w> поле было окаймлено золотом."
                            }
                        },
                        {
                            "text": "The shield displayed an <w>ermine</w> pattern across the center.",
                            "target_lang_translations": {
                                "ru": "На щите по центру был изображён <w>горностаевый</w> узор."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий геральдический узор из белого цвета с чёрными пятнами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горностаевый",
                                "target_lang_sense_clarification": "прилагательное в геральдике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d03e142b-6f9e-3537-90bb-1762c49603cb",
                    "sense_definition": "To decorate or clothe someone or something with ermine fur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal tailor was commissioned to <w>ermine</w> the king's ceremonial cloak.",
                            "target_lang_translations": {
                                "ru": "Королевскому портному было поручено оторочить <w>горностаем</w> парадный плащ короля."
                            }
                        },
                        {
                            "text": "The robe was <w>ermined</w> to signify his high status.",
                            "target_lang_translations": {
                                "ru": "Мантия была украшена <w>горностаем</w> в знак его высокого статуса."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или обшивать что-либо мехом горностая."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}