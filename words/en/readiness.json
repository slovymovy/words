            "senses": [
                {
                    "sense_id": "f9f85a53-2ec1-3ed7-8154-0b742fbe0f12",
                    "sense_definition": "The state or degree of being ready; preparedness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preparedness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team worked overtime to ensure their <w>readiness</w> for the upcoming product launch.",
                            "target_lang_translations": {
                                "ru": "Команда работала сверхурочно, чтобы обеспечить свою <w>готовность</w> к предстоящему запуску продукта."
                            }
                        },
                        {
                            "text": "The local government tested the emergency sirens to ensure disaster <w>readiness</w>.",
                            "target_lang_translations": {
                                "ru": "Местные власти протестировали сирены оповещения, чтобы проверить <w>готовность</w> к чрезвычайным ситуациям."
                            }
                        }
                    ],
                    "synonyms": [
                        "preparedness"
                    ],
                    "antonyms": [
                        "unpreparedness"
                    ],
                    "common_phrases": [
                        "disaster readiness",
                        "state of readiness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или степень подготовленности к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готовность",
                                "target_lang_sense_clarification": "состояние подготовленности"
                            },
                            {
                                "target_lang_word": "подготовленность",
                                "target_lang_sense_clarification": "наличие необходимых условий или навыков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6364804-c4af-3918-95bb-4cad0e8b6414",
                    "sense_definition": "Willingness or eagerness to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "willingness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She appreciated his <w>readiness</w> to help with the heavy lifting.",
                            "target_lang_translations": {
                                "ru": "Она оценила его <w>готовность</w> помочь с переноской тяжестей."
                            }
                        },
                        {
                            "text": "The manager noticed a general <w>readiness</w> to learn among the new interns.",
                            "target_lang_translations": {
                                "ru": "Менеджер заметил общую <w>готовность</w> к обучению среди новых стажеров."
                            }
                        }
                    ],
                    "synonyms": [
                        "willingness",
                        "eagerness",
                        "alacrity"
                    ],
                    "antonyms": [
                        "unwillingness",
                        "reluctance"
                    ],
                    "common_phrases": [
                        "readiness to help",
                        "readiness to learn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желание, стремление или внутреннее согласие сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готовность",
