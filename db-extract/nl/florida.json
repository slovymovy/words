                                    {
                                        "sense_id": "1e717bba-7b99-3f9d-bc95-0dc89849be22",
                                        "entry_id": "003b8801-44f0-3d2f-9642-50c7393168bb",
                                        "glosses": [
                                            "État des États-Unis d’Amérique (code postal FL), bordé par l’Alabama et la Géorgie au nord, l’océan Atlantique à l’est, et le golfe du Mexique à l’ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d31d5ab-5989-4d15-a95f-802237ea124d",
                                                "sense_id": "1e717bba-7b99-3f9d-bc95-0dc89849be22",
                                                "text": "La Floride resserre les règles de son plan de vaccination pour éviter que l’État devienne une destination de tourisme vaccinal."
                                            },
                                            {
                                                "example_id": "dd19a1c1-504f-459b-bf55-9d57072a5297",
                                                "sense_id": "1e717bba-7b99-3f9d-bc95-0dc89849be22",
                                                "text": "Je vis en Floride."
                                            },
                                            {
                                                "example_id": "e057b43d-df45-459f-9c4b-89f83f872e47",
                                                "sense_id": "1e717bba-7b99-3f9d-bc95-0dc89849be22",
                                                "text": "La Floride applique la peine de mort."
                                            },
                                            {
                                                "example_id": "22836599-5e8d-489b-b73e-edc632cde614",
                                                "sense_id": "1e717bba-7b99-3f9d-bc95-0dc89849be22",
                                                "text": "Tallahassee est la capitale de la Floride."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
