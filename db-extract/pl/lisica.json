                                "target_senses": [
                                    {
                                        "sense_id": "d6680746-0246-33f6-b625-47cc89b979f0",
                                        "entry_id": "6e78e72d-f174-3058-a258-78ee51ef806c",
                                        "glosses": [
                                            "Femelle du renard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4e02a98-4b3a-422f-9eb0-e2b6c0453115",
                                                "sense_id": "d6680746-0246-33f6-b625-47cc89b979f0",
                                                "text": "Ma mère fit un cri de renarde :\n « Ha !… Où est-il ?\n– Qui, madame Colette ?\n– Mon petit garçon ! L’a-t-on vu sortir ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb88444f-657c-3b3a-984e-d08c4dc4be3e",
                                        "entry_id": "6e78e72d-f174-3058-a258-78ee51ef806c",
                                        "glosses": [
                                            "Sorcière."
                                        ],
                                        "tags": [
                                            "Mythologie japonaise"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77a2edaa-bac6-42f3-b031-5edf0918a894",
                                                "sense_id": "eb88444f-657c-3b3a-984e-d08c4dc4be3e",
                                                "text": "— La renarde a bouffé l’âme de Seisaku !"
                                            }
                                        ]
                                    }
                                ]
                            },
