                            {
                                "example_id": "e091ecc0-078b-409a-a35c-98fb8791235b",
                                "sense_id": "dab0dd2e-0435-3cae-a200-4c70d455a1fe",
                                "text": "Alle kindergraven zijn er liefdevol opgetuigd met beertjes van steen, vogeltjes, bootjes, vaasjes met roosjes, kaarsjes die eeuwig branden en briefjes vol verdriet die onder een steen liggen. In de bomen rond de graven hangen heel veel windvangers die ijle, rustgevende muziek maken. Tingeltangels noemen mijn man en ik ze."
                            }
                        ]
                    },
