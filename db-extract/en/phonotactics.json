                                        "sense_id": "9c4d0496-d2d2-3201-9eff-c40aa474d54d",
                                        "entry_id": "17966b8d-d401-38be-b74b-948d3e74f91d",
                                        "glosses": [
                                            "Ensemble des règles combinatoires des phonèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20bc1bfa-a4ac-478b-8ea7-e289819f7951",
                                                "sense_id": "9c4d0496-d2d2-3201-9eff-c40aa474d54d",
                                                "text": "La capacité du bébé à détecter les combinaisons de sons les plus fréquentes de sa langue et à distinguer celles qui sont possibles et celles qui ne sont pas autorisées renvoie à ce que l’on appelle la phonotactique d’une langue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
