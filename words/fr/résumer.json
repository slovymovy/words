{
    "word_family": [
        "résumé",
        "résumable",
        "résomptif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "973d887e-daf6-3789-b87c-2ddcee596557",
                    "sense_definition": "Présenter de façon brève et synthétique les points essentiels d'un texte, d'un discours ou d'une idée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "synthetiser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous <w>résumer</w> la situation avant que nous commencions la réunion ?"
                        },
                        {
                            "text": "L'étudiant a su <w>résumer</w> ce long article en une seule page claire."
                        }
                    ],
                    "synonyms": [
                        "synthétiser",
                        "récapituler",
                        "abréger"
                    ],
                    "antonyms": [
                        "développer",
                        "détailler"
                    ],
                    "common_phrases": [
                        "résumer la situation",
                        "résumer en quelques mots",
                        "résumer un texte"
                    ]
                },
                {
                    "sense_id": "7e3e3dd7-e185-368a-a2b0-a58bbb5959cd",
                    "sense_definition": "Se réduire à l'essentiel, consister principalement en un élément précis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la controverse se <w>résume</w> à un simple malentendu entre les deux partenaires."
                        },
                        {
                            "text": "Leurs exigences salariales se <w>résument</w> finalement à une modeste augmentation mensuelle."
                        }
                    ],
                    "synonyms": [
                        "se réduire",
                        "consister"
                    ],
                    "common_phrases": [
                        "se résumer à"
                    ]
                },
                {
                    "sense_id": "f728af54-f7bf-38d9-ad13-36f2708e76ff",
                    "sense_definition": "Condenser ou exprimer de manière frappante un ensemble vaste, complexe ou abstrait.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "synthetiser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce monument emblématique <w>résume</w> à lui seul toute l'histoire de la capitale."
                        },
                        {
                            "text": "Son discours brillant <w>résumait</w> parfaitement l'esprit de renouveau de notre mouvement."
                        }
                    ],
                    "synonyms": [
                        "incarner",
                        "concentrer"
                    ],
                    "common_phrases": [
                        "résumer à lui seul",
                        "résumer une époque"
                    ]
                }
            ]
        }
    ]
}