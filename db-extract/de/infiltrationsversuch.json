                        "examples": [
                            {
                                "example_id": "edfb1003-d42c-4722-af75-f83e01234b7b",
                                "sense_id": "e485463b-589b-38dd-989d-0e664d35228f",
                                "text": "„Der erste Infiltrationsversuch der Ostblockstaaten in Nordafrika erfolgte in den sechziger Jahren in Marokko, das den westlichen Eckpfeiler des afrikanischen Kontinents bildet und die Gegenküste zum strategisch wichtigen Gibraltar stellt.“"
                            }
                        ],
