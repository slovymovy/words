                        "examples": [
                            {
                                "example_id": "b5846068-33fc-40ef-ab39-e46a9b079268",
                                "sense_id": "43628df3-24b2-3be6-8da9-f14979062a95",
                                "text": "Ootmarsum staat dit weekeinde in het teken van de aloude paastradities. Dat betekent onder meer dat de acht poaskearls in actie komen. Op de ochtend van eerste paasdag trokken ze al vroeg door het ontwakende stadje om de Simon en Judaskerk en langs de hervormde kerk."
                            },
                            {
                                "example_id": "85fa1e47-1ca3-4e88-8ec2-6042c6dbfd48",
                                "sense_id": "43628df3-24b2-3be6-8da9-f14979062a95",
                                "text": "Een frisse neus halen dit weekend? Wandel dan zondag in alle vroegte mee over Hof Espelo. De wandeling van Landschap Overijssel begint al om 07.30 uur bij bezoekerscentrum Het Koetshuis. Je wandelt zo’n anderhalf uur door de ontwakende natuur. Meelopen kost 5 euro, donateurs betalen niets."
                            }
                        ]
                    }
