                "senses": [
                    {
                        "sense_id": "386c37dc-4c01-3a82-866b-375686417afa",
                        "entry_id": "68b09fc7-9f76-33bf-a053-e878663cc18c",
                        "glosses": [
                            "Noord-Amerikaans zoogdier, Bison bison, uit de familie van de holhoornigen (Bovidae)\\nDe wetenschappelijke naam van de soort werd als Bos bison in 1758 gepubliceerd door Carl Linnaeus. De wisent of \\\"Europese bizon\\\" is een nauw verwante soort."
                        ],
                        "tags": [
                            "evenhoevigen"
                        ],
                        "examples": [
                            {
                                "example_id": "e5247c0a-6805-430e-af2c-f95f3cf32e66",
                                "sense_id": "386c37dc-4c01-3a82-866b-375686417afa",
                                "text": "Omstreeks 1830 zwierven er waarschijnlijk 40 tot 60 miljoen bizons door de uitgestrektheid van Noord-Amerika. Toen begon de grote slachtpartij. Een tactiek van het leger van de VS in de strijd tegen opstandige indianen. Jagers die bizons afschoten verdienden niet alleen geld met het vlees, maar werden bovendien beloond met premies. In 1898 waren er minder dan 1.000 van deze dieren over."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7a43a04-1d39-4ecc-9a00-1a803cbb020a",
                        "source_entry_id": "68b09fc7-9f76-33bf-a053-e878663cc18c",
                        "source_sense_id": "386c37dc-4c01-3a82-866b-375686417afa",
                        "source_sense_description": "Noord-Amerikaans zoogdier, Bison bison",
                        "target_lang_word": "Bison",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bison",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a2cc780-c858-3139-9eea-759bc4487ad8",
                                        "entry_id": "8e604647-28a2-3908-9c74-f830ab8ee852",
                                        "glosses": [
                                            "eine Gattung europäischer und nordamerikanischer Wildrinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b923e967-d3de-4ce5-a454-0315ce7656b4",
                                                "sense_id": "9a2cc780-c858-3139-9eea-759bc4487ad8",
                                                "text": "Aus dem Steppenwisent entwickelten sich zwei Arten des Bisons, die in zwei aufeinander folgenden Einwanderungswellen die südlicheren Teile des Kontinents eroberten."
                                            },
                                            {
                                                "example_id": "f33ebc22-1dc0-4a63-98a1-d2663598c145",
                                                "sense_id": "9a2cc780-c858-3139-9eea-759bc4487ad8",
                                                "text": "„In dieser misslichen Lage erreicht uns die Nachricht, dass in Tschernobyl ein Bison gestorben ist, der einst dorthin verbracht wurde, um das Gras in der Todeszone kurz zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "391b6f65-f850-30ae-9db3-017ee9c9640d",
                                        "entry_id": "8e604647-28a2-3908-9c74-f830ab8ee852",
                                        "glosses": [
                                            "eine Art aus dieser Gattung, der Amerikanische Bison (Bison bison)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc342089-cd0e-4b6f-9e8f-bb9eac5fa188",
                                                "sense_id": "391b6f65-f850-30ae-9db3-017ee9c9640d",
                                                "text": "Der Bison war die Lebensgrundlage der Prärie-Indianer."
                                            },
                                            {
                                                "example_id": "653bc097-fcc0-4142-8e09-313c17d7dca5",
                                                "sense_id": "391b6f65-f850-30ae-9db3-017ee9c9640d",
                                                "text": "„Womöglich waren sie eine leichtere Beute für die Steinzeitbewohner als die mächtigen Bisons.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
