                "senses": [
                    {
                        "sense_id": "f3d025f7-b812-3ac9-a580-1fc31bae98c9",
                        "entry_id": "064e5459-68dd-39f3-9a9d-38f227b85f50",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus, das für Gottesdienste der Dorfbewohner bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40a6141-3952-4c84-8f57-24f0f72d0f40",
                                "sense_id": "f3d025f7-b812-3ac9-a580-1fc31bae98c9",
                                "text": "„Die heutige Dorfkapelle wurde Anfang des vergangenen Jahrhunderts erbaut und im Jahre 1915 dem hl. Laurentius geweiht.“"
                            },
                            {
                                "example_id": "84a2de5f-39c4-4e65-a863-ff8de5ff9c87",
                                "sense_id": "f3d025f7-b812-3ac9-a580-1fc31bae98c9",
                                "text": "„Wenn Sie in Richtung Frauenau unterwegs sind, können Sie die Dorfkapelle im Ortsteil Hinterklessing besichtigen.“"
                            },
                            {
                                "example_id": "324b21e2-726a-463c-8969-a969056e6fbe",
                                "sense_id": "f3d025f7-b812-3ac9-a580-1fc31bae98c9",
                                "text": "„Jeden Samstag betet sie den Rosenkranz in der Dorfkapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea92d8fa-02cd-34a3-b783-bcbed94b8a6a",
                        "entry_id": "064e5459-68dd-39f3-9a9d-38f227b85f50",
                        "glosses": [
                            "kleines Musiker-Ensemble aus dem Dorf, das insbesondere Tanz- und Unterhaltungsmusik spielt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "6d2d2e04-66e1-45ac-9805-d93499500613",
                                "sense_id": "ea92d8fa-02cd-34a3-b783-bcbed94b8a6a",
                                "text": "„Die damaligen Lehrer Willi Leschmann, Dirigent der Trachtenkapelle Michelstadt und Wilhelm Mohr, Dirigent der Dorfkapelle Lauerbach, gaben die ersten \"Züge\" an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
