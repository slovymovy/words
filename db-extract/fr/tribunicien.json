                        "sense_id": "94bddd12-5b31-300b-9008-270c74b03987",
                        "entry_id": "e1aeba0e-b4dc-34b6-8009-56242483863c",
                        "glosses": [
                            "Variante de tribunitien. Doublet de tribun, doté de la puissance tribunicienne."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "cd944b79-31eb-46b3-ba9e-b396c49a048a",
                                "sense_id": "94bddd12-5b31-300b-9008-270c74b03987",
                                "text": "Un personnage, l’Asiatique Ti. Julius Celsus Polemaeanus, fut sous Vespasien adlectus inter aedilicios, ce qui lui donnait évidemment le même rang qu’un tribunicien."
                            },
                            {
                                "example_id": "5f844b2d-b76d-4a0f-9e1c-7009453c9daf",
                                "sense_id": "94bddd12-5b31-300b-9008-270c74b03987",
                                "text": "Que ne vont-ils chercher là les raisons de quelques succès, plutôt que dans le ressassement aigri de ses qualités de « tribunicien » !"
                            }
                        ]
                    }
                ],
