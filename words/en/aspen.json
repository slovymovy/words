{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "760c9b85-54f1-3234-808f-83ecd2919436",
                    "sense_definition": "A type of poplar tree known for its thin, straight, greenish-white trunk and leaves that tremble in the wind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Above a certain elevation, the <w>aspens</w> gave way to scrubby, gnarled pines.",
                            "target_lang_translations": {
                                "de": "Ab einer gewissen Höhe wichen die <w>Espen</w> struppigen, knorrigen Kiefern."
                            }
                        },
                        {
                            "text": "The beautiful <w>aspen</w> forests shimmer across the mountainsides during the autumn months.",
                            "target_lang_translations": {
                                "de": "Die wunderschönen <w>Espenwälder</w> schimmern während der Herbstmonate an den Berghängen."
                            }
                        }
                    ],
                    "synonyms": [
                        "poplar"
                    ],
                    "common_phrases": [
                        "aspen tree",
                        "aspen forest",
                        "aspen leaf"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Pappelart, die für ihren dünnen, geraden, grünlich-weißen Stamm und ihre Blätter bekannt ist, die im Wind zittern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Espe",
                                "target_lang_sense_clarification": "Allgemeine Bezeichnung für den Baum."
                            },
                            {
                                "target_lang_word": "Zitterpappel",
                                "target_lang_sense_clarification": "Bezeichnung, die sich auf das Zittern der Blätter bezieht."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "302f6197-8583-34fa-8739-33d3fb1e47b7",
                    "sense_definition": "The pale, lightweight, and soft wood obtained from the aspen tree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter chose <w>aspen</w> for the interior paneling because of its light color.",
                            "target_lang_translations": {
                                "de": "Der Tischler wählte <w>Espenholz</w> für die Innenverkleidung wegen seiner hellen Farbe."
                            }
                        },
                        {
                            "text": "Many traditional wooden baskets are crafted from flexible <w>aspen</w> strips.",
                            "target_lang_translations": {
                                "de": "Viele traditionelle Holzkörbe werden aus flexiblen <w>Espenholzstreifen</w> gefertigt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das helle, leichte und weiche Holz, das vom Espenbaum gewonnen wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Espenholz",
                                "target_lang_sense_clarification": "Das Holz der Espe."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b864076e-f2e1-3d22-b7c0-5ea412336bb6",
                    "sense_definition": "A well-known ski-resort town located in Colorado, USA.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to spend their winter vacation skiing in <w>Aspen</w>.",
                            "target_lang_translations": {
                                "de": "Sie beschlossen, ihren Winterurlaub beim Skifahren in <w>Aspen</w> zu verbringen."
                            }
                        },
                        {
                            "text": "The luxury resort in <w>Aspen</w> is famous for its high-end amenities.",
                            "target_lang_translations": {
                                "de": "Das Luxusresort in <w>Aspen</w> ist für seine erstklassige Ausstattung berühmt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein bekannter Skiort in Colorado, USA."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Aspen",
                                "target_lang_sense_clarification": "Eigenname des Ortes."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6541a69-e264-3dfb-877f-30081d157ad3",
                    "sense_definition": "A female given name inspired by the aspen tree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Aspen</w> is a popular nature-inspired name for girls in North America.",
                            "target_lang_translations": {
                                "de": "<w>Aspen</w> ist ein beliebter, von der Natur inspirierter Name für Mädchen in Nordamerika."
                            }
                        },
                        {
                            "text": "My friend <w>Aspen</w> loves hiking in the mountains.",
                            "target_lang_translations": {
                                "de": "Meine Freundin <w>Aspen</w> liebt es, in den Bergen zu wandern."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein weiblicher Vorname, der vom Espenbaum inspiriert ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Aspen",
                                "target_lang_sense_clarification": "Vorname."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c6278f1-d3a3-3cde-b4c4-933ab12d1397",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the new novel is named Sarah <w>Aspen</w>.",
                            "target_lang_translations": {
                                "de": "Die Autorin des neuen Romans heißt Sarah <w>Aspen</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Aspen</w> will be leading the meeting this afternoon.",
                            "target_lang_translations": {
                                "de": "Herr <w>Aspen</w> wird heute Nachmittag das Meeting leiten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Aspen",
                                "target_lang_sense_clarification": "Nachname."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da5b801e-e8ba-3f79-8919-21c8fd9a194b",
                    "sense_definition": "A small community in Nova Scotia, Canada.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small village of <w>Aspen</w> is located in Guysborough County.",
                            "target_lang_translations": {
                                "de": "Das kleine Dorf <w>Aspen</w> liegt im Guysborough County."
                            }
                        },
                        {
                            "text": "Driving through rural Nova Scotia, we passed a sign for <w>Aspen</w>.",
                            "target_lang_translations": {
                                "de": "Als wir durch das ländliche Nova Scotia fuhren, kamen wir an einem Schild für <w>Aspen</w> vorbei."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine kleine Gemeinde in Nova Scotia, Kanada."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Aspen",
                                "target_lang_sense_clarification": "Ortsname."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3107dbf5-5fa0-3f1b-bbad-67090cc7d31c",
                    "sense_definition": "Relating to or made from the aspen tree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>aspen</w> leaves turned a brilliant gold color in the autumn.",
                            "target_lang_translations": {
                                "de": "Die <w>Espenblätter</w> färbten sich im Herbst leuchtend gold."
                            }
                        },
                        {
                            "text": "They built a small cabin using local <w>aspen</w> wood.",
                            "target_lang_translations": {
                                "de": "Sie bauten eine kleine Hütte aus lokalem <w>Espenholz</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aspen wood",
                        "aspen leaves"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich auf die Espe beziehend oder aus Espenholz gefertigt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Espen-",
                                "target_lang_sense_clarification": "Präfix für Zusammensetzungen (z.B. Espenholz, Espenblätter)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db635135-3433-3c25-8f32-ed14168dd70d",
                    "sense_definition": "Characterized by trembling or shaking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "trembling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood there with an <w>aspen</w> fear, unable to speak a single word.",
                            "target_lang_translations": {
                                "de": "Er stand dort mit einer <w>zitternden</w> Angst und konnte kein einziges Wort hervorbringen."
                            }
                        },
                        {
                            "text": "Her <w>aspen</w> hands betrayed her nervousness during the performance.",
                            "target_lang_translations": {
                                "de": "Ihre <w>zitternden</w> Hände verrieten ihre Nervosität während des Auftritts."
                            }
                        }
                    ],
                    "synonyms": [
                        "trembling",
                        "shaking"
                    ],
                    "antonyms": [
                        "steady"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or poetic context."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Durch Zittern oder Beben gekennzeichnet (literarisch/poetisch)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zitternd",
                                "target_lang_sense_clarification": "Allgemeines Adjektiv für das Zittern."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7638aad3-59ae-37c1-8753-7d4164dea14a",
                    "sense_definition": "Describing a person who gossips or talks excessively.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>aspen</w> tongue of the neighbor spread rumors throughout the entire village.",
                            "target_lang_translations": {
                                "de": "Die <w>klatschhafte</w> Zunge der Nachbarin verbreitete Gerüchte im ganzen Dorf."
                            }
                        },
                        {
                            "text": "She was known for her <w>aspen</w> nature, always whispering about others.",
                            "target_lang_translations": {
                                "de": "Sie war für ihre <w>klatschhafte</w> Art bekannt und flüsterte immer über andere."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossiping"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person beschreibend, die klatscht oder übermäßig redet (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "klatschhaft",
                                "target_lang_sense_clarification": "Jemand, der gerne tratscht."
                            },
                            {
                                "target_lang_word": "geschwätzig",
                                "target_lang_sense_clarification": "Jemand, der zu viel redet."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}