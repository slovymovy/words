    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ce1b0cf-7758-3da2-bd24-2c6aaf321dd5",
                    "sense_definition": "A lack of agreement, harmony, or consistency between things, ideas, or people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many voters experienced cognitive <w>dissonance</w> when their favorite politician supported the controversial law."
                        },
                        {
                            "text": "There was a clear <w>dissonance</w> between what the company promised and what it actually delivered to customers."
                        }
                    ],
                    "synonyms": [
                        "discord",
                        "disharmony",
                        "discordance"
                    ],
                    "antonyms": [
                        "concord",
                        "consonance",
                        "concordance"
                    ],
                    "common_phrases": [
                        "cognitive dissonance"
                    ]
                },
                {
                    "sense_id": "36b2b6fb-2504-39a3-8f7b-c89bf96c4e85",
                    "sense_definition": "An individual instance or occurrence of conflict, disagreement, or incongruity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest report highlighted several glaring <w>dissonances</w> within the government's foreign policy strategy."
                        },
                        {
                            "text": "Scholars noted subtle <w>dissonances</w> between the author's public lectures and her private journals."
                        }
                    ],
                    "synonyms": [
                        "clash",
                        "disagreement",
                        "conflict"
                    ]
                },
                {
                    "sense_id": "41b7a385-3b00-33aa-ac42-c0eeb1ded916",
                    "sense_definition": "A harsh, unpleasant combination of sounds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden screech of metal and car horns created an unbearable <w>dissonance</w> on the busy street."
                        },
                        {
                            "text": "The orchestra opened the piece with an unexpected <w>dissonance</w> that startled the audience."
                        }
                    ],
                    "synonyms": [
