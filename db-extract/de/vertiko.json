                "senses": [
                    {
                        "sense_id": "997e6d36-18ec-3d67-8a74-6df86f9ece31",
                        "entry_id": "7c92c9e3-dfce-3a3d-9963-a66b6c252119",
                        "glosses": [
                            "kleinerer zweitüriger Zierschrank, der nach oben mit einer Schublade und einem Aufsatz abschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8db56ca0-8c30-45c0-a60a-aeb9aa9b6dc2",
                                "sense_id": "997e6d36-18ec-3d67-8a74-6df86f9ece31",
                                "text": "Vertikos waren früher sehr verbreitete Möbelstücke."
                            },
                            {
                                "example_id": "688f4926-c579-4e6a-b1bd-3c53f17674d0",
                                "sense_id": "997e6d36-18ec-3d67-8a74-6df86f9ece31",
                                "text": "„Es ist nicht mehr die Vorkriegsstube mit Mahagonimöbeln, Säulchen und Muschelaufsatz und einem spiegelgeschmückten Vertiko.“"
                            },
                            {
                                "example_id": "b647e34a-d708-4fc3-87d6-9d05e0fa7fe0",
                                "sense_id": "997e6d36-18ec-3d67-8a74-6df86f9ece31",
                                "text": "„Eva kauert seitlich zwischen Fenster und Vertiko, kauert und kreischt, als wenn sie ein Gespenst gesehen hat.“"
                            },
                            {
                                "example_id": "94b6fb60-1f8e-4f4c-a5b4-44d5507d1295",
                                "sense_id": "997e6d36-18ec-3d67-8a74-6df86f9ece31",
                                "text": "„Das Vertiko meiner Mutter erscheint, hölzern, braun und auf Hochglanz gestriegelt.“"
                            },
                            {
                                "example_id": "66cc5bff-c438-4a5e-94ec-8c3fd48b40fa",
                                "sense_id": "997e6d36-18ec-3d67-8a74-6df86f9ece31",
                                "text": "„Ein altes Vertiko kann mehr erklären als tausend Worte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
