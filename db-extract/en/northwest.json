                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nordwesten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5d4e235-2abd-3aa4-bb5f-679068217b0b",
                                        "entry_id": "bbe05302-911b-3dca-b4e5-ef999b9cc8ee",
                                        "glosses": [
                                            "die Nebenhimmelsrichtung, die dem Südosten gegenüber und zwischen Norden und Westen liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc5286e-f9b5-474e-bf19-64256f879185",
                                                "sense_id": "a5d4e235-2abd-3aa4-bb5f-679068217b0b",
                                                "text": "Der Weg biegt nach Nordwesten ab."
                                            },
                                            {
                                                "example_id": "22fd7c85-e26d-4285-87dd-c660a97cafb3",
                                                "sense_id": "a5d4e235-2abd-3aa4-bb5f-679068217b0b",
                                                "text": "„In dieser Marslandschaft erhob sich im Nordwesten das berühmte Polygon mit seinen Steinhaufen und Kratern, die mit hoher Wahrscheinlichkeit Eisen, Kobalt, Zink und Zinnoxid enthielten.“"
                                            },
                                            {
                                                "example_id": "d9b83bdb-7e60-43d8-b4eb-28955dc74f98",
                                                "sense_id": "a5d4e235-2abd-3aa4-bb5f-679068217b0b",
                                                "text": "„Der Sturm blies zum Glück immer noch aus Nordwesten, so daß die Öffnungen des Granithauses weitgehend im Windschatten lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef365800-a623-3ff5-81b4-fe3f4c83a01b",
                                        "entry_id": "bbe05302-911b-3dca-b4e5-ef999b9cc8ee",
                                        "glosses": [
                                            "der von der Mitte aus in dieser Richtung liegende Teil eines Gebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2bc5bd-52d6-4528-aa7e-3a7ac54515d4",
                                                "sense_id": "ef365800-a623-3ff5-81b4-fe3f4c83a01b",
                                                "text": "Ihre Großeltern waren mit einem Treck in den Nordwesten gezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
