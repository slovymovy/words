                        "glosses": [
                            "Relativement à l'estomac."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "aa94d7f3-00b4-4328-b863-90ad12d5bdf5",
                                "sense_id": "acaad6b9-d453-3089-928c-1c96bdb7bcf2",
                                "text": "Bien que les ruminants soient les mieux armés stomacalement pour digérer la cellulose, il n'arrivent pas à la transformer complétement, […]."
                            },
                            {
                                "example_id": "78522d0a-5034-4d79-a502-7ac58a5799de",
                                "sense_id": "acaad6b9-d453-3089-928c-1c96bdb7bcf2",
                                "text": "Aussi, ma vie a très sensiblement changé - stomacalement parlant - depuis que Mme Oudard travaille au bistrot. A midi donc je mange seul, non pas qu'avant celle-ci me tenant compagnie mon manger passait mieux."
                            }
                        ]
                    }
