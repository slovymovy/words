        "fr-extract.jsonl": [
            {
                "entry_id": "4aaf4bb5-08eb-396c-8305-931b8a012b39",
                "word": "piaffe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "746ed90a-dfb7-312f-9afc-04cb0539992f",
                        "entry_id": "4aaf4bb5-08eb-396c-8305-931b8a012b39",
                        "glosses": [
                            "Faste, ostentation, vaine somptuosité en habits, en meubles, en équipage, etc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5714b5a9-7dab-4e38-bedc-94a5cf3fb8be",
                                "sense_id": "746ed90a-dfb7-312f-9afc-04cb0539992f",
                                "text": "Ils ont beau se laver dans des machins d’argent et faire de la piaffe… je les connais ! Octave Mirbeau, Journal d’une femme de chambre, chap. V (1900)"
                            },
                            {
                                "example_id": "9f315064-02ff-4362-b80b-6f61537ce0ff",
                                "sense_id": "746ed90a-dfb7-312f-9afc-04cb0539992f",
                                "text": "Nous venons de voir défiler le ventre de Berthelot dans les fleurs, la gueule de nos canons bâillonnés de roses, la piaffe des arabes blancs sur qui dansent les chasseurs d’Afrique, l’infanterie roumaine rêveuse et sympathique dont les sonneries longues semblent de nostalgiques appels de bergers."
                            },
                            {
                                "example_id": "f5a6d0c4-f701-416d-ae23-31940eb79009",
                                "sense_id": "746ed90a-dfb7-312f-9afc-04cb0539992f",
                                "text": "Quant à la sensibilité, il faut, pour la définir, écarter toutes les épithètes de mouvement, […], avec ce qu'elles annoncent d’indiscrétion ou de piaffe."
                            }
                        ]
                    }
