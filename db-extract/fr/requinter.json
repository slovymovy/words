                "senses": [
                    {
                        "sense_id": "d936e118-30cc-3475-92f7-631c06808146",
                        "entry_id": "ed0ef048-e52e-32d0-9772-c011fda459bc",
                        "glosses": [
                            "Avoir de nouveau une quinte de toux. (Il n’a été trouvé qu’une seule attestation littéraire.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ea0565-6945-401b-b85b-49f30ceb0113",
                                "sense_id": "d936e118-30cc-3475-92f7-631c06808146",
                                "text": "Je vais requinter. J’ai beau me foutre des suppositoires, c’est comme si je chantais."
                            }
                        ]
                    },
                    {
                        "sense_id": "a13cb121-0e99-390f-9bd0-9c974cc0e49c",
                        "entry_id": "ed0ef048-e52e-32d0-9772-c011fda459bc",
                        "glosses": [
                            "Variante de requinquer (se requinquer, c’est retrouver une nouvelle santé)."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "3d9c3e32-060d-4325-9902-2ac33225a81d",
                                "sense_id": "a13cb121-0e99-390f-9bd0-9c974cc0e49c",
                                "text": "Il est indispensable de se requinter avant de démarrer la nouvelle étape de notre randonnée."
                            }
                        ]
