                "senses": [
                    {
                        "sense_id": "d1cc328d-851a-34e4-a5cb-1f33c426c673",
                        "entry_id": "eedbd687-0b3b-3efb-8710-a6343241462a",
                        "glosses": [
                            "Ministerium eines Staates, welches für außenpolitische Beziehungen mit anderen Staaten verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b9db3b-46e0-4c74-9124-e3fc346e4da8",
                                "sense_id": "d1cc328d-851a-34e4-a5cb-1f33c426c673",
                                "text": "Das Außenministerium erklärte gestern, dass die Friedensverhandlungen mit XYZ gescheitert seien."
                            },
                            {
                                "example_id": "86d61134-f5b2-4464-ab00-54489cf7252f",
                                "sense_id": "d1cc328d-851a-34e4-a5cb-1f33c426c673",
                                "text": "„Natürlich sickerte gerüchteweise durch, dass in den Außenministerien und Botschaften der europäischen Mächte in höchster Anspannung gearbeitet wurde.“"
                            },
                            {
                                "example_id": "f78899c1-6ae5-4c54-a518-f4c1a759e42d",
                                "sense_id": "d1cc328d-851a-34e4-a5cb-1f33c426c673",
                                "text": "„So war der zähe Kampf, den Beneš und Jaksch zwischen 1940 und 1942 miteinander führten und den Jaksch überhaupt nur wagen konnte, weil er Helfer und Unterstützer im britischen Außenministerium hatte, höchst ungleich.“"
                            },
                            {
                                "example_id": "33aa9526-4b41-442d-9f9e-db7773a733ac",
                                "sense_id": "d1cc328d-851a-34e4-a5cb-1f33c426c673",
                                "text": "„Ganz in der Nähe arbeitete Gunnar, er war Staatssekretär im Außenministerium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2e6e550-e022-4e54-87bb-5ede56d4e9bd",
                        "source_entry_id": "eedbd687-0b3b-3efb-8710-a6343241462a",
                        "source_sense_id": "d1cc328d-851a-34e4-a5cb-1f33c426c673",
