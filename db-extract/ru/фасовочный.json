                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd2f8b82-9eac-333b-a6b5-974246c40251",
                                        "entry_id": "d0153c14-2d0d-3d1a-892a-697b5673a2f7",
                                        "glosses": [
                                            "The manner in which a person or product is promoted."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "611a6f3f-7596-4ec1-b718-d5df2a9786f5",
                                                "sense_id": "cd2f8b82-9eac-333b-a6b5-974246c40251",
                                                "text": "Do Amaral seems to belong more to a Europian ^([sic]) tradition than to any of the artistic pigeonholes currently in vogue in the States. His failure to show allegiance to any one medium makes him resistant to the relentless packaging that is a feature even of much avant garde American art."
                                            }
