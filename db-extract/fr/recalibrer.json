                "senses": [
                    {
                        "sense_id": "f50d35f2-0648-38cc-8623-35c2e1219df3",
                        "entry_id": "96615693-b2a7-373c-928d-72b5acc0cf62",
                        "glosses": [
                            "Calibrer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a0bb3a-c5af-4d22-8db5-f9ab0d3ffc5d",
                                "sense_id": "f50d35f2-0648-38cc-8623-35c2e1219df3",
                                "text": "J'essaye de recalibrer mon écran tactile, mais je n'arrive pas a enregistrer."
                            },
                            {
                                "example_id": "a9e1be3d-b438-44e0-81a2-5491c5186444",
                                "sense_id": "f50d35f2-0648-38cc-8623-35c2e1219df3",
                                "text": "J'ai mis des années avant de comprendre à la fois la technique de la photo sous-marine et le traitement de la lumière sous la surface, se souvient-il auprès du magazine d'Air France, En vols. La lumière rouge disparaît avec la profondeur, il est donc impératif de recalibrer les photos par la suite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d228522-2bc0-440f-9d82-11e3e066598f",
                        "source_entry_id": "96615693-b2a7-373c-928d-72b5acc0cf62",
                        "source_sense_id": "f50d35f2-0648-38cc-8623-35c2e1219df3",
