                },
                {
                    "sense_id": "3ef5b07c-4c40-3588-b008-dd8dc56e06f3",
                    "sense_definition": "To spread or propagate something negative, such as fear or doubt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>sow</w> doubt about the new economic policy.",
                            "target_lang_translations": {
                                "de": "Der Politiker versuchte, Zweifel an der neuen Wirtschaftspolitik zu <w>säen</w>."
                            }
                        },
                        {
                            "text": "These rumors only serve to <w>sow</w> discord among the team members.",
                            "target_lang_translations": {
                                "de": "Diese Gerüchte dienen nur dazu, Zwietracht unter den Teammitgliedern zu <w>säen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sow doubt",
                        "sow discord"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas Negatives wie Angst oder Zweifel verbreiten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "säen",
                                "target_lang_sense_clarification": "Im übertragenen Sinne: Zweifel oder Zwietracht verbreiten."
                            },
                            {
                                "target_lang_word": "verbreiten",
                                "target_lang_sense_clarification": "Etwas Negatives unter Menschen streuen."
                            }
                        ]
                    }
                }
            ]
        },
