                "senses": [
                    {
                        "sense_id": "49d22203-419e-30b4-a580-92ad9c648e2b",
                        "entry_id": "2b73f8de-245a-3b5d-9659-ea7b65e44814",
                        "glosses": [
                            "Gruppe aus 11 aktiven Fußballspielern, die noch um die Ersatzspieler ergänzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d7f0c3-fe1a-4a22-8947-773a156b077a",
                                "sense_id": "49d22203-419e-30b4-a580-92ad9c648e2b",
                                "text": "Die beiden Fußballmannschaften treffen sich zu einem Freundschaftsspiel im Stadion."
                            },
                            {
                                "example_id": "89c141f4-1951-467d-9c33-4b78cf365533",
                                "sense_id": "49d22203-419e-30b4-a580-92ad9c648e2b",
                                "text": "Später möchte ich so viele Kinder haben, dass ich meine eigene Fußballmannschaft habe."
                            },
                            {
                                "example_id": "d5c6df19-4dca-4415-ad6f-df3b9e123c85",
                                "sense_id": "49d22203-419e-30b4-a580-92ad9c648e2b",
                                "text": "„Denn längst haben wir als Gesellschaft akzeptiert, dass wir wie unsere Fußballmannschaft sind - bunt und nicht uni.“"
                            },
                            {
                                "example_id": "2bf1b332-10c4-4434-96ab-22d777f065ff",
                                "sense_id": "49d22203-419e-30b4-a580-92ad9c648e2b",
                                "text": "„Eine Fußballmannschaft fliegt in die USA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
