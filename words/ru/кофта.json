                    "frequency": "VeryLow",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Графиня осталась в спальной <w>кофте</w> и ночном чепце.",
                            "target_lang_translations": {
                                "en": "The countess remained in her <w>bed jacket</w> and nightcap."
                            }
                        },
                        {
                            "text": "В старых романах часто упоминается домашняя <w>кофта</w> как часть ночного наряда.",
                            "target_lang_translations": {
                                "en": "In old novels, a <w>bed jacket</w> is often mentioned as part of night attire."
                            }
                        }
                    ],
                    "synonyms": [
                        "ночнушка"
                    ],
                    "traits": [
                        {
