                                "target_senses": [
                                    {
                                        "sense_id": "17d5e709-4d32-3072-a6dc-25625e2695c6",
                                        "entry_id": "5f659e20-236e-3db6-af23-53052ad03663",
                                        "glosses": [
                                            "bogini i uosobienie młodości oraz szafarka ambrozji i nektaru na Olimpie, utożsamiana z rzymską Juwentas"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cbbf084-6fc0-430c-8f9d-3838d182f5f5",
                                                "sense_id": "17d5e709-4d32-3072-a6dc-25625e2695c6",
                                                "text": "Hebe uchodziła za córkę Zeusa i Hery, siostrę Ejlejtyi, Aresa i Hefajstosa oraz żonę unieśmiertelnionego Heraklesa."
                                            },
                                            {
                                                "example_id": "b90fe6e4-d5e0-42c9-9f4d-007572f46a8a",
                                                "sense_id": "17d5e709-4d32-3072-a6dc-25625e2695c6",
                                                "text": "Oboje, Hebe i Ganimedes, krzątając się przy ucztach, roznosili bogom ambrozję i nektar"
                                            },
                                            {
                                                "example_id": "b9f4aa32-122f-41b5-a33b-cd49cc032553",
                                                "sense_id": "17d5e709-4d32-3072-a6dc-25625e2695c6",
                                                "text": "Atrybutami Hebe były dzban i czara."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "eab3b1e8-ab7a-350a-88b8-1bc75f6d7f26",
                                        "entry_id": "5f659e20-236e-3db6-af23-53052ad03663",
                                        "glosses": [
                                            "planetoida o numerze katalogowym 6"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8211bc2f-5e95-45a4-b50d-e9a1d3257970",
                                                "sense_id": "eab3b1e8-ab7a-350a-88b8-1bc75f6d7f26",
                                                "text": "Hebe porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
