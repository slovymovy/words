                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ueberdachung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Himmel</w> unseres alten Wagens hängt herunter und muss erneuert werden."
                        },
                        {
                            "text": "In der Werkstatt ließ er den beschädigten <w>Himmel</w> des Autos reparieren."
