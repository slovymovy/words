                "senses": [
                    {
                        "sense_id": "569f927d-dfaa-3943-a818-0499ab84e26c",
                        "entry_id": "6e3c39c3-6d99-38f6-b295-c50fb93befff",
                        "glosses": [
                            "Betriebsgewerkschaftsleitung"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fda627bb-d98b-478c-8382-701497b0f45d",
                                "sense_id": "569f927d-dfaa-3943-a818-0499ab84e26c",
                                "text": "„Auch der schon erwähnte Max Fettling, 1. Vorsitzender der BGL auf der Baustelle Stalinallee, der in der Nacht vom 18. zum 19. Juni verhaftet und zu 10 Jahren Zuchthaus verurteilt wurde, konnte nur immer wieder betonen, daß er eigentlich nichts als seine Arbeit getan hätte – die Arbeit eines Gewerkschaftsfunktionärs.“"
                            },
                            {
                                "example_id": "9ddb1074-041c-4867-a363-5f21f44e3418",
                                "sense_id": "569f927d-dfaa-3943-a818-0499ab84e26c",
                                "text": "„Auf der Grundlage dieser ASAO haben die Betriebsleiter gemeinsam mit den Leitern des BGW (Betriebsgesundheitswesen) und den BGL die in ihren Betrieben zur Sicherung von Leben und Gesundheit noch erforderlichen Beschäftigungsverbote für Frauen und Jugendliche neu festzulegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
