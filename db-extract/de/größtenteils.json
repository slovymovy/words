                                        "examples": [
                                            {
                                                "example_id": "ee3f37b2-a066-478c-8c95-545560dbf8d9",
                                                "sense_id": "74b6611f-e1bc-39cf-9469-ec5144920953",
                                                "text": "Arkadaşlarımın çoğu gibi mektebe lalalarla, uşaklarla gitmedim."
