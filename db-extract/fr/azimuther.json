                        ],
                        "examples": [
                            {
                                "example_id": "8d6d66e7-cbfb-4083-b948-521351e77805",
                                "sense_id": "f7f03c9d-ccf4-3e6a-9426-ac7f02759fed",
                                "text": "Si tu m’azimuthes, comme tu en as l’intention, le secret de la planque disparaîtra avec moi."
                            },
                            {
                                "example_id": "4fa460bc-3773-4c8d-b4b8-162f4ae13a77",
                                "sense_id": "f7f03c9d-ccf4-3e6a-9426-ac7f02759fed",
                                "text": "Je vais venir t’azimuther à 9H du soir et tu vas comprendre ce que c'est de venir troubler les esprits."
                            }
