                    {
                        "translation_id": "6a77eefe-2eb1-43b8-96b1-ed7e95af7910",
                        "source_entry_id": "531ec835-1ca9-3ea8-9ffc-681672d175de",
                        "source_sense_id": "1cbe06da-11c0-3651-aece-5424752568cb",
                        "source_sense_description": "someone who rides a motorcycle — see also biker",
                        "target_lang_word": "motocycliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motocycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2312a46-13e3-3db9-9e03-ecba8b116555",
                                        "entry_id": "41b95140-ba0e-300a-97b5-508635da4004",
                                        "glosses": [
                                            "Relatif à la motocyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43233677-7a11-48e1-8565-b6551b8672a3",
                                                "sense_id": "e2312a46-13e3-3db9-9e03-ecba8b116555",
                                                "text": "On sait qu’une fédération des clubs motocyclistes, issue du récent congrès tenu à Lyon, nourrit la prétention, louable en elle-même, de régir, elle aussi, le sport motocycliste …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "motocycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f4fdf7-4c24-3a2a-aa22-3fd77eb436d1",
                                        "entry_id": "9aad3e69-b7bf-3d40-a73d-70432ab97ddb",
                                        "glosses": [
                                            "Celui, celle qui conduit une motocyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f6b56e1-4c42-4688-8793-d3d4eaca265a",
                                                "sense_id": "b7f4fdf7-4c24-3a2a-aa22-3fd77eb436d1",
                                                "text": "En revenant de chez Jacques Philostène, il avait eu la chance de tomber sur un motocycliste."
                                            },
                                            {
                                                "example_id": "d01b33a9-2bdc-40e2-aa21-3ec713ae37a8",
                                                "sense_id": "b7f4fdf7-4c24-3a2a-aa22-3fd77eb436d1",
                                                "text": "Guidés par des motocyclistes, leurs véhicules se rangent le long des trottoirs, ils s’installent dans nos casernes et bâtiments militaires, les ex-camps anglais, les grands hôtels et belles propriétés réquisitionnés."
                                            },
                                            {
                                                "example_id": "154cd777-68c4-43b6-b0be-4414e0a5bfbd",
                                                "sense_id": "b7f4fdf7-4c24-3a2a-aa22-3fd77eb436d1",
                                                "text": "Selon les constatations de la gendarmerie, le motocycliste doublait une file de véhicules quand il a percuté de plein fouet une voiture qui traversait la route."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecb97265-cfe9-4783-9a6c-5f7e90b9bc36",
                        "source_entry_id": "531ec835-1ca9-3ea8-9ffc-681672d175de",
                        "source_sense_id": "1cbe06da-11c0-3651-aece-5424752568cb",
                        "source_sense_description": "someone who rides a motorcycle — see also biker",
                        "target_lang_word": "Motorradfahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Motorradfahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c07bec0b-9e44-3d7f-8508-8596bf6a31ab",
                                        "entry_id": "9b2fd396-f067-39f6-8e29-26b63921bd98",
                                        "glosses": [
                                            "Person, die auf einem Motorrad fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc8a7105-9dca-4b89-a818-8fe7e1a3b5e3",
                                                "sense_id": "c07bec0b-9e44-3d7f-8508-8596bf6a31ab",
                                                "text": "Der Motorradfahrer fuhr ordnungsgemäß."
                                            },
                                            {
                                                "example_id": "525b2f37-262a-475e-87b3-c6dd1b591cc7",
                                                "sense_id": "c07bec0b-9e44-3d7f-8508-8596bf6a31ab",
                                                "text": "„Es ist ein Motorradfahrer mit Beiwagen, der von einer kurzen Fahrt mit seiner Frau nach Haus kommt.“"
                                            },
                                            {
                                                "example_id": "879dd42b-a66f-4529-9a3e-b6406f6a6453",
                                                "sense_id": "c07bec0b-9e44-3d7f-8508-8596bf6a31ab",
                                                "text": "„Ein Motorradfahrer kommt heran, steht neben mir und starrt mich an.“"
                                            },
                                            {
                                                "example_id": "13da7d98-3b47-4f3f-bde0-976992a3704e",
                                                "sense_id": "c07bec0b-9e44-3d7f-8508-8596bf6a31ab",
                                                "text": "„Ein Motorradfahrer kommt uns entgegen.“"
                                            },
                                            {
                                                "example_id": "b852a390-3958-405e-9da1-e7339b56fc79",
                                                "sense_id": "c07bec0b-9e44-3d7f-8508-8596bf6a31ab",
                                                "text": "„Ein Motorradfahrer zieht als Schutz gegen den kalten Wind seine lederne Motorradjacke verkehrt herum an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
