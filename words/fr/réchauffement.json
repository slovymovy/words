            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b13ee6be-3427-3659-87ca-63bf93459332",
                    "sense_definition": "Hausse globale et durable des températures moyennes de l'atmosphère terrestre et des océans causée par l'activité humaine.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "climat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>réchauffement</w> climatique entraîne une fonte accélérée des glaciers à travers le monde."
                        },
                        {
                            "text": "Les scientifiques alertent régulièrement sur les conséquences désastreuses du <w>réchauffement</w> planétaire."
                        }
                    ],
                    "antonyms": [
                        "refroidissement"
                    ],
                    "common_phrases": [
                        "réchauffement climatique",
                        "réchauffement planétaire"
                    ]
                },
                {
                    "sense_id": "9840bc4b-2abd-357c-8709-5d4b6091c3d9",
                    "sense_definition": "Action d'apporter de la chaleur à un corps ou de porter à nouveau un aliment à température chaude.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "thermique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin préconise un <w>réchauffement</w> progressif du patient afin d'éviter tout choc thermique."
                        },
                        {
                            "text": "Le simple <w>réchauffement</w> de ce plat au four traditionnel prendra une quinzaine de minutes."
                        }
                    ],
                    "antonyms": [
                        "refroidissement"
                    ],
                    "common_phrases": [
                        "réchauffement d'un plat",
                        "couverture de réchauffement"
                    ]
                },
                {
                    "sense_id": "42bd6d6f-b4d0-3cb6-986e-b663564184bc",
                    "sense_definition": "Élévation notable de la température atmosphérique ou météorologique après une période de froid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "thermique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous attendons un net <w>réchauffement</w> des températures à partir de la semaine prochaine."
                        },
                        {
                            "text": "Ce <w>réchauffement</w> printanier soudain a provoqué la floraison précoce des cerisiers du jardin."
                        }
                    ],
                    "antonyms": [
                        "refroidissement"
                    ],
                    "common_phrases": [
                        "réchauffement des températures",
                        "réchauffement printanier"
                    ]
                },
                {
                    "sense_id": "93a69a03-5e27-3706-b29b-37a03e3507f9",
                    "sense_definition": "Amélioration des rapports humains ou diplomatiques qui deviennent plus cordiaux après une période de tension.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux nations célèbrent le <w>réchauffement</w> de leurs relations diplomatiques après plusieurs années de crise."
                        },
                        {
                            "text": "Un timide <w>réchauffement</w> s'est opéré entre les deux collègues au cours de la réunion."
                        }
                    ],
                    "antonyms": [
                        "refroidissement"
                    ],
                    "common_phrases": [
                        "réchauffement diplomatique",
                        "réchauffement des relations"
                    ]
                }
            ]
        }
    ]
