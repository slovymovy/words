                        "entry_id": "4546188c-3770-3b99-9d85-eb9f4ad2eb7b",
                        "glosses": [
                            "A stream that flows out, such as from a lake or reservoir; an outflow; effluence."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "634db988-4286-4cdf-a1b5-416f4f13e97a",
                                "sense_id": "4508617c-1406-33f8-9f5a-e1105b805346",
                                "text": "The landscape was dotted with reservoirs and many many effluent streams."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecc4b98e-e533-331c-afd6-6ce4a126da66",
                        "entry_id": "4546188c-3770-3b99-9d85-eb9f4ad2eb7b",
                        "glosses": [
                            "Sewage or waste water discharged into a natural body of water."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d76d3c06-175f-4f72-b590-7ca3820fd0db",
                                "sense_id": "ecc4b98e-e533-331c-afd6-6ce4a126da66",
                                "text": "Residents have little control over the industrial effluent that pollutes their rivers."
                            },
                            {
                                "example_id": "14783238-1a0c-407b-b0dd-813c423fc204",
                                "sense_id": "ecc4b98e-e533-331c-afd6-6ce4a126da66",
                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                            }
                        ]
                    }
