{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4932dd3c-8d8d-3eb5-b275-20e3d871bc60",
                    "sense_definition": "A desirable or useful feature or facility of a building or place that adds to comfort or convenience.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel offers modern <w>amenity</w> options like a swimming pool and a gym.",
                            "target_lang_translations": {
                                "tr": "Otel, yüzme havuzu ve spor salonu gibi modern <w>olanak</w> seçenekleri sunmaktadır."
                            }
                        },
                        {
                            "text": "Access to local <w>amenities</w> makes this neighborhood very popular for young families.",
                            "target_lang_translations": {
                                "tr": "Yerel <w>imkânlara</w> erişim, bu mahalleyi genç aileler için çok popüler kılmaktadır."
                            }
                        }
                    ],
                    "synonyms": [
                        "facility"
                    ],
                    "common_phrases": [
                        "basic amenity",
                        "modern amenity",
                        "hotel amenity",
                        "local amenity"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir binanın veya yerin konfor ya da kolaylık sağlayan, arzulanan veya yararlı Özelliği veya olanağı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "olanak",
                                "target_lang_sense_clarification": "konfor ve kolaylık sağlayan imkân"
                            },
                            {
                                "target_lang_word": "tesis",
                                "target_lang_sense_clarification": "yüzme havuzu veya spor salonu gibi fiziksel imkânlar"
                            },
                            {
                                "target_lang_word": "imkân",
                                "target_lang_sense_clarification": "yaşamı kolaylaştıran fırsat ve şartlar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fb4e873-ff55-343c-a517-c3cb5df9246e",
                    "sense_definition": "A public service or facility provided for the convenience and enjoyment of the local community.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public library is an essential community <w>amenity</w> that serves residents of all ages.",
                            "target_lang_translations": {
                                "tr": "Halk kütüphanesi, her yaştan mahalle sakinine hizmet veren temel bir toplumsal <w>hizmettir</w>."
                            }
                        },
                        {
                            "text": "The town council invested in public <w>amenity</w> projects to improve the quality of life.",
                            "target_lang_translations": {
                                "tr": "Belediye meclisi, yaşam kalitesini artırmak için kamusal <w>tesis</w> projelerine yatırım yaptı."
                            }
                        }
                    ],
                    "synonyms": [
                        "infrastructure"
                    ],
                    "common_phrases": [
                        "public amenity",
                        "community amenity"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yerel halkın rahatı ve keyfi için sağlanan kamusal hizmet veya tesis."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kamusal hizmet",
                                "target_lang_sense_clarification": "topluma sunulan genel hizmetler"
                            },
                            {
                                "target_lang_word": "sosyal tesis",
                                "target_lang_sense_clarification": "toplumun faydalandığı sosyal alanlar"
                            },
                            {
                                "target_lang_word": "hizmet",
                                "target_lang_sense_clarification": "halka sağlanan faydalı imkânlar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5740e8e-f0c4-34d2-8cc8-09f759e09405",
                    "sense_definition": "The quality of being pleasant, agreeable, or attractive in character or climate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We especially enjoyed the <w>amenity</w> of the climate on our last holiday.",
                            "target_lang_translations": {
                                "tr": "Son tatilimizde özellikle iklimin <w>hoşluğunun</w> tadını çıkardık."
                            }
                        },
                        {
                            "text": "The gentle sound of the river added to the overall <w>amenity</w> of the quiet countryside.",
                            "target_lang_translations": {
                                "tr": "Nehrin hafif sesi, sakin kırsal alanın genel <w>tatlılığına</w> huzur kattı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "amenity of climate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir karakterin veya iklimin hoş, hoşa giden veya çekici olma niteliği."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hoşluk",
                                "target_lang_sense_clarification": "hoş ve dinlendirici olma durumu"
                            },
                            {
                                "target_lang_word": "tatlılık",
                                "target_lang_sense_clarification": "sevimlilik, ılımanlık veya çekicilik"
                            },
                            {
                                "target_lang_word": "ılımanlık",
                                "target_lang_sense_clarification": "iklim için yumuşaklık ve hoşluk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}