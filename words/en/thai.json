                {
                    "sense_id": "2ddd020b-8446-32b8-92c5-99c4b570cdb4",
                    "sense_definition": "A person living in or coming from Thailand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>Thai</w> who has lived in London for five years.",
                            "target_lang_translations": {
                                "ru": "Она <w>тайка</w>, которая живет в Лондоне уже пять лет.",
                                "zh": "她是一位在伦敦住了五年的<w>泰国人</w>。"
                            }
                        },
                        {
                            "text": "Many <w>Thais</w> celebrate the Songkran festival in April.",
                            "target_lang_translations": {
                                "ru": "Многие <w>тайцы</w> отмечают фестиваль Сонгкран в апреле.",
                                "zh": "许多<w>泰国人</w>在四月庆祝宋干节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Thailander"
                    ],
                    "common_phrases": [
                        "native Thai",
                        "Thai people"
                    ],
                    "target_lang_definitions": {
