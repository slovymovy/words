                "senses": [
                    {
                        "sense_id": "7a036a1c-bba3-3f6e-8351-c22e4634ec95",
                        "entry_id": "5a7f7200-e9df-3324-8469-8257d2d2a943",
                        "glosses": [
                            "in een theater of film de achtergrond en zijwanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19670b2-0dc6-49b8-8a4d-b84ee01175cb",
                                "sense_id": "7a036a1c-bba3-3f6e-8351-c22e4634ec95",
                                "text": "De koninklijke zaal waar het toneel zich afspeelde was niet meer de een kartonnen decor."
                            },
                            {
                                "example_id": "e82bbcd1-b870-4b26-8949-7bb22f978095",
                                "sense_id": "7a036a1c-bba3-3f6e-8351-c22e4634ec95",
                                "text": "Moest vroeger een groep hijgende mannen proberen in een mum van tijd nieuwe decors te zetten bij iedere scènewisseling, Nu gaat het elektronisch met een druk op de knop. Het nadeel is natuurlijk dat je als bezoeker geen tijd meer krijgt om je neus te snuiten of gewoon even op adem te komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c335c0ab-412e-30b9-bc7c-d70a142b74fa",
                        "entry_id": "5a7f7200-e9df-3324-8469-8257d2d2a943",
                        "glosses": [
                            "de omgeving waarin iets zich afspeelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eb2c2d7-1557-4cbd-9973-be6286f61977",
                                "sense_id": "c335c0ab-412e-30b9-bc7c-d70a142b74fa",
                                "text": "`Deze stad is een perfect decor voor jou,' zei ik.\n`Bedoel je dat ik oud word?'\n`Ik bedoel dat je nog beter uitkomt in een gouden lijst.'"
                            }
                        ]
                    }
                ],
