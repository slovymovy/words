                        "examples": [
                            {
                                "example_id": "ece82dfa-6a32-43d0-8a75-47259342df67",
                                "sense_id": "1b53d134-2880-30e3-8004-0962fa5b1916",
                                "text": "Hij verliest zijn evenwicht, rent als vanzelf nog een paar meter door en stuit dan op het lichaam van de oude Grisonnier, wiens onverwachte dood het vertreksein was geweest voor deze laatste slachtpartij."
                            },
                            {
                                "example_id": "961f0039-071f-4bc1-abc5-09a50b700f7b",
                                "sense_id": "1b53d134-2880-30e3-8004-0962fa5b1916",
                                "text": "In 2008 was het de eerste keer dat het olijke gezelschap met de eigen bus een eindtoernooi bezocht. Vorige week donderdagavond klonk in Eibergen bij het bandencentrum van Henk Vermeulen, een van de tien ‘Bofkonten’, het vertreksein voor de vijftig uur durende rit naar Charkov."
                            }
                        ]
