                "senses": [
                    {
                        "sense_id": "f0fd35c4-3e6c-3426-b836-0e835960aa5d",
                        "entry_id": "7cab8be4-e856-375b-a339-f57d19b739e8",
                        "glosses": [
                            "Recouvert de lambris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad92fde7-023b-414b-a6f5-fea3c2f817f2",
                                "sense_id": "f0fd35c4-3e6c-3426-b836-0e835960aa5d",
                                "text": "La chambre de Raoule était capitonnée de damas rouge et lambrissée, aux pourtours, de bois des îles sertis de cordelières de soie."
                            },
                            {
                                "example_id": "8192b489-4f9f-485b-aa9e-080a12c50d95",
                                "sense_id": "f0fd35c4-3e6c-3426-b836-0e835960aa5d",
                                "text": "Le mur est lambrissé de statues en bois sculpté, avec un long auvent qui n’est qu’une dentelle de fleurettes, trèfles, épines, statuettes, feuilles, boutons entrelacés, une efflorescence, un épanouissement merveilleux."
                            },
                            {
                                "example_id": "87499ea9-2db0-4afb-987f-2a90599e3fea",
                                "sense_id": "f0fd35c4-3e6c-3426-b836-0e835960aa5d",
                                "text": "Sa vue sur le Parc, sur les bosquets, sur le Grand Canal lui eut permis d’être moins somptueusement lambrissée, voûtée, meublée."
                            }
                        ]
                    }
                ],
