                "senses": [
                    {
                        "sense_id": "f2a4cc26-7339-31bb-ab15-cd1f8fe8cdd8",
                        "entry_id": "ea676b56-91f1-3f67-84fb-b28afc02e137",
                        "glosses": [
                            "the Low German dialect(s) of the Sauerland"
                        ],
                        "tags": [
                            "neuter",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "98c4d8ba-e452-45c7-abac-6c643a39b431",
                                "sense_id": "f2a4cc26-7339-31bb-ab15-cd1f8fe8cdd8",
                                "text": "Sie [= Die ravensbergische Mundart] gehört aber ihrer ganzen Natur nach entschieden zu der süd- oder ostwestfälischen Gruppe und hat also ihre nächsten Verwandten im Lippischen, Schaumburgischen, Paderbornischen, Soestischen, und Sauerländischen an der oberen und mittleren Ruhr und Lenne."
                            },
                            {
                                "example_id": "12d6a981-a92d-456d-9184-3158d00c1e5e",
                                "sense_id": "f2a4cc26-7339-31bb-ab15-cd1f8fe8cdd8",
                                "text": "II. Zweite Gruppe:\nBeide ô gehen in au über.\n(Das Sauerländische und Paderborn'sche.)",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "59485849-347e-47e3-920a-4e7fc3a2922f",
                                "sense_id": "f2a4cc26-7339-31bb-ab15-cd1f8fe8cdd8",
                                "text": "Im westlichen Westfälischen lassen sich … zwei Haupträume und zwei westliche Randgebiete unterscheiden. Der Süden mit dem Sauerländischen um Lüdenscheid – Meschede – Winterberg, dem Soestischen und dem Märkischen um Schwelm – Dortmund – Recklinghausen erweist sich … am konservativsten."
                            },
                            {
                                "example_id": "b3dd29fc-ddff-4b5f-88ba-12e708d5b2f9",
                                "sense_id": "f2a4cc26-7339-31bb-ab15-cd1f8fe8cdd8",
                                "text": "So „scheint“ nach Saltveit (1983b: 1227) die tun-Fügung als Ersatz für Konj. II-Formen (nicht Irrealis!) im Moselfränkischen wie im Sauerländischen „ungebräuchlich“ zu sein.",
                                "translation": "(please add an English translation of this quotation)",
