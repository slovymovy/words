                    {
                        "translation_id": "12b66dea-68ce-433b-aebd-4caf6ddd942d",
                        "source_entry_id": "a63b33ee-6bba-37e0-b357-87407b0cc40d",
                        "source_sense_id": "f53ab163-a642-32e8-ae7a-fbf514e79b3a",
                        "target_lang_word": "Bugspriet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bugspriet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                        "entry_id": "61415336-f674-35d9-b830-77e27edaef93",
                                        "glosses": [
                                            "über den Bug hinausragende Segelstange"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c73cbbc-0fed-4498-a56b-e1a70bae6db1",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "Am Bugspriet stehen viele Personen."
                                            },
                                            {
                                                "example_id": "bf54e3a4-b85c-4cc5-b8c7-333d8e7c241f",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "„An zwischen Fock- und Großmast gespannten Leinen und an den Seilen, die den Fockmast mit dem stummelartigen Bugspriet verbanden, hingen Kleider zum Trocknen.“"
                                            },
                                            {
                                                "example_id": "29e71d0e-3ae7-4921-9ebd-2ace098ad671",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "„Im selben Moment fiel aus Richtung Bugspriet ein Schuß.“"
                                            },
                                            {
                                                "example_id": "33c41c9d-5c92-493d-b1a3-d4e6e4c8d2f6",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "„Vorgestern hockten die Offiziere und Arbeiter an den Davits der Rettungsboote, gestern am Bugspriet, heute morgen wurden die Sirenen ausprobiert.“"
                                            },
                                            {
                                                "example_id": "404d7f0e-d7b6-4bf5-8b48-9d9a16504996",
                                                "sense_id": "4f59ed8f-db13-328b-8d2c-c0ef9beb3286",
                                                "text": "„Am Bugspriet standen die Kapitäne und strichen sich besorgt die Bärte, denn die Jahreszeit der Meeresstürme stand bevor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
