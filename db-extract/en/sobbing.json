                                "target_senses": [
                                    {
                                        "sense_id": "2d89c758-19d1-3c13-a950-271ca3571a7d",
                                        "entry_id": "9cbd9079-d6fa-3f20-89af-282305bb173f",
                                        "glosses": [
                                            "Qui sanglote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5bd223c-93b5-42ae-8d6b-53e1bb40b511",
                                                "sense_id": "2d89c758-19d1-3c13-a950-271ca3571a7d",
                                                "text": "Il collait sa bouche sanglotante sur la peau de l’enfant."
                                            },
                                            {
                                                "example_id": "669f3c0a-6d92-4546-a079-cd82a3f4b776",
                                                "sense_id": "2d89c758-19d1-3c13-a950-271ca3571a7d",
                                                "text": "Ma bonne est partie, dit Christine en recommençant à sangloter.\nMADAME DES ORMES.\nAh ! c’est vrai ! Alors, viens tout de même comme tu es.\nM. DES ORMES.\nElle ne peut pas aller chez Mme de Guibert sanglotante, décoiffée et chiffonnée."
                                            },
                                            {
                                                "example_id": "c777dab1-f00c-477b-ac66-04912cf26fe9",
                                                "sense_id": "2d89c758-19d1-3c13-a950-271ca3571a7d",
                                                "text": "On entendit alors un fracas de sauve-qui-peut, la porte fut ouverte, arrachée avec violence, et les trois hommes affolés, tremblants, hurlants, sanglotants, suffoqués et perdus d’effroi, se précipitèrent en avant…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sanglotant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e3c1163-4582-349b-a274-d16136be74c7",
                                        "entry_id": "553020aa-ec59-3268-afe9-ca01892e16ae",
                                        "glosses": [
                                            "Participe présent du verbe sangloter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc16873a-c366-4c8c-8844-d3f7de99a47b",
                                                "sense_id": "9e3c1163-4582-349b-a274-d16136be74c7",
                                                "text": "Quand Flore Brazier descendit, elle trouva la foule très disposée à suivre les impressions qu’elle voulait lui donner ; elle se montra les larmes aux yeux, et fit observer en sanglotant que le peintre, qui avait une figure à ça d’ailleurs, s’était la veille disputé chaudement avec Max à propos des tableaux qu’il avait chippés au père Rouget."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
