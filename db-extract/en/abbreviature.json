                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1826ac9e-9bf1-48ce-87e6-7e9aa83d7a84",
                                                "sense_id": "b8a41e91-5a71-3b3e-96ba-7d8393d034ed",
                                                "text": "El vocablo \"Méx.\" es una abreviatura que emplea el Diccionario de la Real Academia para indicar que la acepción es propia del español hablado en México."
