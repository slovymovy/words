                    }
                ],
                "senses": [
                    {
                        "sense_id": "2984014a-2736-3756-8af3-d804808d0dca",
                        "entry_id": "643823e5-859a-30b6-add0-aeeb6e548854",
                        "glosses": [
                            "Médicament antagoniste des récepteurs de la morphine."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "32d89565-4d58-458f-994b-886921d0982c",
                                "sense_id": "2984014a-2736-3756-8af3-d804808d0dca",
                                "text": "En association avec la buprénorphine, la naloxone est utilisée dans la prise en charge de dépendances aux opiacés."
                            },
                            {
                                "example_id": "7ce7ea18-d2ff-4c67-a2e4-29856f287e5c",
                                "sense_id": "2984014a-2736-3756-8af3-d804808d0dca",
                                "text": "Grâce à la formation qu’elle a suivie, Sharon Nedley sait comment administrer sans risque la naloxone, un médicament qui combat rapidement les effets nocifs des opioïdes, comme la morphine, l’héroïne ou la méthadone."
                            },
                            {
                                "example_id": "04261044-5ecc-4469-a293-c4b5ad57cd72",
                                "sense_id": "2984014a-2736-3756-8af3-d804808d0dca",
                                "text": "La naloxone est une substance qui présente une très forte affinité pour les récepteurs du cerveau sur lesquels se fixent les substances opioïdes. Une fois administrée, elle prend la place de l’opioïde à l’origine du surdosage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1f920f3-0879-4fb0-bc6f-61e597725088",
                        "source_entry_id": "643823e5-859a-30b6-add0-aeeb6e548854",
                        "source_sense_id": "2984014a-2736-3756-8af3-d804808d0dca",
