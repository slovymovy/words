                        "examples": [
                            {
                                "example_id": "4321a68d-a762-499b-bf01-5299fe6efe62",
                                "sense_id": "50d30556-5494-39a0-a60e-08c7421dfe8a",
                                "text": "Door sommigen wordt dit scherp veroordeeld"
                            },
                            {
                                "example_id": "43862629-8c9b-4013-8362-bc4df25c8ca3",
                                "sense_id": "50d30556-5494-39a0-a60e-08c7421dfe8a",
                                "text": "Sommigen gingen wat eten en anderen zaten zwijgend voor zich uit te staren."
                            },
                            {
                                "example_id": "7e793123-c51d-48ee-be71-2f7cca7dc061",
                                "sense_id": "50d30556-5494-39a0-a60e-08c7421dfe8a",
                                "text": "Met de overgrote meerderheid van de kinderen in de studie was van tevoren al weinig aan de hand, en hoewel sommigen rondom de geboorte van hun broertje of zusje inderdaad wat gedragsproblemen vertoonden - met name agressie kon flink toenemen - waren de meesten van hen na vier maanden alweer de oude."
                            }
                        ]
                    }
