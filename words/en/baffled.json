{
    "word_family": [
        "baffle",
        "bafflement",
        "baffling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1aa38ac0-9b9b-34f1-a53e-dbb3bb776456",
                    "sense_definition": "Thoroughly confused or puzzled by something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked completely <w>baffled</w> by the complex puzzle.",
                            "target_lang_translations": {
                                "cs": "Vypadala, že je z toho složitého hlavolamu úplně <w>zmatená</w>."
                            }
                        },
                        {
                            "text": "The scientists were <w>baffled</w> by the unexpected results of the experiment.",
                            "target_lang_translations": {
                                "cs": "Vědci byli z nečekaných výsledků experimentu <w>zmatení</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewildered",
                        "perplexed",
                        "confused"
                    ],
                    "antonyms": [
                        "clear",
                        "certain"
                    ],
                    "common_phrases": [
                        "completely baffled",
                        "utterly baffled"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zcela zmatený nebo vyvedený z míry něčím."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zmatený",
                                "target_lang_sense_clarification": "obecný stav zmatení"
                            },
                            {
                                "target_lang_word": "bezradný",
                                "target_lang_sense_clarification": "když někdo neví, jak dál"
                            },
                            {
                                "target_lang_word": "vyvedený z míry",
                                "target_lang_sense_clarification": "pocit překvapení a zmatku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e537d5e9-819f-3193-9f57-b8e84675bb28",
                    "sense_definition": "Equipped with baffles, which are devices used to regulate the flow of fluids or sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine features a <w>baffled</w> oil pan to prevent sloshing.",
                            "target_lang_translations": {
                                "cs": "Motor je vybaven olejovou vanou <w>s přepážkami</w>, aby se zabránilo přelévání oleje."
                            }
                        },
                        {
                            "text": "The acoustic room was <w>baffled</w> to reduce echo and noise.",
                            "target_lang_translations": {
                                "cs": "Akustická místnost byla <w>opatřena tlumiči</w> pro snížení ozvěny a hluku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vybavený přepážkami (bafly) pro regulaci proudění tekutin nebo zvuku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opatřený přepážkami",
                                "target_lang_sense_clarification": "technický popis konstrukce"
                            },
                            {
                                "target_lang_word": "s tlumiči",
                                "target_lang_sense_clarification": "v kontextu akustiky nebo proudění"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ef887eb-81fd-325d-8c34-3d48cc3f4dd2",
                    "sense_definition": "Simple past and past participle of <w>baffle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange noise <w>baffled</w> the investigators for several weeks.",
                            "target_lang_translations": {
                                "cs": "Ten podivný hluk vyšetřovatele několik týdnů <w>zmátl</w>."
                            }
                        },
                        {
                            "text": "His sudden departure has <w>baffled</w> all of his close friends.",
                            "target_lang_translations": {
                                "cs": "Jeho náhlý odchod všechny jeho blízké přátele <w>uvedl v úžas</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb baffle."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa 'baffle' (zmást, uvést v úžas)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zmátl",
                                "target_lang_sense_clarification": "způsobil zmatek"
                            },
                            {
                                "target_lang_word": "uvedl v úžas",
                                "target_lang_sense_clarification": "překvapil něčím nepochopitelným"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}