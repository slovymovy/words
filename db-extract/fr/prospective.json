                ],
                "senses": [
                    {
                        "sense_id": "d341e99b-e1fc-3d4c-a38a-cd313b220c22",
                        "entry_id": "5f6045dc-09af-347d-abce-9b21884f95d2",
                        "glosses": [
                            "Étude des avenirs possibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ec2885a-cce2-4270-9425-36be1d2e90be",
                                "sense_id": "d341e99b-e1fc-3d4c-a38a-cd313b220c22",
                                "text": "J’évoque alors en rafale les rumeurs courant les salles de rédaction sur Ze Plan, qui instaurerait dans certains quartiers une sharia soft, mais Serge s’esclaffe « tout cela provient de la fuite d’un scénario de type « ultra-accommodant » de la cellule Prospective du ministère de l’Intérieur, c’est payé pour ça les cellules Prospectives, gamberger sans tabou."
                            },
                            {
                                "example_id": "af80a335-50e9-4977-b4ca-aa78b47898c1",
                                "sense_id": "d341e99b-e1fc-3d4c-a38a-cd313b220c22",
                                "text": "La prospective suppose une vision à long terme, une réflexion large et ouverte, la prise en compte des acteurs internes et externes."
                            },
                            {
                                "example_id": "ee4e069e-da6b-488a-9191-44d699d892ab",
                                "sense_id": "d341e99b-e1fc-3d4c-a38a-cd313b220c22",
                                "text": "Sans compter que les méthodes de prospective évoluent: la modélisation, largement répandue il y a quelques années, est désormais en perte de vitesse, parce que jugée trop complexe à mettre en oeuvre, pour des résultats incertains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f76edce-150b-4e58-b76f-dad0ee0c00a7",
                        "source_entry_id": "5f6045dc-09af-347d-abce-9b21884f95d2",
                        "source_sense_id": "d341e99b-e1fc-3d4c-a38a-cd313b220c22",
                        "target_lang_word": "foresight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foresight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                        "entry_id": "e9b90758-4893-33d2-9056-e8e4503d078a",
                                        "glosses": [
                                            "The ability to foresee or prepare wisely for the future."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aa10e5c-8319-4cfe-8971-e2f4562a70d1",
                                                "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                                "text": "Having the foresight to prepare an evacuation plan may have saved their lives."
                                            },
                                            {
                                                "example_id": "30f34a82-12ac-4e27-ae3e-21c89cf02824",
                                                "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                                "text": "The rugged forhead that with graue foreſight / Welds kingdomes cauſes, & affaires of ſtate; […]"
                                            },
                                            {
                                                "example_id": "feb47bc8-fc7a-488b-a071-9874b8bb570c",
                                                "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: […]"
                                            },
                                            {
                                                "example_id": "8e06d51c-eb96-4a2b-af2d-239b4f3c0cde",
                                                "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                                "text": "The specifiers of the Freightliner network had the foresight to base the rail journey on carrying ISO containers which are 8ft wide and originally 8ft tall (although now increased to a height of 9ft 6ins), with a variety of lengths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0317e045-91e9-315c-975a-b89b46c07153",
                                        "entry_id": "e9b90758-4893-33d2-9056-e8e4503d078a",
                                        "glosses": [
                                            "The front sight on a rifle or similar weapon."
                                        ],
