                        "cross_references": [
                            {
                                "target_word": "porte vitrée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b7c736d-7729-3925-a55a-4cf675801a10",
                                        "entry_id": "d0f2846d-ee39-3cf5-be07-448972489bef",
                                        "glosses": [
                                            "Porte qui est partagée dans toute sa hauteur ou seulement à moitié par des croisillons de bois ou de fer, dont les vides sont remplis par des carreaux de verre ou des glaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702a5a48-4191-47f9-a2fb-36932c8530d5",
                                                "sense_id": "7b7c736d-7729-3925-a55a-4cf675801a10",
                                                "text": "Il y avait là, juste en face, une boutique de modeste apparence qui pouvait bien être celle d'une crèmerie. La porte vitrée était ouverte et une femme en tablier blanc se tenait sur le seuil, attendant la pratique."
                                            },
                                            {
                                                "example_id": "80eba8ed-984d-45f7-9735-23e9c0a3496a",
                                                "sense_id": "7b7c736d-7729-3925-a55a-4cf675801a10",
                                                "text": "Lorsqu’il passe devant le bâtiment quelques minutes plus tard, il lit les plaques qui encadrent la porte vitrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
