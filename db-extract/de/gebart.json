                    }
                ],
                "senses": [
                    {
                        "sense_id": "a26631b5-c6f8-3a10-80ec-554d88a9a0d6",
                        "entry_id": "a5433926-c902-3b0f-b345-682a4b889c67",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01561195-06e6-452e-9e8d-73c61139ae9b",
                                "sense_id": "a26631b5-c6f8-3a10-80ec-554d88a9a0d6",
                                "text": "Frau Gebart ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8ce7cfd5-e984-4539-ae70-0ba733d816c6",
                                "sense_id": "a26631b5-c6f8-3a10-80ec-554d88a9a0d6",
                                "text": "Herr Gebart wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1b988cc2-60e6-446a-b6e4-3275ecf265d5",
                                "sense_id": "a26631b5-c6f8-3a10-80ec-554d88a9a0d6",
                                "text": "Die Gebarts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f83c3d79-ae73-4f94-be33-2a2163a6fe2e",
                                "sense_id": "a26631b5-c6f8-3a10-80ec-554d88a9a0d6",
                                "text": "Der Gebart trägt nie die Schals, die die Gebart ihm strickt."
                            },
                            {
                                "example_id": "cd2bca93-670b-4023-9b8f-26eac4ec06dc",
                                "sense_id": "a26631b5-c6f8-3a10-80ec-554d88a9a0d6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gebart kommt, geht der Herr Gebart.“"
                            },
                            {
                                "example_id": "5035cda6-0d72-4b32-89d3-6d6497104049",
                                "sense_id": "a26631b5-c6f8-3a10-80ec-554d88a9a0d6",
                                "text": "Gebart kommt und geht."
                            },
                            {
                                "example_id": "f3c11abf-6200-4cf2-82c2-f2e08d2478cb",
                                "sense_id": "a26631b5-c6f8-3a10-80ec-554d88a9a0d6",
                                "text": "Gebarts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
