                    "sense_definition": "To damage or ruin someone's reputation, honor, or good name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rival newspaper was on a relentless campaign to <w>besmirch</w> the actor's reputation."
                        },
                        {
                            "text": "He refused to lie because he would never do anything to <w>besmirch</w> his family's name."
                        }
                    ],
                    "synonyms": [
                        "smear",
                        "slander",
                        "libel",
                        "blacken",
                        "debase"
                    ],
                    "common_phrases": [
