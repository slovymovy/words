                "senses": [
                    {
                        "sense_id": "736e5470-d5a9-353b-a46d-e85f2136154d",
                        "entry_id": "4e9ee09d-3e07-334d-8103-96678db604d4",
                        "glosses": [
                            "Épanouir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5b55a8-cab8-4ff1-8765-b408fbc983a3",
                                "sense_id": "736e5470-d5a9-353b-a46d-e85f2136154d",
                                "text": "Mais un sourire de sa bouche étroite et charnue fit se réépanouir sa beauté."
                            },
                            {
                                "example_id": "aa24cd63-bc01-4ca0-afe3-54ec0ca40578",
                                "sense_id": "736e5470-d5a9-353b-a46d-e85f2136154d",
                                "text": "En réalité, la veine continue à se contracter au delà du col pour se réépanouir plus loin, suivant la pleine section."
                            }
                        ]
                    }
