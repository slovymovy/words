                {
                    "sense_id": "8cb1359b-d4bc-3bed-83e4-b709c9e3d350",
                    "sense_definition": "Qui manifeste une vanité, une prétention ou une arrogance insupportable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son comportement est devenu tellement <w>puant</w> que plus personne ne veut travailler avec lui.",
                            "target_lang_translations": {
                                "en": "His behaviour has become so <w>arrogant</w> that nobody wants to work with him any more.",
                                "ru": "Его поведение стало настолько <w>высокомерным</w>, что никто больше не хочет с ним работать.",
                                "de": "Sein Verhalten ist so <w>überheblich</w> geworden, dass niemand mehr mit ihm arbeiten will.",
                                "es": "Su comportamiento se ha vuelto tan <w>arrogante</w> que ya nadie quiere trabajar con él.",
                                "zh": "他的态度变得如此<w>傲慢</w>，以至于再也没有人愿意和他共事。"
                            }
                        },
                        {
                            "text": "Ce personnage affiche un mépris <w>puant</w> envers tous les nouveaux employés du service.",
                            "target_lang_translations": {
                                "en": "This man shows <w>arrogant</w> contempt for all the new staff in the department.",
                                "ru": "Этот человек демонстрирует <w>высокомерное</w> презрение ко всем новым сотрудникам отдела.",
                                "de": "Dieser Mann zeigt gegenüber allen neuen Mitarbeitern der Abteilung eine <w>überhebliche</w> Verachtung.",
                                "es": "Este individuo muestra un desprecio <w>arrogante</w> hacia todos los nuevos empleados del departamento.",
                                "zh": "这个人对部门里所有新来的员工都流露出一种<w>傲慢</w>的轻蔑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrogant",
                        "suffisant",
                        "vaniteux"
                    ],
                    "antonyms": [
                        "humble",
                        "modeste"
                    ],
                    "common_phrases": [
                        "orgueil puant"
                    ],
                    "target_lang_definitions": {
