                    {
                        "translation_id": "b8be4f56-d0aa-4bbd-9cff-274ec042395d",
                        "source_entry_id": "120bf9e3-4fb0-38ed-b0f9-029c6a4ab134",
                        "source_sense_id": "8676d058-3146-3fe7-b1fb-74e2d2c2c31b",
                        "source_sense_description": "tägliche Nachrichtensendung",
                        "target_lang_word": "news",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "news",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                        "entry_id": "f951dbbf-3ec6-33bc-847b-8d8b6e2e24fb",
                                        "glosses": [
                                            "New information of interest."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3f0fcd-9688-48c3-bf86-40c689d84053",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "Is there any news about the storm?"
                                            },
                                            {
                                                "example_id": "1aea41bc-1a57-47f7-9f62-bbd25e9043b1",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "That was not much news in the press release."
                                            },
                                            {
                                                "example_id": "94a5bbf7-2ec9-491d-984c-b5db56aa09d1",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "VVith speede let vs impart the newes vnto my Lord the King,\nThe fearefull newes that whilſt the flame doth but begin,\nSad pollicie may ſerue to quench the fire: […]"
                                            },
                                            {
                                                "example_id": "d9daf56e-a816-49ac-865a-f0f812356258",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "Sirra, your Lord and maſters married, there's newes for you: you haue a new Miſtris."
                                            },
                                            {
                                                "example_id": "a31671a3-9a5c-45f2-9b7e-c1febd631313",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "When theſe news were brought to him, ſome counſelled him to go to Stirlin, where the King was, and where he would be the ſtronger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                                        "entry_id": "f951dbbf-3ec6-33bc-847b-8d8b6e2e24fb",
                                        "glosses": [
                                            "Information about current events disseminated by the media."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049d62b4-ef41-4045-91b4-4a10443ec853",
                                                "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                                                "text": "Did you hear/read/see the latest news?"
                                            },
                                            {
                                                "example_id": "a36a518c-07f8-4142-b678-67dba67d9a1c",
                                                "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                                                "text": "The news is that a new leader will be elected in one month."
                                            },
                                            {
                                                "example_id": "d48ad57e-16a6-4d6c-8f5a-27e13f2aeb02",
                                                "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                                                "text": "I heard about the earthquake on the morning news."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f37c860-de67-33bd-9e16-f77369edeaa3",
                                        "entry_id": "f951dbbf-3ec6-33bc-847b-8d8b6e2e24fb",
                                        "glosses": [
                                            "Messages posted on newsgroups."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e51134-0655-40f0-aa2e-9b0cc63628b4",
                                                "sense_id": "9f37c860-de67-33bd-9e16-f77369edeaa3",
                                                "text": "The Usenet news system brings people together from around the world and forms social groups on the basis of common interest. Usenet news is a domain that is suffering badly from information overload."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "news",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0eb6f30d-459f-3eab-baeb-69959d6bbe77",
                                        "entry_id": "841c3b75-498b-34ec-a03c-cb9b57e6af30",
                                        "glosses": [
                                            "To report; to make known."
                                        ],
