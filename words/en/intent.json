{
    "word_family": [
        "intend",
        "intention",
        "intentional",
        "intentionally",
        "unintentional"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18a0332d-94b9-34f1-9433-c1a746471f3b",
                    "sense_definition": "An aim, purpose, or plan that someone has.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was never my <w>intent</w> to cause such confusion among the staff.",
                            "target_lang_translations": {
                                "ru": "У меня никогда не было <w>намерения</w> вызывать такую путаницу среди персонала.",
                                "tr": "Personel arasında böyle bir kafa karışıklığına yol açmak asla benim <w>niyetim</w> değildi."
                            }
                        },
                        {
                            "text": "The group declared their <w>intent</w> to fight the new regulations in court.",
                            "target_lang_translations": {
                                "ru": "Группа заявила о своем <w>намерении</w> оспаривать новые правила в суде.",
                                "tr": "Grup, yeni düzenlemelerle mahkemede mücadele etme <w>niyetlerini</w> açıkladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "intention",
                        "aim",
                        "purpose",
                        "objective",
                        "goal"
                    ],
                    "common_phrases": [
                        "with intent",
                        "statement of intent",
                        "letter of intent",
                        "to all intents and purposes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цель, замысел или план, который есть у кого-либо.",
                        "tr": "Birinin sahip olduğu bir amaç, niyet veya plan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наме́рение",
                                "target_lang_sense_clarification": "желание или замысел сделать что-то"
                            },
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "конечный результат, на который направлено действие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "niyet",
                                "target_lang_sense_clarification": "bir şeyi yapmayı planlama veya isteme"
                            },
                            {
                                "target_lang_word": "amaç",
                                "target_lang_sense_clarification": "ulaşılmak istenen hedef veya maksat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5df747d-aa85-30d9-83f7-692928fb0b50",
                    "sense_definition": "The state of mind in which a person knowingly commits an illegal act.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecutor must prove that there was criminal <w>intent</w> behind the actions.",
                            "target_lang_translations": {
                                "ru": "Прокурор должен доказать, что в действиях присутствовал преступный <w>умысел</w>.",
                                "tr": "Savcı, eylemlerin arkasında suç <w>kastı</w> olduğunu kanıtlamalıdır."
                            }
                        },
                        {
                            "text": "He was charged with possession of a weapon with <w>intent</w> to harm.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в хранении оружия с <w>умыслом</w> причинить вред.",
                                "tr": "Zarar verme <w>kastıyla</w> silah bulundurmaktan suçlandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "criminal intent",
                        "malicious intent",
                        "with intent to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние ума, при котором человек сознательно совершает противозаконное действие.",
                        "tr": "Bir kişinin yasa dışı bir eylemi bilerek gerçekleştirdiği zihinsel durum."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́мысел",
                                "target_lang_sense_clarification": "в юридическом контексте: осознанное намерение совершить преступление"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kasıt",
                                "target_lang_sense_clarification": "hukukta: bilerek ve isteyerek suç işleme durumu"
                            },
                            {
                                "target_lang_word": "kötü niyet",
                                "target_lang_sense_clarification": "suç teşkil eden eylemdeki kasıtlı durum"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec4dbaa5-b66a-3319-881c-ddfbd0548a17",
                    "sense_definition": "Fully determined and resolved to do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "determined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She seems <w>intent</w> on finishing the project by tonight no matter what.",
                            "target_lang_translations": {
                                "ru": "Она, кажется, <w>твердо намерена</w> закончить проект сегодня вечером, несмотря ни на что.",
                                "tr": "Ne olursa olsun projeyi bu geceye kadar bitirmeye <w>kararlı</w> görünüyor."
                            }
                        },
                        {
                            "text": "The children were <w>intent</w> on having a good time despite the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Дети были <w>полны решимости</w> хорошо провести время, несмотря на проливной дождь.",
                                "tr": "Çocuklar, şiddetli yağmura rağmen iyi vakit geçirmeye <w>azimliydi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "determined",
                        "resolved",
                        "bent",
                        "set"
                    ],
                    "common_phrases": [
                        "intent on",
                        "intent upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо решивший сделать что-либо.",
                        "tr": "Bir şeyi yapmaya tamamen kararlı ve azimli olma durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́лный реши́мости",
                                "target_lang_sense_clarification": "твердо настроенный на выполнение чего-либо"
                            },
                            {
                                "target_lang_word": "наме́ренный",
                                "target_lang_sense_clarification": "имеющий твердое намерение (обычно в составе сказуемого)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kararlı",
                                "target_lang_sense_clarification": "bir şeyi yapmaya kesin karar vermiş olan"
                            },
                            {
                                "target_lang_word": "azimli",
                                "target_lang_sense_clarification": "bir amaca ulaşmak için kararlılık gösteren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76aab3a4-9e40-344f-b456-4d6ab4aac92d",
                    "sense_definition": "Showing strong interest and concentrated attention.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "focused",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He listened to the instructions with an <w>intent</w> expression on his face.",
                            "target_lang_translations": {
                                "ru": "Он слушал инструкции с <w>сосредоточенным</w> выражением лица.",
                                "tr": "Talimatları yüzünde <w>pürdikkat</w> bir ifadeyle dinledi."
                            }
                        },
                        {
                            "text": "The audience remained <w>intent</w> throughout the long and complex speech.",
                            "target_lang_translations": {
                                "ru": "Публика оставалась <w>сосредоточенной</w> на протяжении всей этой длинной и сложной речи.",
                                "tr": "Dinleyiciler, bu uzun ve karmaşık konuşma boyunca <w>dikkatle</w> dinlemeye devam etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "engrossed",
                        "absorbed",
                        "focused",
                        "rapt"
                    ],
                    "antonyms": [
                        "distracted",
                        "absent-minded"
                    ],
                    "common_phrases": [
                        "intent gaze",
                        "intent look",
                        "intent silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий сильный интерес и пристальное внимание.",
                        "tr": "Güçlü bir ilgi ve yoğunlaşmış bir dikkat gösteren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосредото́ченный",
                                "target_lang_sense_clarification": "о внимании, лице или человеке"
                            },
                            {
                                "target_lang_word": "при́стальный",
                                "target_lang_sense_clarification": "обычно о взгляде или наблюдении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "pürdikkat",
                                "target_lang_sense_clarification": "büyük bir dikkatle odaklanmış"
                            },
                            {
                                "target_lang_word": "dikkatli",
                                "target_lang_sense_clarification": "yoğun ilgi ve odaklanma gösteren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}