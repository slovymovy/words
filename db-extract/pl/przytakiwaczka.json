                "senses": [
                    {
                        "sense_id": "9b24d6dc-cb18-33a8-ac65-43445464b4ae",
                        "entry_id": "53e24a26-5669-30e8-80a9-41d76649f9e6",
                        "glosses": [
                            "kobieta nie mająca własnego zdania, przytakująca innym, zwłaszcza tym, od których jest zależna"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e929f337-80e7-476c-a17f-18d2fad821ee",
                                "sense_id": "9b24d6dc-cb18-33a8-ac65-43445464b4ae",
                                "text": "Ja jako działaczka od zawsze przytakiwaczka wszelkim władzom, bo władza ma zawsze rację i w każdym przypadku też, protestuję (z wykrzyknikiem na swoim miejscu), bo Szanowny seksista redaktor wywrotowy i całkiem zasiedziały w męskich pogwarkach – zapomina o ważnej sprawie – parytetach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
