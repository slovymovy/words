                                ]
                            },
                            {
                                "target_word": "Wehe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42b7603b-4497-3bf7-b227-e0b1a384bdc8",
                                        "entry_id": "85a87781-4790-3b61-ad7c-1a4cee7c1579",
                                        "glosses": [
                                            "Kontraktion der Gebärmutter während der Geburt"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28ddb32b-23af-4d43-bee2-a3dfc9b9a5ea",
                                                "sense_id": "42b7603b-4497-3bf7-b227-e0b1a384bdc8",
                                                "text": "Es waren schmerzhafte Wehen."
                                            },
                                            {
                                                "example_id": "461a969c-2764-4d83-a105-3a31647dec19",
                                                "sense_id": "42b7603b-4497-3bf7-b227-e0b1a384bdc8",
                                                "text": "„Die Wehen hatten am Morgen eingesetzt, aber noch war kein Laut nach außen gedrungen.“"
                                            },
                                            {
                                                "example_id": "a23c4eed-97c7-4b3c-89d5-3a4b20642215",
                                                "sense_id": "42b7603b-4497-3bf7-b227-e0b1a384bdc8",
                                                "text": "„Sie hebt mich auf die Beine, weil ich mich bewegen soll, sobald die Wehen eine Pause einlegen.“"
                                            },
                                            {
                                                "example_id": "3fdab08f-ae62-4de8-b205-e216f52e6c86",
                                                "sense_id": "42b7603b-4497-3bf7-b227-e0b1a384bdc8",
                                                "text": "„Da bäumte sich wieder eine Wehe in ihr auf.“"
                                            },
                                            {
                                                "example_id": "7214a2da-02a3-4407-93b1-872a275304dd",
                                                "sense_id": "42b7603b-4497-3bf7-b227-e0b1a384bdc8",
                                                "text": "„Die Wehen setzen ein, als Charlotte zusammen mit ihrem Freund dort einem Boxkampf beiwohnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wehe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a33feb1d-07c8-3169-8871-6cc4f181b6bc",
                                        "entry_id": "38d7f621-a539-3d7e-ba2b-1945b32e4e15",
                                        "glosses": [
                                            "durch den Wind aufgewehte, zusammengewehte Anhäufung, vor allem von Schnee oder Sand"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfd9f289-0f9d-44d9-86a2-617ddb6291b4",
                                                "sense_id": "a33feb1d-07c8-3169-8871-6cc4f181b6bc",
                                                "text": "„Und ſie ſah der davonrollenden Britſchka und dem polternden Karren nach, bis beide verſchwunden waren hinter einer Wehe von Staub, hinter einer Woge von goldenen Aͤhren.“"
                                            },
                                            {
                                                "example_id": "dbbc43da-be9c-4e30-a6d3-977cc0751657",
                                                "sense_id": "a33feb1d-07c8-3169-8871-6cc4f181b6bc",
                                                "text": "„Trotzdem überwältigt ihn der Katarakt von Getöse immer wieder, der die Luft erfüllt, vom Walde her, wo mit dem Brausen eines unermüdlichen Wasserfalls schwellend und stoßend der Wind den Schnee zu Wehen bläst, Zweige aneinanderschlägt und hin und wieder ein schußartiges Dröhnen verursacht, dadurch, daß unter seinem Ansturm und der Sprödigkeit des Frostes ein Baum einen seiner schweren Äste krachend hergeben muß.“"
                                            },
                                            {
                                                "example_id": "a3ab06e7-3f10-4b46-a2e0-708044758c0f",
                                                "sense_id": "a33feb1d-07c8-3169-8871-6cc4f181b6bc",
                                                "text": "„Dad hat in der Nähe des Flusses gelegen, am Waldrand, in einer Wehe aus vorjährigen Blättern und Schnee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wehe",
                                "target_lang_code": "de",
                                "target_senses": [
