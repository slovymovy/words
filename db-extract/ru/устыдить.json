                        "examples": [
                            {
                                "example_id": "7b3895de-804d-4e33-8d82-76cc86c02536",
                                "sense_id": "a313e7c7-7cb1-36d5-b92d-7a22742db00e",
                                "text": "Под те́м же ду́бом, над те́м же боло́том, где Рыжо́в выкри́кивал слова́ми Иса́ии «го́ре кре́пким», он дожда́лся ду́ха, да́вшего ему́ мысль самому́ сде́латься кре́пким, да́бы устыди́ть крепча́йших.",
                                "translation": "Under the same oak, over the same swamp where Ryzhov had cried out in the words of Isaiah, “Woe to the mighty,” he finally received the spirit which gave him the thought of becoming mighty himself, in order to shame the mightiest.",
                                "english": "Under the same oak, over the same swamp where Ryzhov had cried out in the words of Isaiah, “Woe to the mighty,” he finally received the spirit which gave him the thought of becoming mighty himself, in order to shame the mightiest."
                            }
                        ]
                    }
