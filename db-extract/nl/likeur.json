                                            {
                                                "example_id": "c9ab587a-8ad7-4a40-b32f-787cf25ba38c",
                                                "sense_id": "673e11c0-1b8c-389d-9a76-f57ece466944",
                                                "text": "Every champagne has to be liqueured after its disgorgement, to replace the inevitable loss."
                                            }
