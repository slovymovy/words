    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f88b1dad-553a-3559-806a-6d8675c64843",
                    "sense_definition": "Personne reconnue par une religion pour sa vie exemplaire, sa piété et sa proximité avec Dieu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles se rassemblent pour prier le <w>saint</w> patron du village lors de la fête annuelle."
                        },
                        {
                            "text": "Cette église ancienne a été construite en hommage à un <w>saint</w> du Moyen Âge."
                        }
                    ],
                    "common_phrases": [
                        "saint patron"
                    ]
                },
                {
                    "sense_id": "e2e76c6c-c102-3bb5-b492-e26843f4322e",
                    "sense_definition": "Personne remarquable par sa bienveillance, son dévouement ou sa patience exceptionnelle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle aide les enfants malades tous les jours sans jamais se plaindre, c'est une véritable <w>sainte</w>."
                        },
                        {
                            "text": "Il faut une patience de <w>saint</w> pour supporter de telles remarques désagréables au quotidien."
                        }
                    ],
                    "common_phrases": [
                        "patience de saint"
                    ]
                },
                {
                    "sense_id": "ea6e7e8d-4d19-3c9d-aee6-abce5cbebef4",
                    "sense_definition": "Statue, tableau ou représentation plastique d'un saint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sculpteur a restauré avec soin les vieux <w>saints</w> en bois qui ornent le retable."
                        },
                        {
                            "text": "Dans cette chapelle sombre, plusieurs petits <w>saints</w> en plâtre entourent l'autel principal."
                        }
                    ]
                },
                {
                    "sense_id": "864aa1ec-64b4-3721-9a07-6c08c7e5958b",
                    "sense_definition": "Figure représentant un personnage canonisé dans la composition d'armoiries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason de la ville porte un <w>saint</w> nimbé d'or tenant une palme."
                        },
                        {
                            "text": "On reconnaît immédiatement ce <w>saint</w> dessiné sur l'écu grâce à sa crosse abbatiale."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b3e62531-397a-342e-86ab-e9725b2a447a",
                    "sense_definition": "Qui est consacré à Dieu, propre au culte ou à la religion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux croyants effectuent un pèlerinage pour visiter les lieux <w>saints</w>."
                        },
                        {
                            "text": "Le prêtre pose les vases <w>saints</w> sur l'autel avant de commencer la cérémonie."
                        }
                    ],
                    "synonyms": [
                        "sacré"
                    ],
                    "common_phrases": [
                        "lieux saints",
                        "semaine sainte"
                    ]
                },
                {
                    "sense_id": "c0abc5aa-488b-31b9-b5e5-a97b506d7093",
                    "sense_definition": "Souverainement pur, parfait et bienheureux, en référence directe au divin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles chantent pour glorifier le <w>saint</w> nom de Dieu durant le service religieux."
                        },
                        {
                            "text": "Dans la tradition chrétienne, la <w>sainte</w> Trinité représente Dieu en trois personnes."
                        }
                    ]
                },
                {
                    "sense_id": "1c5d8341-c632-3f10-bb19-e44d3ade7456",
                    "sense_definition": "Digne d'un immense respect, inviolable ou hautement vénéré dans un ordre moral ou civique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour les juges du tribunal, la défense des libertés fondamentales est un devoir <w>saint</w>."
                        },
                        {
                            "text": "La mémoire des ancêtres était considérée comme une chose <w>sainte</w> au sein de la communauté."
                        }
                    ],
                    "synonyms": [
                        "vénéré"
                    ]
                },
                {
                    "sense_id": "511175c8-c531-38ce-ad7b-e0bee0140642",
                    "sense_definition": "Total, absolu ou poussé à son paroxysme (utilisé pour intensifier un nom).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue a une <w>sainte</w> horreur des réunions inutiles qui s'éternisent en fin de journée."
                        },
                        {
                            "text": "Elle éprouve une <w>sainte</w> frousse dès qu'un insecte s'approche de son lit."
                        }
                    ],
                    "common_phrases": [
                        "sainte horreur"
                    ]
                },
                {
                    "sense_id": "b0640419-8409-37bd-88fa-c04f63e0717d",
                    "sense_definition": "Animé par des idéaux éthiques particulièrement élevés ou une vertu profonde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe éprouvait une <w>sainte</w> indignation devant la misère qui frappait les enfants."
                        },
                        {
                            "text": "Les jeunes soldats ont combattu guidés par une <w>sainte</w> ferveur patriotique."
                        }
                    ]
                }
            ]
        },
        {
