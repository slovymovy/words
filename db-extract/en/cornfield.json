                "translations": [
                    {
                        "translation_id": "623b0c32-6c8d-4f78-b5d5-02acc64217c9",
                        "source_entry_id": "4144fb02-5039-34b7-b56d-eac6f612e262",
                        "source_sense_id": "78e27ba0-85f7-3e39-ba4c-6fcef4325f9b",
                        "source_sense_description": "sdü",
                        "target_lang_word": "Maisfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maisfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b865629-13c7-3485-a2ec-a2753d5037c9",
                                        "entry_id": "949fd52f-8a5b-3ec7-a7bb-ed6d4d845961",
                                        "glosses": [
                                            "Feld, auf dem Mais angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6367ef7c-d9ea-471a-82de-cbbc2ad7afba",
                                                "sense_id": "9b865629-13c7-3485-a2ec-a2753d5037c9",
                                                "text": "Auf europäischen Maisfeldern wird zumeist gelbfarbener Mais angebaut, aber es gibt auch rote und blaue Sorten, die interessante Farbeffekte in Nahrungsmitteln hervorrufen können."
                                            },
                                            {
                                                "example_id": "e9973623-ae0a-4ab9-b809-1298d2d5ba01",
                                                "sense_id": "9b865629-13c7-3485-a2ec-a2753d5037c9",
                                                "text": "„Es war mitten am Tag, und vor mir lagen nichts als Maisfelder.“"
                                            },
                                            {
                                                "example_id": "d1657772-9b81-4f1e-b88f-10e88291d0ff",
                                                "sense_id": "9b865629-13c7-3485-a2ec-a2753d5037c9",
                                                "text": "„Nach einer Weile kommen wir durch Maisfelder.“"
                                            },
                                            {
                                                "example_id": "8252bfd2-2ac1-4b0e-9c2d-3108af55a094",
                                                "sense_id": "9b865629-13c7-3485-a2ec-a2753d5037c9",
                                                "text": "„Von hier aus lief ein breiter Weg, zwischen zwei Maisfeldern hinführend, nach dem Hauptgebäude zu, aus dem jetzt klar und deutlich der schon lang gehörte Gesang heraustönte.“"
                                            },
                                            {
                                                "example_id": "a41ecbf9-bd22-409b-82cd-6d35a3f8fc7a",
                                                "sense_id": "9b865629-13c7-3485-a2ec-a2753d5037c9",
                                                "text": "„Doch ähnelten die Maisfelder nicht den Äckern, die die Europäer kannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4dafac9-ebe9-4c33-88f9-369808df1977",
                        "source_entry_id": "4144fb02-5039-34b7-b56d-eac6f612e262",
                        "source_sense_id": "89e01b65-36ca-374d-ade2-a26e73014891",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Getreidefeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Getreidefeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a7c45c4-5873-3e60-8f5e-a02efb97d56d",
                                        "entry_id": "7ccdddc4-e4ff-329d-997c-b825018b5332",
                                        "glosses": [
                                            "Feld, auf dem Getreide angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a089010-2c2d-4d97-9dcc-e3b12a38d8d8",
                                                "sense_id": "0a7c45c4-5873-3e60-8f5e-a02efb97d56d",
                                                "text": "„Eine Dampflok hat mit ihrem Funkenflug Sonntagnachmittag ein Getreidefeld in Tamsweg im Lungau in Salzburg in Brand gesetzt.“"
                                            },
                                            {
                                                "example_id": "95af0a9e-4f69-4502-9f6f-a07649976dbc",
                                                "sense_id": "0a7c45c4-5873-3e60-8f5e-a02efb97d56d",
                                                "text": "„Kaum sah Pencroff Hagelkörner in der Größe von Taubeneiern niedergehen, da stürzte er zu seinem Getreidefeld und deckte die Triebe mit einem großen Stück Leinwand ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
