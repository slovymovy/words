                    },
                    {
                        "translation_id": "d7b0dfca-4fa3-4649-b1a2-23f06579da52",
                        "source_entry_id": "fc1b89a4-23b3-373d-8f7a-1548eedc6ece",
                        "source_sense_id": "70e1043d-710d-3ddb-896b-a5aa45725ff8",
