                    {
                        "translation_id": "a6a2434d-eebb-4b14-9848-1f812b706f17",
                        "source_entry_id": "0bbfc469-9dba-3e7b-b18b-43b4118c125c",
                        "source_sense_id": "a5ee1091-f67c-3b15-bc6b-84b969fc5e92",
                        "source_sense_description": "Botanik: Eibisch (Althaea)",
                        "target_lang_word": "Eibisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eibisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6146c9f8-7e98-3f1c-bb83-3faafc30475f",
                                        "entry_id": "b2ea0038-7018-3e9f-9cd6-89153dda4741",
                                        "glosses": [
                                            "Gattungsname für verschiedene Malvengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f8628f-0ca7-4c79-9746-c251235b06a0",
                                                "sense_id": "6146c9f8-7e98-3f1c-bb83-3faafc30475f",
                                                "text": "Der Eibisch gehört zur Familie der Malvengewächse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05dd633b-dade-34e2-88b8-74b91e70b52b",
                                        "entry_id": "b2ea0038-7018-3e9f-9cd6-89153dda4741",
                                        "glosses": [
                                            "helle, violette Blütenpflanze, die schleimlösende Stoffe enthält und daher als Heilpflanze gebraucht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c4567ab-55c0-4a64-8ade-8da5ab82cf09",
                                                "sense_id": "05dd633b-dade-34e2-88b8-74b91e70b52b",
                                                "text": "Der Tee von Eibisch (Althaea officinalis) wirkt als reizmilderndes Mittel bei Husten und Katarrhen der Atemwege."
                                            },
                                            {
                                                "example_id": "1c890f34-8d58-48a1-be54-0fdb3e99ad31",
                                                "sense_id": "05dd633b-dade-34e2-88b8-74b91e70b52b",
                                                "text": "„Er säte Hirse und Wälschkorn an die mittelmäßigen Plätze, ein wenig Weizen in den guten Boden, Reiß in die sumpfigen Gründe und an dem Fuß der Felsen eßbaren Eibisch, Calebassen und Gurken, welche sich gerne daran herumranken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8339780d-2eea-439c-ad4b-5dd7bf60f9ef",
                        "source_entry_id": "0bbfc469-9dba-3e7b-b18b-43b4118c125c",
                        "source_sense_id": "ba66e4b4-3bdf-35cb-8c67-b2c5f3d374da",
                        "source_sense_description": "Botanik: Stockrose (Alcea)",
                        "target_lang_word": "Stockrose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stockrose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d73f1f0e-c407-3001-8fa7-395ace4f8220",
                                        "entry_id": "a3adcb75-8ff7-3a49-b071-1d1f0c91e286",
                                        "glosses": [
                                            "Rosenart aus der Familie der Malvengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22223375-855b-472d-b80a-76aab5cf5f8e",
                                                "sense_id": "d73f1f0e-c407-3001-8fa7-395ace4f8220",
                                                "text": "„Es war ein ruhiger Spaziergang, vorbei am Dorfladen und an einem Café mit Strohdach und einem Garten voller Stockrosen.“"
                                            },
                                            {
                                                "example_id": "3cfb0830-2e34-4e56-b663-74b6ce2f2b7f",
                                                "sense_id": "d73f1f0e-c407-3001-8fa7-395ace4f8220",
                                                "text": "„Suttree stellte sich in die Tür und blickte hinaus auf den Schrottplatz. Hohe Stockrosen neben dem beschwerten Tor, blühende Kletten und Begonien längs der Zaunreste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
