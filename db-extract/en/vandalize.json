                "translations": [
                    {
                        "translation_id": "a019ec31-75f2-4e6c-854b-393fdc18734b",
                        "source_entry_id": "0f5a0539-26ed-3871-917a-cbae9d19b0c9",
                        "source_sense_id": "54060ec8-5195-3001-806f-76493ed743b9",
                        "target_lang_word": "vandalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vandalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                        "entry_id": "dabe8cb4-0872-3fa5-9547-b47d7fbdaed7",
                                        "glosses": [
                                            "absichtlich verwüsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf1f456-f322-4592-b20c-92c33f022574",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Wenn der Safe leergeräumt ist und wir gut in der Zeit liegen, können wir noch ein wenig vandalisieren, es heißt ja nicht umsonst ›Erst die Arbeit, dann das Vergnügen‹“"
                                            },
                                            {
                                                "example_id": "a45e3fe4-efe5-4682-8762-2dcc911e8b6e",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Viele seiner Busfahrer müssen zusehen, wie aufgeputschte Jugendliche ihren Bus vandalisieren, und werden beim Versuch, für Ordnung zu sorgen, bespuckt und angepöbelt.“"
                                            },
                                            {
                                                "example_id": "84ac6e3d-a9fa-4585-b4ec-d00a09715574",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Er erhält Morddrohungen und sein Büro wird vandalisiert.“"
                                            },
                                            {
                                                "example_id": "e30abafc-719c-4621-beec-dc277c02363f",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Während der französischen Revolution und der dritten Republik wurde der Palast als Abladeplatz von Leichen nach Massakern, als Gefängnis, Baracke und Pferdestall benutzt und natürlich vandalisiert.“"
                                            },
                                            {
                                                "example_id": "61080061-53d1-4f3a-93de-73252f8eb564",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Als hätte ein Unbekannter jedes einzelne Zimmer in bösartiger, niederträchtiger Absicht vandalisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
