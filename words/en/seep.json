                },
                {
                    "sense_id": "6383f106-6392-3c4c-a9e7-0f41a705ec1c",
                    "sense_definition": "To allow a liquid to pass through or leak from a crack or opening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small crack in the pipe was <w>seeping</w> water onto the floor. ",
                            "target_lang_translations": {
                                "tr": "Borudaki küçük çatlak zemine su <w>sızdırıyordu</w>.",
                                "ru": "Из маленькой трещины в трубе на пол <w>сочилась</w> вода.",
                                "cs": "Malou trhlinou v potrubí <w>prosakovala</w> voda na podlahu."
                            }
                        },
                        {
                            "text": "They noticed the old container was <w>seeping</w> oil into the garage.",
                            "target_lang_translations": {
                                "tr": "Eski konteynerin garaja yağ <w>sızdırdığını</w> fark ettiler.",
                                "ru": "Они заметили, что из старого контейнера в гараж <w>подтекало</w> масло.",
                                "cs": "Všimli si, že ze starého kontejneru <w>vytéká</w> olej do garáže."
                            }
