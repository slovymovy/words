                        "form": "die Gleisbetten"
                    },
                    {
                        "form_id": "bf68cb66-7607-47a4-bea7-7d23a63ca3c6",
                        "entry_id": "6a5fd8a9-241c-33d3-b809-0c15d5c8bb13",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gleisbette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2472b5c0-7b2f-310c-bb5d-50dfd9e2cf09",
                        "entry_id": "6a5fd8a9-241c-33d3-b809-0c15d5c8bb13",
                        "glosses": [
                            "Unterbau, in dem die Schwellen einer Eisenbahnstrecke liegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd649859-834d-4488-978b-175df819edea",
                                "sense_id": "2472b5c0-7b2f-310c-bb5d-50dfd9e2cf09",
                                "text": "„Die Produkte fanden insbesondere bei der Bahn, die die Gleisbette schottern musste, einen dankbaren Abnehmer.“"
                            },
                            {
                                "example_id": "597a2c56-103a-40c1-a2a7-a72eca0224e7",
                                "sense_id": "2472b5c0-7b2f-310c-bb5d-50dfd9e2cf09",
                                "text": "„Ein 30-jähriger Mann ist mit seinem Auto im Gleisbett einer Bahnstrecke gelandet, weil er die Anweisung seines Navigationsgerätes falsch deutete.“"
                            },
                            {
                                "example_id": "36118337-dccb-4d45-bd9e-b49f29b6e78b",
                                "sense_id": "2472b5c0-7b2f-310c-bb5d-50dfd9e2cf09",
                                "text": "„Bald unterhöhlten Füchse und Kaninchen den Damm und zerstörten die Gleisbetten.“"
                            },
                            {
                                "example_id": "3acf3912-a9ae-4cfe-bab0-8929c5f0db75",
                                "sense_id": "2472b5c0-7b2f-310c-bb5d-50dfd9e2cf09",
                                "text": "„Sowohl in Kaufbeuren als auch in Schongau sind noch immer die Gleisbette am Abzweig von der Allgäubahn beziehungsweise von der Fuchstalbahn sichtbar.“"
                            },
                            {
                                "example_id": "4028a1fe-b603-4be1-a412-ac40cd6f807e",
                                "sense_id": "2472b5c0-7b2f-310c-bb5d-50dfd9e2cf09",
                                "text": "„‚Sie wohnt dort in der Nähe des Bahnhofs und hatte nach dem Verschwinden der unter Artenschutz stehenden Schildkröte tagelang die Gleisbette abgesucht‘, erzählte Müller.“"
                            },
                            {
                                "example_id": "83c94d2a-2eb8-4877-bbb1-f47cc018316e",
                                "sense_id": "2472b5c0-7b2f-310c-bb5d-50dfd9e2cf09",
                                "text": "„Aufgrund des reichlich vorhandenen Platz sind die Gleisbette hier schon immer recht breit gewesen.“"
                            },
                            {
                                "example_id": "c1df9529-39a6-4cb5-b8bb-6800e6bb880c",
                                "sense_id": "2472b5c0-7b2f-310c-bb5d-50dfd9e2cf09",
                                "text": "„Sie halten die Gleisbette hinter dem Mediapark für abschreckend?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
