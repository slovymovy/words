                "senses": [
                    {
                        "sense_id": "dfa784d1-0c47-33c4-a673-73752c5bf71e",
                        "entry_id": "0e2027ab-200a-3950-86ee-8c3d7aae7a5a",
                        "glosses": [
                            "Besuch mehrerer Nachtlokale an einem Abend oder Tag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad4c563-c6f9-43a1-8c6a-a65a4c5b4811",
                                "sense_id": "dfa784d1-0c47-33c4-a673-73752c5bf71e",
                                "text": "„Man kann hier nach mitternächtlichem Bar-Hopping auf der nun geradezu märchenhaft illuminierten Uferpromenade flanieren und mit Einheimischen völlig zweckfrei ins Gespräch kommen.“"
                            },
                            {
                                "example_id": "a3008c27-53ad-4445-ac53-5dfec3425246",
                                "sense_id": "dfa784d1-0c47-33c4-a673-73752c5bf71e",
                                "text": "„Beim anschließenden Bar-Hopping muss so viel Alkohol geflossen sein, dass er sich seiner Hose entledigte und sie anschließend – ihm sei völlig rätselhaft wie – verlor.“"
                            },
                            {
                                "example_id": "a7718ce9-7521-41d2-b738-f690011df6e5",
                                "sense_id": "dfa784d1-0c47-33c4-a673-73752c5bf71e",
                                "text": "„Ein Bar-Hopping, wie in Prag sonst üblich, ist nicht empfehlenswert.“"
                            },
                            {
                                "example_id": "9665644c-d910-42ac-8a96-00756f8b5482",
                                "sense_id": "dfa784d1-0c47-33c4-a673-73752c5bf71e",
                                "text": "„Nach dem Bar-Hopping laden 18 Clubs zum Tanzen und Feiern ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
