                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "530f874f-58b9-35c8-92cc-708981192520",
                        "entry_id": "8f984c70-388c-30c5-a804-d0d5c51e05ee",
                        "glosses": [
                            "An area by the side of a road where vehicles may temporarily stop in safety. Typical pullouts allow drivers and passengers to safely exit the vehicle but rarely have additional amenities."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "983697d1-0e44-455f-965f-050565a5a961",
                                "sense_id": "530f874f-58b9-35c8-92cc-708981192520",
                                "text": "Capt. Greg Baarts with the CHP Northern Division says information pulled from the SUV's software shows the vehicle was stopped at the highway pullout before it accelerated straight off the cliff."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b9a7acc-7182-313b-a4ed-502c91a1f09f",
                        "entry_id": "8f984c70-388c-30c5-a804-d0d5c51e05ee",
                        "glosses": [
                            "The ending of a period of surfing by navigating the surfboard into or over the back of a wave."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3aa955f2-fd43-4d43-bfe9-59f9363e6671",
                                "sense_id": "6b9a7acc-7182-313b-a4ed-502c91a1f09f",
                                "text": "Here's a pretty strange pullout. An \"El Rollo.\" When Corky does something strange, everyone for 50 yards knows all about it."
                            },
                            {
                                "example_id": "2b58aafe-cebe-4d00-94f3-6972c477c645",
                                "sense_id": "6b9a7acc-7182-313b-a4ed-502c91a1f09f",
                                "text": "Most pullouts, then and today, are done by simply angling or pivoting the board up and over the wave crest."
                            },
                            {
                                "example_id": "ca6b4e69-6741-4fe3-ba9c-576d1e6824e9",
                                "sense_id": "6b9a7acc-7182-313b-a4ed-502c91a1f09f",
                                "text": "[…] Machado, who turns what might seem like a handicap, that lankiness, to rubbery advantage in his sinuous carving and slackly cool pullouts."
                            }
                        ]
                    },
