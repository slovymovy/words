                                                "sense_id": "ffeaa6bb-c6b7-3197-a37c-3dda88c71d60",
                                                "text": "Het tweede deel is net ook uitgekomen."
                                            },
                                            {
                                                "example_id": "252e04e7-d4b6-46e3-8491-6ad117650a2f",
                                                "sense_id": "ffeaa6bb-c6b7-3197-a37c-3dda88c71d60",
                                                "text": "Het is 25 jaar geleden dat het eerste boek van Harry Potter uitkwam in het Verenigd Koninkrijk. Sindsdien is de boekenreeks uitgegroeid tot een wereldwijd fenomeen. In deze video zie je wat er inmiddels allemaal bij het Harry Potter-universum hoort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487b93b3-bb72-38fa-9012-2b4a030ebfb5",
                                        "entry_id": "176231f7-f15d-3c42-ae18-6f411e81bbe4",
                                        "glosses": [
