                                        "examples": [
                                            {
                                                "example_id": "97f14466-992f-4ea8-9aa3-a782c38d0ae3",
                                                "sense_id": "dc6e85da-b6b4-3f5c-9b4d-2d2a34474394",
                                                "text": "To be 'bogged down' or 'mired down' is to be mired, generally in the 'wet valleys' in the spring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "917d74ea-f7c7-395b-a0fc-94b82ef9b522",
                                        "entry_id": "ea89a48b-e355-3230-9bff-cdf65dab2e37",
                                        "glosses": [
                                            "To prevent or slow someone or something from making progress."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603edf0e-4194-47c7-837e-48b55c05cd3d",
                                                "sense_id": "917d74ea-f7c7-395b-a0fc-94b82ef9b522",
                                                "text": "[…] Bogg'd in his filthy Lusts […]"
                                            },
                                            {
                                                "example_id": "4a5c859d-d33f-4aa1-a993-078695d76aab",
                                                "sense_id": "917d74ea-f7c7-395b-a0fc-94b82ef9b522",
                                                "text": "[…] whose profession to forsake the World... bogs them deeper into the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efff1604-3754-3dd4-b10f-73ab39687612",
                                        "entry_id": "ea89a48b-e355-3230-9bff-cdf65dab2e37",
                                        "glosses": [
                                            "To sink and stick in bogland."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ab9867-9949-48bf-b6d7-8a228119dc82",
                                                "sense_id": "efff1604-3754-3dd4-b10f-73ab39687612",
                                                "text": "Duncan Graham in Gartmore his horse bogged; that the deponent helped some others to take the horse out of the bogg."
                                            }
