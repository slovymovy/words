        "fr-extract.jsonl": [
            {
                "entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                "word": "lisibilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "baa28ad1-d1a8-47eb-8142-6e34ae6f1644",
                        "entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                        "tags": [
                            "plural"
                        ],
                        "form": "lisibilités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c705c16-d6f7-34a2-846c-7faff71386f4",
                        "entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                        "glosses": [
                            "Qualité de ce qui est lisible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30288fdd-3c21-4363-8c71-22645b36ba4f",
                                "sense_id": "5c705c16-d6f7-34a2-846c-7faff71386f4",
                                "text": "Tout manuscrit doit être remis à l’éditeur en état de lisibilité parfaite."
                            },
                            {
                                "example_id": "b25cc064-d284-45bd-8704-7cfb810b0fe6",
                                "sense_id": "5c705c16-d6f7-34a2-846c-7faff71386f4",
                                "text": "Pour des questions de lisibilité et d'homogénéité d'écriture, il est préférable d'éviter les combinaisons de simples quotes et antislash dans une même expression si cela n'est pas indispensable."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2b58604-aaad-3d68-9f0a-55e1ee7df916",
                        "entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                        "glosses": [
                            "Clarté, compréhensibilité, cohérence."
                        ],
                        "tags": [
                            "figuratively",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c28bb51c-94e9-4c19-96d9-d0911ce00b27",
                                "sense_id": "b2b58604-aaad-3d68-9f0a-55e1ee7df916",
                                "text": "Même si beaucoup d'agglomérations ont déjà passé des secteurs à 30 km/h, Régis Muller insiste sur l'enjeu de \"lisibilité\" : \"Nous avons des départementales qui sont à 80 km/h, c'est la règle, avec des dérogations à 90 km/h et du coup on est un peu perdu … En ville, c'est un peu la même chose, malgré le marquage, les panneaux de signalisation, on ne sait plus.\""
                            },
                            {
                                "example_id": "5bb3a2c3-f2e3-4c7f-af37-a577d47d5bc9",
                                "sense_id": "b2b58604-aaad-3d68-9f0a-55e1ee7df916",
                                "text": "Le ministre de l’environnement a pourtant rappelé qu’il fallait une lisibilité à moyen et long terme pour optimiser les investissements en économie d’énergie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac198d70-3f72-3361-ad78-a2e88bab4c9a",
                        "entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                        "glosses": [
                            "Qualité exprimant la netteté de la perception visuelle d’un contenu d’une carte et la facilité de distinction de ses éléments."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09f76a12-a399-4b04-a416-61253d3c16ba",
                        "source_entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                        "target_lang_word": "readability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "readability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f40d358b-3da0-34fd-8e0f-f558ef3c1667",
                                        "entry_id": "fbf830a6-e94a-3025-9c60-99706286be54",
                                        "glosses": [
                                            "The property of being capable of being read; legibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cbb9952-56c8-48e1-ab2b-3e6b2ad8cbc1",
                                                "sense_id": "f40d358b-3da0-34fd-8e0f-f558ef3c1667",
                                                "text": "When done correctly, kerning helps to improve the readability of text by adding or removing space between two letters. Bad kerning, also known as keming, leads to misreadings, and in the worst cases, incredibly bad (but humorous) misunderstandings."
                                            },
                                            {
                                                "example_id": "5c54cfad-fa16-4a3e-976e-bbdc3d67baa6",
                                                "sense_id": "f40d358b-3da0-34fd-8e0f-f558ef3c1667",
                                                "text": "Point-free coding is a byproduct of adopting declarative programming. You can use point-free coding without FP. But because point-free is all about improving the readability of code at a glance and making it simpler to parse, having the guarantees imposed by FP furthers this cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b1c803-0fae-3227-9f45-afb49ae559ab",
                                        "entry_id": "fbf830a6-e94a-3025-9c60-99706286be54",
                                        "glosses": [
                                            "The property of being easy or engaging to read."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b2bd7a-6be2-4589-9317-4a6f04d047bf",
                                                "sense_id": "62b1c803-0fae-3227-9f45-afb49ae559ab",
                                                "text": "The book had a clever plot, but lacked readability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c157a0c0-e3e6-4a65-a110-e29d4cc5269f",
