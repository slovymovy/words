                "translations": [
                    {
                        "translation_id": "9f21a592-0115-4f95-b023-2d59b870bc2d",
                        "source_entry_id": "74d52611-f70c-30b1-90a5-7d1435d85636",
                        "source_sense_id": "413fe4cf-0283-3aa8-a38b-b19a7cbbae61",
                        "target_lang_word": "vis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "461d6d1b-53b1-3416-b4a6-1321c9401c15",
                                        "entry_id": "783c2b57-6f46-3214-b9ab-5c752243a632",
                                        "glosses": [
                                            "Première personne du singulier du passé simple de voir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e0d483a-3db3-4ea4-8e59-94b308c50ee7",
                                                "sense_id": "461d6d1b-53b1-3416-b4a6-1321c9401c15",
                                                "text": "Callamar qui, comme tu sais, a eu la petite vérole, se porte bien maintenant, mais cela l’a un peu désadonisé, il me fit peur la première fois que je le vis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "865af08b-eaef-368d-85ed-b3290f920ccf",
                                        "entry_id": "783c2b57-6f46-3214-b9ab-5c752243a632",
                                        "glosses": [
                                            "Deuxième personne du singulier du passé simple de voir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                        "entry_id": "26f0148e-e917-3777-8512-9287616c5054",
                                        "glosses": [
                                            "Pièce mécanique formée d’un corps qui comporte un filet de forme hélicoïdale et une tête où une empreinte permet d’appliquer un couple ; il en résulte un double mouvement de rotation et de translation. En mécanique, elles sont souvent employées avec des écrous pour former des boulons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b88c00-991d-4d22-a129-b5f836d46c6f",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "Je vis ces vis."
                                            },
                                            {
                                                "example_id": "32c128b0-1e71-45f8-9a61-04456f3ddef4",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "Une énorme vis de chêne poli traversait le toit rond et tournait avec un son rauque. La grande aile de toile grise clouée sur son squelette de bois s’envolait devant la lucarne parmi la poussière de soleil."
                                            },
                                            {
                                                "example_id": "5510eb6c-f7de-4ba8-8cdc-bcc1e592f875",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "Il s’assit, les mains aux cuisses, sur le tabouret de piano. C’était un tabouret à vis. Parfois M. Courtois virait vers la droite ou la gauche, et la vis travaillait avec un âcre grincement."
                                            },
                                            {
                                                "example_id": "00b578f3-4448-4cb6-965a-6fe878bea38f",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "Les parages du Rousset et de la forêt de Lente, les vallons obscurs de Bouvante et de Cordéac furent serrés comme dans un pressoir à vis par des gels qui écrabouillaient tout ce qu’il y avait de vivant ou le faisaient gicler hors des frontières."
                                            },
                                            {
                                                "example_id": "269f9594-7c76-4391-a4e3-7d0ff5c0c9ca",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "Le principal avantage des vis à bois est de permettre des assemblages résistant à la traction, même lorsqu'un seul côté est accessible. Elles peuvent donc être utilisées en cas de sollicitation de cisaillement accompagnée de traction parallèle à la tige."
                                            },
                                            {
                                                "example_id": "0073cdab-0ff3-4db5-a1ff-e8816f6d0f22",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "Une vis de pressoir."
                                            },
                                            {
                                                "example_id": "a03d0fde-c5f4-420b-9e13-b5e083d5b3bf",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "La vis est rompue dans l’écrou."
                                            },
                                            {
                                                "example_id": "403b74bf-2063-4276-a8b0-c9f2494690d8",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "Vis à tête plate, à tête ronde."
                                            },
                                            {
                                                "example_id": "1514d493-d05f-4a58-b091-af3e4eae3e28",
                                                "sense_id": "58ae1bb8-1194-369d-bc4f-d265db669341",
                                                "text": "Les vis d’une serrure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d98ff25-98e1-384b-a78c-57b3367509fc",
                                        "entry_id": "0f4f180b-c686-3bfe-8aa9-69c000b0c6bb",
                                        "glosses": [
                                            "Ancienne unité de masse de l’Inde et du Sud-Est asiatique. Selon le lieu, valait entre 1,3606 et 4,5354 kilogrammes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8bdae7e-faf1-41cb-b2c0-5147824349c9",
                                                "sense_id": "1d98ff25-98e1-384b-a78c-57b3367509fc",
                                                "text": "BIS, Bisse, Bixe. Différents noms d’un poids de l’Inde, appelé plus communément vis. […]\nVIS, Viss, Biss, Bisse, Bixe. Poids de l’Inde. Le punjseer ou pusseree est un poids analogue, auquel on donne quelquefois aussi le nom de vis, entre autres à Bangalore."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d831132a-8f96-369f-a417-ce0609e862af",
                                        "entry_id": "4163299f-4152-370f-8960-26b46933c2df",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de vivre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ba07fc5-cd35-4ad0-a44e-3ee86ea98659",
                                                "sense_id": "d831132a-8f96-369f-a417-ce0609e862af",
                                                "text": "Si je vis assez longtemps pour me voir un petit-gendre, je vous piloterai sur la mer des intérêts politiques comme j’ai piloté Malin, et vous arriverez à une position égale à celle des Keller…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c564f54f-f470-3386-bd07-76c1bbda21f4",
                                        "entry_id": "4163299f-4152-370f-8960-26b46933c2df",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’indicatif présent de vivre."
                                        ],
