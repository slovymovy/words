                ],
                "senses": [
                    {
                        "sense_id": "ba1f9926-fd6b-3cad-b238-1af6a3b14fe5",
                        "entry_id": "b7326cfe-afb7-36d4-a600-ed577c3f5317",
                        "glosses": [
                            "een grote indruk achterlatend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3cc58f2-5bea-4bc5-b9ea-b7245095bb16",
                                "sense_id": "ba1f9926-fd6b-3cad-b238-1af6a3b14fe5",
                                "text": "Veel Almeloërs willen er zaterdagmiddag tussen 14.00 en 15.00 uur getuige van zijn. Hun stad is immers historisch verbonden met het eeuwenoude Huize Almelo, het kasteel dat grenst aan de binnenstad, en de familie Van Rechteren Limpurg. En als de graaf overlijdt en naar zijn laatste rustplaats in zijn eigen bos wordt gedragen, is dat een indrukwekkende gebeurtenis die niet zo vaak voorkomt."
                            },
                            {
                                "example_id": "ca5c6b36-e5a6-4859-8ba4-d19c33272df9",
                                "sense_id": "ba1f9926-fd6b-3cad-b238-1af6a3b14fe5",
                                "text": "Deze indrukwekkende demonstratie van betrokkenheid van de kant van de majordomus had een onverwachte uitwerking op de gevleide dichteres. Ze begon te schateren, waarbij zichtbaar werd hoe haar tanden verankerd waren in de met roze tandvlees overtrokken mandibula van haar schedel. Het was bijna angstaanjagend hoe grappig zij de goedbedoelde declamatie van haar eigen meesterwerk achtte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf1a99d2-8ee9-4c0d-8809-7ddba0cb0a47",
                        "source_entry_id": "b7326cfe-afb7-36d4-a600-ed577c3f5317",
                        "source_sense_id": "ba1f9926-fd6b-3cad-b238-1af6a3b14fe5",
                        "source_sense_description": "een grote indruk achterlatend",
                        "target_lang_word": "eindrucksvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindrucksvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "440b5028-3f6c-30e0-8167-2c92c626dfaf",
                                        "entry_id": "14369d8d-4d57-33b6-988f-27969c499310",
                                        "glosses": [
                                            "Eindruck, starke Wirkung hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a41267f6-1228-4b5b-bb4b-d1cef654d992",
                                                "sense_id": "440b5028-3f6c-30e0-8167-2c92c626dfaf",
                                                "text": "Die Nationalparks der USA sind eindrucksvoll, dein Urlaub wird dir im Gedächtnis bleiben."
                                            },
                                            {
                                                "example_id": "b1423f98-aacf-475d-a88f-b6dc03933579",
                                                "sense_id": "440b5028-3f6c-30e0-8167-2c92c626dfaf",
                                                "text": "„Der Kripokommissar ist ein eindrucksvoller Mann, groß, kahl rasiert, dandyhaft.“"
                                            },
                                            {
                                                "example_id": "add475fc-3108-4637-b12f-2894de9d3b44",
                                                "sense_id": "440b5028-3f6c-30e0-8167-2c92c626dfaf",
                                                "text": "„WM-Spitzenreiter Nico Rosberg unterstreicht mit der siebten Pole Position der Saison seine Titelambitionen eindrucksvoll.“"
                                            },
                                            {
                                                "example_id": "40adfe77-d32b-4f61-9d4f-e82bb64d61ed",
                                                "sense_id": "440b5028-3f6c-30e0-8167-2c92c626dfaf",
                                                "text": "„Im Vorraum der Wachstube hatte ein eindrucksvoller Haufen von Knütteln, Äxten und Gewehren gelegen; die Gewehre sorgsam zur Seite geschoben, sie sollten untersucht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
