                    {
                        "sense_id": "7511749a-87fc-39b7-82e7-5d673f5b5d25",
                        "entry_id": "12cd66bd-999e-3474-9ad4-836629c9910d",
                        "glosses": [
                            "inrichting waar patiënten medische zorg krijgen en worden verpleegd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98cd26d4-7bd0-480c-ad19-c56a57ef4cc2",
                                "sense_id": "7511749a-87fc-39b7-82e7-5d673f5b5d25",
                                "text": "De kliniek was overvol na het grote verkeersongeluk."
                            },
                            {
                                "example_id": "78f5449f-b0ec-4cda-a889-466ded56402e",
                                "sense_id": "7511749a-87fc-39b7-82e7-5d673f5b5d25",
                                "text": "In deze kliniek worden mensen met een verslaving geholpen om er vanaf te komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2d40191-5951-406d-8e42-45093dcc03ef",
                        "source_entry_id": "12cd66bd-999e-3474-9ad4-836629c9910d",
                        "source_sense_id": "7511749a-87fc-39b7-82e7-5d673f5b5d25",
                        "source_sense_description": "een inrichting waar patiënten worden verpleegd",
