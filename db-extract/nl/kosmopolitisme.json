                "senses": [
                    {
                        "sense_id": "dc6a5c08-155a-33c5-8167-5c3b34a810c7",
                        "entry_id": "8288278a-20e4-324c-bb84-217dc75fc07b",
                        "glosses": [
                            "van een persoon dat deze een gevoel van verbondenheid met de mensheid in het algemeen ervaart, dat sterker is dan enig gevoel voor nationale of regionale identiteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4eb5ca0-bd1d-4ed6-9377-a2160b7de417",
                                "sense_id": "dc6a5c08-155a-33c5-8167-5c3b34a810c7",
                                "text": "De Friese musicus maakt carrière met haar eigen band in de Verenigde Staten. Volgens de jury combineert ze kosmopolitisme en Hollandse nuchterheid."
                            },
                            {
                                "example_id": "cc3e1f35-378f-4656-a7a8-8b3d1b1cf983",
                                "sense_id": "dc6a5c08-155a-33c5-8167-5c3b34a810c7",
                                "text": "Zjdanov, lid van het Politbureau, bond de strijd aan met het 'kosmopolitisme', oftewel: met ieder non-conformisme en intellectualisme en met eenieder die niet loyaal genoeg aan de Partij werd geacht."
                            }
                        ]
                    }
                ],
