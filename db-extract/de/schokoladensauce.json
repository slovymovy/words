                "senses": [
                    {
                        "sense_id": "13b0c7ec-f64b-3288-a671-5359e2c18bb2",
                        "entry_id": "e191348c-c448-314c-8570-23d5881a86f0",
                        "glosses": [
                            "Soße, die aus geschmolzener Schokolade oder Schokoladenpulver besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d90a18-ab08-47ee-b21b-f0a840e5e150",
                                "sense_id": "13b0c7ec-f64b-3288-a671-5359e2c18bb2",
                                "text": "„Darauf stand eine Flasche eisgekühlter Champagner mit zwei Gläsern, eine Schale mit Erdbeeren, geschlagene Sahne und eine zweite Schale mit Schokoladensauce.“"
                            },
                            {
                                "example_id": "747e1fee-caac-4773-b680-2a248ad05f20",
                                "sense_id": "13b0c7ec-f64b-3288-a671-5359e2c18bb2",
                                "text": "„Die Schokoladensauce ist etwas ganz Besonderes, weil sie auf Leinöl oder Perillaöl beruht: beides gesunde Omega-3-Öle.“"
                            },
                            {
                                "example_id": "3514a6f7-c829-4447-baf2-9e26189850ea",
                                "sense_id": "13b0c7ec-f64b-3288-a671-5359e2c18bb2",
                                "text": "„Die Milchmischung auf die gehackte Kuvertüre gießen und alles zu einer glatten Schokoladensauce verrühren.“"
                            },
                            {
                                "example_id": "090b1720-485c-464a-a399-439d1e1bac10",
                                "sense_id": "13b0c7ec-f64b-3288-a671-5359e2c18bb2",
                                "text": "„Den Kaloriengehalt können Sie jedoch durch Zugabe von Vanilleeis, heißen Kirschen, Sahne, Frucht- oder Schokoladensaucen problemlos auf leckere Art und Weise steigern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
