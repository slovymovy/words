                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La flamme vacillante de la bougie semblait <w>hypnotiser</w> le chat assis au bord de la fenêtre."
