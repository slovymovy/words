{
    "word_family": [
        "widły",
        "widelec",
        "widelczyk",
        "widlasty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a946a7f5-2cda-3209-ae3b-2187bebcee9e",
                    "sense_definition": "uchwyt lub mechanizm w tradycyjnym aparacie telefonicznym, na który odkłada się słuchawkę",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "telefon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy skończył rozmowę, natychmiast odłożył słuchawkę na <w>widełki</w>.",
                            "target_lang_translations": {
                                "ru": "Когда он закончил разговор, то сразу же положил трубку на <w>рычаг</w>."
                            }
                        },
                        {
                            "text": "Aparat telefoniczny głośno zadzwonił, gdy tylko podniosłem słuchawkę z <w>widełek</w>.",
                            "target_lang_translations": {
                                "ru": "Телефон громко зазвонил, как только я снял трубку с <w>рычага</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odłożyć słuchawkę na widełki"
                    ],
                    "target_lang_definitions": {
                        "ru": "рычаг или подставка в проводном телефонном аппарате, куда кладется трубка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычаг",
                                "target_lang_sense_clarification": "телефонный рычаг для трубки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9b2aea4-9be5-3543-8331-ef6c5e3ec219",
                    "sense_definition": "dolna i górna granica wyznaczająca dopuszczalny zakres pewnych wartości liczbowych",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zakres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ogłoszeniu o pracę podano bardzo atrakcyjne <w>widełki</w> płacowe.",
                            "target_lang_translations": {
                                "ru": "В объявлении о вакансии была указана очень привлекательная зарплатная <w>вилка</w>."
                            }
                        },
                        {
                            "text": "Nowa propozycja zakłada elastyczne <w>widełki</w> cenowe dla stałych klientów.",
                            "target_lang_translations": {
                                "ru": "Новое предложение предусматривает гибкую ценовую <w>вилку</w> для постоянных клиентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "widełki płacowe",
                        "widełki cenowe"
                    ],
                    "target_lang_definitions": {
                        "ru": "нижняя и верхняя граница, определяющие допустимый диапазон числовых значений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вилка",
                                "target_lang_sense_clarification": "диапазон значений (цен, зарплат)"
                            },
                            {
                                "target_lang_word": "диапазон",
                                "target_lang_sense_clarification": "интервал между крайними значениями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c75b14a8-3a13-3f17-a339-76c713f9810a",
                    "sense_definition": "zdrobnienie od rzeczownika <w>widły</w>; małe widły lub przedmiot o rozwidlonym kształcie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "przedmiot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko pomagało w ogrodzie, trzymając małe, metalowe <w>widełki</w>.",
                            "target_lang_translations": {
                                "ru": "Ребёнок помогал в саду, держа маленькие металлические <w>вилы</w>."
                            }
                        },
                        {
                            "text": "Część drewniana była zakończona małymi <w>widełkami</w>, które ułatwiały podpieranie gałęzi.",
                            "target_lang_translations": {
                                "ru": "Деревянная часть заканчивалась маленькой <w>рогаткой</w>, облегчавшей подпирание веток."
                            }
                        }
                    ],
                    "synonyms": [
                        "widły"
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшительное от вилы; маленькие вилы или раздвоенный предмет"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вилы",
                                "target_lang_sense_clarification": "маленькие садовые вилы"
                            },
                            {
                                "target_lang_word": "рогатка",
                                "target_lang_sense_clarification": "раздвоенная деталь или предмет"
                            },
                            {
                                "target_lang_word": "вилочка",
                                "target_lang_sense_clarification": "маленькие вилы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d815f024-4be1-3a0d-aac5-c35e40700917",
                    "sense_definition": "w szachach: jednoczesny atak jednej figury na dwie lub więcej figur przeciwnika",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "szachy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biały skoczek wykonał niespodziewane <w>widełki</w>, atakując jednocześnie króla i hetmana.",
                            "target_lang_translations": {
                                "ru": "Белый конь поставил неожиданную <w>вилку</w>, одновременно атакуя короля и ферзя."
                            }
                        },
                        {
                            "text": "Przeciwnik nie zauważył zagrożenia i łatwo wpadł w te proste <w>widełki</w>.",
                            "target_lang_translations": {
                                "ru": "Соперник не заметил угрозы и легко попался на эту простую <w>вилку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "podwójny atak"
                    ],
                    "common_phrases": [
                        "zrobić widełki"
                    ],
                    "target_lang_definitions": {
                        "ru": "в шахматах: одновременная атака одной фигурой двух или более фигур соперника"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вилка",
                                "target_lang_sense_clarification": "шахматный двойной удар"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}