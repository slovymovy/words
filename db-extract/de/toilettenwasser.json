                        "examples": [
                            {
                                "example_id": "0c2ee420-fc1e-4a0e-a2e1-7d6f0a8e0b41",
                                "sense_id": "c372529a-3208-302e-a5a8-37ffe0b5ef99",
                                "text": "„Wieder packten ihn die brutalen Hände, nun am Hinterkopf, stießen ihn nach vorn und nach unten, in die offene Kloschüssel hinein, stießen ihn mit der Stirn gegen das Porzellan, und dann ging es abwärts, kopfüber in das stehende Toilettenwasser hinein.“"
                            }
                        ],
