                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were <w>haggling</w> over the price of the car for nearly an hour.",
                            "target_lang_translations": {
                                "ru": "Они почти час <w>торговались</w> из-за цены на машину.",
                                "nl": "Ze waren bijna een uur lang over de prijs van de auto aan het <w>afdingen</w>."
                            }
                        },
                        {
                            "text": "She is <w>haggling</w> with the shopkeeper to get a better deal on the souvenirs.",
                            "target_lang_translations": {
                                "ru": "Она <w>торгуется</w> с продавцом, чтобы получить более выгодную цену на сувениры.",
                                "nl": "Ze is met de winkelier aan het <w>pingelen</w> om een betere prijs te krijgen voor de souvenirs."
                            }
                        }
                    ],
