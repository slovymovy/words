                                        "entry_id": "164b0ff0-e333-371f-a2f0-734f9535bc21",
                                        "glosses": [
                                            "A serious medical condition in which the whole body is inflamed, causing injury to its own tissues and organs as a response to infection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26238503-6eaf-4350-8b8c-fb6d2ab6af64",
                                                "sense_id": "f529ec68-28cb-3a2e-83f8-a3aa2ceb1079",
                                                "text": "Imagine the sepsis of helpless loathing [Jimmy Connors] must have inspired in his opponents during his \"great runs\" at the US Open."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d9262ab-9cae-4bfa-97d0-e89511a985c7",
