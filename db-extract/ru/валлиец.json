                        "entry_id": "f27b8e92-9468-3d5f-8137-57718a419459",
                        "glosses": [
                            "представитель кельтского народа, составляющего коренное населения Уэльса; также житель или уроженец Уэльса"
                        ],
                        "tags": [],
                        "examples": [
                            {
