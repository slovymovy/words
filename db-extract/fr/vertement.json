                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ec308d7-dbed-3318-a104-30e6e17e2d8c",
                        "entry_id": "811a8549-ec28-3b8d-a037-d27e70bb44d7",
                        "glosses": [
                            "Avec vivacité ; avec rudesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1130dd-5302-4f79-b8b0-889541ecf505",
                                "sense_id": "6ec308d7-dbed-3318-a104-30e6e17e2d8c",
                                "text": "Saccard ne s’en occupa que pour régler le côté pécuniaire de la question ; mais la jeune femme gronda vertement son élève."
                            },
                            {
                                "example_id": "d1455536-7a78-4222-8e8e-57d2247b45d0",
                                "sense_id": "6ec308d7-dbed-3318-a104-30e6e17e2d8c",
                                "text": "Cette feuille ne craignait pas de dire ce qu'elle pesait, même aux personnages les plus hauts placés. Dans le nᵒ 29 du 30 juin 1793, elle jugeait vertement le général Alexandre Beauharnais , qui venait d'être nommé ministre de la Guerre."
                            },
                            {
                                "example_id": "8b095be5-598d-43c0-bea3-24837510377b",
                                "sense_id": "6ec308d7-dbed-3318-a104-30e6e17e2d8c",
                                "text": "Ainsi suspecté de servir la soupe aux généraux et aux ministres de droite (bien qu'il ait vertement envoyé aux pelotes Alain Peyrefitte lorsque ce dernier prétendit s’inviter lui-même à « Apostrophes »), Pivot eût dû, en bonne logique, « sauter » lorsque advint, en mai 1981, le pouvoir socialiste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
