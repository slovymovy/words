                                "example_id": "8cbe36bf-6ccf-4344-9959-118a2b71c21b",
                                "sense_id": "8d414be3-a739-3676-abc5-655e2baeb305",
                                "text": "Показать недюжинные способности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee4dcb09-2b61-4084-8d7a-d15fc3af6c0c",
                        "source_entry_id": "c4e55fbb-212d-3b68-ace0-f085feba92fa",
                        "source_sense_id": "8d414be3-a739-3676-abc5-655e2baeb305",
                        "target_lang_word": "peu ordinaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "99658211-5880-423d-ab4d-55f1886c2274",
                        "source_entry_id": "c4e55fbb-212d-3b68-ace0-f085feba92fa",
                        "source_sense_id": "8d414be3-a739-3676-abc5-655e2baeb305",
                        "target_lang_word": "hors du commun",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hors du commun",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e89cde9b-f7f0-3d45-8ce4-76df754de525",
                                        "entry_id": "154e2632-0aaf-3ad5-b5bf-8f8471c4bcf7",
                                        "glosses": [
                                            "Que l’on ne rencontre pas ordinairement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a96672fb-4d7e-4a91-8970-a5e533b82437",
                                                "sense_id": "e89cde9b-f7f0-3d45-8ce4-76df754de525",
                                                "text": "Dans plusieurs épisodes, alors que ses compagnons restent pantois, Panurge montre des talents de déchiffrement hors du commun."
                                            },
                                            {
                                                "example_id": "1c6f4f94-bb6e-44b0-b0b4-ceceb178da98",
                                                "sense_id": "e89cde9b-f7f0-3d45-8ce4-76df754de525",
                                                "text": "Naît alors, nourri d’un voyage en Italie de 8 ans (1770-1778), une œuvre singulière : peintures mythologiques, sujets shakespeariens, représentations de songes, avec une esthétique nouvelle, qui tend vers le fantastique, des anatomies michelangelesques, une énergie, un mouvement et un souffle hors du commun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d3d9bf3-1991-4d66-a92b-28478a29578b",
                        "source_entry_id": "c4e55fbb-212d-3b68-ace0-f085feba92fa",
                        "source_sense_id": "8d414be3-a739-3676-abc5-655e2baeb305",
                        "target_lang_word": "exceptionnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exceptionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7502c854-5ab1-3d15-aea8-b0702a2364b7",
                                        "entry_id": "cd7793e3-87af-36c4-bbbd-20021a36349b",
                                        "glosses": [
                                            "Qui est relatif à une exception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedb7b62-6f4a-4a05-987d-c28d0688419a",
                                                "sense_id": "7502c854-5ab1-3d15-aea8-b0702a2364b7",
                                                "text": "Brest, exceptionnelle enclave, est, en somme, la seule commune où un esprit anticlérical, se manifeste ouvertement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd53905-c32d-3173-a512-f2ad02210344",
                                        "entry_id": "cd7793e3-87af-36c4-bbbd-20021a36349b",
                                        "glosses": [
                                            "Qui est rare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71a11cc-1f8c-4418-943d-ad38df53fb02",
                                                "sense_id": "2dd53905-c32d-3173-a512-f2ad02210344",
                                                "text": "Le pape Innocent III (1193-1216) devait rompre avec cette tradition de tolérance et se faire l'inspirateur d'une politique hostile, qu'il mena avec une vigueur exceptionnelle."
                                            },
                                            {
                                                "example_id": "243c75af-bd0f-42a4-ac15-a5381530050c",
                                                "sense_id": "2dd53905-c32d-3173-a512-f2ad02210344",
                                                "text": "C'est un garçon fort agréable que Bernard. Soigné, rasé de près, le teint clair, il s'exprime dans une langue choisie et ne fait usage de l'argot qu'en d'exceptionnelles circonstances."
                                            },
                                            {
                                                "example_id": "1c9d3029-7a3b-4c00-a040-436be0b1eac1",
                                                "sense_id": "2dd53905-c32d-3173-a512-f2ad02210344",
                                                "text": "Mais il fallait que ce bon mouvement ne demeurât point exceptionnel, et se prolongeât au-delà du succès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
