                        "vrai mufle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "terme dépréciatif ou injurieux"
                        }
                    ]
                },
                {
                    "sense_id": "902bb43b-d897-3d30-89d8-f2af40ed180c",
                    "sense_definition": "Motif de sculpture ou d'architecture représentant la tête ou le museau d'un animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fontaine de pierre ancienne était ornée d'un superbe <w>mufle</w> de lion crachant de l'eau."
                        },
                        {
                            "text": "L'architecte avait sculpté des <w>mufles</w> fantastiques le long de la corniche du monument."
                        }
                    ],
                    "common_phrases": [
