                        "entry_id": "0e2c8010-5ca6-3164-8e5f-5f2e07ef6874",
                        "glosses": [
                            "lid van het gelijknamige volk van indianen in het zuidwesten van de Verenigde Staten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff8a5fb-23c0-4b0d-ba5c-815bcb6bb566",
                                "sense_id": "b0eb444c-ea46-3e97-88b0-ab13dc36dcfd",
                                "text": "New Mexico viert deze maandag voor het eerst niet Columbusdag maar Inheemsevolkerendag. (…) De Navajo hoopt dat afschaffing van de dag hem „persoonlijke groei kan bieden en me kan verbinden met mijn voorouders”."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea1cbb10-054a-3dd8-95b6-c566ce1eba0b",
                        "entry_id": "0e2c8010-5ca6-3164-8e5f-5f2e07ef6874",
                        "glosses": [
