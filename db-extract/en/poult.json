                        "glosses": [
                            "A young bird, a chick; now especially, a young game bird (turkey, partridge, grouse etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ee8727-0df6-4752-9935-1d766f92d67a",
                                "sense_id": "dd233599-8ce2-31c1-93fc-749c92883986",
                                "text": "‘I even questioned,’ said he, ‘whether there will not be, in about a week's time, some nice turkey powts.’"
                            },
                            {
                                "example_id": "2603e251-ed39-4b5f-a9d7-64513a7b12ec",
                                "sense_id": "dd233599-8ce2-31c1-93fc-749c92883986",
                                "text": "And, besides, she [the old grouse's wife] was the mother of a family, and had seven little poults to wash and feed every day; […]"
                            },
                            {
                                "example_id": "b8689939-9d98-4353-a618-2d134459d65c",
                                "sense_id": "dd233599-8ce2-31c1-93fc-749c92883986",
                                "text": "After an hour of fishing I saw a flock of turkeys on the opposite bank and shot one of the poults."
                            }
                        ]
                    }
