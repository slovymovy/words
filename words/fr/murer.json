    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5983cb33-68f4-30ed-8b26-4ccb1a1db5b1",
                    "sense_definition": "Boucher ou condamner une ouverture à l'aide de briques, de pierres ou de maçonnerie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fermeture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a décidé de <w>murer</w> la vieille entrée pour sécuriser le bâtiment."
                        },
                        {
                            "text": "Ils ont dû <w>murer</w> une fenêtre qui donnait directement sur la cour du voisin."
                        }
                    ],
                    "synonyms": [
                        "obstruer",
                        "condamner",
                        "boucher"
                    ],
                    "antonyms": [
                        "ouvrir",
                        "déboucher",
                        "percer"
                    ],
                    "common_phrases": [
                        "murer une porte",
                        "murer une fenêtre"
                    ]
                },
                {
                    "sense_id": "9319f158-5da6-3667-b482-e62ac17887fe",
                    "sense_definition": "Se renfermer totalement sur soi-même et refuser tout dialogue ou communication avec l'extérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "isolement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'annonce de la mauvaise nouvelle, il a préféré se <w>murer</w> dans le silence."
                        },
                        {
                            "text": "L'accusé refuse de répondre aux questions du juge et se <w>mure</w> dans un mutisme complet."
                        }
                    ],
                    "synonyms": [
                        "s'enfermer",
                        "s'isoler",
                        "se renfermer"
                    ],
                    "antonyms": [
                        "s'ouvrir",
                        "communiquer"
                    ],
                    "common_phrases": [
                        "se murer dans le silence",
                        "se murer dans son mutisme"
                    ]
                },
                {
                    "sense_id": "5f8381be-5934-3aad-aa4d-c1c0d1b37e73",
                    "sense_definition": "Entourer un terrain ou un domaine d'un mur ou d'une clôture en maçonnerie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cloture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a voté un budget pour <w>murer</w> l'ancien cimetière du village."
                        },
                        {
                            "text": "Pour protéger leurs cultures contre les animaux, les fermiers veulent <w>murer</w> ce terrain."
                        }
                    ],
                    "synonyms": [
                        "clôturer",
                        "enclore"
                    ],
                    "common_phrases": [
                        "murer un terrain",
                        "murer une propriété"
                    ]
                },
                {
                    "sense_id": "bea7fff1-8f41-3203-a630-7c494d73d383",
                    "sense_definition": "Enfermer une personne vivante dans un espace clos de maçonnerie pour l'y faire périr ou l'incarcérer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enfermement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une sombre légende raconte qu'un chevalier fut autrefois condamné à être <w>muré</w> vivant dans ce cachot."
                        },
                        {
                            "text": "Le tyran fit cruellement <w>murer</w> son rival dans les souterrains du château royal."
                        }
                    ],
                    "synonyms": [
                        "emmurer",
                        "claquemurer",
                        "incarcérer"
                    ],
                    "antonyms": [
                        "libérer"
                    ],
                    "common_phrases": [
                        "murer vivant"
                    ]
                },
                {
                    "sense_id": "5613bc35-2792-35c0-82ec-8d91bc5afc33",
                    "sense_definition": "Dérober complètement à la vue d'autrui ou dissimuler aux regards indiscrets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dissimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme public a toujours cherché à <w>murer</w> sa vie privée loin des journalistes."
                        },
                        {
                            "text": "Elle préférait <w>murer</w> ses sentiments secrets plutôt que de les exposer au grand jour."
                        }
                    ],
                    "synonyms": [
                        "dissimuler",
                        "masquer"
                    ],
                    "antonyms": [
                        "dévoiler",
                        "exposer"
                    ]
                }
            ]
        }
    ]
}