                "senses": [
                    {
                        "sense_id": "b71747ec-8968-3fea-9962-ceebe118e7b4",
                        "entry_id": "02d433c9-afdd-3828-9fa2-01ac205b7936",
                        "glosses": [
                            "militärische Offensive der Truppen des Dritten Reiches mit dem Ziel, den Hafen von Antwerpen zurückzuerobern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413bf2e5-10ac-48e3-b99b-c0b25226829e",
                                "sense_id": "b71747ec-8968-3fea-9962-ceebe118e7b4",
                                "text": "„Nach dem Zusammenbruch der Ardennenoffensive gab es für die Alliierten kein Hindernis mehr auf dem Weg ins Reich.“"
                            },
                            {
                                "example_id": "bb31ba0e-1924-4f43-88ca-3b719475a042",
                                "sense_id": "b71747ec-8968-3fea-9962-ceebe118e7b4",
                                "text": "„Ein letztes Mal konnte sich die deutsche Wehrmacht im Zweiten Weltkrieg in der Ardennenoffensive aufbäumen.“"
                            },
                            {
                                "example_id": "590764f0-1569-4cec-b419-54927aea00c9",
                                "sense_id": "b71747ec-8968-3fea-9962-ceebe118e7b4",
                                "text": "„Die Ardennenoffensive überraschte die Alliierten.“"
                            },
                            {
                                "example_id": "397693a6-be26-4011-a599-3e92fc73aa9c",
                                "sense_id": "b71747ec-8968-3fea-9962-ceebe118e7b4",
                                "text": "„Die Ardennenoffensive mit den Schlachten im Hürtgenwald wollte kein Ende nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
