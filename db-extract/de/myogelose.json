                                    {
                                        "sense_id": "3cdb3acf-b85a-377b-b0db-95f50d2bd226",
                                        "entry_id": "45ae6a49-f246-3242-b735-a795e720a7f0",
                                        "glosses": [
                                            "A palpable area of hardening, stiffness or swelling in a muscle, usually painful on pressure, now considered to be correlated with a myofascial trigger point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e525f29c-1a31-4cae-968f-3c0efd79397a",
                                                "sense_id": "3cdb3acf-b85a-377b-b0db-95f50d2bd226",
                                                "text": "Myogelosis is a common diagnosis in the case of chronic pain conditions, especially in the region of the pectoral girdle musculature, the glutei muscles, and the erector spinae muscle. Although such indurative areas continue to be palpable even on the cadaver, few studies concerning the morphological substrate of these areas have been undertaken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
