                ],
                "senses": [
                    {
                        "sense_id": "9966f14c-29fb-34ca-925f-d1adadf64b8d",
                        "entry_id": "108b591e-111b-3f1c-a1de-afd362758210",
                        "glosses": [
                            "Verwendung von Kleinbuchstaben am Wortanfang"
                        ],
                        "tags": [
                            "Schriftlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "8a730e9b-8434-45e3-940d-05c252050515",
                                "sense_id": "9966f14c-29fb-34ca-925f-d1adadf64b8d",
                                "text": "In der Auseinandersetzung um die Rechtschreibung wurden auch unterschiedliche Formen der Kleinschreibung erörtert."
                            },
                            {
                                "example_id": "d386aca9-0fd5-4eaf-9f15-fd3df152bfb7",
                                "sense_id": "9966f14c-29fb-34ca-925f-d1adadf64b8d",
                                "text": "„In der Liste sind alle Wörter großgeschrieben, aber für einige gibt es sowohl Groß- als auch Kleinschreibung.“"
                            },
                            {
                                "example_id": "10db9083-dbc1-4d41-8a7b-b3a5c79f5329",
                                "sense_id": "9966f14c-29fb-34ca-925f-d1adadf64b8d",
                                "text": "„Die Konstruktionen wurden bisher vor allem als orthographische Fälle gesehen, wobei es um die Groß- und Kleinschreibung sowie um die Zusammen- und Getrenntschreibung geht.“"
                            },
                            {
                                "example_id": "6aa8110c-e66f-4d18-9e70-8932c4b5e1f0",
                                "sense_id": "9966f14c-29fb-34ca-925f-d1adadf64b8d",
                                "text": "„Grundsätzlich gilt: Kleinschreibung ist der Normalfall.“"
                            },
                            {
                                "example_id": "72784761-133b-44df-99d8-65867a417e29",
                                "sense_id": "9966f14c-29fb-34ca-925f-d1adadf64b8d",
                                "text": "„1954 und 1958 wurden von Sprachwissenschaftlern der vier Deutsch sprechenden Staaten Stuttgarter beziehungsweise Wiesbadener Empfehlungen zur Rechtschreibreform erarbeitet, deren erste sogar die Forderung nach Kleinschreibung der Substantive (so genannte »gemäßigte Kleinschreibung«) enthielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
