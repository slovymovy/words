            "senses": [
                {
                    "sense_id": "ecb1fcf7-5e69-3714-bb65-b0b426f7b920",
                    "sense_definition": "Посещать какое-либо место или находиться где-то в течение некоторого времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я часто <w>бываю</w> в этом парке по выходным."
                        },
                        {
                            "text": "Мы <w>бывали</w> в гостях у наших друзей в прошлом месяце."
                        }
                    ],
                    "common_phrases": [
