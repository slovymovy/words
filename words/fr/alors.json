                    "target_lang_definitions": {
                        "en": "Introduces a consequence or conclusion drawn from what has just been said.",
                        "ru": "Указывает на следствие или вывод из сказанного; в таком случае.",
                        "nl": "Geeft aan dat iets het gevolg of de conclusie is van wat net is gezegd.",
                        "de": "Leitet eine Folge oder einen Schluss aus dem zuvor Gesagten ein.",
                        "pl": "Wskazuje na wniosek lub skutek tego, co przed chwilą zostało powiedziane.",
                        "it": "Introduce una conseguenza o una conclusione tratta da quanto appena detto.",
                        "cs": "Uvádí důsledek nebo závěr vyplývající z předchozího výroku.",
                        "tr": "Önceki söylenenden çıkan bir sonucu ya da bir durumun doğal sonucunu belirtir.",
                        "es": "Introduce una consecuencia o una conclusión que se deduce de lo que acaba de decirse.",
                        "zh": "表示由前文推出的结果或结论，相当于“在这种情况下”。"
                    },
