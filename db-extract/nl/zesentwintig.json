                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3345072e-e416-4d45-9656-e6ad8330493a",
                                "sense_id": "5a37a968-6598-384a-adf7-f1c580aa198c",
                                "text": "Het is weer de zesentwintig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "2fa28586-4391-4d50-8516-bfe889ed5e9b",
                                "sense_id": "5a37a968-6598-384a-adf7-f1c580aa198c",
                                "text": "Haar zevenentwintigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zesentwintig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "262024f7-7e8e-3cf1-9b69-86da13245e22",
                        "entry_id": "2b46ab3a-d02a-3d9f-a51d-da13fe87ca70",
                        "glosses": [
                            "groep van 26 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f129351d-f579-4389-9781-04c61da2d623",
                                "sense_id": "262024f7-7e8e-3cf1-9b69-86da13245e22",
                                "text": "De zesentwintig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
