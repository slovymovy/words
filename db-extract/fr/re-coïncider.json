                    }
                ],
                "senses": [
                    {
                        "sense_id": "4de01741-1513-3127-85a7-e980bdd0626a",
                        "entry_id": "2db03a85-e730-3424-bfd5-2d9b3a415345",
                        "glosses": [
                            "Coïncider à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd19855f-9bfd-4de0-8a87-0e365a48c776",
                                "sense_id": "4de01741-1513-3127-85a7-e980bdd0626a",
                                "text": "Je crois que vivre est cette aptitude à dé-coïncider d’avec soi pour ne cesser d’avoir à re-coïncider encore."
                            },
                            {
                                "example_id": "6db0b2b7-8b7a-431d-a0c6-501db4130c73",
                                "sense_id": "4de01741-1513-3127-85a7-e980bdd0626a",
                                "text": "La correction a donc visé à faire re-coïncider la frontière avec la Meuse, ce qui s’est traduit par la cession de quatorze hectares au Pays-Bas et de trois hectares à la Belgique, plus particulièrement à la Wallonie et la commune de Visé."
                            },
                            {
                                "example_id": "0d7a4198-a643-4873-854d-a69f22b1e870",
                                "sense_id": "4de01741-1513-3127-85a7-e980bdd0626a",
                                "text": "Dans la mesure où ils cherchent à faire re-coïncider à terme formation et emploi, les changements d'emploi volontaires s'analysent alors comme des tentatives de correction de ce trajet professionnel par rapport au projet initial."
                            }
                        ]
                    }
                ],
