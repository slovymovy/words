                    {
                        "translation_id": "2aa71c77-096d-4f04-a6e1-6fe5f9009c45",
                        "source_entry_id": "6ea02814-273b-35bd-9888-daea021058ed",
                        "source_sense_id": "45e624a8-d980-338f-be0f-6156f8ee81c4",
