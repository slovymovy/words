                        "examples": [
                            {
                                "example_id": "8d8389e3-eefd-4488-a16c-ee73b2b51f47",
                                "sense_id": "84d40ba0-9f48-3916-ba34-8d573d4a3042",
                                "text": "„Münzer stieg in einen kleinen Privatwagen.“"
                            },
                            {
                                "example_id": "4e13d313-e864-4e74-8918-1042a25d6540",
                                "sense_id": "84d40ba0-9f48-3916-ba34-8d573d4a3042",
                                "text": "„Ein Wortwechsel, laute und polternde Stimmen ziehen seinen Blick vom Kreuz auf ein Auto, einen geschlossenen Privatwagen, der vor dem Untersuchungsgefängnis hält.“"
                            },
                            {
                                "example_id": "ae057958-2114-4a55-a425-728ea81bd97f",
                                "sense_id": "84d40ba0-9f48-3916-ba34-8d573d4a3042",
                                "text": "„Privatwagen und Taxi fuhren in fast ununterbrochener Reihe vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
