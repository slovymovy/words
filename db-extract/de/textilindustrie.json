                "senses": [
                    {
                        "sense_id": "4e5835fb-5175-3513-a523-5e3844344c82",
                        "entry_id": "2466507a-53d0-3200-8aa0-ca301384b326",
                        "glosses": [
                            "Gesamtheit der Unternehmen, die Textilien herstellen oder Dienstleistungen zur Herstellung von Textilien anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0003ef5f-7b3d-4587-98bf-355c21d3f47d",
                                "sense_id": "4e5835fb-5175-3513-a523-5e3844344c82",
                                "text": "Die Textilindustrie ist ein wichtiger Wirtschaftszweig des Landes."
                            },
                            {
                                "example_id": "de151c35-6298-4ba4-828a-4fa7e9d693b2",
                                "sense_id": "4e5835fb-5175-3513-a523-5e3844344c82",
                                "text": "„Von einem kurzen Nachkriegsboom abgesehen, erlebte Großbritannien in den 20er Jahren eine Stagnation der traditionellen Branchen der Textilindustrie, des Kohlenbergbaus oder des Schiffbaus.“"
                            },
                            {
                                "example_id": "043f640b-06b3-41c0-aff2-b565ea562a15",
                                "sense_id": "4e5835fb-5175-3513-a523-5e3844344c82",
                                "text": "„In Mähren entstand eine umfangreiche Textilindustrie, in Mährisch-Ostrau (Ostrava) ein Steinkohlenrevier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
