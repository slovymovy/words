                "senses": [
                    {
                        "sense_id": "e33d7b5f-1910-3580-b624-dd9a507cbeb9",
                        "entry_id": "828be36c-2f12-30d6-a5f0-22e602a9ec9a",
                        "glosses": [
                            "Donner un caractère grégorien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87234f48-e0d9-47bf-b70c-4777f9182950",
                                "sense_id": "e33d7b5f-1910-3580-b624-dd9a507cbeb9",
                                "text": "Et cela n’empêcherait pas d’aller à la recherche des initiatives privées, qui, après des sacrifices et des luttes parfois pénibles, ont réussi finalement à « grégorianiser » leurs lutrins."
                            },
                            {
                                "example_id": "c9db7fd8-8dd6-4813-93c6-8c9443c8b0b1",
                                "sense_id": "e33d7b5f-1910-3580-b624-dd9a507cbeb9",
                                "text": "On voit l’antique formulaire gélasien se rétrécir, s’amoindrir, se « grégorianiser », et nous conduire ainsi au type liturgique qui deviendra la formule classique du « Missale Romanum »."
                            }
                        ]
                    }
                ],
