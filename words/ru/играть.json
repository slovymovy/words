                            {
                                "target_lang_word": "吹奏",
                                "target_lang_sense_clarification": "管乐器"
                            },
                            {
                                "target_lang_word": "拉",
                                "target_lang_sense_clarification": "拉弦乐器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca4f654c-b731-3348-a446-fd393ad8b58b",
                    "sense_definition": "Исполнять роль в театре или кино; выступать на сцене.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Известный актёр будет <играть> главную роль в новом фильме.",
                            "target_lang_translations": {
                                "en": "A famous actor will <play> the main role in the new movie.",
                                "zh": "一位著名演员将在新电影中<w>扮演</w>主角。"
                            }
                        },
                        {
                            "text": "Она мечтает <играть> на сцене большого театра.",
                            "target_lang_translations": {
                                "en": "She dreams of <acting> on the stage of the Bolshoi Theatre.",
                                "zh": "她梦想着在大剧院的舞台上<w>演戏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "изображать",
                        "лицедействовать"
                    ],
                    "common_phrases": [
                        "играть роль",
                        "играть в театре",
                        "играть в кино",
                        "играть на сцене",
                        "играть Гамлета"
                    ],
                    "target_lang_definitions": {
                        "en": "To perform a role in theater or cinema; to perform on stage.",
                        "zh": "在戏剧或电影中扮演角色；在舞台上表演。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "act",
                                "target_lang_sense_clarification": "perform on stage"
                            },
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "portray a character"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扮演",
                                "target_lang_sense_clarification": "角色"
                            },
                            {
                                "target_lang_word": "演",
                                "target_lang_sense_clarification": "表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0e65439-2dfc-3693-8d51-2765a3a9cc4f",
                    "sense_definition": "Относиться к чему-либо несерьёзно, рискованно или пренебрежительно; обращаться с чем-то опасным как с игрушкой.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит <играть> с огнём, это может плохо кончиться.",
                            "target_lang_translations": {
                                "en": "One shouldn't <play> with fire, it might end badly.",
                                "zh": "不应该<w>玩弄</w>火，这可能会有糟糕的后果。"
                            }
                        },
                        {
                            "text": "Он привык <играть> чувствами других людей.",
                            "target_lang_translations": {
                                "en": "He is used to <playing> with other people's feelings.",
                                "zh": "他习惯于<w>玩弄</w>别人的感情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пренебрегать"
                    ],
                    "antonyms": [
                        "ценить"
                    ],
                    "common_phrases": [
                        "играть с огнём",
                        "играть жизнью",
                        "играть судьбой",
                        "играть людьми"
                    ],
                    "target_lang_definitions": {
                        "en": "To treat something unseriously, riskily, or dismissively; to handle something dangerous like a toy.",
                        "zh": "对某事态度不认真、冒险或轻视；像对待玩具一样对待危险事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "treat lightly, toy with"
                            },
                            {
                                "target_lang_word": "toy",
                                "target_lang_sense_clarification": "treat casually"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拿……开玩笑",
                                "target_lang_sense_clarification": "轻视"
                            },
                            {
                                "target_lang_word": "玩弄",
                                "target_lang_sense_clarification": "对待危险事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa809953-1d68-3b82-ae15-c68088924076",
                    "sense_definition": "Притворяться кем-либо, изображать какое-либо поведение или качество с целью обмана или шутки.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хватит <играть> комедию, скажи мне правду.",
                            "target_lang_translations": {
                                "en": "Stop <acting> the fool, tell me the truth.",
                                "zh": "别再<w>演戏</w>了，告诉我真相。"
                            }
                        },
                        {
                            "text": "Он любит <играть> в начальника, хотя ничего не решает.",
                            "target_lang_translations": {
                                "en": "He likes to <play> the boss, although he decides nothing.",
                                "zh": "他喜欢<w>装</w>领导，尽管他什么都决定不了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "притворяться",
                        "изображать",
                        "лукавить"
                    ],
                    "common_phrases": [
                        "играть комедию",
                        "играть дурака",
                        "играть в благородство"
                    ],
                    "target_lang_definitions": {
                        "en": "To pretend to be someone, to depict some behavior or quality for the purpose of deception or a joke.",
                        "zh": "为了欺骗或开玩笑而假装成某人，或表现出某种行为或品质。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "pretend to be"
                            },
                            {
                                "target_lang_word": "act",
                                "target_lang_sense_clarification": "feign"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装",
                                "target_lang_sense_clarification": "假装"
                            },
                            {
                                "target_lang_word": "演戏",
                                "target_lang_sense_clarification": "虚伪行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dad5922-749d-33e3-b5fe-c70c3cdcabe3",
                    "sense_definition": "Использовать чьи-либо слабости, чувства или инстинкты для достижения своих целей.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный оратор умеет <играть> на эмоциях толпы.",
                            "target_lang_translations": {
                                "en": "An experienced orator knows how to <play> on the crowd's emotions.",
                                "zh": "经验丰富的演说家懂得如何<w>利用</w>群众的情绪。"
                            }
                        },
                        {
                            "text": "Пожалуйста, перестань <играть> на моих нервах.",
                            "target_lang_translations": {
                                "en": "Please stop <playing> on my nerves.",
                                "zh": "请别再<w>折磨</w>我的神经了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "играть на нервах",
                        "играть на чувствах",
                        "играть на слабостях"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To use someone's weaknesses, feelings, or instincts to achieve one's goals.",
                        "zh": "利用他人的弱点、感情或本能来达到自己的目的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "play on",
                                "target_lang_sense_clarification": "exploit emotions"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利用",
                                "target_lang_sense_clarification": "操纵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14e13d7a-8674-35e6-88dc-17fa36a36cb4",
                    "sense_definition": "Ярко сверкать, переливаться светом или цветом; о напитках — пениться и искриться.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В хрустальном бокале красиво <играет> шампанское.",
                            "target_lang_translations": {
                                "en": "Champagne <sparkles> beautifully in the crystal glass.",
                                "zh": "香槟在水晶杯中美丽地<w>闪烁</w>着。"
                            }
                        },
                        {
                            "text": "Солнечный луч <играл> на поверхности озера.",
                            "target_lang_translations": {
                                "en": "A sunbeam <played> on the surface of the lake.",
                                "zh": "阳光在湖面上<w>闪烁</w>。"
                            }
                        },
                        {
                            "text": "На её губах <играла> лёгкая улыбка.",
                            "target_lang_translations": {
                                "en": "A faint smile <played> on her lips.",
                                "zh": "她的嘴角<w>泛起</w>一丝淡淡的微笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сверкать",
                        "сиять",
                        "пениться",
                        "бурлить",
                        "отражаться"
                    ],
                    "common_phrases": [
                        "вино играет",
                        "солнце играет"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To sparkle brightly, shimmer with light or color; of drinks — to foam and sparkle.",
                        "zh": "明亮地闪烁，闪烁着光芒或色彩；指饮料时，指起泡和闪烁。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sparkle",
                                "target_lang_sense_clarification": "shine, bubble"
                            },
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "move lightly (light, smile)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "光线"
                            },
                            {
                                "target_lang_word": "泛起",
                                "target_lang_sense_clarification": "表情或光影"
                            }
                        ]
                    }
