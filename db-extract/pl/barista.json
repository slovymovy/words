                "senses": [
                    {
                        "sense_id": "1abd3b5c-3847-339d-8d13-b116805a57d5",
                        "entry_id": "d06d12d0-487f-3a2b-b98a-6d2f017296df",
                        "glosses": [
                            "osoba zawodowo zajmująca się doborem, parzeniem oraz serwowaniem kawy"
                        ],
                        "tags": [],
