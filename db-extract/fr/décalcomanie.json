                    }
                ],
                "senses": [
                    {
                        "sense_id": "0532976e-6c97-3740-88af-783a03071cc2",
                        "entry_id": "643ee8bd-4187-36e2-bc71-af8054dda647",
                        "glosses": [
                            "Procédé par lequel on reporte une image en couleur sur du papier, de la porcelaine, etc., qui en garde l’impression."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "caffb19f-04cc-4e36-bd45-443bd2088ee5",
                                "sense_id": "0532976e-6c97-3740-88af-783a03071cc2",
                                "text": "A Paris, on a fait de la potichomanie, de la décalcomanie."
                            }
                        ]
                    },
                    {
                        "sense_id": "97bd8185-3f87-3054-95c5-a660cf1eade7",
                        "entry_id": "643ee8bd-4187-36e2-bc71-af8054dda647",
                        "glosses": [
                            "Image transférable d'un support flexible à un autre généralement rigide, de façon permanente."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e1c4f42-1315-41a9-8b76-23b148632fc0",
                        "source_entry_id": "643ee8bd-4187-36e2-bc71-af8054dda647",
                        "source_sense_description": "Procédé par lequel on reporte une image",
                        "target_lang_word": "Abziehbild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abziehbild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b6e73ac-07b9-3716-bd07-207463afb9d6",
                                        "entry_id": "4702fa1c-c288-3290-80f5-d85f11b3ac48",
                                        "glosses": [
                                            "Bild, das spiegelverkehrt auf ein Papier (als Träger) appliziert wurde und nach Befeuchten auf einen Gegenstand gelegt, angedrückt und damit übertragen wird, das Papier wird danach abgezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e64793c-ce4e-4bb5-a301-66b09880f725",
                                                "sense_id": "9b6e73ac-07b9-3716-bd07-207463afb9d6",
                                                "text": "Kinder lieben es, ein Abziehbild aus dem Kaugummiautomaten auf ihren Arm zu übertragen – wie ein Tatoo."
                                            },
                                            {
                                                "example_id": "34c98456-7b00-48eb-8d25-66e27d029943",
                                                "sense_id": "9b6e73ac-07b9-3716-bd07-207463afb9d6",
                                                "text": "„Im oberfränkischen Rehau drucken die Azubis Abziehbilder für edles Geschirr mit leuchtenden Farben.“"
                                            },
                                            {
                                                "example_id": "37acf375-15be-4430-a7aa-cf34c57a96f4",
                                                "sense_id": "9b6e73ac-07b9-3716-bd07-207463afb9d6",
                                                "text": "„Die Richter [Anmerkung: des Bundespatentgerichts in München] hatten dort entschieden, dass der Markenschutz zumindest für einen Teil der von der FIFA vorgelegten Liste nicht gilt. Das betrifft zum Beispiel Produkte wie Sammelbilder und Sammelkarten, Aufkleber und Abziehbilder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                        "entry_id": "4702fa1c-c288-3290-80f5-d85f11b3ac48",
                                        "glosses": [
                                            "Idee, Vorstellung oder auch Klischee von einer Person/einer Sache"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "418d135e-7293-4405-9402-4d5e3d7ddd9a",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "„[…] viele Männer finden sich im Abziehbild der betrunken umherziehenden Männergruppen, die an Himmelfahrt den Vatertag feiern, nicht unbedingt wieder. Auch Männer können mehr als trinken […].“"
                                            },
                                            {
                                                "example_id": "c76d384a-ac29-40d6-a45b-c04bdf4f73e4",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "„Robert Mugabe ist das Abziehbild des Despoten. Aus dem strahlenden Freiheitskämpfer und Helden afrikanischer Unabhängigkeit ist ein Diktator geworden, der sein ganzes Volk zur Geisel nimmt.“"
                                            },
                                            {
                                                "example_id": "c146fbc7-01bc-42ac-bdfd-481c0c964e1f",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "„Was in Film und Fernsehen gezeigt werde, [ist] doch das reinste Abziehbild: »Entweder sieht man eine dicke Witzfigur, die nur Kriminalfälle löst oder eine sinistre Gestalt, die an irgendeinem Weltendende ein Geheimnis aus dem Schrank holt […]«.“"
                                            },
                                            {
                                                "example_id": "04e5a741-062b-413e-96e5-207e9c757d0d",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "[Weihnachten: Christkind oder Weihnachtsmann:] „In den Medien dominiert aber mittlerweile eindeutig Santa Claus, dieses künstliche amerikanische Abziehbild des Nikolaus.“"
                                            },
                                            {
                                                "example_id": "5e37b0c4-143b-4fb3-9e69-e2a04dea2373",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "[Kritiker Tilman Krause: Für einen guten Roman muss man] „»Figuren schaffen, die nicht nur als Abziehbilder als Typen der Epoche funktionieren, sondern die auch ein Eigenleben haben.«“"
                                            },
                                            {
                                                "example_id": "f46d1508-8b93-4bc1-9ded-45fe7cfeca27",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "„Der sympathische und kämpferische [Anmerkung: schottische Radfahrer Graeme] Obree wirkt wie ein Abziehbild eines Radprofis, den man sich heutzutage angesichts der derzeitigen Entwicklung im Radsport wünschen würde. So sagt ein Funktionär auf die Nachfrage, ob Obree vielleicht dope: »Er nimmt gar nichts. Wir haben sogar eines seiner Sandwiches getestet - nur Orangen und Zucker.«“"
                                            },
                                            {
                                                "example_id": "d85d2cc8-f6f2-4564-bfe6-0e59a5a0a542",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "„Wo “House of Cards” uns mit brillianten Figuren fesselt, holt “Marseille” einfach ein paar eindimensionale Abziehbilder aus der Klischee-Kiste.“"
                                            },
                                            {
                                                "example_id": "10504285-520d-4aa0-a01d-9f314808f100",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "„In Co de Kloets gerade veröffentlichtem Buch \"Frank & Co\" […], begegnet man in vielen Interviews und Texten deshalb auch keinem Abziehbild, sondern dem Menschen Zappa, dem kompromisslosen, direkten und humorvollen Musiker.“"
                                            },
                                            {
                                                "example_id": "1790a5d4-bca3-45b8-897c-e6900353bcf4",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "„PULS-Moderatoren sind echte Persönlichkeiten – keine glattgebügelten Abziehbilder, sondern Träumer und Rampensäue, Nerds und Draufgänger.“"
                                            },
                                            {
                                                "example_id": "21036973-3656-473b-bb80-993a952d3c55",
                                                "sense_id": "89c8a00d-0f96-39b8-8131-e34915fb7eee",
                                                "text": "„Soziale Medien wie Instagram befeuern diesen Trend und zeigen die Berge als märchenhaft stilisierte Sehnsuchtsorte: inszeniert bis ins letzte Detail, retuschiert und mit Filtern zugekleistert. Viel schöner als die Realität, aber oft auch so beliebig wie Abziehbilder […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
