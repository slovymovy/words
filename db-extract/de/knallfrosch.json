                    {
                        "translation_id": "f685e91e-0430-41d9-be4f-ae14b4b17709",
                        "source_entry_id": "33c5b483-a062-301d-980d-f3866f06fdfd",
                        "source_sense_id": "8179e4c9-a21b-38e3-8622-443c9bef411d",
                        "target_lang_word": "pétard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c1b86d2-d201-382a-900b-3b68d7f5af9d",
                                        "entry_id": "526b3126-7f9f-39b5-b921-b94c8aa50cd5",
                                        "glosses": [
                                            "Expression de surprise, d’étonnement, de stupéfaction ; putain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a44026e2-56d4-4aaf-b1e8-99aa89f6cf40",
                                                "sense_id": "0c1b86d2-d201-382a-900b-3b68d7f5af9d",
                                                "text": "Un coup de bagne pour vingt-cinq ans ça nous dresserait à tous le cul ! Sacredieu pétard ! Ah ! il nous aimait pas la tante !"
                                            },
                                            {
                                                "example_id": "05576dc6-3a1b-426f-a264-60c096627f16",
                                                "sense_id": "0c1b86d2-d201-382a-900b-3b68d7f5af9d",
                                                "text": "Pétard! On m’a volé! Même Jolly Jumper!!!"
                                            },
                                            {
                                                "example_id": "84a98e91-3acc-46cc-a46b-d369a19c0032",
                                                "sense_id": "0c1b86d2-d201-382a-900b-3b68d7f5af9d",
                                                "text": "Pétard ! C’est qu’il n’est pas mauvais en plus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pétard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1e332d2-163c-3b90-8b04-f9606b17bfa8",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Petit fourneau chargé d’explosif, qu’on fait éclater pour briser une porte, ébranler une muraille, faire une excavation dans un terrain très dur, chevrotine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5810698-0c1b-4f39-9f92-3e3b0fc10aa8",
                                                "sense_id": "e1e332d2-163c-3b90-8b04-f9606b17bfa8",
                                                "text": "L’idée que Machiavel nous donne des villes impériales d’Allemagne est toute différente de ce qu’elles sont à présent ; un pétard suffirait, et au défaut de cela un mandement de l’Empereur, pour le rendre maître de la ville."
                                            },
                                            {
                                                "example_id": "a5700687-9024-43c4-bd7d-63e3fecede5a",
                                                "sense_id": "e1e332d2-163c-3b90-8b04-f9606b17bfa8",
                                                "text": "Leurs armures étaient peintes en noir ; ils portaient des échelles noires et des lanternes sourdes, des haches pour couper les chaînes des ponts, et des pétards pour faire sauter les portes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dda704c8-b344-3770-adb8-3284e1d21e49",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Petite boîte détonante que l’on place sur un rail comme signal et qui, écrasée par une locomotive, attire par le bruit de la détonation l’attention du mécanicien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4456371b-0c7a-40a3-9e05-110a15b150ee",
                                                "sense_id": "dda704c8-b344-3770-adb8-3284e1d21e49",
                                                "text": "Poser des pétards sur la voie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93f50474-5864-3e19-ba16-5b3799d106cf",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Pièce d’artifice faite avec de la poudre et du papier roulé et serré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc085d2-e674-4d68-a98b-eb7449dae349",
                                                "sense_id": "93f50474-5864-3e19-ba16-5b3799d106cf",
                                                "text": "Tantôt il attache un pétard à un poil de ma barbe, tantôt il me décoche de son arbalète un trait de feu dans mon manteau."
                                            },
                                            {
                                                "example_id": "8dbd7d4f-9a97-4660-9ce5-a773ec5d9384",
                                                "sense_id": "93f50474-5864-3e19-ba16-5b3799d106cf",
                                                "text": "Au douar, l’on avait tiré quelques coups de fusil, fait partir beaucoup de pétards, fait courir les faméliques chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd5be59-b5c1-3719-985b-10a0c05a2bf5",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Nouvelle à sensation lancée à dessein de faire scandale, bombe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2fddacd-e243-4e28-9209-cef6669079a1",
                                                "sense_id": "cbd5be59-b5c1-3719-985b-10a0c05a2bf5",
                                                "text": "Lancer un pétard."
                                            },
                                            {
                                                "example_id": "7e6e11d8-04da-4962-bf58-11fa87898d59",
                                                "sense_id": "cbd5be59-b5c1-3719-985b-10a0c05a2bf5",
                                                "text": "Pétard mouillé : Révélation, nouvelle qui devrait être spectaculaire, sensationnelle, mais qui n’a pas d’effet."
                                            },
                                            {
                                                "example_id": "a51f5a09-366c-470c-97be-a62455534037",
                                                "sense_id": "cbd5be59-b5c1-3719-985b-10a0c05a2bf5",
                                                "text": "De divers côtés lui parvenaient [à la Reine] des nouvelles du déplorable effet produit par ce pétard [le manifeste de Brunswick] […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd57cd5-3271-3415-9582-ff3655b4518f",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Outil pneumatique permettant de façonner la pierre en propulsant la broche ou le ciseau à son encontre à cadence élevée."
                                        ],
                                        "tags": [
                                            "Taille de pierre"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7559cdb8-4c83-38d5-89fd-3b38d5fbcbb0",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Revolver, pétoire, flingue."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bba8cfd-e227-4a1d-b57b-f2e846c6ff1d",
                                                "sense_id": "7559cdb8-4c83-38d5-89fd-3b38d5fbcbb0",
                                                "text": "Il prenait son pétard en mains, il faisait tourner le barillet."
                                            },
                                            {
                                                "example_id": "06fd0e2d-442a-4c58-829a-3c710824b22e",
                                                "sense_id": "7559cdb8-4c83-38d5-89fd-3b38d5fbcbb0",
                                                "text": "— Donne-moi ton revolver. Je vais te remettre les trois balles.\nDhéry bougea mollement dans son coin.\n— Vous ne pourriez pas aller faire ça ailleurs, non ?\nAlexandre haussa les épaules.\n— Ne t'énerve pas. Question pétard, l'abbé en connaît un bout.\n— Si j'ose dire, dit Maillat. L'abbé sourit et se tourna vers lui.\n— Tiens, te voilà paré maintenant.\nMaillat remit le revolver dans son étui, et leva son quart au-dessus de sa tête."
                                            },
                                            {
                                                "example_id": "463e95ad-938b-4e98-8e0c-66d1487d1f4e",
                                                "sense_id": "7559cdb8-4c83-38d5-89fd-3b38d5fbcbb0",
                                                "text": "—… Alors le Douglas Fairbanks il arrive sur son ch’val, i prend ses pétards, il abat le traître, un sale mec, et i dit, en embrassant la fille du shérif : « Rien ne pourra plus nous séparer, ma chérie… »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8b5ab20-c1f8-390a-b9e8-57033186d8fd",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Fesses, arrière-train, fessier."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "note": "Au Canada, on dit plutôt péteux dans ce sens",
                                        "examples": [
                                            {
                                                "example_id": "5a1fa07c-57f7-49ad-9fa0-92418c2e8dd6",
                                                "sense_id": "b8b5ab20-c1f8-390a-b9e8-57033186d8fd",
                                                "text": "Elle avait pas vingt piges la môme et des petits nénés insolents… et la taille de guêpe… et un pétard comme je les aime, tendu, musclé, bien fendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc36b4c0-70fb-3d89-8bfa-c100945f4b8c",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Homme ou femme très attirant, bombe sexuelle (pour une femme), étalon (pour un homme)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f735c32-e7dd-32f7-96d0-6f31a3015f40",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Tapage, scandale."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a96f80a6-c160-45c4-a6d0-78895f30ad0c",
                                                "sense_id": "5f735c32-e7dd-32f7-96d0-6f31a3015f40",
                                                "text": "Le roi et la reine entrèrent. J’étais couvert d’une sueur froide tant je craignais un pétard de mes deux compagnons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e864f72-8e4c-3d81-80b3-98429a772fb0",
                                        "entry_id": "f19c6ea4-47d5-3bbc-afd2-e080d92f3833",
                                        "glosses": [
                                            "Nuance de couleur vive, éclatante, « pétante » (rose pétard, jaune pétard, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26386c9c-4e7c-41fc-979d-ca260cac583b",
                                                "sense_id": "2e864f72-8e4c-3d81-80b3-98429a772fb0",
                                                "text": "Les couleurs pétard, vert pomme, rouge cassis, bleu pailleté, orange effet marbré, sont de sortie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pétard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f361c69-b1ee-3cf0-9fc6-fbabfb7166a5",
                                        "entry_id": "5a0959e9-5f5a-3d70-999a-0ab6e07577f2",
                                        "glosses": [
                                            "Cigarette contenant du cannabis ou ses dérivés."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d793f259-f15e-44e6-87a8-3a8d3c80b544",
                                                "sense_id": "4f361c69-b1ee-3cf0-9fc6-fbabfb7166a5",
                                                "text": "Aussi, quand il n’en pouvait plus, il rendait visite à Raphaël pour fumer un pétard et se détendre."
                                            },
                                            {
                                                "example_id": "3a393a65-364e-4b87-bfd9-ea990309878a",
                                                "sense_id": "4f361c69-b1ee-3cf0-9fc6-fbabfb7166a5",
                                                "text": "Mon père est mort, j’ai hérité, j’ai eu vingt et un ans, je suis allé au casino et j’ai perdu quelques millions, j’aurais préféré le piano, mais au lieu de ça, j’ai appris à rouler des pétards parfaits, et à me faire mes propres fix, avec Julie."
                                            },
                                            {
                                                "example_id": "cd334d49-e224-43f0-bfe2-3117cf5339bd",
                                                "sense_id": "4f361c69-b1ee-3cf0-9fc6-fbabfb7166a5",
                                                "text": "Si tu crois que tu vas gagner en endurance à rien branler chez toi, à boire des binches et fumer des pétards devant la console avec tes potes, va falloir y réfléchir à 2 fois !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
