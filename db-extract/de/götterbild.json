                    }
                ],
                "senses": [
                    {
                        "sense_id": "5aeda3ee-8b4f-3c0a-b645-445d81b7224e",
                        "entry_id": "5a5beda7-b990-3f6a-9089-8d411bbc1045",
                        "glosses": [
                            "Bild eines Gottes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b649941d-9439-432b-8a13-b89aa86d68b0",
                                "sense_id": "5aeda3ee-8b4f-3c0a-b645-445d81b7224e",
                                "text": "„In Kiew lässt der Konvertit nun alle heidnischen Götterbilder und Statuen zerschlagen oder ins Feuer werfen und befiehlt zudem seinen Untertanen, sich am Ufer des Dnjepr zu einer Massentaufe einzufinden.“"
                            },
                            {
                                "example_id": "4953841a-7630-4873-ad26-c48e519cec4f",
                                "sense_id": "5aeda3ee-8b4f-3c0a-b645-445d81b7224e",
                                "text": "„Ganz im Norden, wo bereits der Hang beginnt, lag ein kleiner quadratischer Bau, wohl für ein Götterbild, daneben stand ein weiterer größerer rechteckiger Tempel, dessen Wände noch ein Meter hoch erhalten sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "269675b2-455c-4720-a01b-0cab57c083ba",
                        "source_entry_id": "5a5beda7-b990-3f6a-9089-8d411bbc1045",
                        "source_sense_id": "5aeda3ee-8b4f-3c0a-b645-445d81b7224e",
                        "source_sense_description": "Bild eines Gottes",
                        "target_lang_word": "idol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f17eca-610e-38e8-920b-32be0c3d0587",
                                        "entry_id": "b58be051-677f-3e64-b5d2-6f0d1cd7682d",
                                        "glosses": [
                                            "A graven image or representation of anything that is revered, or believed to convey spiritual power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4237136e-942a-4d08-83e7-d34a4ab43892",
                                                "sense_id": "f8f17eca-610e-38e8-920b-32be0c3d0587",
                                                "text": "20 And the rest of the men which were not killed by these plagues, yet repented not of the works of their hands, that they should not worship deuils, and idoles of golde, and siluer, and brasse, and stone, and of wood, which neither can see, nor heare, nor walke:\n21 Neither repented they of their murders, nor of their sorceries, nor of their fornication, nor of their thefts."
                                            },
                                            {
                                                "example_id": "3d7f2424-7f56-4e04-903d-f4578e6d8209",
                                                "sense_id": "f8f17eca-610e-38e8-920b-32be0c3d0587",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            },
                                            {
                                                "example_id": "1183da42-a6b2-48ff-929e-daceaee7b063",
                                                "sense_id": "f8f17eca-610e-38e8-920b-32be0c3d0587",
                                                "text": "There's a one-eyed yellow idol to the north of Kathmandu, There's a little marble cross below the town; There's a broken-hearted woman tends the grave of Mad Carew, And the Yellow God forever gazes down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1286905-f128-33c1-90ac-5b4e7d677f81",
                                        "entry_id": "b58be051-677f-3e64-b5d2-6f0d1cd7682d",
                                        "glosses": [
                                            "A cultural icon, or especially popular person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcb44df2-0eb5-3c2d-977f-94f2c7fdc901",
                                        "entry_id": "b58be051-677f-3e64-b5d2-6f0d1cd7682d",
                                        "glosses": [
                                            "A popular entertainer, usually young, captivating and attractive, and often female, with an image of being close to fans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f717e0-c61b-4bfc-9b8c-a3e544b6a5d2",
                                                "sense_id": "fcb44df2-0eb5-3c2d-977f-94f2c7fdc901",
                                                "text": "Tom Cruise is his idol."
                                            },
                                            {
                                                "example_id": "068ac76a-74b7-4e13-bf53-416f3788adaf",
                                                "sense_id": "fcb44df2-0eb5-3c2d-977f-94f2c7fdc901",
                                                "text": "Sachin Tendulkar is Rohan's idol."
                                            },
                                            {
                                                "example_id": "a7171a0a-0c68-4102-ad57-6d303da8266f",
                                                "sense_id": "fcb44df2-0eb5-3c2d-977f-94f2c7fdc901",
                                                "text": "They are known as \"idols\" and their job is \"to sell dreams\". For decades, the young pop stars of Japan and South Korea have been the envy of teenagers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b76b8035-4985-3aa4-83fb-5aa900f64f06",
                                        "entry_id": "b58be051-677f-3e64-b5d2-6f0d1cd7682d",
                                        "glosses": [
                                            "An eidolon or phantom; a misleading or elusive image or representation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73f27a36-08c4-4537-8162-048c364110bf",
                        "source_entry_id": "5a5beda7-b990-3f6a-9089-8d411bbc1045",
                        "source_sense_id": "5aeda3ee-8b4f-3c0a-b645-445d81b7224e",
                        "source_sense_description": "Bild eines Gottes",
                        "target_lang_word": "idole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a73f439-e096-3b39-8509-22359843ce8f",
                                        "entry_id": "8d66540e-571c-35dc-82ae-1cc976776618",
                                        "glosses": [
                                            "Figure, statue représentant une divinité qui fait l'objet d'une adoration religieuse, précisément, une idolâtrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc13d40-88a1-4fa6-8759-9f42d6d38eb6",
                                                "sense_id": "9a73f439-e096-3b39-8509-22359843ce8f",
                                                "text": "Une idole de pierre, de bois."
                                            },
                                            {
                                                "example_id": "1466d33c-569a-4732-a1e5-82899fc9be09",
                                                "sense_id": "9a73f439-e096-3b39-8509-22359843ce8f",
                                                "text": "Les prêtres des idoles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a22fc43-fdac-3b8e-9765-3c677880a65d",
                                        "entry_id": "8d66540e-571c-35dc-82ae-1cc976776618",
                                        "glosses": [
                                            "Divinité que sa statue représente."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de46294d-7e79-437a-9023-67534f7ab9a4",
                                                "sense_id": "5a22fc43-fdac-3b8e-9765-3c677880a65d",
                                                "text": "Adorer une idole."
                                            },
                                            {
                                                "example_id": "9ebbc9f6-57ea-4423-abda-3c6478e98799",
                                                "sense_id": "5a22fc43-fdac-3b8e-9765-3c677880a65d",
                                                "text": "Pour mieux tenir debout\nL’homme inventa la fable\nSe vêtit de légendes\nPeupla le ciel d’idoles\nMultiplia ses panthéons\nCumula ses utopies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53b392c-534f-3626-8d49-c32accbc901a",
                                        "entry_id": "8d66540e-571c-35dc-82ae-1cc976776618",
                                        "glosses": [
                                            "Personne adulée, riche, puissante, etc, à qui on prodigue les honneurs, les louanges."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb0c9c5c-728a-4c91-9787-997a56f970bd",
                                                "sense_id": "d53b392c-534f-3626-8d49-c32accbc901a",
                                                "text": "Il y a toujours eu, dans les cours, des idoles et des idolâtres."
                                            },
                                            {
                                                "example_id": "6116d15e-c448-43ee-ba4a-bdcda316fc43",
                                                "sense_id": "d53b392c-534f-3626-8d49-c32accbc901a",
                                                "text": "Que je faisais de vous une idole dans mon cœur."
                                            },
                                            {
                                                "example_id": "90fc64c9-c9ff-4180-8355-72955f139a38",
                                                "sense_id": "d53b392c-534f-3626-8d49-c32accbc901a",
                                                "text": "– Ça, c'est niet. J'ai mes limites. La perspective de changer le slibard plein de pisse de mon idole ne m'enchante pas, mais je n'ai pas le choix, alors ça va."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4c3af83-c17e-35ec-b4d4-d65431d58251",
                                        "entry_id": "8d66540e-571c-35dc-82ae-1cc976776618",
                                        "glosses": [
                                            "Ce qui fait le sujet de l’affection, de la passion de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00a8e33f-f8a6-4a7c-b201-e267c7a37b97",
                                                "sense_id": "a4c3af83-c17e-35ec-b4d4-d65431d58251",
                                                "text": "Il y a longtemps que les hommes, toujours vains, font leur idole de la gloire."
                                            },
                                            {
                                                "example_id": "9143db9f-193a-4948-947a-a099e87a1d3a",
                                                "sense_id": "a4c3af83-c17e-35ec-b4d4-d65431d58251",
                                                "text": "Cet honneur a toujours été l’idole des hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b95b2d-6515-32fd-9065-d655f048cfeb",
                                        "entry_id": "8d66540e-571c-35dc-82ae-1cc976776618",
                                        "glosses": [
                                            "Se dit d’une personne qui se tient à ne rien faire, passive comme une statue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d576f6-b42a-4b12-9947-a31a6a5c1839",
                                                "sense_id": "56b95b2d-6515-32fd-9065-d655f048cfeb",
                                                "text": "Il est là comme une idole."
                                            },
                                            {
                                                "example_id": "4211a9f8-62cb-43b9-8be9-45df243bad1d",
                                                "sense_id": "56b95b2d-6515-32fd-9065-d655f048cfeb",
                                                "text": "D’abord nous n’avons su non plus que d’une idole\nLui tirer de la bouche une seule parole."
                                            },
                                            {
                                                "example_id": "e091375f-1c82-4651-9e82-9441a6998aac",
                                                "sense_id": "56b95b2d-6515-32fd-9065-d655f048cfeb",
                                                "text": "Poppée est bien [dans son buste] la jolie idole que devait élever puis briser un caprice de Néron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0c9f1b-9a2d-3c63-9353-c28ca72b5566",
                                        "entry_id": "8d66540e-571c-35dc-82ae-1cc976776618",
                                        "glosses": [
                                            "Ampullaire, coquille univalve, aussi connue sous le nom de dieu manitou ou manitou, mollusque gastéropode d’eau douce (Pomacea urceus, anciennement Ampullarius urceus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
