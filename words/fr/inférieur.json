                        "membres inférieurs",
                        "étage inférieur"
                    ]
                },
                {
                    "sense_id": "58162740-f630-3152-86b4-8d20f349e9f0",
                    "sense_definition": "Qui a une valeur, une qualité ou un rang moindre en comparaison avec un autre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "valeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce produit bon marché est fabriqué avec des matériaux de qualité <w>inférieure</w>."
                        },
                        {
                            "text": "Son salaire mensuel est nettement <w>inférieur</w> à la moyenne nationale."
