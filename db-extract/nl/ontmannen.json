                "senses": [
                    {
                        "sense_id": "560ccd80-1a9b-3cda-b0d8-2d354487d172",
                        "entry_id": "5f9c146b-4f27-3077-b27b-a074bb39f455",
                        "glosses": [
                            "door te castreren of het amputeren van de penis, iemand ontdoen van zijn mannelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89cdbc1e-1e40-4ab0-8d07-7b352c57d71c",
                                "sense_id": "560ccd80-1a9b-3cda-b0d8-2d354487d172",
                                "text": "In de omgeving staat de rotsformatie bekend als de Trollpikken, in het Nederlands 'de penis van de trol'. Het ontmannen van de Troll vond plaats op een moment dat de plaatselijke bevolking van Egersund van plan was, de speciale rotsformatie nog meer toeristisch te vermarkten door het aanleggen van een speciaal pas, een parkeerplaats en informatieve borden."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fa4ff4e-d9a4-3d40-9d50-438344804871",
                        "entry_id": "5f9c146b-4f27-3077-b27b-a074bb39f455",
                        "glosses": [
                            "van iets of iemand de kracht afnemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd4aca4-7236-4896-8b03-d42eb463abc8",
                                "sense_id": "1fa4ff4e-d9a4-3d40-9d50-438344804871",
                                "text": "Een temperatuurdaling van een paar graden in een gebied van honderd vierkante kilometer is al genoeg om een orkaan te ontmannen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da7691d0-80dc-48a4-adf4-b84eaf5d4859",
                        "source_entry_id": "5f9c146b-4f27-3077-b27b-a074bb39f455",
                        "source_sense_id": "560ccd80-1a9b-3cda-b0d8-2d354487d172",
                        "source_sense_description": "door te castreren of het amputeren van de penis, iemand ontdoen van zijn mannelijkheid",
                        "target_lang_word": "entmannen",
