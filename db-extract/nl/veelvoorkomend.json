                        "examples": [
                            {
                                "example_id": "6e73cda9-8ed4-4c43-8a9b-ad10e5ade25c",
                                "sense_id": "e65279f8-a129-31b7-84e3-c3b71e156b60",
                                "text": "Inmiddels wonen we in het relatieve duivenluwe centrum van Deventer, maar in Amsterdam is dit een bekend en veelvoorkomend probleem."
                            },
                            {
                                "example_id": "08e610f8-ff2d-4b09-9b04-637fd5374b3d",
                                "sense_id": "e65279f8-a129-31b7-84e3-c3b71e156b60",
                                "text": "Zelfs de meest onschuldige huisdieren kunnen al risicovol zijn voor ouderen, zegt Byard. ,,Katten zijn bijvoorbeeld een veelvoorkomend struikelgevaar in huis voor ouderen. Iets waar ze misschien niet zo snel aan denken. Katten wrijven graag tegen enkels en benen, zitten graag achter mensen en leiden daardoor vaak tot struikelletsel.’’"
                            }
                        ]
