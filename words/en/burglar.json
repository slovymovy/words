{
    "word_family": [
        "burgle",
        "burglary",
        "burglarize",
        "burglarproof"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                    "sense_definition": "A person who breaks into a building or house illegally in order to steal something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "criminal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>burglar</w> made off with a large diamond from the museum.",
                            "target_lang_translations": {
                                "ru": "<w>Взломщик</w> скрылся с крупным бриллиантом из музея."
                            }
                        },
                        {
                            "text": "The police managed to catch the <w>burglar</w> before he could escape through the window.",
                            "target_lang_translations": {
                                "ru": "Полиции удалось поймать <w>грабителя</w> прежде, чем он успел скрыться через окно."
                            }
                        }
                    ],
                    "synonyms": [
                        "housebreaker",
                        "burglarizer"
                    ],
                    "common_phrases": [
                        "convicted burglar",
                        "armed burglar",
                        "catch a burglar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который незаконно проникает в здание или дом со взломом, чтобы совершить кражу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взломщик",
                                "target_lang_sense_clarification": "вор, совершающий взлом дверей или сейфов"
                            },
                            {
                                "target_lang_word": "домушник",
                                "target_lang_sense_clarification": "вор, специализирующийся на квартирных кражах"
                            },
                            {
                                "target_lang_word": "грабитель",
                                "target_lang_sense_clarification": "общий термин для того, кто совершает кражу или ограбление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "363a85b6-6ebb-3d7e-8dc9-18be66b053f4",
                    "sense_definition": "To commit the crime of burglary by breaking into a place to steal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "criminal activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang planned to <w>burglar</w> the warehouse during the holiday weekend.",
                            "target_lang_translations": {
                                "ru": "Банда планировала <w>обворовать</w> склад во время праздничных выходных."
                            }
                        },
                        {
                            "text": "He was arrested for attempting to <w>burglar</w> several homes in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Он был арестован за попытку <w>совершить кражу со взломом</w> в нескольких домах по соседству."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often replaced by 'burgle' or 'burglarize' in standard usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершить кражу со взломом, незаконно проникнув в помещение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обворовать",
                                "target_lang_sense_clarification": "совершить кражу из помещения"
                            },
                            {
                                "target_lang_word": "совершить кражу со взломом",
                                "target_lang_sense_clarification": "официальный юридический термин"
                            },
                            {
                                "target_lang_word": "взломать",
                                "target_lang_sense_clarification": "проникнуть внутрь, повредив замки или двери"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}