                        "examples": [
                            {
                                "example_id": "0bb8eeda-4d99-4e55-8b92-ce13048b58ff",
                                "sense_id": "7558754c-4cb2-3e27-9f9e-9f72f1ba360c",
                                "text": "„Maartje is een moordvrouw\", vindt hij. „Eén uit duizenden\"."
                            },
                            {
                                "example_id": "e8d8d8c8-03c7-42f4-9931-07220df26c3a",
                                "sense_id": "7558754c-4cb2-3e27-9f9e-9f72f1ba360c",
                                "text": "Zou toch aardig zijn, niet om mij, maar om jullie in bikini in de modder te zien. Twee moordvrouwen bij elkaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "39557f68-936c-3037-a914-9ca08dbe0fce",
                        "entry_id": "2940a46e-91ab-3f1d-bac7-1e058aa44662",
                        "glosses": [
                            "vrouwelijke moordenaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da8f303-bfd7-481e-8735-f7799ee96d02",
                                "sense_id": "39557f68-936c-3037-a914-9ca08dbe0fce",
                                "text": "Vrouwen moorden minder vaak dan mannen, maar ze hebben meestal een beter verhaal. Over hoe je iemand per ongeluk door zijn hart kunt steken, over een moord als verzetsdaad na de oorlog, of over de baby die verdween door hem op de vijlbank van de vader te leggen. Altijd al willen weten hoe het brein van een moordvrouw werkt en hoe je op het spoor komt van deze vrouwen?"
                            }
                        ]
                    }
