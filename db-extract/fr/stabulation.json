                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd5a2c4-1c23-493c-960c-45948cb6e577",
                                                "sense_id": "8acc4fb6-2ef3-3e03-a744-da122925fc99",
                                                "text": "But hire us some fair chamber for the night, / And stalling for the horses, and return / With victual for these men, and let us know."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e03cee81-c507-4bac-b0ba-e74056885a85",
                        "source_entry_id": "04561a0f-b988-33bb-ba8d-01ae73c46428",
