                "senses": [
                    {
                        "sense_id": "7c137d1e-0ff6-3e5d-9a7d-49f9e212949d",
                        "entry_id": "b6edb0df-5394-3ea0-a3b7-6a611acdd4d2",
                        "glosses": [
                            "A puppet, usually made of wood, which is animated by the pulling of strings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249e3087-72a5-4974-a91c-49c4d5539fdc",
                                "sense_id": "7c137d1e-0ff6-3e5d-9a7d-49f9e212949d",
                                "text": "If you think we are worked by strings,\nLike a Japanese marionette,\nYou don't understand these things:\nIt is simply Court etiquette."
                            }
                        ]
                    },
                    {
                        "sense_id": "1379019c-dc09-32c3-baea-5e0c541aa8f3",
