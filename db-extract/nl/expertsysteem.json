                                    {
                                        "sense_id": "74551d0d-5cb0-33e7-b130-d40a3b267389",
                                        "entry_id": "074ba26b-aca5-354f-b1f6-855d04c80c38",
                                        "glosses": [
                                            "A type of artificially intelligent software system that stores expertise concerning some subject matter in a knowledge base and attempts to answer questions or solve problems in a manner which simulates the thought processes of a human expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285a1017-0674-4952-b96a-60e62c60bee4",
                                                "sense_id": "74551d0d-5cb0-33e7-b130-d40a3b267389",
                                                "text": "“For each different kind of problem,” said Minsky, “the construction of expert systems had to start all over again, because they didn't accumulate common-sense knowledge.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa29bedf-75b3-493c-a79f-912e05242134",
                        "source_entry_id": "547dc529-6767-3ce3-b332-5abcaed8aa39",
                        "source_sense_id": "1c450a92-e653-3c38-b73b-74774e252896",
                        "source_sense_description": "een computersysteem dat specifieke kennis van menselijke experts representeert en gebruikt om een probleem binnen een bepaald gebied op te lossen",
                        "target_lang_word": "système expert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "système expert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb97879-b83a-3d66-9bdc-e2a7c6e3e208",
                                        "entry_id": "14feacd0-aff4-3295-84e0-d200a7fb1dea",
                                        "glosses": [
                                            "Ensemble de logiciels exploitant dans un domaine particulier des connaissances explicites et organisées, pouvant se substituer à un expert humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd94552-467f-4564-af70-5ab26de45a26",
                                                "sense_id": "3bb97879-b83a-3d66-9bdc-e2a7c6e3e208",
                                                "text": "Ces systèmes experts seront des monstres de puissance et d'intelligence : chacun coûtera des milliards de dollars et s’autoaméliorera par l'analyse des millions de dossiers de patients qu'il monitorera."
                                            },
                                            {
                                                "example_id": "1fafc7f3-1aa3-4db0-a4d6-98fac7806810",
                                                "sense_id": "3bb97879-b83a-3d66-9bdc-e2a7c6e3e208",
                                                "text": "L’un de nos projets s’intitulait « bateau sans médecin ». Il consistait à développer ce qui fut appelé par la suite un « système expert » et qui avait pour objectif de donner des conseils en cas de problèmes médicaux en l’absence d’un médecin."
                                            },
                                            {
                                                "example_id": "42f13cba-8b3f-4f0b-a0bf-3d617468be12",
                                                "sense_id": "3bb97879-b83a-3d66-9bdc-e2a7c6e3e208",
                                                "text": "Mais quelle sera la place ou l’implication de l’IPADE dans tout cet univers virtuel, de téléconsultation, télésoins ou même de systèmes experts basés sur l’intelligence artificielle (IA) ?"
                                            }
                                        ]
                                    }
