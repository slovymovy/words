                        "examples": [
                            {
                                "example_id": "acffc8fb-b7b2-4060-9138-d93f1518f3fe",
                                "sense_id": "e2032b67-9519-3bfe-9e7e-a17b9e1dbeaf",
                                "text": "Être sensible à la gloriole."
                            },
                            {
                                "example_id": "7c44209f-5266-4124-8ce9-a15740fafa8f",
                                "sense_id": "e2032b67-9519-3bfe-9e7e-a17b9e1dbeaf",
                                "text": "Sa gloriole d’auteur ne fut pas satisfaite d’un éloge aussi modéré."
                            }
                        ]
                    }
