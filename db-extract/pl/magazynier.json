                        "translation_id": "e7fd3105-c107-4eb9-92a0-37fb790fc08e",
                        "source_entry_id": "c0a4981b-73a4-3e3c-b907-b9fd4c5fff2e",
                        "source_sense_id": "31b5c631-b75d-3cfb-85ed-c94ff89b24d7",
                        "target_lang_word": "warehouseman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warehouseman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26294987-de6e-316f-acc3-28a490d9adaf",
                                        "entry_id": "84659d98-5008-329f-a373-5c915ec7a6fb",
                                        "glosses": [
                                            "A person who manages, or works in, a warehouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d38b8e3a-cfd3-437c-92b7-d14176e92220",
                                                "sense_id": "26294987-de6e-316f-acc3-28a490d9adaf",
                                                "text": "But the itinerant tradesman or street-seller is still further distinguished from the regular fixed dealer—the stallkeeper from the shopkeeper—the street-wareman from the warehouseman, by the arts they respectively employ to attract custom."
                                            },
                                            {
                                                "example_id": "96c8242f-6b0e-44ff-aa9c-09788756d2f7",
                                                "sense_id": "26294987-de6e-316f-acc3-28a490d9adaf",
                                                "text": "If a recount of an item is ordered, the warehouseman responsible for the custody of the stock accompanies and assists the rechecker to assure himself that the exact quantity of stock recorded as on hand is actually physically present."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8159b893-6834-38b9-90e8-355c26d74f9a",
                                        "entry_id": "84659d98-5008-329f-a373-5c915ec7a6fb",
                                        "glosses": [
                                            "One who keeps a wholesale shop for woollen goods."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
