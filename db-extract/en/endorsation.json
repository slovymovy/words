                        "examples": [
                            {
                                "example_id": "0bb6eabe-23b0-4688-9b3b-13c038a44f1f",
                                "sense_id": "37252024-c0f7-3376-a1ee-61a99e8e53e9",
                                "text": "Every Endorsation of the examination of any permit shall be made on the back thereof, and every permit shall be defaced by writing the word \" Cancelled \" across the face of it on the expiration of the period for which it has been granted."
                            },
                            {
                                "example_id": "7ba4dd99-7aa3-42d5-b64f-446df062ba8a",
                                "sense_id": "37252024-c0f7-3376-a1ee-61a99e8e53e9",
                                "text": "As an alumnus of the University of Virginia, a gallant Confederate soldier, and since the war a devoted, useful minister of the gospel, Mr. Nelson is widely known and needs no endorsation from us."
                            },
                            {
                                "example_id": "9610ab50-1a22-49f5-ae9d-a3e5560afa9c",
                                "sense_id": "37252024-c0f7-3376-a1ee-61a99e8e53e9",
                                "text": "The following article which gives an able and reliable account of the invention has my entire endorsation."
                            },
                            {
                                "example_id": "011dde8d-70e4-441e-9090-8e7e115f5d49",
                                "sense_id": "37252024-c0f7-3376-a1ee-61a99e8e53e9",
                                "text": "The only peculiarities of deposit-receipts consist in the consideration of how far endorsation of the deposit-receipt is equivalent to the money alleged to be donated."
                            },
                            {
                                "example_id": "eeb4695d-42b6-48fb-8a15-b3ac69650dc8",
                                "sense_id": "37252024-c0f7-3376-a1ee-61a99e8e53e9",
                                "text": "Endorsation of the policy followed is a matter to be determined by the Executive"
                            }
