                ],
                "senses": [
                    {
                        "sense_id": "ab6a883a-15e6-34d5-a2d8-1a9407c04623",
                        "entry_id": "035b7776-5252-3291-8e6c-c5f432c20226",
                        "glosses": [
                            "Verbund gleichartiger Zellen (Gewebe), die die Bronchien ausmachen und der Atmung in der Lunge dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5204ab52-3006-4586-b1e8-05bb0314f829",
                                "sense_id": "ab6a883a-15e6-34d5-a2d8-1a9407c04623",
                                "text": "„Die durch Allergene oder endogene Antigene ausgelösten entzündlichen Prozesse innerhalb des Bronchialgewebes führen zum Asthma bronchiale mit charakteristischen histopathologischen Veränderungen des Bronchialgewebes.“"
                            },
                            {
                                "example_id": "bc6c9af1-22cd-4341-b02d-30132ef819ec",
                                "sense_id": "ab6a883a-15e6-34d5-a2d8-1a9407c04623",
                                "text": "„Der Husten ist normalerweise eine alltägliche Erkrankung des Bronchialgewebes und deutet auf eine Störung in den Atemwegen hin.“"
                            },
                            {
                                "example_id": "94403183-a246-4393-b609-62d0d022a9cd",
                                "sense_id": "ab6a883a-15e6-34d5-a2d8-1a9407c04623",
                                "text": "„Das angegriffene Bronchialgewebe produziert verstärkt Schleim, der die hauchdünnen Verästelungen verstopft. Folge: Husten.“"
                            },
                            {
                                "example_id": "701f37d6-7809-4c5e-9bc0-4d1433be957d",
                                "sense_id": "ab6a883a-15e6-34d5-a2d8-1a9407c04623",
                                "text": "„Die bakterielle Infektion als Folge der Entzündung kann beim Abheilen vereinzelte Infektionsherde und abgekapselte nekrotische Stellen in der Lunge und den Bronchialgeweben hinterlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
