                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429fa452-8c41-462c-90c8-de95bd530f63",
                                                "sense_id": "f3ee4426-a289-380f-ad7a-f16dc36b0c61",
                                                "text": "Other costs associated with selling a home include surveyor's fees, legal fees, estate agent's commission, stamp duty and the VAT."
                                            }
