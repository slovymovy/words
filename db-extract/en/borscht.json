                                        "entry_id": "6c6b3bb5-f86c-3351-b694-ff7faf3b834b",
                                        "glosses": [
                                            "reichhaltige Gemüsesuppe aus Roter Bete mit Fleisch, die in Mittel- und Osteuropa sehr verbreitet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1a194a-b742-452d-8732-a3642b3f68fe",
                                                "sense_id": "1128df83-0423-314b-a688-f5e25cea7451",
                                                "text": "Die Zusammensetzung von Borschtsch ist regional unterschiedlich, fast immer gehören jedoch Fleisch, Rote Bete und Weißkohl dazu."
                                            },
                                            {
                                                "example_id": "05a16e41-603c-40eb-984d-dbdddf014f77",
                                                "sense_id": "1128df83-0423-314b-a688-f5e25cea7451",
                                                "text": "„Er brachte mir Brot, Speck und in Wodkaflaschen abgefüllten Borschtsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
