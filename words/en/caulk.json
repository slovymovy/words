        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3103378-f434-31b6-b698-ceb971572825",
                    "sense_definition": "To seal joints or cracks with a flexible material to prevent leaks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>caulk</w> the gaps around the windows to keep the cold air out.",
                            "target_lang_translations": {
                                "tr": "Soğuk havayı dışarıda tutmak için pencerelerin etrafındaki boşluklara <w>kalafat çekmelisin</w>."
                            }
                        },
                        {
                            "text": "The plumber had to <w>caulk</w> the area around the bathtub to stop water from leaking.",
                            "target_lang_translations": {
                                "tr": "Tesisatçı, su sızmasını durdurmak için küvetin etrafındaki bölgeye <w>kalafat çekmek</w> zorunda kaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "seal",
                        "fill"
                    ],
                    "common_phrases": [
                        "caulk the windows",
                        "caulk the tub"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sızıntıyı önlemek için ek yerlerini veya çatlakları esnek bir malzemeyle kapatmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kalafat çekmek",
