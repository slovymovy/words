                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>staart</w> al minutenlang uit het raam zonder iets te zeggen.",
                            "target_lang_translations": {
                                "en": "He has been <w>staring</w> out the window for minutes without saying anything."
                            }
                        },
                        {
                            "text": "Waarom <w>staart</w> zij zo vreemd naar die onbekende man?",
                            "target_lang_translations": {
                                "en": "Why is she <w>staring</w> so strangely at that unknown man?"
                            }
                        }
