                "senses": [
                    {
                        "sense_id": "aa1ca878-3b83-3799-a641-d7c3c5e10738",
                        "entry_id": "f02b726e-7060-3015-bdcc-f0de502bde1e",
                        "glosses": [
                            "A practitioner of hermeneutics: someone who interprets a text, especially a holy text."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0034a182-7549-4a39-bd41-44976dd8e67f",
                                "sense_id": "aa1ca878-3b83-3799-a641-d7c3c5e10738",
                                "text": "Moses, full of sacrificial institutes, is the text, Isaiah and all the prophets are the hermeneuts[…]."
                            },
                            {
                                "example_id": "75325c2b-e76b-46bf-9241-30e036ea1a4e",
                                "sense_id": "aa1ca878-3b83-3799-a641-d7c3c5e10738",
                                "text": "He was a hermeneut who worked out striking interpretations of texts."
                            }
                        ]
                    },
                    {
                        "sense_id": "908ecba5-9918-3abc-9a08-e6138854c01f",
                        "entry_id": "f02b726e-7060-3015-bdcc-f0de502bde1e",
                        "glosses": [
                            "An interpreter of culture, experience, etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "10fcce2f-bf4f-4903-82a9-ac9140780dc5",
                                "sense_id": "908ecba5-9918-3abc-9a08-e6138854c01f",
                                "text": "Oh, an ardent hermeneut might try to distinguish his or her own experience as more intensively \"pop\" than that of less authentic metaconsumers passing through Coke's world."
                            },
                            {
                                "example_id": "c42dccba-5ebc-4678-b153-ce3b9f3c86e7",
                                "sense_id": "908ecba5-9918-3abc-9a08-e6138854c01f",
                                "text": "In short, Hillman is not a hermeneut but an imagist, or phenomenologist, who sticks to the image, adheres to the phenomenon, and adamantly refuses to interpret it, or reduce it to a concept."
                            }
                        ]
                    }
                ],
