                    "target_lang_definitions": {
                        "ru": "Государственная или военная награда в форме креста.",
                        "en": "A state or military decoration in the shape of a cross."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крест",
                                "target_lang_sense_clarification": "награда"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Cross",
                                "target_lang_sense_clarification": "military or state decoration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ec4add8-f0bb-3275-8b1b-2f277267b312",
                    "sense_definition": "Starożytne narzędzie kary śmierci, na którym wieszano skazańców.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W czasach rzymskich wielu niewolników zginęło na <w>krzyżu</w>.",
                            "target_lang_translations": {
                                "ru": "В римские времена многие рабы погибли на <w>кресте</w>.",
                                "en": "In Roman times, many slaves died on the <w>cross</w>."
                            }
                        },
                        {
                            "text": "Skazaniec musiał sam nieść swój <w>krzyż</w> na miejsce egzekucji.",
                            "target_lang_translations": {
                                "ru": "Осуждённый должен был сам нести свой <w>крест</w> на место казни.",
                                "en": "The convict had to carry his own <w>cross</w> to the place of execution."
                            }
                        }
                    ],
                    "common_phrases": [
                        "śmierć na krzyżu"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древнее орудие смертной казни, на котором распинали осуждённых.",
                        "en": "An ancient instrument of capital punishment upon which condemned criminals were crucified."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крест",
                                "target_lang_sense_clarification": "орудие казни"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "instrument of execution"
                            }
                        ]
                    }
                }
