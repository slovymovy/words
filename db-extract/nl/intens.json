                        "form": "intensers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6888ffde-945e-319f-a337-d572238e5697",
                        "entry_id": "16557df8-fc99-310c-a5e0-93228cb79c46",
                        "glosses": [
                            "zeer krachtig, hevig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "802cc7e2-e46e-4db4-9b87-a3423757660a",
                                "sense_id": "6888ffde-945e-319f-a337-d572238e5697",
                                "text": "Mijn onzekerheid werd steeds intenser en instinctief had ik nog maar één behoefte: vluchten, weg uit de bergen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5796d282-f2dd-42ab-bfcb-093e4709ac11",
                        "source_entry_id": "16557df8-fc99-310c-a5e0-93228cb79c46",
                        "source_sense_id": "6888ffde-945e-319f-a337-d572238e5697",
                        "source_sense_description": "zeer krachtig, hevig",
                        "target_lang_word": "intense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf37e0b6-da86-38ba-8149-ffd6a727915a",
                                        "entry_id": "91d92dac-f581-3ec5-b0b9-7785cf440d45",
                                        "glosses": [
                                            "Of a characteristic: extreme or very high or strong in degree; severe; also, excessive, towering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c6f6a9-0ed3-429e-b5f3-f259f2c7c2bd",
                                                "sense_id": "cf37e0b6-da86-38ba-8149-ffd6a727915a",
                                                "text": "Nor was I yet able to passe through any of the narrower streets, but kept the widest; the ground and air, smoake and fiery vapour, continu'd so intense that my haire was almost sing'd, and my feete unsufferably surbated."
                                            },
                                            {
                                                "example_id": "8cd3fba4-279f-41f0-ab38-f6e7775223bd",
                                                "sense_id": "cf37e0b6-da86-38ba-8149-ffd6a727915a",
                                                "text": "[…] Nature had a robe of glory on, / And the bright air o'er every shape did weave / Intenser hues, so that the herbless stone, / The leafless bough among the leaves alone, / Had being clearer than its own could be, […]"
                                            },
                                            {
                                                "example_id": "1bbf2eb8-f581-465e-b1fe-b0a01469579c",
                                                "sense_id": "cf37e0b6-da86-38ba-8149-ffd6a727915a",
                                                "text": "[…] Pietro di Medici then gave, at the period of one great epoch of consummate power in the arts, the perfect, accurate, and intensest possible type of the greatest error which nations and princes can commit, respecting the power of genius entrusted to their guidance."
                                            },
                                            {
                                                "example_id": "fb74d071-2715-4812-a846-bb01f1cc8980",
                                                "sense_id": "cf37e0b6-da86-38ba-8149-ffd6a727915a",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "451a1a76-d299-3371-9bbc-e2aaa0f43a1e",
                                        "entry_id": "91d92dac-f581-3ec5-b0b9-7785cf440d45",
                                        "glosses": [
                                            "Of a thing: possessing some characteristic to an extreme or very high or strong degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e3d194-8591-4445-afce-376cb84abd8d",
                                                "sense_id": "451a1a76-d299-3371-9bbc-e2aaa0f43a1e",
                                                "text": "[T]h' intense atom glows / A moment, then is quenched in a most cold repose."
                                            },
                                            {
                                                "example_id": "e42f3411-c947-4b0e-b655-c10940185304",
                                                "sense_id": "451a1a76-d299-3371-9bbc-e2aaa0f43a1e",
                                                "text": "These pendent lamps and chandeliers are bright / As earthly fires from dull dross can be cleansed; / Yet could my eyes drink up intenser beams / Undazzled—this is darkness—when I close / These lids, i see far fiercer brilliances,— […]"
                                            },
                                            {
                                                "example_id": "4cd3cd33-9797-4006-b9e4-9a09b8ea2760",
                                                "sense_id": "451a1a76-d299-3371-9bbc-e2aaa0f43a1e",
                                                "text": "As the night came on the yellow stars grew more intense overhead, but the lambent glow in the north did not pale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                        "entry_id": "91d92dac-f581-3ec5-b0b9-7785cf440d45",
                                        "glosses": [
                                            "Of feelings, thoughts, etc.: strongly focused; ardent, deep, earnest, passionate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da596fe-2e2f-4eee-922f-d6eef21c6a73",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "intense study"
                                            },
                                            {
                                                "example_id": "6395eee2-40cd-4dd2-9603-cc19c02d7795",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "intense thought"
                                            },
                                            {
                                                "example_id": "58dc5e20-d3cb-413e-8998-d0dd2190f352",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "No mortall nature can endure either in the actions of Religion, or ſtudy of VViſdome, vvithout ſometime ſlackning the cords of intenſe thought and labour: […]"
                                            },
                                            {
                                                "example_id": "18013370-3afc-4dbb-b1f0-1714cd1cbc4b",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "VVe found the Elector intenſe upon the ſtrengthening of his Army, […]"
                                            },
                                            {
                                                "example_id": "1a021dce-9d8e-4283-acf0-83637ebb55b5",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "The ceremony began vvith the exhortation of the Father-Abbot, delivered vvith ſolemn energy; then the novice kneeling before him, made her profeſſion, for vvhich Vivaldi liſtened vvith intenſe attention, but it vvas delivered in ſuch lovv and trembling accents, that he could not aſcertain even the tone."
                                            },
                                            {
                                                "example_id": "17829fde-992e-4f91-b867-7157dd2b5950",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "I rose by candle-light, and consumed, in the intensest application, the hours which every other individual of our party wasted in enervating slumbers, from the hesternal dissipation or debauch."
                                            },
                                            {
                                                "example_id": "46d9c7a5-6670-4ab9-ab86-72119392fdb8",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "That intense patriotism which is peculiar to the members of societies congregated within a narrow space was, in such circumstances, strongly developed."
                                            },
                                            {
                                                "example_id": "329ff330-3019-4fc9-be1d-1d4ce7592fd4",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "[H]er voice gave intensest passion and longing to the words; […]"
                                            },
                                            {
                                                "example_id": "3904e308-e916-4f39-8c3a-d701787b8703",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "Of all the questions which, throughout the centuries, have escaped from the lips of man, there is none which has been asked with such persistence, none which has possessed interest more perennial, than \"Whence do I come? Whither shall I go?\" Man's origin, man's hereafter, have ever been of intensest interest to man."
                                            },
                                            {
                                                "example_id": "9240dbff-2fc0-45b8-ac38-b250317b767a",
                                                "sense_id": "cd5fe951-f8e7-36e8-a5a5-18ca13fdbf42",
                                                "text": "And the strange sensation became still stranger within her, intenser in its two constituent parts: intenser in pride, intenser in compassionate love—that of a mistress and a mother in one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e7fbf0a-3e78-3f65-84a5-a9e56aeb5724",
                                        "entry_id": "91d92dac-f581-3ec5-b0b9-7785cf440d45",
                                        "glosses": [
                                            "Of a person: very emotional or passionate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47c1d84-34f3-4664-a4c9-271be12eb4f5",
                                                "sense_id": "5e7fbf0a-3e78-3f65-84a5-a9e56aeb5724",
                                                "text": "The artist was a small, intense man with piercing blue eyes."
                                            },
                                            {
                                                "example_id": "8577713f-52a0-46bf-a714-d7d42c5f7fda",
                                                "sense_id": "5e7fbf0a-3e78-3f65-84a5-a9e56aeb5724",
                                                "text": "Fair Æsthetic (suddenly, and in deepest tones, to Smith, who has just been introduced to take her in to Dinner). \"Are you Intense?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01df5cb-096f-38c1-9082-340508e502b6",
                                        "entry_id": "91d92dac-f581-3ec5-b0b9-7785cf440d45",
                                        "glosses": [
                                            "Under tension; tightly drawn; strained, stressed, tense."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
