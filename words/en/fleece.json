{
    "word_family": [
        "fleecy",
        "fleecer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a3e6a0d7-0e41-30f4-b994-24cbc9e1fc22",
                    "sense_definition": "A warm, soft jacket or top made from a synthetic wool-like fabric.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is getting quite cold outside, so you should probably wear a <w>fleece</w> under your coat.",
                            "target_lang_translations": {
                                "ru": "На улице становится довольно холодно, так что тебе, вероятно, стоит надеть <w>флиску</w> под пальто."
                            }
                        },
                        {
                            "text": "She bought a new <w>blue</w> <w>fleece</w> to keep her warm during the morning hike.",
                            "target_lang_translations": {
                                "ru": "Она купила новую <w>синюю</w> <w>флисовую кофту</w>, чтобы не замерзнуть во время утреннего похода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blue fleece",
                        "warm fleece",
                        "zip-up fleece"
                    ],
                    "target_lang_definitions": {
                        "ru": "Теплая мягкая куртка или кофта из синтетической ткани, напоминающей шерсть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флиска",
                                "target_lang_sense_clarification": "разговорное название одежды"
                            },
                            {
                                "target_lang_word": "флисовая кофта",
                                "target_lang_sense_clarification": "предмет одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2119a4c-7a84-3713-96d3-58f4b9910466",
                    "sense_definition": "The woolly coat of a sheep or similar animal, especially when shorn off in one piece.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_products",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer carefully removed the <w>thick</w> <w>fleece</w> from the sheep during the spring shearing.",
                            "target_lang_translations": {
                                "ru": "Фермер аккуратно снял <w>густое</w> <w>руно</w> с овцы во время весенней стрижки."
                            }
                        },
                        {
                            "text": "After the harvest, the raw <w>fleece</w> was cleaned and prepared for spinning into yarn.",
                            "target_lang_translations": {
                                "ru": "После сбора необработанную <w>шерсть</w> очистили и подготовили для прядения пряжи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thick fleece",
                        "sheep fleece",
                        "raw fleece"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шерстяной покров овцы или подобного животного, особенно состриженный целиком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руно",
                                "target_lang_sense_clarification": "овечья шерсть, состриженная одним пластом"
                            },
                            {
                                "target_lang_word": "шерсть",
                                "target_lang_sense_clarification": "волосяной покров животного"
                            },
                            {
                                "target_lang_word": "овчина",
                                "target_lang_sense_clarification": "выделанная шкура овцы с шерстью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da2265d-bc0c-39dd-bbf6-a1dd5a2e4f74",
                    "sense_definition": "A soft, warm fabric with a textured surface, often used for linings or sportswear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This jacket has a <w>fleece</w> <w>lining</w> that makes it very comfortable in winter.",
                            "target_lang_translations": {
                                "ru": "У этой куртки <w>флисовая</w> <w>подкладка</w>, что делает её очень удобной зимой."
                            }
                        },
                        {
                            "text": "The designer chose a high-quality <w>fleece</w> for the new line of athletic sweatshirts.",
                            "target_lang_translations": {
                                "ru": "Дизайнер выбрал высококачественный <w>флис</w> для новой линии спортивных толстовок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fleece lining",
                        "polyester fleece",
                        "soft fleece"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая теплая ткань с ворсистой поверхностью, часто используемая для подкладки или спортивной одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флис",
                                "target_lang_sense_clarification": "синтетический материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "460ec2bf-e9dd-36ce-a3af-d1f5b71e1412",
                    "sense_definition": "Any soft, white, or woolly covering that looks like a sheep's coat, such as clouds or snow.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain peaks were covered in a <w>white</w> <w>fleece</w> of fresh snow after the storm.",
                            "target_lang_translations": {
                                "ru": "Горные вершины были покрыты <w>белым</w> <w>покровом</w> свежего снега после шторма."
                            }
                        },
                        {
                            "text": "The sky was filled with a <w>fleece</w> of small white clouds drifting slowly eastward.",
                            "target_lang_translations": {
                                "ru": "Небо было заполнено <w>барашками</w> маленьких белых облаков, медленно дрейфующих на восток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "white fleece"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically in literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое мягкое, белое или пушистое покрытие, напоминающее овечью шерсть (например, облака или снег)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покров",
                                "target_lang_sense_clarification": "о снеге или облаках"
                            },
                            {
                                "target_lang_word": "барашки",
                                "target_lang_sense_clarification": "об облаках"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d3bb49c-d89b-32fb-a788-d3257e53e330",
                    "sense_definition": "To shear or cut the wool from a sheep or other animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "farming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes a skilled worker to <w>fleece</w> a sheep quickly without hurting the animal.",
                            "target_lang_translations": {
                                "ru": "Нужен опытный работник, чтобы быстро <w>остричь</w> овцу, не поранив животное."
                            }
                        },
                        {
                            "text": "The farmers gather every year in April to <w>fleece</w> the entire flock.",
                            "target_lang_translations": {
                                "ru": "Фермеры собираются каждый год в апреле, чтобы <w>стричь</w> всё стадо."
                            }
                        }
                    ],
                    "synonyms": [
                        "shear#Verb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стричь шерсть с овцы или другого животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стричь",
                                "target_lang_sense_clarification": "снимать шерсть с животного"
                            },
                            {
                                "target_lang_word": "остригать",
                                "target_lang_sense_clarification": "удалять шерсть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53f21f36-621f-3a0b-96be-0f568f8b8ac4",
                    "sense_definition": "To overcharge or swindle someone out of their money.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishonest mechanic tried to <w>fleece</w> the tourists by charging double for simple repairs.",
                            "target_lang_translations": {
                                "ru": "Нечестный механик пытался <w>ободрать</w> туристов, запрашивая двойную цену за простой ремонт."
                            }
                        },
                        {
                            "text": "Many investors were <w>fleeced</w> by the fraudulent scheme that promised impossible returns.",
                            "target_lang_translations": {
                                "ru": "Многие инвесторы были <w>обораны до нитки</w> мошеннической схемой, обещавшей невозможную прибыль."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fleece the public",
                        "fleece customers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used to describe being ripped off"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обсчитывать или выманивать деньги у кого-либо обманным путем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдирать",
                                "target_lang_sense_clarification": "брать непомерно высокую цену"
                            },
                            {
                                "target_lang_word": "обобрать как липку",
                                "target_lang_sense_clarification": "ограбить или обмануть полностью"
                            },
                            {
                                "target_lang_word": "нагреть",
                                "target_lang_sense_clarification": "обмануть на деньги"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}