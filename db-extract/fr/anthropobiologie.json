                    {
                        "sense_id": "2e554660-5953-3371-a21f-1eeed688c6a7",
                        "entry_id": "fecd0b95-f8c1-3ae6-872f-734788aaa01d",
                        "glosses": [
                            "Étude de l’espèce humaine dans ses aspects biologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad807a12-1125-4e44-b456-e4c12ac455fd",
                                "sense_id": "2e554660-5953-3371-a21f-1eeed688c6a7",
                                "text": "La science qui analyse les ossements humains (l’anthropobiologie) témoigne ici d’un groupe pluriel et d’un continuel mouvement socio-économique de ces dominants, ce qu’avaient déjà constaté de leur côté les historiens et les archéologues, qui parlent désormais des élites et des noblesses au pluriel."
                            },
                            {
                                "example_id": "b51b8b85-d702-4fb7-95bc-28965bb84e3b",
                                "sense_id": "2e554660-5953-3371-a21f-1eeed688c6a7",
                                "text": "L’anthropobiologie ou anthropologie biologique a pour objet l’étude de l’espèce humaine, de son origine, de son évolution et de sa diversité."
                            }
                        ]
                    }
                ],
