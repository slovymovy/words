                "senses": [
                    {
                        "sense_id": "90bdf971-8a42-3de0-a70e-4a88a3878432",
                        "entry_id": "5a397e1b-e70f-3148-9dd3-dbe566162e6a",
                        "glosses": [
                            "Kräfteverteilung, Machtverhältnisse, Einfluss: Übergewicht (z. B. eines Staates im geopolitischen Machtgefüge), Übermacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d10cbc-7784-4680-89cc-aa3833fd5a24",
                                "sense_id": "90bdf971-8a42-3de0-a70e-4a88a3878432",
                                "text": "„In der näheren Zukunft wird vermutlich die amerikanische Präponderanz auf den globalen Kapital- und Geldmärkten anhalten.“"
                            },
                            {
                                "example_id": "1e588b9b-09f6-4d78-9ca4-7934f5aa2aa4",
                                "sense_id": "90bdf971-8a42-3de0-a70e-4a88a3878432",
                                "text": "„Wenn sich die stille Hoffnung der Franzosen und vielleicht auch anderer Handelsstaaten am Mittelmeer daran geknüpft hat, der englischen Präponderanz in Süd- und Ostasien einen tödtlichen Schlag beigebracht zu haben, so ist sie nicht in Erfüllung gegangen.“"
                            },
                            {
                                "example_id": "514a8b98-2c20-4677-9af2-3588a1cd6cc1",
                                "sense_id": "90bdf971-8a42-3de0-a70e-4a88a3878432",
                                "text": "„In einer freiheitlichen Verfassung verbürgen die Grundrechtsnormen somit eine Präponderanz der Freiheitsrechte: Beschränkungen der individuellen Freiheit und Einflußnahmen auf den Freiheitsgebrauch sind nicht von vornherein unzulässig, aber aus verfassungsrechtlicher Sicht in besonderer Weise rechtfertigungsbedürftig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bdbdbed-5e4c-4490-94a6-5c6d581825a2",
                        "source_entry_id": "5a397e1b-e70f-3148-9dd3-dbe566162e6a",
                        "source_sense_id": "90bdf971-8a42-3de0-a70e-4a88a3878432",
                        "target_lang_word": "preponderance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preponderance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9eb5e506-d0b1-3936-9beb-a2827460549e",
                                        "entry_id": "822807a0-e50e-39b2-a0ef-0bc019e6b0ae",
                                        "glosses": [
                                            "Superiority in amount or number; the bulk or majority; also, a large amount or number; an abundance, a profusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e38a4bb-4f74-4459-b8de-9bffb77e845b",
                                                "sense_id": "9eb5e506-d0b1-3936-9beb-a2827460549e",
                                                "text": "[S]trong proofs are at hand to shew, that in the Irish people there is a large admixture, if not an overwhelming praeponderance, of Iberian elements."
                                            },
                                            {
                                                "example_id": "72e884a2-1f49-4166-a317-5ac0e51f2d29",
                                                "sense_id": "9eb5e506-d0b1-3936-9beb-a2827460549e",
                                                "text": "Is there a preponderance of female protagonists in commercial fiction, and if so, what does it mean?"
                                            },
                                            {
                                                "example_id": "885539c5-3801-4a3a-bcf0-0c2ed97af8e5",
                                                "sense_id": "9eb5e506-d0b1-3936-9beb-a2827460549e",
                                                "text": "Subtle, institutional discrimination was evident in the preponderance of blacks and underprivileged whites fighting the war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1df83802-9e6b-3de9-9790-807311168d30",
                                        "entry_id": "822807a0-e50e-39b2-a0ef-0bc019e6b0ae",
                                        "glosses": [
                                            "Superiority of influence, power, a quality, etc.; an outweighing, predominance, pre-eminence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aab93ee-4ee9-48ea-bad9-b15f66d11051",
                                                "sense_id": "1df83802-9e6b-3de9-9790-807311168d30",
                                                "text": "In a few weeks he [William III of England] had changed the relative position of all the states in Europe, and had restored the equilibrium which the preponderance of one power had destroyed."
                                            },
                                            {
                                                "example_id": "df52fc97-dd11-4d04-b0a7-74b608dde5d1",
                                                "sense_id": "1df83802-9e6b-3de9-9790-807311168d30",
                                                "text": "But even less disgruntled observers have insisted that pain and unpleasure are more common in dreams than pleasure: for instance, Scholz (1893, 57), Volkelt (1875, 80), and others. Indeed two ladies, Florence Hallam and Sarah Weed (1896, 499), have actually given statistical expression, based on a study of their own dreams, to the preponderance of unpleasure in dreaming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489b3323-585e-34f4-b90b-a781a90bf6b4",
                                        "entry_id": "822807a0-e50e-39b2-a0ef-0bc019e6b0ae",
                                        "glosses": [
                                            "Greater physical weight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12615fed-e5e7-3e9a-9dcd-61b8d8668891",
                                        "entry_id": "822807a0-e50e-39b2-a0ef-0bc019e6b0ae",
                                        "glosses": [
                                            "Greater physical weight.",
                                            "The excess of weight of that part of a cannon behind the trunnions over that in front of them."
                                        ],
                                        "tags": [
