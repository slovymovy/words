                                        "sense_id": "657501d1-95ba-3fd4-aca2-4855b0bbd540",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Not faint or delicate; vivid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f3109b1-998a-4b3a-ab73-e26edb5aeb9d",
                                                "sense_id": "657501d1-95ba-3fd4-aca2-4855b0bbd540",
                                                "text": "a rich red colour"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "249a3d9c-e7fe-3e1f-ac2a-9a37eff7428a",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Very amusing."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eda7eddf-72db-4f5f-a4d2-934e3f10fdd3",
                                                "sense_id": "249a3d9c-e7fe-3e1f-ac2a-9a37eff7428a",
                                                "text": "The scene was a rich one."
                                            },
                                            {
                                                "example_id": "0adaf59d-759d-4b52-85aa-85007a09c996",
                                                "sense_id": "249a3d9c-e7fe-3e1f-ac2a-9a37eff7428a",
                                                "text": "a rich incident or character"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785de463-9942-3f50-84d5-6efbe375be95",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Ridiculous, absurd, outrageous, preposterous, especially in a galling, hypocritical, or brazen way."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "259ab286-baa9-4e1a-89ba-ed2ee48f76fa",
                                                "sense_id": "785de463-9942-3f50-84d5-6efbe375be95",
                                                "text": "That's rich, coming from you."
                                            },
                                            {
                                                "example_id": "c9bb642d-f5b0-406d-af9d-d54333df4cd5",
                                                "sense_id": "785de463-9942-3f50-84d5-6efbe375be95",
                                                "text": "Now, if money be a marketable commodity like flour, as the Witness states, is it not rather a rich idea that of selling the use of a barrel of flour instead of the barrel of flour itself?"
                                            },
                                            {
                                                "example_id": "5a78cef0-575c-4c61-8653-a532085fb7db",
                                                "sense_id": "785de463-9942-3f50-84d5-6efbe375be95",
                                                "text": "It is a bit rich to oppress, torture, imprison, enslave, deport and proscribe a people for 200 years, and then take credit for the fact that they are democratic at the end of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "803c86d3-60c4-3aa8-a4f4-f1e8b21f3a5c",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Pornographic; titillating."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49599760-00a1-37de-a1cd-1bc2b2c5c6b3",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Elaborate, having complex formatting, multimedia, or depth of interaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cbfe490-373f-4b07-9d0f-739cd4a419df",
                                                "sense_id": "49599760-00a1-37de-a1cd-1bc2b2c5c6b3",
                                                "text": "A skilled multimedia developer will have no problems adding interactive video and audio into existing rich media web pages."
                                            },
                                            {
                                                "example_id": "da2fccd4-7eeb-4051-8659-725807c935e4",
                                                "sense_id": "49599760-00a1-37de-a1cd-1bc2b2c5c6b3",
                                                "text": "Some rich text email messages contain formatting information that's best viewed with Microsoft Word."
                                            },
                                            {
                                                "example_id": "b7471e79-059f-4a22-9fb1-a6e6e76936d9",
                                                "sense_id": "49599760-00a1-37de-a1cd-1bc2b2c5c6b3",
                                                "text": "But what did matter was that the new web platform provided a rich experience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b6e0c13-7257-31f8-857c-52cd6eb35a7a",
