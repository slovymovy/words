                        "entry_id": "120695d2-037b-3dea-89d1-a3c778a03a68",
                        "glosses": [
                            "sehr einfach gehaltene Speisewirtschaft (oftmals auch unter freiem Himmel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de63f75-4a9d-46fa-a8e3-73fb1d2c0d6b",
                                "sense_id": "d25c2d1c-a2b7-3d07-b532-5d31c9bb86f3",
                                "text": "Am Sonntag findet man in dem Park viele Garküchen, die hauptsächlich Speisen aus Thailand, aber auch aus Laos, Vietnam, Indien und Brasilien anbieten."
                            },
                            {
                                "example_id": "522d859f-084a-4bd5-b424-ca14d04c4693",
                                "sense_id": "d25c2d1c-a2b7-3d07-b532-5d31c9bb86f3",
                                "text": "„Und die Garküchen am Rand des Marktes produzieren beißenden Holzkohlenqualm.“"
                            },
                            {
                                "example_id": "031ca4fb-0cff-4303-9bec-71b74013d73a",
                                "sense_id": "d25c2d1c-a2b7-3d07-b532-5d31c9bb86f3",
                                "text": "„In ausgebrannten Steinhäusern nisteten sich Garküchen und Herbergen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
