                "translations": [
                    {
                        "translation_id": "3ee0b539-29e3-49fd-b97f-0e98d008861c",
                        "source_entry_id": "236e3afe-84a9-3af1-9e93-31597ba21a79",
                        "source_sense_id": "1f3920db-d7da-308c-98c0-69bee55f9c68",
