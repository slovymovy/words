                ],
                "senses": [
                    {
                        "sense_id": "94b2e8f7-24e5-3255-9f4e-edab53003f0b",
                        "entry_id": "d25ff7d3-ee0a-3322-8b83-088ff4af3b74",
                        "glosses": [
                            "besonders bewunderte Läuferin; Läuferin, die als Vorbild angesehen wird"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "cdff43cd-80d4-418a-b6a2-9ebd7eaeb458",
                                "sense_id": "94b2e8f7-24e5-3255-9f4e-edab53003f0b",
                                "text": "„Ich bin ja die Laufheldin der Nicht-Läufer und Langsamläufer.“"
                            },
                            {
                                "example_id": "4c84be7e-efbb-435b-b194-12d250db005c",
                                "sense_id": "94b2e8f7-24e5-3255-9f4e-edab53003f0b",
                                "text": "„Da klatschte selbst Hollands Laufheldin Sifan Hassan, die im Olympiastadion das Zielband hielt, respektvoll Beifall.“"
                            },
                            {
                                "example_id": "6155c04a-b2d4-4a9f-93c4-67e7a8937b46",
                                "sense_id": "94b2e8f7-24e5-3255-9f4e-edab53003f0b",
                                "text": "„Als Chris äußerlich erfrischt aus der Halle kommt, ist uns die Anfahrt nach Büren zu knapp, wir entscheiden, bei km 95 am Ufer der Aare unsere weitere Laufheldin zu erwarten.“"
                            },
                            {
                                "example_id": "09a1b48a-ebd2-477c-89a4-a965d3fcbbe4",
                                "sense_id": "94b2e8f7-24e5-3255-9f4e-edab53003f0b",
                                "text": "„Ich habe diese Überschrift bewusst so gewählt, da es in diesem Artikel darum geht, wie du zur Laufheldin oder zum Laufhelden wirst, wenn du – so wie ich damals – mit Übergewicht an diese Herausforderung herantrittst.“"
                            },
                            {
                                "example_id": "17217534-ba61-4ef8-92a7-08fa265fd2ce",
                                "sense_id": "94b2e8f7-24e5-3255-9f4e-edab53003f0b",
                                "text": "„So kurz gefasst könnte eine Biografie der Laufheldin 2014 Heike Fritzlar aussehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
