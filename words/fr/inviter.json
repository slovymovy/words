{
    "word_family": [
        "invitation",
        "désinviter",
        "réinviter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16851d0c-0020-3498-9941-d62ca30627b5",
                    "sense_definition": "Convier quelqu'un à un repas, une célébration ou un événement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "convier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>invite</w> tous mes amis à mon anniversaire samedi soir."
                        },
                        {
                            "text": "Nous voulons vous <w>inviter</w> à dîner dans un bon restaurant."
                        }
                    ],
                    "synonyms": [
                        "convier"
                    ],
                    "antonyms": [
                        "désinviter"
                    ],
                    "common_phrases": [
                        "inviter à dîner",
                        "inviter des amis",
                        "inviter au restaurant"
                    ]
                },
                {
                    "sense_id": "703950c6-b80c-39f0-a122-250db30b58e9",
                    "sense_definition": "Inciter, encourager ou disposer naturellement à une action ou un comportement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inciter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette douce musique nous <w>invite</w> au repos et à la détente."
                        },
                        {
                            "text": "Le beau temps printanier <w>invite</w> à faire une longue promenade en forêt."
                        }
                    ],
                    "common_phrases": [
                        "inviter au calme",
                        "inviter à la réflexion",
                        "inviter au voyage"
                    ]
                },
                {
                    "sense_id": "c8ebac55-20c3-34c0-9675-25f20fe84937",
                    "sense_definition": "Demander formellement ou enjoindre poliment à quelqu'un d'accomplir une action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enjoindre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le responsable a poliment <w>invité</w> le visiteur agité à quitter les lieux."
                        },
                        {
                            "text": "Le président de séance <w>invite</w> l'assemblée à voter à main levée."
                        }
                    ],
                    "common_phrases": [
                        "inviter à sortir",
                        "inviter à quitter les lieux"
                    ]
                },
                {
                    "sense_id": "9de51e50-b976-3b08-bab1-04db9a38e377",
                    "sense_definition": "Venir ou se joindre à une réunion ou chez quelqu'un sans y avoir été convié.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "s_inviter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon voisin s'est <w>invité</w> chez nous au moment précis où nous commencions à manger."
                        },
                        {
                            "text": "Tu ne peux pas simplement t'<w>inviter</w> à cette fête privée sans prévenir l'organisateur."
                        }
                    ],
                    "common_phrases": [
                        "s'inviter chez quelqu'un",
                        "s'inviter à dîner"
                    ]
                },
                {
                    "sense_id": "873ab614-e449-3360-80c5-e163dbc362b3",
                    "sense_definition": "S'imposer au cœur d'une discussion, d'un débat ou d'une actualité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "s_inviter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La question du climat s'est <w>invitée</w> au centre des discussions entre les ministres."
                        },
                        {
                            "text": "Ce dossier délicat s'<w>invite</w> régulièrement dans les débats politiques de la campagne électorale."
                        }
                    ],
                    "common_phrases": [
                        "s'inviter dans le débat",
                        "s'inviter dans la campagne"
                    ]
                }
            ]
        }
    ]
}