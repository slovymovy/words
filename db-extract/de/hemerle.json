                ],
                "senses": [
                    {
                        "sense_id": "a421ecae-9dfd-3427-96c6-50cbacb30375",
                        "entry_id": "a3bded43-cfa0-3677-a54b-0c21bcc6d65b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ccf001-6393-4f64-a826-a25b7b1b1896",
                                "sense_id": "a421ecae-9dfd-3427-96c6-50cbacb30375",
                                "text": "Frau Hemerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9fc94c49-4a08-4d34-9248-b02c0cee909e",
                                "sense_id": "a421ecae-9dfd-3427-96c6-50cbacb30375",
                                "text": "Herr Hemerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ec56bf97-2530-425e-b38e-2bad0cc4c9fb",
                                "sense_id": "a421ecae-9dfd-3427-96c6-50cbacb30375",
                                "text": "Die Hemerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "c5af01e4-a2f2-4bea-926c-f6a1bba69fc7",
                                "sense_id": "a421ecae-9dfd-3427-96c6-50cbacb30375",
                                "text": "Der Hemerle trägt nie die Pullover, die die Hemerle ihm strickt."
                            },
                            {
                                "example_id": "6c5c06c0-d183-4259-a3a8-70434ce0351d",
                                "sense_id": "a421ecae-9dfd-3427-96c6-50cbacb30375",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hemerle kommt, geht der Herr Hemerle.“"
                            },
                            {
                                "example_id": "2e96e2c3-bd95-465a-b590-9e2e87f836ef",
                                "sense_id": "a421ecae-9dfd-3427-96c6-50cbacb30375",
                                "text": "Hemerle kommt und geht."
                            },
                            {
                                "example_id": "7f8bbef4-2924-4985-9f25-6b9b7a087721",
                                "sense_id": "a421ecae-9dfd-3427-96c6-50cbacb30375",
                                "text": "Hemerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
