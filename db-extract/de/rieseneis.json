                "senses": [
                    {
                        "sense_id": "3bbc9cb4-df40-357d-8467-03089f361c9c",
                        "entry_id": "5be1b35d-102f-34ce-98a7-c11fccdd3628",
                        "glosses": [
                            "extrem große Speiseeisportion"
