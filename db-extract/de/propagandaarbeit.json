                "senses": [
                    {
                        "sense_id": "b083c0a2-ee2f-3028-a205-168d47164862",
                        "entry_id": "69b7467e-c64a-3d63-a868-8518a6dce71d",
                        "glosses": [
                            "Gesamtheit propagandistischer Aktivitäten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef6300a-057a-47ce-a4b7-240dadb9be23",
                                "sense_id": "b083c0a2-ee2f-3028-a205-168d47164862",
                                "text": "„Der African National Council leistete eine effiziente Propagandaarbeit, denn die Ablehnung der Verfassung war überwältigend und überzeugte die britische Kommission unter Lord Pearce.“"
                            },
                            {
                                "example_id": "594e92e5-3f1b-434d-ac2f-d80ced4e62ad",
                                "sense_id": "b083c0a2-ee2f-3028-a205-168d47164862",
                                "text": "„In Paris fragte sich der dortige Vertreter der Jewish Agency, Emile Najjar, wie er angesichts der gegenwärtigen Realitäten eine effektive Propagandaarbeit leisten könne.“"
                            },
                            {
                                "example_id": "07c477ee-5e6d-4606-a3f8-aa036590c7c8",
                                "sense_id": "b083c0a2-ee2f-3028-a205-168d47164862",
                                "text": "„In diese Richtung argumentiert nun auch der NDR: Die Verantwortung von Henri Nannen für die Propagandaarbeit des ‚Südstern‘ sei ‚unstrittig‘, so eine Sprecherin.“"
                            },
                            {
                                "example_id": "e9e8bbef-6809-4663-aaf9-28413effe19c",
                                "sense_id": "b083c0a2-ee2f-3028-a205-168d47164862",
                                "text": "„Sie stellte kein einziges Ereignis, wie die Fahndung durch die Polizei, die Ereignisse rund um die Festnahme ihres Vaters, ihre Ausreise aus China, näher dar und beschrieb auch ihre Tätigkeit, für die Falun Gong Bewegung Flugblätter verteilt zu haben und in Propagandaarbeit involviert gewesen zu sein, nicht konkret.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
