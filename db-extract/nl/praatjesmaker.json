                                        "glosses": [
                                            "Que gusta de hablar mucho."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edba4051-29c7-4245-a093-c566d985f2fb",
                                                "sense_id": "88b669a2-9790-3e92-9d2d-7b7f113a34a0",
                                                "text": "Él, de costumbre, tan simpático y hablador con todo el mundo, no abrió la boca en toda la noche"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b19d21f4-f45b-354c-a985-536ce27c0655",
                                        "entry_id": "a6aa522c-9dcf-3662-b22b-e03ffd6853e1",
                                        "glosses": [
                                            "Que gusta hablar en demasía, importunando a los demás con impertinencias."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9c91a0-eb6b-495f-8a20-296d96cd86f4",
                                                "sense_id": "b19d21f4-f45b-354c-a985-536ce27c0655",
                                                "text": "El primero es un criollo blanco, dominador y prepotente, hablador y manipulador"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2e7d5448-2c97-3db7-ad9f-46e39cf8a947",
                                        "entry_id": "a6aa522c-9dcf-3662-b22b-e03ffd6853e1",
                                        "glosses": [
                                            "Persona que dice y critica todo lo que ve y oye de manera poco discreta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb0170d-7a8e-4148-9100-9f1f27e75dab",
                                                "sense_id": "2e7d5448-2c97-3db7-ad9f-46e39cf8a947",
                                                "text": "¡Así que a ver venga por otra cicatero!, ¡eso le está bien por ser hablador!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1786ea16-747d-3a5a-ab0b-0d48a91d4d1a",
                                        "entry_id": "a6aa522c-9dcf-3662-b22b-e03ffd6853e1",
                                        "glosses": [
                                            "Que se comporta con arrogancia y cuenta mentiras."
                                        ],
