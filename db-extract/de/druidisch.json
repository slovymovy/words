                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fa3f90d-f323-39c8-9728-7eb8347ed438",
                        "entry_id": "4ead9e2e-23d8-3cfa-8d98-ff2a836e65e5",
                        "glosses": [
                            "sich auf Druiden beziehend, zu ihnen gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "120a5daf-3083-424f-aad4-c635c28c85d0",
                                "sense_id": "6fa3f90d-f323-39c8-9728-7eb8347ed438",
                                "text": "„Als ich die von Norrys gesammelten Erzählungen zusammentrug und sie um die Berichte mehrerer Gelehrter ergänzte, die die Ruinen untersucht hatte, kam ich zu dem Schluss, dass Exham Priory auf dem Platz eines vorgeschichtlichen Tempels stand, eines druidischen oder vordruidischen Bauwerks, das im selben Zeitraum wie Stonehenge entstanden sein musste.“"
                            },
                            {
                                "example_id": "e674679c-7c76-4243-a669-3f512e69c4a9",
                                "sense_id": "6fa3f90d-f323-39c8-9728-7eb8347ed438",
                                "text": "„Am Sanderson College existierte eine eng verbundene Gemeinschaft aus Professoren der Fächer Englisch, Geschichte und Philosophie, die druidische Bräuche pflegten und jedes Semester den Studenten mit dem besten Notendurchschnitt kastrierten und seine Genitalien an den Ulmenbaum vorm Campus nagelten, um den Angehörigen des College Gesundheit, Glück und ein langes Leben zu bescheren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
