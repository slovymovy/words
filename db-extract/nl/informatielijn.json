                        "entry_id": "1dd97b26-d540-383d-9f40-cd7a0f1a4956",
                        "glosses": [
                            "telefoonnummer dat men kan bellen als men informatie over een bepaald onderwerp wil krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81844e89-5e6c-4e2f-9068-f4fbccef5918",
                                "sense_id": "74a03bc2-da78-3bca-829c-66631923332c",
                                "text": "Er komt in Nederland een informatielijn voor mensen met vragen over ebola en de risico's op besmetting. Die informatielijn wordt opgezet door het RIVM."
                            },
                            {
                                "example_id": "aeab011e-57b2-4532-b64a-2ead3a98c280",
                                "sense_id": "74a03bc2-da78-3bca-829c-66631923332c",
                                "text": "Wilt u problemen melden met betrekking tot het krijgen van een plek in een verzorgingshuis of verpleeghuis? Bel dan de informatielijn van de Nederlandse Zorgautoriteit (NZa)."
                            },
                            {
                                "example_id": "c676180f-c81c-4b5a-9144-5b118a122579",
                                "sense_id": "74a03bc2-da78-3bca-829c-66631923332c",
                                "text": "De speciale meldlijn blijft twee weken open. De NVVE hoopt in die periode de omvang van het probleem in kaart te kunnen brengen. Daarna kunnen mensen bellen met de informatielijn van de NVVE."
                            }
                        ]
                    }
