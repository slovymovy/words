                                    {
                                        "sense_id": "3aa154fb-61a4-39e2-8a0b-03efca3e5158",
                                        "entry_id": "0890bc36-94b0-3b75-a193-a3c3dac3144c",
                                        "glosses": [
                                            "Langue sémitique parlée en Éthiopie, en Érythrée et en Israël."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb652a00-cf90-4c75-8795-7027482dffc5",
                                                "sense_id": "3aa154fb-61a4-39e2-8a0b-03efca3e5158",
                                                "text": "Les Érythréens eux ont le tigrigna et un alphabet tout à fait particulier qui descend du guèze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98b282ec-2ef7-47a4-bb51-b2711e5a8c00",
                        "source_entry_id": "be4201bb-651d-37ba-a0d7-f7475533d555",
                        "source_sense_id": "646eaf0b-de47-32e1-833c-88be6ba5a4fa",
                        "source_sense_description": "language",
                        "target_lang_word": "Tigrinya",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tigrinya",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93b5b100-297b-3e48-9eec-22974f758c43",
                                        "entry_id": "5994d9ec-0fe6-38fd-9d12-9385fdf6849a",
                                        "glosses": [
                                            "semitische Sprache, die in Äthiopien und Eritrea gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f90921-8e39-4acb-9fb1-9903a7dd3928",
                                                "sense_id": "93b5b100-297b-3e48-9eec-22974f758c43",
                                                "text": "„Tesfai, der oft entschuldigend auf seine Sprachschwierigkeiten hinweist, spricht zwar inzwischen gut Tigrinya, dennoch fehlen ihm immer wieder Wörter und Ausdrücke.“"
                                            },
                                            {
                                                "example_id": "d04f6d26-9cbd-412f-9e0a-cd4ac4b18bc7",
                                                "sense_id": "93b5b100-297b-3e48-9eec-22974f758c43",
                                                "text": "„Tigrinya ist eng mit dem Ge’ez verwandt und erst seit dem Zweiten Weltkrieg Schriftsprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "767384e4-9480-4fd7-aca1-4e053986131b",
                        "source_entry_id": "be4201bb-651d-37ba-a0d7-f7475533d555",
                        "source_sense_id": "646eaf0b-de47-32e1-833c-88be6ba5a4fa",
                        "source_sense_description": "language",
                        "target_lang_word": "Tigrinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tigrinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2bd1313-e1e8-3960-827e-8244ec2e4723",
                                        "entry_id": "0bb18149-1200-30fe-b7a4-1d6737f62c8c",
                                        "glosses": [
                                            "semitische Sprache, die in Äthiopien und Eritrea gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09cbc95e-405f-46ad-83db-d6efa2802457",
                                                "sense_id": "e2bd1313-e1e8-3960-827e-8244ec2e4723",
                                                "text": "„Sie können auch französisch und englisch sprechen und lesen, aber sie verstehen nur wenige Brocken Amarigna, kein Wort Tigrinisch.“"
                                            },
                                            {
                                                "example_id": "6d45d32d-6b32-49d5-b84b-3a936af716e3",
                                                "sense_id": "e2bd1313-e1e8-3960-827e-8244ec2e4723",
                                                "text": "„[…] so wundert man sich eben, daß die beiden modernen semitischen Sprachen, die nach ihrer Sprecherzahlen den zweiten und dritten Platz einnehmen, nämlich Amharisch und Tigrinisch (Tigrinya), überhaupt nicht berücksichtigt sind.“"
                                            },
                                            {
                                                "example_id": "851730cc-478f-454c-9544-6167a5e88b33",
                                                "sense_id": "e2bd1313-e1e8-3960-827e-8244ec2e4723",
                                                "text": "„Nach Anzahl der Sprecher nimmt das Tigrinische unter den modernen semitischen Sprachen den dritten Rang ein – nach dem Arabischen und dem Amharischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
