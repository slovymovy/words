                "senses": [
                    {
                        "sense_id": "e560aff2-38e7-310d-951f-91ef9a3b09e7",
                        "entry_id": "034bf2d2-c0d6-32ae-b23f-e494aeac09a0",
                        "glosses": [
                            "Tätigkeit, die sicherstellt, das geltendes Recht beim Bauen eingehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bfa154a-b41d-4f3e-8f27-d28bbd13e31a",
                                "sense_id": "e560aff2-38e7-310d-951f-91ef9a3b09e7",
                                "text": "Die Bauaufsicht wird von der Baubehörde wahrgenommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cd59f71-5f60-3609-a174-fb2a3c90c4d6",
                        "entry_id": "034bf2d2-c0d6-32ae-b23f-e494aeac09a0",
                        "glosses": [
                            "Behörde zur Genehmigung, Beobachtung, Kontrolle, Überwachung und baurechtliche Abnahme von Bauvorhaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5b4b1d-db2d-4681-a3c1-0e386dcda6ef",
                                "sense_id": "3cd59f71-5f60-3609-a174-fb2a3c90c4d6",
                                "text": "Im Rechtsstreit mit der Bauaufsicht unterlag der Bauherr und musste beim Brandschutz nachbessern."
                            },
                            {
                                "example_id": "2090b6c2-baad-4c08-bf87-97adb028f50f",
                                "sense_id": "3cd59f71-5f60-3609-a174-fb2a3c90c4d6",
                                "text": "Die Bauaufsicht nahm das fertiggestellte Gebäude ab und übergab es der Öffentlichkeit."
                            },
                            {
                                "example_id": "bfea2b30-851f-45c9-ac8e-f12c77e5081f",
                                "sense_id": "3cd59f71-5f60-3609-a174-fb2a3c90c4d6",
                                "text": "Herr Meyer von der Bauaufsicht kontrollierte im Ortstermin die genehmigten Außenmaße des Gebäudes."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
