                "senses": [
                    {
                        "sense_id": "7c89e34a-f965-3b06-b7a4-35fd73f0a1e6",
                        "entry_id": "051a9fb6-5f03-3bf5-ae34-eeb29791bbb9",
                        "glosses": [
                            "устар. наёмный работник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f727007f-d2c6-41ab-9398-09fc62d21d35",
                                "sense_id": "7c89e34a-f965-3b06-b7a4-35fd73f0a1e6",
                                "text": "Это всё — отхожие рабочие. Это — крестьяне только по названию, а на самом деле наймиты, рабочие."
                            }
                        ]
                    },
                    {
                        "sense_id": "b083e9a9-bb60-3538-9a17-7c11ee3f9cce",
                        "entry_id": "051a9fb6-5f03-3bf5-ae34-eeb29791bbb9",
                        "glosses": [
                            "пренебр. человек, защищающий чужие интересы из корыстных соображений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a38c64fb-a0d8-4bf7-b9fe-0a1f896b222e",
                                "sense_id": "b083e9a9-bb60-3538-9a17-7c11ee3f9cce",
                                "text": "На Западе распространяются слухи наймитами империалистов и авторами подложных писем о том, что Коминтерн есть организация заговорщиков и террористов .."
                            }
                        ]
                    }
