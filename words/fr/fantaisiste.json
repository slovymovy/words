                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a rejeté cette explication <w>fantaisiste</w> qui ne reposait sur aucune preuve matérielle."
                        },
                        {
                            "text": "Les données fournies dans ce rapport financier semblent totalement <w>fantaisistes</w> et appellent à la vigilance."
