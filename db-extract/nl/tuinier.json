                "translations": [
                    {
                        "translation_id": "9fec2d02-40db-4bdb-a939-6826c6cf30e3",
                        "source_entry_id": "5ca0b99f-9d1d-35c1-9b3a-2f0b449b0a3b",
                        "source_sense_id": "d9e2f6ad-bc5b-34fb-9731-deacc1ad6738",
                        "target_lang_word": "Gärtner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gärtner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                        "entry_id": "466811f2-e496-329e-b181-46d5b9161a23",
                                        "glosses": [
                                            "Person, die beruflich im Gartenbau tätig ist"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9261b79d-2e8c-4969-8f92-71d72caaf50e",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "Ein Gärtner ist bei Wind und Wetter draußen und arbeitet in den Beeten."
                                            },
                                            {
                                                "example_id": "0c1c6692-895d-4076-b5d0-959b621f4803",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "Sie führte ein Telefonat mit dem Gärtner über das Anlegen neuer Rhododendronhecken."
                                            },
                                            {
                                                "example_id": "63ad1bf9-10c4-41fe-9f8c-7d6f3343031e",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Der französische Präsident dagegen sieht von seinem Arbeitszimmer nur die Gärtner, die in seinem Privatpark unter den uralten Bäumen den Rhododendron stutzen.“"
                                            },
                                            {
                                                "example_id": "577482b9-3d15-487a-9715-ad0662140884",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Ihre wundervollen Kinder würden eine gute Schule besuchen, und sie hätte drei Dienstmädchen, einen Gärtner, einen Chauffeur und eine Köchin.“"
                                            },
                                            {
                                                "example_id": "980a5c37-69f2-4912-93dd-f0d62d23eae3",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Anna ist Friedas Schwester und die Frau des Gärtners von Rumbske, den – wie fast alle Männer – der Krieg fortriß.“"
                                            },
                                            {
                                                "example_id": "8ce48aec-8237-4bd4-bc1f-2caa227f117c",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Fried kam in die Lehrlingsgruppe der Schreiner, und ihn steckte man zu den Gärtnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae7881bb-bd56-4708-9d9c-131925234ba1",
                        "source_entry_id": "5ca0b99f-9d1d-35c1-9b3a-2f0b449b0a3b",
                        "source_sense_id": "d9e2f6ad-bc5b-34fb-9731-deacc1ad6738",
                        "target_lang_word": "gardener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06c8e2f9-1e73-3f9c-b8c4-0eb163484f8d",
                                        "entry_id": "0590057a-29ca-3851-92bc-cb45e0e80888",
                                        "glosses": [
                                            "One who gardens; one who grows plants or cultivates a garden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea51546d-1a90-453e-bb87-104a0829f7b7",
                                                "sense_id": "06c8e2f9-1e73-3f9c-b8c4-0eb163484f8d",
                                                "text": "\"Ponder the fact that God has made you a gardener, to root out vice and to plant virtue.\" — St. Catherine of Siena"
                                            },
                                            {
                                                "example_id": "1a11fcac-39fe-4ca7-b766-5c80db1de1ce",
                                                "sense_id": "06c8e2f9-1e73-3f9c-b8c4-0eb163484f8d",
                                                "text": "At the far end of the houses the head gardener stood waiting for his mistress, and he gave her strips of bass to tie up her nosegay. This she did slowly and laboriously, with knuckly old fingers that shook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a3dd65-07e0-3d52-aa9c-1d19aee08d49",
                                        "entry_id": "0590057a-29ca-3851-92bc-cb45e0e80888",
                                        "glosses": [
                                            "A coachman who drives badly."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "470f51ee-4472-4846-8f15-3ad7283d26f6",
                                                "sense_id": "55a3dd65-07e0-3d52-aa9c-1d19aee08d49",
                                                "text": "Get on, gardener! Get on, you slow and clumsy coachman. The allusion is to a man who is both gardener and coachman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3921ffd2-ce24-467e-9d19-e5569e3d5412",
                        "source_entry_id": "5ca0b99f-9d1d-35c1-9b3a-2f0b449b0a3b",
                        "source_sense_id": "d9e2f6ad-bc5b-34fb-9731-deacc1ad6738",
                        "target_lang_word": "jardinier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jardinier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a698c8-b40c-3648-9b5e-3ba19bbbb0bb",
                                        "entry_id": "eb72a162-2d54-3187-a01b-27ffc36c5aa9",
                                        "glosses": [
                                            "Relatif aux jardins et au jardinage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f858b95a-01a3-49ff-980e-4e6fc5263804",
                                                "sense_id": "a3a698c8-b40c-3648-9b5e-3ba19bbbb0bb",
                                                "text": "La manière la plus ordinaire de former ces composts, est de réunir sur la lisière du terrain à améliorer, les fumiers d’étable et les terres destinées à les composer ; celles qui provenaient de cultures jardinières étaient naguère et sont encore, dans quelques parties de l'ouest, prisées, pour cette destination, presque à l’égal du fumier."
                                            },
                                            {
                                                "example_id": "382d9252-5580-4462-80e8-61b7070d5fbf",
                                                "sense_id": "a3a698c8-b40c-3648-9b5e-3ba19bbbb0bb",
                                                "text": "L’Herbier d’Otto Brunfels (1532) énumère, en tant que nouvelles bases de l’économie jardinière : salsifis, haricots, pois, aulx et oignons, choux pommés, raves et navets."
                                            },
                                            {
                                                "example_id": "5556c9f5-e29e-4fba-a28c-6a8984493e94",
                                                "sense_id": "a3a698c8-b40c-3648-9b5e-3ba19bbbb0bb",
                                                "text": "C’est bien fait, beau travail, fit-il, je vois que vous avez sacrifié au rite de la petite communauté qui veut que l’intégration ici passe par la production jardinière, une sorte d’urbanité légumière, le raffinement horticole, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jardinier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5742a174-864c-32c3-b221-dab9ed263531",
                                        "entry_id": "86e6cb24-8698-3089-9180-c0dbad98c70d",
                                        "glosses": [
                                            "Personne dont le métier est de cultiver, d'entretenir un ou plusieurs jardins, pour son compte personnel ou d’autrui."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d689dc2a-293a-4882-9146-8de08cfb6098",
                                                "sense_id": "5742a174-864c-32c3-b221-dab9ed263531",
                                                "text": "Vous avez pu constater que, sauf un lopin de terre où le jardinier sème des plants de carottes et de choux pour la table de sa Grandeur, tout le jardin est inculte ; c’est du bien perdu et sans profit pour personne."
                                            },
                                            {
                                                "example_id": "bd09e27e-6cef-4aa8-9c7c-dfba990f6d02",
                                                "sense_id": "5742a174-864c-32c3-b221-dab9ed263531",
                                                "text": "Nous avions pour jardinier un ancien forçat que sa bonne conduite au bagne avait racheté de ses fautes."
                                            },
                                            {
                                                "example_id": "8c867dfb-a238-40a1-bb16-cdf4a3899b5e",
                                                "sense_id": "5742a174-864c-32c3-b221-dab9ed263531",
                                                "text": "M. Tom Smallways était fruitier de son état et jardinier par vocation, et Jessica, sa modeste épouse, vaquait aux soins de la boutique."
                                            },
                                            {
                                                "example_id": "8354b794-d999-4c49-ab86-bf0a9e41c78d",
                                                "sense_id": "5742a174-864c-32c3-b221-dab9ed263531",
                                                "text": "Il paraît, nous a-t-on dit un jour, qu'il existe à Châteauneuf-le-Rouge un labyrinthe de buis si vaste que le jardinier a besoin de l'année entière pour le tailler : il commence à un bout, et, lorsqu'il arrive à la fin du tracé, recommence un nouveau circuit et une nouvelle année."
                                            },
                                            {
                                                "example_id": "2a63b698-599c-4e2a-8483-a1891200352f",
                                                "sense_id": "5742a174-864c-32c3-b221-dab9ed263531",
                                                "text": "Du haut de la terrasse, il vit des jardiniers occupés à enlever les traînasses des fraisiers afin de conserver les pieds les plus vigoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7843106-67d5-3522-a3d0-0203fc526a36",
                                        "entry_id": "86e6cb24-8698-3089-9180-c0dbad98c70d",
                                        "glosses": [
                                            "Personne qui conçoit des jardins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aff04d20-8472-47e3-8020-2ed217c58db0",
                                                "sense_id": "e7843106-67d5-3522-a3d0-0203fc526a36",
                                                "text": "Le jardinier réalise un poème architectural avec ses allées droites bordées d'arbres taillés, ses ronds-points dans les futaies, ses bassins géométriques, ses cascades et ses jets d'eau réguliers comme des murs."
                                            },
                                            {
                                                "example_id": "0d9d9d2b-f01e-485e-8e7d-1988e0284a57",
                                                "sense_id": "e7843106-67d5-3522-a3d0-0203fc526a36",
                                                "text": "— L'histoire est trop jolie. Savais-tu que le jardinier Le Nôtre prit le chemin de Rome afin d'aller embellir les jardins du Vatican ?"
                                            },
                                            {
                                                "example_id": "c5075ece-946e-4965-9c10-1b4db5dce8b5",
                                                "sense_id": "e7843106-67d5-3522-a3d0-0203fc526a36",
                                                "text": "Ce dimanche matin, sur France Inter, Alain Baraton, jardinier de Versailles, citait, pour illustrer quelque débat sur la démocratie participative, une lettre de Georges Pompidou à Jacques Chaban-Delmas, à propos des arbres qui ombragent les routes de France."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jardinier",
                                "target_lang_code": "fr",
                                "target_senses": [
