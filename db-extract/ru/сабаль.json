                                    {
                                        "sense_id": "9e9c448f-fa23-3649-8264-d2f0a40a1650",
                                        "entry_id": "8a908807-363d-3fef-90c7-d2dd2491b900",
                                        "glosses": [
                                            "Any of various fan palms of the family Arecaceae, especially Sabal palmetto or the saw palmetto, Serenoa repens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8b94f6-315a-427f-9698-3e38d4d451f3",
                                                "sense_id": "9e9c448f-fa23-3649-8264-d2f0a40a1650",
                                                "text": "Broad o'er my Head the verdant Cedar wave, / And high Palmetos lift their graceful Shade."
                                            },
                                            {
                                                "example_id": "e4bab5c2-a736-41ab-83a9-92d051bfe770",
                                                "sense_id": "9e9c448f-fa23-3649-8264-d2f0a40a1650",
                                                "text": "[O]n the flat coastal swamps of South Florida, where the palmettos once blew over the detritus of a dozen failed booms and the hotels were boarded up six months a year, there has evolved […] a settlement of considerable interest […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f7161b-9138-384b-91a7-30df5082ee28",
                                        "entry_id": "8a908807-363d-3fef-90c7-d2dd2491b900",
                                        "glosses": [
                                            "A hat made of palmetto leaves."
                                        ],
