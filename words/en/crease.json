                    "target_lang_definitions": {
                        "cs": "Zastaralá forma slova kris, typ jihovýchodoasijské dýky.",
                        "ru": "Устаревшая форма слова kris (крис) — разновидность кинжала народов Юго-Восточной Азии.",
                        "zh": "马来短剑（kris 的古旧拼写，一种东南亚波浪刃匕首）。"
                    },
                    "translations": {
