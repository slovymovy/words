                ],
                "senses": [
                    {
                        "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                        "entry_id": "8d19072f-6f20-331b-9db7-578b5699b1b9",
                        "glosses": [
                            "zusätzliche Bezahlung der zu verrichtenden Arbeit für ungünstige Arbeitszeiten in Spät- und Nachtschichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a9132d-6985-4bcf-ab2e-405351162a5f",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "Schichtarbeiter bekommen für Spät- und Nachtschichten eine Schichtzulage."
                            },
                            {
                                "example_id": "51bf1ce5-7510-46c5-8b9f-23fa5fb37111",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„Sie verdient 1.000 Euro im Monat netto plus 400 als Schichtzulage – diese aber oft mit Verzögerung.“"
                            },
                            {
                                "example_id": "d1397d2b-32d8-4413-a6d5-b07d339c6c67",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„Ein altgedienter Kapitän der Lufthansa kommt inklusive Schichtzulage und Überstunden auf bis zu 22.000 Euro im Monat.“"
                            },
                            {
                                "example_id": "76b6efcf-591e-4bdf-b743-ecb0644e3c2b",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„Lechner würde sogar noch Leute einstellen, aber er findet niemanden, obwohl die Firma doch, wie er sagt, 12,47 Euro pro Stunde zahlt, plus Schichtzulage.“"
                            },
                            {
                                "example_id": "dbfa59af-8cb0-4631-bc74-44e33f72cbcb",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„Schichtzulagen für Feiertags- und Nachtarbeit bleiben zwar steuerfrei, die Sozialversicherungsbefreiung wird aber auf einen Stundengrundlohn von 25 Euro (bisher: 50 Euro) begrenzt.“"
                            },
                            {
                                "example_id": "9ed5a7a2-0c5b-4631-97c7-1d4dc2fb8b5e",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„Um dem Druck der Billiglohnländer immer mehr stand zu halten, wurden nach und nach solche Zulagen wie Urlaubsgeld, Weihnachtsgeld und sogar die Schichtzulagen entweder gekürzt oder ganz gestrichen.“"
                            },
                            {
                                "example_id": "18b58552-d578-4108-972c-9ed61b447b53",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„1943 wurde der Lohn der einheimischen Arbeiter davon abhängig gemacht, dass die Zwangsarbeiterinnen tatkräftig mitarbeiteten. Zugleich wurden die Schichtzulagen gestrichen.“"
                            },
                            {
                                "example_id": "25682f65-8f35-4ccd-b7eb-38ad454efce9",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„1. Juli 1920 – Im mitteldeutschen Braunkohlerevier beginnen Streiks gegen einen gesetzlichen Steuerabzug und für Schichtzulagen.“"
                            },
                            {
                                "example_id": "6850228e-9057-4ad3-a5e4-087a28b61964",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„Die Gewerkschaft ver.di fordert 700 Euro mehr im Monat für die Beschäftigten. Außerdem sollen sich die Schichtzulagen verbessern und Auszubildende deutlich mehr Geld erhalten.“"
                            },
                            {
                                "example_id": "6fdf0556-16a5-4f34-b20e-08130d19ceac",
                                "sense_id": "1c2d2ba8-cbae-3690-a8da-7df10e2649d8",
                                "text": "„30. September 1955 – In Bremen treten rund 3000 Hafenarbeiter in einen Streik, mit dem sie eine Schichtzulage von 3 DM durchsetzen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
