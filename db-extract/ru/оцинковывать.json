                        "cross_references": [
                            {
                                "target_word": "zinc",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0a6f1a-dbf6-3a6e-9857-48f5a11cbb71",
                                        "entry_id": "d3a5e675-b146-369f-a767-6dd60b2fdeb9",
                                        "glosses": [
                                            "A chemical element (symbol Zn) with an atomic number of 30, a blue-silvery metal that is slightly brittle at room temperature and tarnishes slightly in moist air."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52c167ac-5e03-424c-9e0e-eb56afa727f6",
                                                "sense_id": "1d0a6f1a-dbf6-3a6e-9857-48f5a11cbb71",
                                                "text": "As for daytime sun protection, Dr. Bowe said mineral sunscreens made with zinc oxide may be gentler on sensitized skin than chemical formulas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d9f92ff-d93e-3013-aa92-f46659dcf387",
                                        "entry_id": "d3a5e675-b146-369f-a767-6dd60b2fdeb9",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfba18f0-9575-3598-978c-bde8e0a56ddd",
                                        "entry_id": "d3a5e675-b146-369f-a767-6dd60b2fdeb9",
                                        "glosses": [
                                            "A corrugated iron roof."
                                        ],
                                        "tags": [
                                            "Nigeria",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7214dfc8-3f15-3128-a4a8-4805a99f879e",
                                        "entry_id": "d3a5e675-b146-369f-a767-6dd60b2fdeb9",
                                        "glosses": [
                                            "A zinc countertop."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d5ac5f7-df2d-4e23-ad27-adbac919692f",
                                                "sense_id": "7214dfc8-3f15-3128-a4a8-4805a99f879e",
                                                "text": "Then, three workmen throwing dice for drinks. And their heads come sharply together as they count the scores. And so violently do they throw the dice that they shoot off \"the zinc\" on to the floor."
                                            },
                                            {
                                                "example_id": "7d66a3ce-2d4e-4d22-8795-4e9f5bc48750",
                                                "sense_id": "7214dfc8-3f15-3128-a4a8-4805a99f879e",
                                                "text": "Even if there were a Chef and Brewer near Marble Arch, the name suggests a pint and pie, not a prawn and tomato sandwich and “a dock glass of white port off the zinc”; i.e., a small glass of a fine aperitif, at the counter […]"
                                            }
                                        ]
                                    }
                                ]
                            },
