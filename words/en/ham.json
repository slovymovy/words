    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d1fa8ca-ab69-339d-8ac4-3a83b69cc8d7",
                    "sense_definition": "Meat from the thigh or buttock of a pig, typically cured, smoked, or salted for food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a <w>ham</w> and cheese sandwich for lunch please.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел сэндвич с <w>ветчиной</w> и сыром на обед, пожалуйста.",
                                "zh": "请给我来一份午餐的火腿奶酪三明治。"
                            }
                        },
                        {
                            "text": "She decided to bake a whole <w>ham</w> for the holiday dinner.",
                            "target_lang_translations": {
                                "ru": "Она решила запечь целый <w>окорок</w> для праздничного ужина.",
                                "zh": "她决定为节日晚餐烤一整只<w>火腿</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ham and cheese",
                        "honey glazed ham",
                        "slice of ham"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо из бедра или ягодицы свиньи, обычно вяленое, копченое или соленое.",
                        "zh": "猪后腿或臀部的肉，通常经过腌制、熏制或风干后食用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветчина",
                                "target_lang_sense_clarification": "готовый мясной продукт"
                            },
                            {
                                "target_lang_word": "окорок",
                                "target_lang_sense_clarification": "часть туши или копченость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "火腿",
                                "target_lang_sense_clarification": "加工后作为食物的猪腿肉"
                            },
                            {
                                "target_lang_word": "火腿肉",
                                "target_lang_sense_clarification": "较正式，也可指整块火腿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef26848d-00eb-327b-82a2-a27ecc57502e",
                    "sense_definition": "The thigh or buttock of a hog slaughtered for meat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher hung the large <w>hams</w> in the smokehouse to cure.",
                            "target_lang_translations": {
                                "ru": "Мясник развесил большие <w>окорока</w> в коптильне для вяления.",
                                "zh": "肉贩把几个大的<w>猪后腿</w>挂在熏房里进行腌制。"
                            }
                        },
                        {
                            "text": "He carried a heavy <w>ham</w> from the market back to his kitchen.",
                            "target_lang_translations": {
                                "ru": "Он нес тяжелый <w>окорок</w> с рынка домой на кухню.",
                                "zh": "他把一只沉重的<w>猪后腿</w>从市场搬回了厨房。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cured ham",
                        "smoked ham"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бедро или ягодица свиньи, забитой на мясо.",
                        "zh": "被屠宰供食用的猪的后腿或臀部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окорок",
                                "target_lang_sense_clarification": "часть туши животного"
                            },
                            {
                                "target_lang_word": "задняя нога",
                                "target_lang_sense_clarification": "анатомическая часть туши"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猪后腿",
                                "target_lang_sense_clarification": "屠宰后作为肉品的后腿部位"
                            },
                            {
                                "target_lang_word": "猪腿",
                                "target_lang_sense_clarification": "较书面，指猪的后腿肉块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61fdc579-065c-32e1-b757-ee5749663563",
                    "sense_definition": "A person who operates an amateur radio station as a hobby.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "radio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My uncle is a dedicated <w>ham</w> who talks to people all over the world.",
                            "target_lang_translations": {
                                "ru": "Мой дядя — заядлый <w>радиолюбитель</w>, который общается с людьми по всему миру.",
                                "zh": "我叔叔是个很投入的<w>业余无线电爱好者</w>，会和世界各地的人通话。"
                            }
                        },
                        {
                            "text": "The local <w>ham</w> radio operator helped provide communication during the storm.",
                            "target_lang_translations": {
                                "ru": "Местный <w>радиолюбитель</w> помог обеспечить связь во время шторма.",
                                "zh": "暴风雨期间，当地一位<w>业余无线电爱好者</w>帮助维持了通信。"
                            }
                        }
                    ],
                    "synonyms": [
                        "radio amateur"
                    ],
                    "common_phrases": [
                        "ham radio operator"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used term for amateur radio enthusiasts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который занимается любительской радиосвязью в качестве хобби.",
                        "zh": "把业余无线电通信当作爱好的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радиолюбитель",
                                "target_lang_sense_clarification": "человек, увлекающийся радиосвязью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "业余无线电爱好者",
                                "target_lang_sense_clarification": "从事业余无线电通信的人"
                            },
                            {
                                "target_lang_word": "无线电爱好者",
                                "target_lang_sense_clarification": "较简洁说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b446fa5-3aa4-3fa4-91dd-274e82afeb07",
                    "sense_definition": "An actor or performer who overacts or uses an exaggerated, showy style.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lead actor was such a <w>ham</w> that the play felt like a parody.",
                            "target_lang_translations": {
                                "ru": "Ведущий актер так <w>переигрывал</w>, что пьеса казалась пародией.",
                                "zh": "主演真是个<w>戏精</w>，整部戏都像在演讽刺剧。"
                            }
                        },
                        {
                            "text": "He is a real <w>ham</w> who loves being the center of attention on stage.",
                            "target_lang_translations": {
                                "ru": "Он настоящий <w>ломака</w>, который обожает быть в центре внимания на сцене.",
                                "zh": "他就是个十足的<w>爱出风头的人</w>，特别喜欢在台上成为关注焦点。"
                            }
                        }
