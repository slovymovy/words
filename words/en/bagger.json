                },
                {
                    "sense_id": "61151655-c8ea-3182-ab4a-8586cda7572f",
                    "sense_definition": "A person or machine that packs items into bags.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bagging_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory installed an automatic <w>bagger</w> to speed up the packaging process.",
                            "target_lang_translations": {
