                "senses": [
                    {
                        "sense_id": "7b9be7c5-6661-3e28-ab7a-0cc80c70e85d",
                        "entry_id": "ee2ae469-e4be-3ed4-bcba-b1edd2c305da",
                        "glosses": [
                            "Anhänger der Philosophie Georg Wilhelm Friedrich Hegels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9563c5-63b4-4dba-857e-df6f7a4454ab",
                                "sense_id": "7b9be7c5-6661-3e28-ab7a-0cc80c70e85d",
                                "text": "„Als gelte es, die Vorstellung vom gespaltenen Hegel recht glaubwürdig zu machen, ließen es die Hegelianer der \"Vereinigung\" und die Hegelianer der \"Gesellschaft\" auch nicht an gegenseitigen Kränkungen fehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83f645a7-8e38-4b75-91eb-a46886807b9c",
                        "source_entry_id": "ee2ae469-e4be-3ed4-bcba-b1edd2c305da",
                        "source_sense_id": "7b9be7c5-6661-3e28-ab7a-0cc80c70e85d",
