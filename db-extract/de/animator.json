                                "target_senses": [
                                    {
                                        "sense_id": "8466a49f-606a-310c-84ca-d5f7424834f9",
                                        "entry_id": "29274f60-c652-30fd-8621-89310525de96",
                                        "glosses": [
                                            "One who creates an animation or cartoon; a cartoonist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a7544df-974b-4086-8607-3fb6bb526cdd",
                                                "sense_id": "8466a49f-606a-310c-84ca-d5f7424834f9",
                                                "text": "In recent years, animators using computer rendering have largely superseded artists working by hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304b10fb-3915-3feb-9037-98630ca69f48",
                                        "entry_id": "29274f60-c652-30fd-8621-89310525de96",
                                        "glosses": [
                                            "One who animates something; one who brings something to life or the appearance of life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf55f39-8fb1-4b77-a83f-36ff0108fdd1",
                                                "sense_id": "304b10fb-3915-3feb-9037-98630ca69f48",
                                                "text": "The android turned to gaze at its animator."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64a5f084-917c-48a7-b504-434b63a034be",
                        "source_entry_id": "1b910c0a-6668-3593-ac6d-5598641aeea7",
                        "source_sense_id": "874e8a15-ff9b-3f6e-b821-8500d686784a",
                        "source_sense_description": "Person, die Filmsequnzen erstellt",
                        "target_lang_word": "animateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "animateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Celui qui anime un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17571c25-bde6-46c9-a273-2e82118da236",
                                                "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                                                "text": "Au mois de février 1867, on le retrouve parmi les animateurs de la grande grève des bronziers parisiens."
                                            },
                                            {
                                                "example_id": "82373ed9-046b-4d4f-93fc-30b5b4256b9d",
                                                "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                                                "text": "Durant quatre ans, Vigneault assume le rôle d’animateur de cette boîte qui accueille les premiers chansonniers québécois dont Raoul Roy, Clémence Desrochers, Pauline Julien, Hervé Brousseau, Jean-Pierre Ferland, Claude Gauthier, […]."
                                            },
                                            {
                                                "example_id": "fbed40ea-c815-4df4-a577-7d51757c5748",
                                                "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                                                "text": "Sans doute est-ce pour mieux rompre en visière avec des revues grisailleuses et assommantes que l’animateur Ayguesparse fonde en 1945 Marginales dont la centième livraison date de 1965."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0411c3-ece4-30c1-8c26-6ccfea71f81f",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Celui qui réalise l’animation d’un dessin animé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4120f52d-99c1-31f5-8128-247d5ea1b56a",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Celui qui est chargé de préparer, de présenter, d'expliquer et de coordonner les divers éléments constitutifs d'une émission télévisée ou radiophonique."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ca7fbe-5644-446f-95f1-5b3bee9ee9cf",
                                                "sense_id": "4120f52d-99c1-31f5-8128-247d5ea1b56a",
                                                "text": "Pour simplifier, on peut comparer cela à un talk-show télévisé. À côté de notre animateur préféré se tiennent les combattants de la rhétorique, bien alignés pour s'interpeller à volonté. Parfois, ils parlent tous en même temps, tant et si bien qu'il est impossible d’y comprendre quoi que ce soit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa7764f0-1879-3a92-a9d0-977c3d47bd81",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Un travailleur social plus particulièrement un animateur socioculturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f5a79d5-3373-4e32-aadf-6f7659910f45",
                                                "sense_id": "fa7764f0-1879-3a92-a9d0-977c3d47bd81",
                                                "text": "De 1980 à 2000, en effet, on est passé d’un animateur « éducateur » à un professionnel d’abord gestionnaire et soucieux de réglementation autant que conscient du groupe, de ses limites et de ses conflits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c77f5954-061c-36b2-8224-b4e35447ab04",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Un enseignant dans le secteur de la formation professionnelle pour adulte ou dans la réadaptation professionnelle, dénommé animateur de formation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e70880a-bad1-37e4-9545-fc47f60be860",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Celui qui passe de la musique, notamment de variétés, dans une réunion publique ou privée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffb51577-bd11-3483-9b8d-5c996d3ece09",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Cheval qui se trouve en première position d'une course hippique et en imprime le rythme."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "animateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "335a7721-48f5-3c1f-b426-1174fe29c6ee",
                                        "entry_id": "3115f569-6a2e-384f-859b-8d612adb526a",
                                        "glosses": [
                                            "Qui anime ; qui donne du mouvement , de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee17d72d-3507-4aef-a345-e2252d351f1c",
                                                "sense_id": "335a7721-48f5-3c1f-b426-1174fe29c6ee",
                                                "text": "Elles sont lettres mortes pour qui ne sait pas les vivifier par la science du dynamisme animateur."
                                            }
                                        ]
