                "senses": [
                    {
                        "sense_id": "bf23b39b-4f54-3f3f-b63c-cf3fe900afd9",
                        "entry_id": "a8c80e86-a7f1-3815-a920-649fcc048711",
                        "glosses": [
                            "Enlever son caractère orphelin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4afbe7ae-d877-4446-911b-1e322a60bc91",
                                "sense_id": "bf23b39b-4f54-3f3f-b63c-cf3fe900afd9",
                                "text": "il y a Xxxx dans un tableau; une page orpheline peut être désorphelinée !"
                            },
                            {
                                "example_id": "6efdfa7a-1801-4df1-ae5a-9a074981ba55",
                                "sense_id": "bf23b39b-4f54-3f3f-b63c-cf3fe900afd9",
                                "text": "Est-ce qu'on peut \"désorpheliner\" le site www.wikimedia.fr en plaçant des liens vers lui sur les pages méta pertinentes?"
                            },
                            {
                                "example_id": "653cecb5-b724-4120-91f0-ecc15dfcf8e0",
                                "sense_id": "bf23b39b-4f54-3f3f-b63c-cf3fe900afd9",
                                "text": "Chère ou cher eBaby zorphelin/e/, réjouis-toi, toi qui cherchais à te désorpheliner sans trouver parents dignes de t'élever, car voici !"
                            },
                            {
                                "example_id": "48444eb9-e727-4613-87e1-248f007266cd",
                                "sense_id": "bf23b39b-4f54-3f3f-b63c-cf3fe900afd9",
                                "text": "L'idée de la buter me serait revenue, c'est sûr, mais là c'est un peu prématuré quand même, il s'est passé trop peu de temps depuis le jour où j'ai été désorphelinée sauvagement pour me découvrir un ADN DeHell."
                            }
                        ]
                    }
