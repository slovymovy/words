                    },
                    {
                        "translation_id": "513c162d-ec19-42de-b2b2-d9f1212a5d69",
                        "source_entry_id": "42839f18-0529-3c0d-b19a-b54a4ceb4c91",
                        "source_sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
