            "senses": [
                {
                    "sense_id": "471df38c-e522-3349-824c-9745c516fe99",
                    "sense_definition": "Anticipated; thought to be about to arrive or occur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>expected</w> storm never arrived, leaving the day surprisingly calm.",
                            "target_lang_translations": {
                                "ru": "<w>Ожидаемый</w> шторм так и не пришел, и день выдался удивительно спокойным.",
                                "es": "La tormenta <w>esperada</w> nunca llegó, dejando el día sorprendentemente tranquilo."
                            }
                        },
                        {
                            "text": "Everything went exactly as <w>expected</w> during the important meeting.",
                            "target_lang_translations": {
                                "ru": "На важной встрече все прошло именно так, как <w>ожидалось</w>.",
                                "es": "Todo salió exactamente como se <w>esperaba</w> durante la importante reunión."
                            }
                        }
                    ],
