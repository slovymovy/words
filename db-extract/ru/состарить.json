                            "participle",
                            "past"
                        ],
                        "form": "соста́рив"
                    },
                    {
                        "form_id": "8d2c092d-5737-4924-8d53-3f95a840adaf",
                        "entry_id": "9c0b696b-d750-35ca-9d38-59894301b701",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "соста́ривши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4966a8e5-f332-3ffb-9c28-df72773b4f5a",
                        "entry_id": "9c0b696b-d750-35ca-9d38-59894301b701",
                        "glosses": [
                            "сделать старым (в абсолютном смысле) или более старым, чем прежде (в относительном смысле)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f9c317d-82ad-4f4e-971b-825360d1472b",
                                "sense_id": "4966a8e5-f332-3ffb-9c28-df72773b4f5a",
                                "text": "Работа, дом, вечная нехватка времени — скольких женщин они надломили, преждевременно состарили! Впрочем, не всех. Лично я тогда выглядела неплохо. Не сломили меня ни канитель с Борисом, ни дежурства, ни бессонные ночи."
                            },
                            {
                                "example_id": "c104e19d-9e27-4e14-a869-4d97291e5e53",
                                "sense_id": "4966a8e5-f332-3ffb-9c28-df72773b4f5a",
                                "text": "Они взяли обычных мышей, забрали у них клетки, состарили их радиацией и подсадили эти клетки другим молодым мышам. Всего через неделю состояние мышей-реципиентов всерьёз испортилось: их здоровье стало хуже по множеству показателей, они стали медленнее бегать, а их мышцы ослабли."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f1e3945-da0e-3c0d-962b-a36756e03dea",
                        "entry_id": "9c0b696b-d750-35ca-9d38-59894301b701",
                        "glosses": [
                            "сделать так, чтобы что-либо казалось более старым, чем есть на самом деле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c855e851-e878-4fa6-8408-28c19001243b",
                                "sense_id": "7f1e3945-da0e-3c0d-962b-a36756e03dea",
                                "text": "Мы увидели три спальни: ❬…❭ Мебель — шкафы и комоды, изготовленные из дерева, которое специально «состарили». И вообще каждый предмет, будь то подставка для цветов или полочка с массой безделушек, сделан под старину."
                            },
                            {
                                "example_id": "5a7e7d14-306c-4c15-a727-ff5419de308e",
                                "sense_id": "7f1e3945-da0e-3c0d-962b-a36756e03dea",
                                "text": "Здешний пруд прославился своей скульптурной группой «Мальчик с дельфином», которая, к сожалению, исчезла. Но уже в 1995 году можно было увидеть копию скульптуры, которую искусственно состарили."
                            },
                            {
                                "example_id": "9bfbca14-1af3-4304-af9a-e85df5b316d5",
                                "sense_id": "7f1e3945-da0e-3c0d-962b-a36756e03dea",
                                "text": "Искусственно состарить лицо можно также проведя белым гримёрным карандашом линию над ресницами на верхнем веке."
                            }
                        ]
                    }
                ],
