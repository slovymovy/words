                    "sense_id": "28ad5bc2-b692-39b9-9eae-a994800c7d10",
                    "sense_definition": "Het bedrag in geld of de mate van belangrijkheid die aan iets wordt toegekend.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "economische en algemene betekenis",
                    "name_type": "no",
