                        "examples": [
                            {
                                "example_id": "b3c8b532-7d1b-4084-9bd2-152c02721ee6",
                                "sense_id": "bded4481-5a22-3d2a-9290-283fa48200db",
                                "text": "Sinds de opkomst van de Nationaalsocialistische Duitse Arbeiderspartij in Duitsland is de swastika in de westerse wereld een symbool geworden dat sterke associaties oproept met fascisme, racisme, de Tweede Wereldoorlog en de Holocaust"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04eb705d-39c2-4f31-8035-1d687447560e",
                        "source_entry_id": "a5f9a0f9-ac9a-3e60-aa90-246a659b4e0c",
                        "source_sense_id": "bded4481-5a22-3d2a-9290-283fa48200db",
                        "target_lang_word": "esvástica",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esvástica",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "54b68cb4-cb1b-352c-bf34-0b09d2471eec",
                                        "entry_id": "f01f856f-07c6-3c74-bdc2-211ed36fd8b2",
                                        "glosses": [
                                            "Variante de svástica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce99373-7ceb-41a7-b68a-b6681274288d",
                                                "sense_id": "54b68cb4-cb1b-352c-bf34-0b09d2471eec",
                                                "text": "En el país vasco francés especialmente hay bastantes estelas y casas en las que aparece una cruz que recuerda a la esvástica y a la que se llama cruz ovífila, por su contorno redondeado."
                                            },
                                            {
                                                "example_id": "362ac944-867c-4c22-a362-5673f47d706c",
                                                "sense_id": "54b68cb4-cb1b-352c-bf34-0b09d2471eec",
                                                "text": "Los botones pertenecían a las Juventudes Hitlerianas. Usaban botas y calzón de montar, guerrera con correaje y brazalete con la esvástica."
                                            },
                                            {
                                                "example_id": "8e2a895c-a9f9-4733-a229-c712eed604e4",
                                                "sense_id": "54b68cb4-cb1b-352c-bf34-0b09d2471eec",
                                                "text": "Los de Tacuara le grabaron con una navaja una esvástica en el pecho y después la dejaron irse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
