                                "ru": "Свеча горела маленьким, спокойным <w>пламенем</w>.",
                                "pl": "Świeca dawała mały, spokojny <w>płomień</w>.",
                                "de": "Die Kerze gab eine kleine, ruhige <w>Flamme</w> ab.",
                                "fr": "La bougie produisait une petite <w>flamme</w> tranquille.",
                                "it": "La candela emetteva una piccola e tranquilla <w>fiamma</w>.",
                                "cs": "Svíčka vydávala malý, klidný <w>plamen</w>.",
                                "tr": "Mum küçük, sakin bir <w>alev</w> veriyordu.",
                                "es": "La vela emitía una <w>llama</w> pequeña y tranquila.",
                                "zh": "蜡烛发出了微小而平静的<w>火苗</w>。"
                            }
                        },
                        {
                            "text": "De <w>vlammen</w> sloegen hoog uit het dak van de schuur.",
                            "target_lang_translations": {
                                "cs": "<w>Plameny</w> šlehaly vysoko ze střechy stodoly.",
                                "de": "Die <w>Flammen</w> schlugen hoch aus dem Dach der Scheune.",
                                "en": "The <w>flames</w> leapt high from the roof of the barn.",
                                "es": "Las <w>llamas</w> salían altas del tejado del granero.",
                                "fr": "Les <w>flammes</w> jaillissaient haut du toit de la grange.",
                                "it": "Le <w>fiamme</w> si alzavano alte dal tetto del fienile.",
                                "pl": "<w>Płomienie</w> buchały wysoko z dachu stodoły.",
                                "ru": "<w>Пламя</w> высоко вырывалось из крыши сарая.",
                                "tr": "<w>Alevler</w> ahırın çatısından yükseğe yükseliyordu.",
                                "zh": "<w>火焰</w>从谷仓的屋顶高高窜起。"
                            }
