        "fr-extract.jsonl": [
            {
                "entry_id": "f120eb99-4c97-33bb-bc6a-35d8ae588c07",
                "word": "universaux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4814662d-5364-3b8b-bb45-ca87d3977147",
                        "entry_id": "f120eb99-4c97-33bb-bc6a-35d8ae588c07",
                        "glosses": [
                            "Certaines idées générales, qui étaient le genre, la différence, l’espèce, le propre et l’accident."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e88ca597-7d7c-411a-8cc7-bec5f06aab50",
                                "sense_id": "4814662d-5364-3b8b-bb45-ca87d3977147",
                                "text": "Pour les conceptualistes, les universaux sont des abstracta formés par notre esprit en ne retenant d'un ensemble d'individus que les caractères qu'ils ont en commun."
                            },
                            {
                                "example_id": "718a8d47-a703-46f5-991e-91668135ade4",
                                "sense_id": "4814662d-5364-3b8b-bb45-ca87d3977147",
                                "text": "[…] un Paris éternel, sans cesse renouvelé depuis les clercs du Moyen Age discutant des universaux (et David de Dinant n’est pas loin, criant dans les flammes) jusqu’aux jeunes hommes de nos jours échangeant leurs réflexions sur Heidegger ou sur Mao."
                            },
                            {
                                "example_id": "4932e5bc-5160-428c-abfd-4cb13562052e",
                                "sense_id": "4814662d-5364-3b8b-bb45-ca87d3977147",
                                "text": "Pourquoi ? Parce que les technologies contemporaines, proposera ce livre, remettent en question non seulement la perception que nous avons du monde, mais bien aussi les universaux qui nous ont aidés, à travers les millénaires, à rendre ce monde cohérent et à rationaliser notre présence en celui-ci."
                            }
                        ]
                    }
                ],
