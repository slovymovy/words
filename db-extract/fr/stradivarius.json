                "senses": [
                    {
                        "sense_id": "96e91dd0-fcdd-35d1-9eaf-83774ab18487",
                        "entry_id": "0a0c098c-5eb4-389c-9cea-6a11c91b77f1",
                        "glosses": [
                            "Version latinisée du nom du luthier Antonio Stradivari."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6635ee4a-00c7-48aa-bddc-1a2cc30fd722",
                                "sense_id": "96e91dd0-fcdd-35d1-9eaf-83774ab18487",
                                "text": "J’ai la chance de jouer sur un instrument de 1733, qui m’offre à la fois la puissance et la rondeur des timbres : il a été construit par Montagnana à Venise, le plus célèbre luthier italien de l’époque avec Stradivarius, et il m’est prêté par une institution londonienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d0374db-60dd-3e57-99d6-823cdbcc3b7e",
                        "entry_id": "0a0c098c-5eb4-389c-9cea-6a11c91b77f1",
                        "glosses": [
                            "Instrument à cordes frottées (le plus souvent un violon) fabriqué par Antonio Stradivari."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "5f0dde0e-514c-4c61-a12e-854d10a4e796",
                                "sense_id": "2d0374db-60dd-3e57-99d6-823cdbcc3b7e",
                                "text": "« En fait, le Stadivarius n’est pas forcément le meilleur instrument. »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
