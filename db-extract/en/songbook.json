                                        "glosses": [
                                            "książka, książeczka lub zeszyt z tekstami, czasem też nutami, piosenek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481cabb6-4a08-4568-bada-c51f19a911a4",
                                                "sense_id": "fba90cd7-1e1c-30b7-bab3-3273a8815e66",
                                                "text": "Zawsze w góry zabieram swój stary, harcerski śpiewnik."
