                                        "sense_id": "11d31ba9-f292-3820-a04c-dfffb290c159",
                                        "entry_id": "1399c61e-3bf5-3618-9383-16ab4c8042f5",
                                        "glosses": [
                                            "Personne qui fait ou qui vend des gants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09728797-c42d-4942-9e34-92ee5da64141",
                                                "sense_id": "11d31ba9-f292-3820-a04c-dfffb290c159",
                                                "text": "Ce furent les Croisades qui firent pénétrer en France l'usage des parfums : on introduisait ceux-ci sous forme de peaux odoriférantes destinées à faire des pourpoints, des ceintures, des gants. Aussi s'explique-t-on que le commerce de la parfumerie ait d'abord été aux mains des gantiers."
                                            },
                                            {
                                                "example_id": "60e2581e-f5a4-4893-840c-55399f9a642e",
                                                "sense_id": "11d31ba9-f292-3820-a04c-dfffb290c159",
                                                "text": "Les ramasseurs de crottes blanches, qui revendaient la merde au kilo, à des artisans gantiers qui s’en servaient pour blanchir le cuir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gantier",
                                "target_lang_code": "fr",
                                "target_senses": [
