                        "sense_id": "8b366a7f-eeeb-33bd-9625-288eb5cde2a2",
                        "entry_id": "6df2855b-6a67-31dc-a515-842fcac81209",
                        "glosses": [
                            "etwas, das gegessen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ab047c-406e-4978-b9ee-786a4644cc53",
                                "sense_id": "8b366a7f-eeeb-33bd-9625-288eb5cde2a2",
                                "text": "„Die meisten hatten es aufgegeben, überhaupt noch nach Essbarem zu suchen.“"
                            }
                        ],
