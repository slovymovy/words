                    "sense_definition": "Говорить тихо, неразборчиво и невнятно, часто себе под нос.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "тихая невнятная речь",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он что-то смущённо <w>бормотал</w> себе под нос и не смотрел в глаза собеседнику.",
                            "target_lang_translations": {
                                "it": "<w>Borbottava</w> qualcosa tra sé e sé con imbarazzo, senza guardare negli occhi il suo interlocutore."
                            }
                        },
                        {
                            "text": "Старик сидел у окна и тихо <w>бормотал</w> непонятные слова.",
                            "target_lang_translations": {
                                "it": "Il vecchio sedeva vicino alla finestra e <w>mormorava</w> a bassa voce parole incomprensibili."
                            }
                        }
                    ],
                    "synonyms": [
                        "бубнить",
                        "лепетать"
                    ],
                    "common_phrases": [
                        "бормотать под нос",
                        "бормотать во сне"
                    ],
                    "target_lang_definitions": {
                        "it": "Parlare a voce bassa, in modo confuso e indistinto, spesso tra sé e sé."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "borbottare",
                                "target_lang_sense_clarification": "pronunciare parole a bassa voce e in modo indistinto, talvolta con fare contrariato o tra sé"
                            },
                            {
                                "target_lang_word": "biascicare",
                                "target_lang_sense_clarification": "articolare le parole in modo poco chiaro, strascicato o confuso"
                            },
                            {
                                "target_lang_word": "mormorare",
                                "target_lang_sense_clarification": "parlare a fior di labbra, a voce molto bassa"
                            },
                            {
                                "target_lang_word": "farfugliare",
                                "target_lang_sense_clarification": "dire qualcosa in modo confuso, frettoloso e poco comprensibile"
