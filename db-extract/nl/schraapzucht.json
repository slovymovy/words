                "senses": [
                    {
                        "sense_id": "718152d9-dfc7-3677-8761-686197cfe6e8",
                        "entry_id": "f02b4629-8e6d-3b7e-a457-8901f4d2783b",
                        "glosses": [
                            "te zeer gericht op het verzamelen van een kapitaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf34630-10a6-457b-8826-b86669764536",
                                "sense_id": "718152d9-dfc7-3677-8761-686197cfe6e8",
                                "text": "Schraapzucht. Een mooi woord met scherpe kantjes, dat helaas enigszins in onbruik is geraakt."
                            },
                            {
                                "example_id": "167c3138-c032-4956-9d4f-eb44cdb13531",
                                "sense_id": "718152d9-dfc7-3677-8761-686197cfe6e8",
                                "text": "De or heeft een brief geschreven aan minister Wouter Bos van Financiën, als 'eigenaar' van ABN Amro medeverantwoordelijk, volgens Van der Knijff. Het is wrang dat door de schraapzucht van de staatsbank ons bedrijf omvalt. Mét ons zullen onderaannemers en leveranciers in moeilijkheden komen."
                            }
                        ]
                    }
                ],
