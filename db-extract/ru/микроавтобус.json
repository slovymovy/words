                ],
                "senses": [
                    {
                        "sense_id": "a7b0ce7f-5d53-329e-b11a-422e6a69469d",
                        "entry_id": "3fcb92c7-c6b7-3635-83c5-6e1e8d15f774",
                        "glosses": [
                            "автомоб. автобус малого размера, мощность которого не превышает 100-120 л.с., вмещающий обычно от 5 до 15 пассажиров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922deb83-6dcb-4889-8fb2-1b91092ab6e7",
                                "sense_id": "a7b0ce7f-5d53-329e-b11a-422e6a69469d",
                                "text": "Явно нерациональное дело ― перевозить на машине, весящей тонну-полторы, лишь полтонны груза! Поэтому развозные автомобили и их разновидность ― микроавтобус, начиная с сороковых годов, выполняют со смещённой вперёд кабиной водителя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e34fbc85-4edb-420a-a0b0-80ccb2d016c7",
                        "source_entry_id": "3fcb92c7-c6b7-3635-83c5-6e1e8d15f774",
                        "source_sense_id": "a7b0ce7f-5d53-329e-b11a-422e6a69469d",
                        "target_lang_word": "minibus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minibus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fafa4d05-0c88-349a-8848-32bb1dd5f0cb",
                                        "entry_id": "3cf9ff4a-1dfb-3776-b8d1-7c52a2b40ae2",
                                        "glosses": [
                                            "A small bus, especially one used as transport for small groups."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c3b3ae-13e7-4f15-abce-609fc94c2737",
                                                "sense_id": "fafa4d05-0c88-349a-8848-32bb1dd5f0cb",
                                                "text": "Just south of Durness, at Keoldale, is a passenger-ferry across the Kyle of Durness. It links up during the summer months with a minibus service to the lonely Cape Wrath lighthouse, built of granite in 1827 on a headland 400 ft above the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee68cad5-b6b9-3162-ae27-c6bba98ecaa0",
                                        "entry_id": "3cf9ff4a-1dfb-3776-b8d1-7c52a2b40ae2",
                                        "glosses": [
                                            "A sixteen-seater vehicle used as a taxi."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08dad76f-df41-4f83-b9f9-2d209ca3473b",
                                                "sense_id": "ee68cad5-b6b9-3162-ae27-c6bba98ecaa0",
                                                "text": "Police are still searching for the gunmen who hijacked the minibus carrying school pupils taking two of the children with them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7f520f-cb69-3060-b2b3-34a751ab7da2",
                                        "entry_id": "3cf9ff4a-1dfb-3776-b8d1-7c52a2b40ae2",
                                        "glosses": [
                                            "A small four-wheeled carriage."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "326dd208-cb49-3fc4-abee-d3c41bf0546b",
                                        "entry_id": "3cf9ff4a-1dfb-3776-b8d1-7c52a2b40ae2",
                                        "glosses": [
                                            "A combined spending bill for multiple departments that is smaller than an omnibus bill."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e3c8e7-7ea5-46d5-8874-cf85c0927d87",
                                                "sense_id": "326dd208-cb49-3fc4-abee-d3c41bf0546b",
                                                "text": "The minibus is the first of two funding packages the House hopes to pass this month."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94f12301-ed59-4221-8f0c-d0b4423e5897",
                        "source_entry_id": "3fcb92c7-c6b7-3635-83c5-6e1e8d15f774",
