                    "sense_id": "00eb6930-9b6a-3dc5-bcd3-2ae621e53b0b",
                    "sense_definition": "Een eenvoudig voertuig op twee of meer wielen zonder motor, dat meestal wordt getrokken of geduwd.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer laadde de houten <w>kar</w> vol met vers hooi.",
                            "target_lang_translations": {
                                "en": "The farmer loaded the wooden <w>cart</w> full of fresh hay.",
                                "ru": "Фермер загрузил деревянную <w>телегу</w> свежим сеном.",
                                "pl": "Rolnik załadował drewnianą <w>furmankę</w> świeżym sianem.",
                                "de": "Der Bauer lud den hölzernen <w>Karren</w> voll mit frischem Heu.",
                                "fr": "Le fermier a chargé la <w>charrette</w> en bois de foin frais.",
                                "it": "Il contadino caricò il <w>carretto</w> di legno pieno di fieno fresco.",
                                "cs": "Farmář naložil dřevěný <w>vozík</w> plný čerstvého sena.",
                                "tr": "Çiftçi ahşap <w>arabayı</w> taze samanla doldurdu.",
                                "es": "El granjero cargó el <w>carro</w> de madera lleno de heno fresco.",
                                "zh": "农夫把木制<w>板车</w>装满了新鲜干草。"
                            }
                        },
                        {
                            "text": "Hij moest de zware <w>kar</w> helemaal alleen de heuvel op duwen.",
                            "target_lang_translations": {
                                "en": "He had to push the heavy <w>cart</w> up the hill all by himself.",
                                "ru": "Ему пришлось в одиночку толкать тяжелую <w>тележку</w> в гору.",
                                "pl": "Musiał pchać ciężki <w>wózek</w> pod górę zupełnie sam.",
                                "de": "Er musste den schweren <w>Karren</w> ganz alleine den Hügel hinaufschieben.",
                                "fr": "Il a dû pousser la lourde <w>charrette</w> tout seul en haut de la colline.",
                                "it": "Dovette spingere il pesante <w>carretto</w> su per la collina tutto da solo.",
                                "cs": "Musel ten těžký <w>vozík</w> vytlačit do kopce úplně sám.",
                                "tr": "Ağır <w>arabayı</w> tek başına yokuş yukarı itmek zorunda kaldı.",
                                "es": "Tuvo que empujar el pesado <w>carro</w> cuesta arriba él solo.",
                                "zh": "他不得不独自一人把那辆沉重的<w>手推车</w>推上山坡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wagen"
                    ],
                    "common_phrases": [
                        "de kar trekken",
                        "voor de kar spannen"
                    ],
                    "target_lang_definitions": {
                        "en": "A simple vehicle on two or more wheels without a motor, usually pulled or pushed.",
                        "ru": "Простое транспортное средство на двух или более колесах без мотора, которое обычно тянут или толкают.",
                        "pl": "Prosty pojazd na dwóch lub więcej kołach bez silnika, zazwyczaj ciągnięty lub pchany.",
                        "de": "Ein einfaches Fahrzeug auf zwei oder mehr Rädern ohne Motor, das meist gezogen oder geschoben wird.",
                        "fr": "Un véhicule simple sur deux roues ou plus, sans moteur, généralement tiré ou poussé.",
                        "it": "Un veicolo semplice su due o più ruote senza motore, solitamente trainato o spinto.",
                        "cs": "Jednoduchý dopravní prostředek na dvou nebo více kolech bez motoru, který se obvykle táhne nebo tlačí.",
                        "tr": "Motoru olmayan, genellikle çekilen veya itilen, iki veya daha fazla tekerlekli basit bir taşıt.",
                        "es": "Un vehículo sencillo de dos o más ruedas sin motor, que generalmente se empuja o se tira de él.",
                        "zh": "一种无动力、通常靠人力推拉的简易两轮或多轮车辆。"
                    },
