                "senses": [
                    {
                        "sense_id": "bdf3ae87-798a-3a68-80c3-734a1c310182",
                        "entry_id": "a8098ef4-e3b2-3422-a13e-18c56bb6cc9a",
                        "glosses": [
                            "To climb."
                        ],
                        "tags": [
                            "Northern-English",
                            "Scottish",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "bd912a4e-9c28-4c90-b951-57ba3d696301",
                                "sense_id": "bdf3ae87-798a-3a68-80c3-734a1c310182",
                                "text": "1832 March 5, Memoirs of a Paisley Baillie, The Day: A Journal of Literature, Fine Arts, Fashions, &c., Glasgow, page 218,\nThis I thocht at the time when he was speeling up the ladder before me in the Hie Kirk steeple ; but good breeding, at that particular time, keeped me from taking ony correck view of how things stood in that quarter."
                            },
                            {
                                "example_id": "f6cc1380-b5b9-43d2-b411-f5d68a2d6624",
                                "sense_id": "bdf3ae87-798a-3a68-80c3-734a1c310182",
                                "text": "They were catched speeling up the lamp-posts and taking oot the cruizes and drinking the ulye, wick and a′."
                            },
                            {
                                "example_id": "e903737e-b5f1-4484-a28f-ad19011a51bc",
                                "sense_id": "bdf3ae87-798a-3a68-80c3-734a1c310182",
                                "text": "1860, Hugh MacDonald, Days at the Coast: A Series of Sketches Descriptive of the Firth of Clyde, Glasgow, page 255,\nThere is a comfortable inn at this picturesque spot, where those who purpose speeling the lofty Ben generally prepare for their arduous undertaking."
                            }
                        ]
                    }
                ],
