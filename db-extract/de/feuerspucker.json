                        "source_entry_id": "6b02f540-cc38-30de-8c9f-2c9db4dc76d4",
                        "source_sense_id": "17208022-491a-3fb1-842a-a64f00d3c154",
                        "source_sense_description": "Person, welche spezielle Brandmittel gegen eine Feuerquelle pustet und erstere so entzündet",
                        "target_lang_word": "cracheur de feu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cracheur de feu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c17c9a1-9ef1-3829-a6ec-d41e44aab45c",
                                        "entry_id": "7ce55c8d-97ec-3863-bd5a-abf3a81a0e8a",
                                        "glosses": [
                                            "Personne qui souffle du combustible qui s’embrase au contact d’une flamme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3aa0df-d174-4d0b-826f-16ab717ffd53",
                                                "sense_id": "7c17c9a1-9ef1-3829-a6ec-d41e44aab45c",
                                                "text": "[…], je me suis lié d’amitié avec un cracheur de feu. Je lui ai dit : je te donne cent balles, tu m’apprends à cracher le feu, il a pris les cent balles, il m’a appris. Il y a deux méthodes pour cracher le feu : le cacao très pur et le kerdane. J’ai appris au kerdane. C’est un mélange de pétrole, je crois, je n’ai jamais très bien su. Tout l’art du cracheur de feu, c’est la vaporisation."
                                            },
                                            {
                                                "example_id": "36f178fe-2405-4037-a6aa-9f6cb25b29b4",
                                                "sense_id": "7c17c9a1-9ef1-3829-a6ec-d41e44aab45c",
                                                "text": "Il arriva plusieurs fois que des familles furieuses quittent la salle pendant le spectacle, et j’en pleurais de rage et de honte, au souvenir de mes parents et des périodes glorieuses du Circo Giacomo, quand alternaient jongleurs, danseurs, cracheurs de feu, danseurs, équilibristes et que nous avions même, durant deux ans, pris en pension un éléphant très doux appelé, justement, Dulco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a97c5ed5-e301-3536-bc02-3402d31f9feb",
                                        "entry_id": "7ce55c8d-97ec-3863-bd5a-abf3a81a0e8a",
                                        "glosses": [
                                            "Dragon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e892e87-519c-44ec-9acb-6ae6553f108b",
                                                "sense_id": "a97c5ed5-e301-3536-bc02-3402d31f9feb",
                                                "text": "[…] si j’étais toi, je sortirais d’ici en attendant qu’on l’ait examinée plus en détails et qu’on sache comment s’occuper de ce genre de dragon. Tu te souviens de ce qu’ont raconté les derniers chasseurs à avoir capturé un cracheur de feu ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
