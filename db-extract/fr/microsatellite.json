                ],
                "senses": [
                    {
                        "sense_id": "9852e6e4-835a-342f-8af2-5fb1d22d0687",
                        "entry_id": "238aa2a5-7133-3386-aade-80f96cc7ba88",
                        "glosses": [
                            "Ensemble constitué par la répétition dans le même sens d’un motif simple d’ADN de 1 à 4 nucléotides, et qui peut aller jusqu’à quelques dizaines de copies."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "9c08b456-01f2-48f3-8615-7f35b406bf01",
                                "sense_id": "9852e6e4-835a-342f-8af2-5fb1d22d0687",
                                "text": "Un microsatellite (ou séquence microsatellite) est une séquence d’ADN formée par une répétition continue de motifs composés de 1 à 4 nucléotides le plus souvent."
                            },
                            {
                                "example_id": "3c7d517a-4ce4-47e4-9648-2e03dbeffa38",
                                "sense_id": "9852e6e4-835a-342f-8af2-5fb1d22d0687",
                                "text": "Dicentrarchus labrax a été l’un des premiers poissons pour lesquels on a mis au point des sondes permettant d’analyser les microsatellites, les SPN et l’ADN mitochondrial."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ff5b899-59c7-317c-8450-b3af4eea0e01",
                        "entry_id": "238aa2a5-7133-3386-aade-80f96cc7ba88",
                        "glosses": [
                            "Satellite dont la masse est de quelques dizaines de kilogrammes."
                        ],
                        "tags": [],
                        "examples": []
                    }
