                "senses": [
                    {
                        "sense_id": "51e18d1c-ae6a-32a9-89aa-9a928c537af9",
                        "entry_id": "193ea927-26fe-3947-b8f6-11e16b25cbdd",
                        "glosses": [
                            "Handlung, bei der ein zunächst nicht lesbarer Text mittels eines Schlüssels lesbar gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6afd6bc6-0c69-4a71-afd1-3a9f566eceb5",
                                "sense_id": "51e18d1c-ae6a-32a9-89aa-9a928c537af9",
                                "text": "„Ligaturen und Abbreviaturen durchsetzen die Texte in solchem Umfang, daß es zur Entschlüsselung eines besonderen Studiums bedurfte.“"
                            },
                            {
                                "example_id": "2db7f414-b7b0-4c13-ad44-b63bdcf78c99",
                                "sense_id": "51e18d1c-ae6a-32a9-89aa-9a928c537af9",
                                "text": "„Mein Anliegen war, die Geschichte der Entschlüsselungen auch unter diesen umfassenderen Aspekten zu erzählen…“"
                            },
                            {
                                "example_id": "202dd5bb-dcd5-4aba-9545-9ed89a2a1076",
                                "sense_id": "51e18d1c-ae6a-32a9-89aa-9a928c537af9",
                                "text": "„Anders ausgedrückt: Mit einem so einfachen Code wäre schon ein wichtiger Anfang für die Entschlüsselung, die Decodierung, gemacht worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
