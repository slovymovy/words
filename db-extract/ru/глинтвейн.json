                    }
                ],
                "senses": [
                    {
                        "sense_id": "b58e1d18-1cdc-3ff4-8e4e-2990c28642fc",
                        "entry_id": "6c957898-8199-31b8-bda3-b7fb62d57c8d",
                        "glosses": [
                            "горячий алкогольный напиток, сделанный из вина, который обычно распивается в холодную погоду или на Рождество"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2de5532-81aa-445d-86d9-7c8976b6a38b",
                                "sense_id": "b58e1d18-1cdc-3ff4-8e4e-2990c28642fc",
                                "text": "Ида сварила штутгартский глинтвейн; аромат корицы и муската дымился над тёмной горячей чашей."
                            },
                            {
                                "example_id": "bb3da686-b71b-4fd2-a2e9-d9c93666af3c",
                                "sense_id": "b58e1d18-1cdc-3ff4-8e4e-2990c28642fc",
                                "text": "Сидя на палубе в шезлонге, завернувшись в шерстяной плед, потягивая глинтвейн, так приятно почувствовать себя в средневековой Германии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98810282-99c7-4194-bf5d-cdb5eb0cb9ec",
                        "source_entry_id": "6c957898-8199-31b8-bda3-b7fb62d57c8d",
                        "source_sense_id": "b58e1d18-1cdc-3ff4-8e4e-2990c28642fc",
