                    },
                    {
                        "translation_id": "e5cf9ed4-4e95-4ef3-b170-d599d737597e",
                        "source_entry_id": "666028c5-29cf-305e-969b-8eaf76a52e16",
                        "source_sense_description": "spoon for eating soup",
                        "target_lang_word": "cuillère à soupe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuillère à soupe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                        "entry_id": "dbdb6b6c-de5d-3585-8bd5-13c0939bdd4d",
                                        "glosses": [
                                            "Ustensile de table destiné à porter à la bouche des aliments liquides ou peu consistants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13cfd5b9-5d5b-4f29-82ed-9d348300f06f",
                                                "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                                "text": "Une cuillère à soupe contient 15 millilitres (ml) ou 15 centimètres-cubes (cm³), une cuillère à café 5 millilitres (ml) ou 5 centimètres-cubes (cm³)."
                                            },
                                            {
                                                "example_id": "d7d60ecd-ca40-40c1-8b1a-6005f9aeda44",
                                                "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                                "text": "Avec un vieux couteau rouillé, elle taillait des tranches minces dans sa miche ; sa cuillère à soupe, en fer blanc étamé, était de forme ronde."
                                            },
                                            {
                                                "example_id": "f6d2c4e9-3b8c-485a-b523-eb207dbb5f2a",
                                                "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                                "text": "De plus, l’élève doit avoir un coffre pour renfermer son linge sale, un parapluie, un couvert de table consistant en une cuillère à soupe, une cuillère à café, toutes les deux en argent, un couteau et une fourchette, […]."
                                            },
                                            {
                                                "example_id": "221ca6a6-b6ed-4d44-a68e-287f9818b5f1",
                                                "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                                "text": "La contenance d’une cuillère à café ou d’une cuillère à soupe est utilisée, parfois, pour exprimer une quantité de liquide (sirop, médicament)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de7e6add-9470-3eac-9499-8a8c63199fe7",
                                        "entry_id": "dbdb6b6c-de5d-3585-8bd5-13c0939bdd4d",
                                        "glosses": [
                                            "Mesure de volume de 15 ml."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5db46011-6802-4499-b685-87f3f228b59d",
                                                "sense_id": "de7e6add-9470-3eac-9499-8a8c63199fe7",
                                                "text": "À la fin, ajoutez une cuillère à soupe de crème fraîche, puis les moules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d438685-c876-35b9-82ec-13bde2a3e4dd",
                                        "entry_id": "dbdb6b6c-de5d-3585-8bd5-13c0939bdd4d",
                                        "glosses": [
                                            "ou Louche, cuillère profonde et à long manche, dont on se sert à table pour prendre le potage dans la soupière."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66d44394-48a5-4808-a2c4-ba514d38be80",
                                                "sense_id": "0d438685-c876-35b9-82ec-13bde2a3e4dd",
                                                "text": "Il faut convenir cependant qu’il lui restait de ce qu’il avait possédé jadis six couverts d’argent et une cuillère à soupe que madame Magloire regardait tous les jours avec bonheur reluire splendidement sur la grosse nappe de toile blanche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec6c6850-e2e4-48af-8875-a9c1b2dd4c16",
                        "source_entry_id": "666028c5-29cf-305e-969b-8eaf76a52e16",
                        "source_sense_description": "spoon for eating soup",
                        "target_lang_word": "Suppenlöffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suppenlöffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01828f6b-437b-300f-8adc-48437e0b7341",
                                        "entry_id": "13003bfc-eaaa-3888-9207-8f51905942c5",
                                        "glosses": [
                                            "Löffel für die Suppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2ae6a9-0fe9-46b5-9324-fb4975b6bb74",
                                                "sense_id": "01828f6b-437b-300f-8adc-48437e0b7341",
                                                "text": "„Harriet, die inzwischen mit Claire getuschelt hatte, ohne daß ihr ein einziges Wort von Nikolai entgangen wäre, klopfte mit dem tropfenden Suppenlöffel an ihr Glas.“"
                                            },
                                            {
                                                "example_id": "61e13b45-1191-487d-89a6-a3271c7d7106",
                                                "sense_id": "01828f6b-437b-300f-8adc-48437e0b7341",
                                                "text": "„Ich schlug ihr den Suppenlöffel aus der Hand, rannte in den Garten, wieder zurück ins Haus, wo das Gekreische und Geschreie in vollem Gang war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a64b5a21-f076-424c-8609-6fb10b318795",
                        "source_entry_id": "666028c5-29cf-305e-969b-8eaf76a52e16",
                        "source_sense_description": "spoon for eating soup",
                        "target_lang_word": "Esslöffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esslöffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "016a5001-e6aa-353c-b386-a170bc6b3fd7",
                                        "entry_id": "61211ae1-9d34-35aa-a28c-78d846a71c2a",
                                        "glosses": [
                                            "Gerät zur Nahrungsaufnahme, um Suppe, Brei oder Ähnliches zu essen"
                                        ],
                                        "tags": [
                                            "Küche",
                                            "Haushalt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8551fbc8-2afb-49ed-a8c8-cb4f3d1662ee",
                                                "sense_id": "016a5001-e6aa-353c-b386-a170bc6b3fd7",
                                                "text": "Die Stiftung Warentest in Berlin empfiehlt, auf dem ganzen Körper eine Menge von etwa drei Esslöffeln zu verteilen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26d03fda-81fd-411b-9ab5-734f303ebc8b",
                        "source_entry_id": "666028c5-29cf-305e-969b-8eaf76a52e16",
                        "source_sense_description": "spoon for eating soup",
                        "target_lang_word": "Löffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Löffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74c05d89-1a47-3ec6-90f9-4e19a7d35609",
                                        "entry_id": "ea0164b6-6c6b-345d-bad5-17aba8883860",
                                        "glosses": [
                                            "Teil des Bestecks zum Schöpfen, Rühren, Aufnehmen von Flüssigkeiten, insbesondere von Breien, Getränken, Mus, Suppen und Soßen; kurz für Esslöffel, Kaffeelöffel oder Teelöffel"
                                        ],
                                        "tags": [
                                            "Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c483c0-3970-4a23-9f1c-209705018600",
                                                "sense_id": "74c05d89-1a47-3ec6-90f9-4e19a7d35609",
                                                "text": "Er hat die Suppe mit dem Löffel gegessen."
                                            },
                                            {
                                                "example_id": "be8288b3-22fc-44e8-a4e2-7fa070ac29bc",
                                                "sense_id": "74c05d89-1a47-3ec6-90f9-4e19a7d35609",
                                                "text": "„Freund Blase, es gibt süßen Brei! Wo ist mein großer Löffel?“ (nach einem russischen Märchen)"
                                            },
                                            {
                                                "example_id": "fba69e10-e7ca-440f-9436-ce2b5c03e3c7",
                                                "sense_id": "74c05d89-1a47-3ec6-90f9-4e19a7d35609",
                                                "text": "„Stumm fährt er mit dem Löffel in seinem nun fast leeren Becher umher.“"
                                            },
                                            {
                                                "example_id": "04aba84d-8260-42fe-8970-c092f0342c2a",
                                                "sense_id": "74c05d89-1a47-3ec6-90f9-4e19a7d35609",
                                                "text": "„Er nimmt einen Löffel voller Gurken- und Tomatenstücke in den Mund und spricht dann auf Deutsch weiter.“"
                                            },
                                            {
                                                "example_id": "1c178e69-2540-4c03-a1d0-d7eeeb81039c",
                                                "sense_id": "74c05d89-1a47-3ec6-90f9-4e19a7d35609",
                                                "text": "„Ich konnte mich an dem Löffel festhalten, konnte die Bohnen erkennen, Spuren von Eiweiß und Eidotter darin, die Scheibe Brot, die immer kleiner wurde.“"
                                            },
                                            {
                                                "example_id": "97b27097-c12b-4590-83dc-d56692391a31",
                                                "sense_id": "74c05d89-1a47-3ec6-90f9-4e19a7d35609",
                                                "text": "„Ihre Mutter aß einen Löffel Flan und seufzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bfe264c4-5af6-30cb-b968-6478ee8bc4f6",
                                        "entry_id": "ea0164b6-6c6b-345d-bad5-17aba8883860",
                                        "glosses": [
                                            "Ohren von Tieren, besonders bei Hasen und Kaninchen"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f74cdd-189a-4f5c-b3a2-33de31e579f3",
                                                "sense_id": "bfe264c4-5af6-30cb-b968-6478ee8bc4f6",
                                                "text": "Der Hase spitzt seine Löffel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5fbe0b7f-4b2f-3812-a627-6217a40672b9",
                                        "entry_id": "ea0164b6-6c6b-345d-bad5-17aba8883860",
                                        "glosses": [
                                            "Ohren (beim Menschen)"
                                        ],
                                        "tags": [
                                            "casual",
                                            "figurative",
                                            "humorous",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5cc1947-cb7e-4edf-b0f7-5406f16bcbb9",
                                                "sense_id": "5fbe0b7f-4b2f-3812-a627-6217a40672b9",
                                                "text": "In seiner Jugend bezog Paul regelmäßig welche hinter die Löffel."
                                            },
                                            {
                                                "example_id": "6e786660-77a4-48d7-a0f5-984c175e8591",
                                                "sense_id": "5fbe0b7f-4b2f-3812-a627-6217a40672b9",
                                                "text": "„Als Mama mich mit dem Marmeladenbrot sah, kriegte ich ein paar hinter die Löffel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fbc04560-4289-3786-9055-9a76e6323ae7",
                                        "entry_id": "ea0164b6-6c6b-345d-bad5-17aba8883860",
                                        "glosses": [
                                            "technisches Gerät zum Schöpfen, Greifen, Abmessen, Aufnehmen und Rühren sowie den Transport von Flüssigkeiten und losen Gütern (Brei, Teig, Mörtel, Erde)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9843b4a5-b8d9-48ea-8353-4079d42f4373",
                                                "sense_id": "fbc04560-4289-3786-9055-9a76e6323ae7",
                                                "text": "Das Substrat wird üblicherweise mit einem Löffel umgerührt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9b6663ba-4062-3173-aaef-4ba05849e232",
                                        "entry_id": "ea0164b6-6c6b-345d-bad5-17aba8883860",
                                        "glosses": [
                                            "als Küchenmaß/Mengenangabe für Esslöffel oder Teelöffel"
                                        ],
                                        "tags": [
                                            "mit Formen wie drei Löffel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d1bf74-d439-433b-bbf1-6e5494a950d0",
                                                "sense_id": "9b6663ba-4062-3173-aaef-4ba05849e232",
                                                "text": "Sie wünscht drei Löffel Zucker in ihren Kaffee."
                                            }
                                        ],
