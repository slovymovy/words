    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "073b9759-57fb-370c-ae30-2f950213b0f5",
                    "sense_definition": "The profession of educating people or the act of imparting knowledge.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to pursue a career in <w>teaching</w> because she loves working with children.",
                            "target_lang_translations": {
                                "ru": "Она решила сделать карьеру в <w>преподавании</w>, потому что любит работать с детьми."
                            }
                        },
                        {
                            "text": "The school is currently looking for a new <w>teaching</w> assistant to help in the classroom.",
                            "target_lang_translations": {
                                "ru": "В настоящее время школа ищет нового <w>помощника учителя</w>, чтобы помогать в классе."
                            }
                        }
                    ],
                    "synonyms": [
                        "tutelage"
                    ],
                    "common_phrases": [
                        "teaching assistant",
                        "teaching methods",
                        "teaching profession",
                        "online teaching"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессия педагога или деятельность по передаче знаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преподавание",
                                "target_lang_sense_clarification": "процесс передачи знаний в учебном заведении"
                            },
                            {
                                "target_lang_word": "обучение",
                                "target_lang_sense_clarification": "процесс или деятельность по обучению кого-либо"
                            },
                            {
                                "target_lang_word": "педагогическая деятельность",
                                "target_lang_sense_clarification": "профессиональная сфера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1271244-1a68-3379-962a-71b68c3c4716",
                    "sense_definition": "A set of ideas or principles taught by a religious, philosophical, or moral authority.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doctrine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people around the world still follow the <w>teachings</w> of Confucius today.",
                            "target_lang_translations": {
                                "ru": "Многие люди во всем мире и сегодня следуют <w>учению</w> Конфуция."
                            }
                        },
                        {
                            "text": "The core <w>teachings</w> of this philosophy emphasize the importance of inner peace.",
                            "target_lang_translations": {
                                "ru": "Основные <w>положения</w> этой философии подчеркивают важность внутреннего мира."
                            }
                        }
                    ],
                    "common_phrases": [
                        "religious teachings",
                        "core teachings",
                        "moral teachings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность идей или принципов, проповедуемых религиозным, философским или моральным авторитетом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учение",
                                "target_lang_sense_clarification": "система взглядов или догматов"
                            },
                            {
                                "target_lang_word": "доктрина",
                                "target_lang_sense_clarification": "научная или политическая теория"
                            },
                            {
                                "target_lang_word": "заповеди",
                                "target_lang_sense_clarification": "моральные или религиозные наставления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d9445eb-08a9-3196-99c9-5e829aef8dc7",
                    "sense_definition": "The present participle and gerund of <w>teach</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>teaching</w> mathematics at the local high school.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он <w>преподает</w> математику в местной средней школе."
                            }
                        },
                        {
                            "text": "I enjoy <w>teaching</w> English to students from different countries.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>преподавать</w> английский студентам из разных стран."
                            }
                        }
                    ],
                    "traits": [
