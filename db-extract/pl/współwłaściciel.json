                                            {
                                                "example_id": "5455817b-e0c1-461a-ba48-39cf10974d85",
                                                "sense_id": "82f79d2b-6df3-3b33-9e19-f2d2fa149bf7",
                                                "text": "[…] when a gay man really does die of something other than AIDS, as in the case of Tom Norton, the popular coowner of Unabridged Books, festering doubt will plague his memory."
                                            },
                                            {
                                                "example_id": "adc387cf-7256-4a71-bfa7-abcce03fb25b",
                                                "sense_id": "82f79d2b-6df3-3b33-9e19-f2d2fa149bf7",
                                                "text": "She praised Mythic Talent co-owner Asmongold for arguing, “Every trans kid is actually a victim of a parent with a mental illness.”"
                                            }
