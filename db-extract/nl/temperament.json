                    },
                    {
                        "translation_id": "af8fbc2d-6318-4453-88ac-888ed581c9dd",
                        "source_entry_id": "9fe9421b-5106-3926-aca0-5f6b0988ca9f",
                        "target_lang_word": "tempérament",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tempérament",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef468a8d-5c3d-3db8-b451-288625db95c0",
                                        "entry_id": "1aee71d2-9267-34f1-ab82-93ae31af8422",
                                        "glosses": [
                                            "Complexion, constitution du corps, en parlant des personnes, voire des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60640d8c-da96-4d8f-9ce9-46ce634584e4",
                                                "sense_id": "ef468a8d-5c3d-3db8-b451-288625db95c0",
                                                "text": "Quoique La Brière fût alors mince, il appartient à ce genre de tempéraments qui, formés tard, prennent à trente ans un embonpoint inattendu."
                                            },
                                            {
                                                "example_id": "e8871c2a-2b90-47bc-9423-506bb2d4e1d0",
                                                "sense_id": "ef468a8d-5c3d-3db8-b451-288625db95c0",
                                                "text": "Quelle différence, en effet, entre le cheval arabe léger, vif, sanguin, et les gros chevaux du Danemarck, du Hanovre, de la Hollande et de la Normandie aux formes lourdes et empâtées et au tempérament essentiellement lymphatique."
                                            },
                                            {
                                                "example_id": "4fad5070-f403-4b36-a9f5-df866a462138",
                                                "sense_id": "ef468a8d-5c3d-3db8-b451-288625db95c0",
                                                "text": "Tempérament bilieux, sanguin, lymphatique, nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94915c17-f391-3ee0-8691-b17c0cac2c38",
                                        "entry_id": "1aee71d2-9267-34f1-ab82-93ae31af8422",
                                        "glosses": [
                                            "Caractère ; disposition mentale."
                                        ],
                                        "tags": [],
                                        "note": "On y joint une épithète qui qualifie ce caractère",
                                        "examples": [
                                            {
                                                "example_id": "aae733df-c578-4e35-a746-cbb1ef0283a6",
                                                "sense_id": "94915c17-f391-3ee0-8691-b17c0cac2c38",
                                                "text": "[…]; sans doute, ils ont, eux aussi, certains du moins, des ascendants névrosiques, mais la mysophobie atteint le plus souvent des gens minutieux ou méticuleux par tempérament, par exemple, des vieilles filles ou des garçons âgés, célibataires."
                                            },
                                            {
                                                "example_id": "b57a6dac-9d62-442b-80f4-a77539935169",
                                                "sense_id": "94915c17-f391-3ee0-8691-b17c0cac2c38",
                                                "text": "Là encore mes amis, vous avez fait de l'excellente besogne et vous l'avez faite sans bruit, sans flafla, comme toujours, avec cette application silencieuse qui est dans le tempérament marin, très réservé de sa nature."
                                            },
                                            {
                                                "example_id": "c82d20ae-b766-4425-b08b-0490c9ee10b4",
                                                "sense_id": "94915c17-f391-3ee0-8691-b17c0cac2c38",
                                                "text": "Se venger, les tuer ! La violence naturelle à son tempérament sanguin lui dicta les pires conseils."
                                            },
                                            {
                                                "example_id": "877a0a7e-003c-4804-82d2-a5d08daea807",
                                                "sense_id": "94915c17-f391-3ee0-8691-b17c0cac2c38",
                                                "text": "L’allégresse qu’ils semaient le long de la route affectait diversement, et selon leurs tempéraments, les autres excursionnistes."
                                            },
                                            {
                                                "example_id": "83febe7c-d420-441d-bcf2-c682411b2046",
                                                "sense_id": "94915c17-f391-3ee0-8691-b17c0cac2c38",
                                                "text": "Il y avait de quoi désespérer ou attaquer ces misogynes qui niaient aux femmes le droit d'écrire et de défendre leurs talents selon leur propre tempérament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9492f48c-486c-31c8-97d6-d100959e3a34",
                                        "entry_id": "1aee71d2-9267-34f1-ab82-93ae31af8422",
                                        "glosses": [
                                            "Action de tempérer, adoucissement qu’on propose pour concilier les esprits et pour accommoder les affaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b6492f3-3cfe-482f-b0a0-bf13927bdcc0",
                                                "sense_id": "9492f48c-486c-31c8-97d6-d100959e3a34",
                                                "text": "Proposer divers tempéraments pour concilier des intérêts opposés."
                                            },
                                            {
                                                "example_id": "ce6f0dda-53db-414b-897d-cbfc6ab09b8e",
                                                "sense_id": "9492f48c-486c-31c8-97d6-d100959e3a34",
                                                "text": "Il faut essayer de trouver un tempérament à cela."
                                            },
                                            {
                                                "example_id": "c560a1b1-c934-45b3-aad4-4f4df77768b8",
                                                "sense_id": "9492f48c-486c-31c8-97d6-d100959e3a34",
                                                "text": "Pour le duc de La Rochefoucauld..., qui ne connaît pas de tempérament à la perversité humaine, il n'existe pas de véritable amitié. Aussi écoutons-le : \"Ce que les hommes ont nommé « amitié » n'est qu'une société, qu'un mesnagement réciproque d'interests et qu'un eschange de bons offices\"."
                                            },
                                            {
                                                "example_id": "cbea645f-9b0f-47a4-a50c-0e850759b66b",
                                                "sense_id": "9492f48c-486c-31c8-97d6-d100959e3a34",
                                                "text": "Dans leur désir de conserver leur privilège d’amodiateurs des chaumes, les habitants du Val Saint-Grégoire accédèrent ensuite à de successifs tempéraments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "464d81b8-3812-33c1-a4d3-a6f6cf00e725",
                                        "entry_id": "1aee71d2-9267-34f1-ab82-93ae31af8422",
                                        "glosses": [
                                            "Limitation, atténuation ou assouplissement d’une loi ou d'une norme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aba4e969-339e-3560-adc3-4233704842d2",
                                        "entry_id": "1aee71d2-9267-34f1-ab82-93ae31af8422",
                                        "glosses": [
                                            "Altération légère qu’on fait subir aux demi-tons chromatiques et aux demi-tons diatoniques pour les unifier et pour qu’ils puissent être rendus par la même corde, par la même touche d’un instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7c1a4d6-ebf9-4cdc-ba88-f127f0e94b08",
                                                "sense_id": "aba4e969-339e-3560-adc3-4233704842d2",
                                                "text": "Au moyen du tempérament, le ré dièse et le mi bémol sont rendus par la même corde du piano."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
