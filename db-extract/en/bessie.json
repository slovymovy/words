                    {
                        "sense_id": "35a07916-c1a7-3f1e-9673-9f15b008102a",
                        "entry_id": "11ced294-cd22-302f-bb88-1af7cf07f009",
                        "glosses": [
                            "A diminutive of the female given name Elizabeth, also used as a formal female given name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d2f888-8766-4bd7-81d2-c48a84d183b6",
                                "sense_id": "35a07916-c1a7-3f1e-9673-9f15b008102a",
                                "text": "Bessie - I beg your pardon, but I do so like the name 'Bessie'; and the best is, that you always say these pretty things as if you meant them."
                            },
                            {
                                "example_id": "160998e3-59be-426a-911c-c41f13bbe8d7",
                                "sense_id": "35a07916-c1a7-3f1e-9673-9f15b008102a",
                                "text": "\"Dear Bessie - \" Elizabeth had never asked her not to call her that, although she fairly detested the name. But still it had been her mother's name, and was likely dear to her grandmother. It seemed disloyalty to her mother to suggest that she be called \"Elizabeth\"."
                            }
                        ]
                    },
