            {
                "entry_id": "2758f989-839e-3e06-bcae-47d378d6a154",
                "word": "actine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9fe171ce-ae56-4ec8-8da8-e60999f3273a",
                        "entry_id": "2758f989-839e-3e06-bcae-47d378d6a154",
                        "tags": [
                            "plural"
