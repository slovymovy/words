                                                "sense_id": "57dc0115-ee93-33ef-9d8e-d11dae873667",
                                                "text": "Grand colombier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b7750b-201d-3e18-94e4-93340c6601a1",
                                        "entry_id": "2411c6a0-87b6-3694-b632-6227d62fd780",
                                        "glosses": [
                                            "Grand espace laissé entre les mots."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a366df6f-41d5-43a0-ba9b-fc2abf7a290e",
                                                "sense_id": "58b7750b-201d-3e18-94e4-93340c6601a1",
                                                "text": "Colombiers, en terme d’Imprimerie, se dit du trop grand espace qu’on laisse entre les mots."
