                "forms": [
                    {
                        "form_id": "763df63f-5a41-446e-9297-0986f7619ca5",
                        "entry_id": "a4b3af36-a822-35e9-b2eb-637898913c15",
                        "tags": [
                            "plural"
                        ],
                        "form": "strombolis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8eec2559-169a-36bc-afa6-41b245576fe9",
                        "entry_id": "a4b3af36-a822-35e9-b2eb-637898913c15",
                        "glosses": [
                            "Pizza roulée mozzarella, charcuterie italienne tel du salami, de la coppa ou de la bresaola ainsi que des légumes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce0affe0-fcdb-4b18-83bb-49b27587df85",
                                "sense_id": "8eec2559-169a-36bc-afa6-41b245576fe9",
                                "text": "Pour laisser passer l’air durant la cuisson, réalisez des fentes sur le dessus. Cassez un œuf, gardez le jaune et étalez-le à l’aide d’un pinceau de cuisine sur votre stromboli."
                            },
                            {
                                "example_id": "0a62fa76-75f9-4d99-a74b-a4fbc2e82a64",
                                "sense_id": "8eec2559-169a-36bc-afa6-41b245576fe9",
                                "text": "Deuxième différence : la forme. On utilise pour le stromboli une pâte rectangulaire qui est roulée puis scellée, tandis que le calzone est une pâte ronde pliée en deux et fermée pour être frite ou cuite au four."
                            },
                            {
                                "example_id": "0d023dda-53a0-4ac6-99c2-45d2a17fbd80",
                                "sense_id": "8eec2559-169a-36bc-afa6-41b245576fe9",
                                "text": "La pizza Stromboli a été imaginée aux Etats-Unis et plus précisément à Philadelphie. Il s’agit d’une recette de pizza roulée et garnie de jambon, de fromage et de sauce pour pizza. Ce roulé est un cousin de la pizza et plus précisément de la calzone dont il se rapproche le plus, avec la spécificité d’une cuisson avec une pâte à pizza fermée et soudée."
                            }
                        ]
                    }
                ],
