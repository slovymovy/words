                    {
                        "translation_id": "6a701720-76a5-4523-9866-1560c2db56f4",
                        "source_entry_id": "7a0f6fe4-1176-3738-a241-18fef61e8e48",
                        "source_sense_description": "to bring about the catalysis of a chemical reaction",
                        "target_lang_word": "catalyser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catalyser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8924b211-dfef-3218-91cb-86573f36d57e",
                                        "entry_id": "c06e6eb9-3c5a-3125-914f-a5be231676df",
                                        "glosses": [
                                            "Modifier la vitesse d’une réaction chimique à l’aide d’un catalyseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e529221-f1ed-4590-8eec-5081160de21a",
                                                "sense_id": "8924b211-dfef-3218-91cb-86573f36d57e",
                                                "text": "Le fer (Fe) est l’un des composants essentiels du processus cellulaire et physiologique. Cependant, sa faible solubilité et sa capacité à catalyser la formation d’oxydants toxiques sont des problèmes majeurs pour son utilisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ec71cc6-70b9-384f-b0fa-cbc96ca14db5",
                                        "entry_id": "c06e6eb9-3c5a-3125-914f-a5be231676df",
                                        "glosses": [
                                            "Déclencher, susciter une réaction, une émotion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa218f4-0ba7-4df9-ae5a-5f54d9e95d04",
                                                "sense_id": "6ec71cc6-70b9-384f-b0fa-cbc96ca14db5",
                                                "text": "Et c’est vrai que je catalysais sa colère, j’augmentais son énervement si je tremblais quand il élevait la voix."
                                            },
                                            {
                                                "example_id": "a90982be-7105-406b-9a56-9670667844ec",
                                                "sense_id": "6ec71cc6-70b9-384f-b0fa-cbc96ca14db5",
                                                "text": "Et on crie tellement fort qu'on ne s'aperçoit pas que le fait de crier catalyse les changements qu'on essaie d'enrayer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
