                ],
                "senses": [
                    {
                        "sense_id": "c940d2e4-6c03-3be0-ba58-60292bb05933",
                        "entry_id": "82ea0e77-522e-3d46-b9e5-6c0124cffb48",
                        "glosses": [
                            "Mettre une crête à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbe75b20-41ff-45f5-a420-6d9fe0abacaa",
                                "sense_id": "c940d2e4-6c03-3be0-ba58-60292bb05933",
                                "text": "Les cheveux drus, emmêlés, crêtaient d’une broussaille rousse, presque rouge, le front bombé, les joues pleines et dures."
                            },
                            {
                                "example_id": "27f034d8-9293-4c57-986a-bf8d47fa8328",
                                "sense_id": "c940d2e4-6c03-3be0-ba58-60292bb05933",
                                "text": "Sur le sommet en forme de table, fantastique dalle plate et blanche comme un autel dressé pour des sacrifices à la mesure des mondes, la neige immobile, la neige éternelle commençait à vivre d’un bouillonnement mystérieux et devenait une écume tantôt creusée, tantôt crêtée de vermeil, d’orange, de nacre et d’or."
                            }
                        ]
                    },
                    {
                        "sense_id": "46910fee-34cd-3dad-85ec-3b760be0100a",
                        "entry_id": "82ea0e77-522e-3d46-b9e5-6c0124cffb48",
                        "glosses": [
                            "Constituer une crête, un moment plus important que les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c24c11d3-b17a-4008-ad84-801a11deb3db",
                                "sense_id": "46910fee-34cd-3dad-85ec-3b760be0100a",
                                "text": "Des vagues de peur, d’indignation, d’allégresse crêtaient le cours sans surprise des jours."
                            }
                        ]
                    }
                ],
