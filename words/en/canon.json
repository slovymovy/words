{
    "word_family": [
        "canonical",
        "canonize",
        "canonization",
        "canonist",
        "canonicity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60a6ba14-e287-3ae8-9453-1ea8492c01a2",
                    "sense_definition": "A group of literary works or artistic creations that are generally accepted as representing the best, most important, or most influential in a field.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "standard_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students at the university spend a year studying the Western <w>canon</w>.",
                            "target_lang_translations": {
                                "ru": "Студенты университета год изучают западный <w>канон</w>.",
                                "zh": "大学生们花了一年时间研读西方<w>经典</w>。"
                            }
                        },
                        {
                            "text": "This novel has recently been added to the literary <w>canon</w>.",
                            "target_lang_translations": {
                                "ru": "Этот роман недавно был включён в литературный <w>канон</w>.",
                                "zh": "这部小说最近被列入了文学<w>经典</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "literary canon",
                        "Western canon",
                        "established canon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа литературных произведений или художественных творений, которые общепризнаны как представляющие лучшее, наиболее важное или влиятельное в своей области.",
                        "zh": "指在某一领域中被公认为最优秀、最重要或最具影响力的文学或艺术作品集。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канон",
                                "target_lang_sense_clarification": "совокупность признанных произведений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经典",
                                "target_lang_sense_clarification": "公认的杰作"
                            },
                            {
                                "target_lang_word": "典范",
                                "target_lang_sense_clarification": "标准作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "652ae90f-d623-34f8-a373-bcef67cd933b",
                    "sense_definition": "The collection of works, events, or details considered to be the authentic and official history of a fictional universe.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fictional_continuity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fans often debate which comic books are part of the official <w>canon</w>.",
                            "target_lang_translations": {
                                "ru": "Фанаты часто спорят, какие комиксы входят в официальный <w>канон</w>.",
                                "zh": "粉丝们经常争论哪些漫画书属于官方<w>正史</w>。"
                            }
                        },
                        {
                            "text": "The new movie contradicts the established <w>canon</w> of the series.",
                            "target_lang_translations": {
                                "ru": "Новый фильм противоречит установленному <w>канону</w> серии.",
                                "zh": "这部新电影与该系列既定的<w>正史</w>相矛盾。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "official canon",
                        "head canon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in fandom contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность произведений, событий или деталей, считающихся подлинной и официальной историей вымышленной вселенной.",
                        "zh": "在虚构作品中，被视为该世界观下真实且官方的历史、事件或细节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канон",
                                "target_lang_sense_clarification": "в вымышленных вселенных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正史",
                                "target_lang_sense_clarification": "虚构世界中的官方设定"
                            },
                            {
                                "target_lang_word": "原著设定",
                                "target_lang_sense_clarification": "官方认可的背景"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13a46e23-9279-3fac-91e8-0950e38779a5",
                    "sense_definition": "A generally accepted rule, principle, or standard of judgment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rule_principle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trial must proceed according to the strict <w>canons</w> of law.",
                            "target_lang_translations": {
                                "ru": "Судебное разбирательство должно проходить в строгом соответствии с <w>канонами</w> права.",
                                "zh": "审判必须严格按照法律<w>准则</w>进行。"
                            }
                        },
                        {
                            "text": "He violated the accepted <w>canons</w> of polite society.",
                            "target_lang_translations": {
                                "ru": "Он нарушил принятые <w>каноны</w> светского общества.",
                                "zh": "他违背了上流社会公认的<w>规范</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "canon of law",
                        "moral canon"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общепринятое правило, принцип или стандарт суждения.",
                        "zh": "普遍接受的规则、原则或判断标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канон",
                                "target_lang_sense_clarification": "правило, норма"
                            },
                            {
                                "target_lang_word": "правило",
                                "target_lang_sense_clarification": "предписание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准则",
                                "target_lang_sense_clarification": "行为或判断的标准"
                            },
                            {
                                "target_lang_word": "规范",
                                "target_lang_sense_clarification": "公认的规则"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d586b45-8fe6-3e9c-b9e0-907fb9b02239",
                    "sense_definition": "A piece of music in which the same melody is played by different voices or instruments starting at different times.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir learned to sing a simple <w>canon</w> for the concert.",
                            "target_lang_translations": {
                                "ru": "Хор разучил простой <w>канон</w> для концерта.",
                                "zh": "合唱团为音乐会学习演唱了一首简单的<w>卡农</w>。"
                            }
                        },
                        {
                            "text": "Pachelbel’s <w>Canon</w> is a very popular piece for weddings.",
                            "target_lang_translations": {
                                "ru": "«<w>Канон</w>» Пахельбеля — очень популярное произведение для свадеб.",
                                "zh": "帕赫贝尔的《<w>卡农</w>》是婚礼上非常受欢迎的曲目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in canon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальное произведение, в котором одна и та же мелодия исполняется разными голосами или инструментами, вступающими в разное время.",
                        "zh": "一种音乐形式，即同一旋律由不同的声部或乐器在不同时间先后进入并重叠演奏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канон",
                                "target_lang_sense_clarification": "музыкальная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡农",
                                "target_lang_sense_clarification": "音乐曲式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ee0b220-3482-3ef7-92a6-dbfb681dd236",
                    "sense_definition": "A law or body of laws established by a church.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bishop explained that the decision was based on <w>canon</w> law.",
                            "target_lang_translations": {
                                "ru": "Епископ объяснил, что решение основано на <w>каноническом</w> праве.",
                                "zh": "主教解释说，该决定是基于<w>教会法</w>作出的。"
                            }
                        },
                        {
                            "text": "Scholars of <w>canon</w> law studied the ancient texts carefully.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>канонического</w> права внимательно изучали древние тексты.",
                                "zh": "研究<w>教会法</w>的学者们仔细研读了这些古籍。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "canon law"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "religious"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Закон или свод законов, установленных церковью.",
                        "zh": "由教会制定的法律或法规。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канон",
                                "target_lang_sense_clarification": "церковное правило"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教会法",
                                "target_lang_sense_clarification": "宗教法律"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ce50195-88a7-3b1a-ad4a-f58aca6eacc3",
                    "sense_definition": "A member of the clergy who serves in a cathedral or collegiate church.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clergy_member",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>canon</w> led the evening prayers at the cathedral.",
                            "target_lang_translations": {
                                "ru": "<w>Каноник</w> провёл вечернюю молитву в соборе.",
                                "zh": "那位<w>法政牧师</w>在主教座堂主持了晚祷。"
                            }
                        },
                        {
                            "text": "She spoke with <w>Canon</w> Smith about the upcoming festival.",
                            "target_lang_translations": {
                                "ru": "Она поговорила с <w>каноником</w> Смитом о предстоящем фестивале.",
                                "zh": "她与史密斯<w>法政牧师</w>谈论了即将到来的节日。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "religious"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член духовенства, служащий в кафедральном соборе или коллегиальной церкви.",
                        "zh": "在主教座堂或协同教堂任职的教士。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каноник",
                                "target_lang_sense_clarification": "священнослужитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "法政牧师",
                                "target_lang_sense_clarification": "教会职衔"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be37f039-1b71-3749-9353-52f41aab63e7",
                    "sense_definition": "Considered to be part of the official story or continuity of a fictional universe.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fictional_continuity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spinoff book series is not considered <w>canon</w> by the creators.",
                            "target_lang_translations": {
                                "ru": "Серия книг-спин-оффов не считается создателями <w>каноном</w>.",
                                "zh": "创作者并不认为该衍生系列丛书是<w>正统的</w>。"
                            }
                        },
                        {
                            "text": "Fans were happy that the popular character finally became <w>canon</w>.",
                            "target_lang_translations": {
                                "ru": "Фанаты были счастливы, что популярный персонаж наконец стал <w>каноничным</w>.",
                                "zh": "粉丝们很高兴那个受欢迎的角色终于成为了<w>正统</w>设定。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-canon"
                    ],
                    "common_phrases": [
                        "considered canon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in fandom contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Считающийся частью официальной истории или непрерывности вымышленной вселенной.",
                        "zh": "被视为虚构世界官方故事或连续性的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каноничный",
                                "target_lang_sense_clarification": "соответствующий канону"
                            },
                            {
                                "target_lang_word": "канонический",
                                "target_lang_sense_clarification": "официальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正统的",
                                "target_lang_sense_clarification": "符合官方设定的"
                            },
                            {
                                "target_lang_word": "官方的",
                                "target_lang_sense_clarification": "被认可的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ab6ac20b-964d-3962-9d28-4673b7e7c332",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Canon</w> signed the guestbook at the hotel.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кэнон</w> расписался в гостевой книге отеля.",
                                "zh": "<w>卡农</w>先生在酒店的访客簿上签了名。"
                            }
                        },
                        {
                            "text": "We met a family named <w>Canon</w> during our trip.",
                            "target_lang_translations": {
                                "ru": "Мы встретили семью по фамилии <w>Кэнон</w> во время нашей поездки.",
                                "zh": "我们在旅行中遇到了一户姓<w>卡农</w>的人家。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кэнон",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡农",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
