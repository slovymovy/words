                "senses": [
                    {
                        "sense_id": "5b684f00-4a19-3e61-b849-b380044f519c",
                        "entry_id": "c4f9f431-d496-3804-83fd-c87bbeaa6cd2",
                        "glosses": [
                            "Römische Märtyrerin aus dem 3. Jahrhundert nach Christus. Cäcilia ist die Schutzpatronin der Musik und Kirchenmusik sowie der Musikinstrumente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4dc4652-d4ca-4c0a-8da3-49c75875aea1",
                                "sense_id": "5b684f00-4a19-3e61-b849-b380044f519c",
                                "text": "Die Attribute der Heiligen Cäcilia sind der Blumenstrauß, die Orgel und andere Musikinstrumente. In vielen Darstellungen spielt Cäcilia selbst diese Instrumente."
                            },
                            {
                                "example_id": "66b2b20a-346e-4058-8998-0e832d48dca4",
                                "sense_id": "5b684f00-4a19-3e61-b849-b380044f519c",
                                "text": "Charles Gounod hat zu Ehren der Heiligen Cäcilia die Cäcilienmesse komponiert und sie am 22 November 1855, dem Jahrestag Cäcilias, in Paris uraufgeführt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "567bf2c1-1d4a-44e8-b84a-8f8bec99d0b2",
                        "source_entry_id": "c4f9f431-d496-3804-83fd-c87bbeaa6cd2",
                        "source_sense_id": "5b684f00-4a19-3e61-b849-b380044f519c",
                        "source_sense_description": "Schutzpatronin der Musik und Kirchenmusik sowie der Musikinstrumente",
                        "target_lang_word": "Cecilia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cecilia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6a85ac-1ff2-3abd-b2a9-805ad7a84da9",
                                        "entry_id": "da70de13-5ad9-3e02-b544-99540c72f31a",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba31879b-094f-4e20-88a0-e7d0402a2915",
                                                "sense_id": "ee6a85ac-1ff2-3abd-b2a9-805ad7a84da9",
                                                "text": "Hark how the flutes and trumpets raise / At bright Cecilia's name, their lays!"
                                            },
                                            {
                                                "example_id": "00ef947c-a9e4-4157-b88c-1c63d855a837",
                                                "sense_id": "ee6a85ac-1ff2-3abd-b2a9-805ad7a84da9",
                                                "text": "‘Sissy is not a name,’ said Mr. Gradgrind. ‘Don’t call yourself Sissy. Call yourself Cecilia.’ ‘It’s father as calls me Sissy, sir,’ returned the young girl in a trembling voice, and with another curtsey. ‘Then he has no business to do it,’ said Mr. Gradgrind. ‘Tell him he mustn’t. Cecilia Jupe. Let me see. What is your father?’"
                                            },
                                            {
                                                "example_id": "a53528c9-e2fd-4199-8625-31affd809b23",
                                                "sense_id": "ee6a85ac-1ff2-3abd-b2a9-805ad7a84da9",
                                                "text": "Because they had named her Cecilia, her parents fancied that the matter of her life and character had been fairly well settled. She would, of course, be quiet and pale and mystical, like the saint whose picture hung above the old upright piano in the Kirby living-room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
