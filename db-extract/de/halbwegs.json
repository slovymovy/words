                        "target_lang_word": "halverwege",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halverwege",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4d2a61c5-abc1-3b76-a990-fb4fbdd7cda1",
                                        "entry_id": "fe746711-a0a8-3461-b075-ceea3aaf7e91",
                                        "glosses": [
                                            "op het middelpunt van een weg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305e95aa-493a-4bcb-b670-4cd0815ab812",
                                                "sense_id": "4d2a61c5-abc1-3b76-a990-fb4fbdd7cda1",
                                                "text": "Dit huis staat ergens aan het begin van de straat en niet halverwege."
                                            },
                                            {
                                                "example_id": "e0fc250f-b04e-4137-96c5-3ba30962aa81",
                                                "sense_id": "4d2a61c5-abc1-3b76-a990-fb4fbdd7cda1",
                                                "text": "Dat er halverwege een gorilla het veld op loopt, verwachten de deelnemers niet - en de helft van hen ziet hem ook niet."
                                            },
                                            {
                                                "example_id": "024b515c-8cdc-40d6-997e-141ee2011b1e",
                                                "sense_id": "4d2a61c5-abc1-3b76-a990-fb4fbdd7cda1",
                                                "text": "Halverwege kwam ons een Park Ranger tegemoet. Ik voelde een immense opluchting aangezien ik dacht dat we nu veilig waren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "halverwege",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c113e1ae-583e-39ac-bd3a-73ee34bea68a",
                                        "entry_id": "6aa110d9-0740-34c3-b798-84c1837aa81a",
                                        "glosses": [
                                            "in het midden van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb13db7-bdb5-4e2b-b94e-84855ec84ccf",
                                                "sense_id": "c113e1ae-583e-39ac-bd3a-73ee34bea68a",
                                                "text": "Deze speler mag zich halverwege het seizoen de meest waardevolle speler van de eredivisie noemen."
                                            },
                                            {
                                                "example_id": "6ca5fc11-eb26-4b4d-9ec6-389ff8290e73",
                                                "sense_id": "c113e1ae-583e-39ac-bd3a-73ee34bea68a",
                                                "text": "De man had bijna zwart haar, en hij was ouder, waarschijnlijk halverwege de twintig."
                                            },
                                            {
                                                "example_id": "74ad3017-0881-419d-9765-aa8287825792",
                                                "sense_id": "c113e1ae-583e-39ac-bd3a-73ee34bea68a",
                                                "text": "Terlouw promoveerde op kernfusie, maar stelde halverwege zijn leven vast dat de wetenschap hem onvoldoende bevredigde. Hij stapte over naar de politiek en ging kinder- en jeugdboeken schrijven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
