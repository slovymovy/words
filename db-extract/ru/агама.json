                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac73203f-9694-4164-b822-388234bbf79b",
                                "sense_id": "e1be2e1d-0d2f-3f01-bf71-4986c18326fb",
                                "text": "Но вскоре увидел, что из скворечника выглядывает… рогатая голова. Ящерица агама! А ещё через месяц из деревянного домика выбежала целая стайка красно-зелёных агамят."
                            }
                        ]
                    }
                ],
