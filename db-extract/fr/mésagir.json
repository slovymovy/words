                        "glosses": [
                            "Mal agir."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0fb1e193-743b-490b-a76a-93a2bd273017",
                                "sense_id": "346dc0d4-fc9f-3156-9c15-d6493783dc42",
                                "text": "Si le corps mésagit C’✂ parce que l’âme a abdiqué sa mission souveraine"
                            },
                            {
                                "example_id": "973f3571-658f-4e7f-9349-229ad542389a",
                                "sense_id": "346dc0d4-fc9f-3156-9c15-d6493783dc42",
                                "text": "En ce cas ils ne se le pardonneraient jamais, enfin durant quelque temps, d’avoir mésagi à l’encontre d’un humain mais ce fut le prix à payer afin de satisfaire leur appétit de curiosité, de cela ils ne doutèrent point."
                            }
                        ]
                    }
