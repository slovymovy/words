                "senses": [
                    {
                        "sense_id": "ed542074-623c-368f-a8f6-9ee674183669",
                        "entry_id": "0fd42fd6-7337-37e0-957c-a1f0256bebbd",
                        "glosses": [
                            "Zollstation, aus der heraus stets Wache bezogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a9731eb-8b2b-45ba-a936-525229f22405",
                                "sense_id": "ed542074-623c-368f-a8f6-9ee674183669",
                                "text": "„Seit rund einer Woche ist die Zollwache in Vorarlberg Geschichte - die Grenzkontrolle wird jetzt von Gendarmeriebeamten durchgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dae50463-d943-3962-b222-80f9e1978616",
                        "entry_id": "0fd42fd6-7337-37e0-957c-a1f0256bebbd",
                        "glosses": [
                            "bewaffnete Zollbeamte im aktiven Dienst, die wachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c57f2be8-26e5-4f27-b767-96275d43605f",
                                "sense_id": "dae50463-d943-3962-b222-80f9e1978616",
                                "text": "„Seit rund einer Woche ist die Zollwache in Vorarlberg Geschichte - die Grenzkontrolle wird jetzt von Gendarmeriebeamten durchgeführt.“"
                            },
                            {
                                "example_id": "daadf3fd-ff4f-4b4c-8c66-d778f464f8da",
                                "sense_id": "dae50463-d943-3962-b222-80f9e1978616",
                                "text": "„Dem Beamten, der auf Grund einer Organisationsänderung im Bereich der Zollwache von der Besoldungsgruppe des Exekutivdienstes oder der Besoldungsgruppe der Wachebeamten in die Besoldungsgruppe des Allgemeinen Verwaltungsdienstes überstellt worden ist, gebühren an Stelle der Ergänzungszulage nach § 12b eine ruhegenussfähige Ergänzungszulage und ein Differenzausgleich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "71b383fa-1dfd-30d5-8a53-3ea74d7ac2fb",
