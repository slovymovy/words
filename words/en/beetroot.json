            "senses": [
                {
                    "sense_id": "0b1e3a6f-8f42-337a-8242-859621ab559a",
                    "sense_definition": "A dark red root vegetable that can be eaten raw, cooked, or pickled.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She added sliced <w>beetroot</w> to the fresh garden salad.",
                            "target_lang_translations": {
                                "ru": "Она добавила нарезанную <w>свёклу</w> в свежий овощной салат."
                            }
                        },
                        {
                            "text": "Pickled <w>beetroot</w> is often served as a side dish in traditional dinners.",
                            "target_lang_translations": {
                                "ru": "Маринованная <w>свёкла</w> часто подаётся в качестве гарнира к традиционным обедам."
                            }
                        }
                    ],
                    "synonyms": [
                        "beet",
                        "red beet",
                        "table beet"
                    ],
                    "common_phrases": [
                        "pickled beetroot",
                        "beetroot juice",
                        "beetroot salad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тёмно-красный корнеплод, употребляемый в пищу в сыром, варёном или маринованном виде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свёкла",
                                "target_lang_sense_clarification": "корнеплод или само растение"
                            },
                            {
                                "target_lang_word": "буряк",
                                "target_lang_sense_clarification": "региональное, разговорное название свёклы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "405d96a1-258d-3920-b2a4-f183318b2209",
                    "sense_definition": "To turn bright red or purple in the face, typically from embarrassment or anger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His face <w>beetrooted</w> in front of the whole audience when he forgot his lines.",
                            "target_lang_translations": {
                                "ru": "Его лицо <w>покраснело как свёкла</w> перед всеми зрителями, когда он забыл свои слова."
                            }
                        },
                        {
                            "text": "She began <w>beetrooting</w> furiously as soon as the embarrassing truth was revealed.",
                            "target_lang_translations": {
                                "ru": "Она начала отчаянно <w>багроветь</w>, как только открылась неловкая правда."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покраснеть или побагроветь лицом от смущения, стыда или гнева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покраснеть как свёкла",
                                "target_lang_sense_clarification": "сильно покраснеть лицом"
                            },
                            {
                                "target_lang_word": "побагроветь",
                                "target_lang_sense_clarification": "налиться краской от злости или стыда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
