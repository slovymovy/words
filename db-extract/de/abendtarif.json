                "senses": [
                    {
                        "sense_id": "9e4f2492-da1a-3d57-9f6f-79e6da909f60",
                        "entry_id": "2600b8da-741e-3047-b65e-5549f14a15fe",
                        "glosses": [
                            "während der Abendzeit geltender Tarif"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef54a9f-bafb-4fe4-bf89-e901367ea2b9",
                                "sense_id": "9e4f2492-da1a-3d57-9f6f-79e6da909f60",
                                "text": "„Im Orts-Nahbereich bis 20 Kilometer könne von Analog-Anschlüssen aus im Abendtarif ab 21 Uhr und das ganze Wochenende lang für die bisherige Gebühreneinheit von 6 Cent vier statt 2,5 Minuten lang telefoniert werden, berichtet \"Bild\".“"
                            },
                            {
                                "example_id": "c55d84df-130f-4e70-9a9d-e773cdcf89b0",
                                "sense_id": "9e4f2492-da1a-3d57-9f6f-79e6da909f60",
                                "text": "„Der Eintritt ist jeweils ab 17 Uhr zum Abendtarif (50 Prozent des regulären Einzeleintritts) möglich, auch Jahreskarten haben an den Abenden Gültigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
