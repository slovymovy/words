                ],
                "senses": [
                    {
                        "sense_id": "ee475d8c-28f2-3745-979f-6f0684aa094a",
                        "entry_id": "20e33205-58f5-3e09-8879-fcc1624ac32d",
                        "glosses": [
                            "Wirtshaus mit einem schlechten Ruf, wo sich Prostituierte und Ganoven aufhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8aced7-9917-4456-86e3-d3933b0453a5",
                                "sense_id": "ee475d8c-28f2-3745-979f-6f0684aa094a",
                                "text": "„Ein Erlass des preußischen Königs verbot seinen Beamten das Fiedeln in Kaschemmen.“"
                            },
                            {
                                "example_id": "bcd740ca-0fcc-41fd-b8e0-101274c07f5e",
                                "sense_id": "ee475d8c-28f2-3745-979f-6f0684aa094a",
                                "text": "„Er konnte sich nicht mehr als ihr Held träumen, und er ging wieder ziellos durch die Straßen, immer durch Straßen und Anlagen und ließ es Nacht werden und trank eilig Schnäpse in kleinen Kaschemmen, eilig, als hätte er wirklich Eile, und rannte los.“"
                            },
                            {
                                "example_id": "cead372f-2c71-4ec0-8903-2928af51dbbf",
                                "sense_id": "ee475d8c-28f2-3745-979f-6f0684aa094a",
                                "text": "„Er machte sich auf den Weg zum Nabur, jedoch nicht, weil es um einen Deut einladender als die anderen Kaschemmen geklungen hatte.“"
                            },
                            {
                                "example_id": "1e7764c9-baf2-4e21-8294-8d3d99931c45",
                                "sense_id": "ee475d8c-28f2-3745-979f-6f0684aa094a",
                                "text": "„Es war eine Kaschemme, eine mitternächtliche Orgie in einer richtigen Lasterhöhle, ein Schandbetrieb widerlichster Art.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
