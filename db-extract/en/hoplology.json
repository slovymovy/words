                "senses": [
                    {
                        "sense_id": "c35774c5-c4b3-3f41-b7df-cdfb5f7ea539",
                        "entry_id": "2733b84b-6e87-3c73-b870-e3514e0abd46",
                        "glosses": [
                            "The study of the methods, behaviour, and technology involved in human combat, particularly weapons and armour."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0cc3030d-354c-4ebc-88ff-7bb7ae65bbdd",
                                "sense_id": "c35774c5-c4b3-3f41-b7df-cdfb5f7ea539",
                                "text": "Some students of hoplology, the science of l'arme blanche (the sword), in the neighbourhood of my residence have entreated me to invoke the invaluable aid of 'N. & Q.' in matters of archæology to endeavour to trace the missing weapons."
                            },
                            {
                                "example_id": "6bfaace3-8560-4a2e-8175-5e1a865f6be7",
                                "sense_id": "c35774c5-c4b3-3f41-b7df-cdfb5f7ea539",
                                "text": "It has often been a public misconception that the words \"martial arts\" refer to something exclusively Asian in nature. But history and hoplology (the science of weaponry and related combative systems) tell us that no race on the face of the earth has ever lacked for fighting techniques, […]"
                            },
                            {
                                "example_id": "2250d3be-4111-4edf-b7ee-b499c115c110",
                                "sense_id": "c35774c5-c4b3-3f41-b7df-cdfb5f7ea539",
                                "text": "In his seminal work that made him the doyen of modern hoplology, Sir Richard Burton traces the spread of various arms and armaments of the world to ancient Egypt."
                            }
                        ]
                    }
                ],
