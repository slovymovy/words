            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b606115-8bdd-3b81-908e-6dfe82b961ce",
                    "sense_definition": "een toneel- of muziekstuk oefenen ter voorbereiding op een uitvoering",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "oefenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De band moet vanavond nog een keer <w>repeteren</w> voor het concert van morgen.",
                            "target_lang_translations": {
                                "en": "The band needs to <w>rehearse</w> one more time tonight for tomorrow's concert."
                            }
                        },
                        {
                            "text": "Zij moeten het toneelstuk nog <w>repeteren</w> in de grote zaal.",
                            "target_lang_translations": {
                                "en": "They still have to <w>rehearse</w> the play in the main hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "instuderen"
                    ],
                    "common_phrases": [
                        "een toneelstuk repeteren",
                        "voor een concert repeteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to practice a play or piece of music in preparation for a performance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rehearse",
                                "target_lang_sense_clarification": "to practice for a performance"
                            },
                            {
                                "target_lang_word": "practice",
                                "target_lang_sense_clarification": "to perform an activity regularly to improve"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d753acb-a47b-34b2-a9d1-65c97aa474c0",
                    "sense_definition": "iets nog een keer doen of zeggen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herhaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geschiedenis lijkt zich soms te <w>repeteren</w> in verschillende landen.",
                            "target_lang_translations": {
                                "en": "History sometimes seems to <w>repeat</w> itself in different countries."
                            }
                        },
                        {
                            "text": "De leraar bleef de belangrijkste regels <w>repeteren</w> tot iedereen ze begreep.",
                            "target_lang_translations": {
                                "en": "The teacher kept <w>repeating</w> the most important rules until everyone understood them."
                            }
                        }
                    ],
                    "synonyms": [
