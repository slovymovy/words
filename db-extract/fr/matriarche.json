            {
                "entry_id": "06becd14-8b92-38fd-a21a-bd0790f37e25",
                "word": "matriarche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "057059f2-8c45-435a-b094-5ed164fe62f9",
                        "entry_id": "06becd14-8b92-38fd-a21a-bd0790f37e25",
                        "tags": [
                            "plural"
