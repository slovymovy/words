                                                "example_id": "0121b540-8530-4c34-8a3b-39befb9e88bb",
                                                "sense_id": "140b92d2-1eeb-3273-957e-610d2dd935de",
                                                "text": "„Der anspruchsvolle Grenzgänger am Scheideweg von Leben und Tod lebt in krassen Antinomien, die dem Durchschnittsbürger sein Verständnis erschweren.“"
                                            },
                                            {
                                                "example_id": "ac43b7e3-136d-4021-ab00-7df7e9593729",
                                                "sense_id": "140b92d2-1eeb-3273-957e-610d2dd935de",
                                                "text": "Die feuchte Luft erschwert mir das Atmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49456b45-7b54-3155-8c81-aa04a9eb149f",
                                        "entry_id": "0fe4108a-c949-3faa-86d4-b06bafb0a786",
                                        "glosses": [
                                            "etwas schwerwiegender, schlimmer machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d01b23f-3669-4ecd-8c1c-01e64a0ce8fb",
                                                "sense_id": "49456b45-7b54-3155-8c81-aa04a9eb149f",
                                                "text": "Die mangelhaften hygienischen Zustände kommen erschwerend hinzu."
                                            },
                                            {
                                                "example_id": "2785575a-4890-42e0-801e-a9af5b34e785",
                                                "sense_id": "49456b45-7b54-3155-8c81-aa04a9eb149f",
                                                "text": "Das innenpolitische Chaos erschwert die Situation."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8f27457-cb11-4c6c-88d7-7fe2ba1e50b7",
                        "source_entry_id": "25fa826d-fa64-3676-8941-ba022475d61d",
                        "source_sense_description": "сделать сложным или более сложным, трудным",
                        "target_lang_word": "compliquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compliquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72c4cd3d-c830-3fbd-ad01-22671b68f072",
                                        "entry_id": "59737a96-9e96-3c5a-b639-07ecc20f9db1",
                                        "glosses": [
                                            "Rendre confus ou difficile à comprendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32b5aff-24f4-4e25-8c56-f97b68259073",
                                                "sense_id": "72c4cd3d-c830-3fbd-ad01-22671b68f072",
                                                "text": "Tu compliques les affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3526cc4-30ef-3935-8395-de8b4074b188",
                                        "entry_id": "59737a96-9e96-3c5a-b639-07ecc20f9db1",
                                        "glosses": [
                                            "Former un assemblage dont les parties, plus ou moins nombreuses, ont entre elles des rapports multipliés et difficiles à saisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9a4424-2352-4c5b-9f39-b814c1b4996d",
                                                "sense_id": "b3526cc4-30ef-3935-8395-de8b4074b188",
                                                "text": "Depuis Ronsard et Joachim du Bellay les meilleurs esprits trouvent l’orthographe française trop surchargée, sentent le besoin de la simplifier. Voici pourquoi. C’est qu’elle était très simple au XVᵉ siècle, et que les grammairiens du XVIᵉ siècle, par affectation scientifique, par pédantisme, l’avaient grièvement compliquée."
                                            },
                                            {
                                                "example_id": "0e754733-9645-482c-8f4d-12c0ad06c60f",
                                                "sense_id": "b3526cc4-30ef-3935-8395-de8b4074b188",
                                                "text": "Ensuite quatre girls anglaises, des sisters quelconques, vinrent danser un pas de gigue, compliqué de cake-walk et de matchiche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa1c132-d6e0-3cbc-8372-14b4727c4d43",
                                        "entry_id": "59737a96-9e96-3c5a-b639-07ecc20f9db1",
                                        "glosses": [
                                            "Aggraver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a0aa09-98d9-4725-9f8b-c4fe94617b99",
                                                "sense_id": "efa1c132-d6e0-3cbc-8372-14b4727c4d43",
                                                "text": "Mon arrière-grand-mère juive et mon arrière-grand-père palestinien ont eu neuf enfants. Ma grand-mère était l’aînée. L’histoire s'est vraiment compliquée pendant la grande révolte arabe."
                                            },
                                            {
                                                "example_id": "564537ba-9e57-4f03-94cc-7aed2ba8035e",
                                                "sense_id": "efa1c132-d6e0-3cbc-8372-14b4727c4d43",
                                                "text": "Une maladie, une infection se complique d’une autre maladie."
                                            },
                                            {
                                                "example_id": "797800a5-a5d4-4030-b58a-52e89b3292b8",
                                                "sense_id": "efa1c132-d6e0-3cbc-8372-14b4727c4d43",
                                                "text": "Pendant ce temps, le président partage certains objectifs de son parti et dissimule mal son intention de compliquer la vie à son successeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
