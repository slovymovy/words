                {
                    "sense_id": "f086bedf-34c5-3e48-a92e-ea5953429cb0",
                    "sense_definition": "A large, spotted carnivorous cat native to South and Central America.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jaguar</w> is a powerful predator that lives in the rainforests of South America.",
                            "target_lang_translations": {
                                "zh": "<w>美洲豹</w>是一种生活在南美洲雨林中的强大捕食者。"
                            }
                        },
                        {
                            "text": "We saw a beautiful <w>jaguar</w> resting in the shade during our trip to the zoo.",
                            "target_lang_translations": {
                                "zh": "在去动物园游玩时，我们看到一只美丽的<w>美洲豹</w>正在阴凉处休息。"
                            }
                        }
                    ],
                    "synonyms": [],
                    "target_lang_definitions": {
                        "zh": "一种原产于南美洲和中美洲的大型斑点肉食猫科动物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "美洲豹",
                                "target_lang_sense_clarification": "指生活在美洲的豹属动物，也常被称为美洲虎。"
                            },
                            {
                                "target_lang_word": "美洲虎",
                                "target_lang_sense_clarification": "美洲豹的常用别称。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78a5271a-3f38-3ebd-bc9a-d83892d4986b",
                    "sense_definition": "A luxury motor car manufactured by the Jaguar company.",
