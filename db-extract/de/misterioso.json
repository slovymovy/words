                                "target_senses": [
                                    {
                                        "sense_id": "2207734b-012e-31e5-87fe-2379c542606d",
                                        "entry_id": "0d74cb8e-03de-319b-a8e1-8b6ee69db27e",
                                        "glosses": [
                                            "Qui contient quelque mystère, quelque secret, quelque sens caché. Se dit proprement en matière de religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a1affb-11fb-4eca-b349-b857a4268c8b",
                                                "sense_id": "2207734b-012e-31e5-87fe-2379c542606d",
                                                "text": "Les sens mystérieux de la Bible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e51cbf9-ff48-3b01-a177-75993f5b4deb",
                                        "entry_id": "0d74cb8e-03de-319b-a8e1-8b6ee69db27e",
                                        "glosses": [
                                            "Se dit en parlant des affaires humaines."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498bc2e2-fe7c-4e32-b0df-c2d5f173d73a",
                                                "sense_id": "8e51cbf9-ff48-3b01-a177-75993f5b4deb",
                                                "text": "Il y a quelque chose de mystérieux dans cette affaire."
                                            },
                                            {
                                                "example_id": "a251b728-fb00-4170-ac65-f37c1c568808",
                                                "sense_id": "8e51cbf9-ff48-3b01-a177-75993f5b4deb",
                                                "text": "C’est un homme qui a une conduite mystérieuse."
                                            },
                                            {
                                                "example_id": "2d9c7e09-461e-4969-a3ac-96dd6ee5e4ff",
                                                "sense_id": "8e51cbf9-ff48-3b01-a177-75993f5b4deb",
                                                "text": "Ils ont eu ensemble un entretien mystérieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e3d878-8d39-344d-beaf-3fce0756a85f",
                                        "entry_id": "0d74cb8e-03de-319b-a8e1-8b6ee69db27e",
                                        "glosses": [
                                            "Qui fait mystère de beaucoup de choses et souvent de choses qui n’en valent pas la peine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f09dcdb3-35c1-4516-b14b-477a1915b08f",
                                                "sense_id": "24e3d878-8d39-344d-beaf-3fce0756a85f",
                                                "text": "C’est un homme fort mystérieux, tout mystérieux."
                                            },
                                            {
                                                "example_id": "fea8233d-4508-4590-808e-2174f85efb98",
                                                "sense_id": "24e3d878-8d39-344d-beaf-3fce0756a85f",
                                                "text": "Il est mystérieux en toutes choses."
                                            }
                                        ]
                                    }
                                ]
                            }
