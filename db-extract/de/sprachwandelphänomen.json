                ],
                "senses": [
                    {
                        "sense_id": "6335c4dd-2953-395f-8258-cba4ec88367d",
                        "entry_id": "d0d94089-29f0-398d-9163-8b0661798ca9",
                        "glosses": [
                            "ein bestimmter Prozess im Sprachwandel und sein Ergebnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "864fe246-6973-4f6c-a96e-4c509a94be91",
                                "sense_id": "6335c4dd-2953-395f-8258-cba4ec88367d",
                                "text": "„Sprachwandelphänomene werden in der Folge vorschnell als Fehler, die es grundsätzlich zu vermeiden gelte, stigmatisiert, und der Sprachwandel insgesamt wird als bedrohlicher Verfallsprozess wahrgenommen.“"
                            },
                            {
                                "example_id": "a658f904-09c0-4164-9f07-be837a46d77f",
                                "sense_id": "6335c4dd-2953-395f-8258-cba4ec88367d",
                                "text": "„Da die präskriptive Linguistik spätestens seit dem 20. Jahrhundert die Parallelflexion allerdings bevorzugt, wird die schwache Flexion von Adjektiven in Reihungen in Grammatiken oft als Sprachwandelphänomen dargestellt (…).“"
                            },
                            {
                                "example_id": "42409faa-98d7-4a1f-89d8-e9b56b1f23ef",
                                "sense_id": "6335c4dd-2953-395f-8258-cba4ec88367d",
                                "text": "„Nennen Sie ein wichtiges Sprachwandelphänomen/sprachliches Merkmal, wodurch sich die älteste der genannten Sprachstufen des Deutschen von der darauffolgenden Sprachstufe unterscheidet.“"
                            },
                            {
                                "example_id": "7f5d1e29-9a81-43e6-b805-5e6725fe93d6",
                                "sense_id": "6335c4dd-2953-395f-8258-cba4ec88367d",
                                "text": "„Er beschäftigte sich im Rahmen seiner Habilitationsschrift mit dem Sprachwandelphänomen der Grammatikalisierung im Französischen.“"
                            },
                            {
                                "example_id": "bf6a1c20-9544-428e-b0c6-318fcc36c297",
                                "sense_id": "6335c4dd-2953-395f-8258-cba4ec88367d",
                                "text": "„Neben der Dokumentation der einzelnen Sprachwandelphänomene vom Germanischen bis heute wird immer nach den Gründen für diese ständigen Veränderungen gefragt. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
