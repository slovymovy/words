            {
                "entry_id": "556cf564-0e69-3bf4-8621-6ab762e79372",
                "word": "diurétique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "631bcb4b-61ef-4e99-8805-aa66028be570",
                        "entry_id": "556cf564-0e69-3bf4-8621-6ab762e79372",
                        "tags": [
                            "plural"
                        ],
                        "form": "diurétiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                        "entry_id": "556cf564-0e69-3bf4-8621-6ab762e79372",
                        "glosses": [
                            "Substance qui provoque et augmente l’excrétion urinaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc6dd8ba-1082-4007-b887-779194b99d15",
                                "sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                                "text": "Diurétique minéral, végétal."
                            },
                            {
                                "example_id": "79d86e25-246c-4d60-b7e4-02a63c3de836",
                                "sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                                "text": "Les médicaments agissant comme diurétiques sont nombreux : certains acidifiants (chlorure d’ammonium), les sels de potassium, les diurétiques osmotiques, (…), les diurétiques mercuriels."
                            },
                            {
                                "example_id": "e721b85b-6261-4e33-acf8-0fada26933a8",
                                "sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                                "text": "On sait aujourd’hui que l’asperge est un diurétique, mais qu’elle peut avoir une action irritante sur les reins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "019db9f0-ba07-459f-887f-d315b3e95833",
                        "source_entry_id": "556cf564-0e69-3bf4-8621-6ab762e79372",
                        "source_sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                        "target_lang_word": "Diuretikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diuretikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7af9fcf-ace1-3947-bc47-4917a869620b",
                                        "entry_id": "73aa271b-0b44-3966-bcca-d02c4f47e0b3",
                                        "glosses": [
                                            "Mittel, das harntreibend wirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab0ad911-4411-4f62-8e4e-f670885c32e7",
                                                "sense_id": "a7af9fcf-ace1-3947-bc47-4917a869620b",
                                                "text": "„Gelegentlich werden Mate-Aufgüsse auch als Diuretikum, bei rheumatischen Beschwerden und gegen Depressionen eingesetzt.“"
                                            },
                                            {
                                                "example_id": "8f48f0b8-c79f-459c-b734-df704b45ec71",
                                                "sense_id": "a7af9fcf-ace1-3947-bc47-4917a869620b",
                                                "text": "„Ein zu niedriger Kaliumspiegel entwickelt sich bei schweren Durchfällen und unter der Behandlung mit Diuretika, zu hohe Kaliumspiegel bei Niereninsuffizienz.“"
                                            },
                                            {
                                                "example_id": "9c3ea45d-cb6a-4c31-a078-600868260ce9",
                                                "sense_id": "a7af9fcf-ace1-3947-bc47-4917a869620b",
                                                "text": "„Die Ärzte erklärten, er könne mithilfe eines starken intravenösen Diuretikums vielleicht noch drei bis sechs Monate leben, doch als Roth begriff, dass er nicht mehr aufs Land zurückkehren, schwimmen oder auch nur das Bett verlassen könnte, entschied er sich für Palliativpflege.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
