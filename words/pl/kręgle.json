                    "sense_id": "5e58b281-b22c-300e-85d9-165816c637c4",
                    "sense_definition": "gra polegająca na strącaniu kulami ciężkich butelkowatych pionów",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wieczorem pojedziemy z dzieciakami na <w>kręgle</w>.",
