                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nateklý",
                                "target_lang_sense_clarification": "nejčastější výraz pro části těla po zranění nebo zánětu"
                            },
                            {
                                "target_lang_word": "opuchlý",
                                "target_lang_sense_clarification": "často používané pro obličej nebo oči"
                            },
                            {
                                "target_lang_word": "zduřelý",
                                "target_lang_sense_clarification": "často používané pro žlázy nebo tkáně"
                            }
                        ]
                    }
                }
            ]
        },
