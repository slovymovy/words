                "senses": [
                    {
                        "sense_id": "90132249-6474-3f31-9a05-b87128f6257c",
                        "entry_id": "ff450935-20b8-31a7-8ccc-d7b2e34e7033",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0832a7dd-0b3b-40a2-952c-89c15eb722dd",
                                "sense_id": "90132249-6474-3f31-9a05-b87128f6257c",
                                "text": "Frau Schnürle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "14fb7978-d490-41ca-936c-67b27d27dd99",
                                "sense_id": "90132249-6474-3f31-9a05-b87128f6257c",
                                "text": "Herr Schnürle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d747f408-1f07-41ed-b3a6-1b23c336df56",
                                "sense_id": "90132249-6474-3f31-9a05-b87128f6257c",
                                "text": "Die Schnürles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a650a4f3-4759-4ace-8b15-63ea628a8e91",
                                "sense_id": "90132249-6474-3f31-9a05-b87128f6257c",
                                "text": "Der Schnürle trägt nie die Pullover, die die Schnürle ihm strickt."
                            },
                            {
                                "example_id": "bbbc5af8-2d28-432d-8994-15f830fc2038",
                                "sense_id": "90132249-6474-3f31-9a05-b87128f6257c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schnürle kommt, geht der Herr Schnürle.“"
                            },
                            {
                                "example_id": "ca25793d-6154-4f66-b68f-4cb8c1fe4355",
                                "sense_id": "90132249-6474-3f31-9a05-b87128f6257c",
                                "text": "Schnürle kommt und geht."
                            },
                            {
                                "example_id": "7eac9a6d-ad5a-4d07-878b-217554f86ef4",
                                "sense_id": "90132249-6474-3f31-9a05-b87128f6257c",
                                "text": "Schnürles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
