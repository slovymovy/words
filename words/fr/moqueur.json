            "senses": [
                {
                    "sense_id": "28c0b147-d641-311f-baf5-3df88713676a",
                    "sense_definition": "Qui a l'habitude de se moquer ou qui exprime une raillerie ironique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il m'a adressé un sourire <w>moqueur</w> avant de répondre à ma question."
                        },
                        {
                            "text": "Elle a adopté un ton <w>moqueur</w> qui a aussitôt vexé son camarade de classe."
                        }
                    ],
                    "common_phrases": [
                        "sourire moqueur",
                        "ton moqueur",
                        "regard moqueur",
                        "air moqueur"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02448e43-6fba-3c85-8b20-630954340bcd",
                    "sense_definition": "Personne qui prend plaisir à se moquer d'autrui ou à railler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne fais pas attention à ses remarques, c'est un <w>moqueur</w> invétéré."
                        },
                        {
                            "text": "Cet éternel <w>moqueur</w> aime tourner chaque situation sérieuse en dérision."
                        }
                    ],
                    "synonyms": [
                        "railleur"
                    ]
                },
                {
                    "sense_id": "48631e8b-2790-3c44-ae62-4f3effd7b180",
                    "sense_definition": "Oiseau passereau d'Amérique de la famille des mimidés, réputé pour imiter le chant d'autres espèces.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ornithologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>moqueur</w> polyglotte est capable d'imiter le chant de dizaines d'espèces d'oiseaux."
                        },
                        {
                            "text": "Pendant notre promenade dans le parc, un <w>moqueur</w> chantait au sommet d'un arbre."
                        }
                    ],
                    "common_phrases": [
                        "moqueur polyglotte"
                    ]
                },
                {
                    "sense_id": "c87757d0-7269-3839-99db-de55687bd20d",
                    "sense_definition": "Ancien nom vulgaire donné aux irrisors, oiseaux arboricoles d'Afrique subsaharienne au bec courbé.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ornithologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une bande de <w>moqueurs</w> bruyants fouillait l'écorce des acacias de leurs longs becs courbés."
                        },
                        {
                            "text": "L'explorateur a observé un <w>moqueur</w> au plumage brillant dans la savane boisée."
                        }
                    ],
                    "synonyms": [
                        "irrisor"
                    ],
                    "common_phrases": [
