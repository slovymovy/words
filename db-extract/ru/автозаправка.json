                    },
                    {
                        "sense_id": "9a118913-1ac9-3865-a050-e0e197742013",
                        "entry_id": "2185c505-946a-30a4-933d-07f8c6af8a4a",
                        "glosses": [
                            "процесс автоматической заправки автомобилей и мотоциклов жидким топливом"
                        ],
                        "tags": [],
