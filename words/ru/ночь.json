                    "sense_definition": "Часть суток от захода до восхода солнца, между вечером и утром.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама поцеловала сына и пожелала ему спокойной <w>ночи</w>.",
                            "target_lang_translations": {
                                "en": "Mom kissed her son and wished him good <w>night</w>.",
                                "zh": "妈妈亲吻了儿子，并祝他晚安，祝他睡个好<w>觉</w>。"
                            }
                        },
                        {
                            "text": "Мы гуляли по городу всю <w>ночь</w> и смотрели на яркие звёзды.",
                            "target_lang_translations": {
                                "en": "We walked around the city all <w>night</w> and looked at the bright stars.",
                                "zh": "我们整<w>夜</w>都在城里散步，看着明亮的星星。"
                            }
                        }
                    ],
                    "antonyms": [
                        "день"
                    ],
                    "common_phrases": [
                        "спокойной ночи",
                        "день и ночь",
                        "на ночь",
                        "глубокая ночь"
                    ],
                    "target_lang_definitions": {
                        "en": "The part of the day from sunset to sunrise, between evening and morning.",
                        "zh": "指从日落到日出，即傍晚到早晨之间的一段时间。"
                    },
