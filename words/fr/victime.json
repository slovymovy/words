                    "frequency": "High",
                    "semantic_group_id": "dommage_subi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les secours sont arrivés rapidement pour secourir la <w>victime</w> du grave accident."
                        },
                        {
                            "text": "La police recherche des témoins afin d'identifier l'agresseur de cette jeune <w>victime</w>."
                        }
                    ],
                    "synonyms": [
                        "sinistré"
                    ],
                    "antonyms": [
                        "agresseur",
                        "assassin",
                        "bourreau",
                        "meurtrier"
                    ],
                    "common_phrases": [
