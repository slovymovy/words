                "senses": [
                    {
                        "sense_id": "d2cf6ee9-f382-380e-b2f4-40c493d0f4f2",
                        "entry_id": "1d48dd22-54db-30da-a3de-034a024b4630",
                        "glosses": [
                            "To subject to deindustrialization; to deprive of industry."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "639c0804-6105-4a30-992c-9f7b055a35d1",
                                "sense_id": "d2cf6ee9-f382-380e-b2f4-40c493d0f4f2",
                                "text": "Thus, the U.K., the first nation to industrialize, was also the first to deindustrialize."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e34f7e8f-180b-4d9d-ad73-49abc2f197d5",
                        "source_entry_id": "1d48dd22-54db-30da-a3de-034a024b4630",
                        "source_sense_id": "d2cf6ee9-f382-380e-b2f4-40c493d0f4f2",
                        "source_sense_description": "Translations",
                        "target_lang_word": "désindustrialiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désindustrialiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5617bc7-d20a-39c8-87de-a4fa3149b0c7",
                                        "entry_id": "6fc7a288-9d53-3a93-949c-363cb6accbf2",
                                        "glosses": [
                                            "Faire perdre son caractère industriel à (une région, par exemple)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7881f47-35a2-47e4-bd80-c07363983cfb",
                                                "sense_id": "e5617bc7-d20a-39c8-87de-a4fa3149b0c7",
                                                "text": "Il faut donc désindustrialiser pour débureaucratiser. Il faut déprofessionnaliser l’exercice des fonctions thérapeutiques pour rendre à l’individu son autonomie et son libre choix."
                                            },
                                            {
                                                "example_id": "449b516f-56e9-4f3b-92b2-e9ddb910521c",
                                                "sense_id": "e5617bc7-d20a-39c8-87de-a4fa3149b0c7",
                                                "text": "Une étude du Cépii suggère qu’une meilleure représentation des salariés au conseil d’administration et une plus grande proximité géographique entre les sièges sociaux et les usines expliquent, en partie, pourquoi l’Allemagne a moins désindustrialisé que la France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
