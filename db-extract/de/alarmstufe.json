                "senses": [
                    {
                        "sense_id": "3b53b6d3-6bb1-37e7-bbc1-6ef8a31c29fc",
                        "entry_id": "b132bba3-9c75-30c4-9022-805889d998cc",
                        "glosses": [
                            "bestimmter Grad (einer dafür geschaffenen stufenartigen Einteilung), anhand dessen eine (mögliche) Gefahrensituation beurteilt und die Alarmbereitschaft von jemandem, zum Beispiel Einsatzkräften, festgelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77788429-d4a2-452e-8e27-fce5e89594e2",
                                "sense_id": "3b53b6d3-6bb1-37e7-bbc1-6ef8a31c29fc",
                                "text": "„Nach mehr als 4000 leichten Erdstößen wächst auf der Kanareninsel La Palma die Sorge vor einem Vulkanausbruch. Die Behörden verhängten die zweithöchste von insgesamt drei Alarmstufen in der Umgebung der Vulkankette des Cumbre Vieja im Südwesten der Insel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
