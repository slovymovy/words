                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9dbe4eb-6dd4-47ee-b447-3288508bf06b",
                                "sense_id": "57700708-2461-32b1-acd8-17e584926c2b",
                                "text": "„Das Bundesarbeitsgericht in Kassel entscheidet, dass Abfindungsansprüche aus einem Sozialplan bei einem Konkurs nicht vorrangig sind.“"
                            },
                            {
                                "example_id": "4111051d-f239-4e61-bb6e-aae611d40fad",
                                "sense_id": "57700708-2461-32b1-acd8-17e584926c2b",
                                "text": "„In Berlin finden vertrauliche Besprechungen zwischen Mitgliedern der Reichsregierung und Vertretern der Länder über die finanziellen Abfindungsansprüche der Länder gegenüber dem Reich statt.“"
                            },
                            {
                                "example_id": "6b2ed2ff-b3c1-481e-a72f-9b5affe57141",
                                "sense_id": "57700708-2461-32b1-acd8-17e584926c2b",
                                "text": "„Ein Abfindungsanspruch kann im Tarif-, Arbeitsvertrag oder der Betriebsvereinbarung begründet sein.“"
                            }
                        ],
