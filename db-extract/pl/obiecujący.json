                    },
                    {
                        "translation_id": "4cc0ff98-bed4-4309-8e5c-ec0f648e6572",
                        "source_entry_id": "1362fbed-6219-3580-800b-22644389ee6e",
                        "source_sense_id": "a885c716-7606-32fe-a634-669cb144caac",
                        "target_lang_word": "Erfolg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erfolg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa17a49c-cf53-3f7e-b67d-0cfd7e0ceffa",
                                        "entry_id": "869acc20-3c96-3bda-950b-b6bc210df0f3",
                                        "glosses": [
                                            "das Gelingen einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d13fd02-1b24-4318-874d-73105dd91dd0",
                                                "sense_id": "fa17a49c-cf53-3f7e-b67d-0cfd7e0ceffa",
                                                "text": "Ich habe versucht es zu reparieren – leider ohne Erfolg."
                                            },
                                            {
                                                "example_id": "a8350f07-79e7-4bee-a0d3-582f0b8aeda0",
                                                "sense_id": "fa17a49c-cf53-3f7e-b67d-0cfd7e0ceffa",
                                                "text": "„Es ist jetzt schon ein Erfolg, wenn die Ehefrau eines Inhaftierten keine Spuren von Folter im Gesicht ihres Mannes entdeckt.“"
                                            },
                                            {
                                                "example_id": "713b4a42-14ad-4c46-9dce-73298ec438c0",
                                                "sense_id": "fa17a49c-cf53-3f7e-b67d-0cfd7e0ceffa",
                                                "text": "„Dem genügsamen, arbeitsfrohen Puritanertum des Vaters genügte der eigene Erfolg keineswegs.“"
                                            },
                                            {
                                                "example_id": "6a5fad09-7943-410a-a6a8-c5f1cd5897e9",
                                                "sense_id": "fa17a49c-cf53-3f7e-b67d-0cfd7e0ceffa",
                                                "text": "„Als Erfolg wertet er, wenn ein Patient nach einem Jahr noch lebte, und als einen Fehlschlag, wenn ein Patient nach einem Jahr bereits gestorben war.“"
                                            },
                                            {
                                                "example_id": "2ac1e78f-97dd-401f-99ee-949ed336b56d",
                                                "sense_id": "fa17a49c-cf53-3f7e-b67d-0cfd7e0ceffa",
                                                "text": "„Ich hatte zwei Bücher von ihm gelesen, politische Unterhaltungsromane, die ihren Erfolg dem Mißverständnis verdankten, wagemutig zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c52d045-d1f4-3f9e-8a72-c211fcb547ab",
                                        "entry_id": "869acc20-3c96-3bda-950b-b6bc210df0f3",
                                        "glosses": [
                                            "das Erreichen selbst gesetzter Ziele"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ebeb5c-ddfb-4ad7-a46a-ee766565f3a7",
                                                "sense_id": "4c52d045-d1f4-3f9e-8a72-c211fcb547ab",
                                                "text": "„Ich hatte zwei Bücher von ihm gelesen, politische Unterhaltungsromane, die ihren Erfolg dem Mißverständnis verdankten, wagemutig zu sein.“"
                                            },
                                            {
                                                "example_id": "7169fd80-d5de-4ed1-8e6f-fe638dea609a",
                                                "sense_id": "4c52d045-d1f4-3f9e-8a72-c211fcb547ab",
                                                "text": "Alice hatte großen Erfolg auf der Bühne."
                                            },
                                            {
                                                "example_id": "af48d679-78f8-4046-a7db-9004982b6e70",
                                                "sense_id": "4c52d045-d1f4-3f9e-8a72-c211fcb547ab",
                                                "text": "„Die künstlerischen Erfolge wird er mit seiner Gesundheit bezahlen.“"
                                            },
                                            {
                                                "example_id": "a70bdef8-1fb8-4bf7-b3b7-1397c8ca03ff",
                                                "sense_id": "4c52d045-d1f4-3f9e-8a72-c211fcb547ab",
                                                "text": "„Von dem Erfolg bei Kursk befeuert, war das sowjetische Oberkommando mit Zuversicht und Kühnheit zur Offensive übergegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
