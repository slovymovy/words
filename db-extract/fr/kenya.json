        "fr-extract.jsonl": [
            {
                "entry_id": "c0b51acb-d48c-3ea2-9738-cfd084a6bd78",
                "word": "Kenya",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9abe1146-5f89-4221-bc78-3b6639a3c270",
                        "entry_id": "c0b51acb-d48c-3ea2-9738-cfd084a6bd78",
                        "tags": [],
                        "form": "Kénya"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                        "entry_id": "c0b51acb-d48c-3ea2-9738-cfd084a6bd78",
                        "glosses": [
                            "Pays d’Afrique de l’Est, entouré par le Soudan du Sud et l’Éthiopie au nord, la Somalie et l’océan Indien à l’est, l’Ouganda à l’ouest et la Tanzanie au sud. Sa capitale est Nairobi."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "e3fccd2b-f43a-44af-8433-a74890fbea26",
                                "sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                                "text": "Et, avant de regagner l’Europe, j’avais résolu de passer par un des Parcs royaux du Kenya, ces réserves où des lois d’une rigueur extrême protègent les bêtes sauvages dans toutes les formes de leur vie."
                            },
                            {
                                "example_id": "0e0373ab-766e-48fc-aa53-d402af99d957",
                                "sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                                "text": "Le bongo se rencontre en zone forestière de l’Ouest africain jusqu’au Kenya et en Ouganda ; il n’en est pas moins la plus rare des grandes antilopes et sa protection est une nécessité impérieuse."
                            },
                            {
                                "example_id": "5f2beafa-5ef9-4d2d-8568-e5360f08488a",
                                "sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                                "text": "Je voulais aller au Kenya, photographier les Masai et les neiges du Kilimandjaro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b52f49d-e93b-4b0b-a0d8-cbbba7e0947d",
                        "source_entry_id": "c0b51acb-d48c-3ea2-9738-cfd084a6bd78",
                        "source_sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                        "source_sense_description": "pays d’Afrique",
                        "target_lang_word": "Kenia",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kenia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "050d6e5d-c074-33b0-b984-f4cc217bad59",
                                        "entry_id": "99217d65-fc33-35d7-9fed-b83f7ea8eede",
                                        "glosses": [
                                            "Land in Ostafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70aa8c5d-a5f0-4917-9bef-e7b4d9c6d62b",
                                                "sense_id": "050d6e5d-c074-33b0-b984-f4cc217bad59",
                                                "text": "Sie kommt aus Kenia."
                                            },
                                            {
                                                "example_id": "48bae0b9-b413-4f8a-b612-355eebc2ae3e",
                                                "sense_id": "050d6e5d-c074-33b0-b984-f4cc217bad59",
                                                "text": "„Es gibt eine Vielzahl an Nationalparks in Kenia, die ein wichtiges Standbein für den Tourismus darstellen.“"
                                            },
                                            {
                                                "example_id": "fd55a92c-cab1-410f-b0b5-9e9a13bf4e03",
                                                "sense_id": "050d6e5d-c074-33b0-b984-f4cc217bad59",
                                                "text": "Nairobi ist die Hauptstadt von Kenia."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kenia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b08414fa-8c9f-3214-906f-e438382f2ff0",
                                        "entry_id": "f1edaa5f-d633-3e55-b6f3-1a9b2506d120",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
