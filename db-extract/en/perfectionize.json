                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "eecb674c-a45c-400a-9c03-9a1cf0ceb492",
                                "sense_id": "fbc60323-2a6f-3547-a406-e50635ead38a",
                                "text": "A solitary life is not the atmosphere to perfectionize any virtue."
                            },
                            {
                                "example_id": "9021e9b9-2a38-4ab1-90d7-37f3f391ba22",
                                "sense_id": "fbc60323-2a6f-3547-a406-e50635ead38a",
                                "text": "After having made the first 4-5 bird sculptures the urge to perfectionize your sculptures will rapidly make itself felt."
                            }
                        ]
                    },
                    {
                        "sense_id": "eaec9c69-233c-36db-b4b4-0b0b81750953",
                        "entry_id": "e1c13217-8d7f-3835-a967-7acdf9105d98",
                        "glosses": [
                            "To be a perfectionist."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "628bbaa1-c62e-4d93-8ae9-4e80d778ae6c",
                                "sense_id": "eaec9c69-233c-36db-b4b4-0b0b81750953",
                                "text": "Don't obsess or perfectionize! The reality check is just that, and you have to get out there and get started."
