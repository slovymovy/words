                        "source_entry_id": "ecbeb6cf-bd75-3d76-89f0-bc54b7e8b509",
                        "source_sense_id": "d4a3243a-75d8-33db-8c0a-ef1fba68f64e",
                        "source_sense_description": "skull enlargement due to fluid",
                        "target_lang_word": "Wasserkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cd75c8b-81f8-356e-a98c-f038f46ab00f",
                                        "entry_id": "618f0fd5-d963-39ca-982d-c50a3e189365",
                                        "glosses": [
                                            "eine krankhafte Ansammlung von Wasser im Gehirn, die zu einer Vergrößerung des Kopfes führt"
                                        ],
                                        "tags": [
                                            "Pathologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53541528-40e3-41e4-87ec-99aead8a87c5",
                                                "sense_id": "4cd75c8b-81f8-356e-a98c-f038f46ab00f",
                                                "text": "Zehn Prozent der infizierten Babys zeigen bei der Geburt Folgen der Toxoplasmose, wie Gehirn- oder Leberentzündung sowie Hydrocephalus - einen Wasserkopf."
                                            },
                                            {
                                                "example_id": "ee5b822d-3ed5-43d2-8a89-a861fc8d565d",
                                                "sense_id": "4cd75c8b-81f8-356e-a98c-f038f46ab00f",
                                                "text": "Intensivmedizin rettet immer kleinere Babys, oft zum Preis schwerer Gesundheitsschäden: […] Relativ häufige Blutungen im nicht ausgereiften kindlichen Gehirn können später zu einem Wasserkopf mit Lähmungen, Krämpfen und Schwachsinn führen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a7dc003-1292-3e48-b82c-2423426b8788",
                                        "entry_id": "618f0fd5-d963-39ca-982d-c50a3e189365",
                                        "glosses": [
                                            "eine Verwaltung, von der man annimmt, dass sie für die Erfüllung ihrer Aufgaben mit zu vielen Personal arbeitet oder überflüssige Aufgaben verrichtet; eine aufgeblähte Verwaltung"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "680796f1-35dd-48ac-bb34-d515302ccaab",
                                                "sense_id": "5a7dc003-1292-3e48-b82c-2423426b8788",
                                                "text": "\"Die Verwaltung der EU soll ein Wasserkopf sein? Das ist nur ein Klischee: Für die EU arbeiten in 2015 insgesamt knapp 33.000 Beschäftigte an zig Standorten in ganz Europa. Zum Vergleich: allein die Berliner Verwaltung hat bei nicht mal 4 Millionen Einwohnern mehr als die dreifache Beschäftigtenzahl, nämlich 106.000. Und die stocken gerade auf …!\""
                                            },
                                            {
                                                "example_id": "f554e276-abb4-42e1-8d66-5ce6cabe91c6",
                                                "sense_id": "5a7dc003-1292-3e48-b82c-2423426b8788",
                                                "text": "Der AFD-EU-Abgeordnete Hans-Olaf Henkel: \"Wir sind der Meinung, dass man innerhalb von sieben Jahren diesen Wasserkopf [der EU] um 50 Prozent verkleinern müsste. Wir sind der Meinung, dass wir nicht 28 Kommissare brauchen mit jeweils einem großen Kabinett, sondern 12 würden reichen.\""
                                            },
                                            {
                                                "example_id": "2bc36f99-babb-4f67-9725-d5be516f59de",
                                                "sense_id": "5a7dc003-1292-3e48-b82c-2423426b8788",
                                                "text": "Australien und England haben ihren Sport zentralisiert. Seitdem gewinnen sie öfter. Das föderale Deutschland hingegen züchtet nach wie vor einen Wasserkopf an Verwaltung und Bürokratie. In den vielen Olympia-Stützpunkten und Landessportbünden versickert Förderung. Es gibt zu viele Pöstchen."
                                            },
                                            {
                                                "example_id": "b58110ae-e8ed-4f6a-aa4c-e0b6d240f8dd",
                                                "sense_id": "5a7dc003-1292-3e48-b82c-2423426b8788",
                                                "text": "Die [Bundesgesundheits-]Ministerin [Ulla Schmidt, SPD,] sicherte zu, die geplante Bundesstiftung [Aids-]Prävention werde mit drei ehrenamtlichen Vorständen, einem hauptamtlichen Geschäftsführer und wenigen Mitarbeitern kein bürokratischer Wasserkopf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
