                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "4a32f993-3703-4086-9e51-1f5c4646f784",
                                "sense_id": "bd9516ee-0ce8-3f54-b839-b4030a2d6d95",
                                "text": "До тех пор учился я только у одного учителя, учившего нас всему, что проходилось в нашей школе."
                            },
                            {
                                "example_id": "a140554b-c3f9-4f36-bec9-f53162650d35",
                                "sense_id": "bd9516ee-0ce8-3f54-b839-b4030a2d6d95",
                                "text": "Жёлобы или узкие кулуары могут проходиться лазанием (обычным или в распор), но лучше всего вообще избегать этих мест, проходя по ним лишь в случаях крайней необходимости и только рано утром."
                            }
                        ]
                    }
