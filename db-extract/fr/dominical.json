                "senses": [
                    {
                        "sense_id": "67477ccc-9cab-3d4a-afab-d58ff52487eb",
                        "entry_id": "8752fcbe-4f2a-31d1-a73a-c3fe2df0e4e0",
                        "glosses": [
                            "Relatif au dimanche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd2c74e0-e2a7-4580-a12b-a4f8b95f6d21",
                                "sense_id": "67477ccc-9cab-3d4a-afab-d58ff52487eb",
                                "text": "Le jour gris, tombant comme une pluie fine, tissait sans arrêt de transparents filets dans lesquels les promeneurs dominicaux semblaient s’argenter."
                            },
                            {
                                "example_id": "d96477d8-3e4f-4b67-9daa-b8846d0cb751",
                                "sense_id": "67477ccc-9cab-3d4a-afab-d58ff52487eb",
                                "text": "Après un gigot flageolets avalé chez belle-maman, qu’il appelle « ma mère », monsieur met à profit l’après-midi dominical pour s’immerger dans la comptabilité familiale."
                            },
                            {
                                "example_id": "48f8c5e6-ae13-4281-b5bb-1007c8d009c1",
                                "sense_id": "67477ccc-9cab-3d4a-afab-d58ff52487eb",
                                "text": "Sa foi catholique crevassée, l’Irlandaise tourna le dos aux sacrements, puis à la messe dominicale, ne daignant même pas faire des Pâques de renard."
                            },
                            {
                                "example_id": "317dd83c-0d1a-4180-b5fc-9500da9c1a48",
                                "sense_id": "67477ccc-9cab-3d4a-afab-d58ff52487eb",
                                "text": "Dans le champ tout proche, une moissonneuse-batteuse effectuait des coupes en cette fin de journée dominicale."
                            },
                            {
                                "example_id": "57ff7b34-2996-482a-881e-a419ab796ca8",
                                "sense_id": "67477ccc-9cab-3d4a-afab-d58ff52487eb",
                                "text": "Lettre dominicale : lettre attribuée aux dimanches d’une année servant au comput."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3c37e93-3b09-3d27-8eb2-3bbfcf3159e5",
                        "entry_id": "8752fcbe-4f2a-31d1-a73a-c3fe2df0e4e0",
                        "glosses": [
                            "Qui provient du Seigneur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0fe372b-3239-4c35-9ea0-1c7cd537f59a",
                                "sense_id": "c3c37e93-3b09-3d27-8eb2-3bbfcf3159e5",
                                "text": "L’oraison dominicale : Le pater, prière que Jésus enseigna à ses disciples."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e667c51-7ce9-4fa2-9d7f-ce51335adb8a",
