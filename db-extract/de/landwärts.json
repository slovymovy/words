                                    {
                                        "sense_id": "e7300f93-ee12-34e3-bac0-a8e58906dbdc",
                                        "entry_id": "d06905d0-e505-396d-bea6-54336198bd82",
                                        "glosses": [
                                            "Positioned on or near the shore."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33d34bb9-4ea9-42fd-bf47-db44642091dd",
                                                "sense_id": "e7300f93-ee12-34e3-bac0-a8e58906dbdc",
                                                "text": "Princeton University's Center for Environmental Studies recommended today that New Jersey minimize adverse impacts of offshore drilling by limiting to the Atlantic City area any onshore bases built to support and supply oil rigs in the ocean."
                                            },
                                            {
                                                "example_id": "c344c5b8-4a57-4103-a2ec-22f74d9e7800",
                                                "sense_id": "e7300f93-ee12-34e3-bac0-a8e58906dbdc",
                                                "text": "The second time La Suprema came into harbor, at the Port of Augusta, in the east of Sicily, I watched the police onshore grow impatient with a teenager who was scheduled to disembark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e3ca7d-22f4-399c-b1e1-44907ecdce0a",
                                        "entry_id": "d06905d0-e505-396d-bea6-54336198bd82",
                                        "glosses": [
                                            "Within the country; not overseas."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c868266-0808-4eaf-86ae-9b08cb42ea06",
                                                "sense_id": "43e3ca7d-22f4-399c-b1e1-44907ecdce0a",
                                                "text": "By this measure, it was only the second largest onshore leak in the US last year, surpassed by one near San Antonio, Texas in March which discharged 147 tonnes of methane an hour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onshore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3951533f-011c-39cb-b7b1-28832a972142",
                                        "entry_id": "611e6975-5b5c-3914-9558-9bb621366c32",
                                        "glosses": [
                                            "From the sea towards the land."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "927def0d-7c82-459a-a6b7-23383c1934b7",
                                                "sense_id": "3951533f-011c-39cb-b7b1-28832a972142",
                                                "text": "Like most storms, Hurricane Katrina weakened as it came onshore, and by Monday evening the National Hurricane Center had downgraded it to a tropical storm."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onshore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3b70936-17f8-3acf-b0d3-caf7382c1f8b",
                                        "entry_id": "a6a7e466-b042-3f42-b674-41bdd26b5c31",
                                        "glosses": [
                                            "To relocate production, services or jobs to lower-cost locations in the same country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed69839-0021-44a7-aaa1-9dca63037ffe",
                                                "sense_id": "b3b70936-17f8-3acf-b0d3-caf7382c1f8b",
                                                "text": "I don’t want to suggest that any attempt to onshore production will doom America to runaway costs, supply-chain catastrophes, and frayed global alliances. In many cases, I’m sure there are brilliant reasons to bring back more advanced manufacturing, clean-energy construction, and resource production."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
