                ],
                "senses": [
                    {
                        "sense_id": "1eae244e-70de-3da9-8d11-8d1a7e60a25a",
                        "entry_id": "2877d3ea-48c7-3cae-8d92-dabe67b8943d",
                        "glosses": [
                            "ботан. многолетнее травянистое растение семейства лилейных с большим толстым корневищем и метелками цветов"
                        ],
                        "tags": [],
