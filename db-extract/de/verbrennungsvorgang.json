                        "sense_id": "7116f840-a3bf-319e-90be-b1774ecd7d64",
                        "entry_id": "5bed3f9a-3fe7-3444-a731-bc1e9e1edf0f",
                        "glosses": [
                            "Prozess, bei dem eine rasche Oxydation die maßgebliche Rolle spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8d0fb80-521e-400c-87ae-339c885da532",
                                "sense_id": "7116f840-a3bf-319e-90be-b1774ecd7d64",
                                "text": "„Wissenschaftler haben den Verbrennungsvorgang in den Motoren besser verstanden, sodass derlei Tuning möglich ist.“"
                            },
                            {
                                "example_id": "aa5155bf-d095-40fa-afb2-c1af8273be30",
                                "sense_id": "7116f840-a3bf-319e-90be-b1774ecd7d64",
                                "text": "„Der Luftmassenmesser ermittelt laut VW die aktuell durchgesetzte Luftmasse; diese sei ein für das Motormanagement sehr wichtiger Wert für einen optimalen Verbrennungsvorgang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
