                    {
                        "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                        "entry_id": "09e05570-a2ba-3629-9693-536288e4a2e1",
                        "glosses": [
                            "The removal of ambiguity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7aad4b0c-43d0-4a5f-88cf-b9f871136f32",
                                "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                                "text": "The lexical disambiguation relies on looking ahead to identify possible senses."
                            },
                            {
                                "example_id": "8825bd8e-0787-4c42-97d7-a135ff4a37b2",
                                "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                                "text": "Disambiguation — where it is to fix the sense of an ambiguous term. This operation has been termed distinction by some Logicians, and erroneously reckoned as a species of division."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b1c666a-cd74-3e98-9619-b5746851cc2f",
                        "entry_id": "09e05570-a2ba-3629-9693-536288e4a2e1",
                        "glosses": [
                            "A page on a wiki containing links to two or more topics with the same name."
                        ],
