                                "target_senses": [
                                    {
                                        "sense_id": "69a90779-fc1c-354c-a62c-5ade9ad105b5",
                                        "entry_id": "5d291c75-1557-34f9-a974-d48ffae55116",
                                        "glosses": [
                                            "A dance in which a group of people perform the same dance moves synchronously while in one or more lines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c51e2bd6-ae85-43f3-8041-855d7af17f65",
                        "source_entry_id": "897ae4e7-0756-394e-b51c-ee5a6ec652d0",
                        "source_sense_id": "d5f09869-ba5a-3199-825d-3d870d866a79",
                        "source_sense_description": "synchronisierter Gruppentanz",
                        "target_lang_word": "danse en ligne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "danse en ligne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f55656a4-8722-3b71-8d83-2b20e1f28b59",
                                        "entry_id": "136c0aa5-480b-37bf-9f6a-966eb0f5c655",
                                        "glosses": [
                                            "Type de danse de groupes pratiquée individuellement, soit l'un derrière l'autre, soit côte à côte, soit encore en deux lignes se faisant face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6433d84-989a-4291-9d15-bdb806b2a8fb",
                                                "sense_id": "f55656a4-8722-3b71-8d83-2b20e1f28b59",
                                                "text": "Danses en ligne, twists et madisons seront de la partie."
                                            },
                                            {
                                                "example_id": "8873f37d-9e9d-4999-bcbc-c9edd8821dd1",
                                                "sense_id": "f55656a4-8722-3b71-8d83-2b20e1f28b59",
                                                "text": "Au centre de loisirs chaque mercredi matin, avec Christine, présidente du club Tiags n’Country de Puy-du-Lac, les enfants découvrent la danse en ligne, sur des musiques de genres rock, west coast swing ou cajun, avec des petites chorégraphies adaptées."
                                            },
                                            {
                                                "example_id": "edcd26c0-159c-4ce3-b5e8-7b50903d43c2",
                                                "sense_id": "f55656a4-8722-3b71-8d83-2b20e1f28b59",
                                                "text": "Craponne-sur-Arzon, dans la Haute-Loire, est le rendez-vous depuis plus de trente ans des amateurs de danse en ligne avec de nombreuses démonstrations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
