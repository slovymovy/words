                    {
                        "translation_id": "311288e7-2b09-49a6-bd7e-86fd594dbd66",
                        "source_entry_id": "ac556559-e251-33f4-a1d2-ea11d077ac6c",
                        "source_sense_id": "8d7e477e-d297-3498-adce-17c5088f0b5b",
                        "target_lang_word": "Mulde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mulde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfdcc9de-1601-3a94-bb60-7cb6f11b3683",
                                        "entry_id": "3478d277-efeb-31b0-b97e-c02f791d964c",
                                        "glosses": [
                                            "längliches, abgerundetes Gefäß mit einer flachen Vertiefung, das sowohl aus einem Stück als auch aus einem Material gefertigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a4c3669-8eee-4140-be66-e4e5400a18b7",
                                                "sense_id": "dfdcc9de-1601-3a94-bb60-7cb6f11b3683",
                                                "text": "Der Teig wird in einer Mulde gebacken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b4b1e24-10f7-3c2c-9eff-f075e789ab9b",
                                        "entry_id": "3478d277-efeb-31b0-b97e-c02f791d964c",
                                        "glosses": [
                                            "Vertiefung, Einsenkung in der Erdoberfläche, in der Landschaft, im Gelände"
                                        ],
                                        "tags": [
                                            "Geomorphologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "841bf983-bc20-433c-b019-d13ae9d64378",
                                                "sense_id": "2b4b1e24-10f7-3c2c-9eff-f075e789ab9b",
                                                "text": "„[Diese Abfahrt] war naturbelassen und stark kupiert, allgemein hügelig und von Mulden durchzogen.“"
                                            },
                                            {
                                                "example_id": "47074946-9033-43f7-8f2f-be426c66522b",
                                                "sense_id": "2b4b1e24-10f7-3c2c-9eff-f075e789ab9b",
                                                "text": "„Wir marschierten in einer flachen Mulde.“"
                                            },
                                            {
                                                "example_id": "74f04e5e-0673-406e-90b4-4e956122acb4",
                                                "sense_id": "2b4b1e24-10f7-3c2c-9eff-f075e789ab9b",
                                                "text": "„Dort legten sie sie in eine Mulde zwischen hohen Sandhügeln, die sie auf der einen Seite gegen den Strand und auf der andern gegen die Häuser abschirmten.“"
                                            },
                                            {
                                                "example_id": "38238076-9e1c-4985-aafc-6ce857121c0c",
                                                "sense_id": "2b4b1e24-10f7-3c2c-9eff-f075e789ab9b",
                                                "text": "„Die ersten Schatten der Dämmerung fielen über die Mulde des Platzes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "957444da-c6dd-372a-9f00-242e4da625b2",
                                        "entry_id": "3478d277-efeb-31b0-b97e-c02f791d964c",
                                        "glosses": [
                                            "Gesteinssenke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926f14b8-c80f-430e-8882-f804ed65e5a7",
                                                "sense_id": "957444da-c6dd-372a-9f00-242e4da625b2",
                                                "text": "Das Tarim-Sedimentbecken in Asien ist eine riesige Mulde."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "63b2721b-44a4-3160-adbf-34c7b3e13703",
                                        "entry_id": "3478d277-efeb-31b0-b97e-c02f791d964c",
                                        "glosses": [
                                            "Behältnis zum Transport verschiedener Materialien im Bauwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60c2084e-9b64-488f-b98f-b509acc38170",
                                                "sense_id": "63b2721b-44a4-3160-adbf-34c7b3e13703",
                                                "text": "„Die beladenen Mulden brachte sie entweder am selben Tag oder am Morgen des Folgetages mit einem Lkw in ihren Betrieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mulde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c4b489d-7750-3445-8c4d-d82a50f70b14",
                                        "entry_id": "0e6ce9d0-d23a-3a12-93a3-074f935190ef",
                                        "glosses": [
                                            "Fluss in Deutschland, Zusammenfluss von Zwickauer Mulde und Freiberger Mulde, der in die Elbe mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c477fe1d-cb18-4cb7-b0f4-e05dd06d375f",
                                                "sense_id": "0c4b489d-7750-3445-8c4d-d82a50f70b14",
                                                "text": "Die Mulde hat zwei Quellflüsse."
                                            },
                                            {
                                                "example_id": "484ccb1f-3934-4ac3-a9b4-197309f2094f",
                                                "sense_id": "0c4b489d-7750-3445-8c4d-d82a50f70b14",
                                                "text": "Wir überquerten die Mulde."
                                            },
                                            {
                                                "example_id": "b112f599-6905-4d72-a3ea-84ea8ffbc543",
                                                "sense_id": "0c4b489d-7750-3445-8c4d-d82a50f70b14",
                                                "text": "Die Kinder versuchten, in der Mulde zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
