                                "target_senses": [
                                    {
                                        "sense_id": "7b65f0b6-46d3-3ed6-8d8b-e966f278b7ed",
                                        "entry_id": "e5d46c9b-14d8-32e0-8996-ee22d47a36ad",
                                        "glosses": [
                                            "A person or group that acts in an auxiliary manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439abbbe-589f-4394-a552-103e5b885484",
                                                "sense_id": "7b65f0b6-46d3-3ed6-8d8b-e966f278b7ed",
                                                "text": "A drive to exploit the Highlands as a winter sports area, with all the necessary auxiliaries, such as chair lifts in the Cairngorms, shows increasing promise, […]."
                                            },
                                            {
                                                "example_id": "6417790b-18f3-47f5-b789-29ad053d191a",
                                                "sense_id": "7b65f0b6-46d3-3ed6-8d8b-e966f278b7ed",
                                                "text": "Auxiliaries and ancillaries are comprehensive, and include a Westinghouse motor-driven recriprocating compressor used for locomotive braking and general service air, two rotary exhauster sets for train brakes when hauling passenger or fitted freight trains, and an oil-fired train heating boiler."
                                            },
                                            {
                                                "example_id": "79900dd3-9af2-422f-af96-f0ec8bae22a9",
                                                "sense_id": "7b65f0b6-46d3-3ed6-8d8b-e966f278b7ed",
                                                "text": "Summer “felt betrayed” that a close friend had used AI as “an auxiliary” to talk to her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47744a7-0bcf-3bf0-a88b-f98ee102eaae",
                                        "entry_id": "e5d46c9b-14d8-32e0-8996-ee22d47a36ad",
                                        "glosses": [
                                            "A sailing vessel equipped with an engine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bd53e4c-930a-3a49-97aa-ebb0fe996ea7",
                                        "entry_id": "e5d46c9b-14d8-32e0-8996-ee22d47a36ad",
                                        "glosses": [
                                            "Ellipsis of auxiliary verb."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ee0632-e37f-449e-ac79-709f1041e8e9",
                                                "sense_id": "3bd53e4c-930a-3a49-97aa-ebb0fe996ea7",
                                                "text": "The three traditionally recognized Non-modal Auxiliaries are the per-\nfective Auxiliary have, the progressive Auxiliary be, and the passive Auxiliary\nbe. Perfective have is so-called because it marks the completion (hence, perfec-\ntion) of an action; it is followed by a VP headed by a perfective -n participle, as\nin:\n(121) The referee has [_(VP) shown him the red card]"
                                            }
                                        ]
                                    },
