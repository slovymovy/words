{
    "word_family": [
        "bevangen",
        "onbevangenheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "14f0670a-6ec5-350c-872b-842976590781",
                    "sense_definition": "Zonder vooroordelen of vooringenomenheid; onpartijdig en open-minded.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbevooroordeeld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk om met een <w>onbevangen</w> blik naar nieuwe ideeën te luisteren.",
                            "target_lang_translations": {
                                "en": "It is important to listen to new ideas with an <w>open-minded</w> perspective."
                            }
                        },
                        {
                            "text": "De rechter probeerde de zaak op een uiterst <w>onbevangen</w> manier te beoordelen.",
                            "target_lang_translations": {
                                "en": "The judge tried to assess the case in an extremely <w>unbiased</w> manner."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbevooroordeeld",
                        "onpartijdig",
                        "objectief"
                    ],
                    "antonyms": [
                        "bevooroordeeld",
                        "partijdig"
                    ],
                    "common_phrases": [
                        "onbevangen blik",
                        "onbevangen houding"
                    ],
                    "target_lang_definitions": {
                        "en": "Without prejudice or bias; impartial and open-minded."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "open-minded",
                                "target_lang_sense_clarification": "receptive to new ideas or arguments"
                            },
                            {
                                "target_lang_word": "unbiased",
                                "target_lang_sense_clarification": "impartial and without prejudice"
                            },
                            {
                                "target_lang_word": "unprejudiced",
                                "target_lang_sense_clarification": "not having or showing a dislike or distrust of a group or person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7465e829-886e-3707-8300-d787c8fc01ce",
                    "sense_definition": "Vrijmoedig, ongedwongen en zonder schroom of verlegenheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vrijmoedig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kinderen kunnen vaak heel <w>onbevangen</w> reageren op vreemde situaties.",
                            "target_lang_translations": {
                                "en": "Children can often react very <w>spontaneously</w> to strange situations."
                            }
                        },
                        {
                            "text": "Zij sprak op een <w>onbevangen</w> manier over haar persoonlijke ervaringen.",
                            "target_lang_translations": {
                                "en": "She spoke about her personal experiences in an <w>uninhibited</w> way."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrijmoedig",
                        "ongedwongen",
                        "onbeschroomd",
                        "spontaan"
                    ],
                    "antonyms": [
                        "verlegen",
                        "geremd",
                        "schuw"
                    ],
                    "common_phrases": [
                        "onbevangen reageren",
                        "onbevangen praten"
                    ],
                    "target_lang_definitions": {
                        "en": "Free, unconstrained, and without hesitation or shyness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uninhibited",
                                "target_lang_sense_clarification": "expressing one's feelings or thoughts without restraint"
                            },
                            {
                                "target_lang_word": "spontaneous",
                                "target_lang_sense_clarification": "natural and unconstrained in behavior"
                            },
                            {
                                "target_lang_word": "candid",
                                "target_lang_sense_clarification": "truthful and straightforward; frank"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}