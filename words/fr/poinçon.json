                    "frequency": "Middle",
                    "semantic_group_id": "outil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan utilise un <w>poinçon</w> pour percer un trou supplémentaire dans cette ceinture en cuir."
