                    "sense_definition": "veel geld kostend; duur",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waarde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat paleis was ingericht met buitengewoon <w>kostelijke</w> meubels van zeldzaam hout.",
                            "target_lang_translations": {
                                "fr": "Ce palais était meublé de pièces extrêmement <w>coûteuses</w> en bois rare."
