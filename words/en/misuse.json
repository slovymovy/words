{
    "word_family": [
        "misuser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09edaf93-af1f-3998-84e7-dbe2d2a344e9",
                    "sense_definition": "To use something in an incorrect, unsuitable, or improper way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "use_incorrectly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>misuse</w> these tools, you could damage the equipment or injure yourself.",
                            "target_lang_translations": {
                                "ru": "Если вы будете <w>неправильно использовать</w> эти инструменты, вы можете повредить оборудование или пораниться."
                            }
                        },
                        {
                            "text": "The company accused former employees of <w>misusing</w> confidential customer data.",
                            "target_lang_translations": {
                                "ru": "Компания обвинила бывших сотрудников в <w>неправомерном использовании</w> конфиденциальных данных клиентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "misapply"
                    ],
                    "common_phrases": [
                        "misuse power",
                        "misuse funds",
                        "misuse resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать что-либо неправильно, не по назначению или во вред."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злоупотреблять",
                                "target_lang_sense_clarification": "полномочиями, доверием, положением"
                            },
                            {
                                "target_lang_word": "неправильно использовать",
                                "target_lang_sense_clarification": "инструменты, данные, ресурсы"
                            },
                            {
                                "target_lang_word": "нерационально использовать",
                                "target_lang_sense_clarification": "ресурсы, бюджет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58fec574-188b-3340-8313-c3495fff7620",
                    "sense_definition": "To treat someone or something badly, cruelly, or unfairly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mistreat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was accused of <w>misusing</w> his pets by neglecting them for days.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в <w>жестоком обращении с</w> домашними питомцами, которых он оставлял без присмотра на несколько дней."
                            }
                        },
                        {
                            "text": "The workers felt that management had consistently <w>misused</w> their goodwill.",
                            "target_lang_translations": {
                                "ru": "Рабочие чувствовали, что руководство постоянно <w>злоупотребляло</w> их доброй волей."
                            }
                        }
                    ],
                    "synonyms": [
                        "abuse",
                        "mistreat",
                        "ill-treat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохо, жестоко или несправедливо обращаться с кем-либо или чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жестоко обращаться",
                                "target_lang_sense_clarification": "с людьми или животными"
                            },
                            {
                                "target_lang_word": "злоупотреблять",
                                "target_lang_sense_clarification": "добротой, терпением"
                            },
                            {
                                "target_lang_word": "плохо обращаться",
                                "target_lang_sense_clarification": "с кем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37c34eec-9f46-3605-8374-0a8a9eb0c00b",
                    "sense_definition": "To insult or abuse someone verbally.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mistreat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The furious customer continued to <w>misuse</w> the clerk until security arrived.",
                            "target_lang_translations": {
                                "ru": "Разъярённый клиент продолжал <w>оскорблять</w> клерка до тех пор, пока не прибыла охрана."
                            }
                        },
                        {
                            "text": "He remained remarkably calm even after being publicly <w>misused</w> by his political opponents.",
                            "target_lang_translations": {
                                "ru": "Он сохранял поразительное спокойствие даже после того, как его публично <w>поносили</w> политические оппоненты."
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "revile"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage for verbal abuse"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорблять кого-либо словами, бранить (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "словесно"
                            },
                            {
                                "target_lang_word": "поносить",
                                "target_lang_sense_clarification": "бранить, хулить"
                            },
                            {
                                "target_lang_word": "бранить",
                                "target_lang_sense_clarification": "ругать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14aa1806-ae79-3819-915b-f0ab03d7b707",
                    "sense_definition": "To sexually assault or abuse someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mistreat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical records indicate that many captive women were <w>misused</w> during the conquest.",
                            "target_lang_translations": {
                                "ru": "Исторические свидетельства указывают на то, что многие пленницы были <w>обесчещены</w> во время завоевания."
                            }
                        },
                        {
                            "text": "The old chronicle describes how prisoners were repeatedly <w>misused</w> by the guards.",
                            "target_lang_translations": {
                                "ru": "Старая хроника описывает, как охранники неоднократно <w>надругались над</w> пленными."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic or euphemistic sense for sexual assault"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать сексуальному насилию или домогательствам (устаревшее или эвфемизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обесчестить",
                                "target_lang_sense_clarification": "совершить насилие (устар.)"
                            },
                            {
                                "target_lang_word": "надругаться",
                                "target_lang_sense_clarification": "совершить сексуальное насилие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6b40133-e6c5-3e4e-b5d4-063778442d7d",
                    "sense_definition": "An incorrect, improper, or unlawful use of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "use_incorrectly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report exposed widespread <w>misuse</w> of public funds by senior officials.",
                            "target_lang_translations": {
                                "ru": "В отчёте раскрыто масштабное <w>нецелевое использование</w> государственных средств высокопоставленными чиновниками."
                            }
                        },
                        {
                            "text": "Teachers often complain about the persistent <w>misuse</w> of grammar in student essays.",
                            "target_lang_translations": {
                                "ru": "Учителя часто жалуются на постоянное <w>неправильное употребление</w> грамматических правил в сочинениях учеников."
                            }
                        }
                    ],
                    "synonyms": [
                        "misapplication"
                    ],
                    "common_phrases": [
                        "misuse of power",
                        "misuse of funds",
                        "drug misuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неправильное, ненадлежащее или незаконное использование чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злоупотребление",
                                "target_lang_sense_clarification": "властью, полномочиями, средствами"
                            },
                            {
                                "target_lang_word": "неправильное употребление",
                                "target_lang_sense_clarification": "слов, понятий, правил"
                            },
                            {
                                "target_lang_word": "нецелевое использование",
                                "target_lang_sense_clarification": "финансов, ресурсов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}