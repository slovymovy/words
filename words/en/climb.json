{
    "word_family": [
        "climbable",
        "climber",
        "climbdown",
        "clifftop"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10587d5c-1c7b-338a-81d5-1232e5856759",
                    "sense_definition": "To move upwards on something (for example, a mountain or a tree).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physically move upward",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>climbed</w> the hill after school and watched the sunset.",
                            "target_lang_translations": {
                                "ru": "Дети <w>взобрались</w> на холм после школы и смотрели на закат."
                            }
                        },
                        {
                            "text": "We <w>climb</w> a mountain every summer when the weather is good.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поднимаемся</w> в горы каждое лето, когда стоит хорошая погода."
                            }
                        }
                    ],
                    "antonyms": [
                        "descend"
                    ],
                    "common_phrases": [
                        "climb a mountain",
                        "climb a tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться вверх по чему-либо (например, по горе или дереву)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "на гору или дерево"
                            },
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "вверх по склону"
                            },
                            {
                                "target_lang_word": "залезать",
                                "target_lang_sense_clarification": "на дерево или возвышенность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef39c09e-34e6-307c-86fb-71377c8e34b7",
                    "sense_definition": "To move by gripping with the hands and using the feet, especially on or over something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physically move upward",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when you <w>climb</w> out of the boat onto the dock.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, когда <w>вылезаешь</w> из лодки на причал."
                            }
                        },
                        {
                            "text": "The mechanic <w>climbed</w> up the ladder to fix the light.",
                            "target_lang_translations": {
                                "ru": "Механик <w>поднялся</w> по лестнице, чтобы починить свет."
                            }
                        }
                    ],
                    "antonyms": [
                        "climb down"
                    ],
                    "common_phrases": [
                        "climb out of bed",
                        "climb up a ladder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться, цепляясь руками и используя ноги, особенно по чему-либо или через что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карабкаться",
                                "target_lang_sense_clarification": "используя руки и ноги"
                            },
                            {
                                "target_lang_word": "лезть",
                                "target_lang_sense_clarification": "через препятствие или по лестнице"
                            },
                            {
                                "target_lang_word": "вылезать",
                                "target_lang_sense_clarification": "из лодки или машины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e05798a-e925-3993-b479-546298c2838a",
                    "sense_definition": "To scale; to get to the top of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physically move upward",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>climbed</w> to the top of the tower for a better view.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поднялись</w> на вершину башни, чтобы полюбоваться видом."
                            }
                        },
                        {
                            "text": "They plan to <w>climb</w> Mount Everest one day, but they are training first.",
                            "target_lang_translations": {
                                "ru": "Они планируют однажды <w>совершить восхождение</w> на Эверест, но сначала тренируются."
                            }
                        }
                    ],
                    "synonyms": [
                        "scale"
                    ],
                    "antonyms": [
                        "descend"
                    ],
                    "common_phrases": [
                        "climb to the top",
                        "climb the peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать восхождение; добираться до вершины чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взобраться",
                                "target_lang_sense_clarification": "на самую вершину"
                            },
                            {
                                "target_lang_word": "покорять",
                                "target_lang_sense_clarification": "вершину горы"
                            },
                            {
                                "target_lang_word": "подняться",
                                "target_lang_sense_clarification": "на верхний этаж или пик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daef4c3a-ef7c-3fbe-b7e3-04b93ee01d55",
                    "sense_definition": "To ascend or rise; to go up (often used for levels, numbers, smoke, or prices).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "upward movement increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the storm, black smoke <w>climbed</w> into the gray sky.",
                            "target_lang_translations": {
                                "ru": "Во время шторма черный дым <w>поднимался</w> в серое небо."
                            }
                        },
                        {
                            "text": "After the new tax, prices <w>climbed</w> quickly in many stores.",
                            "target_lang_translations": {
                                "ru": "После введения нового налога цены во многих магазинах быстро <w>выросли</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "fall",
                        "drop"
                    ],
                    "common_phrases": [
                        "prices climb quickly",
                        "smoke climbs upward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься или расти; идти вверх (часто о показателях, числах, дыме или ценах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "о дыме или ценах"
                            },
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "о ценах или уровне"
                            },
                            {
                                "target_lang_word": "взлетать",
                                "target_lang_sense_clarification": "о быстро растущих ценах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bb3a1c5-2b75-3883-a950-b25a731f6c14",
                    "sense_definition": "To move to a higher position in a ranking, list, or chart.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "upward movement increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The song <w>climbed</w> to number one after the TV performance.",
                            "target_lang_translations": {
                                "ru": "Песня <w>поднялась</w> на первое место после выступления по телевидению."
                            }
                        },
                        {
                            "text": "Sales began to <w>climb</w> to a new record during the holiday season.",
                            "target_lang_translations": {
                                "ru": "Продажи начали <w>расти</w> до нового рекорда во время праздничного сезона."
                            }
                        }
                    ],
                    "antonyms": [
                        "fall",
                        "drop"
                    ],
                    "common_phrases": [
                        "climb to number one",
                        "climb the charts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться на более высокую позицию в рейтинге, списке или чарте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "в рейтинге или чарте"
                            },
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "о показателях продаж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cadfcb3f-6f1c-3d40-8aa7-aa729ab688d4",
                    "sense_definition": "To practise the sport of climbing.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "physically move upward",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>climb</w> indoors in winter when the cliffs are too wet.",
                            "target_lang_translations": {
                                "ru": "Зимой я <w>лазаю</w> в зале, когда скалы слишком влажные."
                            }
                        },
                        {
                            "text": "She loves to <w>climb</w> with friends at the gym every weekend.",
                            "target_lang_translations": {
                                "ru": "Она любит <w>заниматься скалолазанием</w> с друзьями в зале каждые выходные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "climb at the gym",
                        "climb indoors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься скалолазанием или альпинизмом как видом спорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься скалолазанием",
                                "target_lang_sense_clarification": "как хобби или спорт"
                            },
                            {
                                "target_lang_word": "лазать",
                                "target_lang_sense_clarification": "на скалодроме или по скалам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "620511cb-2750-3adc-9bdf-1ac40e9f83b4",
                    "sense_definition": "To move to a higher position in society or in an organization.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "social advancement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>climb</w> the ladder by taking credit for other people’s work.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>продвинуться</w> по карьерной лестнице, присваивая себе заслуги других людей."
                            }
                        },
                        {
                            "text": "In that company, it is hard to <w>climb</w> into management without experience.",
                            "target_lang_translations": {
                                "ru": "В этой компании трудно <w>попасть</w> в руководство без опыта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "climb the ladder",
                        "climb into management"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продвигаться вверх по социальной лестнице или в организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвигаться",
                                "target_lang_sense_clarification": "по карьерной лестнице"
                            },
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "в должности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "544d93e6-f30d-3cb4-8fd0-791d5db7c987",
                    "sense_definition": "To jump high, especially in sports to reach the ball.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports jump high",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker <w>climbed</w> for a header and nearly scored at the far post.",
                            "target_lang_translations": {
                                "ru": "Нападающий <w>выпрыгнул</w> для удара головой и чуть не забил у дальней штанги."
                            }
                        },
                        {
                            "text": "He <w>climbed</w> high in the box and met the cross with his head.",
                            "target_lang_translations": {
                                "ru": "Он высоко <w>подпрыгнул</w> в штрафной и пробил головой после навеса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "climb for a header",
                        "climb high"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высоко подпрыгивать, особенно в спорте, чтобы дотянуться до мяча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпрыгивать",
                                "target_lang_sense_clarification": "для удара головой"
                            },
                            {
                                "target_lang_word": "взлетать",
                                "target_lang_sense_clarification": "в воздух за мячом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "196e2316-c906-3b56-8b2f-17c1146369a9",
                    "sense_definition": "Of plants, to grow upwards by clinging to something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plants growth habit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This vine will <w>climb</w> up a wall if you give it support.",
                            "target_lang_translations": {
                                "ru": "Эта лоза будет <w>виться</w> вверх по стене, если дать ей опору."
                            }
                        },
                        {
                            "text": "In spring, the beans <w>climb</w> along the sticks and grow very fast.",
                            "target_lang_translations": {
                                "ru": "Весной бобы <w>плетутся</w> по колышкам и растут очень быстро."
                            }
                        }
                    ],
                    "common_phrases": [
                        "climb up a wall",
                        "climb along a fence"
                    ],
                    "target_lang_definitions": {
                        "ru": "О растениях: расти вверх, цепляясь за опору."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виться",
                                "target_lang_sense_clarification": "о растениях по опоре"
                            },
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "вверх по стене"
                            },
                            {
                                "target_lang_word": "карабкаться",
                                "target_lang_sense_clarification": "о лианах или лозе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18cc6fca-530f-3e6c-b917-b98346a31840",
                    "sense_definition": "An act or period of climbing, especially to reach a higher place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "act of climbing physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>climb</w> was easier than we expected because the path was wide.",
                            "target_lang_translations": {
                                "ru": "<w>Подъём</w> оказался легче, чем мы ожидали, потому что тропа была широкой."
                            }
                        },
                        {
                            "text": "We started the <w>climb</w> up the mountain before sunrise to avoid the heat.",
                            "target_lang_translations": {
                                "ru": "Мы начали <w>восхождение</w> на гору до рассвета, чтобы избежать жары."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a steep climb",
                        "the climb up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или период подъема, особенно для достижения более высокого места."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "процесс движения вверх"
                            },
                            {
                                "target_lang_word": "восхождение",
                                "target_lang_sense_clarification": "на гору"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "510c00f6-2f8b-3941-9699-bc98cfbc7d3e",
                    "sense_definition": "A difficult effort or process of moving upward, often used in a figurative way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "upward movement increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing his job, the <w>climb</w> out of poverty took many years.",
                            "target_lang_translations": {
                                "ru": "После потери работы <w>путь</w> из нищеты занял много лет."
                            }
                        },
                        {
                            "text": "A sudden <w>climb</w> in prices made rent too expensive for many families.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>рост</w> цен сделал аренду слишком дорогой для многих семей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the climb out",
                        "a climb in prices"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудное усилие или процесс движения вверх, часто в переносном смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путь",
                                "target_lang_sense_clarification": "к выходу из сложной ситуации"
                            },
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "цен или показателей"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "из бедности или кризиса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}