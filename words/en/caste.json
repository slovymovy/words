{
    "word_family": [
        "casteless",
        "castelessness",
        "outcaste"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fa0d46b-d9f5-396c-8312-20fabaee6e4f",
                    "sense_definition": "A hereditary social class and subclass in South Asian societies or historically in other cultures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Discrimination based on <w>caste</w> is prohibited by law, but traditional attitudes change slowly.",
                            "target_lang_translations": {
                                "ru": "Дискриминация по признаку <w>касты</w> запрещена законом, однако традиционные взгляды меняются медленно."
                            }
                        },
                        {
                            "text": "The organization provides aid to all individuals regardless of their religion or <w>caste</w>.",
                            "target_lang_translations": {
                                "ru": "Организация оказывает помощь всем людям независимо от их вероисповедания или <w>касты</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "caste system",
                        "lower caste",
                        "upper caste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наследственная общественная группа в странах Южной Азии или исторически в других культурах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каста",
                                "target_lang_sense_clarification": "обособленная общественная группа"
                            },
                            {
                                "target_lang_word": "варна",
                                "target_lang_sense_clarification": "сословная группа в древней Индии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5405a640-adff-32e3-9171-2193a6c5f9ea",
                    "sense_definition": "The system of dividing society into hereditary social classes; the caste system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sociologist wrote extensively on the enduring influence of <w>caste</w> in rural communities.",
                            "target_lang_translations": {
                                "ru": "Социолог подробно писал о сохраняющемся влиянии <w>кастовой системы</w> в сельских общинах."
                            }
                        },
                        {
                            "text": "They discussed how <w>caste</w> restricted economic mobility for generations.",
                            "target_lang_translations": {
                                "ru": "Они обсуждали, как <w>кастовый строй</w> на протяжении поколений ограничивал экономическую мобильность."
                            }
                        }
                    ],
                    "synonyms": [
                        "caste system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система деления общества на замкнутые наследственные классы; кастовая система."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кастовая система",
                                "target_lang_sense_clarification": "система кастового строя"
                            },
                            {
                                "target_lang_word": "кастовый строй",
                                "target_lang_sense_clarification": "социальный строй, основанный на кастах"
                            },
                            {
                                "target_lang_word": "кастовость",
                                "target_lang_sense_clarification": "принцип деления на касты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf5cb32c-5119-31e3-b8c2-60bc96170ab7",
                    "sense_definition": "A rigid, exclusive social group or class that maintains distinct privileges and social boundaries.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy governing <w>caste</w> rarely interacted with ordinary citizens.",
                            "target_lang_translations": {
                                "ru": "Богатая правящая <w>каста</w> редко общалась с простыми гражданами."
                            }
                        },
                        {
                            "text": "He felt that his professional colleagues formed an insular and self-serving <w>caste</w>.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что его коллеги по профессии образовали замкнутую и своекорыстную <w>касту</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "class",
                        "order",
                        "stratum"
                    ],
                    "common_phrases": [
                        "ruling caste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Замкнутая, привилегированная общественная группа, отделяющая себя от остального общества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каста",
                                "target_lang_sense_clarification": "замкнутая группа людей"
                            },
                            {
                                "target_lang_word": "сословие",
                                "target_lang_sense_clarification": "обособленный общественный слой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69555835-da56-3efc-b75c-397cab887192",
                    "sense_definition": "A specialized group of social insects having a particular form and performing a specific role in a colony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a beehive, almost all bees belong to the worker <w>caste</w>.",
                            "target_lang_translations": {
                                "ru": "В пчелином улье почти все пчелы принадлежат к <w>касте</w> рабочих особей."
                            }
                        },
                        {
                            "text": "The soldier <w>caste</w> defends the termite mound against predators.",
                            "target_lang_translations": {
                                "ru": "<w>Каста</w> солдат защищает термитник от хищников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worker caste",
                        "soldier caste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специализированная группа общественных насекомых, имеющая особое строение и выполняющая определенную роль в колонии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каста",
                                "target_lang_sense_clarification": "у общественных насекомых"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}