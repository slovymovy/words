                                    {
                                        "sense_id": "59003928-f06d-3f3d-8420-ea41385c0e4f",
                                        "entry_id": "f27eed00-b3ad-3588-836c-4ed00cf4cc55",
                                        "glosses": [
                                            "Résultat de celle-ci."
