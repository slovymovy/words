                "senses": [
                    {
                        "sense_id": "5793cc17-99cd-3cc6-ab35-b29b989c0a0e",
                        "entry_id": "81a06b97-2d74-3b06-8d81-3dd4ccb68575",
                        "glosses": [
                            "устар., разг. монета или сумма в пятнадцать копеек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a1808b5-9954-4bb1-aa11-afee49d6cc01",
                                "sense_id": "5793cc17-99cd-3cc6-ab35-b29b989c0a0e",
                                "text": "— Ну-ко, брат, оцени-ка, сколько заплатил? — говорит прохожий приятелю, показывая покупку. — Пятачок? — Что-о-о-о?.. — Пятиалтынный что ли?.. — Вот за эту цепочку пятачок?! — Вот за эту цепочку пятачок… — Ты говоришь? — Я говорю…"
                            }
                        ]
                    }
                ],
