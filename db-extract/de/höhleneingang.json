                ],
                "senses": [
                    {
                        "sense_id": "fe3ccf07-44ba-3a11-bf6d-b824eb0a89a2",
                        "entry_id": "33a32f1f-a445-3116-ac27-e57360fc8ee5",
                        "glosses": [
                            "der Eingang zu einer Höhle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebe422e-040e-4774-8572-4db1735be849",
                                "sense_id": "fe3ccf07-44ba-3a11-bf6d-b824eb0a89a2",
                                "text": "„Das Störhaus ist eine Alpenvereinshütte knapp eine Dreiviertelstunde vom Höhleneingang entfernt.“"
                            },
                            {
                                "example_id": "a585d47d-7fda-445b-be05-b5047c36afc2",
                                "sense_id": "fe3ccf07-44ba-3a11-bf6d-b824eb0a89a2",
                                "text": "„Du hättest den Höhleneingang übersehen, hätte Gavrilo nicht angehalten.“"
                            },
                            {
                                "example_id": "15ebf4c0-f57a-421a-b5c9-5b829968d111",
                                "sense_id": "fe3ccf07-44ba-3a11-bf6d-b824eb0a89a2",
                                "text": "„Der Bogen, der den Höhleneingang bildete, ist übrigens nur halb so hoch, und aus ihm strömt das Wasser so reichlich, daß es schon am Ursprung den Namen Fluß verdient.“"
                            },
                            {
                                "example_id": "857b263a-1162-4f88-848b-6cf12cfd7183",
                                "sense_id": "fe3ccf07-44ba-3a11-bf6d-b824eb0a89a2",
                                "text": "„Auch Ferris sah jetzt, dass sich in den Schatten des Höhleneingangs etwas nach draußen, ans Licht bewegte, und er dachte: Jetzt haben wir ihn.“"
                            },
                            {
                                "example_id": "1d915683-7708-4683-9f5a-ef7dd4604313",
                                "sense_id": "fe3ccf07-44ba-3a11-bf6d-b824eb0a89a2",
                                "text": "„Überraschend scheint es nicht, dass Chung Ga, als er mich im Delirium stammelnd am Höhleneingang fand, erst einmal gezwungen war, mich ins Sonnenlicht zu tragen und mir große Löffel belebenden Weins in die ausgedörrte Kehle einflößte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
