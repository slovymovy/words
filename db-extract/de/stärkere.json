                ],
                "senses": [
                    {
                        "sense_id": "a91cef24-bcc1-3a89-839d-203059a76a69",
                        "entry_id": "78625906-21b8-3925-a9d2-e69aa31175d1",
                        "glosses": [
                            "weibliche Person, die mehr Kraft hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f32020a-6eda-4532-bcae-574a0f36a92c",
                                "sense_id": "a91cef24-bcc1-3a89-839d-203059a76a69",
                                "text": "„Aber wenn nun Elvira die Stärkere ist?“"
                            },
                            {
                                "example_id": "45e0d3d6-c14e-4320-b177-6064486d74e3",
                                "sense_id": "a91cef24-bcc1-3a89-839d-203059a76a69",
                                "text": "„Noch immer stellt die Wohnung das wichtigste Kapital für eine Paarbeziehung oder die Wiederheirat dar. Der/die Stärkere gewinnt, und das Gesetz kann niemanden zwingen, eine auch zu Unrecht benutzte Wohnung aufzugeben.“"
                            },
                            {
                                "example_id": "57328982-c160-4de8-aca1-9983f9b281b1",
                                "sense_id": "a91cef24-bcc1-3a89-839d-203059a76a69",
                                "text": "„Die Stärkere gewinnt. Sie kehrt darauf zu ihrem Mann zurück. Ja? STRINDBERG Völlig richtig! Der abwesende Mann ist die Hauptperson!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
