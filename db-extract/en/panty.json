                        "sense_id": "3ce983c0-ab62-30e8-9d7c-a95da871ec58",
                        "entry_id": "6af5bef0-b791-38ee-b8e7-8f31db15feef",
                        "glosses": [
                            "Short trousers for men, or more usually boys."
                        ],
                        "tags": [
                            "in-plural",
