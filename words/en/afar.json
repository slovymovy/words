{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b1636844-12d2-3e97-b595-8e3dc2322890",
                    "sense_definition": "At, to, or from a great distance; far away.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountains could be seen clearly from <w>afar</w>.",
                            "target_lang_translations": {
                                "ru": "Горы были хорошо видны <w>издалека</w>."
                            }
                        },
                        {
                            "text": "He watched the celebration from <w>afar</w> because he did not want to be noticed.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал за празднованием <w>издали</w>, потому что не хотел, чтобы его заметили."
                            }
                        }
                    ],
                    "synonyms": [
                        "distantly",
                        "remotely"
                    ],
                    "antonyms": [
                        "nearby"
                    ],
                    "common_phrases": [
                        "seen from afar",
                        "loved from afar"
                    ],
                    "target_lang_definitions": {
                        "ru": "На большом расстоянии, издалека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "издалека́",
                                "target_lang_sense_clarification": "с большого расстояния (акцент на направлении взгляда или действия)"
                            },
                            {
                                "target_lang_word": "и́здали",
                                "target_lang_sense_clarification": "с большого расстояния (синоним к издалека)"
                            },
                            {
                                "target_lang_word": "вдали́",
                                "target_lang_sense_clarification": "на большом расстоянии (указывает на местоположение)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "feb8bd28-fabf-33e6-b31c-769f5503638a",
                    "sense_definition": "A member of the ethnic group that speaks the Afar language.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Afar</w> people have a rich cultural history in the Horn of Africa.",
                            "target_lang_translations": {
                                "ru": "Народ <w>афары</w> имеет богатую культурную историю на Африканском Роге."
                            }
                        },
                        {
                            "text": "Many <w>Afar</w> live in the desert regions of Ethiopia and Eritrea.",
                            "target_lang_translations": {
                                "ru": "Многие <w>афары</w> живут в пустынных районах Эфиопии и Эритреи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель народа афары, проживающего в Восточной Африке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "афа́р",
                                "target_lang_sense_clarification": "представитель народа афары"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4027ba42-3ef3-364f-90f6-0eaf13254e3f",
                    "sense_definition": "A Cushitic language spoken in Ethiopia, Eritrea, and Djibouti.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Linguists study <w>Afar</w> to understand the development of Cushitic languages.",
                            "target_lang_translations": {
                                "ru": "Лингвисты изучают <w>афарский</w> язык, чтобы понять развитие кушитских языков."
                            }
                        },
                        {
                            "text": "The <w>Afar</w> language is primarily used in the Horn of Africa.",
                            "target_lang_translations": {
                                "ru": "<w>Афарский</w> язык в основном используется на Африканском Роге."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кушитский язык, на котором говорят в Эфиопии, Эритрее и Джибути."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "афа́рский язы́к",
                                "target_lang_sense_clarification": "название языка"
                            },
                            {
                                "target_lang_word": "данаки́льский язы́к",
                                "target_lang_sense_clarification": "устаревшее или альтернативное название языка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bafbb0c-e63a-3203-a7d4-05ad4df4eddc",
                    "sense_definition": "A region of Ethiopia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The <w>Afar</w> region is known for its extreme heat and volcanic activity.",
                            "target_lang_translations": {
                                "ru": "Регион <w>Афар</w> известен своей экстремальной жарой и вулканической активностью."
                            }
                        },
                        {
                            "text": "Travelers often visit the <w>Afar</w> region to see the unique geological formations.",
                            "target_lang_translations": {
                                "ru": "Путешественники часто посещают регион <w>Афар</w>, чтобы увидеть уникальные геологические образования."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Регион в Эфиопии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Афа́р",
                                "target_lang_sense_clarification": "название административного региона"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}