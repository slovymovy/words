                        ],
                        "form": "die Wirtschaftsministerien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99b0e532-d860-3705-991e-01fca36d0150",
                        "entry_id": "0cc3d249-1aaa-34d6-a3e4-50eb35263d26",
                        "glosses": [
                            "Ministerium, das für die wirtschaftliche Entwicklung eines Staates zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ef67ce-141c-43f9-a7d4-41613967b4b1",
                                "sense_id": "99b0e532-d860-3705-991e-01fca36d0150",
                                "text": "„Die Besprechungen über die Ausweitung des Interzonenhandels, die zwischen den süddeutschen Wirtschaftsministerien und entsprechenden Stellen der sowjetischen Zone stattfinden sollten, sind aufgeschoben worden.“"
                            },
                            {
                                "example_id": "4d3758aa-41cf-402a-b7d3-e50d93b9529a",
                                "sense_id": "99b0e532-d860-3705-991e-01fca36d0150",
                                "text": "„Das großhessische Wirtschaftsministerium hat infolge Kohlenmangels ebenfalls durchgreifende Einsparungsmaßnahmen in der Elektrizitäts- und Gasversorgung angekündigt.“"
                            },
                            {
                                "example_id": "dadaad54-9196-4a4e-b6d5-b0c7d6aebadf",
                                "sense_id": "99b0e532-d860-3705-991e-01fca36d0150",
                                "text": "„Gabriel betritt sein Büro im Wirtschaftsministerium in der Scharnhorststraße nur kurz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
