    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7a0b61b-afa1-3b95-aa89-37d76db8537c",
                    "sense_definition": "Any of a series of Soviet and Russian fighter aircraft designed by the Mikoyan-Gurevich design bureau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aircraft",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "The museum features a perfectly preserved <w>MiG</w> from the Cold War era.",
                            "target_lang_translations": {
                                "ru": "В музее представлен прекрасно сохранившийся <w>МиГ</w> времен холодной войны."
                            }
                        },
                        {
                            "text": "During the air show, a supersonic <w>MiG</w> performed several impressive maneuvers over the airfield.",
                            "target_lang_translations": {
                                "ru": "Во время авиашоу сверхзвуковой <w>МиГ</w> выполнил несколько впечатляющих маневров над аэродромом."
                            }
                        }
                    ],
                    "synonyms": [
                        "Mikoyan"
                    ],
                    "common_phrases": [
                        "supersonic MiG",
                        "Soviet MiG"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из серии советских и российских истребителей, разработанных конструкторским бюро Микояна и Гуревича."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "МиГ",
                                "target_lang_sense_clarification": "марка самолета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4954c6f2-6c2a-3417-a99d-eb7c132c75f7",
                    "sense_definition": "A colloquial abbreviation for a <w>milligram</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete admitted to taking four hundred <w>migs</w> of the supplement every single day.",
                            "target_lang_translations": {
                                "ru": "Спортсмен признался, что принимал по четыреста <w>миллиграмм</w> добавки каждый божий день."
                            }
                        },
                        {
                            "text": "He was prescribed a dosage of fifty <w>migs</w> to manage his chronic symptoms.",
                            "target_lang_translations": {
                                "ru": "Ему прописали дозировку в пятьдесят <w>мг</w> для купирования хронических симптомов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hundred migs"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in bodybuilding or medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное сокращение для миллиграмма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миллиграмм",
                                "target_lang_sense_clarification": "единица веса"
                            },
                            {
                                "target_lang_word": "мг",
                                "target_lang_sense_clarification": "аббревиатура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a1e55bd-094e-334d-96b2-7b16653d8f91",
                    "sense_definition": "A member of the Luton Town MIGs (Men in Gear), a specific group of football hooligans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "subculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local police were on high alert for any <w>MIGs</w> arriving at the stadium before the match.",
                            "target_lang_translations": {
                                "ru": "Местная полиция была в состоянии повышенной готовности в ожидании прибытия любых <w>мигов</w> на стадион перед матчем."
                            }
                        },
                        {
                            "text": "It was the <w>MIGs</w> who quickly gained the upper hand during the confrontation at the pub.",
                            "target_lang_translations": {
                                "ru": "Именно <w>миги</w> быстро одержали верх во время стычки в пабе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifically related to Luton, England"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "hooligan subculture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член группировки футбольных хулиганов Luton Town MIGs (Men in Gear)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миг",
                                "target_lang_sense_clarification": "член фанатской группировки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "37c67d62-5e90-3f62-9802-244522a75624",
                    "sense_definition": "Relating to metal inert gas welding, a process using a continuous wire electrode.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "welding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician used a <w>MIG</w> welder to repair the broken steel frame of the car.",
                            "target_lang_translations": {
                                "ru": "Техник использовал сварочный аппарат <w>MIG</w> для ремонта сломанной стальной рамы автомобиля."
                            }
                        },
                        {
                            "text": "He prefers <w>MIG</w> welding because it is generally faster and easier for beginners to learn.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает сварку <w>MIG</w>, потому что она обычно быстрее и проще в освоении для новичков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "MIG welding",
                        "MIG welder"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к дуговой сварке плавящимся электродом в среде инертного газа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "MIG",
                                "target_lang_sense_clarification": "тип сварки"
                            },
                            {
                                "target_lang_word": "полуавтоматический",
                                "target_lang_sense_clarification": "о методе сварки"
                            }
                        ]
                    }
                }
            ]
        }
