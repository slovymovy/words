    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65d16961-a66c-3594-a4f3-f6175192dfd3",
                    "sense_definition": "regelmäßig wiederkehrende Monatsblutung bei geschlechtsreifen Mädchen und Frauen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "menstruation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Mädchen bekommen ihre erste <w>Periode</w> im Alter von etwa zwölf Jahren."
                        },
                        {
                            "text": "Wenn eine Frau schwanger ist, bleibt ihre monatliche <w>Periode</w> in der Regel aus."
                        }
                    ],
                    "synonyms": [
                        "Menstruation",
                        "Monatsblutung",
                        "Regel",
                        "Regelblutung"
                    ],
                    "common_phrases": [
                        "die Periode bekommen",
                        "die Periode haben"
                    ]
                },
                {
                    "sense_id": "49669ade-abb5-33e8-bd48-113953a08f5b",
                    "sense_definition": "ein durch bestimmte gemeinsame Merkmale oder Ereignisse abgegrenzter Zeitraum",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dieses berühmte Gemälde stammt aus der blauen <w>Periode</w> des spanischen Künstlers."
                        },
                        {
                            "text": "Das Land erlebte nach dem Krieg eine lange <w>Periode</w> des wirtschaftlichen Aufschwungs."
                        }
                    ],
                    "synonyms": [
                        "Epoche",
                        "Zeitraum"
                    ],
                    "common_phrases": [
                        "eine lange Periode"
                    ]
                },
                {
                    "sense_id": "18e4749a-9a9a-3d7b-9b4d-fbc6894ebfa7",
                    "sense_definition": "zeitlicher oder räumlicher Abstand, nach dem sich ein periodischer Ablauf wiederholt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zyklus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die physikalische <w>Periode</w> einer Schwingung beschreibt die Dauer für einen vollständigen Ablauf."
                        },
                        {
                            "text": "In der Mathematik hat die gewöhnliche Sinusfunktion eine feste <w>Periode</w> von zwei Pi."
                        }
                    ],
                    "synonyms": [
                        "Periodendauer"
                    ],
                    "common_phrases": [
                        "Periode einer Schwingung"
                    ]
                },
                {
                    "sense_id": "0cecd28a-3696-3a37-a6a2-9ad6e1922a71",
                    "sense_definition": "Ziffer oder Ziffernfolge, die sich nach dem Komma eines Dezimalbruchs unendlich wiederholt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Bruch ein Drittel ergibt als Dezimalzahl null Komma <w>Periode</w> drei."
                        },
                        {
                            "text": "Bei manchen mathematischen Brüchen umfasst die <w>Periode</w> hinter dem Komma mehrere Zahlen."
                        }
                    ]
                },
                {
                    "sense_id": "14232ade-32f8-30c3-8e02-e967ff276caa",
                    "sense_definition": "horizontale Zeile im Periodensystem der chemischen Elemente mit derselben Anzahl von Elektronenschalen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chemie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die erste <w>Periode</w> des Periodensystems umfasst lediglich die beiden Gase Wasserstoff und Helium."
                        },
                        {
                            "text": "Die chemischen Eigenschaften der Stoffe verändern sich entlang einer <w>Periode</w> von links nach rechts."
                        }
                    ],
                    "common_phrases": [
                        "erste Periode des Periodensystems"
                    ]
                },
                {
                    "sense_id": "c67822b9-4c8b-3c86-954f-bb25bb7c5946",
                    "sense_definition": "komplexes, rhetorisch und grammatisch kunstvoll gegliedertes Satzgefüge",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rhetorik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Klassische Schriftsteller wie Thomas Mann sind für ihre verschachtelten <w>Perioden</w> bekannt."
                        },
                        {
                            "text": "Eine kunstvolle <w>Periode</w> besteht meist aus einem Vordersatz und einem abschließenden Nachsatz."
                        }
                    ],
                    "synonyms": [
                        "Satzperiode"
                    ],
                    "antonyms": [
                        "einfacher Satz",
                        "Ellipse",
                        "Satzellipse",
                        "Satzgefüge",
                        "Satzreihe",
                        "Satzverbindung"
                    ]
                }
            ]
        }
    ]
