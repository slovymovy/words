                    "sense_definition": "Iets wat je in je handen hebt aan iemand anders geven, vaak nadat je het zelf hebt gekregen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je het zout even <w>doorgeven</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>pass</w> the salt?",
                                "ru": "Ты не мог бы <w>передать</w> соль?",
                                "de": "Kannst du bitte das Salz <w>weitergeben</w>?",
                                "pl": "Czy możesz <w>podać</w> sól?",
                                "fr": "Peux-tu me <w>faire passer</w> le sel ?",
                                "it": "Puoi <w>passarmi</w> il sale?",
                                "cs": "Můžeš mi prosím <w>podat</w> sůl?",
                                "tr": "Tuzu <w>uzatır</w> mısın?",
                                "es": "¿Puedes <w>pasar</w> la sal?",
                                "zh": "你能帮我把盐<w>递</w>一下吗？"
                            }
                        },
                        {
                            "text": "We moesten de zware dozen aan elkaar <w>doorgeven</w>.",
                            "target_lang_translations": {
                                "en": "We had to <w>pass</w> the heavy boxes to each other.",
                                "ru": "Нам пришлось <w>передавать</w> тяжелые коробки друг другу.",
                                "de": "Wir mussten die schweren Kartons aneinander <w>weitergeben</w>.",
                                "pl": "Musieliśmy <w>przekazywać</w> sobie nawzajem ciężkie pudła.",
                                "fr": "Nous devions nous <w>faire passer</w> les cartons lourds.",
                                "it": "Dovevamo <w>passarci</w> le scatole pesanti l'un l'altro.",
                                "cs": "Museli jsme si ty těžké krabice navzájem <w>předávat</w>.",
                                "tr": "Ağır kutuları birbirimize <w>iletmemiz</w> gerekiyordu.",
                                "es": "Tuvimos que <w>pasarnos</w> las cajas pesadas unos a otros.",
                                "zh": "我们必须把沉重的箱子一个接一个地<w>传递</w>下去。"
                            }
                        }
                    ],
                    "synonyms": [
