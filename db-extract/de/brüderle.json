                ],
                "senses": [
                    {
                        "sense_id": "dd6b2f66-b827-37a1-941e-7de2bf95a390",
                        "entry_id": "aebf1ca6-047f-3ca5-8814-e7f9ca16191d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e32c826b-be06-4bc0-9765-b9283c2a4fbc",
                                "sense_id": "dd6b2f66-b827-37a1-941e-7de2bf95a390",
                                "text": "Frau Brüderle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a948cbd8-42f7-4ebd-809e-572be7639591",
                                "sense_id": "dd6b2f66-b827-37a1-941e-7de2bf95a390",
                                "text": "Herr Brüderle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9b71933e-6a82-4c83-8e69-9de94b3af1d6",
                                "sense_id": "dd6b2f66-b827-37a1-941e-7de2bf95a390",
                                "text": "Die Brüderles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a9a7ec1b-847b-47aa-b26a-94e6b13a7953",
                                "sense_id": "dd6b2f66-b827-37a1-941e-7de2bf95a390",
                                "text": "Der Brüderle trägt nie die Pullover, die die Brüderle ihm strickt."
                            },
                            {
                                "example_id": "f82a6a8b-c9d6-438d-baa0-6fee555119b2",
                                "sense_id": "dd6b2f66-b827-37a1-941e-7de2bf95a390",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brüderle kommt, geht der Herr Brüderle.“"
                            },
                            {
                                "example_id": "67fb0b49-4730-42d2-a7ba-d005d664913c",
                                "sense_id": "dd6b2f66-b827-37a1-941e-7de2bf95a390",
                                "text": "Brüderle kommt und geht."
                            },
                            {
                                "example_id": "be6460fd-fe85-4449-be18-3527f37394ed",
                                "sense_id": "dd6b2f66-b827-37a1-941e-7de2bf95a390",
                                "text": "Brüderles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
