                                        "entry_id": "855358e4-0be6-33f0-b65e-4b431d8fa27e",
                                        "glosses": [
                                            "The buildings forming the border of such a courtyard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c637379-984f-4e1d-9178-5f8fe4739a70",
                                                "sense_id": "85df38b8-7ab0-3cba-ba02-d018c882ca12",
                                                "text": "The quadrangle surrounding the Far Common was never considered absolutely essential to the Devon School."
                                            }
