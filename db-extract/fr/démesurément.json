        "fr-extract.jsonl": [
            {
                "entry_id": "37ee40da-ea16-3754-ac7a-bc94154c9da7",
                "word": "démesurément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c5fb211-c54d-3b70-94ac-6e15dcc210f7",
                        "entry_id": "37ee40da-ea16-3754-ac7a-bc94154c9da7",
                        "glosses": [
                            "D’une manière excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ad4530-a5f3-417a-9f86-57b233635997",
                                "sense_id": "8c5fb211-c54d-3b70-94ac-6e15dcc210f7",
                                "text": "Le disque brillant se traînait avec lenteur sur l'horizon de l'ouest, et ses obliques rayons projetaient démesurément devant leurs pas les ombres des explorateurs."
                            },
                            {
                                "example_id": "b87f8d08-c960-4ec1-8da8-634562689c6f",
                                "sense_id": "8c5fb211-c54d-3b70-94ac-6e15dcc210f7",
                                "text": "Une histoire banale au fond, démesurément grossie, transformée, dénaturée par les passions politiques, et religieuses!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6422340-24c7-4cb1-9b35-a427910050c4",
                        "source_entry_id": "37ee40da-ea16-3754-ac7a-bc94154c9da7",
                        "source_sense_id": "8c5fb211-c54d-3b70-94ac-6e15dcc210f7",
                        "target_lang_word": "maßlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maßlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "135c424d-7240-3bd2-822f-64c8cb4cadec",
                                        "entry_id": "64cd869e-197f-3906-b083-1866b54fa16d",
                                        "glosses": [
                                            "über das gewöhnliche Maß hinausgehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396d42d9-83e9-46fa-b811-cd406f845675",
                                                "sense_id": "135c424d-7240-3bd2-822f-64c8cb4cadec",
                                                "text": "Diese maßlose Gier, noch mehr Geld anhäufen zu wollen, trieb ihn soweit, daß er kriminell wurde."
                                            },
                                            {
                                                "example_id": "c936c568-f630-4c90-a9f4-7fafb59ed614",
                                                "sense_id": "135c424d-7240-3bd2-822f-64c8cb4cadec",
                                                "text": "Sie war von ihm maßlos enttäuscht."
                                            },
                                            {
                                                "example_id": "64a39d4b-0821-4ccd-be5e-08c936dbafa3",
                                                "sense_id": "135c424d-7240-3bd2-822f-64c8cb4cadec",
                                                "text": "„Trifft das noch zu im Zeitalter der Weltraumfahrt? Dieses Wort ist eine maßlose Übertreibung, ebenso wie sein Synonym Astronautik. Es gibt eine Reihe von Vergleichen, die das anschaulich machen. Einer mag genügen: Wenn jemand am Alpenrand, etwa bei Grainau unweit Garmisch, in 900 m Höhe über dem Meeresspiegel steht und zum Gipfel der Zugspitze (2000 m über ihm) hinaufblickt, und wenn er seinen Hals reckt, um dort oben etwas zu erkennen, und wenn ihm dann ein hilfsbereiter Freund ein Blatt von 0,2 mm Stärke unter die Schuhe schiebt, »damit du etwas näher dran bist und besser sehen kannst«, so hat sich dieser Jemand damit dem Zugspitzgipfel nur um ein Zehnmillionstel der gegebenen Distanz genähert (1 km = 1 Million mm). Ein »Astronaut«, der den Mond betritt, hat mit der Reise von der Erde bis dorthin von der Entfernung, die uns vom sonnennächsten Fixstern trennt, noch weniger, nämlich 1 Hundertmillionstel, zurückgelegt. Andere Fixsterne sind millionen- und milliardenmal weiter entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7f0b732-8b99-4442-8208-f026a9689952",
                        "source_entry_id": "37ee40da-ea16-3754-ac7a-bc94154c9da7",
                        "source_sense_id": "8c5fb211-c54d-3b70-94ac-6e15dcc210f7",
                        "target_lang_word": "immeasurably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immeasurably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f36b624a-7fd4-39da-9d5a-8b1c09b3613f",
                                        "entry_id": "e7204749-43b2-32da-b703-a145cff98e7e",
                                        "glosses": [
                                            "In a manner that is not measurable, in a way that cannot be measured."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "481897d9-f7ce-476c-9de4-95342f07a90b",
                                                "sense_id": "f36b624a-7fd4-39da-9d5a-8b1c09b3613f",
                                                "text": "The sky seems immeasurably large at night."
                                            },
                                            {
                                                "example_id": "40baee7c-91c3-4173-a689-6b735d84a6db",
                                                "sense_id": "f36b624a-7fd4-39da-9d5a-8b1c09b3613f",
                                                "text": "Yet Mrs Allen found much favour with the décor of the new vehicles. She also agreed that the levels of comfort were \"immeasurably higher\" than she had previously found."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
