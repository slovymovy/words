                "entry_id": "59874cf7-ae80-39fd-99ef-23f2c5574979",
                "word": "stalkily",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1972e3db-8cff-3744-945d-534a73011b22",
                        "entry_id": "59874cf7-ae80-39fd-99ef-23f2c5574979",
                        "glosses": [
                            "In a stalky manner.",
                            "Like, or as if made up of, one or several stalks or sticks; with a tall and thin appearance; lankily."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f41f30b3-be07-468e-8851-6fb280550789",
                                "sense_id": "1972e3db-8cff-3744-945d-534a73011b22",
                                "text": "Little stands of trees stand in stooks, stalkily bundled and clumped by giants."
                            },
                            {
                                "example_id": "31d7c200-3f91-44b9-b3ce-9b6788d49c74",
                                "sense_id": "1972e3db-8cff-3744-945d-534a73011b22",
                                "text": "Oh, can it be their weariness that makes them lounge so stalkily, / And wear their flesh so flaccidly, and granulate, and chalkily?"
                            },
                            {
                                "example_id": "42c1ddd9-821d-44e5-80b9-afe3d636ff18",
                                "sense_id": "1972e3db-8cff-3744-945d-534a73011b22",
                                "text": "The conductor emerged from the wings, tall and lean in his tailcoat, and moved stalkily across the platform; applause began in the front rows and worked its way back gradually to the far reaches of the hall, where people were talking in a sudden frenzy, as if they had a great deal to get said before silence was enjoined upon them."
                            }
                        ]
                    },
                    {
                        "sense_id": "9468aaa2-1536-3ab6-8c05-ef9533a15c76",
                        "entry_id": "59874cf7-ae80-39fd-99ef-23f2c5574979",
                        "glosses": [
                            "In a stalky manner.",
                            "As if covertly following or hunting a person; sneakily, surreptitiously."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce368883-2535-4128-9b52-f1bfa739eece",
                                "sense_id": "9468aaa2-1536-3ab6-8c05-ef9533a15c76",
                                "text": "There's no sense in not doin' a thing stalkily while you're about it."
                            },
                            {
                                "example_id": "227e97a7-ff4f-4838-ab72-aaea0d708dc7",
                                "sense_id": "9468aaa2-1536-3ab6-8c05-ef9533a15c76",
                                "text": "But the journey went on. Slower as the river became more intimate; reeds at the edge almost within touching distance. Waterfowl. A heron stalkily still. Dank lank growth and then the smells of intensive farming."
                            },
                            {
                                "example_id": "e9a8c470-c46b-40ed-afdf-aa43617af905",
                                "sense_id": "9468aaa2-1536-3ab6-8c05-ef9533a15c76",
                                "text": "'Now we must be careful,' announced Anton in his stalkily precise Italian."
                            }
                        ]
                    }
                ],
