                                        ]
                                    },
                                    {
                                        "sense_id": "028417f9-601a-3a5a-9fe2-4474848b316f",
                                        "entry_id": "d09b648f-6d0b-3790-852a-00e108428016",
                                        "glosses": [
                                            "To trounce, beat by a wide margin."
