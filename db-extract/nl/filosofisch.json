                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "443c5333-b634-42cd-a6fe-2d95057c5f84",
                                "sense_id": "6b724df3-d2cc-3ccb-9e5d-10a83862cf27",
                                "text": "Hij heeft een diepgaande interesse in filosofische vraagstukken.",
                                "translation": "He has a profound interest in philosophical questions.",
                                "english": "He has a profound interest in philosophical questions."
                            },
                            {
                                "example_id": "c3e0fc92-158f-4243-bf5e-65945eb30959",
                                "sense_id": "6b724df3-d2cc-3ccb-9e5d-10a83862cf27",
                                "text": "De schrijver onderzoekt op filosofische wijze de betekenis van het leven.",
                                "translation": "The writer explores the meaning of life in a philosophical manner.",
                                "english": "The writer explores the meaning of life in a philosophical manner."
                            },
                            {
                                "example_id": "48bfce36-6e38-4ed8-a16b-3927174726d1",
                                "sense_id": "6b724df3-d2cc-3ccb-9e5d-10a83862cf27",
                                "text": "Het boek biedt een filosofische kijk op de menselijke natuur.",
                                "translation": "The book offers a philosophical view on human nature.",
                                "english": "The book offers a philosophical view on human nature."
                            }
                        ]
                    }
