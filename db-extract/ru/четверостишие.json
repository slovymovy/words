                        "sense_id": "f3e44b27-f960-3672-ac2b-021ed3c67c33",
                        "entry_id": "9339eb9c-fa3d-3585-afdf-e6f0e1db88cb",
                        "glosses": [
                            "стихотворение или стихотворная строфа из четырёх строк"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee7e68d-d803-4372-ba19-f6f25804b828",
                                "sense_id": "f3e44b27-f960-3672-ac2b-021ed3c67c33",
                                "text": "Последнее четверостишие она совсем, как говорится, скомкала — томик Пушкина вдруг выскользнул из её рук, — и она поспешно удалилась."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a95a4d62-bb9d-447b-839b-0d91d7a4e2ce",
                        "source_entry_id": "9339eb9c-fa3d-3585-afdf-e6f0e1db88cb",
                        "source_sense_id": "f3e44b27-f960-3672-ac2b-021ed3c67c33",
                        "target_lang_word": "quatrain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quatrain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c4cfd7-6dd9-3331-b6fb-1d1fac04632f",
                                        "entry_id": "83b7899a-9b06-38f6-9d15-3f2538d2be4d",
                                        "glosses": [
                                            "A poem in four lines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47a5884e-4f2d-350d-8b0d-0217fcb33a53",
                                        "entry_id": "83b7899a-9b06-38f6-9d15-3f2538d2be4d",
                                        "glosses": [
                                            "A stanza of four lines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4fc988c-83a8-4179-8b2e-2bde6a793793",
                                                "sense_id": "47a5884e-4f2d-350d-8b0d-0217fcb33a53",
                                                "text": "Example:"
                                            },
                                            {
                                                "example_id": "7c03ece3-ca83-44de-8b6b-512e6079e537",
                                                "sense_id": "47a5884e-4f2d-350d-8b0d-0217fcb33a53",
                                                "text": "Awake! for Morning in the Bowl of Night,"
                                            },
                                            {
                                                "example_id": "573845db-90e2-4417-8043-027f5bd4a122",
                                                "sense_id": "47a5884e-4f2d-350d-8b0d-0217fcb33a53",
                                                "text": "Has flung the Stone that puts the stars to flight:"
                                            },
                                            {
                                                "example_id": "4010a6c5-b810-4166-8170-d7a347fe6892",
                                                "sense_id": "47a5884e-4f2d-350d-8b0d-0217fcb33a53",
                                                "text": "And Lo! the Hunter of the East has caught"
                                            },
                                            {
                                                "example_id": "26dfa724-cd42-4e44-b7c4-c443b3f916f2",
                                                "sense_id": "47a5884e-4f2d-350d-8b0d-0217fcb33a53",
                                                "text": "The Sultan's Turret in a Noose of light."
                                            },
                                            {
                                                "example_id": "c4f347b7-5849-4f80-b58a-a8dbf4b220a8",
                                                "sense_id": "47a5884e-4f2d-350d-8b0d-0217fcb33a53",
                                                "text": "The menu card was designed by Mr. Arthur Hacker, and further enriched by some charming verses in Omarian quatrains from Mr. Le Gallienne, who read them to a sympathetic audience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
