                        "glosses": [
                            "Un des trois glucosides contenus dans les racines de gentiane. Sa formule brute est : C₁₀H₂₆O₁₀."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de92bca1-0696-4081-9235-343ccb609a3b",
                                "sense_id": "17546446-e494-380a-b06a-3a6d070fe910",
                                "text": "La gentiamarine ne se forme que à la longue dans les racines sèches de gentiane."
                            },
