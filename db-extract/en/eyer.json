                    {
                        "sense_id": "23bab648-925e-3708-b992-92278d04299a",
                        "entry_id": "134c1f1a-aa51-365b-bc11-687422639853",
                        "glosses": [
                            "One who eyes someone or something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0885f1e-be7f-4875-8348-aa26917f64f6",
                                "sense_id": "23bab648-925e-3708-b992-92278d04299a",
                                "text": "1654, Edmund Gayton, Pleasant Notes upon Don Quixot, London, Notes vpon Book II. Chap. IV, p. 47,\nThe Amoretto was wont to take his stand at one place about the pew, where sate his Mistresse, who was a very attentive hearer of the man above her, and the sutor was as diligent an eyer of her, for having a book, and black-lead pen alwaies in his hand, (as if he took notes of the sermon) at last he got her exact picture."
                            },
                            {
                                "example_id": "902ece3a-3367-48ae-948c-febcd8bb6b25",
                                "sense_id": "23bab648-925e-3708-b992-92278d04299a",
                                "text": "You knew less about sex than you knew about sleuthing, but you soon figured out what the goods were and got them. You were not so much a private eye as an eyer of privates."
                            }
                        ]
                    }
                ],
