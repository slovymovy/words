            "senses": [
                {
                    "sense_id": "990ae823-3d15-3143-b5e6-2e2a6f7c1710",
                    "sense_definition": "third-person singular simple present indicative of <w>barnacle</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship's hull slowly <w>barnacles</w> over time if it is not regularly cleaned.",
                            "target_lang_translations": {
                                "ru": "Корпус корабля со временем медленно <w>обрастает ракушками</w>, если его регулярно не чистить."
                            }
                        },
                        {
                            "text": "As the metal structure sits in the harbor, it gradually <w>barnacles</w> with marine growth.",
                            "target_lang_translations": {
                                "ru": "Пока металлическая конструкция находится в гавани, она постепенно <w>покрывается морскими наростами</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular present form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма третьего лица единственного числа настоящего времени глагола barnacle (обрастать ракушками/балянусами)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрастает ракушками",
                                "target_lang_sense_clarification": "о судне или предмете в воде"
                            },
                            {
                                "target_lang_word": "покрывается балянусами",
                                "target_lang_sense_clarification": "о морском наросте"
                            }
                        ]
