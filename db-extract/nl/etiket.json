                ],
                "translations": [
                    {
                        "translation_id": "ad08fa70-69a1-4975-9ab3-6748bf8af460",
                        "source_entry_id": "7177ca38-9125-3f66-8ced-a8fc9b2ea959",
                        "source_sense_id": "9d7d622a-4de4-3a58-b38f-282234bc5719",
                        "source_sense_description": "stuk papier met informatie dat ergens opgeplakt zit",
                        "target_lang_word": "Etikett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Etikett",
