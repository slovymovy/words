                        "glosses": [
                            "Maladie parasitaire respiratoire affectant la trachée, elle est due à un petit nématode nommé Syngamus trachealis ou strongle. On l'observe surtout aux Antilles et en Amérique centrale."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "d1e3b5df-3bc9-4161-970c-cc815389d51d",
                                "sense_id": "0904fc07-466b-34e0-a12d-c8cd933863fa",
                                "text": "La syngamose est fréquente dans les basses-cours."
                            },
                            {
                                "example_id": "76d64068-5408-4123-b45d-55a5603bc2de",
                                "sense_id": "0904fc07-466b-34e0-a12d-c8cd933863fa",
                                "text": "Les humains en contact avec des animaux malades peuvent attraper la syngamose."
                            }
                        ]
                    }
