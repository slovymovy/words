                                    {
                                        "sense_id": "94a5edfd-2f56-357b-ba36-551188dacd4b",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "A substitution for an error or mistake."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5146710e-d431-3395-bf56-c26d9c2684a5",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "Punishment that is intended to rehabilitate an offender."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57610803-890b-4aae-90dd-be776ef3dd46",
                                                "sense_id": "5146710e-d431-3395-bf56-c26d9c2684a5",
                                                "text": "As the facts of the case were investigated, it became apparent that before us was the story of a man whom the entire machinery of law enforcement and correction had conspired against from the beginning to the end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b287e0e0-8dcc-3c64-8690-ccd69ba4cfff",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "An amount or quantity of something added or subtracted so as to correct."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bc94ba9-0aac-3b98-8865-98b809d95c26",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "A decline in a stock market price after a period of rises. Often operationally defined as a market value drop of 10% or more on some specific stock market index."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19af3c5a-de40-3a20-a7c5-ed97e2a3b1ac",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "a station's indication that previous information was incorrect and will continue with correct information from the last correct transmitted"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c43a06-0366-45a5-8f1f-6a81dc5402fc",
                                                "sense_id": "19af3c5a-de40-3a20-a7c5-ed97e2a3b1ac",
                                                "text": "I have four T-80 tanks at grid Three-niner-niner-four-eight-eight, Correction: Grid Three niner-niner-four-eight-five. How copy? Over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9b7b394-aca6-41f8-843b-f2a9b17c68fc",
                        "source_entry_id": "c5b65da5-f2dd-3ef6-8008-1c9f12250e8a",
                        "source_sense_id": "ef740fe1-13d7-3e8e-a896-0cac25685113",
                        "source_sense_description": "verbetering",
                        "target_lang_word": "correction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad2c7fbf-2940-388c-8453-2b5b5b371f19",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Action de corriger, d’ôter les défauts de quelque chose ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5b3d2d2-945c-42dd-9dbb-ce5e44bfd863",
                                                "sense_id": "ad2c7fbf-2940-388c-8453-2b5b5b371f19",
                                                "text": "[…] ; on apprenait à mesurer le vent aux diverses altitudes en observant un ballon au moyen d'un théodolite ; on calculait les tables qui permettaient une interprétation rapide, et en même temps d'autres tables de correction pour le tir de l'artillerie."
                                            },
                                            {
                                                "example_id": "1414f206-8134-48c4-ba4e-ec02aa6b805f",
                                                "sense_id": "ad2c7fbf-2940-388c-8453-2b5b5b371f19",
                                                "text": "Ainsi, la volonté de correction des premières années, face aux échecs répétitifs maintes fois constatés d'hommes idémistes, se trouve noyée dans l’inertie. Paris dicte à Cayenne des mesures qui témoignent de sa souveraineté, et reflète aussi la méconnaissance de la réalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17362415-2da0-37c3-921e-38ccad267d4c",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Changements qu’on fait dans les ouvrages de l’esprit pour les améliorer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a039b54-515c-4420-9cab-1faf21633743",
                                                "sense_id": "17362415-2da0-37c3-921e-38ccad267d4c",
                                                "text": "Il a fait à son récit de nombreuses corrections."
                                            },
                                            {
                                                "example_id": "f1a5d53c-6429-4326-8105-a11704a69fa2",
                                                "sense_id": "17362415-2da0-37c3-921e-38ccad267d4c",
                                                "text": "Il a introduit d’importantes corrections dans son texte primitif."
                                            },
                                            {
                                                "example_id": "ecf62b15-5403-4721-b12f-112e0af1435f",
                                                "sense_id": "17362415-2da0-37c3-921e-38ccad267d4c",
                                                "text": "Recevoir une pièce de théâtre à correction, La recevoir avec la condition que l’auteur y fera certains changements."
                                            },
                                            {
                                                "example_id": "d78407e7-3eab-4303-8976-702be00f0bd1",
                                                "sense_id": "17362415-2da0-37c3-921e-38ccad267d4c",
                                                "text": "Sauf correction, sous correction, locution adverbiale dont on se sert pour adoucir la portée d’une affirmation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "651ea655-cc6a-3b7b-9af8-1b62c385e8a2",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Action de corriger les travaux des élèves et étudiants et d'en noter la valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f17526-1ada-459c-bcb5-60d2726f11fe",
                                                "sense_id": "651ea655-cc6a-3b7b-9af8-1b62c385e8a2",
                                                "text": "Le consensus évite des attitudes différentes entre auteurs. La présence d'une conférence de consensus rend un sujet plus facilement « tombable » aux ECN car la correction est moins sujette à discussion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98f2a90-002d-3e5a-a833-140d992b0fa9",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Action de corriger les épreuves, d’indiquer les fautes de composition, afin que l’ouvrier les fasse disparaître."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f0ed1b-3533-48ca-87be-e5d023b1317c",
                                                "sense_id": "a98f2a90-002d-3e5a-a833-140d992b0fa9",
                                                "text": "La correction des épreuves,"
                                            },
                                            {
                                                "example_id": "609d8049-10b2-4dfe-806d-187e5c00bdec",
                                                "sense_id": "a98f2a90-002d-3e5a-a833-140d992b0fa9",
                                                "text": "La correction de cette feuille exigera beaucoup de temps."
                                            },
                                            {
                                                "example_id": "27b3abc6-dbb2-4c77-9e6a-999618f220ef",
                                                "sense_id": "a98f2a90-002d-3e5a-a833-140d992b0fa9",
                                                "text": "Signes de correction. On appelle également"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbae3582-4c83-39d6-bf72-2bc02729624b",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Action du compositeur qui exécute les changements indiqués sur l’épreuve par le correcteur ou par l’auteur."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18b7642c-6623-4d80-8fc1-37959ad20492",
                                                "sense_id": "dbae3582-4c83-39d6-bf72-2bc02729624b",
                                                "text": "La correction de cette forme est terminée. Il se dit pareillement des additions et changements écrits à la marge ou entre les lignes d’une épreuve ou d’un manuscrit."
                                            },
                                            {
                                                "example_id": "1501ecc5-1ab6-41ee-92f0-d62259d6ee2c",
                                                "sense_id": "dbae3582-4c83-39d6-bf72-2bc02729624b",
                                                "text": "Cette épreuve est chargée de corrections."
                                            },
                                            {
                                                "example_id": "4a63dca7-4cd2-4c46-9a97-05dfc77231fb",
                                                "sense_id": "dbae3582-4c83-39d6-bf72-2bc02729624b",
                                                "text": "Toutes les corrections étaient écrites de sa main."
                                            },
                                            {
                                                "example_id": "71fd50f1-fe32-4f84-98ca-9b045fb988c8",
                                                "sense_id": "dbae3582-4c83-39d6-bf72-2bc02729624b",
                                                "text": "Théophile Morin arriva vers dix heures, retenu par des corrections de compositions, toute une lourde besogne pédagogique, sans nul intérêt, qui parfois lui prenait ses nuits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f3c2d3-2ce2-3295-9b3b-2d2aaa15b3af",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Opération où l’on fait usage d’un correctif pour tempérer la force de certaines substances."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be402bb3-ad8e-34fc-b46c-e28f78a82743",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Qualité de ce qui est correct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "604aa088-79ac-4791-98f1-9e136fc66aaf",
                                                "sense_id": "be402bb3-ad8e-34fc-b46c-e28f78a82743",
                                                "text": "La correction du langage, du style."
                                            },
                                            {
                                                "example_id": "4a2c216a-66e0-4577-b5a7-c4a71a18afcb",
                                                "sense_id": "be402bb3-ad8e-34fc-b46c-e28f78a82743",
                                                "text": "Il parle, il écrit avec une grande correction."
                                            },
                                            {
                                                "example_id": "699ccfa0-653b-4481-b813-23582bfbc9b9",
                                                "sense_id": "be402bb3-ad8e-34fc-b46c-e28f78a82743",
                                                "text": "La correction de la tenue, de la conduite."
                                            },
                                            {
                                                "example_id": "ffe90d96-3c64-4794-978f-87ed4ec874f1",
                                                "sense_id": "be402bb3-ad8e-34fc-b46c-e28f78a82743",
                                                "text": "Et il montrait des lettres d’elle, en insistant sur la correction de l’orthographe et le tour élégant des phrases !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f3df1a1-7e76-36eb-9eec-54bf952ae4a8",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Exactitude dans la représentation des contours et des détails anatomiques de la figure, d’après un modèle bien conformé, abstraction faite du coloris."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7071bf7-2c5a-4868-b431-ea40074fbefb",
                                                "sense_id": "3f3df1a1-7e76-36eb-9eec-54bf952ae4a8",
                                                "text": "Correction de dessin,"
                                            },
                                            {
                                                "example_id": "a907d4c3-98d3-4240-8639-2b3e9b3cf93f",
                                                "sense_id": "3f3df1a1-7e76-36eb-9eec-54bf952ae4a8",
                                                "text": "Raphaël a poussé plus loin que personne la correction du dessin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58fcdd6c-cb29-3d76-b58b-5f57f23e3d5e",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Châtiment, peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e041a2b0-3a5f-4ac4-9c36-a52fa0c06f64",
                                                "sense_id": "58fcdd6c-cb29-3d76-b58b-5f57f23e3d5e",
                                                "text": "Infliger, administrer une correction."
                                            },
                                            {
                                                "example_id": "d98ad9fb-103d-4c7d-b2c4-8714f30e15e5",
                                                "sense_id": "58fcdd6c-cb29-3d76-b58b-5f57f23e3d5e",
                                                "text": "Maison de correction."
                                            },
                                            {
                                                "example_id": "9bfc8bdb-8d05-4166-94aa-b3a774943081",
                                                "sense_id": "58fcdd6c-cb29-3d76-b58b-5f57f23e3d5e",
                                                "text": "Je ne t’ai jamais prêté le moindre défaut, la moindre sottise enfantine, ni l’un de ces actes qui me valaient des « corrections » au même âge que toi, tel ce jour où j’ai coupé traîtreusement une boucle dans la chevelure de ma cousine C. en train de lire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d49f98df-8141-36fd-a49e-7f621ddb9427",
                                        "entry_id": "1136d345-75a7-3a66-b859-97a9801ab70e",
                                        "glosses": [
                                            "Opération qui modifie une information portée sur un document cartographique pour l'actualiser en fonction de nouvelles données. Nota : ne pas confondre avec correction (de rédaction)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
