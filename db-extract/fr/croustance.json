                    {
                        "sense_id": "773bc140-f73c-3121-9a62-a5357c93f265",
                        "entry_id": "04e76c0d-dc69-38cb-a16d-6a971044b92c",
                        "glosses": [
                            "Nourriture, repas."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7451b39d-87f7-44b5-af11-10ecc3ba7899",
                                "sense_id": "773bc140-f73c-3121-9a62-a5357c93f265",
                                "text": "Et puis, je m’en contrefous ! Je ne vais pas m’amuser à des placements de père de famille ; gagner ma croustance, vivoter, — ça ne m’intéresse pas !"
                            },
                            {
                                "example_id": "007f43fd-e463-47bc-9ff3-d218efa952aa",
                                "sense_id": "773bc140-f73c-3121-9a62-a5357c93f265",
                                "text": "Il ne leur porte pas de la croustance à ses zoziaux, cette nuit ?"
                            },
                            {
                                "example_id": "3609fd45-2721-4489-a6dc-7dc1ec5c9cdf",
                                "sense_id": "773bc140-f73c-3121-9a62-a5357c93f265",
                                "text": "Il déclara que c’était l’heure d’aller préparer sa croustance, parce qu’il avait prévu pour ce soir une blanquette qui devrait mijoter jusqu’au dîner."
                            },
                            {
                                "example_id": "ab46241d-8c95-43bd-b834-12aaec5b5006",
                                "sense_id": "773bc140-f73c-3121-9a62-a5357c93f265",
                                "text": "Pour ce soir, c’est toi qui feras la croustance…"
                            }
                        ]
                    }
                ],
