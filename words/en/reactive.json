{
    "word_family": [
        "react",
        "reaction",
        "reactor",
        "reactivity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e0da201-425b-3dd7-a54c-c1e530bff049",
                    "sense_definition": "Reacting to events after they have happened rather than planning for them in advance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company took a <w>reactive</w> approach to the crisis instead of preparing for it.",
                            "target_lang_translations": {
                                "ru": "Компания выбрала <w>реактивный</w> подход к кризису вместо того, чтобы подготовиться к нему."
                            }
                        },
                        {
                            "text": "We need to stop being <w>reactive</w> and start planning for future challenges.",
                            "target_lang_translations": {
                                "ru": "Нам нужно перестать <w>действовать по ситуации</w> и начать планировать будущие вызовы."
                            }
                        }
                    ],
                    "antonyms": [
                        "proactive"
                    ],
                    "common_phrases": [
                        "reactive approach",
                        "reactive strategy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий по ситуации, реагирующий на события постфактум, а не планирующий действия заранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реактивный",
                                "target_lang_sense_clarification": "в значении реагирующий на события"
                            },
                            {
                                "target_lang_word": "действующий по ситуации",
                                "target_lang_sense_clarification": "описывает подход, лишенный планирования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38a866bd-1461-3ee1-8229-881663cf87a2",
                    "sense_definition": "Easily undergoing a chemical change or interaction with other substances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sodium is a highly <w>reactive</w> metal that burns when it touches water.",
                            "target_lang_translations": {
                                "ru": "Натрий — это <w>высокореакционноспособный</w> металл, который горит при контакте с водой."
                            }
                        },
                        {
                            "text": "Francium is the most <w>reactive</w> of the alkali metals.",
                            "target_lang_translations": {
                                "ru": "Франций — самый <w>активный</w> из щелочных металлов."
                            }
                        }
                    ],
                    "synonyms": [
                        "volatile"
                    ],
                    "common_phrases": [
                        "highly reactive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко вступающий в химические реакции или взаимодействия с другими веществами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реакционноспособный",
                                "target_lang_sense_clarification": "химический термин"
                            },
                            {
                                "target_lang_word": "активный",
                                "target_lang_sense_clarification": "в контексте химической активности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0b0b2f1-ad98-3850-b48d-57c9fca4d76e",
                    "sense_definition": "Showing a response or reaction to a specific stimulus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient showed a <w>reactive</w> response to the new medication.",
                            "target_lang_translations": {
                                "ru": "У пациента проявилась <w>реактивная</w> реакция на новый препарат."
                            }
                        },
                        {
                            "text": "The skin became <w>reactive</w> after applying the strong cream.",
                            "target_lang_translations": {
                                "ru": "Кожа стала <w>отзывчивой</w> (чувствительной) после нанесения сильного крема."
                            }
                        }
                    ],
                    "synonyms": [
                        "responsive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий ответную реакцию на определенный раздражитель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзывчивый",
                                "target_lang_sense_clarification": "способный реагировать на стимул"
                            },
                            {
                                "target_lang_word": "реактивный",
                                "target_lang_sense_clarification": "в медицинском или биологическом контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "064b6189-44ae-38e3-8db0-06b8b4906c59",
                    "sense_definition": "Relating to electrical circuits that involve induction or capacitance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer measured the <w>reactive</w> power in the electrical system.",
                            "target_lang_translations": {
                                "ru": "Инженер измерил <w>реактивную</w> мощность в электрической системе."
                            }
                        },
                        {
                            "text": "Inductors and capacitors are considered <w>reactive</w> components in a circuit.",
                            "target_lang_translations": {
                                "ru": "Индукторы и конденсаторы считаются <w>реактивными</w> компонентами в цепи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reactive power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к электрическим цепям, содержащим индуктивность или емкость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реактивный",
                                "target_lang_sense_clarification": "физический и электротехнический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}