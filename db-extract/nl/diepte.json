                        "examples": [
                            {
                                "example_id": "c1e9a393-8e12-456f-a840-be2b3f2bdbc5",
                                "sense_id": "189fedb5-2ac7-3c17-a32b-9203e5e6afc1",
                                "text": "In de diepten van de oceaan leven vreemde wezens.",
                                "translation": "Strange creatures live in the depths of the ocean.",
                                "english": "Strange creatures live in the depths of the ocean."
                            },
                            {
                                "example_id": "380a586d-a99d-4f25-b61a-a524c8c23c06",
                                "sense_id": "189fedb5-2ac7-3c17-a32b-9203e5e6afc1",
                                "text": "Hij keek in de diepte van de afgrond.",
                                "translation": "He looked into the depth of the abyss.",
                                "english": "He looked into the depth of the abyss."
                            }
                        ]
                    }
