{
    "word_family": [
        "déversement",
        "déversoir",
        "dévers"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a7a7f2b-0693-3d06-86af-a1fa407b9671",
                    "sense_definition": "Faire couler un cours d'eau ou un liquide d'un endroit dans un autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "écoulement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand fleuve vient <w>déverser</w> ses eaux froides dans la mer du Nord."
                        },
                        {
                            "text": "Les autorités ont interdit aux usines locales de <w>déverser</w> leurs résidus liquides dans le canal."
                        }
                    ],
                    "synonyms": [
                        "verser",
                        "écouler"
                    ],
                    "common_phrases": [
                        "déverser dans la mer",
                        "déverser dans le fleuve"
                    ]
                },
                {
                    "sense_id": "a9e2d44b-0d81-3d5a-a1fa-8e6ff5fa2694",
                    "sense_definition": "Répandre ou décharger des matières, des objets ou des sentiments en grande quantité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "répandre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs camions sont venus <w>déverser</w> des déchets industriels près de la forêt."
                        },
                        {
                            "text": "À la fin de la réunion, il a fini par <w>déverser</w> toute sa colère accumulée."
                        }
                    ],
                    "synonyms": [
                        "répandre",
                        "décharger"
                    ],
                    "antonyms": [
                        "contenir",
                        "retenir"
                    ],
                    "common_phrases": [
                        "déverser des déchets",
                        "déverser sa colère"
                    ]
                },
                {
                    "sense_id": "20abed95-400c-37f5-8555-bf540eca9da9",
                    "sense_definition": "Faire pencher un ouvrage de maçonnerie ou de charpente hors de son aplomb.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inclinaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humidité excessive a fini par <w>déverser</w> cette lourde poutre maîtresse de la grange."
                        },
                        {
                            "text": "Une mauvaise pression exercée sur la structure risque de <w>déverser</w> l'ensemble de la charpente."
                        }
                    ],
                    "synonyms": [
                        "gauchir",
                        "fausser"
                    ],
                    "common_phrases": [
                        "déverser une pièce de bois"
                    ]
                },
                {
                    "sense_id": "eb48bc66-56a0-3863-955c-252a2a5c8e7d",
                    "sense_definition": "Perdre son aplomb et s'incliner, en parlant d'un mur ou d'un élément de construction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inclinaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous la poussée constante des terres, ce vieux mur de soutènement <w>déverse</w> dangereusement."
                        },
                        {
                            "text": "L'architecte a remarqué que le pignon de la maison <w>déverse</w> vers la route principale."
                        }
                    ],
                    "synonyms": [
                        "pencher",
                        "verser"
                    ],
                    "common_phrases": [
                        "mur qui déverse"
                    ]
                }
            ]
        }
    ]
}