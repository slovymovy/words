                                    },
                                    {
                                        "sense_id": "2eb989ec-5510-3839-b010-301e29cab67c",
                                        "entry_id": "da7db54a-072f-39a7-93e8-969c69f1bcd7",
                                        "glosses": [
                                            "A troopship."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c185db7-508c-4a3e-9c19-51ee1a9ba7f9",
                                                "sense_id": "2eb989ec-5510-3839-b010-301e29cab67c",
                                                "text": "She was built by William Denny & Bros. Ltd., and launched in 1939, but went immediately on active service as a trooper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e769d01-4360-3d96-8f5b-7d827232451c",
                                        "entry_id": "da7db54a-072f-39a7-93e8-969c69f1bcd7",
                                        "glosses": [
                                            "Ellipsis of state trooper."
                                        ],
                                        "tags": [
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ff39ce8-f3a3-3a02-a180-6cd1eb3b5c08",
                                        "entry_id": "da7db54a-072f-39a7-93e8-969c69f1bcd7",
                                        "glosses": [
                                            "A mounted policeman."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a77a9584-8166-3f56-935f-879e44d6e28b",
                                        "entry_id": "da7db54a-072f-39a7-93e8-969c69f1bcd7",
                                        "glosses": [
                                            "Misspelling of trouper (“one who stoically endures adversity”) ."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "colloquial",
                                            "figuratively",
                                            "misspelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e903eb-2837-4caa-9c45-48140d53a112",
                                                "sense_id": "a77a9584-8166-3f56-935f-879e44d6e28b",
                                                "text": "He was a real trooper about taking care of the kids for the weekend."
                                            },
                                            {
                                                "example_id": "56215519-2e86-45db-b5b6-20297bf1867e",
                                                "sense_id": "a77a9584-8166-3f56-935f-879e44d6e28b",
                                                "text": "Because his father and brothers were in the department, he had to be. She knew he was never really comfortable with the job but still he did it like a trooper."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trooper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8efb6b7c-fc08-34bc-a5a8-99e76c51f3bb",
                                        "entry_id": "b3e08364-ae46-31eb-82ef-a4f3436e36dc",
                                        "glosses": [
                                            "To work as a trooper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450c5525-65ad-4947-9b10-7ed36a820291",
                                                "sense_id": "8efb6b7c-fc08-34bc-a5a8-99e76c51f3bb",
                                                "text": "Maybe I should quit troopering and hire on with Global Harvest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f78ea0f6-0e52-3742-b281-242a8afe366b",
                                        "entry_id": "b3e08364-ae46-31eb-82ef-a4f3436e36dc",
                                        "glosses": [
                                            "To work steadily at an unpleasant job without complaint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6b32af6-ffb6-4712-b196-8fe15d0bf8ca",
                                                "sense_id": "f78ea0f6-0e52-3742-b281-242a8afe366b",
                                                "text": "Carrie handed out tools, helped hold a measuring tape, and troopered on where she could,"
                                            },
                                            {
                                                "example_id": "b0c476c0-0c35-4d81-8e05-4c8869bc51fd",
                                                "sense_id": "f78ea0f6-0e52-3742-b281-242a8afe366b",
                                                "text": "But she troopered on, plastering a smile on her face and giving her a warm greeting and inwardly reminded herself that Ms. Madeleine was of no threat to her, as if she had a fear of Jack-in-the-boxes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
