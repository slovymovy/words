                    {
                        "sense_id": "ac906a9a-99e9-3f14-a353-523c74161d81",
                        "entry_id": "6ff3e120-713a-3d74-be07-63b071ee86e1",
                        "glosses": [
                            "zandpad voor paardrijders dat meestal door een natuurgebied loopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "753d3bb7-3550-45d8-aef4-3a921a8fa03c",
                                "sense_id": "ac906a9a-99e9-3f14-a353-523c74161d81",
                                "text": "Kalmthoutse Heide weer gedeeltelijk open: Aan de noordkant werd parking Noord aan de Verbindingsstraat weer opengesteld. Daarmee kan het volledig intact gebleven wandelpad 'Ree' en het noordelijke deel van het ruiterpad opnieuw gebruikt worden."
                            },
                            {
                                "example_id": "4756cae8-5729-4060-9d99-2ddfa4faa05c",
                                "sense_id": "ac906a9a-99e9-3f14-a353-523c74161d81",
                                "text": "Herman Rouwenhorst, fervent natuurfotograaf uit het belendende Epe, zag de wolf woensdagmorgen naar eigen zeggen op nog geen honderd meter afstand. ,,Midden op het ruiterpad. Ken je de film Dances with Wolves? Daar komen man en wolf elkaar opeens tegen en ze blijven stokstijf staan. Hier gebeurde dat ook. De wolf keek me een tijdje aan, draaide zich daarna om en liep op z'n dooie gemakje weg. Kippenvel\"."
                            }
                        ]
                    }
