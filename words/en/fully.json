{
    "word_family": [
        "full",
        "fullness",
        "fulfill",
        "fulfillment"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fdfa11c5-cf93-3c99-8606-7467da928da9",
                    "sense_definition": "In a complete manner; without any lack or defect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>fully</w> capable of meeting his responsibilities at work.",
                            "target_lang_translations": {
                                "ru": "Он <w>вполне</w> способен справляться со своими обязанностями на работе.",
                                "zh": "他<w>完全</w>有能力履行工作职责。"
                            }
                        },
                        {
                            "text": "The new software system is now <w>fully</w> operational and ready for use.",
                            "target_lang_translations": {
                                "ru": "Новая программная система теперь <w>полностью</w> функционирует и готова к использованию.",
                                "zh": "新的软件系统现已<w>完全</w>投入运行，随时可以使用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "completely",
                        "entirely",
                        "perfectly",
                        "totally",
                        "wholly"
                    ],
                    "antonyms": [
                        "partially",
                        "incompletely"
                    ],
                    "common_phrases": [
                        "fully aware",
                        "fully understand",
                        "fully developed",
                        "fully operational",
                        "fully equipped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенно, всецело; без каких-либо недостатков или упущений.",
                        "zh": "以完整的方式；没有任何缺失或缺陷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полностью",
                                "target_lang_sense_clarification": "целиком, без остатка"
                            },
                            {
                                "target_lang_word": "целиком",
                                "target_lang_sense_clarification": "весь объект или действие полностью"
                            },
                            {
                                "target_lang_word": "в полной мере",
                                "target_lang_sense_clarification": "в полном объеме, максимально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "指程度达到极限，没有剩余"
                            },
                            {
                                "target_lang_word": "充分",
                                "target_lang_sense_clarification": "指程度足够，满足要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffbc6359-aed2-32c1-b13d-ff05a35c4485",
                    "sense_definition": "Used to emphasize a quantity, indicating it is at least the specified amount.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>fully</w> four hours before we finally arrived home.",
                            "target_lang_translations": {
                                "ru": "Прошло <w>целых</w> четыре часа, прежде чем мы наконец добрались домой.",
                                "zh": "我们<w>足足</w>过了四个小时才终于到家。"
                            }
                        },
                        {
                            "text": "In the recent survey, <w>fully</w> half of the respondents agreed with the proposal.",
                            "target_lang_translations": {
                                "ru": "В недавнем опросе <w>целая</w> половина респондентов согласилась с предложением.",
                                "zh": "在最近的调查中，<w>整整</w>一半的受访者同意该提议。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fully half",
                        "fully three hours"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления количества, указывая, что оно составляет не менее указанной величины.",
                        "zh": "用于强调数量，表示至少达到所指定的数额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целых",
                                "target_lang_sense_clarification": "при указании на значительный объем времени или количества"
                            },
                            {
                                "target_lang_word": "не менее",
                                "target_lang_sense_clarification": "как минимум"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足足",
                                "target_lang_sense_clarification": "强调数量多或时间长"
                            },
                            {
                                "target_lang_word": "整整",
                                "target_lang_sense_clarification": "强调数量完整，不打折扣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3f5a4f4-29fb-3f29-b330-09951e034f93",
                    "sense_definition": "Used as a general intensifier to mean actually, really, or literally.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>fully</w> woke up at noon yesterday after the long party.",
                            "target_lang_translations": {
                                "ru": "Вчера после долгой вечеринки я <w>окончательно</w> проснулся только в полдень.",
                                "zh": "昨晚派对结束后，我直到中午才<w>完全</w>清醒过来。"
                            }
                        },
                        {
                            "text": "That strange behavior is <w>fully</w> typical of my younger brother.",
                            "target_lang_translations": {
                                "ru": "Это странное поведение <w>вполне</w> типично для моего младшего брата.",
                                "zh": "那种奇怪的行为<w>完全</w>是我弟弟的典型作风。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как усилитель в значении «действительно», «на самом деле» или «вполне».",
                        "zh": "用作一般强调词，意为实际上、确实或完全。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вполне",
                                "target_lang_sense_clarification": "достаточно, полностью (о качестве)"
                            },
                            {
                                "target_lang_word": "совершенно",
                                "target_lang_sense_clarification": "абсолютно"
                            },
                            {
                                "target_lang_word": "окончательно",
                                "target_lang_sense_clarification": "бесповоротно, до конца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "表示程度上的彻底"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "表示真实性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9357f3d-9895-3126-87c7-7cbbad327b7a",
                    "sense_definition": "To an equal degree; exactly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>fully</w> as shocking as it is meant to be.",
                            "target_lang_translations": {
                                "ru": "Это <w>столь же</w> шокирующе, как и задумывалось.",
                                "zh": "这和预想的一样，<w>同样</w>令人震惊。"
                            }
                        },
                        {
                            "text": "The second task proved to be <w>fully</w> as difficult as the first one.",
                            "target_lang_translations": {
                                "ru": "Вторая задача оказалась <w>так же</w> сложна, как и первая.",
                                "zh": "第二项任务证明和第一项<w>同样</w>困难。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fully as"
                    ],
                    "target_lang_definitions": {
                        "ru": "В равной степени; точно так же.",
                        "zh": "在相同的程度上；确切地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столь же",
                                "target_lang_sense_clarification": "в такой же степени"
                            },
                            {
                                "target_lang_word": "так же",
                                "target_lang_sense_clarification": "одинаково"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同样",
                                "target_lang_sense_clarification": "表示程度一致"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01b6e8fe-4f52-30a5-8cde-304c76c15424",
                    "sense_definition": "To the point of being physically full or satiated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests ate <w>fully</w> at the banquet before the dancing began.",
                            "target_lang_translations": {
                                "ru": "Гости наелись <w>досыта</w> на банкете, прежде чем начались танцы.",
                                "zh": "舞会开始前，客人们在宴会上吃得<w>饱饱</w>的。"
                            }
                        },
                        {
                            "text": "You should eat <w>fully</w> to ensure you have energy for the journey.",
                            "target_lang_translations": {
                                "ru": "Тебе следует поесть <w>досыта</w>, чтобы хватило сил на путешествие.",
                                "zh": "你应该吃<w>饱</w>，以确保旅途有足够的体力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "eat fully"
                    ],
                    "target_lang_definitions": {
                        "ru": "До состояния физической сытости.",
                        "zh": "达到身体饱足的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досыта",
                                "target_lang_sense_clarification": "до полного насыщения едой"
                            },
                            {
                                "target_lang_word": "плотно",
                                "target_lang_sense_clarification": "обильно (о еде)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "饱",
                                "target_lang_sense_clarification": "指吃够了，不再感到饥饿"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d66d447-1970-3494-a9f3-c3539b8a1290",
                    "sense_definition": "To commit or send someone to trial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was arrested and subsequently <w>fullied</w> to stand trial for the theft.",
                            "target_lang_translations": {
                                "ru": "Он был арестован и впоследствии <w>предан суду</w> за кражу.",
                                "zh": "他被捕后随即被<w>起诉</w>，因盗窃罪接受审判。"
                            }
                        },
                        {
                            "text": "After the magistrate heard the evidence, the prisoner was <w>fullied</w>.",
                            "target_lang_translations": {
                                "ru": "После того как судья заслушал доказательства, заключенный был <w>отправлен под суд</w>.",
                                "zh": "地方法官听取证据后，囚犯被<w>送交审判</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal cant"
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предать суду или отправить под стражу (устаревшее/жаргон).",
                        "zh": "将某人移交审判。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предать суду",
                                "target_lang_sense_clarification": "официально отправить на судебное разбирательство"
                            },
                            {
                                "target_lang_word": "отправить под суд",
                                "target_lang_sense_clarification": "направить дело в суд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起诉",
                                "target_lang_sense_clarification": "法律程序中正式控告"
                            },
                            {
                                "target_lang_word": "送交审判",
                                "target_lang_sense_clarification": "将案件移交法院"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}