                "translations": [
                    {
                        "translation_id": "9d72359c-5841-4030-b1b4-548c862f7e23",
                        "source_entry_id": "c4078469-f3aa-3e74-a4e8-41aac95bb524",
                        "source_sense_id": "29e4e33c-2d59-34a0-91ff-dd2f6fad1d22",
                        "target_lang_word": "Derivation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Derivation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d6afe45-720a-32bb-a822-401fc68db762",
                                        "entry_id": "a4072377-f339-3bfc-98fb-9284593b9181",
                                        "glosses": [
                                            "(Prozess und Ergebnis der) Bildung neuer Wörter mit Hilfe gebundener grammatischer Morpheme (Derivateme)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6566d28d-74e8-4fbf-8f91-da96c52d4664",
                                                "sense_id": "8d6afe45-720a-32bb-a822-401fc68db762",
                                                "text": "Die Wörter „schauerlich“, „Unwort“, „zerreden“ sind Derivationen."
                                            },
                                            {
                                                "example_id": "d79625ca-5e16-49e5-a30c-77058edc7fbb",
                                                "sense_id": "8d6afe45-720a-32bb-a822-401fc68db762",
                                                "text": "Die Derivation gehört ebenso wie die Flexion zur „Morphologie“."
                                            },
                                            {
                                                "example_id": "71cacb52-b486-461d-b581-ce3fb93d9cda",
                                                "sense_id": "8d6afe45-720a-32bb-a822-401fc68db762",
                                                "text": "Man kann unter Derivation einerseits Wörter mit einer bestimmten Wortstruktur verstehen, andererseits aber auch ein Verfahren und/oder den Vorgang, neue Wörter zu bilden."
                                            },
                                            {
                                                "example_id": "70960620-fe5c-4abb-bd31-e52e4ec4f746",
                                                "sense_id": "8d6afe45-720a-32bb-a822-401fc68db762",
                                                "text": "„Gehören Präfixbildungen zur Derivation oder stellen sie einen speziellen Wortbildungstyp bzw. eine eigene Wortbildungsart dar?“"
                                            },
                                            {
                                                "example_id": "48b478f4-4258-4f08-bf52-5e8df007dfc8",
                                                "sense_id": "8d6afe45-720a-32bb-a822-401fc68db762",
                                                "text": "„Das ist bei den meisten Komposita und Derivationen der deutschen Gegenwartssprache anders.“"
                                            },
                                            {
                                                "example_id": "ff99bdfc-73f6-4dba-877f-34c7a0eb36b3",
                                                "sense_id": "8d6afe45-720a-32bb-a822-401fc68db762",
                                                "text": "„Während die Zahl der Elemente, die in Komposition eingehen können, unübersehbar groß ist, ist die Zahl der Elemente, mit denen Derivationen möglich sind, gering.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
