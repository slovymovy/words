    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa829340-abf7-3e1f-aa38-b473c6562f8e",
                    "sense_definition": "Het door elkaar slaan of mengen van vloeistoffen, meestal eieren.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "mengen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn vader <w>klutste</w> vaak een eitje voor het ontbijt.",
                            "target_lang_translations": {
                                "en": "My father often <w>whisked</w> an egg for breakfast.",
                                "ru": "Мой отец часто <w>взбивал</w> яйцо на завтрак."
                            }
                        },
                        {
                            "text": "Je moet de eieren goed <w>klutsen</w> voordat je ze in de pan doet.",
                            "target_lang_translations": {
                                "en": "You need to <w>beat</w> the eggs well before putting them in the pan.",
                                "ru": "Нужно хорошо <w>разболтать</w> яйца, прежде чем выливать их на сковороду."
                            }
                        }
                    ],
                    "synonyms": [
                        "mengen",
                        "klutselen"
                    ],
                    "common_phrases": [
                        "een ei klutsen",
                        "eieren klutsen"
                    ],
                    "target_lang_definitions": {
                        "en": "To beat or mix liquids together, most commonly eggs.",
                        "ru": "Взбивание или перемешивание жидкостей, чаще всего яиц."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to whisk",
                                "target_lang_sense_clarification": "using a rapid motion to mix"
                            },
                            {
                                "target_lang_word": "to beat",
                                "target_lang_sense_clarification": "mixing eggs or cream"
                            },
                            {
                                "target_lang_word": "to scramble",
                                "target_lang_sense_clarification": "specifically for preparing eggs"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "взбивать",
                                "target_lang_sense_clarification": "яйца или сливки"
                            },
                            {
                                "target_lang_word": "разбалтывать",
                                "target_lang_sense_clarification": "яйца для омлета"
                            },
                            {
                                "target_lang_word": "перемешивать",
                                "target_lang_sense_clarification": "жидкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d9fcc24-fa2a-39d0-883e-203c3b856ce4",
                    "sense_definition": "Het bedienen van de koppeling in een voertuig, vaak in de context van dubbel ontkoppelen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voertuigbediening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij deze oude vrachtwagen moet je nog ouderwets dubbel <w>klutsen</w> om te schakelen.",
                            "target_lang_translations": {
                                "en": "With this old truck, you still have to <w>double-clutch</w> the old-fashioned way to shift gears.",
                                "ru": "В этом старом грузовике всё еще нужно по-старинке <w>использовать двойной выжим</w>, чтобы переключить передачу."
                            }
                        },
                        {
                            "text": "Hij leerde hoe hij moest <w>klutsen</w> zonder de tandwielen te laten knarsen.",
                            "target_lang_translations": {
                                "en": "He learned how to <w>clutch</w> without making the gears grind.",
                                "ru": "Он научился <w>выжимать сцепление</w> так, чтобы шестерни не скрежетали."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontkoppelen",
                        "koppelen"
                    ],
                    "common_phrases": [
                        "dubbel klutsen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in the context of driving older vehicles"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Operating the clutch in a vehicle, often in the context of double-clutching.",
                        "ru": "Управление сцеплением в автомобиле, часто в контексте двойного выжима сцепления."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to double-clutch",
                                "target_lang_sense_clarification": "shifting technique for older vehicles"
                            },
                            {
                                "target_lang_word": "to clutch",
                                "target_lang_sense_clarification": "operating the clutch pedal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выжимать сцепление",
