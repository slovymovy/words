                        "sense_id": "60ee1453-c7f9-3e6b-87d4-e9bc66399817",
                        "entry_id": "0d141478-0baf-3f89-885b-bf2f24d0dd20",
                        "glosses": [
                            "A place set with trees or mass of shrubbery, a grove or thicket."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "335fea83-5f92-4267-ac7a-099d9876e657",
                                "sense_id": "60ee1453-c7f9-3e6b-87d4-e9bc66399817",
                                "text": "At the entrance of the king, the first traverse was drawn, and the lower descent of the mountain discovered, which was the pendant of a hill to life, with divers boscages and grovets upon the steep or hanging grounds thereof."
                            },
                            {
                                "example_id": "608ba3cb-fea4-4dfa-aac1-d0f09d47a470",
                                "sense_id": "60ee1453-c7f9-3e6b-87d4-e9bc66399817",
                                "text": "The shadiest boskage covers it perpetually."
                            },
                            {
                                "example_id": "6970e3c6-9143-4197-b1a4-a668d18be2c2",
                                "sense_id": "60ee1453-c7f9-3e6b-87d4-e9bc66399817",
                                "text": "An abundance of bird life dwells in the luxuriant boscage of the cuttings, and the whole six miles provide a rich field of study for the botanist."
                            }
                        ]
                    },
                    {
                        "sense_id": "4af45418-e087-3a4c-9a73-be1500bea3ac",
                        "entry_id": "0d141478-0baf-3f89-885b-bf2f24d0dd20",
                        "glosses": [
                            "Mast-nuts of forest trees, used as food for pigs, or any such sustenance as wood and trees yield to cattle."
