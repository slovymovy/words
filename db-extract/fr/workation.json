                                    {
                                        "sense_id": "a9daab84-58d8-3ab1-99b6-f40a76974928",
                                        "entry_id": "36cd10cc-b19f-3607-95f0-e8141e0da940",
                                        "glosses": [
                                            "Alternative form of workcation."
                                        ],
