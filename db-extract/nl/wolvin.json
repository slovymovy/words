                                "target_senses": [
                                    {
                                        "sense_id": "64a7bb24-c3de-3bca-9e16-a3c74d3ed7bd",
                                        "entry_id": "512a0fac-cf2d-311f-a42c-943decc543e9",
                                        "glosses": [
                                            "A female wolf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19e39ae-a72f-4bf1-aece-38d9a8d13184",
                                                "sense_id": "64a7bb24-c3de-3bca-9e16-a3c74d3ed7bd",
                                                "text": "In some trepidation the priest and his friend accompanied the wolf to his den, where lay a she-wolf on the point of death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e398cf77-fa0b-3110-ac4b-9df9bb0892fc",
                                        "entry_id": "512a0fac-cf2d-311f-a42c-943decc543e9",
                                        "glosses": [
                                            "A predatory woman."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4f4196b-2e75-4c19-8493-84e129b514a3",
                        "source_entry_id": "28da8b72-15d0-34b7-b441-5c21877e690c",
                        "source_sense_id": "f078fc40-e1fd-37cc-95a9-dce439e505ff",
                        "source_sense_description": "vrouwelijke wolf",
                        "target_lang_word": "louve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "louve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b67d5023-a3b6-36b2-9c0e-d9ad7dcb56c6",
                                        "entry_id": "1d47a7f3-4953-370f-9518-d17401d55cf0",
                                        "glosses": [
                                            "Loup femelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4a172d-aeba-4b56-8a70-41f4df6fa3d7",
                                                "sense_id": "b67d5023-a3b6-36b2-9c0e-d9ad7dcb56c6",
                                                "text": "Romulus et Rémus furent allaités par une louve, dit la légende ; la réalité est moins attendrissante : toute louve signalée à moins de 70 km de Rome est systématiquement abattue."
                                            },
                                            {
                                                "example_id": "cce81ada-484f-4704-b648-73b23c21c48c",
                                                "sense_id": "b67d5023-a3b6-36b2-9c0e-d9ad7dcb56c6",
                                                "text": "Entre chienne et louve , le spectacle du Quartet Buccal, a fait un tabac partout où il a été donné."
                                            },
                                            {
                                                "example_id": "15281fe2-1c92-4f97-b3a3-b9a0dbbae416",
                                                "sense_id": "b67d5023-a3b6-36b2-9c0e-d9ad7dcb56c6",
                                                "text": "Mon enfant, mon enfant, pourquoi hurler dans l’ombre\nComme la maigre louve au bord des tombeaux sourds ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d3dc15c-e8c7-3b93-82f9-e1d423d5f1cb",
                                        "entry_id": "1d47a7f3-4953-370f-9518-d17401d55cf0",
                                        "glosses": [
                                            "Femme portée sur le plaisir sexuel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe34a50-ee89-4505-a4bd-7fbe36809a86",
                                                "sense_id": "9d3dc15c-e8c7-3b93-82f9-e1d423d5f1cb",
                                                "text": "Il la revoyait jeune, grande créature mince et pâle, aux yeux effarés, veuve tout de suite de Rougon, du lourd jardinier qu’elle avait voulu pour mari, se jetant avant la fin de son deuil aux bras du contrebandier Macquart, qu’elle aimait d’un amour de louve et qu’elle n’épousait même pas."
                                            },
                                            {
                                                "example_id": "61f5deae-ee99-4a42-890b-89172c273949",
                                                "sense_id": "9d3dc15c-e8c7-3b93-82f9-e1d423d5f1cb",
                                                "text": "Renvoyée de son école pour inconduite, elle est revenue ici parce que certains étudiants lui plaisent. Elle devait rester trois jours, paraît-il. Trois jours ! Elle n’a pas la moindre intention de partir. C’est ce que les Latins appelaient lupa, une louve, une bête sans cesse affamée…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7f4744-122e-38c9-92a5-727c6cfa4359",
                                        "entry_id": "1d47a7f3-4953-370f-9518-d17401d55cf0",
                                        "glosses": [
                                            "Femme indépendante, au comportement sauvage, éprise de liberté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e7a4b1d-8012-4e29-9c2a-444a139d28d4",
                                                "sense_id": "1f7f4744-122e-38c9-92a5-727c6cfa4359",
                                                "text": "Tu me guides je te guide – louves\nà la queue leu leu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c70f5638-836a-3801-84d0-ebcd90b67c9b",
                                        "entry_id": "1d47a7f3-4953-370f-9518-d17401d55cf0",
                                        "glosses": [
                                            "Coin métallique utilisé pour le levage des pierres de taille. Il en existait deux types : le modèle auto-serrant et le modèle clavé. L'une comme l'autre était introduite dans un trou percé au centre de la pierre à soulever."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "491620f5-7909-34b7-b95f-45119e40a539",
                                        "entry_id": "1d47a7f3-4953-370f-9518-d17401d55cf0",
                                        "glosses": [
                                            "Sorte de filet servant pour la pêche, maintenu par des perches ou des cerceaux de bois, apparentée au verveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8012149d-5a2f-479e-877b-f6f6439ad465",
                                                "sense_id": "491620f5-7909-34b7-b95f-45119e40a539",
                                                "text": "Dans les eaux dormantes on préfère employer les louves ou les verveux cylindriques à plusieurs entrées; c’est au milieu des herbes que l’on tend les louves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d73f78-cc68-36a6-94aa-fe7d78130982",
                                        "entry_id": "1d47a7f3-4953-370f-9518-d17401d55cf0",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
