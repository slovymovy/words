                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e98f321-0725-4f67-b7d7-afb890b4f9b0",
                                "sense_id": "7f4cd54b-deb6-3f46-b2ea-fb1146702667",
                                "text": "The sunset's roses faint and fain decline.\nInshore the still sea shimmers scale on scale,\nLike an enormous coat of magic mail —\nSheet silver shot with tremulous opaline."
                            }
                        ]
                    },
                    {
                        "sense_id": "83cbb3fc-ba88-34fd-8a89-863bfb8eb9bf",
                        "entry_id": "83fb9775-211f-3c1a-b655-8c574f1112d3",
                        "glosses": [
