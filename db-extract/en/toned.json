                        "target_lang_word": "straff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "straff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "040d9e90-a9b6-3705-9d1e-6a2e711966f0",
                                        "entry_id": "d6815e21-0dba-3f8a-9c86-3e626b024ceb",
                                        "glosses": [
                                            "nicht durchhängend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f184882-c8d0-4d9c-8e64-328d8a5e6cbd",
                                                "sense_id": "040d9e90-a9b6-3705-9d1e-6a2e711966f0",
                                                "text": "Das Abschleppseil muss straff gespannt sein."
                                            },
                                            {
                                                "example_id": "606a06b9-6c12-4dc1-a554-0681ea7b9e7a",
                                                "sense_id": "040d9e90-a9b6-3705-9d1e-6a2e711966f0",
                                                "text": "Rudenz: „[…] allzu straff gespannt zerspringt der Bogen.“"
                                            },
                                            {
                                                "example_id": "dda7fbd1-ed4d-472e-a424-0b45b1bca23d",
                                                "sense_id": "040d9e90-a9b6-3705-9d1e-6a2e711966f0",
                                                "text": "Die straffen Sitze [des Seat Toledo] sind bequem, die sehr straffe Federung ist es zum Glück auch noch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b6f27f3-2d68-3902-9aa7-4a99256d74a0",
                                        "entry_id": "d6815e21-0dba-3f8a-9c86-3e626b024ceb",
                                        "glosses": [
                                            "nicht schlaff, nicht locker"
                                        ],
                                        "tags": [
                                            "menschlicher Körper"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf392cdc-f25a-41e6-bc84-0a898369ff7b",
                                                "sense_id": "8b6f27f3-2d68-3902-9aa7-4a99256d74a0",
                                                "text": "Da gibt es ältere Herren, die Silvio Berlusconi nicht unähnlich sind: sonnenbankbraune Haut, straff geliftet, die coole Sonnenbrille lässig ins tiefschwarz getönte, schüttere Haupthaar gesteckt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d3ac5902-69ba-32b8-805f-e3d4e31e35ef",
                                        "entry_id": "d6815e21-0dba-3f8a-9c86-3e626b024ceb",
                                        "glosses": [
                                            "sehr gut organisiert; keinen Raum für Nachlässigkeiten lassend, nichts Überflüssiges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4427cb4-46e7-41aa-8eb2-dfbdf5f49841",
                                                "sense_id": "d3ac5902-69ba-32b8-805f-e3d4e31e35ef",
                                                "text": "Das Verhältnis von Hochschullehrern und Studenten hat sich in den letzten Jahrzehnten gewandelt. Überfüllte Hörsäle und ein straffer Lehrplan erschweren das Studium."
                                            },
                                            {
                                                "example_id": "d64872d1-8257-4684-9313-62b87de08934",
                                                "sense_id": "d3ac5902-69ba-32b8-805f-e3d4e31e35ef",
                                                "text": "Viele Jugendliche, die ebenfalls Leistungssport betrieben, sind davon [von der deutschen Turnelite] noch ganz weit entfernt. Dennoch absolvieren sie stetig ihr straffes Trainingsprogramm."
                                            },
                                            {
                                                "example_id": "e8a9badd-b822-42c0-9af0-794637b0f902",
                                                "sense_id": "d3ac5902-69ba-32b8-805f-e3d4e31e35ef",
                                                "text": "Ihre [Petra Ledendeckers] zahlreichen Engagements schafft sie mit einem straffen Terminplan und guter Organisation."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
