                                        "sense_id": "0efd0ea1-b815-3384-b7ba-d1854b8689f8",
                                        "entry_id": "33293fd0-b753-3eff-84d7-ffa3c3ed7653",
                                        "glosses": [
                                            "Committing new offenses after a crime committed in the past."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa2a979-9702-4b20-b7e8-c1a2570c74be",
                                                "sense_id": "0efd0ea1-b815-3384-b7ba-d1854b8689f8",
                                                "text": "The increase in criminal activity was attributed to recidivism."
                                            },
                                            {
                                                "example_id": "09271de7-6ada-4c66-86ff-f6ad5a193e5a",
                                                "sense_id": "0efd0ea1-b815-3384-b7ba-d1854b8689f8",
                                                "text": "Unintended mathwashing occurs when the algorithm is left unchecked, and, learning from historical data, amplifies social bias. The U.S. justice system uses an algorithm called COMPAS to determine a criminal's likelihood to re-offend. COMPAS has been proven by Pro Publica to predict that black defendants will have higher rates of recidivism than they actually do, while white defendants are predicted to have lower rates than they actually do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa4f06cf-7df0-35cb-8e0c-070887d82201",
                                        "entry_id": "33293fd0-b753-3eff-84d7-ffa3c3ed7653",
                                        "glosses": [
                                            "Chronic repetition of criminal or other antisocial behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fffa9245-0972-3ef1-af1f-f4fb85e85779",
                                        "entry_id": "33293fd0-b753-3eff-84d7-ffa3c3ed7653",
                                        "glosses": [
                                            "Returning to a negative behavior after having stopped it for a period of time."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e9506d-d7ac-4604-b119-d12991597680",
                                                "sense_id": "fffa9245-0972-3ef1-af1f-f4fb85e85779",
                                                "text": "alcohol(ic) recidivism"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
