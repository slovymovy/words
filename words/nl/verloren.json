                },
                {
                    "sense_id": "b558bb9a-aa65-3c64-a11f-c5c19951ac8d",
                    "sense_definition": "Meervoud verleden tijd van <w>verliezen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>verloren</w> elkaar uit het oog in de drukte.",
                            "target_lang_translations": {
                                "en": "We <w>lost</w> sight of each other in the crowd.",
                                "ru": "Мы <w>потеряли</w> друг друга из виду в толпе.",
                                "fr": "Nous nous sommes <w>perdus</w> de vue dans la foule.",
                                "zh": "我们在人群中<w>失去</w>了彼此的踪迹。"
                            }
                        },
                        {
                            "text": "De bomen <w>verloren</w> al hun bladeren tijdens de storm.",
                            "target_lang_translations": {
                                "en": "The trees <w>lost</w> all their leaves during the storm.",
                                "ru": "Деревья <w>потеряли</w> все свои листья во время шторма.",
                                "fr": "Les arbres ont <w>perdu</w> toutes leurs feuilles pendant la tempête.",
                                "zh": "暴风雨中，树木<w>掉光</w>了所有的树叶。"
                            }
                        }
                    ],
