                        "cross_references": [
                            {
                                "target_word": "adhesion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d4b70b0-ed20-377d-9d87-e08692348cfc",
                                        "entry_id": "555ddb02-1d39-3a16-b122-7c285064290e",
                                        "glosses": [
                                            "The ability of a substance to stick to an unlike substance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a16e2768-0bb7-3ab4-95dd-865a882bb52e",
                                        "entry_id": "555ddb02-1d39-3a16-b122-7c285064290e",
                                        "glosses": [
                                            "Persistent attachment or loyalty."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1ce98f2-3f8f-46ab-90c3-cd6a622485c9",
                                                "sense_id": "a16e2768-0bb7-3ab4-95dd-865a882bb52e",
                                                "text": "[N]o waver in Judgment, have I, though Gods mercy, ever been; but a conſtant aſſertor of, and ſufferer for my ſatisfiedneſs in, and adheſion to, the piety and probity of my breeding and belief, vvhich vvas ever, yet is, and I hope, through Gods grace, to death ſhall be, in point of Religion according to the Doctrine and Diſcipline of the Church of England."
                                            },
                                            {
                                                "example_id": "c75d18af-d262-4653-a612-3c43468adf21",
                                                "sense_id": "a16e2768-0bb7-3ab4-95dd-865a882bb52e",
                                                "text": "Who doubts that the fineing, whipping, torturing, hanging, embowelling of men, women, and children, guilty of no other crime than adhesion to the Catholic faith, had assisted the Pope and Philip, and their band of English, Scotch, and Irish conspirators, to shake Elizabeth's throne and endanger her life?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd474988-89f2-3e89-8f27-1b6bc06e8b4c",
                                        "entry_id": "555ddb02-1d39-3a16-b122-7c285064290e",
                                        "glosses": [
                                            "An agreement to adhere."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4526ac-5e85-43fd-9273-107026b68ca5",
                                                "sense_id": "fd474988-89f2-3e89-8f27-1b6bc06e8b4c",
                                                "text": "Mistress Affery, heartily glad to effect the proposed compromise, gave in her willing adhesion to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59a76fc8-cbc6-3ca3-a409-fd3aef400699",
                                        "entry_id": "555ddb02-1d39-3a16-b122-7c285064290e",
                                        "glosses": [
                                            "An abnormal union of surface by the formation of new tissue resulting from an inflammatory process."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c210863-3051-3fa3-a1d9-7e68337f518f",
                                        "entry_id": "555ddb02-1d39-3a16-b122-7c285064290e",
                                        "glosses": [
                                            "The binding of a cell to a surface or substrate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4a6d4fb-52f1-3f26-83ee-90f570cffbe7",
                                        "entry_id": "555ddb02-1d39-3a16-b122-7c285064290e",
                                        "glosses": [
                                            "The frictional grip on a surface, of wheels, shoes etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038da197-21b7-49ea-b52e-17b54609163b",
                                                "sense_id": "c4a6d4fb-52f1-3f26-83ee-90f570cffbe7",
                                                "text": "Several types of diesel locomotive have been tested on this working and as a result the probable choice will be Type 2 diesels in pairs, without bankers. The crucial factor in the selection of this method is the higher degree of adhesion obtained than with a single Type 4; on trial one of the latter showed that in very adverse conditions it might slip to a standstill at one of the two tricky spots on the steep climb from Tyne Dock to Consett."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
