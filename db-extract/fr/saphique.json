                    },
                    {
                        "translation_id": "25281d52-00d1-4589-97a7-223195bec904",
                        "source_entry_id": "4f0a0fef-ef35-39b3-8d6c-009344ad1cd8",
                        "target_lang_word": "Sapphic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sapphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1fa46a4-c7de-3cc4-8635-0df9356a0377",
                                        "entry_id": "e637fa00-e4be-3328-b591-41acff69abdb",
                                        "glosses": [
                                            "A Sapphic verse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce5e5415-b70e-4408-9678-d857bbde9bc2",
                                                "sense_id": "a1fa46a4-c7de-3cc4-8635-0df9356a0377",
                                                "text": "His Sapphics, on the story of Bacchus and Ariadne, are easy, elegant, and poetical."
                                            },
                                            {
                                                "example_id": "53f92072-03ab-40b5-9cac-0951862a4af8",
                                                "sense_id": "a1fa46a4-c7de-3cc4-8635-0df9356a0377",
                                                "text": "The first line (which goes by the name of Aristophanes) is a Sapphic without the initial trochees."
                                            },
                                            {
                                                "example_id": "e600bf52-4333-4948-a4fb-ad07508787ed",
                                                "sense_id": "a1fa46a4-c7de-3cc4-8635-0df9356a0377",
                                                "text": "\"A real Sapphic,\" said Crane, dropping into a poetical tone, as an elocutionist does when he is hungry for an opportunity to recite a favorite sketch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1007d245-812d-38d9-8c25-c530bce6c941",
                                        "entry_id": "e637fa00-e4be-3328-b591-41acff69abdb",
                                        "glosses": [
                                            "A person who is sapphic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbb706f-062e-43c2-bde4-d49dba9babf1",
                                                "sense_id": "1007d245-812d-38d9-8c25-c530bce6c941",
                                                "text": "'Very good,” he said, 'although I must confess that the older I get, the less I am able to enjoy the company of women – except of course our own dear Enid who is so notorious a Sapphic as to be virtually hors concours."
                                            },
                                            {
                                                "example_id": "53f08a75-ce61-4689-a647-d18403e9e7b1",
                                                "sense_id": "1007d245-812d-38d9-8c25-c530bce6c941",
                                                "text": "There are many of us (yes, even in Utah) who are more style-conscious, socially involved and culturally aware Sapphics than the common opinion dictates."
                                            },
                                            {
                                                "example_id": "f2b89707-ab40-4756-8554-4d140a327026",
                                                "sense_id": "1007d245-812d-38d9-8c25-c530bce6c941",
                                                "text": "Are you a fan of hate-to-love? Roommates? Royalty romances? Geology puns? Sapphics? Her Royal Highness has all of this and more. After Millie discovers her best friend turned maybe girlfriend kissing someone else, she decides to flee […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sapphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f219013-2ccf-3657-92a3-45b1e4a6627a",
                                        "entry_id": "575a1b09-3dea-3b3b-a6a3-4f73e3309119",
                                        "glosses": [
                                            "Relating to the Greek poetess Sappho from Lesbos or her poetry."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb1fbc08-ddd1-384a-a5af-5cdbad34f921",
                                        "entry_id": "575a1b09-3dea-3b3b-a6a3-4f73e3309119",
                                        "glosses": [
                                            "Of a certain kind of verse reputed to have been invented by Sappho, consisting of five metrical feet, of which the first, fourth, and fifth are trochees, the second is a spondee, and the third a dactyl."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
