    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a44875f4-2bc0-30af-b3c7-bf57c5dc084e",
                    "sense_definition": "Pratiquer la méditation pour apaiser son esprit ou dans un cadre spirituel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spiritualité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'assoit confortablement sur son coussin pour <w>méditer</w> chaque matin pendant vingt minutes."
                        },
                        {
                            "text": "Le moine passe plusieurs heures par jour à <w>méditer</w> en silence dans le monastère."
                        }
                    ],
                    "common_phrases": [
                        "méditer en silence"
                    ]
                },
                {
                    "sense_id": "7e61289a-a566-31a5-b9df-d60eac5e00a2",
                    "sense_definition": "Réfléchir longuement et profondément à quelque chose afin de l'analyser ou de le comprendre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pensée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe a passé des années à <w>méditer</w> sur le sens de l'existence humaine."
                        },
                        {
                            "text": "Tu devrais <w>méditer</w> ses précieux conseils avant de prendre une décision aussi importante."
                        }
                    ],
                    "synonyms": [
                        "réfléchir",
                        "songer"
                    ],
                    "common_phrases": [
                        "méditer sur un sujet",
                        "méditer longuement"
                    ]
                },
                {
                    "sense_id": "034e3572-d4a2-3239-981a-d42e045b7dbd",
                    "sense_definition": "Concevoir ou préparer secrètement dans son esprit un projet ou une action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "projet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prisonnier semblait <w>méditer</w> un plan d'évasion depuis plusieurs semaines."
                        },
                        {
                            "text": "Il gardait le silence et semblait <w>méditer</w> une terrible vengeance contre ses rivaux."
                        }
                    ],
                    "synonyms": [
                        "projeter",
                        "tramer",
                        "combiner"
                    ],
                    "common_phrases": [
                        "méditer une vengeance",
                        "méditer un projet"
                    ]
                }
            ]
        }
    ]
