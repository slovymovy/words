                                "example_id": "580b2cff-20da-41f0-80e0-1e793caf0221",
                                "sense_id": "5c8279ce-f373-3ee6-bfce-14721daef458",
                                "text": "Het is een ondankbare baan, maar iemand moet het doen.",
                                "translation": "It's a thankless job, but someone has to do it.",
                                "english": "It's a thankless job, but someone has to do it."
