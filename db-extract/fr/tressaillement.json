        "fr-extract.jsonl": [
            {
                "entry_id": "92e277b4-054c-3244-a8c6-1ee800e44285",
                "word": "tressaillement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e09d240a-6cd6-4270-95a1-028ba303a797",
                        "entry_id": "92e277b4-054c-3244-a8c6-1ee800e44285",
                        "tags": [
                            "plural"
                        ],
                        "form": "tressaillements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9af2f54-f243-32e8-a02f-727c1706fe5b",
                        "entry_id": "92e277b4-054c-3244-a8c6-1ee800e44285",
                        "glosses": [
                            "Légère agitation, brusque mouvement causé par une émotion vive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2958f77a-66ff-4183-9ae2-45bec8802a94",
                                "sense_id": "c9af2f54-f243-32e8-a02f-727c1706fe5b",
                                "text": "Ce devait être un regard échangé, quelque tressaillement surpris, comme lorsqu’un chirurgien met le doigt sur une douleur cachée."
                            },
                            {
                                "example_id": "cc589c11-0eed-4c57-9bd1-d2bad3fa10d0",
                                "sense_id": "c9af2f54-f243-32e8-a02f-727c1706fe5b",
                                "text": "La poigne du policier s’était abattue sur l’épaule du Roi du crime. Fantômas n’avait pas eu un tressaillement, il n’avait tenté aucune résistance."
                            },
                            {
                                "example_id": "190da19c-ff25-4935-877f-7f0e76bd303a",
                                "sense_id": "c9af2f54-f243-32e8-a02f-727c1706fe5b",
                                "text": "Il est pareil à ces araignées velues qui vivent au grenier, tapies pendant des jours au centre de leur toile, immobiles, redoutables, prêtes à bondir au moindre tressaillement du piège tendu."
                            },
                            {
                                "example_id": "7dee0d8e-6d1b-4b6f-b2ce-3e2962669d0a",
                                "sense_id": "c9af2f54-f243-32e8-a02f-727c1706fe5b",
                                "text": "Je pris sa main dans la mienne et lui ordonnai de se tranquilliser, car une série de tressaillements la convulsaient, et elle tenait à garder son regard fixé sur le miroir."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
