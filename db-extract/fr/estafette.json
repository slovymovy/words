        "fr-extract.jsonl": [
            {
                "entry_id": "16086882-8fa2-316c-bf0c-c45bfc00af5b",
                "word": "estafette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "500d0ecb-23d8-40c7-8d2c-4b2eafc5fa6a",
                        "entry_id": "16086882-8fa2-316c-bf0c-c45bfc00af5b",
                        "tags": [
                            "plural"
                        ],
                        "form": "estafettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b56e885e-ad31-3af6-b563-fc10a99c6127",
                        "entry_id": "16086882-8fa2-316c-bf0c-c45bfc00af5b",
                        "glosses": [
                            "Tout courrier chargé d’une dépêche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "156c668a-6cef-4644-8385-bfe22b258792",
                                "sense_id": "b56e885e-ad31-3af6-b563-fc10a99c6127",
                                "text": "Cette nouvelle venait d’être apportée par une estafette qui avait réussi à pénétrer dans la ville, et qui était chargée d’en faire ouvrir les portes à la colonne."
                            },
                            {
                                "example_id": "7968c6de-6ad2-4770-a1d3-32971d7e2af5",
                                "sense_id": "b56e885e-ad31-3af6-b563-fc10a99c6127",
                                "text": "Je revenais dans l'auto des estafettes, portant des piles et d'autres accessoires lorsque nous offrîmes une place à une sorte d'ambulancier."
                            },
                            {
                                "example_id": "ae121c7e-5af5-4e0b-86a6-b70399482e21",
                                "sense_id": "b56e885e-ad31-3af6-b563-fc10a99c6127",
                                "text": "L’armée du Kuomintang attendrait Shanghaï dans quelques heures : de moment en moment, arrivaient les estafettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e75b68a-d6bf-3b93-8b69-763793eddd0c",
                        "entry_id": "16086882-8fa2-316c-bf0c-c45bfc00af5b",
                        "glosses": [
                            "Soldat chargé de transmettre des messages ; agent de liaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208295a3-489b-44ea-bd93-83b7e4fd72ff",
                                "sense_id": "5e75b68a-d6bf-3b93-8b69-763793eddd0c",
                                "text": "Des aides de camp, des estafettes apportaient des nouvelles."
                            },
                            {
                                "example_id": "f71384e6-20d4-4d98-93ef-48a848cdd3fc",
                                "sense_id": "5e75b68a-d6bf-3b93-8b69-763793eddd0c",
                                "text": "Pour les deux derniers mois de grossesse, Carlos voulait alléger le plus possible son travail d’estafette."
                            }
                        ]
                    },
                    {
                        "sense_id": "15ebfb6b-190d-3533-bc1b-8d2668969aa4",
                        "entry_id": "16086882-8fa2-316c-bf0c-c45bfc00af5b",
                        "glosses": [
                            "Automobile utilitaire de marque Renault."
                        ],
                        "tags": [],
                        "note": "S’écrit souvent avec une majuscule initiale",
                        "examples": [
                            {
                                "example_id": "acc35358-0a89-47e0-984e-6fae02e6c8e3",
                                "sense_id": "15ebfb6b-190d-3533-bc1b-8d2668969aa4",
                                "text": "Voici une photo prise de l’endroit où était stationnée l’Estafette et les premiers points d’impact vont être relevés contre le mur. Ces points d’impact vont être relevés sur toute cette partie et les photos qui suivent vont montrer ces points à la hauteur du sol."
                            },
                            {
                                "example_id": "c2bd12db-4321-47ce-aa41-249873d93754",
                                "sense_id": "15ebfb6b-190d-3533-bc1b-8d2668969aa4",
                                "text": "La Zaza avait beau avoir des nerfs d’acier, une présence d’esprit à toute épreuve, elle se planta contre une Estafette en stationnement."
                            }
                        ]
                    },
                    {
                        "sense_id": "f747a345-8e73-3ad0-993b-fa6f7495c276",
                        "entry_id": "16086882-8fa2-316c-bf0c-c45bfc00af5b",
                        "glosses": [
                            "Véhicule de transport de personnes, d’un volume rappelant celui de l’Estafette Renault."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "9f388734-981b-46c2-890e-9e7bb6bb280d",
                                "sense_id": "f747a345-8e73-3ad0-993b-fa6f7495c276",
                                "text": "Une douzaine d’estafettes de CRS sont arrivées sur les lieux, sans immédiatement intervenir, alors que les militants multipliaient happenings ou interventions de spécialistes de l’urbanisme ou de la construction écologique, expliquant les possibilités et avantages de matériaux telle que paille, bois ou terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc19d3e7-8490-36ad-8975-7ccef0fac52b",
                        "entry_id": "16086882-8fa2-316c-bf0c-c45bfc00af5b",
                        "glosses": [
                            "Synonyme de anomie pelure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef64e31e-cb6a-4492-8699-3ef7e39daf01",
                                "sense_id": "dc19d3e7-8490-36ad-8975-7ccef0fac52b",
                                "text": "Anomia ephippium, Feuille de rose, encore appelée anomie, éclair, estafette, huître nacrée, luisette, pelure d'oignon : […]."
                            }
                        ]
                    }
                ],
