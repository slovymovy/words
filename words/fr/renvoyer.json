{
    "word_family": [
        "envoyer",
        "renvoi",
        "envoi",
        "envoyeur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33bee4fe-4aca-37d1-b3ac-c7fc1db39327",
                    "sense_definition": "Faire retourner une chose ou une personne à son lieu d'origine ou à son expéditeur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vêtement commandé est trop petit, je vais le <w>renvoyer</w> au vendeur dès demain."
                        },
                        {
                            "text": "Elle n'a pas accepté ce cadeau luxueux et l'a aussitôt <w>renvoyé</w> à son expéditeur."
                        }
                    ],
                    "synonyms": [
                        "retourner",
                        "restituer"
                    ],
                    "antonyms": [
                        "garder",
                        "conserver"
                    ],
                    "common_phrases": [
                        "renvoyer un colis",
                        "renvoyer un article"
                    ]
                },
                {
                    "sense_id": "d8acf33e-3bc8-3eb2-8048-2a7e18fea2d2",
                    "sense_definition": "Envoyer une nouvelle fois ce qui a déjà été expédié.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "reexpedition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme tu n'as rien reçu, je te <w>renvoie</w> les documents par courrier électronique."
                        },
                        {
                            "text": "Le message s'est perdu dans la transmission, nous devons donc le <w>renvoyer</w> immédiatement."
                        }
                    ],
                    "synonyms": [
                        "réexpédier",
                        "retransmettre"
                    ],
                    "common_phrases": [
                        "renvoyer un message",
                        "renvoyer un courriel"
                    ]
                },
                {
                    "sense_id": "985313e3-b162-34a2-9a51-fb3435776bfe",
                    "sense_definition": "Congédier quelqu'un de son emploi, ou l'exclure d'un établissement scolaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "congediement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a décidé de <w>renvoyer</w> cet employé après plusieurs retards injustifiés."
                        },
                        {
                            "text": "L'élève indiscipliné a été <w>renvoyé</w> de l'école pour une durée de trois jours."
                        }
                    ],
                    "synonyms": [
                        "licencier",
                        "congédier",
                        "exclure"
                    ],
                    "antonyms": [
                        "embaucher",
                        "recruter",
                        "engager"
                    ],
                    "common_phrases": [
                        "renvoyer un employé",
                        "renvoyer de l'école"
                    ]
                },
                {
                    "sense_id": "232f53b9-317a-3827-907b-6aeb2120e84a",
                    "sense_definition": "Repousser en sens inverse un projectile, ou réfléchir de la lumière, de la chaleur ou un son.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand miroir du salon <w>renvoie</w> la lumière du soleil dans toute la pièce."
                        },
                        {
                            "text": "Les deux joueurs de tennis se <w>renvoient</w> la balle avec une grande rapidité."
                        }
                    ],
                    "synonyms": [
                        "réfléchir",
                        "répercuter",
                        "rejeter"
                    ],
                    "antonyms": [
                        "absorber"
                    ],
                    "common_phrases": [
                        "renvoyer la balle",
                        "renvoyer la lumière"
                    ]
                },
                {
                    "sense_id": "aca714cd-fc35-3cc7-b2db-b0b7b81ac787",
                    "sense_definition": "Adresser une personne vers un spécialiste ou orienter le lecteur vers une autre source d'information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin généraliste a préféré <w>renvoyer</w> son patient vers un cardiologue réputé."
                        },
                        {
                            "text": "L'astérisque en bas de page <w>renvoie</w> le lecteur à des explications complémentaires."
                        }
                    ],
                    "synonyms": [
                        "orienter",
                        "adresser",
                        "référer"
                    ],
                    "common_phrases": [
                        "renvoyer à une note",
                        "renvoyer vers un spécialiste"
                    ]
                },
                {
                    "sense_id": "729723e1-e019-3967-b4d0-37c207880fa0",
                    "sense_definition": "Différer une affaire ou un événement, le reporter à une date ultérieure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "report",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les membres du comité ont choisi de <w>renvoyer</w> la discussion à la prochaine réunion."
                        },
                        {
                            "text": "Il ne faut pas toujours <w>renvoyer</w> au lendemain ce qu'on peut accomplir aujourd'hui."
                        }
                    ],
                    "synonyms": [
                        "reporter",
                        "ajourner",
                        "différer"
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
                        "renvoyer à plus tard",
                        "renvoyer aux calendes grecques"
                    ]
                },
                {
                    "sense_id": "3cd2f6b7-b8ba-3516-a4af-bb3ef103fe50",
                    "sense_definition": "Rejeter par la bouche le contenu de son estomac.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "regurgitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malade après le dîner, le jeune garçon a fini par <w>renvoyer</w> tout son repas."
                        },
                        {
                            "text": "Il a eu le mal de mer et a <w>renvoyé</w> son déjeuner pendant la traversée."
                        }
                    ],
                    "synonyms": [
                        "vomir",
                        "rendre"
                    ],
                    "common_phrases": [
                        "renvoyer son repas"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "7fa77f45-2183-3123-a25a-d476c7c0fc26",
                    "sense_definition": "Décider qu'une personne poursuivie doit comparaître devant une juridiction pour y être jugée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge d'instruction a décidé de <w>renvoyer</w> l'accusé devant la cour d'assises."
                        },
                        {
                            "text": "Le dossier a été examiné par les magistrats qui l'ont <w>renvoyé</w> devant un autre tribunal."
                        }
                    ],
                    "synonyms": [
                        "déférer"
                    ],
                    "common_phrases": [
                        "renvoyer devant le tribunal",
                        "renvoyer devant les assises"
                    ]
                }
            ]
        }
    ]
}