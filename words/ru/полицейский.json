                        "полицейская машина",
                        "полицейская форма",
                        "полицейский патруль"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to the police force, belonging to or characteristic of it.",
                        "nl": "Met betrekking tot de politie, behorend tot of kenmerkend voor de politie."
                    },
                    "translations": {
