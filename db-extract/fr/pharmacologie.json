                        ],
                        "form": "pharmacologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b13ab2a-d00b-36db-b1e1-0c749ee0c3fc",
                        "entry_id": "3727dff7-31f9-3576-a2ed-103a8e4c65ff",
                        "glosses": [
                            "Partie de la pharmacie qui a pour objet de faire connaître les médicaments et d’en étudier l’emploi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5272d444-ddae-41c9-97a1-2a3d78da065e",
                                "sense_id": "2b13ab2a-d00b-36db-b1e1-0c749ee0c3fc",
                                "text": "La morphine fut ainsi le premier médicament réellement puissant et inaugura l’ère moderne de la pharmacologie et de la médecine."
                            },
                            {
                                "example_id": "b465198f-999f-40fa-8938-0bd1ff027e75",
                                "sense_id": "2b13ab2a-d00b-36db-b1e1-0c749ee0c3fc",
                                "text": "C’est un nouveau champ de la pharmacologie qui s’ouvre, au-delà de la pharmacologie compétitive classique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12f93f49-33dd-425b-993a-bb4890c61f28",
                        "source_entry_id": "3727dff7-31f9-3576-a2ed-103a8e4c65ff",
                        "source_sense_id": "2b13ab2a-d00b-36db-b1e1-0c749ee0c3fc",
                        "source_sense_description": "Médecine des médicaments",
                        "target_lang_word": "Pharmakologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pharmakologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73803ee3-dade-3203-bb4e-9dde422e4052",
                                        "entry_id": "00d729d0-bac1-38d5-b979-3700573de017",
                                        "glosses": [
                                            "„Lehre von den Wechselwirkungen zwischen körperfremden Stoffen und Organismen“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e408c8-6a42-4185-a7df-532e1903ed07",
                                                "sense_id": "73803ee3-dade-3203-bb4e-9dde422e4052",
                                                "text": "„In der experimentellen Pharmakologie wird anhand von Modellsystemen versucht, die pharmakologischen Eigenschaften eines (potenziellen) Arzneistoffs oder einer Arzneimittelzubereitung zu simulieren.“"
                                            },
                                            {
                                                "example_id": "f4dc69ee-6e01-4c79-b085-42265c9304ac",
                                                "sense_id": "73803ee3-dade-3203-bb4e-9dde422e4052",
                                                "text": "„Beide waren Vollblutakademiker, beide waren renommiert in ihren Fachgebieten, die pflanzliche Pharmakologie bei meiner Mutter, bei meinem Vater die Botanik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
