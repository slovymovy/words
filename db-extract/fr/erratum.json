                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e423bdbc-ba24-40c3-8fa2-ddb07d98d33c",
                                "sense_id": "0e4903fd-098b-3dc3-b285-5e0ac8e75427",
                                "text": "Il a signalé un erratum à l’éditeur."
                            },
                            {
                                "example_id": "0074c545-96c4-4b20-bb07-c40357d59726",
                                "sense_id": "0e4903fd-098b-3dc3-b285-5e0ac8e75427",
                                "text": "J'attends toujours la liste des erratums du catalogue."
                            }
                        ]
                    },
                    {
                        "sense_id": "90b3732c-b157-3967-8434-1f3cddea67f5",
                        "entry_id": "5ba44b21-bc50-3396-8736-7cd5b0046abf",
                        "glosses": [
                            "Liste rectificative d’erreurs, dans le contexte d’un document imprimé, publié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06195637-612c-4c4d-a22d-c12f80267b10",
                                "sense_id": "90b3732c-b157-3967-8434-1f3cddea67f5",
                                "text": "De l’esprit des lois paraît pour la première fois à Genève, en 1748, grâce à l’aide de Mme de Tencin. Cette dernière s’est également chargée de la publication des errata de cette édition très fautive."
                            },
                            {
                                "example_id": "78b5ddef-4112-461a-b707-56dca4df7b7b",
                                "sense_id": "90b3732c-b157-3967-8434-1f3cddea67f5",
                                "text": "Scarron composa une épître burlesque à Guillemette, chienne de sa sœur, puis il proposa en erratum de lire : sa chienne de sœur."
                            }
                        ]
                    }
