                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man sat resting on the oaken <w>settle</w> by the fireplace.",
                            "target_lang_translations": {
                                "ru": "Старик сидел, отдыхая на дубовой <w>скамье</w> у камина.",
                                "zh": "老人坐在壁炉旁的橡木<w>高背长椅</w>上休息。"
                            }
                        },
                        {
                            "text": "They stored their winter blankets inside the wooden <w>settle</w> in the hallway.",
                            "target_lang_translations": {
                                "ru": "Они хранили зимние одеяла внутри деревянной <w>скамьи-ларя</w> в прихожей.",
                                "zh": "他们把冬天的毯子收在门厅那张木制<w>储物长椅</w>里。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная деревянная скамья с высокой спинкой и подлокотниками, часто с ящиком для хранения под сиденьем.",
                        "zh": "一种长木椅，有高靠背和扶手，座位下常带储物箱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скамья-ларь",
                                "target_lang_sense_clarification": "мебель"
                            },
                            {
                                "target_lang_word": "скамья",
                                "target_lang_sense_clarification": "деревянная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高背长椅",
                                "target_lang_sense_clarification": "带高靠背和扶手的木制长椅"
                            },
                            {
                                "target_lang_word": "储物长椅",
                                "target_lang_sense_clarification": "座位下带储物空间的长椅"
                            }
                        ]
                    }
                }
            ]
        },
        {
