                        "examples": [
                            {
                                "example_id": "6d9eeb86-2f02-41d1-a0a8-8e12ea310b3e",
                                "sense_id": "d3f8b29a-e8c5-3c92-be3f-4f82dd53d971",
                                "text": "Il appelle pédolyse le délavage du sol effectué par la pluie."
                            },
                            {
                                "example_id": "d2d7675e-54b2-4c5b-aa39-5673f8808db8",
                                "sense_id": "d3f8b29a-e8c5-3c92-be3f-4f82dd53d971",
                                "text": "Le processus de pédolyse détermine l'exportation d'une grande partie des matières solubles du sol, tandis que les composés colloïdaux à l'état d’hydrosol et d’hydrogel restent en quantité supérieure dans le liquide …."
                            },
                            {
                                "example_id": "7b6bc8dc-ee8c-4c95-af34-f465baaecf94",
                                "sense_id": "d3f8b29a-e8c5-3c92-be3f-4f82dd53d971",
                                "text": "Les conflits modernes se distinguent par un phénomène de pédolyse particulièrement marqué, résultant d'une altération de la structure tellurique qui accroît considérablement la susceptibilité des terrains aux effets délétères des précipitations atmosphériques."
                            }
                        ]
                    }
