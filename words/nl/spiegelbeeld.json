{
    "word_family": [
        "spiegel",
        "spiegelen",
        "beeld",
        "beelden",
        "spiegeling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4cbc7488-4498-3d7d-8779-cd9676debf75",
                    "sense_definition": "het beeld van iets of iemand dat door een spiegelend oppervlak wordt teruggekaatst",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reflectie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij keek langdurig naar haar eigen <w>spiegelbeeld</w> in het gladde water van de vijver.",
                            "target_lang_translations": {
                                "en": "She looked for a long time at her own <w>reflection</w> in the smooth water of the pond."
                            }
                        },
                        {
                            "text": "Het kind probeerde zijn eigen <w>spiegelbeeld</w> aan te raken op het glas van de ruit.",
                            "target_lang_translations": {
                                "en": "The child tried to touch his own <w>mirror image</w> on the glass of the windowpane."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflectie",
                        "wederbeeld"
                    ],
                    "common_phrases": [
                        "eigen spiegelbeeld",
                        "kijken naar het spiegelbeeld"
                    ],
                    "target_lang_definitions": {
                        "en": "the image of something or someone reflected by a mirroring surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reflection",
                                "target_lang_sense_clarification": "image in a mirror or water"
                            },
                            {
                                "target_lang_word": "mirror image",
                                "target_lang_sense_clarification": "the visual reflection"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fbfd72c-9c28-3f43-a8b7-4eaeff299bbd",
                    "sense_definition": "een afbeelding of vorm die precies omgekeerd is ten opzichte van het origineel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "omkering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee gebouwen aan de gracht zijn elkaars <w>spiegelbeeld</w> qua architectuur.",
                            "target_lang_translations": {
                                "en": "The two buildings on the canal are each other's <w>mirror image</w> in terms of architecture."
                            }
                        },
                        {
                            "text": "In de wiskunde kun je een figuur tekenen die het exacte <w>spiegelbeeld</w> van de eerste is.",
                            "target_lang_translations": {
                                "en": "In mathematics, you can draw a figure that is the exact <w>mirror image</w> of the first one."
                            }
                        }
                    ],
                    "common_phrases": [
                        "elkaars spiegelbeeld",
                        "exact spiegelbeeld"
                    ],
                    "target_lang_definitions": {
                        "en": "an image or shape that is exactly reversed relative to the original"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mirror image",
                                "target_lang_sense_clarification": "symmetrical reversal"
                            },
                            {
                                "target_lang_word": "specular image",
                                "target_lang_sense_clarification": "technical or mathematical term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86ce0761-d662-3f23-b242-a8fea5552a9b",
                    "sense_definition": "iets dat in eigenschappen of karakter het tegenovergestelde is van het origineel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tegenstelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Antimaterie is in veel opzichten het <w>spiegelbeeld</w> van gewone materie met een tegengestelde lading.",
                            "target_lang_translations": {
                                "en": "Antimatter is in many respects the <w>mirror image</w> of ordinary matter with an opposite charge."
                            }
                        },
                        {
                            "text": "Zijn nieuwe beleid is het politieke <w>spiegelbeeld</w> van wat zijn voorganger altijd deed.",
                            "target_lang_translations": {
                                "en": "His new policy is the political <w>mirror image</w> of what his predecessor always did."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het spiegelbeeld zijn van"
                    ],
                    "target_lang_definitions": {
                        "en": "something that is the opposite of the original in properties or character"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mirror image",
                                "target_lang_sense_clarification": "opposite counterpart"
                            },
                            {
                                "target_lang_word": "antithesis",
                                "target_lang_sense_clarification": "direct opposite"
                            },
                            {
                                "target_lang_word": "counterpart",
                                "target_lang_sense_clarification": "corresponding but opposite version"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}