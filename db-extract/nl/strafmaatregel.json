                        "source_entry_id": "9374cfb6-fbab-3541-855b-29d3383c5a60",
                        "source_sense_id": "b8d63094-1bee-3355-bf7b-6d13138426ac",
                        "target_lang_word": "Sanktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sanktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fac5cd43-ae40-3f21-a59c-a9b881b25939",
                                        "entry_id": "19bcef1d-a949-3051-a05b-2b8d45ca3471",
                                        "glosses": [
                                            "Bestätigung, Rechtfertigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b984e9-e389-4f2d-b158-b4fb63ff30d7",
                                                "sense_id": "fac5cd43-ae40-3f21-a59c-a9b881b25939",
                                                "text": "Die Sanktion der Beschlüsse ist Voraussetzung dafür, dass sie in Kraft treten können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66ae144b-31ed-3cd0-8e41-8a7a52db85d8",
                                        "entry_id": "19bcef1d-a949-3051-a05b-2b8d45ca3471",
                                        "glosses": [
                                            "missbilligende Reaktion auf nicht geduldetes Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826ce52d-6349-44ed-adde-ed808028161c",
                                                "sense_id": "66ae144b-31ed-3cd0-8e41-8a7a52db85d8",
                                                "text": "Die Sanktion für sein unflätiges Verhalten folgte auf dem Fuße."
                                            },
                                            {
                                                "example_id": "31b91dc4-a1c4-4165-985e-c67e08b88635",
                                                "sense_id": "66ae144b-31ed-3cd0-8e41-8a7a52db85d8",
                                                "text": "„Am selben Tag verhängte der noch amtierende Präsident Barack Obama neue Sanktionen gegen Russland.“"
                                            },
                                            {
                                                "example_id": "cac3de4e-9f48-4508-beac-d61b7b90ec51",
                                                "sense_id": "66ae144b-31ed-3cd0-8e41-8a7a52db85d8",
                                                "text": "[Russischer Angriffskrieg auf die Ukraine:] „Obwohl der Westen die russische Rüstungsindustrie mit schweren Sanktionen belegt hat, laufen die Maschinen auf Hochtouren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "acfe17e6-30d7-33fc-8b81-8d1315f9925a",
                                        "entry_id": "19bcef1d-a949-3051-a05b-2b8d45ca3471",
                                        "glosses": [
                                            "Bestrafung für Vergehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f48b08a6-5455-4d22-aadc-45c5ae6c335a",
                                                "sense_id": "acfe17e6-30d7-33fc-8b81-8d1315f9925a",
                                                "text": "Für diese Vergehen gelten schwerwiegende Sanktionen."
                                            },
                                            {
                                                "example_id": "b0efdc87-3526-4f22-866f-dbf68c46f6ec",
                                                "sense_id": "acfe17e6-30d7-33fc-8b81-8d1315f9925a",
                                                "text": "„Die Gemeinsame Geschäftsordnung der Bundesministerien sieht zwar vor, dass Gesetzentwürfe »grundsätzlich« dem Redaktionsstab Rechtssprache zur Prüfung vorzulegen sind, doch Sanktionen für die Nichtbeachtung dieser Vorschrift gibt es nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d2e5c2-2af9-44d0-ab4f-bacea2a5d2c5",
                        "source_entry_id": "9374cfb6-fbab-3541-855b-29d3383c5a60",
                        "source_sense_id": "b8d63094-1bee-3355-bf7b-6d13138426ac",
                        "target_lang_word": "sanction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b88a440d-f01c-3832-8080-4d99d1526f38",
                                        "entry_id": "0dde6a72-b9de-3aea-859d-aaa6e6e9b86d",
                                        "glosses": [
                                            "An approval, by an authority, generally one that makes something valid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "169b60e2-9103-483f-ad67-8e03072c86f7",
                                                "sense_id": "b88a440d-f01c-3832-8080-4d99d1526f38",
                                                "text": "The whalers had been operating in the contested waters off the island with sanction from the Japanese government."
                                            },
                                            {
                                                "example_id": "156f7369-8f7c-4424-8b6d-9c9d19db63d1",
                                                "sense_id": "b88a440d-f01c-3832-8080-4d99d1526f38",
                                                "text": "The idea that it was more comfortable in the house than out of it, did much towards reconciling his lordship. He felt positively glad that, as his wife had acted without his sanction, she should be subject to all possible inconvenience, as if such could be felt in Henrietta's state of mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c9d8553-bd54-32f3-8967-e6af067a861d",
                                        "entry_id": "0dde6a72-b9de-3aea-859d-aaa6e6e9b86d",
                                        "glosses": [
                                            "A penalty, punishment, or some coercive measure, intended to ensure compliance; especially one adopted by several nations, or by an international body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d49f0c1c-bb07-4896-a1fc-aeb7bee616b2",
                                                "sense_id": "5c9d8553-bd54-32f3-8967-e6af067a861d",
                                                "text": "The United States enacted a new round of sanctions against the apartheid regime of South Africa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79384b9-12e4-338a-a4fb-9b2eaddb9bae",
                                        "entry_id": "0dde6a72-b9de-3aea-859d-aaa6e6e9b86d",
                                        "glosses": [
                                            "A law, treaty, or contract, or a clause within a law, treaty, or contract, specifying any of the above."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sanction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d863476a-456b-33e4-abe3-0f4f666714f5",
                                        "entry_id": "ccb8751f-f518-3403-8413-a3343d6c09b4",
                                        "glosses": [
                                            "To ratify; to make valid."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adcbf2ca-f5f6-316c-88c6-94c2c52d4f6f",
                                        "entry_id": "ccb8751f-f518-3403-8413-a3343d6c09b4",
                                        "glosses": [
                                            "To give official authorization or approval to; to countenance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b50b34-b5ad-4526-a2d5-c7d00470d4a2",
                                                "sense_id": "adcbf2ca-f5f6-316c-88c6-94c2c52d4f6f",
                                                "text": "The school's inaction further sanctions this misbehavior."
                                            },
                                            {
                                                "example_id": "f4f846c0-9e88-4842-be10-38b57e102dd5",
                                                "sense_id": "adcbf2ca-f5f6-316c-88c6-94c2c52d4f6f",
                                                "text": "Many of the most earnest Protestants were business men, to whom lending money at interest was essential. Consequently first Calvin, and then other Protestant divines, sanctioned interest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c63877f-4120-3ee0-98ee-5a97077033c1",
                                        "entry_id": "ccb8751f-f518-3403-8413-a3343d6c09b4",
                                        "glosses": [
                                            "To penalize (a state etc.) with sanctions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe21eb14-c882-470e-ba18-370370974f5e",
                                                "sense_id": "7c63877f-4120-3ee0-98ee-5a97077033c1",
                                                "text": "The generative AI chatbot, ChatGPT, can be duped into providing detailed advice on how to commit crimes — ranging from money laundering to the export of weapons to sanctioned countries — a tech startup found."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
