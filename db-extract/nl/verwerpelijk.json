                "senses": [
                    {
                        "sense_id": "0f566ea1-b029-3aef-99dc-94542b62af27",
                        "entry_id": "b27aeeab-f0eb-3c0e-a9b1-24bd1853a7b6",
                        "glosses": [
                            "wat verworpen moet worden (uit moreel oogpunt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947fd1e3-7e8f-42bb-8211-6d2e8792e1a7",
                                "sense_id": "0f566ea1-b029-3aef-99dc-94542b62af27",
                                "text": "De zaak-Van Rey is ingewikkelder dan die rond de in 2013 tot drie jaar cel veroordeelde VVD’er Ton Hooijmaijers. De gedeputeerde van Noord-Holland cashte met valse facturen via bv’tjes smeergeld. Dat is betrekkelijk duidelijke corruptie. Bij Van Rey is het diffuser. Bij hem gaat het om een handelwijze die bestuurlijk-ethisch verwerpelijk mag zijn, maar heeft hij ook iets strafbaars gedaan?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fd28b22-ed69-4559-bc34-4c3bedae521f",
                        "source_entry_id": "b27aeeab-f0eb-3c0e-a9b1-24bd1853a7b6",
                        "source_sense_id": "0f566ea1-b029-3aef-99dc-94542b62af27",
                        "target_lang_word": "blameworthy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blameworthy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86715cd2-6b2a-3bcf-87ae-2ed056ca42f5",
                                        "entry_id": "965850a5-db04-356a-af0c-14109ac0b8ad",
                                        "glosses": [
                                            "Deserving blame or censure; reprehensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9feecd-41c9-4bf0-9937-2edd501c3e3f",
                                                "sense_id": "86715cd2-6b2a-3bcf-87ae-2ed056ca42f5",
                                                "text": "Yes, my life has been blameworthy; I confess it. But you know nothing of its temptations."
                                            },
                                            {
                                                "example_id": "3baf3ef2-ede8-4bc5-bfb0-c659db1d55d2",
                                                "sense_id": "86715cd2-6b2a-3bcf-87ae-2ed056ca42f5",
                                                "text": "And there are ſome diſpoſitions blame-vvorthy in men, vvhich are yet, in a right ſenſe, holily aſcribed unto God; as unchangeableneſs, and irrepentance: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e12ab5dd-1253-4d9c-a498-9d99c73bd4bd",
                        "source_entry_id": "b27aeeab-f0eb-3c0e-a9b1-24bd1853a7b6",
                        "source_sense_id": "0f566ea1-b029-3aef-99dc-94542b62af27",
                        "target_lang_word": "censurable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "censurable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db028be1-a033-3e3e-bc2d-ba667731ca21",
                                        "entry_id": "41b4718b-564c-3696-bd44-e65faf3ce67c",
                                        "glosses": [
                                            "Deserving of censure; blameworthy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78091905-2a2c-4dba-8aae-0441789c71bf",
                                                "sense_id": "db028be1-a033-3e3e-bc2d-ba667731ca21",
                                                "text": "... and well considered, me thinks this is one of the most censurable parts of this licentiousnesse, in regard it laboureth to taint the whole body of conversation, as it corrupteth the nature of words, which are the Publique Faith, whereupon all innocent discourse must needs trust it selfe, so that this perversion seemeth a publick impediment to the commerce of all vertuous communication ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b744f64e-5f98-4de2-b43f-cafdf797171f",
                        "source_entry_id": "b27aeeab-f0eb-3c0e-a9b1-24bd1853a7b6",
                        "source_sense_id": "0f566ea1-b029-3aef-99dc-94542b62af27",
                        "target_lang_word": "condemnable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condemnable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3220f137-24b1-3b38-93e3-21eda7007a83",
                                        "entry_id": "8e1df932-87fa-365a-b7d9-04706b3e13ae",
                                        "glosses": [
                                            "Deserving of condemnation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50908677-a522-4c5e-a8e8-4c3a30ab7e02",
                                                "sense_id": "3220f137-24b1-3b38-93e3-21eda7007a83",
                                                "text": "It is not the fault of any creed, but of the complicated nature of human affairs, […] that hardly any kind of action can safely be laid down as either always obligatory or always condemnable."
                                            },
                                            {
                                                "example_id": "d15928da-3625-413b-9a16-10aec5f2b2b1",
                                                "sense_id": "3220f137-24b1-3b38-93e3-21eda7007a83",
                                                "text": "He’s got the one issue that’s utterly condemnable, but he was really quite open."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f63b491f-01bc-47a2-8ba2-b41ffac463ee",
                        "source_entry_id": "b27aeeab-f0eb-3c0e-a9b1-24bd1853a7b6",
                        "source_sense_id": "0f566ea1-b029-3aef-99dc-94542b62af27",
                        "target_lang_word": "objectionable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objectionable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da635994-4467-37ec-b681-1d3d72cf6a28",
                                        "entry_id": "ab0596f3-931e-3e18-9089-8e3297c0de49",
                                        "glosses": [
                                            "Arousing disapproval; worthy of objection; offensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc19455b-edc4-499e-bf9d-f89af435a5a9",
                                                "sense_id": "da635994-4467-37ec-b681-1d3d72cf6a28",
                                                "text": "Before removing objectionable material, you'll have to decide what will offend people."
                                            },
                                            {
                                                "example_id": "93a35596-172b-4a80-932c-bf3e1d094770",
                                                "sense_id": "da635994-4467-37ec-b681-1d3d72cf6a28",
                                                "text": "The L.C.C. [London County Council] considers viaducts in London objectionable and a hindrance to town planning and would like to abolish all the Southern Railway lines on viaducts in South London. [Nothing much happened, they still exist.]"
                                            },
                                            {
                                                "example_id": "ad7eb032-22d3-469c-8bc1-23f3f28dbbdb",
                                                "sense_id": "da635994-4467-37ec-b681-1d3d72cf6a28",
                                                "text": "We don’t find every use of ALPRs objectionable. For example, we do not generally object to using them to check license plates against lists of stolen cars, for AMBER Alerts, or for toll collection, provided they are deployed and used fairly and subject to proper checks and balances, such as ensuring devices are not disproportionately deployed in low-income communities and communities of color, and that the “hot lists” they are run against are legitimate and up to date."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
