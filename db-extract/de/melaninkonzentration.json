                ],
                "senses": [
                    {
                        "sense_id": "69a8983f-dd39-3cb4-8a53-976962c6ee1f",
                        "entry_id": "ec1c9f2c-8476-3df2-924d-a3d61c47f4bb",
                        "glosses": [
                            "Gehalt (Konzentration) des Pigments Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7624da76-73bd-469c-bcd4-fda41210a1ff",
                                "sense_id": "69a8983f-dd39-3cb4-8a53-976962c6ee1f",
                                "text": "„Diese Brunstschwielen sind aufgrund höherer Melaninkonzentration dunkler als das sie umgebende Gewebe und daher gut zu erkennen.“"
                            },
                            {
                                "example_id": "e1d7d39e-83a2-4947-82e0-9364fcd6d113",
                                "sense_id": "69a8983f-dd39-3cb4-8a53-976962c6ee1f",
                                "text": "„Eine verminderte NIA-Intensität entspricht einer reduzierten Lebens sinkt die Melaninkonzentration langsam.“"
                            },
                            {
                                "example_id": "acf755a1-ea54-4e3c-996f-867f3f51b691",
                                "sense_id": "69a8983f-dd39-3cb4-8a53-976962c6ee1f",
                                "text": "„Dadurch sahen nicht nur meine Haut und mein Teint besser aus, das Alpha-MSH erhöht auch die Melaninkonzentration in Augen und Hirn.“"
                            },
                            {
                                "example_id": "7f4b2d6e-f3a4-465a-abfb-285b63d91236",
                                "sense_id": "69a8983f-dd39-3cb4-8a53-976962c6ee1f",
                                "text": "„Der Schutzefekt dunkler Haut vor UV-Strahlung resultiert offenbar aus sehr hoher Melaninkonzentration und dessen Anordnung in dicht gepackten Organellen, die geeignet sind, empfindliche Strukturen wie den Zellkern abzuschatten.“"
                            },
                            {
                                "example_id": "9a09097c-28a1-4b56-b187-2419b8c089c0",
                                "sense_id": "69a8983f-dd39-3cb4-8a53-976962c6ee1f",
                                "text": "„Optisch betrachtet bewirkt die Melaninkonzentration mit den dazwischenliegenden farbarmen Bereichen das Gleiche wie eine gleichmäßige Verteilung einer geringeren Anzahl normaler Melaninkörnchen nämlich eine Melaninaufhellung.“"
                            },
                            {
                                "example_id": "0c6af9b2-96f3-428c-81b4-b6d5277df89c",
                                "sense_id": "69a8983f-dd39-3cb4-8a53-976962c6ee1f",
                                "text": "„Das OCA2-Protein stimuliert die vollständige Ausreifung der Melanosomen, was zu einer hohen Melaninkonzentration in den Melanocyten der Iris und damit zu einer dunklen Augenfarbe führt.“"
                            },
                            {
                                "example_id": "74607f1f-13a0-4ca5-b5c5-2910c0118b85",
                                "sense_id": "69a8983f-dd39-3cb4-8a53-976962c6ee1f",
                                "text": "„Histologisch findet man eine erhöhte Melaninkonzentration in den basalen Epithelschichten, nicht jedoch eine erhöhte Konzentration von Melanozyten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
