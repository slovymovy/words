                "senses": [
                    {
                        "sense_id": "34fb2004-e127-3c6b-aedd-637a726c1c5e",
                        "entry_id": "a6a977a1-0183-3fec-bce7-5b8f10842f1a",
                        "glosses": [
                            "Without provocation or motivation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9cbd8ff-b64c-45ed-b4f6-5e59f3e22002",
                                "sense_id": "34fb2004-e127-3c6b-aedd-637a726c1c5e",
                                "text": "He attacked me, suddenly, unprovoked."
                            },
                            {
                                "example_id": "7e438961-13f4-498d-bed5-5a634a4939b2",
                                "sense_id": "34fb2004-e127-3c6b-aedd-637a726c1c5e",
                                "text": "'He said, \"I won't bugger you\"? Really?' 'Yes, really.' 'God. That is a bit suspicious; coming out unprovoked.'"
                            },
                            {
                                "example_id": "6b173416-f9c8-4e15-8f5d-c85315f3c7a9",
                                "sense_id": "34fb2004-e127-3c6b-aedd-637a726c1c5e",
                                "text": "The supernatural are so destructive that they have to create conditions to enable the continuous infliction of mental and physical injuries on others unprovoked."
                            },
                            {
                                "example_id": "ada8ead3-eff0-4247-8953-526c6c18dd47",
                                "sense_id": "34fb2004-e127-3c6b-aedd-637a726c1c5e",
                                "text": "So when one of our own flouts our laws to attack my house unprovoked—”"
                            }
                        ]
                    }
