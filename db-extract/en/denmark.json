                    {
                        "translation_id": "74087dc6-13a3-4b90-8b27-ba99e2420f20",
                        "source_entry_id": "7248bf16-50c8-3493-b287-8827a81c18b9",
                        "source_sense_description": "country in Northern Europe",
                        "target_lang_word": "Denemarken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Denemarken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                                        "entry_id": "c49f21ab-1660-32a6-9037-66f0e313356c",
                                        "glosses": [
                                            "een Scandinavisch land in Noord-Europa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e59fe041-0111-4dec-ae9e-9c7f137a102d",
                                                "sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                                                "text": "Hij heeft vier jaar in Denemarken gewoond en spreekt dus goed Deens."
                                            },
                                            {
                                                "example_id": "e355f2f7-2079-4e29-9e69-12a3f23ed8f2",
                                                "sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                                                "text": "Kopenhagen is de hoofdstad van Denemarken."
                                            },
                                            {
                                                "example_id": "bfc25130-8225-47c2-9339-cee4abed7629",
                                                "sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                                                "text": "Denemarken ook nauwelijks, in de pers hadden ze het uitgebreid gehad over de gemoedelijke verhouding tussen de Deense bevolking en de Duitse gasten. De koning en de regering van Denemarken zaten nog op hun plaats en de samenwerking leek uitstekend te functioneren binnen de Germaanse verbroedering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5358ef12-12a4-4481-9a93-e77eb3882f26",
                        "source_entry_id": "7248bf16-50c8-3493-b287-8827a81c18b9",
                        "source_sense_description": "country in Northern Europe",
                        "target_lang_word": "Danemark",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Danemark",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30fcbc07-bac3-3805-990e-a5ae209151ba",
                                        "entry_id": "aa7d53b4-2f80-3d0e-819f-37eb37b9fa01",
                                        "glosses": [
                                            "Pays de la Scandinavie, qui comprend la péninsule de Jutland ; bordé au sud par l’Allemagne, à l'est par la mer Baltique et le Cattégat qui le sépare de la Suède, au nord-est par le Skagerrak et à l’ouest par la mer du Nord. Sa capitale est Copenhague."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd788ab-6cfe-49fc-b66d-d90ceb565fe6",
                                                "sense_id": "30fcbc07-bac3-3805-990e-a5ae209151ba",
                                                "text": "L’Islande a son parti de Home Rulers qui veulent affranchir leur pays de la tutelle du Danemark et rétablir l’ancienne république islandaise."
                                            },
                                            {
                                                "example_id": "83877445-5fb7-4cfd-9946-54e51f934084",
                                                "sense_id": "30fcbc07-bac3-3805-990e-a5ae209151ba",
                                                "text": "Le Groenland, qui a la chance d’appartenir au Danemark, est, après l’Australie, la plus grande île du monde ; son étendue correspond approximativement au quart de celle de l’Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b885a49c-c6b3-4508-be1d-8e697d137779",
                        "source_entry_id": "7248bf16-50c8-3493-b287-8827a81c18b9",
                        "source_sense_description": "country in Northern Europe",
                        "target_lang_word": "Dänemark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dänemark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                        "entry_id": "b56008b7-2813-37b2-b686-790ec8034948",
                                        "glosses": [
                                            "Staat mit 5,7 Mio. Einwohnern; einschließlich Grönland und Färöer das Königreich Dänemark, nur das dänische Kernland in Nordeuropa"
                                        ],
                                        "tags": [
                                            "aber auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad7fb526-55d7-4b19-9a01-6f93a1360d34",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "Der höchste Punkt Dänemarks erreicht gerade 173 Meter."
                                            },
                                            {
                                                "example_id": "a69596a8-1898-44ee-9022-bd84f54245fd",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "Kopenhagen ist die Hauptstadt von Dänemark."
                                            },
                                            {
                                                "example_id": "cca3b165-b9d7-4f94-8df2-41628c1dc4ab",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "„Das Dänemark des 9. Jahrhunderts ist geprägt von den Wikingern, die einen Eroberungsfeldzug in Richtung England unternehmen.“"
                                            },
                                            {
                                                "example_id": "bdf84429-441d-4046-a08a-5d55ee56ea2d",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "„Wer aktuell nach Dänemark ein- oder ausreisen möchte, muss gelegentlich mit Wartezeiten an den Grenzübergängen rechnen.“"
                                            },
                                            {
                                                "example_id": "703801a2-3620-4e47-8c9a-20bf6afdef39",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "„Hier wird Dänemark zum erstenmal als Land genannt. TANMARKAR lautet das Runenwort.“"
                                            },
                                            {
                                                "example_id": "69977dde-0e3c-406a-8912-40a979c61692",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "„Island und Grönland haben eines gemeinsam: Beide waren Kolonien Dänemarks.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
