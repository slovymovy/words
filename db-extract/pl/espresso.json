                                "target_senses": [
                                    {
                                        "sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                                        "entry_id": "3aade14e-99d9-37a8-8c94-4528f1ffc4fe",
                                        "glosses": [
                                            "Café très corsé avec un fort arôme, obtenu en faisant passer rapidement de l’eau bouillante sous pression à travers du café finement moulu et torréfié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c59d8abb-5162-4740-b468-9cf41fa84cd7",
                                                "sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                                                "text": "Il avait épuisé ses fiches bristol, écarté deux ou trois hypothèses de travail, avait avalé cinq expresso et raté le dernier service de la cantine."
                                            },
                                            {
                                                "example_id": "452490b8-70c0-4840-9442-7cbcbd877d55",
                                                "sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                                                "text": "Je trouve une place à la terrasse qui donne sur la salle des pas perdus. Je commande un double-expresso, un croissant et un pain au chocolat."
                                            },
                                            {
                                                "example_id": "17db4cc9-280a-4fa8-b4ab-adc007cfe00b",
                                                "sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                                                "text": "Plutôt slow coffee qu’expresso ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da197f4d-9342-4e9b-a266-66b68550e15f",
                        "source_entry_id": "3fea4acb-22e1-354c-bd84-41be23e73655",
                        "source_sense_id": "a97ac225-fadb-3573-adbd-815ae7cbb8c8",
