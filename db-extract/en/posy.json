                                    {
                                        "sense_id": "d46f04e8-7a17-3a21-8f50-37f364e948be",
                                        "entry_id": "c5a5be1a-6fc8-394f-9b5a-86b97e4a282c",
                                        "glosses": [
                                            "een boeket"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d149daf1-6b46-494c-8c94-741e25148bc7",
                                                "sense_id": "d46f04e8-7a17-3a21-8f50-37f364e948be",
                                                "text": "Hij nam een paar ruikers mee voor de hele familie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "633b39ef-49da-3f88-a240-ce663024697c",
                                        "entry_id": "c5a5be1a-6fc8-394f-9b5a-86b97e4a282c",
