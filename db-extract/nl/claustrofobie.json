                        "entry_id": "56733bb3-1a95-34c0-849a-5bdecec03b30",
                        "glosses": [
                            "vrees voor afgesloten ruimten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e81d31-58e4-4469-bffa-c1f87cf9d6da",
                                "sense_id": "413b509b-c2e8-3db4-99f6-307c59f67ab1",
                                "text": "Liften zijn een te vermijden plek voor mensen die aan claustrofobie lijden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8f4b9b0-41c4-47dd-8158-bc11a8472c7c",
                        "source_entry_id": "56733bb3-1a95-34c0-849a-5bdecec03b30",
                        "source_sense_id": "413b509b-c2e8-3db4-99f6-307c59f67ab1",
                        "source_sense_description": "vrees voor afgesloten ruimten",
                        "target_lang_word": "Klaustrophobie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klaustrophobie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c7fd9bc-802b-3de2-b27a-ee2c87a0b28f",
                                        "entry_id": "d1af35ca-bc4f-3f14-bb2d-299b869624ba",
                                        "glosses": [
                                            "krankhafte Angst vor engen Räumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb3ec00-a63d-460a-b64d-890bbfafd661",
                                                "sense_id": "2c7fd9bc-802b-3de2-b27a-ee2c87a0b28f",
                                                "text": "Klaustrophobie kann sich darin äußern, dass jemand es nicht erträgt, in Fahrstühlen mitzufahren."
                                            },
                                            {
                                                "example_id": "af911002-53af-4d5e-b951-25fb6a119523",
                                                "sense_id": "2c7fd9bc-802b-3de2-b27a-ee2c87a0b28f",
                                                "text": "„Hedda litt allerdings unter einer unerträglich starken Klaustrophobie und wollte deshalb keinesfalls in den engen Bunker gehen.“"
                                            },
                                            {
                                                "example_id": "c759469c-8c79-43e2-b7b3-71aff63cf4f0",
                                                "sense_id": "2c7fd9bc-802b-3de2-b27a-ee2c87a0b28f",
                                                "text": "„Ich halte es für notwendig, ihm das mit der Klaustrophobie näher zu erklären.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ca18557-a3b5-4823-a5fe-07f054f040dc",
                        "source_entry_id": "56733bb3-1a95-34c0-849a-5bdecec03b30",
                        "source_sense_id": "413b509b-c2e8-3db4-99f6-307c59f67ab1",
                        "source_sense_description": "vrees voor afgesloten ruimten",
                        "target_lang_word": "Raumangst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raumangst",
