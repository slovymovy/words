                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d34e611d-7309-4aaf-807c-67238a551dfc",
                        "source_entry_id": "bac3d91c-d405-3b0f-9d44-7e7fd1f43a11",
                        "source_sense_id": "6bd41583-9114-3c6c-b0ee-27cdd37caa9b",
                        "target_lang_word": "flu-like",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flu-like",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56b7143a-7368-38a9-89b9-2591910bca84",
                                        "entry_id": "3b3dae3d-e428-3468-b4af-921562b8dd20",
                                        "glosses": [
                                            "Alternative form of flulike."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a9d359-2844-4b35-9001-8a129ad42abc",
                                                "sense_id": "56b7143a-7368-38a9-89b9-2591910bca84",
                                                "text": "However, caffeine withdrawal can bring on symptoms like headache, fatigue or drowsiness, difficulty concentrating, depressed mood or irritability, and even flu-like symptoms such as nausea or muscle pain!"
                                            },
                                            {
                                                "example_id": "a393bcb6-d018-4810-a011-f2f4a6340807",
                                                "sense_id": "56b7143a-7368-38a9-89b9-2591910bca84",
                                                "text": "He had presented in the Cromwell Hospital, London with flu-like symptoms and initially received treatment for related renal bleeding."
                                            },
                                            {
                                                "example_id": "6110bc63-dda9-45d3-9a91-783c7e6728e8",
                                                "sense_id": "56b7143a-7368-38a9-89b9-2591910bca84",
                                                "text": "The most common adverse effects include injection-site redness and swelling, menstrual irregularities, flu-like symptoms (eg, fever, chills, and myalgias), and rarely injection-site necrosis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a2379d3-005e-448a-9357-05c78056ac63",
                        "source_entry_id": "bac3d91c-d405-3b0f-9d44-7e7fd1f43a11",
