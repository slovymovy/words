                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30a5eee7-1182-4a7e-bb0e-6ee3fc9f00d3",
                                "sense_id": "f2ea3c63-7d4d-3351-949a-5f24493ee118",
                                "text": "Deux départements limitrophes, victimes eux aussi de l'hyponatalité, accusent seuls une densité beaucoup plus faible."
                            }
                        ]
                    },
                    {
                        "sense_id": "8417baff-5146-3bf9-b63e-aebd211b4a3f",
