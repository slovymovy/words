        "nl-extract.jsonl": [
            {
                "entry_id": "c2e03032-cc3f-3073-a0f9-08ddaf502b3b",
                "word": "excelleren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d920505-72c2-324c-9627-7fdede02f40e",
                        "entry_id": "c2e03032-cc3f-3073-a0f9-08ddaf502b3b",
                        "glosses": [
                            "heel erg goed in iets zijn / heel veel beter zijn dan anderen / overal bovenuit steken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4422e24d-de8e-4bc4-ac0b-55d6387f3c83",
                                "sense_id": "1d920505-72c2-324c-9627-7fdede02f40e",
                                "text": "Vrouwen hebben gewoon meer interesse in familieachtige dingen, zei Thierry Baudet, fractievoorzitter van Forum voor Democratie, tegen het blad Quote. Daarom zouden ze minder excelleren. Ik vraag mij af waar Baudet zijn standpunt vandaan haalt. Werp een blik op een willekeurige school en je zal zien dat er het hardst wordt gewerkt door de meisjes."
                            },
                            {
                                "example_id": "a3ed31d1-29a3-4f74-9487-4b825ecd1aff",
                                "sense_id": "1d920505-72c2-324c-9627-7fdede02f40e",
                                "text": "Ook zo genoten van de Limburgspecial in het Volkskrant Magazine van afgelopen weekend? Met name Cécile Narinx ('ik wil wel weer terug naar Maastricht'), Willem Vissers ('kijk al die bekende Limburgers toch eens excelleren') en Marcel Maassen ('mijn zuurvlees smaakt het best') waren lekker op dreef, in fijne stukken die nu eens niet doordrenkt waren van de zelfhaat waarmee wij Limburgers onszelf meestal manifesteren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a6100ad-656d-43bd-b390-2fa00e450597",
                        "source_entry_id": "c2e03032-cc3f-3073-a0f9-08ddaf502b3b",
                        "source_sense_id": "1d920505-72c2-324c-9627-7fdede02f40e",
                        "source_sense_description": "heel erg goed in iets zijn / heel veel beter zijn dan anderen / overal bovenuit steken",
                        "target_lang_word": "outshine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outshine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c686002-2c3c-35ee-96b3-cb2b7c8ef75d",
                                        "entry_id": "2d528a8f-eaa9-377b-bd3a-da0654e6ec39",
                                        "glosses": [
                                            "To shine brighter than something else"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cdc5166-3721-3599-8230-2fec5b20de6b",
                                        "entry_id": "2d528a8f-eaa9-377b-bd3a-da0654e6ec39",
                                        "glosses": [
                                            "To exceed something or someone else, especially in an obvious or flamboyant manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aebc7ba-12df-4d29-b46b-6b9d3cd7e1e1",
                                                "sense_id": "7cdc5166-3721-3599-8230-2fec5b20de6b",
                                                "text": "Four minutes later Walcott, who until then had been redundant as a lone striker owing to one-star service, was given his first decent pass of the game and duly took his chance to outshine the Senegalese, springing a poorly conceived offside trap to collect Lukas Podolski's ball and stroke a low 15-yard shot past Tim Krul and into the far corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c7261d-1ffa-3fc2-ae27-70f13fb5785a",
                                        "entry_id": "2d528a8f-eaa9-377b-bd3a-da0654e6ec39",
                                        "glosses": [
                                            "To shine forth, to give out light."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2feecc-afa2-4ada-8125-cc148b16ccdc",
                                                "sense_id": "47c7261d-1ffa-3fc2-ae27-70f13fb5785a",
                                                "text": "Bright, outshining beams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
