                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aca3c310-d95c-31bb-882d-366e8d506e51",
                                        "entry_id": "1d9f62b5-8b6b-3626-8aba-bbb0b0a5d39f",
                                        "glosses": [
                                            "Form der Arbeit, bei der Arbeitnehmer ihre Arbeitsaufgaben durch Telekommunikation ausüben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe5494a8-eb35-46e4-8057-79cb93abd808",
                                                "sense_id": "aca3c310-d95c-31bb-882d-366e8d506e51",
                                                "text": "Seine Telearbeit macht ihm Spaß."
                                            },
                                            {
                                                "example_id": "262f4dc4-48ea-405f-9a9b-14c3a5539ccc",
                                                "sense_id": "aca3c310-d95c-31bb-882d-366e8d506e51",
                                                "text": "Ich hab noch genug Telearbeit vor mir."
                                            },
                                            {
                                                "example_id": "18025e86-7b11-49be-bf97-72bc8c47b267",
                                                "sense_id": "aca3c310-d95c-31bb-882d-366e8d506e51",
                                                "text": "Der Personalrat hat eine Dienstvereinbarung über Telearbeit geschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3558a15c-bb5c-4a6a-834c-51630bf82a44",
                        "source_entry_id": "ff0feaa3-af49-308a-accc-c16c0968b435",
                        "source_sense_id": "e5369a96-3a7a-3500-bb55-c3b880612341",
                        "source_sense_description": "Telearbeit, Teleworking",
                        "target_lang_word": "Teleworking",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a2c01aa7-e023-445b-a1cc-8f9b0509cfd6",
                        "source_entry_id": "ff0feaa3-af49-308a-accc-c16c0968b435",
                        "source_sense_id": "e5369a96-3a7a-3500-bb55-c3b880612341",
                        "source_sense_description": "Telearbeit, Teleworking",
                        "target_lang_word": "Home Office",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Home Office",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "425fc59c-0d54-38aa-8f0e-9e2f5c779b94",
                                        "entry_id": "e4fc3026-0356-3db1-97b0-e22290af0f41",
                                        "glosses": [
                                            "digitaler Arbeitsplatz in der persönlichen Wohnstätte"
                                        ],
                                        "tags": [
                                            "Arbeitswelt",
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff7ed05-3e10-4cc3-8f21-f04db46b9ec9",
                                                "sense_id": "425fc59c-0d54-38aa-8f0e-9e2f5c779b94",
                                                "text": "Ich komme morgen nicht ins Büro, ich werde in meinem neu eingerichteten Home Office arbeiten."
                                            },
                                            {
                                                "example_id": "7c5d28ef-e54b-46cc-ba56-af7514261129",
                                                "sense_id": "425fc59c-0d54-38aa-8f0e-9e2f5c779b94",
                                                "text": "„Ein Muttersprachler wird sich allerdings verwundert am Kopf kratzen. Home Office klingt zwar schön international, Englischsprechende würden das aber nie so sagen – jedenfalls nicht in dem Kontext. Das Home Office ist nur das Arbeitszimmer, im britischen Englischen übrigens auch das Innenministerium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                        "entry_id": "e4fc3026-0356-3db1-97b0-e22290af0f41",
                                        "glosses": [
                                            "Arbeitsform, bei der man als Angestellter eines Unternehmens Arbeiten von zuhause erledigt; in der Regel werden dazu technische Hilfsmittel, wie Computer, Smartphones und Ähnliches, eingesetzt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80c7a66-3ed2-4514-a2ed-ca640db1f7e2",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "Mitarbeiter, die im Büro arbeiten, sollten ein Recht auf Home Office haben."
                                            },
                                            {
                                                "example_id": "d458b52a-0ab4-4a7c-bad9-b010c9e60d59",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "„Als er die Möglichkeit hatte, im Home Office von zuhause zu arbeiten, zog er von München nach Sankt Heinrich am Starnberger See.“"
                                            },
                                            {
                                                "example_id": "95a48878-122f-4fc6-81c0-085526308c10",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "„Kaum aus dem Bett gestolpert und schon mitten im Job: Dem Home Office gehört die Zukunft, für viele ist das Arbeiten in den eigenen vier Wänden längst zum Alltag geworden.“"
                                            },
                                            {
                                                "example_id": "06bf9b3b-d500-4174-b29b-6001d5864159",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "„»Wir wollen ein Recht auf Home Office und damit auch eine Flexibilisierung der Arbeitszeiten«, sagte Kuhle.“ [Anmerkung: Konstantin Kuhle ist Generalsekretär der niedersächsischen FDP]"
                                            },
                                            {
                                                "example_id": "0a50fc50-8bfc-497d-9adc-6566f4783c48",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "„Per Rundmail fordert der Konzern alle Mitarbeiter im Home Office auf, bis Juni an ihre Büroarbeitsplätze zurückzukehren.“"
                                            },
                                            {
                                                "example_id": "bc3472b0-a3c4-48e6-9f2a-dc6e5644722e",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "„Home Office, Telearbeit oder Teilzeitstellen [sind] nur einige Möglichkeiten, auf die Bedürfnisse der Angestellten zu reagieren und damit als Unternehmen für qualifizierte Arbeitnehmer attraktiv zu werden.“"
                                            },
                                            {
                                                "example_id": "f48eda59-1ecb-483a-ac97-738f1c284411",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "[…] IBM ruft die Mitarbeiter, die bislang von zu Hause arbeiten durften, wieder ins Büro zurück. Ist das Modell \"Home Office\", in Deutschland noch kaum angekommen, schon wieder ein Auslaufmodell?"
                                            },
                                            {
                                                "example_id": "c686d997-05e3-49fd-bc74-282c79247c37",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "„[…] gerade für Ärzte mit familiären Verpflichtungen kann es attraktiv sein, im Home Office Patienten telefonisch oder online zu beraten.“"
                                            },
                                            {
                                                "example_id": "eece5ea1-0845-4960-8ece-9a52cc2b182a",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "„Die Auftraggeber Swisscom und SBB sind sehr zufrieden. Ihr Fazit nach zwei Monaten Pilotversuch: Bei flexiblen Arbeitszeiten und Home Office arbeiten die Leute mehr, besser und sind zufriedener.“"
                                            },
                                            {
                                                "example_id": "f7f0734b-e3e9-47c3-b8b7-d92a88554eeb",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "[Schlagzeile:] „Realschule Gmund: Home Office für Schüler – Schneefrei? Von wegen! Zwar bleiben die Schultore der Realschule in Gmund geschlossen, aber die Schüler erwischt's trotzdem kalt! Sie müssen am heimischen PC lernen.“"
                                            },
                                            {
                                                "example_id": "72a08512-60b1-4516-b8c2-3306c3989a4d",
                                                "sense_id": "f47d1417-b25f-3016-8620-4716cbac010d",
                                                "text": "„Ein Muttersprachler wird sich allerdings verwundert am Kopf kratzen. Home Office klingt zwar schön international, Englischsprechende würden das aber nie so sagen – jedenfalls nicht in dem Kontext. Das Home Office ist nur das Arbeitszimmer, im britischen Englischen übrigens auch das Innenministerium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "008f23d9-4a66-3082-a04d-db96a4da4d79",
                                        "entry_id": "e4fc3026-0356-3db1-97b0-e22290af0f41",
                                        "glosses": [
                                            "britisches Innenministerium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547d74a3-fe16-412c-8161-4070b4d4608f",
                                                "sense_id": "008f23d9-4a66-3082-a04d-db96a4da4d79",
                                                "text": "„Ein Muttersprachler wird sich allerdings verwundert am Kopf kratzen. Home Office klingt zwar schön international, Englischsprechende würden das aber nie so sagen – jedenfalls nicht in dem Kontext. Das Home Office ist nur das Arbeitszimmer, im britischen Englischen übrigens auch das Innenministerium.“"
                                            },
                                            {
                                                "example_id": "19babaa3-3717-45b9-a479-35f7e5a68736",
                                                "sense_id": "008f23d9-4a66-3082-a04d-db96a4da4d79",
                                                "text": "„Firmen hatten bis zum 24. April 2017 Zeit, dem Home Office (dem britischen Innnenministerium, d.Red.) ihr Interesse an der Ausschreibung mitzuteilen. Das Home Office stellt jährlich etwa sechs Millionen Reisepässe aus.“"
                                            },
                                            {
                                                "example_id": "9cbe1f03-4a11-4e5c-80a2-18818d971398",
                                                "sense_id": "008f23d9-4a66-3082-a04d-db96a4da4d79",
                                                "text": "„Mittlerweile [wird] die Mehrheit der Asylanträge vom dafür zuständigen Home Office abgelehnt […].“"
                                            },
                                            {
                                                "example_id": "c3826b5f-2f00-49a1-bf0d-e48fa9b80205",
                                                "sense_id": "008f23d9-4a66-3082-a04d-db96a4da4d79",
                                                "text": "„Wenn Sie länger als 3 Monate in Großbritannien bleiben möchten, können Sie beim Home Office eine Aufenthaltserlaubnis beantragen, die für eine Dauer von 36 Monaten erteilt werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
