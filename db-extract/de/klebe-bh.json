                "senses": [
                    {
                        "sense_id": "0d4dcd66-6561-3b62-9c09-ae9029cb1b85",
                        "entry_id": "59b7306c-a134-3c28-af0b-0539cf27a0e0",
                        "glosses": [
                            "ein Büstenhalter, der auf der Haut fixiert wird und ohne Träger oder Unterbrustband auskommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3fbe11d-3009-4b87-b00c-528384f46e55",
                                "sense_id": "0d4dcd66-6561-3b62-9c09-ae9029cb1b85",
                                "text": "Schluss mit nervigen BH-Trägern, die unschön unter dem Kleid herausschauen. Klebe-BHs sollen dieses Problem nämlich lösen."
                            },
                            {
                                "example_id": "47dbc7a6-cb5c-4766-bf0c-3cfe401f4c51",
                                "sense_id": "0d4dcd66-6561-3b62-9c09-ae9029cb1b85",
                                "text": "Auf der Innenseite des Klebe BHs ist eine Klebeschicht angebracht, die diesen an der Brust fixiert."
                            },
                            {
                                "example_id": "53583b25-bf37-4f5a-8020-6b382b30782d",
                                "sense_id": "0d4dcd66-6561-3b62-9c09-ae9029cb1b85",
                                "text": "Damit ihr das ermöglicht wird, aber dennoch keine Träger oder Bänder am Ausschnitt des Kleides hervorspitzen, gibt es den Klebe BH."
                            },
                            {
                                "example_id": "806ca971-1889-4dd0-964d-53874f405f47",
                                "sense_id": "0d4dcd66-6561-3b62-9c09-ae9029cb1b85",
                                "text": "Dieser superleichte Klebe-BH aus atmungsfähigen Material ist ideal für rückenfreie Kleider und Tops."
                            },
                            {
                                "example_id": "41fd08cc-8f8a-4463-95dd-819967f27a9b",
                                "sense_id": "0d4dcd66-6561-3b62-9c09-ae9029cb1b85",
                                "text": "Seit einiger Zeit schon gibt es hautfarbene Klebe-BH´s zu kaufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
