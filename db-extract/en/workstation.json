                    },
                    {
                        "translation_id": "fe684483-f311-4211-8003-c606511538d1",
                        "source_entry_id": "00b4933a-a7a6-3ae0-a766-9ebd8af353bc",
                        "source_sense_description": "area for single worker",
                        "target_lang_word": "Arbeitsplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeitsplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb016f2-cb47-3ad6-a1bb-7c4cf95d35b4",
                                        "entry_id": "83435bb3-1b3e-3294-8cd4-e58bda59f072",
                                        "glosses": [
                                            "Ort, an dem gearbeitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "428077b4-36ef-44eb-84b1-c7b6cf6b7465",
                                                "sense_id": "8bb016f2-cb47-3ad6-a1bb-7c4cf95d35b4",
                                                "text": "Mein Arbeitsplatz ist dahinten, neben Hans."
                                            },
                                            {
                                                "example_id": "ce561b9a-c8d8-4098-afa1-da7ba82ca3c0",
                                                "sense_id": "8bb016f2-cb47-3ad6-a1bb-7c4cf95d35b4",
                                                "text": "„Gut, dies war ein etwas anderes Ambiente als an meinem früheren Arbeitsplatz im Palais des Nations in Genf.“"
                                            },
                                            {
                                                "example_id": "d9766256-9c54-4bf8-832d-00374ce07666",
                                                "sense_id": "8bb016f2-cb47-3ad6-a1bb-7c4cf95d35b4",
                                                "text": "„Auf einmal war diese wunderbare Werbeagentur zu einem befremdlichen Arbeitsplatz geworden.“"
                                            },
                                            {
                                                "example_id": "8f89133e-7ef4-41ad-8f8f-74704f36fe1d",
                                                "sense_id": "8bb016f2-cb47-3ad6-a1bb-7c4cf95d35b4",
                                                "text": "„Am Gebäude angekommen, erklomm sie die zahlreichen Stufen zu ihrem Arbeitsplatz für diese Nacht.“"
                                            },
                                            {
                                                "example_id": "2e9c44e9-412b-4eba-aa7f-8d6b4979e41a",
                                                "sense_id": "8bb016f2-cb47-3ad6-a1bb-7c4cf95d35b4",
                                                "text": "„Mädchen, die sich gut führten und bei denen nicht die Gefahr bestand, dass sie davonliefen, bekamen Arbeitsplätze außerhalb des Heimes zugewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4cad393-0390-3355-87df-7c9ac3fd7b4b",
                                        "entry_id": "83435bb3-1b3e-3294-8cd4-e58bda59f072",
                                        "glosses": [
                                            "Anstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b05e03-0c20-4a81-a191-151f33bd1a3a",
                                                "sense_id": "b4cad393-0390-3355-87df-7c9ac3fd7b4b",
                                                "text": "Ich habe endlich einen Arbeitsplatz gefunden, der mir genug Lohn einbringt."
                                            },
                                            {
                                                "example_id": "a6b02781-9369-49e5-b5ed-6df7f23a1128",
                                                "sense_id": "b4cad393-0390-3355-87df-7c9ac3fd7b4b",
                                                "text": "„Doch zum Glück gibt es einen Ort, wo wir als Freizeitgladiatoren unserer geballten Zerstörungswut freien Lauf lassen können - den Arbeitsplatz.“"
                                            },
                                            {
                                                "example_id": "e8125d03-030e-4b91-a223-d949c2aa7dc1",
                                                "sense_id": "b4cad393-0390-3355-87df-7c9ac3fd7b4b",
                                                "text": "„Damals konnte ein Hauptschüler davon ausgehen, nach der Schulzeit eine Ausbildungsstelle oder einen Arbeitsplatz zu finden.“"
                                            },
                                            {
                                                "example_id": "6bcd7ecf-5085-4fbb-afe2-7c050e0f141f",
                                                "sense_id": "b4cad393-0390-3355-87df-7c9ac3fd7b4b",
                                                "text": "„Eine Million Arbeitsplätze sind verloren, die Wirtschaft ist um ein Viertel geschrumpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
