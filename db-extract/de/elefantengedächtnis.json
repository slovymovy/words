                "senses": [
                    {
                        "sense_id": "be2ca859-362a-347a-99b6-be1692481282",
                        "entry_id": "ea7bedd7-76f0-3a70-9cfa-1156f6bc91ec",
                        "glosses": [
                            "die Fähigkeit, sich etwas, insbesondere negative Erfahrungen, sehr gut merken zu können"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2f39b04d-d0b7-49da-b93e-9ad0f0699627",
                                "sense_id": "be2ca859-362a-347a-99b6-be1692481282",
                                "text": "„Eines muss man dem amtierenden Präsidenten George W. Bush lassen. Er hat ein wahres Elefantengedächtnis […]“"
                            },
                            {
                                "example_id": "b0707d99-3f03-4a6b-8594-6ee56513867c",
                                "sense_id": "be2ca859-362a-347a-99b6-be1692481282",
                                "text": "„Helmut Kohl war einer, der ein Elefantengedächtnis hatte, und dieses Elefantengedächtnis hat wohl ganz gut funktioniert bis auf die letzten Jahre, in denen er in einem nicht gerade strahlenden Zustand war, wie man weiß.“"
                            },
                            {
                                "example_id": "59b0085b-fd9c-46c0-8ca7-958d869ee349",
                                "sense_id": "be2ca859-362a-347a-99b6-be1692481282",
                                "text": "„[…] das sprichwörtliche Elefantengedächtnis hat in puncto Erinnerungskapazität längst Konkurrenz bekommen – und zwar durch das Internet, das Daten sammelt und speichert wie niemand oder nichts zuvor.“"
                            },
                            {
                                "example_id": "fc455a14-bf00-4d62-9392-a67bae624986",
                                "sense_id": "be2ca859-362a-347a-99b6-be1692481282",
                                "text": "„Auf der Bühne oder in Gesellschaft ist er Polo Hofer stets der perfekte Entertainer, ein lebendiges Lexikon mit einem Elefantengedächtnis, aus welchem er nach Belieben Anekdoten und Witze abrufen kann.“"
                            },
                            {
                                "example_id": "c567e9c6-3838-409f-87d0-14269da365d7",
                                "sense_id": "be2ca859-362a-347a-99b6-be1692481282",
                                "text": "[…] Schriftsteller haben halt Elefantengedächtnisse, siehe Grass, siehe Walser, sind bei entsprechendem Lob aber auch wunderbar flexibel."
                            },
                            {
                                "example_id": "b0653086-fb1c-4a5a-b65c-2d0697687d16",
                                "sense_id": "be2ca859-362a-347a-99b6-be1692481282",
                                "text": "[Uni-Erstsemester: …] „Gut stellen solltet ihr euch mit den Mitarbeitern der Prüfungsämter. Die halten sich meistens sehr penibel an Öffnungszeiten, Formulare, Fristen und verfügen über Elefantengedächtnisse.“"
                            }
                        ],
