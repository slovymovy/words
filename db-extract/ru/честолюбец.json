                        "source_sense_id": "c10e9218-1cf0-3e27-bc08-1d102a9675e0",
                        "target_lang_word": "ambitieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambitieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bad32d3-d639-373a-b46d-dc8a3c15bec4",
                                        "entry_id": "fdcafb2b-e20b-305f-a9bb-2a18fb41361c",
                                        "glosses": [
                                            "Qui a de l’ambition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53416059-838c-4fd2-96cd-d2f60d42346f",
                                                "sense_id": "1bad32d3-d639-373a-b46d-dc8a3c15bec4",
                                                "text": "Les Spartiates étaient petits en nombre, grands de cœur, ambitieux et violents ; de fausses lois n'en aurait tiré que de pâles coquins ; Lycurgue en fit d'héroïques brigands."
                                            },
                                            {
                                                "example_id": "305f7fdf-84b5-4d03-84fc-6c8724dff015",
                                                "sense_id": "1bad32d3-d639-373a-b46d-dc8a3c15bec4",
                                                "text": "Un personnage déclare que, éclairé par sa longue expérience, il préférerait redevenir ambitieux plutôt quʼamoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9671eedd-e0d2-3e9e-928d-d633abf8d81e",
                                        "entry_id": "fdcafb2b-e20b-305f-a9bb-2a18fb41361c",
                                        "glosses": [
                                            "Qui renferme ou marque de l’ambition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f63104-6125-443f-acb2-47fc34860b81",
                                                "sense_id": "9671eedd-e0d2-3e9e-928d-d633abf8d81e",
                                                "text": "Cette supposition n’a rien d’improbable, car les vues ambitieuses des rois franks n’allaient guère au-delà de la perspective d’un gain immédiat et personnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8d39a7-15a9-38e2-baf6-36a7be49d1b9",
                                        "entry_id": "fdcafb2b-e20b-305f-a9bb-2a18fb41361c",
                                        "glosses": [
                                            "Qualifie des formes de discours recherchées ou affectées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2468e09d-1070-4292-829b-e2e495650494",
                                                "sense_id": "1e8d39a7-15a9-38e2-baf6-36a7be49d1b9",
                                                "text": "Ornements ambitieux."
                                            },
                                            {
                                                "example_id": "06b56264-cde7-4459-a5c3-8048195a25c3",
                                                "sense_id": "1e8d39a7-15a9-38e2-baf6-36a7be49d1b9",
                                                "text": "Style ambitieux."
                                            },
                                            {
                                                "example_id": "4a2ea58c-6cd0-4fc5-9b06-8d5a2e490910",
                                                "sense_id": "1e8d39a7-15a9-38e2-baf6-36a7be49d1b9",
                                                "text": "Phrase ou expression ambitieuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ambitieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4e60f7-af46-3fbf-96fc-0009f040f3f4",
                                        "entry_id": "d313a2ff-0c75-3642-a95a-aeac1d23cd06",
                                        "glosses": [
                                            "Substantif de l’adjectif : personne qui a de l’ambition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af64e501-4d62-4e94-8264-575cba99c88f",
                                                "sense_id": "9e4e60f7-af46-3fbf-96fc-0009f040f3f4",
                                                "text": "L’ambitieux sacrifie tout à sa passion."
                                            },
                                            {
                                                "example_id": "19a72bc2-55d8-438c-a47b-bc2cecd5df7d",
                                                "sense_id": "9e4e60f7-af46-3fbf-96fc-0009f040f3f4",
                                                "text": "Les ambitieux se permettent tout pour parvenir à leurs fins."
                                            },
                                            {
                                                "example_id": "381322ad-1353-4554-a1be-f446492db806",
                                                "sense_id": "9e4e60f7-af46-3fbf-96fc-0009f040f3f4",
                                                "text": "Il nʼavait pas lʼétoffe dʼun ambitieux : il ne savait pas mettre lʼorgueil bas."
                                            },
                                            {
                                                "example_id": "0297ec84-6010-4bf5-a366-35de0f97249c",
                                                "sense_id": "9e4e60f7-af46-3fbf-96fc-0009f040f3f4",
                                                "text": "et que tous les maux horribles de la guerre, loin d’accabler les peuples fidèles et innocents, retombent sur la tête parjure et exécrable de l’ambitieux qui foulera aux pieds les droits sacrés de cette alliance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
