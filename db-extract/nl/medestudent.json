                "senses": [
                    {
                        "sense_id": "6e5b4157-3d29-3ba4-af1f-54696be1700a",
                        "entry_id": "69d6f351-abfc-3bbd-90be-fc935d0ef384",
                        "glosses": [
                            "iemand die samen met jou een opleiding volgt; iemand die ook een student is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efb0db6b-f3c1-416d-b572-ed90458e797f",
                                "sense_id": "6e5b4157-3d29-3ba4-af1f-54696be1700a",
                                "text": "Ik kon heel veel leren van mijn medestudenten"
                            },
                            {
                                "example_id": "15c88f70-a5c7-4b02-b479-24038cdf65cf",
                                "sense_id": "6e5b4157-3d29-3ba4-af1f-54696be1700a",
                                "text": "Mijn beste vrienden waren medestudenten tijdens mijn opleiding."
                            },
                            {
                                "example_id": "83e030fa-490b-4fab-b955-db4dfe7ede0e",
                                "sense_id": "6e5b4157-3d29-3ba4-af1f-54696be1700a",
                                "text": "De meeste medestudenten aan de Handelshogeschool hadden het waarschijnlijk allemaal als een grap gezien, of als een sport met de bedoeling de studielening te verdubbelen die alle studenten van het land cadeau kregen van de sociaaldemocratische staat, ook wie het totaal niet nodig had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ad28103-d034-47b4-a88b-6cb23e02ef20",
                        "source_entry_id": "69d6f351-abfc-3bbd-90be-fc935d0ef384",
                        "source_sense_id": "6e5b4157-3d29-3ba4-af1f-54696be1700a",
                        "source_sense_description": "iemand die samen met jou een opleiding volgt; iemand die ook een student is",
                        "target_lang_word": "Kommilitone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommilitone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                        "entry_id": "872d0fa3-f9fc-3571-aa99-8e0fa62ea0f2",
                                        "glosses": [
                                            "Person, mit der man gemeinsam an einer Hochschule studiert (hat)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf2de264-5f70-433b-8c39-d6d32bf4c665",
                                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                                "text": "„Es war normal, dass ich mich ihnen anschloss, da wir keinen Zugang zu den reichen Studenten hatten, der Mehrzahl unserer Kommilitonen.“"
                                            },
                                            {
                                                "example_id": "010dab62-ddd3-4215-a1eb-21817095890e",
                                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                                "text": "„All dies, erklärte mir der Kommilitone geduldig, sei en detail im Mietvertrag festgelegt, sogar der Wochentag der Ausführung: und zwar der Samstag.“"
                                            },
                                            {
                                                "example_id": "4aaede38-e7b3-41dd-911c-d275b3715c5c",
                                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                                "text": "„Nur Csoma hielt das Versprechen - er war schließlich zwanzig Jahre älter als die beiden Kommilitonen, mit denen er es abgelegt hatte.“"
                                            },
                                            {
                                                "example_id": "5f088cdc-77e1-4010-b38a-da56724a91c5",
                                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                                "text": "„Sein Mobiltelefon klingelte, und ein Kommilitone, mit dem Tom gemeinsam promoviert hatte, war am anderen Ende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
