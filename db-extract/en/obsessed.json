    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4633e347-0fb9-32f7-b961-39a532a63ebe",
                "word": "obsessed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0945cd8f-13e3-4d41-ba12-f4de646648ec",
                        "entry_id": "4633e347-0fb9-32f7-b961-39a532a63ebe",
                        "tags": [
