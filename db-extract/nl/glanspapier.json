                        "sense_id": "8e405753-c8d2-31c7-a2d8-0ea4b4906349",
                        "entry_id": "3d750188-dfbf-3b15-ac47-3a99e2193936",
                        "glosses": [
                            "glanzend papier dat zeer geschikt is voor het afdrukken van foto's"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0eabf7c-5c83-4dcd-9b96-c905f7c6d283",
                                "sense_id": "8e405753-c8d2-31c7-a2d8-0ea4b4906349",
                                "text": "We hadden geen van beiden de moed om de foto's te bekijken, omdat we net zo goed als Jenny wisten dat op elke afdruk, opzichtig onzichtbaar, Tonio aanwezig was. Zijn spiedende, aftastende oog, dwars door het glanspapier heen."
                            },
                            {
                                "example_id": "46f0d6e6-27e2-418c-9647-9a13638aa527",
                                "sense_id": "8e405753-c8d2-31c7-a2d8-0ea4b4906349",
                                "text": "De eerste ontwerpen voor de torenflat aan de Hofstraat zijn al gemaakt in opdracht van Rabo Vastgoed. Tijdens een gesprek over alle commotie de afgelopen tijd over de flat, laat wethouder A. Sjoers fraai uitgevoerde brochures met foto’s op glanspapier zien waarin drie architectenbureaus hun ontwerpen tonen."
                            }
                        ]
                    }
