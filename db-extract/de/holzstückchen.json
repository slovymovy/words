                        "examples": [
                            {
                                "example_id": "e1738fd9-f938-4786-9330-ec9ee1cb7729",
                                "sense_id": "515e7009-8f0d-3819-85ad-af9489187add",
                                "text": "„Die Feuer erloschen; glühende Holzstückchen stoben über die Ebene, Sand kroch im Dunkeln vorüber, wie Läusearmeen auf dem Vormarsch.“"
                            },
                            {
                                "example_id": "75c08d52-852d-4126-bc06-af5ed090c187",
                                "sense_id": "515e7009-8f0d-3819-85ad-af9489187add",
                                "text": "„Court hörte ganz in seiner Nähe Gläser hinter der Theke zerbersten, der Eiskübel bekam eine Kugel ab, und 30 Zentimeter vor seiner Nase splitterten Holzstückchen von der Thekenkante ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
