                        "examples": [
                            {
                                "example_id": "905f5a47-e353-41cd-8c96-2feca5da5140",
                                "sense_id": "42c765d6-839f-3884-a542-4deb5f58fe27",
                                "text": "„Das Grünloch ist eine beinahe kreisförmige Doline auf dem Dürrensteinplateau, westlich des Großen Hetzkogels. In früherer Zeit fand in diesem Gebiet Almwirtschaft statt, und auch im Grünloch standen Almhütten.“"
                            },
                            {
                                "example_id": "664336fb-154d-4fea-b78f-dc7b9144f8b3",
                                "sense_id": "42c765d6-839f-3884-a542-4deb5f58fe27",
                                "text": "„In den Göstlinger Alpen nahe dem Dürrenstein wurden längere Feldversuche am Grünloch betrieben, hier konnte im Jahre 1932 sogar ein Tiefstwert von minus 52,6 Grad gemessen werden.“"
                            }
                        ],
