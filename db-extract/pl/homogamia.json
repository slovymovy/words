                        "glosses": [
                            "wybieranie partnera podobnego fenotypowo do wybierającego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3309685d-a8b2-3dea-9a35-f21ab96c8f0f",
                        "entry_id": "ab9a69ea-9ce0-3589-8b04-3ae12bb2e8c3",
                        "glosses": [
                            "dobieranie się podobnych typów w doborze małżeńskim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d144db-f59d-4f7d-ae16-cfdcff0b7e4c",
                                "sense_id": "3309685d-a8b2-3dea-9a35-f21ab96c8f0f",
                                "text": "To istotna kwestia doboru małżeńskiego – homogamia. W pary dobierają się osoby o podobnej sytuacji społecznej, materialnej. Taka zasada obowiązuje w nowoczesnym społeczeństwie i realizowana jest nieświadomie: zakochujemy się w kimś o podobnym stylu życia, postawie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5bb131d0-e175-3ef5-9c3b-e711e1f67d87",
                        "entry_id": "ab9a69ea-9ce0-3589-8b04-3ae12bb2e8c3",
                        "glosses": [
                            "jednoczesne dojrzewanie słupka i pręcika w tym samym kwiecie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eba42bc2-0fb9-4d19-899e-5e29c348cd42",
                        "source_entry_id": "ab9a69ea-9ce0-3589-8b04-3ae12bb2e8c3",
                        "source_sense_id": "884e2fc5-9a72-3491-9976-a6883dbde4b0",
