                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de50836-44f8-4265-948d-1aa322a7bd8d",
                                                "sense_id": "163a13a2-3617-3f9b-9d76-a484f59a68c1",
                                                "text": "Karoline Friederike Louise Maximiliane von Günderrode (* 11. Februar 1780 in Karlsruhe; † 26. Juli 1806 in Winkel) war deutsche Romantikerin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c04c968-0e6d-4e0a-b0c6-f13ea70ab6ca",
                        "source_entry_id": "74422055-9937-3b9e-a705-ba067dad37b5",
                        "source_sense_id": "8234c541-2f28-33ca-b86f-0b5981e68ee3",
