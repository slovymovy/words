                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81e1857-f6c8-4be3-82cc-803a66f78435",
                                "sense_id": "239584e6-0366-3d19-bc39-2015130db183",
                                "text": "Outside the Filmmakers Lodge, a central gathering spot for Sundance participants, a sign assured festivalgoers[…]."
                            },
                            {
                                "example_id": "0f1335b1-d355-49c7-9bcf-39a4543288ee",
                                "sense_id": "239584e6-0366-3d19-bc39-2015130db183",
                                "text": "Once festivalgoers arrive at a rural festival, they are essentially living 'off-grid' for the duration of the event."
                            },
                            {
                                "example_id": "3f7e08a6-25b3-4a43-b340-88d10bddc45c",
                                "sense_id": "239584e6-0366-3d19-bc39-2015130db183",
                                "text": "Five Georgia officers have been indicted on murder charges in the asphyxiation death of a festivalgoer near Atlanta Motor Speedway in 2019, prosecutors said Friday."
                            }
                        ]
                    }
                ],
