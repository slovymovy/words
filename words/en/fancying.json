{
    "word_family": [
        "fancy",
        "fanciful",
        "fancier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d149178e-d7b6-3a40-b55d-a28881b38b8a",
                    "sense_definition": "present participle and gerund of <w>fancy</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>fancying</w> a cup of tea after her long walk.",
                            "target_lang_translations": {
                                "fr": "Elle <w>a envie d'</w>une tasse de thé après sa longue marche.",
                                "zh": "长途跋涉后，她正<w>想要</w>喝杯茶。"
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>fancying</w> what he would do if he won the lottery.",
                            "target_lang_translations": {
                                "fr": "Il a passé l'après-midi à <w>imaginer</w> ce qu'il ferait s'il gagnait à la loterie.",
                                "zh": "他整个下午都在<w>想象</w>如果中了彩票他会做什么。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb fancy."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Participe présent et gérondif du verbe 'fancy', signifiant avoir envie de quelque chose ou imaginer quelque chose.",
                        "zh": "指想要某物或对某人产生好感，也指在脑海中想象某事。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "avoir envie de",
                                "target_lang_sense_clarification": "exprimer un désir ou une envie pour quelque chose"
                            },
                            {
                                "target_lang_word": "imaginer",
                                "target_lang_sense_clarification": "se représenter quelque chose dans son esprit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "想要",
                                "target_lang_sense_clarification": "指渴望得到某物或做某事。"
                            },
                            {
                                "target_lang_word": "想象",
                                "target_lang_sense_clarification": "指在脑海中构思或设想。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ac2eb70-df1e-3bcd-b5bd-db758cceb718",
                    "sense_definition": "A product of the imagination or a sudden desire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author filled his book with strange <w>fancyings</w> about life on other planets.",
                            "target_lang_translations": {
                                "fr": "L'auteur a rempli son livre d'étranges <w>imaginations</w> sur la vie sur d'autres planètes.",
                                "zh": "作者在书中写满了关于外星生命的奇特<w>幻想</w>。"
                            }
                        },
                        {
                            "text": "She dismissed his fears as mere <w>fancyings</w> without any basis in reality.",
                            "target_lang_translations": {
                                "fr": "Elle a balayé ses peurs comme de simples <w>caprices</w> sans aucun fondement dans la réalité.",
                                "zh": "她认为他的恐惧不过是毫无根据的<w>念头</w>，便没当回事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imagination",
                        "notion",
                        "whim"
                    ],
                    "antonyms": [
                        "fact",
                        "reality"
                    ],
                    "target_lang_definitions": {
                        "fr": "Produit de l'imagination ou désir soudain et irrationnel.",
                        "zh": "指凭空产生的想法、幻想或一时的念头。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "imaginations",
                                "target_lang_sense_clarification": "produits de l'esprit ou idées fantaisistes"
                            },
                            {
                                "target_lang_word": "caprices",
                                "target_lang_sense_clarification": "désirs soudains et changeants"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幻想",
                                "target_lang_sense_clarification": "指不切实际的想象。"
                            },
                            {
                                "target_lang_word": "念头",
                                "target_lang_sense_clarification": "指突然产生的想法。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}