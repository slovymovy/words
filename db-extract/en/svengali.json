                    },
                    {
                        "translation_id": "760f71a7-75ea-436b-992a-9804d07fb1fe",
                        "source_entry_id": "f4aeb883-6988-384b-ab28-e81ee1c8fd29",
                        "source_sense_id": "18974682-ccbd-38b3-a451-164203fe2083",
                        "source_sense_description": "One who manipulates or controls another as by some mesmeric or sinister influence; especially a coach, mentor or industry mogul.",
                        "target_lang_word": "Strippenzieher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strippenzieher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                        "entry_id": "674a6f88-4f26-31a9-b0b7-d2955d98cd3f",
                                        "glosses": [
                                            "Person, die im Hintergrund eigene oder fremde Interessen durchsetzt, ohne das Dritte das erkennen können"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0159c94-8e3b-49f8-8353-d67c15ab21f3",
                                                "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                                "text": "„Schäuble war ein wichtiger Strippenzieher in der deutschen Politik, manche nannten ihn die \"graue Eminenz\".“"
                                            },
                                            {
                                                "example_id": "264933b2-bce4-4033-bcfc-6d2b042598ca",
                                                "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                                "text": "[Mitch McConnell:] „Er gilt seit Langem als einer der wichtigsten Strippenzieher in der US-Politik.“"
                                            },
                                            {
                                                "example_id": "923673df-0b2b-44b5-b2e7-027adb502672",
                                                "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                                "text": "„Der Ehrenvorsitzende der Partei gilt mit seinem Milliardenvermögen als wichtigster Strippenzieher des Landes.“"
                                            },
                                            {
                                                "example_id": "a7f45a69-902f-4eed-a8de-41fab8d55feb",
                                                "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                                "text": "„Einen aktiven Posten als Politiker will Wendt nicht, dafür fehle ihm die Zeit. Trotzdem bezeichnen ihn manche als Strippenzieher.“"
                                            },
                                            {
                                                "example_id": "c2469ffc-991f-4635-b236-2d73a89cf0d6",
                                                "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                                "text": "„Antisemitismus zeigt sich oft in Mythen, wonach jüdische Strippenzieher die Welt lenken.“"
                                            },
                                            {
                                                "example_id": "1abf1607-73a6-4541-aab3-a7595fbbcf90",
                                                "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                                "text": "„Dobrindt ist im Führungstrio der Union inzwischen unersetzlicher Vordenker und Strippenzieher.“"
                                            },
                                            {
                                                "example_id": "5b73954c-523e-4f08-b22e-6f2991cca53f",
                                                "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                                "text": "„Erwin Huber: Der 60-Jährige ist bislang vor allem als rechte Hand Stoibers und effizienter Strippenzieher an der Seite des Ministerpräsidenten in Erscheinung getreten.“"
                                            },
                                            {
                                                "example_id": "2bf939d9-264b-44f4-99a1-c42d1b6db3bb",
                                                "sense_id": "d19b6a88-6dd6-30c1-b72f-9998dfa6400b",
                                                "text": "„Die Medienzeitschrift Kress pro platzierte ihn 2020 hinter EU-Kommissarin Margrethe Vestager auf Platz zwei im Ranking der 20 „mächtigsten Strippenzieher in den Medien“.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c9d46cc-b72e-3f9b-9051-eba2648c2c00",
                                        "entry_id": "674a6f88-4f26-31a9-b0b7-d2955d98cd3f",
                                        "glosses": [
                                            "Person, die Kabel verlegt; Elektriker"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1538ffb1-7b24-407d-b143-05d6412c02ba",
                        "source_entry_id": "f4aeb883-6988-384b-ab28-e81ee1c8fd29",
                        "source_sense_id": "18974682-ccbd-38b3-a451-164203fe2083",
                        "source_sense_description": "One who manipulates or controls another as by some mesmeric or sinister influence; especially a coach, mentor or industry mogul.",
                        "target_lang_word": "Drahtzieher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drahtzieher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5713953e-1d5c-3e45-bd10-0f4a583b63ae",
                                        "entry_id": "7fd4307e-ec14-39ca-8bcb-545d74c4b731",
                                        "glosses": [
                                            "jemand, der aus Metall mit Hilfe von Ziehmaschinen Draht herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f0a0259-6f01-4958-8c08-db4ef949a3e8",
                                                "sense_id": "5713953e-1d5c-3e45-bd10-0f4a583b63ae",
                                                "text": "Die gute Qualität des Drahts lässt auf einen geschulten Drahtzieher schließen."
                                            },
                                            {
                                                "example_id": "0c8db420-f67d-4211-9e88-866bb5d49f53",
                                                "sense_id": "5713953e-1d5c-3e45-bd10-0f4a583b63ae",
                                                "text": "„Der Drahtzieher sitzt dabei auf einer Schaukel, um mit der Schwingbewegung mehr Kraft zu erzeugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32c2a91b-74d8-3f28-b3a0-3118ba855409",
                                        "entry_id": "7fd4307e-ec14-39ca-8bcb-545d74c4b731",
                                        "glosses": [
                                            "jemand, der im Hintergrund Entscheidungen trifft und (oft ungesetzliche) Aktionen plant, aber nicht als Verantwortlicher zu erkennen ist"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8b85051-57e9-42d1-8f3d-0cce57f00a6e",
                                                "sense_id": "32c2a91b-74d8-3f28-b3a0-3118ba855409",
                                                "text": "Die Schmuggler wurden an der Grenze verhaftet, aber die Drahtzieher wird man nicht zu fassen bekommen."
                                            },
                                            {
                                                "example_id": "df21e822-5541-4c75-a6ca-d3db0b0f0ce0",
                                                "sense_id": "32c2a91b-74d8-3f28-b3a0-3118ba855409",
                                                "text": "Die mutmaßlichen Drahtzieher des Anschlags vermuten die Sicherheitsbehörden in den Reihen der Aufständischen."
                                            },
                                            {
                                                "example_id": "c086d902-1aa3-4ebb-ad47-55397013a190",
                                                "sense_id": "32c2a91b-74d8-3f28-b3a0-3118ba855409",
                                                "text": "„Auch alle anderen Drahtzieher des Staatsstreichs in der jungen Republik Kongo kamen ungeschoren davon.“"
                                            },
                                            {
                                                "example_id": "5efc400c-5e15-459b-a83d-c4d52f9848de",
                                                "sense_id": "32c2a91b-74d8-3f28-b3a0-3118ba855409",
                                                "text": "„Bald gab es in der Presse Spekulationen über die tatsächlichen Drahtzieher beim Abgang Glogowskis.“"
                                            },
                                            {
                                                "example_id": "e147e9a6-92c6-474d-a201-c8dadb842910",
                                                "sense_id": "32c2a91b-74d8-3f28-b3a0-3118ba855409",
                                                "text": "„Wir bekamen zwar nie heraus, ob O.B. tatsächlich einer der Marlboro-Männer war, aber beim Essen erfuhren wir, dass er einer der Drahtzieher bei der Tuareg-Rebellenbewegung gewesen war.“"
                                            },
                                            {
                                                "example_id": "8a3faebd-e1a5-4657-88d1-360a4d2777af",
                                                "sense_id": "32c2a91b-74d8-3f28-b3a0-3118ba855409",
                                                "text": "„Bis heute gibt es viele Spekulationen über diesen Absturz, die von einfachem technischen Versagen bis hin zu gezieltem Mord durch den pakistanischen Geheimdienst Inter-Services Intelligence (ISI) oder durch Drahtzieher in Indien oder der Sowjetunion reichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
