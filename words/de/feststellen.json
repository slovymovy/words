            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1f04d16-62ab-358e-a062-55af571dce77",
                    "sense_definition": "etwas bemerken oder erkennen, das einem vorher nicht bewusst war",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wahrnehmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Erst am Bahnhof <w>stellte</w> sie <w>fest</w>, dass sie ihre Geldbörse zu Hause vergessen hatte."
                        },
                        {
                            "text": "Wir haben heute überrascht <w>festgestellt</w>, dass unser Zug pünktlich abgefahren ist."
                        }
                    ],
                    "synonyms": [
                        "bemerken",
                        "erkennen"
                    ],
                    "antonyms": [
                        "übersehen"
                    ],
                    "common_phrases": [
                        "mit Erstaunen feststellen",
                        "überrascht feststellen"
                    ]
                },
                {
                    "sense_id": "98a9b4f1-2718-36bf-9c6d-4447242daff3",
                    "sense_definition": "durch gezielte Untersuchung, Messung oder Nachforschung ermitteln",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ermittlung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Arzt konnte nach der Untersuchung keine schwere Krankheit bei ihm <w>feststellen</w>."
                        },
                        {
                            "text": "Die Polizei <w>stellte</w> am Unfallort die genauen Personalien aller Beteiligten <w>fest</w>."
                        }
                    ],
                    "synonyms": [
                        "ermitteln",
                        "herausfinden"
                    ],
                    "common_phrases": [
                        "die Identität feststellen",
                        "die Todesursache feststellen",
                        "Schäden feststellen"
                    ]
                },
                {
                    "sense_id": "7aa1aca6-0922-3c4c-8b0c-107995ba1b9b",
                    "sense_definition": "eine Tatsache oder Beobachtung ausdrücklich betonen oder erklären",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aussage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Abschließend möchte ich <w>feststellen</w>, dass unser Projekt ein großer Erfolg war."
                        },
                        {
                            "text": "Der Sprecher <w>stellte</w> klar <w>fest</w>, dass keine weiteren Verhandlungen geplant sind."
                        }
                    ],
                    "synonyms": [
                        "konstatieren",
                        "betonen"
                    ],
                    "common_phrases": [
                        "ausdrücklich feststellen",
                        "abschließend feststellen"
                    ]
                },
                {
                    "sense_id": "4af805aa-4d07-3e0b-8bff-cac3a249da3a",
                    "sense_definition": "ein bewegliches Bauteil in einer festen Position sichern oder arretieren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergiss nicht, die Bremse am Kinderwagen sicher <w>festzustellen</w>, bevor du loslässt."
                        },
                        {
                            "text": "Er <w>stellte</w> das Fenster mit einem kleinen Haken <w>fest</w>, damit es offen blieb."
                        }
                    ],
                    "synonyms": [
