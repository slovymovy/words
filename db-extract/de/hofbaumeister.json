                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b067aa-6cd9-470e-b282-bc19a49ac2a2",
                                "sense_id": "07c397b1-fa3d-3dc4-9e4d-2beb7460d53c",
                                "text": "„Ein Hofbaumeister war ein an den Sitz eines regierenden Fürsten oder Herrschers (Hof) berufener, also ein von einem Landesherren mit der Planung und Durchführung öffentlicher Bauvorhaben betrauter Baumeister.“"
                            },
                            {
                                "example_id": "56810f29-12a7-42e5-b47b-f663c86a82b2",
                                "sense_id": "07c397b1-fa3d-3dc4-9e4d-2beb7460d53c",
                                "text": "„Diese [Wasserleitung] wurde vom Hofbaumeister Peter Concorz (Chonchartz) errichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
