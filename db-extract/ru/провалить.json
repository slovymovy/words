                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f07d53b2-80c3-46e1-b106-f9786eb9ab94",
                                "sense_id": "252c77c0-2f47-31d8-aa6c-83e370dd5889",
                                "text": "провали́ть де́ло",
                                "translation": "to ruin things; make a mess of things; mess things up; gum up the works",
                                "english": "to ruin things; make a mess of things; mess things up; gum up the works"
                            },
                            {
                                "example_id": "4c65be1d-540a-48b9-a2f1-1c8562208b57",
                                "sense_id": "252c77c0-2f47-31d8-aa6c-83e370dd5889",
                                "text": "провали́ть роль",
                                "translation": "to ruin ones part",
                                "english": "to ruin ones part"
                            },
                            {
                                "example_id": "e23edcf7-48ac-428a-902b-99d50777f855",
                                "sense_id": "252c77c0-2f47-31d8-aa6c-83e370dd5889",
                                "text": "провали́ть экза́мен",
                                "translation": "to fail/flunk an exam",
                                "english": "to fail/flunk an exam"
                            }
                        ]
                    },
                    {
                        "sense_id": "279f5fb8-99c6-3494-b888-a35e71ab6d94",
                        "entry_id": "85515b80-1350-3f50-a64f-9b0c65d8697a",
                        "glosses": [
                            "to fail"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1a332bb9-3e73-4422-a9fb-6bc19781c830",
                                "sense_id": "279f5fb8-99c6-3494-b888-a35e71ab6d94",
                                "text": "провали́ть кого́-либо на пи́сьменном экза́мене",
                                "translation": "fail someone in the written paper",
                                "english": "fail someone in the written paper"
                            },
                            {
                                "example_id": "7ca6d6e9-d9cc-4312-8c84-0b969734209c",
                                "sense_id": "279f5fb8-99c6-3494-b888-a35e71ab6d94",
                                "text": "оппози́ция провали́ла план прави́тельства",
                                "translation": "the opposition torpedoed the government's plan",
                                "english": "the opposition torpedoed the government's plan"
                            },
                            {
                                "example_id": "ba33e1a5-e783-43f7-bd55-c49ca89f70f8",
                                "sense_id": "279f5fb8-99c6-3494-b888-a35e71ab6d94",
                                "text": "провали́ть законопрое́кт",
                                "translation": "to kill the bill",
                                "english": "to kill the bill"
                            },
                            {
                                "example_id": "484843bd-969c-48de-a4c7-600853a8ece3",
                                "sense_id": "279f5fb8-99c6-3494-b888-a35e71ab6d94",
                                "text": "провали́ть кого́-либо при голосова́нии",
                                "translation": "to vote someone down",
