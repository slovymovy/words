                                        "glosses": [
                                            "männlicher Vorname einer Bühnenrolle/fiktiven Figur aus der Oper ‚Don Giovanni‘, die als Diener der Titelfigur die Liebschaften seines Herrn in einem langen Schriftstück registriert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a920fbb2-9d29-4b67-bad3-8721b3bc6070",
                                                "sense_id": "c7327d0b-3bff-3df4-ad2d-f8b5973aac86",
                                                "text": "„Schmelzing zeigte die lange Pergamenttafel, die er vollgeschrieben hatte. Er ließ sie auseinanderfallen, wie Leporello Don Juan's Register.“"
                                            }
