                "senses": [
                    {
                        "sense_id": "a4f71d34-4009-3199-ac3d-921210ea6e1a",
                        "entry_id": "f892a7bc-5eba-3a45-9e64-01e7bd308984",
                        "glosses": [
                            "Qui peut provoquer la mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a97b811-b0ab-4f55-ba3f-f785e2765f3b",
                                "sense_id": "a4f71d34-4009-3199-ac3d-921210ea6e1a",
                                "text": "La dose létale, ou meurtrière, dit-elle, pour une intoxication aiguë à l’arsenic est de 120 mg c’est-à-dire l’équivalent de quelque grain de poussière [?]. Pas de chance, la mort apparaît en quelques minutes."
                            },
                            {
                                "example_id": "d3521014-d262-4943-894e-7e42007d0791",
                                "sense_id": "a4f71d34-4009-3199-ac3d-921210ea6e1a",
                                "text": "Des ONG, soutenues par des acteurs du numérique, demandent l’interdiction des armes létales autonomes."
                            },
                            {
                                "example_id": "80b9b4c6-c2cb-4412-bab6-1791db8ef07e",
                                "sense_id": "a4f71d34-4009-3199-ac3d-921210ea6e1a",
                                "text": "Les semenciers, les producteurs d’engrais et de pesticides jouaient par leur existence même, sur le plan agricole, un rôle destructeur et létal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bbc9b87-c802-40b8-9a22-3a6eb7e1fbb7",
                        "source_entry_id": "f892a7bc-5eba-3a45-9e64-01e7bd308984",
