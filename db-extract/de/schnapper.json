                "senses": [
                    {
                        "sense_id": "dd839e09-9f7e-3c8c-9314-39f54ad84172",
                        "entry_id": "92c397e6-dc7d-3e1b-ad10-0bdc2281c293",
                        "glosses": [
                            "Vertreter der Familie der Lutjanidae, mariner Raubfische in Riffen des Indopazifiks und Atlantiks"
                        ],
                        "tags": [
                            "Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dedfd403-6e53-4b84-9731-181235fbb6e1",
                                "sense_id": "dd839e09-9f7e-3c8c-9314-39f54ad84172",
                                "text": "„Die Nordamerikaner lieben den Schnapper: Er ist fest, trocken und weiß im Fleisch und hat dabei nur wenige, große Gräten und er ist für alle Garmethoden geeignet.“"
                            },
                            {
                                "example_id": "3270ec35-f65e-41cf-8df3-dabbeddb3049",
                                "sense_id": "dd839e09-9f7e-3c8c-9314-39f54ad84172",
                                "text": "Der Schnapper lebt in den subtropischen Riffen des Indopazifiks und Atlantiks, wo er seiner Beute auflauert und plötzlich zuschnappt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9aa69fe1-bfec-370f-b933-912ad45f2f87",
                        "entry_id": "92c397e6-dc7d-3e1b-ad10-0bdc2281c293",
                        "glosses": [
                            "einer, der nach etwas schnappt in Form eines zuschnappenden Bisses oder eines schnellen Atemholens mit dem Mund oder dem Maul"
                        ],
                        "tags": [
                            "archaic",
                            "general"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c82c914a-bc56-3ae9-9013-97d1caa5c35d",
                        "entry_id": "92c397e6-dc7d-3e1b-ad10-0bdc2281c293",
                        "glosses": [
                            "ein Bauteil, das selbsttätig einschnappt oder einrastet und damit eine Verriegelungsfunktion übernimmt"
                        ],
                        "tags": [
                            "Mechanik"
                        ],
                        "examples": [
                            {
                                "example_id": "921ba8ba-75e6-4575-baa7-b1ec48bd55e6",
                                "sense_id": "c82c914a-bc56-3ae9-9013-97d1caa5c35d",
                                "text": "Ein auf dem Achslagerblock montierter Schnapper rastet dabei so in Nuten des Targettellers ein, daß das zugehörige Loch vor dem Target bzw. der Quarzscheibe genau symmetrisch zur Magnetachse in Ruhestellung kommt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
