            "senses": [
                {
                    "sense_id": "3de183d6-4f0e-379f-840e-0f9d6c2f38cf",
                    "sense_definition": "het overmatig of gulzig drinken van vloeistoffen, meestal verwijzend naar alcohol",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drinken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het winnen van de wedstrijd gingen de supporters de hele nacht <w>zuipen</w> in de stad.",
                            "target_lang_translations": {
                                "en": "After winning the match, the supporters went <w>boozing</w> in the city all night."
                            }
                        },
                        {
                            "text": "Hij <w>zoop</w> als een ketter tijdens het feestje en was de volgende dag erg ziek.",
                            "target_lang_translations": {
                                "en": "He <w>drank</w> like a fish during the party and was very sick the next day."
                            }
                        }
                    ],
                    "synonyms": [
                        "pimpelen",
                        "doorzakken",
                        "drinken",
                        "hannesen"
                    ],
                    "antonyms": [
                        "nippen"
                    ],
                    "common_phrases": [
                        "zuipen als een ketter",
                        "een avondje zuipen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal and often implies excessive alcohol consumption"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the excessive or greedy drinking of liquids, usually referring to alcohol"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "booze",
                                "target_lang_sense_clarification": "to drink alcohol excessively"
                            },
                            {
                                "target_lang_word": "guzzle",
                                "target_lang_sense_clarification": "to drink greedily or in large amounts"
                            },
                            {
                                "target_lang_word": "get hammered",
                                "target_lang_sense_clarification": "to drink a lot of alcohol to get drunk"
                            },
                            {
                                "target_lang_word": "swill",
                                "target_lang_sense_clarification": "to drink large quantities of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "050cf21e-017d-3d54-b987-1992529faf7b",
                    "sense_definition": "het in zeer grote hoeveelheden verbruiken van brandstof of olie door een voertuig of machine",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die oude Amerikaanse auto <w>zuipt</w> benzine en is daarom erg duur in het gebruik.",
                            "target_lang_translations": {
                                "en": "That old American car <w>guzzles</w> petrol and is therefore very expensive to use."
                            }
                        },
                        {
                            "text": "Mijn motor <w>zuipt</w> olie, dus ik moet het peil elke week goed controleren.",
                            "target_lang_translations": {
                                "en": "My engine <w>eats up</w> oil, so I have to check the level carefully every week."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbruiken",
                        "slurpen"
                    ],
                    "antonyms": [
                        "besparen"
                    ],
                    "common_phrases": [
                        "benzine zuipen",
                        "olie zuipen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize high consumption"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the consumption of fuel or oil in very large quantities by a vehicle or machine"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guzzle",
