                ],
                "senses": [
                    {
                        "sense_id": "1175fbb9-721a-3beb-9c5f-55d913814d04",
                        "entry_id": "d824309d-7eb6-3947-a050-f1941b99b932",
                        "glosses": [
                            "An uncultured Australian."
                        ],
                        "tags": [
                            "Australia",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cfc107be-3b98-4a86-90ea-db10afc7ebbd",
                                "sense_id": "1175fbb9-721a-3beb-9c5f-55d913814d04",
                                "text": "Martin Sharp once described Sydney's western suburbs to me hazily as 'where the Alfs live'."
                            },
                            {
                                "example_id": "f45a63ce-125b-4f4e-9ef5-06b54dea694b",
                                "sense_id": "1175fbb9-721a-3beb-9c5f-55d913814d04",
                                "text": "Oz savaged suburbia as a wasteland of consumerism and conformity, peopled with 'Alfs' […]"
                            },
                            {
                                "example_id": "f5c20eb4-a6ac-4770-b819-62e741620985",
                                "sense_id": "1175fbb9-721a-3beb-9c5f-55d913814d04",
                                "text": "Coote ended his piece with the claim that “[t]he Australian Alfs are beyond redemption”, and as such only small groups of militant aligned students and workers posed a real challenge to the system."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
