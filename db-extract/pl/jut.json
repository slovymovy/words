                "senses": [
                    {
                        "sense_id": "eedffad0-0b29-33c0-9440-596124373062",
                        "entry_id": "aa8b3736-2e68-3a81-bf65-d594ecf134e2",
                        "glosses": [
                            "członek dawnego północnogermańskiego plemienia zamieszkującego Jutlandię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "206d5551-3c4e-48d5-8293-b76f1cf656ea",
                                "sense_id": "eedffad0-0b29-33c0-9440-596124373062",
                                "text": "Jest on więc Gotem-Greutungiem; określenie zaś Gauta może oznaczać zarówno Gota szwedzkiego, jak też Juta z Danii. W tym czasie bowiem Duńczycy występują jeszcze oddzielnie obok Jutów, zamieszkujących północną część półwyspu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c18b040-66ae-4572-9f72-ab640325a698",
                        "source_entry_id": "aa8b3736-2e68-3a81-bf65-d594ecf134e2",
                        "source_sense_id": "eedffad0-0b29-33c0-9440-596124373062",
                        "target_lang_word": "Jute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc9a5c1-1a39-313a-acbb-f8733ad7b382",
                                        "entry_id": "617a393f-4d52-3837-a946-086ab6706d12",
                                        "glosses": [
                                            "A member of the Germanic tribe that existed in modern-day Denmark that invaded England about the same time as the Angles and the Saxons in the beginning of the Middle Ages, but were eventually integrated by the time of the Norman Conquest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9669c311-d1d6-4078-a28b-3aaa27bb00e3",
                                                "sense_id": "2cc9a5c1-1a39-313a-acbb-f8733ad7b382",
                                                "text": "No Jute is left to wield a sword to save this hoard. No one is left to swing the battle-ax skyward."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "442f18f2-2c2f-4d7e-a68c-2c635ed31c4e",
                        "source_entry_id": "aa8b3736-2e68-3a81-bf65-d594ecf134e2",
                        "source_sense_id": "eedffad0-0b29-33c0-9440-596124373062",
                        "target_lang_word": "Jüte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jüte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0905a34-b486-3795-998e-0e0cd1eaa868",
                                        "entry_id": "c3c80340-ef08-36f2-98e4-0ef2096f92c2",
                                        "glosses": [
                                            "Bewohner Jütlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6466194d-36a7-4f8c-9958-ab766772df34",
                                                "sense_id": "c0905a34-b486-3795-998e-0e0cd1eaa868",
                                                "text": "„Die Jüten […] waren ein germanischer Volksstamm auf der Halbinsel Jütland.“"
                                            },
                                            {
                                                "example_id": "00b45eff-aca4-4f33-8236-487cfe3c0105",
                                                "sense_id": "c0905a34-b486-3795-998e-0e0cd1eaa868",
                                                "text": "„Die germanischen Angeln, Sachsen und Jüten intensivierten nach dem Abzug der Römer ihre Unternehmungen auf der Insel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6685eaf3-c6b6-441c-9978-57f30bc482a9",
                        "source_entry_id": "aa8b3736-2e68-3a81-bf65-d594ecf134e2",
                        "source_sense_id": "eedffad0-0b29-33c0-9440-596124373062",
                        "target_lang_word": "ют",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ют",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2fed08-f883-3ced-80cf-af1cf5814e49",
                                        "entry_id": "fb932bb5-f25c-3279-815e-b6158e0a9adf",
                                        "glosses": [
                                            "морск. кормовая надстройка или кормовая часть верхней палубы судна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7616f638-f407-40dc-a170-70bcd6591665",
                                                "sense_id": "4e2fed08-f883-3ced-80cf-af1cf5814e49",
                                                "text": "Я пошёл в сие время на ют, сорвался в рулевую дыру и больно убился о крючья; почему принужден был сойти в каюту отдохнуть."
                                            },
                                            {
                                                "example_id": "8ef36f05-55b4-4fea-8472-b9d11b466240",
                                                "sense_id": "4e2fed08-f883-3ced-80cf-af1cf5814e49",
                                                "text": "— Флагман поднимает сигнал, — закричал с юта штурманский ученик."
                                            },
                                            {
                                                "example_id": "138cbc7b-c209-4117-b37f-81ffd8d2aaca",
                                                "sense_id": "4e2fed08-f883-3ced-80cf-af1cf5814e49",
                                                "text": "И вот, когда «Стрела» бросила якорь в каталонской бухте и мы начали штопать корму, Бернардито собрал нас всех ночью на юте и сказал «Добычу делить не будем!…»"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ют",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1eb0e250-ebbf-3729-a6c2-8cd0253f5c56",
                                        "entry_id": "66d8a85f-5d78-3006-b627-bab8778bd651",
                                        "glosses": [
                                            "истор. представитель одного из германских народов, населявших в древности Север Европы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a031c6-6e05-4bd9-8b9b-f3ff884f12a3",
                                                "sense_id": "1eb0e250-ebbf-3729-a6c2-8cd0253f5c56",
                                                "text": "Одним из надёжных свидетельств проживания славян в Висло-Одерском регионе в римское время стали лексические славизмы, достоверно фиксируемые в древнеанглийском языке, основу которого заложили диалекты англов, саксов и ютов."
                                            },
                                            {
                                                "example_id": "a0aabcc6-0f07-42da-a861-3fd03e32bb2a",
                                                "sense_id": "1eb0e250-ebbf-3729-a6c2-8cd0253f5c56",
                                                "text": "Полторы тысячи лет назад остготы, хазары, юты или лангобарды охраняли свою самобытность не менее ревностно, чем мы сейчас."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
