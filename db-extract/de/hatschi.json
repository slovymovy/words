                        "entry_id": "f1cc6d34-a653-324b-977b-dfd0283b699f",
                        "glosses": [
                            "bless you; gesundheit (used a response to someone’s sneezing, also sometimes one’s own)"
                        ],
                        "tags": [
                            "informal"
