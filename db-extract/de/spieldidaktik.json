                "senses": [
                    {
                        "sense_id": "146e0696-7392-3b60-a825-d46b8e04ec9e",
                        "entry_id": "ed8d02cd-a498-3c8a-bf3e-32b997349f05",
                        "glosses": [
                            "Wissenschaft vom Lehren und Lernen des Spiels, seiner Leitziele, Lernziele, Methoden und Organisationsformen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c7b058-e6ed-4e34-981c-3a6fa67a2b06",
                                "sense_id": "146e0696-7392-3b60-a825-d46b8e04ec9e",
                                "text": "„Neben der spieltheoretischen Erörterung des Regelspiels ist eine Einordnung der fachspezifischen Spieldidaktik in übergreifende spielpädagogische Zusammenhänge erforderlich.“"
                            },
                            {
                                "example_id": "e5e8476f-abab-4a50-ac91-01b964dd910e",
                                "sense_id": "146e0696-7392-3b60-a825-d46b8e04ec9e",
                                "text": "„Die Spieldidaktik spricht vom sogenannten Aufforderungscharakter von Gelände, Geräten, Materialien, eigenem Körper, Mitspielern, Situationen.“"
                            },
                            {
                                "example_id": "70ffdfe2-3f72-4792-8f3d-6ec7f27d8f0d",
                                "sense_id": "146e0696-7392-3b60-a825-d46b8e04ec9e",
                                "text": "„Zur Einführung in die Problematik referierte Marsal am Beispiel der Diskussion zwischen Moriya und Mineji die Debatte japanischer Erzieher der Zwanziger Jahre über die Spieldidaktik.“"
                            },
                            {
                                "example_id": "f8db7315-479c-4ab6-b0e9-99381772e5b4",
                                "sense_id": "146e0696-7392-3b60-a825-d46b8e04ec9e",
                                "text": "„Anfang und Kern des Spiellernprozesses müsse es ausmachen, solche reduzierten Spielformen anzubieten, durch deren Vollzug auch Spielanfänger in die Lage versetzt werden, die jeweilige Spielidee zu erfassen und sachgerecht zu gestalten. Im Grunde wurde damit die Vorgehensweise in der Spieldidaktik zu einem Problem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
