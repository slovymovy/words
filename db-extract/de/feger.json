                "translations": [
                    {
                        "translation_id": "881e1a67-138f-441c-ba5a-209dbe44682b",
                        "source_entry_id": "34f6bba2-be13-39b8-b417-769a67c93703",
                        "source_sense_id": "11cc01ee-5912-3c76-8d5d-fa5859e10998",
                        "source_sense_description": "umgangssprachlich: (junge) Frau, die leidenschaftlich und/oder regsam ist",
                        "target_lang_word": "live wire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "live wire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b09282fd-04d5-38f1-96eb-8340fb3c218c",
                                        "entry_id": "05a73765-b6e4-37bf-8b12-e094cc7bd39c",
                                        "glosses": [
                                            "An electrical wire through which there is a flow of electrical current."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1525051b-c37f-42fc-8b0e-ef11ab8bfe73",
                                                "sense_id": "b09282fd-04d5-38f1-96eb-8340fb3c218c",
                                                "text": "Two boys got electrocuted when a live wire fell on the auto-rickshaw in which they were sitting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                        "entry_id": "05a73765-b6e4-37bf-8b12-e094cc7bd39c",
                                        "glosses": [
                                            "An especially energetic, alert, or vivacious person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed169ef-4b83-4a47-b32c-25e9aa03c5d8",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "With his thin, eager face and darting hands he was more than a live wire - he was a whole bundle of live wires."
                                            },
                                            {
                                                "example_id": "546e2f80-84d5-47a4-b722-8924f6f2f7bb",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "Mr. Black is a kindly, gentle, fine individual, but as a leader, an up-to-date fellow, a go-getter—why he just doesn't know the first thing about it. . . . In a growing community like Douglaston we need a live wire."
                                            },
                                            {
                                                "example_id": "bd2b8a6e-75e9-4e26-94cb-b2333dfdeb3a",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "I can't sleep 'cause my bed's on fire / Don't touch me, I'm a real live wire"
                                            },
                                            {
                                                "example_id": "898150b8-77f9-446a-897f-dfa932960bdb",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "She was irresistible—a laughing, chattering live wire, never at a loss for a word."
                                            },
                                            {
                                                "example_id": "bccc6533-4231-4493-b1b3-c03b84302a77",
                                                "sense_id": "f4574498-b62c-3ed6-a836-a5a2d3931c9b",
                                                "text": "Ellen Page gives a star-making performance as a 16-year-old live wire who decides to go through with her pregnancy and seeks acceptably well-adjusted, wealthy, punk-rock loving parents for the unborn baby."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
