                "senses": [
                    {
                        "sense_id": "c04f613a-15ac-34b7-b9be-924130d98e7e",
                        "entry_id": "edc6a15e-bdf7-366b-baf0-69fa1f954398",
                        "glosses": [
                            "Rundgesang mit Wechsel zwischen Kehrreim und Strophe"
                        ],
                        "tags": [
                            "Musik",
                            "ursprünglich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3d25c80e-34d1-36c5-b8f1-e33222592e75",
                        "entry_id": "edc6a15e-bdf7-366b-baf0-69fa1f954398",
                        "glosses": [
                            "Instrumentalstück mit sich mehrfach wiederholendem Hauptthema, oft als Schlusssatz in Sinfonien"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "24ac9328-a013-45d6-8cb7-ef5d2b9dbc90",
                                "sense_id": "3d25c80e-34d1-36c5-b8f1-e33222592e75",
                                "text": "Der zweite Satz beginnt mit schallenden, fanfarenartigen Akkorden, die durch eine schnelle Entwicklung zum Hauptthema des Rondos führen."
                            },
                            {
                                "example_id": "a5696651-dbac-4907-9481-e210e9b37990",
                                "sense_id": "3d25c80e-34d1-36c5-b8f1-e33222592e75",
                                "text": "Neben Polonaisen, Variationen, Rondos und Potpourris für Violine und Orchester komponierte er zwei Streichquartette und ein Adagio et Polonaise für Klarinette und Orchester."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6cd5b0b-d0e4-43d8-9fda-7443fa6b3b0a",
                        "source_entry_id": "edc6a15e-bdf7-366b-baf0-69fa1f954398",
                        "source_sense_id": "c04f613a-15ac-34b7-b9be-924130d98e7e",
                        "source_sense_description": "Musik, ursprünglich: Rundgesang mit Wechsel zwischen Kehrreim und Strophe",
                        "target_lang_word": "rondo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rondo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48d8ac70-f2e2-3f36-84ce-894edafcd6e6",
                                        "entry_id": "2174106f-2425-35c1-979f-9b578aa64d70",
                                        "glosses": [
                                            "Forme musicale instrumentale basée sur une alternance entre une partie récurrente (le refrain) et plusieurs parties contrastantes (les couplets)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9349d14-9b33-44c3-92ea-28ced46c4664",
                                                "sense_id": "48d8ac70-f2e2-3f36-84ce-894edafcd6e6",
                                                "text": "Souplesse, homogénéité, aisance insolente sur toute la tessiture, Joyce DiDonato fera du rondo final \"Tanti affetti in tal momento\" un moment de véritable folie musicale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1351b432-b723-44a3-9d47-351d569f1803",
                        "source_entry_id": "edc6a15e-bdf7-366b-baf0-69fa1f954398",
                        "source_sense_id": "c04f613a-15ac-34b7-b9be-924130d98e7e",
                        "source_sense_description": "Musik, ursprünglich: Rundgesang mit Wechsel zwischen Kehrreim und Strophe",
                        "target_lang_word": "rondeau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rondeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f0ac130-a417-3792-9678-aaf1ecdb4887",
                                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                                        "glosses": [
                                            "Petite pièce de poésie composée de treize vers sur deux rimes, avec une pause au cinquième et une au huitième, et dont le premier mot ou les premiers mots appelés clausule se répètent après le huitième vers et après le dernier, sans faire partie des vers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "474b9822-267c-45b8-ac1b-24a91ee243bc",
                                                "sense_id": "5f0ac130-a417-3792-9678-aaf1ecdb4887",
                                                "text": "Vadius.– Peut-on voir rien d’égal aux sonnets que vous faites ?\nTrissotin.– Rien qui soit plus charmant que vos petits rondeaux ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034c7e7e-b070-3095-bd20-aecdd9ed234e",
                                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                                        "glosses": [
                                            "Forme musicale, vocale au départ, alternant un refrain et plusieurs couplets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b2e1afd-738f-4cb1-aba0-e5cafe17b50e",
                                                "sense_id": "034c7e7e-b070-3095-bd20-aecdd9ed234e",
                                                "text": "… et, après avoir bien tâtonné, je fus enfin dirigé, par les sons d’un joyeux rondeau, vers un appartement où le digne sacristain disait une messe au diable."
                                            },
                                            {
                                                "example_id": "9365e849-3342-4e91-abe4-980ffad05865",
                                                "sense_id": "034c7e7e-b070-3095-bd20-aecdd9ed234e",
                                                "text": "Certains genres musicaux étaient même de préférence chantés et dansés par des jeunes femmes (carole, airs de danse tels que rondeau, ductia, estampie, maierolies)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cab596ac-4165-3a68-8cfe-17ebf9c002b5",
                                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                                        "glosses": [
                                            "Grosse marmite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7ad0f32-d73f-3780-ba75-23c7e83a203d",
                                        "entry_id": "20b8376b-b9d0-30d3-ab78-9855c0d81aa9",
                                        "glosses": [
                                            "Poisson marin du genre Archosargus (famille des sparidés)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
