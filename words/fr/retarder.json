    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97055a68-643f-3f87-a9d5-8708c06d809a",
                    "sense_definition": "Faire perdre du temps à quelqu'un, le mettre en retard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ralentissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un appel imprévu m'a <w>retardé</w> ce matin avant de partir au travail.",
                            "target_lang_translations": {
                                "en": "An unexpected call <w>held</w> me <w>up</w> this morning before I left for work.",
                                "ru": "Неожиданный звонок <w>задержал</w> меня этим утром перед уходом на работу.",
                                "de": "Ein unerwarteter Anruf hat mich heute Morgen <w>aufgehalten</w>, bevor ich zur Arbeit aufbrach.",
                                "es": "Una llamada imprevista me <w>retrasó</w> esta mañana antes de salir al trabajo.",
                                "zh": "今天早上上班前，一个意外的电话<w>耽误</w>了我。"
                            }
                        },
                        {
                            "text": "Ne me <w>retarde</w> pas, je dois absolument attraper mon train dans dix minutes.",
                            "target_lang_translations": {
                                "en": "Don't <w>hold</w> me <w>up</w>, I absolutely have to catch my train in ten minutes.",
                                "ru": "Не <w>задерживай</w> меня, мне обязательно нужно успеть на поезд через десять минут.",
                                "de": "<w>Halte</w> mich nicht <w>auf</w>, ich muss unbedingt meinen Zug in zehn Minuten erwischen.",
                                "es": "No me <w>retrases</w>, tengo que coger el tren dentro de diez minutos sin falta.",
                                "zh": "别<w>耽误</w>我，我一定要赶上十分钟后开的火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ralentir"
                    ],
                    "common_phrases": [
                        "retarder quelqu'un"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone to lose time or be late by holding them up.",
                        "ru": "Заставить кого-либо потерять время или опоздать, задерживая его.",
                        "de": "Jemanden so aufhalten, dass er Zeit verliert oder zu spät kommt.",
                        "es": "Hacer que alguien pierda tiempo o llegue tarde al retenerlo.",
                        "zh": "使某人耽误时间，以致迟到或误事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hold up",
                                "target_lang_sense_clarification": "keeping someone from their plans"
                            },
                            {
                                "target_lang_word": "delay",
                                "target_lang_sense_clarification": "making someone arrive late"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "задержать человека в пути"
                            },
                            {
                                "target_lang_word": "держать",
                                "target_lang_sense_clarification": "разговорное: не отпускать"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufhalten",
                                "target_lang_sense_clarification": "jemanden am Weiterkommen hindern"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "retrasar",
                                "target_lang_sense_clarification": "uso general con personas"
                            },
                            {
                                "target_lang_word": "entretener",
                                "target_lang_sense_clarification": "retener a alguien un rato"
                            },
                            {
                                "target_lang_word": "demorar",
                                "target_lang_sense_clarification": "dejar a alguien esperando"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耽误",
                                "target_lang_sense_clarification": "使人误了时间"
                            },
                            {
                                "target_lang_word": "耽搁",
                                "target_lang_sense_clarification": "使人停留而迟到"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad7e9e45-944b-3dd5-834f-48078f489ce8",
                    "sense_definition": "Reporter une action ou un événement à une date ou une heure ultérieure ; différer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "report",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de <w>retarder</w> leur voyage à cause des mauvaises conditions météorologiques.",
                            "target_lang_translations": {
                                "en": "They decided to <w>postpone</w> their trip because of the bad weather conditions.",
                                "ru": "Они решили <w>отложить</w> поездку из-за плохих погодных условий.",
                                "de": "Sie haben beschlossen, ihre Reise wegen der schlechten Wetterbedingungen zu <w>verschieben</w>.",
                                "es": "Decidieron <w>aplazar</w> su viaje por las malas condiciones meteorológicas.",
                                "zh": "由于天气状况恶劣，他们决定<w>推迟</w>旅行。"
                            }
                        },
                        {
                            "text": "Nous devons <w>retarder</w> le début de la réunion en attendant l'arrivée du directeur.",
                            "target_lang_translations": {
                                "en": "We have to <w>delay</w> the start of the meeting while we wait for the director to arrive.",
                                "ru": "Нам придётся <w>отложить</w> начало совещания, пока не придёт директор.",
                                "de": "Wir müssen den Beginn der Besprechung <w>verschieben</w>, bis der Direktor eintrifft.",
                                "es": "Tenemos que <w>retrasar</w> el inicio de la reunión mientras esperamos la llegada del director.",
                                "zh": "在等经理到来的这段时间里，我们得<w>推迟</w>会议的开始。"
                            }
                        }
                    ],
                    "synonyms": [
                        "différer",
                        "reporter",
                        "ajourner"
                    ],
                    "antonyms": [
                        "avancer",
                        "hâter"
                    ],
                    "common_phrases": [
                        "retarder l'échéance",
                        "retarder un départ"
                    ],
                    "target_lang_definitions": {
                        "en": "To move an action or event to a later date or time; to put off.",
                        "ru": "Перенести действие или событие на более позднюю дату или время.",
                        "de": "Eine Handlung oder ein Ereignis auf einen späteren Zeitpunkt verlegen.",
                        "es": "Pasar una acción o un evento a una fecha u hora posterior.",
                        "zh": "把某个行动或事件改到之后的日期或时间。"
                    },
                    "translations": {
                        "en": [
