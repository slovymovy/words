                        "target_lang_word": "free time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "free time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dd99a4f-faf3-3cfb-bcd0-d00c00d6cb5a",
                                        "entry_id": "740d1986-5412-3dc3-95c8-a5ac6e4d492a",
                                        "glosses": [
                                            "Time when one is not working."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904f559c-779d-4d1a-8be3-51276f7764a8",
                                                "sense_id": "5dd99a4f-faf3-3cfb-bcd0-d00c00d6cb5a",
                                                "text": "I love to play football in my free time."
                                            },
                                            {
                                                "example_id": "82bf6824-c417-4688-96fd-08c418ce19a9",
                                                "sense_id": "5dd99a4f-faf3-3cfb-bcd0-d00c00d6cb5a",
                                                "text": "If you have some free time tomorrow, let’s go and watch a film."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aaf879e-6345-4759-9c17-fb8374ac66fb",
                        "source_entry_id": "1eb4a99b-16cf-3ab0-a665-5d7deea25c12",
                        "source_sense_id": "b6bb88e1-6399-31f2-95d5-12a620ed9aa6",
                        "target_lang_word": "time off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "time off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f017b4ad-51d4-3309-b340-ae63817ec7c0",
                                        "entry_id": "da5a0427-9ba0-392b-9f3a-f74998dec803",
                                        "glosses": [
                                            "A period of time where one is not required to work."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ee49eda-fb87-4e9e-b0a8-025a46d574b1",
                                                "sense_id": "f017b4ad-51d4-3309-b340-ae63817ec7c0",
                                                "text": "I've got some time off next week, so maybe we could meet up then?"
                                            },
                                            {
                                                "example_id": "f21445b3-c8ac-428c-8c54-87ede380c125",
                                                "sense_id": "f017b4ad-51d4-3309-b340-ae63817ec7c0",
                                                "text": "Many feel they cannot take time off as this would only serve to make things financially worse, and so they plough on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c8e8dd9-d8a3-4beb-8494-0cc9c162419d",
                        "source_entry_id": "1eb4a99b-16cf-3ab0-a665-5d7deea25c12",
                        "source_sense_id": "b6bb88e1-6399-31f2-95d5-12a620ed9aa6",
                        "target_lang_word": "Freizeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freizeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "172c7b30-f4e0-30d6-a57b-0c20f6d43c24",
                                        "entry_id": "45cded2e-e14b-358c-b5fc-c20726cf808b",
                                        "glosses": [
                                            "frei verfügbare Zeit"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7300ad80-5413-48ad-ae32-a05935a77b15",
                                                "sense_id": "172c7b30-f4e0-30d6-a57b-0c20f6d43c24",
                                                "text": "Zeitung lesen kannst du in deiner Freizeit."
                                            },
                                            {
                                                "example_id": "eb90162c-f052-43ba-95d0-6aecfdfee943",
                                                "sense_id": "172c7b30-f4e0-30d6-a57b-0c20f6d43c24",
                                                "text": "„Dragan ist Freigänger, arbeitet draußen für die Stadtwerke. Das bedeutet, man darf auch ein bisschen Freizeit draußen verbringen.“"
                                            },
                                            {
                                                "example_id": "60f713fb-b156-45a4-9878-692d148b85b3",
                                                "sense_id": "172c7b30-f4e0-30d6-a57b-0c20f6d43c24",
                                                "text": "„Alle Vorhaltungen, Überzeugungsversuche und Bitten halfen nichts, der Doktor blieb unbeirrbar und lernte in seiner Freizeit seelenruhig Arabisch, Kisuaheli und Mandingo-Dialekte.“"
                                            },
                                            {
                                                "example_id": "18078908-5151-4e0b-8764-21e89da64c78",
                                                "sense_id": "172c7b30-f4e0-30d6-a57b-0c20f6d43c24",
                                                "text": "„Gab es so etwas wie Freizeit, gingen viele auf die Kängurujagd.“"
                                            },
                                            {
                                                "example_id": "46a4aa73-af6b-444e-8c76-9d159c207833",
                                                "sense_id": "172c7b30-f4e0-30d6-a57b-0c20f6d43c24",
                                                "text": "„Während der Freizeit am Sonntagnachmittag wurde die eingegangene Post der vergangenen Woche verteilt, und sie durften Briefe schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f83bceb8-c094-3873-8cbb-b4b2440d2e01",
                                        "entry_id": "45cded2e-e14b-358c-b5fc-c20726cf808b",
                                        "glosses": [
                                            "organisierter mehrtägiger Ausflug einer bestimmten (Ziel-)Gruppe in Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b16919f-1812-435d-ae42-edcea3484172",
                                                "sense_id": "f83bceb8-c094-3873-8cbb-b4b2440d2e01",
                                                "text": "„1956 wurde ein Gelände in Westernohe im Westerwald gekauft, auf dem 1958 die erste Freizeit mit Behinderten durchgeführt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25cf65ee-a4e4-4c85-8c2a-bf4bad284d4d",
                        "source_entry_id": "1eb4a99b-16cf-3ab0-a665-5d7deea25c12",
                        "source_sense_id": "b6bb88e1-6399-31f2-95d5-12a620ed9aa6",
                        "target_lang_word": "Muße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                        "entry_id": "8cac3911-3483-39a2-8b3b-fab96c4df937",
                                        "glosses": [
                                            "arbeitsfreie Zeit für Erholung, Entspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62efbb36-c690-4d8f-a206-b6e526ed13de",
                                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                                "text": "Der Alltag lässt uns oft wenig Muße."
                                            },
                                            {
                                                "example_id": "56f824ab-6c15-49cf-9bd5-07cc05ab6c9f",
                                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                                "text": "Wir sollten uns mehr Muße gönnen."
                                            },
                                            {
                                                "example_id": "c7592a8b-9eb2-4d4c-a4b9-c93707b1c1ce",
                                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                                "text": "„Die Muße verliert, wie alle guten Dinge dieser Welt, sogleich den Reiz, wenn sie uns aufgenötigt wird.“"
                                            },
                                            {
                                                "example_id": "c9e42f89-68ba-4867-9c55-ec43d2027021",
                                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                                "text": "„Weil Simen Tjing nicht zu Hause war, hatten alle Frauen Muße und lustwandelten nun, um die Frühlingsmattigkeit zu verscheuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74e8dab8-af51-445b-b867-84aeedfa250a",
                        "source_entry_id": "1eb4a99b-16cf-3ab0-a665-5d7deea25c12",
                        "source_sense_id": "b6bb88e1-6399-31f2-95d5-12a620ed9aa6",
                        "target_lang_word": "loisir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loisir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab22a918-2390-3101-92e0-0c5901f2215a",
                                        "entry_id": "5b18830e-bfa0-38e1-856c-5252fc292e28",
                                        "glosses": [
                                            "Temps dont on peut disposer en dehors de ses occupations habituelles (emploi, gestion de la maison, éducation des enfants, etc.) et des contraintes qu’elles imposent (transports par exemple)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818fe8e0-a640-42d6-8e6e-a30eb1f3fd2c",
                                                "sense_id": "ab22a918-2390-3101-92e0-0c5901f2215a",
                                                "text": "« Le loisir ? fit-il. Mais, ma petite demoiselle, temps dont on peut librement disposer en dehors de ses occupations habituelles et des contraintes. »"
                                            },
                                            {
                                                "example_id": "d2bb7d84-66eb-47f8-9bc7-45b2c45972dc",
                                                "sense_id": "ab22a918-2390-3101-92e0-0c5901f2215a",
                                                "text": "Ces éminentes personnalités ont toutes été d’accord pour admettre que, dans vingt ans, l’homme consacrera le tiers de sa vie à son éducation, un deuxième tiers à travailler, et le troisième à profiter des fruits de son travail. D’où l’avertissement tiré des conclusions : « Les loisirs vont s’abattre sur l’homme non préparé comme une peste morale. Notre civilisation doit faire face à trois dangers graves : la guerre nucléaire, la surpopulation et le loisir. »"
                                            },
                                            {
                                                "example_id": "9f7e2601-c635-45ee-85fb-04bcf63d35b5",
                                                "sense_id": "ab22a918-2390-3101-92e0-0c5901f2215a",
                                                "text": "Ce loisir correspondait aux randonnées ou excursions à pied ou en canoë dans la nature sauvage, notamment en montagne et en forêt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9524dab9-6d9a-3d7e-9ee7-5afdceab62dd",
                                        "entry_id": "5b18830e-bfa0-38e1-856c-5252fc292e28",
                                        "glosses": [
                                            "Espace de temps suffisant pour faire quelque chose commodément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aef9b71d-e8ac-406e-be7b-260d9550356f",
                                                "sense_id": "9524dab9-6d9a-3d7e-9ee7-5afdceab62dd",
                                                "text": "Le manque de loisir nous prive de parler plus au long de cet excellent écrit; […]."
                                            },
                                            {
                                                "example_id": "f6e52ebc-08db-443f-9be3-ec49adf72785",
                                                "sense_id": "9524dab9-6d9a-3d7e-9ee7-5afdceab62dd",
                                                "text": "Pour être cultivé, il fallait des loisirs : une classe de gens peinait pour permettre à un très petit nombre de jouir de la vie, de s’instruire, et le jardin de la culture, des belles-lettres et des arts, restait une propriété privée où seuls pouvaient avoir accès non les plus intelligents, les plus aptes, mais ceux qui, depuis leur enfance, s’étaient trouvés à l’abri du besoin."
                                            },
                                            {
                                                "example_id": "d075385a-9c1d-4c52-b30e-3f5ab6018954",
                                                "sense_id": "9524dab9-6d9a-3d7e-9ee7-5afdceab62dd",
                                                "text": "Seuls les professionnels ont tout loisir, du prime matin au soir tombant, d’inspecter cinq mille — voire dix mille crins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
