                        "entry_id": "ec2dc388-7f38-3a04-b7dc-e136a76cb8bb",
                        "glosses": [
                            "Apostrophe dactylographique."
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a3223d55-6208-40ae-865f-70627de27f9b",
                                "sense_id": "eba0b403-7030-3932-8fe1-4c905b0c71e2",
                                "text": "Il convertit les impostrophes en apostrophes, les guillements en guillemets, il place des espaces insécables quand il faut, bref, essaye d’arranger aussi bien qu’il peut votre texte."
                            },
                            {
                                "example_id": "6656bdba-0a98-4645-a22c-75a4ee2334f4",
                                "sense_id": "eba0b403-7030-3932-8fe1-4c905b0c71e2",
                                "text": "Par conséquent, on voit aujourd’hui fleurir dans les publicités, sur les enseignes, dans les magazines, ces impostrophes et ces guillements qui tentent d’imiter les signes originaux."
                            }
                        ]
                    }
