                "senses": [
                    {
                        "sense_id": "ad0dcf81-da8f-3b31-9458-ef32a1991629",
                        "entry_id": "4965210f-da12-39a5-944d-5f35513adf69",
                        "glosses": [
                            "архит. крестьянский дом из брёвен или брусьев, удлинённый сруб которого разделён поперек на жилую избу и парадную горницу капитальной стеной, рубившейся одновременно с остальными стенами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5773a770-770e-4e0a-a12f-93888df15f1f",
                                "sense_id": "ad0dcf81-da8f-3b31-9458-ef32a1991629",
                                "text": "А Федор Капитонович меж тем и домик выстроил, да ещё какой — пятистенок, и не в чашу рубленный, как у других, а в лапу, с тёплыми сенями, с подвалом, просторными комнатами да горницами!"
                            }
                        ]
                    }
