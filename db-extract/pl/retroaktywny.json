                "senses": [
                    {
                        "sense_id": "14ee4c76-cf7a-338c-bd9c-0afef76b54b1",
                        "entry_id": "053b8a24-2547-303c-b8fb-61b183cfbfec",
                        "glosses": [
                            "taki, który obowiązuje z datą wsteczną, działa wstecz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "822ff480-0b17-4cf8-8cd5-963d2c3743ee",
                                "sense_id": "14ee4c76-cf7a-338c-bd9c-0afef76b54b1",
                                "text": "Uzasadniona jest retroaktywna kwalifikowalność kosztów poniesionych przez Łotwę ze skutkiem od dnia notyfikacji ognisk choroby oraz przez Litwę i Białoruś ze skutkiem od dnia rozpoczęcia działań nadzorczych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ae2e7d2-a6c8-4d4f-bb6b-81d79850e60f",
                        "source_entry_id": "053b8a24-2547-303c-b8fb-61b183cfbfec",
                        "source_sense_id": "14ee4c76-cf7a-338c-bd9c-0afef76b54b1",
                        "target_lang_word": "retroactive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retroactive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90575406-e590-3044-8771-b0dbb531d92b",
                                        "entry_id": "8e49bf04-0e18-3eb1-b22e-5b41e67e25e1",
                                        "glosses": [
                                            "Extending in scope, effect, application or influence to a prior time or to prior conditions"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b24db5d3-f805-4786-9df9-dc00e86580b5",
                                                "sense_id": "90575406-e590-3044-8771-b0dbb531d92b",
                                                "text": "Rather, he hoped there was some legal trickeration he could deploy to get a retroactive water right filed and end-run the opposition."
                                            },
                                            {
                                                "example_id": "3e3a3984-c0b2-4a21-8e0b-5b0465c8a1c3",
                                                "sense_id": "90575406-e590-3044-8771-b0dbb531d92b",
                                                "text": "Can such a child be ennobled by the passage of time, his struggles granted retroactive gravitas and his childish confusions rearticulated with adult clarity?"
                                            },
                                            {
                                                "example_id": "e4831c03-0d54-4e02-babe-31aec3ac42b6",
                                                "sense_id": "90575406-e590-3044-8771-b0dbb531d92b",
                                                "text": "Such assumptions can motivate expressions of cisgenderism such as retroactive misgendering (in which a person's past is described using language that disregards or contrasts with their current designation of their gender) […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f17f29e3-66c3-4d9f-820a-89efa9b6f543",
                        "source_entry_id": "053b8a24-2547-303c-b8fb-61b183cfbfec",
                        "source_sense_id": "14ee4c76-cf7a-338c-bd9c-0afef76b54b1",
                        "target_lang_word": "retroaktivní",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retroaktivní",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "06507f62-0ad2-32f9-af42-3ece172b28c5",
                                        "entry_id": "e03425c9-8c7c-32d6-beba-7db2708b7f68",
                                        "glosses": [
                                            "mající zpětnou platnost"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfc997b2-3677-42a9-9e07-049e7bdbcfaa",
                                                "sense_id": "06507f62-0ad2-32f9-af42-3ece172b28c5",
                                                "text": "Nálezy Ústavního soudu nemají retroaktivní účinky, ale působí do budoucna."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f44d4cbf-58a1-46e3-95a0-1c8cc7e370bd",
                        "source_entry_id": "053b8a24-2547-303c-b8fb-61b183cfbfec",
                        "source_sense_id": "14ee4c76-cf7a-338c-bd9c-0afef76b54b1",
                        "target_lang_word": "rétroactif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétroactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16d87966-d562-32e8-8512-bab8f78bb396",
                                        "entry_id": "678e657f-8087-38d6-91da-5ae0a53789dd",
                                        "glosses": [
                                            "Qui agit sur le passé. S’emploie surtout avec le mot effet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54504b2c-270b-48bc-b219-b3dfd78ef534",
                                                "sense_id": "16d87966-d562-32e8-8512-bab8f78bb396",
                                                "text": "L’âge, la beauté, la pâleur, la nationalité de cette enfant, l’impressionnaient beaucoup. Et la teinte de la robe jaune, si décolorée par de fréquents lavages, et cette mauvaise reprise des bas et et les talons éculés des chaussures et cet air de souffrance rétroactive !"
                                            },
                                            {
                                                "example_id": "53d7f099-8985-47f1-9457-3f73e6780b76",
                                                "sense_id": "16d87966-d562-32e8-8512-bab8f78bb396",
                                                "text": "13 octobre 44 – Un jour, à Philadelphie, Pennsylvania, il parlera peut-être de moi à sa femme, avec un sourire rétroactif et une voix un peu mélancolique, celle des occasions perdues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53771765-d424-3629-b428-75191db5695b",
                                        "entry_id": "678e657f-8087-38d6-91da-5ae0a53789dd",
                                        "glosses": [
                                            "Se dit d'une décision législative ou réglementaire dont l'exécution est étendue á une période antérieure à leur date d'adoption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941e6539-b3a8-4ee5-ac9a-8a720e16743c",
                                                "sense_id": "53771765-d424-3629-b428-75191db5695b",
                                                "text": "La loi ne dispose que pour l'avenir ; elle n'a point d'effet rétroactif."
                                            },
                                            {
                                                "example_id": "baf693c3-e7bb-41dc-b3de-010cc71a33fa",
                                                "sense_id": "53771765-d424-3629-b428-75191db5695b",
                                                "text": "La décision du juge qui prononce la nullité prend le nom d’annulation, elle est en principe rétroactive (…)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a4b4f83-fab7-4851-b9ae-bf5d2d6750b8",
                        "source_entry_id": "053b8a24-2547-303c-b8fb-61b183cfbfec",
