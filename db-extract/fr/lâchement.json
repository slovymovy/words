        "fr-extract.jsonl": [
            {
                "entry_id": "c368e9b6-c4d0-3cc7-ae34-9c6a7b1eaf5d",
                "word": "lâchement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4fccc59d-e226-39cd-b223-d53e8f81598a",
                        "entry_id": "c368e9b6-c4d0-3cc7-ae34-9c6a7b1eaf5d",
                        "glosses": [
                            "Avec mollesse, avec nonchalance, sans énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac43bb5f-f3de-4ce5-95a2-b2eaa74ca544",
                                "sense_id": "4fccc59d-e226-39cd-b223-d53e8f81598a",
                                "text": "Il travaille bien lâchement. - Il mène trop lâchement sa besogne. - Il y va si lâchement!"
                            }
                        ]
                    },
                    {
                        "sense_id": "9ef643a3-5909-37e6-ab90-a6f300f1dded",
                        "entry_id": "c368e9b6-c4d0-3cc7-ae34-9c6a7b1eaf5d",
                        "glosses": [
                            "Sans cœur et sans honneur, honteusement, avec bassesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1707b44-69b9-4a9a-ac94-cc606d31e028",
                                "sense_id": "9ef643a3-5909-37e6-ab90-a6f300f1dded",
                                "text": "Se conduire lâchement. - Trahir lâchement son ami. - Se venger lâchement. - Il s’est comporté lâchement dans cette circonstance."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
