            {
                "entry_id": "5b964571-45cb-36b0-91aa-c43b15a3e622",
                "word": "vacation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "06cf0b49-3bf9-492f-a019-f7ef9a63801e",
                        "entry_id": "5b964571-45cb-36b0-91aa-c43b15a3e622",
                        "tags": [
                            "plural"
                        ],
                        "form": "vacations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51ac8756-6724-380e-b411-c35ceda33215",
                        "entry_id": "5b964571-45cb-36b0-91aa-c43b15a3e622",
                        "glosses": [
                            "Durée de travail quotidien consacrée par règlement de justice ou d’administration publique à une affaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607b8743-458e-487e-8e59-4186f39fd214",
                                "sense_id": "51ac8756-6724-380e-b411-c35ceda33215",
                                "text": "Il y a eu dans cette affaire trois vacations d’experts."
                            },
                            {
                                "example_id": "c3e81587-05b7-49f4-98a4-16b0bce74b85",
                                "sense_id": "51ac8756-6724-380e-b411-c35ceda33215",
                                "text": "Le rapport de ce procès a duré tant de vacations."
                            },
                            {
                                "example_id": "88ce3375-a695-4fd9-bdcd-a257004dc721",
                                "sense_id": "51ac8756-6724-380e-b411-c35ceda33215",
                                "text": "Il y a eu ce jour-là deux vacations."
                            },
                            {
                                "example_id": "a7aea611-6f42-470f-8559-449a40799a24",
                                "sense_id": "51ac8756-6724-380e-b411-c35ceda33215",
                                "text": "Première, seconde vacation."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f65c15f-9a70-364c-be60-f54ee8e2393e",
                        "entry_id": "5b964571-45cb-36b0-91aa-c43b15a3e622",
                        "glosses": [
                            "Se dit de même des salaires, des honoraires qu’on paie aux gens d’affaires, aux gens de loi, aux membres d’un jury d’examen, etc."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7e635436-172f-4c21-9cda-be07e8a687e9",
                                "sense_id": "7f65c15f-9a70-364c-be60-f54ee8e2393e",
                                "text": "Ce notaire s’est fait payer tant de vacations pour cet inventaire."
                            },
                            {
                                "example_id": "a908c5ea-2ab5-45ea-a27d-a3d91af1d08b",
                                "sense_id": "7f65c15f-9a70-364c-be60-f54ee8e2393e",
                                "text": "Il lui faut tant pour ses salaires et vacations."
                            },
                            {
                                "example_id": "a0fddd8a-55be-4458-a885-505ab599c307",
                                "sense_id": "7f65c15f-9a70-364c-be60-f54ee8e2393e",
                                "text": "On lui a taxé ses vacations."
                            },
                            {
                                "example_id": "db14dc66-a337-4771-9888-0fe11345a81e",
                                "sense_id": "7f65c15f-9a70-364c-be60-f54ee8e2393e",
                                "text": "On a réglé ses vacations."
                            },
                            {
                                "example_id": "c7bec403-721f-449d-8857-ad7006878e3e",
                                "sense_id": "7f65c15f-9a70-364c-be60-f54ee8e2393e",
                                "text": "Chaque sapeur-pompier est payé en vacation pendant ses interventions, gardes et formations."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6e1be4b-d959-3658-b6f9-2478353436ab",
                        "entry_id": "5b964571-45cb-36b0-91aa-c43b15a3e622",
                        "glosses": [
                            "Cessation des séances des gens de justice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96fd5638-8f61-4123-aaf4-a620913dd926",
                                "sense_id": "e6e1be4b-d959-3658-b6f9-2478353436ab",
                                "text": "Le temps des vacations."
                            },
                            {
                                "example_id": "b05ba16a-3d7a-4050-8811-34dcccd5f515",
                                "sense_id": "e6e1be4b-d959-3658-b6f9-2478353436ab",
                                "text": "Durant les vacations de la Cour d’appel."
                            },
                            {
                                "example_id": "e321c2ca-70d0-44b0-97d0-3f4e4f3e0e11",
                                "sense_id": "e6e1be4b-d959-3658-b6f9-2478353436ab",
                                "text": "Chambre des vacations, Chambre composée d’un président et de plusieurs conseillers ou juges, tirés des différentes chambres, dans laquelle on administre la justice pendant les vacations."
                            }
                        ]
                    }
                ],
