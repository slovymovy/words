                                        "entry_id": "6e5e89a8-1c4b-3802-91cb-0b386774dc1f",
                                        "glosses": [
                                            "A fine net, placed around a bed, in a window opening, etc., to provide protection against mosquitoes and other insects, and the diseases carried by them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f286db53-d1df-4a70-8e9c-8e98b83e0fc9",
                                                "sense_id": "f7d2f427-b2c0-3cb4-be15-ea4b0daf0ba7",
                                                "text": "Child-trouble widened her brown eyes as she turned them on the shrouded figure stiffly outlined by the sheet, now partly screened by the mosquito-net."
                                            },
                                            {
                                                "example_id": "86fad765-d759-4801-b4c9-97208ed2a3a8",
                                                "sense_id": "f7d2f427-b2c0-3cb4-be15-ea4b0daf0ba7",
                                                "text": "In the room the mosquito net was down, ghost-grey in the falling light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
