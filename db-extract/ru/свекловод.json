                    },
                    {
                        "translation_id": "589878b9-5136-4e55-9938-4759b05acead",
                        "source_entry_id": "e817c32d-6d1f-3bd4-9671-8a3edff59462",
                        "source_sense_id": "30b3f827-c2a5-37ab-9ecc-af2483277a98",
                        "target_lang_word": "betteravier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betteravier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f9a59c-30b2-3e4b-ab51-aeb22e29edbe",
                                        "entry_id": "8a37c29c-ca45-36bb-9638-a46bec1ef5a9",
                                        "glosses": [
                                            "Relatif à la betterave et à sa culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b2b45e-a6b7-492f-aafe-843b619db2ca",
                                                "sense_id": "c1f9a59c-30b2-3e4b-ab51-aeb22e29edbe",
                                                "text": "Le but économique des syndicats betteraviers se concentre dans la production et dans la vente ; il peut se définir comme suit : propager parmi les membres les procédés qui permettent d'obtenir les rendements les plus riches […]."
                                            },
                                            {
                                                "example_id": "560a382a-c2bd-4f88-9fc5-54dc3e906634",
                                                "sense_id": "c1f9a59c-30b2-3e4b-ab51-aeb22e29edbe",
                                                "text": "Les quotas betteraviers ne sont pas attachés aux terres par le règlement communautaire qui les régit. Ils peuvent l'être par les accords interprofessionnels passés entre les sucreries et les planteurs."
                                            },
                                            {
                                                "example_id": "b55a2764-ce40-418a-8071-bd1938b14368",
                                                "sense_id": "c1f9a59c-30b2-3e4b-ab51-aeb22e29edbe",
                                                "text": "Dix fourgons de ce type furent construits par le TPT et systématiquement attelés à chaque convoi betteravier jusqu’à la fermeture du réseau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "betteravier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb6123b5-1fa8-316e-ab34-a945904aba70",
                                        "entry_id": "adef6d4f-134c-3cf3-83ec-591505c6ffbb",
                                        "glosses": [
                                            "Producteur de betteraves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e48b24-a537-4f27-a549-d544ad140a22",
                                                "sense_id": "eb6123b5-1fa8-316e-ab34-a945904aba70",
                                                "text": "En faisant si bon marché de la dignité et de l'honneur de la France, on appelait la betterave, si modeste encore, à quitter le jardin et le laboratoire pour s'emparer des champs et des usines, en même temps que dans chaque betteravier on se donnait un auxiliaire."
                                            },
                                            {
                                                "example_id": "b3697520-19ec-456f-85af-1c78c3772cda",
                                                "sense_id": "eb6123b5-1fa8-316e-ab34-a945904aba70",
                                                "text": "Depuis 1916-24, les betteraviers profitent de la « parité » : le même prix leur est payé par l’État pour leurs betteraves, qu'elles servent à fabriquer du sucre ou qu'il y ait distillation en alcool."
                                            },
                                            {
                                                "example_id": "9fc51749-8b6d-422e-bde1-aa0edcd67e4e",
                                                "sense_id": "eb6123b5-1fa8-316e-ab34-a945904aba70",
                                                "text": "Tant mieux, tant mieux ! commenta le betteravier, comme s’il se félicitait d’une prochaine amélioration du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c36798d4-6b06-3d69-90ef-caee2ab0c5b8",
                                        "entry_id": "adef6d4f-134c-3cf3-83ec-591505c6ffbb",
                                        "glosses": [
                                            "Camion de transport de betteraves."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaae138c-bcb7-42c9-9875-889be403dc40",
                                                "sense_id": "c36798d4-6b06-3d69-90ef-caee2ab0c5b8",
                                                "text": "Livré à lui-même, le camion est allé s'encastrer dans la remorque d'un ensemble routier transportant du bois. Le choc fut très violent. Il a défoncé la cabine du betteravier qui s'est immobilisée perpendiculairement à la benne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
