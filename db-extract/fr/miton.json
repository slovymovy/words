                        "glosses": [
                            "Panade à base de pain bouilli avec d’autres ingrédients."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7748f9f-3d53-45b1-b1b1-9671a78f9dd6",
                                "sense_id": "9a2dcf02-8950-395e-8baa-f92d6289c054",
                                "text": "Soupe aux mitons, sorte de panade faite avec des morceaux de pain."
                            },
                            {
                                "example_id": "92dc9c68-c1e4-4788-aedd-6e375b9b5c55",
                                "sense_id": "9a2dcf02-8950-395e-8baa-f92d6289c054",
                                "text": "Les malades ont toujours été bien soignés et respectés dans nos fermes. Pour eux, la bouillie était de rigueur, ainsi que l’omelette sucrée. Le Haut-Pays leur offrait le miochon ou miton, appelé aussi panade."
                            }
                        ]
                    }
