                        "entry_id": "b9b7c337-4476-3e07-ba19-98324ace40eb",
                        "glosses": [
                            "to learn (to completion, typically something involving rote memorisation)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10f1ac7e-4cb2-420d-806f-ba3a69943b30",
                                "sense_id": "8f405798-5cb0-3af6-913f-666cb94aecbb",
                                "text": "вы́учить язы́к",
                                "translation": "to learn a language",
                                "english": "to learn a language"
                            },
                            {
                                "example_id": "a4e7d699-58c8-4f00-804b-1cbee29a0caf",
                                "sense_id": "8f405798-5cb0-3af6-913f-666cb94aecbb",
                                "text": "вы́учить пе́сню",
                                "translation": "to learn a song",
                                "english": "to learn a song"
                            },
                            {
                                "example_id": "b83a2d1f-9df5-41a1-8608-397d5ef42f9a",
                                "sense_id": "8f405798-5cb0-3af6-913f-666cb94aecbb",
                                "text": "Сего́дня мы вы́учили ва́жный уро́к.",
                                "translation": "We learnt an important lesson today.",
                                "english": "We learnt an important lesson today."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bcafaa2-28c8-3d8d-aab4-e45dff381c0c",
                        "entry_id": "b9b7c337-4476-3e07-ba19-98324ace40eb",
                        "glosses": [
                            "to memorize"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63580f32-822e-4717-b123-3239c9bda901",
                                "sense_id": "3bcafaa2-28c8-3d8d-aab4-e45dff381c0c",
                                "text": "Он вы́учил бо́льше 10 ты́сяч книг.",
                                "translation": "He's memorised over 10,000 books.",
                                "english": "He's memorised over 10,000 books."
                            }
                        ]
                    }
