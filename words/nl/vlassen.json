{
    "word_family": [
        "vlas",
        "vlasvezel",
        "vlasakker",
        "vlasbloem"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc9abf70-cb27-3196-b3aa-d00456852e52",
                    "sense_definition": "vurig verlangen naar iets of proberen iets te bemachtigen (meestal met 'op')",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "begeerte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>vlassen</w> al maanden op een promotie binnen het bedrijf.",
                            "target_lang_translations": {
                                "en": "They have been <w>eyeing</w> a promotion within the company for months."
                            }
                        },
                        {
                            "text": "De dieven bleken te <w>vlassen</w> op de kostbare schilderijen in de galerie.",
                            "target_lang_translations": {
                                "en": "The thieves turned out to be <w>after</w> the valuable paintings in the gallery."
                            }
                        }
                    ],
                    "synonyms": [
                        "azen",
                        "loeren",
                        "verlangen",
                        "hopen"
                    ],
                    "common_phrases": [
                        "vlassen op"
                    ],
                    "target_lang_definitions": {
                        "en": "To eagerly desire something or try to obtain it (usually with 'op')"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to eye",
                                "target_lang_sense_clarification": "to look at or desire with interest"
                            },
                            {
                                "target_lang_word": "to have one's eye on",
                                "target_lang_sense_clarification": "to wish to acquire or achieve"
                            },
                            {
                                "target_lang_word": "to covet",
                                "target_lang_sense_clarification": "to desire eagerly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec071229-985a-36bb-b855-117db2ec307c",
                    "sense_definition": "het bewerken of bereiden van vlas",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vlasbewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze oude fabriek ging men vroeger handmatig <w>vlassen</w>.",
                            "target_lang_translations": {
                                "en": "In this old factory, people used to <w>process flax</w> manually."
                            }
                        },
                        {
                            "text": "De boeren moesten het geoogste gewas eerst drogen en daarna <w>vlassen</w>.",
                            "target_lang_translations": {
                                "en": "The farmers first had to dry the harvested crop and then <w>process the flax</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To process or prepare flax"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to process flax",
                                "target_lang_sense_clarification": "to prepare flax fibers"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ac8b8d8-feb3-3df9-9eb9-db6e0bf2a413",
                    "sense_definition": "gemaakt van of vervaardigd uit de vezels van de <w>vlas</w>plant",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg een lichte, <w>vlassen</w> jurk tijdens de warme zomerdag.",
                            "target_lang_translations": {
                                "en": "She wore a light, <w>linen</w> dress during the warm summer day."
                            }
                        },
                        {
                            "text": "In het museum hingen eeuwenoude <w>vlassen</w> doeken die goed bewaard waren gebleven.",
                            "target_lang_translations": {
                                "en": "In the museum hung centuries-old <w>flaxen</w> cloths that had been well preserved."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Made of or manufactured from the fibers of the flax plant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flaxen",
                                "target_lang_sense_clarification": "made of flax"
                            },
                            {
                                "target_lang_word": "linen",
                                "target_lang_sense_clarification": "made of flax fibers"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}