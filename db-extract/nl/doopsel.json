                                    },
                                    {
                                        "sense_id": "a7acfaa5-063e-34d7-a8ea-42b5eea28cc5",
                                        "entry_id": "9a7a3e4c-b72f-3a36-8d34-eacaefe8e4ac",
                                        "glosses": [
