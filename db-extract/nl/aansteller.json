                                    {
                                        "sense_id": "0a90ef45-daee-3137-81af-9f7ed95c0f8d",
                                        "entry_id": "7d68dc28-c789-3d36-ba2c-52fe2dee2e1e",
                                        "glosses": [
                                            "A particularly difficult question or puzzle."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f56eaeea-dd7e-3287-913d-3c0ba0302f56",
                                        "entry_id": "7d68dc28-c789-3d36-ba2c-52fe2dee2e1e",
                                        "glosses": [
                                            "Someone who asks a question or sets a problem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3ae2c5-9ab0-49f1-be86-e7ef00ef04a0",
                                                "sense_id": "f56eaeea-dd7e-3287-913d-3c0ba0302f56",
                                                "text": "Even as a child, she was a habitual poser of difficult questions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7d30dcc-f9e5-3c68-b8b5-e9af83e4c11a",
                                        "entry_id": "7d68dc28-c789-3d36-ba2c-52fe2dee2e1e",
                                        "glosses": [
                                            "Someone who, or something which, poses; a person who sets their body in a fixed position, such as for photography or painting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3a9edb5-587f-3e24-9232-877c940d3c55",
                                        "entry_id": "7d68dc28-c789-3d36-ba2c-52fe2dee2e1e",
                                        "glosses": [
                                            "A poseur; someone who affects some behaviour, style, attitude or other condition, often to impress or influence others."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d7a5358-10b6-48a9-8510-b3261dc70920",
                                                "sense_id": "d3a9edb5-587f-3e24-9232-877c940d3c55",
                                                "text": "\"My boyfriend, or I should say, ex-boyfriend, used to be all dark and brooding with long, black hair, but now?!\" [...] \"Um, I'm pretty sure uniforms don't work that way. I think your ex might just be a big poser.\" \"A fact I would be blissfully unaware of if not for these damn uniforms!\""
                                            },
                                            {
                                                "example_id": "7a76c598-882e-4927-849e-2b8cc5c66641",
                                                "sense_id": "d3a9edb5-587f-3e24-9232-877c940d3c55",
                                                "text": "Started hormones and these bitches called me a trans poser / They can kill themselves, I'm turning up like a transposer"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebd4c813-371a-44a4-9749-3de68283ed62",
                        "source_entry_id": "aae24573-dbce-3ed2-b07c-330332a1647e",
                        "source_sense_id": "69797c7a-4acd-3408-b583-d5fff0b0c0c6",
                        "source_sense_description": "iemand die zich aanstelt",
                        "target_lang_word": "poseur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poseur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ee2c314-c543-3389-96cb-26d9f11c31b8",
                                        "entry_id": "bdb72c55-fc94-36fb-8dc7-1e6f8e0d2a4b",
                                        "glosses": [
                                            "One who affects some behaviour, style, attitude or other condition, often to impress or influence others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9464c211-f32a-4baa-bebc-159403833a3a",
                                                "sense_id": "4ee2c314-c543-3389-96cb-26d9f11c31b8",
                                                "text": "He pretends he's an artist, but he's just a poseur."
                                            },
                                            {
                                                "example_id": "0832c589-54fa-4d38-ace3-d2e596af3113",
                                                "sense_id": "4ee2c314-c543-3389-96cb-26d9f11c31b8",
                                                "text": "She only dresses like that because she thinks she is getting the boys' attention; she's such a poseur."
                                            },
                                            {
                                                "example_id": "ac318f75-0c2c-4067-8c40-f83c86a70af6",
                                                "sense_id": "4ee2c314-c543-3389-96cb-26d9f11c31b8",
                                                "text": "But he was also, what seems almost incompatible with this ferocious truthfulness, excessively self-conscious and morally attitudinising, a thin-skinned poseur."
                                            },
                                            {
                                                "example_id": "b8d5edb7-8aa2-4e03-b052-4e23034761bb",
                                                "sense_id": "4ee2c314-c543-3389-96cb-26d9f11c31b8",
                                                "text": "I am a poseur and I don't care / I like to make people stare"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d9d0606-bb35-42ed-a84a-d2a41c5598aa",
                        "source_entry_id": "aae24573-dbce-3ed2-b07c-330332a1647e",
                        "source_sense_id": "69797c7a-4acd-3408-b583-d5fff0b0c0c6",
                        "source_sense_description": "iemand die zich aanstelt",
                        "target_lang_word": "cabotin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabotin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "363c6de8-5edf-3e0c-aee8-e1ca99501ecd",
                                        "entry_id": "eeda2502-a502-317c-a5ed-2c05fb991530",
                                        "glosses": [
                                            "Comédien ambulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9a605af-b2d4-41e3-83f2-e9fc74733bce",
                                                "sense_id": "363c6de8-5edf-3e0c-aee8-e1ca99501ecd",
                                                "text": "Il nous vint une troupe de cabotins."
                                            },
                                            {
                                                "example_id": "2c9fcca3-af3b-4924-b32b-654343060932",
                                                "sense_id": "363c6de8-5edf-3e0c-aee8-e1ca99501ecd",
                                                "text": "Le rapide entre dans la nuit comme dans un tunnel de douze heures et halète pour la franchir. C’est le plus rapide des rapides du soir, c’est une force de la nature, il emporte avec lui comme un orage des germes de toutes les énergies, des boutures de toutes les races. S’il versait sa cargaison dans une plaine, il y naîtrait peut-être une fabuleuse New York avec ses banques, ses cinémas, ses cabotins…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6abe2947-07c8-32a8-8440-658bf1c8bcb0",
                                        "entry_id": "eeda2502-a502-317c-a5ed-2c05fb991530",
                                        "glosses": [
                                            "Comédien sans talent."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "544c8d40-3fd5-4ba9-801e-dd45c74ffd89",
                                                "sense_id": "6abe2947-07c8-32a8-8440-658bf1c8bcb0",
                                                "text": "Très épris de théâtre, et pourvu de remarquables dons comiques, il travailla d’abord pour être acteur, se destinant au Théâtre-Français ; mais, dégoûté par les cabotins pontifiants qu’il était obligé de rencontrer, il se fit acteur de mélodrame et parut, dans des pièces de cape et d’épée, sur les scènes de province et de quartier."
                                            },
                                            {
                                                "example_id": "1528f7c9-ab53-4c3a-a883-3ca54363c84b",
                                                "sense_id": "6abe2947-07c8-32a8-8440-658bf1c8bcb0",
                                                "text": "Des cabotins, pour la plupart, cabotins, pantins, plaisantins.\nIl y avait une hiérarchie chez les artistes. Les chanteurs occupaient le haut de l’affiche, suivis par les comiques, venaient ensuite les danseuses, toujours ravissantes, puis enfin les prestidigitateurs et les dresseurs d’animaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98d5d714-7a88-3fc4-9ca8-28c8b22d9509",
                                        "entry_id": "eeda2502-a502-317c-a5ed-2c05fb991530",
                                        "glosses": [
                                            "Celui qui affecte dans la vie privée des attitudes de théâtre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3142de55-93df-4316-b209-6271816e82b5",
                                                "sense_id": "98d5d714-7a88-3fc4-9ca8-28c8b22d9509",
                                                "text": "Le cabotinage est roi, tellement roi que personne ne peut s’en passer. Les hommes les plus supérieurs sont obligés de devenir cabotins eux-mêmes pour faire triompher leurs meilleures idées. C’est par ce moyen qu’on sépare en deux un continent ; c’est par ce moyen qu’on devient député."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59328f0f-d06c-351d-9677-d77f85146bee",
                                        "entry_id": "eeda2502-a502-317c-a5ed-2c05fb991530",
                                        "glosses": [
                                            "Marionnette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1254d2c-892e-484a-b09b-4dc81c088fad",
                                                "sense_id": "59328f0f-d06c-351d-9677-d77f85146bee",
                                                "text": "« Marionnettes royales… marionnettes ! » criait à pleins poumons cet homme. Il est venu de Castlebar, le chef-lieu du comté de Mayo, ce montreur de cabotins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cabotin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef10a75e-8bd1-31c1-9dcc-b78baf2712a2",
