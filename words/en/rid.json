{
    "word_family": [
        "riddance",
        "rid-up",
        "rid-work"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4de4cfc-c3e0-3cbf-b4b4-79916473d705",
                    "sense_definition": "To free someone or something from an unwanted person, thing, or situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "remove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager is trying to <w>rid</w> the office of unnecessary paperwork.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер пытается <w>избавить</w> офис от ненужной бумажной волокиты.",
                                "zh": "新经理正试图把办公室里不必要的文书工作<w>清除</w>掉。"
                            }
                        },
                        {
                            "text": "I am finally glad to be <w>rid</w> of that old, broken car.",
                            "target_lang_translations": {
                                "ru": "Я наконец-то рад <w>избавиться</w> от этой старой сломанной машины.",
                                "zh": "我总算高兴自己<w>摆脱</w>了那辆又旧又坏的车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deliver",
                        "disencumber"
                    ],
                    "common_phrases": [
                        "be rid of",
                        "get rid of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освободить кого-либо или что-либо от нежелательного человека, вещи или ситуации.",
                        "zh": "使某人或某物摆脱不想要的人、事物或处境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избавлять",
                                "target_lang_sense_clarification": "освобождать от чего-то обременительного"
                            },
                            {
                                "target_lang_word": "избавить",
                                "target_lang_sense_clarification": "завершить процесс освобождения от чего-то"
                            },
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "делать свободным от помех"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摆脱",
                                "target_lang_sense_clarification": "使人或事物摆脱不想要的人、事物或处境"
                            },
                            {
                                "target_lang_word": "清除",
                                "target_lang_sense_clarification": "把不需要的东西或麻烦去掉"
                            },
                            {
                                "target_lang_word": "除去",
                                "target_lang_sense_clarification": "多用于 get rid of，表示去除、丢掉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e12bfb3-c4c5-3e04-a311-4ef2a87d3cd6",
                    "sense_definition": "To remove someone or something that is annoying or troublesome from a specific place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener worked hard to <w>rid</w> the weeds from the flower beds.",
                            "target_lang_translations": {
                                "ru": "Садовник усердно трудился, чтобы <w>очистить</w> клумбы от сорняков.",
                                "zh": "园丁努力把花坛里的杂草<w>清除</w>掉。"
                            }
                        },
                        {
                            "text": "They managed to <w>rid</w> the camp of pests before the guests arrived.",
