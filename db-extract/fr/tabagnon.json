                        "examples": [
                            {
                                "example_id": "e19bdb5d-dbbd-486b-ac37-bb0e4ce9de4a",
                                "sense_id": "bfdd00e0-2017-3199-9495-1e0131f13954",
                                "text": "J’aimerais bien que tu appropries ton tabagnon, c’est tellement sale !"
                            }
                        ]
                    },
                    {
                        "sense_id": "8e0231d3-6d5d-3c60-8ceb-977cb827d2fa",
                        "entry_id": "72fcb4a4-362a-3305-92cf-f0aa3989126d",
                        "glosses": [
                            "Plate-forme sur un bateau de joutes lyonnaises."
                        ],
                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "243c3bdf-c102-4ec5-a45f-5e80187fc373",
                                "sense_id": "8e0231d3-6d5d-3c60-8ceb-977cb827d2fa",
                                "text": "Glaudius ! C’est ton tour ! Grimpe sur le tabagnon !"
                            },
                            {
                                "example_id": "f91d230f-a1fa-4c66-b07b-7debd7303f0d",
                                "sense_id": "8e0231d3-6d5d-3c60-8ceb-977cb827d2fa",
                                "text": "Par exemple, le tabagnon est assez long et presque horizontal, car, au lieu de se tenir à peu près debout, comme les jouteurs cettois, les jouteurs lyonnais se fendent à la manière des escrimeurs."
                            },
                            {
                                "example_id": "7102bd97-e5c3-4575-8898-82059780c4c0",
                                "sense_id": "8e0231d3-6d5d-3c60-8ceb-977cb827d2fa",
                                "text": "Seriez-vous prêt à monter sur un tabagnon avec les jouteurs lyonnais de Confluent ? Nous vous laissons choisir la couleur de votre bateau, mais je vous confirme que pendant une Joute, les mulatins savent croiser les lances !"
                            }
                        ]
                    },
                    {
                        "sense_id": "1c3a7b0f-fbf8-3b56-9c04-5ccc5fce747c",
                        "entry_id": "72fcb4a4-362a-3305-92cf-f0aa3989126d",
                        "glosses": [
                            "Nom donné à certains centres de l'École des Arts et Métiers."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "222dc415-9d1f-41ee-8b22-b598e012b1da",
                                "sense_id": "1c3a7b0f-fbf8-3b56-9c04-5ccc5fce747c",
                                "text": "On a souvent parlé de la belle vie\nQue les Gadz'Arts mènent au Tabagnon\nTous les pékins du pays nous envient\nEt voudraient bien que nous les invitions."
                            }
                        ]
                    }
