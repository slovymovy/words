                            {
                                "target_lang_word": "kategorik olarak",
                                "target_lang_sense_clarification": "kararlı bir şekilde (genellikle ret durumunda)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "absolut",
                                "target_lang_sense_clarification": "vollkommen, gänzlich"
                            },
                            {
                                "target_lang_word": "kategorisch",
                                "target_lang_sense_clarification": "entschieden, besonders bei Ablehnung"
                            },
                            {
                                "target_lang_word": "durchaus",
                                "target_lang_sense_clarification": "in jeder Hinsicht, völlig"
                            }
                        ]
