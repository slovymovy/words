                        "cross_references": [
                            {
                                "target_word": "Emission",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "846b0b46-63b3-3add-a0ae-43e4ae79bfdb",
                                        "entry_id": "22a61f52-4bad-3a6e-8e88-88aeef3cff0d",
                                        "glosses": [
                                            "Ausgabe neuer Wertpapiere"
                                        ],
                                        "tags": [
                                            "Bankwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a63e232-9d9e-4aef-8bc5-6ebad3bc866e",
                                                "sense_id": "846b0b46-63b3-3add-a0ae-43e4ae79bfdb",
                                                "text": "Die Marktchancen für die Emission neuer Wertpapiere dürften derzeit gering sein."
                                            },
                                            {
                                                "example_id": "28e39021-2921-4784-9679-4c444d8e0b2b",
                                                "sense_id": "846b0b46-63b3-3add-a0ae-43e4ae79bfdb",
                                                "text": "„Durch die massive Emission fiel ihr Kurs schnell unter den Nennwert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "170dc2ff-287c-3cff-b8ee-e79f369ce107",
                                        "entry_id": "22a61f52-4bad-3a6e-8e88-88aeef3cff0d",
                                        "glosses": [
                                            "Ausgabe neuer Briefmarken"
                                        ],
                                        "tags": [
                                            "Postwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d37a9379-f5bb-45db-b72d-37542a6c08d5",
                                                "sense_id": "170dc2ff-287c-3cff-b8ee-e79f369ce107",
                                                "text": "Die Deutsche Post legt jedes Jahr recht viele neue Emissionen auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3171aecb-5530-3d95-bce9-1c2d139d8624",
                                        "entry_id": "22a61f52-4bad-3a6e-8e88-88aeef3cff0d",
                                        "glosses": [
                                            "Ausstoß von Umweltbelastungen wie Abgasen, Lärm, Schadstoffen"
                                        ],
                                        "tags": [
                                            "Umwelt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "118d5155-568f-477d-83ec-8d2b165294e5",
                                                "sense_id": "3171aecb-5530-3d95-bce9-1c2d139d8624",
                                                "text": "Die Rechte für Emissionen werden inzwischen gehandelt."
                                            },
                                            {
                                                "example_id": "32e4242b-8738-4524-8c34-81ee6ee138d8",
                                                "sense_id": "3171aecb-5530-3d95-bce9-1c2d139d8624",
                                                "text": "„Der Energieverbrauch sinkt, die Emissionen nicht. Deutschland hat 2022 fast genauso viel CO₂ ausgestoßen wie im Jahr zuvor.“"
                                            },
                                            {
                                                "example_id": "db53150e-b2b6-4f8a-bec8-5bd208cbc666",
                                                "sense_id": "3171aecb-5530-3d95-bce9-1c2d139d8624",
                                                "text": "[Klimaschädliche Gase:] „»Wir müssen bei den Emissionen auf null kommen, schlimmer noch, eigentlich auf minus irgendwas.«“"
                                            },
                                            {
                                                "example_id": "aa2013aa-1e8e-40fd-8118-0ff86b18c741",
                                                "sense_id": "3171aecb-5530-3d95-bce9-1c2d139d8624",
                                                "text": "[Fußball-WM 2022 in Katar:] „Nach Angaben der Veranstalter werden alle verursachten Emissionen durch den Kauf von Klimazertifikaten kompensiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "13ac82fc-2be5-32b7-833e-3aa1095e88e8",
                                        "entry_id": "22a61f52-4bad-3a6e-8e88-88aeef3cff0d",
                                        "glosses": [
                                            "Aussendung von elektromagnetischen Teilchen oder Wellen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91eb5158-5b50-4c79-9644-2661563fdf0f",
                                                "sense_id": "13ac82fc-2be5-32b7-833e-3aa1095e88e8",
                                                "text": "Die Emission von elektrischer Energie findet zum Beispiel an einer Ionisationsröhre statt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "198623f4-526e-3c4a-a583-c27eb29253bf",
                                        "entry_id": "22a61f52-4bad-3a6e-8e88-88aeef3cff0d",
