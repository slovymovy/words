                "senses": [
                    {
                        "sense_id": "2f7d3c24-dc04-3817-a704-812d9ecad025",
                        "entry_id": "cf92aa2b-e565-3cf9-aecf-9a7a0d153f6b",
                        "glosses": [
                            "das Ernten von Kartoffeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd2d9a37-b7fc-4818-8ac9-7b60f911b46d",
                                "sense_id": "2f7d3c24-dc04-3817-a704-812d9ecad025",
                                "text": "Durch das Hochwasser wurde die gesamte Kartoffelernte vernichtet."
                            },
                            {
                                "example_id": "0066ee0d-a153-4f5c-add9-96cadf392f05",
                                "sense_id": "2f7d3c24-dc04-3817-a704-812d9ecad025",
                                "text": "„Zur selben Zeit zeigte sich, dass alle Hoffnungen auf eine Entspannung der Versorgungslage durch eine gute Kartoffelernte reines Wunschdenken waren.“"
                            },
                            {
                                "example_id": "cffbe14c-541d-47b9-ac06-0fa791d69293",
                                "sense_id": "2f7d3c24-dc04-3817-a704-812d9ecad025",
                                "text": "„Die anhaltende Dürre setzt der Kartoffelernte zu.“"
                            },
                            {
                                "example_id": "e9111fd7-6869-4b2e-acdf-e5ed8b12a27a",
                                "sense_id": "2f7d3c24-dc04-3817-a704-812d9ecad025",
                                "text": "„Nach der anhaltenden Dürre könnten Pommes Frites künftig wegen der schlechten Kartoffelernte teurer werden.“"
                            },
                            {
                                "example_id": "a721801d-bdc6-4199-874b-a359dfbb8e72",
                                "sense_id": "2f7d3c24-dc04-3817-a704-812d9ecad025",
                                "text": "„Zum pommerschen Herbst gehört die Kartoffelernte, tausend Morgen allein für die Güterverwaltung von Rumbske, Rowen und Zedlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
