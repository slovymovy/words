                                "example_id": "39bab746-30f7-4506-b2be-3a469b1e0932",
                                "sense_id": "a36e2043-a4e2-3ed8-962c-a71101b47070",
                                "text": "ско́ро на́скоро",
                                "translation": "as quickly as possible",
                                "english": "as quickly as possible"
                            },
                            {
                                "example_id": "115a4097-f580-40b5-ac1d-5b0c9598ed91",
                                "sense_id": "a36e2043-a4e2-3ed8-962c-a71101b47070",
                                "text": "Я очути́лся в небольшо́й и не совсе́м опря́тной ко́мнате с бе́дной, сло́вно на́скоро расста́вленной ме́белью.",
                                "translation": "I found myself in a small and not over clean apartment, containing some poor furniture that looked as if it had been hurriedly set down where it stood.",
                                "english": "I found myself in a small and not over clean apartment, containing some poor furniture that looked as if it had been hurriedly set down where it stood."
                            }
                        ]
                    }
