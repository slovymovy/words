                    "frequency": "High",
                    "semantic_group_id": "beseitigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit diesem speziellen Mittel lassen sich alte Flecken leicht aus dem Teppich <w>entfernen</w>."
                        },
                        {
                            "text": "Die Ärztin konnte den kleinen Splitter schnell und schmerzlos aus dem Finger <w>entfernen</w>."
                        }
                    ],
                    "synonyms": [
                        "beseitigen",
                        "wegmachen"
                    ],
                    "antonyms": [
                        "anbringen",
                        "hinzufügen"
                    ],
                    "common_phrases": [
                        "Flecken entfernen",
                        "Schmutz entfernen"
                    ]
                },
                {
                    "sense_id": "64cdd66e-3123-3038-a73c-6e0bfe19e541",
                    "sense_definition": "sich von einem Ort oder einer Person wegbewegen und so den Abstand vergrößern",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wegbewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das große Schiff <w>entfernte</w> sich bei Sonnenuntergang langsam von der Insel."
                        },
                        {
                            "text": "Bitte bleiben Sie zusammen und <w>entfernen</w> Sie sich nicht von der Reisegruppe."
                        }
                    ],
                    "antonyms": [
