                                            {
                                                "example_id": "3e8f0a19-3af2-44a0-b41e-cee0c422e68a",
                                                "sense_id": "a9a10887-0ae7-3252-8ea3-838a09674e55",
                                                "text": "Toteż - zauważa Hegel - stoicyzm \"mógł wystąpić tylko w okresie powszechnego strachu i niewolnictwa, będącego zarazem okresem takiej kultury ogólnej (…), która kształtowanie i kulturę (…) podnosiła do poziomu myśli\"."
                                            }
