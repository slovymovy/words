                    {
                        "translation_id": "4969b4d0-999b-42df-b071-9bc5b7fec962",
                        "source_entry_id": "10fc14db-2675-32cb-b410-f78a010b20e1",
                        "source_sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
