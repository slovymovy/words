                    {
                        "sense_id": "d13005c4-de73-315c-a34d-9f34b416355a",
                        "entry_id": "7389e7e0-1436-394a-b604-8a893e950033",
                        "glosses": [
                            "Oberbegriff/Hyperonym eines Wortfeldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9153d2db-ef42-4304-a270-74a3e9042e8e",
                                "sense_id": "d13005c4-de73-315c-a34d-9f34b416355a",
                                "text": "„Ausgangspunkt ist ein Begriff, der als »Kern« des Feldes gilt. Sein Träger hat eine hyperonymische Funktion, ist das Archilexem.“"
                            },
                            {
                                "example_id": "34ac704f-9734-4ae4-8b22-3b20d53c2264",
                                "sense_id": "d13005c4-de73-315c-a34d-9f34b416355a",
                                "text": "„Solche übergeordneten Glieder eines Wortfeldes heißen Archilexeme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
