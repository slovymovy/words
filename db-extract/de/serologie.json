                                        "entry_id": "34af9d17-55e8-3418-850d-0b1a34d56413",
                                        "glosses": [
                                            "Étude des réactions entre anticorps et antigènes dans le sérum sanguin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5909da17-2c57-4b95-bbc7-ed0884aa1a2f",
                                                "sense_id": "13e8b723-95f2-3c91-9d82-e1ffff472e85",
                                                "text": "La sérologie s’effectue sur un prélèvement sanguin veineux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6fdbe8-aef4-3748-adf1-aa7d6958854e",
                                        "entry_id": "34af9d17-55e8-3418-850d-0b1a34d56413",
                                        "glosses": [
                                            "Résultat de cet examen sérologique, classement selon les caractéristiques du sérum."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba62c166-a174-4826-9dc1-cca1e1a5cf6a",
                                                "sense_id": "ac6fdbe8-aef4-3748-adf1-aa7d6958854e",
                                                "text": "La présence d'anticorps spécifiques à une maladie indique que la personne est entrée en contact avec l'agent pathogène. On dit que la personne a une sérologie positive, ou bien est séropositive."
                                            }
                                        ]
                                    }
                                ]
