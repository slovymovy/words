{
    "word_family": [
        "excepter",
        "exceptionnel",
        "exceptionnellement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9447c770-b8de-338f-938d-53c66dea4862",
                    "sense_definition": "Cas, personne ou chose qui ne se conforme pas à une règle générale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "derogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le monde doit participer à cette réunion sans <w>exception</w>."
                        },
                        {
                            "text": "Ce restaurant est généralement fermé le lundi, mais ils font une <w>exception</w> aujourd'hui."
                        }
                    ],
                    "synonyms": [
                        "dérogation",
                        "anomalie"
                    ],
                    "antonyms": [
                        "règle"
                    ],
                    "common_phrases": [
                        "à l'exception de",
                        "faire exception",
                        "sans exception"
                    ]
                },
                {
                    "sense_id": "62d030e8-e764-3feb-8e3a-675970539019",
                    "sense_definition": "Action d'excepter, de soustraire à l'application d'un principe commun.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "derogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le règlement intérieur du musée ne souffre aucune <w>exception</w> concernant la sécurité."
                        },
                        {
                            "text": "L'<w>exception</w> accordée aux résidents locaux a suscité beaucoup de mécontentement."
                        }
                    ],
                    "synonyms": [
                        "exclusion",
                        "dispense"
                    ],
                    "common_phrases": [
                        "ne souffrir aucune exception"
                    ]
                },
                {
                    "sense_id": "581898bf-443b-3256-88ad-c0b3c014b325",
                    "sense_definition": "Événement imprévu ou anomalie survenant pendant l'exécution d'un programme informatique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le système a levé une <w>exception</w> lorsque le fichier demandé était introuvable."
                        },
                        {
                            "text": "Le développeur doit capturer chaque <w>exception</w> pour éviter le plantage de l'application."
                        }
                    ],
                    "common_phrases": [
                        "lever une exception"
                    ]
                },
                {
                    "sense_id": "f08f76e1-0daf-3f58-9ca5-02c218bffc7b",
                    "sense_definition": "Moyen de défense juridique utilisé pour suspendre ou déclarer irrecevable une procédure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a soulevé une <w>exception</w> d'incompétence dès l'ouverture de l'audience."
                        },
                        {
                            "text": "Cette demande en justice a été bloquée par une <w>exception</w> de procédure recevable."
                        }
                    ],
                    "common_phrases": [
                        "soulever une exception"
                    ]
                }
            ]
        }
    ]
}