                    {
                        "translation_id": "5d4ccffe-f73e-4fb6-8181-8a10dded5fd3",
                        "source_entry_id": "8b6fb539-ef9b-36b1-89ca-3013dd513308",
                        "source_sense_id": "05b94bb2-dd6d-3304-99d3-6bc76bcd28ef",
                        "target_lang_word": "Regiment",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regiment",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a20436e7-7fb2-3563-8b06-a1ccb7075f80",
                                        "entry_id": "b8de3e54-114c-3993-9c54-52a57c604724",
                                        "glosses": [
                                            "mittelgroße militärische Formation (zwischen Brigade und Bataillon)"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d16f6e2-cb98-4c36-9731-70641952e836",
                                                "sense_id": "a20436e7-7fb2-3563-8b06-a1ccb7075f80",
                                                "text": "Ein Regiment der Infanterie der preußischen Armee um circa 1888 hatte, bei drei Bataillonen, eine Gesamtstärke von 2364 Offizieren, Unteroffizieren und Mannschaften."
                                            },
                                            {
                                                "example_id": "acdee07e-8f00-4479-a23a-fc87a2b27689",
                                                "sense_id": "a20436e7-7fb2-3563-8b06-a1ccb7075f80",
                                                "text": "„Weil erklärt, dass bei verschiedenen Regimentern Soldatenräte gebildet worden seien.“"
                                            },
                                            {
                                                "example_id": "59c928b8-c611-49b9-b4e4-11dece8d1142",
                                                "sense_id": "a20436e7-7fb2-3563-8b06-a1ccb7075f80",
                                                "text": "„In dieser Zeit kümmerte sich die Königin um ihr Regiment und half, wo sie nur konnte.“"
                                            },
                                            {
                                                "example_id": "3b55bb74-ff9a-431d-9df3-1e8b5aca5823",
                                                "sense_id": "a20436e7-7fb2-3563-8b06-a1ccb7075f80",
                                                "text": "„Offiziere fremder Regimenter waren herversetzt worden, die niemand kannte.“"
                                            },
                                            {
                                                "example_id": "99468858-9876-41c0-b293-b0787a337599",
                                                "sense_id": "a20436e7-7fb2-3563-8b06-a1ccb7075f80",
                                                "text": "„Dann kam der Einsatz des Regiments an der Ostfront.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1ce8b92-cdec-3006-b241-caa9422f1026",
                                        "entry_id": "b8de3e54-114c-3993-9c54-52a57c604724",
                                        "glosses": [
                                            "Herrschaft, Regierung"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43579115-d2cb-4a2b-8853-02bd57fad85e",
                                                "sense_id": "b1ce8b92-cdec-3006-b241-caa9422f1026",
                                                "text": "In der Nationalen Volksarmee herrschte noch ein strenges Regiment; da ging es härter zu als heute bei der Bundeswehr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
