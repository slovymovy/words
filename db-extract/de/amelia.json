                    {
                        "translation_id": "67cdb690-1b2b-416b-ac0a-a54ea3cdf031",
                        "source_entry_id": "3b0367a2-26ce-352f-9fe2-cb4a0077f0a0",
                        "source_sense_id": "a2bc3830-07cb-3372-86c5-b0cfdb013f46",
