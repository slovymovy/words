                "senses": [
                    {
                        "sense_id": "c5167738-0678-3072-a122-f7ff959f6c1c",
                        "entry_id": "1c1e956c-41f8-3f70-9584-ae670a7561b8",
                        "glosses": [
                            "Person, die von Beruf Schuhe reinigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6e84f0-2661-40f9-a4ee-54e67b1a747a",
                                "sense_id": "c5167738-0678-3072-a122-f7ff959f6c1c",
                                "text": "„Es war einmal ein gewisser Musje Morgenroth, der war Stiefelputzer, und zwar ein sehr vornehmer, denn er putzte nur die Stiefel von Geheimeräthen.“"
                            },
                            {
                                "example_id": "d325da46-f5e8-45e6-b387-182b7f811d98",
                                "sense_id": "c5167738-0678-3072-a122-f7ff959f6c1c",
                                "text": "„Stiefelputzer, Schuster und Kaufleute lauschten Schulter an Schulter den Brandreden, schrien »Viva!«“"
                            },
                            {
                                "example_id": "c0bb8dbf-d5e0-4d8a-a0df-b52b19dda622",
                                "sense_id": "c5167738-0678-3072-a122-f7ff959f6c1c",
                                "text": "„Man konnte sich aber von einem der vielen Stiefelputzer für 30 Rubel die Stiefel reinigen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
