                                        "sense_id": "83e13fd9-24f3-3aba-9226-e0cde16fad22",
                                        "entry_id": "92daab2e-cc45-34b2-8d6f-d2bfe9174fd1",
                                        "glosses": [
                                            "Petit instrument portatif qui sert à donner la longueur métrique d’une ligne tracée sur un plan, sur des cartes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b4dfc7a-fc2d-46fb-bae6-999731296349",
                                                "sense_id": "83e13fd9-24f3-3aba-9226-e0cde16fad22",
                                                "text": "Un curvimètre est un instrument composé d’une roulette et d’un compteur gradué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a9884b7-5605-47a9-8104-97376c519e3d",
                        "source_entry_id": "88320b76-bf0e-3a16-9d61-325d0825ec9a",
                        "source_sense_id": "8eba8146-0a4a-3d51-af3d-daf01d2c9077",
