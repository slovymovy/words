                "senses": [
                    {
                        "sense_id": "2ea6bb06-5233-3ccf-9820-6a4d2464ad1d",
                        "entry_id": "69736be9-d78e-3aa6-bed6-ce3bc068d200",
                        "glosses": [
                            "abbreviation of Solidarische Landwirtschaft (“community-supported agriculture”, literally “solidary agriculture”)"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "feminine",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0a714dc9-ab1d-4a20-baf0-31e631e8d0e3",
                                "sense_id": "2ea6bb06-5233-3ccf-9820-6a4d2464ad1d",
                                "text": "Für eine Etablierung derartiger Projekte sind gleichzeitig eine erhöhte Risikobereitschaft, Offenheit und Motivation von Landwirtinnen und Landwirten nötig, (zumindest teilweise) auf das Wirtschaftsmodell von SoLawi umzustellen."
                            },
                            {
                                "example_id": "1167b2ca-6dfd-4028-ab91-b233e5329a5b",
                                "sense_id": "2ea6bb06-5233-3ccf-9820-6a4d2464ad1d",
                                "text": "Solidarische Landwirtschaft (Solawi), das klingt ein bisschen nach Sozialismus. Treffender wäre eigentlich die wörtliche Übersetzung der englischen Bezeichnung \"Community Supported Agriculture (CSA)\", etwa \"eine von der Gemeinschaft unterstützte Landwirtschaft\"."
                            }
                        ]
                    }
