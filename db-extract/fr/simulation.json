                                            {
                                                "example_id": "52d1e0fb-edfe-4f76-beab-942b78c11353",
                                                "sense_id": "e80213cf-6974-3eaf-9900-a90b3619c6df",
                                                "text": "Я не знаю случаев симуляции умопомешательства до совершения преступления, но они могут встретиться.",
                                                "translation": "Je n'ai pas recueilli de faits où la folie ait été simulée avant l'accomplissement d'un crime."
                                            },
                                            {
                                                "example_id": "db005cfc-7015-434b-9449-77321ad9bed7",
                                                "sense_id": "e80213cf-6974-3eaf-9900-a90b3619c6df",
                                                "text": "Каторжного с мигренью или ишиасом легко заподозрить в симуляции и не пустить в лазарет; однажды я видел, как целая толпа каторжных просилась у смотрителя тюрьмы в лазарет и он отказывал всем, не желая разбирать ни больных, ни здоровых."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d303a164-0b59-4402-95ed-2f2a3e212e87",
                        "source_entry_id": "232ef181-0f29-3264-a71f-c4e515f30fc4",
                        "source_sense_description": "Action de simuler",
                        "target_lang_word": "simulace",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simulace",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a2f8e49b-216f-3167-9c35-061cfa7074a8",
                                        "entry_id": "8ae8b29c-5d55-3435-ab44-ecd459bd9566",
                                        "glosses": [
                                            "předstírání, napodobování"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "465810dd-9c39-4f7b-856e-d0084ff5dea2",
                                                "sense_id": "a2f8e49b-216f-3167-9c35-061cfa7074a8",
                                                "text": "K vyvinění používají široké spektrum forem a způsobů klamání: lhaní (zatloukání), zatajování, vymýšlení, překrucování skutečnosti, falešných alibi, předstírání, využívání falešných svědků, odstraňování nepohodlných svědků, kamufláží, simulace aj."
                                            },
                                            {
                                                "example_id": "90f09745-1dee-40e2-a588-62ce15bb76ac",
                                                "sense_id": "a2f8e49b-216f-3167-9c35-061cfa7074a8",
                                                "text": "Celkem bylo možno v češtině zaregistrovat přes 500 výrazů, které buď klamání přímo označují (lež, předstírání, falšování, podvod), nebo s ním úzce souvisí (simulace, vychytralost, pokrytectví)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c11dee4-4db0-3a5e-88b3-81663f414971",
                                        "entry_id": "8ae8b29c-5d55-3435-ab44-ecd459bd9566",
                                        "glosses": [
                                            "napodobení nějaké situace nebo děje, často prostřednictvím simulátoru nebo modelu"
                                        ],
                                        "tags": [
                                            "odborně"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31fb26fd-dd25-4fb1-a9e0-000eeda4437c",
                                                "sense_id": "9c11dee4-4db0-3a5e-88b3-81663f414971",
                                                "text": "Počítačové simulace dynamických oceánských teplot a atmosférických vztahů snad jednoho dne umožní meteorologům předpovídat zimní deště v Evropě s několikaletým předstihem, což by znamenalo vědecký milník mimořádného dosahu."
                                            },
                                            {
                                                "example_id": "d998efee-5a6d-4428-9b0c-a7a2c5d07266",
                                                "sense_id": "9c11dee4-4db0-3a5e-88b3-81663f414971",
                                                "text": "Během čtrnáctidenní simulace pěší zóny dopravní podnik zjistí technické a přepravní parametry, které potřebuje vědět pro případ vymístění dopravy z třídy Míru, k tomu provede i další průzkumy. Město tak získá přehled o názoru cestujících na změněný systémem dopravy, pohybu chodců po pěší zóně, návštěvnosti obchodů atd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b656023d-06a2-31cc-98b0-0f5a600d1d6e",
                                        "entry_id": "8ae8b29c-5d55-3435-ab44-ecd459bd9566",
                                        "glosses": [
                                            "vědomé předstírání nemoci nebo jejích příznaků"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "902acaa5-0371-466f-9975-14d242f5deab",
                                                "sense_id": "b656023d-06a2-31cc-98b0-0f5a600d1d6e",
                                                "text": "Finty a triky při vyšetřování podezřelých z trestních činů, při zjišťování simulace choroby ap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff123d4-1155-356b-812a-bab375ced9e0",
                                        "entry_id": "8ae8b29c-5d55-3435-ab44-ecd459bd9566",
                                        "glosses": [
                                            "předstírané právní jednání"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
