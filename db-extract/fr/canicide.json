                                    {
                                        "sense_id": "b1fb083a-db8f-32d0-ab10-e10f0d65f250",
                                        "entry_id": "3ad45ff1-5791-3053-8d7a-fe38c4a697d0",
                                        "glosses": [
                                            "Pertaining or inclined to canicide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d336b7de-8333-47fa-ba19-2f9d1ec04b89",
                                                "sense_id": "b1fb083a-db8f-32d0-ab10-e10f0d65f250",
                                                "text": "The canicidal properties of this modern reviver of the Cynophontis [a festival in Argos where dogs were killed] are well known."
                                            },
                                            {
                                                "example_id": "942afeb9-ae33-434a-8cf5-e2dda58538dd",
                                                "sense_id": "b1fb083a-db8f-32d0-ab10-e10f0d65f250",
                                                "text": "Dog Mutton.—The Journal of Commerce, world-renowned for its canicidal propensities, seems ambitious of an equally wide-spread canivorous reputation. It is not enough for that print that poor Tray be killed—it wants him to be eaten as well."
                                            },
                                            {
                                                "example_id": "749c9411-cb5b-4995-a260-1bbc36b3586c",
                                                "sense_id": "b1fb083a-db8f-32d0-ab10-e10f0d65f250",
                                                "text": "Echoing the canine theme of the new Mexican hit Amores Perros, Bong Joon-ho’s Barking Dogs Never Bite is a dark, twisted comedy about a deadbeat college lecturer who becomes obsessed with the relentless yapping of a neighbor’s pooch — and sets out to silence the animal once and for all. Set in a high-rise Seoul apartment building, the film is one of several canicidal tales featured in this year’s festival."
                                            }
                                        ]
