                        {
                            "text": "Это решение <необходимо> повлечет за собой изменения в структуре компании.",
                            "target_lang_translations": {
                                "en": "This decision will <necessarily> entail changes in the company structure.",
                                "zh": "这一决定<w>必定</w>会引发公司结构的变化。",
                                "nl": "Dit besluit zal <w>onvermijdelijk</w> leiden tot veranderingen in de bedrijfsstructuur.",
                                "pl": "Ta decyzja <w>nieuchronnie</w> pociągnie za sobą zmiany w strukturze firmy.",
                                "de": "Diese Entscheidung wird <w>zwangsläufig</w> Änderungen in der Unternehmensstruktur nach sich ziehen.",
                                "fr": "Cette décision entraînera <w>nécessairement</w> des changements dans la structure de l'entreprise.",
                                "it": "Questa decisione comporterà <w>inevitabilmente</w> dei cambiamenti nella struttura aziendale.",
                                "cs": "Toto rozhodnutí <w>nevyhnutelně</w> povede ke změnám ve struktuře společnosti.",
                                "tr": "Bu karar, şirket yapısında <w>kaçınılmaz olarak</w> değişikliklere yol açacaktır.",
                                "es": "Esta decisión conllevará <w>necesariamente</w> cambios en la estructura de la empresa."
                            }
                        }
