                    },
                    {
                        "sense_id": "1f4c510b-afc1-3be7-9374-89a4dec5b1ea",
                        "entry_id": "d7871c43-b752-3813-a224-9e1e4d5ec48e",
                        "glosses": [
                            "Stimulation, excitement (of a feeling, emotion etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f81a0ca-106e-4b56-b081-586f988bf0b1",
                                "sense_id": "1f4c510b-afc1-3be7-9374-89a4dec5b1ea",
                                "text": "It may indeed be said that these days brought on a high quickening of Maisie's direct perceptions, of her sense of freedom to make out things for herself."
                            }
