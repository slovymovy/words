                ],
                "senses": [
                    {
                        "sense_id": "ad36c000-3945-3678-a2da-660927ab4b5a",
                        "entry_id": "3013bc0d-2089-3bfc-aba7-95858e12614f",
                        "glosses": [
                            "Hexagone inscrit dans une conique dont les sommets sont reliés deux à deux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3304cfcd-9d5e-4746-80ab-ad06fb6dee9c",
                                "sense_id": "ad36c000-3945-3678-a2da-660927ab4b5a",
                                "text": "L’hexagramme de Pascal."
                            }
                        ]
                    },
                    {
                        "sense_id": "838e9a49-8bb7-3e06-9447-15e687001c4d",
                        "entry_id": "3013bc0d-2089-3bfc-aba7-95858e12614f",
                        "glosses": [
                            "Étoile de David ou sceau de Salomon, figuré par deux triangles équilatéraux tournés de 60°."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c6608451-0ee8-4967-ac3a-d70bcf30ea7f",
                                "sense_id": "838e9a49-8bb7-3e06-9447-15e687001c4d",
                                "text": "Car on sait que l’hexagramme appelé par les Arabes Sceau de Salomon, était dès le Moyen Age appelé Bouclier de David par les Juifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "397281e7-b89b-3467-97e8-12413fd1aa92",
                        "entry_id": "3013bc0d-2089-3bfc-aba7-95858e12614f",
                        "glosses": [
                            "Symbole constitué de six traits yin ou yang, résultant de la combinaison de deux trigrammes."
                        ],
                        "tags": [
                            "Ésotérisme"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5ce01a13-e60e-3677-abc3-3116cf60d972",
                        "entry_id": "3013bc0d-2089-3bfc-aba7-95858e12614f",
                        "glosses": [
                            "Monnaie byzantine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eb3c98f-7ee9-4b96-ac99-827e218f05a5",
                                "sense_id": "5ce01a13-e60e-3677-abc3-3116cf60d972",
                                "text": "Entre 615 après J.C. et le début du VIIIᵉ siècle, l’État byzantin émit une monnaie en argent, assez lourde, connue sous le nom d’hexagramme."
                            }
                        ]
                    }
