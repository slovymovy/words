                        "sense_id": "3f3d29e4-84eb-3663-a031-168615807172",
                        "entry_id": "dc247bb0-ab21-3976-8dc5-13a74a1eb964",
                        "glosses": [
                            "Sandstein, der sich aus Quarz und Feldspat zusammensetzt und als Pflasterstein verwendet wird"
                        ],
                        "tags": [
                            "speziell Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "5ee40c45-709f-4177-b9fd-a376aeb9508d",
                                "sense_id": "3f3d29e4-84eb-3663-a031-168615807172",
                                "text": "„In der Keramik werden unter Pegmatiten allerdings meist Feldspatsande verstanden, die durch Verwitterung von Gesteinen, z.B. Granit oder Gneis, entstanden sind. Dadurch kommt als weiteres häufiges Begleitmineral Kaolinit hinzu. Man findet sie auf primären und sekundären Lagerstätten, wobei letztere auch als Arkosen bezeichnet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
