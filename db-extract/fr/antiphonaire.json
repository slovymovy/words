        "fr-extract.jsonl": [
            {
                "entry_id": "05604ad9-ff10-36ff-9749-2013945eee8e",
                "word": "antiphonaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "712927dc-dfc0-4eeb-bac2-93482c5cdddd",
                        "entry_id": "05604ad9-ff10-36ff-9749-2013945eee8e",
                        "tags": [
                            "plural"
                        ],
                        "form": "antiphonaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a8528c8-c032-36e0-ad75-e891881227b6",
                        "entry_id": "05604ad9-ff10-36ff-9749-2013945eee8e",
                        "glosses": [
                            "Livre d’église où les antiennes et autres parties de l’office sont notées avec des notes de plain-chant."
                        ],
                        "tags": [
                            "Livre",
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "c5f002ed-a00d-45ad-bf3d-68d09004f009",
                                "sense_id": "2a8528c8-c032-36e0-ad75-e891881227b6",
                                "text": "… un vieux pupitre de chapelle, en fer forgé, un de ces antiques lutrins sur lesquels le diacre plaçait jadis l’antiphonaire."
                            },
                            {
                                "example_id": "f3c51eb8-7332-48eb-bec6-dd6d2e2c069b",
                                "sense_id": "2a8528c8-c032-36e0-ad75-e891881227b6",
                                "text": "Les bons moines pleureront leurs palimpsestes, incunables et antiphonaires disparus, mais ils loueront le Seigneur d’avoir détourné une main impie de leurs ciboires et de leurs ostensoirs."
                            },
                            {
                                "example_id": "6d6304bd-875d-43d0-aa01-67c3930d1e53",
                                "sense_id": "2a8528c8-c032-36e0-ad75-e891881227b6",
                                "text": "Dans ce coffre se trouvaient les objets de la chapelle que l'inventaire énumère : elle comportait deux croix de \"Limoges\", c'est-à-dire de cuivre émaillé dont Limoges avait la spécialité, deux aiguières, l'une de cuivre, l'autre d'étain, un missel, un antiphonaire, un psautier, un bréviaire, un ordinaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d6ba3e8-b245-48d2-92b8-9fb12108e6e4",
                        "source_entry_id": "05604ad9-ff10-36ff-9749-2013945eee8e",
                        "source_sense_id": "2a8528c8-c032-36e0-ad75-e891881227b6",
                        "target_lang_word": "Antiphonale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiphonale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe336fcb-7c81-3ec5-9857-7381f61a352f",
                                        "entry_id": "9dbb6e4c-dde0-3b8e-8274-7ea26d95a6a7",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d445dc28-04be-49c8-a42f-60454e7463ef",
                                                "sense_id": "fe336fcb-7c81-3ec5-9857-7381f61a352f",
                                                "text": "„Dann hoben die anderen an, dreißig Mönche in langen schwarzen Kutten, Dampf vor den Gesichtern. Der Neue hob das Buch, das Antiphonale, und brummte mit, Freitag, 15. Dezember 1989, 7180 Disentis, Schweiz: Herr, weit öffne ich meinen Mund und lechze nach deinen Geboten, denn nach ihnen hab ich Verlangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "586c0cb6-7949-494a-b0d7-f9bb50962846",
                        "source_entry_id": "05604ad9-ff10-36ff-9749-2013945eee8e",
