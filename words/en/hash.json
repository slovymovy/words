{
    "word_family": [
        "hashish",
        "hashrate",
        "rehash"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97bf2488-03f7-3b58-ae34-3eeb8690b3f4",
                    "sense_definition": "The # symbol, often used in computing, social media, or to indicate a number.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "symbols",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please enter your account number followed by the <w>hash</w> key.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, введите номер вашего счета, а затем клавишу <w>решётка</w>."
                            }
                        },
                        {
                            "text": "You can find the <w>hash</w> sign above the number three on most keyboards.",
                            "target_lang_translations": {
                                "ru": "На большинстве клавиатур символ <w>решётки</w> находится над цифрой три."
                            }
                        }
                    ],
                    "synonyms": [
                        "hash sign",
                        "number sign",
                        "pound sign",
                        "octothorpe /octothorn"
                    ],
                    "common_phrases": [
                        "hash key",
                        "hash symbol"
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ #, часто используемый в программировании, социальных сетях или для обозначения номера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решётка",
                                "target_lang_sense_clarification": "название символа #"
                            },
                            {
                                "target_lang_word": "знак номера",
                                "target_lang_sense_clarification": "использование символа для обозначения числа"
                            },
                            {
                                "target_lang_word": "октоторп",
                                "target_lang_sense_clarification": "техническое название символа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e25487b-0591-368d-9de3-ed00b31c6e5d",
                    "sense_definition": "A dish consisting of diced meat and potatoes that have been mixed together and fried.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For breakfast, he ordered a plate of corned beef <w>hash</w> with two eggs.",
                            "target_lang_translations": {
                                "ru": "На завтрак он заказал порцию <w>хэша</w> из солонины с двумя яйцами."
                            }
                        },
                        {
                            "text": "The chef prepared a savory beef <w>hash</w> using the leftovers from last night.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил аппетитное мясное <w>крошево</w>, используя остатки со вчерашнего вечера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "corned beef hash",
                        "beef hash",
                        "potato hash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блюдо из мелко нарезанного мяса и картофеля, смешанных и обжаренных вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хэш",
                                "target_lang_sense_clarification": "название блюда"
                            },
                            {
                                "target_lang_word": "крошево",
                                "target_lang_sense_clarification": "мелко нарезанная еда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "139bf09f-b327-3a8d-a45b-470d08b1c122",
                    "sense_definition": "A slang term for hashish, a drug derived from the cannabis plant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found a small amount of <w>hash</w> in the suspect's pocket.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла небольшое количество <w>гашиша</w> в кармане подозреваемого."
                            }
                        },
                        {
                            "text": "He was arrested for trying to sell <w>hash</w> near the park.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за попытку продать <w>хэш</w> рядом с парком."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for hashish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название гашиша, наркотического вещества, получаемого из конопли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хэш",
                                "target_lang_sense_clarification": "жаргонное сокращение от гашиш"
                            },
                            {
                                "target_lang_word": "гашиш",
                                "target_lang_sense_clarification": "полное название вещества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84005565-2dbd-34c6-b927-0bc07ed9b689",
                    "sense_definition": "A value or string of characters generated by a mathematical function to represent data.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system stores a <w>hash</w> of your password rather than the password itself.",
                            "target_lang_translations": {
                                "ru": "Система хранит <w>хеш</w> вашего пароля, а не сам пароль."
                            }
                        },
                        {
                            "text": "The checksum is a unique <w>hash</w> used to verify that the file is not corrupted.",
                            "target_lang_translations": {
                                "ru": "Контрольная сумма — это уникальный <w>хеш-код</w>, используемый для проверки того, что файл не поврежден."
                            }
                        }
                    ],
                    "synonyms": [
                        "checksum"
                    ],
                    "common_phrases": [
                        "hash function",
                        "password hash",
                        "unique hash"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical computing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значение или строка символов, созданная математической функцией для представления данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хеш",
                                "target_lang_sense_clarification": "результат хеширования данных"
                            },
                            {
                                "target_lang_word": "хэш-код",
                                "target_lang_sense_clarification": "уникальный идентификатор данных"
                            },
                            {
                                "target_lang_word": "контрольная сумма",
                                "target_lang_sense_clarification": "значение для проверки целостности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2463152b-9de2-3e59-b83e-53af55aea1f2",
                    "sense_definition": "A confused mess or a muddle of things.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager made a complete <w>hash</w> of the project schedule.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер устроил полную <w>путаницу</w> в графике проекта."
                            }
                        },
                        {
                            "text": "The document was a confused <w>hash</w> of unrelated ideas and statistics.",
                            "target_lang_translations": {
                                "ru": "Документ представлял собой бессвязную <w>мешанину</w> из несвязанных идей и статистики."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a hash of",
                        "confused hash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'make a hash of'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядок, путаница или мешанина из вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мешанина",
                                "target_lang_sense_clarification": "смесь разнородных вещей"
                            },
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "отсутствие порядка или ясности"
                            },
                            {
                                "target_lang_word": "неразбериха",
                                "target_lang_sense_clarification": "хаос в делах или мыслях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f23fdea9-5d03-330a-acf4-dc43b51cf0df",
                    "sense_definition": "To chop food, especially meat, into small pieces for cooking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe requires you to <w>hash</w> the leftover roast beef before frying it.",
                            "target_lang_translations": {
                                "ru": "По рецепту вам нужно <w>покрошить</w> остатки ростбифа перед тем, как обжаривать его."
                            }
                        },
                        {
                            "text": "She began to <w>hash</w> up the vegetables to prepare the morning meal.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>крошить</w> овощи, чтобы приготовить завтрак."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hash up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелко резать продукты, особенно мясо, для приготовления пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крошить",
                                "target_lang_sense_clarification": "мелко измельчать ножом"
                            },
                            {
                                "target_lang_word": "покрошить",
                                "target_lang_sense_clarification": "законченное действие по измельчению"
                            },
                            {
                                "target_lang_word": "шинковать",
                                "target_lang_sense_clarification": "нарезать мелкими кусочками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3c90be9-738a-347c-9869-869321034994",
                    "sense_definition": "To spoil or ruin something by doing it badly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am afraid I have <w>hashed</w> the entire presentation by forgetting the main points.",
                            "target_lang_translations": {
                                "ru": "Боюсь, я <w>испортил</w> всю презентацию, забыв основные моменты."
                            }
                        },
                        {
                            "text": "Don't let him <w>hash</w> it up like he did the last time.",
                            "target_lang_translations": {
                                "ru": "Не позволяй ему всё <w>завалить</w>, как он сделал в прошлый раз."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hash it up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испортить или провалить что-либо, сделав это плохо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завалить",
                                "target_lang_sense_clarification": "плохо справиться с делом"
                            },
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "сделать что-то негодным"
                            },
                            {
                                "target_lang_word": "напортачить",
                                "target_lang_sense_clarification": "допустить грубые ошибки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fccf3267-d843-3e17-a56b-0da4893bc27b",
                    "sense_definition": "To convert data into a fixed-size numerical value using an algorithm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server will <w>hash</w> the input string to create a secure identifier.",
                            "target_lang_translations": {
                                "ru": "Сервер будет <w>хешировать</w> входную строку для создания безопасного идентификатора."
                            }
                        },
                        {
                            "text": "It is standard practice to <w>hash</w> passwords before storing them in a database.",
                            "target_lang_translations": {
                                "ru": "Стандартной практикой является <w>хеширование</w> паролей перед их сохранением в базе данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hash the data",
                        "hash a password"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical computing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобразовывать данные в числовое значение фиксированного размера с помощью алгоритма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хешировать",
                                "target_lang_sense_clarification": "выполнять операцию хеширования"
                            },
                            {
                                "target_lang_word": "хэшировать",
                                "target_lang_sense_clarification": "вариант написания термина"
                            }
                        ]
                    }
                }
            ]
        },
        {
