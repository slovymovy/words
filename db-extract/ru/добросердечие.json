                    {
                        "translation_id": "8b131b4d-c7bc-4c3f-8385-a6462193c3b2",
                        "source_entry_id": "a2de275a-017a-3ba5-a4ff-71ae2528e95d",
                        "target_lang_word": "Gutherzigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gutherzigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7f0a99-0ffc-38e0-a371-f2bd24e7df86",
                                        "entry_id": "8d51d293-a9f4-3d63-943e-32c40be4a3a1",
                                        "glosses": [
                                            "Einstellung/Haltung, wohlwollend und freundlich gegenüber anderen Personen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d07745-20da-4d80-8210-bf3146c66e3b",
                                                "sense_id": "fc7f0a99-0ffc-38e0-a371-f2bd24e7df86",
                                                "text": "„Später dann, gegen Ende unseres Lebens, wenn uns das Leid des Alterns bedrängt, sind wir wieder stark von der Gutherzigkeit und heilenden Hinwendung Anderer abhängig.“"
                                            },
                                            {
                                                "example_id": "0a16ef46-d895-4efa-b820-de617fccc638",
                                                "sense_id": "fc7f0a99-0ffc-38e0-a371-f2bd24e7df86",
                                                "text": "„Narzisstische Personen handeln ebenfalls eher nicht aus Altruismus und Gutherzigkeit und sind wenig bescheiden.“"
                                            },
                                            {
                                                "example_id": "f3d684c6-a04b-4f98-8990-41506bf443eb",
                                                "sense_id": "fc7f0a99-0ffc-38e0-a371-f2bd24e7df86",
                                                "text": "„Ein zweites Erfordernis beim Lachen ist Gutherzigkeit, aber die Menschen lachen meist boshaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9cfb64e-e30a-4855-bace-63a45b0fe58e",
                        "source_entry_id": "a2de275a-017a-3ba5-a4ff-71ae2528e95d",
                        "target_lang_word": "bonté du cœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "87a41a3c-4752-44b3-b0da-59559e9541de",
                        "source_entry_id": "a2de275a-017a-3ba5-a4ff-71ae2528e95d",
                        "target_lang_word": "cordialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                        "entry_id": "bb893b3f-690c-346b-9e85-12dfce28c585",
                                        "glosses": [
                                            "Affection dont les manifestations attestent la sincérité, la vivacité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2470dab5-4124-4573-b078-fafb34468f3c",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "La plus franche cordialité régnait entre nous. Je passai là d’excellentes heures."
                                            },
                                            {
                                                "example_id": "d38dab9b-6bd4-47b0-8bd6-9995dde452e1",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "Le bruit des voix, des carafes, des fourchettes, et des gosiers qui poussaient le bœuf vers les estomacs, cette rumeur de cordialité qui monte d’une table où les bonnes entrées n’empêchent pas les conversations, leur tapait un peu dans la tête."
                                            },
                                            {
                                                "example_id": "6bde5b34-f0f6-4cab-b000-188e115b82fa",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "Lorsqu’au bout de quelques semaines Elhamy la remercia, avec une cordialité souriante, du bien qu’elle avait fait à son fils, une émotion sourde étreignit sa gorge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
