                        "examples": [
                            {
                                "example_id": "7146d428-d2ae-4902-9a5f-cb44e980b45c",
                                "sense_id": "6757c35f-cde9-33a0-84ab-8086eca85c96",
                                "text": "We hebben het gemeten: Evo van de Nederlandse illustrator en designer Jurian Möller is dertig meter lang. Het is dan ook niet zomaar een boek, het is een leporello. De leporello is de missing link tussen het boek en de accordeon: je kunt het helemaal openvouwen. En over missing links heeft Möller het hier: hij laat zien hoe de mens uit een amoebe kwam. Of andersom: hoe een amoebe uiteindelijk evolueerde tot de mens zoals wij die kennen. Want dat is het leuke aan een leporello: je kunt hem in twee richtingen lezen."
                            },
                            {
                                "example_id": "6ad96a54-710a-45ba-82c5-7ab6c7a248e8",
                                "sense_id": "6757c35f-cde9-33a0-84ab-8086eca85c96",
                                "text": "Sjoerd Knibbeler: Paper Planes. Fw: books. Vormgeving: Hans Gremmen. 25 euro. Leporello met foto's op karton van gevouwen papieren droomvliegtuigjes."
                            }
                        ]
                    }
