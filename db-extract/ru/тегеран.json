                "senses": [
                    {
                        "sense_id": "66cc20b7-9b30-3520-8967-f2f2cfd5a2e9",
                        "entry_id": "75a3c645-389c-3c15-8061-2db63cddd25b",
                        "glosses": [
                            "столица и крупнейший город Ирана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3330a265-7da4-4306-ad0b-94539a90ff8f",
                                "sense_id": "66cc20b7-9b30-3520-8967-f2f2cfd5a2e9",
                                "text": "Наконец, он отправился с супругою в Тегеран."
                            },
                            {
                                "example_id": "6916ceb3-ca1a-43d3-8d94-769406063504",
                                "sense_id": "66cc20b7-9b30-3520-8967-f2f2cfd5a2e9",
                                "text": "Ящики с лимонадом Логидзе отправлялись в Баку, оттуда морем шли в Персию и дальше караванным путём до самого Тегерана."
                            }
                        ]
                    },
                    {
                        "sense_id": "720df9f9-bafb-31b5-ae59-97b6ef4b08af",
                        "entry_id": "75a3c645-389c-3c15-8061-2db63cddd25b",
                        "glosses": [
                            "метоним., полит. правительство Исламской Республики Иран"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb75ace0-cdfd-453e-9b6c-670893520893",
                                "sense_id": "720df9f9-bafb-31b5-ae59-97b6ef4b08af",
                                "text": "Ранее Тегеран заявлял о намерении ограничить судоходство в Персидском заливе в случае военной угрозы."
                            },
                            {
                                "example_id": "09546e82-d365-40ac-922f-4fbe1b8aad5c",
                                "sense_id": "720df9f9-bafb-31b5-ae59-97b6ef4b08af",
                                "text": "С отменой меморандума планы поставок российского оружия Тегерану получают новую жизнь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6b2aae8-552d-4015-a9b2-be019387b0d5",
                        "source_entry_id": "75a3c645-389c-3c15-8061-2db63cddd25b",
                        "target_lang_word": "Teheran",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teheran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "463d89b8-dbcb-3150-8e34-6d551e64e59d",
                                        "entry_id": "8736e70e-92a5-370e-a168-77251d571499",
                                        "glosses": [
                                            "Dated spelling of Tehran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cefa14b2-8917-4a9f-8ace-80369efddd5a",
                                                "sense_id": "463d89b8-dbcb-3150-8e34-6d551e64e59d",
                                                "text": "This one stark fact stands out: Every agreement the Soviets entered into at Teheran in 1943 and Yalta in 1945, was ruthlessly broken, save for those palpably to their advantage. The same holds true for the Potsdam Conference of 1945."
                                            },
                                            {
                                                "example_id": "5d540c04-a645-4adf-9d89-5a0f2be47516",
                                                "sense_id": "463d89b8-dbcb-3150-8e34-6d551e64e59d",
                                                "text": "No tears need be shed for next year’s games at Teheran. Even if we should remain in the AGF, the Iranians would find ways to keep us out of competition, just as the Indonesians did at Jakarta in 1962."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9d53602-a57e-4c4b-bbbb-cb35bd3a9b7e",
