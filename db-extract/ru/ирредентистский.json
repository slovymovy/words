                "senses": [
                    {
                        "sense_id": "0d14bbd7-ce67-39fe-bb53-037458fcbca1",
                        "entry_id": "5ca6746e-edf0-34ec-940f-a408bd2736de",
                        "glosses": [
                            "полит. связанный, соотносящийся по значению с существительными ирредентист, ирредентизм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deb2a887-a250-497f-8032-a9717476a2d1",
                                "sense_id": "0d14bbd7-ce67-39fe-bb53-037458fcbca1",
                                "text": "Из этой воли и возникло ирредентистское движение ИРА."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b0e373a-a9ce-40be-aa32-377f39aae9ab",
                        "source_entry_id": "5ca6746e-edf0-34ec-940f-a408bd2736de",
                        "source_sense_id": "0d14bbd7-ce67-39fe-bb53-037458fcbca1",
                        "target_lang_word": "irrédentiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrédentiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0883c66b-3f2a-3b49-af72-f9578e7f0906",
                                        "entry_id": "e475be2d-0231-3a8a-ad0a-f2c836a7164a",
                                        "glosses": [
                                            "Personne qui professe l’irrédentisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8774865-69b4-44bf-8480-59670e99ed93",
                                                "sense_id": "0883c66b-3f2a-3b49-af72-f9578e7f0906",
                                                "text": "On peut en effet rapprocher de cette évolution de Slataper, l’itinéraire d’un irrédentiste de cinq ans son cadet et qui porte lui aussi un patronyme slave, plus précisément slovène, comme le matronyme d’Oberdank."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "irrédentiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                                        "entry_id": "4eca564c-47c6-36a9-8dc4-b3d06abc316c",
                                        "glosses": [
                                            "Relatif à l’irrédentisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e66612f6-ef6a-4ee9-8a24-e6b7486a24b4",
                                                "sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                                                "text": "La grande majorité des juifs étant irrédentiste et n’entendant nullement subir le joug germanique aussitôt après le traité de Francfort, un grand mouvement d’émigration se dessina."
                                            },
                                            {
                                                "example_id": "f8d995cd-332b-4412-ad1f-2381264ad566",
                                                "sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                                                "text": "Comme il n’est secondé que par une servante (Autrichienne, mais irrédentiste) et que nous sommes vingt clients, il s’empresse, bondit d’un bout à l'autre de la salle."
                                            },
                                            {
                                                "example_id": "a3be8062-e830-492f-8d27-b95ef69ee658",
                                                "sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                                                "text": "Mais écartons –pour le moment du moins- la conquête brutale de la joie. Ne risquons pas de tout gâter et de faire une Jacqueline irrédente"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
