                            "target_lang_translations": {
                                "en": "I have to go to the <w>hair salon</w> tomorrow to have my hair cut shorter."
                            }
                        },
                        {
                            "text": "De nieuwe <w>kapsalon</w> in de winkelstraat heeft een moderne inrichting.",
                            "target_lang_translations": {
