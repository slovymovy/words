                    {
                        "translation_id": "3e013b4b-6d64-4e27-92cc-de98d52257cf",
                        "source_entry_id": "d0b5c985-acfc-3cf0-acc8-2fd9e7770e28",
                        "source_sense_id": "c4211f63-d907-3204-a882-8676e7efac1b",
