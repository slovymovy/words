                    },
                    {
                        "translation_id": "d87520c3-91d2-4fff-8d36-ca2451e64cd8",
                        "source_entry_id": "1e9be929-66c6-39f2-a2e4-b96f5b89c9d4",
                        "source_sense_id": "6371d760-aece-3e00-a7f7-b5e1e54abc5a",
                        "source_sense_description": "mental lethargy or dullness",
                        "target_lang_word": "hébétude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hébétude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0ea3bc5-daeb-3944-af2f-e6a84c7518ee",
                                        "entry_id": "ac6d8cdd-41b7-3071-bbff-f79791b6c1d9",
                                        "glosses": [
                                            "Engourdissement des facultés cérébrales dans certaines maladies, l’anémie cérébrale, par exemple."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                        "entry_id": "ac6d8cdd-41b7-3071-bbff-f79791b6c1d9",
                                        "glosses": [
                                            "Apparence ou comportement d’une personne qui semble soudain engourdie ou sidérée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20bd804d-fbae-40e4-8fc7-ef4532a5b25f",
                                                "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                                "text": "La soudaineté chirurgicale de leur rupture le laissa stupide. Seul dans cette maison que leur couple, quasi conjugal, habitait depuis quelque vingt ans, il ne parvenait pas, au bout de huit jours, à s’évader de l’hébétude pour entrer dans le chagrin."
                                            },
                                            {
                                                "example_id": "ca54eaaf-6156-4e4a-8297-5d5cc3124a4d",
                                                "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                                "text": "Un monsieur, courant, une serviette sous le bras, le heurta sans ménagements et l’arracha à son hébétude."
                                            },
                                            {
                                                "example_id": "9c15547a-4944-43e8-a55e-6d9033559159",
                                                "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                                "text": "Il se tut et retomba dans son hébétude."
                                            },
                                            {
                                                "example_id": "86705cdd-5200-472e-964a-e4e8d0b87dab",
                                                "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                                "text": "Il la pénétrait bestialement, dans une hébétude sensuelle qui n'atteignait à la lucidité qu'à la minute où l'on voit, par une nuit d'été, la fusée d'un feu d'artifice fondre en un riche bouquet d'étoiles pâmées qui retombent au néant."
                                            },
                                            {
                                                "example_id": "09b2bde1-cb7a-4eba-8457-cce70a26feaf",
                                                "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                                "text": "Cette considération le plongea dans une sorte d’hébétude douloureuse."
                                            },
                                            {
                                                "example_id": "a6c8a6b4-d51b-4897-8a39-0961b0ea4ff1",
                                                "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                                "text": "De sa bouche lisse, Amédée souriait, repris par l’hébétude de l’enfance."
                                            },
                                            {
                                                "example_id": "24dd71ff-b9c5-4a8c-864d-9ef0344ed825",
                                                "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                                "text": "À présent, une émission télévisée fera l’affaire. La plus idiote conviendra. Ah – regarder pour regarder, sans alibi, sans désir, sans excuse ! C’est comme l’eau du bain : une hébétude qui vous engourdit d’un bien-être palpable."
                                            },
                                            {
                                                "example_id": "4d3cb753-563e-4af2-9d41-4562a80dc79c",
                                                "sense_id": "adc3eb99-7e9c-36f4-9798-a568539c8285",
                                                "text": "Pour une fois que j’ai l’occasion de parler de cette histoire… Elle a pourtant quelque chose d’une vieille putain réduite à l’hébétude par l’excès des hommes, cette histoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0ca259d-8b22-43b7-a731-14f6f64890a1",
                        "source_entry_id": "1e9be929-66c6-39f2-a2e4-b96f5b89c9d4",
                        "source_sense_id": "6371d760-aece-3e00-a7f7-b5e1e54abc5a",
                        "source_sense_description": "mental lethargy or dullness",
                        "target_lang_word": "abrutissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abrutissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77f6d873-f08a-316b-ba7b-632852165848",
                                        "entry_id": "f57197b1-f3a7-37ec-b731-84227a0e67f5",
                                        "glosses": [
                                            "Action d’abrutir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9997fb00-562d-42b3-9216-16da014cc110",
                                                "sense_id": "77f6d873-f08a-316b-ba7b-632852165848",
                                                "text": "Et Barnier, ce garçon si bon et si tranquille, quelle folie lui traverse le cerveau ? Une fois la sottise faite, la forme que prend son repentir, son volontaire abrutissement par l’absinthe, son suicide, tout cela est-il d’accord avec l’idée qu’on nous a donnée de son caractère ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d80bb5d-1254-3523-a04e-816831766cdd",
                                        "entry_id": "f57197b1-f3a7-37ec-b731-84227a0e67f5",
                                        "glosses": [
                                            "État d’une personne abrutie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bb61f4f-3f4e-4d78-b3be-11652786e0b5",
                                                "sense_id": "0d80bb5d-1254-3523-a04e-816831766cdd",
                                                "text": "Nous fûmes, Lambert et moi, si accablés de pensum, que nous n’avons pas eu six jours de liberté durant nos deux années d’amitié. Sans les livres que nous tirions de la bibliothèque, et qui entretenaient la vie dans notre cerveau, ce système d’existence nous eût menés à un abrutissement complet."
                                            },
                                            {
                                                "example_id": "4caa54e4-9579-4dab-9386-e753ca8ec4f0",
                                                "sense_id": "0d80bb5d-1254-3523-a04e-816831766cdd",
                                                "text": "— Je crois que c’est un devoir à remplir envers ces gens simples, qui seront peut-être nos égaux le jour où nous voudrons les éclairer, au lieu de les tenir dans les ténèbres de l’abrutissement."
                                            },
                                            {
                                                "example_id": "d90fec89-8fdb-4c38-8fc7-23fe6c443fae",
                                                "sense_id": "0d80bb5d-1254-3523-a04e-816831766cdd",
                                                "text": "Mais comment pourra-ton satisfaire au besoin moral des masses ? On ne le peut que par une instruction publique généralement gratuite, […]. Mais si, comme jusqu'alors, les instituteurs sont inconsidérés, tourmentés, vexés, impayés, mal logés, à une merci ingrate, paupérisante et dégradante, sous une dépendance entravante et serve, sous le coterisme du prêtre et de quelques factotons de village, les populations ne sortiront pas de leur ignorance, resteront dans leur abêtissement et leur abrutissement, […]."
                                            },
                                            {
                                                "example_id": "98206e86-51eb-45ca-9c76-8086e40eba9e",
                                                "sense_id": "0d80bb5d-1254-3523-a04e-816831766cdd",
                                                "text": "La femme regardait les comédiens avec la fixité morne de l’abrutissement, sans paraître bien se rendre compte de ce qu’elle voyait."
                                            },
                                            {
                                                "example_id": "da0a51d5-c492-4f81-9a0b-a4effc3d0ea7",
                                                "sense_id": "0d80bb5d-1254-3523-a04e-816831766cdd",
                                                "text": "Il faut avoir vécu au fond d’un département, pour bien comprendre quelles furent les quatre années d’abrutissement que ce garçon passa de la sorte."
                                            },
                                            {
                                                "example_id": "fb67f1c0-3d3e-4fad-9e7f-b453f19d65db",
                                                "sense_id": "0d80bb5d-1254-3523-a04e-816831766cdd",
                                                "text": "En dehors de cela, de la vie réelle, personnelle, on leur avait laissé deux choses : l'abrutissement de l'alcool et la jouissance immédiate, à bon marché, à la maison publique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b245a0d2-52a1-4ebe-bbc8-09ded3478868",
                        "source_entry_id": "1e9be929-66c6-39f2-a2e4-b96f5b89c9d4",
                        "source_sense_id": "6371d760-aece-3e00-a7f7-b5e1e54abc5a",
                        "source_sense_description": "mental lethargy or dullness",
                        "target_lang_word": "abêtissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abêtissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75bb9bef-7b13-32b8-93c8-be4f7ce3ad61",
                                        "entry_id": "72f36125-6965-312a-834c-05adbff0bdea",
                                        "glosses": [
                                            "Action d’abêtir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bdf7307-72ac-4b5d-8e05-8c7d85a90635",
                                                "sense_id": "75bb9bef-7b13-32b8-93c8-be4f7ce3ad61",
                                                "text": "Mais comment pourra-ton satisfaire au besoin moral des masses ? On ne le peut que par une instruction publique généralement gratuite, […]. Mais si, comme jusqu'alors, les instituteurs sont inconsidérés, tourmentés, vexés, impayés, mal logés, à une merci ingrate, paupérisante et dégradante, sous une dépendance entravante et serve, sous le coterisme du prêtre et de quelques factotons de village, les populations ne sortiront pas de leur ignorance, resteront dans leur abêtissement et leur abrutissement, […]."
                                            },
                                            {
                                                "example_id": "beaea03a-fd4c-4bf0-a095-700ac70a825e",
                                                "sense_id": "75bb9bef-7b13-32b8-93c8-be4f7ce3ad61",
                                                "text": "La renaissance de la superstition, qu’il avait crue enterrée par Voltaire et Rousseau, lui semblait, dans la génération nouvelle, le signe d’un complet abêtissement."
                                            },
                                            {
                                                "example_id": "5727038b-9101-4819-97ff-1087e10ef8f8",
                                                "sense_id": "75bb9bef-7b13-32b8-93c8-be4f7ce3ad61",
                                                "text": "Pradelle convint avec moi que le travail aussi peut être une drogue. Je remerciai avec effusion Jacques dont le fantôme m’avait arrachée à mon studieux abêtissement."
                                            },
                                            {
                                                "example_id": "e1cb856f-2fa2-4d25-91cf-56f2c838b465",
                                                "sense_id": "75bb9bef-7b13-32b8-93c8-be4f7ce3ad61",
                                                "text": "Tant d’abêtissement aussi autour des landaus du square Carpeaux, tant de : « C’est mignon comme ça, ça ne devrait jamais grandir ! »"
                                            },
                                            {
                                                "example_id": "6cd465ff-87ab-47a2-a5f9-e87cd53d0605",
                                                "sense_id": "75bb9bef-7b13-32b8-93c8-be4f7ce3ad61",
                                                "text": "À partir de là, on peut combiner les motifs existentiels de Cavell et de Sartre et mettre le doigt sur un double danger : un abêtissement vers le haut et un abêtissement vers le bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f08e6a0-493b-30ec-addb-4cc9d5b804f2",
                                        "entry_id": "72f36125-6965-312a-834c-05adbff0bdea",
                                        "glosses": [
                                            "État d’une personne abêtie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8a0a1e-6e89-4933-aaa1-f9254204ee98",
                                                "sense_id": "7f08e6a0-493b-30ec-addb-4cc9d5b804f2",
                                                "text": "L’alcool est responsable de son abêtissement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
