                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be11ca49-135c-4695-83f9-9afcc6203be4",
                                "sense_id": "c6daebf8-f17b-355a-91cd-96204578fe07",
                                "text": "C'est pêchu, ça groove, mais l'heure (17h30) et le lieu (trop lumineux, pas de bar) ne sont pas idéaux pour désamorphiser le public."
                            },
                            {
                                "example_id": "a714518b-5e1a-40a4-8b9f-3b1970249197",
                                "sense_id": "c6daebf8-f17b-355a-91cd-96204578fe07",
                                "text": "Par ailleurs, je ne comprends pas pourquoi ils ne donnent pas la possibilité de désamorphiser ses rushs de 4K / 60 fps après leurs enregistrements."
                            }
                        ]
                    }
