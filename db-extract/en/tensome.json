                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d2b381-808d-4a6d-84db-c9ec7cbe9f88",
                                "sense_id": "cf367b03-5a42-31dd-ace6-18f9fd9f3c54",
                                "text": "1974, International Thespian Society, National Thespian Dramatic Honor Society for High Schools, Dramatics: Volumes 46-47, link\nHastily the tensome make their way to the stage unloading their props in the wings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c3d68d5-ab23-44f8-8c80-26308844eb96",
