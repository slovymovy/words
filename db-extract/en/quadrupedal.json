                "translations": [
                    {
                        "translation_id": "56d50700-30e3-4f53-88fb-742705bf5e43",
                        "source_entry_id": "b49d67dd-cb91-3fa3-adce-99e48b666328",
                        "source_sense_id": "957da626-51b5-35f2-9423-3af73382b912",
                        "source_sense_description": "walking on four feet",
                        "target_lang_word": "viervoetig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viervoetig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f533e4e7-be33-3ae1-9cb1-406e297ef273",
                                        "entry_id": "d9e3f612-abe7-308f-bc5a-aa18deaa90db",
                                        "glosses": [
                                            "van een dier of voorwerp dat het vier voeten heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8d0d9b-1bc7-40ee-8ed9-d10be2737e5b",
                                                "sense_id": "f533e4e7-be33-3ae1-9cb1-406e297ef273",
                                                "text": "De eerste dinoveertjes waren sowieso geen volwaardige slagpennen, maar pluizige en borstelige plukjes dons die dieren warm hielden. Paleontologen vinden steeds meer dino’s met zulke oerveertjes. Aanvankelijk vooral dino’s die aan vogels verwant zijn, maar deze zomer werd voor het eerst een viervoetige, plantenetende dino met pluis beschreven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05147cd1-13ce-3a82-ba2b-ac0e03b6adb7",
                                        "entry_id": "d9e3f612-abe7-308f-bc5a-aa18deaa90db",
                                        "glosses": [
                                            "betrekking hebbend op honden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07b10bf-a36b-4f0c-89bf-a43ed13c1188",
                                                "sense_id": "05147cd1-13ce-3a82-ba2b-ac0e03b6adb7",
                                                "text": "Automatische gezichtsherkenning bij weggelopen en gevonden honden is een groeimarkt, door het mobieltje. Maar de programma’s zitten nog in de puppyfase. Gezichtsherkenningsprogramma’s voor mensen moeten flink aangepast worden voor viervoetig gebruik, blijkt nu."
                                            },
                                            {
                                                "example_id": "db99edc5-6cf8-438b-baa0-b6e0835e303f",
                                                "sense_id": "05147cd1-13ce-3a82-ba2b-ac0e03b6adb7",
                                                "text": "Er zijn zelfs speciale agentschappen om hondenzaken waar te nemen. Bij bureau Animal Actors scheppen ze op over viervoetige cliënten met rollen in True Grit en No Country for Old Men. Agentschap Hollywood Paws heeft een brochure: How to Make Your Pet a Star."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b339616-c402-47e5-8f99-dc84910f7002",
                        "source_entry_id": "b49d67dd-cb91-3fa3-adce-99e48b666328",
                        "source_sense_id": "957da626-51b5-35f2-9423-3af73382b912",
                        "source_sense_description": "walking on four feet",
                        "target_lang_word": "quadrupède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrupède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa1a6a06-541f-3468-8fb2-dd1ed4d93fdd",
                                        "entry_id": "c91457d9-b1c4-396f-b136-3e1bc62b2df9",
                                        "glosses": [
                                            "Qui a quatre pieds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ca5eda-6d7e-4bb8-a6a2-4da2249038a5",
                                                "sense_id": "fa1a6a06-541f-3468-8fb2-dd1ed4d93fdd",
                                                "text": "Parmi les animaux quadrupèdes, il y en a de sauvages et de domestiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quadrupède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74cf0e58-14b9-3479-883c-b8721bdbf9a9",
                                        "entry_id": "e7162c04-584e-3ab2-9177-bed001a7185e",
                                        "glosses": [
                                            "Animal qui se déplace sur quatre pattes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "895422a8-7f30-4efe-a912-c42a7eae1fb3",
                                                "sense_id": "74cf0e58-14b9-3479-883c-b8721bdbf9a9",
                                                "text": "L’albatros est le plus gros des oiseaux palmipèdes ; il est reconnoissable à sa corporance massive qui lui a fait donner le nom de mouton du Cap, en le comparant à ce quadrupède pour sa grosseur."
                                            },
                                            {
                                                "example_id": "11b362f6-9b02-4903-b11f-c0793818ca2b",
                                                "sense_id": "74cf0e58-14b9-3479-883c-b8721bdbf9a9",
                                                "text": "La chienne de l’employé des mines (car nous avions des quadrupèdes dans notre ménagerie, sans compter les enfants) fit lever quelques perdrix dont deux ou trois furent abattues par mon compagnon de voyage."
                                            },
                                            {
                                                "example_id": "afe027ee-1ba1-485c-9df5-95bf9d1892dc",
                                                "sense_id": "74cf0e58-14b9-3479-883c-b8721bdbf9a9",
                                                "text": "Un animal ?… Lequel ?… Un chien ?… Un chat ?… Non ! Pourquoi aurait-on caché un quadrupède domestique dans cette caisse ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfb017b0-63f8-440b-aede-73f03fdb62ea",
                        "source_entry_id": "b49d67dd-cb91-3fa3-adce-99e48b666328",
