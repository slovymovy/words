                "senses": [
                    {
                        "sense_id": "f82718b9-920a-363c-bcf8-2e7f1314bdf5",
                        "entry_id": "e4014b91-902a-3c95-9327-79760c84e012",
                        "glosses": [
                            "Adapter à un environnement tropical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d37bf9-0cc1-46df-9a3a-8ebc4374f73c",
                                "sense_id": "f82718b9-920a-363c-bcf8-2e7f1314bdf5",
                                "text": "Voici donc un archipel de saynètes pleines de personnages et de situations typiques, tropicalisées, ultramarinisées, mahorisées."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e319a90-8087-30f4-a4e8-7232e25f00ff",
                        "entry_id": "e4014b91-902a-3c95-9327-79760c84e012",
                        "glosses": [
                            "Prendre un caractère tropical."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "81fc9b52-ff45-46b8-922d-a3f68b65ec7e",
                                "sense_id": "9e319a90-8087-30f4-a4e8-7232e25f00ff",
                                "text": "En glissant vers le sud, ces vents se tropicalisent et s’humidifient sur la mer de Chine méridionale entraînant de fortes pluies sur les côtes est et nord de l’ensemble régional."
                            }
                        ]
                    }
                ],
                "translations": [
