                    {
                        "sense_id": "726ff66e-ec01-37c1-b0c8-825cf2b6f163",
                        "entry_id": "512c9f60-06a4-3a4f-adae-761a070221f4",
                        "glosses": [
                            "dat wat in een (rang)ordening met 93 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22c1bd64-8ae9-4663-aed2-3f1b018f43c2",
                                "sense_id": "726ff66e-ec01-37c1-b0c8-825cf2b6f163",
                                "text": "Het is weer de drieënnegentig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "5f4a7304-0906-4d2e-b3e2-912270dadaa0",
                                "sense_id": "726ff66e-ec01-37c1-b0c8-825cf2b6f163",
                                "text": "Haar vierennegentigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de drieënnegentig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "258ff9e8-76f7-3aae-ab9f-d90001a405d0",
                        "entry_id": "512c9f60-06a4-3a4f-adae-761a070221f4",
                        "glosses": [
                            "groep van 93 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140d2514-72a5-4b5e-988c-47710764d5ad",
                                "sense_id": "258ff9e8-76f7-3aae-ab9f-d90001a405d0",
                                "text": "De drieënnegentig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
