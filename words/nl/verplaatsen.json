                            {
                                "target_lang_word": "перенести",
                                "target_lang_sense_clarification": "изменить время встречи или местоположение объекта"
                            },
                            {
                                "target_lang_word": "пересадить",
                                "target_lang_sense_clarification": "переместить растение на новое место"
