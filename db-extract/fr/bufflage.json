                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75608675-16ec-4c83-972f-b9ab1c048a6b",
                                "sense_id": "07016a3b-3495-3d27-9b17-e2885c33a593",
                                "text": "Une première passe est donnée à l’aide de la meule en émeri pur, grain à polir ; on procède ensuite au bufflage au disque en buffle émerisé à l’émeri une minute."
                            },
                            {
                                "example_id": "a1a28094-3360-4297-8b86-f9b55d0a0d79",
                                "sense_id": "07016a3b-3495-3d27-9b17-e2885c33a593",
                                "text": "Le bufflage est une étape de ponçage fin d’un meuble. Ce terme vient de la peau de buffle utilisée alors par l’ébéniste pour effectuer ce travail."
                            }
                        ]
