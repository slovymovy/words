            {
                "entry_id": "6649361c-a4fb-327d-bef0-0b3008bcebc0",
                "word": "Sofi",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "16e25adb-cd69-32b9-beec-d7ef64879b85",
                        "entry_id": "6649361c-a4fb-327d-bef0-0b3008bcebc0",
                        "glosses": [
                            "Groupe français de reconditionnement de produits électroniques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea99e10-d0dd-461e-99e1-95e2e7b636af",
                                "sense_id": "16e25adb-cd69-32b9-beec-d7ef64879b85",
                                "text": "« La force de ce secteur, c’est de proposer un produit d’occasion, donc moins cher, avec les mêmes garanties sur le neuf », fait valoir Jean-Christophe Estoudre, fondateur et président de Sofi Groupe, l’un des leadeurs français du reconditionnement de produits électroniques."
                            },
                            {
                                "example_id": "0cf098a0-dca1-48cd-a139-04fed2d60170",
                                "sense_id": "16e25adb-cd69-32b9-beec-d7ef64879b85",
                                "text": "Sofi Groupe, qui reconditionne des smartphones et des tablettes numériques et les revend sous la marque Smaaart, vient de lever 4 millions d’euros auprès d’investisseurs publics et privés."
                            },
                            {
                                "example_id": "cef3ede9-4639-4aa1-8aa5-1d7878eefa4d",
                                "sense_id": "16e25adb-cd69-32b9-beec-d7ef64879b85",
                                "text": "Econocom annonce fin avril l’acquisition d’une partie majoritaire du capital de Sofi, un industriel du reconditionnement en France."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "392fff9a-5e58-3735-a543-d01373dcdbbb",
                "word": "sofi",
