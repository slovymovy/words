                                            {
                                                "example_id": "8a6bae5a-8d6c-4629-b239-5a000cc3d242",
                                                "sense_id": "560937c7-b146-3f8c-a82f-56afbbda4253",
                                                "text": "„Der als Sklave geborene Anführer Toussaint Louverture bewies großes militärisches und diplomatisches Geschick, dazu gehörige Skrupellosigkeit.“"
                                            },
                                            {
                                                "example_id": "14e72f5d-0ddd-46f1-ab46-9052a7edc890",
                                                "sense_id": "560937c7-b146-3f8c-a82f-56afbbda4253",
                                                "text": "„Seine Cleverness und Skrupellosigkeit verbargen sich hinter einem fast gütig wirkenden, sehr dunklen Gesicht mit Vollbart und großen, treu in die Welt blickenden Augen.“"
                                            },
                                            {
                                                "example_id": "a368c83d-8bf9-4c7c-ac0a-3a60c78e2b1d",
                                                "sense_id": "560937c7-b146-3f8c-a82f-56afbbda4253",
                                                "text": "„Trotz der Skrupellosigkeit, die man für so eine Karriere benötigte, galt er als Mann mit Feingefühl.“"
                                            }
                                        ],
