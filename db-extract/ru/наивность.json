                    },
                    {
                        "translation_id": "5f93ac46-fe8c-4a88-a13e-2b5647c90c6c",
                        "source_entry_id": "17f925e8-4d89-3f29-bbbd-15c6644fb9b2",
                        "target_lang_word": "Naivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Naivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90c231ea-ab9e-3293-8a18-f8857fe5ec12",
                                        "entry_id": "e6815682-afdf-3b31-93b5-18479772ef13",
                                        "glosses": [
                                            "argloses Vorgehen oder Denkweise ohne Hintergedanken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69143402-ab9b-45a7-9405-41ed3497f815",
                                                "sense_id": "90c231ea-ab9e-3293-8a18-f8857fe5ec12",
                                                "text": "„Russell wird man kaum Naivität vorwerfen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4b19bbd-8dfc-3df6-99cd-0d2163d6a975",
                                        "entry_id": "e6815682-afdf-3b31-93b5-18479772ef13",
                                        "glosses": [
                                            "Vorgehen oder Denkweise, die von mangelnder Erfahrung und/oder Sachkenntnis zeugt, wodurch Situation nicht angemessen beurteilt werden"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e6656c5-584a-44cc-914e-9d57c6f9a712",
                                                "sense_id": "c4b19bbd-8dfc-3df6-99cd-0d2163d6a975",
                                                "text": "Du bist wirklich mit Naivität gesegnet!"
                                            },
                                            {
                                                "example_id": "5677d55b-5f78-40a7-93a2-0a0a6f661bf7",
                                                "sense_id": "c4b19bbd-8dfc-3df6-99cd-0d2163d6a975",
                                                "text": "„Kaum hatte er das gesagt, als Fürst Wassilij und Anna Pawlowna sich von ihm abwandten und mit einem Seufzer über seine Naivität einander betrübt ansahen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0bd6ec7-c7e0-474f-b776-1540b34c335a",
