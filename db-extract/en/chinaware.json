                        "examples": [
                            {
                                "example_id": "b19e1890-b79d-4368-8fef-e453933c3703",
                                "sense_id": "04046343-d489-3ad2-b0ed-802186c1f0aa",
                                "text": "According to the Japanese writer, the two first-named mountains and hills, besides several other places up and down Hizen, is made Japanese porcelain or chinaware out of a whitish fat clay, which is found there in great plenty."
                            },
                            {
                                "example_id": "6e453f34-9d2b-44a2-83cf-2955bc514346",
                                "sense_id": "04046343-d489-3ad2-b0ed-802186c1f0aa",
                                "text": "So I turned my attention to setting up my new home, arranging the furniture and displaying Rita's sparkling glass and chinaware on the sideboard."
                            },
                            {
                                "example_id": "187f6c13-24c3-4a7d-8ddf-2539a74d60a0",
                                "sense_id": "04046343-d489-3ad2-b0ed-802186c1f0aa",
                                "text": "This book includes a systematic examination of chinawares in over a thousand documented estates from the seaport communities of Salem, Boston, Newport, New York, and Philadelphia from 1690 to 1770."
                            }
                        ]
                    }
