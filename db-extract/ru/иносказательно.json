                "senses": [
                    {
                        "sense_id": "cc8b8180-9026-3ad9-a518-e5d0dc238ba4",
                        "entry_id": "0b35f61a-73fd-3c59-90d9-db3151994893",
                        "glosses": [
                            "не прямо, со скрытым смыслом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c31880e-6703-434f-84bc-77b0e45277bd",
                                "sense_id": "cc8b8180-9026-3ad9-a518-e5d0dc238ba4",
                                "text": "Звук, говоря иносказательно, может быть назван покровом, телом, формою; связанная с ним мысль ― также говоря иносказательно ― покрываемым, душою, содержанием."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ea74625-91cc-4097-ac1f-4c909828354f",
                        "source_entry_id": "0b35f61a-73fd-3c59-90d9-db3151994893",
                        "source_sense_id": "cc8b8180-9026-3ad9-a518-e5d0dc238ba4",
                        "target_lang_word": "à mots couverts",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à mots couverts",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff7591f6-bdb3-35cc-b026-1c52735a60cf",
                                        "entry_id": "9fa767c4-9ce0-33c7-9389-57c7f2c6ff47",
                                        "glosses": [
                                            "En prenant soin de ne pas dévoiler ce que l’on pense réellement, en suggérant plutôt qu’en énonçant, en ne désignant pas directement les personnes dont on parle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52301664-cbae-4910-baea-7555a9c72c52",
                                                "sense_id": "ff7591f6-bdb3-35cc-b026-1c52735a60cf",
                                                "text": "Entre parents, grand’mères et tantes, commençaient, pour m’intriguer davantage, de continuelles conversations à mots couverts ; des chuchotements, qu’on faisait mine d’étouffer dès que je paraissais…"
                                            },
                                            {
                                                "example_id": "c0eac907-1c9e-4e45-9da0-45e1f68dd530",
                                                "sense_id": "ff7591f6-bdb3-35cc-b026-1c52735a60cf",
                                                "text": "Tante Germaine avait déploré à mots couverts devant mes parents que Jacques fût trop sage."
                                            },
                                            {
                                                "example_id": "481091dc-e3e9-449c-970f-56e18a1cf1d5",
                                                "sense_id": "ff7591f6-bdb3-35cc-b026-1c52735a60cf",
                                                "text": "Le manipulateur vous menace à mots couverts pour attiser vos peurs profondes… Ne cédez pas et ripostez : \" Je ne veux pas entrer dans ce type de relations ! \""
                                            },
                                            {
                                                "example_id": "513a8aa3-3dd7-42e6-b4fa-7b4ca2fe60e2",
                                                "sense_id": "ff7591f6-bdb3-35cc-b026-1c52735a60cf",
                                                "text": "Mais, à mots couverts, les dirigeants du groupe ne cachent plus que le sort de ces cathédrales d’acier est scellé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
