                        "translation_id": "f285d4e4-2d4d-4696-a517-dc8dd1625a35",
                        "source_entry_id": "993a125d-6b20-33c7-9ee4-b5b97e8f16eb",
                        "source_sense_id": "ba3b06d2-e335-3c29-b72f-17afc536ed7e",
