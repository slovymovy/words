            "senses": [
                {
                    "sense_id": "f57adfc0-dc17-3cb0-bc45-8dd68d9a51b9",
                    "sense_definition": "een onwillekeurige schuddende beweging maken van koude, angst of afschuw",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gedachte aan wat er had kunnen gebeuren deed hem <w>rillen</w>.",
                            "target_lang_translations": {
                                "en": "The thought of what could have happened made him <w>shiver</w>."
                            }
                        },
                        {
                            "text": "Pietje werd er wakker van en liep vlug naar het <w>rillende</w> dier toe.",
                            "target_lang_translations": {
                                "en": "Pietje woke up from it and quickly walked to the <w>shivering</w> animal."
                            }
                        },
                        {
                            "text": "Ik sta te <w>rillen</w> van de kou omdat ik mijn jas ben vergeten.",
                            "target_lang_translations": {
                                "en": "I am <w>shivering</w> with cold because I forgot my coat."
                            }
                        }
                    ],
                    "synonyms": [
                        "beven",
                        "sidderen",
                        "bibberen"
                    ],
                    "common_phrases": [
                        "rillen van de kou",
                        "rillen van angst",
                        "staan te rillen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make an involuntary shaking movement due to cold, fear, or disgust"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shiver",
                                "target_lang_sense_clarification": "to shake from cold or fear"
                            },
                            {
                                "target_lang_word": "tremble",
                                "target_lang_sense_clarification": "to shake involuntarily"
                            },
                            {
                                "target_lang_word": "quiver",
                                "target_lang_sense_clarification": "to shake with a slight motion"
                            },
                            {
                                "target_lang_word": "shudder",
                                "target_lang_sense_clarification": "to shake from disgust or horror"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
