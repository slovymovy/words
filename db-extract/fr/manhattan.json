                                                "sense_id": "20905098-81b3-3169-977f-3180b2842502",
                                                "text": "Angeblich kauften die Niederländer den Indianern Manhattan für gerade einmal 60 Gulden ab."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f57e5e5-22fe-36fd-8233-7d26fa9bcf58",
                                        "entry_id": "dfe7e799-11d4-3aa1-9c76-0ec36229acf1",
                                        "glosses": [
                                            "New Yorker Stadtteil auf der gleichnamigen Halbinsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e1d651-0be3-4e87-be67-3c03121b35dd",
                                                "sense_id": "9f57e5e5-22fe-36fd-8233-7d26fa9bcf58",
                                                "text": "In Manhattan schlägt der Puls der Stadt New York."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Manhattan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2016e337-7466-310c-be29-dcab535bbe96",
                                        "entry_id": "9e623e15-1215-35b6-9fe2-15ef565afb93",
                                        "glosses": [
                                            "alkoholisches Mixgetränk aus amerikanischem Whiskey und rotem süßen Wermut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e639db3a-5bae-4fbe-9dfe-a734dbc57566",
                                                "sense_id": "2016e337-7466-310c-be29-dcab535bbe96",
                                                "text": "„Einen Manhattan, bitte.“"
                                            },
                                            {
                                                "example_id": "4d04ffe2-737d-4f8f-948e-933cfca74c4c",
                                                "sense_id": "2016e337-7466-310c-be29-dcab535bbe96",
                                                "text": "„Als schnellere Alternative biete ich ihnen Manhattans an, und der Anführer des Rudels lacht höhnisch auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
