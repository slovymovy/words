                    {
                        "translation_id": "69db16c8-476c-4f7c-a076-4edf93df3973",
                        "source_entry_id": "66ecf2fd-9e7e-38ba-b6b2-af8f4da5ad45",
                        "source_sense_id": "07735b80-930e-382e-bc10-c8c6c2c5cdfa",
                        "target_lang_word": "Überlegung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überlegung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d951458b-e0fb-3ed6-8e90-181dda0bc1d8",
                                        "entry_id": "b0049491-0030-3da0-80fb-45fd99a0dc9c",
                                        "glosses": [
                                            "die Handlung des Überlegens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "905761c3-e91a-4d0f-9247-8184d454f440",
                                                "sense_id": "d951458b-e0fb-3ed6-8e90-181dda0bc1d8",
                                                "text": "Es ist eine Überlegung wert."
                                            },
                                            {
                                                "example_id": "1bd8a502-fe67-463b-946c-ac527b4c495e",
                                                "sense_id": "d951458b-e0fb-3ed6-8e90-181dda0bc1d8",
                                                "text": "„Lieber Leser, du siehst, was sich aus diesen Überlegungen ergibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20ac8d97-5f5c-3d1c-acfc-8180a5110e01",
                                        "entry_id": "b0049491-0030-3da0-80fb-45fd99a0dc9c",
                                        "glosses": [
                                            "das Ergebnis von [1]; etwas, das man überlegt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f532416c-95c0-4cd5-9ace-c503aa61c961",
                                                "sense_id": "20ac8d97-5f5c-3d1c-acfc-8180a5110e01",
                                                "text": "Das war jedenfalls meine Überlegung."
                                            },
                                            {
                                                "example_id": "d7d0f8f4-72c5-4d90-a457-96ea32880543",
                                                "sense_id": "20ac8d97-5f5c-3d1c-acfc-8180a5110e01",
                                                "text": "„Auch Stalin grollte im Kreml. Denn ihm paßte die Kapitulation der deutschen Heeresgruppe in Italien überhaupt nicht in seine strategischen Überlegungen.“"
                                            },
                                            {
                                                "example_id": "b0b7c2cb-b7a8-4901-a797-e6a7242b9622",
                                                "sense_id": "20ac8d97-5f5c-3d1c-acfc-8180a5110e01",
                                                "text": "„Obwohl sie schon im Augenblick dieser Wendung des Gesprächs einsah, daß Hainstocks taktische Überlegung viel für sich hatte, war sie grenzenlos enttäuscht.“"
                                            },
                                            {
                                                "example_id": "e8ee17be-0945-4314-b1ca-0ec2a65b1566",
                                                "sense_id": "20ac8d97-5f5c-3d1c-acfc-8180a5110e01",
                                                "text": "„Hätte Schopenhauer Comte gekannt, hätte er dessen Überlegungen vermutlich nicht besonders ernst genommen.“"
                                            },
                                            {
                                                "example_id": "bce34216-cd36-4c73-b7aa-63350d0083a2",
                                                "sense_id": "20ac8d97-5f5c-3d1c-acfc-8180a5110e01",
                                                "text": "„Auch unsere Bundeswehr wird sich diese Überlegung zu eigen machen, jedoch nicht auf halbem Wege stehen bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a75fc847-e6db-40f7-ae62-b0f373ed1d0a",
                        "source_entry_id": "66ecf2fd-9e7e-38ba-b6b2-af8f4da5ad45",
                        "source_sense_id": "07735b80-930e-382e-bc10-c8c6c2c5cdfa",
                        "target_lang_word": "Gedankengang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gedankengang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c29dc305-ec11-3d66-a931-189c8e39df64",
                                        "entry_id": "03e6ee90-541f-3446-9e2b-f5ce3c2dfbe1",
                                        "glosses": [
                                            "Abfolge der Gedanken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33bd4c74-7f56-469e-849f-431d6d76af06",
                                                "sense_id": "c29dc305-ec11-3d66-a931-189c8e39df64",
                                                "text": "Diesen Gedankengang kann ich nicht nachvollziehen."
                                            },
                                            {
                                                "example_id": "6b042f9b-c510-4738-ad57-8eae780b0448",
                                                "sense_id": "c29dc305-ec11-3d66-a931-189c8e39df64",
                                                "text": "„So verliefen die reuigen Gedankengänge des biederen Küan.“"
                                            },
                                            {
                                                "example_id": "636b163f-5f89-4d09-9cbc-916da13db517",
                                                "sense_id": "c29dc305-ec11-3d66-a931-189c8e39df64",
                                                "text": "„Und dieser so einfache Gedankengang ertötete im Fürsten Andrej alles Interesse, das er früher dem ganzen Reformwerk entgegengebracht hatte.“"
                                            },
                                            {
                                                "example_id": "9d1238d0-c3e8-4fde-a252-fdcd566de35f",
                                                "sense_id": "c29dc305-ec11-3d66-a931-189c8e39df64",
                                                "text": "„Dieser kluge Gedankengang stammt übrigens von Epikur, dem wohl ersten Gelehrten, der öffentlich die Existenz Gottes anzweifelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
