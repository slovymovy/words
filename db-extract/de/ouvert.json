                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1ffe706-1c69-4f42-a48e-4d07c42aa94c",
                                                "sense_id": "4d7fecc7-a114-336f-8e5b-1d3565635822",
                                                "text": "Il est en guerre ouverte contre ses voisins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3991781-71f2-3d10-9480-66d5781a4354",
                                        "entry_id": "43924013-813a-332b-ae3a-97320dd4c4cf",
                                        "glosses": [
                                            "Qualifie un milieu où la végétation herbacée domine avec un taux de recouvrement supérieur à 25 %."
