                    },
                    {
                        "translation_id": "0056de4e-fcc2-40a1-83b7-8f1406857d4c",
                        "source_entry_id": "7632348e-d424-397c-96cc-3d2bc4e9f421",
                        "source_sense_id": "e393f77d-66c4-3a00-a1c9-25fe18044dcb",
                        "target_lang_word": "elektrolytisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elektrolytisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                        "entry_id": "ef6e435d-e5f5-37ff-ab8b-697cd1e0e20d",
                                        "glosses": [
                                            "die Elektrolyse, den Elektrolyten betreffend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a61a947-012a-48e9-8e3b-b462cf8f63e9",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Im Gegensatz zu dem metallischen nimmt der elektrolytische Widerstand mit der Temperatur ab."
                                            },
                                            {
                                                "example_id": "b6b1f1fd-c1ad-40c5-a06e-9e16f7fa92bf",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Viele Verbindungen leiten im geschmolzenen Zustande elektrolytisch."
                                            },
                                            {
                                                "example_id": "d768ae69-f18a-42fc-a755-1479daa388c9",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Elektrolytisches Polieren ist eine elektrochemische Behandlung, die zur Einebnung und zum Glänzen einer ursprünglich matten und rauen metallischen Oberfläche führt."
                                            },
                                            {
                                                "example_id": "0202086d-7c9c-44df-970b-8e55971eef75",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Das aus sauren kolloidfreien Kupfervitriollösungen elektrolytisch abgeschiedene Kupfer hat kristallinisches Gefüge."
                                            },
                                            {
                                                "example_id": "d52bca12-1591-4dd8-b08a-36fae13f5dbb",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Die Isotonie (Isosmie) des Organismus ist an die gleichbleibende Konzentration seiner mineralischen Bestandteile gebunden, wobei ihre elektrolytische Dissoziation infolge der Einwirkung auf die Größe des osmotischen Druckes in Rechnung gesetzt werden muß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
