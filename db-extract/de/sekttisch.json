                ],
                "senses": [
                    {
                        "sense_id": "e90c4e67-4523-3eb7-ba7f-8354f1f22342",
                        "entry_id": "9959c423-0787-3897-82bf-36567db74209",
                        "glosses": [
                            "Stehtisch, an dem man Sekt trinkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a67c4a1-0f53-482d-b420-03a265de2b1a",
                                "sense_id": "e90c4e67-4523-3eb7-ba7f-8354f1f22342",
                                "text": "„Der Narrhalla-Marsch erklingt, und Elferratspräsident Herbert Bach tritt ans Mikrophon, das gleich neben dem silbernen Sekttisch steht.“"
                            },
                            {
                                "example_id": "4a322d5c-16d6-4e60-b59e-cdd63b1b045c",
                                "sense_id": "e90c4e67-4523-3eb7-ba7f-8354f1f22342",
                                "text": "„Dann streifen die Gäste wünschelnd durch das Foyer der Rhein-Mosel-Halle, umkreisen Sekttische und Stützpfeiler, und die Ruten schlagen aus, dass es eine Freude ist.“"
                            },
                            {
                                "example_id": "7045e16b-79dc-4d50-8e50-cd09c3c43709",
                                "sense_id": "e90c4e67-4523-3eb7-ba7f-8354f1f22342",
                                "text": "„Wenn man sich zu dem an den Sekttisch gesellt und am 9. August 2008 kurz vor Beginn von „Tristan” gesagt hat: Mensch, ist das nicht toll, wie viele Gewerkschaftsmitglieder sich für Wagner begeistern – dann hat dieser Mann doch einigermaßen pikiert geschaut […].“"
                            },
                            {
                                "example_id": "357185ec-7c47-4946-9407-a13554951045",
                                "sense_id": "e90c4e67-4523-3eb7-ba7f-8354f1f22342",
                                "text": "„Der Berufsrheinländer, immer lustig, immer vergnügt, lief unter die Gäste, Sekttische, Weinzwangtische, Sekt-und-Weincommis, faßte die Händchen der Dämchen, führte sie aufs glatte Parkett der Entscheidung, stellte sie vor, stellte sie bloß, stellte sie zur Wahl, entgleiste Hausfrauen, ausgekratzte Mütter, Gewänder aus dem Heimberater schlicht und strahlend, wie entferne ich Spermatozoen, was koche ich schlank, fragen Sie Frau Christine sie rät am dümmsten, unfreie, verkrampfte, doch maßlos eingebildete Bewegungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
