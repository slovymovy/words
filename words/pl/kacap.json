{
    "word_family": [
        "kacapka",
        "kacapski",
        "kacapstwo"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45f9e2e3-09e2-31fe-815e-ad25dd214e9d",
                    "sense_definition": "pogardliwe lub obraźliwe określenie Rosjanina lub ogólnie obywatela dawnego Związku Radzieckiego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "etnofaulizm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W internecie pojawiło się wiele komentarzy, w których autorzy pogardliwie nazywali najeźdźców <w>kacapami</w>.",
                            "target_lang_translations": {
                                "ru": "В интернете появилось много комментариев, в которых авторы презрительно называли захватчиков <w>кацапами</w>."
                            }
                        },
                        {
                            "text": "Starszy pan często używał słowa <w>kacap</w>, wspominając żołnierzy ze wschodu z czasów powojennych.",
                            "target_lang_translations": {
                                "ru": "Пожилой мужчина часто использовал слово «<w>кацап</w>», вспоминая восточных солдат послевоенных времён."
                            }
                        }
                    ],
                    "synonyms": [
                        "Moskal"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "określenie pogardliwe i wulgarne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "пренебрежительное или оскорбительное обозначение русского или вообще гражданина бывшего СССР"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кацап",
                                "target_lang_sense_clarification": "этнофолизм, оскорбительное прозвище русских"
                            },
                            {
                                "target_lang_word": "москаль",
                                "target_lang_sense_clarification": "схожий пренебрежительный этнофолизм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c399bc6-5dba-35bf-b179-7194e6ff1137",
                    "sense_definition": "człowiek ograniczony umysłowo, niezdarny lub postępujący głupio",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obelga",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znowu zapomniałeś zabrać ważnych dokumentów z biura, ty kompletny <w>kacapie</w>!",
                            "target_lang_translations": {
                                "ru": "Ты опять забыл забрать из офиса важные документы, ах ты круглый <w>болван</w>!"
                            }
                        },
                        {
                            "text": "Nie mogłem uwierzyć, że ten <w>kacap</w> znowu zepsuł całą naszą pracę w warsztacie.",
                            "target_lang_translations": {
                                "ru": "Я не мог поверить, что этот <w>недотёпа</w> снова испортил всю нашу работу в мастерской."
                            }
                        }
                    ],
                    "synonyms": [
                        "głupiec",
                        "baran",
                        "prostak"
                    ],
                    "antonyms": [
                        "mędrzec"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane jako obelga"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ограниченный, неловкий, глупый или бестолковый человек"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болван",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "глупец"
                            },
                            {
                                "target_lang_word": "недотёпа",
                                "target_lang_sense_clarification": "неловкий или неуклюжий человек"
                            },
                            {
                                "target_lang_word": "остолоп",
                                "target_lang_sense_clarification": "глупый, бестолковый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "566638e4-e063-3df0-bf8a-95d0327f5bc1",
                    "sense_definition": "historyczne określenie chłopa wielkoruskiego, często z brodą",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych kronikach i pamiętnikach zaboru rosyjskiego chłopa z brodą często określano słowem <w>kacap</w>.",
                            "target_lang_translations": {
                                "ru": "В старинных хрониках и мемуарах времён российского раздела бородатого крестьянина часто называли словом «<w>кацап</w>»."
                            }
                        },
                        {
                            "text": "XIX-wieczny podróżnik opisywał w swojej książce życie codzienne i stroje noszone przez wiejskich <w>kacapów</w>.",
                            "target_lang_translations": {
                                "ru": "Путешественник XIX века описывал в своей книге повседневную жизнь и одежду, которую носили деревенские <w>кацапы</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "znaczenie historyczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "историческое обозначение великорусского крестьянина, часто бородатого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кацап",
                                "target_lang_sense_clarification": "историческое бытовое название бородатого великоросса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}