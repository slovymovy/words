                ],
                "senses": [
                    {
                        "sense_id": "eb916e0e-a941-380a-b625-bd3c6e144352",
                        "entry_id": "8547a0a1-401e-391c-a7e6-4ad3805c0742",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0e9d17-9470-4818-9a8c-7b12c09ffeb5",
                                "sense_id": "eb916e0e-a941-380a-b625-bd3c6e144352",
                                "text": "Frau Maister ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ec597c1d-56f3-44ab-9f78-86f8917747f5",
                                "sense_id": "eb916e0e-a941-380a-b625-bd3c6e144352",
                                "text": "Herr Maister wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5037bc47-2ea7-43a1-a25d-63e8e135bffa",
                                "sense_id": "eb916e0e-a941-380a-b625-bd3c6e144352",
                                "text": "Die Maisters fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d2f18ec7-7b06-4e52-8f0f-8deeb7cb8c8e",
                                "sense_id": "eb916e0e-a941-380a-b625-bd3c6e144352",
                                "text": "Der Maister trägt nie die Schals, die die Maister ihm strickt."
                            },
                            {
                                "example_id": "0478b087-d3e7-4865-80d5-e468112df5f0",
                                "sense_id": "eb916e0e-a941-380a-b625-bd3c6e144352",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Maister kommt, geht der Herr Maister.“"
                            },
                            {
                                "example_id": "8f09c5a8-806e-479a-983a-2d9b90f22f89",
                                "sense_id": "eb916e0e-a941-380a-b625-bd3c6e144352",
                                "text": "Maister kommt und geht."
                            },
                            {
                                "example_id": "ba864737-f10b-4ac0-986a-58ba9f7b2868",
                                "sense_id": "eb916e0e-a941-380a-b625-bd3c6e144352",
                                "text": "Maisters kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
