{
    "word_family": [
        "prime",
        "primarily",
        "primal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb0a69fe-bae3-3780-9757-dfc839a28f06",
                    "sense_definition": "Most important; main or principal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our <w>primary</w> concern is the safety of the passengers.",
                            "target_lang_translations": {
                                "ru": "Наша <w>главная</w> забота — безопасность пассажиров.",
                                "zh": "我们<w>首要</w>关心的是乘客的安全。"
                            }
                        },
                        {
                            "text": "The <w>primary</w> reason for the delay was the bad weather.",
                            "target_lang_translations": {
                                "ru": "<w>Основной</w> причиной задержки была плохая погода.",
                                "zh": "延误的<w>主要</w>原因是天气不好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "main",
                        "chief",
                        "principal",
                        "key",
                        "major",
                        "prime"
                    ],
                    "antonyms": [
                        "secondary",
                        "minor"
                    ],
                    "common_phrases": [
                        "primary concern",
                        "primary goal",
                        "primary reason",
                        "primary focus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый важный; главный или основной.",
                        "zh": "最重要的；主要的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основной",
                                "target_lang_sense_clarification": "наиболее важный"
                            },
                            {
                                "target_lang_word": "главный",
                                "target_lang_sense_clarification": "центральный, ведущий"
                            },
                            {
                                "target_lang_word": "первостепенный",
                                "target_lang_sense_clarification": "имеющий высший приоритет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主要",
                                "target_lang_sense_clarification": "最重要的"
                            },
                            {
                                "target_lang_word": "首要",
                                "target_lang_sense_clarification": "第一位的，最重要的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8452dda-3435-352f-9e0b-fe1333754fee",
                    "sense_definition": "Relating to the education of children between the ages of about five and eleven.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My daughter started <w>primary</w> school last September.",
                            "target_lang_translations": {
                                "ru": "Моя дочь пошла в <w>начальную</w> школу в прошлом сентябре.",
                                "zh": "我女儿去年九月上了<w>小学</w>。"
                            }
                        },
                        {
                            "text": "Teachers in <w>primary</w> education need a lot of patience and energy.",
                            "target_lang_translations": {
                                "ru": "Учителям <w>начального</w> образования требуется много терпения и энергии.",
                                "zh": "<w>小学</w>教育的老师需要极大的耐心和精力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "elementary"
                    ],
                    "antonyms": [
                        "secondary"
                    ],
                    "common_phrases": [
                        "primary school",
                        "primary education",
                        "primary teacher"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к обучению детей в возрасте от пяти до одиннадцати лет.",
                        "zh": "关于五岁到十一岁儿童的教育。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начальный",
                                "target_lang_sense_clarification": "относящийся к школе (1-4 классы)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小学",
                                "target_lang_sense_clarification": "指代小学阶段的教育"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54a6bb2a-b024-3fa0-89e9-83d3bc479bec",
                    "sense_definition": "Happening or existing first in a sequence of events or development; original.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>primary</w> stages of the disease are often difficult to detect.",
                            "target_lang_translations": {
                                "ru": "<w>Первичные</w> стадии заболевания часто трудно обнаружить.",
                                "zh": "这种疾病的<w>最初</w>阶段通常很难被发现。"
                            }
                        },
                        {
                            "text": "Historians rely on <w>primary</w> sources to understand what happened in the past.",
                            "target_lang_translations": {
                                "ru": "Историки полагаются на <w>первоисточники</w>, чтобы понять, что происходило в прошлом.",
                                "zh": "历史学家依靠<w>原始</w>资料来了解过去发生的事情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "initial",
                        "original",
                        "first"
                    ],
                    "antonyms": [
                        "final",
                        "last"
                    ],
                    "common_phrases": [
                        "primary source",
                        "primary stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или существующий первым в последовательности событий или развитии; исходный.",
                        "zh": "在事件或发展序列中首先发生或存在的；最初的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первичный",
                                "target_lang_sense_clarification": "начальный, исходный"
                            },
                            {
                                "target_lang_word": "первоначальный",
                                "target_lang_sense_clarification": "самый первый по времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最初",
                                "target_lang_sense_clarification": "时间上最早的"
                            },
                            {
                                "target_lang_word": "原始",
                                "target_lang_sense_clarification": "最初的，未开发的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9494b27a-d528-336d-9185-ba16c19f32f0",
                    "sense_definition": "Relating to day-to-day medical care provided by general practitioners rather than specialists.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to invest more money in <w>primary</w> care to prevent hospitals from becoming overcrowded.",
                            "target_lang_translations": {
                                "ru": "Нам нужно вкладывать больше денег в <w>первичную</w> медико-санитарную помощь, чтобы предотвратить переполненность больниц.",
                                "zh": "我们需要在<w>初级</w>医疗上投入更多资金，以防止医院过度拥挤。"
                            }
                        },
                        {
                            "text": "Your <w>primary</w> physician can refer you to a specialist if necessary.",
                            "target_lang_translations": {
                                "ru": "Ваш <w>лечащий</w> врач может направить вас к специалисту при необходимости.",
                                "zh": "如有必要，你的<w>初级</w>保健医生可以为你转诊给专科医生。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "primary care",
                        "primary physician"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к повседневной медицинской помощи, оказываемой врачами общей практики, а не узкими специалистами.",
                        "zh": "指由全科医生而非专科医生提供的日常医疗护理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первичный",
                                "target_lang_sense_clarification": "в контексте медицины (первичная помощь)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "初级",
                                "target_lang_sense_clarification": "指代基础医疗服务"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ece3534a-ffbb-3f91-9d36-40a096d87bfb",
                    "sense_definition": "An election in which people choose a candidate to represent a political party in a later general election.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator won the <w>primary</w> easily and will now run for president.",
                            "target_lang_translations": {
                                "ru": "Сенатор легко выиграл <w>праймериз</w> и теперь будет баллотироваться в президенты.",
                                "zh": "这位参议员轻松赢得了<w>初选</w>，现在将竞选总统。"
                            }
                        },
                        {
                            "text": "Voter turnout is usually lower in a <w>primary</w> than in the general election.",
                            "target_lang_translations": {
                                "ru": "Явка избирателей на <w>предварительных выборах</w> обычно ниже, чем на всеобщих.",
                                "zh": "<w>初选</w>的投票率通常低于大选。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "presidential primary",
                        "democratic primary",
                        "republican primary"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выборы, на которых избиратели выбирают кандидата от политической партии для участия в последующих всеобщих выборах.",
                        "zh": "一种选举，人们在其中选择候选人代表政党参加随后的普选。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "праймериз",
                                "target_lang_sense_clarification": "предварительные внутрипартийные выборы"
                            },
                            {
                                "target_lang_word": "предварительные выборы",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "初选",
                                "target_lang_sense_clarification": "政党内部的预选"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d90c03f-e816-391a-8860-fdf657e47001",
                    "sense_definition": "One of the three colors (red, yellow, and blue) that can be mixed together to make other colors.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Artists mix the three <w>primaries</w> to create every other shade on the canvas.",
                            "target_lang_translations": {
                                "ru": "Художники смешивают три <w>основных цвета</w>, чтобы создать любой другой оттенок на холсте.",
                                "zh": "艺术家混合三种<w>原色</w>，在画布上创造出其他所有的色调。"
                            }
                        },
                        {
                            "text": "Red is a <w>primary</w>, but orange is a secondary color.",
                            "target_lang_translations": {
                                "ru": "Красный — это <w>основной цвет</w>, а оранжевый — составной.",
                                "zh": "红色是<w>原色</w>，而橙色是间色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "additive primaries",
                        "subtractive primaries"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из трех цветов (красный, желтый и синий), смешиванием которых можно получить другие цвета.",
                        "zh": "三种颜色（红、黄、蓝）之一，可以通过混合它们来制造其他颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основной цвет",
                                "target_lang_sense_clarification": "в колористике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原色",
                                "target_lang_sense_clarification": "色彩学中的基本色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28bc0e24-cf19-3ce2-9374-cd422d9d5ff8",
                    "sense_definition": "A large flight feather on the outer part of a bird's wing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle had damaged several <w>primaries</w> and could not fly properly.",
                            "target_lang_translations": {
                                "ru": "Орел повредил несколько <w>маховых перьев</w> и не мог нормально летать.",
                                "zh": "那只鹰损坏了几根<w>初级飞羽</w>，无法正常飞行。"
                            }
                        },
                        {
                            "text": "Birdwatchers identify species by looking at the pattern on the <w>primaries</w>.",
                            "target_lang_translations": {
                                "ru": "Орнитологи определяют виды, глядя на рисунок на <w>маховых перьях</w>.",
                                "zh": "观鸟者通过观察<w>初级飞羽</w>上的花纹来识别物种。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context (ornithology)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное маховое перо на внешней части крыла птицы.",
                        "zh": "鸟类翅膀外侧的一根大飞羽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маховое перо",
                                "target_lang_sense_clarification": "перо первого порядка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "初级飞羽",
                                "target_lang_sense_clarification": "鸟类学专业术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d700eb29-cabe-3ae5-a013-672692140999",
                    "sense_definition": "To challenge an incumbent politician for their party's nomination in a primary election.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The governor was <w>primaried</w> by a candidate from the extreme wing of his party.",
                            "target_lang_translations": {
                                "ru": "Губернатору <w>бросил вызов на праймериз</w> кандидат от радикального крыла его партии.",
                                "zh": "州长在党内<w>初选</w>中受到了来自党内极端派系候选人的挑战。"
                            }
                        },
                        {
                            "text": "It is rare for a sitting president to be <w>primaried</w> effectively.",
                            "target_lang_translations": {
                                "ru": "Редко случается, чтобы действующему президенту успешно <w>бросали вызов на праймериз</w>.",
                                "zh": "现任总统在党内<w>初选</w>中被有效挑战的情况很少见。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get primaried"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "political jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросить вызов действующему политику за выдвижение от партии на предварительных выборах.",
                        "zh": "在初选中挑战在任政治家以获得党内提名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросить вызов на праймериз",
                                "target_lang_sense_clarification": "составить конкуренцию однопартийцу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "在党内初选中竞争"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}