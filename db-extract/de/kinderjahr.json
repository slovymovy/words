                "senses": [
                    {
                        "sense_id": "fc8f8b66-9452-38c6-b801-aad5e6eeaab3",
                        "entry_id": "3770d097-e423-3664-a34c-296a99392586",
                        "glosses": [
                            "Lebensjahr eines Kindes"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "a7d83b1d-2e0e-4c9f-a578-2685dd547e0b",
                                "sense_id": "fc8f8b66-9452-38c6-b801-aad5e6eeaab3",
                                "text": "„Er hatte Natascha von ihren Kinderjahren an gekannt, und der Eindruck, den er von ihr hatte, war der einer solchen Lieblichkeit, dass er ihn mit der sich ihm neu aufdrängenden Vorstellung von ihrer Niedrigkit, Dummheit und Herzlosigkeit gar nicht in Einklang zu bringen vermochte.“"
                            },
                            {
                                "example_id": "816ca210-db89-4106-9b4c-68361b389aa2",
                                "sense_id": "fc8f8b66-9452-38c6-b801-aad5e6eeaab3",
                                "text": "„Das war die Eroberung der Luft – und wir, in deren Kinderjahren noch die Pferdebahn durch Mainz klapperte, die wir die ersten Autos und die erste Elektrische gesehen hatten, sind dabeigewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
