                                "target_senses": [
                                    {
                                        "sense_id": "7a6730fc-f3bb-3050-b098-5da47cef2082",
                                        "entry_id": "a53342d8-f2c8-3414-b6fd-e06e968eeca5",
                                        "glosses": [
                                            "Abondance de biens, richesse dont on fait étalage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae012377-2637-4881-bf23-f965d2fe17b0",
                                                "sense_id": "7a6730fc-f3bb-3050-b098-5da47cef2082",
                                                "text": "Elle vit l’opulence & les richesses succéder à l’aisance ; & son père, avant tout cela, avoit connu le mésaise & presque la pauvreté."
                                            },
                                            {
                                                "example_id": "78ae8738-51c7-48ba-b030-6b37dba2c92c",
                                                "sense_id": "7a6730fc-f3bb-3050-b098-5da47cef2082",
                                                "text": "Ses concitoyens le regardaient comme un homme d’une grande opulence. Il possédait cinquante feddans de bonne terre; cinq gamousses, dix bœufs mugissaient dans ses étables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a36769a-4468-315b-97eb-1ef0fcdc9e2a",
                                        "entry_id": "a53342d8-f2c8-3414-b6fd-e06e968eeca5",
                                        "glosses": [
                                            "Ampleur, développement abondant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "466ebb96-a21d-46f8-8fae-9163f0606ecd",
                                                "sense_id": "8a36769a-4468-315b-97eb-1ef0fcdc9e2a",
                                                "text": "L’opulence des formes dans les tableaux de Rubens, de Jordaens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
