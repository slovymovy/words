                        "examples": [
                            {
                                "example_id": "cab0d096-c75f-4893-980a-ce6404c61f0f",
                                "sense_id": "bba07829-40cc-344a-9304-161573dcf56e",
                                "text": "Polski fabrykant jest służalczy wobec Niemców"
                            }
