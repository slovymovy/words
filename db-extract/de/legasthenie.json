                        ]
                    },
                    {
                        "translation_id": "f7ea1269-5e05-47ce-b38b-abf609c2fb1c",
                        "source_entry_id": "74474328-0f4c-3c34-8789-0fe3289358f3",
                        "source_sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                        "target_lang_word": "дислексия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дислексия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53cc40c6-cae5-32d4-a5ef-8b0e08ea8c70",
                                        "entry_id": "b84a4c5a-8d32-36dc-844d-aea2a267ff38",
                                        "glosses": [
                                            "психиатр. частичное специфическое нарушение процесса чтения, проявляющееся в повторяющихся ошибках стойкого характера"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a59ecab-a0ad-4c62-995f-9456c3237a0b",
                                                "sense_id": "53cc40c6-cae5-32d4-a5ef-8b0e08ea8c70",
                                                "text": "Стойкое нарушение чтения психоневрологи называют дислексией, письма — дисграфией. ❬…❭ Дети с дислексией допускают ошибки при чтении: пропускают звуки, добавляют ненужные, искажают звучание слов, скорость чтения у них невысокая, ребята меняют буквы местами, иногда пропускают начальные слоги слов."
                                            },
                                            {
                                                "example_id": "a563a09c-3211-4743-8438-3cd8e57a462e",
                                                "sense_id": "53cc40c6-cae5-32d4-a5ef-8b0e08ea8c70",
                                                "text": ".. несовершеннолетняя Джессика Уотсон .. страдала дислексией (нарушением способности к овладению навыками чтения) .."
                                            },
                                            {
                                                "example_id": "43aa7a41-7850-4439-91dc-a437a4afe0c1",
                                                "sense_id": "53cc40c6-cae5-32d4-a5ef-8b0e08ea8c70",
                                                "text": "Долгое время учёные пытались выявить причины дислексии — нарушения способности человека правильно воспринимать печатный текст и обучаться чтению."
                                            },
                                            {
                                                "example_id": "f90dbcca-e7e4-47cf-9c27-e46dca526d89",
                                                "sense_id": "53cc40c6-cae5-32d4-a5ef-8b0e08ea8c70",
                                                "text": ".. Марии захотелось заняться чем-то общественно значимым и как раз в это время она узнала о том, что у её дочери дислексия. Незнакомое слово произнёс репетитор английского языка, .. который сделал такой вывод по ряду очевидных для него, но совершенно незамеченных никем из российских коллег признаков: Ксения низко наклонялась над книгами, обхватив голову руками, постоянно тёрла глаза, да и слишком часто жаловалась на усталость и головные боли после чтения."
                                            },
                                            {
                                                "example_id": "6b730487-f2b3-46a8-bac5-be60a83fe5e4",
                                                "sense_id": "53cc40c6-cae5-32d4-a5ef-8b0e08ea8c70",
                                                "text": "Дислексия — проблема миллионов людей во всём мире. Это неврологическое нарушение приводит к проблемам с восприятием написанного и напечатанного текста. ❬…❭ Дислексию непросто диагностировать, и она, конечно же, сильно мешает жить своему обладателю. Особенно если это ребёнок, и он только осваивает чтение."
                                            },
                                            {
                                                "example_id": "b010901a-14c9-4083-b48f-22a9f71f4ec7",
                                                "sense_id": "53cc40c6-cae5-32d4-a5ef-8b0e08ea8c70",
                                                "text": "Следует отметить, что нарушение усвоения правописания у школьников (дизорфография) часто сочетается с нарушениями письма и чтения (дисграфией и дислексией)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
