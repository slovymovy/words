                                        "sense_id": "bbc6a1b9-67bd-344c-8c38-67ff79073f11",
                                        "entry_id": "41023eb0-4ba7-3928-889e-e328199f3d91",
                                        "glosses": [
                                            "Île de Grèce."
                                        ],
