                "senses": [
                    {
                        "sense_id": "27eeb429-2b6b-3ff7-86c7-11b3faf8bbf1",
                        "entry_id": "63e44bfe-b385-3911-beae-65d9e695197a",
                        "glosses": [
                            "Instrument permettant d’effectuer une sélection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a88dcd5-8686-483f-8722-d495a0227d45",
                                "sense_id": "27eeb429-2b6b-3ff7-86c7-11b3faf8bbf1",
                                "text": "Un sélecteur automatique choisit, à chaque essai, la lampe qui sera allumée."
                            }
                        ]
                    },
                    {
                        "sense_id": "f806c626-258e-36f2-96ed-52927c1770f4",
                        "entry_id": "63e44bfe-b385-3911-beae-65d9e695197a",
                        "glosses": [
                            "Commutateur à plusieurs directions dont la manœuvre est effectuée sous l’action de signaux de commande."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aa7182d1-acb6-3d12-9549-fa7e3a375a49",
                        "entry_id": "63e44bfe-b385-3911-beae-65d9e695197a",
                        "glosses": [
                            "Pédale ou levier de changement de vitesse d’une motocyclette, d’une voiture à embrayage automatique ou d’un poids-lourd à embrayage automatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18922385-935e-4774-be6c-470be19e0347",
                                "sense_id": "aa7182d1-acb6-3d12-9549-fa7e3a375a49",
                                "text": "Son ensemble routier roulait jusqu’à ce moment sans difficultés, ce qui laisse penser que le sélecteur DNR était sur D, que ce soit en mode automatique ou en mode manuel."
                            }
                        ]
                    },
                    {
                        "sense_id": "8efdb995-6a3e-3e7c-8c5d-defb7e9889d2",
                        "entry_id": "63e44bfe-b385-3911-beae-65d9e695197a",
                        "glosses": [
                            "Mot-clé CSS qui permet de désigner l'élément d'un document."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83c3bee5-46c0-3299-abe9-bff90db3263c",
                        "entry_id": "63e44bfe-b385-3911-beae-65d9e695197a",
                        "glosses": [
                            "Celui qui sélectionne les membres d'une équipe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cfdbd698-5758-39bf-85db-91589d21462c",
                        "entry_id": "63e44bfe-b385-3911-beae-65d9e695197a",
                        "glosses": [
                            "Cornue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6837554-6cf2-4bc7-811f-3e6d32d35c36",
                                "sense_id": "cfdbd698-5758-39bf-85db-91589d21462c",
                                "text": "Le sélecteur David (7 par batterie à l'usine d'Eguilles) est formé d'une cornue sphérique de 1m55 de diamètre extérieur montée sur un chariot. Il est muni d'une ouverture et d'un trou de coulée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb81eafc-7271-42e5-8702-540dc79598cd",
                        "source_entry_id": "63e44bfe-b385-3911-beae-65d9e695197a",
                        "target_lang_word": "selector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2eee5f53-804a-3456-b989-6fa58909e64f",
                                        "entry_id": "0e09b19b-f644-314d-8d84-88a242ece490",
                                        "glosses": [
                                            "Someone or something which selects or chooses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb7fa873-f517-47ed-8aad-5cd970ff40e5",
                                                "sense_id": "2eee5f53-804a-3456-b989-6fa58909e64f",
                                                "text": "There is one selection for hot chocolate. All selectors are the push button type."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52e1571f-bab2-3a9e-ba39-f75b32979aec",
                                        "entry_id": "0e09b19b-f644-314d-8d84-88a242ece490",
                                        "glosses": [
                                            "An administrator responsible for selecting which players will play for a side."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06a4b0cf-f432-320e-bd89-aab12b03c00b",
                                        "entry_id": "0e09b19b-f644-314d-8d84-88a242ece490",
                                        "glosses": [
                                            "A matching expression in a stylesheet determining which elements in the markup are affected by a style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0894da02-e7df-497d-8912-5a1e1ed0e394",
                                                "sense_id": "06a4b0cf-f432-320e-bd89-aab12b03c00b",
                                                "text": "The ID selector targets just one element per page, making it much more specific than a class selector that might target many."
                                            },
                                            {
                                                "example_id": "9ac0fc83-0328-4124-9ec5-e50b1d2d86a3",
                                                "sense_id": "06a4b0cf-f432-320e-bd89-aab12b03c00b",
                                                "text": "The selector indicates the query expression to run over the DOM; the context indicates the portion of the DOM from which to run the query."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d32ce77-fd6f-30a5-aa62-fc9d63696a30",
                                        "entry_id": "0e09b19b-f644-314d-8d84-88a242ece490",
                                        "glosses": [
                                            "A pointer to a structure describing a segment of memory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc068f66-9043-40d7-8e30-4cca647553ec",
                                                "sense_id": "6d32ce77-fd6f-30a5-aa62-fc9d63696a30",
                                                "text": "Phar Lap executables […] provide a protected-mode selector, 34h, that maps to the first megabyte of physical memory."
                                            },
                                            {
                                                "example_id": "8f61b24d-4149-4d31-872e-b98afe9caa11",
                                                "sense_id": "6d32ce77-fd6f-30a5-aa62-fc9d63696a30",
                                                "text": "You will only have to be concerned with DPMI, selectors, and such, if you use Borland C++ in DOS."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3fdf7c3-5987-3231-92f4-347168f6ddfa",
                                        "entry_id": "0e09b19b-f644-314d-8d84-88a242ece490",
                                        "glosses": [
                                            "A text string transmitted to a Gopher server, identifying the resource to be retrieved."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ff5db1-f388-4af8-9141-5bfebf1236e2",
                                                "sense_id": "c3fdf7c3-5987-3231-92f4-347168f6ddfa",
                                                "text": "Gopher selector strings are more liberal in makeup than URLs and may contain any characters other than a tab, return, or linefeed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b57f7ca-5cbd-3412-9d5a-13240d56c405",
                                        "entry_id": "0e09b19b-f644-314d-8d84-88a242ece490",
                                        "glosses": [
                                            "A disc jockey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f943684a-e896-4e9e-8506-bf2622464f3f",
                                                "sense_id": "1b57f7ca-5cbd-3412-9d5a-13240d56c405",
                                                "text": "That's my sector, homosexual dissector / Come again, rewind selector"
                                            },
                                            {
                                                "example_id": "dd6f4b87-ba27-4d3e-a9da-4a92f0744120",
                                                "sense_id": "1b57f7ca-5cbd-3412-9d5a-13240d56c405",
                                                "text": "This sonic body has to decide which music track to play at any particular moment. But when the selector is alone in front of the crowd, how do they know which track to play next?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c41e17a-8e84-346c-b33d-57cc108de04a",
                                        "entry_id": "0e09b19b-f644-314d-8d84-88a242ece490",
                                        "glosses": [
                                            "A person who is entitled to choose a tract of Crown land to purchase."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66b39f9-af2b-47cd-9b6b-b59f85818248",
                                                "sense_id": "0c41e17a-8e84-346c-b33d-57cc108de04a",
                                                "text": "Each selector in turn chose the particular allotment he wanted for his client, and so on till this important work was over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4ea7592-ffb6-44f2-af29-5e6384a54699",
                        "source_entry_id": "63e44bfe-b385-3911-beae-65d9e695197a",
                        "target_lang_word": "switcher",
