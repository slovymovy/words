                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a3396552-9f8e-32aa-b9cd-5113982e2eae",
                        "entry_id": "d0baf023-110f-37c6-9c7d-e5ac0246d8ef",
                        "glosses": [
                            "Seidenstoff, der aus schwarzem und weißem Garn gefertigt wurde"
                        ],
                        "tags": [
