                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "949548df-f3d6-4f28-ab42-1e8d8376cbab",
                                                "sense_id": "439dbaea-ed54-3d8f-8dea-170e6c9b6507",
                                                "text": "The goalee made a frantic grab as the leather spun clean past him, but he was just a second too late, and Joe had scored for Redcliff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a92d38-b285-3da3-ad50-842e32adae65",
