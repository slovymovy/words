                "senses": [
                    {
                        "sense_id": "23e8dfbd-18c3-34d3-b893-50edaa5918b4",
                        "entry_id": "185ac7e7-0335-3286-9f3b-acfa23c46336",
                        "glosses": [
                            "(U- oder S-)Bahn-Garnitur, die nicht die übliche Länge aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3f441b-213e-467f-bf31-caab361c0b48",
                                "sense_id": "23e8dfbd-18c3-34d3-b893-50edaa5918b4",
                                "text": "„Das seinerseits zieht die Notwendigkeit nach sich, jene Bahnsteigbereiche eigens auszuweisen, an denen Kurzzüge tatsächlich stehen bleiben.“"
                            },
                            {
                                "example_id": "7aec86c1-1374-4566-91c1-9138a1d16df4",
                                "sense_id": "23e8dfbd-18c3-34d3-b893-50edaa5918b4",
                                "text": "„Kurzzüge haben zwei Lokomotiven und 75 Waggons.“"
                            }
                        ],
