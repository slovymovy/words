{
    "word_family": [
        "predisposition",
        "disposition",
        "dispose"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d341ec65-3efb-3a7e-960f-bf3b3f483331",
                    "sense_definition": "To make someone inclined to a specific attitude, action, or condition in advance; to influence someone's thinking beforehand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher's positive comments about the book helped <w>predispose</w> the students to enjoy the story.",
                            "target_lang_translations": {
                                "ru": "Положительные отзывы учителя о книге помогли <w>предрасположить</w> учеников к тому, чтобы им понравилась история."
                            }
                        },
                        {
                            "text": "A friendly introduction can often <w>predispose</w> an audience to listen more carefully to a speaker.",
                            "target_lang_translations": {
                                "ru": "Дружелюбное вступление часто может <w>настроить</w> аудиторию на более внимательное слушание оратора."
                            }
                        }
                    ],
                    "synonyms": [
                        "incline",
                        "bias",
                        "influence",
                        "prompt"
                    ],
                    "antonyms": [
                        "deter",
                        "discourage"
                    ],
                    "common_phrases": [
                        "predispose an audience",
                        "predispose someone to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее склонять кого-либо к определенному отношению, действию или состоянию; влиять на чье-либо мышление заранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предрасполагать",
                                "target_lang_sense_clarification": "настраивать в пользу чего-либо"
                            },
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "убеждать или влиять на мнение"
                            },
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "создавать определенное отношение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d971811-2294-306c-b968-fb752c30a8d6",
                    "sense_definition": "To make someone susceptible or vulnerable to something, such as a particular disease or medical condition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "susceptibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain genetic factors may <w>predispose</w> individuals to developing high blood pressure later in life.",
                            "target_lang_translations": {
                                "ru": "Определенные генетические факторы могут <w>предрасполагать</w> людей к развитию высокого кровяного давления в более позднем возрасте."
                            }
                        },
                        {
                            "text": "Poor diet and lack of exercise can <w>predispose</w> a person to various health complications.",
                            "target_lang_translations": {
                                "ru": "Плохое питание и отсутствие физических упражнений могут <w>сделать</w> человека <w>восприимчивым</w> к различным осложнениям со здоровьем."
                            }
                        }
                    ],
                    "synonyms": [
                        "expose",
                        "make vulnerable"
                    ],
                    "antonyms": [
                        "protect",
                        "immunize"
                    ],
                    "common_phrases": [
                        "predispose to disease",
                        "genetically predispose"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in medical or scientific contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать кого-либо восприимчивым или уязвимым к чему-либо, например, к определенному заболеванию или медицинскому состоянию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предрасполагать",
                                "target_lang_sense_clarification": "создавать почву для болезни"
                            },
                            {
                                "target_lang_word": "делать восприимчивым",
                                "target_lang_sense_clarification": "повышать риск заболевания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}