                                                "example_id": "3ae8f1d8-91a9-48a4-8f1c-ac2fcb8bdb73",
                                                "sense_id": "60c0f053-9e87-3efa-8451-d6e23bac09cb",
                                                "text": "Céleste dans le lit d’Armand devisait avec ses sœurs couchées dans la chambre voisine, par la porte qu’elles laissaient ouverte et calaient au besoin."
                                            },
                                            {
                                                "example_id": "75d335a6-d6f8-4102-be7e-ce8311eb2a07",
                                                "sense_id": "60c0f053-9e87-3efa-8451-d6e23bac09cb",
                                                "text": "Pour éviter qu’elles n’abîment les fruits, il faut bien les caler dans l’emballage, sans pour autant trop les tasser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4393331-468a-3f17-b130-fdbbc2b59733",
                                        "entry_id": "dddc5f55-660e-392d-99e9-6b9316b72437",
                                        "glosses": [
                                            "Fixer, planifier un évènement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0181ec5a-01f4-4047-9414-dbb4c3c63a11",
                                                "sense_id": "c4393331-468a-3f17-b130-fdbbc2b59733",
                                                "text": "En effet, caler la durée du marché sur le délai d’exécution de la prestation principale conduit souvent à ignorer l’existence d’engagements satellites."
                                            },
                                            {
                                                "example_id": "decf121d-a1e8-4a1b-848f-e4329f8ca7bd",
                                                "sense_id": "c4393331-468a-3f17-b130-fdbbc2b59733",
                                                "text": "Très cool, ce restau avec toi, à refaire! Viens, on se cale une date maintenant !"
                                            },
                                            {
                                                "example_id": "5192dcfc-9da2-4c47-bd58-5560220eee84",
                                                "sense_id": "c4393331-468a-3f17-b130-fdbbc2b59733",
                                                "text": "caler un rendez-vous"
                                            },
                                            {
                                                "example_id": "3d9a859b-da42-4c14-ada2-7e2781753e9a",
                                                "sense_id": "c4393331-468a-3f17-b130-fdbbc2b59733",
                                                "text": "caler une réunion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00536cbd-4572-3b3c-affe-4d7c7ff2dd25",
                                        "entry_id": "dddc5f55-660e-392d-99e9-6b9316b72437",
                                        "glosses": [
                                            "Régler une presse pour imprimer le visuel désiré."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad20cd8a-00fa-3ac6-9370-435ceeee53d1",
                                        "entry_id": "dddc5f55-660e-392d-99e9-6b9316b72437",
                                        "glosses": [
                                            "Rabaisser quelqu’un."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ba2357-debd-46fd-95bf-ca8b75109350",
                                                "sense_id": "ad20cd8a-00fa-3ac6-9370-435ceeee53d1",
                                                "text": "Arrête de le caler, il a déjà assez l’air fou comme ça."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce413385-4c09-3782-9535-eb12ad9ac9b5",
                                        "entry_id": "dddc5f55-660e-392d-99e9-6b9316b72437",
                                        "glosses": [
                                            "Boire un verre le plus rapidement possible."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb0f0d7-ae55-4635-9cf6-702c5bfa7cd7",
                                                "sense_id": "ce413385-4c09-3782-9535-eb12ad9ac9b5",
                                                "text": "Caler une bière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7468fd5d-d12c-3be0-8d8b-50dfd289cff0",
                                        "entry_id": "dddc5f55-660e-392d-99e9-6b9316b72437",
                                        "glosses": [
                                            "S’installer confortablement et coiment quelque part."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ca3cbe-5da4-4d75-a888-578864beba04",
                                                "sense_id": "7468fd5d-d12c-3be0-8d8b-50dfd289cff0",
                                                "text": "[…] n’avait-il point remarqué une superbe truite qui se calait sous un rocher de la rive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "535832a9-d23f-3ff7-8e85-35c297f1ffaa",
                                        "entry_id": "dddc5f55-660e-392d-99e9-6b9316b72437",
                                        "glosses": [
                                            "Se rabaisser."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ece0b2ba-c9d8-43c4-8eb6-130cb6033703",
                                                "sense_id": "535832a9-d23f-3ff7-8e85-35c297f1ffaa",
                                                "text": "Arrête de parler, tu ne fais que te caler davantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7474da19-7c05-39ab-905c-0a18a2343c15",
                                        "entry_id": "dddc5f55-660e-392d-99e9-6b9316b72437",
                                        "glosses": [
                                            "Dans l’expression « se caler une fille », avoir avec elle des relations sexuelles."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
