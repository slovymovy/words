                "senses": [
                    {
                        "sense_id": "842c2b49-9cec-3ec3-8298-05f9a1915599",
                        "entry_id": "9ae75db0-9aae-3b04-b1b6-ff43e907cf48",
                        "glosses": [
                            "Partei, deren Abgeordnete/Angehörige an der Regierung nicht beteiligt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb39a4a1-1743-4e91-b4ad-9146b231b7cc",
                                "sense_id": "842c2b49-9cec-3ec3-8298-05f9a1915599",
                                "text": "„Herr Kern gehörte in seiner politischen Überzeugung der radikalen Oppositionspartei an.“"
                            },
                            {
                                "example_id": "aa0d8ad3-5279-4379-8118-5e6d704fc678",
                                "sense_id": "842c2b49-9cec-3ec3-8298-05f9a1915599",
                                "text": "„Zwölf kirgisische Oppositionsparteien, darunter Ata-Meken und Ar-Namys, geben die Bildung einer neuen Oppositionsbewegung »Für Gerechtigkeit« als Reaktion auf die Parlamentswahl bekannt, mehr als 20 gesellschaftliche Bewegungen schließen sich an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
