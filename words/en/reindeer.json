                    }
                },
                {
                    "sense_id": "cb60db26-826f-37be-ad45-13c4ae006715",
                    "sense_definition": "Any specific subspecies or scientific grouping of the Rangifer tarandus species.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deer species",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biologists are studying how different <w>reindeer</w> populations adapt to changing Arctic climates.",
                            "target_lang_translations": {
                                "ru": "Биологи изучают, как различные популяции <w>северного оленя</w> адаптируются к меняющемуся арктическому климату."
                            }
                        },
                        {
                            "text": "The classification of various <w>reindeer</w> ecotypes remains a subject of debate among zoologists.",
                            "target_lang_translations": {
                                "ru": "Классификация различных экотипов <w>северного оленя</w> остается предметом споров среди зоологов."
