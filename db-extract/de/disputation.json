                "senses": [
                    {
                        "sense_id": "806dbb87-8d54-34fc-ab84-9afa1b56ab3c",
                        "entry_id": "566b2931-6e20-3fa2-ad3c-9a52ec22aa93",
                        "glosses": [
                            "wissenschaftliches Verteidigungsgespräch im Rahmen einer Promotion oder Habilitation zur Dissertation oder Habilitationsschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d439a5d-e32e-4e1d-aa39-648946f19fed",
                                "sense_id": "806dbb87-8d54-34fc-ab84-9afa1b56ab3c",
                                "text": "„Ich verließ ihn mit der Versicherung, ich würde bei seiner bald stattfindenden Disputation zugegen sein, denn ich machte mir ein Fest daraus, den berühmten Mamachi argumentieren zu hören.“"
                            },
                            {
                                "example_id": "3efdaa38-22d3-4dbf-bcbd-60c5d4f7e4c8",
                                "sense_id": "806dbb87-8d54-34fc-ab84-9afa1b56ab3c",
                                "text": "„In der öffentlichen Disputation war sein Respondent Markus Hertz, der Mann, der zusammen mit seiner genialisch-geistreichen Frau, der berühmten Henriette Hertz, im wissenschaftlichen und literarischen Leben Berlins später eine größere Rolle spielte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "20dd5875-3f74-3b1e-b329-546c1d9404e4",
                        "entry_id": "566b2931-6e20-3fa2-ad3c-9a52ec22aa93",
                        "glosses": [
                            "wissenschaftliches Streitgespräch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7792dbf6-505a-46c5-8cac-d0f8a0413071",
                                "sense_id": "20dd5875-3f74-3b1e-b329-546c1d9404e4",
                                "text": "„Bereits 1518 im Vorfeld der Leipziger Disputation zwischen Luther und Eck tat sich Karlstadt mit Cranach zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
