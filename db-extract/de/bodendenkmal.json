                    {
                        "form_id": "3e3bd142-1c82-4de6-b2e2-ceb54a2dc597",
                        "entry_id": "67912245-9e5b-3be6-b264-09eb50454f6f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bodendenkmäler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fca1ca0-4565-3275-a45a-ec37a34c0008",
                        "entry_id": "67912245-9e5b-3be6-b264-09eb50454f6f",
                        "glosses": [
                            "bewegliches oder unbewegliches Denkmal, das sich im Boden befindet oder befand und ein besonderes materielles Zeugnis menschlicher Arbeit aus vorgeschichtlicher und geschichtlicher Zeit ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e541711-2fa4-4a67-b524-8f2cce7904ea",
                                "sense_id": "1fca1ca0-4565-3275-a45a-ec37a34c0008",
                                "text": "In Bayern werden viele Bodendenkmäler ausgewiesen."
                            },
                            {
                                "example_id": "e8e06ea1-aabf-4ff9-8efb-136cbd52c1d1",
                                "sense_id": "1fca1ca0-4565-3275-a45a-ec37a34c0008",
                                "text": "Die Archäologen beginnen damit, die obertägigen Bodendenkmäler aufzunehmen."
                            },
                            {
                                "example_id": "6bff8beb-d2e2-4a75-98ca-19b0c6888793",
                                "sense_id": "1fca1ca0-4565-3275-a45a-ec37a34c0008",
                                "text": "Bodendenkmäler bestehen in der Regel aus Befunden und Funden."
                            },
                            {
                                "example_id": "baf9fcff-0cfc-4628-acba-9386a0d5a4ec",
                                "sense_id": "1fca1ca0-4565-3275-a45a-ec37a34c0008",
                                "text": "Bedeutend sind Bodendenkmäler vor allem, wenn sie von Epochen und Kulturen erzählen, für die es kaum andere Quellen gibt."
                            },
                            {
                                "example_id": "3aebaa69-270d-432a-8c95-cfa47ea0697f",
                                "sense_id": "1fca1ca0-4565-3275-a45a-ec37a34c0008",
                                "text": "Die Auffindung von Bodendenkmälern geschieht zumeist plötzlich und erfordert gezieltes und entschlossenes Handeln, da beispielsweise auf Baustellen Prozesse der wirtschaftlichen Planung und Termine nicht mehr aufgehalten werden können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
