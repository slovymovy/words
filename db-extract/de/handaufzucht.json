                "senses": [
                    {
                        "sense_id": "5ddf00c0-a9a7-3786-8102-a4a859b3cd28",
                        "entry_id": "b8235fa5-042a-3c75-9d9f-a9cb7324ae12",
                        "glosses": [
                            "Versorgung eines Jungtieres durch einen oder mehrere Menschen ohne Beteiligung der Elterntiere"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5c27f713-57cb-48da-92ae-b6aa0c32fc7a",
                                "sense_id": "5ddf00c0-a9a7-3786-8102-a4a859b3cd28",
                                "text": "Die Handaufzucht von Tieren erfordert viel Erfahrung und Sorgfalt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "15336852-3ea1-382b-9d1f-880efe03efa9",
                        "entry_id": "b8235fa5-042a-3c75-9d9f-a9cb7324ae12",
                        "glosses": [
                            "Tier, das durch Menschen aufgezogen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35a34b49-e30d-47d5-bd6c-a92d8458e374",
                                "sense_id": "15336852-3ea1-382b-9d1f-880efe03efa9",
                                "text": "„Das entspreche nicht seinem Typ, außerdem seien die Pandas keine Handaufzucht wie seinerzeit Knut.“"
                            },
                            {
                                "example_id": "4be83ecf-c98e-4fac-9fc3-3fcd4cb5a921",
                                "sense_id": "15336852-3ea1-382b-9d1f-880efe03efa9",
                                "text": "„Für seinen Vater sei jedes zu früh verstorbene Tier ein herber Schlag gewesen. »Viele Jungtiere waren erst einmal Handaufzuchten.«“"
                            },
                            {
                                "example_id": "03f586db-f89b-4939-8cb8-a82f16816894",
                                "sense_id": "15336852-3ea1-382b-9d1f-880efe03efa9",
                                "text": "„Während die Handaufzuchten noch völlig auf die menschlichen Lotsen angewiesen sind, machen Gruppen ausgewilderter Waldrappe die Südwanderung bereits auf eigene Faust.“"
                            },
                            {
                                "example_id": "0212412f-41bc-429f-8e35-f44f84e025c0",
                                "sense_id": "15336852-3ea1-382b-9d1f-880efe03efa9",
                                "text": "„Puan, das Orang-Utan-Weibchen (23 Jahre), ist eine Handaufzucht und kennt das Malen von früher.“"
                            },
                            {
                                "example_id": "9cabecd1-122c-4261-861b-6d75ecde7a4a",
                                "sense_id": "15336852-3ea1-382b-9d1f-880efe03efa9",
                                "text": "„Handaufzuchten sind häufig distanzloser gegenüber Artgenossen und Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
