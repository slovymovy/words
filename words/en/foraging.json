                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ищущий пищу",
                                "target_lang_sense_clarification": "о животных или птицах"
                            },
                            {
                                "target_lang_word": "добывающий пропитание",
                                "target_lang_sense_clarification": "в дикой природе"
                            },
                            {
                                "target_lang_word": "поиск пищи",
                                "target_lang_sense_clarification": "в значении герундия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "324a3eec-58bf-3c58-b43a-3459e1b1a37d",
                    "sense_definition": "The act of searching for wild food resources or other provisions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guide led a successful wild mushroom <w>foraging</w> trip through the damp forest.",
                            "target_lang_translations": {
                                "ru": "Гид провёл успешный поход за <w>сбором</w> диких грибов по сырому лесу."
                            }
                        },
                        {
                            "text": "Most of the bee <w>foraging</w> takes place within a short flight from the hive.",
                            "target_lang_translations": {
                                "ru": "Большая часть <w>фуражировки</w> пчёл происходит недалеко от улья."
                            }
                        }
                    ],
                    "synonyms": [
