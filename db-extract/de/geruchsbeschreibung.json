                "senses": [
                    {
                        "sense_id": "a52bb950-95d2-3427-b1b7-9ab8e5f600ff",
                        "entry_id": "11f5c50d-c9a1-3d08-b27d-42b3f87f790d",
                        "glosses": [
                            "das Beschreiben eines Geruchs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a71d5ace-3b98-4a1a-9893-80385452e015",
                                "sense_id": "a52bb950-95d2-3427-b1b7-9ab8e5f600ff",
                                "text": "„Der Fragebogen zur quantitativen Geruchsbeschreibung bestand aus den vier Skalen „Intensität“, „Angenehm“, „Unangenehm“ und „Bekanntheit“.“"
                            },
                            {
                                "example_id": "65d3ccf9-4459-4fc0-a3f6-3f16d6031c70",
                                "sense_id": "a52bb950-95d2-3427-b1b7-9ab8e5f600ff",
                                "text": "„Mit der Geruchsbeschreibung arbeitet seit Jahrzehnten die Parfümerie.“"
                            },
                            {
                                "example_id": "bd57fe02-8cd5-406c-8c05-7a35743fe3c6",
                                "sense_id": "a52bb950-95d2-3427-b1b7-9ab8e5f600ff",
                                "text": "„Für Geruchsbeschreibungen braucht man besondere Adjektive, die die Art des Geruchs wiedergeben und kategorisieren.“"
                            },
                            {
                                "example_id": "cce5fe3a-e5a8-4d4d-8cc3-8022cb37b77a",
                                "sense_id": "a52bb950-95d2-3427-b1b7-9ab8e5f600ff",
                                "text": "„Geruchsbeschreibung: So finden Sie im Bairischen eine nahezu unbeschränkte Palette an Ausdrücken zur Beschreibung von Gerüchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
