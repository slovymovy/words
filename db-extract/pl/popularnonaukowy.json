                                    {
                                        "sense_id": "ef37962f-3b7c-3301-956e-fa884ebf2c49",
                                        "entry_id": "9122bee9-3717-30f7-9842-0b78c3f87973",
                                        "glosses": [
                                            "sich ohne höheren Anspruch mit wissenschaftlichen Themen an ein breites Publikum richtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0354e77-57fd-42b7-9283-ae3768d8ca1d",
                                                "sense_id": "ef37962f-3b7c-3301-956e-fa884ebf2c49",
                                                "text": "„Nach 1848/49 kam es im deutschsprachigen Raum zu einem rapiden Anwachsen des populärwissenschaftlichen Büchermarktes.“"
                                            },
                                            {
                                                "example_id": "0ed81b30-428b-480d-962a-bc2ea8a42bdc",
                                                "sense_id": "ef37962f-3b7c-3301-956e-fa884ebf2c49",
                                                "text": "„Insbesondere stehen die Geschlechterrollen von Männern und Frauen mit türkischem Migrationshintergrund sowohl in den medialen als auch populärwissenschaftlichen Debatten im Fokus.“"
                                            },
                                            {
                                                "example_id": "c012f593-615d-43cf-a7db-d03204742dd1",
                                                "sense_id": "ef37962f-3b7c-3301-956e-fa884ebf2c49",
                                                "text": "„Über diese Frage hat sich das populärwissenschaftliche Magazin ‚Katapult‘ mit einem Redakteur der ‚Süddeutschen Zeitung‘ gestritten.“"
                                            },
                                            {
                                                "example_id": "fc7c65ec-4d03-4410-8d10-a75cce33f9c4",
                                                "sense_id": "ef37962f-3b7c-3301-956e-fa884ebf2c49",
                                                "text": "„So erklärt er – in einer Ästhetik, die an populärwissenschaftliche Fernsehmagazine wie ‚Galileo‘ oder ‚Welt der Wunder‘ erinnert – Themen wie den Klimawandel oder den Islam.“"
                                            }
                                        ],
