                            "feminine"
                        ],
                        "form": "parcimonieuse"
                    },
                    {
                        "form_id": "9261d63f-5c58-4d0f-802d-e7072762151d",
                        "entry_id": "4f1602a9-affc-3184-8dc8-eef701ef3374",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "parcimonieuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "163a8eee-0bb9-34aa-bb33-8627fc7cfc2b",
                        "entry_id": "4f1602a9-affc-3184-8dc8-eef701ef3374",
                        "glosses": [
                            "Qui a de la parcimonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2503ab81-6369-4418-a941-bb9a93a17a0e",
                                "sense_id": "163a8eee-0bb9-34aa-bb33-8627fc7cfc2b",
                                "text": "Dame ! on est parcimonieux chez soi quand on est prodigue au dehors !"
                            },
                            {
                                "example_id": "5541ad68-3909-4ceb-90a7-c8d24ca64a22",
                                "sense_id": "163a8eee-0bb9-34aa-bb33-8627fc7cfc2b",
                                "text": "Mais le nouveau tarif épouvanta notre village parcimonieux, et, dès le lendemain, la troupe nous quittait pour planter ses tentes à X…, petite ville voisine, aristocratique et coquette, tapie au pied de son château, prosternée devant ses châtelains titrés."
                            },
                            {
                                "example_id": "4b6dd873-7449-43a4-9766-e33cec6aa1ce",
                                "sense_id": "163a8eee-0bb9-34aa-bb33-8627fc7cfc2b",
                                "text": "Lorsqu’on entre, c’est elle qu’on voit, près de l’ampoule électrique parcimonieuse, près de l’escalier noir qui monte vers les appartements, près des portes des cabinets dont elle éteint soigneusement l’ampoule après chaque passage."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d6c279c-7918-3a57-8ae5-0c163011b5ad",
                        "entry_id": "4f1602a9-affc-3184-8dc8-eef701ef3374",
                        "glosses": [
                            "Se dit d'un modèle faisant intervenir un faible nombre de paramètres."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1a37ad5-fcc6-4cea-be01-788480eda640",
                        "source_entry_id": "4f1602a9-affc-3184-8dc8-eef701ef3374",
                        "target_lang_word": "knauserig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knauserig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0697821-44f6-34f7-b678-5d0fbaf3b993",
                                        "entry_id": "824a58af-ec2c-3f4d-8538-eb7ab7bda1af",
                                        "glosses": [
                                            "äußerst sparsam, geizig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b0efd0-f35c-42fd-b594-3e8f3c71ff5c",
                                                "sense_id": "c0697821-44f6-34f7-b678-5d0fbaf3b993",
                                                "text": "„Doch angesichts der rund 23.000 Todesopfer und bis zu zwei Millionen hilfsbedürftigen Menschen in ihrem Land nach dem verheerenden Wirbelsturm ‚Nargis‘ blieben die Militärmachthaber knauserig.“"
                                            },
                                            {
                                                "example_id": "80a0d8fd-8783-4c0d-99f5-83c719f6f3b2",
                                                "sense_id": "c0697821-44f6-34f7-b678-5d0fbaf3b993",
                                                "text": "„Die Autohersteller haben bereits Stellen gestrichen, und die privaten Banken sind mit Krediten knauserig geworden, nachdem die Ausfallrate im Mai einen Höchststand erreicht hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc78f73-4974-436c-9c87-7b953c9a7325",
                        "source_entry_id": "4f1602a9-affc-3184-8dc8-eef701ef3374",
                        "target_lang_word": "knickrig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knickrig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aac2c712-1767-378b-ae33-1a11a5d892d1",
                                        "entry_id": "0d00629f-3466-34e6-bad5-14ca21a7caa3",
                                        "glosses": [
                                            "äußerst sparsam, geizig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc5f431-0dec-4ca5-b746-34d2684e17e4",
                                                "sense_id": "aac2c712-1767-378b-ae33-1a11a5d892d1",
                                                "text": "„Außerdem waren sie knickrig, denk mal dran, wie bei deinem Onkel August zwölf Mann mit einer Ente gespeist wurden.“"
                                            },
                                            {
                                                "example_id": "5465c7ba-33cc-4179-aebe-ea99a50140c3",
                                                "sense_id": "aac2c712-1767-378b-ae33-1a11a5d892d1",
                                                "text": "„Ihre Gegentypen sind unfreundlich, streitsüchtig, hartherzig, undankbar und knickrig.“"
                                            },
                                            {
                                                "example_id": "a9caded1-7696-49d6-bb39-c1eb1dc320b9",
                                                "sense_id": "aac2c712-1767-378b-ae33-1a11a5d892d1",
                                                "text": "„Hinterm Tresen sind sie ja richtig knickrig, aber außer Dienst dafür umso großzügiger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aef2cfb-3366-4d08-9125-431192fa713f",
                        "source_entry_id": "4f1602a9-affc-3184-8dc8-eef701ef3374",
                        "target_lang_word": "parsimonious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parsimonious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43969acc-4aad-3295-b490-5fbfc63001af",
                                        "entry_id": "df8ac340-a3c4-3923-8caf-04bdf8c48892",
                                        "glosses": [
                                            "Exhibiting parsimony; sparing in the expenditure of money; frugal, possibly to excess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a35a273-1ece-4873-9dbe-ea36b8b2db5e",
                                                "sense_id": "43969acc-4aad-3295-b490-5fbfc63001af",
                                                "text": "He was regular in his habits, parsimonious, and industrious; but he lacked all talent needed at the bar—he had neither address, nor eloquence, nor ingenuity."
                                            },
                                            {
                                                "example_id": "f8aaeeff-efd7-42b3-be80-652448c41472",
                                                "sense_id": "43969acc-4aad-3295-b490-5fbfc63001af",
                                                "text": "Our fathers would have an economical government, even if grand people called it a parsimonious one, and taxes should be no greater than were absolutely necessary to pay for such a government."
                                            },
                                            {
                                                "example_id": "8640f95a-7183-44bd-8380-66f982bfa50f",
                                                "sense_id": "43969acc-4aad-3295-b490-5fbfc63001af",
                                                "text": "The first three college-savings plans stand out for their parsimonious expenses […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2541abdc-66ac-33ab-aa2a-a8a2cf3a63a9",
                                        "entry_id": "df8ac340-a3c4-3923-8caf-04bdf8c48892",
                                        "glosses": [
                                            "Using a minimal number of assumptions, steps, or conjectures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef3422d-912b-478f-a1c7-fdb14db50740",
                                                "sense_id": "2541abdc-66ac-33ab-aa2a-a8a2cf3a63a9",
                                                "text": "Statistical methods offer the ability to enforce parsimonious selection of the most influential potential predictors of each gene's state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0f2d1c4-b21c-372d-9ec3-d4fa86800b28",
                                        "entry_id": "df8ac340-a3c4-3923-8caf-04bdf8c48892",
                                        "glosses": [
                                            "Not conceding many goals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ccb984-c09f-40df-b2cc-173ba5cc0de6",
                                                "sense_id": "e0f2d1c4-b21c-372d-9ec3-d4fa86800b28",
                                                "text": "They played like a team that was in a hurry to get back to the Premier League. Norwich City had dismantled the most parsimonious defence in the Championship inside the opening quarter of an hour and at the final whistle it was the yellow end, rather than Middlesbrough’s banks of red, where the euphoria could be found."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e6b4a8a-8b83-495d-9aee-cb079b084dba",
                        "source_entry_id": "4f1602a9-affc-3184-8dc8-eef701ef3374",
                        "target_lang_word": "stingy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stingy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95bd91d8-3472-3993-840e-233eff8ec12f",
                                        "entry_id": "29b0fb9c-648e-333d-ba04-0fe57197774a",
                                        "glosses": [
                                            "Stinging; able or inclined to sting."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b44ea69-23a0-4bc5-a62e-1a696778492b",
                                                "sense_id": "95bd91d8-3472-3993-840e-233eff8ec12f",
                                                "text": "Bumble bee – Bumble bee / I send to you this sonnet, / But please don't be – Bumble bee / The stingy bee in my bonnet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stingy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c4482f-cb8d-3088-aa45-ce4d0750f846",
                                        "entry_id": "41ef67e6-1f16-33fa-8d4f-48c9cf2a32e1",
                                        "glosses": [
                                            "Unwilling to spend, give, or share; ungenerous; mean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2922a777-259a-42cf-872b-2ed9c6285007",
                                                "sense_id": "b9c4482f-cb8d-3088-aa45-ce4d0750f846",
                                                "text": "\"Well, I'm doing my best to grow,\" said Davy, \"but it's a thing you can't hurry much. If Marilla wasn't so stingy with her jam I believe I'd grow a lot faster.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4b0658-f8a5-32db-be97-6f7183924bf7",
                                        "entry_id": "41ef67e6-1f16-33fa-8d4f-48c9cf2a32e1",
                                        "glosses": [
                                            "Small, scant, meager, insufficient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "460e8246-7840-45f4-9e72-c3f8609b0cf0",
                                                "sense_id": "6e4b0658-f8a5-32db-be97-6f7183924bf7",
                                                "text": "The realization of this joint oppression is like discovering that the stingy crusts of bread being held out by society have mold on them."
                                            },
                                            {
                                                "example_id": "a14b458a-4d17-4e05-ae44-87491eba484c",
                                                "sense_id": "6e4b0658-f8a5-32db-be97-6f7183924bf7",
                                                "text": "As the moon wheels around Earth every 28 days and shows us a progressively greater and then stingier slice of its sun-lightened face, the distance between the moon and Earth changes, too. At the nearest point along its egg-shaped orbit, its perigee, the moon may be 26,000 miles closer to us than it is at its far point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f35f7403-85b1-4036-8553-eba3a345fb78",
                        "source_entry_id": "4f1602a9-affc-3184-8dc8-eef701ef3374",
                        "target_lang_word": "thrifty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrifty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83492601-fdf9-3b03-8ae6-19e2f3518b73",
                                        "entry_id": "b0b8ce67-be21-3b43-bdac-d6c832d12b7b",
                                        "glosses": [
                                            "Showing thrift; economical; frugal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed0334b-19bd-4fa0-a43f-44265fed1f5e",
                                                "sense_id": "83492601-fdf9-3b03-8ae6-19e2f3518b73",
                                                "text": "That was a certain trade, while th' age was thrifty, / And men good husbands, look'd into their stocks, / Had their minds bounded; now the public riot / Prostitutes all, scatters away in coaches, / In footmens coats, and waiting womens gowns"
                                            },
                                            {
                                                "example_id": "2dc3e8fd-011d-4657-bab3-c9b96ad3557f",
                                                "sense_id": "83492601-fdf9-3b03-8ae6-19e2f3518b73",
                                                "text": "Nor less disastrous, should his thrifty urn / Neglected leave the once well-water'd land, / To dreary wastes yon paradise would turn, / Polluted ooze, or heaps of barren sand."
                                            },
                                            {
                                                "example_id": "6833e0e6-5a97-4243-b222-12745ef4e573",
                                                "sense_id": "83492601-fdf9-3b03-8ae6-19e2f3518b73",
                                                "text": "Both were thrifty and hardworking. From the beginning of their marriage both worked steadily and saved every penny above their basic living expenses. By their first anniversary they were saving almost all of Richard's earnings as a union carpenter—eighty to ninety dollars a week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                        "entry_id": "b0b8ce67-be21-3b43-bdac-d6c832d12b7b",
                                        "glosses": [
                                            "Thriving, prosperous, successful; (of an animal or plant) growing rapidly or vigorously."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14181562-372b-4f80-896d-9d397785d9bc",
                                                "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                                "text": "The life of religion is this water of life; where that runs, where that is received, and where things are done in this spirit, there all things are well: The church thrifty, the soul thrifty, graces thrifty, and all is well."
                                            },
                                            {
                                                "example_id": "4667de34-6b95-456a-885c-8834c0005011",
                                                "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                                "text": "the lands on this road are of an excellent quality, and in many places light timbered, in others covered with thrifty oak, black walnut, sugar maple, beach and linden."
                                            },
                                            {
                                                "example_id": "1882986b-1af9-437e-94a5-ab8b28a15341",
                                                "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                                "text": "But, Gentlemen, the gallant Admiral has told you he has two loves; and he seems to have made a prudent choice, and been a very thrifty wooer."
                                            },
                                            {
                                                "example_id": "1f48f83b-1a6d-4aa7-adae-0a1c4d3ef407",
                                                "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                                "text": "A thrifty tree of twelve or eighteen inches diameter will increase in its quantity or weight by one year's growth, beyond that of a small sprout or tree in a ratio of more than five to one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                        "entry_id": "b0b8ce67-be21-3b43-bdac-d6c832d12b7b",
                                        "glosses": [
                                            "Preserved by thrift; carefully managed."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f8a937a-0eae-48b8-bb8e-7e07526966f0",
                                                "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                                "text": "The amount of patient toil, with its thrifty rewards; of domestic happiness, with its radiant comforts; the amount of intelligent culture, of high-aimed virtue, and of kindly charity, — that have been realized here, if not matter of our boasting, is the glory of our inheritance."
                                            },
                                            {
                                                "example_id": "7a881cec-3524-4fe0-9244-b899931a6c17",
                                                "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                                "text": "They han great stores, and thriftye flockes, / great freendes and feeble foes"
                                            },
                                            {
                                                "example_id": "ebe4b163-2a52-4d16-8b55-e362bfa14b30",
                                                "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                                "text": "But do not ſo: I haue fiue hundred Crownes,\n The thriftie hire I ſaued vnder your Father,\n Which I did ſtore to be my foſter Nurſe"
                                            },
                                            {
                                                "example_id": "5fa5402f-e15e-4630-8bbe-17d649eac700",
                                                "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                                "text": "No more the shadows of the plane-tree and the beech allay the intensity of the solstitial heat; no more the feathered tribes are heard to chirrup amidst the sprays, or the active squirrel seen to disport among the boughs, or collect his thrifty store of acrons ^([sic]) and of nuts, under the cool and impenetrable recesses of the glade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3187b47f-3857-4bd8-9194-9963fe6c8ae9",
