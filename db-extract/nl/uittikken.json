        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "b3b9e2c5-ce96-30af-90bc-e25ac2503d8c",
                "word": "uittikken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e42dd70a-a965-3aa2-8225-b4537323fa61",
                        "entry_id": "b3b9e2c5-ce96-30af-90bc-e25ac2503d8c",
                        "glosses": [
                            "iets met behulp van een toetsenbord overtypen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d7ab14-b074-4333-ab5a-37bccfdc1cce",
                                "sense_id": "e42dd70a-a965-3aa2-8225-b4537323fa61",
                                "text": "De schrijver van de romancyclus A la recherche du temps perdu, Marcel Proust, kwam amper zijn kamer uit, maar hield stevig de regie in handen om zijn werk in de markt te zetten. Van het eerste deel, Du côté de chez Swann, bepaalde hij de prijszetting en de typografie. Zelfs de ontvangst wilde hij in de hand houden. Daartoe schreef hij zelf flatterende recensies. Die stuurde hij naar zijn uitgever om ze te laten uittikken, zodat er geen spoor was van zijn handschrift."
                            },
                            {
                                "example_id": "3009cc07-d673-42c2-8b8b-16cbdf429105",
                                "sense_id": "e42dd70a-a965-3aa2-8225-b4537323fa61",
                                "text": "Król beschikt inmiddels over 800 uur opnames van conversaties in het Wymysoojs. En dankzij de universiteit van Warschau krijgt hij, na jaren voor niets te hebben gewerkt, nu ook af en toe geld voor het uittikken van gesprekken en het delen van zijn kennis."
                            },
                            {
                                "example_id": "33440fe4-8a1a-43b9-ad88-b0a0e9f65b62",
                                "sense_id": "e42dd70a-a965-3aa2-8225-b4537323fa61",
                                "text": "Helemaal nieuw is het systeem niet, maar wie het nog niet eerder zag, verbaast zich. Acecad uit Taiwan maakt met de DigiMemo het uittikken van handgeschreven tekst overbodig. De DigiMemo is een kunststof plaat, iets groter dan A4 formaat. Daarop komt een gewoon schrijfblok te liggen. Met een speciale pen, die echter net zo schrijft als een conventionele balpen, maakt de scribent zijn aantekeningen, of tekent hij tabellen of grafieken. Vervolgens wordt de DigiMemo aangesloten op de computer. De software zet de handgeschreven tekst om in Word, waarna het bestand naar believen kan worden bewerkt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae62f83a-d8e7-4d4e-a75d-7a05c1f091d2",
                        "source_entry_id": "b3b9e2c5-ce96-30af-90bc-e25ac2503d8c",
                        "source_sense_id": "e42dd70a-a965-3aa2-8225-b4537323fa61",
                        "target_lang_word": "type",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "type",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "846c752b-23a2-389d-a920-ef932db2f6c4",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "A grouping based on shared characteristics; a class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca74d359-f556-4b98-a8d5-4560a78ed089",
                                                "sense_id": "846c752b-23a2-389d-a920-ef932db2f6c4",
                                                "text": "This type of plane can handle rough weather more easily than that type of plane."
                                            },
                                            {
                                                "example_id": "f4a563c0-98cb-494c-91f4-b590f10db3b9",
                                                "sense_id": "846c752b-23a2-389d-a920-ef932db2f6c4",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f718912-9f9f-3330-82e1-6d0cf0cfc81a",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "An individual considered typical of its class, one regarded as typifying a certain profession, environment, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e264f5-4c39-459e-a5da-1aa257792d66",
                                                "sense_id": "4f718912-9f9f-3330-82e1-6d0cf0cfc81a",
                                                "text": "Look, with these gals that want to buy it, most of them are older, dignified. Social Register types, you know what I mean? They can't be trotting down to Times Square to pick out the merchandise. They got to have some kind of, uh, middleman."
                                            },
                                            {
                                                "example_id": "ee1c0bf8-df32-45e8-95d2-ef291ede2484",
                                                "sense_id": "4f718912-9f9f-3330-82e1-6d0cf0cfc81a",
                                                "text": "\"I just peeked out toward the restaurant and there are a lot of Navy types in there. I'd hate for you to get in trouble on your last night in Europe.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8334f716-814b-35f2-91ea-8ee6dc815a62",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "An individual that represents the ideal for its class; an embodiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60f3d43-45c5-4c1c-931e-fcb0b16befbc",
                                                "sense_id": "8334f716-814b-35f2-91ea-8ee6dc815a62",
                                                "text": "Altogether he was the type of low ruffianism — as ill-conditioned a looking brute as ever ginned a hare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e65cd0a0-12e2-3113-97a3-ec25360546c5",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "A letter or character used for printing, historically a cast or engraved block.",
                                            "Such types collectively, or a set of type of one font or size."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfe5da2c-c638-359c-8a14-e531d3900c56",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "A letter or character used for printing, historically a cast or engraved block.",
                                            "Text printed with such type, or imitating its characteristics."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7f467a3-8f5a-456b-afa5-1158f434af75",
                                                "sense_id": "bfe5da2c-c638-359c-8a14-e531d3900c56",
                                                "text": "The headline was set in bold type."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fe2fe0a-2576-3a22-906b-dcc442a19209",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "Something, often a specimen, selected as an objective anchor to connect a scientific name to a taxon; this need not be representative or typical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b980af5-3fb1-43d7-b85a-d4960006a62d",
                                                "sense_id": "4fe2fe0a-2576-3a22-906b-dcc442a19209",
                                                "text": "...thus Stearn has designated Linnaeus as the type specimen of Homo sapiens"
                                            },
                                            {
                                                "example_id": "6ac9615e-773f-429f-95d9-6f62a3d0e009",
                                                "sense_id": "4fe2fe0a-2576-3a22-906b-dcc442a19209",
                                                "text": "Musca domestica is the type-species of Musca, a genus originally created by Linnaeus for a variety of higher Diptera, many of which are now known to be in other families."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9890be3b-f7da-36d5-af60-fd43dc625c49",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "Preferred sort of person; sort of person that one is attracted to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd45d5bd-5f24-44e2-908c-523a92cd83c1",
                                                "sense_id": "9890be3b-f7da-36d5-af60-fd43dc625c49",
                                                "text": "We can't get along: he's just not my type."
                                            },
                                            {
                                                "example_id": "85d67458-ee6a-42d8-a0a7-901bf9a98f50",
                                                "sense_id": "9890be3b-f7da-36d5-af60-fd43dc625c49",
                                                "text": "He was exactly her type."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c17d586-8acc-354d-8fb4-2873f13f6bae",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "A blood group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2bd0aa6-a43c-36da-acee-a300f3eae7ed",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "A word that occurs in a text or corpus irrespective of how many times it occurs, as opposed to a token."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dade4186-89d0-3351-97c2-e02e9ff376d8",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "An event or person that prefigures or foreshadows a later event - commonly an Old Testament event linked to Christian times."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d4056d1-f0b7-3152-9710-a33744ed8cc9",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "A tag attached to variables and values used in determining which kinds of value can be used in which situations; a data type."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d47c9510-98fd-3d5b-9921-36cc3cdb3258",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "The original object, or class of objects, scene, face, or conception, which becomes the subject of a copy; especially, the design on the face of a medal or a coin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfa75189-acbb-34ba-83c9-e55131c19a84",
                                        "entry_id": "2b583594-5f66-3d14-b41b-869db1c45039",
                                        "glosses": [
                                            "A simple compound, used as a mode or pattern to which other compounds are conveniently regarded as being related, and from which they may be actually or theoretically derived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe97de2a-74d9-42e8-a59d-82c9c03bc9c5",
                                                "sense_id": "dfa75189-acbb-34ba-83c9-e55131c19a84",
                                                "text": "The fundamental types used to express the simplest and most essential chemical relations are hydrochloric acid, water, ammonia, and methane."
                                            }
                                        ]
                                    },
