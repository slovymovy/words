                "senses": [
                    {
                        "sense_id": "3bd27c65-7126-3308-922c-16459a015fd0",
                        "entry_id": "92979c8a-b923-3628-a421-466bc994777c",
                        "glosses": [
                            "weibliche Person, die an einer Hochschule Biologie studiert"
                        ],
                        "tags": [
                            "Bildungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "34832775-7cf0-46a5-b8c3-4ea46c1755fa",
                                "sense_id": "3bd27c65-7126-3308-922c-16459a015fd0",
                                "text": "„Nadja war eine junge deutsche Biologiestudentin, die hier als eine von mehreren Freiwilligen ein Praktikum machte.“"
                            },
                            {
                                "example_id": "c9707210-a038-4e4f-aa6a-fcb415d88c3c",
                                "sense_id": "3bd27c65-7126-3308-922c-16459a015fd0",
                                "text": "„Die Biologiestudentin interessierte sich auch für Astrophysik, also sozusagen für das Belebte und das Unbelebte, »wobei sich das eine aus dem andern zusammensetzt«, pflegte sie zu betonen.“"
                            },
                            {
                                "example_id": "91ad72c3-cb35-49f0-99ca-dedbec8ce0d6",
                                "sense_id": "3bd27c65-7126-3308-922c-16459a015fd0",
                                "text": "„Sophia, eine Biologiestudentin im letzten Semester, bekommt durch einen vermeintlichen Zufall die Gelegenheit, in der Südsee als wissenschaftliche Mitarbeiterin in einem Meeresbiologischen Institut zu arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
