                "senses": [
                    {
                        "sense_id": "054cc348-f05f-3db0-871c-9aec9b949498",
                        "entry_id": "ffcdfae3-7a18-3b53-b4cd-950744f517e7",
                        "glosses": [
                            "fury, rage, frenzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78d229d1-b400-4577-a817-1b13a480a44e",
                                "sense_id": "054cc348-f05f-3db0-871c-9aec9b949498",
                                "text": "На дворе́ шуме́ла непого́да. Что́-то бе́шеное, зло́бное, но глубоко́ несча́стное с я́ростью зве́ря мета́лось вокру́г тракти́ра и стара́лось ворва́ться вовну́трь.",
                                "translation": "Outside a storm was raging. Something frantic and wrathful, but profoundly unhappy, seemed to be flinging itself about the tavern with the ferocity of a wild beast and trying to break in.",
                                "english": "Outside a storm was raging. Something frantic and wrathful, but profoundly unhappy, seemed to be flinging itself about the tavern with the ferocity of a wild beast and trying to break in."
                            },
                            {
                                "example_id": "85ba3840-98e1-4c00-ada1-dc53d3239ad7",
                                "sense_id": "054cc348-f05f-3db0-871c-9aec9b949498",
                                "text": "Пусть ярость благородная вскипает как волна!\nИдёт война народная, священная война!",
                                "translation": "Let noble wrath boil up like a wave!\nThe people's war is going on, a sacred war!",
                                "english": "Let noble wrath boil up like a wave!\nThe people's war is going on, a sacred war!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
