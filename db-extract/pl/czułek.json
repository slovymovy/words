                        "cross_references": [
                            {
                                "target_word": "Fühler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e69ecf30-9217-34a1-8951-0eee35b3d851",
                                        "entry_id": "1e68231f-af67-3c09-a6e9-395deb30330a",
                                        "glosses": [
                                            "Körperteil, das zum Tasten und Fühlen verwendet wird (meist bei Insekten etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb2a5290-236b-4fba-a43a-c2d01cbda7c7",
                                                "sense_id": "e69ecf30-9217-34a1-8951-0eee35b3d851",
                                                "text": "„Der Kopf trägt als Sinnesorgane die Augen (Oculi), Fühler (Antenne) und die Mundwerkzeuge. An den Kopf schließt der Halsschild (Pronotum) an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a23c1f47-ff0a-373d-9e62-107a7c7673f7",
                                        "entry_id": "1e68231f-af67-3c09-a6e9-395deb30330a",
                                        "glosses": [
                                            "kurz für Messfühler"
                                        ],
