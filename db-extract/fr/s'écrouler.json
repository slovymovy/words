                ],
                "translations": [
                    {
                        "translation_id": "2cc19d34-ce18-41d0-8be5-1b6511b41ba8",
                        "source_entry_id": "792369f7-8859-3582-91f1-a317f88cde97",
                        "source_sense_id": "9c08cb0b-0f4e-3be8-a7e7-d1812e734dff",
                        "target_lang_word": "einstürzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einstürzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d5c5be9-d541-3fa8-9854-cbbc4bfce266",
                                        "entry_id": "eacb17c1-06f8-371b-8f28-99a5c48a187c",
                                        "glosses": [
                                            "in sich zusammenfallen, so dass die Einzelteile direkt übereinander und unten am Boden liegen"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a9b46f-ff6e-430b-bd0a-5c3e75178281",
                                                "sense_id": "0d5c5be9-d541-3fa8-9854-cbbc4bfce266",
                                                "text": "Ich glaube nicht, dass der Schuppen so schnell einstürzt, der sieht doch ganz stabil aus."
                                            },
                                            {
                                                "example_id": "1aa58bb1-c8e8-4a73-90e4-578b196e48c3",
                                                "sense_id": "0d5c5be9-d541-3fa8-9854-cbbc4bfce266",
                                                "text": "Meistens geht dem Einstürzen ein Ächtzen und Krachen voran, hört man so etwas, muss man sich augenblicklich entfernen."
                                            },
                                            {
                                                "example_id": "a41f09e6-1665-41f7-8ac1-38829feec1e0",
                                                "sense_id": "0d5c5be9-d541-3fa8-9854-cbbc4bfce266",
                                                "text": "„In Edwardsville in Illinois stürzte das Dach eines Verteilzentrums des Online-Händlers Amazon teilweise ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8b93b76-34ba-3a72-a69b-e3dadf6442ef",
                                        "entry_id": "eacb17c1-06f8-371b-8f28-99a5c48a187c",
                                        "glosses": [
                                            "eine Person befallen, ohne dass diese genügend Zeit hat, den Vorgang kontrollieren zu können"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "figurative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c70c2cb-2482-4b86-817f-b31f0da23223",
                                                "sense_id": "f8b93b76-34ba-3a72-a69b-e3dadf6442ef",
                                                "text": "Tausend Gedanken stürzten auf sie ein."
                                            },
                                            {
                                                "example_id": "e8163f9e-571d-4a99-8940-e23ce2c166c6",
                                                "sense_id": "f8b93b76-34ba-3a72-a69b-e3dadf6442ef",
                                                "text": "„Zu viele Gefühle stürzten auf sie ein, zu viele Ereignisse überschlugen sich.“"
                                            },
                                            {
                                                "example_id": "eb8f1b50-af62-44e8-92d7-dcf3a69830ef",
                                                "sense_id": "f8b93b76-34ba-3a72-a69b-e3dadf6442ef",
                                                "text": "„Mehrere Mitglieder stürzen auf ihn ein, umringen ihn, drohen ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a6ce8c5-e4b9-39a8-9aa0-206a6856956c",
                                        "entry_id": "eacb17c1-06f8-371b-8f28-99a5c48a187c",
                                        "glosses": [
                                            "etwas zum Einsturz bringen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71e3a60e-1a96-4756-b2bd-8901b4a7c53b",
                                                "sense_id": "8a6ce8c5-e4b9-39a8-9aa0-206a6856956c",
                                                "text": "Es gibt ausgerechnet in unserer auf Liberalität setzenden Gesellschaft, die radikal jede Menge Tabus eingestürzt hat, auch eine erhebliche Menge neuer Tabuzonen."
                                            },
                                            {
                                                "example_id": "0b6acadb-b063-41d6-b7d2-bdb871c87281",
                                                "sense_id": "8a6ce8c5-e4b9-39a8-9aa0-206a6856956c",
                                                "text": "Tokat, eine der bedeutendsten Städte Kleinasiens, ist, wie bereits gemeldet, von einem Erdbeben verwüstet worden, welches den größten Theil der Häuser und 2 Moscheen eingestürzt hat."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
