                            }
                        },
                        {
                            "text": "De sfeer in het café was <w>bruisend</w> en vol gezelligheid.",
                            "target_lang_translations": {
                                "en": "The atmosphere in the café was <w>lively</w> and full of conviviality.",
                                "ru": "Атмосфера в кафе была <w>оживленной</w> и очень уютной."
                            }
