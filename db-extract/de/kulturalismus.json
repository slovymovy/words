                "senses": [
                    {
                        "sense_id": "5b79788c-2a67-3f7b-9d17-4f6c9d8fbaea",
                        "entry_id": "5c502d48-6d45-3d76-8fd7-2e37aaab3a44",
                        "glosses": [
                            "culturalism"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d810dd5b-f672-407b-a06d-129954145275",
                                "sense_id": "5b79788c-2a67-3f7b-9d17-4f6c9d8fbaea",
                                "text": "Es hat Fälle gegeben, in denen mordenden Ehemännern, Vätern oder Brüdern ein kultureller Rabatt bei sogenannten »Ehrentaten« gewährt wurde. Solcher Kulturalismus ist nichts anderes als eine weiche Form des Rassismus."
                            },
                            {
                                "example_id": "631d17ff-6358-4d75-8065-101415ba550e",
                                "sense_id": "5b79788c-2a67-3f7b-9d17-4f6c9d8fbaea",
                                "text": "Erstaunlich an der Rezeption Saids ist, wie gern er von der Kulturkritik als Kronzeuge aufgerufen wird, auch wenn autoritäre Systeme infrage gestellt werden. Dabei mutiert Saids Orientalismus zu einem positiv verstandenen Kulturalismus."
                            }
                        ]
                    }
                ],
