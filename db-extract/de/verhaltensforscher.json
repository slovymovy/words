                "senses": [
                    {
                        "sense_id": "fdb1d941-f526-360c-b203-737643bea0cb",
                        "entry_id": "1e6b6a67-e5f6-3110-b628-af335bd7ccd8",
                        "glosses": [
                            "Wissenschaftler, der die Verhaltensweisen von Tieren und Menschen studiert und beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b06ae5f-4bae-4ccc-ba9f-b1211518e5da",
                                "sense_id": "fdb1d941-f526-360c-b203-737643bea0cb",
                                "text": "Konrad Lorenz beschäftigte sich als Verhaltensforscher insbesondere mit Graugänsen."
                            },
                            {
                                "example_id": "2cd22294-6c19-4eb5-890a-84332fdae3c4",
                                "sense_id": "fdb1d941-f526-360c-b203-737643bea0cb",
                                "text": "Beschäftigung finden Verhaltensforscher/innen in zoologischen Gärten und Tierparks sowie an Hochschulen, etwa an zoologischen, biologischen oder veterinärmedizinischen Instituten."
                            },
                            {
                                "example_id": "1472e4b5-48bb-4a71-b40c-cfd39522cf09",
                                "sense_id": "fdb1d941-f526-360c-b203-737643bea0cb",
                                "text": "„Auch setzt er sich nicht wie Verhaltensforscher geduldig ins Freie, um die Tiere zu beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
