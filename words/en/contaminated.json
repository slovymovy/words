{
    "word_family": [
        "contaminate",
        "contamination",
        "contaminant",
        "decontaminate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d79f9eab-aa7b-33d4-9893-d05701f1bb0f",
                    "sense_definition": "Made impure or unfit for use by the introduction of harmful or undesirable elements.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers were advised not to drink the <w>contaminated</w> water.",
                            "target_lang_translations": {
                                "ru": "Жителям деревни посоветовали не пить <w>загрязнённую</w> воду.",
                                "nl": "De dorpelingen werd geadviseerd om het <w>verontreinigde</w> water niet te drinken.",
                                "zh": "村民们被建议不要饮用<w>受污染的</w>水。"
                            }
                        },
                        {
                            "text": "All <w>contaminated</w> instruments must be sterilized before they can be used again.",
                            "target_lang_translations": {
                                "ru": "Все <w>загрязнённые</w> инструменты должны быть простерилизованы перед повторным использованием.",
                                "nl": "Alle <w>besmette</w> instrumenten moeten worden gesteriliseerd voordat ze opnieuw kunnen worden gebruikt.",
                                "zh": "所有<w>受污染的</w>器械在再次使用前都必须进行消毒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "polluted",
                        "tainted",
                        "adulterated"
                    ],
                    "antonyms": [
                        "pure"
                    ],
                    "common_phrases": [
                        "contaminated water",
                        "contaminated food",
                        "contaminated soil",
                        "heavily contaminated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставший нечистым или непригодным для использования из-за попадания вредных или нежелательных элементов.",
                        "nl": "Onzuiver of ongeschikt voor gebruik gemaakt door de toevoeging van schadelijke of ongewenste elementen.",
                        "zh": "因有害或不良成分的进入而变质或不宜使用的；受污染的、受感染的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнённый",
                                "target_lang_sense_clarification": "содержащий вредные примеси или грязь"
                            },
                            {
                                "target_lang_word": "заражённый",
                                "target_lang_sense_clarification": "содержащий инфекцию, вирусы или радиацию"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verontreinigd",
                                "target_lang_sense_clarification": "algemene term voor stoffen die onzuiverheden bevatten"
                            },
                            {
                                "target_lang_word": "besmet",
                                "target_lang_sense_clarification": "specifiek voor infecties, bacteriën of virussen"
                            },
                            {
                                "target_lang_word": "vervuild",
                                "target_lang_sense_clarification": "vaak gebruikt voor milieuvervuiling zoals water of bodem"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受污染的",
                                "target_lang_sense_clarification": "通用，指受到有害杂质、毒物等污染"
                            },
                            {
                                "target_lang_word": "被污染的",
                                "target_lang_sense_clarification": "指环境、水源或物体遭到有害物质污染"
                            },
                            {
                                "target_lang_word": "受感染的",
                                "target_lang_sense_clarification": "指带有病菌、病毒等生物污染"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "180e6ff5-1c1c-3bdc-adb2-a03ae357e3a4",
                    "sense_definition": "Simple past and past participle of <w>contaminate</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory accident <w>contaminated</w> the river with toxic chemicals.",
                            "target_lang_translations": {
                                "ru": "Авария на заводе <w>загрязнила</w> реку токсичными химикатами.",
                                "nl": "Het fabrieksongeluk <w>verontreinigde</w> de rivier met giftige chemicaliën.",
                                "zh": "工厂事故产生的有毒化学物质<w>污染</w>了这条河流。"
                            }
                        },
                        {
                            "text": "The crime scene was <w>contaminated</w> by people walking through it.",
                            "target_lang_translations": {
                                "ru": "Место преступления было <w>загрязнено</w> людьми, ходившими по нему.",
                                "nl": "De plaats delict werd <w>vervuild</w> door mensen die er doorheen liepen.",
                                "zh": "由于有人走动，犯罪现场遭到了<w>破坏</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "contaminated with",
                        "contaminated by"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола contaminate.",
                        "nl": "Verleden tijd en voltooid deelwoord van het werkwoord 'contaminate' (verontreinigen).",
                        "zh": "动词 contaminate（污染、玷污、弄脏）的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнил",
                                "target_lang_sense_clarification": "сделал грязным или непригодным (прошедшее время)"
                            },
                            {
                                "target_lang_word": "заразил",
                                "target_lang_sense_clarification": "передал инфекцию или отравил (прошедшее время)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verontreinigde",
                                "target_lang_sense_clarification": "verleden tijd van verontreinigen"
                            },
                            {
                                "target_lang_word": "besmette",
                                "target_lang_sense_clarification": "verleden tijd van besmetten"
                            },
                            {
                                "target_lang_word": "vervuild",
                                "target_lang_sense_clarification": "voltooid deelwoord van vervuilen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "污染",
                                "target_lang_sense_clarification": "使环境、物体或水源变脏或有害"
                            },
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "使不洁净或破坏原始状态"
                            },
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "指现场、证据等受到干扰或损毁"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}