                "senses": [
                    {
                        "sense_id": "c73d1e34-1251-3c51-8d26-7d0d065615cb",
                        "entry_id": "0711f602-fb0d-3608-adc4-e870c9e8b11e",
                        "glosses": [
                            "Bewegung von Fahrzeugen, die zur Fortbewegung mindestens eine Schiene brauchen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35764efb-fee6-4569-821d-6d563638dc3a",
                                "sense_id": "c73d1e34-1251-3c51-8d26-7d0d065615cb",
                                "text": "Der Schienenverkehr verbreitete sich am Ende des 19. Jahrhunderts im Westen."
                            },
                            {
                                "example_id": "b961f044-2a22-4ce1-a8d0-20b6442a4f01",
                                "sense_id": "c73d1e34-1251-3c51-8d26-7d0d065615cb",
                                "text": "Der Schienenverkehr kam zum Erliegen, als die Weichenzentrale ausfiel. Alle Züge in Österreich standen für 50 Minuten still!"
                            }
                        ],
