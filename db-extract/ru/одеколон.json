                                            {
                                                "example_id": "bbb58149-4d54-4fd1-b03c-cb1d48e6f22b",
                                                "sense_id": "778d4083-332a-3ae7-9030-5a4191fb8799",
                                                "text": "O giderken yanaklarına, ellerine kolonya sürdürdü."
                                            }
                                        ]
