                            },
                            {
                                "target_word": "mullah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2ec488d-1a33-3c05-8ac3-bdad6b5787fb",
                                        "entry_id": "893dbc73-a22b-304c-bf4a-337ef15c256e",
                                        "glosses": [
                                            "Alternative form of muller (“to beat, thrash”)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9581211-75e8-4278-bd1d-bd6f578d3805",
                                                "sense_id": "e2ec488d-1a33-3c05-8ac3-bdad6b5787fb",
                                                "text": "But I mullahed him. He may have been four inches taller but I punched him through the ropes and knocked the granny and the grandad out of him."
                                            },
                                            {
                                                "example_id": "d0ae1786-d15b-45b2-8b60-3606cfb2a7e9",
                                                "sense_id": "e2ec488d-1a33-3c05-8ac3-bdad6b5787fb",
                                                "text": "The Sevens practice session was touch rugby, but every time Harvey got the ball, I absolutely mullahed him. I pushed him, dumped him on his arse, ran through him. Every time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
