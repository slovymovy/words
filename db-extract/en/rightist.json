                    {
                        "translation_id": "476e4bc6-d5af-4420-8325-9a8f98315e97",
                        "source_entry_id": "14c9c543-7256-398d-9a43-3f98ec7c3fa0",
                        "source_sense_description": "supporter of the political right",
                        "target_lang_word": "Rechter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8c8459d-14f4-3caf-b103-71519a8a4de7",
                                        "entry_id": "4be88609-545f-3708-8cb8-a4e57b9b0094",
                                        "glosses": [
                                            "Mann, der einer rechten (beispielsweise konservativen, rechtspopulistischen, rechtsextremen) Partei nahesteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f12c93-199f-4964-af70-0f34651de7d5",
                                                "sense_id": "e8c8459d-14f4-3caf-b103-71519a8a4de7",
                                                "text": "„Aber vor allem sind wir stolz, dass wir den Rechten gezeigt haben: ›Wir sind mehr‹.“"
                                            },
                                            {
                                                "example_id": "73920c90-c3b2-44bd-94af-37101aa0c6de",
                                                "sense_id": "e8c8459d-14f4-3caf-b103-71519a8a4de7",
                                                "text": "„Kundgebungen und Feste in ganz Kassel sollen den für den 20. Juli angekündigten Aufmarsch der Rechten verhindern.“"
                                            },
                                            {
                                                "example_id": "6c01d110-fee1-4c10-8c57-777023c30eeb",
                                                "sense_id": "e8c8459d-14f4-3caf-b103-71519a8a4de7",
                                                "text": "„Die AfD hat im Spitzenteam dem Rechten Alexander Gauland die Ökonomin Alice Weidel an die Seite gestellt.“"
                                            },
                                            {
                                                "example_id": "1d1709bc-7536-49c5-8799-43bd144541c3",
                                                "sense_id": "e8c8459d-14f4-3caf-b103-71519a8a4de7",
                                                "text": "[Schlagzeile:] „Warum deutsche Talkshows den Rechten nutzen“"
                                            },
                                            {
                                                "example_id": "b60270ee-0de8-4462-b6b5-4c13e19c9ad8",
                                                "sense_id": "e8c8459d-14f4-3caf-b103-71519a8a4de7",
                                                "text": "„Ist dieser Mann ein Rechter? Rechts nicht im Sinne von konservativ, sondern von rechtsaußen, völkisch, rassistisch, kurzum inakzeptabel?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rechter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3958452-882a-31d3-a041-ec77e8e437b1",
