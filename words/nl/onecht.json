{
    "word_family": [
        "echtheid",
        "onechtheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3be1095c-87c3-3ba1-bde4-a809ad8cc819",
                    "sense_definition": "Niet echt, kunstmatig, nagemaakt of verzonnen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "niet-origineel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij draagt vandaag een ketting met <w>onechte</w> diamanten.",
                            "target_lang_translations": {
                                "en": "Today she is wearing a necklace with <w>fake</w> diamonds."
                            }
                        },
                        {
                            "text": "Zijn glimlach voelde heel <w>onecht</w> aan tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "His smile felt very <w>insincere</w> during the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "vals",
                        "kunstmatig",
                        "nagemaakt",
                        "artificieel"
                    ],
                    "antonyms": [
                        "echt"
                    ],
                    "common_phrases": [
                        "onechte diamanten",
                        "onechte glimlach"
                    ],
                    "target_lang_definitions": {
                        "en": "Not real, artificial, imitated, or made up."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "false",
                                "target_lang_sense_clarification": "not genuine or real"
                            },
                            {
                                "target_lang_word": "fake",
                                "target_lang_sense_clarification": "imitation or counterfeit"
                            },
                            {
                                "target_lang_word": "artificial",
                                "target_lang_sense_clarification": "man-made, not natural"
                            },
                            {
                                "target_lang_word": "phony",
                                "target_lang_sense_clarification": "insincere or fraudulent"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2acc567-300e-3b82-9186-cc67ee4657bd",
                    "sense_definition": "Niet authentiek of vervalst, in het bijzonder met betrekking tot documenten of kunstwerken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "niet-origineel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De expert stelde vast dat het om een <w>onecht</w> document ging.",
                            "target_lang_translations": {
                                "en": "The expert determined that it was a <w>forged</w> document."
                            }
                        },
                        {
                            "text": "Dit schilderij bleek na onderzoek een <w>onecht</w> kunstwerk te zijn.",
                            "target_lang_translations": {
                                "en": "This painting turned out to be a <w>fake</w> work of art after investigation."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervalst",
                        "frauduleus",
                        "apocrief"
                    ],
                    "antonyms": [
                        "echt"
                    ],
                    "common_phrases": [
                        "onecht document",
                        "onecht kunstwerk"
                    ],
                    "target_lang_definitions": {
                        "en": "Not authentic or forged, especially regarding documents or artworks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forged",
                                "target_lang_sense_clarification": "copied fraudulently"
                            },
                            {
                                "target_lang_word": "fake",
                                "target_lang_sense_clarification": "not genuine"
                            },
                            {
                                "target_lang_word": "inauthentic",
                                "target_lang_sense_clarification": "lacking authenticity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b33578fd-3860-3640-8c28-4cb5813dddd6",
                    "sense_definition": "Buitenechtelijk geboren of buiten het huwelijk plaatsvindend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "buitenechtelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historische documenten werd hij omschreven als een <w>onecht</w> kind.",
                            "target_lang_translations": {
                                "en": "In historical documents, he was described as an <w>illegitimate</w> child."
                            }
                        },
                        {
                            "text": "Zij kregen een <w>onecht</w> kind in een tijd dat dit sociaal onacceptabel was.",
                            "target_lang_translations": {
                                "en": "They had a child <w>out of wedlock</w> at a time when this was socially unacceptable."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitenechtelijk",
                        "onwettig"
                    ],
                    "antonyms": [
                        "echt"
                    ],
                    "common_phrases": [
                        "onecht kind"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vooral in historische of formele context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Born out of wedlock or occurring outside of marriage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "illegitimate",
                                "target_lang_sense_clarification": "born of parents not married to each other"
                            },
                            {
                                "target_lang_word": "out-of-wedlock",
                                "target_lang_sense_clarification": "outside of marriage"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17de115e-23c2-3b50-a635-2d32731a62e3",
                    "sense_definition": "Een buitenechtelijke relatie of gemeenschap.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "buitenechtelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude wetboeken werd streng gestraft op het leven in <w>onecht</w>.",
                            "target_lang_translations": {
                                "en": "In old law books, living in <w>concubinage</w> was severely punished."
                            }
                        },
                        {
                            "text": "Zij kozen ervoor om in <w>onecht</w> samen te leven.",
                            "target_lang_translations": {
                                "en": "They chose to live together <w>unmarried</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "concubinaat"
                    ],
                    "common_phrases": [
                        "in onecht leven"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Verouderd juridisch of formeel begrip"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An extramarital relationship or cohabitation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "concubinage",
                                "target_lang_sense_clarification": "cohabitation without being legally married"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}