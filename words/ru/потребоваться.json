    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9571b09b-2a66-31c4-b72d-a70ba2154c93",
                    "sense_definition": "Стать нужным, необходимым для какой-либо цели или в определённых обстоятельствах.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "необходимость",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для завершения этого сложного проекта нам <w>потребуется</w> опытный программист.",
                            "target_lang_translations": {
                                "pl": "Do ukończenia tego skomplikowanego projektu <w>będzie nam potrzebny</w> doświadczony programista."
                            }
                        },
                        {
                            "text": "Если вам <w>потребуется</w> помощь с переездом, обязательно звоните мне в любое время.",
                            "target_lang_translations": {
                                "pl": "Jeśli <w>będzie Panu potrzebna</w> pomoc przy przeprowadzce, proszę koniecznie dzwonić o każdej porze."
                            }
                        }
                    ],
                    "synonyms": [
                        "понадобиться"
                    ],
                    "antonyms": [
                        "обойтись"
                    ],
                    "common_phrases": [
                        "потребуется помощь",
                        "потребуется время",
                        "потребуются деньги",
                        "если потребуется"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stać się potrzebnym lub koniecznym do osiągnięcia jakiegoś celu albo w danych okolicznościach."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przydać się",
                                "target_lang_sense_clarification": "okazać się przydatnym"
                            },
                            {
                                "target_lang_word": "być potrzebnym",
                                "target_lang_sense_clarification": "stać się niezbędnym"
                            },
                            {
                                "target_lang_word": "okazać się potrzebnym",
                                "target_lang_sense_clarification": "stać się koniecznym w danej sytuacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bb13747-e615-3c3f-9a58-8829b4754bcd",
                    "sense_definition": "Занять определённое количество времени, сил или других затрат для выполнения действия.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "затраты",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На подготовку всех необходимых документов нам <w>потребовалось</w> около двух недель.",
                            "target_lang_translations": {
                                "pl": "Przygotowanie wszystkich niezbędnych dokumentów <w>zajęło</w> nam około dwóch tygodni."
                            }
                        },
                        {
                            "text": "Для решения этой математической задачи <w>потребуется</w> немало усилий и терпения.",
                            "target_lang_translations": {
                                "pl": "Rozwiązanie tego zadania matematycznego <w>będzie wymagało</w> niemało wysiłku i cierpliwości."
                            }
                        }
                    ],
                    "synonyms": [
                        "понадобиться"
                    ],
                    "common_phrases": [
                        "потребуется много времени",
                        "потребовалось немало усилий"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wymagać określonej ilości czasu, sił lub innych nakładów na wykonanie czynności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wymagać",
                                "target_lang_sense_clarification": "pochłonąć nakłady, czas lub wysiłek"
                            },
                            {
                                "target_lang_word": "zająć",
                                "target_lang_sense_clarification": "o czasie potrzebnym na działanie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}