                        "entry_id": "149da3ab-1ae5-3cd2-84a6-9505920eaee2",
                        "glosses": [
                            "A temporary location with better sources of pollen to which a hive is moved during times when the plants in the normal location of the hive have dried up."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd06277-6150-424a-a7f6-0fde00203bdf",
                                "sense_id": "51aa4939-7330-33c4-8b5c-8016074c286f",
                                "text": "There may be thirty to fifty supers in every outyard, and we have only about half an hour to get them off the hives, stacked and covered before the bees get really cross about what we are doing."
                            },
                            {
                                "example_id": "7c439f7b-883c-4c0a-8cfa-613bac8aecd1",
                                "sense_id": "51aa4939-7330-33c4-8b5c-8016074c286f",
                                "text": "Nowhere was this more evident than when we moved four of her beehives to the outyard."
                            }
                        ]
                    }
                ],
