                                    {
                                        "sense_id": "3ebb935d-a5c6-301c-ab70-826493c8b206",
                                        "entry_id": "01f0d2e9-1043-3677-b384-70907c70579d",
                                        "glosses": [
                                            "teoria o centralnym położeniu Słońca we wszechświecie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d20244-9aa7-47e6-91ec-ae8686e17ba8",
                                                "sense_id": "3ebb935d-a5c6-301c-ab70-826493c8b206",
                                                "text": "Był to nie tylko pierwszy bezpośredni i eksperymentalny dowód heliocentryzmu, ale także okazało się po raz pierwszy, jak ogromna odległość dzieli Układ Słoneczny od innych gwiazd."
                                            },
                                            {
                                                "example_id": "c0070f5a-a48e-48dc-94c4-e0e7755953dc",
                                                "sense_id": "3ebb935d-a5c6-301c-ab70-826493c8b206",
                                                "text": "O sprzyjanie heliocentryzmowi oskarżono również kilku władców."
                                            }
