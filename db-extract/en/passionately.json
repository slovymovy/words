                                    {
                                        "sense_id": "1ec092f3-3a6a-393a-8efc-c8fec136b56f",
                                        "entry_id": "db1ec7cb-fe61-397b-b724-a163361dc84c",
                                        "glosses": [
                                            "Avec beaucoup de passion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "709e5688-dedd-4677-853a-e0af95cb995b",
                                                "sense_id": "1ec092f3-3a6a-393a-8efc-c8fec136b56f",
                                                "text": "J'aime pour la première fois de ma vie, et j'aime passionnément, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd3c0a7-de38-30de-8cb5-dd9921b345d6",
                                        "entry_id": "db1ec7cb-fe61-397b-b724-a163361dc84c",
                                        "glosses": [
                                            "Avec beaucoup de désir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a9d4d49-c018-4e53-bcbf-7342b5e31a8f",
                                                "sense_id": "bdd3c0a7-de38-30de-8cb5-dd9921b345d6",
                                                "text": "Cela donna d’extrêmes inquiétudes à la reine, qui souhaitait passionnément sa guérison […]"
                                            },
                                            {
                                                "example_id": "bf802813-8c9a-4be5-874e-e73fd056ca08",
                                                "sense_id": "bdd3c0a7-de38-30de-8cb5-dd9921b345d6",
                                                "text": "Le maître [Vauban], passionnément amoureux du bien public, ne demandait qu’à faire des élèves qui l’égalassent […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bc0a6b8-fd8c-4cb6-9fa4-edaf664c604c",
                        "source_entry_id": "f7081c0d-aa9c-3e7b-b989-4532101928a9",
