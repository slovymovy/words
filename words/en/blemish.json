{
    "word_family": [
        "unblemished"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8a4a584-5c4f-3821-a4cc-b6e9a4b2e71d",
                    "sense_definition": "A small flaw, spot, or stain that spoils the appearance of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flaw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a concealer to hide the small <w>blemish</w> on her cheek."
                        },
                        {
                            "text": "The antique table had a tiny <w>blemish</w> on the surface from years of use."
                        }
                    ],
                    "synonyms": [
                        "flaw",
                        "spot",
                        "stain",
                        "imperfection"
                    ],
                    "common_phrases": [
                        "skin blemish",
                        "minor blemish"
                    ]
                },
                {
                    "sense_id": "211ec2ef-b7f3-3192-b98b-83ffea62b383",
                    "sense_definition": "A moral defect or a flaw in someone's character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flaw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His dishonesty was a serious <w>blemish</w> on his otherwise respectable character."
                        },
                        {
                            "text": "A lack of empathy is often considered a significant <w>blemish</w> in a leader."
                        }
                    ],
                    "synonyms": [
                        "defect",
                        "fault",
                        "failing"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a9f8e0e-57a1-3953-a954-421d598bcdd9",
                    "sense_definition": "To spoil or damage the appearance of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spoil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain did not <w>blemish</w> the beauty of the garden."
                        },
                        {
                            "text": "Poor construction can <w>blemish</w> the look of a modern building."
                        }
                    ],
                    "synonyms": [
                        "mar",
                        "spoil",
                        "damage"
                    ]
                },
                {
                    "sense_id": "0fdf66ad-2f9a-3089-aab1-70c3cff05147",
                    "sense_definition": "To damage or tarnish someone's reputation or character.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spoil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal served to <w>blemish</w> his long-standing reputation in the community."
                        },
                        {
                            "text": "He feared that the false accusations would <w>blemish</w> his professional record."
                        }
                    ],
                    "synonyms": [
                        "tarnish",
                        "stain",
                        "sully"
                    ]
                }
            ]
        }
    ]
}