                        "examples": [
                            {
                                "example_id": "a0b7480a-aa5e-4526-be48-77fa17e78c02",
                                "sense_id": "247864a9-4ad5-3743-8bf2-8c3cf9dc9b5d",
                                "text": "„Außerdem lagen mehrere Wandbilder kreuz und quer am Boden und der Plattenspieler war kaputt.“"
                            },
                            {
                                "example_id": "738ea501-c0fb-410f-a1b6-e582fb20bbc2",
                                "sense_id": "247864a9-4ad5-3743-8bf2-8c3cf9dc9b5d",
                                "text": "„Ringsumher hingen Wandbilder aus Seide in allen Farben, die ausgeschnitten und aufgeklebt waren.“"
                            }
                        ],
