                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sconcertante",
                                "target_lang_sense_clarification": "che lascia disorientati o perplessi"
                            },
                            {
                                "target_lang_word": "disorientante",
                                "target_lang_sense_clarification": "che confonde le idee o toglie i punti di riferimento"
                            },
                            {
                                "target_lang_word": "enigmatico",
                                "target_lang_sense_clarification": "misterioso e difficile da spiegare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65ecf939-350c-30c7-b888-dc911c97f508",
                    "sense_definition": "Causing frustration and confusion due to difficulty or obstruction",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dealing with the government office was a slow and <w>baffling</w> ordeal.",
