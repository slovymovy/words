                "senses": [
                    {
                        "sense_id": "52581ebe-64a6-37de-843c-7b7923eb0c2e",
                        "entry_id": "aa4ca7b5-e2f8-3afd-8ab8-a0f7aa958c1b",
                        "glosses": [
                            "das vorherbestimmte Schicksal"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "5b41ba23-1954-4f2b-ac62-c48278648698",
                                "sense_id": "52581ebe-64a6-37de-843c-7b7923eb0c2e",
                                "text": "„Kismet bedeutet, dass wir nur auf den Wellen des Lebens getrieben werden - mal an diesen, mal an jenen Ort.“"
                            },
                            {
                                "example_id": "671425bd-f48e-413b-8b14-3e64c4e4b7cf",
                                "sense_id": "52581ebe-64a6-37de-843c-7b7923eb0c2e",
                                "text": "„Und wenn die Dame des Hauses gerade da ist, liest sie dem Gast sein persönliches Kismet aus der Mokkatasse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1d694c8-865f-4271-a4fb-d67865dd5d6d",
                        "source_entry_id": "aa4ca7b5-e2f8-3afd-8ab8-a0f7aa958c1b",
                        "source_sense_id": "52581ebe-64a6-37de-843c-7b7923eb0c2e",
                        "source_sense_description": "Islam: das vorherbestimmte Schicksal",
                        "target_lang_word": "судьба",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "судьба",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "01829ec2-8132-3013-acad-2e0f9af4f27e",
                                        "entry_id": "3b192431-b109-3ec4-bd33-d77480b815d9",
                                        "glosses": [
                                            "удел, предопределённый или складывающийся независимо от воли человека ход его жизни; персонализованная или безличная сила, управляющая событиями жизни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0be9807-1eb8-48d7-8ee7-45d46b74f9cb",
                                                "sense_id": "01829ec2-8132-3013-acad-2e0f9af4f27e",
                                                "text": "Зато судьба заботливо выручала его из отчаянных положений, оттаскивала за волосы, за шиворот от самого края…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23e5fa1-5b28-3729-88da-a9842dafac8f",
                                        "entry_id": "3b192431-b109-3ec4-bd33-d77480b815d9",
                                        "glosses": [
                                            "жизненный путь, совокупность событий, обстоятельств жизни, существования кого-либо, чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdaf9653-913c-477a-953f-dfad99318fba",
                                                "sense_id": "c23e5fa1-5b28-3729-88da-a9842dafac8f",
                                                "text": "Я хочу доказать, что нотки архаизма в творчестве Бунина заведомо обусловили судьбу эмигранта."
                                            },
                                            {
                                                "example_id": "d7b9aac1-b53f-4bb0-b575-39d647b106c2",
                                                "sense_id": "c23e5fa1-5b28-3729-88da-a9842dafac8f",
                                                "text": "Окна нашей комнаты выходили как раз на монастырь, и мы были свидетелями его печальной судьбы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9f8924-15ff-335f-aae1-6b659290052f",
                                        "entry_id": "3b192431-b109-3ec4-bd33-d77480b815d9",
                                        "glosses": [
                                            "дальнейшее существование, будущее кого-либо, чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7a4c109-68c9-41ed-bcaf-8141d7bc3f89",
                                                "sense_id": "cb9f8924-15ff-335f-aae1-6b659290052f",
                                                "text": "Зло неистребимо. Никакой человек не способен уменьшить его количество в мире. Он может несколько улучшить свою собственную судьбу, но всегда за счёт ухудшения судьбы других."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
