                ],
                "senses": [
                    {
                        "sense_id": "737cff3b-98ab-3351-b581-3ed1f9d48980",
                        "entry_id": "487f4f47-7fe2-3881-a69e-18f670da4b62",
                        "glosses": [
                            "zubereitetes oder zur Zubereitung vorgesehenes, entgrätetes Stück vom Zander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd51ef21-ef9b-4c3a-855a-070941753119",
                                "sense_id": "737cff3b-98ab-3351-b581-3ed1f9d48980",
                                "text": "„Küchenchef Dietrichs zaubert leichte und köstliche Gerichte wie Risotto mit Chorizo und Rucola oder Zanderfilet auf Steckrüben auf die Teller.“"
                            },
                            {
                                "example_id": "df0d06ea-9beb-428d-848c-e79b9c416194",
                                "sense_id": "737cff3b-98ab-3351-b581-3ed1f9d48980",
                                "text": "„Küchenchef Manfred Grossmann servierte ein warmes Büfett, unter anderem mit Zanderfilet auf Paprika-Couscous, Milchkalbsrücken im Parmesanmantel, Pilzragout mit Mini-Semmelknödel oder Tiramisu von der Valrhona-Schokolade.“"
                            },
                            {
                                "example_id": "009fdef7-55a5-4b87-98c0-2d9f88be35d0",
                                "sense_id": "737cff3b-98ab-3351-b581-3ed1f9d48980",
                                "text": "Dass das Zanderfilet frisch ist, behauptet auch nur der Koch, nicht ich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
