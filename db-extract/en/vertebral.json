                                "target_senses": [
                                    {
                                        "sense_id": "f93d5aca-b4cd-328b-96e2-7ad3037dd00a",
                                        "entry_id": "e731f89b-21b5-32e8-8ae3-26391eb60e63",
                                        "glosses": [
                                            "die Wirbel, die Wirbelsäule betreffend; zu Wirbeln, der Wirbelsäule gehörend; aus Wirbeln bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf3dcf7-37b9-4052-bb9a-fd3f3b5e7cd4",
                                                "sense_id": "f93d5aca-b4cd-328b-96e2-7ad3037dd00a",
                                                "text": "Das »vertebrale Syndrom« ist ein klinischer Sammelbegriff für die lokale segmentale Manifestation der Erkrankungen von Bewegungssegmenten und den daraus resultierenden segmentalen Leistungsstörungen."
                                            },
                                            {
                                                "example_id": "9d2ec55e-a2cc-4140-8dd4-e196594a52e8",
                                                "sense_id": "f93d5aca-b4cd-328b-96e2-7ad3037dd00a",
                                                "text": "Die vertebrale Endplatte besteht aus einer 0,6-1 mm dicken Knorpelschicht."
                                            },
                                            {
                                                "example_id": "679b69bb-4203-4359-97b3-6c6d83894d8d",
                                                "sense_id": "f93d5aca-b4cd-328b-96e2-7ad3037dd00a",
                                                "text": "Vertebrale Hämangiome sind benigne Läsionen, die zu einer Resorption des betroffenen Knochens führen können (…). Meist ist nur ein Wirbelkörper betroffen."
                                            },
                                            {
                                                "example_id": "8e24d9cc-82fe-4acb-9d52-3f7e9fb1a746",
                                                "sense_id": "f93d5aca-b4cd-328b-96e2-7ad3037dd00a",
                                                "text": "Knochen: Eine Östrogen- oder Östrogen-Gestagen-Therapie verhindert den frühen postmenopausalen Knochenverlust sowie Hüft- und vertebrale Frakturen."
                                            },
                                            {
                                                "example_id": "e1e63483-1839-4ffe-8f94-bd0f2c5ba239",
                                                "sense_id": "f93d5aca-b4cd-328b-96e2-7ad3037dd00a",
                                                "text": "Bei allen Patienten war das vertebrale Wachstum noch nicht abgeschlossen (Risser 0 bis 3) und die vertebralen Apophysen nicht verschmolzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
