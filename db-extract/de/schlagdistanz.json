                "senses": [
                    {
                        "sense_id": "784c5c36-b190-3a07-a917-069974625501",
                        "entry_id": "342266a5-0a91-338b-8c4d-d738168f9c49",
                        "glosses": [
                            "Situation bei einem Wettbewerb, bei der der Abstand zwischen zwei konkurrierenden Sportlern oder Mannschaften so gering ist, dass der Zurückliegende die Chance hat, seinen Konkurrenten zu überholen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a59579-11b3-4ded-8759-7a04c66af224",
                                "sense_id": "784c5c36-b190-3a07-a917-069974625501",
                                "text": "„Manchester verbesserte sich auf Rang acht und hat nun wieder Schlagdistanz zu den Startplätzen für den europäischen Wettbewerb.“"
                            },
                            {
                                "example_id": "56221a80-5a03-4302-8bcf-b85ec5dec16d",
                                "sense_id": "784c5c36-b190-3a07-a917-069974625501",
                                "text": "„GM werde fünf bis sechs Jahre benötigen, um mit seiner Produktstrategie in Schlagdistanz zu Volkswagen zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8bc79221-5702-3b1d-a7b0-6daa27e57469",
                        "entry_id": "342266a5-0a91-338b-8c4d-d738168f9c49",
                        "glosses": [
                            "maximale Entfernung, die mit einem Schlag erreicht werden kann"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "05caa669-4b56-4444-86d1-1eb5afb2382d",
                                "sense_id": "8bc79221-5702-3b1d-a7b0-6daa27e57469",
                                "text": "„Der mittlere kam einen Schritt auf mich zu und stand nun einen Meter von mir entfernt. Schlagdistanz!“"
                            },
                            {
                                "example_id": "d35d26df-0661-44cc-8742-840e7255c7e5",
                                "sense_id": "8bc79221-5702-3b1d-a7b0-6daa27e57469",
                                "text": "„Mit schnellen Beinen gleitet er immer wieder in Schlagdistanz, trifft Schmeling – und ist weg, bevor der Konterschlag kommt.“"
                            },
                            {
                                "example_id": "3517763b-a5c9-436e-86d0-784cab978eae",
                                "sense_id": "8bc79221-5702-3b1d-a7b0-6daa27e57469",
                                "text": "„Phil blieb in Schlagdistanz zu Pasquano stehen.“"
                            },
                            {
                                "example_id": "9327af67-0661-4e4b-837d-5ed24424a7aa",
                                "sense_id": "8bc79221-5702-3b1d-a7b0-6daa27e57469",
                                "text": "„Nun werde geübt, wie man sich aktiv aus der Schlagdistanz entfernen könne, ohne verletzbar zu sein.“"
                            },
                            {
                                "example_id": "28d93f9d-41b7-41bb-9fdb-142f1c916fcf",
                                "sense_id": "8bc79221-5702-3b1d-a7b0-6daa27e57469",
                                "text": "„Wenn der Gegner seinen rechten Fuß hinten hat, solltet ihr euch innerhalb der Schlagdistanz nur zu seiner linken hinbewegen; zu seiner rechten Seite bewegt ihr euch nur, wenn er den linken Fuß hinten hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
