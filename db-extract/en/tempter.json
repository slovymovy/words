                    },
                    {
                        "sense_id": "7f436bc5-72d6-3504-b7b6-8745b3740a05",
                        "entry_id": "f3361b87-719d-3faf-a1bc-5ccdc66b08fb",
                        "glosses": [
                            "A seducer, especially a man who seduces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8684fd7-71fc-4123-8a77-8c66f39b9cc5",
                                "sense_id": "7f436bc5-72d6-3504-b7b6-8745b3740a05",
                                "text": "He is a tempter of married women."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc704986-1e96-4849-ad62-efc69698cd5d",
                        "source_entry_id": "f3361b87-719d-3faf-a1bc-5ccdc66b08fb",
                        "source_sense_description": "Someone that tempts",
                        "target_lang_word": "tentateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tentateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5778ca0-64eb-36c4-b36e-91111476b436",
                                        "entry_id": "2f3de1f0-2b49-3213-9590-3c5f3304cb1f",
                                        "glosses": [
                                            "Qui soumet à la tentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032e6e87-0364-4d28-9930-1fa52890ba5a",
                                                "sense_id": "f5778ca0-64eb-36c4-b36e-91111476b436",
                                                "text": "L'Église post-grégorienne exploite ce que les Écritures et la Tradition lui offrent-pour \"monachiser\" ses clercs séculiers et les détacher de la femme tentatrice."
                                            },
                                            {
                                                "example_id": "84068186-79df-4078-8527-a29f985bafe7",
                                                "sense_id": "f5778ca0-64eb-36c4-b36e-91111476b436",
                                                "text": "Je produis quelques talbins tentateurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tentateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f435c4f-eb9c-3fba-99d8-5dfc7c89e2b0",
                                        "entry_id": "506ea0ca-8e85-349d-892c-442bdc7aa114",
                                        "glosses": [
                                            "Celui qui tente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ef8517-b746-408a-82b0-97c022ec80b9",
                                                "sense_id": "6f435c4f-eb9c-3fba-99d8-5dfc7c89e2b0",
                                                "text": "Contre toute attente, cette proposition n'est pas du goût du shah qui préfère s'en aller cette fois encore, après avoir cependant offert un plateau de fruits aux tentatrices. Autre pays, autres mœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9651330-c15e-3af2-bf60-948709958e33",
                                        "entry_id": "506ea0ca-8e85-349d-892c-442bdc7aa114",
                                        "glosses": [
                                            "Le démon."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "note": "Dans ce sens l'on emploie l'article défini",
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51540a08-fa40-4ffb-b239-1e73096e4cfc",
                        "source_entry_id": "f3361b87-719d-3faf-a1bc-5ccdc66b08fb",
                        "source_sense_description": "Someone that tempts",
                        "target_lang_word": "Verführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                        "entry_id": "54e91b65-e6d1-3f22-be23-873a6d43fe97",
                                        "glosses": [
                                            "jemand, der jemand anderen zu etwas bringt, das dieser nicht ohnehin beabsichtigt hatte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8558578-b38b-46a5-b94a-ab6157fd5b23",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Der wahre Verführer beginnt das Vorspiel am Herd.“"
                                            },
                                            {
                                                "example_id": "40ba8c06-c5a3-4d38-bf3e-88b2ba70d01d",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Im Lehrtheater lernt das Kind, wie eine Ampel funktioniert, wie man sicher eine Straße überquert, welche Verkehrszeichen, Einrichtungen oder Menschen helfen, wo Verführer und Gefahren lauern und wie man sich gegen sie wehren kann.“"
                                            },
                                            {
                                                "example_id": "2ce27e4a-605f-4e1a-8f32-13f0e39bacf2",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Wenn die Freundin sich, um nicht erröten zu müssen, eine ganz unbedeutende Gunst rauben läßt, wird sie die erste sein, die andere zu einer größeren anzuspornen; und wenn der Verführer geschickt ist, hat sich die Unschuldige bereits zu weit vorgewagt, um noch zurückweichen zu können.“"
                                            },
                                            {
                                                "example_id": "1eac1562-30e2-4b49-8396-3f847418da5b",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Blieb noch das ernste Bühnenstück oder das bürgerliche Trauerspiel, in dem untröstliche Familienväter, Diener, die ihre Herren retten, Reiche, die ihr Vermögen verschenken, unschuldige Näherinnen und ruchlose Verführer auftreten, ein Genre, das bei Diderot anfängt und sich bis zu Pixérécourt fortsetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
