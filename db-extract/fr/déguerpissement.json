                    },
                    {
                        "sense_id": "9226a1cd-01b0-3ff1-98f6-27836a192f12",
                        "entry_id": "9251003d-17b4-3320-8e41-1bb12b3e26f6",
                        "glosses": [
                            "Action de déguerpir, de se retirer contraint et forcé."
