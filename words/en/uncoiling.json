{
    "word_family": [
        "coil",
        "uncoil"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46ab788d-1332-3830-b834-8f9d18cabcc5",
                    "sense_definition": "The process or action of straightening something that was previously wound or twisted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The slow <w>uncoiling</w> of the rope revealed how tangled it had become.",
                            "target_lang_translations": {
                                "pl": "Powolne <w>rozwijanie</w> liny ujawniło, jak bardzo była splątana."
                            }
                        },
                        {
                            "text": "Constant <w>uncoiling</w> and recoiling of the wire eventually caused it to snap.",
                            "target_lang_translations": {
                                "pl": "Ciągłe <w>rozwijanie</w> i zwijanie drutu ostatecznie doprowadziło do jego pęknięcia."
                            }
                        }
                    ],
                    "synonyms": [
                        "straightening",
                        "unwinding"
                    ],
                    "antonyms": [
                        "coiling",
                        "winding"
                    ],
                    "common_phrases": [
                        "slow uncoiling"
                    ],
                    "target_lang_definitions": {
                        "pl": "Proces lub czynność prostowania czegoś, co było wcześniej zwinięte lub skręcone."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozwijanie",
                                "target_lang_sense_clarification": "ogólny proces prostowania czegoś zwiniętego"
                            },
                            {
                                "target_lang_word": "odwijanie",
                                "target_lang_sense_clarification": "proces zdejmowania zwojów z czegoś"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca5f1070-be96-32cd-af4c-da9a1f9063c6",
                    "sense_definition": "Present participle and gerund of <w>uncoil</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake was <w>uncoiling</w> itself slowly before moving across the grass.",
                            "target_lang_translations": {
                                "pl": "Wąż powoli <w>rozwijał</w> swoje ciało, zanim ruszył przez trawę."
                            }
                        },
                        {
                            "text": "She spent the afternoon <w>uncoiling</w> the garden hose to water the plants.",
                            "target_lang_translations": {
                                "pl": "Spędziła popołudnie, <w>rozwijając</w> wąż ogrodowy, aby podlać rośliny."
                            }
                        }
                    ],
                    "synonyms": [
                        "unwinding",
                        "straightening"
                    ],
                    "antonyms": [
                        "coiling",
                        "winding"
                    ],
                    "common_phrases": [
                        "uncoiling slowly"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb uncoil."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od czasownika 'uncoil' (rozwijać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozwijający się",
                                "target_lang_sense_clarification": "imiesłów przymiotnikowy opisujący czynność"
                            },
                            {
                                "target_lang_word": "rozwijając",
                                "target_lang_sense_clarification": "imiesłów przysłówkowy współczesny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}