{
    "word_family": [
        "enrage",
        "outrage",
        "rager",
        "raging"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02fe1184-36cc-37b6-90ad-f90e37fd6971",
                    "sense_definition": "Violent uncontrolled anger.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "anger_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He flew into a <w>rage</w> when he discovered that his car had been stolen.",
                            "target_lang_translations": {
                                "ru": "Он пришел в <w>ярость</w>, когда обнаружил, что его машину угнали.",
                                "de": "Er geriet in <w>Wut</w>, als er entdeckte, dass sein Auto gestohlen worden war.",
                                "zh": "当他发现车被偷时，他顿时<w>暴怒</w>起来。"
                            }
                        },
                        {
                            "text": "Her face turned red with <w>rage</w> as she read the insulting letter.",
                            "target_lang_translations": {
                                "ru": "Её лицо покраснело от <w>ярости</w>, когда она читала это оскорбительное письмо.",
                                "de": "Ihr Gesicht lief vor <w>Wut</w> rot an, als sie den beleidigenden Brief las.",
                                "zh": "读着那封侮辱性的信，她气得满脸<w>通红</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fury",
                        "ire"
                    ],
                    "common_phrases": [
                        "road rage",
                        "fly into a rage",
                        "blind rage",
                        "shaking with rage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, неконтролируемый гнев.",
                        "de": "Ein Zustand heftiger, unkontrollierter Wut.",
                        "zh": "强烈的、无法控制的愤怒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярость",
                                "target_lang_sense_clarification": "сильный гнев"
                            },
                            {
                                "target_lang_word": "бешенство",
                                "target_lang_sense_clarification": "крайняя степень раздражения"
                            },
                            {
                                "target_lang_word": "гнев",
                                "target_lang_sense_clarification": "чувство сильного возмущения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wut",
                                "target_lang_sense_clarification": "starkes Gefühl von Ärger und Aggression"
                            },
                            {
                                "target_lang_word": "Zorn",
                                "target_lang_sense_clarification": "heftiges, oft moralisch begründetes Gefühl von Ärger"
                            },
                            {
                                "target_lang_word": "Raserei",
                                "target_lang_sense_clarification": "Zustand wilder, unkontrollierter Erregung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴怒",
                                "target_lang_sense_clarification": "极度的愤怒"
                            },
                            {
                                "target_lang_word": "狂怒",
                                "target_lang_sense_clarification": "失去理智的愤怒"
                            },
                            {
                                "target_lang_word": "愤怒",
                                "target_lang_sense_clarification": "强烈的愤慨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "989b7917-6148-3cf1-986e-bf1fb6dba909",
                    "sense_definition": "A current fashion or fad that is very popular for a short time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fashion_trend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Those colorful sneakers were all the <w>rage</w> last summer.",
                            "target_lang_translations": {
                                "ru": "Те разноцветные кроссовки были <w>последним писком моды</w> прошлым летом.",
                                "de": "Diese bunten Turnschuhe waren letzten Sommer der <w>letzte Schrei</w>.",
                                "zh": "去年夏天，那些彩色的运动鞋<w>风靡一时</w>。"
                            }
                        },
                        {
                            "text": "Video games are the current <w>rage</w> among teenagers in the city.",
                            "target_lang_translations": {
                                "ru": "Видеоигры — это нынешний <w>писк моды</w> среди подростков в городе.",
                                "de": "Videospiele sind bei den Jugendlichen in der Stadt gerade der <w>letzte Schrei</w>.",
                                "zh": "电子游戏是目前城里青少年中<w>最流行</w>的玩意儿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "all the rage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Модное увлечение, которое очень популярно в течение короткого времени.",
                        "de": "Ein kurzlebiger, sehr populärer Modetrend.",
                        "zh": "短时间内非常流行的一种时尚或风潮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последний крик",
                                "target_lang_sense_clarification": "о моде"
                            },
                            {
                                "target_lang_word": "писк моды",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "der letzte Schrei",
                                "target_lang_sense_clarification": "etwas, das gerade sehr modern ist"
                            },
                            {
                                "target_lang_word": "Modeerscheinung",
                                "target_lang_sense_clarification": "ein vorübergehender Trend"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风靡一时",
                                "target_lang_sense_clarification": "形容事物非常流行"
                            },
                            {
                                "target_lang_word": "时尚潮流",
                                "target_lang_sense_clarification": "流行的趋势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0a75207-3867-31b7-807e-0ee78cea8dac",
                    "sense_definition": "A subgenre of trap music characterized by aggressive, distorted synthesizers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ played a set of <w>rage</w> tracks that kept the crowd moving all night.",
                            "target_lang_translations": {
                                "ru": "Диджей сыграл сет из <w>рейдж</w>-треков, которые заставляли толпу двигаться всю ночь.",
                                "de": "Der DJ spielte ein Set aus <w>Rage</w>-Tracks, die die Menge die ganze Nacht in Bewegung hielten.",
                                "zh": "DJ播放了一组<w>雷吉</w>音乐，让全场观众整晚都在舞动。"
                            }
                        },
                        {
                            "text": "Many new artists are experimenting with the <w>rage</w> sound in their latest albums.",
                            "target_lang_translations": {
                                "ru": "Многие новые артисты экспериментируют со звучанием <w>рейдж</w> в своих последних альбомах.",
                                "de": "Viele neue Künstler experimentieren auf ihren neuesten Alben mit dem <w>Rage</w>-Sound.",
                                "zh": "许多新晋艺人正在他们的最新专辑中尝试<w>雷吉</w>风格的音效。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поджанр трэп-музыки, характеризующийся агрессивными, искаженными синтезаторами.",
                        "de": "Ein Subgenre der Trap-Musik, das durch aggressive, verzerrte Synthesizer-Klänge geprägt ist.",
                        "zh": "一种以激进、失真的合成器音效为特征的陷阱音乐子流派。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейдж",
                                "target_lang_sense_clarification": "музыкальный стиль"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Rage",
                                "target_lang_sense_clarification": "Musikgenre (wird im Deutschen meist als Anglizismus verwendet)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雷吉音乐",
                                "target_lang_sense_clarification": "音乐流派"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6e33578-e501-3f4e-88d3-3b8d954f3d20",
                    "sense_definition": "To move or continue with great violence or intensity, such as a storm, fire, or conflict.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "violent_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm <w>raged</w> outside the cabin for three days without stopping.",
                            "target_lang_translations": {
                                "ru": "Шторм <w>бушевал</w> снаружи хижины три дня без остановки.",
                                "de": "Der Sturm <w>wütete</w> drei Tage lang ununterbrochen vor der Hütte.",
                                "zh": "暴风雨在小屋外面<w>肆虐</w>了三天，一直没有停歇。"
                            }
                        },
                        {
                            "text": "A fierce debate has <w>raged</w> for years about the best way to solve the problem.",
                            "target_lang_translations": {
                                "ru": "Ожесточенные споры <w>бушевали</w> годами о том, как лучше всего решить эту проблему.",
                                "de": "Über den besten Weg zur Lösung des Problems <w>tobt</w> seit Jahren eine heftige Debatte.",
                                "zh": "关于解决该问题的最佳方法，一场激烈的辩论已经<w>持续</w>多年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "storm"
                    ],
                    "common_phrases": [
                        "rage on",
                        "battle raged",
                        "fire raged"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить или продолжаться с большой силой или интенсивностью (о шторме, огне или конфликте).",
                        "de": "Mit großer Heftigkeit oder Intensität ablaufen (z. B. bei einem Sturm, Feuer oder Konflikt).",
                        "zh": "指风暴、火灾或冲突等以巨大的力量或强度发生或持续。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бушевать",
                                "target_lang_sense_clarification": "о стихии или ветре"
                            },
                            {
                                "target_lang_word": "свирепствовать",
                                "target_lang_sense_clarification": "о шторме, болезни или войне"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wüten",
                                "target_lang_sense_clarification": "kraftvoll und zerstörerisch agieren"
                            },
                            {
                                "target_lang_word": "toben",
                                "target_lang_sense_clarification": "heftig und unkontrolliert ablaufen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肆虐",
                                "target_lang_sense_clarification": "指自然灾害或战争等猛烈发生"
                            },
                            {
                                "target_lang_word": "激烈进行",
                                "target_lang_sense_clarification": "指冲突或争论"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad3058f-4d8f-3c09-90a1-d086c4a09e8e",
                    "sense_definition": "To act or speak in heightened anger.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "anger_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>raged</w> against the unfair rules imposed by the new management.",
                            "target_lang_translations": {
                                "ru": "Он <w>неистовствовал</w> против несправедливых правил, введенных новым руководством.",
                                "de": "Er <w>tobte</w> gegen die unfairen Regeln, die das neue Management eingeführt hatte.",
                                "zh": "他<w>怒斥</w>新管理层强加的不公平规则。"
                            }
                        },
                        {
                            "text": "The customer <w>raged</w> at the waiter because his soup was cold.",
                            "target_lang_translations": {
                                "ru": "Клиент <w>набросился с криками</w> на официанта, потому что его суп был холодным.",
                                "de": "Der Kunde <w>wütete</w> den Kellner an, weil seine Suppe kalt war.",
                                "zh": "因为汤是凉的，那位顾客对服务员<w>大发雷霆</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rant",
                        "rave",
                        "fume",
                        "seethe"
                    ],
                    "common_phrases": [
                        "rage against",
                        "rage at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать или говорить в состоянии сильного гнева.",
                        "de": "Sich in einem Zustand von starkem Zorn verhalten oder äußern.",
                        "zh": "在极度愤怒的状态下行动或说话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неистовствовать",
                                "target_lang_sense_clarification": "проявлять крайнюю ярость"
                            },
                            {
                                "target_lang_word": "беситься",
                                "target_lang_sense_clarification": "разг. злиться"
                            },
                            {
                                "target_lang_word": "рвать и метать",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "toben",
                                "target_lang_sense_clarification": "sich lautstark und wild äußern"
                            },
                            {
                                "target_lang_word": "wüten",
                                "target_lang_sense_clarification": "sich in einem Zustand von Zorn heftig gebärden"
                            },
                            {
                                "target_lang_word": "rasen",
                                "target_lang_sense_clarification": "vor Wut außer sich sein"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴跳如雷",
                                "target_lang_sense_clarification": "形容愤怒到了极点"
                            },
                            {
                                "target_lang_word": "怒斥",
                                "target_lang_sense_clarification": "愤怒地指责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19447799-6b70-35cc-9b0f-02996826739c",
                    "sense_definition": "To party hard or have a wild, exciting time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "party_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students <w>raged</w> all night after finishing their final exams.",
                            "target_lang_translations": {
                                "ru": "Студенты <w>отрывались</w> всю ночь после сдачи выпускных экзаменов.",
                                "de": "Die Studenten haben nach ihren Abschlussprüfungen die ganze Nacht <w>abgefeiert</w>.",
                                "zh": "期末考试结束后，学生们整晚都在<w>狂欢</w>。"
                            }
                        },
                        {
                            "text": "We plan to <w>rage</w> at the concert this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы планируем <w>оторваться</w> на концерте в эти выходные.",
                                "de": "Wir planen, am Wochenende auf dem Konzert richtig <w>abzufeiern</w>.",
                                "zh": "我们计划在这个周末的音乐会上<w>尽情狂欢</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бурно веселиться, проводить время дико и активно.",
                        "de": "Ausgelassen feiern oder eine wilde, aufregende Zeit verbringen.",
                        "zh": "疯狂地聚会或度过一段狂野、刺激的时光。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрываться",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "тусить",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "abfeiern",
                                "target_lang_sense_clarification": "ausgelassen feiern"
                            },
                            {
                                "target_lang_word": "die Sau rauslassen",
                                "target_lang_sense_clarification": "umgangssprachlich für wild feiern"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狂欢",
                                "target_lang_sense_clarification": "尽情地欢乐"
                            },
                            {
                                "target_lang_word": "疯玩",
                                "target_lang_sense_clarification": "非正式用语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
