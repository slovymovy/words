                    {
                        "sense_id": "40e30cf5-2950-36a8-99bb-fc2cfd30f00d",
                        "entry_id": "e21a9e81-0437-32bf-99e2-f6a5a8a2b141",
                        "glosses": [
                            "Indo-européen."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7f242b29-bf52-43cf-89e8-4013cb2556bd",
                                "sense_id": "40e30cf5-2950-36a8-99bb-fc2cfd30f00d",
                                "text": "Mais j’irai plus loin encore dans le chemin des déductions. Et j’oserai dire que cet échantillon humain appartient à la famille japétique, répandue depuis les Indes jusqu’aux limites de l’Europe occidentale."
                            },
                            {
                                "example_id": "869ee57f-977e-4d9c-8e08-ac5af3ec7679",
                                "sense_id": "40e30cf5-2950-36a8-99bb-fc2cfd30f00d",
                                "text": "Mais voici que sous des bannières victorieuses, des peuples de race japétique envahissent l’Est du vieux continent."
                            }
                        ]
                    }
                ],
