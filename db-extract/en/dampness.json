                    },
                    {
                        "translation_id": "193d1584-a608-45ef-a170-7648b61732a4",
                        "source_entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                        "source_sense_description": "moderate humidity",
                        "target_lang_word": "moiteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37c34232-3989-39fb-8883-d8fccaaa18a1",
                                        "entry_id": "ed740f19-86b2-3e83-b822-e2619f26603d",
                                        "glosses": [
                                            "Caractère de ce qui est moite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f656b90a-f5f8-4b94-a48a-77a0335bbd3b",
                                                "sense_id": "37c34232-3989-39fb-8883-d8fccaaa18a1",
                                                "text": "l’ombre y prenait une chaleur renfermée de fournaise, une moiteur d’humidité, une sueur pestilentielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                        "entry_id": "ed740f19-86b2-3e83-b822-e2619f26603d",
                                        "glosses": [
                                            "Légère humidité, légère transpiration,"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a458585-f086-4777-b35b-4c7fe7eb5750",
                                                "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                                "text": "Il a une petite moiteur aux mains."
                                            },
                                            {
                                                "example_id": "1fcd547b-1c2e-4e1c-9752-6216b7490da9",
                                                "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                                "text": "Après l’accès de fièvre, il reste souvent un peu de moiteur."
                                            },
                                            {
                                                "example_id": "0bc952e4-5dde-4f15-ab68-ff54cffc8212",
                                                "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                                "text": "Il faut chauffer ces draps pour en ôter la moiteur."
                                            },
                                            {
                                                "example_id": "3aad3062-69df-46ef-b61f-649dfcaf3430",
                                                "sense_id": "a0a10d2d-f2b8-31b8-86da-e56a8a65c9d1",
                                                "text": "Va dehors ! Va voir s’il y a des oranges pour moi chez l’épicier… Va demander à M. Rosimond de me prêter La Revue des Deux-Mondes… Mais marche doucement, le temps est orageux, tu reviendrais en moiteur !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae0f30a-91d6-3994-9069-feac0111a291",
                                        "entry_id": "ed740f19-86b2-3e83-b822-e2619f26603d",
                                        "glosses": [
                                            "Tiédeur agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c8f1dea-61da-4098-8049-c6f6d19d1cef",
                                                "sense_id": "fae0f30a-91d6-3994-9069-feac0111a291",
                                                "text": "Sentir dans ses membres une douce moiteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e95d2cc-1364-4970-b8aa-3df7176738ff",
                        "source_entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                        "source_sense_description": "moderate humidity",
                        "target_lang_word": "вла́жность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вла́жность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5e7a4a21-1387-328c-9c55-952b4d0b9f05",
                                        "entry_id": "f34bf07c-bc12-35bc-a83b-a5b1618ba472",
                                        "glosses": [
                                            "свойство по значению прилагательного влажный; наличие влаги в чём-либо, пропитанность влагой, степень насыщенности влагой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f63ec9a-f3ba-4a39-90f0-0b29339a6d91",
                                                "sense_id": "5e7a4a21-1387-328c-9c55-952b4d0b9f05",
                                                "text": "Знакомые уже лианы обвивали и поддерживали ряды деревянных шкафчиков ― таких же, как в большом холле, но из-за высокой влажности прогнивших насквозь ― это стало ясно, как только Данила попытался открыть один из выдвижных ящиков."
                                            },
                                            {
                                                "example_id": "2a59f4ec-e262-4cfe-ae12-7fdba813cb43",
                                                "sense_id": "5e7a4a21-1387-328c-9c55-952b4d0b9f05",
                                                "text": "Что касается погоды ― не далее чем сегодня начал стихать пренеприятный шторм, песок на пляжах здорово взбаламучен, влажность весьма высока ― у меня зудят руки, и не проходит постоянное желание скидывать с себя и отжимать свою рубашку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ffcaaf-a730-3c84-8dbd-444140bfacda",
                                        "entry_id": "f34bf07c-bc12-35bc-a83b-a5b1618ba472",
                                        "glosses": [
                                            "большая насыщенность воздуха влагой, большое количество осадков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695df247-0e72-47e4-88ff-c4bf2ed48c32",
                                                "sense_id": "83ffcaaf-a730-3c84-8dbd-444140bfacda",
                                                "text": "В разных местах, на покрытых эстрадах, мерцали огни, и раздавались звуки музыки, которые, благодаря влажности воздуха, даже в небольшом расстоянии доходили до слуха в виде треска."
                                            },
                                            {
                                                "example_id": "b02e95fe-83ab-47a6-88da-2aa32a978ae2",
                                                "sense_id": "83ffcaaf-a730-3c84-8dbd-444140bfacda",
                                                "text": "Мир, из которого он пришел, царство цветущих, знойных равнин, напоенных влажностью, пропитанных цветением и разложением буйной растительности, был гораздо разнообразнее и в то же время мельче."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0663adf0-5388-3c78-b463-bf420d6955d8",
                                        "entry_id": "f34bf07c-bc12-35bc-a83b-a5b1618ba472",
                                        "glosses": [
                                            "физ. показатель содержания воды, влаги в физических телах или средах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13dd0797-eac6-43c2-ab31-d5d4c4f65295",
                                                "sense_id": "0663adf0-5388-3c78-b463-bf420d6955d8",
                                                "text": "Основными функциями, которые выполняет покрасочный слой, являются: регулирование влажности древесины, придание окну лучшего внешнего вида и облегчение ухода за ним."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "449b3d2a-4f59-3f31-94e6-0145aecb405b",
                                        "entry_id": "f34bf07c-bc12-35bc-a83b-a5b1618ba472",
                                        "glosses": [
                                            "перен. блеск, яркость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc22dbdf-0aa8-4fda-bcf2-302b32ce8bbb",
                                                "sense_id": "449b3d2a-4f59-3f31-94e6-0145aecb405b",
                                                "text": "И по степени влажности глаз, и по большей или меньшей невинности их выражения я безошибочно заключаю о степени успешности торгов…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57446507-eb5e-4b92-8c5b-59fbc4dcdf49",
                        "source_entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                        "source_sense_description": "moderate humidity",
                        "target_lang_word": "сы́рость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сы́рость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "273d8d9e-be36-3fc0-ab82-3d4004d0bf5d",
                                        "entry_id": "f6f8b625-6a9f-37c9-a000-09981b5d7c21",
                                        "glosses": [
                                            "свойство по значению прилагательного сырой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1bd239-8a97-4e97-b8bc-d11a7bbd1fed",
                                                "sense_id": "273d8d9e-be36-3fc0-ab82-3d4004d0bf5d",
                                                "text": "Тот, бывало, как увидит, что около него нечисто, — сейчас задней ногой стук в стенку стойла; а этому ничего — хоть по самое брюхо навали ему навозу. Тот, если, например, против ветра его поставить, — сейчас всеми лёгкими вздохнёт и встряхнётся, а этот знай пофыркивает; того сырость дождевая беспокоила — этому она нипочём…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b059504-2eae-326f-9f92-6775db263092",
                                        "entry_id": "f6f8b625-6a9f-37c9-a000-09981b5d7c21",
                                        "glosses": [
                                            "большое содержание влаги в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76afa6cf-702d-45f9-a85a-1350afca67b0",
                                                "sense_id": "4b059504-2eae-326f-9f92-6775db263092",
                                                "text": "Уже не ожесточение испытывал он, а ту особенную одеревенелость чувства, которая, говорят, овладевает человеком перед совершением преступления. Но собственный голос испугал его — так дико прозвучал он под навесом тёмных ветвей, в гнилой и спёртой сырости лесного оврага!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
