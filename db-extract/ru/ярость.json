                        "form": "я́ростях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "701ceda9-f380-3ca4-8156-31a1d6dcb14c",
                        "entry_id": "6e7fb206-e51d-3bae-93b8-60bd4908246a",
                        "glosses": [
                            "сильный гнев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27216832-9a9d-411d-a438-7e33eb0aca65",
                                "sense_id": "701ceda9-f380-3ca4-8156-31a1d6dcb14c",
                                "text": "По словам Виктора, он впал в ярость и задушил её."
                            }
                        ]
                    },
                    {
                        "sense_id": "c37f1bc1-4094-3467-a9d8-d734868c2707",
                        "entry_id": "6e7fb206-e51d-3bae-93b8-60bd4908246a",
                        "glosses": [
                            "необычайная сила, интенсивность проявления чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8179d06-1104-47aa-8b75-599419f2fb98",
                                "sense_id": "c37f1bc1-4094-3467-a9d8-d734868c2707",
                                "text": "Бушевала метель, но в душе Серой Совы совершалось такое, что эта ярость стихии только бодрила его, она вызывала в нем такое чувство, будто сейчас совершается в природе какое-то торжество, вроде стихийного карнавала, и он шествует, сливаясь душой с этим диким разгулом, и чувствует, что нет ничего такого, чего бы он не мог преодолеть."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1cdc8b0-713c-49d3-b39d-28b881eee12d",
                        "source_entry_id": "6e7fb206-e51d-3bae-93b8-60bd4908246a",
                        "target_lang_word": "rage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02fe1184-36cc-37b6-90ad-f90e37fd6971",
                                        "entry_id": "bf9ae48d-2318-3de9-91db-a3ebeaccc9d6",
                                        "glosses": [
                                            "Violent uncontrolled anger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11f0c8d-3c32-453b-966f-82ff007b1aad",
                                                "sense_id": "02fe1184-36cc-37b6-90ad-f90e37fd6971",
                                                "text": "Heav'n has no Rage, like Love to Hatred turn'd, / Nor Hell a Fury, like a Woman ſcorn'd."
                                            },
                                            {
                                                "example_id": "81a58afe-0727-461e-a7b5-def4146207b0",
                                                "sense_id": "02fe1184-36cc-37b6-90ad-f90e37fd6971",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. Otherwise his pelt would not have been so perfect. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "703d95cd-c483-4499-b044-54c9a855cf53",
                                                "sense_id": "02fe1184-36cc-37b6-90ad-f90e37fd6971",
                                                "text": "[…] rage is not only impotent by definition, it is the mode in which impotence becomes active in its last stage of final despair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "989b7917-6148-3cf1-986e-bf1fb6dba909",
                                        "entry_id": "bf9ae48d-2318-3de9-91db-a3ebeaccc9d6",
                                        "glosses": [
                                            "A current fashion or fad."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c92b9d-0b95-4c2e-8ebb-8acf76339742",
                                                "sense_id": "989b7917-6148-3cf1-986e-bf1fb6dba909",
                                                "text": "Miniskirts were all the rage back then."
                                            },
                                            {
                                                "example_id": "b65839ee-a9d4-48dd-8140-7e3a50a123f1",
                                                "sense_id": "989b7917-6148-3cf1-986e-bf1fb6dba909",
                                                "text": "But the rage of travelling is a symptom of a deeper unsoundness affecting the whole intellectual action."
                                            },
                                            {
                                                "example_id": "191f0d85-644a-477c-ae0b-0c6af4707f10",
                                                "sense_id": "989b7917-6148-3cf1-986e-bf1fb6dba909",
                                                "text": "This rage for boulevardizing has destroyed the quaint, queer, pestilential streets of old Paris, through which it was our pleasure to wander many years since."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c82cee30-f759-3c2c-a4f6-148804152215",
                                        "entry_id": "bf9ae48d-2318-3de9-91db-a3ebeaccc9d6",
                                        "glosses": [
                                            "An exciting and boisterous party."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013a0d47-bb80-4feb-8ced-b51cf5a15e5b",
                                                "sense_id": "c82cee30-f759-3c2c-a4f6-148804152215",
                                                "text": "That evening, Felix and Trish Homer invited me to the Sundancer for \"a bit of a rage.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0a75207-3867-31b7-807e-0ee78cea8dac",
                                        "entry_id": "bf9ae48d-2318-3de9-91db-a3ebeaccc9d6",
                                        "glosses": [
                                            "A subgenre of trap music originating in the United States in the 2020s, characterized by 808s and aggressive, distorted synths."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8997aa-027e-4a0d-b4b8-69b6ab069475",
                                                "sense_id": "b0a75207-3867-31b7-807e-0ee78cea8dac",
                                                "text": "Tripp At Knight feels like a Carti homage, but while it certainly gestures towards the rage sound, Trippie’s imitation of Carti is largely rooted in 2019 rather than 2021."
                                            },
                                            {
                                                "example_id": "c89df642-f4a7-4485-b303-70e3e5fb908b",
                                                "sense_id": "b0a75207-3867-31b7-807e-0ee78cea8dac",
                                                "text": "The list of rappers affiliated with rage has exploded in the subsequent 18 months, and several seem poised to break out in 2023."
                                            },
                                            {
                                                "example_id": "7e3583d1-539d-46d6-a1ad-eeb191276b9a",
                                                "sense_id": "b0a75207-3867-31b7-807e-0ee78cea8dac",
                                                "text": "OK produced the bulk of Jump Out, and the pair succeeded in crafting a sound that, while sonically linked to the forbearers of the underground — maximalist drums in the spirit of so-called “rage” rap along with melodic flourishes of early Playboi Carti — the Charlotte, North Carolina born producer manages to tread new terrain, constructing a sonic identity that feels deliriously right now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eec336e-dd91-39c1-ab00-4f0e6d09ad13",
                                        "entry_id": "bf9ae48d-2318-3de9-91db-a3ebeaccc9d6",
                                        "glosses": [
                                            "Any vehement passion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a8d57e6-c732-4e76-a142-e4ec4ece0212",
                                                "sense_id": "9eec336e-dd91-39c1-ab00-4f0e6d09ad13",
                                                "text": "And your true rights be termed a poet's rage"
                                            },
                                            {
                                                "example_id": "49e636cd-e73c-45a0-bb41-26c8f67f533c",
                                                "sense_id": "9eec336e-dd91-39c1-ab00-4f0e6d09ad13",
                                                "text": "in great rage of pain"
                                            },
                                            {
                                                "example_id": "ae601706-0b4c-4579-a037-785d99f28fd4",
                                                "sense_id": "9eec336e-dd91-39c1-ab00-4f0e6d09ad13",
                                                "text": "convulsed with a rage of grief"
                                            },
                                            {
                                                "example_id": "ed6bfc64-6c27-4135-90e2-8e3d243c59a8",
                                                "sense_id": "9eec336e-dd91-39c1-ab00-4f0e6d09ad13",
                                                "text": "He appeased the rage of hunger with some scraps of broken meat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ad3058f-4d8f-3c09-90a1-d086c4a09e8e",
                                        "entry_id": "b62965bf-86b5-3b47-9a1e-e8ecb2851e3a",
                                        "glosses": [
                                            "To act or speak in heightened anger."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6362220-637a-47db-a107-14996e81fc21",
                                                "sense_id": "4ad3058f-4d8f-3c09-90a1-d086c4a09e8e",
                                                "text": "When a Muslim politician held a 50th birthday party, he [Zaharan Hashim] raged about how Western infidel traditions were poisoning his hometown, Kattankudy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e33578-e501-3f4e-88d3-3b8d954f3d20",
                                        "entry_id": "b62965bf-86b5-3b47-9a1e-e8ecb2851e3a",
                                        "glosses": [
                                            "To move with great violence, as a storm etc."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "280d83d2-d472-446b-ac8a-a526ea5a756e",
                                                "sense_id": "a6e33578-e501-3f4e-88d3-3b8d954f3d20",
                                                "text": "Horrible diſcord, and the madding Wheeles / Of brazen Chariots rag'd; dire was the noiſe / Of conflict; over head the diſmal hiſs / Of fiery Darts in flaming volies flew, / And flying vaulted either Hoſt with fire."
                                            },
                                            {
                                                "example_id": "bdad49e2-2ac2-4f81-9cec-decab02b1202",
                                                "sense_id": "a6e33578-e501-3f4e-88d3-3b8d954f3d20",
                                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom.[…]Roaring, leaping, pouncing, the tempest raged about the wanderers, drowning and blotting out their forms with sandy spume."
                                            },
                                            {
                                                "example_id": "aa031d9f-ddf7-43fe-a31d-aab1e743e1f0",
                                                "sense_id": "a6e33578-e501-3f4e-88d3-3b8d954f3d20",
                                                "text": "The two women murmured over the spirit-lamp, plotting the eternal conspiracy of hush and clean bottles while the wind raged and gave a sudden wrench at the cheap fastenings."
                                            },
                                            {
                                                "example_id": "c11e2091-a916-4a1f-bff0-46dc04845995",
                                                "sense_id": "a6e33578-e501-3f4e-88d3-3b8d954f3d20",
                                                "text": "Though the storm raged up the East Coast, it has become increasingly apparent that New Jersey took the brunt of it."
                                            },
                                            {
                                                "example_id": "7fc7c204-0c10-4435-a2f2-a35d2fa19459",
                                                "sense_id": "a6e33578-e501-3f4e-88d3-3b8d954f3d20",
                                                "text": "Debate has raged over whether Glass and smartglasses like it have any viable real-world use cases for consumers, or are more interesting to businesses where workers need hands-free access to information."
                                            },
                                            {
                                                "example_id": "8b85ac6d-5297-4f87-bf9c-ffd4e14cff0a",
                                                "sense_id": "a6e33578-e501-3f4e-88d3-3b8d954f3d20",
                                                "text": "As the storm raged, more than 85 million people—or more than one in every four Americans—were covered by some kind of blizzard or winter-storm advisory on Friday, according to weather.com."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19447799-6b70-35cc-9b0f-02996826739c",
                                        "entry_id": "b62965bf-86b5-3b47-9a1e-e8ecb2851e3a",
                                        "glosses": [
                                            "To party hard; to have a good time."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "821f0812-1799-40f0-aa51-b70f215b5da6",
                                                "sense_id": "19447799-6b70-35cc-9b0f-02996826739c",
                                                "text": "These events are all about raging hard, getting as fucked up as you can. Not necessarily even about dancing, just being a face in this giant extravaganza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d39dcdf-d9af-32dc-ad78-ced385069cee",
                                        "entry_id": "b62965bf-86b5-3b47-9a1e-e8ecb2851e3a",
                                        "glosses": [
                                            "To enrage."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd155b3e-b5ba-48db-a2e6-4f18f007b9e9",
                                                "sense_id": "6d39dcdf-d9af-32dc-ad78-ced385069cee",
                                                "text": "The King is come, deale mildly with his youth, / For young hot Colts, being rag'd, do rage the more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
