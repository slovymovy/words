                        "entry_id": "f5f709db-06fb-3c33-819a-64720d3de183",
                        "glosses": [
                            "Gebäude über der Schachtöffnung eines Bergwerks"
                        ],
                        "tags": [
                            "Bergmannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "b42ee4a0-26e1-45ed-b43b-06778d51452d",
                                "sense_id": "dc771f09-fcb2-3a3e-90b7-f6b88034cfaa",
                                "text": "„Wir gelangen auf die hohen aufgeschichteten Halden und in die Kauen, die über den Schachtöffnungen angebracht sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d65c5afe-bff3-3be2-9ccf-fa82ad43f5d3",
                        "entry_id": "f5f709db-06fb-3c33-819a-64720d3de183",
                        "glosses": [
                            "Wasch- und Umkleideraum der Bergleute"
                        ],
                        "tags": [
                            "Bergmannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "8dd178fa-c90d-4b6f-a006-20d7e228840c",
                                "sense_id": "d65c5afe-bff3-3be2-9ccf-fa82ad43f5d3",
                                "text": "Als die Kaue für die Zeche Zollern gebaut wurde, hatten sich auf den Ruhrgebietszechen Umkleide- und Waschräume für die Bergleute bereits durchgesetzt."
                            }
                        ],
                        "sense_index_json": "\"2\""
