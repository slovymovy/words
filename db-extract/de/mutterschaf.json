                "senses": [
                    {
                        "sense_id": "f6e2ba1b-01ad-3cd4-bb21-ce19812beea9",
                        "entry_id": "09b505ea-a2e2-31df-a04d-ace6584922cf",
                        "glosses": [
                            "weibliches Schaf, das Lämmer hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf21e151-b0e7-4150-b932-5bd974ee7ddf",
                                "sense_id": "f6e2ba1b-01ad-3cd4-bb21-ce19812beea9",
                                "text": "„Die Mutterschafe trennte man von ihren Kindern, und sie blieben am Hof, wo sie gemolken wurden.“"
                            },
                            {
                                "example_id": "55f67906-9739-47e3-8929-4aa75f4333d5",
                                "sense_id": "f6e2ba1b-01ad-3cd4-bb21-ce19812beea9",
                                "text": "„Er umarmt Guđriđur, nachdem sie den Lämmerpferch aufgebaut haben, um die Jungtiere von den Mutterschafen zu trennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
