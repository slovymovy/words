                    {
                        "translation_id": "feb60add-1742-4107-bf2b-00264d1c5742",
                        "source_entry_id": "d4dc9b4f-9e10-3c37-b5f2-f9e007227a0d",
                        "source_sense_description": "раздел педагогики, излагающий теорию и общие законы образования и обучения",
                        "target_lang_word": "Bildungswissenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bildungswissenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "853362a6-ad2e-3e2f-87d0-7b15450a23b9",
                                        "entry_id": "2ef46e9e-afa5-3a2e-ae36-eb4313253a3b",
                                        "glosses": [
                                            "Sammelbegriff für verschiedene wissenschaftliche Disziplinen, die sich im weitesten Sinne mit dem Thema Bildung beschäftigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f44b95a-b767-4d1e-a7f1-ee09cfb93b6d",
                                                "sense_id": "853362a6-ad2e-3e2f-87d0-7b15450a23b9",
                                                "text": "„Ich bin mir aber ziemlich sicher, dass die stärker evidenzbasierte Ausrichtung der Bildungswissenschaften nicht wieder zurückgedreht wird.“"
                                            },
                                            {
                                                "example_id": "bc974b7b-f2c1-438b-b750-9f360383b41f",
                                                "sense_id": "853362a6-ad2e-3e2f-87d0-7b15450a23b9",
                                                "text": "„In sechs Fachbereichen wird auf den Gebieten der bildenden und darstellenden Kunst, der künstlerischen Therapien, der Architektur, der Bildungswissenschaft sowie der Betriebswirtschaftslehre gelehrt und geforscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
