                "senses": [
                    {
                        "sense_id": "3db38916-7549-3a8c-b1d3-9989e4b59359",
                        "entry_id": "3437adbb-ccf4-344a-a280-5111ce7b3001",
                        "glosses": [
                            "Faire perdre son caractère de brouillon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ddd1f4f-4aa6-4710-8b51-4f7cbea7aabe",
                                "sense_id": "3db38916-7549-3a8c-b1d3-9989e4b59359",
                                "text": "J’essaie au fur et à mesure de débrouillonner un peu, de peur de me retrouver avec des brouillons au troisième ou quatrième degré, situation atroce."
                            },
                            {
                                "example_id": "c755f44f-9cc6-42b2-bcbf-034a68f4b226",
                                "sense_id": "3db38916-7549-3a8c-b1d3-9989e4b59359",
                                "text": "Maintenant je repose votre peinture pour pouvoir faire sécher mon texte, le débrouillonner quelque peu, et j’ai l’impression de fermer une fenêtre."
                            }
                        ]
                    }
