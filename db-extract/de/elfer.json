                ],
                "senses": [
                    {
                        "sense_id": "739ff410-f61d-342a-aa28-823daeae399b",
                        "entry_id": "3ff1e02a-27cc-3d1f-8515-264f3a4a4d66",
                        "glosses": [
                            "etwas mit Größe, Wert, Maß oder Nummer 11"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "9699c817-f0a0-417e-b615-237b6d47287b",
                                "sense_id": "739ff410-f61d-342a-aa28-823daeae399b",
                                "text": "Welchen Schraubenschlüssel brauchst du? – den Elfer!"
                            },
                            {
                                "example_id": "53e24670-e4b0-4b3c-a200-aefdfba05ec9",
                                "sense_id": "739ff410-f61d-342a-aa28-823daeae399b",
                                "text": "„Die Elfer sind letzte Woche nach Melchester und von dort weitergezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fa81cc6f-322c-360e-8c47-b4f5e587f5e7",
                        "entry_id": "3ff1e02a-27cc-3d1f-8515-264f3a4a4d66",
                        "glosses": [
                            "Strafstoß, der elf Meter vor dem Tor ausgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81fb2000-87c5-4cd5-a40f-a87bbdeef9a7",
                                "sense_id": "fa81cc6f-322c-360e-8c47-b4f5e587f5e7",
                                "text": "Der Fußballer hat den Elfer verwandelt."
                            },
                            {
                                "example_id": "987bc4a2-c5cd-499b-b952-289bd55c5e2c",
                                "sense_id": "fa81cc6f-322c-360e-8c47-b4f5e587f5e7",
                                "text": "„Eigentlich ist es keine Schwierigkeit, einen Elfmeter zu verwandeln. Aber selbst die besten Fußballer der Welt haben schon Elfer verschossen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3d9d8d28-479a-39a7-bde7-30614223b3aa",
                        "entry_id": "3ff1e02a-27cc-3d1f-8515-264f3a4a4d66",
                        "glosses": [
                            "die Zahl 11"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "aef77b18-8f0d-4b7c-8312-d9e244e50fe0",
                                "sense_id": "3d9d8d28-479a-39a7-bde7-30614223b3aa",
                                "text": "Wer hat hier einen Elfer hingemalt?"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
