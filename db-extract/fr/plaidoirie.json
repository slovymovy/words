            {
                "entry_id": "99efc188-2811-3672-8755-c5c66cec360f",
                "word": "plaidoirie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "82f8f26b-0b89-473c-a4c2-2f9815461b84",
                        "entry_id": "99efc188-2811-3672-8755-c5c66cec360f",
                        "tags": [
                            "plural"
                        ],
                        "form": "plaidoiries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cf80072-0916-3d22-8bda-ba79c84cadec",
                        "entry_id": "99efc188-2811-3672-8755-c5c66cec360f",
                        "glosses": [
                            "Action de plaider ; discours de l’avocat qui plaide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56751819-a68a-4739-9358-53e739e06a09",
                                "sense_id": "7cf80072-0916-3d22-8bda-ba79c84cadec",
                                "text": "Mes divertissements étaient encore des plaidoiries, et mes conversations des mémoires."
                            },
                            {
                                "example_id": "5a7cef0e-b039-4b10-8b10-32f5eb5f27d7",
                                "sense_id": "7cf80072-0916-3d22-8bda-ba79c84cadec",
                                "text": "L’avocat de Nicolas Sarkozy, Vincent Desry, doit plaider ce vendredi matin, ouvrant le bal des plaidoiries de la défense."
                            },
                            {
                                "example_id": "39c309b1-98ed-430a-935d-2406092f0f10",
                                "sense_id": "7cf80072-0916-3d22-8bda-ba79c84cadec",
                                "text": "Mᵉ Demange achève sa plaidoirie, dont la péroraison très sobre, très courte, mais puissante par la chaleur de l'accent et de l’élévation de la pensée, touche visiblement le cœur des juges : […]."
                            },
                            {
                                "example_id": "7cc4db75-4d60-460c-9d3e-341921302f9a",
                                "sense_id": "7cf80072-0916-3d22-8bda-ba79c84cadec",
                                "text": "Il n'incitait guère les plaignants à lui faire confiance, d'autant plus que ses plaidoiries émaillées de principes philosophiques et de maximes latinistes n'ayant rien à voir avec l'affaire restaient incompréhensives pour le vulgum pecus."
                            }
                        ]
                    },
                    {
                        "sense_id": "0adeead5-6adf-3af5-ac48-cb84327803fe",
                        "entry_id": "99efc188-2811-3672-8755-c5c66cec360f",
                        "glosses": [
                            "Art, la profession de l’avocat."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c6f9aa5d-5dc1-4b91-b85b-b39f1c41027c",
                                "sense_id": "0adeead5-6adf-3af5-ac48-cb84327803fe",
                                "text": "Cet avocat est meilleur pour la consultation que pour la plaidoirie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bd4cf8a-aa8a-4a02-9c90-cde440212895",
                        "source_entry_id": "99efc188-2811-3672-8755-c5c66cec360f",
                        "source_sense_id": "7cf80072-0916-3d22-8bda-ba79c84cadec",
                        "source_sense_description": "(Droit) Action de plaider ; discours de l’avocat qui plaide.",
                        "target_lang_word": "pleading",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35d97efd-c615-3a83-a546-e108455aae66",
                                        "entry_id": "f3d72f74-efd3-3d87-9338-38708fe5aa00",
                                        "glosses": [
                                            "The act of making a plea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e0e06e4-af27-43f4-8b73-a75468f07cce",
                                                "sense_id": "35d97efd-c615-3a83-a546-e108455aae66",
                                                "text": "But it pleased her to play on my passion / And whet me to pleadings / That won from her mirthful negations / And scornings undue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40b69490-db66-3926-8a6a-4c019a3fc2e1",
                                        "entry_id": "f3d72f74-efd3-3d87-9338-38708fe5aa00",
                                        "glosses": [
                                            "A document filed in a lawsuit, particularly a document initiating litigation or responding to the initiation of litigation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pleading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8fe0bab-189e-369c-bcd2-3f593addb15d",
                                        "entry_id": "aa5588ff-56ea-3194-9b3b-cabfe5f57267",
                                        "glosses": [
                                            "present participle and gerund of plead"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pleading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0842208-f8be-3019-a0c9-d33058b64591",
                                        "entry_id": "f5202580-11e4-3f22-a495-1d5d94ebadb7",
                                        "glosses": [
                                            "That pleads."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7228398-e710-465f-ac00-d70faec34f84",
                                                "sense_id": "b0842208-f8be-3019-a0c9-d33058b64591",
                                                "text": "Franchise, relaxed and soothed by the vagueness of a surrender set so far in the future, simply took hold of his two hands to make him behave himself and looked at him with her pretty pleading eyes — the eyes of a sensitive woman who didn't want to risk having a child by anyone but her husband."
                                            },
                                            {
                                                "example_id": "478762b8-f10c-4cd0-a6c3-7e42f69d38b1",
                                                "sense_id": "b0842208-f8be-3019-a0c9-d33058b64591",
                                                "text": "With a pleading look, she raised her eyes to him."
                                            },
                                            {
                                                "example_id": "1780e691-f120-49ab-9d71-1f749b3d27e6",
                                                "sense_id": "b0842208-f8be-3019-a0c9-d33058b64591",
                                                "text": "Have but a pleading heart and God will have a plenteous hand."
                                            },
                                            {
                                                "example_id": "10b1e792-80e1-4aa8-aef7-1f731e8a3fa1",
                                                "sense_id": "b0842208-f8be-3019-a0c9-d33058b64591",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
