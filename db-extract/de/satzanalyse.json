                        "entry_id": "eee020af-1a43-3e12-8952-930abab7e02d",
                        "glosses": [
                            "Untersuchung der Struktur von Sätzen, die je nach verwendetem Grammatikmodell unterschiedlich vorgehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb8a9583-dfb6-483a-b0a6-f41f6fd8ec15",
                                "sense_id": "a90b6eed-1946-39b7-a637-e51d0800d159",
                                "text": "Die Satzanalyse im Rahmen einer traditionellen Grammatik besteht darin, die Satzglieder und ihre Funktionen zu bestimmen."
                            },
                            {
                                "example_id": "539fdfde-e14f-433d-932d-13bccba29cbb",
                                "sense_id": "a90b6eed-1946-39b7-a637-e51d0800d159",
                                "text": "Legt man eine Dependenzgrammatik, Phrasenstrukturgrammatik oder eine Valenzgrammatik oder noch ein anderes Modell zugrunde, muss die Satzanalyse mit deren Begriffen und Verfahren vorgehen."
                            }
                        ],
