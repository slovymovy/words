                                            {
                                                "example_id": "a18614f4-bcbd-4628-b0f3-9a6e261a9b10",
                                                "sense_id": "599cbc43-87c4-3db8-b66f-3721a9cb6d49",
                                                "text": "On peut construire un nombre réel N dont la partie entière est zéro et tel que pour tout n, la n-ième décimale de N est égale à : 1 si la n-ième décimale du n-ième nombre définissable par des phrases est égale à 8 ou à 9 ; […]"
                                            },
                                            {
                                                "example_id": "898a8b38-083e-4580-a057-2a063bb7eb2d",
                                                "sense_id": "599cbc43-87c4-3db8-b66f-3721a9cb6d49",
                                                "text": "[…] un entier étant donné, considérons la suite dont le n-ième terme est égal au nombre de fois où cet entier apparaît à l'étage n."
                                            }
                                        ]
                                    }
                                ]
                            },
