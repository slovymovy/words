                        "entry_id": "a3897471-7418-3f70-9d03-52530c19e5eb",
                        "glosses": [
                            "N’importe comment et avec précipitation."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0204a742-1b6b-4b6d-8977-467a5d3f0890",
                                "sense_id": "76913796-4d4f-36da-8d11-491754b8d7fc",
                                "text": "Il nous a raconté cela bredi-breda."
                            },
                            {
                                "example_id": "b32c9abd-fa99-443f-b1c0-522b6b44d37b",
                                "sense_id": "76913796-4d4f-36da-8d11-491754b8d7fc",
                                "text": "Il commence bredi-breda, sans savoir ce qu’il va faire."
                            },
                            {
                                "example_id": "1d2cf2a6-b9c4-46aa-890a-83c0df7019ae",
                                "sense_id": "76913796-4d4f-36da-8d11-491754b8d7fc",
                                "text": "Madame Pinson ne veut rien entendre et, tandis que son mari entraîne bredi-breda sa fille hors du groupe, Canulard et sa belle-mère exécutent le galop final avec un brio étourdissant."
                            },
                            {
                                "example_id": "19f48384-e75e-4d84-afb2-5550d487e44e",
                                "sense_id": "76913796-4d4f-36da-8d11-491754b8d7fc",
                                "text": "Plus de cent Cochons arrivaient bredi-breda, pantoufli-pantoufla, harcelés par des hommes et des chiens."
                            },
                            {
                                "example_id": "7ab796e6-5ebb-4952-84ea-0634a60e7a8a",
                                "sense_id": "76913796-4d4f-36da-8d11-491754b8d7fc",
                                "text": "Ils étaient restés seuls encore une centaine de mètres, puis ils furent rattrapés par une douzaine de personnes qui trottinèrent bredi-breda jusqu'à eux."
                            }
                        ]
                    }
