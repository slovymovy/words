                        "glosses": [
                            "Ornementation portée sur la lèvre inférieure ou supérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf5e2d07-67d0-4a8d-870f-81b6d3d8f29e",
                                "sense_id": "ea39c8b2-3780-3f49-957e-6e1b6aacc7a0",
                                "text": "Devant eux, les coupables sont accroupis, attachés par une corde ; certains ont été dépouillés de leurs labrets, leurs cheveux ont été rasés sur le front comme ceux des gens du peuple."
                            },
                            {
                                "example_id": "639e87b4-c6d5-44d7-baca-3f3466e8cae7",
                                "sense_id": "ea39c8b2-3780-3f49-957e-6e1b6aacc7a0",
                                "text": "Tout nu, peint de rouge, le nez et la lèvre inférieure transpercés de la barrette et du labret, emplumé, l’Indien du pape se révéla merveilleux professeur en sociologie bororo."
                            },
                            {
                                "example_id": "193474ee-53aa-4717-a0b0-20bbc353033a",
                                "sense_id": "ea39c8b2-3780-3f49-957e-6e1b6aacc7a0",
                                "text": "Plus une femme possède un labret important, plus son prix à payer en bêtes est élevé."
                            },
                            {
                                "example_id": "284eb40e-5a7d-4a49-b7b9-9becdca02ae6",
                                "sense_id": "ea39c8b2-3780-3f49-957e-6e1b6aacc7a0",
                                "text": "Pas de labret sous la main, ni peintures de guerre, épilation des temps, bâton de chefferie : mon complet suffirait."
                            }
                        ]
                    },
