        "nl-extract.jsonl": [
            {
                "entry_id": "26bea450-4abd-3b9a-bc6e-32d02d2105c0",
                "word": "atheïsme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9db60f43-ed1f-3d3c-8c29-ae0842677d7a",
                        "entry_id": "26bea450-4abd-3b9a-bc6e-32d02d2105c0",
                        "glosses": [
                            "overtuiging dat goden niet bestaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba98c8b3-665d-4364-aea3-a7fbd14d5a80",
                                "sense_id": "9db60f43-ed1f-3d3c-8c29-ae0842677d7a",
                                "text": "Volgens het atheïsme bestaan er geen goden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d27a48c2-526e-4af0-8b75-91fd59a7d0e1",
                        "source_entry_id": "26bea450-4abd-3b9a-bc6e-32d02d2105c0",
                        "source_sense_id": "9db60f43-ed1f-3d3c-8c29-ae0842677d7a",
                        "source_sense_description": "overtuiging dat goden niet bestaan",
                        "target_lang_word": "Atheismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atheismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf913d3a-f098-37c0-9b01-5cb28e0811c0",
                                        "entry_id": "3096f269-8dcc-3350-80a0-3819becc1cfe",
                                        "glosses": [
                                            "Überzeugung, dass von einer Welt ohne Gott beziehungsweise Götter auszugehen ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34104aa5-86e1-4cf5-bf67-f78adb4019d3",
                                                "sense_id": "cf913d3a-f098-37c0-9b01-5cb28e0811c0",
                                                "text": "Der Atheismus hat wichtige Wurzeln in der Aufklärung."
                                            },
                                            {
                                                "example_id": "9e2985da-42fa-42a7-812d-acb4e9333289",
                                                "sense_id": "cf913d3a-f098-37c0-9b01-5cb28e0811c0",
                                                "text": "„Atheismus bedeutet philosophisch gesehen, die Leugnung der Existenz od. jedweder […] Erkennbarkeit Gottes (theoret. Atheismus). Dieser theoretische Atheismus kann in seinen Vertretern tolerant (bis bekümmert) sein, wenn er keine missionarischen Absichten hat; […] Von einem prakt. Atheismus spricht man bei einer Lebensführung, in der aus der theoret. Anerkennung des Daseins Gottes keine (merklichen) Folgerungen gezogen werden.“"
                                            },
                                            {
                                                "example_id": "f406759b-2174-431a-b792-a0d9537e9bd5",
                                                "sense_id": "cf913d3a-f098-37c0-9b01-5cb28e0811c0",
                                                "text": "„Eine solche Einstellung kann nur gut sein, denn sie bekämpft den Atheismus.“"
                                            },
                                            {
                                                "example_id": "8d7944a0-fec7-4f3d-a609-a4d2bcef1ac6",
                                                "sense_id": "cf913d3a-f098-37c0-9b01-5cb28e0811c0",
                                                "text": "„Der Atheismus breitet sich immer mehr aus.“"
                                            },
                                            {
                                                "example_id": "11541f64-5657-47e6-b18f-817d80ca5b00",
                                                "sense_id": "cf913d3a-f098-37c0-9b01-5cb28e0811c0",
                                                "text": "„Andere wollen vermeiden, dass Gläubige durch ein Bekenntnis zum Atheismus abgestoßen werden.“"
                                            },
                                            {
                                                "example_id": "c890620c-7a0b-489b-905d-a784cb1edc86",
                                                "sense_id": "cf913d3a-f098-37c0-9b01-5cb28e0811c0",
                                                "text": "„Bergmann erzählt als Physiker in diesem Buch eine andere Geschichte, die des christlichen Glaubens: Der Glaube an Gott ist vernünftig und erklärt die Existenz und die Eigenschaften der Welt besser als der Atheismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06f03943-3901-3245-a6c5-15334c12ab13",
                                        "entry_id": "3096f269-8dcc-3350-80a0-3819becc1cfe",
                                        "glosses": [
                                            "eine spezifische Auffassung oder Art von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa88eda0-4410-4224-b9fc-00e92f054867",
                                                "sense_id": "06f03943-3901-3245-a6c5-15334c12ab13",
                                                "text": "„Auf diesem Hintergrund kann es nicht verwundern, dass das Bemühen der Klassifizierung der unterschiedlichen Atheismen von erheblichen Unschärfen begleitet wird."
                                            },
                                            {
                                                "example_id": "39daf04e-40c5-4807-b7f9-b1a6eeb599f6",
                                                "sense_id": "06f03943-3901-3245-a6c5-15334c12ab13",
                                                "text": "„Religionen ohne Gott kommen in dieser Konstruktion ebensowenig vor wie bekennende Atheismen, z.B. ein säkularer Humanismus.“"
                                            },
                                            {
                                                "example_id": "783a0eff-0474-43d0-b16b-574691e52439",
                                                "sense_id": "06f03943-3901-3245-a6c5-15334c12ab13",
                                                "text": "„Robuste Theismen der systematischen oder fundamentalistischen Variante und robuste Atheismen in der Art, wie sie Richard Dawkins vertritt, sagen beide einfach zu viel über etwas, das wir nicht wissen.“"
                                            },
                                            {
                                                "example_id": "40824b8c-4ef4-49a3-b9a2-18e2f3d27927",
                                                "sense_id": "06f03943-3901-3245-a6c5-15334c12ab13",
                                                "text": "„Nun, für den kritischen Dialog, für den öffentlich zu führenden Streit mit der Lebens- und Weltanschauung der verschiedenen Atheismen empfiehlt sich bestimmt nicht der Weg der Gottesbeweise.“"
                                            },
                                            {
                                                "example_id": "9fd141d2-b8ce-4971-8771-2876922b19a4",
                                                "sense_id": "06f03943-3901-3245-a6c5-15334c12ab13",
                                                "text": "„Denunziatorische Atheismen à la Dawkins und Hitchens laufen darauf hinaus, Religionen als irrational und schädlich und religiöse Menschen damit als dumm, unmoralisch und armselige Persönlichkeiten zu denunzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf6e3665-d9ee-4e2b-a22a-3a46885b9287",
                        "source_entry_id": "26bea450-4abd-3b9a-bc6e-32d02d2105c0",
                        "source_sense_id": "9db60f43-ed1f-3d3c-8c29-ae0842677d7a",
                        "source_sense_description": "overtuiging dat goden niet bestaan",
                        "target_lang_word": "atheism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atheism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf4a6bd-0025-3365-b756-f6726cc0203d",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "A non-belief in deities.",
                                            "Belief that no deities exist (sometimes including rejection of other religious beliefs)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9193557d-b3cc-4abe-8508-2854b492c4b9",
                                                "sense_id": "9cf4a6bd-0025-3365-b756-f6726cc0203d",
                                                "text": "Near-synonyms: antireligiousness, irreligion, irreligiousness"
                                            },
                                            {
                                                "example_id": "a26c3f65-46be-4d98-b14c-4ee454a89e35",
                                                "sense_id": "9cf4a6bd-0025-3365-b756-f6726cc0203d",
                                                "text": "For atheism to be rationally justified it is only necessary that it be more probable than not or at least more probable than theism. Certainty is no more required in the case of atheism than it is in the case of scientific theories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3946514d-82ee-3c6f-957a-a2b371179ce8",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "A non-belief in deities.",
                                            "A lack of belief in deities, or a belief that there is insufficient evidence to believe in a god."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe49a398-6b8f-47aa-af63-3f145f23c592",
                                                "sense_id": "3946514d-82ee-3c6f-957a-a2b371179ce8",
                                                "text": "Near-synonyms: irreligion, irreligiousness, nonreligion, nonreligiousness"
                                            },
                                            {
                                                "example_id": "66be7a45-04ae-48f4-8385-6e2ff3738ed8",
                                                "sense_id": "3946514d-82ee-3c6f-957a-a2b371179ce8",
                                                "text": "The theory of Secularism is a form, not of dogmatic, but of skeptical, Atheism; it is dogmatic only in denying the sufficiency of the evidence for the being and perfections of God. It does not deny, it only does not believe, His existence."
                                            },
                                            {
                                                "example_id": "712dab06-60fd-4e81-9525-a9cc6848b3eb",
                                                "sense_id": "3946514d-82ee-3c6f-957a-a2b371179ce8",
                                                "text": "...but Atheism per se simply means, not denial, but rejection, in the sense of not accepting the Theistic theory of the universe which Mr. Lee has put forward tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc5a2f2-a698-36ff-8089-9de5691421c3",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "A non-belief in deities.",
                                            "Absence of belief that any deities exist (including absence of the concept of deities)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf91b50e-f9f5-4dd7-b059-19bbb54cb005",
                                                "sense_id": "abc5a2f2-a698-36ff-8089-9de5691421c3",
                                                "text": "What can parents do, and mothers more especially, […] with regard to the atheism that is natural to all the children of men?"
                                            },
                                            {
                                                "example_id": "25765766-a1b8-48ee-a089-66b5a2d3d34a",
                                                "sense_id": "abc5a2f2-a698-36ff-8089-9de5691421c3",
                                                "text": "Atheism, in its basic form, is not a belief; it is the absence of belief. An atheist is not primarily a person who believes that a god does not exist; rather, he does not believe in the existence of a god."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a80e8eb-761d-3b9c-9c88-9fb65d7c7324",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "Absence of belief in a particular deity, pantheon, or religious doctrine (notwithstanding belief in other deities)."
                                        ],
                                        "tags": [
                                            "historical",
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d60c58a8-f165-48b8-8948-1605dbbf3087",
                                                "sense_id": "7a80e8eb-761d-3b9c-9c88-9fb65d7c7324",
                                                "text": "Domitilla, Flavia, niece of the emperor Domitian (81-96). She and her husband, Flavius Clemens (consul in 95 and cousin of Domitian), were probably Christians; charged with atheism and adoption of Jewish ways, they were punished (95) with death (Clemens) and exile (Domitilla)."
                                            },
                                            {
                                                "example_id": "be18b112-9d0b-47ec-933e-4b0fbfa6124d",
                                                "sense_id": "7a80e8eb-761d-3b9c-9c88-9fb65d7c7324",
                                                "text": "Sacrificial religion becomes redundant – which is why Christianity did indeed have a reputation in the ancient world for atheism: it rejected the key duty humans are thought to owe to the gods, namely sacrifice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b903027f-e480-3e0c-98ef-34339166ab7b",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "A rejection of all religions, even non-theistic ones."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3770285-1b4c-4aa2-a12f-879af05ca6ff",
                                                "sense_id": "b903027f-e480-3e0c-98ef-34339166ab7b",
                                                "text": "Some worldviews are based in a belief in God; others are not. Buddhism, Taoism, atheism, Marxism, and existentialism are examples of worldviews that are nontheistic."
                                            },
                                            {
                                                "example_id": "e1d2519a-effa-4b82-ac63-38fb429ddb74",
                                                "sense_id": "b903027f-e480-3e0c-98ef-34339166ab7b",
                                                "text": "Buddhism and atheism do agree on the view that there is no God. But Buddhism and atheist materialism totally disagree on the points such as “What is life?”, “Is there any Super natural?” etc."
                                            },
                                            {
                                                "example_id": "ad4ecdd8-17d5-4378-8b76-d68f91fc24a5",
                                                "sense_id": "b903027f-e480-3e0c-98ef-34339166ab7b",
                                                "text": "Another reason why the transition between Buddhism and atheism seemed so easy, was my personal discomfort with the theory of reincarnation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d48a8b35-86a5-45ff-bd1c-517cba08c787",
                        "source_entry_id": "26bea450-4abd-3b9a-bc6e-32d02d2105c0",
                        "source_sense_id": "9db60f43-ed1f-3d3c-8c29-ae0842677d7a",
                        "source_sense_description": "overtuiging dat goden niet bestaan",
                        "target_lang_word": "athéisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "athéisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47dce21b-a73a-3e5d-b834-a005255a2181",
                                        "entry_id": "171a4ecd-92e2-3c37-a12e-905a6feae5a2",
                                        "glosses": [
                                            "Absence de croyance en un ou plusieurs dieux ou divinités, la doctrine de celui qui ne croit en aucun dieu ou aucune divinité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d434b6a-fde1-4cc7-8dc4-2240e7dbc98a",
                                                "sense_id": "47dce21b-a73a-3e5d-b834-a005255a2181",
                                                "text": "Oui, je le soutiens, la superstition est plus injurieuse à Dieu que l’athéisme, […]."
                                            },
                                            {
                                                "example_id": "ef82d8e6-7f04-4364-af8c-1da77840e81c",
                                                "sense_id": "47dce21b-a73a-3e5d-b834-a005255a2181",
                                                "text": "Au contact de son mari, madame Leroi, libérée de toute croyance, dans son atavisme protestant de la liberté d’examen, s’était créé une sorte d’athéisme tranquille, une idée de devoir, de justice humaine et souveraine, qu’elle réalisait avec bravoure, par-dessus toutes les conventions sociales."
                                            },
                                            {
                                                "example_id": "d3b859ba-3c35-4bff-8c63-0e1b3494a19c",
                                                "sense_id": "47dce21b-a73a-3e5d-b834-a005255a2181",
                                                "text": "Renouvier s'attaque au concept d'un Dieu impersonnel. Il essaie de montrer qu'un anthropomorphisme épuré est encore le meilleur remède contre l’athéisme, et que tous les panthéismes et tous les monismes où Dieu n'est qu'un nom de l'Absolu, inconditionné, infini, partant contradictoire et inconcevable, sont autant d’athéismes déguisés."
                                            },
                                            {
                                                "example_id": "8813316b-9480-45d8-a220-7edb07a33a22",
                                                "sense_id": "47dce21b-a73a-3e5d-b834-a005255a2181",
                                                "text": "Affichant non sans panache un athéisme militant, il appelle à en finir avec une certaine tolérance envers les religions monothéistes, intrinsèquement intolérantes et pétries de haine."
                                            },
                                            {
                                                "example_id": "ea789d3b-c2e6-485b-8ec1-02bac90105e8",
                                                "sense_id": "47dce21b-a73a-3e5d-b834-a005255a2181",
                                                "text": "Mais des difficultés surgissent dès qu’on cherche à appliquer cette définition simple aux multiples variantes de l’athéisme. Il existe un athéisme pour ainsi dire spontané. L’homme, en révolte contre les lois divines, refuse Dieu."
                                            },
                                            {
                                                "example_id": "9036b3e6-0163-49f8-b3d3-19e203b3cb21",
                                                "sense_id": "47dce21b-a73a-3e5d-b834-a005255a2181",
                                                "text": "Bon nombre de musulmans entretiennent un rapport très lâche au religieux, mais l'athéisme reste un impensé et un tabou complet. L'islam ne reconnaît toujours pas le droit à l'athéisme, ni le droit de changer de religion."
                                            },
                                            {
                                                "example_id": "78059413-4e07-4b63-81e8-b405f219304e",
                                                "sense_id": "47dce21b-a73a-3e5d-b834-a005255a2181",
                                                "text": "Le véritable athéisme consiste à croire que Dieu lui-même ne croit pas en lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aa9932a-1bac-4ced-a775-920a17dabfd1",
                        "source_entry_id": "26bea450-4abd-3b9a-bc6e-32d02d2105c0",
