                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6399bb90-13c1-431b-96cd-f97c8246fc14",
                                "sense_id": "fee3c96e-0f3c-30da-bc02-5a5466b4299a",
                                "text": "„Der zweite Plan ist eine Zeitschrift, die er herausgeben will, es soll eine Wochenschrift werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6150d314-f317-47a1-b470-bbae8dad773d",
                        "source_entry_id": "a33664ac-82d2-31c8-b82d-1943db3a83d1",
                        "source_sense_id": "fee3c96e-0f3c-30da-bc02-5a5466b4299a",
                        "source_sense_description": "Publikationsorgan, das wöchentlich erscheint",
                        "target_lang_word": "journal hebdomadaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
