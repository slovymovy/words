                        "entry_id": "4c1d0b62-fd21-3c07-8ece-e09029bd213a",
                        "glosses": [
                            "Phénomène semblable à un tsunami, mais causé par des perturbations météorologiques ou atmosphériques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba53803-b78d-41e6-b48a-5a384a2cddf1",
                                "sense_id": "8a5f1f08-740e-32dc-8198-0934127933d4",
                                "text": "Le cyclone dévastateur de 1864 à Calcutta, suivi d'un météotsunami de 6 m remontant la Hooghly et détruisant le port, a précipité la création de l'Indian Meteorological Office, dix ans seulement après la création de son équivalent britannique."
                            }
                        ]
                    }
                ],
