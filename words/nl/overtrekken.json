{
    "word_family": [
        "trek",
        "trekken",
        "uittrekken",
        "aantrekken",
        "vertrekken",
        "overtrek"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6041d48c-c953-37ca-9097-2f0eaa30145b",
                    "sense_definition": "De contouren van een bestaande tekening of afbeelding natekenen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "natekenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de tekening gemakkelijk <w>overtrekken</w> met een potlood en kalkpapier.",
                            "target_lang_translations": {
                                "en": "You can easily <w>trace</w> the drawing with a pencil and tracing paper.",
                                "ru": "Вы можете легко <w>перевести</w> рисунок с помощью карандаша и кальки."
                            }
                        },
                        {
                            "text": "Het kind probeert de lijnen van de kleurplaat voorzichtig te <w>overtrekken</w>.",
                            "target_lang_translations": {
                                "en": "The child is trying to carefully <w>trace</w> the lines of the coloring page.",
                                "ru": "Ребенок старается осторожно <w>обвести</w> линии раскраски."
                            }
                        }
                    ],
                    "synonyms": [
                        "natrekken"
                    ],
                    "common_phrases": [
                        "tekening overtrekken",
                        "lijnen overtrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To copy the outlines of an existing drawing or image.",
                        "ru": "Копирование контуров существующего рисунка или изображения."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trace",
                                "target_lang_sense_clarification": "copying lines"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "переводить",
                                "target_lang_sense_clarification": "рисунок через кальку"
                            },
                            {
                                "target_lang_word": "обводить",
                                "target_lang_sense_clarification": "контуры"
                            },
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "по линиям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7e840d9-da3f-3fc2-b683-2cdc814b8862",
                    "sense_definition": "Tijdens een tocht of reis een bepaald gebied, gebergte of grens passeren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "passeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Carthagers waren de Alpen <w>overgetrokken</w> en vielen Rome aan.",
                            "target_lang_translations": {
                                "en": "The Carthaginians had <w>crossed</w> the Alps and attacked Rome.",
                                "ru": "Карфагеняне <w>перешли</w> через Альпы и напали на Рим."
                            }
                        },
                        {
                            "text": "De troepen moesten de grens <w>overtrekken</w> voordat de zon opkwam.",
                            "target_lang_translations": {
                                "en": "The troops had to <w>cross</w> the border before the sun rose.",
                                "ru": "Войска должны были <w>пересечь</w> границу до восхода солнца."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de grens overtrekken",
                        "gebergte overtrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To pass through a certain area, mountain range, or border during a journey.",
                        "ru": "Пересечение определенной местности, горного хребта или границы во время похода или путешествия."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "a border or mountain range"
                            },
                            {
                                "target_lang_word": "traverse",
                                "target_lang_sense_clarification": "formal, passing through an area"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "границу или горы"
                            },
                            {
                                "target_lang_word": "пересекать",
                                "target_lang_sense_clarification": "территорию"
                            },
                            {
                                "target_lang_word": "переправляться",
                                "target_lang_sense_clarification": "через препятствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99a93bde-ae67-3552-86ed-d96d4afce5e6",
                    "sense_definition": "Een voorwerp voorzien van een nieuwe laag stof of bekleding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bekleden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die oude meubels kunnen best nog een keer <w>overtrokken</w> worden met leer.",
                            "target_lang_translations": {
                                "en": "Those old pieces of furniture could easily be <w>reupholstered</w> with leather one more time.",
                                "ru": "Эту старую мебель вполне можно еще раз <w>перетянуть</w> кожей."
                            }
                        },
                        {
                            "text": "Zij gaat de stoelen <w>overtrekken</w> met een moderne blauwe stof.",
                            "target_lang_translations": {
                                "en": "She is going to <w>recover</w> the chairs with a modern blue fabric.",
                                "ru": "Она собирается <w>обить</w> стулья современной синей тканью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meubels overtrekken",
                        "stoelen overtrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To provide an object with a new layer of fabric or upholstery.",
                        "ru": "Снабжение предмета новым слоем ткани или обивки."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reupholster",
                                "target_lang_sense_clarification": "furniture"
                            },
                            {
                                "target_lang_word": "recover",
                                "target_lang_sense_clarification": "putting a new cover on"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перетягивать",
                                "target_lang_sense_clarification": "мебель новой тканью"
                            },
                            {
                                "target_lang_word": "обивать",
                                "target_lang_sense_clarification": "заново"
                            },
                            {
                                "target_lang_word": "обтягивать",
                                "target_lang_sense_clarification": "покрытием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "579ac964-d6e9-3771-947c-1d743015564a",
                    "sense_definition": "Iets op een overdreven manier voorstellen of reageren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overdrijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Volgens de minister was het probleem door de pers zwaar <w>overtrokken</w>.",
                            "target_lang_translations": {
                                "en": "According to the minister, the problem was heavily <w>exaggerated</w> by the press.",
                                "ru": "По словам министра, проблема была сильно <w>преувеличена</w> прессой."
                            }
                        },
                        {
                            "text": "Ik snap zijn <w>overtrokken</w> reactie op dat kleine foutje echt niet.",
                            "target_lang_translations": {
                                "en": "I really don't understand his <w>overblown</w> reaction to that small mistake.",
                                "ru": "Я действительно не понимаю его <w>чрезмерную</w> реакцию на эту маленькую ошибку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zwaar overtrokken",
                        "overtrokken reactie"
                    ],
                    "target_lang_definitions": {
                        "en": "To present something or react in an exaggerated manner.",
                        "ru": "Представление чего-либо в преувеличенном виде или чрезмерная реакция."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exaggerated",
                                "target_lang_sense_clarification": "of a reaction or claim"
                            },
                            {
                                "target_lang_word": "overblown",
                                "target_lang_sense_clarification": "excessive"
                            },
                            {
                                "target_lang_word": "disproportionate",
                                "target_lang_sense_clarification": "not in proportion"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "преувеличивать",
                                "target_lang_sense_clarification": "значимость или проблему"
                            },
                            {
                                "target_lang_word": "раздувать",
                                "target_lang_sense_clarification": "ситуацию"
                            },
                            {
                                "target_lang_word": "утрировать",
                                "target_lang_sense_clarification": "реакцию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db81ac6f-e7e4-36d0-99ab-9d97e5adf39e",
                    "sense_definition": "Een vliegtuig in een positie brengen waarbij de draagkracht plotseling wegvalt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "luchtvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Piloten leren waar ze op moeten letten om een vliegtuig niet te <w>overtrekken</w>.",
                            "target_lang_translations": {
                                "en": "Pilots learn what to watch out for so as not to <w>stall</w> an aircraft.",
                                "ru": "Пилоты учатся тому, на что нужно обращать внимание, чтобы не <w>допустить сваливания</w> самолета."
                            }
                        },
                        {
                            "text": "Door de te steile klim begon het toestel gevaarlijk te <w>overtrekken</w>.",
                            "target_lang_translations": {
                                "en": "Due to the climb being too steep, the aircraft began to <w>stall</w> dangerously.",
                                "ru": "Из-за слишком крутого подъема самолет начал опасно <w>терять скорость</w> и сваливаться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vliegtuig overtrekken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de luchtvaart"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To bring an aircraft into a position where lift is suddenly lost.",
                        "ru": "Приведение самолета в положение, при котором внезапно теряется подъемная сила."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stall",
                                "target_lang_sense_clarification": "aviation term"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сваливать",
                                "target_lang_sense_clarification": "самолет в штопор или режим сваливания"
                            },
                            {
                                "target_lang_word": "доводить до сваливания",
                                "target_lang_sense_clarification": "авиационный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31310096-e4e1-3d51-98e5-1724e1f6d7b9",
                    "sense_definition": "Nogmaals aan iets trekken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "trekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet het touw nog een keer <w>overtrekken</w> om het strak te krijgen.",
                            "target_lang_translations": {
                                "en": "You need to <w>pull</w> the rope <w>again</w> to get it tight.",
                                "ru": "Нужно еще раз <w>перетянуть</w> веревку, чтобы она была натянута туго."
                            }
                        },
                        {
                            "text": "Na de eerste poging besloot hij de hendel nogmaals te <w>overtrekken</w>.",
                            "target_lang_translations": {
                                "en": "After the first attempt, he decided to <w>pull</w> the lever <w>once more</w>.",
                                "ru": "После первой попытки он решил еще раз <w>дернуть</w> за рычаг."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To pull on something once more.",
                        "ru": "Повторное натяжение или рывок чего-либо."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull again",
                                "target_lang_sense_clarification": "repeated action"
                            },
                            {
                                "target_lang_word": "retighten",
                                "target_lang_sense_clarification": "by pulling"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перетягивать",
                                "target_lang_sense_clarification": "тянуть еще раз для плотности"
                            },
                            {
                                "target_lang_word": "подтягивать",
                                "target_lang_sense_clarification": "повторно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7c1664d-0ffe-3f86-948b-11e0f663ae16",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>overtrek</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben nieuwe <w>overtrekken</w> gekocht voor de kussens op de bank.",
                            "target_lang_translations": {
                                "en": "We bought new <w>covers</w> for the cushions on the sofa.",
                                "ru": "Мы купили новые <w>чехлы</w> для диванных подушек."
                            }
                        },
                        {
                            "text": "De schone <w>overtrekken</w> liggen al klaar in de linnenkast.",
                            "target_lang_translations": {
                                "en": "The clean <w>slips</w> are already waiting in the linen closet.",
                                "ru": "Чистые <w>наволочки</w> уже лежат в бельевом шкафу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "schone overtrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'overtrek', referring to protective fabric layers.",
                        "ru": "Множественное число существительного 'overtrek', означающее защитные тканевые слои или чехлы."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "covers",
                                "target_lang_sense_clarification": "for furniture or pillows"
                            },
                            {
                                "target_lang_word": "slips",
                                "target_lang_sense_clarification": "pillowcases or furniture slips"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "чехлы",
                                "target_lang_sense_clarification": "для мебели или подушек"
                            },
                            {
                                "target_lang_word": "наволочки",
                                "target_lang_sense_clarification": "для подушек"
                            },
                            {
                                "target_lang_word": "покрытия",
                                "target_lang_sense_clarification": "защитные"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}