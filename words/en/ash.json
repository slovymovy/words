{
    "word_family": [
        "ashen",
        "ashy",
        "ashtray",
        "ashcan"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d602dda0-4575-3e8a-9345-4bb36796786b",
                    "sense_definition": "The powdery solid residue left after a material has been burned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "residue_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She swept the cold <w>ash</w> from the fireplace every morning.",
                            "target_lang_translations": {
                                "ru": "Каждое утро она выметала холодную <w>золу</w> из камина.",
                                "zh": "她每天早上都会把壁炉里冰冷的<w>灰</w>扫干净。",
                                "es": "Ella barría la <w>ceniza</w> fría de la chimenea cada mañana."
                            }
                        },
                        {
                            "text": "Cigarette <w>ash</w> fell onto the table as he spoke.",
                            "target_lang_translations": {
                                "ru": "Сигаретный <w>пепел</w> упал на стол, пока он говорил.",
                                "zh": "他说话时，烟<w>灰</w>掉在了桌子上。",
                                "es": "La <w>ceniza</w> del cigarrillo cayó sobre la mesa mientras hablaba."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cigarette ash",
                        "turn to ash",
                        "rise from the ashes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порошкообразный твердый остаток, остающийся после сжигания материала.",
                        "zh": "物质燃烧后留下的粉末状固体残留物。",
                        "es": "Residuo sólido pulverulento que queda después de que un material se ha quemado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пепел",
                                "target_lang_sense_clarification": "мелкий, легкий остаток (напр. от сигарет)"
                            },
                            {
                                "target_lang_word": "зола",
                                "target_lang_sense_clarification": "более грубый остаток (напр. от дров в печи)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灰",
                                "target_lang_sense_clarification": "燃烧后的残留物"
                            },
                            {
                                "target_lang_word": "灰烬",
                                "target_lang_sense_clarification": "燃烧后的残余物"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ceniza",
                                "target_lang_sense_clarification": "residuo general de la combustión"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f294171-b852-394d-a5c2-539e3902a41a",
                    "sense_definition": "The remains of a human or animal body after cremation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "residue_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family decided to scatter his <w>ashes</w> at sea.",
                            "target_lang_translations": {
                                "ru": "Семья решила развеять его <w>прах</w> над морем.",
                                "zh": "家人决定将他的<w>骨灰</w>撒入大海。",
                                "es": "La familia decidió esparcir sus <w>cenizas</w> en el mar."
                            }
                        },
                        {
                            "text": "An urn containing the <w>ashes</w> was placed on the mantelpiece.",
                            "target_lang_translations": {
                                "ru": "Урна с <w>прахом</w> была поставлена на каминную полку.",
                                "zh": "装有<w>骨灰</w>的骨灰盒被放在了壁炉架上。",
                                "es": "Una urna que contenía las <w>cenizas</w> fue colocada sobre la repisa de la chimenea."
                            }
                        }
                    ],
                    "synonyms": [
                        "cremains"
                    ],
                    "common_phrases": [
                        "scatter ashes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Останки человеческого тела или тела животного после кремации.",
                        "zh": "火葬后人类或动物遗体的残留物。",
                        "es": "Restos de un cuerpo humano o animal después de la cremación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прах",
                                "target_lang_sense_clarification": "останки умершего"
                            },
                            {
                                "target_lang_word": "пепел",
                                "target_lang_sense_clarification": "буквальное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骨灰",
                                "target_lang_sense_clarification": "火葬后的遗骨残余"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cenizas",
                                "target_lang_sense_clarification": "restos mortales incinerados (usado en plural)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7204149-4d0d-38e4-befa-2ec26849f162",
                    "sense_definition": "A common shade tree of the genus Fraxinus, known for its tough wood.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tree_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>ash</w> in the backyard provides excellent shade in summer.",
                            "target_lang_translations": {
                                "ru": "Старый <w>ясень</w> на заднем дворе дает отличную тень летом.",
                                "zh": "后院那棵老<w>白蜡树</w>在夏天提供了极好的遮荫。",
                                "es": "El viejo <w>fresno</w> en el patio trasero proporciona una sombra excelente en verano."
                            }
                        },
                        {
                            "text": "Many <w>ash</w> trees in the region are suffering from disease.",
                            "target_lang_translations": {
                                "ru": "Многие <w>ясени</w> в регионе страдают от болезней.",
                                "zh": "该地区的许多<w>白蜡树</w>正遭受病害。",
                                "es": "Muchos <w>fresnos</w> en la región están sufriendo enfermedades."
                            }
                        }
                    ],
                    "synonyms": [
                        "ash tree"
                    ],
                    "common_phrases": [
                        "mountain ash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное тенистое дерево рода Ясень (Fraxinus), известное своей прочной древесиной.",
                        "zh": "木犀科白蜡树属的常见遮荫树，以木材坚硬著称。",
                        "es": "Árbol de sombra común del género Fraxinus, conocido por su madera resistente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясень",
                                "target_lang_sense_clarification": "дерево"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白蜡树",
                                "target_lang_sense_clarification": "树木名称"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "fresno",
                                "target_lang_sense_clarification": "árbol"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21aba5e3-f53c-3d42-b01e-611dc683f8da",
                    "sense_definition": "Fine particles of rock and mineral ejected from a volcano.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "residue_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Flights were cancelled because of the thick volcanic <w>ash</w> in the sky.",
                            "target_lang_translations": {
                                "ru": "Рейсы были отменены из-за густого вулканического <w>пепла</w> в небе.",
                                "zh": "由于天空中浓厚的<w>火山灰</w>，航班被取消了。",
                                "es": "Los vuelos fueron cancelados debido a la espesa <w>ceniza</w> volcánica en el cielo."
                            }
                        },
                        {
                            "text": "The village was covered in a layer of grey <w>ash</w> after the eruption.",
                            "target_lang_translations": {
                                "ru": "После извержения деревня была покрыта слоем серого <w>пепла</w>.",
                                "zh": "火山喷发后，村庄覆盖了一层灰色的<w>火山灰</w>。",
                                "es": "El pueblo quedó cubierto por una capa de <w>ceniza</w> gris después de la erupción."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volcanic ash",
                        "cloud of ash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкие частицы горных пород и минералов, выбрасываемые вулканом.",
                        "zh": "火山喷发时喷出的细小岩石和矿物颗粒。",
                        "es": "Partículas finas de roca y minerales expulsadas por un volcán."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пепел",
                                "target_lang_sense_clarification": "вулканический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "火山灰",
                                "target_lang_sense_clarification": "火山喷发物"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ceniza volcánica",
                                "target_lang_sense_clarification": "partículas expulsadas por un volcán"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c17d3d56-fdf5-316a-9065-3899c2778945",
                    "sense_definition": "The hard, pale wood obtained from the ash tree, often used for furniture or tool handles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tree_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baseball bat was made of solid <w>ash</w>.",
                            "target_lang_translations": {
                                "ru": "Бейсбольная бита была сделана из цельного <w>ясеня</w>.",
                                "zh": "这根棒球棒是用坚硬的<w>白蜡木</w>制成的。",
                                "es": "El bate de béisbol estaba hecho de <w>fresno</w> sólido."
                            }
                        },
                        {
                            "text": "They chose a kitchen table crafted from light <w>ash</w>.",
                            "target_lang_translations": {
                                "ru": "Они выбрали кухонный стол, изготовленный из светлого <w>ясеня</w>.",
                                "zh": "他们选了一张用浅色<w>白蜡木</w>制作的餐桌。",
                                "es": "Eligieron una mesa de cocina hecha de <w>fresno</w> claro."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердая светлая древесина ясеня, часто используемая для мебели или рукояток инструментов.",
                        "zh": "从白蜡树上获得的坚硬浅色木材，常用于制作家具或工具柄。",
                        "es": "Madera dura y clara obtenida del fresno, utilizada a menudo para muebles o mangos de herramientas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясень",
                                "target_lang_sense_clarification": "материал/древесина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白蜡木",
                                "target_lang_sense_clarification": "木材名称"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "madera de fresno",
                                "target_lang_sense_clarification": "material de construcción"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b23d4419-a115-3d30-acc5-fd7cd4ec184b",
                    "sense_definition": "To knock the burnt ash off the end of a burning cigarette or cigar.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He nervously <w>ashed</w> his cigarette into the tray while waiting.",
                            "target_lang_translations": {
                                "ru": "Ожидая, он нервно <w>стряхивал пепел</w> со своей сигареты в пепельницу.",
                                "zh": "等待时，他紧张地把烟<w>弹</w>进烟灰缸里。",
                                "es": "Él nerviosamente <w>sacudió la ceniza</w> de su cigarrillo en el cenicero mientras esperaba."
                            }
                        },
                        {
                            "text": "Please do not <w>ash</w> on the carpet.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>стряхивай пепел</w> на ковер.",
                                "zh": "请不要把烟<w>弹</w>在地毯上。",
                                "es": "Por favor, no <w>sacudas la ceniza</w> en la alfombra."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стряхивать сгоревший пепел с кончика горящей сигареты или сигары.",
                        "zh": "将燃烧的香烟或雪茄末端的灰烬弹掉。",
                        "es": "Golpear el extremo de un cigarrillo o puro encendido para desprender la ceniza."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стряхивать пепел",
                                "target_lang_sense_clarification": "действие с сигаретой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弹掉",
                                "target_lang_sense_clarification": "动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sacudir la ceniza",
                                "target_lang_sense_clarification": "acción de limpiar el cigarrillo"
                            }
                        ]
                    }
                }
            ]
        },
