                "senses": [
                    {
                        "sense_id": "36170a95-93b3-3a27-81eb-78e4b9fb35a4",
                        "entry_id": "2965699c-4f71-321f-88ef-cf7cae311df8",
                        "glosses": [
                            "een grote indruk achterlatend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2173f478-c854-464e-a8f0-b9edccd244ee",
                                "sense_id": "36170a95-93b3-3a27-81eb-78e4b9fb35a4",
                                "text": "Nog een impressionant cijfer: de eerste lading van 100.000 toestellen - aangeboden op sociaalnetwerksite Qzone - was op 90 seconden de deur uit. Vijf uur later stond de teller op 3 miljoen exemplaren."
                            },
                            {
                                "example_id": "9d12bbc0-37f3-4bd1-ac37-2736225c8bd6",
                                "sense_id": "36170a95-93b3-3a27-81eb-78e4b9fb35a4",
                                "text": "'El Pistolero' bouwde de afgelopen jaren een impressionant palmares op. Hij won twee keer de Ronde van Frankrijk (2007 en 2009), twee keer de Vuelta (2008 en 2012) en één keer de Giro (2008)."
                            },
                            {
                                "example_id": "be490b0f-0d99-436a-a4f0-07a7c0a5f43e",
                                "sense_id": "36170a95-93b3-3a27-81eb-78e4b9fb35a4",
                                "text": "De woning werd minutieus gerestaureerd onder leiding van de architecten Frank Escher en Ravi GuneWardena, en prijkt nu op een lijst van de 10 meest impressionante woningen in Los Angeles."
                            }
                        ]
                    }
