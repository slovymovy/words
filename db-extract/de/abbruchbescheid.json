                        ],
                        "examples": [
                            {
                                "example_id": "e0e44469-d2aa-49cf-bcc7-9886552abeda",
                                "sense_id": "05122386-e02a-3c5e-97b2-95a8243cc7ab",
                                "text": "Das Ehepaar Düringer hält den Abbruchbescheid in der Hand. Sie haben bis „spätestens 31. Juli 2008“ ihr Haus abzureißen."
                            },
                            {
                                "example_id": "b8f9a1dd-093e-42b9-9772-ff7bdb9a9575",
                                "sense_id": "05122386-e02a-3c5e-97b2-95a8243cc7ab",
                                "text": "In erster Instanz erließ die Behörde auf Basis der Vermessungen des Geometers einen Abbruchbescheid."
                            },
                            {
                                "example_id": "89a32326-97c9-43d9-bf54-8aef302992d2",
                                "sense_id": "05122386-e02a-3c5e-97b2-95a8243cc7ab",
                                "text": "Das Gebäude verwahrloste immer mehr, 1972 richtete ein Erdbeben weitere Schäden an und Mitte der 1970er Jahre beantragte der Eigentümer den Abbruchbescheid."
                            }
                        ],
