                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aefd6530-fdc7-3663-a7fc-cc5ed47f666d",
                        "entry_id": "dda41df0-ea01-3185-ba23-817873075e37",
                        "glosses": [
                            "Bezeichnung für einen nicht definierten Vertreter aus der Familie von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c04b278-6108-47de-9223-f981c1cf4a93",
                                "sense_id": "aefd6530-fdc7-3663-a7fc-cc5ed47f666d",
                                "text": "„Papageientaucher mit Schnäbeln voller Sandaale flüchten schwerfällig vor dem Boot und klatschen ein paar Meter weiter zurück in die Wellen, Mantelmöwen gleiten wie Modellflugzeuge über der Wasseroberfläche.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
