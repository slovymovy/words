                "senses": [
                    {
                        "sense_id": "134fd409-f796-3b95-ae0c-8257369ce699",
                        "entry_id": "ba106549-dd4f-3ba9-b7ba-f41d67dbeb3a",
                        "glosses": [
                            "pierwiastek chemiczny o symbolu W i liczbie atomowej 74"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7e1628-cd1b-4d90-8cb4-63ce8ee9a582",
                                "sense_id": "134fd409-f796-3b95-ae0c-8257369ce699",
                                "text": "Jakie właściwości chemiczne ma wolfram?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4a5cc47-b48e-4e59-9fce-13aa10af50b5",
                        "source_entry_id": "ba106549-dd4f-3ba9-b7ba-f41d67dbeb3a",
                        "source_sense_id": "134fd409-f796-3b95-ae0c-8257369ce699",
                        "target_lang_word": "tungsten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tungsten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2ac233-e715-38e9-8304-af19b18eaeac",
                                        "entry_id": "aabaeba1-ae93-30a8-bd98-93c475d98581",
                                        "glosses": [
                                            "A rare metallic chemical element (symbol W, from Latin wolframium) with an atomic number of 74."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16111632-debc-4b47-912c-cab6ca08439d",
                                                "sense_id": "9e2ac233-e715-38e9-8304-af19b18eaeac",
                                                "text": "So far they have built and used a prototype robot to make millionth-of-a-meter scratches in aluminum with a fine tungsten needle."
                                            },
                                            {
                                                "example_id": "3fada3e2-aea3-4521-a9f0-11e4d7900eb7",
                                                "sense_id": "9e2ac233-e715-38e9-8304-af19b18eaeac",
                                                "text": "Which makes the concept known as Rods From God the ultimate form of kinetic weaponry. This theoretical weapon would drop telephone pole sized rods of dense tungsten from a satellite in orbit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6801d1b9-7482-3306-886e-20ec651e8612",
                                        "entry_id": "aabaeba1-ae93-30a8-bd98-93c475d98581",
                                        "glosses": [
                                            "A light bulb containing tungsten."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae36f97-9337-4647-8ceb-2ffc3024b443",
                                                "sense_id": "6801d1b9-7482-3306-886e-20ec651e8612",
                                                "text": "We have several business houses where tungstens are used as window lights only, and find that in nearly every one the wiring was arranged to get more light, leaving the consumption about the same."
                                            },
                                            {
                                                "example_id": "15624afe-f951-4589-b6b9-ae778f6cdc77",
                                                "sense_id": "6801d1b9-7482-3306-886e-20ec651e8612",
                                                "text": "Lighting was unimaginative for the standard stock with naked tungsten filament bulbs and metal reflectors. However, all compartments had individual reading lights above the seats with attractive glass shades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc496f3-b064-33d6-a452-bd3d5c30101a",
                                        "entry_id": "aabaeba1-ae93-30a8-bd98-93c475d98581",
                                        "glosses": [
                                            "scheelite, calcium tungstate"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b28e14d8-1df1-4443-a6e7-23a401a8f38e",
                                                "sense_id": "5dc496f3-b064-33d6-a452-bd3d5c30101a",
                                                "text": "We apprehend that this is not the acid of a calx ponderoſa, but rather a diſtinct acid conjoined to common calcareous earth, ſince, in fact, in another place, § 97, the tungſten is mentioned as a calx ſaturated with a peculiar acid, perhaps of a metallic nature, for which the author himſelf refers us to the above § 33, and ſeems to think it the ſame as the acid there mentioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d5747bd-197d-4039-b272-39dc20d1cd11",
                        "source_entry_id": "ba106549-dd4f-3ba9-b7ba-f41d67dbeb3a",
                        "source_sense_id": "134fd409-f796-3b95-ae0c-8257369ce699",
                        "target_lang_word": "wolfram",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wolfram",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "94872a9a-db2d-3b90-9ebd-79083a3e18ba",
                                        "entry_id": "b5b2239d-5e9b-36fa-b013-9846748f360d",
                                        "glosses": [
                                            "kovový chemický prvek s atomovým číslem 74 a chemickou značkou W"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34f3753e-a764-47e0-8d45-ea4f745cd4a1",
                        "source_entry_id": "ba106549-dd4f-3ba9-b7ba-f41d67dbeb3a",
                        "source_sense_id": "134fd409-f796-3b95-ae0c-8257369ce699",
                        "target_lang_word": "tungstène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tungstène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96470646-0611-3ccb-950e-70bb6c6a8721",
                                        "entry_id": "7425e1cc-20ad-3a8d-994f-00f5952a6aa7",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 74, son symbole W appartenant à la série chimique des métaux de transition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60776bb9-cc19-4304-a30b-f381bd9c8083",
                                                "sense_id": "96470646-0611-3ccb-950e-70bb6c6a8721",
                                                "text": "Cet âge obtenu d'abord par les isotopes du plomb a été confirmé récemment par l'étude de la composition isotopique du tungstène dans les roches terrestres comparées aux résultats des météorites."
                                            },
                                            {
                                                "example_id": "d7e78468-c75c-4d77-b8bf-4ce326be74a3",
                                                "sense_id": "96470646-0611-3ccb-950e-70bb6c6a8721",
                                                "text": "Selon des informations de presse, les armes DIME [Dense Inert Metal Explosive] combinent un explosif, des particules de carbone et une poudre d'un alliage de métaux lourds et de tungstène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd6aff1f-2f66-31ad-9921-ab9add6ce238",
                                        "entry_id": "7425e1cc-20ad-3a8d-994f-00f5952a6aa7",
                                        "glosses": [
                                            "Corps simple de cet élément très dur, très pesant et très stable aux hautes températures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3527573-7821-410b-a125-0f8c346fe7de",
                                                "sense_id": "dd6aff1f-2f66-31ad-9921-ab9add6ce238",
                                                "text": "D’autres procédés modernes, tels que le spiralage du filament et même, pour certaines lampes, le double spiralage, ont permis de porter à un très haut degré le rendement de nos lampes. Les filaments sont en tungstène, métal extrait d'un minerai rare appelé « scheelite », dont le point de fusion est particulièrement élevé (3.380°)."
                                            },
                                            {
                                                "example_id": "e4cb2612-3ec0-4659-993c-8dd168fd3298",
                                                "sense_id": "dd6aff1f-2f66-31ad-9921-ab9add6ce238",
                                                "text": "Tungsten Toad: Cette offrande de Lindy est fabriquée avec du tungstène, un métal dur et plus dense que le plomb, qui, taille pour taille, s'enfonce plus rapidement vers les profondeurs."
                                            },
                                            {
                                                "example_id": "f902ad68-c1c9-4636-99ae-e6fba95f7604",
                                                "sense_id": "dd6aff1f-2f66-31ad-9921-ab9add6ce238",
                                                "text": "Les fils de tungstène des ampoules électriques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e13c639-bd56-48df-b959-1de9b9c69a7f",
                        "source_entry_id": "ba106549-dd4f-3ba9-b7ba-f41d67dbeb3a",
                        "source_sense_id": "134fd409-f796-3b95-ae0c-8257369ce699",
                        "target_lang_word": "wolframio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wolframio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7c10ef38-0778-358e-8bcf-1cdc40cb7acb",
                                        "entry_id": "5dd49726-a838-351b-9ed9-b99aa3825542",
                                        "glosses": [
                                            "Elemento químico de número atómico 74, un metal de color gris acero, muy duro y denso (símbolo W)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2631434-b423-4f80-878e-874afdc52d89",
                                                "sense_id": "7c10ef38-0778-358e-8bcf-1cdc40cb7acb",
                                                "text": "Tostado de nuevo el producto, se deja enfriar, se muele finamente y se somete a la lixiviación dentro de cubas de madera para dejar en disolución las sales de vanadio, arsénico y wolframio, así como los sulfatos y molibdatos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "073929fd-19ce-4e97-90b8-5bcbc093fd4c",
                        "source_entry_id": "ba106549-dd4f-3ba9-b7ba-f41d67dbeb3a",
                        "source_sense_id": "134fd409-f796-3b95-ae0c-8257369ce699",
                        "target_lang_word": "volframio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volframio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "cc2592db-2cc0-3fc8-90eb-3fa50862313b",
                                        "entry_id": "411453bc-021d-3ea2-a3ed-a4bc00249b89",
                                        "glosses": [
                                            "Elemento químico de número atómico 74, un metal de color gris acero, muy duro y denso (símbolo W)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce06fde7-2f62-4128-81cd-6a3bce620e05",
                                                "sense_id": "cc2592db-2cc0-3fc8-90eb-3fa50862313b",
                                                "text": "La construcción de un útil con matrices y punzones de carburos de volframio requiere de dos a cuatro veces más tiempo que la misma construcción en acero, pero este aumento en el precio del útil se ve compensado ampliamente por las ventajas antes expuestas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "382f4e57-dbae-4438-939c-305f9fe175a4",
                        "source_entry_id": "ba106549-dd4f-3ba9-b7ba-f41d67dbeb3a",
