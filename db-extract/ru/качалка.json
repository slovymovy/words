                    },
                    {
                        "sense_id": "dfb39c98-0485-344d-a05d-163a7efa1ccc",
                        "entry_id": "d17330db-752c-384b-8825-2e6c782db063",
                        "glosses": [
                            "техн. деталь, похожая на качалку [1] (например, в системе управления кордовой моделью)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83316214-a45b-4f5f-90d5-8260a24fc50d",
                                "sense_id": "dfb39c98-0485-344d-a05d-163a7efa1ccc",
                                "text": "Наиболее простая схема управления этим механизмом — третья корда и дополнительная качалка."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4a79e95-4664-3893-971b-d5589da821b9",
                        "entry_id": "d17330db-752c-384b-8825-2e6c782db063",
                        "glosses": [
                            "спорт. в конном спорте: одноместная повозка на двух колёсах, применяемая в бегах рысаков"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3b1c656a-df52-3559-979e-5ddfcef918e3",
                        "entry_id": "d17330db-752c-384b-8825-2e6c782db063",
                        "glosses": [
                            "живоп. инструмент для затушёвки фона в гравюрах на металле"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "52036f07-c030-3ced-83a0-dac6e2642256",
                        "entry_id": "d17330db-752c-384b-8825-2e6c782db063",
                        "glosses": [
                            "спорт., жарг. то же, что тренажёрный зал"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4131b24f-8992-4238-bbd0-86546b52267d",
                                "sense_id": "52036f07-c030-3ced-83a0-dac6e2642256",
                                "text": "Вот и хлынули в охранный бизнес спортсмены всех мастей, всякие дембеля-десантники и «свои надёжные ребята» из подвалов-качалок…"
                            }
                        ]
                    },
                    {
                        "sense_id": "30735d44-5ae6-3970-8ed4-b91cafb6df80",
                        "entry_id": "d17330db-752c-384b-8825-2e6c782db063",
                        "glosses": [
                            "комп. жарг. компьютерная программа для скачивания файлов через Интернет"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a090787a-9e5c-4077-8f91-98f62313dfd5",
                        "source_entry_id": "d17330db-752c-384b-8825-2e6c782db063",
                        "source_sense_description": "тренажёрный зал",
                        "target_lang_word": "gym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "322238eb-f622-33eb-ad35-d264f132d2af",
                                        "entry_id": "bef327cd-a5d4-3b33-b21a-1949c3cc9324",
                                        "glosses": [
                                            "Clipping of gymnasium; especially, a school gymnasium."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42a3fc0d-75fc-4097-8c27-6561b4123414",
                                                "sense_id": "322238eb-f622-33eb-ad35-d264f132d2af",
                                                "text": "It was pouring rain, so the kids played kickball in the gym instead of on the field."
                                            },
                                            {
                                                "example_id": "8204e109-a93e-46fc-9e46-13f09a85f0cf",
                                                "sense_id": "322238eb-f622-33eb-ad35-d264f132d2af",
                                                "text": "Gym is my favourite period in this school."
                                            },
                                            {
                                                "example_id": "65558fc2-a6c5-4ba5-afb4-fd824e16645c",
                                                "sense_id": "322238eb-f622-33eb-ad35-d264f132d2af",
                                                "text": "I'm off to the gym for my pilates class."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8632fb43-47d3-3aa4-bee3-3ebc0393b5c0",
                                        "entry_id": "bef327cd-a5d4-3b33-b21a-1949c3cc9324",
                                        "glosses": [
                                            "Clipping of gymnastics, often as sense 4."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87dce29f-7569-301b-9c5a-5777c0be8842",
                                        "entry_id": "bef327cd-a5d4-3b33-b21a-1949c3cc9324",
                                        "glosses": [
                                            "A sports facility specialized for lifting weights, cardio machines, and other exercise (culturally differentiated from sense 1)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78197100-f234-404f-80a4-e8da0290504f",
                                                "sense_id": "87dce29f-7569-301b-9c5a-5777c0be8842",
                                                "text": "Near-synonyms: health club, sports club"
                                            },
                                            {
                                                "example_id": "2e6d0043-2ba6-4c54-8226-ab646496afef",
                                                "sense_id": "87dce29f-7569-301b-9c5a-5777c0be8842",
                                                "text": "hit the gym"
                                            },
                                            {
                                                "example_id": "3bdb2c21-9a0d-44a4-a2bd-507cf0035a35",
                                                "sense_id": "87dce29f-7569-301b-9c5a-5777c0be8842",
                                                "text": "He's been hitting the gym a lot. He has a membership at a commercial gym and also a bit of a home gym."
                                            },
                                            {
                                                "example_id": "2800260d-8b75-46e3-92d6-04cb19a59732",
                                                "sense_id": "87dce29f-7569-301b-9c5a-5777c0be8842",
                                                "text": "Working out in commercial gyms, if anything, made my workouts worse instead of better."
                                            },
                                            {
                                                "example_id": "41c18645-9f41-4460-9d5e-9304bca55a2a",
                                                "sense_id": "87dce29f-7569-301b-9c5a-5777c0be8842",
                                                "text": "Pete, I want to work out. Where is the gym?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e02502a-772e-3496-bf80-3394fd5ee7e5",
                                        "entry_id": "bef327cd-a5d4-3b33-b21a-1949c3cc9324",
                                        "glosses": [
                                            "Physical education class (PE class)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3df5545-0163-4e55-b783-ab37f6de09dd",
                                                "sense_id": "6e02502a-772e-3496-bf80-3394fd5ee7e5",
                                                "text": "The gym teacher at our school makes us stretch before and after each class."
                                            },
                                            {
                                                "example_id": "f4b43403-06ba-417b-8200-51659744730a",
                                                "sense_id": "6e02502a-772e-3496-bf80-3394fd5ee7e5",
                                                "text": "gym teacher"
                                            },
                                            {
                                                "example_id": "0405ef2f-3953-468f-b110-50d2cddf1805",
                                                "sense_id": "6e02502a-772e-3496-bf80-3394fd5ee7e5",
                                                "text": "gym class"
                                            },
                                            {
                                                "example_id": "b2b38cca-12b4-4ed3-b3d6-7ec8c3bee129",
                                                "sense_id": "6e02502a-772e-3496-bf80-3394fd5ee7e5",
                                                "text": "She has gym on Tuesday and Thursday afternoons."
                                            },
                                            {
                                                "example_id": "ab51ccda-02b9-4351-9347-c190b3493513",
                                                "sense_id": "6e02502a-772e-3496-bf80-3394fd5ee7e5",
                                                "text": "They played basketball in gym last week."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9094db1a-1895-349e-873d-ae75e44914c7",
                                        "entry_id": "c055f6db-3727-304e-8143-6be4342f8d8f",
                                        "glosses": [
                                            "To go to the gym."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "India",
                                            "South-Africa",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b9075d8-371c-479d-a13d-7a4f4c95bec9",
                                                "sense_id": "9094db1a-1895-349e-873d-ae75e44914c7",
                                                "text": "The only thing that can make you susceptible to this condition pre-marriage is crash dieting or mindless gymming and exercise.)"
                                            },
                                            {
                                                "example_id": "b02ab425-3b87-42e4-835a-a198bcf701c1",
                                                "sense_id": "9094db1a-1895-349e-873d-ae75e44914c7",
                                                "text": "I have tried everything from yoga to dancing to gymming, but I can't be consistent with anything. Actually, I'm okay without working out."
                                            },
                                            {
                                                "example_id": "b144e274-4e83-45e6-9655-0a41240dcad6",
                                                "sense_id": "9094db1a-1895-349e-873d-ae75e44914c7",
                                                "text": "So just like you go gymming for your body, go gymming with thoughts in order to have a healthier mind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
