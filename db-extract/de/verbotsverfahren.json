                "senses": [
                    {
                        "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                        "entry_id": "92955d78-d2f8-3dcc-949d-1dbc15485a19",
                        "glosses": [
                            "Rechtshandlung einer Behörde oder Gerichtsprozess, der die Auflösung einer Partei oder Organisation bewirken soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d332dd0-2dfb-4c4d-a587-50f7992a3215",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "„Gegen die rechtsextreme NPD gab es 2 Verbotsverfahren; beide scheiterten.“"
                            },
                            {
                                "example_id": "a00976cf-d484-428d-9e06-29ab962cbd91",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "„ein Verbotsverfahren ist höchst riskant.“"
                            },
                            {
                                "example_id": "6cc5d53d-fbe4-4837-8194-54c249fd2e3d",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "„Ein Verbotsverfahren wird durch Antrag beim Bundesverfassungsgericht eingeleitet.“"
                            },
                            {
                                "example_id": "db2b8c6b-0623-4229-be41-5ddf1b8e4a34",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "[22. Januar 2002:] „Karlsruhe: Das Bundesverfassungsgericht hebt die mündlichen Verhandlungstermine im Verbotsverfahren gegen die rechtsextreme NPD überraschend auf.“"
                            },
                            {
                                "example_id": "4a3ff68f-52b5-4ad1-b675-c39aba7b5d2e",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "[13. Mai 2003:] „Nach Angaben von Schily wird die rechtsextremistische NPD trotz der Einstellung des Verbotsverfahrens durch das Bundesverfassungsgericht weiter beobachtet.“"
                            },
                            {
                                "example_id": "a5cb2a68-936e-4f54-a219-4a430d2a9de4",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "„2003 scheiterte ein Verbotsverfahren gegen die Nationaldemokratische Partei Deutschlands vor dem Bundesverfassungsgericht.“"
                            },
                            {
                                "example_id": "67efe778-4b88-41ae-8863-8aab2edef313",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "„Aus Sicht des Thüringer Verfassungsschutzchefs Stephan Kramer ist ein Verbotsverfahren die »Ultima Ratio« im Umgang mit der Partei.“"
                            },
                            {
                                "example_id": "f5ce34c1-e2c3-442a-a91f-72b86c4d3f21",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "„Am 31. März 2008 leitete das türkische Verfassungsgericht das Verbotsverfahren gegen die 71 Politiker und die Regierungspartei AKP offiziell ein.“"
                            },
                            {
                                "example_id": "961c6de0-60e4-4f84-93de-5bacedea6615",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "„In der Diskussion um ein Verbotsverfahren gegen die AfD überwiegt in der Politik die Skepsis.“"
                            },
                            {
                                "example_id": "c9c43641-aabb-413c-b125-2f1de6f6b748",
                                "sense_id": "ff717f35-a9b0-3df5-b059-4e9447c93f0f",
                                "text": "„Im April diesen Jahres waren in Zusammenhang mit dem Verbotsverfahren wegen des Verdachts der Terrorfinanzierung in Nordrhein-Westfalen und Bayern Wohnungen durchsucht worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
