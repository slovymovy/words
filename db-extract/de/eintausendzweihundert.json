                "entry_id": "167bdc9f-3c61-3b7d-9b40-e4e215e2f575",
                "word": "eintausendzweihundert",
                "pos": "num",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b41698a0-d7ec-3d48-966d-b0f0e2c6a5a7",
                        "entry_id": "167bdc9f-3c61-3b7d-9b40-e4e215e2f575",
                        "glosses": [
                            "die Kardinalzahl, die sich aus Addition von tausend und zweihundert ergibt; zwölf mal hundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb1ffdf8-f021-4e23-ba27-b4105762e3d8",
                                "sense_id": "b41698a0-d7ec-3d48-966d-b0f0e2c6a5a7",
                                "text": "„Bis zu eintausendzweihundert Frachtkräne, Prahme und Schuten lagen in einem Jahr hier vor Anker und brachten ihre Güter nach Holland.“"
                            },
                            {
                                "example_id": "a21dbf08-e608-46f0-b5cd-1b8b18056bf4",
                                "sense_id": "b41698a0-d7ec-3d48-966d-b0f0e2c6a5a7",
                                "text": "„Die eintausendzweihundert Mann starke Garnison hatte sich schon am 19ten den Spaniern ergeben.“"
                            },
                            {
                                "example_id": "c0599c99-a5a5-46b9-8d56-88678e1748d2",
                                "sense_id": "b41698a0-d7ec-3d48-966d-b0f0e2c6a5a7",
                                "text": "„Ich kann mir nicht vorstellen, dass ein Orgelregister, auf die verlangte Art gebaut, weniger als mindestens eintausendzweihundert Franken kosten soll.“"
                            },
                            {
                                "example_id": "f5300ff5-1510-4cd8-b6ca-82e1d003e7ba",
                                "sense_id": "b41698a0-d7ec-3d48-966d-b0f0e2c6a5a7",
                                "text": "„Brown-Sequard berichtete davon, dass er an über eintausendzweihundert Wissenschaftler kostenlos seine organische Flüssigkeit verschickt habe.“"
                            },
                            {
                                "example_id": "6504ff70-cf59-44bb-a6b7-025ea4e49ea4",
                                "sense_id": "b41698a0-d7ec-3d48-966d-b0f0e2c6a5a7",
                                "text": "„Man muß das so verstehen: Vor zwölfhundert Premierenbesuchern, also eintausendzweihundert Menschen in Zürich, Berlin oder München, entscheidet sich das öffentliche Schicksal eines dramatischen Werkes von Frisch, Dürrenmatt, Peter Weiss oder Grass.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
