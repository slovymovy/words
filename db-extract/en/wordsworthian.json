                        "examples": [
                            {
                                "example_id": "8f7bef4e-b9f9-492b-bfd3-538c46147c80",
                                "sense_id": "3cf4a0c3-3b26-3bbb-8235-6c591a7c189a",
                                "text": "The sentiment is of a distinctly Wordsworthian quality."
                            },
                            {
                                "example_id": "8adecc25-6a96-4a5a-b8c0-a2e2ca9baa9d",
                                "sense_id": "3cf4a0c3-3b26-3bbb-8235-6c591a7c189a",
                                "text": "The whole area was tastefully laid out with gardens full of daffodils and other Wordsworthian aids to memory."
                            },
                            {
                                "example_id": "ed0aaac6-a213-4a5d-93db-97ce024f5778",
                                "sense_id": "3cf4a0c3-3b26-3bbb-8235-6c591a7c189a",
                                "text": "We don’t have Alps in this country, but we have the Drakensberg, or on a smaller scale Table Mountain, which we climb in the wake of the poets, hoping for one of those revelatory, Wordsworthian moments we have all heard about."
                            },
                            {
                                "example_id": "a583ea78-8e8f-4e7c-a0f4-9cb3d83ea81a",
                                "sense_id": "3cf4a0c3-3b26-3bbb-8235-6c591a7c189a",
                                "text": "The Wordsworthian Enlightenment: Romantic Poetry and the Ecology of Reading."
                            }
                        ]
                    }
