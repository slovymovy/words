    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "278f4072-d98f-3a9f-b786-359da0e661e9",
                "word": "peaker",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "66ea9f29-7692-45e9-a1ae-2562f019da38",
                        "entry_id": "278f4072-d98f-3a9f-b786-359da0e661e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "peakers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b360c354-c1d8-3c02-bca5-85e009b0cc4c",
                        "entry_id": "278f4072-d98f-3a9f-b786-359da0e661e9",
                        "glosses": [
                            "That which reaches or forms a peak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29997b4-46cf-44dd-a76f-16695950b7b3",
                                "sense_id": "b360c354-c1d8-3c02-bca5-85e009b0cc4c",
                                "text": "The amplitude was sufficiently large to enable one to see the string take the shape of the compounded wave, but as the phase difference between the two vibrations changed rapidly, the visual impression was of a three-peaker curve."
                            },
                            {
                                "example_id": "ba135b4a-6897-4891-9f8e-1720a0e83144",
                                "sense_id": "b360c354-c1d8-3c02-bca5-85e009b0cc4c",
                                "text": "L of them, Tryfan is clearly a three peaker from this angle, and the Glyders with their two outliers (16) complete the circle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d14ad0fb-8969-3443-b715-bc91d9c8995e",
                        "entry_id": "278f4072-d98f-3a9f-b786-359da0e661e9",
                        "glosses": [
                            "One whose behaviour or performance reaches a maximum (of something) at a particular time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87921ad-05eb-435d-945e-e5ff2ec39292",
                                "sense_id": "d14ad0fb-8969-3443-b715-bc91d9c8995e",
                                "text": "All patients and controls who achieved maximum PHA response on day six or later were called \" late peakers\" , and those who achieved maximum PHA response on day four or earlier were called \"early peakers\" ."
                            },
                            {
                                "example_id": "9a163de1-e1f9-41a7-904b-555939ef58fb",
                                "sense_id": "d14ad0fb-8969-3443-b715-bc91d9c8995e",
                                "text": "These are the teams the program team has to watch out for. They're the peakers."
                            },
                            {
                                "example_id": "aade48f4-2c3e-444a-8416-31c7c35f0dfe",
                                "sense_id": "d14ad0fb-8969-3443-b715-bc91d9c8995e",
                                "text": "In general, those subjects classified as rare offenders or moderate late peakers (approximately 70% of the sample) were significantly less likely than those on the high-level chronic trajectory to be male, to have poor academic achievement, to have low social support from family, to experience stressful life events, and to use alcohol or other substances."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f5b6905-ad15-32a6-84de-c7204a5f3a1d",
                        "entry_id": "278f4072-d98f-3a9f-b786-359da0e661e9",
                        "glosses": [
                            "A power station that provides energy supply only during peak usage periods."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9eaf3b0-5b31-4d54-84df-c44e6a855abb",
                                "sense_id": "2f5b6905-ad15-32a6-84de-c7204a5f3a1d",
                                "text": "The most common peaking units or \"peakers\" are electricity generating units that run during times of high electricity consumption."
                            },
                            {
                                "example_id": "2fedca39-5e21-45f8-99d2-0ad98bfd8eba",
                                "sense_id": "2f5b6905-ad15-32a6-84de-c7204a5f3a1d",
                                "text": "Peakers can be brought on line at full capacity quickly to help meet peak electricity demands as well as to satisfy normal demands during scheduled and unscheduled shutdowns at base-load plants."
                            }
                        ]
                    },
                    {
                        "sense_id": "35d72f2d-10f5-33cc-b75c-74b0ea19d374",
                        "entry_id": "278f4072-d98f-3a9f-b786-359da0e661e9",
                        "glosses": [
                            "One who climbs to the peak of one or more mountains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf1045c2-5fc2-4788-bd3e-d7c5833fb44d",
                                "sense_id": "35d72f2d-10f5-33cc-b75c-74b0ea19d374",
                                "text": "'Good work, team, good work! ... We meet a long trail of Three Peakers doing their first mountain."
                            }
                        ]
                    },
                    {
                        "sense_id": "736a8c91-2298-3d09-8877-a09d334b0787",
                        "entry_id": "278f4072-d98f-3a9f-b786-359da0e661e9",
                        "glosses": [
                            "One who is open to peak experiences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc4202a-0966-47b1-a16b-1da000e6c5c9",
                                "sense_id": "736a8c91-2298-3d09-8877-a09d334b0787",
                                "text": "Interestingly, in terms of his hierarchy of human potential, Maslow locates these 'peakers' between the self-actualizers who have peak experiences and those who do not."
                            },
                            {
                                "example_id": "9d3a3fba-4f61-4c6a-8646-4688d4cf6f7d",
                                "sense_id": "736a8c91-2298-3d09-8877-a09d334b0787",
                                "text": "Whereas peakers emphasize creativity, personal growth, and non-institutionalized forms of religious experiences, “non-peakers” value the practicality of everyday life, worldly success, and tradition (Maslow, 1970)."
                            },
                            {
                                "example_id": "1bbbc631-c0f9-4cd3-9283-e8aa1a430547",
                                "sense_id": "736a8c91-2298-3d09-8877-a09d334b0787",
                                "text": "Peakers appear to display a general willingness to explore and experience states of consciousness differing from their usual states of being and are 'open' in the broadest sense of the word."
                            }
                        ]
                    }
                ],
