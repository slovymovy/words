                        "entry_id": "c7d24cf1-f017-3f21-8db1-644f0dcf79c0",
                        "glosses": [
                            "Tier, Pflanze oder Ähnliches, das als Nahrung für ein anderes Lebewesen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f1c8953-2388-46d6-8112-9426829caff9",
                                "sense_id": "46cd559a-97bf-37d8-9b81-f225c6ff2606",
                                "text": "„Offenbar lieferten die neuen Pflanzen den Säugern eine immer bessere Nahrungsquelle.“"
                            },
                            {
                                "example_id": "522f75d1-b9a1-435b-9b00-1dc8546578c2",
                                "sense_id": "46cd559a-97bf-37d8-9b81-f225c6ff2606",
                                "text": "„[…] als gute Nahrungsquellen für Bienen gelten die beiden Lavendelarten Lavandula angustifolia (Echter Lavendel) und Lavandula stoechas (Schopflavendel).“"
                            }
                        ],
