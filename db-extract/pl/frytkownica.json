                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c96321-43a9-4c16-a6d4-e37d4b8d18d9",
                                "sense_id": "b99534bb-37da-351a-b881-7ed70402009f",
                                "text": "Na obiad zjedliśmy frytki usmażone we frytkownicy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "561d5423-eb90-3a21-9ad9-edf149bc45a1",
