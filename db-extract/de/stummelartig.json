                ],
                "senses": [
                    {
                        "sense_id": "797ffd15-9ad3-33d4-8ef4-e3fd092650be",
                        "entry_id": "6a86ed37-2e10-3074-a45b-8bed8593a530",
                        "glosses": [
                            "einem Stummel ähnelnd, an einen Stummel erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643febad-bdbb-463f-b76a-c03be6e3f60a",
                                "sense_id": "797ffd15-9ad3-33d4-8ef4-e3fd092650be",
                                "text": "„Dieses Wesen hat die stummelartigen Hände erhoben, denen ein Fleischhaken entglitten ist, mit dem es anscheinend das am Boden liegende Schreibzeug des Evangelisten stehlen wollte.“"
                            },
                            {
                                "example_id": "85c7cc22-a613-4248-865a-847fce966f57",
                                "sense_id": "797ffd15-9ad3-33d4-8ef4-e3fd092650be",
                                "text": "„Seine Augen glommen unergründlich in ihren tiefen Höhlen; sein Mund öffnete sich und offenbarte eine Doppelreihe stummelartiger Zähne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
