                        ],
                        "examples": [
                            {
                                "example_id": "5e24ff6e-2537-458b-b490-634749d7e775",
                                "sense_id": "1db0e126-7ef1-363f-9559-79c0145d13ec",
                                "text": "[in the speech bubble of a bus driver in a cartoon depicting different modes of transport:] Be a Bussy person and save fuel"
                            },
                            {
                                "example_id": "5f9f852e-97e3-474b-b579-96d2b04c3ffc",
                                "sense_id": "1db0e126-7ef1-363f-9559-79c0145d13ec",
                                "text": "> >Sn!pe, you're weird. Ever heard the phrase 'he/she looks like the back-end\n> >of a bus'? I rest my case.\nOy! That were prolly put out by the train mob, innit? ¶ You leave the Snipe alone; a bussy person in a happy person. ¶ (daft as a brushy person, n'all, but a lot saner than a trainy person.)"
                            },
                            {
                                "example_id": "6acd7a1c-f8b1-45ce-a8cc-5f1186e061e6",
                                "sense_id": "1db0e126-7ef1-363f-9559-79c0145d13ec",
                                "text": "There you go! I'm picking up the same British feeling that I have that someone hi-jacked a good word for something not very mini, and more bussy than vanny."
                            }
                        ]
                    }
