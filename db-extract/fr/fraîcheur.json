        "fr-extract.jsonl": [
            {
                "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                "word": "fraîcheur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "96dfd338-d999-4057-aadb-7e375fee8227",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "tags": [
                            "plural"
                        ],
                        "form": "fraîcheurs"
                    },
                    {
                        "form_id": "490976cb-7ed6-4138-a758-757c214333d0",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "fraicheur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af1db580-797c-37ea-903b-4b6b396b7266",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "glosses": [
                            "Froid doux et modéré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15073bc4-6469-4b9c-bbf1-16f7f0b68ab9",
                                "sense_id": "af1db580-797c-37ea-903b-4b6b396b7266",
                                "text": "[…] ; je descendis à la lueur des flambeaux dans cette habitation de gnomes, enfoncée sous terre d'environ quatre vingt pieds ; mais l’humidité, la fraîcheur et la fumée des torches abrégèrent ma promenade."
                            },
                            {
                                "example_id": "71542287-f42a-4a16-9344-cf7d5e920321",
                                "sense_id": "af1db580-797c-37ea-903b-4b6b396b7266",
                                "text": "[…], mais ce lui était plaisir que de ne point manquer la sortie de l’étable fumante, dans la prime fraîcheur du matin."
                            },
                            {
                                "example_id": "3549df0c-3dec-49e2-a421-e96058195d91",
                                "sense_id": "af1db580-797c-37ea-903b-4b6b396b7266",
                                "text": "Il apparaît assez tardivement , comme la plupart des hygrophores, préférant la fraîcheur des pluies automnales aux chaleurs de la fin de l'été."
                            },
                            {
                                "example_id": "48ca8a6f-7d1d-4cec-b956-2e9df55da959",
                                "sense_id": "af1db580-797c-37ea-903b-4b6b396b7266",
                                "text": "La fraîcheur de l’eau, d’une boisson, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "20dffefe-5f4e-3859-9bb7-e61833e943eb",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "glosses": [
                            "Vent très faible qui suit ou qui précède le calme."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "bcb905c6-8b37-4f7c-b582-8d11934f6ef3",
                                "sense_id": "20dffefe-5f4e-3859-9bb7-e61833e943eb",
                                "text": "Il vient un peu de fraîcheur."
                            },
                            {
                                "example_id": "3cc6a194-41fd-4240-a4bd-713086c7b4ae",
                                "sense_id": "20dffefe-5f4e-3859-9bb7-e61833e943eb",
                                "text": "La brise est finie, il n’y a plus qu’une légère fraîcheur."
                            }
                        ]
                    },
                    {
                        "sense_id": "33e8ad50-04e7-31dc-95f4-1993415768b2",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "glosses": [
                            "Froidure ; froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c73d202f-15e1-4ed9-8336-53ca2ca18632",
                                "sense_id": "33e8ad50-04e7-31dc-95f4-1993415768b2",
                                "text": "La fraîcheur du soir est perfide dans cette saison."
                            },
                            {
                                "example_id": "4a77d15a-e65a-40be-aa67-3bd3114b7d1c",
                                "sense_id": "33e8ad50-04e7-31dc-95f4-1993415768b2",
                                "text": "Il fait quelquefois des fraîcheurs qui nuisent à la vigne."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c8d34c7-5b9e-3911-9fea-025e6a59d7d4",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "glosses": [
                            "Douleur musculaire causée par un froid humide."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5b1395f9-f1b9-452e-98b8-f663778c2243",
                                "sense_id": "3c8d34c7-5b9e-3911-9fea-025e6a59d7d4",
                                "text": "Gagner, avoir une fraîcheur."
                            },
                            {
                                "example_id": "8f54e0d9-ab73-47ff-ad39-eb1f8bfb6205",
                                "sense_id": "3c8d34c7-5b9e-3911-9fea-025e6a59d7d4",
                                "text": "Cela cause des fraîcheurs."
                            },
                            {
                                "example_id": "ead061d9-10f7-4ad7-ac99-c9ff1f6a16b7",
                                "sense_id": "3c8d34c7-5b9e-3911-9fea-025e6a59d7d4",
                                "text": "Ce n’est point un rhumatisme, ce n’est qu’une fraîcheur."
                            }
                        ]
                    },
                    {
                        "sense_id": "b82be1b6-5aa3-3858-bddd-1da5da220f13",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "glosses": [
                            "Lustre ; brillant ; éclat agréable des fleurs, du teint, des couleurs, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "82c2380e-92b5-4a5d-a57d-5bf911bc9cb5",
                                "sense_id": "b82be1b6-5aa3-3858-bddd-1da5da220f13",
                                "text": "C’était à cette époque une femme de cinquante-deux à cinquante-trois ans à peu près, qui conservait, grâce à son embonpoint plein de fraîcheur, les traits de sa première beauté."
                            },
                            {
                                "example_id": "f4caf4a6-c553-471d-845d-625a21f05aa8",
                                "sense_id": "b82be1b6-5aa3-3858-bddd-1da5da220f13",
                                "text": "On sait assez que chez l’homme l’habitude tue le désir. Maman avait perdu sa première fraîcheur et lui sa fougue. Pour la réveiller, il recourait aux professionnelles du café de Versailles ou aux pensionnaires du Sphinx."
                            },
                            {
                                "example_id": "dda3bedf-881e-4475-b87c-859353eb7bf7",
                                "sense_id": "b82be1b6-5aa3-3858-bddd-1da5da220f13",
                                "text": "Parfois, on rencontre une fille dont le teint noisette et les yeux de baies sauvages sont séduisants, mais leurs traits sont rarement beaux, et elles enlaidissent vite, dès que la première fraîcheur de la jeunesse est passée..."
                            },
                            {
                                "example_id": "0283e970-810a-44e7-9bd6-640831f8bf37",
                                "sense_id": "b82be1b6-5aa3-3858-bddd-1da5da220f13",
                                "text": "La fraîcheur du coloris, dans un tableau."
                            },
                            {
                                "example_id": "c429d649-ee69-499b-8ade-12c3d6995f00",
                                "sense_id": "b82be1b6-5aa3-3858-bddd-1da5da220f13",
                                "text": "Ces peintures ont conservé toute leur fraîcheur."
                            }
                        ]
                    },
                    {
                        "sense_id": "38e9ea59-5911-3c0a-9b43-c917647dbecf",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "glosses": [
                            "absence d'altération ; conservation du premier état d'une chose."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "de361001-bcaf-4ec5-aea6-ce83cd00e00a",
                                "sense_id": "38e9ea59-5911-3c0a-9b43-c917647dbecf",
                                "text": "Je m'explique: nos usines cédulent le départ et l'arrivée des bateaux, leur fournissant la quantité de glace nécessaire pour qu'ils rapportent le poisson dans le meilleur état de fraîcheur possible."
                            },
                            {
                                "example_id": "6791fd02-2227-4592-aa36-2b35d7ed38e2",
                                "sense_id": "38e9ea59-5911-3c0a-9b43-c917647dbecf",
                                "text": "La fraîcheur d’un costume. — L’ameublement a conservé toute sa fraîcheur."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a35f194-ecb9-31a5-8f05-08ff5b3137d7",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "glosses": [
                            "Caractère de grâce naturelle dans les conceptions de l’esprit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6b20d830-8c4b-41e1-badf-ed237cfdca95",
                                "sense_id": "9a35f194-ecb9-31a5-8f05-08ff5b3137d7",
                                "text": "La fraîcheur des pensées, de l’imagination, du style."
                            }
                        ]
                    },
                    {
                        "sense_id": "8056505e-61b9-345d-9eb1-e1978a206519",
                        "entry_id": "1948c51f-7fa7-3f62-b899-9835ba29a61a",
                        "glosses": [
                            "Beauté (femme)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "49569a9b-df21-4fd9-a734-d2828f8857e7",
                                "sense_id": "8056505e-61b9-345d-9eb1-e1978a206519",
                                "text": "Le proxénète devait probablement à certaines de ses anciennes gagneuses, évincées par l’arrivée de fraîcheurs slaves, d’avoir balancé sa planque."
                            }
                        ]
                    }
                ],
