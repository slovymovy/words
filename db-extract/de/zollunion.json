                        "glosses": [
                            "Zusammenschluss von Staaten, die ein gemeinsames Zollgebiet bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c36401ec-a9dd-43bc-bea1-4749cb56ea7a",
                                "sense_id": "b6c5af52-7c0f-3e58-8520-551f4329e066",
                                "text": "„Seit Wochen streitet das Kabinett von Premierministerin Theresa May über das künftige Verhältnis zur europäischen Zollunion. […] Mitglieder einer Zollunion vereinbaren gemeinsame Zölle an ihren Außengrenzen, an den Binnengrenzen werden keine Abgaben erhoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
