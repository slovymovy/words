                        "source_sense_id": "9726301b-e806-371e-8e81-9dd6475c9f89",
                        "target_lang_word": "ironisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ironisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb9587c-00d4-3fda-a170-e88ee8dbeffd",
                                        "entry_id": "8f0f4d9d-0db5-3af0-8b32-e68f647a29e0",
                                        "glosses": [
                                            "ironisch behandeln, mit Ironie behandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619b47ce-7173-4c5f-900d-7087cbbb4ca7",
                                                "sense_id": "2eb9587c-00d4-3fda-a170-e88ee8dbeffd",
                                                "text": "„Er hat eine muntere Art, sich selbst erfrischend zu ironisieren, ein blonder junger Mann von nun 40 Jahren, nicht groß, aber kräftig gebaut wie ein Leichtathlet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60884880-195d-45fe-96e5-a199cf027653",
                        "source_entry_id": "f7362313-2f1c-3c71-aaca-c17445917764",
                        "source_sense_id": "9726301b-e806-371e-8e81-9dd6475c9f89",
                        "target_lang_word": "ironiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ironiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60f6cfba-d8b8-3747-8bbc-ea2e54b01027",
                                        "entry_id": "116b15a3-ba45-3b2b-a9fc-6ccee1699e6c",
                                        "glosses": [
                                            "Prendre le ton de l’ironie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4886460-356b-47e2-8ed2-d15bfb8c239e",
                                                "sense_id": "60f6cfba-d8b8-3747-8bbc-ea2e54b01027",
                                                "text": "Les collaborateurs de La Gazette médicale ont beau jeu d’ironiser sur les signes qui désignent aussitôt ces choléraphobiques : […]."
                                            },
                                            {
                                                "example_id": "3bffcc62-761d-4fcc-8cdf-bf9a7aa55551",
                                                "sense_id": "60f6cfba-d8b8-3747-8bbc-ea2e54b01027",
                                                "text": "— Pedigree de Marcel Proute, je te prie. Du moins ce que tu en sais.\n— A l'origine, il était horloger, attaque Ambroise.\n— A la recherche du temps perdu, ironisé-je pour moi seul, mais j'ai la surprise de le voir sourire."
                                            },
                                            {
                                                "example_id": "8285e5e6-327c-4df3-a697-d26ef0d21944",
                                                "sense_id": "60f6cfba-d8b8-3747-8bbc-ea2e54b01027",
                                                "text": "Ceux qui utilisent ChatGPT partent souvent dans des envolées lyriques en adoptant des formulations de professeurs de mathématiques. Ils se prennent pour Baudelaire, ironise-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf3d256-143a-3adb-a098-fe6ece562570",
                                        "entry_id": "116b15a3-ba45-3b2b-a9fc-6ccee1699e6c",
                                        "glosses": [
                                            "Tourner en dérision quelque chose ou quelqu'un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b815f156-e6ef-4f71-b9bb-da58472fbb05",
                                                "sense_id": "3cf3d256-143a-3adb-a098-fe6ece562570",
                                                "text": "Ironiser le lucre au théâtre, c'est blasphémer Dieu dans une église."
                                            },
                                            {
                                                "example_id": "51349ecd-0557-4d77-89ae-bce319e7f767",
                                                "sense_id": "3cf3d256-143a-3adb-a098-fe6ece562570",
                                                "text": "Tu m’ironises par ton indolence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
