                "senses": [
                    {
                        "sense_id": "5ba55aee-fba6-30fd-bd91-b73ae7d14d0b",
                        "entry_id": "87751cb2-e2da-3694-a62b-18241b1cf5e5",
                        "glosses": [
                            "(künstliche) Gesichtsbedeckung, welche die Form des vordersten Körperteils eines Säugetiers mit kurzen Beinen, verlängerter rüsselartiger Schnauze und Borsten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a3af07f-6388-492b-993b-4e1ba68026e7",
                                "sense_id": "5ba55aee-fba6-30fd-bd91-b73ae7d14d0b",
                                "text": "Auf Halloweenpartys kann man hin und wieder Menschen mit Schweinekopfmasken beobachten."
                            },
                            {
                                "example_id": "1c0b2c77-60d5-4adf-9174-aa73557d4211",
                                "sense_id": "5ba55aee-fba6-30fd-bd91-b73ae7d14d0b",
                                "text": "„[…], und ein Stammgast, der sich für ein Schwein hält, ist nie ohne Schweinekopfmaske überm Federkleid anzutreffen.“"
                            },
                            {
                                "example_id": "af88925e-935e-400e-8859-808ac484c9f8",
                                "sense_id": "5ba55aee-fba6-30fd-bd91-b73ae7d14d0b",
                                "text": "„Ich kam und schnitzte eine Schweinekopfmaske.“"
                            },
                            {
                                "example_id": "42240292-3d9c-4818-b2e2-72b388a477f9",
                                "sense_id": "5ba55aee-fba6-30fd-bd91-b73ae7d14d0b",
                                "text": "„Spezialmasken wie die Schweinekopfmaske mit gebogenen Hauern, die Maske des blauen Fischs vom Korallenriff, […]“"
                            },
                            {
                                "example_id": "e1f64697-172f-4f87-93bc-c39ed7bcc297",
                                "sense_id": "5ba55aee-fba6-30fd-bd91-b73ae7d14d0b",
                                "text": "„Den Täter habe er nicht erkannt, der habe eine Schweinekopfmaske getragen.“"
                            },
                            {
                                "example_id": "6d9cb0b6-fd6f-42d2-af0d-f1034ef0e4d2",
                                "sense_id": "5ba55aee-fba6-30fd-bd91-b73ae7d14d0b",
                                "text": "„Hinten steht ein Mann mit Schweinekopfmaske, davor sitzt ein anderer im Smoking, an der Rampe links eine Tänzerin im Tutu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
