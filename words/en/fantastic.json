    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13935912-4cec-344c-ad69-fc0b6dbc363f",
                    "sense_definition": "Extremely good, wonderful, or impressive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>fantastic</w> time at the beach last weekend.",
                            "target_lang_translations": {
                                "ru": "Мы <w>чудесно</w> провели время на пляже в прошлые выходные."
                            }
                        },
                        {
                            "text": "The food at that new restaurant is <w>fantastic</w> and very affordable.",
                            "target_lang_translations": {
                                "ru": "Еда в том новом ресторане <w>превосходная</w> и очень доступная по цене."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonderful",
                        "excellent",
                        "great",
                        "superb",
                        "terrific",
                        "marvelous"
                    ],
                    "common_phrases": [
                        "fantastic news",
                        "fantastic job",
                        "fantastic opportunity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хороший, замечательный или впечатляющий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фантастический",
                                "target_lang_sense_clarification": "в значении превосходный"
                            },
                            {
                                "target_lang_word": "чудесный",
                                "target_lang_sense_clarification": "очень хороший"
                            },
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "впечатляющий"
                            },
                            {
                                "target_lang_word": "превосходный",
                                "target_lang_sense_clarification": "высшего качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                    "sense_definition": "Based on or existing only in fantasy; not real or practical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imaginary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author created a <w>fantastic</w> world filled with dragons and magic.",
                            "target_lang_translations": {
                                "ru": "Автор создал <w>фантастический</w> мир, наполненный драконами и магией."
                            }
                        },
                        {
                            "text": "His <w>fantastic</w> plans for a moon colony were never taken seriously by the government.",
                            "target_lang_translations": {
                                "ru": "Его <w>фантастические</w> планы по созданию колонии на Луне никогда не воспринимались правительством всерьез."
                            }
                        }
                    ],
                    "synonyms": [
                        "fanciful",
                        "imaginary",
                        "unreal",
                        "wild"
                    ],
                    "antonyms": [
                        "realistic"
                    ],
                    "common_phrases": [
                        "fantastic creatures",
                        "fantastic stories"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на фантазии или существующий только в воображении; нереальный или непрактичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фантастический",
                                "target_lang_sense_clarification": "вымышленный"
