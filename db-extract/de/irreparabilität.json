                "senses": [
                    {
                        "sense_id": "b93c4cc9-c37c-3822-8c54-d1f7469283d6",
                        "entry_id": "c6760cfa-b247-31a7-b571-bb43a6ecbd99",
                        "glosses": [
                            "Umstand, das etwas nicht mehr in einen funktionstüchtigen, funktionierenden Zustand versetzt (repariert) werden kann, nicht mehr rückgängig/ungeschehen gemacht werden kann"
                        ],
                        "tags": [
                            "oder auch"
                        ],
                        "examples": [
                            {
                                "example_id": "c4afbd6b-f7e3-4129-9fc0-5cb0ad6facd8",
                                "sense_id": "b93c4cc9-c37c-3822-8c54-d1f7469283d6",
                                "text": "„Verhindern kann man den Krankheitsbeginn wohl nicht; es sollte aber möglich sein, durch entgegenwirkende Therapie frühzeitig in die Entwicklungskette einzugreifen, um den Schaden zu begrenzen, d. h. nicht erst in den Status der Irreparabilität gelangen zu lassen.“"
                            },
                            {
                                "example_id": "52628300-4faf-4382-aee0-9ca3b855238b",
                                "sense_id": "b93c4cc9-c37c-3822-8c54-d1f7469283d6",
                                "text": "„Die faktische, tatsächliche Irreparabilität finden wir überall dort, wo eine unterlassene Handlung nicht nachgeholt (z.B. die unrichtige Ankündigung einer Wahl) oder wo eine fehlerhafte Handlung nicht ungeschehen gemacht werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
