                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "прямой, не тайный"
                            },
                            {
                                "target_lang_word": "неприкрытый",
                                "target_lang_sense_clarification": "откровенный, демонстративный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56262be5-e099-368b-af5a-fa6ff5de558f",
                    "sense_definition": "Spread out or opened, especially said of a bird's wings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms depicted a golden falcon with wings <w>overt</w> against a blue background.",
