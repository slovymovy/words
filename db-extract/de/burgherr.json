                "senses": [
                    {
                        "sense_id": "c1c8bf51-1802-3532-bb5a-ce7f7c90bed4",
                        "entry_id": "b1063b50-8512-3cfa-9b4e-89ec0d157206",
                        "glosses": [
                            "jemand, der die Verfügungsgewalt über eine Burg hat"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "06682fe9-e434-4ac2-8be5-7ce069780e4d",
                                "sense_id": "c1c8bf51-1802-3532-bb5a-ce7f7c90bed4",
                                "text": "„Burgherr Erich Podstatny hat den historischen Übergang zerlegen lassen und mit den Teilen stufenweise das hügelige Gelände rund um das Anwesen in Plankenstein erschlossen; Aussichtsplattform mit Blick ins Alpenvorland inklusive.“"
                            },
                            {
                                "example_id": "d34f09c9-d998-4f11-882b-0bf242d86ed1",
                                "sense_id": "c1c8bf51-1802-3532-bb5a-ce7f7c90bed4",
                                "text": "„Denn der Burgherr hatte ihn ausdrücklich mit Vollmachten ausgestattet.“"
                            },
                            {
                                "example_id": "e9f47ff5-2839-4c0d-bc0a-e9d81e968bd2",
                                "sense_id": "c1c8bf51-1802-3532-bb5a-ce7f7c90bed4",
                                "text": "„War der Burgherr in Fehde und hatte gerade Waffenknechte angeheuert, wurde auf den Wehrgängen ›patrouilliert‹.“"
                            },
                            {
                                "example_id": "7b331408-1bd3-4333-9580-c8ed8250dcef",
                                "sense_id": "c1c8bf51-1802-3532-bb5a-ce7f7c90bed4",
                                "text": "„Stets kommt ein philosophischer Bettler vor, ein griesgrämiger Burgherr, unschuldige junge Mädchen, komische Diener und endlose Dialoge, eine dumme Prüderie und völliger Mangel an Tiefe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
