                    {
                        "sense_id": "6f9dc451-bc2f-3d1e-b4cc-87bb936ab9f9",
                        "entry_id": "287b0a3e-6a65-3666-addd-fa25d06eb0e2",
                        "glosses": [
                            "Kind, das (insbesondere den Eltern) viele Sorgen bereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd830afc-9124-4a9c-8ab0-a749354487ae",
                                "sense_id": "6f9dc451-bc2f-3d1e-b4cc-87bb936ab9f9",
                                "text": "Paul war immer ein bisschen ihr Sorgenkind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8f38c4cd-eb02-3485-b54b-d2506d81951a",
                        "entry_id": "287b0a3e-6a65-3666-addd-fa25d06eb0e2",
                        "glosses": [
                            "Geschöpf, Werk, Gegenstand, der oder das Sorgen macht"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "81a81c68-b0d5-4435-8175-ee6dd9306a14",
                                "sense_id": "8f38c4cd-eb02-3485-b54b-d2506d81951a",
                                "text": "„LSD – mein Sorgenkind“ ist der Titel von Albert Hofmanns berühmtestem Buch."
                            }
