                        "sense_id": "99b07675-0b37-3216-a925-943fd26192b0",
                        "entry_id": "637c2793-3574-3686-af62-f4a2ea3da192",
                        "glosses": [
                            "Déprécier (quelque chose qui nous appartient en propre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38ce358f-e87b-450a-9f51-e53e46c40fc7",
                                "sense_id": "99b07675-0b37-3216-a925-943fd26192b0",
                                "text": "Plusieurs facteurs peuvent pousser le locuteur à autodéprécier sa langue, à avoir une image négative de sa façon de parler, plus négative en fait que la réalité, bref à souffrir d'insécurité linguistique."
                            },
                            {
                                "example_id": "87de62e8-d08b-4885-96c7-6c7c7125edf2",
                                "sense_id": "99b07675-0b37-3216-a925-943fd26192b0",
                                "text": "En effet, le problème chez Senghor, c'est cette capacité à s’autodéprécier et à déprécier le Noir."
                            }
                        ]
                    }
