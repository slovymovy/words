                    {
                        "sense_id": "3d1f21ce-9b4d-3060-8fc1-94a52ee6b493",
                        "entry_id": "e91f13aa-3ec6-3fad-818a-5c9233cf6b0a",
                        "glosses": [
                            "Person, die beruflich Fässer und andere Holzgefäße herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea59740e-1267-4061-bd4f-feccb304bec0",
                                "sense_id": "3d1f21ce-9b4d-3060-8fc1-94a52ee6b493",
                                "text": "Der Fassbinder verfertiget zur Bequemlichkeit einer Haushaltung und zum Bedürfnisse der Handelschaft allerley hölzerne Gefäße, welche aus Dauben zusammengesetzt, und mit Reifen auswendig befestiget werden, […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e70e1cf-1684-4470-9ff5-1fc2a3d7c774",
                        "source_entry_id": "e91f13aa-3ec6-3fad-818a-5c9233cf6b0a",
                        "source_sense_id": "3d1f21ce-9b4d-3060-8fc1-94a52ee6b493",
                        "source_sense_description": "Weinbau: Person, die beruflich Fässer und andere Holzgefäße herstellt",
                        "target_lang_word": "cooper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cooper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45cedada-b90c-32c0-9c9e-f354cb5049eb",
                                        "entry_id": "07b4756f-303c-34e1-819e-417a7fd496d7",
                                        "glosses": [
                                            "A craftsman who makes and repairs barrels and similar wooden vessels such as casks, buckets and tubs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982a7bd8-33fd-4886-95ef-29a9405b6639",
                                                "sense_id": "45cedada-b90c-32c0-9c9e-f354cb5049eb",
                                                "text": "They were nearly all whalemen; chief mates, and second mates, and third mates, and sea carpenters, and sea coopers, and sea blacksmiths, and harpooneers, and ship keepers; a brown and brawny company, with bosky beards; an unshorn, shaggy set, all wearing monkey jackets for morning gowns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce3f1d7b-70e2-349d-8d66-97a137787940",
                                        "entry_id": "07b4756f-303c-34e1-819e-417a7fd496d7",
                                        "glosses": [
                                            "A drink of half stout and half porter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cooper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b9961f3-7313-3de3-a7c1-8459b00bedac",
                                        "entry_id": "f924bde7-24f6-3d3d-985d-424a65e07471",
                                        "glosses": [
                                            "To make and repair barrels etc."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6019b5c3-8e46-34c2-823d-129940e8f126",
                                        "entry_id": "f924bde7-24f6-3d3d-985d-424a65e07471",
                                        "glosses": [
                                            "To forge or imitate (writing)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b509cf77-0c2c-4bf6-b8f3-fbeaf99adc10",
                                                "sense_id": "6019b5c3-8e46-34c2-823d-129940e8f126",
                                                "text": "[…] though, owing to his forged signatures having been too often detected, he was declared to be \"a duffer at coopering a monekur.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b368a8ac-dbbb-300b-9543-1c051534e1a5",
                                        "entry_id": "f924bde7-24f6-3d3d-985d-424a65e07471",
                                        "glosses": [
                                            "To intentionally injure (a racehorse) to spoil its chances of winning."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e41133c2-de83-4560-8650-d74070e791b4",
                                                "sense_id": "b368a8ac-dbbb-300b-9543-1c051534e1a5",
                                                "text": "Every design that villainy could suggest was had recourse to in the hopes of nobbling Wild Dayrell; but never being left for an hour by either his trainer or jockey, he escaped the intended 'coopering', even when the lynchpins of the wheels of his van had been tampered with."
                                            }
                                        ]
                                    }
                                ]
                            },
