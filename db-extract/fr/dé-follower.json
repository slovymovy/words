                ],
                "senses": [
                    {
                        "sense_id": "a517007b-5ecb-3bb6-bf9a-4c4fc0e2b15e",
                        "entry_id": "b8ba6130-09e7-3da2-8ffd-f1639a98bbd4",
                        "glosses": [
                            "Arrêter de suivre sur Twitter (ou un autre réseau social)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f323426-6b22-4538-bdcb-588f60453471",
                                "sense_id": "a517007b-5ecb-3bb6-bf9a-4c4fc0e2b15e",
                                "text": "Vous allez vous faire dé-follower massivement."
                            },
                            {
                                "example_id": "faedf851-d679-4f76-a633-46fc7850cd4f",
                                "sense_id": "a517007b-5ecb-3bb6-bf9a-4c4fc0e2b15e",
                                "text": "Mais je conserverai mon franc-parler. Quitte à me dé-follower moi-même si je ne me supporte plus mes écarts de langage."
                            },
                            {
                                "example_id": "f0c3e9f2-78ab-4f22-8613-b4201e0b35b4",
                                "sense_id": "a517007b-5ecb-3bb6-bf9a-4c4fc0e2b15e",
                                "text": "Alors que sur Facebook nos yeux en saignent, sur Twitter, il suffit d’un clic pour vous dé-follower, et les gens ne s’en priveront pas s’ils sont obligés de déchiffrer vos tweets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9238e5b-0f10-4006-80dd-77c5c764ce08",
                        "source_entry_id": "b8ba6130-09e7-3da2-8ffd-f1639a98bbd4",
                        "source_sense_id": "a517007b-5ecb-3bb6-bf9a-4c4fc0e2b15e",
                        "target_lang_word": "unfollow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfollow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bed2eb5-45ed-3461-8e38-31e01f253d2e",
                                        "entry_id": "a6818005-b2be-3653-a2e7-1d27aa073822",
                                        "glosses": [
                                            "To cease to subscribe to (a feed of another user's activity)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dd305c9-2c9f-4bc4-8c29-aa473a3095c4",
                                                "sense_id": "9bed2eb5-45ed-3461-8e38-31e01f253d2e",
                                                "text": "With Twitter, it’s as easy to unfollow as it is to follow."
                                            },
                                            {
                                                "example_id": "fcb8dd0c-3ab4-4120-9101-4065aa43ac10",
                                                "sense_id": "9bed2eb5-45ed-3461-8e38-31e01f253d2e",
                                                "text": "The calls came from Iranian intelligence as soon as the protests began. Agents threatened the family and friends of a DW editor, telling them to cut off contact with him and to unfollow him on Instagram. The journalist was said to be a \"muharebbe\" (Engl. warrior against God) – which is punishable by death in Iran."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
