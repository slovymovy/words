                        "glosses": [
                            "Qualité de ce qui est typique, caractéristique de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b96b6a6a-0c7f-43bd-9514-1242c1976288",
                                "sense_id": "abcf5980-0009-35a3-8ce3-9b49d7681972",
                                "text": "Dans le domaine de la sous-traitance de construction, cette définition ne rend pas compte de la « typicité » des contrats conclus par le constructeur titulaire du marché et par le constructeur sous-traitant, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ad236b3-60c2-37ca-a730-8dd770dcdb83",
                        "entry_id": "09502796-c29e-3e8b-b976-e1ada89154f1",
                        "glosses": [
                            ", Ensemble des caractéristiques d’un aliment, d’une boisson, et en particulier d'un vin, provenant d'un terroir particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5301940e-b919-43a4-9ca0-2aab0162a2cb",
                                "sense_id": "7ad236b3-60c2-37ca-a730-8dd770dcdb83",
                                "text": "La typicité est directement déterminée par le terroir, elle est conférée par le terroir."
                            }
                        ]
                    }
