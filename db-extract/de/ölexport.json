                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94fc0149-ae9c-40a6-801d-d44777da1b48",
                                "sense_id": "64c5c948-3394-3654-b0a6-bff9228b614e",
                                "text": "„Aufgrund des Ölembargos infolge des Jom-Kippur-Krieges 1973 erhöhten sich die Einnahmen aus den Ölexporten nochmals rasant, sodass weitere ausländische Arbeitskräfte benötigt wurden, um die massiven Investionsprogramme des Staates zu realisieren.“"
                            },
                            {
                                "example_id": "27e668b6-5ab4-47bf-b5ab-53364903a557",
                                "sense_id": "64c5c948-3394-3654-b0a6-bff9228b614e",
                                "text": "„Die nigerianische Elite bereicherte sich an den Einnahmen aus den Ölexporten, die bald höher waren als die inländischen Steuereinnahmen, und führte ein Leben in Saus und Braus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
