        "fr-extract.jsonl": [
            {
                "entry_id": "0f835d11-f052-3615-8086-f320f0c09d99",
                "word": "inépuisable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "abf591d8-c088-4cf5-9f1a-60c06b03e957",
                        "entry_id": "0f835d11-f052-3615-8086-f320f0c09d99",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inépuisables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2281f95c-3f60-36da-9adc-26dcab8cebd6",
                        "entry_id": "0f835d11-f052-3615-8086-f320f0c09d99",
                        "glosses": [
                            "Qu’on ne peut épuiser, tarir ou mettre à sec."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "d31c06a4-53f1-4e06-b12f-9faa126c90ea",
                                "sense_id": "2281f95c-3f60-36da-9adc-26dcab8cebd6",
                                "text": "Les Monts du Lyonnais et du Beaujolais, qui abritaient depuis un temps immémorial le tissage domestique des toiles, furent pour la métropole de la soie une réserve inépuisable d'ouvriers héréditairement façonnés à l'austère existence du tisseur."
                            },
                            {
                                "example_id": "9c12b911-1556-4023-9ada-549d6cf5889a",
                                "sense_id": "2281f95c-3f60-36da-9adc-26dcab8cebd6",
                                "text": "On voit donc que la question est maintenant résolue du point de vue technique et économique. Les océans peuvent devenir une source inépuisable d'eau douce et ce qui paraissait une utopie il y a 25 ans devient une réalité nécessaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "495a532d-ac2c-33cc-8f5b-ef0c162d2436",
                        "entry_id": "0f835d11-f052-3615-8086-f320f0c09d99",
                        "glosses": [
                            "Intarissable, qui n’a pas de fin ou dont les ressources abstraites sont infinies."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e1e6f3fb-c253-4ab7-9bbc-5bc28f922b02",
                                "sense_id": "495a532d-ac2c-33cc-8f5b-ef0c162d2436",
                                "text": "Depuis quelques temps, je ne saurais dire au juste, elle est là plus que jamais, parmi surtout la petite et moi, elle est là avec une assiduité vivace, dans une inépuisable bonté, elle me dessine mes gestes et mes regards, mes paroles et mes chants, elle est là penchée sur les cahiers et les bols, elle est là pour les cheveux et les dents, intarissable, précise, si étonnamment précise, elle est là à me la rendre enfin, dans la force des appartenances premières."
                            },
                            {
                                "example_id": "778d21e7-97ed-434a-b028-af36ab3804ac",
                                "sense_id": "495a532d-ac2c-33cc-8f5b-ef0c162d2436",
                                "text": "L’inépuisable joie émane de la Vie ;\nL’embrassement profond de la terre et du ciel\nEmplit d’un même amour le cœur universel ;\nEt la Femme, à jamais vénérée et ravie,\nMultiplie en un long baiser l’Homme immortel."
                            },
                            {
                                "example_id": "a40d9f0f-8f4e-4f19-a73c-122b58c64fec",
                                "sense_id": "495a532d-ac2c-33cc-8f5b-ef0c162d2436",
                                "text": "Cet homme a un fonds de science inépuisable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "329175c7-fab0-418f-a336-81857804d685",
                        "source_entry_id": "0f835d11-f052-3615-8086-f320f0c09d99",
                        "target_lang_word": "inexhaustible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexhaustible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2f4dff-3d7d-35a9-bf44-51a449588696",
                                        "entry_id": "c01126b9-acf1-31ab-b203-575359592fca",
                                        "glosses": [
                                            "Impossible to exhaust; unlimited."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1b95d8-8083-4d06-ae28-07c964f21986",
                                                "sense_id": "6f2f4dff-3d7d-35a9-bf44-51a449588696",
                                                "text": "Henriette and Marie de Mancini, his former inexhaustible themes, seemed to have entirely escaped his memory."
                                            },
                                            {
                                                "example_id": "f1182e22-32da-4120-92c5-5c455d6707b0",
                                                "sense_id": "6f2f4dff-3d7d-35a9-bf44-51a449588696",
                                                "text": "[I]t would not be very much less absurd for someone to write about New York City after having spent only a few years or a few decades in this metropolis of inexhaustible adventure, of terrifying emotional fecundity, of uncapturable character."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f5a1fa6-b61f-4660-a6be-c2c61fdcf60b",
                        "source_entry_id": "0f835d11-f052-3615-8086-f320f0c09d99",
                        "target_lang_word": "indefatigable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indefatigable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61b56277-9009-3c3d-bdb3-1480b85f2710",
                                        "entry_id": "82b2b25e-3877-3d31-9294-69fca7b92924",
                                        "glosses": [
                                            "Extremely persistent and untiring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31ee11ad-14b7-4129-915a-b682940d2d8b",
                                                "sense_id": "61b56277-9009-3c3d-bdb3-1480b85f2710",
                                                "text": "[...] But he was at the ſame Time an excellent Scholar, and moſt indefatigable in teaching the two Lads."
                                            },
                                            {
                                                "example_id": "ad85fd53-c6f0-43df-b6a6-c7e0398d9450",
                                                "sense_id": "61b56277-9009-3c3d-bdb3-1480b85f2710",
                                                "text": "He was respected by all who knew him for his integrity and indefatigable attention to public business."
                                            },
                                            {
                                                "example_id": "40a502d9-317e-45a8-b39e-da47d4547f46",
                                                "sense_id": "61b56277-9009-3c3d-bdb3-1480b85f2710",
                                                "text": "All night long the Martians were hammering and stirring, sleepless, indefatigable, at work upon the machines they were making ready, and ever and again a puff of greenish-white smoke whirled up to the starlit sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
