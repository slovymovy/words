                            },
                            {
                                "target_word": "panthéiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a32d305-f935-3ec9-a7ab-7dd7645f8205",
                                        "entry_id": "b67cfdbe-cca5-3aac-9d08-09c40a66a974",
                                        "glosses": [
                                            "Personne qui adhère au panthéisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a4b0a9-abc2-4490-9c6e-e31eae700c00",
                                                "sense_id": "0a32d305-f935-3ec9-a7ab-7dd7645f8205",
                                                "text": "Schelling s'approche beaucoup, on ne saurait le nier, des philosophes appelés panthéistes, c'est à dire de ceux qui accordent à la nature des attributs de la divinité"
                                            },
                                            {
                                                "example_id": "b61a35a7-9d98-4fb3-b346-acb9bf341738",
                                                "sense_id": "0a32d305-f935-3ec9-a7ab-7dd7645f8205",
                                                "text": "La philosophie de Scot Érigène fut mal accueillie. La nouveauté et l'incertitude de sa terminologie néo-platonicienne le firent prendre pour un panthéiste."
                                            },
                                            {
                                                "example_id": "2b04c26c-de5b-4ce3-9d67-e50453633219",
                                                "sense_id": "0a32d305-f935-3ec9-a7ab-7dd7645f8205",
                                                "text": "Réflexion que fait près de moi mon ami Plumkett : « On se sent devenir panthéiste en contemplant de pareilles choses. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
