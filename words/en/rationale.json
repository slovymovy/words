                    "sense_definition": "A liturgical vestment worn by some Christian bishops of various denominations.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local bishop was seen wearing the <w>rationale</w> during the special anniversary mass.",
                            "target_lang_translations": {
