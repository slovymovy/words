                "senses": [
                    {
                        "sense_id": "8335190e-31b5-3499-bfb3-ad87f827a110",
                        "entry_id": "c8ec232a-2265-319b-a4ed-d2849a364463",
                        "glosses": [
                            "ein kleinformatiges Buch mit gewöhnlich weichem Einband"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d81e88cd-bf14-4a25-939a-10bf87ea1761",
                                "sense_id": "8335190e-31b5-3499-bfb3-ad87f827a110",
                                "text": "Taschenbücher sind meistens etwas preisgünstiger als andere Bücher."
                            },
                            {
                                "example_id": "1d38fe18-645f-4fdc-bbb5-166205da8b24",
                                "sense_id": "8335190e-31b5-3499-bfb3-ad87f827a110",
                                "text": "„Er gab sich damit zufrieden, gelegentlich in Kaufhäusern auf Wühltischen Taschenbücher und Schallplatten im Sonderangebot bis zu fünf Mark zu erstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
