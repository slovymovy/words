                ],
                "translations": [
                    {
                        "translation_id": "c79d61e0-b427-42b8-b1cc-95dc64bf5117",
                        "source_entry_id": "485dfaf0-7a45-37a5-8866-988db83b4f91",
                        "target_lang_word": "gelatinous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelatinous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bbe54f2-5fd6-3a9f-81f0-aff3e1bd366a",
                                        "entry_id": "5ca2c05e-607c-39af-a362-76a44d0cc1be",
                                        "glosses": [
                                            "Jelly-like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f724b18-59ab-4753-86d7-13cca87952b2",
                                                "sense_id": "6bbe54f2-5fd6-3a9f-81f0-aff3e1bd366a",
                                                "text": "In certain star-fishes, small depressions in the layer of pigment which surrounds the nerve are filled, as described by the author just quoted, with transparent gelatinous matter, and this projects outwardly with a convex surface, like the cornea in the higher animals."
                                            },
                                            {
                                                "example_id": "0a3511eb-af41-4cf1-a980-80a5760899ff",
                                                "sense_id": "6bbe54f2-5fd6-3a9f-81f0-aff3e1bd366a",
                                                "text": "Everyone listened, and everyone was listening still when It lumbered slobberingly into sight and gropingly squeezed Its gelatinous green immensity through the black doorway into the tainted outside air of that poison city of madness."
                                            },
                                            {
                                                "example_id": "a7286c05-a56f-43da-997a-ffbed02957a9",
                                                "sense_id": "6bbe54f2-5fd6-3a9f-81f0-aff3e1bd366a",
                                                "text": "Winston was gelatinous with fatigue. Gelatinous was the right word. It had come into his head spontaneously. His body seemed to have not only the weakness of a jelly, but its translucency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3346dee6-ad30-3108-8538-632eabde5f7e",
                                        "entry_id": "5ca2c05e-607c-39af-a362-76a44d0cc1be",
                                        "glosses": [
                                            "Of or referring to gelatin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
