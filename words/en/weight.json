{
    "word_family": [
        "weighty",
        "weightless",
        "overweight",
        "underweight",
        "counterweight",
        "paperweight",
        "lightweight",
        "heavyweight"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84cf93a9-1dfc-3866-a883-98f2cb1d5bc7",
                    "sense_definition": "The measurement of how heavy a person or animal is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement_mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is trying to lose <w>weight</w> by eating healthier food and exercising.",
                            "target_lang_translations": {
                                "ru": "Она пытается сбросить <w>вес</w>, питаясь более здоровой пищей и занимаясь спортом.",
                                "zh": "她正试着通过吃得更健康和锻炼来减轻<w>体重</w>。"
                            }
                        },
                        {
                            "text": "The doctor checked the baby's <w>weight</w> during the regular checkup.",
                            "target_lang_translations": {
                                "ru": "Врач проверил <w>вес</w> ребенка во время планового осмотра.",
                                "zh": "医生在例行检查时查看了宝宝的<w>体重</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lose weight",
                        "gain weight",
                        "watch your weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Измерение того, насколько тяжелым является человек или животное.",
                        "zh": "人或动物有多重的测量值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "масса тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体重",
                                "target_lang_sense_clarification": "人或动物的身体重量"
                            },
                            {
                                "target_lang_word": "重量",
                                "target_lang_sense_clarification": "较口语，也可指体重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fb609b6-7e6f-3ae4-96b6-50b9c4d18ff4",
                    "sense_definition": "The quality of being heavy, or the measurement of how heavy an object is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement_mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The maximum <w>weight</w> for luggage on this flight is twenty kilograms.",
                            "target_lang_translations": {
                                "ru": "Максимальный <w>вес</w> багажа на этом рейсе составляет двадцать килограммов.",
                                "zh": "这趟航班的行李最大<w>重量</w>是二十公斤。"
                            }
                        },
                        {
                            "text": "Please check the net <w>weight</w> printed on the side of the package.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте чистый <w>вес</w> (нетто), напечатанный на боковой стороне упаковки.",
                                "zh": "请查看包装侧面印着的净<w>重</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "net weight",
                        "total weight",
                        "excess weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть тяжелым или измерение того, насколько тяжелым является предмет.",
                        "zh": "物体的沉重程度，或物体有多重的测量值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "масса предмета"
                            },
                            {
                                "target_lang_word": "тяжесть",
                                "target_lang_sense_clarification": "свойство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重量",
                                "target_lang_sense_clarification": "物体有多重的数值"
                            },
                            {
                                "target_lang_word": "重",
                                "target_lang_sense_clarification": "包装或标示用语，如净重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af50566c-af1d-3328-a915-0efa55c4a375",
                    "sense_definition": "A heavy object or equipment used for exercise to build muscle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He goes to the gym to lift <w>weights</w> three times a week.",
                            "target_lang_translations": {
                                "ru": "Он ходит в спортзал поднимать <w>тяжести</w> три раза в неделю.",
                                "zh": "他每周去健身房<w>举重</w>三次。"
                            }
                        },
                        {
                            "text": "Using free <w>weights</w> can help improve your overall body strength.",
                            "target_lang_translations": {
                                "ru": "Использование свободных <w>весов</w> может помочь улучшить общую силу тела.",
                                "zh": "使用自由<w>重量器械</w>有助于提高你的整体力量。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lift weights",
                        "free weights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелый предмет или оборудование, используемое для физических упражнений с целью наращивания мышечной массы.",
                        "zh": "用于锻炼、增强肌肉的重物或器械。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжесть",
                                "target_lang_sense_clarification": "спортивный снаряд"
                            },
                            {
                                "target_lang_word": "гантель",
                                "target_lang_sense_clarification": "вид снаряда"
                            },
                            {
                                "target_lang_word": "гиря",
                                "target_lang_sense_clarification": "вид снаряда"
                            },
                            {
                                "target_lang_word": "блин",
                                "target_lang_sense_clarification": "диск штанги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "举重",
                                "target_lang_sense_clarification": "锻炼时举的重量训练；也用于短语 lift weights"
                            },
                            {
                                "target_lang_word": "重量器械",
                                "target_lang_sense_clarification": "哑铃、杠铃片等重量训练器材的统称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef08043f-88a2-3489-8229-48445d182624",
                    "sense_definition": "A piece of metal or other heavy material used to hold something down or to balance a scale.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a paper <w>weight</w> to keep those documents from blowing away in the wind.",
                            "target_lang_translations": {
                                "ru": "Используйте <w>пресс-папье</w>, чтобы документы не улетели на ветру.",
                                "zh": "用一个<w>镇纸</w>压住那些文件，免得被风吹走。"
                            }
                        },
                        {
                            "text": "The diver attached a lead <w>weight</w> to his belt to help him sink.",
                            "target_lang_translations": {
                                "ru": "Дайвер прикрепил свинцовый <w>груз</w> к поясу, чтобы быстрее погрузиться.",
                                "zh": "潜水员把一块铅<w>坠</w>系在腰带上，好让自己下沉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "paper weight",
                        "lead weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок металла или другого тяжелого материала, используемый для удержания чего-либо или для уравновешивания весов.",
                        "zh": "用来压住东西或平衡秤的金属块或其他沉重材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "груз",
                                "target_lang_sense_clarification": "для удержания"
                            },
                            {
                                "target_lang_word": "гиря",
                                "target_lang_sense_clarification": "для весов"
                            },
                            {
                                "target_lang_word": "пресс-папье",
                                "target_lang_sense_clarification": "для бумаг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重物",
                                "target_lang_sense_clarification": "压住东西的重物"
                            },
                            {
                                "target_lang_word": "镇纸",
                                "target_lang_sense_clarification": "压纸用的重物"
                            },
                            {
                                "target_lang_word": "坠",
                                "target_lang_sense_clarification": "潜水、钓鱼等用的坠子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a24056ef-b0b2-3542-a14e-0027085ca063",
                    "sense_definition": "The importance, influence, or power that something or someone has.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her opinion carries a lot of <w>weight</w> in the company decisions.",
                            "target_lang_translations": {
                                "ru": "Ее мнение имеет большой <w>вес</w> в решениях компании.",
                                "zh": "她的意见在公司的决策中很有<w>分量</w>。"
                            }
                        },
                        {
                            "text": "The evidence did not have enough <w>weight</w> to convince the jury of his guilt.",
                            "target_lang_translations": {
                                "ru": "Улики не имели достаточного <w>веса</w>, чтобы убедить присяжных в его виновности.",
                                "zh": "这些证据分量不足，无法让陪审团相信他有罪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carry weight",
                        "pull your weight",
                        "lend weight to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Важность, влияние или власть, которыми обладает что-то или кто-то.",
                        "zh": "某人或某事所具有的重要性、影响力或力量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "авторитет, влияние"
                            },
                            {
                                "target_lang_word": "значимость",
                                "target_lang_sense_clarification": "важность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分量",
                                "target_lang_sense_clarification": "影响力、重要性"
                            },
                            {
                                "target_lang_word": "重要性",
                                "target_lang_sense_clarification": "重要程度"
                            },
                            {
                                "target_lang_word": "影响力",
                                "target_lang_sense_clarification": "影响或话语权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b49daca9-7ffc-3ced-b125-bfb72e4f5aa5",
                    "sense_definition": "A feeling of pressure, worry, or responsibility that is difficult to deal with.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a huge <w>weight</w> of responsibility after becoming the team leader.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал огромный <w>груз</w> ответственности, став лидером команды.",
                                "zh": "成为团队负责人后，他感到一种巨大的责任<w>重担</w>压在身上。"
                            }
                        },
                        {
                            "text": "Talking to a friend can help take the <w>weight</w> off your mind.",
                            "target_lang_translations": {
                                "ru": "Разговор с другом может помочь снять <w>тяжесть</w> с души.",
                                "zh": "和朋友聊聊能帮你减轻心里的<w>负担</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "weight off your mind",
                        "weight on your shoulders",
                        "dead weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство давления, беспокойства или ответственности, с которым трудно справиться.",
                        "zh": "难以承受的压力、忧虑或责任感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "груз",
                                "target_lang_sense_clarification": "бремя"
                            },
                            {
                                "target_lang_word": "тяжесть",
                                "target_lang_sense_clarification": "психологическое давление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "负担",
                                "target_lang_sense_clarification": "心理上的压力或包袱"
                            },
                            {
                                "target_lang_word": "重担",
                                "target_lang_sense_clarification": "沉重的责任或压力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62f7414d-16a7-3b09-bd9b-b2540e06cf7c",
                    "sense_definition": "The force exerted on a body by gravity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On the moon, your <w>weight</w> would be much less than it is on Earth.",
                            "target_lang_translations": {
                                "ru": "На Луне ваш <w>вес</w> был бы намного меньше, чем на Земле.",
                                "zh": "在月球上，你的<w>重量</w>会比在地球上小得多。"
                            }
                        },
                        {
                            "text": "In physics, mass is constant, but <w>weight</w> varies depending on gravity.",
                            "target_lang_translations": {
                                "ru": "В физике масса постоянна, но <w>вес</w> меняется в зависимости от гравитации.",
                                "zh": "在物理学中，质量保持不变，而<w>重量</w>会随重力而变化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "atomic weight",
                        "molecular weight"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила, воздействующая на тело под действием гравитации.",
                        "zh": "物体由于重力作用而受到的力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "физическая величина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重量",
                                "target_lang_sense_clarification": "受重力作用的物理量"
                            },
                            {
                                "target_lang_word": "重力",
                                "target_lang_sense_clarification": "物理学语境中的正式说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72471c94-6c1c-39f7-a509-f71d6409436b",
                    "sense_definition": "The thickness of the strokes in a typeface or font.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should use a bolder font <w>weight</w> for the headings to make them stand out.",
                            "target_lang_translations": {
                                "ru": "Вам следует использовать более жирное <w>начертание</w> шрифта для заголовков, чтобы выделить их.",
                                "zh": "你应该给标题使用更粗的字体<w>字重</w>，这样更醒目。"
                            }
                        },
                        {
                            "text": "The designer adjusted the line <w>weight</w> to make the drawing look more delicate.",
                            "target_lang_translations": {
                                "ru": "Дизайнер скорректировал <w>толщину</w> линии, чтобы рисунок выглядел более изящным.",
                                "zh": "设计师调整了线条的<w>粗细</w>，让这幅图看起来更精致。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "font weight",
                        "line weight"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Толщина штрихов в гарнитуре или шрифте.",
                        "zh": "字体或字形中笔画的粗细程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начертание",
                                "target_lang_sense_clarification": "шрифта"
                            },
                            {
                                "target_lang_word": "жирность",
                                "target_lang_sense_clarification": "линии"
                            },
                            {
                                "target_lang_word": "толщина",
                                "target_lang_sense_clarification": "штриха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "字重",
                                "target_lang_sense_clarification": "字体粗细程度"
                            },
                            {
                                "target_lang_word": "粗细",
                                "target_lang_sense_clarification": "线条或笔画的粗细"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d064f30b-b435-3eac-b24e-47a0f2a6fd6b",
                    "sense_definition": "A specific quantity of illegal drugs, often one pound or a kilogram.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the dealer for moving a significant amount of <w>weight</w> across the border.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала дилера за перевозку значительного <w>веса</w> через границу.",
                                "zh": "警方以跨境运送大量<w>毒品</w>为由逮捕了那名毒贩。"
                            }
                        },
                        {
                            "text": "He was caught pushing <w>weight</w> in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Его поймали, когда он толкал <w>вес</w> (наркотики) в этом районе.",
                                "zh": "他因在附近贩卖<w>毒品</w>被抓了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "push weight",
                        "move weight"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенное количество запрещенных наркотиков, часто фунт или килограмм.",
                        "zh": "黑话，指一定数量的非法毒品，常为一磅或一公斤左右。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "наркотики (жаргон)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒品",
                                "target_lang_sense_clarification": "毒品数量的黑话说法；常指较大批量"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "853787ea-5906-3b9b-8e1f-47bec4ee8af0",
                    "sense_definition": "To organize or plan something so that a particular result is more likely; to bias.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bias",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scoring system is <w>weighted</w> in favor of those with more experience.",
                            "target_lang_translations": {
                                "ru": "Система подсчета очков <w>смещена</w> в пользу тех, у кого больше опыта.",
                                "zh": "这个评分系统的设计<w>偏向</w>经验更丰富的人。"
                            }
                        },
                        {
                            "text": "They <w>weighted</w> the survey results to reflect the population accurately.",
                            "target_lang_translations": {
                                "ru": "Они <w>взвесили</w> результаты опроса, чтобы точно отразить состав населения.",
                                "zh": "他们对调查结果进行了<w>加权</w>处理，以准确反映总体人口情况。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "weighted in favor",
                        "weighted against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовать или спланировать что-либо так, чтобы конкретный результат был более вероятен; создать перевес.",
                        "zh": "以某种方式安排或处理，使某个结果更可能出现；使带有偏向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смещать",
                                "target_lang_sense_clarification": "создавать перевес"
                            },
                            {
                                "target_lang_word": "взвешивать",
                                "target_lang_sense_clarification": "статистика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏向",
                                "target_lang_sense_clarification": "使某种结果更占优势；带有偏向性"
                            },
