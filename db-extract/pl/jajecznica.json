                    },
                    {
                        "translation_id": "7bf14688-cd7b-442a-a53a-f48a7b5fdcd3",
                        "source_entry_id": "dede8bd2-9e9e-317c-a958-5c3e29607753",
                        "source_sense_id": "11042342-e218-38ad-aa5a-feba55eea505",
                        "target_lang_word": "omelette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omelette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50ee28e0-ecbb-384e-b241-7622303bfe11",
                                        "entry_id": "f115684b-299a-3898-8b4e-62cbfb7a076b",
                                        "glosses": [
                                            "Mets composé d’œufs battus ensemble et cuits à la poêle souvent avec du beurre ou de l’huile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "518ccf50-3a92-414b-a468-f3b6acbda998",
                                                "sense_id": "50ee28e0-ecbb-384e-b241-7622303bfe11",
                                                "text": "La soif fut éteinte au moyen de trois ou quatre jarres d’eau, la faim apaisée par une omelette aux tomates, où il n’y avait pas trop de plumes pour une omelette espagnole."
                                            },
                                            {
                                                "example_id": "8757a401-1984-4136-badf-1da41c53d516",
                                                "sense_id": "50ee28e0-ecbb-384e-b241-7622303bfe11",
                                                "text": "Quel beau feu de foyer pour sécher nos hardes, pendant que l’omelette sautait dans la flamme, l’inimitable omelette d’Alsace, craquante et dorée comme un gâteau."
                                            },
                                            {
                                                "example_id": "71283718-172c-454f-b42b-e7c793ff0ccf",
                                                "sense_id": "50ee28e0-ecbb-384e-b241-7622303bfe11",
                                                "text": "Mais en rentrant chez maître La Hurière, la première figure qu’aperçut notre gentilhomme fut celle de Coconnas attablé devant une gigantesque omelette au lard."
                                            },
                                            {
                                                "example_id": "b3cf31e2-24b9-4641-9d17-0160402af035",
                                                "sense_id": "50ee28e0-ecbb-384e-b241-7622303bfe11",
                                                "text": "Ils étaient assis tous deux devant la petite table ronde sur laquelle Joséphine posait une omelette au rhum entourée de flammes."
                                            },
                                            {
                                                "example_id": "9c329174-7b1d-4e9e-adf0-1bd716f9041a",
                                                "sense_id": "50ee28e0-ecbb-384e-b241-7622303bfe11",
                                                "text": "On leur fera une omelette et on leur donnera du « boustringue » et puis il y a du faro de première qualité et cela les apaise."
                                            },
                                            {
                                                "example_id": "c9bc681f-9bd9-4dec-a561-7ec59da3f961",
                                                "sense_id": "50ee28e0-ecbb-384e-b241-7622303bfe11",
                                                "text": "– Et maintenant que j'ai parlé, j'espère qu'on ne verra plus Antoine Toquelot faire omelette avec des œufs de rossignol à l'ormeau de la Bastidone."
                                            },
                                            {
                                                "example_id": "fb17c54b-e079-4a34-84e7-3e6de60935bf",
                                                "sense_id": "50ee28e0-ecbb-384e-b241-7622303bfe11",
                                                "text": "Monsieur Bilit qui a cette habitude d’arriver n’importe quel soir de la semaine à l’improviste, et s’il se trouve que c’est l’heure du dîner, on met pour lui un couvert de plus et Véra que son appétit insatiable étonne et amuse, même si le repas est assez copieux, lui fait préparer pour son dessert une énorme omelette aux confitures, son plat préféré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48aaaeae-eb6a-4955-bd07-2aa7bcb556fe",
                        "source_entry_id": "dede8bd2-9e9e-317c-a958-5c3e29607753",
                        "source_sense_id": "11042342-e218-38ad-aa5a-feba55eea505",
                        "target_lang_word": "œufs brouillés",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "œufs brouillés",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fb8c229-f293-3ef1-85a4-70e55213bf69",
                                        "entry_id": "2218015b-4136-3c32-b25a-5df186800479",
                                        "glosses": [
                                            "Préparation d’œufs entiers, d’un corps gras (habituellement du beurre) et de sel, constamment remués (et non battus) avec un fouet, à température douce d’un bain-marie, à la consistance crémeuse et lisse après une cuisson durant entre 5 et 8 minutes, souvent crémé ou additionné de fromage en fin de cuisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6263cb07-7ff8-4861-8e97-ccf45fc46769",
                                                "sense_id": "6fb8c229-f293-3ef1-85a4-70e55213bf69",
                                                "text": "Savez-vous pourquoi vous ne trouverez quasiment jamais d’œufs brouillés sur la carte des restaurants, même les plus fameux ? Parce qu'il faut au minimum quinze minutes à un ouvrier spécialisé pour les préparer et qu'il ne peut, pendant ce temps, se consacrer à aucune autre tâche."
                                            },
                                            {
                                                "example_id": "3f8b7a77-dc03-4203-9bd8-0636c9fcfc9e",
                                                "sense_id": "6fb8c229-f293-3ef1-85a4-70e55213bf69",
                                                "text": "Autour de la table, personne n'entend la prière d'Helen, murmurée en direction des œufs brouillés qu'elle remue dans la casserole."
                                            },
                                            {
                                                "example_id": "a89a9ac6-e0e9-4860-aeee-ba5ef07865fc",
                                                "sense_id": "6fb8c229-f293-3ef1-85a4-70e55213bf69",
                                                "text": "Ces molécules blanchâtres , confondues avec les parties butyreuses, jaunies par la bile qui domine alors sur la matière , composent ensemble la masse des excrémens qui ressemble beaucoup à des œufs brouillés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f8358e2-d338-4722-8b7b-14145d222e95",
                        "source_entry_id": "dede8bd2-9e9e-317c-a958-5c3e29607753",
                        "source_sense_id": "11042342-e218-38ad-aa5a-feba55eea505",
                        "target_lang_word": "tortilla",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Plato a base de huevo batido, al que se incorporan otros ingredientes; el conjunto se frie en una sola pieza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95de3943-4055-42ce-9e46-1687f3796db9",
                                                "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                                "text": "¡Ay, huevo mío de dos yemas, que para echar vos guardava yo! ¡Que de uno o de dos hazía yo una tortilla tan dorada que complía mis vergüenças!"
                                            },
                                            {
                                                "example_id": "260514b4-7f78-4e78-85f3-f09fe740a5ed",
                                                "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                                "text": "Luego pasé a un gallinero de más alante, levantó una gallina clueca que estaba empollando dieciocho huevos de raza e hizo una tortilla como pa un banquete."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Porción de masa de harina de maíz o trigo, redonda, plana y muy delgada que se cocina sobre una superficie caliente, habitualmente un comal; forma parte de la gastronomía tradicional de México y América Central."
                                        ],
                                        "tags": [
                                            "Mexico"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2faed898-fde1-4fa7-9c24-9e1ecbb2a01f",
                                                "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                                "text": "El principal y de mayor dignidad, poder y autoridad, sacerdote, ayunaba ochenta días antes; los cuatro días primeros no comía ni bebía más de una tortilla de maíz, que no pesaba una onza, y un poquillo de agua."
                                            },
                                            {
                                                "example_id": "0639f1dd-6158-44ea-bb47-60b646ef9de0",
                                                "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                                "text": "La tortilla mexicana no tiene nada que ver con las tortillas francesa o española. Ya lo dije en otro capítulo. Es un disco de masa de maíz que se lamina y sutiliza a palmetazos maestros."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3819f62e-3dad-351e-ba5a-a2af02e0afbd",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Pan aplanado de masa muy compacta, sin levadura y habitualmente con algo de manteca."
                                        ],
                                        "tags": [
                                            "Bolivia",
                                            "Chile",
                                            "Río-de-la-Plata"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a86180-3cb8-4552-9824-4cf31f40568a",
                                                "sense_id": "3819f62e-3dad-351e-ba5a-a2af02e0afbd",
                                                "text": "\"Pase, no más, mozo."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f5300680-d5f2-3be4-b29f-6dbda4665d4e",
                                        "entry_id": "c3aa138c-5e36-391d-9b45-d3a46f4738bc",
                                        "glosses": [
                                            "Coito entre mujeres."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c0ea0cb-6fb9-408b-9b73-7e5918daed96",
                                                "sense_id": "f5300680-d5f2-3be4-b29f-6dbda4665d4e",
                                                "text": "Esta tuerca, según las del gremio, es una tortillera clásica, de las que hacen ‘tortilla’ de verdad, pubis contra pubis, y no acepta otras variantes de amor sáfico."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00fd7c32-262a-4a6f-9dab-ef609917d0c9",
                        "source_entry_id": "dede8bd2-9e9e-317c-a958-5c3e29607753",
                        "source_sense_id": "11042342-e218-38ad-aa5a-feba55eea505",
                        "target_lang_word": "huevos revueltos",
