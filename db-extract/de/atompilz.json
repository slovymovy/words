                                                "sense_id": "f31f221e-75d9-3a08-9323-a63703cbf436",
                                                "text": "It's Christmas at ground zero / There's panic in the crowd / We can dodge debris / While we trim the tree / Underneath a mushroom cloud"
                                            }
