                        ],
                        "examples": [
                            {
                                "example_id": "c8c09db9-4200-4537-8c02-15925a4b28b2",
                                "sense_id": "f40ea930-515b-3086-a5da-7b1d3589ad30",
                                "text": "Chicanes, garnotte, prises de bec, armes à feu... perdue dans le tintamarre de la campagne, une question bien simple, mais cruciale, n’est jamais posée : c’est quoi ton expérience et ton expertise pour gérer un pays du G7 ?"
                            },
                            {
                                "example_id": "6ff72489-e316-4649-ad22-e5c2fa24ee00",
                                "sense_id": "f40ea930-515b-3086-a5da-7b1d3589ad30",
                                "text": "Ça tient, mais tout juste. Il suffirait de rouler sur une garnotte pour que toute la patente se déglingue."
                            },
                            {
                                "example_id": "7d5d1d2f-9a29-4946-b269-6e33f1658fbf",
                                "sense_id": "f40ea930-515b-3086-a5da-7b1d3589ad30",
                                "text": "Un enfant qui lance des garnottes sur son voisin."
                            }
                        ]
                    }
