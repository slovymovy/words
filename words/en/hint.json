{
    "word_family": [
        "hinter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6dc38938-9f31-3185-811a-3a549fe417d2",
                    "sense_definition": "A piece of information or a clue that helps to solve a problem or answer a question.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could not solve the puzzle until my friend gave me a helpful <w>hint</w>.",
                            "target_lang_translations": {
                                "ru": "Я не мог решить головоломку, пока друг не дал мне полезную <w>подсказку</w>.",
                                "zh": "直到朋友给了我一个有用的<w>提示</w>，我才解开这道谜题。"
                            }
                        },
                        {
                            "text": "The teacher provided a <w>hint</w> to help the students answer the difficult question.",
                            "target_lang_translations": {
                                "ru": "Учитель дал <w>подсказку</w>, чтобы помочь ученикам ответить на сложный вопрос.",
                                "zh": "老师给了学生一个<w>提示</w>，帮助他们回答这道难题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clue",
                        "tip",
                        "pointer",
                        "indication"
                    ],
                    "common_phrases": [
                        "give a hint",
                        "helpful hint",
                        "handy hint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация или ключ, помогающий решить проблему или ответить на вопрос.",
                        "zh": "帮助解决问题或回答问题的一条信息或线索。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсказка",
                                "target_lang_sense_clarification": "совет или идея, помогающая в решении"
                            },
                            {
                                "target_lang_word": "наводка",
                                "target_lang_sense_clarification": "указание или ориентир (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提示",
                                "target_lang_sense_clarification": "帮助解决问题或回答问题的线索"
                            },
                            {
                                "target_lang_word": "线索",
                                "target_lang_sense_clarification": "提供解答方向的线索"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6825c80-83be-3fc9-b3bd-502800485356",
                    "sense_definition": "An indirect suggestion or statement that implies something without saying it explicitly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She dropped a <w>hint</w> that she would like a new watch for her birthday.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>намёк</w> на то, что хотела бы новые часы на день рождения.",
                                "zh": "她<w>暗示</w>自己生日时想要一块新手表。"
                            }
                        },
                        {
                            "text": "He did not take the <w>hint</w> and continued to talk loudly during the movie.",
                            "target_lang_translations": {
                                "ru": "Он не понял <w>намёка</w> и продолжил громко разговаривать во время фильма.",
                                "zh": "他没有领会这个<w>暗示</w>，看电影时还是继续大声说话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suggestion",
                        "implication",
                        "innuendo",
                        "insinuation",
                        "clue",
                        "tip"
                    ],
                    "common_phrases": [
                        "drop a hint",
                        "take a hint",
                        "subtle hint",
                        "gentle hint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Косвенное предложение или утверждение, подразумевающее что-то без прямого высказывания.",
                        "zh": "一种间接的建议或说法，不明说，却让人领会其中的意思。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намёк",
                                "target_lang_sense_clarification": "косвенное указание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暗示",
                                "target_lang_sense_clarification": "不直接说出而是委婉表达的意思"
                            },
                            {
                                "target_lang_word": "示意",
                                "target_lang_sense_clarification": "较含蓄地提醒或表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                    "sense_definition": "A very small amount or slight trace of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef added just a <w>hint</w> of garlic to the sauce to improve the flavor.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар добавил в соус лишь <w>нотку</w> чеснока для улучшения вкуса.",
                                "zh": "为了提味，厨师在酱汁里只加了<w>一点</w>蒜味。"
                            }
                        },
                        {
                            "text": "There was a <w>hint</w> of sadness in her voice when she spoke about her childhood.",
                            "target_lang_translations": {
                                "ru": "В её голосе звучал <w>оттенок</w> грусти, когда она говорила о своём детстве.",
                                "zh": "她谈起童年时，声音里带着<w>一丝</w>悲伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trace",
                        "touch",
                        "dash",
                        "tinge",
                        "whiff",
                        "speck",
                        "modicum"
                    ],
                    "common_phrases": [
                        "hint of",
                        "hint of irony",
                        "hint of smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень малое количество или легкий след чего-либо.",
                        "zh": "极少的数量，或某种事物的轻微痕迹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "едва заметная примесь чувства или качества"
                            },
                            {
                                "target_lang_word": "нотка",
                                "target_lang_sense_clarification": "слабый привкус или след (о запахе, вкусе, чувстве)"
                            },
                            {
                                "target_lang_word": "привкус",
                                "target_lang_sense_clarification": "ощущение вкуса, примесь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一丝",
                                "target_lang_sense_clarification": "极少量；轻微痕迹"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "少量；轻微的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45756485-3365-3668-9345-294ff2695301",
                    "sense_definition": "Data included in a computer font to ensure it displays correctly at small sizes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer adjusted the <w>hint</w> manually to make the text readable on low-resolution screens.",
                            "target_lang_translations": {
                                "ru": "Дизайнер вручную настроил <w>хинтинг</w>, чтобы текст читался на экранах с низким разрешением.",
                                "zh": "设计师手动调整了<w>字形微调</w>，让文字在低分辨率屏幕上也清晰可读。"
                            }
                        },
                        {
                            "text": "Without a proper <w>hint</w>, the characters looked distorted at ten pixels high.",
                            "target_lang_translations": {
                                "ru": "Без правильного <w>хинтинга</w> символы выглядели искажёнными при высоте в десять пикселей.",
                                "zh": "如果没有合适的<w>字形微调</w>，这些字符在十像素高时看起来会变形。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Данные, включенные в компьютерный шрифт для обеспечения его правильного отображения при малых размерах.",
                        "zh": "字体中包含的、用于保证其在小尺寸下正确显示的数据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хинтинг",
                                "target_lang_sense_clarification": "программная инструкция для шрифтов"
                            },
                            {
                                "target_lang_word": "инструкция",
                                "target_lang_sense_clarification": "указание для растеризации шрифта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "字形微调",
                                "target_lang_sense_clarification": "字体中用于改善小字号显示效果的调整信息"
                            },
                            {
                                "target_lang_word": "微调指令",
                                "target_lang_sense_clarification": "用于控制屏幕显示效果的字体信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2470a45f-35ef-33c3-b3b6-c49161b9d5ef",
                    "sense_definition": "An opportunity or occasion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seized the <w>hint</w> to escape while the guards were distracted.",
                            "target_lang_translations": {
                                "ru": "Он воспользовался <w>возможностью</w> сбежать, пока охранники отвлеклись.",
                                "zh": "趁守卫分心时，他抓住了逃跑的<w>机会</w>。"
                            }
                        },
                        {
                            "text": "It was a <w>hint</w> that wrings mine eyes to tears.",
                            "target_lang_translations": {
                                "ru": "Это был <w>случай</w>, от которого на глаза наворачиваются слёзы.",
                                "zh": "那是一个令人落泪的<w>时机</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opportunity",
                        "chance",
                        "occasion"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможность или случай (устаревшее).",
                        "zh": "机会或时机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возможность",
                                "target_lang_sense_clarification": "удобный случай"
                            },
                            {
                                "target_lang_word": "случай",
                                "target_lang_sense_clarification": "обстоятельство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机会",
                                "target_lang_sense_clarification": "可利用的时刻或条件"
                            },
                            {
                                "target_lang_word": "时机",
                                "target_lang_sense_clarification": "适合采取行动的时候"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "373e2e34-c5b0-3988-832b-3c22b022416f",
                    "sense_definition": "To suggest something indirectly or provide a clue without stating it explicitly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>hinted</w> at the possibility of a promotion during our meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>намекнул</w> на возможность повышения во время нашей встречи.",
                                "zh": "经理在开会时<w>暗示</w>了升职的可能性。"
                            }
                        },
                        {
                            "text": "She <w>hinted</w> that she might leave the company if things did not improve.",
                            "target_lang_translations": {
                                "ru": "Она <w>намекнула</w>, что может уйти из компании, если дела не наладятся.",
                                "zh": "她<w>暗示</w>说，如果情况没有改善，她可能会离开公司。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imply",
                        "suggest",
                        "insinuate",
                        "intimate",
                        "allude to"
                    ],
                    "antonyms": [
                        "state",
                        "declare"
                    ],
                    "common_phrases": [
                        "hint at",
                        "hint strongly",
                        "hint darkly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагать что-то косвенно или давать подсказку, не заявляя об этом прямо.",
                        "zh": "间接地表示某事，或在不明说的情况下给出提示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намекать",
                                "target_lang_sense_clarification": "делать намёки (несов. вид)"
                            },
                            {
                                "target_lang_word": "намекнуть",
                                "target_lang_sense_clarification": "сделать намёк (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暗示",
                                "target_lang_sense_clarification": "间接表达某事；不明说"
                            },
                            {
                                "target_lang_word": "示意",
                                "target_lang_sense_clarification": "含蓄地表示或指出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a98e3326-b234-3147-ad84-9c900deaa4a0",
                    "sense_definition": "To add display instructions to a computer font to improve its appearance on screens.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The typographer spent hours <w>hinting</w> the new typeface for better web legibility.",
                            "target_lang_translations": {
                                "ru": "Типограф потратил часы, <w>выполняя хинтинг</w> нового шрифта для лучшей читаемости в вебе.",
                                "zh": "为了提高网页上的可读性，这位字体设计师花了好几个小时为这款新字体<w>添加字形微调指令</w>。"
                            }
                        },
                        {
                            "text": "Software can automatically <w>hint</w> fonts, but manual adjustment often yields better results.",
                            "target_lang_translations": {
                                "ru": "Программы могут автоматически <w>выполнять хинтинг</w> шрифтов, но ручная настройка часто дает лучшие результаты.",
                                "zh": "软件可以自动为字体<w>添加字形微调指令</w>，但手动调整往往效果更好。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять инструкции отображения к компьютерному шрифту для улучшения его вида на экранах.",
                        "zh": "给计算机字体添加显示指令，以改善其在屏幕上的显示效果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выполнять хинтинг",
                                "target_lang_sense_clarification": "применять инструкции к шрифту"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "添加字形微调指令",
                                "target_lang_sense_clarification": "为字体加入改善屏幕显示效果的指令"
                            },
                            {
                                "target_lang_word": "做字形微调",
                                "target_lang_sense_clarification": "对字体进行小尺寸显示优化"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "7b9dab46-324f-3d15-a1de-48a12d0a2e5f",
                    "sense_definition": "Used to emphasize that a previous statement contains a hidden suggestion that should be understood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would really love to receive some flowers for Valentine's Day, <w>hint</w>, <w>hint</w>.",
                            "target_lang_translations": {
                                "ru": "Я бы очень хотела получить цветы на День святого Валентина, <w>намёк</w>, <w>намёк</w>.",
                                "zh": "我真的很想在情人节收到一些花，<w>暗示一下</w>，<w>暗示一下</w>。"
                            }
                        },
                        {
                            "text": "Someone needs to take out the trash soon, <w>hint</w>, <w>hint</w>.",
                            "target_lang_translations": {
                                "ru": "Кто-то должен скоро вынести мусор, <w>намёк</w>, <w>намёк</w>.",
                                "zh": "该有人赶紧去倒垃圾了，<w>暗示一下</w>，<w>暗示一下</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hint hint"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подчеркивания того, что предыдущее утверждение содержит скрытое предложение.",
                        "zh": "用于强调前面的话里有隐藏的意思，希望对方自己领会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намёк",
                                "target_lang_sense_clarification": "указание на скрытый смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暗示一下",
                                "target_lang_sense_clarification": "口语中用来强调前面的话是在暗示别人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}