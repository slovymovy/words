                    {
                        "sense_id": "2e158cce-72f7-3733-8a7c-e26e5af8656b",
                        "entry_id": "f4d4b0fc-8af0-3995-b8bd-6b7d54bea9c2",
                        "glosses": [
                            "Renforcement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170519f7-2689-40f6-ab2f-ea0b2b4e4624",
                                "sense_id": "2e158cce-72f7-3733-8a7c-e26e5af8656b",
                                "text": "Die Bänder sind für Übungen zur Kräftigung und zum Muskelaufbau geeignet."
                            },
                            {
                                "example_id": "6938668b-7c52-48cf-9e4f-dad5749216d0",
                                "sense_id": "2e158cce-72f7-3733-8a7c-e26e5af8656b",
                                "text": "Wenn sie nur etwas mehr Zeit hätte, würde sie auch noch mit Tai Chi anfangen. Es gibt Übungen zur Kräftigung, Dehnung und Abhärtung."
                            }
                        ]
                    }
