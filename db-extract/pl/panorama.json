                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eadf48ea-57b1-380d-8dbb-0acd62428213",
                                        "entry_id": "5cbedec6-27cf-333d-ae0b-78e4c64fea38",
                                        "glosses": [
                                            "eine Rundsicht, Rundblick, Rundgemälde, Rundfoto, eine 360-Grad-Ansicht; ungenauer: Aussicht auf eine, Ansicht einer Landschaft, Geländemodell im Schaukasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b84778b3-b051-4c0e-b586-ee88f80b2099",
                                                "sense_id": "eadf48ea-57b1-380d-8dbb-0acd62428213",
                                                "text": "Das Panorama kann man nur bei guten Wetterverhältnissen genießen."
                                            },
                                            {
                                                "example_id": "6343b72f-f637-436d-b247-34adf3034040",
                                                "sense_id": "eadf48ea-57b1-380d-8dbb-0acd62428213",
                                                "text": "„Die Sonne stand halblinks hinter Pierre und beleuchtete in der klaren und reinen Luft mit grosser Deutlichkeit das mächtige, amphitheatralisch ansteigende Panorama vor ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e19fdc5a-fe3a-3227-a37c-47ac3df73430",
                                        "entry_id": "5cbedec6-27cf-333d-ae0b-78e4c64fea38",
                                        "glosses": [
                                            "Rundblick, Überblick über zum Beispiel ein Themengebiet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "004178b8-5d99-4765-b90b-a31e098ff2de",
                                                "sense_id": "e19fdc5a-fe3a-3227-a37c-47ac3df73430",
                                                "text": "Das Hamburger Museum zeigt ein umfassendes Panorama seiner frühen Werke."
                                            },
                                            {
                                                "example_id": "6582e2e4-0e7d-476c-9277-3cfc46beae5d",
                                                "sense_id": "e19fdc5a-fe3a-3227-a37c-47ac3df73430",
                                                "text": "„Es bildete die Geschichte und Entwurzelung meiner Familie ab, aber dahinter schien ein breiteres, nationales Panorama auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
