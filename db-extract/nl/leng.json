                    {
                        "translation_id": "099771f1-8908-4ff0-8cf6-898c719ca939",
                        "source_entry_id": "dcf03be2-6d5a-35ca-b47a-2400780df6ef",
                        "source_sense_id": "52eb8715-3ecb-34d8-87e6-a036d71cd30c",
                        "source_sense_description": "kabeljauwachtige zoutwatervis, Molva molva",
                        "target_lang_word": "lingue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lingue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77db7c34-ad58-355e-9a9b-fe03945f935e",
                                        "entry_id": "9bba7f90-cb60-35f7-8ab5-82ad06d5f75b",
                                        "glosses": [
                                            "Poisson osseux marin de profondeur, très allongé, à deux nageoires dorsales et une anale, comestible, vivant principalement dans les mers du nord de l’Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14ae16a3-02dd-4530-a5c1-21dfb28c4337",
                                                "sense_id": "77db7c34-ad58-355e-9a9b-fe03945f935e",
                                                "text": "La morue […] appartient à la grande famille […] qui comprend d’ailleurs bien d’autres espèces telles que le merlan, le lieu noir, l’églefin, la lingue, le merlu, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75340a4d-e11e-3c0c-a592-33e2444a04fe",
                                        "entry_id": "9bba7f90-cb60-35f7-8ab5-82ad06d5f75b",
                                        "glosses": [
                                            "Lingue franche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46c795e4-fd24-47c8-a064-f10a8529b1fb",
                                                "sense_id": "75340a4d-e11e-3c0c-a592-33e2444a04fe",
                                                "text": "En conclusion, le lieu jaune et la lingue, espèces ciblées par les filets « petites mailles », ne sont jamais rejetés car commercialisables. De plus la durée d’immersion n’excédant pas 1 jour, ce sont des poissons d’excellente qualité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lingue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "375baec8-fe63-39ed-bc9b-09038a6f3230",
                                        "entry_id": "802535b7-c8fa-37ab-9e47-200a73bc61f7",
                                        "glosses": [
                                            "Couteau."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c194cd-5491-417b-adb8-7195514f805b",
                                                "sense_id": "375baec8-fe63-39ed-bc9b-09038a6f3230",
                                                "text": "Son visage en lame de couteau et son regard gris froid comme le reflet d’un lingue."
                                            },
                                            {
                                                "example_id": "956991b0-1853-4640-bed7-3ffdf62333db",
                                                "sense_id": "375baec8-fe63-39ed-bc9b-09038a6f3230",
                                                "text": "En tout cas, on n'a pas dû se servir d'un lingue ordinaire, mais d'une arme de qualité, une dague, ou peut-être un scalpel."
                                            },
                                            {
                                                "example_id": "b8dd7431-31d9-4db5-8c48-ac348081067d",
                                                "sense_id": "375baec8-fe63-39ed-bc9b-09038a6f3230",
                                                "text": "C’est le couteau qui a gagné la guerre, pas le canon ! Un poilu qui tiendrait contre un train blindé lâchera à la seule idée que des types s’amènent avec un lingue…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lingue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4203eacb-f898-3bf3-873b-ed7d7c2cce87",
                                        "entry_id": "100587c1-95a2-3936-be8e-3a5287184913",
