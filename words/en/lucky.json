{
    "word_family": [
        "luck",
        "luckily",
        "luckless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97adc5f6-89c0-3110-9168-231a3c797a01",
                    "sense_definition": "Having good luck or success by chance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lucky</w> winner of the lottery was announced on television yesterday.",
                            "target_lang_translations": {
                                "ru": "<w>Счастливый</w> победитель лотереи был объявлен по телевидению вчера.",
                                "zh": "昨天电视上公布了彩票的<w>幸运</w>中奖者。"
                            }
                        },
                        {
                            "text": "I feel very <w>lucky</w> to have such supportive friends and family.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя очень <w>счастливым</w>, что у меня такие отзывчивые друзья и семья.",
                                "zh": "能有这么支持我的亲友，我觉得自己非常<w>幸运</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fortunate"
                    ],
                    "antonyms": [
                        "unlucky",
                        "unfortunate"
                    ],
                    "common_phrases": [
                        "lucky winner",
                        "lucky guess",
                        "get lucky",
                        "lucky day"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий удачей или добившийся успеха благодаря счастливому случаю.",
                        "zh": "指人运气好，或者因偶然的机会而获得成功。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "везу́чий",
                                "target_lang_sense_clarification": "разг.; о человеке, которому часто везет"
                            },
                            {
                                "target_lang_word": "уда́чливый",
                                "target_lang_sense_clarification": "о человеке, которому сопутствует удача"
                            },
                            {
                                "target_lang_word": "счастли́вый",
                                "target_lang_sense_clarification": "удачный, благополучный (например, победитель)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幸运的",
                                "target_lang_sense_clarification": "形容人运气好"
                            },
                            {
                                "target_lang_word": "走运的",
                                "target_lang_sense_clarification": "形容人处于好运中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85fb9f9e-2cbe-36e4-843a-9c60188c99ea",
                    "sense_definition": "Bringing or resulting in good luck.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cause_of_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always carries a <w>lucky</w> coin in his pocket for good fortune.",
                            "target_lang_translations": {
                                "ru": "Он всегда носит в кармане <w>счастливую</w> монету на удачу.",
                                "zh": "他口袋里总带着一枚<w>幸运</w>硬币以求好运。"
                            }
                        },
                        {
                            "text": "It was a <w>lucky</w> coincidence that we arrived at the station simultaneously.",
                            "target_lang_translations": {
                                "ru": "Это было <w>удачное</w> совпадение, что мы прибыли на станцию одновременно.",
                                "zh": "我们同时到达车站真是一个<w>凑巧</w>的巧合。"
                            }
                        }
                    ],
                    "synonyms": [
                        "auspicious",
                        "favorable",
                        "propitious",
                        "fortuitous",
                        "serendipitous",
                        "fortunate",
                        "jammy"
                    ],
                    "antonyms": [
                        "unlucky",
                        "cursed"
                    ],
                    "common_phrases": [
                        "lucky charm",
                        "lucky number",
                        "lucky break",
                        "lucky star"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приносящий удачу или являющийся результатом удачного стечения обстоятельств.",
                        "zh": "指带来好运的，或者因巧合而产生有利结果的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счастли́вый",
                                "target_lang_sense_clarification": "приносящий счастье (о предметах, талисманах)"
                            },
                            {
                                "target_lang_word": "уда́чный",
                                "target_lang_sense_clarification": "успешный, завершившийся удачей (о событиях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幸运的",
                                "target_lang_sense_clarification": "指能带来好运的物品"
                            },
                            {
                                "target_lang_word": "凑巧的",
                                "target_lang_sense_clarification": "指结果有利的巧合"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e56cd5b7-ff12-3aa2-bd83-631163e8b883",
                    "sense_definition": "A common name given to a pet dog.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The children were delighted when they named their new puppy <w>Lucky</w>.",
                            "target_lang_translations": {
                                "ru": "Дети были в восторге, когда назвали своего нового щенка <w>Лаки</w>.",
                                "zh": "孩子们给新买的小狗取名叫<w>拉基</w>，他们高兴极了。"
                            }
                        },
                        {
                            "text": "We called our dog <w>Lucky</w> because we found him on a sunny day.",
                            "target_lang_translations": {
                                "ru": "Мы назвали нашу собаку <w>Лаки</w>, потому что нашли его в солнечный день.",
                                "zh": "我们给狗取名叫<w>拉基</w>，因为我们是在一个晴天发现它的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная кличка для домашней собаки.",
                        "zh": "常见的宠物狗名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ла́ки",
                                "target_lang_sense_clarification": "кличка животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉基",
                                "target_lang_sense_clarification": "宠物狗名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dfb5c96-3f83-370a-8771-16998d921725",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Lucky</w> signed the official documents at the bank this morning.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Лаки</w> подписал официальные документы в банке сегодня утром.",
                                "zh": "<w>拉基</w>先生今天早上在银行签署了正式文件。"
                            }
                        },
                        {
                            "text": "We are going to visit the <w>Lucky</w> family for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Мы собираемся навестить семью <w>Лаки</w> сегодня за ужином.",
                                "zh": "我们今晚要去<w>拉基</w>一家吃晚饭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "used as a last name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ла́ки",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉基",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "651952d2-7ea9-35d6-9bc1-fa65cbd402d1",
                    "sense_definition": "The number seven.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rolled a <w>lucky</w> on the dice and won the entire game.",
                            "target_lang_translations": {
                                "ru": "Ему выпала <w>семёрка</w> на кубиках, и он выиграл всю игру.",
                                "zh": "他掷出了一个<w>七</w>，赢得了整场比赛。"
                            }
                        },
                        {
                            "text": "In this card game, a <w>lucky</w> is the highest card you can draw.",
                            "target_lang_translations": {
                                "ru": "В этой карточной игре <w>семёрка</w> — самая старшая карта, которую можно вытянуть.",
                                "zh": "在这个纸牌游戏中，<w>七</w>是你所能抽到的最大牌。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in gambling contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Число семь (обычно в контексте азартных игр).",
                        "zh": "指数字七（常用于博彩语境）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семёрка",
                                "target_lang_sense_clarification": "разг.; игральная карта или грань кубика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "七",
                                "target_lang_sense_clarification": "博彩中的幸运数字"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}