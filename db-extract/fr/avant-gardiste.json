                                        "sense_id": "074e1f17-b3d7-3677-b57d-a524842d29f3",
                                        "entry_id": "e276f26c-e0cf-3876-bc06-71009458f073",
                                        "glosses": [
                                            "The vanguard of an army or other force."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ba46ef5-217b-371d-8bde-9850f4dcc0da",
                                        "entry_id": "e276f26c-e0cf-3876-bc06-71009458f073",
                                        "glosses": [
                                            "Any group of people who invent or promote new techniques or concepts, especially in the arts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "avant-garde",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dda979d-3529-3fbb-a71d-a1243f3ca35c",
                                        "entry_id": "50ac4d94-248c-35d1-8728-d6f0795ca52f",
                                        "glosses": [
                                            "Innovative and pioneering, especially when extremely or obviously so."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8f4674-3e6c-43d7-8a78-4f5eb62fe971",
                                                "sense_id": "0dda979d-3529-3fbb-a71d-a1243f3ca35c",
                                                "text": "It was a very avant-garde production."
                                            },
                                            {
                                                "example_id": "934786cf-3b9e-44e4-9f1e-be809479b30e",
                                                "sense_id": "0dda979d-3529-3fbb-a71d-a1243f3ca35c",
                                                "text": "I fear she will pay a heavy price for the avant garde ideas she has been sold."
                                            },
                                            {
                                                "example_id": "c9fba185-e31e-4dad-a753-fe1de5adba01",
                                                "sense_id": "0dda979d-3529-3fbb-a71d-a1243f3ca35c",
                                                "text": "There’s a moment, for instance, in the competition show Beast Games that struck me as something close to avant garde. Donaldson lays out a million dollars in cash in a big pile, and instructs each of the 10 remaining contestants to come out of their little houses one by one, and to choose how much money they want to take from the pile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
