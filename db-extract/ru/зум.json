                                        "glosses": [
                                            "An augmentation of a view, by varying the focal length of a lens, or digitally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0376e2-a709-48cd-953c-7ef7a0075fd1",
                                                "sense_id": "38acd576-6682-36dd-ad3e-c3d0f82b5dcf",
                                                "text": "What's the zoom like on your camera?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zoom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e131b2-5dfd-3396-add3-f48aef8f6832",
                                        "entry_id": "5cb88d2c-217b-36b6-90ca-c332b25a8d5c",
                                        "glosses": [
                                            "To move fast with a humming noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd0290d-9470-4fab-9864-147d8cd1d841",
                                                "sense_id": "58e131b2-5dfd-3396-add3-f48aef8f6832",
                                                "text": "We zoomed along the highway."
                                            },
                                            {
