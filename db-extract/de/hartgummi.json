                "senses": [
                    {
                        "sense_id": "1aaae4b8-5a9b-3e8e-96ae-0a140a42587f",
                        "entry_id": "541f38d9-1aae-34a5-9a18-3f3c5da0710a",
                        "glosses": [
                            "fester, elastischer Kunststoff (harter Gummi), der auf Basis von Naturkautschuk, Leinöl und Schwefel hergestellt wird"
                        ],
                        "tags": [
                            "Material"
                        ],
                        "examples": [
                            {
                                "example_id": "a4179ea0-929a-47b9-9a89-a52224e7f991",
                                "sense_id": "1aaae4b8-5a9b-3e8e-96ae-0a140a42587f",
                                "text": "„Die Pessare bestehen aus Metall, Porzellan, Hartgummi oder Kunststoff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5fcb17e-b7ef-3c17-be1b-c3004e48e6e4",
                        "entry_id": "541f38d9-1aae-34a5-9a18-3f3c5da0710a",
                        "glosses": [
                            "Puck/Ball aus hartem Gummi"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6adae111-b555-4390-aae4-8fa6d1c758fd",
                                "sense_id": "c5fcb17e-b7ef-3c17-be1b-c3004e48e6e4",
                                "text": "„Eugen Alanov verpasst direkt vor Joacim Eriksson und setzt das Hartgummi haarscharf am Pfosten vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
