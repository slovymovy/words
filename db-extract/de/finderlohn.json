                ],
                "senses": [
                    {
                        "sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                        "entry_id": "9a0f94c0-8b11-3a3e-8085-cc70b9075f1d",
                        "glosses": [
                            "Belohnung (meist Geldbetrag), die der Finder für die Rückgabe eines gefundenen Gutes bekommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b2cb08-5ddc-4ecc-9b7a-e5bd1bf9a546",
                                "sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                                "text": "Wenn jemand etwas Wertvolles gefunden und zurückgegeben hat, dann steht ihm ein angemessener Finderlohn zu."
                            },
                            {
                                "example_id": "b2cf6328-8037-45a1-8153-a8113ec3e38a",
                                "sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                                "text": "„Und wenn's eine Million gewesen wäre, er hätte sie gegen Finderlohn abgegeben.“"
                            },
                            {
                                "example_id": "914351b7-50f5-4b5d-a941-4bde79a58058",
                                "sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                                "text": "„Petra hat im Papierkorb des Vaters einen 20-DM-Schein entdeckt und verlangt, als sie ihn ihrem Vater gibt, 10 Prozent Finderlohn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10599bdc-b5ce-4185-8eef-c2701ac826b1",
                        "source_entry_id": "9a0f94c0-8b11-3a3e-8085-cc70b9075f1d",
                        "source_sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                        "source_sense_description": "Belohnung (meist Geldbetrag), die der Finder für die Rückgabe eines gefundenen Gutes bekommt",
                        "target_lang_word": "reward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b577e4b-fc09-3821-aaee-6d5058aaa705",
                                        "entry_id": "f6bd9276-4b13-3b51-b443-3db34ae0ec3f",
                                        "glosses": [
                                            "Something of value given in return for an act."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48021aea-e401-463b-8ea2-83b74cfdd04d",
                                                "sense_id": "7b577e4b-fc09-3821-aaee-6d5058aaa705",
                                                "text": "For catching the thief, you'll get a nice reward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98317c1c-e4f3-370f-98a0-8649061cc742",
                                        "entry_id": "f6bd9276-4b13-3b51-b443-3db34ae0ec3f",
                                        "glosses": [
                                            "A prize promised for a certain deed or catch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400a1b41-2464-478a-bce4-91f0928acda3",
                                                "sense_id": "98317c1c-e4f3-370f-98a0-8649061cc742",
                                                "text": "The rewards for bringing in badly wanted criminals are printed on 'dead or alive' posters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca12c70a-771e-39b8-b3a2-7c47812db59b",
                                        "entry_id": "f6bd9276-4b13-3b51-b443-3db34ae0ec3f",
                                        "glosses": [
                                            "The result of an action, whether good or bad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2a859e5-5300-4880-af48-4a471bd617b0",
                                                "sense_id": "ca12c70a-771e-39b8-b3a2-7c47812db59b",
                                                "text": "Is this the reward I get for telling the truth: to be put in jail?"
                                            },
                                            {
                                                "example_id": "096f20d3-fe6e-4971-b741-cc7f8e881ae7",
                                                "sense_id": "ca12c70a-771e-39b8-b3a2-7c47812db59b",
                                                "text": "Christian Benteke's first-half goal was just reward for Villa's undoubted superiority but Bradford managed to survive without further damage until half-time, before scoring the goal that takes them to Wembley for the first time since 1996."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd12619d-25a4-3861-b0b1-f937283f12da",
                                        "entry_id": "eca0944f-f825-31fe-abc3-bb777729ee3d",
                                        "glosses": [
                                            "To give a reward to or for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04c99a4-d2b5-4e03-ae7a-21de229b79cb",
                                                "sense_id": "bd12619d-25a4-3861-b0b1-f937283f12da",
                                                "text": "Why are you rewarding the child for misbehaving?"
                                            },
                                            {
                                                "example_id": "f8701c09-2d40-428d-8fc7-b0b91b7ca093",
                                                "sense_id": "bd12619d-25a4-3861-b0b1-f937283f12da",
                                                "text": "Why are you rewarding that bad behaviour?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fcb6adc-cc57-3f6c-8139-1ede080e9bbd",
                                        "entry_id": "eca0944f-f825-31fe-abc3-bb777729ee3d",
                                        "glosses": [
                                            "To be a recompense for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68b7425-0bab-4cfd-a9c2-bad30712b516",
                                                "sense_id": "2fcb6adc-cc57-3f6c-8139-1ede080e9bbd",
                                                "text": "Decorations are meant to reward the most meritous acts and services."
                                            },
                                            {
                                                "example_id": "a20b6c4f-dc9b-4556-9850-173bec2d21ad",
                                                "sense_id": "2fcb6adc-cc57-3f6c-8139-1ede080e9bbd",
                                                "text": "The Italian opted for Bolton's Cahill alongside captain John Terry - and his decision was rewarded with a goal after only 13 minutes. Bulgaria gave a hint of defensive frailties to come when they failed to clear Young's corner, and when Gareth Barry found Cahill in the box he applied the finish past Nikolay Mihaylov."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7194fc3f-c8c7-3b2f-8cb1-abf3869174c1",
                                        "entry_id": "eca0944f-f825-31fe-abc3-bb777729ee3d",
                                        "glosses": [
                                            "To give (something) as a reward."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb455a7-3acc-4786-9331-fc96ad68e7e1",
                                                "sense_id": "7194fc3f-c8c7-3b2f-8cb1-abf3869174c1",
                                                "text": "Thenne syr Marhaus departed and within two dayes his damoysel brought hym where as was a grete tornement that the lady de Vawse has cryed\n[…]\n And there syr Marhaus dyd so nobly that he was renomed\n & had somtyme doune fourty knyghtes\n and soo the serklet of gold was rewarded hym"
                                            },
                                            {
                                                "example_id": "af7b1a1a-b15e-4cae-95d3-9876183fd669",
                                                "sense_id": "7194fc3f-c8c7-3b2f-8cb1-abf3869174c1",
                                                "text": "Thou hast rewarded me good, whereas I have rewarded thee evil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e03f904-d3ce-46a1-abba-d2e1eb082e67",
                        "source_entry_id": "9a0f94c0-8b11-3a3e-8085-cc70b9075f1d",
                        "source_sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                        "source_sense_description": "Belohnung (meist Geldbetrag), die der Finder für die Rückgabe eines gefundenen Gutes bekommt",
                        "target_lang_word": "récompense",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "récompense",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ea45e1c-8582-3e74-9579-c16d6abf3260",
                                        "entry_id": "6866750c-e8cb-3660-9f32-d661d58c487c",
                                        "glosses": [
                                            "Bien qu’on fait à quelqu’un, en reconnaissance d’un service ou en faveur d’une bonne action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5c027a-3418-47af-ad8c-3b0d57f9d268",
                                                "sense_id": "8ea45e1c-8582-3e74-9579-c16d6abf3260",
                                                "text": "Lorsque dans une armée le besoin de récompenses se fait très vivement sentir, on peut affirmer que sa valeur est en baisse."
                                            },
                                            {
                                                "example_id": "14f2bd20-7476-43ee-a72c-0548b60c1933",
                                                "sense_id": "8ea45e1c-8582-3e74-9579-c16d6abf3260",
                                                "text": "Si tu réussis à faire venir Nazira dans mon magasin, seule, sans sa mère, je te donnerai une guinée de récompense."
                                            },
                                            {
                                                "example_id": "6f462c87-2bbf-4804-b42c-31ab20484b6a",
                                                "sense_id": "8ea45e1c-8582-3e74-9579-c16d6abf3260",
                                                "text": "— C’était un méchant homme, il a eu la récompense qu’il méritait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7089396e-5002-369a-ba9b-6aefe245120b",
                                        "entry_id": "6866750c-e8cb-3660-9f32-d661d58c487c",
                                        "glosses": [
                                            "Compensation ou dédommagement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092b8484-3c92-426a-8262-cffd92913216",
                                                "sense_id": "7089396e-5002-369a-ba9b-6aefe245120b",
                                                "text": "On lui donna tant pour récompense des pertes qu’il avait faites."
                                            },
                                            {
                                                "example_id": "5117f226-d208-40be-ab1f-9de3d7fa27ae",
                                                "sense_id": "7089396e-5002-369a-ba9b-6aefe245120b",
                                                "text": "Il faut lui accorder quelque récompense pour le dommage qu’il a souffert."
                                            },
                                            {
                                                "example_id": "9a404457-2321-476f-9dbf-f0b69e899483",
                                                "sense_id": "7089396e-5002-369a-ba9b-6aefe245120b",
                                                "text": "Pour récompense, on lui donna une pension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99f08c0f-cc34-3166-9db2-8e58f606025f",
                                        "entry_id": "6866750c-e8cb-3660-9f32-d661d58c487c",
                                        "glosses": [
                                            "Indemnité ou remploi dû lorsqu’on fait des liquidations de communautés conjugales ou de successions."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9e8f70-ff3a-4e70-b9ba-67cf6598909a",
                                                "sense_id": "99f08c0f-cc34-3166-9db2-8e58f606025f",
                                                "text": "Récompense due à la communauté par les époux, aux époux par la communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "854eba0b-9969-3696-b61a-1d635dff4a67",
                                        "entry_id": "6866750c-e8cb-3660-9f32-d661d58c487c",
                                        "glosses": [
                                            "Titre accordé à quelqu’un pour lui rendre hommage."
                                        ],
                                        "tags": [],
                                        "examples": [
