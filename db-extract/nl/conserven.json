                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "59e63517-b695-4dc1-b67a-48a57d282e6a",
                                "sense_id": "95a16224-3262-3a8e-9cd5-6bccc3bdb211",
                                "text": "Het bedrijf verwerkt groente, fruit en champignons tot conserven voor de consumentenmarkt."
                            }
