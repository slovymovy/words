                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f613f460-9fe5-483b-8c86-ec234699cb46",
                                "sense_id": "52d4cda5-61ac-3dfd-addd-9165dfaafda6",
                                "text": "We kochten een aantal flessen prosecco voor het nieuwjaarsfeest."
                            },
                            {
                                "example_id": "2a7b54e8-33df-4646-b272-197d455f9997",
                                "sense_id": "52d4cda5-61ac-3dfd-addd-9165dfaafda6",
                                "text": "Tijdens de workshop kunt u proeven van vijf verschillende prosecco's."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc55154e-e040-3ecc-a482-f06b0d3353b8",
                        "entry_id": "a8ba5f61-0f0f-31ec-a6cf-7957ab7217a3",
                        "glosses": [
                            "glas met de onder 1. genoemde wijn als eenheid van consumptie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01a34f87-f6c5-47ba-a81e-b9fb1b5970ef",
                                "sense_id": "bc55154e-e040-3ecc-a482-f06b0d3353b8",
                                "text": "Hij nam zijn prosecco mee de tuin in."
                            },
                            {
                                "example_id": "0823726f-4dde-4388-8781-033d8a3f18a3",
                                "sense_id": "bc55154e-e040-3ecc-a482-f06b0d3353b8",
                                "text": "Door de hitte dronken ze wat meer prosecco's dan verstandig was."
                            }
                        ]
