                                "en": "This decision was difficult <w>and</w> necessary.",
                                "nl": "Dit besluit was moeilijk <w>en</w> tevens noodzakelijk.",
                                "de": "Diese Entscheidung war schwierig <w>und</w> zugleich notwendig.",
                                "fr": "Cette décision était difficile <w>et</w> nécessaire.",
                                "it": "Questa decisione era difficile <w>e allo stesso tempo</w> necessaria.",
                                "cs": "Toto rozhodnutí bylo těžké <w>a zároveň</w> nutné.",
                                "tr": "Bu karar zor <w>ve</w> gerekliydi.",
                                "es": "Esta decisión fue difícil <w>y a la vez</w> necesaria.",
                                "zh": "这个决定既困难<w>同时</w>又必要。"
                            }
                        }
