                        "comprendre le mécanisme"
                    ]
                },
                {
                    "sense_id": "81849812-66f4-3a48-93e7-f1a93ddc5d70",
                    "sense_definition": "Habileté technique et agilité des doigts dans l'exécution instrumentale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pianiste possède un <w>mécanisme</w> remarquable, mais son interprétation manque encore d'émotion."
