                                            {
                                                "example_id": "3ba22f61-466d-4ee4-ae56-c4056bdaf654",
                                                "sense_id": "35051c85-736b-37fa-8926-f3a3278ab6eb",
                                                "text": "Ein Spitz kläfft aber auch bei jeder Gelegenheit."
                                            },
                                            {
                                                "example_id": "8f492280-15a2-41d7-b30c-331ca76c3838",
                                                "sense_id": "35051c85-736b-37fa-8926-f3a3278ab6eb",
                                                "text": "„Der Spitz bellte jetzt auch die Sekretärin an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1c6b9e6-0a32-39d2-bcca-427576d4a110",
