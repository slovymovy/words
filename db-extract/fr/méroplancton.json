                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4767e81-859f-3f5c-a815-bb58a2c7504b",
                        "entry_id": "246d01fc-4070-31bb-aca7-e2305cdd8c7a",
                        "glosses": [
                            "Partie du zooplancton composée d’œufs et de larves d’espèces qui ne passent qu’une partie de leur existence dans le plancton et en sortent au stade adulte, par opposition à l’holoplancton, plancton permanent."
                        ],
                        "tags": [
                            "Hydrobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "805d9248-2792-46fb-b6f0-af330812d592",
                                "sense_id": "c4767e81-859f-3f5c-a815-bb58a2c7504b",
                                "text": "Une fraction du méroplancton est constituée de l’ichtyoplancton de presque toutes les espèces de poissons ayant une valeur commerciale."
                            },
                            {
                                "example_id": "7bbce3c3-6d6a-4141-b828-2ca40d91efe1",
                                "sense_id": "c4767e81-859f-3f5c-a815-bb58a2c7504b",
                                "text": "Le méroplancton ne constitue toujours qu’une fraction infime du zooplancton total de la Baie-des Chaleurs, si l’on s’en réfère à nos échantillons de la série régulière."
                            },
                            {
                                "example_id": "46699414-b97a-4dc8-98d3-c55771d318ea",
                                "sense_id": "c4767e81-859f-3f5c-a815-bb58a2c7504b",
                                "text": "S’agissant du zooplancton seul le méroplancton survit dans un bac. Le méroplancton désigne les larves qui composent le plancton juste le temps avant qu’elles atteignent le stade adulte."
                            }
                        ]
                    }
                ],
