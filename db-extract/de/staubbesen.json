                        "glosses": [
                            "handliches Gerät mit weichen, dünnen Borsten, Federn oder dergleichen zum Entfernen von Staub oder Schmutz, häufig an schwer erreichbaren Stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c5769a-7b6d-4358-9a03-fbc7fe7c74b3",
                                "sense_id": "c357bbdc-7ccc-3a6a-a700-e8a11de292f1",
                                "text": "Mit dem Staubbesen wischte er den Staub auf dem Schrank weg."
                            },
                            {
                                "example_id": "9a1f1611-a7ab-47ca-97c9-cc5c08f0ad8c",
                                "sense_id": "c357bbdc-7ccc-3a6a-a700-e8a11de292f1",
                                "text": "„Den Staubbesen hielt er in der rechten Hand und einige Ellen Bindfaden in der linken.“"
                            }
                        ],
