                        ]
                    },
                    {
                        "sense_id": "a569e51f-56a0-3da2-89a4-fc624ea77ae7",
                        "entry_id": "8cfc92f8-83f0-3e7f-94e0-50c0e5061cc2",
                        "glosses": [
                            "Qui concerne la fraction trente-deuxième."
