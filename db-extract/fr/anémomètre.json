        "fr-extract.jsonl": [
            {
                "entry_id": "ebb20444-6889-3240-824d-f7d617fdf1e5",
                "word": "anémomètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b37c722e-c6f3-4ad8-a76b-f085be571b69",
                        "entry_id": "ebb20444-6889-3240-824d-f7d617fdf1e5",
                        "tags": [
                            "plural"
                        ],
                        "form": "anémomètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "868cd07d-109f-3d16-b572-521a569b23ae",
                        "entry_id": "ebb20444-6889-3240-824d-f7d617fdf1e5",
                        "glosses": [
                            "Instrument servant à mesurer la vitesse et la force du vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79837303-5cf0-41fb-afe8-d21152517235",
                                "sense_id": "868cd07d-109f-3d16-b572-521a569b23ae",
                                "text": "Comme anémomètre, le venturi est utilisé uniquement sur les avions lents et les planeurs."
                            },
                            {
                                "example_id": "3e514fbf-3ed6-4a00-bf11-e8dd4040ab44",
                                "sense_id": "868cd07d-109f-3d16-b572-521a569b23ae",
                                "text": "Le reste, sauf, si l'on veut, le compas de relèvement, est à l'avenant, ou parfaitement dérisoire, comme le spidomètre (pour mesurer la vitesse), sans aucune précision, donc sans usage de loch, sans raison d'être hors de régate, et l’anémomètre, dont l'indication… dépend de l'endroit où on le place."
                            },
                            {
                                "example_id": "f032e584-0e17-43b1-887c-b0ae6891dbc3",
                                "sense_id": "868cd07d-109f-3d16-b572-521a569b23ae",
                                "text": "Plus tard, anémomètres et hygromètres compléteront la panoplie des outils de mesure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d52e6468-b743-429b-a352-d60768761d3b",
                        "source_entry_id": "ebb20444-6889-3240-824d-f7d617fdf1e5",
                        "source_sense_id": "868cd07d-109f-3d16-b572-521a569b23ae",
                        "target_lang_word": "anemometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anemometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9ffb7b2-9da3-3996-bc58-85398a9935eb",
                                        "entry_id": "41b47efa-dbd2-3329-b5b2-70f97f276997",
                                        "glosses": [
                                            "An instrument for measuring and recording the speed of the wind, a windmeter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e907f8-d621-4d16-adf2-d24cfcacf053",
                                                "sense_id": "b9ffb7b2-9da3-3996-bc58-85398a9935eb",
                                                "text": "An anemometer constructed by the Soil Mechanics Laboratory of the Western Region, British Railways, has been installed at Dawlish Warren, near Exeter, to obtain a record of the velocity (speed and direction) of the wind. This information is used for the study of the effects of wind erosion on the sand dunes which protect the railway from the sea at that point."
                                            },
                                            {
                                                "example_id": "5966d42c-7305-4211-81c1-62f43fe9079a",
                                                "sense_id": "b9ffb7b2-9da3-3996-bc58-85398a9935eb",
                                                "text": "This anemometer was installed by the North Eastern Railway on Staithes Viaduct in 1884, to warn signallers of dangerously high winds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92fb88fc-a4b1-467f-9cde-e6a563f3e6f3",
                        "source_entry_id": "ebb20444-6889-3240-824d-f7d617fdf1e5",
                        "source_sense_id": "868cd07d-109f-3d16-b572-521a569b23ae",
                        "target_lang_word": "anemometre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anemometre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46daa0f5-2be1-3ff5-952c-a259095b1e0a",
                                        "entry_id": "ad65576c-4cb0-3186-958b-10e290252e8d",
                                        "glosses": [
                                            "Alternative form of anemometer."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9690a822-d68a-43c2-a395-2f3ad89a455b",
                                                "sense_id": "46daa0f5-2be1-3ff5-952c-a259095b1e0a",
                                                "text": "It has been found, however, that the anemometre, or airmeasurer, can be so adjusted that after a few revolutions it releases a spring[…]."
                                            },
                                            {
                                                "example_id": "6d7c641b-2cc1-4360-8e85-3a909f10d6bb",
                                                "sense_id": "46daa0f5-2be1-3ff5-952c-a259095b1e0a",
                                                "text": "Few people perhaps could tell if asked what an anemometre is."
                                            },
                                            {
                                                "example_id": "ae81087a-022f-4f5c-bbe5-0fa4983a3eb8",
                                                "sense_id": "46daa0f5-2be1-3ff5-952c-a259095b1e0a",
                                                "text": "The government suggested that two anemometres should be erected to control traffic during storms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec5f4241-95d6-4b3d-8c1f-0fa7cad0193c",
                        "source_entry_id": "ebb20444-6889-3240-824d-f7d617fdf1e5",
