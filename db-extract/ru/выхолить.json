                "senses": [
                    {
                        "sense_id": "0310c061-dc07-3587-a242-06766b9a3bdd",
                        "entry_id": "1c294a7d-5946-3139-b9cc-b8a54e3fc084",
                        "glosses": [
                            "вырастить, холя, заботливым, тщательным уходом добиться наилучшего состояния, холеного вида"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3de01745-6226-4236-aeaf-5171aeaca709",
                                "sense_id": "0310c061-dc07-3587-a242-06766b9a3bdd",
                                "text": "— Отпусти меня, Зайка, отпусти, беленькая, из башенки по свету погулять, выхолил я тебя, Зайку, вынянчил, пора и на волю мне."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ec99f63-03f5-4fa6-84fb-82fb4c3607b4",
                        "source_entry_id": "1c294a7d-5946-3139-b9cc-b8a54e3fc084",
                        "source_sense_id": "0310c061-dc07-3587-a242-06766b9a3bdd",
                        "target_lang_word": "soigner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soigner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c27565ec-d3f7-359a-b233-e07138b9a859",
                                        "entry_id": "1c382a51-9b65-3b4d-aaba-c4eb33d432b4",
                                        "glosses": [
                                            "Avoir soin de quelqu’un ou de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c5a3c8-f680-461b-ba5b-fbf1d95ebc6f",
                                                "sense_id": "c27565ec-d3f7-359a-b233-e07138b9a859",
                                                "text": "Gasbieha et sa mère passaient le printemps au Caire, l’été à Alexandrie, et suivaient fréquemment le Pacha à Hélouan, où il soignait ses rhumatismes."
                                            },
                                            {
                                                "example_id": "055fcf23-e9f8-4c7e-9456-e4d833a882b1",
                                                "sense_id": "c27565ec-d3f7-359a-b233-e07138b9a859",
                                                "text": "Gravement blessés, tombés au pouvoir de l'adversaire, ils craignent pour leur vie mais sont soignés par des mains qui se révèlent fraternelles."
                                            },
                                            {
                                                "example_id": "540b63dd-5e59-4531-acba-a1393ad23d6b",
                                                "sense_id": "c27565ec-d3f7-359a-b233-e07138b9a859",
                                                "text": "Les abords désobstrués et sablés étaient soignés par l’homme chargé d’entretenir les allées du parc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8915757-2462-3c22-9a66-fd33385c4861",
                                        "entry_id": "1c382a51-9b65-3b4d-aaba-c4eb33d432b4",
                                        "glosses": [
                                            "Apporter de l’intérêt à quelqu’un, dans l’espoir d’une contrepartie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "940ed043-4464-468e-a6e0-011810f650d5",
                                                "sense_id": "f8915757-2462-3c22-9a66-fd33385c4861",
                                                "text": "Il aura bientôt besoin de lui, alors il le soigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11262f3d-8cb4-3058-9540-57f6d0a85652",
                                        "entry_id": "1c382a51-9b65-3b4d-aaba-c4eb33d432b4",
                                        "glosses": [
                                            "Apporter de l’attention, du soin à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1067bee1-db5d-4fc9-8c4a-42a161a87915",
                                                "sense_id": "11262f3d-8cb4-3058-9540-57f6d0a85652",
                                                "text": "Il soigne beaucoup son style."
                                            },
                                            {
                                                "example_id": "e858dc88-0a7d-49cf-8a54-6a7c19febd49",
                                                "sense_id": "11262f3d-8cb4-3058-9540-57f6d0a85652",
                                                "text": "Ce peintre ne soigne pas assez les accessoires, les détails."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
