                ],
                "senses": [
                    {
                        "sense_id": "27558f40-158f-3a4c-85b6-4266fa89f69e",
                        "entry_id": "b84025a9-e0cc-3213-8003-7dc5f9b5bb2b",
                        "glosses": [
                            "Gebiet, innerhalb dessen eine bestimmte Preisstufe für die Nutzung eines Dienstes gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28ebe79-88a8-4136-9a60-df0a6319e181",
                                "sense_id": "27558f40-158f-3a4c-85b6-4266fa89f69e",
                                "text": "„Die Einteilung in Tarifzonen sollte den busfreudigen Gast nicht schrecken, für längere Strecken müssen zwei Fahrscheine entwertet werden, und die Hinweisschilder an den Haltestellen verraten durch farbige Markierungen, wieviel Scheine in den Entwertungsschlitz gesteckt werden müssen.“"
                            },
                            {
                                "example_id": "e20c4854-b5ed-42a9-9308-f7fd5e8ce35f",
                                "sense_id": "27558f40-158f-3a4c-85b6-4266fa89f69e",
                                "text": "„Den Preis für eine Hausratversicherung legen die Versicherer je nach Region fest. Deutschland haben die Anbieter nach Schadenrisiko häufig in vier, manche sogar in sechs Tarifzonen eingeteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
