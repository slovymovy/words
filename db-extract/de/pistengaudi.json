                "senses": [
                    {
                        "sense_id": "2d67ac1b-5556-3934-898e-9416aec5a534",
                        "entry_id": "3056c0e4-0457-349a-a91d-8350f5be18b5",
                        "glosses": [
                            "Skifahren, bei dem nicht so sehr der sportliche Aspekt, sondern der ausgelassene Spaß, das gemeinschaftliche Erlebnis mit Gleichgesinnten, Einkehr und Abfeiern in Hütten im Vordergrund steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81850f1d-60ce-4b18-97d6-b64f97b8e915",
                                "sense_id": "2d67ac1b-5556-3934-898e-9416aec5a534",
                                "text": "„Mancherorts entsteht der Eindruck, dass Pistengaudi und Après-Ski als das Interessanteste am Skifahren bewertet wird.“"
                            },
                            {
                                "example_id": "d304a1ec-1b46-4d40-a8a0-17a773bc5303",
                                "sense_id": "2d67ac1b-5556-3934-898e-9416aec5a534",
                                "text": "„Von der Deformierung des Ortes bekommen die Touristen nichts mit. Sie reisen ja nach ein paar Tagen Pistengaudi wieder ab.“"
                            },
                            {
                                "example_id": "b5630401-32d5-4791-bed1-e9f0d575e6b8",
                                "sense_id": "2d67ac1b-5556-3934-898e-9416aec5a534",
                                "text": "„Die Woche Skifahren in Österreich hatten sie sich redlich verdient, sieben Tage Sonne, Schnee und Pistengaudi. Die Bedingungen waren optimal […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
