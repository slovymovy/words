                "senses": [
                    {
                        "sense_id": "6882ac71-0b08-3d7c-af63-d282e8ae73b1",
                        "entry_id": "9169dcb4-d799-30a3-8501-a91439316fda",
                        "glosses": [
                            "weibliche Person, die ausgewandert ist (besonders aus politischen oder religiösen Gründen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b73afef-c6ac-414b-8f03-b0f85a24ea2e",
                                "sense_id": "6882ac71-0b08-3d7c-af63-d282e8ae73b1",
                                "text": "Seine Mutter hatte es nicht leicht in den USA als Emigrantin aus dem östlichen Teil Russlands."
                            },
                            {
                                "example_id": "ff923997-290a-4c23-bba1-da5cf5211c7a",
                                "sense_id": "6882ac71-0b08-3d7c-af63-d282e8ae73b1",
                                "text": "„Almuth wurde, was ihn überraschte, weder nervös noch traurig; sie fragte nur, ob die Musikgesellschaft des Westens auf eine Emigrantin erpicht sei, die es zuhause offenbar gut mit den Herrschenden gekonnt habe, und die sich am Klavier als Extremistin einer neuen Sachlichkeit aufspiele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
