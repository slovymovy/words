                "senses": [
                    {
                        "sense_id": "f5d31795-4ff0-376f-b42c-4a94e9876799",
                        "entry_id": "d2c106ac-2b8d-391d-be76-bb8a7000f07e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89951f5-9386-4756-83b5-154e39356c99",
                                "sense_id": "f5d31795-4ff0-376f-b42c-4a94e9876799",
                                "text": "Frau Pschorr ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b2917b2b-211d-4ba6-975c-978064e9356a",
                                "sense_id": "f5d31795-4ff0-376f-b42c-4a94e9876799",
                                "text": "Herr Pschorr wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2d4fc043-d5c0-4d6d-90ab-db7fe3fdfa5e",
                                "sense_id": "f5d31795-4ff0-376f-b42c-4a94e9876799",
                                "text": "Die Pschorrs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fdfebf87-32a1-4cc5-99d4-125206df41db",
                                "sense_id": "f5d31795-4ff0-376f-b42c-4a94e9876799",
                                "text": "Der Pschorr trägt nie die Schals, die die Pschorr ihm strickt."
                            },
                            {
                                "example_id": "e2eb6b02-9e2b-432f-8dfa-3d176cae390c",
                                "sense_id": "f5d31795-4ff0-376f-b42c-4a94e9876799",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pschorr kommt, geht der Herr Pschorr.“"
                            },
                            {
                                "example_id": "58c2c9fd-ef50-4e51-a7ca-fb5c170059b3",
                                "sense_id": "f5d31795-4ff0-376f-b42c-4a94e9876799",
                                "text": "Pschorr kommt und geht."
                            },
                            {
                                "example_id": "3741f3a5-a813-4238-b23d-40dc8fecaa93",
                                "sense_id": "f5d31795-4ff0-376f-b42c-4a94e9876799",
                                "text": "Pschorrs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
