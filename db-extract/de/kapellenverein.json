                                            {
                                                "example_id": "d61d8a6e-f2c1-408b-8e84-a8f3a5f34dad",
                                                "sense_id": "1fa5145b-9c64-3aed-89d7-64de1d3045d1",
                                                "text": "Parce que les doutes, ça fabrique des choses. Et ça les défabrique aussi…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8cd842c-d2cb-314c-9ec9-767d4ead1845",
