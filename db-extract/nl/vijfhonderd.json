                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2995b6de-906a-4528-98f5-9423d604bfdf",
                                "sense_id": "7349e2d4-e5b6-323e-ab35-8ab7b19c0119",
                                "text": "Die vijfhonderd kunnen onmogelijk een complete brigade met tanks tegenhouden."
