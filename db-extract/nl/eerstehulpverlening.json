                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5405c55b-b3ee-4be5-8841-da5dcc02a5ef",
                                "sense_id": "78e63c42-1b1c-323e-9f59-6ce60ed34216",
                                "text": "Een verkeerde manier van eerstehulpverlening kan een blessure verergeren en zelfs blijvende schade veroorzaken. Vooral bij letsel aan de nek of wervels en botbreuken doet een verkeerde behandeling meer kwaad dan goed. In het ergste geval kan een tweede botbreuk of een verlamming ontstaan, waarschuwt het Rode Kruis."
                            },
                            {
                                "example_id": "f4f30a1b-c3ac-4e82-9190-7a40c70a4c4e",
                                "sense_id": "78e63c42-1b1c-323e-9f59-6ce60ed34216",
                                "text": "Om goed geoefend te blijven voor noodsituaties worden deze hulpverleners ook ingezet voor de eerstehulpverlening bij de grotere evenementen, zegt het Rode Kruis."
                            }
                        ]
                    }
