                        "glosses": [
                            "De twee mensen die met elkaar in het huwelijk treden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b8474d-bb44-4f11-85b8-513074927798",
                                "sense_id": "b2ab5862-ed19-3adc-8609-aa5f0fbd9415",
                                "text": "Hoewel er in Nederland een aantal eisen wordt gesteld aan beide partners van het bruidspaar, heeft geen daarvan betrekking op het geslacht of de godsdienst van een van de partners."
                            }
                        ]
                    }
