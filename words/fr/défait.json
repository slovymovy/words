                },
                {
                    "sense_id": "c77197bd-1c72-3708-af51-2c48f97cf4b3",
                    "sense_definition": "Troisième personne du singulier du présent de l'indicatif de <w>défaire</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant noue puis <w>défait</w> patiemment les lacets de ses nouvelles chaussures.",
                            "target_lang_translations": {
                                "en": "The child ties, then patiently <w>unties</w> the laces of their new shoes.",
                                "ru": "Ребёнок завязывает, а потом терпеливо <w>развязывает</w> шнурки своих новых ботинок.",
                                "de": "Das Kind bindet die Schnürsenkel seiner neuen Schuhe, dann <w>löst</w> es sie geduldig wieder.",
                                "es": "El niño ata y luego <w>desata</w> pacientemente los cordones de sus zapatos nuevos.",
                                "zh": "孩子先系上，然后耐心地<w>解开</w>新鞋的鞋带。"
                            }
                        },
                        {
                            "text": "Le couturier <w>défait</w> la couture avec précaution pour ne pas abîmer le tissu.",
                            "target_lang_translations": {
                                "en": "The tailor <w>unpicks</w> the seam carefully so as not to damage the fabric.",
                                "ru": "Портной осторожно <w>распарывает</w> шов, чтобы не повредить ткань.",
                                "de": "Der Schneider <w>trennt</w> die Naht vorsichtig <w>auf</w>, um den Stoff nicht zu beschädigen.",
                                "es": "El sastre <w>descose</w> con cuidado la costura para no dañar la tela.",
                                "zh": "裁缝小心地<w>拆开</w>缝线，以免损坏布料。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Third person singular present indicative of the verb défaire.",
                        "ru": "Третье лицо единственного числа настоящего времени изъявительного наклонения глагола défaire.",
                        "de": "Dritte Person Singular Präsens Indikativ des Verbs »défaire«.",
                        "es": "Tercera persona del singular del presente de indicativo del verbo «défaire».",
                        "zh": "动词défaire的第三人称单数现在时形式，表示解开或拆开。"
