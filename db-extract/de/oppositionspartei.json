                "senses": [
                    {
                        "sense_id": "4ad3064f-3057-3b02-808c-617e2fb51c7e",
                        "entry_id": "ed4dc2e0-580a-3f64-b9f4-397e3a916cd9",
                        "glosses": [
                            "Parti d’opposition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ad40ab-55a7-45d5-ada9-2fb58bb3b298",
                                "sense_id": "4ad3064f-3057-3b02-808c-617e2fb51c7e",
                                "text": "Wo ist die Oppositionspartei?",
                                "translation": "Où est le parti d'opposition ? — (Manifeste du parti communiste, 1ʳᵉ édition, 1848.)"
                            },
                            {
                                "example_id": "ed84a384-4cd3-466f-b239-085f1f6e2c4e",
                                "sense_id": "4ad3064f-3057-3b02-808c-617e2fb51c7e",
                                "text": "\"Wir hatten an Schwung verloren\", sagt Wong Yik-mo von der Oppositionspartei Demosisto, der zu den führenden Köpfen der Proteste gehört.",
                                "translation": "\"Nous avions perdu de l’élan\", explique Wong Yik-mo, du parti d'opposition Demosisto, et l'un des leaders de la contestation."
                            },
                            {
                                "example_id": "d7197d83-2b26-47c0-a903-a856ea29f83a",
                                "sense_id": "4ad3064f-3057-3b02-808c-617e2fb51c7e",
                                "text": "(...) Trotzdem haben auch die Oppositionsparteien bis zuletzt keinen Einspruch gegen das Wahlergebnis erhoben.",
                                "translation": "Malgré cela, les partis d'opposition n'ont, jusqu'ici, pas non plus contesté le résultat des élections."
                            }
                        ]
                    }
                ],
