                        "entry_id": "3b45ddaa-a506-3521-958a-f52289b368a7",
                        "glosses": [
                            "In an ample manner; extensively; thoroughly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5061b32-48fe-403f-a783-780240732c31",
                                "sense_id": "a2df2a61-5251-3d7a-a4ce-16271438ddb4",
                                "text": "We were amply supplied with food and beverage."
                            },
                            {
                                "example_id": "6506741c-967b-487f-86be-266995a5c768",
                                "sense_id": "a2df2a61-5251-3d7a-a4ce-16271438ddb4",
                                "text": "If, during his long persecution by President Kruger, Wools-Sampson in the bitterness of his heart had vowed a feud against the Boer cause, it must be acknowledged that he has most amply fulfilled it."
                            }
                        ]
                    }
                ],
