        "ru-extract.jsonl": [
            {
                "entry_id": "ca11245a-ea1e-33f8-a533-33d9f1345714",
                "word": "Кирсанов",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "44424891-df2a-393d-9744-3d9ca574faab",
                        "entry_id": "ca11245a-ea1e-33f8-a533-33d9f1345714",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea968b54-a86e-4709-9162-8b7074b02f4c",
                                "sense_id": "44424891-df2a-393d-9744-3d9ca574faab",
                                "text": "Познакомим с ним читателя, пока он сидит, подогнувши под себя ножки и задумчиво поглядывая кругом. Зовут его Николаем Петровичем Кирсановым."
                            },
                            {
                                "example_id": "476e30ad-8e92-48a4-82c6-cb1eddd6eb11",
                                "sense_id": "44424891-df2a-393d-9744-3d9ca574faab",
                                "text": "Бережно отворив дверь, Кирсанов спустился в кабинет."
                            }
                        ]
                    }
                ],
