                    {
                        "translation_id": "3cb34405-db0f-4071-84a6-f936000e813f",
                        "source_entry_id": "36a141ac-323f-3774-8943-67bbac00db00",
                        "source_sense_id": "c066d864-ec57-3e51-a1fa-5226929d7c01",
                        "source_sense_description": "(bijvoeglijk naamwoord) vernielend",
                        "target_lang_word": "dévastateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dévastateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cf96bfd-8f00-3d70-8d00-ab1245d62db9",
                                        "entry_id": "7f4f12d3-c0af-30e6-bf60-f280df4ce582",
                                        "glosses": [
                                            "Qui dévaste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec43769-6690-46ca-9352-deb1215c11fc",
                                                "sense_id": "3cf96bfd-8f00-3d70-8d00-ab1245d62db9",
                                                "text": "En Inde, le traitement du cheptel au diclofénac est dévastateur pour les vautours."
                                            },
                                            {
                                                "example_id": "65e67924-9267-45f1-b0d2-217bc01b2a55",
                                                "sense_id": "3cf96bfd-8f00-3d70-8d00-ab1245d62db9",
                                                "text": "Le cyclone dévastateur de 1864 à Calcutta, suivi d'un météotsunami de 6 m remontant la Hooghly et détruisant le port, a précipité la création de l'Indian Meteorological Office, dix ans seulement après la création de son équivalent britannique."
                                            },
                                            {
                                                "example_id": "d2e8276a-170f-43b4-9bf7-93eb5e0082d3",
                                                "sense_id": "3cf96bfd-8f00-3d70-8d00-ab1245d62db9",
                                                "text": "Aussitôt que son fils lui apporta la bonne nouvelle, le seigneur ennemi, convaincu que l’arbalète magique ne possédait plus les vertus dévastatrices, déclencha l’offensive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dévastateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2115c3cf-665d-3333-a271-962479cc1d44",
                                        "entry_id": "090bf7c1-8cad-3b07-9ce0-addeeb8932e7",
                                        "glosses": [
                                            "Celui qui dévaste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a094fcc8-fb56-4a47-b2ff-b1f8119e042b",
                                                "sense_id": "2115c3cf-665d-3333-a271-962479cc1d44",
                                                "text": "Ces dévastateurs de l'humanité, les explosifs, les avions de bombardement, les gaz mortifères, font partie de la plus haute science, au même titre que la chaise à électrocuter et que les alcaloïdes hypertoxiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
