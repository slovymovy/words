                "senses": [
                    {
                        "sense_id": "ada1a534-cbb8-37a5-8a22-104aeb540543",
                        "entry_id": "7216a47e-399a-31b8-aeff-7d23c928541b",
                        "glosses": [
                            "Aller de droite et de gauche, sans but arrêté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32dfb0c5-7148-4a5c-9f08-5bcd78de415f",
                                "sense_id": "ada1a534-cbb8-37a5-8a22-104aeb540543",
                                "text": "Croirais-tu que j’ai été toute une semaine à pensailler, rangeailler, mangeailler, promenailler sans rien faire de bon ?"
                            },
                            {
                                "example_id": "42a6afa7-4918-467a-b671-e3b08e75b8ff",
                                "sense_id": "ada1a534-cbb8-37a5-8a22-104aeb540543",
                                "text": "Et autant te dire que j’irais plus aisément sur Piccadilly Circus me promenailler, puis me prélasser sur un transat à Hyde Park, que bloguouiller."
                            }
                        ]
                    }
