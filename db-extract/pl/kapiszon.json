                    },
                    {
                        "sense_id": "78930662-7096-3f28-bdd2-c5b49033641b",
                        "entry_id": "0c23e170-b6c1-3753-9461-3ce17652cc76",
                        "glosses": [
                            "metalowa spłonka z masą wybuchową stanowiąca zapłon w strzelbie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "af191abb-f114-33cd-9318-80087bdab45b",
                        "entry_id": "0c23e170-b6c1-3753-9461-3ce17652cc76",
                        "glosses": [
                            "papierowa spłonka w zabawkowym pistolecie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73f1943-82f3-442b-a466-154eac5124e4",
                                "sense_id": "af191abb-f114-33cd-9318-80087bdab45b",
                                "text": "Na kramiku odpustowym leżały zabawkowe pistolety – korkowce i na kapiszony."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82ded733-487f-4ff2-8e5f-35d6b880a60b",
                        "source_entry_id": "0c23e170-b6c1-3753-9461-3ce17652cc76",
                        "source_sense_id": "e533a3ff-15eb-3267-9721-bdb7daf90e45",
                        "target_lang_word": "capuchon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capuchon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5af9bc26-6eb9-3603-b358-6ee62dacf084",
                                        "entry_id": "877a06b2-d2be-3369-9850-6f960fb206df",
                                        "glosses": [
                                            "Couverture de tête qui se rabat en avant ou se rejette en arrière à volonté et qui fait partie de certains vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ea5ebc-df1f-4ad4-ac23-d0d5b82e19c4",
                                                "sense_id": "5af9bc26-6eb9-3603-b358-6ee62dacf084",
                                                "text": "[…], et n’avait, pour garantir sa tête de l’air humide de la nuit, qu’un petit capuchon de mailles doublé de drap, qui, lorsque le casque était en son lieu ordinaire, retombait en pointe entre les deux épaules."
                                            },
                                            {
                                                "example_id": "d5ee6b94-0035-468b-881b-e29928b384ac",
                                                "sense_id": "5af9bc26-6eb9-3603-b358-6ee62dacf084",
                                                "text": "Des torrents d’eau, […], ruisselaient sur le cortège. Certains enfonçaient le cou dans leur macferlane, d'autres inclinaient leurs capuchons pointus."
                                            },
                                            {
                                                "example_id": "dd2453b2-d25e-44e6-bc52-60338145e061",
                                                "sense_id": "5af9bc26-6eb9-3603-b358-6ee62dacf084",
                                                "text": "Pendant de longues heures nous marchons en silence, ne regardant ni à droite ni à gauche, la tête baissée sous nos capuchons pour nous garantir de l’ondée cinglante."
                                            },
                                            {
                                                "example_id": "8e7885f7-6caa-4954-8360-bf086990fc09",
                                                "sense_id": "5af9bc26-6eb9-3603-b358-6ee62dacf084",
                                                "text": "Il y avait surtout beaucoup d’agents qui, leur capuchon sous le bras, allaient et venaient, d’un air paisible et faisait parfois halte pour écouter la musique des bastringues."
                                            },
                                            {
                                                "example_id": "0a95a964-8dac-4677-b384-3194c8db22e0",
                                                "sense_id": "5af9bc26-6eb9-3603-b358-6ee62dacf084",
                                                "text": "[…] ; ils ont conservé cependant la forme esquimau, en particulier de l’anorak, sorte de veste à capuchon, très pratique pour les régions polaires ; […]."
                                            },
                                            {
                                                "example_id": "9b6b388c-fe17-4013-a302-4e7ac009413d",
                                                "sense_id": "5af9bc26-6eb9-3603-b358-6ee62dacf084",
                                                "text": "Le vieillard avait revêtu sa cape à capuchon verte et tenait dans ses mains une lampe-tempête, la même que Zalec avait vu la première fois qu'ils s'étaient rencontrés, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e7b5a7-1373-3d30-960c-19684d685e92",
                                        "entry_id": "877a06b2-d2be-3369-9850-6f960fb206df",
                                        "glosses": [
                                            "Repli mobile de peau et de muqueuse coulissant et non roulant, qui couvre plus ou moins le gland du clitoris de la femme et le protège à l’état de flaccidité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c8a31c6-d19d-3e37-ab18-5a8dd85ab1b6",
                                        "entry_id": "877a06b2-d2be-3369-9850-6f960fb206df",
                                        "glosses": [
                                            "Prolongement creux et conique, plus ou moins long, en forme de sac ou de casque, qu’on remarque dans les pétales et sépales de certaines plantes, comme les aconits, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10845429-b330-3676-93a2-94757e20c960",
                                        "entry_id": "877a06b2-d2be-3369-9850-6f960fb206df",
                                        "glosses": [
                                            "Synonyme de aconit napel (espèce de plantes)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1750362e-ee3e-3825-bec4-24602b13186e",
                                        "entry_id": "877a06b2-d2be-3369-9850-6f960fb206df",
                                        "glosses": [
                                            "Ce qui a, ou ce qui rappelle la forme d’un capuchon (couvercle d’un tuyau, de cheminée ou de locomotive ; fermeture d’un stylo…)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08e531b7-fb80-4b41-856b-30de843a4f9e",
                                                "sense_id": "1750362e-ee3e-3825-bec4-24602b13186e",
                                                "text": "Les deux grands volcans, le Popocatepetl et l'Iztaccihualt, que les Indiens appellent \"le mari et la femme\", avec leurs capuchons de neige, s’élevaient à l’horizon."
                                            },
                                            {
                                                "example_id": "5619953c-744a-454a-bfa8-821ac0598196",
                                                "sense_id": "1750362e-ee3e-3825-bec4-24602b13186e",
                                                "text": "L’espion, déguisé en agent d’entretien, descellait le capuchon [du flacon] censé être inviolable avec un outil de chirurgien tordu pour l’occasion, puis remplaçait le contenu par de l’urine « propre » stockée au préalable."
                                            },
                                            {
                                                "example_id": "06a7d2fc-4ecf-4b9f-8778-6f7d8f18c6fd",
                                                "sense_id": "1750362e-ee3e-3825-bec4-24602b13186e",
                                                "text": "On sait aujourd’hui que plus on vieillit, plus les télomères, ces petits capuchons qui prolongent pour les protéger les rubans d’ADN, raccourcissent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "587c18cc-1503-3b26-b3ac-b3c0016ffde1",
                                        "entry_id": "877a06b2-d2be-3369-9850-6f960fb206df",
                                        "glosses": [
                                            "Tôle conique que l'on dispose au dessus d'un conduit de cheminée et qui protège de l'entrée de l’eau on dit aussi mitre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ff7a8ee-09ad-3e1a-8929-821e31d8c001",
                                        "entry_id": "877a06b2-d2be-3369-9850-6f960fb206df",
                                        "glosses": [
                                            "Guerre du capuchon : Discorde qui éclata au XIIIᵉ siècle sur la longueur des capuchons des moines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6773c7d-8437-498b-b2a8-ad794a1a74cc",
                                                "sense_id": "1ff7a8ee-09ad-3e1a-8929-821e31d8c001",
                                                "text": "Il y eut autrefois une fameuse dispute entre les cordeliers au sujet du capuchon. (Trévoux) L’assemblée d’Aix-la-Chapelle de l’an 817 ordonna que le capuchon de chaque moine serait au moins de deux coudées."
