                        "cross_references": [
                            {
                                "target_word": "lymphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdef9bb7-de1b-3b04-876c-9cc2d4ee33d5",
                                        "entry_id": "6274f6f0-ae63-307e-977c-43f5f688e674",
                                        "glosses": [
                                            "Humeur transparente qui circule dans des vaisseaux qui lui sont propres et à laquelle on a longtemps attribué la cause de plusieurs maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89b7cdb-c5a5-452f-a29e-ca6d1cdd8c31",
                                                "sense_id": "bdef9bb7-de1b-3b04-876c-9cc2d4ee33d5",
                                                "text": "L'oeil du praticien ne voyait en moi qu'un monceau d'humeurs, triste amalgame de lymphe et de sang."
                                            },
                                            {
                                                "example_id": "188c9c8b-fde5-4a04-94eb-2e7e185dd4b9",
                                                "sense_id": "bdef9bb7-de1b-3b04-876c-9cc2d4ee33d5",
                                                "text": "Le corps de l’homme ne renferme aucun liquide inconnu ; on y trouve du sang, du chyle, de la lymphe, et ces trois fluides contiennent de l’albumine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "679bb89d-6efe-3567-a8d2-2f8310e7e6a5",
                                        "entry_id": "6274f6f0-ae63-307e-977c-43f5f688e674",
                                        "glosses": [
                                            "Un liquide jaunâtre de réaction alcaline, de composition analogue à celle du plasma sanguin, qui contient des globules blancs, mais pas de globules rouges, qui baigne les organes, plus pauvre en nutriments que le sang et plus riche en déchets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28aebe5a-7012-49a4-a86a-c488220f3a22",
                                                "sense_id": "679bb89d-6efe-3567-a8d2-2f8310e7e6a5",
                                                "text": "S'il est exact de considérer l’œdème comme une accumulation anormale de lymphe, on peut admettre que la lymphe périphérique est un liquide tout à fait clair, ne contenant aucune trace d'éléments figurés."
                                            },
                                            {
                                                "example_id": "dc98d5d2-9270-41de-b3e2-daef5275370c",
                                                "sense_id": "679bb89d-6efe-3567-a8d2-2f8310e7e6a5",
                                                "text": "La lymphe est un liquide clair ou jaune issu du sang - c’est la partie du sang contenant quelques globules blancs, mais pas de globules rouges... Elle est récupérée par tout un réseau de fins vaisseaux lymphatiques, peu visibles à l’œil nu ; ces vaisseaux acheminent la lymphe jusqu’aux ganglions lymphatiques, puis la transfèrent en retour dans les veines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ada3adc-ca18-3aea-8ad9-8d1bedb14d3d",
                                        "entry_id": "6274f6f0-ae63-307e-977c-43f5f688e674",
                                        "glosses": [
                                            "Humeur aqueuse qui circule dans les plantes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
