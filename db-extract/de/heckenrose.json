                "senses": [
                    {
                        "sense_id": "8f29610d-b511-36ab-b3e8-f4a909426ae1",
                        "entry_id": "a48e0123-81a0-3ff3-a6d5-5118927d8453",
                        "glosses": [
                            "wild wachsende und meist zwischen zwei und drei Metern hohe Rosenart in Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "725c870e-f8de-42d9-8ac6-451c87893800",
                                "sense_id": "8f29610d-b511-36ab-b3e8-f4a909426ae1",
                                "text": "„In der dornigen Heckenrose sind Vogelnester vor Katzen und anderen Feinden geschützt.“"
                            },
                            {
                                "example_id": "8a56699b-d361-42a2-9099-247c3fca1225",
                                "sense_id": "8f29610d-b511-36ab-b3e8-f4a909426ae1",
                                "text": "„Als der Frost nahte, schützte er die Heckenrosen durch Tüten aus starkem, talggetränktem Papier, die mit Wachslicht verklebt waren; sie sahen aus, als schwebten Zuckerhüte auf Stäben in der Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
