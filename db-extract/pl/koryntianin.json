                "senses": [
                    {
                        "sense_id": "45689922-9f2c-39b3-b2e2-3677670bd2fa",
                        "entry_id": "1c380ae6-942d-37fa-a3c2-24ceee45f955",
                        "glosses": [
                            "mieszkaniec starożytnego miasta-państwa Koryntu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b27089-2381-4787-97a8-24a05882e10e",
                                "sense_id": "45689922-9f2c-39b3-b2e2-3677670bd2fa",
                                "text": "Dopiero w 197 roku p.n.e. Koryntianom udało się zrzucić macedońską hegemonię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "862be560-f448-4b8f-a044-2fb50d902665",
                        "source_entry_id": "1c380ae6-942d-37fa-a3c2-24ceee45f955",
                        "source_sense_id": "45689922-9f2c-39b3-b2e2-3677670bd2fa",
                        "target_lang_word": "Corinthian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Corinthian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e4de460-a0cf-316d-9452-bd31dca6ca51",
                                        "entry_id": "afa7c01b-380e-30eb-9fa2-3bb2e7d37075",
                                        "glosses": [
                                            "Of or relating to Corinth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cce850ac-b354-37c2-aa73-7808cbe572f4",
                                        "entry_id": "afa7c01b-380e-30eb-9fa2-3bb2e7d37075",
                                        "glosses": [
                                            "Of the Corinthian order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945545d6-a2f4-4f13-9e4b-38334792596e",
                                                "sense_id": "cce850ac-b354-37c2-aa73-7808cbe572f4",
                                                "text": "The silver waters of the spring had long since disappeared, but there still were left a few of the Corinthian pillars, some stretched on the ground and overgrown with creeping-plants, while two or three yet remained erect, and showed how graceful the whole must have been."
                                            },
                                            {
                                                "example_id": "4b4f44a0-20d1-4b81-9bbc-087519296956",
                                                "sense_id": "cce850ac-b354-37c2-aa73-7808cbe572f4",
                                                "text": "The examples of the concave family in the Byzantine times are found principally either in large capitals founded on the Greek Corinthian, used chiefly for the nave pillars of churches, or in the small lateral shafts of the palaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe3aada-85ba-38ea-9050-8c4f48a687dd",
                                        "entry_id": "afa7c01b-380e-30eb-9fa2-3bb2e7d37075",
                                        "glosses": [
                                            "Elaborate, ornate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0a89c41-60f4-35b0-8d1c-8098c47fd644",
                                        "entry_id": "afa7c01b-380e-30eb-9fa2-3bb2e7d37075",
                                        "glosses": [
                                            "Debauched in character or practice; impure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ef6721e-4e23-4850-aa12-65d842571a51",
                                                "sense_id": "a0a89c41-60f4-35b0-8d1c-8098c47fd644",
                                                "text": "all her young Corinthian laity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43832690-5c0c-3d32-8c9f-6569c1544a4e",
                                        "entry_id": "afa7c01b-380e-30eb-9fa2-3bb2e7d37075",
                                        "glosses": [
                                            "Being a sporting event (originally in horse racing and yachting) restricted to gentleman amateurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a72c92f-9433-4ed7-8b1f-664057875420",
                                                "sense_id": "43832690-5c0c-3d32-8c9f-6569c1544a4e",
                                                "text": "Corinthian Stakes of 10 Guineas ... To be rode by Gentlemen."
                                            },
                                            {
                                                "example_id": "ebaa689b-82b4-4574-b19b-d238ca14e9fc",
                                                "sense_id": "43832690-5c0c-3d32-8c9f-6569c1544a4e",
                                                "text": "It was a condition of the race, that the horses should be ridden by gentlemen ... [I]t was submitted, that if none were to be reputed in the rank of gentlemen, whose wives had not been visited by Lady Clanricarde, the notion of a Corinthian Race might as well be given up at once, within twenty miles all round Portumna castle. It would amount, in fact, to a disgentilizing of two or three counties."
                                            },
                                            {
                                                "example_id": "dcabe753-c9df-47b6-8377-fce41f95354a",
                                                "sense_id": "43832690-5c0c-3d32-8c9f-6569c1544a4e",
                                                "text": "[W]e have horse races ... whereat the aforesaid noble animals are ridden by gentlemen, and if I err not are named \"Corinthian.\""
                                            },
                                            {
                                                "example_id": "3e6d5bd1-228c-483d-b77c-a0128d3eea8c",
                                                "sense_id": "43832690-5c0c-3d32-8c9f-6569c1544a4e",
                                                "text": "In Corinthian matches the yachts are steered and manned by gentlemen alone,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Corinthian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b4a5666-5b68-394a-a515-bdfdb8b3cf92",
