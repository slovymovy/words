                    "sense_definition": "Éprouver un vif dégoût ou un déplaisir marqué envers quelque chose ; ne pas aimer du tout.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>déteste</w> faire la queue pendant des heures au supermarché.",
                            "target_lang_translations": {
                                "en": "I <w>hate</w> queuing for hours at the supermarket.",
                                "ru": "Я <w>терпеть не могу</w> стоять в очереди по несколько часов в супермаркете.",
                                "nl": "Ik <w>heb een hekel aan</w> urenlang in de rij te staan bij de supermarkt.",
                                "de": "Ich <w>kann es nicht ausstehen</w>, stundenlang im Supermarkt Schlange zu stehen.",
                                "pl": "<w>Nie znoszę</w> stać w kolejce godzinami w supermarkecie.",
                                "it": "<w>Detesto</w> fare la fila per ore al supermercato.",
                                "cs": "<w>Nesnáším</w> stát ve frontě celé hodiny v supermarketu.",
                                "tr": "Süpermarkette saatlerce kuyrukta durmaktan <w>nefret ederim</w>.",
                                "es": "<w>Detesto</w> hacer cola durante horas en el supermercado.",
                                "zh": "我<w>讨厌</w>在超市排好几个小时的队。"
                            }
                        },
                        {
                            "text": "Mon frère <w>déteste</w> le café sans sucre et préfère toujours le thé.",
                            "target_lang_translations": {
                                "en": "My brother <w>hates</w> unsweetened coffee and always prefers tea.",
                                "ru": "Мой брат <w>не переносит</w> кофе без сахара и всегда предпочитает чай.",
                                "nl": "Mijn broer <w>heeft een hekel aan</w> koffie zonder suiker en drinkt altijd liever thee.",
                                "de": "Mein Bruder <w>mag</w> Kaffee ohne Zucker überhaupt nicht und trinkt immer lieber Tee.",
                                "pl": "Mój brat <w>nie znosi</w> kawy bez cukru i zawsze woli herbatę.",
                                "it": "Mio fratello <w>non sopporta</w> il caffè senza zucchero e preferisce sempre il tè.",
                                "cs": "Můj bratr <w>nesnáší</w> kávu bez cukru a vždycky dává přednost čaju.",
                                "tr": "Kardeşim şekersiz kahveye <w>tahammül edemez</w>, her zaman çayı tercih eder.",
                                "es": "Mi hermano <w>no soporta</w> el café sin azúcar y siempre prefiere el té.",
                                "zh": "我哥哥<w>讨厌</w>不加糖的咖啡，总是更喜欢喝茶。"
                            }
                        }
