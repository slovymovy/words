                        "sense_id": "2d4ef593-233a-3528-9f5f-54dbcbcec888",
                        "entry_id": "134d94f8-683e-3968-a54a-d84df60802d5",
                        "glosses": [
                            "Person, die in den Alpen auf einer Alm Milchwirtschaft betreibt, also Käse oder Butter herstellt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "d8740450-ca36-4076-87f3-5ac23f394ce0",
                                "sense_id": "2d4ef593-233a-3528-9f5f-54dbcbcec888",
                                "text": "Der Senner ist zuständig für das Zusammentreiben und Melken der Kühe und gegebenenfalls zur Herstellung von Milchprodukten (Butter, Käse); er betreibt Almwirtschaft üblicherweise in Alleinregie im Auftrag des Bauern."
                            }
                        ],
