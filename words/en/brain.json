                    "sense_definition": "An intelligent person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is the <w>brain</w> of the family and always gets good grades.",
                            "target_lang_translations": {
                                "ru": "Он — <w>мозг</w> семьи и всегда получает хорошие оценки.",
                                "pl": "On jest <w>mózgiem</w> rodziny i zawsze dostaje dobre oceny."
                            }
                        },
                        {
                            "text": "We need some real <w>brains</w> to figure out this complicated problem.",
                            "target_lang_translations": {
                                "ru": "Нам нужны настоящие <w>умы</w>, чтобы решить эту сложную проблему.",
                                "pl": "Potrzebujemy tęgich <w>głów</w>, żeby rozgryźć ten skomplikowany problem."
                            }
