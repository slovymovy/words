                                "target_senses": [
                                    {
                                        "sense_id": "f2a956cc-9682-31da-a35f-c54f1c838a69",
                                        "entry_id": "71f33776-359d-381c-9578-68f284783e16",
                                        "glosses": [
                                            "To attach or anchor (two or more parts) together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
