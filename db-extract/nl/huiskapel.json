                            {
                                "example_id": "194cf3e9-e5b7-4be5-a451-b8c259189736",
                                "sense_id": "fec8911a-212f-347f-bef3-fc95f7fb19f1",
                                "text": "Die zondag gingen de Rostovs zoals gewoonlijk naar de mis in de huiskapel van de Razoemovski's."
                            },
                            {
                                "example_id": "1dd1de7b-04fb-4584-b5de-35d1e33691c7",
                                "sense_id": "fec8911a-212f-347f-bef3-fc95f7fb19f1",
                                "text": "Dit Kleinseminarie Sint Pius X levert koorknapen en misdienaars voor de Sint-Pieter, en zelfs af en toe voor de missen die de paus in zijn eigen huiskapel opdraagt. Op dit kleinseminarie zou jarenlang misbruik hebben plaatsgevonden dat ook nog eens al die tijd zou zijn toegedekt."
                            }
