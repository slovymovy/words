                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec14f03-a653-4e3d-a18d-6e063bee8484",
                                "sense_id": "e563bb26-9e7c-3007-a783-dba1c60cc058",
                                "text": "„Die Stuntleute, die für die vier Hauptdarsteller von den explodierenden Wassertürmen weglaufen sollten, hatten spezielle Schutzanzüge an und wurden noch einmal zusätzlich im Nackenbereich mit einem Schutz-Gel eingeschmiert.“"
                            },
                            {
                                "example_id": "a8c124c7-7129-4252-9fee-4090fbd619d8",
                                "sense_id": "e563bb26-9e7c-3007-a783-dba1c60cc058",
                                "text": "„Sie waren nicht so wehleidig wie kanadische Stuntleute, die pro Tag 800 Dollar kassieren und dann für jeden Scheiß Stuntadjustments wollen.“"
                            },
                            {
                                "example_id": "4959f5a5-08a9-4c81-a89e-063bb64e30c5",
                                "sense_id": "e563bb26-9e7c-3007-a783-dba1c60cc058",
                                "text": "„Wenn außerhalb der Shows zweimal in die Luft geschossen wurde, dann war für die Stuntleute klar: alles stehen und liegen lassen und sofort hin!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
