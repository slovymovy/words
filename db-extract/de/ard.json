                        "sense_id": "bfa6e9f3-dded-32af-b83d-e8e16359fc28",
                        "entry_id": "dd8c7527-6fa8-388c-b2af-c02668a00739",
                        "glosses": [
                            "Arbeitsgemeinschaft der öffentlich-rechtlichen Rundfunkanstalten der Bundesrepublik Deutschland"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "333c31fd-7215-4ea5-a773-7e01be3ad731",
                                "sense_id": "bfa6e9f3-dded-32af-b83d-e8e16359fc28",
                                "text": "Derzeit besteht die ARD aus insgesamt neun Landesrundfunkanstalten."
                            },
                            {
                                "example_id": "0bd07da1-5728-414a-8c6b-16790e624208",
                                "sense_id": "bfa6e9f3-dded-32af-b83d-e8e16359fc28",
                                "text": "„Sie dürfen auch nicht in die Programmautonomie von ARD und ZDF eingreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8a9ab84-e5ef-30f4-a792-2becdba6abb6",
                        "entry_id": "dd8c7527-6fa8-388c-b2af-c02668a00739",
                        "glosses": [
