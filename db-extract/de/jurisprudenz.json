                "senses": [
                    {
                        "sense_id": "934d79ba-a704-3eec-8219-241c96afd8d6",
                        "entry_id": "4568ede1-da28-3b5e-b979-dc6af7c0b952",
                        "glosses": [
                            "Wissenschaft, die sich mit der Auslegung, der systematischen und begrifflichen Durchdringung gegenwärtiger und geschichtlicher juristischer Texte und sonstiger rechtlicher Quellen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6c8c755-a302-4258-bf48-f4d7f81cf325",
                                "sense_id": "934d79ba-a704-3eec-8219-241c96afd8d6",
                                "text": "Die Jurisprudenz ist seine neuentdeckte Leidenschaft."
                            },
                            {
                                "example_id": "bfc40d0d-ee43-440d-8bfe-5e5dbf3af238",
                                "sense_id": "934d79ba-a704-3eec-8219-241c96afd8d6",
                                "text": "Noch bevor es vom ersten nachchristlichen Jahrhundert an zum Ausbau einer wissenschaftlichen Jurisprudenz gekommen ist, haben Philosophen wie Platon und Aristoteles Fragen nach dem Wesen des Rechts und der Gerechtigkeit gestellt."
                            },
                            {
                                "example_id": "dafafe88-e28b-44d6-ae9f-68acf600ecdb",
                                "sense_id": "934d79ba-a704-3eec-8219-241c96afd8d6",
                                "text": "„Während Bertram bereits ein Studium der Jurisprudenz und der Philosophie absolviert hatte, lag die Schulzeit für die beiden anderen noch nicht weit zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9788355f-443a-40ca-9593-0b673bb701a2",
                        "source_entry_id": "4568ede1-da28-3b5e-b979-dc6af7c0b952",
