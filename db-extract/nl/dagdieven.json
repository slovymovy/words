                                "example_id": "f8aa4b48-80d9-49d2-b400-e5a0e06d0def",
                                "sense_id": "b2481744-956c-3b0e-a8c8-2346cd22eb9e",
                                "text": "Ze hebben de hele dag in het park gedagdiefd."
                            },
                            {
                                "example_id": "e9f6dbc6-e5a4-48f0-b640-20d648d71ac1",
                                "sense_id": "b2481744-956c-3b0e-a8c8-2346cd22eb9e",
                                "text": "Ik liep door de gang van een kantoor, het was in een modern gebouw en dus bestonden de wanden links en rechts uit glas,zodat ik overal naar binnen kon kijken en zodoende ook tersluiks kon waarnemen hoe al die pennelikkers zaten te dagdieven."
                            }
                        ]
                    }
