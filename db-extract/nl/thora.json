                ],
                "senses": [
                    {
                        "sense_id": "0a2e3350-e6a6-386e-979a-4110c99cb4df",
                        "entry_id": "0fafb4f1-61c3-3d71-b0f5-db98ad318acb",
                        "glosses": [
                            "de eerste vijf heilige boeken van de Tenach, die de kern van het joodse geloof uitmaken; dit zijn ook de eerste vijf boeken van het Oude Testament van de christenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee25bbb-4e8c-48f8-9782-ab0e748efae3",
                                "sense_id": "0a2e3350-e6a6-386e-979a-4110c99cb4df",
                                "text": "Centraal staat datgene wat Oosterhuis ziet als de kern van de Bijbelse boodschap: Thora (de eerste vijf boeken van het Oude Testament), psalmen en profeten."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cc39c16-63eb-3e48-9d3a-4657f6f16df7",
                        "entry_id": "0fafb4f1-61c3-3d71-b0f5-db98ad318acb",
                        "glosses": [
                            "het geheel van teksten die voor het joodse geloof gezaghebbend zijn: de Tenach, en soms ook de verdere uitleg in Misjna, Talmoed en Midrasj;"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "61825e84-53c8-3e18-8a8b-53bed1dc3bad",
                        "entry_id": "0fafb4f1-61c3-3d71-b0f5-db98ad318acb",
                        "glosses": [
                            "de hele joodse leer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b59f22-a264-426e-ab9b-67d509f32025",
                                "sense_id": "61825e84-53c8-3e18-8a8b-53bed1dc3bad",
                                "text": "In de joodse literatuur is er een theorie die als een gelijkenis een diepzinnige waarheid inhoudt, namelijk dat de Thora, die naar de geest eeuwig is, in verschillende tijdperken verschillende gedaanten aanneemt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9b86788-e89b-49e6-b9d7-faafed343b87",
                        "source_entry_id": "0fafb4f1-61c3-3d71-b0f5-db98ad318acb",
                        "source_sense_id": "0a2e3350-e6a6-386e-979a-4110c99cb4df",
                        "source_sense_description": "-3.",
                        "target_lang_word": "Thora",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thora",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb8a5bf5-492b-309e-af78-542b2fc0901e",
                                        "entry_id": "4c04a645-be5d-3362-b250-2fafcfa47ac7",
                                        "glosses": [
                                            "bedeutendster der drei Hauptteile des Tanach, welcher die fünf Bücher Mose umfasst"
                                        ],
                                        "tags": [
                                            "Judentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f912ac52-88bf-4aa4-b70f-ea4e5bcfd1c4",
                                                "sense_id": "eb8a5bf5-492b-309e-af78-542b2fc0901e",
                                                "text": "„\"Hiermit erklären wir öffentlich, dass die Klagen gegen die Schweizer Banken, die Deutsche Bank und/oder deren respektive Regierungen und andere Regierungen von unseren Rabbinern als ein Verstoß gegen die Regeln der heiligen Thora interpretiert werden\", heißt es in einer halbseitigen Anzeige in der \"New York Times\".[…] \"Die Thora\", der jüdische Gesetzeskodex, so der Wortlaut einer weiteren Anzeige vom World Council of Orthodox Jewish Communities (WCOJC) ebenfalls in der \"New York Times\", verlange, dass Juden \"in Frieden und mit Harmonie mit allen Völkern der Welt zusammenleben\".“"
                                            },
                                            {
                                                "example_id": "420a487f-9f7c-4c2d-ac2a-22912ec353c7",
                                                "sense_id": "eb8a5bf5-492b-309e-af78-542b2fc0901e",
                                                "text": "„Jeden Sabbat las er ihnen einen Abschnitt aus der Thora vor, der jüdischen Bibel, und erklärte ihnen nach den Auslegungen des Talmuds, was die heilige Schrift bedeutet.“"
                                            },
                                            {
                                                "example_id": "63bfa660-25c9-4bfd-815c-552ec3551f8c",
                                                "sense_id": "eb8a5bf5-492b-309e-af78-542b2fc0901e",
                                                "text": "„Wir müssen es schaffen, diese Ressentiments zu überwinden und Vertrauen zwischen beiden Gemeinschaften aufzubauen. Der erste Schritt sollte klarmachen, dass das Problem nicht der Koran oder die Thora oder die Bibel ist. Denn wie ich schon oft betont habe, ist nicht der Glaube das Problem, es sind vielmehr die Gläubigen und ihr Verhalten zueinander.“"
                                            },
                                            {
                                                "example_id": "3aca963e-4d09-4db9-913a-f6db78a23042",
                                                "sense_id": "eb8a5bf5-492b-309e-af78-542b2fc0901e",
                                                "text": "\"Zur Terminologie ist zu sagen, daß Thora sowohl Gottes gebietenden Willen als auch den Pentateuch, in dem man die gesetzlichen Bestandteile als die wichtigsten betrachtete, bezeichnen kann. Im Kanon der Juden hat die Thora bei weitem den ersten Rang gegenüber den Propheten und \"Schriften\", die nur als Ergänzung zu ihr verstanden wurden …\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Thora",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c21dfb67-15e1-31b1-99ac-7ba82e4c98ff",
                                        "entry_id": "07d6710e-f474-3cfe-ba67-34a762c3151d",
                                        "glosses": [
                                            "Bezeichnung eines Asteroiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdf11f8-8793-4540-9403-83322e50a888",
                                                "sense_id": "c21dfb67-15e1-31b1-99ac-7ba82e4c98ff",
                                                "text": "\"Thora ist ein Asteroid des Asteroiden-Hauptgürtels, der am 6. Oktober 1890 von Johann Palisa am Observatorium von Wien entdeckt wurde.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Thora",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "227440ff-e78a-343c-b1a7-2a8cd821aa8e",
                                        "entry_id": "80bc835e-6a72-3cb4-bdfc-1f1ab1c8acac",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a12d8c-cafc-4c0e-8479-7a5cb9823b19",
                                                "sense_id": "227440ff-e78a-343c-b1a7-2a8cd821aa8e",
                                                "text": "„Nach wie vor spielen Silke-Thora Matthies und Christian Köhn auf den Konzertpodien als Solisten und als Klavierduo.“"
                                            },
                                            {
                                                "example_id": "47b3cf3f-19b8-44f6-a39b-76e67179b7c7",
                                                "sense_id": "227440ff-e78a-343c-b1a7-2a8cd821aa8e",
                                                "text": "„Für ihre Leistung in dem Film Ghost World aus dem Jahr 2001 wurde Thora Birch von vielen Kritikern gelobt und mit zahlreichen Preisen ausgezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6768372-d0b9-470e-be66-582dcf1c92d9",
                        "source_entry_id": "0fafb4f1-61c3-3d71-b0f5-db98ad318acb",
