                    },
                    {
                        "form_id": "c94462b7-5730-42c4-8701-4c4c7d98bfc7",
                        "entry_id": "2eb6c193-ee3e-3c07-b584-3c52232ba58e",
                        "tags": [
                            "rare"
                        ],
                        "form": "marcasite"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c197e90f-5ec0-3856-8ede-4496af4d7494",
                        "entry_id": "2eb6c193-ee3e-3c07-b584-3c52232ba58e",
                        "glosses": [
                            "Minéral composé de sulfure de fer, très courant dans la nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f05b3a-b64f-430b-b41e-b80ba10bfecf",
                                "sense_id": "c197e90f-5ec0-3856-8ede-4496af4d7494",
                                "text": "Elle chante en cousant, épingle à son cou un nœud où le satin s’enlace à la dentelle, autour d’un motif de plomb qui imite la marcassite."
                            },
                            {
                                "example_id": "3e66c38e-5064-44c6-b10b-212a7a26ffa0",
                                "sense_id": "c197e90f-5ec0-3856-8ede-4496af4d7494",
                                "text": "La patrie de la verroterie est la Tchécoslovaquie où l'on fabrique à Turnow un strass appelé improprement « marcassite »."
                            },
                            {
                                "example_id": "804fd831-13bb-4123-9419-b8a9db53704e",
                                "sense_id": "c197e90f-5ec0-3856-8ede-4496af4d7494",
                                "text": "On trouve dans la commune de Vic-sur-Saint-Chartier, des pyrites martiales cubiques ou marcassites martiales, des pyrites martiales octaèdres groupées et des pyrites martiales informes."
                            }
                        ]
                    }
                ],
