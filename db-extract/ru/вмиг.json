        "ru-extract.jsonl": [
            {
                "entry_id": "607c0497-ed98-3aa4-911c-93b79c4ecced",
                "word": "вмиг",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                        "entry_id": "607c0497-ed98-3aa4-911c-93b79c4ecced",
                        "glosses": [
                            "разг. очень быстро, тотчас"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75455988-15ac-407c-8177-6476ae294069",
                                "sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                                "text": "Вмиг руки вцепились в гардину и сорвали её вместе с карнизом, отчего солнце хлынуло в затенённую комнату."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15909d88-2510-44b4-b1ee-9c98ad7dec38",
                        "source_entry_id": "607c0497-ed98-3aa4-911c-93b79c4ecced",
                        "source_sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                        "target_lang_word": "instantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "At once; without delay."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dbbe4fe-c6f4-4d73-bb8d-203e0763abac",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "When the neighbours' dog barked, ours instantly replied with a howl."
                                            },
                                            {
                                                "example_id": "4ae2c204-4ac7-453b-a208-b8fa6f357cb0",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            },
                                            {
                                                "example_id": "9349c36a-fb4f-4761-9ef7-1856fe301210",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "The most persistent tormentor was Alex Oxlade-Chamberlain, who scored a hat-trick in last month’s corresponding fixture in Iceland. His ability to run at defences is instantly striking, but it is his clever use of possession that has persuaded some shrewd judges that he is an even better prospect than Theo Walcott."
                                            },
                                            {
                                                "example_id": "4611fc62-9406-4408-b923-401316f3da8d",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "But signalman Bridges was never to answer driver Gimbert's desperate question. A deafening, massive blast blew the wagon to shreds, the 44 high-explosive bombs exploding like simultaneous hits from the aircraft they should have been dropped from. The station was instantly reduced to bits of debris, and the line to a huge crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "Urgently; with insistence."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900f91af-61dd-45bd-9c78-ad26729c6bf4",
                                                "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                                "text": "Sir, my lord would instantly speak with you."
                                            },
                                            {
                                                "example_id": "9574b77c-f7a4-40d3-ba32-d95b887e5c23",
                                                "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                                "text": "Theoxena although she were instantly urged thereunto, could never be induced to marry againe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b35bb64-8168-3d4a-a57e-3a89f0152efe",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "At the same time."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c1356c6-5e50-4411-96be-d5838ecd66a6",
                                                "sense_id": "2b35bb64-8168-3d4a-a57e-3a89f0152efe",
                                                "text": "As if he mastred there a double spirit\nOf teaching, and of learning instantly"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "instantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "882aa7d3-72cd-3f12-b068-859e7bea983a",
                                        "entry_id": "1d3ee2f0-128a-33c6-9729-7a16cb2c5e81",
                                        "glosses": [
                                            "As soon as, directly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16a3c95-e0b6-4b96-a123-22ee09f61f59",
                                                "sense_id": "882aa7d3-72cd-3f12-b068-859e7bea983a",
                                                "text": "I phoned instantly I heard you were back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c594681d-e401-42b0-b39e-87d24987bbd9",
                        "source_entry_id": "607c0497-ed98-3aa4-911c-93b79c4ecced",
                        "source_sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                        "target_lang_word": "in an instant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2bc6240c-107e-40d4-9be3-0845decc8438",
                        "source_entry_id": "607c0497-ed98-3aa4-911c-93b79c4ecced",
                        "source_sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                        "target_lang_word": "in a moment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4ba2a119-5640-4321-a5f2-2a4f9cb460ac",
                        "source_entry_id": "607c0497-ed98-3aa4-911c-93b79c4ecced",
                        "source_sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                        "target_lang_word": "in a flash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in a flash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7117209b-e3df-34c0-b72e-f96b08dacae5",
                                        "entry_id": "b5048cc3-ff77-3d50-b6ec-868d55f36e36",
                                        "glosses": [
                                            "Instantaneously; very quickly; in almost no time."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7c8afa-acbc-4227-a95e-200bb0c0f284",
                                                "sense_id": "7117209b-e3df-34c0-b72e-f96b08dacae5",
                                                "text": "It happened so fast that it was all over in a flash."
                                            },
                                            {
                                                "example_id": "d496f1cf-7ef7-4e65-aa50-d06fb5ae9588",
                                                "sense_id": "7117209b-e3df-34c0-b72e-f96b08dacae5",
                                                "text": "Therefore its completeness, though instantaneous, was total. His realisation was in a flash, but it did not vanish like a flash."
                                            },
                                            {
                                                "example_id": "f1e15062-3f54-4e76-ad46-c6137a571e59",
                                                "sense_id": "7117209b-e3df-34c0-b72e-f96b08dacae5",
                                                "text": "“I bet you want to come and live here in this big house in the lap of luxury with me and Biggie, don’t you?”\n“NO,” replied the boy in a flash."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5235fbb7-1a5f-4262-98e7-6b9df1d484b0",
                        "source_entry_id": "607c0497-ed98-3aa4-911c-93b79c4ecced",
                        "source_sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                        "target_lang_word": "in a twinkling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "100323f4-cf24-4566-bc60-6ab825885dc0",
                        "source_entry_id": "607c0497-ed98-3aa4-911c-93b79c4ecced",
                        "source_sense_id": "320b8516-8641-3a43-a7d5-1ef34d9ce29c",
                        "target_lang_word": "in no time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in no time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "056576cd-fbe4-3990-a2f9-2e0a03ffac1b",
                                        "entry_id": "07dd7f66-6d03-3e55-83b9-c6d9990dea37",
                                        "glosses": [
                                            "Very soon."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e77c197-6fce-437f-867a-38dd23d5fb59",
                                                "sense_id": "056576cd-fbe4-3990-a2f9-2e0a03ffac1b",
                                                "text": "Just give me a ring and I'll be over in no time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66edeee6-be7d-33a8-aedf-89406227c783",
                                        "entry_id": "07dd7f66-6d03-3e55-83b9-c6d9990dea37",
                                        "glosses": [
                                            "Very quickly."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f15a5a59-8f1c-4bfa-96a3-d7d6297cebfc",
                                                "sense_id": "66edeee6-be7d-33a8-aedf-89406227c783",
                                                "text": "My hopes wa'n't disappointed. I never saw clams thicker than they was along them inshore flats. I filled my dreener in no time, and then it come to me that 'twouldn't be a bad idee to get a lot more, take 'em with me to Wellmouth, and peddle 'em out. Clams was fairly scarce over that side of the bay and ought to fetch a fair price."
                                            },
                                            {
                                                "example_id": "7d3fdcd7-0257-4228-94cf-e103427c64f0",
                                                "sense_id": "66edeee6-be7d-33a8-aedf-89406227c783",
                                                "text": "Neil Lennon and his players have, in no time at all, roared back from trailing Rangers by 15 points in November to ending the year two points clear."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "in no time",
                                "target_lang_code": "en",
                                "target_senses": [
