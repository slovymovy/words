                            {
                                "example_id": "0106e482-3a2a-4e17-ad4e-89ca856915c2",
                                "sense_id": "4c0c8670-f676-382e-a5da-7e072d76e749",
                                "text": "De laatste grote peiling van het persbureau Reuters en peilingbureau Ipsos States of the Nation wijst op een grote winstkans voor Clinton. Volgens de peilers is de kans dat Trump het onderspit delft 90 procent."
                            },
                            {
                                "example_id": "d3dbb78b-4e7b-41ec-810d-195c7d356ed7",
                                "sense_id": "4c0c8670-f676-382e-a5da-7e072d76e749",
                                "text": "Bondscoach Groener hield door de verspeelde winstkans gemengde gevoelens over aan de remise tegen Zweden, de nummer twee van het EK in 2010."
                            },
                            {
                                "example_id": "59cbd56b-b411-4492-acf3-24f45a7e97b2",
                                "sense_id": "4c0c8670-f676-382e-a5da-7e072d76e749",
                                "text": "Wie meedoet aan de BankGiro Loterij heeft de meeste kans om een prijs van een miljoen euro in de wacht te slepen. De kans op zo'n grote prijs is wel erg klein: 1 op 790.499. De Consumentenbond heeft onderzoek gedaan naar de winstkans bij grote loterijen."
                            }
