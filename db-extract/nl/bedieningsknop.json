                "senses": [
                    {
                        "sense_id": "96cf2a5f-4bb7-33bd-b0b9-bb94bce96b09",
                        "entry_id": "c93ad09f-3461-336b-8d12-b17a9afe3322",
                        "glosses": [
                            "knop waarmee men een apparaat kan laten werken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15609fee-a25c-4b76-a820-47aca71c5eb8",
                                "sense_id": "96cf2a5f-4bb7-33bd-b0b9-bb94bce96b09",
                                "text": "De elektrische bedieningsknop, links van de openslaande deuren, leek te haperen - tot ik ontdekte dat het zonnescherm al omhoog was, keurig mechanisch opgerold binnen z'n aluminium lijst."
                            },
                            {
                                "example_id": "a2f287d6-29a9-4035-9902-df3afe36ade8",
                                "sense_id": "96cf2a5f-4bb7-33bd-b0b9-bb94bce96b09",
                                "text": "Deze Audi neemt in navolging van de A8 en A7 afscheid van het MMI-systeem, dat een centrale bedieningsknop voor het infotainment tussen de voorstoelen had. In plaats daarvan werkt het nu met een touchscreen of met gesproken commando's. Wie de auto koopt, krijgt maximaal zes keer een halfjaarlijkse update van de navigatiekaarten. Daarna moet er voor deze service worden betaald."
                            }
                        ]
                    }
