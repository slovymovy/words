                        "entry_id": "40fd2afa-1f96-3ae4-bb8a-c407a2245cee",
                        "glosses": [
                            "Dégrossir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21686ccc-befb-44f5-aaae-db245bd5f3b9",
                                "sense_id": "1c945815-7acc-31b9-a1e0-2c4d6b773d44",
                                "text": "Piece à dégaucher le bois, & l’ongle qui empesche que les tenons ne ioignent bien."
                            },
                            {
                                "example_id": "981e1190-745d-4a30-a2a1-9309fcdc9cd3",
                                "sense_id": "1c945815-7acc-31b9-a1e0-2c4d6b773d44",
                                "text": "Un moyen qui sert aussi à vérifier l’équerre de la planche est de dégaucher celle-ci avec l’arbre de trousse."
                            }
                        ]
                    },
                    {
                        "sense_id": "96db8d2f-afcf-3049-884e-ea20745f2211",
