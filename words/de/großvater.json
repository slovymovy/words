                    "sense_id": "6ab31dab-8e3f-3d8a-ae43-9c37f706d0b6",
                    "sense_definition": "Vater des Vaters oder der Mutter",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verwandtschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein <w>Großvater</w> erzählt uns oft Geschichten aus seiner eigenen Jugend.",
                            "target_lang_translations": {
                                "en": "My <w>grandfather</w> often tells us stories from his own youth.",
                                "ru": "Мой <w>дедушка</w> часто рассказывает нам истории из своей молодости.",
                                "nl": "Mijn <w>grootvader</w> vertelt ons vaak verhalen uit zijn eigen jeugd.",
                                "pl": "Mój <w>dziadek</w> często opowiada nam historie ze swojej młodości.",
                                "fr": "Mon <w>grand-père</w> nous raconte souvent des histoires de sa propre jeunesse.",
                                "it": "Mio <w>nonno</w> ci racconta spesso storie della sua giovinezza.",
                                "cs": "Můj <w>dědeček</w> nám často vypráví příběhy ze svého vlastního mládí.",
                                "tr": "<w>Büyükbabam</w> bize sık sık kendi gençliğinden hikâyeler anlatır.",
                                "es": "Mi <w>abuelo</w> a menudo nos cuenta historias de su propia juventud.",
                                "zh": "我的<w>祖父</w>经常给我们讲他自己年轻时的故事。"
                            }
                        },
                        {
                            "text": "Am Wochenende besuchen wir meinen <w>Großvater</w> und trinken gemeinsam Kaffee.",
                            "target_lang_translations": {
                                "en": "On the weekend, we visit my <w>grandfather</w> and drink coffee together.",
                                "ru": "На выходных мы навещаем моего <w>дедушку</w> и вместе пьём кофе.",
                                "nl": "In het weekend bezoeken we mijn <w>grootvader</w> en drinken we samen koffie.",
                                "pl": "W weekend odwiedzamy mojego <w>dziadka</w> i pijemy razem kawę.",
                                "fr": "Le week-end, nous rendons visite à mon <w>grand-père</w> et buvons un café ensemble.",
                                "it": "Nel fine settimana andiamo a trovare mio <w>nonno</w> e beviamo un caffè insieme.",
                                "cs": "O víkendu navštívíme mého <w>dědečka</w> a dáme si spolu kávu.",
                                "tr": "Hafta sonu <w>büyükbabamı</w> ziyaret edip birlikte kahve içiyoruz.",
                                "es": "El fin de semana visitamos a mi <w>abuelo</w> y tomamos café juntos.",
                                "zh": "周末我们会去看望我的<w>祖父</w>，一起喝咖啡。"
                            }
                        }
                    ],
