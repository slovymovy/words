                "senses": [
                    {
                        "sense_id": "c57e0662-2673-31f4-a8e0-fdaa8ffa1c57",
                        "entry_id": "9f9fb9c9-53ba-3487-9f02-eb307c64af06",
                        "glosses": [
                            "klassieke taal en een van de officiële talen van India"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9c3baf1a-3c69-41e1-a57e-aaacde35ee78",
                                "sense_id": "c57e0662-2673-31f4-a8e0-fdaa8ffa1c57",
                                "text": "Veel mensen vinden het Sanskriet een mooie taal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90f9dca1-6fd6-4b73-9c42-71d9e1d1a3e7",
                        "source_entry_id": "9f9fb9c9-53ba-3487-9f02-eb307c64af06",
                        "source_sense_id": "c57e0662-2673-31f4-a8e0-fdaa8ffa1c57",
                        "source_sense_description": "klassieke taal en een van de officiële talen van India",
                        "target_lang_word": "Sanskrit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sanskrit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b060a637-f45b-36c2-ad84-b979b2fb7273",
                                        "entry_id": "ef4cd456-ac05-3673-8a85-1cb924282672",
                                        "glosses": [
                                            "eine alte indogermanische Sprache; Sprache der indischen Brahmanen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "020c518c-0c0d-41c9-b999-6716b4ad0668",
                                                "sense_id": "b060a637-f45b-36c2-ad84-b979b2fb7273",
                                                "text": "Sanskrit ist heute ebenso wie Latein eine weitgehend „tote“ Sprache."
                                            },
                                            {
                                                "example_id": "1148b625-ea3a-4519-847a-589e3ec0dd4b",
                                                "sense_id": "b060a637-f45b-36c2-ad84-b979b2fb7273",
                                                "text": "„Als die aufgeklärte Anthropologie um 1800 entdeckte, dass es sich bei den ›Zigeunern‹ um ein aus Indien stammendes Volk mit einer eigenen, aus dem Sanskrit entwickelten Sprache handelt, setzten zwei gegenläufige Tendenzen ein, die sich in der Mitte des 19. Jahrhunderts in der Ethnographie kreuzten.“"
                                            },
                                            {
                                                "example_id": "00d7b9f0-5e6f-4da4-89ac-52e2d33bea4a",
                                                "sense_id": "b060a637-f45b-36c2-ad84-b979b2fb7273",
                                                "text": "„Die Sprache der Rigvedas liegt in ihrer Entwicklung noch vor dem Sanskrit, einer später erschaffenen Kunstsprache, in der zum Beispiel das Kamasutra verfasst wurde, ein praktischer Leitfaden, wie man eine Frau anfasst, ohne sie dabei umzubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d6051e6-5b78-43fa-9b24-c32532753aed",
                        "source_entry_id": "9f9fb9c9-53ba-3487-9f02-eb307c64af06",
                        "source_sense_id": "c57e0662-2673-31f4-a8e0-fdaa8ffa1c57",
                        "source_sense_description": "klassieke taal en een van de officiële talen van India",
                        "target_lang_word": "Sanskrit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sanskrit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58deb8a8-6de6-379d-a889-f6ab5ad6b962",
                                        "entry_id": "67e1bdcd-f6bc-39f6-91e1-1711745077b6",
                                        "glosses": [
                                            "A classical Indo-European language of South Asia, which is the liturgical language of Hinduism, Buddhism, Sikhism, Jainism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f9b57ff-9297-42db-bf02-eef63c8e2fd0",
                                                "sense_id": "58deb8a8-6de6-379d-a889-f6ab5ad6b962",
                                                "text": "The Sanscrit language, whatever be its antiquity, is of a wonderful structure; more perfect than the Greek, more copious than the Latin, and more exquisitely refined than either, yet bearing to both of them a stronger affinity, both in the roots of verbs and in the forms of grammar, than could possibly have been produced by accident; so strong indeed, that no philologer could examine them all three, without believing them to have sprung from some common source, which, perhaps no longer exists...\n- Sir William Jones, 2 February, 1786, at the Asiatick Society."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sanskrit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d1f77f2-3a7f-387a-b0c9-8b94bf50c2e9",
                                        "entry_id": "b1f1bcff-153b-334a-9d78-42b9f3456818",
                                        "glosses": [
                                            "Relating to Sanskrit."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0df7ac36-bcbf-490e-abee-5172b483475b",
                                                "sense_id": "4d1f77f2-3a7f-387a-b0c9-8b94bf50c2e9",
                                                "text": "Sanskrit, Greek, Slavonic, Germanic, and Celtic names were all of this type, but there are also shorter names formed from the compound ones; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
