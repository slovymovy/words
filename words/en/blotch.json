{
    "word_family": [
        "blotchy",
        "blotched"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aedd6397-ee19-3e40-a448-fb60d2df1415",
                    "sense_definition": "An uneven patch of color or discoloration on a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The white paint on the wall was covered in dark <w>blotches</w> after the leak.",
                            "target_lang_translations": {
                                "nl": "De witte verf op de muur zat na het lek onder de donkere <w>vlekken</w>."
                            }
                        },
                        {
                            "text": "She noticed red <w>blotches</w> on her skin after being in the sun.",
                            "target_lang_translations": {
                                "nl": "Ze merkte rode <w>vlekken</w> op haar huid op nadat ze in de zon was geweest."
                            }
                        }
                    ],
                    "synonyms": [
                        "stain",
                        "spot",
                        "patch",
                        "mark"
                    ],
                    "common_phrases": [
                        "red blotches"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een onregelmatige vlek of verkleuring op een oppervlak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vlek",
                                "target_lang_sense_clarification": "algemene term voor een onregelmatige verkleuring"
                            },
                            {
                                "target_lang_word": "plek",
                                "target_lang_sense_clarification": "een specifieke zone of vlek op een oppervlak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67b278fb-8a09-30e7-a226-7197bcfdedf5",
                    "sense_definition": "A dark or inflamed spot on the skin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the <w>blotches</w> on the patient's arm.",
                            "target_lang_translations": {
                                "nl": "De dokter onderzocht de <w>huidvlekken</w> op de arm van de patiënt."
                            }
                        },
                        {
                            "text": "He tried to hide the <w>blotches</w> on his face with makeup.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde de <w>vlekken</w> in zijn gezicht te verbergen met make-up."
                            }
                        }
                    ],
                    "synonyms": [
                        "pustule",
                        "blemish"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een donkere of ontstoken plek op de huid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "huidvlek",
                                "target_lang_sense_clarification": "specifiek voor verkleuringen op de huid"
                            },
                            {
                                "target_lang_word": "uitslag",
                                "target_lang_sense_clarification": "wanneer de vlekken wijzen op een medische reactie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec5790a9-961a-34eb-9356-ceedf0b0c9dd",
                    "sense_definition": "A blemish or stain on one's reputation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "blemish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal left a permanent <w>blotch</w> on his otherwise clean record.",
                            "target_lang_translations": {
                                "nl": "Het schandaal liet een blijvende <w>smet</w> achter op zijn verder schone blazoen."
                            }
                        },
                        {
                            "text": "Poverty is often seen as a <w>blotch</w> on a wealthy society.",
                            "target_lang_translations": {
                                "nl": "Armoede wordt vaak gezien als een <w>smet</w> op een welvarende samenleving."
                            }
                        }
                    ],
                    "synonyms": [
                        "stain",
                        "blemish",
                        "tarnish"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een smet of beschadiging op iemands reputatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "smet",
                                "target_lang_sense_clarification": "figuurlijk voor een beschadiging van de goede naam"
                            },
                            {
                                "target_lang_word": "vlek",
                                "target_lang_sense_clarification": "figuurlijk voor een negatief punt op een reputatie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d00e562-7e70-32d0-bf44-71673307ccd2",
                    "sense_definition": "To mark or cover something with uneven spots or patches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spilled ink began to <w>blotch</w> the important document.",
                            "target_lang_translations": {
                                "nl": "De gemorste inkt begon het belangrijke document te <w>bevlekken</w>."
                            }
                        },
                        {
                            "text": "Careless painting will <w>blotch</w> the surface of the wood.",
                            "target_lang_translations": {
                                "nl": "Slordig schilderwerk zal het oppervlak van het hout <w>besmeuren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stain",
                        "spot",
                        "smear"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets markeren of bedekken met onregelmatige vlekken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bevlekken",
                                "target_lang_sense_clarification": "het maken van vlekken op iets"
                            },
                            {
                                "target_lang_word": "besmeuren",
                                "target_lang_sense_clarification": "het ontsieren van een oppervlak met vlekken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48375ecb-ef7c-3f77-afdd-2a56eb69d6b0",
                    "sense_definition": "To develop uneven spots or patches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain types of wood will <w>blotch</w> when you apply a dark stain.",
                            "target_lang_translations": {
                                "nl": "Bepaalde houtsoorten worden <w>vlekkerig</w> als je er een donkere beits op aanbrengt."
                            }
                        },
                        {
                            "text": "Her skin tends to <w>blotch</w> whenever she feels nervous.",
                            "target_lang_translations": {
                                "nl": "Haar huid wordt snel <w>vlekkerig</w> wanneer ze zich nerveus voelt."
                            }
                        }
                    ],
                    "synonyms": [
                        "spot"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het ontwikkelen van onregelmatige vlekken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vlekkerig worden",
                                "target_lang_sense_clarification": "het proces waarbij vlekken ontstaan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}