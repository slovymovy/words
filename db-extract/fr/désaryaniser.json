                "senses": [
                    {
                        "sense_id": "f8314e75-d530-310b-8a60-affee439c7eb",
                        "entry_id": "cc5e8446-0a37-306b-9570-caa481c5ad3d",
                        "glosses": [
                            "Faire perdre son caractère aryen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c683788-1838-4fb1-a83c-d07074edf04f",
                                "sense_id": "f8314e75-d530-310b-8a60-affee439c7eb",
                                "text": "Rejetant les à-priori de ses pairs, il désaryanise la fonction mythologique en montrant qu'elle est inhérente à l'esprit humain."
                            },
                            {
                                "example_id": "98fb9dbf-84dc-4347-a834-5eec47787950",
                                "sense_id": "f8314e75-d530-310b-8a60-affee439c7eb",
                                "text": "L'élite fait flèche de tout bois pour féminiser, démasculiniser, désaryaniser, métisser les peuples, et en faire des loukoums de l'esprit, de la chair manipulable par Hollywood, car croyez-vous que le rose et ces couleurs bariolées soient un hasard ?"
                            },
                            {
                                "example_id": "526bb412-42f9-4e1a-89b0-3ac5aab29bdb",
                                "sense_id": "f8314e75-d530-310b-8a60-affee439c7eb",
                                "text": "Zemmour pariait sur la défaite de l'Allemagne désaryanisée."
                            }
                        ]
                    }
