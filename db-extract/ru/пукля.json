                        "form": "пу́кле"
                    },
                    {
                        "form_id": "f1406981-1c01-4454-a2ec-a86e50b3055a",
                        "entry_id": "d0feb73a-bd72-3341-830a-35371450b959",
                        "tags": [
                            "plural",
