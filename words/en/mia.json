                    "frequency": "VeryLow",
                    "semantic_group_id": "language_group",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "The professor specializes in <w>MIA</w> linguistics and ancient texts.",
                            "target_lang_translations": {
