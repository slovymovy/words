                        "glosses": [
                            "S’amuser avec de petites choses, diminutif de amuser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8620d9-73ba-4395-9f97-23bfdb8d2e5a",
                                "sense_id": "8d5f2b73-56cf-3c67-a0c6-fa415de359ec",
                                "text": "Si j’ai une vieillesse chic et un peu propre, si je m’amusote encore entre mes repas, si j’ai pu reprendre un peu de mes anciennes habitudes, c’est parce que je t’ai écouté."
                            },
                            {
                                "example_id": "2c492f75-5f10-4cfb-9354-b8384a076d43",
                                "sense_id": "8d5f2b73-56cf-3c67-a0c6-fa415de359ec",
                                "text": "Et voilà : nous sommes assis au milieu des autres, au soleil, à une terrasse des Boulevards; nous daignons prendre un bock, un quinquina, nous amusoter avec les petites choses gentilles de la vie d’ici."
                            }
                        ]
                    }
