                    {
                        "translation_id": "901139fd-7c76-44a7-9f03-3210e27b0272",
                        "source_entry_id": "3991bdda-b84f-3ca4-9f65-2cb9282c51db",
                        "source_sense_id": "9ee7e9c2-dec4-3493-818e-05f271227d4b",
                        "source_sense_description": "Relatif à l’osmose",
                        "target_lang_word": "осмотический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "осмотический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b4cff822-d5d4-30c8-b38c-ef6c067b7f6d",
                                        "entry_id": "aa92be4e-3d89-33f0-8e26-80cb5110212e",
                                        "glosses": [
                                            "физ., мед. связанный по знач. с сущ.: осмос, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed509658-84fc-4178-a3fa-72e6be1b7568",
                                                "sense_id": "b4cff822-d5d4-30c8-b38c-ef6c067b7f6d",
                                                "text": "Важная роль в этой борьбе принадлежит внутриклеточному пищеварению, столь распространённому у корненожек и инфузорий, и присущему даже простейшим, питающимся осмотическим путём."
                                            },
                                            {
                                                "example_id": "54110218-c108-4426-9a5e-20b5a2400a5d",
                                                "sense_id": "b4cff822-d5d4-30c8-b38c-ef6c067b7f6d",
                                                "text": "К настоящему времени из бактериальных масс получены путём разрушения дистиллированной водой (так называемого «осмотического шока») фильтруемые частицы, которые при их культивировании снова вырастают в те же бактериальные массы."
                                            },
                                            {
                                                "example_id": "89b1594e-2f82-4009-a341-ef15b0aefb76",
                                                "sense_id": "b4cff822-d5d4-30c8-b38c-ef6c067b7f6d",
                                                "text": "Это явление носит название осмоса, а избыточное давление со стороны менее концентрированного раствора называют осмотическим давлением."
                                            },
                                            {
                                                "example_id": "89f577ee-538c-4205-b37b-dc3b5fc5bd4b",
                                                "sense_id": "b4cff822-d5d4-30c8-b38c-ef6c067b7f6d",
                                                "text": "Именно благодаря осмотическому давлению растения впитывают воду, а ткани глаза, соприкасаясь с пресной водой, растягиваются и вызывают болезненное ощущение."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
