        "fr-extract.jsonl": [
            {
                "entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
                "word": "ingrédient",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "57bc00ac-e7dd-42d8-b4a2-53b5f7e32f1c",
                        "entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
                        "tags": [
                            "plural"
                        ],
                        "form": "ingrédients"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a619c0bf-d37b-38f1-af8b-01dd06d3b3f9",
                        "entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
                        "glosses": [
                            "Chacune des substances, y compris les additifs alimentaires, qui entrent dans la composition d’un médicament, d’une boisson, d’un mets ou de quelque autre mélange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e171b8c-3952-4185-901b-a24a03497170",
                                "sense_id": "a619c0bf-d37b-38f1-af8b-01dd06d3b3f9",
                                "text": "Végétariens et végétaliens seront heureux d'apprendre que les veloutés, gâteaux et la plupart des wraps sont réalisés avec des ingrédients d’origine végétale."
                            },
                            {
                                "example_id": "44a2481f-95a8-4482-9bfd-739ca25a34e4",
                                "sense_id": "a619c0bf-d37b-38f1-af8b-01dd06d3b3f9",
                                "text": "Pour le faumage façon « ricotta », mixez les ingrédients jusqu'à obtenir une consistance relativement lisse. Goûtez afin d'ajuster l'assaisonnement."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad4b9ce5-00ee-3bdb-9438-8db4ebd65597",
                        "entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
                        "glosses": [
                            "Élément nécessaire à un état ou à la réussite d'une activité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "78549b77-92d8-48d0-b279-f6ffef851672",
                                "sense_id": "ad4b9ce5-00ee-3bdb-9438-8db4ebd65597",
                                "text": "Depuis Ulysse et Pénélope, depuis Adam et Ève, nous nous racontons, de génération en génération, que l'amour, que le couple, est un ingrédient du bonheur."
                            },
                            {
                                "example_id": "f4494cee-89fc-465f-a7c0-6f7e5f22017d",
                                "sense_id": "ad4b9ce5-00ee-3bdb-9438-8db4ebd65597",
                                "text": "Au-delà d'une bonne infrastructure logicielle, les deux ingrédients essentiels du télétravail, ce sont la souplesse et la confiance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52666756-bfa3-419a-97a1-f56474e044c4",
                        "source_entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
                        "source_sense_description": "Chacune des substances, qui entrent dans la composition d’un médicament etc.",
                        "target_lang_word": "Zutat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zutat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "daac76f0-6ed1-3e8f-a17c-b56cca451760",
                                        "entry_id": "8718be07-99da-3082-8c31-4e077a3406fa",
                                        "glosses": [
                                            "ein Zusatz zu Speisen, ein Bestandteil von Speisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f42f25-0778-47f8-94eb-13e4146a9768",
                                                "sense_id": "daac76f0-6ed1-3e8f-a17c-b56cca451760",
                                                "text": "Ich muss noch die Zutaten für die Suppe heute Abend einkaufen."
                                            },
                                            {
                                                "example_id": "ea9127c1-52b0-4da5-b467-1f2806dda9c0",
                                                "sense_id": "daac76f0-6ed1-3e8f-a17c-b56cca451760",
                                                "text": "„Sensationell, was sie aus so wenigen Zutaten zaubern.“"
                                            },
                                            {
                                                "example_id": "6d4281e8-caec-4bba-b620-fe5d48a52eac",
                                                "sense_id": "daac76f0-6ed1-3e8f-a17c-b56cca451760",
                                                "text": "„Carlotta hatte Thanksgiving schon immer geliebt, und selbst in Paris schaffte sie es, die nötigen Zutaten für ein traditionelles Festmahl mit gefülltem Truthahn aufzutreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c072c880-381e-3260-8189-a5cae12234c1",
                                        "entry_id": "8718be07-99da-3082-8c31-4e077a3406fa",
                                        "glosses": [
                                            "etwas im Nachhinein Hinzugefügtes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5bbfc1-487a-4d65-be00-7c33f96020cf",
                                                "sense_id": "c072c880-381e-3260-8189-a5cae12234c1",
                                                "text": "Doch vermutlich aus Angst, irgendeine der vielen Zielgruppen zu verfehlen, geriet \"Mr. und Mrs. Smith\" mehr zu einem Actionfilm, bei dem der Geschlechterkampf nur eine Zutat ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8495214-e06d-419c-8166-f19e9a0baa06",
                        "source_entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
                        "source_sense_description": "Chacune des substances, qui entrent dans la composition d’un médicament etc.",
                        "target_lang_word": "Ingredienz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ingredienz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "664e65fa-87d7-37b5-b694-eb317237eaf4",
                                        "entry_id": "cab50083-dcfd-3193-a861-ccc9afddca7b",
                                        "glosses": [
                                            "Zutat, Inhaltsstoff, besonders in Bezug auf eine Arznei, auf eine zubereitete Speise oder einen Drink"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a5d0609-75a6-4d1c-ae7d-a596000836fe",
                                                "sense_id": "664e65fa-87d7-37b5-b694-eb317237eaf4",
                                                "text": "„Immerhin, für ein fröhliches Weihnachtsfest auch angehender Briten sorgt das Handbuch, indem es die für den traditionellen ‚Christmas pudding‘ notwendigen Ingredienzen aufzählt.“"
                                            },
                                            {
                                                "example_id": "a7765e82-befa-4875-9161-f2f733ef6517",
                                                "sense_id": "664e65fa-87d7-37b5-b694-eb317237eaf4",
                                                "text": "„Insgesamt deklarieren folgende, aus der Lebenswirklichkeit erwachsende Erfordernisse das interdisziplinäre Unterrichtsprinzip, ergänzend zum disziplinären, zu einer unverzichtbaren Ingredienz moderner curricularer Arbeit.“"
                                            },
                                            {
                                                "example_id": "d122ec28-16b6-41fb-9634-72301b985266",
                                                "sense_id": "664e65fa-87d7-37b5-b694-eb317237eaf4",
                                                "text": "„In der mittelalterlichen Volkskunde spielte Bilsenkraut bei den Praktiken des Hexenkults eine wichtige Rolle, wo es zusammen mit Stechapfel und Tollkirsche als Ingredienz von Hexensalben verwandt wurde.“"
                                            },
                                            {
                                                "example_id": "56a263f8-0cc7-4f18-9746-720de1e3af8d",
                                                "sense_id": "664e65fa-87d7-37b5-b694-eb317237eaf4",
                                                "text": "„Oft kommt es auf hauchzarte Nuancen der Ingredienzien an, oft sind die Ingredienzien halb so fein wie ihr Aroma.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c51a1f71-9f78-4d6c-989b-9c4b4df42b6b",
                        "source_entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
