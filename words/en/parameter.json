    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9667f9a2-baf5-34c2-8dae-4e3f3336edac",
                    "sense_definition": "A characteristic or feature that distinguishes something from others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main <w>parameter</w> of this new software is its user-friendly interface.",
                            "target_lang_translations": {
                                "ru": "Основной <w>параметр</w> этого нового программного обеспечения — его удобный интерфейс."
                            }
                        },
                        {
                            "text": "We need to define the <w>parameters</w> of the project before we start working.",
                            "target_lang_translations": {
                                "ru": "Нам нужно определить <w>параметры</w> проекта, прежде чем мы начнем работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "characteristic",
                        "feature",
                        "trait",
                        "property",
                        "attribute",
                        "quality"
                    ],
                    "common_phrases": [
                        "define the parameters",
                        "within the parameters",
                        "set the parameters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеристика или особенность, которая отличает что-либо от других вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "параметр",
                                "target_lang_sense_clarification": "критерий или характеристика"
                            },
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "характеристика"
                            },
                            {
                                "target_lang_word": "характеристика",
                                "target_lang_sense_clarification": "отличительная черта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8683773-3285-3a4d-a4c0-4c95858426b7",
                    "sense_definition": "A variable that describes a property or characteristic of a system, object, or event.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_variable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers monitored every physical <w>parameter</w> during the chemical reaction.",
                            "target_lang_translations": {
                                "ru": "Исследователи отслеживали каждый физический <w>параметр</w> во время химической реакции."
                            }
                        },
                        {
                            "text": "Temperature is a critical <w>parameter</w> in this biological experiment.",
                            "target_lang_translations": {
                                "ru": "Температура является критическим <w>параметром</w> в этом биологическом эксперименте."
                            }
                        }
                    ],
                    "synonyms": [
                        "property",
                        "attribute"
                    ],
                    "common_phrases": [
                        "physical parameter",
                        "critical parameter",
                        "system parameter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переменная, описывающая свойство или характеристику системы, объекта или события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "параметр",
                                "target_lang_sense_clarification": "физическая или техническая величина"
