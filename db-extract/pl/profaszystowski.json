                ],
                "senses": [
                    {
                        "sense_id": "19ebcf20-d4ba-385a-9628-4aac55838b59",
                        "entry_id": "45d11c98-1318-3f51-928e-6f5cea153592",
                        "glosses": [
                            "profascist (in favour of fascism)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "052d3d1a-92c9-474c-aadc-389f7fbc1675",
                                "sense_id": "19ebcf20-d4ba-385a-9628-4aac55838b59",
                                "text": "Walka polskich ochotników w Hiszpanii była więc walką przeciwko (…) profaszystowskiej polityce zagranicznej Polski sanacyjnej.",
                                "translation": "The fight of the Polish volunteers in Spain was thus a fight against the (…) profascist foreign policy of Sanation Poland.",
                                "english": "The fight of the Polish volunteers in Spain was thus a fight against the (…) profascist foreign policy of Sanation Poland."
                            },
                            {
                                "example_id": "86908438-a9b7-4197-89d6-546a33f424a7",
                                "sense_id": "19ebcf20-d4ba-385a-9628-4aac55838b59",
                                "text": "[Benjamin] Sumner Welles należał do grupy polityków profaszystowskich w Departamencie Stanu.",
                                "translation": "[Benjamin] Sumner Welles was part of a group of profascist politicians in the State Department.",
                                "english": "[Benjamin] Sumner Welles was part of a group of profascist politicians in the State Department."
                            },
                            {
                                "example_id": "1aa3fb2f-523f-492f-9148-40cade613de5",
                                "sense_id": "19ebcf20-d4ba-385a-9628-4aac55838b59",
                                "text": "W ostatnich latach niepodległości działała na Litwie znacząca grupa polityczna o sympatiach proniemieckich i profaszystowskich; członkowie tego ugrupowania zajmowali później wysokie stanowiska w LAF [formacja profaszystowska — red.].",
                                "translation": "In the last years of independence, a significant political group with pro-German and profascist sympathies was active in Lithuania; members of this group later held high positions in the LAF [profascist formation — ed.].",
                                "english": "In the last years of independence, a significant political group with pro-German and profascist sympathies was active in Lithuania; members of this group later held high positions in the LAF [profascist formation — ed.]."
                            }
                        ]
                    }
