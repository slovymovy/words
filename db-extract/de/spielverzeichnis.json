                "senses": [
                    {
                        "sense_id": "278ee81d-829b-397c-9ef4-b8e243294c7c",
                        "entry_id": "82fd3b4a-6b48-3450-929b-e040e1fb46a8",
                        "glosses": [
                            "Auflistung von Spielen"
