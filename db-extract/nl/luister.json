                    {
                        "translation_id": "a3d19804-f9fa-4344-b580-2d72de774118",
                        "source_entry_id": "e625d46f-e15b-336b-8f10-72ee0f85c586",
                        "target_lang_word": "splendor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "splendor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4448f520-b57e-320e-9c70-8057722103f6",
                                        "entry_id": "868333ae-eee5-3dd2-b222-2990964da92c",
                                        "glosses": [
                                            "Great light, luster or brilliance."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2397aca4-1d22-405b-bd45-1c0db709d40f",
                                                "sense_id": "4448f520-b57e-320e-9c70-8057722103f6",
                                                "text": "What tho’ the moon—the white moon\nShed all the splendour of her noon,\nHer smile is chilly—and her beam,\nIn that time of dreariness, will seem\n(So like you gather in your breath)\nA portrait taken after death."
                                            },
                                            {
                                                "example_id": "eb420bc4-52e7-42ad-aa13-3f5c146518cf",
                                                "sense_id": "4448f520-b57e-320e-9c70-8057722103f6",
                                                "text": "Once upon a time on an uninhabited island on the shores of the Red Sea, there lived a Parsee from whose hat the rays of the sun were reflected in more-than-oriental-splendour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "864e9b8f-9d76-3fc0-8a57-52223f567a21",
                                        "entry_id": "868333ae-eee5-3dd2-b222-2990964da92c",
                                        "glosses": [
                                            "Magnificent appearance, display or grandeur."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99103abb-d3fd-4191-b87d-f801d37cd2f4",
                                                "sense_id": "864e9b8f-9d76-3fc0-8a57-52223f567a21",
                                                "text": "The splendor of the Queen's coronation was without comparison."
                                            },
                                            {
                                                "example_id": "532327ed-0121-40c5-9e8b-f824d0f9cd64",
                                                "sense_id": "864e9b8f-9d76-3fc0-8a57-52223f567a21",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76857b5f-8fa3-3e0e-8417-9e8462c7d2c4",
                                        "entry_id": "868333ae-eee5-3dd2-b222-2990964da92c",
                                        "glosses": [
                                            "Great fame or glory."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
