                        "entry_id": "6e9815aa-9350-34bc-8818-6da4504ea2eb",
                        "glosses": [
                            "initialism of Bundesrepublik Deutschland (“Federal Republic of Germany”)"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
