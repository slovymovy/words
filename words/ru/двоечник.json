    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f9896fb-73f1-360f-9ed6-8bd8989f3c07",
                    "sense_definition": "Ученик, который постоянно получает самые низкие оценки.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "school_performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель вызвал <w>двоечника</w> к доске, чтобы проверить его знания.",
                            "target_lang_translations": {
                                "en": "The teacher called the <w>poor student</w> to the board to test his knowledge."
                            }
                        },
                        {
                            "text": "Родители <w>двоечника</w> очень расстроились из-за его плохих оценок.",
                            "target_lang_translations": {
                                "en": "The <w>failing student's</w> parents were very upset because of his bad grades."
                            }
                        }
                    ],
                    "synonyms": [
                        "отстающий"
                    ],
                    "antonyms": [
                        "пятёрочник",
                        "отличник"
                    ],
                    "common_phrases": [
                        "вечный двоечник"
                    ],
                    "target_lang_definitions": {
                        "en": "A student who consistently receives the lowest grades."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poor student",
                                "target_lang_sense_clarification": "a student who performs poorly academically"
                            },
                            {
                                "target_lang_word": "underachiever",
                                "target_lang_sense_clarification": "a student who does not perform as well as they could"
                            },
                            {
                                "target_lang_word": "failing student",
                                "target_lang_sense_clarification": "a student who is not passing their classes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc5c297a-cc48-3782-8899-e378c9f22308",
                    "sense_definition": "Человек, который плохо справляется со своей работой или делом.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "school_performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом проекте он показал себя как настоящий <w>двоечник</w>.",
                            "target_lang_translations": {
                                "en": "In this project, he proved himself to be a real <w>underperformer</w>."
                            }
                        },
                        {
                            "text": "Никто не хотел работать с таким <w>двоечником</w> в одной команде.",
                            "target_lang_translations": {
                                "en": "Nobody wanted to work on the same team as such an <w>incompetent person</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "отстающий"
                    ],
                    "antonyms": [
                        "отличник"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в переносном смысле"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who performs poorly in their work or a specific task."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incompetent person",
                                "target_lang_sense_clarification": "someone who lacks the skills to do a job properly"
                            },
                            {
                                "target_lang_word": "slacker",
                                "target_lang_sense_clarification": "someone who avoids work or effort"
                            },
                            {
                                "target_lang_word": "underperformer",
                                "target_lang_sense_clarification": "someone who does not meet the expected standards of work"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}