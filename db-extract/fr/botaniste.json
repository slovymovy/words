                                                "sense_id": "aa5d16d9-129d-30ac-a6dc-9d36d706ee51",
                                                "text": "Dawno nie byliśmy w botaniku, ale czas nadrobić zaległości."
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
                            },
