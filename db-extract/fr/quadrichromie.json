                        "entry_id": "db535d00-4e44-3e4c-b216-3330921f4de7",
                        "glosses": [
                            "Procédé d’impression basé sur l’utilisation de quatre couleurs : les trois couleurs primaires (cyan, jaune, magenta) et la couleur noire."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "573d707c-53dd-4a83-937e-d427140bb45a",
                                "sense_id": "c31494cd-ce9a-3e17-9225-9531a7e599e3",
                                "text": "Des diplômes encadrés – taureaux, vaches laitières, truies primées – voisinaient avec des fragments de cadastres, avec des cartes d’état-major, des photos de troupeaux et de basses-cours, des prospectus en quadrichromie de tracteurs, de batteuses, d’arracheuses, de semoirs."
                            },
                            {
                                "example_id": "5ed77ed3-7dbc-4d1b-978b-972b2ec9c3c1",
                                "sense_id": "c31494cd-ce9a-3e17-9225-9531a7e599e3",
                                "text": "Et la couleur… ô le progrès de la quadrichromie!"
                            },
                            {
                                "example_id": "d1a49252-57fd-477d-bd8d-672e616969d3",
                                "sense_id": "c31494cd-ce9a-3e17-9225-9531a7e599e3",
                                "text": "Les imprimeurs utilisent généralement des images en quadrichromie."
                            }
                        ]
                    },
