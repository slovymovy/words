                        "entry_id": "960ea321-7ed8-3e00-913d-4267e359ec87",
                        "glosses": [
                            "Qui évoque un homme d’épée habile."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "453c45a8-db39-40bc-a1c6-29ee25bd8431",
                                "sense_id": "f9f62e5d-12fd-3a9f-8d96-757845d15996",
                                "text": "Devant ces héros de chair et d’os, je perdais mon intelligence prodigieuse, mon savoir universel, ma musculature athlétique, mon adresse spadassine."
                            }
                        ]
                    }
                ],
