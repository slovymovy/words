                        "translation_id": "dc3a4c8c-0109-4ddd-a2cc-68ee014428cd",
                        "source_entry_id": "71165633-eabc-39cf-9f4b-e6e9b67a4617",
                        "source_sense_id": "2677773b-5e90-3696-8fb8-2ea8a7455198",
