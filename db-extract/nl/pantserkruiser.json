                        "entry_id": "530e9681-71ea-3759-969f-f43935c326a2",
                        "glosses": [
                            "een zwaar type oorlogsschip dat bij de zeemachten dienstdeed voordat het tijdperk van de slagschepen, van 1906 tot 1945, aanbrak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45bf7b22-2ee2-474a-acae-48570ab37754",
                                "sense_id": "e28abd73-730d-3442-8369-681a2e336fc0",
                                "text": "We analyseerden Pantserkruiser Potemkin en we leefden ons uit op Godard, Truffaut, Antonioni en Fellini, het was een fantastische tijd waarin de pretenties zo hoog de lucht in schoten dat je vleugels nodig had om erboven uit te komen."
                            },
                            {
                                "example_id": "cd2ee104-6c77-414f-9b32-526a7db99bb2",
                                "sense_id": "e28abd73-730d-3442-8369-681a2e336fc0",
                                "text": "Bij de Falklandeilanden is een gezonken oorlogsschip uit de Eerste Wereldoorlog gevonden. Het is de Duitse pantserkruiser SMS Scharnhorst, die op 8 december 1914 zonk bij een zeeslag tegen de Britten."
                            }
                        ]
                    }
