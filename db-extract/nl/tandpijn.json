                                "sense_id": "c8600129-b082-31eb-82fa-9a52ea427b4d",
                                "text": "Heb je ooit tandpijn gehad?",
                                "translation": "Have you ever had a toothache?",
                                "english": "Have you ever had a toothache?"
                            },
                            {
                                "example_id": "8a2d46d6-e4c3-40eb-89c0-d732143ee0bd",
                                "sense_id": "c8600129-b082-31eb-82fa-9a52ea427b4d",
                                "text": "Ze gebruikte kruidnagelolie om de tandpijn te verzachten.",
                                "translation": "She used clove oil to alleviate the toothache.",
                                "english": "She used clove oil to alleviate the toothache."
                            }
                        ]
