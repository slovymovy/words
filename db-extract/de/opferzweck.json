                            {
                                "example_id": "7070e588-e28b-47b1-b04b-02bcca5d6d13",
                                "sense_id": "93c4e9e4-9c22-3c7a-bec0-8478e7a6d044",
                                "text": "„Nach dieser Kundgabe des Opferzweckes bat der Herold, die zahlreichen Gebetsurkunden und Zaubersprüche, die ausgelegt worden waren, Stück für Stück zu überlassen.“"
                            },
                            {
                                "example_id": "d0673746-2781-483b-b9b2-0965caaa3b13",
                                "sense_id": "93c4e9e4-9c22-3c7a-bec0-8478e7a6d044",
                                "text": "„Werfen Sie das Opfer in einem Briefumschlag (beschriftet mit dem Opferzweck) in den Briefkasten im Pfarrhaus ein.“"
                            }
                        ],
