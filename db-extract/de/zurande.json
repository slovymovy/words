                                                "example_id": "05299dda-e863-4b94-a57d-48e84ad6d0df",
                                                "sense_id": "04065a60-2795-3263-a0e6-ee6917ddf90f",
                                                "text": "Young men, in the conduct and manage of actions, embrace more than they can hold."
                                            },
