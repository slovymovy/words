{
    "word_family": [
        "stoppen",
        "stopsel",
        "stopcontact",
        "insteek"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "162ac2d0-441b-3c3b-b5b9-33a160a8de5d",
                    "sense_definition": "Iemand in bed leggen en de dekens goed en strak om het lichaam trekken.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "slapen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vader las een verhaaltje voor en ging zijn dochter daarna warm <w>instoppen</w>.",
                            "target_lang_translations": {
                                "en": "The father read a story and then went to warmly <w>tuck</w> his daughter <w>in</w>."
                            }
                        },
                        {
                            "text": "Elke avond <w>stopt</w> zij haar jongste zoontje met liefde <w>in</w>.",
                            "target_lang_translations": {
                                "en": "Every evening she lovingly <w>tucks</w> her youngest son <w>in</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "toedekken"
                    ],
                    "antonyms": [
                        "uitstoppen"
                    ],
                    "common_phrases": [
                        "iemand warm instoppen",
                        "de kinderen instoppen"
                    ],
                    "target_lang_definitions": {
                        "en": "To put someone to bed and draw the blankets snugly around their body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tuck in",
                                "target_lang_sense_clarification": "into bed with blankets"
                            },
                            {
                                "target_lang_word": "tuck up",
                                "target_lang_sense_clarification": "into bed (British English)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a68a2c3-792a-37ea-8ec6-22cd855a5f52",
                    "sense_definition": "Iets ergens in steken, steken of duwen om het op te bergen of te verbergen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>stopte</w> zijn overhemd netjes in zijn broek voor het sollicitatiegesprek begon.",
                            "target_lang_translations": {
                                "en": "He neatly <w>tucked</w> his shirt into his trousers before the job interview started."
                            }
                        },
                        {
                            "text": "Je kunt al die losse papieren het beste in deze map <w>instoppen</w>.",
                            "target_lang_translations": {
                                "en": "It is best to <w>slip</w> all those loose papers into this folder."
                            }
                        }
                    ],
                    "synonyms": [
                        "steken",
                        "indoen"
                    ],
                    "common_phrases": [
                        "in een broek instoppen"
                    ],
                    "target_lang_definitions": {
                        "en": "To insert, slide, or push something into a place to store, stow, or conceal it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tuck in",
                                "target_lang_sense_clarification": "clothes into a waistband"
                            },
                            {
                                "target_lang_word": "stuff in",
                                "target_lang_sense_clarification": "push into a container or folder"
                            },
                            {
                                "target_lang_word": "slip in",
                                "target_lang_sense_clarification": "insert smoothly into a slot or folder"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}