                "senses": [
                    {
                        "sense_id": "eccf0b28-4ad6-31cb-a82d-e8e1a0d1489b",
                        "entry_id": "2153a4f7-ef4d-3f4b-8257-5e3cebe28006",
                        "glosses": [
                            "Schnäuztuch aus Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1ae352-7017-4e99-acf6-b910ea8e2645",
                                "sense_id": "eccf0b28-4ad6-31cb-a82d-e8e1a0d1489b",
                                "text": "„Dann drehte sie sich wieder dem Fenster zu und faltete das Stofftaschentuch auseinander. »Frau Bach?«, fragte Frithjof und trat vorsichtig neben sie. Sie faltete das Stofftaschentuch wieder zusammen.“"
                            },
                            {
                                "example_id": "ec39cf03-c769-4a88-a25f-901f8093b878",
                                "sense_id": "eccf0b28-4ad6-31cb-a82d-e8e1a0d1489b",
                                "text": "„Sorgfältig, vielleicht sogar übertrieben vorsichtig nahm er jedes Buch in die linke Hand, staubte es mit seinem Stofftaschentuch – Papiertaschentücher verabscheute er – vorsichtig ab und stellte es, ohne daß der untere Bücherrand über das Regalbrett schurrte, andächtig auf sein Bücherbord.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
