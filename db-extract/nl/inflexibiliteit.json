                                        "entry_id": "35ae5758-88e4-340f-b1fa-c6997f3856c4",
                                        "glosses": [
                                            "Eigenschaft von Material, sich nicht beugen, dehnen, zusammenpressen zu lassen, sondern seine Form zu behalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf8c4eb2-e919-4239-b472-9bfb4e63369e",
                                                "sense_id": "75799c3b-15cb-3f51-8381-778852e91945",
                                                "text": "„Das größte Problem stellt jedoch die Inflexibilität dar. Feste Stahl-Vorrichtungen können weder einfach und schnell modifiziert noch für weitere Modelle wiederverwendet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
