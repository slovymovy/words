                "senses": [
                    {
                        "sense_id": "213fd319-82ec-3c64-b4d1-e6cd8225e7af",
                        "entry_id": "d3885cda-b914-38da-8fbb-e4df3aefcc5c",
                        "glosses": [
                            "устар., нар.-поэт. то же, что молодец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a85b92b-ee11-48be-8d79-d7fa18c80781",
                                "sense_id": "213fd319-82ec-3c64-b4d1-e6cd8225e7af",
                                "text": "Вот угада́й — моло́дчик бу́дешь."
                            },
                            {
                                "example_id": "c544a76f-39cd-4959-b653-a78664435a07",
                                "sense_id": "213fd319-82ec-3c64-b4d1-e6cd8225e7af",
                                "text": "Наконец попался мне молодчик, хорош, как ангел, умен, и притом щёголь."
                            }
                        ]
                    },
                    {
                        "sense_id": "9113b9ed-2ac8-3314-afdf-a430a186efa1",
                        "entry_id": "d3885cda-b914-38da-8fbb-e4df3aefcc5c",
                        "glosses": [
                            "разг., неодобр. человек, обычно молодой, нарушающий нормы общественного поведения, способный на преступление, на хулиганство и т. п., опасный или подозрительный для окружающих"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d64563-8410-46b7-b5c5-8b228649e98d",
                                "sense_id": "9113b9ed-2ac8-3314-afdf-a430a186efa1",
                                "text": "Вот, например, какой-то молодчик, зарубивший отца и мать: ушастый, немытый."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8365ad6c-5401-4145-944a-da45008fdec5",
                        "source_entry_id": "d3885cda-b914-38da-8fbb-e4df3aefcc5c",
                        "target_lang_word": "thug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3693df0c-5589-33f9-8511-90079d6e86de",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A person who is a member of a gang or criminal organization."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A violent, aggressive, or truculent person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d99ec1-f55b-4fc8-a96e-646084400c62",
                                                "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                                "text": "They call you a land of license—free but to thug and thief."
                                            },
                                            {
                                                "example_id": "4465883e-47d2-4334-a9ff-ff9d1371b2eb",
                                                "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                                "text": "I pushed up out of my chaise and headed for the miniten court. Leah handed me her thug as I walked past her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50a1b71-f34d-3d72-96f4-341442249f63",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A criminal that extorts people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "040c2d15-c8ee-3873-accd-c91765447eab",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A person who use intimidation to coerce others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3df40006-b52c-358b-8d14-85c1c8739a2c",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "One of a band of assassins formerly active in northern India who worshipped Kali and sacrificed their victims to her."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f14ec2e2-b8b3-3b88-96f5-a6c1665c1020",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "One who, usually as a result of social disadvantage, has turned to committing crimes (e.g. selling drugs, robbery, assault, etc.) to make a living; a gangsta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57d53d2e-357a-38ef-bb78-57f3f8323860",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "An overvigorous plant that spreads and dominates the flowerbed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62facc42-cbca-3978-8655-5821f5716654",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A wooden bat used in the game of miniten, fitting around the player's hand."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "thug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfba2945-a654-3453-87ff-164ef6a8f3f8",
                                        "entry_id": "aa616b41-0825-386f-b2e2-43adb20e008e",
                                        "glosses": [
                                            "To commit acts of thuggery, to live the life of a thug, to menace, to commit crime."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c1e5953-9815-448a-9987-efe0385591b9",
                                                "sense_id": "dfba2945-a654-3453-87ff-164ef6a8f3f8",
                                                "text": "Mr. Ingleby ascertained at the office—after threading the mazes of passage and staircase as though he expected momently to be Thugged—that his nephew had not yet come."
                                            },
                                            {
                                                "example_id": "9fd4a47c-9340-4f7a-be9a-6d6765ce819a",
                                                "sense_id": "dfba2945-a654-3453-87ff-164ef6a8f3f8",
                                                "text": "The report then records the arrest of the whole force of the union paper, the Victor Record, the forced resignation of many other civil officers in the Cripple Creek district who were in sympathy with the miners, […] the severe thugging of many of the well-known labor organizers,"
                                            },
                                            {
                                                "example_id": "ba442acc-a760-4b53-994d-952618896b2a",
                                                "sense_id": "dfba2945-a654-3453-87ff-164ef6a8f3f8",
                                                "text": "C.C. and Company. Another story about the young American motor-cycle hoodlum gangs: raping, thugging and robbing their way along the roads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ecd2b5-8cd7-30aa-9a92-b523d1a99554",
                                        "entry_id": "aa616b41-0825-386f-b2e2-43adb20e008e",
                                        "glosses": [
                                            "(often with out) To appear as a thug; to dress and act in a manner reminiscent of a thug."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8027297e-25a1-4849-9798-1d243f2b1108",
                                                "sense_id": "d4ecd2b5-8cd7-30aa-9a92-b523d1a99554",
                                                "text": "I don’t thug out, but I’m not Wall Street, either. Russell Simmons and Puffy have clothes for this look in the affordable range."
                                            },
                                            {
                                                "example_id": "f42a4fe4-aaca-4bf2-86da-7e58922bd195",
                                                "sense_id": "d4ecd2b5-8cd7-30aa-9a92-b523d1a99554",
                                                "text": "Oh. Besides Allen Iverson, basketball players don’t be thugged out enough for me. I like me a roughneck."
                                            },
                                            {
                                                "example_id": "821ebfb1-ddb3-4cb8-a227-3759d3793193",
                                                "sense_id": "d4ecd2b5-8cd7-30aa-9a92-b523d1a99554",
                                                "text": "Well, I’d like to see more positive images of black men. Ones that don’t just go on about having a big dick, thugging and bashing on some girl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01c38ab4-ca51-4b94-b288-ba1aa9a3da89",
                        "source_entry_id": "d3885cda-b914-38da-8fbb-e4df3aefcc5c",
