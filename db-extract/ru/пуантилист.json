                    {
                        "translation_id": "be29e1be-d7b0-410e-8893-73d0de96103c",
                        "source_entry_id": "26a8043a-824f-3bbe-a333-2d8e7a9671fa",
                        "source_sense_id": "44629924-3529-35d2-847e-9a5b16aedbc9",
                        "target_lang_word": "pointilliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pointilliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc70d6d7-706c-3192-b409-f4348d2fb666",
                                        "entry_id": "b7e31c93-5197-38e0-875f-670e3f09451e",
                                        "glosses": [
                                            "Relatif au pointillisme."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbefa6b5-4307-47d8-8b5f-528f669f00c4",
                                                "sense_id": "bc70d6d7-706c-3192-b409-f4348d2fb666",
                                                "text": "Vue de haut, vue de la « colonnade », cette assemblée de jeunes gens et de jeunes filles avec leurs vêtements vert pomme, blanc du sud, bleu ciel, jaune pâle ou rose fuchsia, faisait penser au tableau d’un peintre pointilliste, dont les myriades de petites taches donnent à l’œil qui se plisse l’illusion d’une couleur uniforme et cependant indéfinissable, parce que volontairement contrariée."
                                            },
                                            {
                                                "example_id": "2f71e1a3-bb30-40bf-8cfd-80e48001261a",
                                                "sense_id": "bc70d6d7-706c-3192-b409-f4348d2fb666",
                                                "text": "Tout comme le peintre amateur juxtaposant des points de couleur n’aboutira probablement pas à restituer une image globale et harmonieuse, l’approche pointilliste de la performance en entreprise risque fort de livrer une œuvre confuse, peu harmonieuse et finalement peu satisfaisante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6de2663-02c2-3a9f-b420-cf1d44e6c7d9",
                                        "entry_id": "b7e31c93-5197-38e0-875f-670e3f09451e",
                                        "glosses": [
                                            "En pointillé, de manière discrète, discontinue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a604376f-976c-464d-8013-6a8b5ff78d05",
                                                "sense_id": "c6de2663-02c2-3a9f-b420-cf1d44e6c7d9",
                                                "text": "Nous avons aujourd’hui une connaissance pointilliste de la Russie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pointilliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9156fcd-ea66-3b33-a471-1c3440f08181",
                                        "entry_id": "68529ced-9459-3b49-8f0b-75009aebadcf",
                                        "glosses": [
                                            "Artiste qui pratique le pointillisme."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ff811b-3d4d-43c5-8dc6-5fd16060a849",
                                                "sense_id": "d9156fcd-ea66-3b33-a471-1c3440f08181",
                                                "text": "On eut dit le rêve fou d’un pointilliste : des milliers et milliers de touches rouges qui décomposaient les formes et les lignes du paysage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
