                ],
                "senses": [
                    {
                        "sense_id": "b657f688-605f-3342-9b59-4ddef771a292",
                        "entry_id": "605aeb08-6ade-3e34-bb98-dbede0bb760d",
                        "glosses": [
                            "Colonne isolée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b715e02-0122-474c-89d6-e0d8a1b6c0d2",
                                "sense_id": "b657f688-605f-3342-9b59-4ddef771a292",
                                "text": "Une statue surmontée d’un dais décore seule le monostyle qui soutient le trumeau de l’église de la Nativité à Villeneuve-le-Comte."
                            },
                            {
                                "example_id": "4db83486-92be-4cbd-af7c-1bc7f43270a1",
                                "sense_id": "b657f688-605f-3342-9b59-4ddef771a292",
                                "text": "Ce trumeau est un monostyle quadrangulaire décoré par une colonnette prise aux dépens de l’épannelage, et surmonte de deux corbeaux qui sont destinés à soulager la portée."
                            }
                        ]
                    },
                    {
                        "sense_id": "c23e625c-18f6-3343-a0e4-24355fe3a5e1",
                        "entry_id": "605aeb08-6ade-3e34-bb98-dbede0bb760d",
                        "glosses": [
                            "Style monolithique, uniforme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc6c71a3-337c-4d5e-91ef-040388a02c4a",
                                "sense_id": "c23e625c-18f6-3343-a0e4-24355fe3a5e1",
                                "text": "C’est [Marcel Proust] un écrivain qui ne cherche pas à changer de corps. Il croit à la vérité de sa quête et il croit à l’installation du passé. C’est un écrivain monostyle et ce monostyle est très modern’ style."
                            },
                            {
                                "example_id": "cc352f65-6eb3-451a-b845-ec130562a918",
                                "sense_id": "c23e625c-18f6-3343-a0e4-24355fe3a5e1",
                                "text": "L'artiste ne cherche pas à imposer un monostyle à toutes les entreprises mais à s’inspirer de chacune pour en créer un nouveau."
                            }
                        ]
                    }
