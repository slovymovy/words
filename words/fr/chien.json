                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la distribution des cartes, le joueur a retourné le <w>chien</w> pour compléter son jeu."
                        },
                        {
                            "text": "Le preneur a intégré les cartes du <w>chien</w> dans sa main avant de constituer son écart."
