                "senses": [
                    {
                        "sense_id": "fb68b9b9-5e61-38cd-be86-df511863513b",
                        "entry_id": "056b5c0c-b823-3c13-bb7c-275e9cdaf662",
                        "glosses": [
                            "Stunde am Vormittag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21101a7e-d638-4d42-8df9-ba04df8b1b2b",
                                "sense_id": "fb68b9b9-5e61-38cd-be86-df511863513b",
                                "text": "„Solches Wetter herrschte auch am zweiten September in der zehnten Vormittagsstunde.“"
                            },
                            {
                                "example_id": "4588bbdd-f1a2-4cd5-ab34-7852a466e22e",
                                "sense_id": "fb68b9b9-5e61-38cd-be86-df511863513b",
                                "text": "„Nun, Robert würde sich in den ersten Vormittagsstunden bei der Präfektur melden und die näheren Umstände erfahren.“"
                            },
                            {
                                "example_id": "a9d58f8f-bb12-4257-bebf-11c7988725ae",
                                "sense_id": "fb68b9b9-5e61-38cd-be86-df511863513b",
                                "text": "„Am 14. Januar 1941, gegen die elfte Vormittagsstunde, betrat ein Herr von etwa fünfundvierzig Jahren das Juweliergeschäft von Marius Pissoladière.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
