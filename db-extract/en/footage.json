                    {
                        "translation_id": "b869a4c4-b6e2-42cd-89bb-f66321a22731",
                        "source_entry_id": "322ebb61-4dac-3da0-ad96-5bd8c421931c",
                        "source_sense_description": "amount of film that has been used",
                        "target_lang_word": "Bildmaterial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bildmaterial",
